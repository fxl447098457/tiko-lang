' appinfo -- the program's name and version, and the title-bar text built from them.
#module "appinfo"

#import "std/strings"
#import "tkp/platform"

public const VERSION_MAJOR = 0
public const VERSION_MINOR = 1
public const VERSION_PATCH = 4

public function VersionText( ) as ustring
    return strings.Format( "{}.{}.{}", VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH )
end function

' "tkEdit 0.1.4", or "name - tkEdit" with a document open.
public function WindowTitle( byref docName as const ustring = "" ) as ustring
    if len( docName ) = 0 then return strings.Format( "{} {}", platform.APP_NAME, VersionText( ) )
    return strings.Format( "{} - {}", platform.APP_NAME, docName )   ' "tkEdit - a.tiko" (author 2026-10-27)
end function
