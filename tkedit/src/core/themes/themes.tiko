'
' themes -- tkEdit's own theme, a .tktheme (docs/tkDesigner/THEMES.md, TH7; docs/tkEdit/CONFIG.md):
' the editor's and the tiko lexer's styles of ONE variant, from its [dark.editor] / [dark.syntax]
' (or [light.*]) tables. Colours are "#rrggbb", held as &hRRGGBB. A syntax entry is a colour or a
' table { fg, bg, bold, italic }. A missing key keeps the variant's default (DarkTheme / LightTheme);
' a bad one keeps it too and adds a warning. The window's colours are the theme's roles, which the
' app resolves itself (tkd/themefile): this module has no SDL.
'
' A theme is looked up by name: <config>/themes/<name>.tktheme (the user's) first, then the one
' tkEdit carries. The old themes/<name>.toml format is not read (THEMES.md TD18): ParseTheme
' refuses it, and the app falls back to Default.
#module "themes"

#import "std/fs"
#import "std/config"
#import "std/containers"
#import "std/outcome"
#import "std/strings"
#import "tkc/bundled"
using containers
using outcome

public const THEME_DIR = "themes"
public const THEME_EXT = ".tktheme"
public const DEFAULT_THEME = "Default"

' One style: -1 = the default style's colour.
public type StyleSpec
    Fore   as long = -1
    Back   as long = -1
    Bold   as boolean
    Italic as boolean
end type

public type Theme
    Name as ustring
    Path as ustring                      ' the file it came from; "" = built in
    Dark as boolean = true               ' the variant this is
    ' [<variant>.editor]
    EdBg as long
    EdFg as long
    Caret as long
    CaretLine as long
    Selection as long
    Gutter as long
    GutterFg as long
    Fold as long
    IndentGuide as long
    Brace as long
    FindMatch as long
    ErrorColor as long
    WarningColor as long
    Bookmark as long
    Breakpoint as long          ' the breakpoint marker (debugger)
    ExecLine as long            ' the arrow on the line the debugger stopped at
    ExecLineBack as long        ' and that line's background
    ' [<variant>.syntax]
    Default_ as StyleSpec
    Comment as StyleSpec
    Number_ as StyleSpec
    Keyword as StyleSpec
    Keyword2 as StyleSpec
    Keyword3 as StyleSpec
    Keyword4 as StyleSpec
    String_ as StyleSpec
    Preprocessor as StyleSpec
    Operator_ as StyleSpec
    Identifier as StyleSpec
    ' what the last parse found wrong (bad colours, unknown keys); never fatal
    Warnings as Array( of ustring )
    declare function IsDark( ) as boolean
end type

public type ThemeResult as Result( of Theme, ustring )

private function Spec( byval fore as long, byval italic as boolean = false ) as StyleSpec
    dim as StyleSpec s
    s.Fore = fore
    s.Italic = italic
    return s
end function

' The dark variant's editor and syntax, built in (themes/Default.tktheme's [dark.*] hold the same).
public function DarkTheme( ) as Theme
    dim as Theme t
    t.Name = DEFAULT_THEME
    t.Dark = true
    t.EdBg = &h1E1E1E : t.EdFg = &hD4D4D4
    t.Caret = &hAEAFAD : t.CaretLine = &h2A2D2E : t.Selection = &h264F78
    t.Gutter = &h1E1E1E : t.GutterFg = &h858585 : t.Fold = &h1E1E1E
    t.IndentGuide = &h404040 : t.Brace = &h515C6A : t.FindMatch = &h623315
    t.ErrorColor = &hF14C4C : t.WarningColor = &hCCA700 : t.Bookmark = &h0E639C
    t.Breakpoint = &hE51400 : t.ExecLine = &hFFCC00 : t.ExecLineBack = &h4B4B18
    t.Default_ = Spec( &hD4D4D4 )
    t.Comment = Spec( &h6A9955, true )
    t.Number_ = Spec( &hB5CEA8 )
    t.Keyword = Spec( &h569CD6 )
    t.Keyword2 = Spec( &h4EC9B0 )
    t.Keyword3 = Spec( &hDCDCAA )
    t.Keyword4 = Spec( &h9CDCFE )
    t.String_ = Spec( &hCE9178 )
    t.Preprocessor = Spec( &hC586C0 )
    t.Operator_ = Spec( &hD4D4D4 )
    t.Identifier = Spec( &hD4D4D4 )
    return t
end function

' The light variant's (themes/Default.tktheme's [light.*]).
public function LightTheme( ) as Theme
    dim as Theme t
    t.Name = DEFAULT_THEME
    t.Dark = false
    t.EdBg = &hFFFFFF : t.EdFg = &h1F1F1F
    t.Caret = &h000000 : t.CaretLine = &hF2F6FA : t.Selection = &hADD6FF
    t.Gutter = &hFFFFFF : t.GutterFg = &h6E7681 : t.Fold = &hFFFFFF
    t.IndentGuide = &hD3D3D3 : t.Brace = &hB9D7F0 : t.FindMatch = &hF8C9A0
    t.ErrorColor = &hE51400 : t.WarningColor = &hBF8803 : t.Bookmark = &h005FB8
    t.Breakpoint = &hE51400 : t.ExecLine = &hBE9B00 : t.ExecLineBack = &hFFF4BF
    t.Default_ = Spec( &h1F1F1F )
    t.Comment = Spec( &h008000, true )
    t.Number_ = Spec( &h098658 )
    t.Keyword = Spec( &h0000FF )
    t.Keyword2 = Spec( &h267F99 )
    t.Keyword3 = Spec( &h795E26 )
    t.Keyword4 = Spec( &h001080 )
    t.String_ = Spec( &hA31515 )
    t.Preprocessor = Spec( &hAF00DB )
    t.Operator_ = Spec( &h1F1F1F )
    t.Identifier = Spec( &h1F1F1F )
    return t
end function

function Theme.IsDark( ) as boolean
    return this.Dark
end function

' "#rrggbb" -> &hRRGGBB; -1 when it is not one.
public function ParseColor( byref s as const ustring ) as long
    if (len( s ) <> 7) orelse (left( s, 1 ) <> "#") then return -1
    dim as long v = 0
    for i as long = 1 to 6
        dim as long ch = asc( mid( s, i + 1, 1 ) )
        dim as long d
        select case ch
        case 48 to 57 : d = ch - 48             ' 0-9
        case 65 to 70 : d = ch - 55             ' A-F
        case 97 to 102 : d = ch - 87            ' a-f
        case else : return -1
        end select
        v = v * 16 + d
    next
    return v
end function

public function FormatColor( byval c as long ) as ustring
    return "#" & lcase( right( "000000" & hex( c and &hFFFFFF ), 6 ) )
end function

' Table t's colour key k into slot; a bad value warns and leaves the slot as it was.
private sub ReadColor( byref t as config.TomlValue, byref k as const ustring, byref slot as long, _
                       byref where_ as const ustring, byref warn as Array( of ustring ) )
    dim as Optional( of config.TomlValue ) o = t.Get( k )
    if o.HasValue( ) = false then exit sub
    dim as Optional( of ustring ) s = o.Value( ).AsString( )
    dim as long c = -1
    if s.HasValue( ) then c = ParseColor( s.Value( ) )
    if c < 0 then
        warn.Push( where_ & "." & k & ": not a ""#rrggbb"" colour; ignored" )
    else
        slot = c
    end if
end sub

private sub ReadStyle( byref t as config.TomlValue, byref k as const ustring, byref slot as StyleSpec, _
                       byref warn as Array( of ustring ) )
    dim as Optional( of config.TomlValue ) o = t.Get( k )
    if o.HasValue( ) = false then exit sub
    dim as config.TomlValue v = o.Value( )
    if v.Kind( ) = config.TOML_STRING then
        dim as long c = ParseColor( v.AsString( ).ValueOr( "" ) )
        if c < 0 then
            warn.Push( "syntax." & k & ": not a ""#rrggbb"" colour; ignored" )
        else
            slot.Fore = c
            slot.Back = -1
            slot.Bold = false
            slot.Italic = false
        end if
    elseif v.Kind( ) = config.TOML_TABLE then
        dim as StyleSpec s
        ReadColor( v, "fg", s.Fore, "syntax." & k, warn )
        ReadColor( v, "bg", s.Back, "syntax." & k, warn )
        s.Bold = v.Get( "bold" ).ValueOr( config.TomlValue.FromBool( false ) ).AsBool( ).ValueOr( false )
        s.Italic = v.Get( "italic" ).ValueOr( config.TomlValue.FromBool( false ) ).AsBool( ).ValueOr( false )
        if s.Fore < 0 then s.Fore = slot.Fore
        slot = s
    else
        warn.Push( "syntax." & k & ": a colour or { fg, bg, bold, italic }; ignored" )
    end if
end sub

' Every key of table t not in the space-separated list `known` is a warning.
private sub WarnUnknown( byref t as config.TomlValue, byref known as const ustring, byref where_ as const ustring, _
                         byref warn as Array( of ustring ) )
    dim as ustring k = " " & known & " "
    for i as long = 0 to t.Count( ) - 1
        if instr( k, " " & t.KeyAt( i ) & " " ) = 0 then warn.Push( where_ & "." & t.KeyAt( i ) & ": unknown key; ignored" )
    next
end sub

' A .tktheme's text, the variant asked for, over that variant's defaults. Fails when it is not
' TOML, or is not a .tktheme (no "format = 1"; the old format's [ui] / [editor] / [syntax] at the top).
public function ParseTheme( byref text as const ustring, byref name_ as const ustring, byval isDark as boolean = true ) as ThemeResult
    dim as config.ConfigResultToml r = config.ParseToml( text )
    if r.IsOk( ) = false then return Fail( of Theme, ustring )( r.Failure( ).Message( ) )
    dim as config.TomlValue root = r.Value( )
    dim as boolean old = root.Get( "ui" ).HasValue( ) orelse root.Get( "editor" ).HasValue( ) orelse root.Get( "syntax" ).HasValue( )
    dim as config.TomlValue fmt = root.Get( "format" ).ValueOr( config.TomlValue.FromBool( false ) )
    if old orelse (fmt.AsInt( ).ValueOr( 0 ) <> 1) then return Fail( of Theme, ustring )( "not a .tktheme theme (format = 1)" )
    dim as Theme t
    if isDark then t = DarkTheme( ) else t = LightTheme( )
    t.Name = name_
    dim as Array( of ustring ) w
    dim as ustring vn = iif( isDark, "dark", "light" )
    dim as config.TomlValue v = root.Get( vn ).ValueOr( config.TomlValue.NewTable( ) )
    dim as config.TomlValue e = v.Get( "editor" ).ValueOr( config.TomlValue.NewTable( ) )
    dim as ustring ew = vn & ".editor"
    ReadColor( e, "bg", t.EdBg, ew, w )
    ReadColor( e, "fg", t.EdFg, ew, w )
    ReadColor( e, "caret", t.Caret, ew, w )
    ReadColor( e, "caret_line", t.CaretLine, ew, w )
    ReadColor( e, "selection", t.Selection, ew, w )
    ReadColor( e, "gutter", t.Gutter, ew, w )
    ReadColor( e, "gutter_fg", t.GutterFg, ew, w )
    ReadColor( e, "fold", t.Fold, ew, w )
    ReadColor( e, "indent_guide", t.IndentGuide, ew, w )
    ReadColor( e, "brace", t.Brace, ew, w )
    ReadColor( e, "find_match", t.FindMatch, ew, w )
    ReadColor( e, "error", t.ErrorColor, ew, w )
    ReadColor( e, "warning", t.WarningColor, ew, w )
    ReadColor( e, "bookmark", t.Bookmark, ew, w )
    ReadColor( e, "breakpoint", t.Breakpoint, ew, w )
    ReadColor( e, "exec_line", t.ExecLine, ew, w )
    ReadColor( e, "exec_line_bg", t.ExecLineBack, ew, w )
    WarnUnknown( e, "bg fg caret caret_line selection gutter gutter_fg fold indent_guide brace find_match error warning bookmark " & _
                 "breakpoint exec_line exec_line_bg", ew, w )
    dim as config.TomlValue s = v.Get( "syntax" ).ValueOr( config.TomlValue.NewTable( ) )
    ReadStyle( s, "default", t.Default_, w )
    ReadStyle( s, "comment", t.Comment, w )
    ReadStyle( s, "number", t.Number_, w )
    ReadStyle( s, "keyword", t.Keyword, w )
    ReadStyle( s, "keyword2", t.Keyword2, w )
    ReadStyle( s, "keyword3", t.Keyword3, w )
    ReadStyle( s, "keyword4", t.Keyword4, w )
    ReadStyle( s, "string", t.String_, w )
    ReadStyle( s, "preprocessor", t.Preprocessor, w )
    ReadStyle( s, "operator", t.Operator_, w )
    ReadStyle( s, "identifier", t.Identifier, w )
    WarnUnknown( s, "default comment number keyword keyword2 keyword3 keyword4 string preprocessor operator identifier", vn & ".syntax", w )
    t.Warnings = w
    return Ok( of Theme, ustring )( t )
end function

public function LoadTheme( byref path as const ustring, byref name_ as const ustring, byval isDark as boolean = true ) as ThemeResult
    dim as fs.FsResultUStr r = bundled.ReadAllText( path )     ' a file, or a bundled: name
    if r.IsOk( ) = false then return Fail( of Theme, ustring )( r.Failure( ).Message( ) )
    dim as ThemeResult t = ParseTheme( r.Value( ), name_, isDark )
    if t.IsOk( ) = false then return Fail( of Theme, ustring )( path & ": " & t.Failure( ) )
    dim as Theme v = t.Value( )
    v.Path = path
    return Ok( of Theme, ustring )( v )
end function

' The file a theme name means: the user's copy wins over the shipped one -- a folder's when
' resourceDir names one, else the copy tkEdit carries (tkc/bundled, "bundled:themes/<name>.tktheme");
' "" = none.
public function FindTheme( byref name_ as const ustring, byref configDir as const ustring, _
                           byref resourceDir as const ustring ) as ustring
    dim as ustring f = name_ & THEME_EXT
    dim as ustring u = fs.PathJoin( configDir, THEME_DIR, f )
    if (len( configDir ) > 0) andalso fs.IsFile( u ) then return u
    if len( resourceDir ) > 0 then
        dim as ustring s = fs.PathJoin( resourceDir, THEME_DIR, f )
        if fs.IsFile( s ) then return s
    end if
    return bundled.Locate( THEME_DIR & "/" & f, "" )
end function

' The names settings.toml had before .tktheme: "dark" and "light" were the two variants of what is
' now Default. theme_mode then says which. Any other name is itself.
public function CurrentName( byref name_ as const ustring, byref mode as ustring ) as ustring
    select case lcase( name_ )
    case "dark", "light"
        mode = lcase( name_ )
        return DEFAULT_THEME
    end select
    return name_
end function
