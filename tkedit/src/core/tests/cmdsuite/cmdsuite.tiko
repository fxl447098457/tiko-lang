'    tkEdit - a minimalist keyboard-driven editor for the tiko compiler
'    Copyright (C) 2026 Paul Squires, PlanetSquires Software
'
' cmdsuite -- tkc/cmdids: every Cmd is in the table once, names are unique and found in any case,
' every row has a menu and a description, the groups split the table.
#module "cmdsuite"

#import "std/containers"
#import "std/outcome"
#import "tkc/cmdids"
#import "../tally"
using containers
using outcome

public sub Run( byref c as tally.Checker )
    c.Begin( "cmdids" )
    dim as cmdids.CommandTable t
    dim as long n = clng( cmdids.Cmd.Last_ ) - 1
    c.SameNum( t.Count( ), n, "one row per Cmd" )
    dim as boolean every = true, named = true
    for i as long = 1 to n
        dim as cmdids.CommandInfo ci = t.Info( cast( cmdids.Cmd, i ) )
        if ci.Id <> cast( cmdids.Cmd, i ) then every = false
        if (len( ci.Name ) = 0) orelse (len( ci.Description ) = 0) orelse (len( ci.Category ) = 0) then named = false
    next
    c.Check( every, "every Cmd has its row" )
    c.Check( named, "every row has a name, a description and a menu" )
    dim as Map( of ustring, boolean ) seen
    dim as boolean unique = true
    for i as long = 0 to t.Count( ) - 1
        if seen.Contains( lcase( t.Item( i ).Name ) ) then unique = false
        seen.Put( lcase( t.Item( i ).Name ), true )
    next
    c.Check( unique, "names are unique, ignoring case" )
    dim as Optional( of cmdids.Cmd ) f = t.Find( "filesave" )
    c.Check( f.HasValue( ) andalso (f.Value( ) = cmdids.Cmd.FileSave), "Find is case-blind" )
    c.Check( t.Find( "NoSuchCommand" ).HasValue( ) = false, "an unknown name is not found" )
    dim as long total = 0
    for g as long = 0 to clng( cmdids.MenuGroup.Count_ ) - 1
        dim as Array( of cmdids.Cmd ) a = t.InGroup( cast( cmdids.MenuGroup, g ) )
        c.Check( a.Count( ) > 0, "menu " & cmdids.GroupName( cast( cmdids.MenuGroup, g ) ) & " is not empty" )
        total += a.Count( )
    next
    c.SameNum( total, n, "the menus hold every command" )
    c.Same( cmdids.GroupName( t.Info( cmdids.Cmd.BufferList ).Group ), "View", "BufferList is in View" )
    c.Same( cmdids.GroupName( t.Info( cmdids.Cmd.ShowMenu ).Group ), "View", "ShowMenu is in View" )
    c.Check( t.Info( cmdids.Cmd.FileRename ).SepBefore, "a separator above Rename" )
    dim as Array( of cmdids.Cmd ) inFile = t.InGroup( cmdids.MenuGroup.File )
    dim as long afterSaveAll = -1
    for i as long = 0 to inFile.Count( ) - 1
        if inFile[i] = cmdids.Cmd.FileSaveAll then afterSaveAll = i + 1
    next
    c.Check( (afterSaveAll > 0) andalso (afterSaveAll + 2 < inFile.Count( )) andalso (inFile[afterSaveAll] = cmdids.Cmd.ProjectSaveAs) andalso _
             (inFile[afterSaveAll + 1] = cmdids.Cmd.ProjectClose) andalso (inFile[afterSaveAll + 2] = cmdids.Cmd.FileRename), "the project's rows follow Save All, in File" )
    c.Check( t.Info( cmdids.Cmd.ProjectSaveAs ).SepBefore andalso (t.Info( cmdids.Cmd.ProjectClose ).SepBefore = false), "a group of their own" )
    c.Same( t.Info( cmdids.Cmd.ProjectSaveAs ).Description, "Save As Project", "named Save As Project" )
    dim as Array( of cmdids.Cmd ) inView = t.InGroup( cmdids.MenuGroup.View )
    c.Check( (inView[1] = cmdids.Cmd.ShowExplorer) andalso (inView[2] = cmdids.Cmd.OutputPane) andalso (t.Info( cmdids.Cmd.OutputPane ).SepBefore = false), "Output is right below Explorer" )
    c.Check( t.Info( cmdids.Cmd.FileSave ).SepBefore, "a separator above Save" )
end sub
