' coreall -- the headless gate: imports every tkp and tkc module and runs every console suite.
'   coreall [suite...]   only the named suites (platform, fuzzy, ...); none = all of them
'   exit code = number of failures; last line "coreall [os] selftest: N passed, M failed"
#import "std/fs"
#import "std/strings"
#import "tkp/platform"
#import "tkc/appinfo"
#import "tkc/tomlget"
#import "tkc/runargs"
#import "./tally"
#import "./fuzzysuite"
#import "./textsuite"
#import "./buildsuite"
#import "./mrusuite"
#import "./navsuite"
#import "./encsuite"
#import "./outlinesuite"
#import "./intelsuite"
#import "./cmdsuite"
#import "./keybindsuite"
#import "./settingssuite"
#import "./sessionsuite"
#import "./projectsuite"
#import "./i18nsuite"
#import "./langsuite"
#import "./instancesuite"
#import "./bundledsuite"
#import "./debugviewsuite"

' Is suite `name` wanted on this command line?
function Wanted( byref name_ as const ustring ) as boolean
    if len( command( 1 ) ) = 0 then return true
    dim as long i = 1
    while len( command( i ) ) > 0
        if lcase( command( i ) ) = name_ then return true
        i += 1
    wend
    return false
end function

sub PlatformSuite( byref c as tally.Checker )
    c.Begin( "platform" )
    dim as platform.Os os_ = platform.CurrentOs( )
#if defined( TIKO_OS_WINDOWS )
    c.Check( os_ = platform.Os.Windows, "CurrentOs is Windows" )
    c.Check( platform.SharedLibraryFile( "parser" ) = "parser.dll", "SharedLibraryFile .dll" )
#elseif defined( TIKO_OS_LINUX )
    c.Check( os_ = platform.Os.Linux, "CurrentOs is Linux" )
    c.Check( platform.SharedLibraryFile( "parser" ) = "parser.so", "SharedLibraryFile .so" )
#elseif defined( TIKO_OS_MACOS )
    c.Check( os_ = platform.Os.MacOS, "CurrentOs is MacOS" )
    c.Check( platform.SharedLibraryFile( "parser" ) = "parser.dylib", "SharedLibraryFile .dylib" )
#endif
#if defined( TIKO_OS_MACOS )
    c.Check( platform.PrimaryModifierName( ) = "Cmd", "Primary is Cmd on macOS" )
#else
    c.Check( platform.PrimaryModifierName( ) = "Ctrl", "Primary is Ctrl off macOS" )
#endif
    c.Check( fs.IsDir( platform.ExeDir( ) ), "ExeDir is a folder" )
    c.Same( platform.InstallDir( ), platform.ExeDir( ), "InstallDir: a program outside a bundle is its own folder" )
    c.Check( fs.IsFile( fs.PathJoin( platform.ExeDir( ), fs.PathFileName( command( 0 ) ) ) ) _
             orelse fs.IsFile( fs.PathJoin( platform.ExeDir( ), fs.PathFileName( command( 0 ) ) & ".exe" ) ), _
             "ExeDir holds this program" )
    dim as fs.FsResultUStr cfg = platform.ConfigDir( )
    c.Check( cfg.IsOk( ), "ConfigDir resolves" )
    if cfg.IsOk( ) then c.Check( strings.EndsWith( cfg.Value( ), "tkEdit" ), "ConfigDir ends in tkEdit" )
    c.Check( platform.SystemFontDirs( ).Count( ) >= 1, "SystemFontDirs not empty" )
    dim as ustring cjk = platform.SystemCjkFont( )
    c.Check( (len( cjk ) = 0) orelse fs.IsFile( cjk ), "SystemCjkFont is none or a file: " & cjk )
#if defined( TIKO_OS_WINDOWS )
    c.Check( len( cjk ) > 0, "Windows has a CJK face (Microsoft YaHei or SimSun)" )
#endif

    c.Begin( "appinfo" )
    c.Check( appinfo.VersionText( ) = "0.1.4", "VersionText" )
    c.Check( appinfo.WindowTitle( ) = "tkEdit 0.1.4", "WindowTitle, no document" )
    c.Check( appinfo.WindowTitle( "a.tiko" ) = "tkEdit - a.tiko", "WindowTitle with a document" )
    ' the exe's version resource says the same version (src/app/res/tkEdit.rc; tree = 4 levels up)
    dim as ustring root = platform.ExeDir( )
    for k as long = 1 to 4
        root = fs.PathParent( root )
    next
    dim as ustring rc = fs.ReadAllText( fs.PathJoin( root, "src/app/res/tkEdit.rc" ) ).ValueOr( "" )
    dim as ustring nums = strings.Format( "{},{},{},0", appinfo.VERSION_MAJOR, appinfo.VERSION_MINOR, appinfo.VERSION_PATCH )
    c.Check( instr( rc, "FILEVERSION     " & nums ) > 0, "tkEdit.rc FILEVERSION " & nums )
    c.Check( instr( rc, "PRODUCTVERSION  " & nums ) > 0, "tkEdit.rc PRODUCTVERSION " & nums )
    c.Check( instr( rc, """FileVersion"",      """ & appinfo.VersionText( ) & """" ) > 0, "tkEdit.rc FileVersion string" )
    c.Check( instr( rc, """ProductVersion"",   """ & appinfo.VersionText( ) & """" ) > 0, "tkEdit.rc ProductVersion string" )
end sub

dim as tally.Checker c
if Wanted( "platform" ) then PlatformSuite( c )
if Wanted( "fuzzy" ) then fuzzysuite.Run( c )
if Wanted( "text" ) then textsuite.Run( c )
if Wanted( "build" ) then buildsuite.Run( c )
if Wanted( "mru" ) then mrusuite.Run( c )
if Wanted( "nav" ) then navsuite.Run( c )
if Wanted( "encoding" ) then encsuite.Run( c )
if Wanted( "outline" ) then outlinesuite.Run( c )
if Wanted( "intel" ) then intelsuite.Run( c )
if Wanted( "cmdids" ) then cmdsuite.Run( c )
if Wanted( "keybind" ) then keybindsuite.Run( c )
if Wanted( "settings" ) then settingssuite.Run( c )
if Wanted( "session" ) then sessionsuite.Run( c )
if Wanted( "project" ) then projectsuite.Run( c )
if Wanted( "debugview" ) then debugviewsuite.Run( c )
if Wanted( "i18n" ) then i18nsuite.Run( c )
if Wanted( "langs" ) then langsuite.Run( c )
if Wanted( "instance" ) then instancesuite.Run( c )
if Wanted( "bundled" ) then bundledsuite.Run( c )

print strings.Format( "coreall [{}] selftest: {} passed, {} failed", platform.OsName( ), c.Passed, c.Failed )
end c.Failed
