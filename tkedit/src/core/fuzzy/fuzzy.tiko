'
' fuzzy -- the fuzzy matcher behind Search Symbol and the file pickers: fzy
' (https://github.com/jhawthorn/fzy). The port lives in vendor/tkControls/tkMatch now (moved there
' for tkAutoComplete, docs/tkControls/AUTOCOMPLETE.md D-3); this module keeps tkEdit's names over it,
' so tests/fuzzysuite checks the moved code unchanged.
'
' Score: the best alignment of needle's characters, in order and without case, inside haystack.
' A match right after a separator (/ - _ space .) or at a lower->upper camel step scores a bonus,
' consecutive matches score more, gaps cost a little. The bonus of a character is decided by
' its low byte, as fzy's 256-entry tables were.
#module "fuzzy"

#import "std/containers"
#import "vendor/tkControls/tkMatch"
using containers
using tkMatch

public const SCORE_GAP_LEADING = TKMATCH_GAP_LEADING
public const SCORE_GAP_TRAILING = TKMATCH_GAP_TRAILING
public const SCORE_GAP_INNER = TKMATCH_GAP_INNER
public const SCORE_MATCH_CONSECUTIVE = TKMATCH_MATCH_CONSECUTIVE
public const SCORE_MATCH_SLASH = TKMATCH_MATCH_SLASH
public const SCORE_MATCH_WORD = TKMATCH_MATCH_WORD
public const SCORE_MATCH_CAPITAL = TKMATCH_MATCH_CAPITAL
public const SCORE_MATCH_DOT = TKMATCH_MATCH_DOT
public const SCORE_MAX = TKMATCH_SCORE_MAX
public const SCORE_MIN = TKMATCH_SCORE_MIN

' Every character of needle occurs in haystack, in order, ignoring case.
public function HasMatch( byref needle as const ustring, byref haystack as const ustring ) as boolean
    return tkMatch_FuzzyHas( needle, haystack )
end function

' The score of needle in haystack; SCORE_MIN for an empty needle or one longer than haystack,
' SCORE_MAX for the same text in another case. Call it only where HasMatch is true.
public function Score( byref needle as const ustring, byref haystack as const ustring ) as double
    return tkMatch_FuzzyScore( needle, haystack )
end function

' Score, and where in haystack (0-based) each character of needle matched. positions is left
' empty when the needle is empty or longer than haystack.
public function ScorePositions( byref needle as const ustring, byref haystack as const ustring, _
                                byref positions as Array( of long ) ) as double
    positions.Clear( )
    dim as long p()
    dim as double result = tkMatch_FuzzyPositions( needle, haystack, p() )
    for i as long = lbound( p ) to ubound( p )
        positions.Push( p(i) )
    next
    return result
end function
