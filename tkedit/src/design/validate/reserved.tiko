' The compiler's reserved words and the runtime procedure names a declaration may not reuse, as of
' tiko-lang's src/lexer/keywords.ti and src/symbols/resolvertl.tiko. A hand-kept copy: a word added
' there and not here is still caught, by the compiler, when the generated form is built.
#module "validate"

private function ReservedList( ) as string
    dim as string s = " "
    s &= "ABS ABSTRACT ACCESS ACOS ALIAS ALLOCATE AND ANDALSO ANY APPEND AS ASC ASIN ASM ATAN2 ATN "
    s &= "BASE BEEP BIN BINARY BLOAD BOOLEAN BSAVE BYREF BYTE BYVAL CALL CALLOCATE CASE CAST CBOOL "
    s &= "CBYTE CDBL CDECL CHAIN CHDIR CHR CINT CIRCLE CLASS CLEAR CLNG CLNGINT CLOSE CLS COLOR "
    s &= "COMMAND COMMON CONDBROADCAST CONDCREATE CONDDESTROY CONDSIGNAL CONDWAIT CONST CONSTRUCTOR "
    s &= "CONTINUE COS CPTR CSHORT CSIGN CSNG CSRLIN CUBYTE CUINT CULNG CULNGINT CUNSG CURDIR CUSHORT "
    s &= "CVA_ARG CVA_COPY CVA_END CVA_START CVD CVI CVL CVLONGINT CVS CVSHORT DATA DATE DEALLOCATE "
    s &= "DECLARE DEFBYTE DEFDBL DEFINED DEFINT DEFLNG DEFLONGINT DEFSHORT DEFSNG DEFSTR DEFUBYTE "
    s &= "DEFUINT DEFULNG DEFULONGINT DEFUSHORT DELETE DESTRUCTOR DIM DIR DO DOUBLE DRAW DYLIBFREE "
    s &= "DYLIBLOAD DYLIBSYMBOL DYNAMIC ELSE ELSEIF ENCODING END ENDIF ENUM ENVIRON EOF EQV ERASE "
    s &= "ERFN ERL ERMN ERR ERROR EXEC EXEPATH EXIT EXP EXPLICIT EXPORT EXTENDS EXTERN FIELD FIX FLIP "
    s &= "FOR FRAC FRE FREEFILE FUNCTION GET GETJOYSTICK GETKEY GETMOUSE GOSUB GOTO HEX IF IIF "
    s &= "IMAGECONVERTROW IMAGECREATE IMAGEDESTROY IMAGEINFO IMP IMPLEMENTS IMPORT INCLUDE INKEY INP "
    s &= "INPUT INSTR INSTRREV INT INTEGER IS KILL LBOUND LCASE LEFT LEN LET LIB LINE LOC LOCAL "
    s &= "LOCATE LOCK LOF LOG LONG LONGINT LOOP LPOS LPRINT LSET LTRIM MID MKD MKDIR MKI MKL "
    s &= "MKLONGINT MKS MKSHORT MOD MULTIKEY MUTEXCREATE MUTEXDESTROY MUTEXLOCK MUTEXUNLOCK NAME "
    s &= "NAMESPACE NEW NEXT NOT OCT ON OPEN OPERATOR OPTION OR ORELSE OUT OUTPUT OVERLOAD PAINT "
    s &= "PALETTE PASCAL PCOPY PEEK PMAP POINT POINTCOORD POINTER POKE POS PRESERVE PRESET PRINT "
    s &= "PRIVATE PROCPTR PROPERTY PROTECTED PSET PTR PUBLIC PUT RANDOM RANDOMIZE READ REALLOCATE "
    s &= "REDIM REM RESET RESTORE RESUME RETURN RIGHT RMDIR RND RSET RTRIM RUN SADD SCOPE SCREEN "
    s &= "SCREENCONTROL SCREENCOPY SCREENEVENT SCREENGLPROC SCREENINFO SCREENLIST SCREENLOCK "
    s &= "SCREENPTR SCREENRES SCREENSET SCREENSYNC SCREENUNLOCK SEEK SELECT SETDATE SETENVIRON "
    s &= "SETMOUSE SETTIME SGN SHARED SHELL SHL SHORT SHR SIN SINGLE SIZEOF SLEEP SPACE SPC SQR "
    s &= "STATIC STDCALL STEP STOP STR STRING STRPTR SUB SWAP SYSTEM TAB TAN THEN THREADCALL "
    s &= "THREADCREATE THREADWAIT TIME TIMER TO TRIM TYPE TYPEOF UBOUND UBYTE UCASE UINTEGER ULONG "
    s &= "ULONGINT UNION UNLOCK UNSIGNED UNTIL USHORT USING USTRING VAL VALINT VALLNG VALUINT VALULNG "
    s &= "VAR VARPTR VA_FIRST VIEW VIRTUAL WAIT WBIN WCHR WEND WHEX WHILE WIDTH WINDOW WINDOWTITLE "
    s &= "WINPUT WITH WOCT WRITE WSPACE WSTR WSTRING XOR ZSTRING __FASTCALL __THISCALL "
    return s
end function
