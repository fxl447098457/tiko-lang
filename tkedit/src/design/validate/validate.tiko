' validate -- everything a form can get wrong that would otherwise surface as a compile error in a
' generated file the user never wrote. Each problem is one line naming the control.
#module "validate"

#import "std/containers"
#import "vendor/tkControls/tkMeta"
#import "vendor/tkControls/tkKeys"
#import "vendor/tkControls/tkLayout"
#import "vendor/tkControls/tkBind"
#import "std/chrono"
#import "../model"
#import "../catalog"
#import "../formfile"
using containers
using tkMeta
using tkKeys
using tkLayout
using model
using tkBind
using chrono

public function IsIdentifier( byref s as const ustring ) as boolean
    if len( s ) = 0 then return false
    for i as long = 1 to len( s )
        select case asc( mid( s, i, 1 ) )
        case 65 to 90, 97 to 122, 95
        case 48 to 57
            if i = 1 then return false
        case else
            return false
        end select
    next
    return true
end function

public function IsReserved( byref s as const ustring ) as boolean
    return instr( ReservedList( ), " " & ucase( s ) & " " ) > 0
end function

' What FormBase and the generated Form already use, and the names a field must not hide.
private function IsFormMember_( byref s as const ustring ) as boolean
    const as string MEMBERS = " handle layout build show showmodal endmodal close isopen openwindow form this base loadfrom saveto isdirty "
    return instr( MEMBERS, " " & lcase( s ) & " " ) > 0
end function

' A wrapper type or a control module: a field named like one hides it from the rest of the form.
private function IsControlWord_( byref s as const ustring ) as boolean
    dim as ustring want = lcase( s )
    if want = "custom" then return true
    if (want = "tkforms") orelse (want = "tkapp") orelse (want = "tklayout") orelse (want = "tkhost") _
       orelse (want = "tkpaint") orelse (want = "tktheme") orelse (want = "formbase") then return true
    for i as long = 0 to tkMeta_Count( ) - 1
        dim as TKMETA_CONTROL ptr m = tkMeta_At( i )
        if (lcase( m->Name ) = want) orelse (lcase( m->Module_ ) = want) then return true
    next
    return false
end function

' A dotted name: "Contact", "contactdb.Contact", "Address.City" -- each part an identifier.
private function IsDottedName_( byref s as const ustring ) as boolean
    if len( s ) = 0 then return false
    dim as long at = 1
    do
        dim as long dot = instr( at, s, "." )
        dim as ustring part = iif( dot > 0, mid( s, at, dot - at ), mid( s, at ) )
        if IsIdentifier( part ) = false then return false
        if dot = 0 then return true
        at = dot + 1
    loop
end function

private function AllDigits_( byref s as const ustring ) as boolean
    for i as long = 1 to len( s )
        dim as long c = asc( s, i )
        if (c < 48) orelse (c > 57) then return false
    next
    return true
end function

' [+|-]digits[.digits][e[+|-]digits] (or .digits): a Minimum / Maximum that is a number.
private function IsNumberText_( byref s as const ustring ) as boolean
    dim as ustring t = trim( s )
    if (left( t, 1 ) = "+") orelse (left( t, 1 ) = "-") then t = mid( t, 2 )
    dim as long ep = instr( lcase( t ), "e" )
    if ep then
        dim as ustring ex = mid( t, ep + 1 )
        if (left( ex, 1 ) = "+") orelse (left( ex, 1 ) = "-") then ex = mid( ex, 2 )
        if (len( ex ) = 0) orelse (AllDigits_( ex ) = false) then return false
        t = left( t, ep - 1 )
    end if
    dim as long dp = instr( t, "." )
    dim as ustring a = t, b
    if dp then a = left( t, dp - 1 ) : b = mid( t, dp + 1 )
    if (len( a ) = 0) andalso (len( b ) = 0) then return false
    return AllDigits_( a ) andalso AllDigits_( b )
end function

' yyyy-mm-dd, a real date: a Minimum / Maximum for a date.
private function IsIsoDate_( byref s as const ustring ) as boolean
    dim as LocalDate ld
    dim as ustring t = trim( s )
    return (len( t ) = 10) andalso LocalDate.TryParseIso( t, ld )
end function

' B2's rules on one control: with Bind, of a kind that takes them, and well formed.
private sub CheckRules_( byref c as FormControl, byval m as TKMETA_CONTROL ptr, byref out_ as Array( of ustring ) )
    dim as ustring set_ = catalog.RulesSet( c )
    if len( set_ ) = 0 then exit sub
    if len( c.Bind ) = 0 then
        out_.Push( c.Name & ": " & set_ & " need" & iif( instr( set_, " " ), "", "s" ) & " Bind first" )
        exit sub
    end if
    dim as ustring t = set_ & " "
    dim as long at_ = 1
    do
        dim as long sp = instr( at_, t, " " )
        if sp = 0 then exit do
        dim as ustring rule = mid( t, at_, sp - at_ )
        if catalog.RuleAllowed( m, rule ) = false then
            out_.Push( c.Name & ": a " & m->Name & " has no " & rule & " rule" )
            exit sub
        end if
        at_ = sp + 1
    loop
    ' Minimum / Maximum: numbers, or dates (a DatePicker's always), the two of one kind, in order
    dim as boolean dateKind = (m->BindKind = "date"), numKind = (m->BindKind = "float")
    dim as ustring lim( 0 to 1 ) = { c.Minimum, c.Maximum }, nm( 0 to 1 ) = { "minimum", "maximum" }
    dim as long kinds( 0 to 1 )                  ' 0 none, 1 number, 2 date
    for k as long = 0 to 1
        if len( lim( k ) ) = 0 then continue for
        if IsIsoDate_( lim( k ) ) andalso (numKind = false) then
            kinds( k ) = 2
        elseif IsNumberText_( lim( k ) ) andalso (dateKind = false) then
            kinds( k ) = 1
        else
            out_.Push( c.Name & ": " & nm( k ) & " '" & lim( k ) & "' is not " & iif( dateKind, "a date (yyyy-mm-dd)", iif( numKind, "a number", "a number or a date (yyyy-mm-dd)" ) ) )
            exit sub
        end if
    next
    if (kinds( 0 ) <> 0) andalso (kinds( 1 ) <> 0) then
        if kinds( 0 ) <> kinds( 1 ) then
            out_.Push( c.Name & ": minimum and maximum must both be numbers or both dates" )
        elseif kinds( 0 ) = 1 then
            if val( c.Minimum ) > val( c.Maximum ) then out_.Push( c.Name & ": minimum " & c.Minimum & " is above maximum " & c.Maximum )
        elseif trim( c.Minimum ) > trim( c.Maximum ) then
            out_.Push( c.Name & ": minimum " & c.Minimum & " is after maximum " & c.Maximum )
        end if
    end if
    if c.MaxLength < 0 then out_.Push( c.Name & ": max length " & c.MaxLength & " is below 0" )
    if len( c.Format ) andalso (tkBind_IsFormat( c.Format ) = false) then
        out_.Push( c.Name & ": format '" & c.Format & "' is neither a number format (.2f) nor a date pattern (dd/MM/yyyy)" )
    end if
end sub

' A field of a list's element: Name, Home.City, or a method with no arguments, FullName( ).
private function IsElementField_( byref s as const ustring ) as boolean
    dim as ustring t = trim( s )
    if right( t, 1 ) = ")" then
        dim as long op = instr( t, "(" )
        if (op = 0) orelse (len( trim( mid( t, op + 1, len( t ) - op - 1 ) ) ) > 0) then return false
        t = rtrim( left( t, op - 1 ) )
    end if
    return IsDottedName_( t )
end function

' An ItemsSource: a name (People, contactdb.All) or a call (contactdb.Countries( )), parentheses
' balanced, on one line.
private function IsSourceExpr_( byref s as const ustring ) as boolean
    dim as ustring t = trim( s )
    if (len( t ) = 0) orelse instr( t, chr( 10 ) ) orelse instr( t, chr( 34 ) ) then return false
    dim as long op = instr( t, "(" )
    dim as ustring head_ = t
    if op then
        if right( t, 1 ) <> ")" then return false
        head_ = rtrim( left( t, op - 1 ) )
        dim as long depth = 0
        for i as long = op to len( t )
            select case mid( t, i, 1 )
            case "(" : depth += 1
            case ")" : depth -= 1 : if depth < 0 then return false
            end select
        next
        if depth <> 0 then return false
    end if
    return IsDottedName_( head_ )
end function

' B3's list binding on one control.
private sub CheckList_( byref doc as FormDoc, byref c as FormControl, byval m as TKMETA_CONTROL ptr, byref out_ as Array( of ustring ) )
    if m->ItemsBind = "records" then exit sub           ' a navigator: CheckNav_
    dim as boolean anyField = false
    for each it as FormItem in c.Items
        if len( it.Field ) then anyField = true
    next
    dim as boolean anySet = catalog.HasListSource( c ) orelse (len( c.ItemType ) > 0) orelse (len( c.DisplayField ) > 0) _
        orelse (len( c.ValueField ) > 0) orelse (len( c.CheckField ) > 0) orelse anyField
    if c.ItemsLive andalso (m->ItemsBind <> "grid") then out_.Push( c.Name & ": only a DataGrid shows its array in place (ItemsLive)" )
    if anySet = false then exit sub
    dim as ustring shape = m->ItemsBind
    if len( shape ) = 0 then
        out_.Push( c.Name & ": a " & m->Name & " has no list to bind" )
        exit sub
    end if
    if (len( c.ItemsField ) > 0) andalso (len( c.ItemsSource ) > 0) then
        out_.Push( c.Name & ": a list comes from ItemsField or ItemsSource, not both" )
        exit sub
    end if
    if len( c.ItemsField ) then
        if IsDottedName_( c.ItemsField ) = false then
            out_.Push( c.Name & ": items field '" & c.ItemsField & "' is not a field name" )
        elseif len( doc.DataType ) = 0 then
            out_.Push( c.Name & ": an ItemsField needs the form's DataType first" )
        end if
    end if
    if len( c.ItemsSource ) andalso (IsSourceExpr_( c.ItemsSource ) = false) then
        out_.Push( c.Name & ": items source '" & c.ItemsSource & "' is not a name or a call (People, contactdb.Countries( ))" )
    end if
    dim as boolean src = catalog.HasListSource( c )
    if len( c.ItemType ) andalso (IsDottedName_( c.ItemType ) = false) then
        out_.Push( c.Name & ": item type '" & c.ItemType & "' is not a type name" )
    end if
    if shape = "items" then
        if len( c.CheckField ) orelse anyField then out_.Push( c.Name & ": a " & m->Name & " has DisplayField and ValueField, not columns or checks" )
        if src andalso c.Items.Count( ) then out_.Push( c.Name & ": its items come from the list; remove the ones typed in" )
        if (src = false) andalso (len( c.DisplayField ) orelse len( c.ValueField )) then out_.Push( c.Name & ": DisplayField and ValueField need ItemsField or ItemsSource" )
        if len( c.DisplayField ) andalso (IsElementField_( c.DisplayField ) = false) then out_.Push( c.Name & ": display field '" & c.DisplayField & "' is not a field (Name, FullName( ))" )
        if len( c.ValueField ) andalso (IsElementField_( c.ValueField ) = false) then out_.Push( c.Name & ": value field '" & c.ValueField & "' is not a field (Id, Code)" )
    else
        if (shape = "grid") andalso len( c.CheckField ) then out_.Push( c.Name & ": a DataGrid has no CheckField: give a column the Kind check and a Field" )
        ' G5b: shown in place, so the array must be one that lives on, not a call's copy
        if c.ItemsLive andalso len( c.ItemsSource ) andalso (IsDottedName_( c.ItemsSource ) = false) then
            out_.Push( c.Name & ": a live grid's ItemsSource must be an array it can change, a name (Lines), not '" & c.ItemsSource & "'" )
        end if
        if len( c.DisplayField ) orelse len( c.ValueField ) then out_.Push( c.Name & ": a " & m->Name & " shows columns: give each column a Field" )
        if (shape = "report") andalso len( c.CheckField ) then out_.Push( c.Name & ": a ReportViewer's fields are its columns; it has no CheckField" )
        if (src = false) andalso (len( c.CheckField ) orelse anyField) then out_.Push( c.Name & ": columns' fields need ItemsField or ItemsSource" )
        if len( c.CheckField ) andalso (IsElementField_( c.CheckField ) = false) then
            out_.Push( c.Name & ": check field '" & c.CheckField & "' is not a field" )
        end if
        for each it as FormItem in c.Items
            if len( it.Field ) andalso (IsElementField_( it.Field ) = false) then out_.Push( c.Name & ": column field '" & it.Field & "' is not a field (Name, FullName( ))" )
        next
    end if
    ' the members the generated code adds for it
    if src then
        for each o as FormControl in doc.Controls
            dim as ustring ln = lcase( o.Name )
            if (ln = lcase( c.Name & "_Fill" )) orelse (ln = lcase( c.Name & "_Item" )) orelse (ln = lcase( c.Name & "_Values_" )) then
                out_.Push( o.Name & ": the name is taken by " & c.Name & "'s list" )
            end if
        next
    end if
end sub

' B4: a navigator steps through ItemsSource, an Array( of DataType ) it changes (New, Delete), so
' a name, not a call; it may follow a B3 list control over the same array. One per form.
private sub CheckNav_( byref doc as FormDoc, byref c as FormControl, byval m as TKMETA_CONTROL ptr, byref out_ as Array( of ustring ) )
    if m->ItemsBind <> "records" then
        if len( c.Follows ) then out_.Push( c.Name & ": only a Navigator follows a list" )
        exit sub
    end if
    if len( c.ItemsField ) orelse len( c.ItemType ) orelse len( c.DisplayField ) orelse len( c.ValueField ) orelse len( c.CheckField ) then
        out_.Push( c.Name & ": a Navigator takes ItemsSource (its records) and Follows, nothing else of a list" )
    end if
    if len( c.ItemsSource ) then
        if IsDottedName_( c.ItemsSource ) = false then
            out_.Push( c.Name & ": a Navigator's records must be an array it can change, a name (People), not '" & c.ItemsSource & "'" )
        elseif len( doc.DataType ) = 0 then
            out_.Push( c.Name & ": a Navigator needs the form's DataType first, the type of its records" )
        end if
    elseif len( c.Follows ) then
        out_.Push( c.Name & ": Follows needs the Navigator's ItemsSource first" )
    end if
    if len( c.Follows ) andalso len( c.ItemsSource ) then
        dim as long fi = -1
        for k as long = 0 to doc.Controls.Count( ) - 1
            if lcase( doc.Controls[k].Name ) = lcase( c.Follows ) then fi = k : exit for
        next
        if fi < 0 then
            out_.Push( c.Name & ": follows '" & c.Follows & "', which is not on the form" )
        else
            dim as ustring shape = catalog.ItemsBindOf( doc.Controls[fi] )
            if (shape <> "rows") andalso (shape <> "items") andalso (shape <> "grid") then
                out_.Push( c.Name & ": follows '" & c.Follows & "', which is no ListTree, ComboBox or DataGrid" )
            elseif lcase( trim( doc.Controls[fi].ItemsSource ) ) <> lcase( trim( c.ItemsSource ) ) then
                out_.Push( c.Name & ": follows '" & c.Follows & "', whose ItemsSource is not " & c.ItemsSource )
            end if
        end if
    end if
    dim as long nNav = 0
    for each o as FormControl in doc.Controls
        if catalog.IsNavigator( o ) then nNav += 1
        dim as ustring ln = lcase( o.Name )
        if (ln <> lcase( c.Name )) andalso ((ln = lcase( c.Name & "_MoveTo" )) orelse (ln = lcase( c.Name & "_Refresh" )) orelse (ln = lcase( c.Name & "_Current" ))) then
            out_.Push( o.Name & ": the name is taken by " & c.Name & "'s records" )
        end if
    next
    if (nNav > 1) andalso (lcase( c.Name ) = lcase( FirstNav_( doc ) )) then out_.Push( c.Name & ": a form has one Navigator" )
end sub

private function FirstNav_( byref doc as FormDoc ) as ustring
    for each o as FormControl in doc.Controls
        if catalog.IsNavigator( o ) then return o.Name
    next
    return ""
end function

' Why this name can't be a field or handler of a form, or "" when it can.
private function NameFault_( byref s as const ustring ) as ustring
    if IsIdentifier( s ) = false then return "is not an identifier"
    if IsReserved( s ) then return "is a reserved word"
    ' Not a keyword: a field by this name would hide the prelude constant the generated Build uses.
    if lcase( s ) = "nullptr" then return "is tiko's null pointer constant"
    if IsFormMember_( s ) then return "is already a member of every form"
    if IsControlWord_( s ) then return "is the name of a control type or module"
    return ""
end function

' The Shown part of a "Shown=CONSTANT,..." list.
private function EnumHas_( byref pairs as const ustring, byref shown as const ustring ) as boolean
    return instr( "," & pairs, "," & shown & "=" ) > 0
end function

private function IsColor_( byref s as const ustring ) as boolean
    if lcase( left( s, 2 ) ) <> "&h" then return false
    if (len( s ) < 3) orelse (len( s ) > 10) then return false
    for i as long = 3 to len( s )
        select case asc( mid( s, i, 1 ) )
        case 48 to 57, 65 to 70, 97 to 102
        case else
            return false
        end select
    next
    return true
end function

public function IsFontRole( byref s as const ustring ) as boolean
    return instr( " UI UI_SMALL UI_BOLD UI_LARGE GLYPH GLYPH_LARGE MONO ", " " & s & " " ) > 0
end function

' A glyph size in points: a whole number from 6 to 200.
private function IsPoints_( byref s as const ustring ) as boolean
    if (len( s ) = 0) orelse (len( s ) > 3) then return false
    for i as long = 1 to len( s )
        dim as long a = asc( mid( s, i, 1 ) )
        if (a < 48) orelse (a > 57) then return false
    next
    return (valint( s ) >= 6) andalso (valint( s ) <= 200)
end function

' "" when this value suits the kind, or what's wrong with it.
private function ValueFault_( byref s as Setting, byref kind_ as const ustring, byref pairs as const ustring ) as ustring
    select case kind_
    case "bool"
        if s.Kind <> VALUE_BOOL then return "must be true or false"
    case "int"
        if s.Kind <> VALUE_INT then return "must be a whole number"
    case "float"
        if (s.Kind <> VALUE_INT) andalso (s.Kind <> VALUE_FLOAT) then return "must be a number"
    case "enum"
        if (s.Kind <> VALUE_TEXT) orelse (EnumHas_( pairs, s.Value ) = false) then return "must be one of " & pairs
    case "color"
        if (s.Kind <> VALUE_TEXT) orelse (IsColor_( s.Value ) = false) then return "must be a colour such as &hFF336699"
    case "font"
        ' GlyphFont is shown as GlyphSize: a role (GLYPH, GLYPH_LARGE) or a size in points (GLYPHS.md)
        if (s.Key = "GlyphFont") andalso (s.Kind = VALUE_TEXT) andalso IsPoints_( s.Value ) then return ""
        if (s.Kind <> VALUE_TEXT) orelse (IsFontRole( s.Value ) = false) then return "must be a font role (UI, UI_BOLD, MONO, ...)"
    case "list"
        if s.Kind <> VALUE_TEXT then return "must be a string"
        return tkMeta_ListFault( s.Value, pairs )
    case else
        if s.Kind <> VALUE_TEXT then return "must be a string"
    end select
    return ""
end function

' [control.colors]: a style name a theme could have, fields of this type's colour struct.
private sub CheckColors_( byref c as FormControl, byval m as TKMETA_CONTROL ptr, byref out_ as Array( of ustring ) )
    if (len( c.StyleName ) = 0) andalso (c.Colors.Count( ) = 0) then exit sub
    if m->NumColorSlots = 0 then
        out_.Push( c.Name & ": " & m->Name & " has no colours a theme sets" )
        exit sub
    end if
    if len( c.StyleName ) andalso ((IsIdentifier( c.StyleName ) = false) orelse (len( c.StyleName ) > 31)) then
        out_.Push( c.Name & ": '" & c.StyleName & "' is not a style name" )
    end if
    for each s as Setting in c.Colors
        if tkMeta_ColorSlot( m, s.Key ) < 0 then out_.Push( c.Name & ": " & m->Name & " has no colour '" & s.Key & "'" )
    next
end sub

private sub CheckProps_( byref c as FormControl, byval m as TKMETA_CONTROL ptr, byref out_ as Array( of ustring ) )
    for each s as Setting in c.Props
        dim as ustring fault
        if (s.Key = "Enabled") orelse (s.Key = "Visible") then
            fault = ValueFault_( s, "bool", "" )
        elseif s.Key = m->CreateArg then
            fault = ValueFault_( s, m->CreateArgKind, m->CreateArgEnum )
        else
            dim as TKMETA_PROP ptr p = tkMeta_FindProp( m, s.Key )
            if p = 0 then
                out_.Push( c.Name & ": " & m->Name & " has no property '" & s.Key & "'" )
                continue for
            end if
            fault = ValueFault_( s, p->Kind, p->EnumPairs )
        end if
        if len( fault ) then out_.Push( c.Name & ": property " & s.Key & " " & fault )
    next
end sub

private sub AddHandler_( byref handlers as Array( of Setting ), byref owner as const ustring, byref handler as const ustring, _
                         byref params as const ustring, byref doc as FormDoc, byref out_ as Array( of ustring ) )
    dim as ustring fault = NameFault_( handler )
    if len( fault ) then
        out_.Push( owner & ": handler '" & handler & "' " & fault )
    elseif FindControl( doc, handler ) >= 0 then
        out_.Push( owner & ": handler '" & handler & "' has the same name as a control" )
    end if
    ' One handler may serve several events, when they all pass it the same things.
    for each h as Setting in handlers
        if lcase( h.Key ) = lcase( handler ) then
            if h.Value <> params then out_.Push( owner & ": handler '" & handler & "' is already used by an event with different parameters" )
            exit sub
        end if
    next
    dim as Setting s
    s.Key = handler
    s.Value = params
    handlers.Push( s )
end sub

' The first problem `after` has that `before` didn't, or "".
public function FirstNewProblem( byref before as FormDoc, byref after as FormDoc ) as ustring
    dim as Array( of ustring ) a, b
    Check( before, "frmForm", a )
    Check( after, "frmForm", b )
    for each s as ustring in b
        dim as boolean known = false
        for each o as ustring in a
            if o = s then known = true
        next
        if known = false then return s
    next
    return ""
end function

' Every problem in `doc`, as one line each, for a form in module `moduleName`. Includes what reading
' the file reported.
' A ContextMenu has to name a PopupMenu of this form.
private sub ContextMenuProblem_( byref doc as FormDoc, byref who as const ustring, byref menuName as const ustring, byref out_ as Array( of ustring ) )
    dim as long k = FindControl( doc, menuName )
    if k < 0 then
        out_.Push( who & ": context menu '" & menuName & "' doesn't exist" )
    elseif doc.Controls[k].TypeName <> catalog.POPUP_TYPE then
        out_.Push( who & ": context menu '" & menuName & "' isn't a " & catalog.POPUP_TYPE )
    end if
end sub

public sub Check( byref doc as FormDoc, byref moduleName as const ustring, byref out_ as Array( of ustring ) )
    for each s as ustring in doc.Problems
        out_.Push( s )
    next
    if len( doc.ContextMenu ) then ContextMenuProblem_( doc, "form", doc.ContextMenu, out_ )
    if IsIdentifier( moduleName ) = false then
        out_.Push( "form file name '" & moduleName & "' is not an identifier" )
    elseif IsReserved( moduleName ) orelse (lcase( moduleName ) = "form") then
        out_.Push( "form file name '" & moduleName & "' can't be a module name" )
    end if
    if (doc.ClientW <= 0) orelse (doc.ClientH <= 0) then out_.Push( "form: width and height must be positive" )
    if len( doc.DataType ) andalso (IsDottedName_( doc.DataType ) = false) then
        out_.Push( "form: data type '" & doc.DataType & "' is not a type name (Contact, or contactdb.Contact)" )
    end if
    select case doc.StartPosition
    case "", "CenterScreen", "CenterOwner"
    case else : out_.Push( "form: no start position '" & doc.StartPosition & "'" )
    end select
    select case doc.WindowState
    case "", "Maximized", "Minimized"
    case else : out_.Push( "form: no window state '" & doc.WindowState & "'" )
    end select
    if (doc.WindowState = "Maximized") andalso (doc.Resizable = "false") then out_.Push( "form: a maximized window has to be resizable" )
    if (doc.MinW < 0) orelse (doc.MinH < 0) orelse (doc.MaxW < 0) orelse (doc.MaxH < 0) then
        out_.Push( "form: a size limit can't be negative" )
    elseif ((doc.MaxW > 0) andalso (doc.MaxW < doc.MinW)) orelse ((doc.MaxH > 0) andalso (doc.MaxH < doc.MinH)) then
        out_.Push( "form: a maximum size is below its minimum" )
    end if

    dim as Array( of Setting ) handlers
    for each s as Setting in doc.Events
        if catalog.IsFormEvent( s.Key ) then
            AddHandler_( handlers, "form", s.Value, catalog.FormEventParams( s.Key ), doc, out_ )
        else
            out_.Push( "form: no event '" & s.Key & "'" )
        end if
    next

    for i as long = 0 to doc.Controls.Count( ) - 1
        dim as FormControl c = doc.Controls[i]
        dim as ustring fault = NameFault_( c.Name )
        if len( fault ) then out_.Push( "control '" & c.Name & "' " & fault )
        if lcase( c.Name ) = lcase( moduleName ) then out_.Push( "control '" & c.Name & "' has the same name as its form" )
        if FindControl( doc, c.Name ) <> i then out_.Push( "control '" & c.Name & "' is a duplicate name (case doesn't count)" )
        if (c.W < 0) orelse (c.H < 0) then out_.Push( c.Name & ": width and height can't be negative" )

        dim as TKMETA_CONTROL ptr m = catalog.Find( c.TypeName )
        if m = 0 then
            out_.Push( c.Name & ": unknown control type '" & c.TypeName & "'" )
            continue for
        end if

        ' a ContextMenu names a PopupMenu of this form; a component has none
        if len( c.ContextMenu ) then
            if catalog.IsComponent( c.TypeName ) then
                out_.Push( c.Name & ": a " & m->Name & " has no context menu" )
            else
                ContextMenuProblem_( doc, c.Name, c.ContextMenu, out_ )
            end if
        end if

        ' a Badge hangs on another visual control of the form (D-B3); nothing else hangs
        if len( c.AttachTo ) orelse len( c.AttachCorner ) orelse len( c.AttachOffset ) orelse len( c.AttachOverlap ) then
            if c.TypeName <> catalog.BADGE_TYPE then
                out_.Push( c.Name & ": only a Badge attaches to a control" )
            elseif len( c.AttachTo ) then
                dim as long t = FindControl( doc, c.AttachTo )
                dim as long dx, dy
                if t < 0 then
                    out_.Push( c.Name & ": attaches to '" & c.AttachTo & "', which is not on the form" )
                elseif t = i then
                    out_.Push( c.Name & ": a Badge can't attach to itself" )
                elseif doc.Controls[t].TypeName = catalog.BADGE_TYPE then
                    out_.Push( c.Name & ": attaches to '" & c.AttachTo & "', another Badge" )
                elseif catalog.IsComponent( doc.Controls[t].TypeName ) then
                    out_.Push( c.Name & ": attaches to '" & c.AttachTo & "', a component, which is never shown" )
                end if
                if catalog.BadgeOffset( c.AttachOffset, dx, dy ) = false then out_.Push( c.Name & ": AttachOffset is two whole numbers: dx,dy" )
            end if
        end if

        ' a component (a Timer) is never shown: it belongs to the form, with nothing to lay out
        if catalog.IsComponent( c.TypeName ) then
            if len( c.Parent ) then out_.Push( c.Name & ": a " & m->Name & " belongs to the form, not inside '" & c.Parent & "'" )
            if c.Dock <> TK_DOCK_NONE then out_.Push( c.Name & ": a " & m->Name & " is never shown, so it can't be docked" )
            if c.Anchor <> TK_ANCHOR_DEFAULT then out_.Push( c.Name & ": a " & m->Name & " is never shown, so it has no anchors" )
        end if

        if len( c.Parent ) then
            dim as long pi_ = FindControl( doc, c.Parent )
            if pi_ < 0 then
                out_.Push( c.Name & ": parent '" & c.Parent & "' doesn't exist" )
            elseif pi_ >= i then
                out_.Push( c.Name & ": parent '" & c.Parent & "' must come before it in the list" )
            else
                dim as FormControl pc = doc.Controls[pi_]
                dim as TKMETA_CONTROL ptr pm = catalog.Find( pc.TypeName )
                if pm then
                    if pm->ContainerKind = TKMETA_NOT_CONTAINER then
                        out_.Push( c.Name & ": parent '" & c.Parent & "' can't hold controls" )
                    elseif pm->ContainerKind = TKMETA_CONTAINER_PAGES then
                        if (c.Page < 0) orelse (c.Page >= pc.Pages.Count( )) then
                            out_.Push( c.Name & ": page " & c.Page & " doesn't exist on '" & c.Parent & "'" )
                        end if
                    elseif c.Page >= 0 then
                        out_.Push( c.Name & ": 'page' only applies inside a tab control" )
                    end if
                end if
            end if
        elseif c.Page >= 0 then
            out_.Push( c.Name & ": 'page' only applies inside a tab control" )
        end if
        if (c.Pages.Count( ) > 0) andalso (m->ContainerKind <> TKMETA_CONTAINER_PAGES) then
            out_.Push( c.Name & ": 'pages' only applies to a tab control" )
        end if

        if m->Name = catalog.CUSTOM_TYPE then
            ' one message for either: the two are filled in one at a time, and the first mustn't be refused
            if (IsIdentifier( c.CustomType ) = false) orelse (len( c.CustomModule ) = 0) then
                out_.Push( c.Name & ": a custom control needs the name of its type and the module it's in" )
            end if
        end if

        CheckProps_( c, m, out_ )
        CheckColors_( c, m, out_ )

        ' the report a ReportViewer shows (RD4): a module whose name is a name; its member <Name>Report
        if len( c.Report ) then
            dim as ustring rstem = c.Report
            dim as long rk = instrrev( rstem, "/" )
            rstem = mid( rstem, rk + 1 )
            if c.TypeName <> "ReportViewer" then
                out_.Push( c.Name & ": only a ReportViewer shows a report" )
            elseif IsDottedName_( rstem ) = false orelse (instr( rstem, "." ) > 0) then
                out_.Push( c.Name & ": report '" & c.Report & "' is not a report module (rptOrders, ../reports/rptOrders)" )
            elseif len( c.ItemsSource ) then
                out_.Push( c.Name & ": a ReportViewer shows a designed report or its own list, not both" )
            else
                for k as long = 0 to doc.Controls.Count( ) - 1
                    if lcase( doc.Controls[k].Name ) = lcase( c.Name & "Report" ) then out_.Push( c.Name & ": its report member " & c.Name & "Report is the name of a control" )
                next
            end if
        end if

        ' data binding (B1): a field of the form's DataType, on a control that has a value to move
        if len( c.Bind ) then
            if len( m->BindKind ) = 0 then
                out_.Push( c.Name & ": a " & m->Name & " can't be bound to a field" )
            elseif IsDottedName_( c.Bind ) = false then
                out_.Push( c.Name & ": bind '" & c.Bind & "' is not a field name (Name, or Address.City)" )
            elseif len( doc.DataType ) = 0 then
                out_.Push( c.Name & ": binding to a field needs the form's DataType first" )
            end if
        end if
        CheckRules_( c, m, out_ )
        CheckList_( doc, c, m, out_ )
        CheckNav_( doc, c, m, out_ )
        ' a two-value control's second field (bind2): only with the first, and only while it applies
        if len( c.Bind2 ) then
            if len( m->Bind2Kind ) = 0 then
                out_.Push( c.Name & ": a " & m->Name & " has no second value to bind" )
            elseif len( c.Bind ) = 0 then
                out_.Push( c.Name & ": " & m->Bind2Name & " needs Bind first" )
            elseif IsDottedName_( c.Bind2 ) = false then
                out_.Push( c.Name & ": " & m->Bind2Name & " '" & c.Bind2 & "' is not a field name (Name, or Address.City)" )
            elseif catalog.Bind2Holds( c ) = false then
                out_.Push( c.Name & ": " & m->Bind2Name & " needs " & m->Bind2When )
            end if
        end if

        for each s as Setting in c.Events
            dim as TKMETA_EVENT ptr e = tkMeta_FindEvent( m, s.Key )
            if e = 0 then
                out_.Push( c.Name & ": " & m->Name & " has no event '" & s.Key & "'" )
            else
                AddHandler_( handlers, c.Name, s.Value, e->Params, doc, out_ )
            end if
        next
    next

    for each c as FormControl in doc.Controls
        dim as long kind_ = catalog.ItemsKindOf( c.TypeName )
        if (c.Items.Count( ) > 0) andalso ((kind_ = catalog.ItemsKind.ItemsNone) orelse (kind_ = catalog.ItemsKind.ItemsPages)) then
            out_.Push( c.Name & ": can't have items" )
            continue for
        end if
        dim as long prev = -1
        for each it as FormItem in c.Items
            if catalog.IsMenuKind( kind_ ) then
                if kind_ = catalog.ItemsKind.ItemsMenu then
                    if (prev < 0) andalso (it.Level <> 0) then out_.Push( c.Name & ": the first menu item must be on the bar" )
                    if (it.Level = 0) andalso (it.Text = "-") then out_.Push( c.Name & ": a separator can't be on the bar" )
                else
                    if (prev < 0) andalso (it.Level <> 0) then out_.Push( c.Name & ": the first item must be on the menu itself, not indented" )
                end if
                if (it.Level > prev + 1) orelse (it.Level > 2) then out_.Push( c.Name & ": '" & it.Text & "' is indented too far" )
                prev = it.Level
                if len( it.Key ) then
                    dim as TK_CHORD ch
                    dim as string k8 = it.Key
                    if tkKeys_Parse( k8, ch ) = false then out_.Push( c.Name & ": '" & it.Key & "' isn't a shortcut" )
                end if
            end if
            if kind_ = catalog.ItemsKind.ItemsToolbar then
                select case it.Kind
                case "", "command", "toggle", "separator", "split", "dropdown"
                case else
                    out_.Push( c.Name & ": no toolbar item kind '" & it.Kind & "'" )
                end select
            end if
            if kind_ = catalog.ItemsKind.ItemsIcons then
                select case it.Kind
                case "", "toggle", "command", "separator"
                case else
                    out_.Push( c.Name & ": no icon panel item kind '" & it.Kind & "'" )
                end select
            end if
            if (kind_ = catalog.ItemsKind.ItemsGridColumns) andalso (catalog.GridKindOk( it.Kind ) = false) then
                out_.Push( c.Name & ": no DataGrid column kind '" & it.Kind & "' (text number check combo date button link progress)" )
            end if
            if (kind_ = catalog.ItemsKind.ItemsGridColumns) andalso (len( catalog.GridAlignConst( it.Align ) ) = 0) then
                out_.Push( c.Name & ": no DataGrid column align '" & it.Align & "' (left center right, or none for the kind's)" )
            end if
            if (kind_ = catalog.ItemsKind.ItemsGridColumns) andalso (len( catalog.GridSummaryConst( it.Summary ) ) = 0) then
                out_.Push( c.Name & ": no DataGrid column summary '" & it.Summary & "' (sum count avg min max, or none)" )
            end if
            if (it.MinWidth < 0) orelse (it.Fill < 0) then out_.Push( c.Name & ": a column's MinWidth and Fill are 0 or more" )
            if len( it.Handler ) then AddHandler_( handlers, c.Name, it.Handler, "", doc, out_ )
        next
    next

    for each o as FormOrphan in doc.Orphans
        AddHandler_( handlers, "orphan", o.Handler, o.Params, doc, out_ )
    next
end sub
