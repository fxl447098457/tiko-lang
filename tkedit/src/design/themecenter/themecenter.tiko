'    License, v. 2.0. If a copy of the MPL was not distributed with this
'    file, You can obtain one at https://mozilla.org/MPL/2.0/.
'
' themecenter -- the Theme Center (docs/tkDesigner/THEMES.md, TH5): one .tktheme open for editing,
' its Dark and Light variants side by side through a switch, and a live preview of the controls
' wearing it (a theme scope, tkTheme_ApplyTo, so the rest of tkEdit keeps its own theme).
'
'   Start            a gallery of themes (shipped with tkEdit, and the user's library); one accent
'   Colours          the 23 roles of the variant shown, each from the theme or set here
'   Fonts and Shape  the font files and sizes, corner radius and border width
'   Styles           named role remaps ("Primary": Surface = @Accent), one "Role = colour" a line
'
' The dialog edits Doc. Saving is the host's: OnSave gets the dialog (tkEdit writes the file, its
' module, and the project's main), OnClose when it is to go.
#module "themecenter"

#import "std/containers"
#import "std/fs"
#import "std/strings"
#import "tkc/i18n"
#import "tkc/bundled"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkListTree"
#import "vendor/tkControls/tkButton"
#import "vendor/tkControls/tkLabel"
#import "vendor/tkControls/tkTextBox"
#import "vendor/tkControls/tkTabControl"
#import "vendor/tkControls/tkSelectBar"
#import "vendor/tkControls/tkNumericUpDown"
#import "vendor/tkControls/tkPanel"
#import "vendor/tkControls/tkCheckBox"
#import "vendor/tkControls/tkOptionButton"
#import "vendor/tkControls/tkToggle"
#import "vendor/tkControls/tkComboBox"
#import "vendor/tkControls/tkProgressBar"
#import "vendor/tkControls/tkColorPicker"
#import "vendor/tkControls/tkTheme"
#import "../model"
#import "../themefile"
#import "../colorval"
using containers
using tkApp
using tkListTree
using tkButton
using tkLabel
using tkTextBox
using tkTabControl
using tkSelectBar
using tkNumericUpDown
using tkPanel
using tkCheckBox
using tkOptionButton
using tkToggle
using tkComboBox
using tkProgressBar
using tkColorPicker
using tkTheme
using tkHost
using tkPaint
using model

const as long WIN_CX = 900
const as long WIN_CY = 600
const as long ROW_CY = 28
const as long GAP = 8
const as long PREVIEW_CX = 340

public type ThemeDialog as ThemeDialog_
public type ThemeDialogSub as sub( byval tc as ThemeDialog ptr )

public type ThemeDialog_
    Win as TK_FORM ptr
    Path as ustring                     ' the .tktheme being edited
    LibraryDir as ustring               ' the user's themes: <config>/themes
    Doc as themefile.ThemeDoc
    Tables as themefile.ThemeTables
    IsDark as boolean = true
    Loading as boolean
    SavingToLibrary as boolean          ' while OnSave writes the library copy (Path is the library's)
    OnSave as ThemeDialogSub
    Host as any ptr                     ' the host's, for its callbacks
    ForEditor as boolean                ' the host's: tkEdit's own theme, not a project's
    OnClose as ThemeDialogSub
    GalleryPaths as Array( of ustring )

    TxtName as TK_WIDGET ptr
    LblName as TK_WIDGET ptr
    SelVariant as TK_WIDGET ptr
    Tabs as TK_WIDGET ptr
    ' Start
    Gallery as TK_WIDGET ptr
    BtnUse as TK_WIDGET ptr
    LblAccent as TK_WIDGET ptr
    TxtAccent as TK_WIDGET ptr
    BtnAccentPick as TK_WIDGET ptr
    ' Colours
    Roles as TK_WIDGET ptr
    TxtRole as TK_WIDGET ptr
    BtnRolePick as TK_WIDGET ptr
    BtnRoleReset as TK_WIDGET ptr
    ' Fonts and Shape: labels and fields, in rows
    FontLabels( 0 to 6 ) as TK_WIDGET ptr
    TxtUIFile as TK_WIDGET ptr
    TxtUIBold as TK_WIDGET ptr
    NudUISize as TK_WIDGET ptr
    TxtGlyph as TK_WIDGET ptr
    TxtMono as TK_WIDGET ptr
    NudRadius as TK_WIDGET ptr
    NudBorder as TK_WIDGET ptr
    ' Styles
    StyleList as TK_WIDGET ptr
    BtnStyleAdd as TK_WIDGET ptr
    BtnStyleDel as TK_WIDGET ptr
    LblStyleName as TK_WIDGET ptr
    TxtStyleName as TK_WIDGET ptr
    LblStyleLines as TK_WIDGET ptr
    TxtStyleLines as TK_WIDGET ptr
    LblStyleProblem as TK_WIDGET ptr
    ' the preview, wearing Doc through a scope
    Preview as TK_WIDGET ptr
    PvLabel as TK_WIDGET ptr
    PvButton as TK_WIDGET ptr
    PvStyled as TK_WIDGET ptr
    PvCheck as TK_WIDGET ptr
    PvOption as TK_WIDGET ptr
    PvToggle as TK_WIDGET ptr
    PvText as TK_WIDGET ptr
    PvCombo as TK_WIDGET ptr
    PvProgress as TK_WIDGET ptr
    ' bottom
    LblContrast as TK_WIDGET ptr
    BtnLibrary as TK_WIDGET ptr
    BtnSave as TK_WIDGET ptr
    BtnClose as TK_WIDGET ptr

    declare sub Open( byval owner as TK_FORM ptr, byref themePath as const ustring, byref libraryDir_ as const ustring, _
                      byref caption as const ustring = "" )
    declare sub Close( )
    declare sub Layout( )
    declare sub FillGallery( )
    declare sub UseGallery( byval row as long )
    declare sub LoadFields( )
    declare sub LoadRole( )
    declare sub LoadStyle( )
    declare sub Refresh( )
    declare function Theme( ) as TKTHEME_COLORS
    declare function RoleOfRow( byval row as long ) as long
    declare sub SetRoleText( byref text as const ustring )
    declare sub FieldChanged( byval w as TK_WIDGET ptr )
    declare sub StyleLinesChanged( )
    declare sub AddStyle( )
    declare sub DeleteStyle( )
    declare sub PickInto( byval box as TK_WIDGET ptr )
    declare function Problems( ) as Array( of ustring )
    declare function LibraryPath( ) as ustring
    declare sub SaveToLibrary( )
end type

' ---- callbacks: the dialog is the form's Tag --------------------------------------------------------

private function DlgOf( byval w as TK_WIDGET ptr ) as ThemeDialog ptr
    dim as TK_FORM ptr f = tkForm_FromWidget( w )
    if f = 0 then return 0
    return f->Tag
end function

private sub OnText( byval h as TK_WIDGET ptr )
    dim as ThemeDialog ptr d = DlgOf( h )
    if (d <> 0) andalso (d->Loading = false) then d->FieldChanged( h )
end sub

private sub OnNumber( byval h as TK_WIDGET ptr, byval v as double )
    dim as ThemeDialog ptr d = DlgOf( h )
    if (d <> 0) andalso (d->Loading = false) then d->FieldChanged( h )
end sub

private sub OnVariant( byval h as TK_WIDGET ptr, byval oldIdx as long, byval newIdx as long )
    dim as ThemeDialog ptr d = DlgOf( h )
    if (d = 0) orelse d->Loading then exit sub
    d->IsDark = (newIdx = 0)
    d->LoadRole( )
    d->Refresh( )
end sub

private sub OnRolePick( byval h as TK_WIDGET ptr, byval row as integer )
    dim as ThemeDialog ptr d = DlgOf( h )
    if (d <> 0) andalso (d->Loading = false) then d->LoadRole( )
end sub

private sub OnStylePick( byval h as TK_WIDGET ptr, byval row as integer )
    dim as ThemeDialog ptr d = DlgOf( h )
    if (d <> 0) andalso (d->Loading = false) then
        d->LoadStyle( )
        d->Refresh( )
    end if
end sub

private sub OnButton( byval h as TK_WIDGET ptr, byval id as long )
    dim as ThemeDialog ptr d = DlgOf( h )
    if d = 0 then exit sub
    select case h
    case d->BtnUse        : d->UseGallery( tkListTree_GetCurSel( d->Gallery ) )
    case d->BtnAccentPick : d->PickInto( d->TxtAccent )
    case d->BtnRolePick   : d->PickInto( d->TxtRole )
    case d->BtnRoleReset  : d->SetRoleText( "" )
    case d->BtnStyleAdd   : d->AddStyle( )
    case d->BtnStyleDel   : d->DeleteStyle( )
    case d->BtnSave       : if d->OnSave then d->OnSave( d )
    case d->BtnLibrary    : d->SaveToLibrary( )
    case d->BtnClose      : if d->OnClose then d->OnClose( d )
    end select
end sub

' A role row: the default row, then a swatch of the role's colour in the variant shown.
private sub PaintRole( byval pi as TKLISTTREE_PAINTINFO ptr )
    tkListTree_PaintRowDefault( pi )
    dim as ThemeDialog ptr d = DlgOf( pi->hList )
    if d = 0 then exit sub
    dim as long r = d->RoleOfRow( pi->itemID )
    if r < 0 then exit sub
    dim as TKTHEME_COLORS t = d->Theme( )
    dim as long s = tkHost_Scale( pi->hList->pHost, 4 ), w_ = tkHost_Scale( pi->hList->pHost, 36 )
    dim as TKRECT rc = pi->rc
    rc.left = rc.right - w_ - s
    rc.right -= s
    rc.top += s
    rc.bottom -= s
    pi->b->SetBackColor( tkTheme_Role( t, r ) or &hFF000000ul )
    pi->b->PaintRect( @rc )
end sub

' ---- building ---------------------------------------------------------------------------------------

private function MakeButton_( byval parent as TK_WIDGET ptr, byref text as const ustring ) as TK_WIDGET ptr
    dim as TK_WIDGET ptr b = tkButton_Create( parent, 1 )
    dim as ustring t = text
    tkButton_SetText( b, t )
    tkButton_SetClickCallback( b, @OnButton )
    return b
end function

private function MakeText_( byval parent as TK_WIDGET ptr, byval multi as boolean = false ) as TK_WIDGET ptr
    dim as TK_WIDGET ptr t = tkTextBox_Create( parent, 1, multi )
    tkTextBox_SetChangeCallback( t, @OnText )
    return t
end function

private function MakeLabel_( byval parent as TK_WIDGET ptr, byref text as const ustring ) as TK_WIDGET ptr
    dim as TK_WIDGET ptr l = tkLabel_Create( parent, 1 )
    tkLabel_SetText( l, text )
    return l
end function

private function MakeNumber_( byval parent as TK_WIDGET ptr, byval lo as double, byval hi as double ) as TK_WIDGET ptr
    dim as TK_WIDGET ptr n = tkNumericUpDown_Create( parent, 1 )
    tkNumericUpDown_SetRange( n, lo, hi )
    tkNumericUpDown_SetValueChangedCallback( n, @OnNumber )
    return n
end function

private function MakeList_( byval parent as TK_WIDGET ptr ) as TK_WIDGET ptr
    dim as TK_WIDGET ptr l = tkListTree_Create( parent, 1 )
    tkListTree_SetPaintCallback( l, @tkListTree_PaintRowDefault )
    return l
end function

sub ThemeDialog_.Open( byval owner as TK_FORM ptr, byref themePath as const ustring, byref libraryDir_ as const ustring, _
                       byref caption as const ustring = "" )
    Path = themePath
    LibraryDir = libraryDir_
    dim as ustring none, e
    dim as ustring text = fs.ReadAllText( themePath ).ValueOr( none )
    if (len( text ) = 0) orelse (themefile.Parse( text, Doc, e ) = false) then
        dim as themefile.ThemeDoc fresh
        fresh.Name = "Default"
        Doc = fresh
    end if

    dim as ustring title = caption
    if len( title ) = 0 then title = i18n.Tr( "designer.theme_title", "Project Theme" )
    dim as single sc = 0
    if owner then sc = tkForm_Host( owner )->fScaleForced
    Win = tkApp_NewForm( title, WIN_CX, WIN_CY, owner, sc )
    if Win = 0 then exit sub
    Win->Tag = @this
    dim as TK_WIDGET ptr root_ = tkForm_Widget( Win )
    Loading = true

    LblName = MakeLabel_( root_, i18n.Tr( "designer.name", "Name" ) )
    TxtName = MakeText_( root_ )
    SelVariant = tkSelectBar_Create( root_, 1 )
    tkSelectBar_AddPanel( SelVariant, i18n.Tr( "designer.theme_dark", "Dark" ) )
    tkSelectBar_AddPanel( SelVariant, i18n.Tr( "designer.theme_light", "Light" ) )
    tkSelectBar_SetCurSel( SelVariant, 0 )
    tkSelectBar_SetSelChangeCallback( SelVariant, @OnVariant )

    Tabs = tkTabControl_Create( root_, 1 )
    dim as TK_WIDGET ptr pStart = tkTabControl_GetPage( Tabs, tkTabControl_AddPage( Tabs, i18n.Tr( "designer.theme_start", "Start" ) ) )
    dim as TK_WIDGET ptr pColours = tkTabControl_GetPage( Tabs, tkTabControl_AddPage( Tabs, i18n.Tr( "designer.theme_colours", "Colours" ) ) )
    dim as TK_WIDGET ptr pFonts = tkTabControl_GetPage( Tabs, tkTabControl_AddPage( Tabs, i18n.Tr( "designer.theme_fonts", "Fonts and Shape" ) ) )
    dim as TK_WIDGET ptr pStyles = tkTabControl_GetPage( Tabs, tkTabControl_AddPage( Tabs, i18n.Tr( "designer.theme_styles", "Styles" ) ) )

    Gallery = MakeList_( pStart )
    BtnUse = MakeButton_( pStart, i18n.Tr( "designer.theme_use", "Use This Theme" ) )
    LblAccent = MakeLabel_( pStart, i18n.Tr( "designer.theme_accent", "Accent" ) )
    TxtAccent = MakeText_( pStart )
    BtnAccentPick = MakeButton_( pStart, i18n.Tr( "designer.theme_pick", "Pick..." ) )

    Roles = tkListTree_Create( pColours, 1 )
    tkListTree_SetPaintCallback( Roles, @PaintRole )
    tkListTree_SetSelChangeCallback( Roles, @OnRolePick )
    for r as long = 0 to TKROLE_COUNT - 1
        tkListTree_AddString( Roles, tkTheme_RoleName( r ), r )
    next
    TxtRole = MakeText_( pColours )
    BtnRolePick = MakeButton_( pColours, i18n.Tr( "designer.theme_pick", "Pick..." ) )
    BtnRoleReset = MakeButton_( pColours, i18n.Tr( "designer.theme_reset", "Reset" ) )

    FontLabels( 0 ) = MakeLabel_( pFonts, i18n.Tr( "designer.theme_ui_font", "UI font" ) )
    FontLabels( 1 ) = MakeLabel_( pFonts, i18n.Tr( "designer.theme_bold_font", "Bold font" ) )
    FontLabels( 2 ) = MakeLabel_( pFonts, i18n.Tr( "designer.theme_size", "Size" ) )
    FontLabels( 3 ) = MakeLabel_( pFonts, i18n.Tr( "designer.theme_glyph_font", "Glyph font" ) )
    FontLabels( 4 ) = MakeLabel_( pFonts, i18n.Tr( "designer.theme_mono_font", "Mono font" ) )
    FontLabels( 5 ) = MakeLabel_( pFonts, i18n.Tr( "designer.theme_corner", "Corner radius" ) )
    FontLabels( 6 ) = MakeLabel_( pFonts, i18n.Tr( "designer.theme_border", "Border width" ) )
    TxtUIFile = MakeText_( pFonts )
    TxtUIBold = MakeText_( pFonts )
    NudUISize = MakeNumber_( pFonts, 0, 72 )
    TxtGlyph = MakeText_( pFonts )
    TxtMono = MakeText_( pFonts )
    NudRadius = MakeNumber_( pFonts, -1, 40 )
    NudBorder = MakeNumber_( pFonts, -1, 10 )

    StyleList = MakeList_( pStyles )
    tkListTree_SetSelChangeCallback( StyleList, @OnStylePick )
    BtnStyleAdd = MakeButton_( pStyles, i18n.Tr( "designer.item_add", "Add" ) )
    BtnStyleDel = MakeButton_( pStyles, i18n.Tr( "designer.item_remove", "Remove" ) )
    LblStyleName = MakeLabel_( pStyles, i18n.Tr( "designer.name", "Name" ) )
    TxtStyleName = MakeText_( pStyles )
    LblStyleLines = MakeLabel_( pStyles, i18n.Tr( "designer.theme_style_roles", "One role a line: Surface = @Accent" ) )
    TxtStyleLines = MakeText_( pStyles, true )
    LblStyleProblem = MakeLabel_( pStyles, "" )

    Preview = tkPanel_Create( root_, 1 )
    PvLabel = MakeLabel_( Preview, i18n.Tr( "designer.theme_preview", "Preview" ) )
    PvButton = tkButton_Create( Preview, 1 )
    tkButton_SetText( PvButton, i18n.Tr( "designer.theme_button", "Button" ) )
    PvStyled = tkButton_Create( Preview, 1 )
    PvCheck = tkCheckBox_Create( Preview, 1 )
    tkCheckBox_SetText( PvCheck, i18n.Tr( "designer.theme_check", "Check box" ) )
    tkCheckBox_SetChecked( PvCheck, true )
    PvOption = tkOptionButton_Create( Preview, 1 )
    tkOptionButton_SetText( PvOption, i18n.Tr( "designer.theme_option", "Option" ) )
    tkOptionButton_SetChecked( PvOption, true )
    PvToggle = tkToggle_Create( Preview, 1 )
    tkToggle_SetChecked( PvToggle, true )
    PvText = tkTextBox_Create( Preview, 1 )
    tkTextBox_SetText( PvText, i18n.Tr( "designer.theme_text", "Text" ) )
    PvCombo = tkComboBox_Create( Preview, 1 )
    tkComboBox_AddItem( PvCombo, i18n.Tr( "designer.theme_option", "Option" ) )
    tkComboBox_SetCurSel( PvCombo, 0 )
    PvProgress = tkProgressBar_Create( Preview, 1 )
    tkProgressBar_SetRange( PvProgress, 0, 100 )
    tkProgressBar_SetPos( PvProgress, 60 )

    LblContrast = MakeLabel_( root_, "" )
    BtnLibrary = MakeButton_( root_, i18n.Tr( "designer.theme_save_library", "Save to Library" ) )
    BtnSave = MakeButton_( root_, i18n.Tr( "designer.theme_save", "Save" ) )
    BtnClose = MakeButton_( root_, i18n.Tr( "designer.theme_close", "Close" ) )

    tkForm_OnSize( Win, sub( byval f as TK_FORM ptr, byval cx as long, byval cy as long )
        cast( ThemeDialog ptr, f->Tag )->Layout( )
    end sub )
    this.FillGallery( )
    Loading = false
    this.LoadFields( )
    tkForm_Show( Win )
    this.Layout( )
    this.Refresh( )
end sub

sub ThemeDialog_.Close( )
    if Win then tkForm_Destroy( Win )
    Win = 0
end sub

sub ThemeDialog_.Layout( )
    if Win = 0 then exit sub
    dim as TK_WIDGET ptr root_ = tkForm_Widget( Win )
    dim as long g = tkForm_Scale( Win, GAP ), rh = tkForm_Scale( Win, ROW_CY ), cw = root_->cw, ch = root_->ch
    dim as long pvW = tkForm_Scale( Win, PREVIEW_CX ), bw = tkForm_Scale( Win, 120 )
    tkWidget_SetPos( LblName, g, g, tkForm_Scale( Win, 60 ), rh )
    tkWidget_SetPos( TxtName, g + tkForm_Scale( Win, 64 ), g, tkForm_Scale( Win, 220 ), rh )
    tkWidget_SetPos( SelVariant, g + tkForm_Scale( Win, 300 ), g, tkForm_Scale( Win, 180 ), rh )
    dim as long top = 2 * g + rh, bottomY = ch - g - rh
    dim as long tabsW = cw - pvW - 3 * g, tabsH = bottomY - g - top
    tkWidget_SetPos( Tabs, g, top, tabsW, tabsH )
    tkWidget_SetPos( Preview, cw - pvW - g, top, pvW, tabsH )
    tkWidget_SetPos( BtnClose, cw - g - bw, bottomY, bw, rh )
    tkWidget_SetPos( BtnSave, cw - 2 * (g + bw), bottomY, bw, rh )
    tkWidget_SetPos( BtnLibrary, cw - 3 * (g + bw), bottomY, bw, rh )
    tkWidget_SetPos( LblContrast, g, bottomY, cw - 3 * (g + bw) - 2 * g, rh )

    ' the pages: their own coordinates, the tab control's size less its tabs
    dim as long pw = tabsW, ph = tabsH - tkTabControl_GetTabHeight( Tabs )
    dim as long sw = tkForm_Scale( Win, 100 )
    tkWidget_SetPos( Gallery, g, g, pw - 2 * g, ph - 4 * g - 2 * rh )
    tkWidget_SetPos( BtnUse, g, ph - 2 * g - 2 * rh - g \ 2, tkForm_Scale( Win, 160 ), rh )
    tkWidget_SetPos( LblAccent, g, ph - g - rh, sw, rh )
    tkWidget_SetPos( TxtAccent, g + sw, ph - g - rh, tkForm_Scale( Win, 120 ), rh )
    tkWidget_SetPos( BtnAccentPick, 2 * g + sw + tkForm_Scale( Win, 120 ), ph - g - rh, sw, rh )

    tkWidget_SetPos( Roles, g, g, pw - 2 * g, ph - 3 * g - rh )
    tkWidget_SetPos( TxtRole, g, ph - g - rh, tkForm_Scale( Win, 140 ), rh )
    tkWidget_SetPos( BtnRolePick, 2 * g + tkForm_Scale( Win, 140 ), ph - g - rh, sw, rh )
    tkWidget_SetPos( BtnRoleReset, 3 * g + tkForm_Scale( Win, 140 ) + sw, ph - g - rh, sw, rh )

    dim as long lw = tkForm_Scale( Win, 120 ), fw = pw - lw - 3 * g, nw = tkForm_Scale( Win, 90 )
    dim as TK_WIDGET ptr fields( 0 to 6 ) = { TxtUIFile, TxtUIBold, NudUISize, TxtGlyph, TxtMono, NudRadius, NudBorder }
    for i as long = 0 to 6
        dim as long y = g + i * (rh + g)
        tkWidget_SetPos( FontLabels( i ), g, y, lw, rh )
        dim as boolean isNumber = (i = 2) orelse (i = 5) orelse (i = 6)
        tkWidget_SetPos( fields( i ), 2 * g + lw, y, iif( isNumber, nw, fw ), rh )
    next

    dim as long lsw = tkForm_Scale( Win, 160 ), rx = 2 * g + lsw, rw = pw - rx - g
    tkWidget_SetPos( StyleList, g, g, lsw, ph - 3 * g - rh )
    tkWidget_SetPos( BtnStyleAdd, g, ph - g - rh, (lsw - g) \ 2, rh )
    tkWidget_SetPos( BtnStyleDel, g + (lsw - g) \ 2 + g, ph - g - rh, (lsw - g) \ 2, rh )
    tkWidget_SetPos( LblStyleName, rx, g, tkForm_Scale( Win, 60 ), rh )
    tkWidget_SetPos( TxtStyleName, rx + tkForm_Scale( Win, 64 ), g, rw - tkForm_Scale( Win, 64 ), rh )
    tkWidget_SetPos( LblStyleLines, rx, 2 * g + rh, rw, rh )
    tkWidget_SetPos( TxtStyleLines, rx, 3 * g + 2 * rh, rw, ph - 6 * g - 3 * rh )
    tkWidget_SetPos( LblStyleProblem, rx, ph - g - rh, rw, rh )

    ' the preview: one control a row
    dim as TK_WIDGET ptr pv( 0 to 8 ) = { PvLabel, PvButton, PvStyled, PvCheck, PvOption, PvToggle, PvText, PvCombo, PvProgress }
    dim as long px = 2 * g, pwid = pvW - 4 * g
    for i as long = 0 to 8
        dim as long w_ = pwid
        if pv( i ) = PvToggle then w_ = tkForm_Scale( Win, 48 )
        tkWidget_SetPos( pv( i ), px, 2 * g + i * (rh + g + g \ 2), w_, rh )
    next
end sub

' ---- the gallery ------------------------------------------------------------------------------------

' Shipped themes (tkEdit's bundled themes/*.tktheme) then the user's library, by name.
sub ThemeDialog_.FillGallery( )
    tkListTree_Clear( Gallery )
    GalleryPaths.Clear( )
    dim as Array( of ustring ) paths
    for each nm as ustring in bundled.Names( "themes" )
        if lcase( right( nm, 8 ) ) = ".tktheme" then paths.Push( bundled.PREFIX & nm )
    next
    if len( LibraryDir ) andalso fs.IsDir( LibraryDir ) then
        for each r as fs.DirEntryResult in fs.ReadDir( LibraryDir )
            if r.IsOk( ) andalso r.Value( ).IsFile( ) andalso (lcase( right( r.Value( ).Name( ), 8 ) ) = ".tktheme") then paths.Push( r.Value( ).Path( ) )
        next
    end if
    for each p as ustring in paths
        dim as ustring none, e
        dim as ustring text = bundled.ReadAllText( p ).ValueOr( none )
        dim as themefile.ThemeDoc d
        if (len( text ) = 0) orelse (themefile.Parse( text, d, e ) = false) then continue for
        tkListTree_AddString( Gallery, d.Name, GalleryPaths.Count( ) )
        GalleryPaths.Push( p )
    next
    if tkListTree_GetCount( Gallery ) then tkListTree_SetCurSel( Gallery, 0 )
end sub

' The gallery's theme becomes the one being edited (the file it is saved to stays the same).
sub ThemeDialog_.UseGallery( byval row as long )
    if (row < 0) orelse (row >= GalleryPaths.Count( )) then exit sub
    dim as ustring none, e
    dim as ustring text = bundled.ReadAllText( GalleryPaths[row] ).ValueOr( none )
    dim as themefile.ThemeDoc d
    if themefile.Parse( text, d, e ) = false then exit sub
    Doc = d
    this.LoadFields( )
    this.Refresh( )
end sub

' ---- Doc into the fields, and back ---------------------------------------------------------------------

private function NumText_( byval v as long ) as ustring
    return str( v )
end function

sub ThemeDialog_.LoadFields( )
    Loading = true
    tkTextBox_SetText( TxtName, Doc.Name )
    tkTextBox_SetText( TxtAccent, Doc.Accent )
    tkTextBox_SetText( TxtUIFile, Doc.UIFile )
    tkTextBox_SetText( TxtUIBold, Doc.UIBold )
    tkNumericUpDown_SetValue( NudUISize, Doc.UISize )
    tkTextBox_SetText( TxtGlyph, Doc.GlyphFile )
    tkTextBox_SetText( TxtMono, Doc.MonoFile )
    tkNumericUpDown_SetValue( NudRadius, Doc.CornerRadius )
    tkNumericUpDown_SetValue( NudBorder, Doc.BorderWidth )
    tkListTree_Clear( StyleList )
    for i as long = 0 to Doc.Styles.Count( ) - 1
        tkListTree_AddString( StyleList, Doc.Styles[i].Name, i )
    next
    if Doc.Styles.Count( ) then tkListTree_SetCurSel( StyleList, 0 )
    Loading = false
    this.LoadRole( )
    this.LoadStyle( )
end sub

function ThemeDialog_.RoleOfRow( byval row as long ) as long
    if (row < 0) orelse (row >= TKROLE_COUNT) then return -1
    return row
end function

' The role's own value in the variant shown, or "" when the theme gives it.
sub ThemeDialog_.LoadRole( )
    dim as long r = this.RoleOfRow( tkListTree_GetCurSel( Roles ) )
    Loading = true
    if r < 0 then
        tkTextBox_SetText( TxtRole, "" )
    else
        dim as long i
        if IsDark then i = FindSetting( Doc.Dark.Roles, tkTheme_RoleName( r ) ) else i = FindSetting( Doc.Light.Roles, tkTheme_RoleName( r ) )
        dim as ustring v
        if i >= 0 then
            if IsDark then v = Doc.Dark.Roles[i].Value else v = Doc.Light.Roles[i].Value
        end if
        tkTextBox_SetText( TxtRole, v )
    end if
    Loading = false
end sub

private function StyleText_( byref st as themefile.ThemeStyle ) as ustring
    dim as ustring o
    for r as long = 0 to TKROLE_COUNT - 1
        dim as long i = FindSetting( st.Roles, tkTheme_RoleName( r ) )
        if i < 0 then continue for
        dim as ustring v = st.Roles[i].Value
        dim as long bar = instr( v, "|" )
        if bar then v = left( v, bar - 1 ) & " | " & mid( v, bar + 1 )
        o &= st.Roles[i].Key & " = " & v & chr( 10 )
    next
    return o
end function

sub ThemeDialog_.LoadStyle( )
    dim as long i = tkListTree_GetCurSel( StyleList )
    Loading = true
    if (i < 0) orelse (i >= Doc.Styles.Count( )) then
        tkTextBox_SetText( TxtStyleName, "" )
        tkTextBox_SetText( TxtStyleLines, "" )
    else
        tkTextBox_SetText( TxtStyleName, Doc.Styles[i].Name )
        tkTextBox_SetText( TxtStyleLines, StyleText_( Doc.Styles[i] ) )
    end if
    tkLabel_SetText( LblStyleProblem, "" )
    Loading = false
end sub

' The role text box's value into the variant shown: a colour sets the role, "" gives it back.
sub ThemeDialog_.SetRoleText( byref text as const ustring )
    dim as long r = this.RoleOfRow( tkListTree_GetCurSel( Roles ) )
    if r < 0 then exit sub
    dim as ustring nm = tkTheme_RoleName( r )
    dim as ustring t = trim( text )
    if len( t ) = 0 then
        dim as long i
        if IsDark then
            i = FindSetting( Doc.Dark.Roles, nm )
            if i >= 0 then Doc.Dark.Roles.Remove( i )
        else
            i = FindSetting( Doc.Light.Roles, nm )
            if i >= 0 then Doc.Light.Roles.Remove( i )
        end if
        if len( tkTextBox_GetText( TxtRole ) ) then
            Loading = true
            tkTextBox_SetText( TxtRole, "" )
            Loading = false
        end if
    else
        dim as ustring c = colorval.Canonical( t, false, false )
        if len( c ) = 0 then exit sub                  ' not a colour yet: typing goes on
        if (nm = "Window") andalso (len( c ) = 9) then c = left( c, 7 )
        if IsDark then PutSetting( Doc.Dark.Roles, nm, c ) else PutSetting( Doc.Light.Roles, nm, c )
    end if
    this.Refresh( )
end sub

private function FieldText_( byval w as TK_WIDGET ptr ) as ustring
    return trim( tkTextBox_GetText( w ) )
end function

sub ThemeDialog_.FieldChanged( byval w as TK_WIDGET ptr )
    select case w
    case TxtName : Doc.Name = FieldText_( TxtName )
    case TxtAccent
        dim as ustring t = FieldText_( TxtAccent )
        if len( t ) = 0 then
            Doc.Accent = ""
        else
            dim as ustring c = colorval.Canonical( t, false, false )
            if len( c ) = 0 then exit sub
            Doc.Accent = c
        end if
    case TxtRole : this.SetRoleText( tkTextBox_GetText( TxtRole ) ) : exit sub
    case TxtUIFile : Doc.UIFile = FieldText_( TxtUIFile )
    case TxtUIBold : Doc.UIBold = FieldText_( TxtUIBold )
    case TxtGlyph : Doc.GlyphFile = FieldText_( TxtGlyph )
    case TxtMono : Doc.MonoFile = FieldText_( TxtMono )
    case NudUISize : Doc.UISize = clng( tkNumericUpDown_GetValue( NudUISize ) )
    case NudRadius : Doc.CornerRadius = clng( tkNumericUpDown_GetValue( NudRadius ) )
    case NudBorder : Doc.BorderWidth = clng( tkNumericUpDown_GetValue( NudBorder ) )
    case TxtStyleName
        dim as long i = tkListTree_GetCurSel( StyleList )
        if (i < 0) orelse (i >= Doc.Styles.Count( )) then exit sub
        Doc.Styles[i].Name = FieldText_( TxtStyleName )
        tkListTree_SetText( StyleList, i, Doc.Styles[i].Name )
    case TxtStyleLines : this.StyleLinesChanged( ) : exit sub
    end select
    this.Refresh( )
end sub

' "Role = colour" lines into the selected style. A line that isn't one is reported, not kept.
sub ThemeDialog_.StyleLinesChanged( )
    dim as long si = tkListTree_GetCurSel( StyleList )
    if (si < 0) orelse (si >= Doc.Styles.Count( )) then exit sub
    dim as ustring text = tkTextBox_GetText( TxtStyleLines ) & chr( 10 )
    dim as Array( of Setting ) roles
    dim as ustring problem
    dim as long at = 1, n = 0
    do
        dim as long e = instr( at, text, chr( 10 ) )
        if e = 0 then exit do
        dim as ustring l = trim( mid( text, at, e - at ), any !" \t\r" )
        at = e + 1
        n += 1
        if len( l ) = 0 then continue do
        dim as long eq = instr( l, "=" )
        dim as ustring k = trim( left( l, eq - 1 ) ), v = trim( mid( l, eq + 1 ) )
        if (eq = 0) orelse (tkTheme_RoleByName( k ) < 0) then
            if len( problem ) = 0 then problem = n & ": '" & k & "' " & i18n.Tr( "designer.theme_not_role", "is not a role" )
            continue do
        end if
        dim as long bar = instr( v, "|" )
        if bar then v = trim( left( v, bar - 1 ) ) & "|" & trim( mid( v, bar + 1 ) )
        dim as ustring c = colorval.Canonical( v )
        if len( c ) = 0 then
            if len( problem ) = 0 then problem = n & ": " & colorval.Explain( v )
            continue do
        end if
        PutSetting( roles, k, c )
    loop
    Doc.Styles[si].Roles = roles
    tkLabel_SetText( LblStyleProblem, problem )
    this.Refresh( )
end sub

sub ThemeDialog_.AddStyle( )
    dim as long k = Doc.Styles.Count( ) + 1
    dim as ustring nm
    do
        nm = "Style" & k
        dim as boolean taken = false
        for each st as themefile.ThemeStyle in Doc.Styles
            if lcase( st.Name ) = lcase( nm ) then taken = true
        next
        if taken = false then exit do
        k += 1
    loop
    dim as themefile.ThemeStyle st
    st.Name = nm
    PutSetting( st.Roles, "Surface", "@Accent" )
    PutSetting( st.Roles, "Text", "@SelectedText" )
    Doc.Styles.Push( st )
    tkListTree_AddString( StyleList, nm, Doc.Styles.Count( ) - 1 )
    tkListTree_SetCurSel( StyleList, Doc.Styles.Count( ) - 1 )
    this.LoadStyle( )
    this.Refresh( )
end sub

sub ThemeDialog_.DeleteStyle( )
    dim as long i = tkListTree_GetCurSel( StyleList )
    if (i < 0) orelse (i >= Doc.Styles.Count( )) then exit sub
    Doc.Styles.Remove( i )
    this.LoadFields( )
    this.Refresh( )
end sub

' The colour picker over the box's colour; what it gives goes into the box (and so into Doc).
sub ThemeDialog_.PickInto( byval box as TK_WIDGET ptr )
    dim as ulong c = &hFF808080ul
    colorval.ParseHex( FieldText_( box ), c )
    dim as ubyte a = c shr 24
    if tkColorPicker_DoModal( tkForm_Widget( Win ), c, a ) then
        tkTextBox_SetText( box, colorval.HexText( (c and &hFFFFFFul) or (culng( a ) shl 24) ) )
        this.FieldChanged( box )
    end if
end sub

' ---- the preview and the contrast line --------------------------------------------------------------------

function ThemeDialog_.Theme( ) as TKTHEME_COLORS
    return themefile.Resolve( Doc, IsDark )
end function

' What a program would see: Doc through a scope on the preview, the selected style on PvStyled.
sub ThemeDialog_.Refresh( )
    if Win = 0 then exit sub
    dim as TKTHEME_COLORS t = this.Theme( )
    dim as TKTHEME_SHAPE sh = themefile.ShapeOf( Doc )
    Tables.Build( Doc )
    tkTheme_ApplyTo( Preview, t, @sh, Tables.StylePtr( ), Tables.Styles.Count( ), Tables.TypePtr( ), Tables.Types.Count( ) )
    dim as long si = tkListTree_GetCurSel( StyleList )
    if (si >= 0) andalso (si < Doc.Styles.Count( )) then
        tkButton_SetText( PvStyled, Doc.Styles[si].Name )
        tkTheme_SetRecipeNamed( PvStyled, Doc.Styles[si].Name, 0, 0 )
        tkWidget_Show( PvStyled, true )
    else
        tkTheme_ClearRecipe( PvStyled )
        tkWidget_Show( PvStyled, false )
    end if
    dim as Array( of ustring ) faults
    themefile.ContrastFaults( t, faults )
    if faults.Count( ) = 0 then
        tkLabel_SetText( LblContrast, i18n.Tr( "designer.theme_contrast_ok", "Contrast: every pair passes AA" ) )
    elseif faults.Count( ) = 1 then
        tkLabel_SetText( LblContrast, faults[0] )
    else
        tkLabel_SetText( LblContrast, faults[0] & " (" & strings.Format( i18n.Tr( "designer.theme_contrast_more", "{} more" ), faults.Count( ) - 1 ) & ")" )
    end if
    tkWidget_Invalidate( Roles )
    tkWidget_Invalidate( tkForm_Widget( Win ) )
end sub

' What would stop the program building from Doc.
function ThemeDialog_.Problems( ) as Array( of ustring )
    dim as Array( of ustring ) p
    themefile.Check( Doc, p )
    return p
end function

' <library>/<name>.tktheme, the name made a file name.
function ThemeDialog_.LibraryPath( ) as ustring
    dim as ustring f
    for i as long = 1 to len( Doc.Name )
        dim as ustring ch = mid( Doc.Name, i, 1 )
        if instr( "\/:*?""<>|", ch ) = 0 then f &= ch
    next
    if len( trim( f ) ) = 0 then f = "Theme"
    return fs.PathJoin( LibraryDir, trim( f ) & ".tktheme" )
end function

' A copy in the user's library, by the theme's name, through OnSave with Path pointing there; the
' gallery then lists it. The theme being edited is still saved where it came from.
sub ThemeDialog_.SaveToLibrary( )
    if (OnSave = 0) orelse (len( LibraryDir ) = 0) then exit sub
    dim as ustring keep = Path
    Path = this.LibraryPath( )
    SavingToLibrary = true
    OnSave( @this )
    SavingToLibrary = false
    Path = keep
    dim as long sel = tkListTree_GetCurSel( Gallery )
    this.FillGallery( )
    if sel >= 0 then tkListTree_SetCurSel( Gallery, sel )
end sub
