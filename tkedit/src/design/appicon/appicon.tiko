'
' appicon -- the program's icon (the Resource Center's "Application icon"): an image made into a
' Windows .ico, the .rc that builds it into the exe, and the tiko.toml line that names that .rc.
'
'   appResources/app.ico     16, 24, 32, 48 and 64 px as 32-bit DIBs, 256 px as a PNG
'   appResources/app.rc      IMAGE_AAA_MAINICON ICON "app.ico" -- the name sorts first, so Windows
'                            takes it as the exe's icon and SDL as every window's (a form's own
'                            Icon property still sets that window's)
'   tiko.toml                resources = ["appResources/app.rc"] in [target.<t>.windows]
'
' No window is opened here.
#module "appicon"

#import "std/containers"
#import "std/fs"
#import "vendor/tkControls/tkHost"
using containers
using tkHost

public const as string ICO_FILE = "app.ico"
public const as string RC_FILE = "app.rc"

' the sizes written, smallest first (Windows takes the nearest); the last one is a PNG
const as long N_SIZES = 6
dim shared as long gSizes_( 0 to N_SIZES - 1 ) = { 16, 24, 32, 48, 64, 256 }

private sub U8_( byref b as Array( of ubyte ), byval v as ulong )
    b.Push( cubyte( v and &hFF ) )
end sub

private sub U16_( byref b as Array( of ubyte ), byval v as ulong )
    U8_( b, v ) : U8_( b, v shr 8 )
end sub

private sub U32_( byref b as Array( of ubyte ), byval v as ulong )
    U16_( b, v ) : U16_( b, v shr 16 )
end sub

' src (ARGB8888) scaled to fit a transparent sz x sz square, centred. Large steps are halved first:
' one linear pass from a photo to 16 px would sample only a few of its pixels.
private function Square_( byval src as SDL_Surface ptr, byval sz as long ) as SDL_Surface ptr
    dim as SDL_Surface ptr dst = SDL_CreateSurface( sz, sz, SDL_PIXELFORMAT_ARGB8888 )
    if dst = 0 then return 0
    SDL_FillSurfaceRect( dst, 0, 0 )
    dim as long w = src->w, h = src->h
    dim as long dw = sz, dh = sz
    if w > h then dh = (h * sz + w \ 2) \ w else dw = (w * sz + h \ 2) \ h
    if dw < 1 then dw = 1
    if dh < 1 then dh = 1
    dim as SDL_Surface ptr cur = src
    while (cur->w \ 2 >= dw) andalso (cur->h \ 2 >= dh)
        dim as SDL_Surface ptr half = SDL_ScaleSurface( cur, cur->w \ 2, cur->h \ 2, SDL_SCALEMODE_LINEAR )
        if cur <> src then SDL_DestroySurface( cur )
        if half = 0 then
            SDL_DestroySurface( dst )
            return 0
        end if
        cur = half
    wend
    SDL_SetSurfaceBlendMode( cur, SDL_BLENDMODE_NONE )       ' its alpha copied, not blended onto nothing
    dim as SDL_Rect r
    r.x = (sz - dw) \ 2 : r.y = (sz - dh) \ 2 : r.w = dw : r.h = dh
    SDL_BlitSurfaceScaled( cur, 0, dst, @r, SDL_SCALEMODE_LINEAR )
    if cur <> src then SDL_DestroySurface( cur )
    return dst
end function

' One icon image as a 32-bit DIB: its header (height doubled: colour, then the AND mask), the
' pixels bottom-up in BGRA -- ARGB8888 is that in memory -- and an all-clear mask (alpha decides).
private sub Dib_( byval s as SDL_Surface ptr, byref out_ as Array( of ubyte ) )
    dim as long sz = s->w
    dim as long maskRow = ((sz + 31) \ 32) * 4
    U32_( out_, 40 ) : U32_( out_, sz ) : U32_( out_, sz * 2 )
    U16_( out_, 1 ) : U16_( out_, 32 )
    U32_( out_, 0 ) : U32_( out_, sz * sz * 4 + maskRow * sz )
    U32_( out_, 0 ) : U32_( out_, 0 ) : U32_( out_, 0 ) : U32_( out_, 0 )
    SDL_LockSurface( s )
    for y as long = sz - 1 to 0 step -1
        dim as ubyte ptr row = cast( ubyte ptr, s->pixels ) + y * s->pitch
        for x as long = 0 to sz * 4 - 1
            out_.Push( row[x] )
        next
    next
    SDL_UnlockSurface( s )
    for i as long = 1 to maskRow * sz
        out_.Push( 0 )
    next
end sub

' One icon image as PNG bytes.
private function Png_( byval s as SDL_Surface ptr, byref out_ as Array( of ubyte ) ) as boolean
    dim as SDL_IOStream ptr io = SDL_IOFromDynamicMem( )
    if io = 0 then return false
    dim as boolean ok = IMG_SavePNG_IO( s, io, false )
    if ok then
        dim as longint n = SDL_GetIOSize( io )
        dim as ubyte ptr p = SDL_GetPointerProperty( SDL_GetIOProperties( io ), SDL_PROP_IOSTREAM_DYNAMIC_MEMORY_POINTER, 0 )
        if (p = 0) orelse (n <= 0) then
            ok = false
        else
            for i as longint = 0 to n - 1
                out_.Push( p[i] )
            next
        end if
    end if
    SDL_CloseIO( io )
    return ok
end function

' src (an image file: any format SDL_image reads) as the Windows icon ico. An .ico is copied as it
' is. "" when written, else why not.
public function MakeIco( byref src as const ustring, byref ico as const ustring ) as ustring
    if fs.IsFile( src ) = false then return fs.PathFileName( src ) & ": not there"
    if lcase( fs.PathExtension( src ) ) = ".ico" then
        if fs.CopyFile( src, ico, true ).IsOk( ) = false then return fs.PathFileName( ico ) & ": can't be written"
        return ""
    end if
    dim as ustring path = src
    dim as SDL_Surface ptr raw = tkHost_LoadSurface( path )
    if raw = 0 then return fs.PathFileName( src ) & ": not an image this can read"
    dim as SDL_Surface ptr img = SDL_ConvertSurface( raw, SDL_PIXELFORMAT_ARGB8888 )
    SDL_DestroySurface( raw )
    if img = 0 then return fs.PathFileName( src ) & ": can't be converted"
    dim as long n = N_SIZES
    dim as Array( of ubyte ) imgs( 0 to N_SIZES - 1 )
    dim as ustring fault
    for k as long = 0 to n - 1
        dim as SDL_Surface ptr sq = Square_( img, gSizes_( k ) )
        if sq = 0 then
            fault = "the " & gSizes_( k ) & " px image can't be made"
            exit for
        end if
        if gSizes_( k ) >= 256 then
            if Png_( sq, imgs( k ) ) = false then fault = "the " & gSizes_( k ) & " px image can't be made"
        else
            Dib_( sq, imgs( k ) )
        end if
        SDL_DestroySurface( sq )
        if len( fault ) then exit for
    next
    SDL_DestroySurface( img )
    if len( fault ) then return fault
    ' ICONDIR, one ICONDIRENTRY per image, then the images in that order
    dim as Array( of ubyte ) b
    U16_( b, 0 ) : U16_( b, 1 ) : U16_( b, n )
    dim as ulong offset = 6 + 16 * n
    for k as long = 0 to n - 1
        dim as long sz = gSizes_( k )
        U8_( b, iif( sz >= 256, 0, sz ) ) : U8_( b, iif( sz >= 256, 0, sz ) )
        U8_( b, 0 ) : U8_( b, 0 )
        U16_( b, 1 ) : U16_( b, 32 )
        U32_( b, imgs( k ).Count( ) ) : U32_( b, offset )
        offset += imgs( k ).Count( )
    next
    for k as long = 0 to n - 1
        for each v as ubyte in imgs( k )
            b.Push( v )
        next
    next
    if fs.WriteAllBytes( ico, b ).IsOk( ) = false then return fs.PathFileName( ico ) & ": can't be written"
    return ""
end function

' The .rc beside the .ico. Block comments only: the resource compiler rejects //.
public function RcText( ) as ustring
    dim as ustring nl = chr( 10 )
    return "/* The program's icon, written by tkEdit from the Resource Center's Application icon." & nl _
         & "   Its name sorts first, so Windows takes it for the exe and SDL for the windows. */" & nl _
         & "IMAGE_AAA_MAINICON ICON """ & ICO_FILE & """" & nl
end function

' ---- tiko.toml ----------------------------------------------------------------------------------

private function Eol_( byref text as const ustring ) as ustring
    if instr( text, chr( 13, 10 ) ) then return chr( 13, 10 )
    return chr( 10 )
end function

private function Lines_( byref text as const ustring, byref eol as const ustring ) as Array( of ustring )
    dim as Array( of ustring ) a
    dim as long p = 1
    do
        dim as long q = instr( p, text, eol )
        if q = 0 then
            a.Push( mid( text, p ) )
            exit do
        end if
        a.Push( mid( text, p, q - p ) )
        p = q + len( eol )
    loop
    return a
end function

private function Join_( byref a as Array( of ustring ), byref eol as const ustring ) as ustring
    dim as ustring o
    for i as long = 0 to a.Count( ) - 1
        if i then o &= eol
        o &= a[i]
    next
    return o
end function

' The key a line sets in a table ("" for a comment, a header or a blank).
private function KeyOf_( byref line_ as const ustring ) as ustring
    dim as ustring t = trim( line_ )
    if (len( t ) = 0) orelse (left( t, 1 ) = "#") orelse (left( t, 1 ) = "[") then return ""
    dim as long e = instr( t, "=" )
    if e = 0 then return ""
    return trim( left( t, e - 1 ) )
end function

' tiko.toml with rc in (on) or out of (off) [target.<target>.windows]'s resources list. The rest of
' the text is kept as it was. A resources list that spans lines is left alone: the text comes back
' unchanged, and changed says no.
public function TomlWithResource( byref text as const ustring, byref target as const ustring, byref rc as const ustring, _
                                  byval on_ as boolean, byref changed as boolean ) as ustring
    changed = false
    dim as ustring eol = Eol_( text )
    dim as Array( of ustring ) a = Lines_( text, eol )
    dim as ustring header = "[target." & target & ".windows]"
    dim as ustring entry = """" & rc & """"
    dim as long h = -1
    for i as long = 0 to a.Count( ) - 1
        if trim( a[i] ) = header then h = i
    next
    if h < 0 then
        if on_ = false then return text
        ' a table of its own at the end, after one blank line
        dim as ustring o = text
        if (len( o ) > 0) andalso (right( o, len( eol ) ) <> eol) then o &= eol
        if (len( o ) > 0) andalso (right( o, 2 * len( eol ) ) <> eol & eol) then o &= eol
        o &= header & eol & "resources = [" & entry & "]" & eol
        changed = true
        return o
    end if
    ' the table's lines: up to the next header
    dim as long last = a.Count( ) - 1
    for i as long = h + 1 to a.Count( ) - 1
        if left( trim( a[i] ), 1 ) = "[" then
            last = i - 1
            exit for
        end if
    next
    dim as long r = -1
    for i as long = h + 1 to last
        if KeyOf_( a[i] ) = "resources" then r = i
    next
    if r < 0 then
        if on_ = false then return text
        a.Insert( h + 1, "resources = [" & entry & "]" )
        changed = true
        return Join_( a, eol )
    end if
    dim as long lb = instr( a[r], "[" ), rb = instrrev( a[r], "]" )
    if (lb = 0) orelse (rb < lb) then return text            ' spans lines: not ours to rewrite
    ' the entries, as written
    dim as Array( of ustring ) items
    dim as ustring inner = mid( a[r], lb + 1, rb - lb - 1 )
    dim as long p = 1
    do
        dim as long c = instr( p, inner, "," )
        dim as ustring it = trim( iif( c = 0, mid( inner, p ), mid( inner, p, c - p ) ) )
        if len( it ) then items.Push( it )
        if c = 0 then exit do
        p = c + 1
    loop
    dim as long at_ = -1
    for i as long = 0 to items.Count( ) - 1
        dim as ustring v = items[i]
        if (left( v, 1 ) = "'") andalso (right( v, 1 ) = "'") then v = """" & mid( v, 2, len( v ) - 2 ) & """"
        if v = entry then at_ = i
    next
    if on_ then
        if at_ >= 0 then return text
        items.Push( entry )
    else
        if at_ < 0 then return text
        items.Remove( at_ )
        if items.Count( ) = 0 then
            a.Remove( r )
            changed = true
            return Join_( a, eol )
        end if
    end if
    dim as ustring list = ""
    for i as long = 0 to items.Count( ) - 1
        if i then list &= ", "
        list &= items[i]
    next
    a[r] = left( a[r], lb ) & list & mid( a[r], rb )
    changed = true
    return Join_( a, eol )
end function
