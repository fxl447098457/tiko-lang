'
' rdialogs -- the New Report wizard's dialog (RD8): rwizard's questions on one page -- the source
' (its name, kind and fields), the parameters, the field to group on, tabular or columnar, the page.
' The labels are the spec's words, as the inspector's are the file's. OK makes the report
' (rwizard.MakeReport): what is wrong shows and the dialog stays; Text is the .tkreport made.
#module "rdialogs"

#import "std/containers"
#import "tkc/i18n"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkButton"
#import "vendor/tkControls/tkLabel"
#import "vendor/tkControls/tkTextBox"
#import "vendor/tkControls/tkComboBox"
#import "vendor/tkControls/tkCheckBox"
#import "../rwizard"
using containers
using tkApp
using tkButton
using tkLabel
using tkTextBox
using tkComboBox
using tkCheckBox
using tkHost

const as long WIZ_WIN_CX = 560
const as long WIZ_WIN_CY = 520

public type WizardDialog
    Win      as TK_FORM ptr
    Spec     as rwizard.RWizardSpec
    Text     as ustring                 ' the report OK made
    Accepted as boolean
    IsModal  as boolean
    Keys     as Array( of ustring )
    Labels   as Array( of TK_WIDGET ptr )
    Edits    as Array( of TK_WIDGET ptr )
    LblInfo  as TK_WIDGET ptr
    BtnOk    as TK_WIDGET ptr
    BtnCancel as TK_WIDGET ptr

    declare sub Open( byval owner_ as TK_FORM ptr, byref title_ as const ustring, byref name_ as const ustring )
    declare function RunModal( ) as boolean
    declare sub Close( )
    declare sub Finish( byval ok as boolean )
    declare sub Layout( )
    declare function EditOf( byref key_ as const ustring ) as TK_WIDGET ptr
    declare sub Collect( )
end type

private function WizDlgOf( byval w as TK_WIDGET ptr ) as WizardDialog ptr
    dim as TK_FORM ptr f = tkForm_FromWidget( w )
    if f = 0 then return 0
    return f->Tag
end function

private sub OnWizButton( byval h as TK_WIDGET ptr, byval id as long )
    dim as WizardDialog ptr d = WizDlgOf( h )
    if d = 0 then exit sub
    if h = d->BtnOk then d->Finish( true )
    if h = d->BtnCancel then d->Finish( false )
end sub

' A row: "text", "combo:a,b,c" or "check".
private sub WizRow_( byval d as WizardDialog ptr, byval root_ as TK_WIDGET ptr, byref key_ as const ustring, _
                     byref kind as const ustring, byref value as const ustring )
    dim as TK_WIDGET ptr l = tkLabel_Create( root_, 1 )
    tkLabel_SetText( l, key_ )
    dim as TK_WIDGET ptr e
    if kind = "check" then
        e = tkCheckBox_Create( root_, 1 )
        tkCheckBox_SetChecked( e, value = "true" )
    elseif left( kind, 6 ) = "combo:" then
        e = tkComboBox_Create( root_, 1 )
        dim as ustring t = mid( kind, 7 ) & ","
        dim as long a = 1
        dim as long b = instr( a, t, "," )
        while b > 0
            tkComboBox_AddItem( e, mid( t, a, b - a ) )
            a = b + 1
            b = instr( a, t, "," )
        wend
        tkComboBox_SetCurSel( e, tkComboBox_FindItemByText( e, value ) )
    else
        e = tkTextBox_Create( root_, 1, false )
        tkTextBox_SetText( e, value )
    end if
    dim as ustring k = key_
    d->Keys.Push( k )
    d->Labels.Push( l )
    d->Edits.Push( e )
end sub

' name_: the report's name (its title to start with).
sub WizardDialog.Open( byval owner_ as TK_FORM ptr, byref title_ as const ustring, byref name_ as const ustring )
    dim as single sc = 0
    if owner_ then sc = tkForm_Host( owner_ )->fScaleForced
    dim as ustring t = title_
    Win = tkApp_NewForm( t, WIZ_WIN_CX, WIZ_WIN_CY, owner_, sc )
    if Win = 0 then exit sub
    Win->Tag = @this
    Spec.Title = name_
    dim as TK_WIDGET ptr root_ = tkForm_Widget( Win )
    WizRow_( @this, root_, "title", "text", Spec.Title )
    WizRow_( @this, root_, "source", "text", Spec.Source )
    WizRow_( @this, root_, "kind", "combo:host,array,sqlite,grid", Spec.Kind )
    WizRow_( @this, root_, "item_type", "text", "" )
    WizRow_( @this, root_, "sql", "text", "" )
    WizRow_( @this, root_, "design_db", "text", "" )
    WizRow_( @this, root_, "fields", "text", "" )
    WizRow_( @this, root_, "parameters", "text", "" )
    WizRow_( @this, root_, "group_by", "text", "" )
    WizRow_( @this, root_, "layout", "combo:tabular,columnar", Spec.Layout )
    WizRow_( @this, root_, "paper", "combo:,A4,Letter,Legal,A3,A5,B5,Tabloid,Executive", "" )
    WizRow_( @this, root_, "landscape", "check", "false" )
    LblInfo = tkLabel_Create( root_, 1 )
    tkLabel_SetWordWrap( LblInfo, true )
    BtnOk = tkButton_Create( root_, 2 )
    tkButton_SetText( BtnOk, i18n.Tr( "designer.ok", "OK" ) )
    tkButton_SetClickCallback( BtnOk, @OnWizButton )
    BtnCancel = tkButton_Create( root_, 3 )
    tkButton_SetText( BtnCancel, i18n.Tr( "designer.cancel", "Cancel" ) )
    tkButton_SetClickCallback( BtnCancel, @OnWizButton )
    tkForm_OnSize( Win, sub( byval f as TK_FORM ptr, byval cx as long, byval cy as long )
        cast( WizardDialog ptr, f->Tag )->Layout( )
    end sub )
    tkForm_Show( Win )
    this.Layout( )
end sub

function WizardDialog.RunModal( ) as boolean
    IsModal = true
    tkForm_ShowModalKeep( Win )
    IsModal = false
    return Accepted
end function

sub WizardDialog.Close( )
    if Win then tkForm_Destroy( Win )
    Win = 0
end sub

function WizardDialog.EditOf( byref key_ as const ustring ) as TK_WIDGET ptr
    for i as long = 0 to Keys.Count( ) - 1
        if Keys[i] = key_ then return Edits[i]
    next
    return 0
end function

' The boxes into the spec.
sub WizardDialog.Collect( )
    Spec.Title = tkTextBox_GetText( this.EditOf( "title" ) )
    Spec.Source = trim( tkTextBox_GetText( this.EditOf( "source" ) ) )
    Spec.Kind = tkComboBox_GetText( this.EditOf( "kind" ) )
    Spec.ItemType = trim( tkTextBox_GetText( this.EditOf( "item_type" ) ) )
    Spec.Sql = tkTextBox_GetText( this.EditOf( "sql" ) )
    Spec.DesignDb = trim( tkTextBox_GetText( this.EditOf( "design_db" ) ) )
    Spec.Fields = tkTextBox_GetText( this.EditOf( "fields" ) )
    Spec.Params = tkTextBox_GetText( this.EditOf( "parameters" ) )
    Spec.GroupBy = trim( tkTextBox_GetText( this.EditOf( "group_by" ) ) )
    Spec.Layout = tkComboBox_GetText( this.EditOf( "layout" ) )
    Spec.Paper = tkComboBox_GetText( this.EditOf( "paper" ) )
    Spec.Landscape = tkCheckBox_GetChecked( this.EditOf( "landscape" ) )
end sub

sub WizardDialog.Finish( byval ok as boolean )
    if ok then
        this.Collect( )
        dim as ustring fault = rwizard.MakeReport( Spec, Text )
        if len( fault ) then
            tkLabel_SetText( LblInfo, fault )
            exit sub
        end if
    end if
    Accepted = ok
    if IsModal then
        if (Win <> 0) andalso (Win->pOwner <> 0) then SDL_RaiseWindow( Win->pOwner->host->win )
        tkForm_EndModal( Win, iif( ok, 1, 0 ) )
    end if
end sub

sub WizardDialog.Layout( )
    if Win = 0 then exit sub
    dim as TK_WIDGET ptr root_ = tkForm_Widget( Win )
    dim as long g = tkForm_Scale( Win, 8 ), rh = tkForm_Scale( Win, 28 ), bw = tkForm_Scale( Win, 96 ), lw = tkForm_Scale( Win, 110 )
    dim as long cw = root_->cw, ch = root_->ch
    dim as long y = g
    for i as long = 0 to Keys.Count( ) - 1
        tkWidget_SetPos( Labels[i], g, y, lw, rh )
        tkWidget_SetPos( Edits[i], 2 * g + lw, y, cw - 3 * g - lw, rh )
        y += rh + g \ 2
    next
    tkWidget_SetPos( LblInfo, g, y, cw - 2 * g, ch - y - 2 * g - rh )
    tkWidget_SetPos( BtnCancel, cw - g - bw, ch - g - rh, bw, rh )
    tkWidget_SetPos( BtnOk, cw - 2 * (g + bw), ch - g - rh, bw, rh )
end sub
