' codegen -- a validated form to the plain tiko of its .design.tiko. The same form always gives the
' same text: no timestamps, stable order, LF line ends. Builds need only this output, never the
' designer.
#module "codegen"

#import "std/containers"
#import "std/hash"
#import "vendor/tkControls/tkMeta"
#import "vendor/tkControls/tkLayout"
#import "vendor/tkControls/tkToolbar"
#import "vendor/tkControls/tkIconPanel"
#import "../model"
#import "../catalog"
#import "../colorval"
using containers
using tkMeta
using tkLayout
using tkToolbar
using tkIconPanel
using tkTheme
using tkHost
using tkPaint
using model

const as string NL = chr( 10 )

' Design units a tab bar takes when the form doesn't set TabHeight; tkTabControl's own default.
const as long TAB_HEIGHT_DEFAULT = 30
' A group box's frame: its padding, and the caption's height at the UI font's usual size.
const as long GROUP_PADDING = 8
const as long GROUP_CAPTION = 16

' A tiko string expression for `s`. Anything a literal can't hold joins on as a chr( ).
private function Literal_( byref s as const ustring ) as ustring
    dim as ustring o = """"
    for i as long = 1 to len( s )
        dim as ustring ch = mid( s, i, 1 )
        dim as ulong code = asc( ch )
        if code = 34 then
            o &= """"""
        elseif (code < 32) orelse (code = 127) then
            o &= """ & chr( " & code & " ) & """
        else
            o &= ch
        end if
    next
    return o & """"
end function

' A text the program shows, and where a translation of it is looked up.
public type TrEntry
    Key as ustring          ' "<Module>.<control>.<Property>", "<Module>.<control>.<id>", "<Module>.Caption"
    Text as ustring         ' the designer's text, shown when no translation has one
end type

' While TranslatableTexts runs, every key Generate hands the translator, in the order it does.
dim shared as boolean gCollect_
dim shared as Array( of TrEntry ) gTexts_

' A text the program shows: through the translator when the form asks for that and there is anything
' to translate. The key says where it's from.
private function TextExpr_( byref doc as FormDoc, byref key_ as const ustring, byref s as const ustring ) as ustring
    if (doc.Translate = false) orelse (len( trim( s ) ) = 0) then return Literal_( s )
    if gCollect_ then
        dim as TrEntry e
        e.Key = doc.ModuleName & "." & key_
        e.Text = s
        gTexts_.Push( e )
    end if
    return "tkForms_Tr( " & Literal_( doc.ModuleName & "." & key_ ) & ", " & Literal_( s ) & " )"
end function

' Properties of kind "text" that are not words a person reads: never translated.
private function NotWords_( byref typeName as const ustring, byref prop as const ustring ) as boolean
    return (typeName = "CodeEdit") andalso ((prop = "Lexer") orelse (prop = "Keywords"))
end function

' The CONSTANT for a Shown name in a "Shown=CONSTANT,..." list.
private function EnumConst_( byref pairs as const ustring, byref shown as const ustring ) as ustring
    dim as ustring t = "," & pairs & ","
    dim as long a = instr( t, "," & shown & "=" )
    if a = 0 then return "0"
    a += len( shown ) + 2
    return mid( t, a, instr( a, t, "," ) - a )
end function

' A control's glyph font role: GLYPH, or GLYPH_LARGE when its GlyphSize is Large (an older file's
' other roles, and a size in points, read as GLYPH).
public function GlyphRole( byref c as FormControl ) as ustring
    if SettingOr( c.Props, "GlyphFont" ) = "GLYPH_LARGE" then return "GLYPH_LARGE"
    return "GLYPH"
end function

' A control's GlyphSize in points; 0 when it is Normal or Large (a role).
public function GlyphPoints( byref c as FormControl ) as long
    dim as ustring v = SettingOr( c.Props, "GlyphFont" )
    if len( v ) = 0 then return 0
    for i as long = 1 to len( v )
        dim as long a = asc( mid( v, i, 1 ) )
        if (a < 48) orelse (a > 57) then return 0
    next
    return valint( v )
end function

' The project's glyph numbering for the Generate that follows (appGlyphs.tkglyphs [codes], GLYPHS.md
' V4): Key "<font>:<hex>", Value its code in the merged glyphs.ttf. Empty: a glyph is written at its
' source font's code.
dim shared as Array( of Setting ) gGlyphCodes_

public sub SetGlyphCodes( byref codes as Array( of Setting ) )
    gGlyphCodes_ = codes
end sub

private function ValueExpr_( byref v as const ustring, byref kind_ as const ustring, byref pairs as const ustring ) as ustring
    select case kind_
    case "bool", "int", "float" : return v
    case "enum"                 : return EnumConst_( pairs, v )
    case "color"                : return v & "ul"
    case "font"                 : return "tkForm_Font( Handle, TKFONT_" & v & " )"
    case "glyph"
        ' "<font>:<hex>": its character in the project's merged font (appGlyphs), else the source font's
        dim as ulong cp = GlyphCode( v )
        if cp then
            dim as ustring want = ucase( GlyphRef( GlyphFontKey( v ), cp ) )
            for each s as Setting in gGlyphCodes_
                if ucase( s.Key ) = want then return "wchr( &h" & ucase( s.Value ) & " )"
            next
            return "wchr( &h" & hex( cp ) & " )"
        end if
    end select
    return Literal_( v )
end function

' A "list" property's arguments.
private function ListExpr_( byref v as const ustring, byref pairs as const ustring ) as ustring
    dim as ustring o
    for i as long = 0 to tkMeta_ListCount( pairs ) - 1
        if i then o &= ", "
        o &= ValueExpr_( tkMeta_ListItem( v, i ), tkMeta_ListSlot( pairs, i ), "" )
    next
    return o
end function

private function AnchorExpr_( byval mask as long ) as ustring
    if mask = TK_ANCHOR_NONE then return "TK_ANCHOR_NONE"
    dim as ustring s
    if mask and TK_ANCHOR_LEFT then s &= " or TK_ANCHOR_LEFT"
    if mask and TK_ANCHOR_TOP then s &= " or TK_ANCHOR_TOP"
    if mask and TK_ANCHOR_RIGHT then s &= " or TK_ANCHOR_RIGHT"
    if mask and TK_ANCHOR_BOTTOM then s &= " or TK_ANCHOR_BOTTOM"
    return mid( s, 5 )
end function

private function DockExpr_( byval dock_ as long ) as ustring
    select case dock_
    case TK_DOCK_TOP    : return "TK_DOCK_TOP"
    case TK_DOCK_BOTTOM : return "TK_DOCK_BOTTOM"
    case TK_DOCK_LEFT   : return "TK_DOCK_LEFT"
    case TK_DOCK_RIGHT  : return "TK_DOCK_RIGHT"
    case TK_DOCK_FILL   : return "TK_DOCK_FILL"
    end select
    return "TK_DOCK_NONE"
end function

' "( a, b )", and "( )" when there's nothing inside.
private function Parens_( byref inside as const ustring ) as ustring
    if len( inside ) = 0 then return "( )"
    return "( " & inside & " )"
end function

' The value a toolbar item's kind stands for.
public function ToolbarKindValue( byref kind_ as const ustring ) as long
    select case kind_
    case "toggle"    : return TBR_KIND_TOGGLE
    case "separator" : return TBR_KIND_SEPARATOR
    case "split"     : return TBR_KIND_SPLIT
    case "dropdown"  : return TBR_KIND_DROPDOWN
    end select
    return TBR_KIND_COMMAND
end function

private function ToolbarKindName_( byref kind_ as const ustring ) as ustring
    select case kind_
    case "toggle"    : return "TBR_KIND_TOGGLE"
    case "separator" : return "TBR_KIND_SEPARATOR"
    case "split"     : return "TBR_KIND_SPLIT"
    case "dropdown"  : return "TBR_KIND_DROPDOWN"
    end select
    return "TBR_KIND_COMMAND"
end function

' The value an icon panel item's kind stands for (a toggle when none is given, as the vendor's is).
public function IconKindValue( byref kind_ as const ustring ) as long
    select case kind_
    case "command"   : return IP_KIND_COMMAND
    case "separator" : return IP_KIND_SEPARATOR
    end select
    return IP_KIND_TOGGLE
end function

private function IconKindName_( byref kind_ as const ustring ) as ustring
    select case kind_
    case "command"   : return "IP_KIND_COMMAND"
    case "separator" : return "IP_KIND_SEPARATOR"
    end select
    return "IP_KIND_TOGGLE"
end function

' Entries are given ids from here, so a dispatcher can tell them from a control's own.
const as long ITEM_ID_BASE = 1000

' Has this menu or toolbar anything to dispatch?
' Indices into c.Props in the order Build sets them: Enabled, Visible, then the control table's
' order (formfile's WriteProps_ order), then any key the table doesn't know, as found.
private function PropOrder_( byref c as FormControl, byval m as TKMETA_CONTROL ptr ) as Array( of long )
    dim as Array( of long ) order_
    dim as Array( of boolean ) done
    done.Reserve( c.Props.Count( ) )
    done.SetCount( c.Props.Count( ) )
    dim as long i = FindSetting( c.Props, "Enabled" )
    if i >= 0 then order_.Push( i ) : done[i] = true
    i = FindSetting( c.Props, "Visible" )
    if i >= 0 then order_.Push( i ) : done[i] = true
    for p as long = 0 to m->NumProps - 1
        i = FindSetting( c.Props, m->Props( p ).Name )
        if (i >= 0) andalso (done[i] = false) then order_.Push( i ) : done[i] = true
    next
    for j as long = 0 to c.Props.Count( ) - 1
        if done[j] = false then order_.Push( j )
    next
    return order_
end function

private function HasItemHandlers_( byref c as FormControl ) as boolean
    for each it as FormItem in c.Items
        if len( it.Handler ) then return true
    next
    return false
end function

private function AnyShortcut_( byref doc as FormDoc ) as boolean
    for each c as FormControl in doc.Controls
        if catalog.IsMenuKind( catalog.ItemsKindOf( c.TypeName ) ) then
            for each it as FormItem in c.Items
                if len( it.Key ) then return true
            next
        end if
    next
    return false
end function

' The select cases that call each entry's handler. The menu ids are the entry's place in the whole
' form, so one key table can reach every menu; a status bar's Click says which panel by its index,
' and its handlers are told the clicks.
private sub ItemCases_( byref c as FormControl, byval baseId as long, byref o as ustring )
    dim as boolean status_ = (catalog.ItemsKindOf( c.TypeName ) = catalog.ItemsKind.ItemsStatus)
    for i as long = 0 to c.Items.Count( ) - 1
        if len( c.Items[i].Handler ) then
            if status_ then
                o &= "    case " & i & " : f->" & c.Items[i].Handler & "( clicks )" & NL
            else
                o &= "    case " & (baseId + i) & " : f->" & c.Items[i].Handler & "( )" & NL
            end if
        end if
    next
end sub

' Does event ev of control c reach its entries' handlers?
private function Dispatches_( byref c as FormControl, byref ev as const ustring ) as boolean
    if HasItemHandlers_( c ) = false then return false
    dim as ustring want = catalog.ItemDispatchEvent( catalog.ItemsKindOf( c.TypeName ) )
    return (len( want ) > 0) andalso (want = ev)
end function

' Where a control's entries start numbering.
private function ItemBase_( byref doc as FormDoc, byval idx as long ) as long
    dim as long b = ITEM_ID_BASE
    for i as long = 0 to idx - 1
        b += doc.Controls[i].Items.Count( )
    next
    return b
end function

' The first parameter's name in "byval hButton as TK_WIDGET ptr, ...".
private function FirstParam_( byref sig as const ustring ) as ustring
    dim as long a = instr( sig, " " ) + 1
    return mid( sig, a, instr( a, sig, " " ) - a )
end function

' The control an event's callback is about: the metadata's expression, else its first parameter.
private function WidgetOf_( byref ev as TKMETA_EVENT ) as ustring
    if len( ev.Widget ) then return ev.Widget
    return FirstParam_( ev.Sig )
end function

private function TabHeight_( byref c as FormControl ) as long
    return valint( SettingOr( c.Props, "TabHeight", str( TAB_HEIGHT_DEFAULT ) ) )
end function

' The widget a child of `c` is created on.
private function ChildParent_( byref c as FormControl, byval kind_ as long, byval page_ as long ) as ustring
    select case kind_
    case TKMETA_CONTAINER_PAGES       : return "tkTabControl_GetPage( " & c.Name & ".Handle, " & page_ & " )"
    case TKMETA_CONTAINER_SCROLLPANEL : return "tkScrollPanel_GetPanel( " & c.Name & ".Handle )"
    end select
    return c.Name & ".Handle"
end function

' ---- sizes of containers ----------------------------------------------------------------------

' Each control's size at design scale. Only a dock changes it from the file's w and h, but a docked
' panel's children are laid out against the size the dock gives it, not the one left in the file.
public type Sizes
    W as Array( of long )
    H as Array( of long )
end type

' The area inside a parent, in design units.
private sub ClientOf_( byref doc as FormDoc, byref sz as Sizes, byval parent as long, byref cw as long, byref ch as long, byref rc as TKRECT )
    cw = doc.ClientW
    ch = doc.ClientH
    if parent >= 0 then
        cw = sz.W[parent]
        ch = sz.H[parent]
        dim as FormControl c = doc.Controls[parent]
        dim as TKMETA_CONTROL ptr m = catalog.Find( c.TypeName )
        if m->ContainerKind = TKMETA_CONTAINER_PAGES then ch -= TabHeight_( c )
        if m->ContainerKind = TKMETA_CONTAINER_GROUPBOX then
            tkRect_Set( rc, GROUP_PADDING, GROUP_PADDING + GROUP_CAPTION, cw - GROUP_PADDING, ch - GROUP_PADDING )
            exit sub
        end if
    end if
    tkRect_Set( rc, 0, 0, cw, ch )
end sub

private sub ComputeChildren_( byref doc as FormDoc, byref sz as Sizes, byval parent as long, byval page_ as long )
    dim as ustring want
    if parent >= 0 then want = lcase( doc.Controls[parent].Name )
    dim as Array( of long ) kids
    dim as Array( of TKLAYOUT_ITEM ) items
    for i as long = 0 to doc.Controls.Count( ) - 1
        if lcase( doc.Controls[i].Parent ) = want then
            if (page_ < 0) orelse (doc.Controls[i].Page = page_) then
                dim as TKLAYOUT_ITEM it
                it.x = doc.Controls[i].X
                it.y = doc.Controls[i].Y
                it.cx = doc.Controls[i].W
                it.cy = doc.Controls[i].H
                it.anchor = doc.Controls[i].Anchor
                it.dock = doc.Controls[i].Dock
                items.Push( it )
                kids.Push( i )
            end if
        end if
    next
    if kids.Count( ) = 0 then exit sub
    dim as Array( of TKRECT ) rects
    rects.Reserve( kids.Count( ) )
    rects.SetCount( kids.Count( ) )
    dim as long cw, ch
    dim as TKRECT rc
    ClientOf_( doc, sz, parent, cw, ch, rc )
    tkLayout_Compute( items.Data( ), items.Count( ), cw, ch, cw, ch, rc, 1.0, rects.Data( ) )
    for k as long = 0 to kids.Count( ) - 1
        if doc.Controls[kids[k]].Dock <> TK_DOCK_NONE then
            sz.W[kids[k]] = rects[k].right - rects[k].left
            sz.H[kids[k]] = rects[k].bottom - rects[k].top
        end if
    next
end sub

public sub EffectiveSizes( byref doc as FormDoc, byref sz as Sizes )
    dim as long n = doc.Controls.Count( )
    sz.W.Reserve( n )
    sz.W.SetCount( n )
    sz.H.Reserve( n )
    sz.H.SetCount( n )
    for i as long = 0 to n - 1
        sz.W[i] = doc.Controls[i].W
        sz.H[i] = doc.Controls[i].H
    next
    ComputeChildren_( doc, sz, -1, -1 )
    ' parents come first in the list, so each size is settled before its children use it
    for i as long = 0 to n - 1
        dim as TKMETA_CONTROL ptr m = catalog.Find( doc.Controls[i].TypeName )
        if m->ContainerKind = TKMETA_CONTAINER_PAGES then
            for p as long = 0 to doc.Controls[i].Pages.Count( ) - 1
                ComputeChildren_( doc, sz, i, p )
            next
        elseif m->ContainerKind <> TKMETA_NOT_CONTAINER then
            ComputeChildren_( doc, sz, i, -1 )
        end if
    next
end sub

private function HasChildren_( byref doc as FormDoc, byref name_ as const ustring, byval page_ as long ) as boolean
    dim as ustring want = lcase( name_ )
    for i as long = 0 to doc.Controls.Count( ) - 1
        if (lcase( doc.Controls[i].Parent ) = want) andalso ((page_ < 0) orelse (doc.Controls[i].Page = page_)) then return true
    next
    return false
end function

' ---- the pieces of the file -------------------------------------------------------------------

' A custom control's module path, once each, in list order.
private function CustomModules_( byref doc as FormDoc ) as Array( of ustring )
    dim as Array( of ustring ) mods
    for i as long = 0 to doc.Controls.Count( ) - 1
        dim as ustring mo = doc.Controls[i].CustomModule
        if len( mo ) = 0 then continue for
        dim as boolean seen = false
        for j as long = 0 to mods.Count( ) - 1
            if mods[j] = mo then seen = true
        next
        if seen = false then mods.Push( mo )
    next
    return mods
end function

' "../widgets/gauge" -> "gauge": the module's own name.
private function LastPart_( byref path as const ustring ) as ustring
    dim as long k = instrrev( path, "/" )
    return mid( path, k + 1 )
end function

private function UsedModules_( byref doc as FormDoc ) as Array( of ustring )
    dim as Array( of ustring ) mods
    for i as long = 0 to doc.Controls.Count( ) - 1
        dim as ustring mo = catalog.Find( doc.Controls[i].TypeName )->Module_
        if len( mo ) = 0 then continue for          ' a custom control's own module is listed apart
        dim as boolean seen = false
        for j as long = 0 to mods.Count( ) - 1
            if mods[j] = mo then seen = true : exit for
        next
        if seen = false then mods.Push( mo )
    next
    ' a type another module owns (catalog.ForeignType*): its module in scope too
    for each c as FormControl in doc.Controls
        dim as TKMETA_CONTROL ptr m = catalog.Find( c.TypeName )
        for each s as Setting in c.Events
            dim as TKMETA_EVENT ptr e = tkMeta_FindEvent( m, s.Key )
            if e = 0 then continue for
            dim as ustring sig = ucase( e->Sig ) & " "
            for t as long = 0 to catalog.ForeignTypeCount( ) - 1
                if instr( sig, " " & catalog.ForeignTypePrefix( t ) ) then
                    dim as ustring fm = catalog.ForeignTypeModule( t )
                    dim as boolean seen = false
                    for each mo as ustring in mods
                        if mo = fm then seen = true
                    next
                    if seen = false then mods.Push( fm )
                end if
            next
        next
    next
    for i as long = 1 to mods.Count( ) - 1
        dim as ustring v = mods[i]
        dim as long j = i - 1
        while (j >= 0) andalso (mods[j] > v)
            mods[j + 1] = mods[j]
            j -= 1
        wend
        mods[j + 1] = v
    next
    return mods
end function

' Each handler once, in the order of first use: one handler may serve several events.
private sub HandlerDecls_( byref doc as FormDoc, byref o as ustring )
    dim as Array( of Setting ) all
    for e as long = 0 to catalog.FormEventCount( ) - 1
        dim as long i = FindSetting( doc.Events, catalog.FormEventName( e ) )
        if i >= 0 then PutSetting( all, doc.Events[i].Value, catalog.FormEventParams( catalog.FormEventName( e ) ) )
    next
    for c as long = 0 to doc.Controls.Count( ) - 1
        dim as TKMETA_CONTROL ptr m = catalog.Find( doc.Controls[c].TypeName )
        for each s as Setting in doc.Controls[c].Events
            PutSetting( all, s.Value, tkMeta_FindEvent( m, s.Key )->Params )
        next
    next
    for c as long = 0 to doc.Controls.Count( ) - 1
        dim as ustring itemParams = catalog.ItemHandlerParams( catalog.ItemsKindOf( doc.Controls[c].TypeName ) )
        for each it as FormItem in doc.Controls[c].Items
            if len( it.Handler ) then PutSetting( all, it.Handler, itemParams )
        next
    next
    for each or_ as FormOrphan in doc.Orphans
        PutSetting( all, or_.Handler, or_.Params )
    next
    for each s as Setting in all
        o &= "    declare sub " & s.Key & Parens_( s.Value ) & NL
    next
end sub

declare function NavWires_( byref doc as FormDoc, byref c as FormControl, byref evName as const ustring ) as boolean
declare function NavThunk_( byref doc as FormDoc, byref k as FormControl, byval ev as TKMETA_EVENT ptr, byval i as long, byref o as ustring ) as boolean

private sub Thunks_( byref doc as FormDoc, byref o as ustring )
    for c as long = 0 to doc.Controls.Count( ) - 1
        dim as FormControl k = doc.Controls[c]
        dim as TKMETA_CONTROL ptr m = catalog.Find( k.TypeName )
        dim as long kindIt = catalog.ItemsKindOf( k.TypeName )
        for e as long = 0 to m->NumEvents - 1
            dim as long i = FindSetting( k.Events, m->Events( e ).Name )
            ' a menu's Command, a toolbar's and a status bar's Click also reach the handler of the
            ' entry that fired (a status bar names its panel by index)
            dim as boolean dispatches = Dispatches_( k, m->Events( e ).Name )
            if NavThunk_( doc, k, @m->Events( e ), i, o ) then
                ' B4: made even with no handler
            elseif dispatches then
                o &= "private sub Thunk_" & k.Name & "_" & m->Events( e ).Name & Parens_( m->Events( e ).Sig ) & NL
                o &= "    dim as Form ptr f = tkForms_ObjectOf( " & WidgetOf_( m->Events( e ) ) & " )" & NL
                o &= "    if f = 0 then exit sub" & NL
                o &= "    select case " & iif( kindIt = catalog.ItemsKind.ItemsStatus, "idx", "id" ) & NL
                ItemCases_( k, ItemBase_( doc, c ), o )
                o &= "    end select" & NL
                if i >= 0 then o &= "    f->" & k.Events[i].Value & Parens_( m->Events( e ).Args ) & NL
                o &= "end sub" & NL & NL
            elseif (i >= 0) andalso (len( m->Events( e ).Returns ) > 0) then
                ' a callback that answers: the handler sets its byref result, which starts at the default
                dim as TKMETA_EVENT ptr ev = @m->Events( e )
                o &= "private function Thunk_" & k.Name & "_" & ev->Name & Parens_( ev->Sig ) & " as " & ev->Returns & NL
                o &= "    dim as " & ev->Returns & " " & ev->Result
                if len( ev->ResultInit ) then o &= " = " & ev->ResultInit
                o &= NL
                o &= "    dim as Form ptr f = tkForms_ObjectOf( " & WidgetOf_( *ev ) & " )" & NL
                o &= "    if f then f->" & k.Events[i].Value & Parens_( ev->Args ) & NL
                o &= "    return " & ev->Result & NL
                o &= "end function" & NL & NL
            elseif i >= 0 then
                o &= "private sub Thunk_" & k.Name & "_" & m->Events( e ).Name & Parens_( m->Events( e ).Sig ) & NL
                o &= "    dim as Form ptr f = tkForms_ObjectOf( " & WidgetOf_( m->Events( e ) ) & " )" & NL
                o &= "    if f then f->" & k.Events[i].Value & Parens_( m->Events( e ).Args ) & NL
                o &= "end sub" & NL & NL
            end if
        next
    next
    if AnyShortcut_( doc ) then
        o &= "private function KeyLabel( byref s as string ) as string" & NL
        o &= "    dim as TK_CHORD c" & NL
        o &= "    if tkKeys_Parse( s, c ) then return tkKeys_Format( c )" & NL
        o &= "    return s" & NL
        o &= "end function" & NL & NL
        ' a shortcut whose entry has no handler yet gets no case; with none at all there is no select,
        ' since tiko refuses one without a case (TKO0418)
        dim as ustring cases
        for c as long = 0 to doc.Controls.Count( ) - 1
            if catalog.IsMenuKind( catalog.ItemsKindOf( doc.Controls[c].TypeName ) ) then
                dim as long b = ItemBase_( doc, c )
                for i as long = 0 to doc.Controls[c].Items.Count( ) - 1
                    if (len( doc.Controls[c].Items[i].Key ) > 0) andalso (len( doc.Controls[c].Items[i].Handler ) > 0) then
                        cases &= "    case " & (b + i) & " : f->" & doc.Controls[c].Items[i].Handler & "( )" & NL
                    end if
                next
            end if
        next
        o &= "private sub Thunk_Keys( byval h as TK_HOST ptr, byval cmd as int32 )" & NL
        if len( cases ) then
            o &= "    dim as TK_FORM ptr fm = tkForm_FromHost( h )" & NL
            o &= "    if fm = 0 then exit sub" & NL
            o &= "    dim as Form ptr f = fm->Tag" & NL
            o &= "    if f = 0 then exit sub" & NL
            o &= "    select case cmd" & NL
            o &= cases
            o &= "    end select" & NL
        else
            o &= "    ' no shortcut's entry has a handler yet" & NL
        end if
        o &= "end sub" & NL & NL
    end if
    dim as long i = FindSetting( doc.Events, "Close" )
    if i >= 0 then
        o &= "private function Thunk_Form_Close( byval w as TK_FORM ptr ) as boolean" & NL
        o &= "    dim as Form ptr f = w->Tag" & NL
        o &= "    if f = 0 then return true" & NL
        o &= "    dim as boolean Cancel = false" & NL
        o &= "    f->" & doc.Events[i].Value & "( Cancel )" & NL
        o &= "    return Cancel = false" & NL
        o &= "end function" & NL & NL
    end if
    i = FindSetting( doc.Events, "Resize" )
    if i >= 0 then
        o &= "private sub Thunk_Form_Resize( byval w as TK_FORM ptr, byval cx as int32, byval cy as int32 )" & NL
        o &= "    dim as Form ptr f = w->Tag" & NL
        o &= "    if f then f->" & doc.Events[i].Value & "( cx, cy )" & NL
        o &= "end sub" & NL & NL
    end if
    i = FindSetting( doc.Events, "KeyDown" )
    if i >= 0 then
        o &= "private function Thunk_Form_KeyDown( byval w as TK_FORM ptr, byval keyCode as int32, byval mods as int32 ) as boolean" & NL
        o &= "    dim as Form ptr f = w->Tag" & NL
        o &= "    if f = 0 then return false" & NL
        o &= "    dim as boolean Handled = false" & NL
        o &= "    f->" & doc.Events[i].Value & "( keyCode, mods, Handled )" & NL
        o &= "    return Handled" & NL
        o &= "end function" & NL & NL
    end if
    i = FindSetting( doc.Events, "Paint" )
    if i >= 0 then
        o &= "private sub Thunk_Form_Paint( byval w as TK_FORM ptr, byval pPaint as TK_PAINT ptr )" & NL
        o &= "    dim as Form ptr f = w->Tag" & NL
        o &= "    if f then f->" & doc.Events[i].Value & "( pPaint )" & NL
        o &= "end sub" & NL & NL
    end if
    i = FindSetting( doc.Events, "Destroy" )
    if i >= 0 then
        o &= "private sub Thunk_Form_Destroy( byval w as TK_FORM ptr )" & NL
        o &= "    dim as Form ptr f = w->Tag" & NL
        o &= "    if f then f->" & doc.Events[i].Value & "( )" & NL
        o &= "end sub" & NL & NL
    end if
    i = FindSetting( doc.Events, "ThemeChanged" )
    if i >= 0 then
        o &= "private sub Thunk_Form_ThemeChanged( byval w as TK_FORM ptr )" & NL
        o &= "    dim as Form ptr f = w->Tag" & NL
        o &= "    if f then f->" & doc.Events[i].Value & "( )" & NL
        o &= "end sub" & NL & NL
    end if
    ' MouseMove watches the form's own widget: over the form, and over controls with none of their own
    i = FindSetting( doc.Events, "MouseMove" )
    if i >= 0 then
        o &= "private sub Thunk_Form_MouseMove( byval w as TK_WIDGET ptr, byval x as int32, byval y as int32, byval buttons as int32, byval mods as int32 )" & NL
        o &= "    dim as Form ptr f = tkForms_ObjectOf( w )" & NL
        o &= "    if f then f->" & doc.Events[i].Value & "( x, y, buttons, mods )" & NL
        o &= "end sub" & NL & NL
    end if
end sub

' The window's settings the form gives, each only when it isn't the run-time default.
private sub WindowCode_( byref doc as FormDoc, byref o as ustring )
    select case doc.StartPosition
    case "CenterScreen" : o &= "    tkForm_SetStartPosition( Handle, TKFORM_POS_CENTER_SCREEN )" & NL
    case "CenterOwner"  : o &= "    tkForm_SetStartPosition( Handle, TKFORM_POS_CENTER_OWNER )" & NL
    end select
    if len( doc.Resizable ) then o &= "    tkForm_SetResizable( Handle, " & doc.Resizable & " )" & NL
    if (doc.MinW <> 0) orelse (doc.MinH <> 0) then o &= "    tkForm_SetMinSize( Handle, " & doc.MinW & ", " & doc.MinH & " )" & NL
    if (doc.MaxW <> 0) orelse (doc.MaxH <> 0) then o &= "    tkForm_SetMaxSize( Handle, " & doc.MaxW & ", " & doc.MaxH & " )" & NL
    select case doc.WindowState
    case "Maximized" : o &= "    tkForm_SetWindowState( Handle, TKFORM_STATE_MAXIMIZED )" & NL
    case "Minimized" : o &= "    tkForm_SetWindowState( Handle, TKFORM_STATE_MINIMIZED )" & NL
    end select
    if doc.AlwaysOnTop then o &= "    tkForm_SetAlwaysOnTop( Handle, true )" & NL
    if len( doc.Icon ) then o &= "    tkForm_SetIcon( Handle, " & Literal_( doc.Icon ) & " )" & NL
end sub

' The statements that fill a control with its entries.
private sub ItemsCode_( byref doc as FormDoc, byval idx as long, byref o as ustring )
    dim as FormControl c = doc.Controls[idx]
    dim as ustring h = c.Name & ".Handle"
    dim as long base_ = ItemBase_( doc, idx )
    select case catalog.ItemsKindOf( c.TypeName )
    case catalog.ItemsKind.ItemsMenu
        if c.Items.Count( ) = 0 then exit sub
        o &= "    scope" & NL
        o &= "        dim as TK_MENU ptr menus( 0 to 2 )" & NL
        for i as long = 0 to c.Items.Count( ) - 1
            dim as FormItem it = c.Items[i]
            dim as boolean hasKids = false
            if i < c.Items.Count( ) - 1 then hasKids = (c.Items[i + 1].Level > it.Level)
            if it.Level = 0 then
                if hasKids then
                    o &= "        menus( 0 ) = tkPopupMenu_Create( tkForm_Host( Handle ) )" & NL
                    o &= "        tkMenuBar_SetDropDown( " & h & ", tkMenuBar_AddItem( " & h & ", " & TextExpr_( doc, c.Name & "." & ItemId( c, i ), it.Text ) & ", " & (base_ + i) & " ), menus( 0 ) )" & NL
                else
                    o &= "        tkMenuBar_AddItem( " & h & ", " & TextExpr_( doc, c.Name & "." & ItemId( c, i ), it.Text ) & ", " & (base_ + i) & " )" & NL
                end if
            elseif it.Text = "-" then
                o &= "        tkPopupMenu_AddSeparator( menus( " & (it.Level - 1) & " ) )" & NL
            else
                dim as ustring accel
                if len( it.Key ) then accel = ", KeyLabel( " & Literal_( it.Key ) & " )"
                o &= "        tkPopupMenu_AddItem( menus( " & (it.Level - 1) & " ), " & (base_ + i) & ", " & TextExpr_( doc, c.Name & "." & ItemId( c, i ), it.Text ) & accel & " )" & NL
                if hasKids then
                    o &= "        menus( " & it.Level & " ) = tkPopupMenu_Create( tkForm_Host( Handle ) )" & NL
                    o &= "        tkPopupMenu_SetItemSubMenu( menus( " & (it.Level - 1) & " ), " & (base_ + i) & ", menus( " & it.Level & " ) )" & NL
                end if
            end if
        next
        o &= "    end scope" & NL
    case catalog.ItemsKind.ItemsPopup
        ' a right-click menu: level 0 is the menu that opens, each deeper level a submenu of the item above
        if c.Items.Count( ) = 0 then exit sub
        o &= "    scope" & NL
        o &= "        dim as TK_MENU ptr menus( 0 to 2 )" & NL
        o &= "        menus( 0 ) = tkContextMenu_GetMenu( " & h & " )" & NL
        for i as long = 0 to c.Items.Count( ) - 1
            dim as FormItem it = c.Items[i]
            dim as boolean hasKids = false
            if i < c.Items.Count( ) - 1 then hasKids = (c.Items[i + 1].Level > it.Level)
            if it.Text = "-" then
                o &= "        tkPopupMenu_AddSeparator( menus( " & it.Level & " ) )" & NL
            else
                dim as ustring accel
                if len( it.Key ) then accel = ", KeyLabel( " & Literal_( it.Key ) & " )"
                o &= "        tkPopupMenu_AddItem( menus( " & it.Level & " ), " & (base_ + i) & ", " & TextExpr_( doc, c.Name & "." & ItemId( c, i ), it.Text ) & accel & " )" & NL
                if hasKids andalso (it.Level < 2) then
                    o &= "        menus( " & (it.Level + 1) & " ) = tkPopupMenu_Create( tkForm_Host( Handle ) )" & NL
                    o &= "        tkPopupMenu_SetItemSubMenu( menus( " & it.Level & " ), " & (base_ + i) & ", menus( " & (it.Level + 1) & " ) )" & NL
                end if
            end if
        next
        o &= "    end scope" & NL
    case catalog.ItemsKind.ItemsToolbar
        for i as long = 0 to c.Items.Count( ) - 1
            o &= "    tkToolbar_AddItem( " & h & ", " & ToolbarKindName_( c.Items[i].Kind ) & ", " & ValueExpr_( c.Items[i].Glyph, "glyph", "" ) & ", " & TextExpr_( doc, c.Name & "." & ItemId( c, i ), c.Items[i].Text ) & ", " & (base_ + i) & " )" & NL
        next
    case catalog.ItemsKind.ItemsIcons
        for i as long = 0 to c.Items.Count( ) - 1
            o &= "    tkIconPanel_AddItem( " & h & ", " & IconKindName_( c.Items[i].Kind ) & ", " & ValueExpr_( c.Items[i].Glyph, "glyph", "" ) & ", " & (base_ + i) & " )" & NL
        next
    case catalog.ItemsKind.ItemsStatus
        for i as long = 0 to c.Items.Count( ) - 1
            o &= "    tkStatusBar_AddPanel( " & h & ", " & TextExpr_( doc, c.Name & "." & ItemId( c, i ), c.Items[i].Text ) & " )" & NL
            if c.Items[i].Width then o &= "    tkStatusBar_SetPanelMinWidth( " & h & ", " & i & ", " & c.Items[i].Width & " )" & NL
            if c.Items[i].Stretch then o &= "    tkStatusBar_SetPanelStretch( " & h & ", " & i & ", true )" & NL
        next
    case catalog.ItemsKind.ItemsColumns
        ' a ListTree's columns, or a ReportViewer's report's fields (R5): a caption and a width each
        dim as ustring addCol = iif( c.TypeName = "ReportViewer", "tkReportViewer_AddField", "tkListTree_AddColumn" )
        for i as long = 0 to c.Items.Count( ) - 1
            dim as FormItem it = c.Items[i]
            o &= "    " & addCol & "( " & h & ", " & TextExpr_( doc, c.Name & "." & ItemId( c, i ), it.Text ) & ", "
            if it.Width > 0 then o &= it.Width else o &= "100"
            o &= " )" & NL
        next
    case catalog.ItemsKind.ItemsGridColumns
        for i as long = 0 to c.Items.Count( ) - 1
            dim as FormItem it = c.Items[i]
            o &= "    tkDataGrid_AddColumnEx( " & h & ", " & TextExpr_( doc, c.Name & "." & ItemId( c, i ), it.Text ) & ", " _
                & catalog.GridKindConst( it.Kind ) & ", " & iif( it.Width > 0, it.Width, 100 ) & " )" & NL
            ' a method's value (Total( )) is shown, never written: no editor opens on it
            dim as boolean ro = it.ReadOnly orelse GridMethodField_( it.Field )
            if (len( it.Align ) > 0) orelse (it.MinWidth > 0) orelse (it.Fill > 0) orelse it.Hidden orelse (len( it.Summary ) > 0) then
                ' the rest of the column's settings: through its TKDATAGRID_COLUMN
                o &= "    scope" & NL
                o &= "        dim as TKDATAGRID_COLUMN c_" & NL
                o &= "        tkDataGrid_GetColumnInfo( " & h & ", " & i & ", c_ )" & NL
                if len( it.Align ) then o &= "        c_.align = " & catalog.GridAlignConst( it.Align ) & NL
                if it.MinWidth > 0 then o &= "        c_.minWidth = " & it.MinWidth & NL
                if it.Fill > 0 then o &= "        c_.fillWeight = " & it.Fill & NL
                if ro then o &= "        c_.readOnly = true" & NL
                if it.Hidden then o &= "        c_.visible = false" & NL
                if len( it.Summary ) then o &= "        c_.summary = " & catalog.GridSummaryConst( it.Summary ) & NL
                o &= "        tkDataGrid_SetColumnInfo( " & h & ", " & i & ", c_ )" & NL
                o &= "    end scope" & NL
            elseif ro then
                o &= "    tkDataGrid_SetColumnReadOnly( " & h & ", " & i & ", true )" & NL
            end if
        next
    case catalog.ItemsKind.ItemsList
        for i as long = 0 to c.Items.Count( ) - 1
            o &= "    " & catalog.ItemsAddProc( c.TypeName ) & "( " & h & ", " & TextExpr_( doc, c.Name & "." & ItemId( c, i ), c.Items[i].Text ) & " )" & NL
        next
    case catalog.ItemsKind.ItemsTabs
        for i as long = 0 to c.Items.Count( ) - 1
            o &= "    tkTabBar_AddTab( " & h & ", " & TextExpr_( doc, c.Name & "." & ItemId( c, i ), c.Items[i].Text ) & " )" & NL
            if len( c.Items[i].Glyph ) then
                o &= "    tkTabBar_SetGlyph( " & h & ", " & i & ", " & ValueExpr_( c.Items[i].Glyph, "glyph", "" ) & " )" & NL
            end if
        next
    end select
end sub

private function HasColors_( byref c as FormControl ) as boolean
    return (len( c.StyleName ) > 0) orelse (c.Colors.Count( ) > 0)
end function

' [control.colors] as the control's recipe: its style by name, its fields, simple mode's derived
' states (colorval.Entries). The theme resolves it now and on every theme change.
private sub ColorsCode_( byref c as FormControl, byval m as TKMETA_CONTROL ptr, byref o as ustring )
    if HasColors_( c ) = false then exit sub
    dim as Array( of TKCOLOR_SRC ) list
    colorval.Entries( c.Colors, m, list )
    if list.Count( ) = 0 then
        o &= "    tkTheme_SetRecipeNamed( " & c.Name & ".Handle, " & Literal_( c.StyleName ) & ", 0, 0 )" & NL
        exit sub
    end if
    o &= "    scope" & NL
    o &= "        dim as TKCOLOR_SRC r( 0 to " & (list.Count( ) - 1) & " )" & NL
    for k as long = 0 to list.Count( ) - 1
        o &= "        r( " & k & " ) = " & colorval.SrcExpr( list[k], str( list[k].slot ) ) & "    ' " & m->Colors( list[k].slot ).Name & NL
    next
    o &= "        tkTheme_SetRecipeNamed( " & c.Name & ".Handle, " & Literal_( c.StyleName ) & ", @r( 0 ), " & list.Count( ) & " )" & NL
    o &= "    end scope" & NL
end sub

private sub CreateControl_( byref doc as FormDoc, byval idx as long, byref sz as Sizes, byref o as ustring )
    dim as FormControl c = doc.Controls[idx]
    dim as TKMETA_CONTROL ptr m = catalog.Find( c.TypeName )

    dim as ustring parent_ = "tkForm_Widget( Handle )"
    if len( c.Parent ) then
        dim as FormControl pc = doc.Controls[FindControl( doc, c.Parent )]
        parent_ = ChildParent_( pc, catalog.Find( pc.TypeName )->ContainerKind, c.Page )
    end if

    o &= "    " & c.Name & ".Create( " & parent_ & ", " & (idx + 1)
    if len( m->CreateArg ) then
        o &= ", " & ValueExpr_( SettingOr( c.Props, m->CreateArg, m->CreateArgDflt ), m->CreateArgKind, m->CreateArgEnum )
    end if
    o &= " )" & NL

    ' a component (a Timer) is never shown: nothing to lay out
    ' an attached Badge (D-B3) is placed by its target, not by the layout
    dim as boolean attached = (c.TypeName = catalog.BADGE_TYPE) andalso (len( c.AttachTo ) > 0)
    if m->Visual andalso attached then
        ' its Attach comes once every control exists (below, with the context menus)
    elseif m->Visual then
        o &= "    tkLayout_Add( Layout, " & c.Name & ".Handle, " & c.X & ", " & c.Y & ", " & c.W & ", " & c.H
        if (c.Anchor <> TK_ANCHOR_DEFAULT) orelse (c.Dock <> TK_DOCK_NONE) then o &= ", " & AnchorExpr_( c.Anchor )
        if c.Dock <> TK_DOCK_NONE then o &= ", " & DockExpr_( c.Dock )
        o &= " )" & NL
        ' a control that sizes its own dock (an InfoBar): told the layout it is in (controls.toml layout_hook)
        if len( m->LayoutHook ) then o &= "    " & m->LayoutHook & "( " & c.Name & ".Handle, Layout )" & NL
        ' Tab order set in the designer (Design > Tab Order): each control its place among its siblings
        dim as boolean anyTab = false
        for each x as FormControl in doc.Controls
            if x.TabIndex > 0 then anyTab = true
        next
        if anyTab then
            dim as Array( of long ) ranks = TabRanks( doc )
            o &= "    tkHost.tkWidget_SetTabIndex( " & c.Name & ".Handle, " & ranks[idx] & " )" & NL
        end if
    end if

    ' A tab control's pages exist before its properties are set, and before its children.
    if m->ContainerKind = TKMETA_CONTAINER_PAGES then
        for p as long = 0 to c.Pages.Count( ) - 1
            o &= "    tkTabControl_AddPage( " & c.Name & ".Handle, " & TextExpr_( doc, c.Name & ".Page" & PageId( c, p ), c.Pages[p] ) & " )" & NL
            if len( PageGlyph( c, p ) ) then
                o &= "    tkTabControl_SetPageGlyph( " & c.Name & ".Handle, " & p & ", " & ValueExpr_( PageGlyph( c, p ), "glyph", "" ) & " )" & NL
            end if
        next
    end if

    ItemsCode_( doc, idx, o )

    ' In the control table's order, not the file's: setters clamp and snap, so a Range must reach the
    ' control before the Value it bounds (controls.toml lists them so). The writer saves this order too.
    dim as Array( of long ) order_ = PropOrder_( c, m )
    for each pi_ as long in order_
        dim byref as Setting s = c.Props[pi_]
        if (s.Key = "Enabled") orelse (s.Key = "Visible") then
            o &= "    " & c.Name & "." & s.Key & " = " & s.Value & NL
        elseif s.Key = "GlyphFont" then
            ' below: every control with a glyph font gets the GLYPH role (GLYPHS.md, Glyph size)
        elseif s.Key <> m->CreateArg then
            dim as TKMETA_PROP ptr p = tkMeta_FindProp( m, s.Key )
            if p->Kind = "list" then
                o &= "    " & c.Name & "." & s.Key & "( " & ListExpr_( s.Value, p->EnumPairs ) & " )" & NL
            elseif (p->Kind = "text") andalso (NotWords_( c.TypeName, s.Key ) = false) then
                o &= "    " & c.Name & "." & s.Key & " = " & TextExpr_( doc, c.Name & "." & s.Key, s.Value ) & NL
            else
                o &= "    " & c.Name & "." & s.Key & " = " & ValueExpr_( s.Value, p->Kind, p->EnumPairs ) & NL
            end if
        end if
    next

    ' its glyphs (and tkControls' own icons it draws) in the GLYPH font: GlyphSize Large is GLYPH_LARGE,
    ' a size in points the GLYPH font's file opened at it (the form's surface keeps it)
    if tkMeta_FindProp( m, "GlyphFont" ) then
        if GlyphPoints( c ) > 0 then
            ' and the icon box as tall as the font, so the glyph isn't clipped -- unless it has its own size
            dim as boolean fit = (tkMeta_FindProp( m, "IconSize" ) <> 0) andalso (FindSetting( c.Props, "IconSize" ) < 0)
            ' (a tab bar's glyph box is one width)
            dim as boolean fitW = (tkMeta_FindProp( m, "IconWidth" ) <> 0) andalso (FindSetting( c.Props, "IconWidth" ) < 0)
            o &= "    scope" & NL
            o &= "        dim as TTF_Font ptr gf_ = tkHost.tkHost_OpenFont( tkForm_Host( Handle ), tkApp_GlyphFace( ), " & GlyphPoints( c ) & " )" & NL
            o &= "        " & c.Name & ".GlyphFont = gf_" & NL
            if fit then o &= "        " & c.Name & ".IconSize( TTF_GetFontHeight( gf_ ), TTF_GetFontHeight( gf_ ) )" & NL
            if fitW then o &= "        " & c.Name & ".IconWidth = TTF_GetFontHeight( gf_ )" & NL
            o &= "    end scope" & NL
        else
            o &= "    " & c.Name & ".GlyphFont = tkForm_Font( Handle, TKFONT_" & GlyphRole( c ) & " )" & NL
        end if
    end if

    ColorsCode_( c, m, o )

    for e as long = 0 to m->NumEvents - 1
        dim as boolean wired = (FindSetting( c.Events, m->Events( e ).Name ) >= 0)
        if Dispatches_( c, m->Events( e ).Name ) then wired = true
        if NavWires_( doc, c, m->Events( e ).Name ) then wired = true
        if wired then
            o &= "    " & m->Events( e ).SetName & "( " & c.Name & ".Handle, @Thunk_" & c.Name & "_" & m->Events( e ).Name & " )" & NL
        elseif len( m->Events( e ).Fallback ) then
            ' unbound, the control still needs one (a ListTree draws no row by itself)
            o &= "    " & m->Events( e ).SetName & "( " & c.Name & ".Handle, @" & m->Events( e ).Fallback & " )" & NL
        end if
    next

    ' Registered once, here, so a parent's container is always ahead of its children's.
    select case m->ContainerKind
    case TKMETA_NOT_CONTAINER
    case TKMETA_CONTAINER_PAGES
        for p as long = 0 to c.Pages.Count( ) - 1
            if HasChildren_( doc, c.Name, p ) then
                o &= "    tkLayout_AddContainer( Layout, " & ChildParent_( c, m->ContainerKind, p ) & ", " & sz.W[idx] & ", " & (sz.H[idx] - TabHeight_( c )) & " )" & NL
            end if
        next
    case TKMETA_CONTAINER_GROUPBOX
        if HasChildren_( doc, c.Name, -1 ) then
            o &= "    tkLayout_AddContainer( Layout, " & c.Name & ".Handle, " & sz.W[idx] & ", " & sz.H[idx] & ", @tkGroupBox_GetClientRect )" & NL
        end if
    case else
        if HasChildren_( doc, c.Name, -1 ) then
            o &= "    tkLayout_AddContainer( Layout, " & ChildParent_( c, m->ContainerKind, -1 ) & ", " & sz.W[idx] & ", " & sz.H[idx] & " )" & NL
        end if
    end select
end sub

public function WithoutCr( byref s as const ustring ) as ustring
    dim as ustring t
    dim as long i = 1, n = len( s )
    while i <= n
        dim as long j = instr( i, s, chr( 13 ) )
        if j = 0 then
            t &= mid( s, i )
            exit while
        end if
        t &= mid( s, i, j - i )
        i = j + 1
    wend
    return t
end function

' The drift mark: changes only when the form's content does, whatever line ends the checkout has.
public function SourceHash( byref sourceText as const ustring ) as ustring
    return left( hash.DigestHex( hash.HASH_SHA256, WithoutCr( sourceText ) ), 16 )
end function

' The keys and texts of a form that passed validate.Check, as its generated code asks for them; none
' when the form isn't Translatable.
public function TranslatableTexts( byref doc as FormDoc, byref moduleName as const ustring ) as Array( of TrEntry )
    gTexts_.Clear( )
    gCollect_ = true
    Generate( doc, moduleName, "", "" )
    gCollect_ = false
    dim as Array( of TrEntry ) r = gTexts_
    gTexts_.Clear( )
    return r
end function

' ---- data binding (B1) ---------------------------------------------------------------------
' A control whose value LoadFrom / SaveTo move: bound to a field, and of a type that has a value.
private function IsBound_( byref c as FormControl ) as boolean
    if len( c.Bind ) = 0 then return false
    dim as TKMETA_CONTROL ptr m = catalog.Find( c.TypeName )
    if m = 0 then return false
    return len( m->BindKind ) > 0
end function

' The form generates LoadFrom / SaveTo: it names its record type and binds at least one control.
private function HasBinding_( byref doc as FormDoc ) as boolean
    if len( doc.DataType ) = 0 then return false
    for each c as FormControl in doc.Controls
        if IsBound_( c ) orelse (catalog.ListReady( c ) andalso (len( c.ItemsField ) > 0)) then return true
        if catalog.NavReady( doc ) >= 0 then return true
    next
    return false
end function

' ---- list binding (B3) ----------------------------------------------------------------------
' A ComboBox keeps its items' ValueField texts in a generated member, <name>_Values_.
private function HasValues_( byref c as FormControl ) as boolean
    if catalog.ItemsKeyed( c.TypeName ) orelse catalog.ItemsIdKeyed( c.TypeName ) then return false   ' its keys / ids ARE the values
    return (catalog.ItemsBindOf( c ) = "items") andalso catalog.ListReady( c ) andalso (len( c.ValueField ) > 0)
end function

private function AnyList_( byref doc as FormDoc ) as boolean
    for each c as FormControl in doc.Controls
        if catalog.ListReady( c ) then return true
    next
    ' a wired navigator steps through an Array( of DataType ) even with no list beside it
    return catalog.NavReady( doc ) >= 0
end function

' A list the inspector has left half filled in: the build stops on it, saying what it still needs.
private sub ListErrors_( byref doc as FormDoc, byref o as ustring )
    for each c as FormControl in doc.Controls
        dim as ustring missing = catalog.ListMissing( c )
        if len( missing ) then o &= "#error " & Literal_( c.Name & ": " & missing & " (Form Designer)" ) & NL
    next
end sub

private function AnyValues_( byref doc as FormDoc ) as boolean
    for each c as FormControl in doc.Controls
        if HasValues_( c ) then return true
    next
    return false
end function

' The loop that fills c's list from src (an Array( of T ) expression, T = ItemType): a row per
' element with a column per field (ListTree; a ReportViewer's report, laid out again after), or an
' item per element showing DisplayField (ComboBox).
' A name is bound by reference, a call's result copied once. The array's type is spelled out, not
' typeof( src ): typeof of a member declared in the form's other file, or of a record's array field,
' reaches the compiler's limits (TKO0700 on [ ], TKO0994) -- see Learnings, B3.
private sub FillBody_( byref c as FormControl, byref src as const ustring, byref o as ustring )
    dim as ustring h = c.Name & ".Handle"
    dim as ustring kw = "byref "
    if right( trim( src ), 1 ) = ")" then kw = ""
    o &= "    scope" & NL
    o &= "        dim " & kw & "as Array( of " & c.ItemType & " ) a_ = " & src & NL
    if (catalog.ItemsBindOf( c ) = "grid") andalso c.ItemsLive then
        ' G5b: the grid reads and writes the array itself, through the Live_ procedures (LiveCode_)
        o &= "        dim as TKDATAGRID_SOURCE src_" & NL
        o &= "        src_.pCtx = @a_" & NL
        o &= "        src_.RowCount = @" & LiveName_( c, "Count" ) & NL
        o &= "        src_.GetCell = @" & LiveName_( c, "Get" ) & NL
        o &= "        src_.SetCell = @" & LiveName_( c, "Set" ) & NL
        o &= "        src_.InsertRows = @" & LiveName_( c, "Insert" ) & NL
        o &= "        src_.DeleteRows = @" & LiveName_( c, "Delete" ) & NL
        o &= "        tkDataGrid_SetSource( " & h & ", @src_ )" & NL
    elseif catalog.ItemsBindOf( c ) = "grid" then
        ' G5: a row per element, each column's field through tkBind as the column's kind
        o &= "        tkDataGrid_BeginUpdate( " & h & " )" & NL
        o &= "        tkDataGrid_SetRowCount( " & h & ", 0 )" & NL
        o &= "        tkDataGrid_SetRowCount( " & h & ", a_.Count( ) )" & NL
        o &= "        for i_ as int32 = 0 to a_.Count( ) - 1" & NL
        for k as long = 0 to c.Items.Count( ) - 1
            if len( c.Items[k].Field ) = 0 then continue for
            dim as ustring vk = catalog.GridValueKind( c.Items[k].Kind )
            o &= "            tkDataGrid_SetCell" & vk & "( " & h & ", i_, " & k & ", tkBind_" & vk & "( a_[i_]." & c.Items[k].Field & " ) )" & NL
        next
        o &= "        next" & NL
        o &= "        tkDataGrid_EndUpdate( " & h & " )" & NL
    elseif catalog.ItemsBindOf( c ) = "rows" then
        o &= "        tkListTree_BeginUpdate( " & h & " )" & NL
        o &= "        tkListTree_Clear( " & h & " )" & NL
        ' a CheckField shows in the rows' check boxes, which the ListTree then has
        if len( c.CheckField ) then o &= "        tkListTree_SetCheckBoxes( " & h & ", true )" & NL
        o &= "        for i_ as int32 = 0 to a_.Count( ) - 1" & NL
        dim as ustring first_ = """"""
        if c.Items.Count( ) andalso len( c.Items[0].Field ) then first_ = "tkBind_Text( a_[i_]." & c.Items[0].Field & " )"
        o &= "            dim as integer row_ = tkListTree_AddString( " & h & ", " & first_ & " )" & NL
        for k as long = 1 to c.Items.Count( ) - 1
            if len( c.Items[k].Field ) then
                o &= "            tkListTree_SetCellText( " & h & ", row_, " & k & ", tkBind_Text( a_[i_]." & c.Items[k].Field & " ) )" & NL
            end if
        next
        o &= "            tkListTree_SetItemData( " & h & ", row_, i_ )" & NL
        if len( c.CheckField ) then
            o &= "            tkListTree_SetCheck( " & h & ", row_, iif( tkBind_Bool( a_[i_]." & c.CheckField & " ), 1, 0 ) )" & NL
        end if
        o &= "        next" & NL
        o &= "        tkListTree_EndUpdate( " & h & " )" & NL
    elseif catalog.ItemsBindOf( c ) = "report" then
        ' a ReportViewer's report (R5): a row per element, column k's Field as field k, by its own type
        o &= "        tkReportViewer_ClearRows( " & h & " )" & NL
        o &= "        for i_ as int32 = 0 to a_.Count( ) - 1" & NL
        o &= "            dim as integer row_ = tkReportViewer_AddRow( " & h & " )" & NL
        for k as long = 0 to c.Items.Count( ) - 1
            if len( c.Items[k].Field ) then
                o &= "            tkBind_ToValue( a_[i_]." & c.Items[k].Field & ", tkReportViewer_Cell( " & h & ", row_, " & k & " ) )" & NL
            end if
        next
        o &= "        next" & NL
        o &= "        tkReportViewer_RefreshReport( " & h & " )" & NL
    else
        o &= "        " & catalog.ItemsClearProc( c.TypeName ) & "( " & h & " )" & NL
        if HasValues_( c ) then o &= "        " & c.Name & "_Values_.Clear( )" & NL
        o &= "        for i_ as int32 = 0 to a_.Count( ) - 1" & NL
        ' a keyed list (the checked-list controls) takes ValueField as each item's key
        dim as ustring keyArg
        if catalog.ItemsKeyed( c.TypeName ) andalso len( c.ValueField ) then keyArg = ", tkBind_Text( a_[i_]." & c.ValueField & " )"
        ' an id-keyed list (AutoComplete) takes ValueField as each item's numeric id
        if catalog.ItemsIdKeyed( c.TypeName ) andalso len( c.ValueField ) then keyArg = ", tkBind_Int( a_[i_]." & c.ValueField & " )"
        o &= "            " & catalog.ItemsAddProc( c.TypeName ) & "( " & h & ", tkBind_Text( a_[i_]." & c.DisplayField & " )" & keyArg & " )" & NL
        if HasValues_( c ) then o &= "            " & c.Name & "_Values_.Push( tkBind_Text( a_[i_]." & c.ValueField & " ) )" & NL
        o &= "        next" & NL
    end if
    o &= "    end scope" & NL
end sub

' G5: a DataGrid filled from an ItemsField writes its rows back in SaveTo.
private function GridWritesBack_( byref c as FormControl ) as boolean
    return (catalog.ItemsBindOf( c ) = "grid") andalso (len( c.ItemsField ) > 0) andalso catalog.ListReady( c )
end function

' A column field that is a method's value (Total( )): shown, not written.
private function GridMethodField_( byref f as const ustring ) as boolean
    return right( trim( f ), 1 ) = ")"
end function

private function LiveName_( byref c as FormControl, byref what as const ustring ) as ustring
    return "Live_" & c.Name & "_" & what
end function

' G5b: a live DataGrid's source procedures, one set per grid. pCtx is the Array object itself (not its
' storage), so the array may grow under the binding; the host keeps it alive while the grid shows it.
private sub LiveCode_( byref doc as FormDoc, byref o as ustring )
    for each c as FormControl in doc.Controls
        if (catalog.ItemsBindOf( c ) <> "grid") orelse (c.ItemsLive = false) orelse (catalog.ListReady( c ) = false) then continue for
        dim as ustring A = "Array( of " & c.ItemType & " )"
        dim as ustring a_ = "    dim byref as " & A & " a_ = *cptr( " & A & " ptr, p_ )" & NL
        o &= "' " & c.Name & " shows its array in place (ItemsLive)" & NL
        o &= "private function " & LiveName_( c, "Count" ) & "( byval p_ as any ptr ) as integer" & NL
        o &= "    return cptr( " & A & " ptr, p_ )->Count( )" & NL
        o &= "end function" & NL & NL
        o &= "private sub " & LiveName_( c, "Get" ) & "( byval p_ as any ptr, byval row_ as integer, byval col_ as integer, byref v_ as TKDG_VALUE )" & NL
        o &= a_
        o &= "    select case col_" & NL
        for k as long = 0 to c.Items.Count( ) - 1
            if len( c.Items[k].Field ) = 0 then continue for
            dim as ustring vk = catalog.GridValueKind( c.Items[k].Kind )
            o &= "    case " & k & " : v_.Set" & vk & "( tkBind_" & vk & "( a_[row_]." & c.Items[k].Field & " ) )" & NL
        next
        o &= "    end select" & NL
        o &= "end sub" & NL & NL
        o &= "private function " & LiveName_( c, "Set" ) & "( byval p_ as any ptr, byval row_ as integer, byval col_ as integer, byref v_ as TKDG_VALUE ) as boolean" & NL
        o &= a_
        o &= "    select case col_" & NL
        for k as long = 0 to c.Items.Count( ) - 1
            dim as ustring f = c.Items[k].Field
            if (len( f ) = 0) orelse GridMethodField_( f ) then continue for
            dim as ustring m
            select case catalog.GridValueKind( c.Items[k].Kind )
            case "Float" : m = "f"
            case "Bool"  : m = "b"
            case "Date"  : m = "d"
            case else    : m = "s"
            end select
            o &= "    case " & k & " : tkBind_Put( a_[row_]." & f & ", v_." & m & " )" & NL
        next
        o &= "    case else : return false" & NL
        o &= "    end select" & NL
        o &= "    return true" & NL
        o &= "end function" & NL & NL
        o &= "private function " & LiveName_( c, "Insert" ) & "( byval p_ as any ptr, byval row_ as integer, byval n_ as integer ) as boolean" & NL
        o &= a_
        o &= "    for j_ as integer = 1 to n_" & NL
        o &= "        dim as " & c.ItemType & " new_" & NL
        o &= "        a_.Insert( row_, new_ )" & NL
        o &= "    next" & NL
        o &= "    return true" & NL
        o &= "end function" & NL & NL
        o &= "private function " & LiveName_( c, "Delete" ) & "( byval p_ as any ptr, byval row_ as integer, byval n_ as integer ) as boolean" & NL
        o &= a_
        o &= "    for j_ as integer = 1 to n_" & NL
        o &= "        a_.Remove( row_ )" & NL
        o &= "    next" & NL
        o &= "    return true" & NL
        o &= "end function" & NL & NL
    next
end sub

' The array as long as the grid, each column with a plain field (not a method) written from its cell.
' A live grid already wrote into the array it shows: only another record's array is copied.
private sub GridSaveBody_( byref c as FormControl, byref o as ustring )
    dim as ustring h = c.Name & ".Handle"
    ' the copy, indented one more step inside a live grid's "not this array" test
    dim as ustring b, t = "        "
    if c.ItemsLive then t = "            "
    b &= t & "dim as int32 n_ = tkDataGrid_GetRowCount( " & h & " )" & NL
    ' shorter: cut; longer: new elements pushed (SetCount cannot grow past what is constructed)
    b &= t & "if a_.Count( ) > n_ then a_.SetCount( n_ )" & NL
    b &= t & "while a_.Count( ) < n_" & NL
    b &= t & "    dim as " & c.ItemType & " new_" & NL
    b &= t & "    a_.Push( new_ )" & NL
    b &= t & "wend" & NL
    b &= t & "for i_ as int32 = 0 to n_ - 1" & NL
    for k as long = 0 to c.Items.Count( ) - 1
        dim as ustring f = c.Items[k].Field
        if (len( f ) = 0) orelse GridMethodField_( f ) then continue for
        b &= t & "    tkBind_Put( a_[i_]." & f & ", tkDataGrid_GetCell" & catalog.GridValueKind( c.Items[k].Kind ) & "( " & h & ", i_, " & k & " ) )" & NL
    next
    b &= t & "next" & NL
    o &= "    scope" & NL
    o &= "        dim byref as Array( of " & c.ItemType & " ) a_ = r." & c.ItemsField & NL
    if c.ItemsLive then
        o &= "        if tkDataGrid_GetSourceContext( " & h & " ) <> cptr( any ptr, @a_ ) then" & NL
        o &= b
        o &= "        end if" & NL
    else
        o &= b
    end if
    o &= "    end scope" & NL
end sub

' IsDirty's test for a grid filled from r's ItemsField. A live grid showing r's own array has written
' every edit into it already: only its open edit counts.
private sub GridDirty_( byref c as FormControl, byref o as ustring )
    dim as ustring h = c.Name & ".Handle"
    o &= "    if tkDataGrid_IsEditing( " & h & " ) then return true" & NL
    o &= "    scope" & NL
    o &= "        dim byref as Array( of " & c.ItemType & " ) a_ = r." & c.ItemsField & NL
    dim as ustring t = "        "
    if c.ItemsLive then
        o &= "        if tkDataGrid_GetSourceContext( " & h & " ) <> cptr( any ptr, @a_ ) then" & NL
        t = "            "
    end if
    o &= t & "if tkDataGrid_GetRowCount( " & h & " ) <> a_.Count( ) then return true" & NL
    o &= t & "for i_ as int32 = 0 to a_.Count( ) - 1" & NL
    for k as long = 0 to c.Items.Count( ) - 1
        dim as ustring f = c.Items[k].Field
        if (len( f ) = 0) orelse GridMethodField_( f ) then continue for
        dim as ustring vk = catalog.GridValueKind( c.Items[k].Kind )
        dim as ustring fmt
        if vk = "Text" then fmt = ", """""
        o &= t & "    if tkBind_Differs( a_[i_]." & f & ", tkDataGrid_GetCell" & vk & "( " & h & ", i_, " & k & " )" & fmt & " ) then return true" & NL
    next
    o &= t & "next" & NL
    if c.ItemsLive then o &= "        end if" & NL
    o &= "    end scope" & NL
end sub

' The list members: <name>_Fill( ) for an ItemsSource (the program calls it; an ItemsField is
' filled by LoadFrom), <name>_Item( ) for a ListTree: the chosen row's element, -1 for none.
private sub ListDecls_( byref doc as FormDoc, byref o as ustring )
    for each c as FormControl in doc.Controls
        if catalog.ListReady( c ) = false then continue for
        if HasValues_( c ) then o &= "    " & c.Name & "_Values_ as Array( of ustring )" & NL
        if len( c.ItemsSource ) then o &= "    declare sub " & c.Name & "_Fill( )" & NL
        if (catalog.ItemsBindOf( c ) = "rows") orelse (catalog.ItemsBindOf( c ) = "grid") then o &= "    declare function " & c.Name & "_Item( ) as int32" & NL
    next
end sub

private sub ListCode_( byref doc as FormDoc, byref o as ustring )
    for each c as FormControl in doc.Controls
        if catalog.ListReady( c ) = false then continue for
        if len( c.ItemsSource ) then
            o &= NL & "sub Form." & c.Name & "_Fill( )" & NL
            FillBody_( c, c.ItemsSource, o )
            o &= "end sub" & NL
        end if
        if catalog.ItemsBindOf( c ) = "grid" then
            ' the current row is its element (the grid keeps the array's order: no sort reaches the store)
            o &= NL & "function Form." & c.Name & "_Item( ) as int32" & NL
            o &= "    dim as integer r_, c_" & NL
            o &= "    if tkDataGrid_GetCurrentCell( " & c.Name & ".Handle, r_, c_ ) = false then return -1" & NL
            o &= "    if r_ >= tkDataGrid_GetRowCount( " & c.Name & ".Handle ) then return -1" & NL
            o &= "    return r_" & NL
            o &= "end function" & NL
        end if
        if catalog.ItemsBindOf( c ) = "rows" then
            o &= NL & "function Form." & c.Name & "_Item( ) as int32" & NL
            o &= "    dim as int32 row_ = tkListTree_GetCurSel( " & c.Name & ".Handle )" & NL
            o &= "    if row_ < 0 then return -1" & NL
            o &= "    return tkListTree_GetItemData( " & c.Name & ".Handle, row_ )" & NL
            o &= "end function" & NL
        end if
    next
end sub

private function BindFn_( byref kind as const ustring ) as ustring
    select case kind
    case "text"  : return "Text"
    case "bool"  : return "Bool"
    case "int"   : return "Int"
    case "float" : return "Float"
    case "date"  : return "Date"
    case "time"  : return "Time"
    case "datetime" : return "DateTime"
    end select
    return ""
end function

' The value a getter returns, as its kind's own type: the overload is then chosen by the field alone.
private function BindGot_( byref kind as const ustring, byref getter as const ustring, byref ctl as const ustring ) as ustring
    dim as ustring v = getter & "( " & ctl & ".Handle )"
    select case kind
    case "int"   : return "clngint( " & v & " )"
    case "float" : return "cdbl( " & v & " )"
    end select
    return v
end function

' B2: the kinds SaveTo checks before it writes (a bool always converts; a time isn't covered), and
' the kinds LoadFrom reads back to see whether the control shows the field as it is.
private function Checked_( byref kind as const ustring ) as boolean
    return (kind = "text") orelse (kind = "int") orelse (kind = "float") orelse (kind = "date")
end function

private function ReadBack_( byref kind as const ustring ) as boolean
    return (kind = "int") orelse (kind = "float") orelse (kind = "date")
end function

' A control's rules as a tkBind_Rule( ... ) argument.
private function RuleArg_( byref c as FormControl, byval m as TKMETA_CONTROL ptr ) as ustring
    dim as ustring r = "tkBind_Rule( " & iif( c.Required, "true", "false" ) & ", " & Literal_( c.Minimum ) & ", " _
        & Literal_( c.Maximum ) & ", " & c.MaxLength & ", " & Literal_( c.Format )
    if len( m->BindNone ) then r &= ", true, " & m->BindNone
    return r & " )"
end function

' The report both make when they found something: the form's ValidationError handler first, then
' (unless it set Handled) tkBind's presenter, by default a message box over the form.
private sub BindReport_( byref doc as FormDoc, byref o as ustring, byref loading as const ustring )
    o &= "    if bindErrors_.Count then" & NL
    dim as long i = FindSetting( doc.Events, "ValidationError" )
    o &= "        dim as boolean bindHandled_ = false" & NL
    if i >= 0 then o &= "        " & doc.Events[i].Value & "( bindErrors_, " & loading & ", bindHandled_ )" & NL
    o &= "        if bindHandled_ = false then tkBind_ShowErrors( Handle, bindErrors_, " & loading & " )" & NL
    o &= "        return false" & NL
    o &= "    end if" & NL
end sub

' The control bound to the same field as control i with the other half of a date and a time (a
' DatePicker and a TimePicker on one DateTime), or -1. SaveTo writes the pair in ONE call: on a new
' record the DateTime is Invalid, and a time half saved first would have no date to sit on
' (claude-docs TIMEPICKER.md 10.2).
private function DateTimePair_( byref doc as FormDoc, byval i as long ) as long
    dim as TKMETA_CONTROL ptr m = catalog.Find( doc.Controls[i].TypeName )
    if (m = 0) orelse m->BindLoadOnly then return -1
    dim as ustring want
    select case m->BindKind
    case "date" : want = "time"
    case "time" : want = "date"
    case else : return -1
    end select
    dim as ustring fld = lcase( doc.Controls[i].Bind )
    for j as long = 0 to doc.Controls.Count( ) - 1
        if (j <> i) andalso IsBound_( doc.Controls[j] ) andalso (lcase( doc.Controls[j].Bind ) = fld) then
            dim as TKMETA_CONTROL ptr mj = catalog.Find( doc.Controls[j].TypeName )
            if (mj <> 0) andalso (mj->BindKind = want) andalso (mj->BindLoadOnly = false) then return j
        end if
    next
    return -1
end function

' Moving each bound control's value in from r, and out to it, through tkBind's overloads: the
' compiler picks one by the field's type. Setters are silent, so LoadFrom notifies nobody. A
' two-value control's second field (bind2) follows its first: a range Slider's setters push the
' other thumb, so lower then upper lands on any pair.
' B2: SaveTo checks every value first (tkBind_Check, and tkBind_Range for a Minimum / Maximum) and
' writes nothing unless all pass; LoadFrom reads each number, index and date back (tkBind_Loaded) and
' reports a value the control couldn't show as it is. Both answer whether all was well.
private sub BindingCode_( byref doc as FormDoc, byref o as ustring )
    o &= NL & "function Form.LoadFrom( byref r as " & doc.DataType & " ) as boolean" & NL
    o &= "    dim as TKBIND_ERRORS bindErrors_" & NL
    for each c as FormControl in doc.Controls
        if len( c.ItemsField ) andalso catalog.ListReady( c ) then FillBody_( c, "r." & c.ItemsField, o )
        if IsBound_( c ) = false then continue for
        dim as TKMETA_CONTROL ptr m = catalog.Find( c.TypeName )
        if catalog.BindsByValue( c ) then
            dim as ustring hv = c.Name & ".Handle"
            o &= "    tkComboBox_SetCurSel( " & hv & ", tkBind_IndexOf( " & c.Name & "_Values_, tkBind_Text( r." & c.Bind & " ) ) )" & NL
            o &= "    tkBind_LoadedPick( bindErrors_, " & hv & ", " & Literal_( c.Bind ) & ", tkBind_Text( r." & c.Bind & " ), tkComboBox_GetCurSel( " & hv & " ) )" & NL
            continue for
        end if
        dim as ustring fmt
        if len( c.Format ) then fmt = ", " & Literal_( c.Format )
        o &= "    " & m->BindSet & "( " & c.Name & ".Handle, tkBind_" & BindFn_( m->BindKind ) & "( r." & c.Bind & fmt & " ) )" & NL
        if ReadBack_( m->BindKind ) andalso len( m->BindGet ) then
            o &= "    tkBind_Loaded( bindErrors_, " & c.Name & ".Handle, " & Literal_( c.Bind ) & ", r." & c.Bind & ", " & BindGot_( m->BindKind, m->BindGet, c.Name ) & " )" & NL
        end if
        if c.TypeName = "TextBox" then o &= "    tkTextBox_SetError( " & c.Name & ".Handle, false )" & NL
        if len( c.Bind2 ) andalso catalog.Bind2Holds( c ) then
            o &= "    " & m->Bind2Set & "( " & c.Name & ".Handle, tkBind_" & BindFn_( m->Bind2Kind ) & "( r." & c.Bind2 & " ) )" & NL
            if ReadBack_( m->Bind2Kind ) andalso len( m->Bind2Get ) then
                o &= "    tkBind_Loaded( bindErrors_, " & c.Name & ".Handle, " & Literal_( c.Bind2 ) & ", r." & c.Bind2 & ", " & BindGot_( m->Bind2Kind, m->Bind2Get, c.Name ) & " )" & NL
            end if
        end if
    next
    BindReport_( doc, o, "true" )
    o &= "    return true" & NL
    o &= "end function" & NL & NL

    o &= "function Form.SaveTo( byref r as " & doc.DataType & " ) as boolean" & NL
    o &= "    dim as TKBIND_ERRORS bindErrors_" & NL
    ' a grid's open edit first: a value it refuses stops the save, as a check would
    for each c as FormControl in doc.Controls
        if GridWritesBack_( c ) then o &= "    if tkDataGrid_EndEdit( " & c.Name & ".Handle, true ) = false then return false" & NL
    next
    ' first every check: nothing is written unless all pass
    for each c as FormControl in doc.Controls
        if IsBound_( c ) = false then continue for
        dim as TKMETA_CONTROL ptr m = catalog.Find( c.TypeName )
        if m->BindLoadOnly then continue for
        if catalog.BindsByValue( c ) then
            o &= "    tkBind_CheckPick( bindErrors_, " & c.Name & ".Handle, " & Literal_( c.Bind ) & ", r." & c.Bind & ", " & c.Name & "_Values_, " _
                & "tkComboBox_GetCurSel( " & c.Name & ".Handle ), " & RuleArg_( c, m ) & " )" & NL
            continue for
        end if
        if Checked_( m->BindKind ) then
            dim as ustring tail_ = c.Name & ".Handle, " & Literal_( c.Bind ) & ", r." & c.Bind & ", " & BindGot_( m->BindKind, m->BindGet, c.Name ) & ", " & RuleArg_( c, m ) & " )"
            o &= "    tkBind_Check( bindErrors_, " & tail_ & NL
            if len( c.Minimum ) orelse len( c.Maximum ) then o &= "    tkBind_Range( bindErrors_, " & tail_ & NL
        end if
        if len( c.Bind2 ) andalso catalog.Bind2Holds( c ) andalso Checked_( m->Bind2Kind ) then
            o &= "    tkBind_Check( bindErrors_, " & c.Name & ".Handle, " & Literal_( c.Bind2 ) & ", r." & c.Bind2 & ", " _
                & BindGot_( m->Bind2Kind, m->Bind2Get, c.Name ) & ", tkBind_Rule( ) )" & NL
        end if
    next
    for each c as FormControl in doc.Controls
        if IsBound_( c ) andalso (c.TypeName = "TextBox") then
            o &= "    tkTextBox_SetError( " & c.Name & ".Handle, bindErrors_.Has( " & c.Name & ".Handle ) )" & NL
        end if
    next
    BindReport_( doc, o, "false" )
    ' then the writes
    for i as long = 0 to doc.Controls.Count( ) - 1
        dim as FormControl c = doc.Controls[i]
        if IsBound_( c ) = false then continue for
        dim as TKMETA_CONTROL ptr m = catalog.Find( c.TypeName )
        if m->BindLoadOnly then continue for
        ' a date and a time control on one field: one call, at the first of the two
        dim as long pair_ = DateTimePair_( doc, i )
        if pair_ >= 0 then
            if pair_ < i then continue for
            dim as FormControl c2 = doc.Controls[pair_]
            dim as TKMETA_CONTROL ptr m2 = catalog.Find( c2.TypeName )
            dim as ustring dGot = BindGot_( m->BindKind, m->BindGet, c.Name ), tGot = BindGot_( m2->BindKind, m2->BindGet, c2.Name )
            if m->BindKind = "time" then swap dGot, tGot
            o &= "    tkBind_Put( r." & c.Bind & ", " & dGot & ", " & tGot & " )" & NL
            continue for
        end if
        if catalog.BindsByValue( c ) then
            o &= "    tkBind_PutPick( r." & c.Bind & ", " & c.Name & "_Values_, tkComboBox_GetCurSel( " & c.Name & ".Handle ) )" & NL
            continue for
        end if
        dim as ustring fmt
        if len( c.Format ) andalso (m->BindKind = "text") then fmt = ", " & Literal_( c.Format )
        o &= "    tkBind_Put( r." & c.Bind & ", " & BindGot_( m->BindKind, m->BindGet, c.Name ) & fmt & " )" & NL
        if len( c.Bind2 ) andalso catalog.Bind2Holds( c ) then
            o &= "    tkBind_Put( r." & c.Bind2 & ", " & BindGot_( m->Bind2Kind, m->Bind2Get, c.Name ) & " )" & NL
        end if
    next
    ' G5: every grid row back into its ItemsField array, rows added and deleted included
    for each c as FormControl in doc.Controls
        if GridWritesBack_( c ) then GridSaveBody_( c, o )
    next
    o &= "    return true" & NL
    o &= "end function" & NL
end sub

' ---- the record navigator (B4) ----------------------------------------------------------------
' Its own Navigate thunk (the user's handler first, which may say no) and the followed list's
' SelChange thunk (the navigator follows, then the user's handler) are made even with no handler.
private function NavWires_( byref doc as FormDoc, byref c as FormControl, byref evName as const ustring ) as boolean
    dim as long ni = catalog.NavReady( doc )
    if ni < 0 then return false
    if (lcase( c.Name ) = lcase( doc.Controls[ni].Name )) andalso (evName = "Navigate") then return true
    dim as long li = catalog.NavList( doc )
    if (li < 0) orelse (lcase( c.Name ) <> lcase( doc.Controls[li].Name )) then return false
    ' a DataGrid moves its current row (CurrentCellChanged); a ListTree / ComboBox its selection
    if catalog.ItemsBindOf( c ) = "grid" then return evName = "CurrentCellChanged"
    return evName = "SelChange"
end function

private function NavThunk_( byref doc as FormDoc, byref k as FormControl, byval ev as TKMETA_EVENT ptr, byval i as long, byref o as ustring ) as boolean
    if NavWires_( doc, k, ev->Name ) = false then return false
    dim as FormControl nav = doc.Controls[catalog.NavReady( doc )]
    if ev->Name = "Navigate" then
        o &= "private function Thunk_" & k.Name & "_Navigate" & Parens_( ev->Sig ) & " as boolean" & NL
        o &= "    dim as boolean Allow = true" & NL
        o &= "    dim as Form ptr f = tkForms_ObjectOf( " & WidgetOf_( *ev ) & " )" & NL
        o &= "    if f = 0 then return true" & NL
        if i >= 0 then o &= "    f->" & k.Events[i].Value & Parens_( ev->Args ) & NL
        o &= "    if Allow then f->" & nav.Name & "_Go_( action, target )" & NL
        o &= "    return false                ' the form has moved it, or kept it: the navigator takes nothing itself" & NL
        o &= "end function" & NL & NL
    else
        o &= "private sub Thunk_" & k.Name & "_" & ev->Name & Parens_( ev->Sig ) & NL
        o &= "    dim as Form ptr f = tkForms_ObjectOf( " & WidgetOf_( *ev ) & " )" & NL
        o &= "    if f = 0 then exit sub" & NL
        o &= "    f->" & nav.Name & "_FromList_( )" & NL
        if i >= 0 then o &= "    f->" & k.Events[i].Value & Parens_( ev->Args ) & NL
        o &= "end sub" & NL & NL
    end if
    return true
end function

private sub NavDecls_( byref doc as FormDoc, byref o as ustring )
    dim as long ni = catalog.NavReady( doc )
    if ni < 0 then exit sub
    dim as ustring n = doc.Controls[ni].Name
    o &= "    declare function IsDirty( byref r as " & doc.DataType & " ) as boolean" & NL
    o &= "    declare function " & n & "_MoveTo( byval i as int32 ) as boolean" & NL
    o &= "    declare sub " & n & "_Refresh( )" & NL
    o &= "    declare function " & n & "_Current( ) as int32" & NL
    o &= "    declare function " & n & "_Go_( byval action as int32, byval target as int32 ) as boolean" & NL
    if catalog.NavList( doc ) >= 0 then
        o &= "    declare sub " & n & "_FromList_( )" & NL
        o &= "    declare sub " & n & "_ListRow_( byval i as int32 )" & NL
    end if
end sub

' The followed list's selection, silently.
private sub NavSelect_( byref doc as FormDoc, byref idx as const ustring, byref o as ustring, byref indent as const ustring )
    dim as long li = catalog.NavList( doc )
    if li < 0 then exit sub
    dim as FormControl l = doc.Controls[li]
    if catalog.ItemsBindOf( l ) = "rows" then
        o &= indent & "tkListTree_SetCurSel( " & l.Name & ".Handle, " & idx & " )" & NL
    elseif catalog.ItemsBindOf( l ) = "grid" then
        ' the record's row, in the column the grid is on (silent: no CurrentCellChanged)
        o &= indent & "scope" & NL
        o &= indent & "    dim as integer r_, c_" & NL
        o &= indent & "    tkDataGrid_GetCurrentCell( " & l.Name & ".Handle, r_, c_ )" & NL
        o &= indent & "    tkDataGrid_SetCurrentCell( " & l.Name & ".Handle, " & idx & ", iif( c_ < 0, 0, c_ ) )" & NL
        o &= indent & "end scope" & NL
    else
        o &= indent & "tkComboBox_SetCurSel( " & l.Name & ".Handle, " & idx & " )" & NL
    end if
end sub

private sub NavCode_( byref doc as FormDoc, byref o as ustring )
    dim as long ni = catalog.NavReady( doc )
    if ni < 0 then exit sub
    dim as FormControl nav = doc.Controls[ni]
    dim as ustring n = nav.Name, nh = nav.Name & ".Handle", src = nav.ItemsSource, T = doc.DataType
    dim as long li = catalog.NavList( doc )
    dim as ustring arr = "    dim byref as Array( of " & T & " ) a_ = " & src & NL

    ' IsDirty: any bound control that shows something else than r holds
    o &= NL & "function Form.IsDirty( byref r as " & T & " ) as boolean" & NL
    for each c as FormControl in doc.Controls
        if IsBound_( c ) = false then continue for
        dim as TKMETA_CONTROL ptr m = catalog.Find( c.TypeName )
        if m->BindLoadOnly then continue for
        if catalog.BindsByValue( c ) then
            o &= "    if tkBind_DiffersPick( r." & c.Bind & ", " & c.Name & "_Values_, tkComboBox_GetCurSel( " & c.Name & ".Handle ) ) then return true" & NL
        elseif m->BindKind = "text" then
            o &= "    if tkBind_Differs( r." & c.Bind & ", " & BindGot_( m->BindKind, m->BindGet, c.Name ) & ", " & Literal_( c.Format ) & " ) then return true" & NL
        elseif Checked_( m->BindKind ) orelse (m->BindKind = "bool") then
            o &= "    if tkBind_Differs( r." & c.Bind & ", " & BindGot_( m->BindKind, m->BindGet, c.Name ) & " ) then return true" & NL
        end if
        if len( c.Bind2 ) andalso catalog.Bind2Holds( c ) andalso (Checked_( m->Bind2Kind ) orelse (m->Bind2Kind = "bool")) andalso (m->Bind2Kind <> "text") then
            o &= "    if tkBind_Differs( r." & c.Bind2 & ", " & BindGot_( m->Bind2Kind, m->Bind2Get, c.Name ) & " ) then return true" & NL
        end if
    next
    ' a grid on one of r's arrays: an open edit, another row count, or any cell that differs
    for each c as FormControl in doc.Controls
        if GridWritesBack_( c ) then GridDirty_( c, o )
    next
    o &= "    return false" & NL
    o &= "end function" & NL

    ' MoveTo: save a changed record (SaveTo may refuse), then load i
    o &= NL & "function Form." & n & "_MoveTo( byval i as int32 ) as boolean" & NL
    o &= arr
    o &= "    if (i < 0) orelse (i >= a_.Count( )) then return false" & NL
    o &= "    dim as int32 cur = tkNavigator_GetPosition( " & nh & " )" & NL
    o &= "    if (cur >= 0) andalso (cur < a_.Count( )) then" & NL
    o &= "        if cur = i then return true" & NL
    o &= "        if IsDirty( a_[cur] ) then" & NL
    o &= "            if SaveTo( a_[cur] ) = false then return false" & NL
    if li >= 0 then o &= "            " & n & "_ListRow_( cur )" & NL
    o &= "        end if" & NL
    o &= "    end if" & NL
    o &= "    tkNavigator_SetCount( " & nh & ", a_.Count( ) )" & NL
    o &= "    tkNavigator_SetPosition( " & nh & ", i )" & NL
    o &= "    LoadFrom( a_[i] )" & NL
    NavSelect_( doc, "i", o, "    " )
    o &= "    return true" & NL
    o &= "end function" & NL

    ' Refresh: after the program changed the array
    o &= NL & "sub Form." & n & "_Refresh( )" & NL
    o &= arr
    if li >= 0 then o &= "    " & doc.Controls[li].Name & "_Fill( )" & NL
    o &= "    tkNavigator_SetCount( " & nh & ", a_.Count( ) )" & NL
    o &= "    if a_.Count( ) = 0 then" & NL
    o &= "        tkNavigator_SetPosition( " & nh & ", -1 )" & NL
    o &= "        dim as " & T & " blank_" & NL
    o &= "        LoadFrom( blank_ )" & NL
    o &= "        exit sub" & NL
    o &= "    end if" & NL
    o &= "    dim as int32 cur = tkNavigator_GetPosition( " & nh & " )" & NL
    o &= "    if cur < 0 then cur = 0" & NL
    o &= "    tkNavigator_SetPosition( " & nh & ", cur )" & NL
    o &= "    LoadFrom( a_[cur] )" & NL
    NavSelect_( doc, "cur", o, "    " )
    o &= "end sub" & NL

    o &= NL & "function Form." & n & "_Current( ) as int32" & NL
    o &= "    return tkNavigator_GetPosition( " & nh & " )" & NL
    o &= "end function" & NL

    ' Go_: what a navigator button asks for, once its Navigate handler has let it
    o &= NL & "function Form." & n & "_Go_( byval action as int32, byval target as int32 ) as boolean" & NL
    o &= arr
    o &= "    dim as int32 cur = tkNavigator_GetPosition( " & nh & " )" & NL
    o &= "    select case action" & NL
    o &= "    case TKNAV_NEW" & NL
    o &= "        if (cur >= 0) andalso (cur < a_.Count( )) then" & NL
    o &= "            if IsDirty( a_[cur] ) then" & NL
    o &= "                if SaveTo( a_[cur] ) = false then return false" & NL
    o &= "            end if" & NL
    o &= "        end if" & NL
    o &= "        dim as " & T & " blank_" & NL
    o &= "        a_.Push( blank_ )" & NL
    o &= "        tkNavigator_SetCount( " & nh & ", a_.Count( ) )" & NL
    o &= "        tkNavigator_SetPosition( " & nh & ", a_.Count( ) - 1 )" & NL
    o &= "        " & n & "_Refresh( )" & NL
    o &= "        return true" & NL
    o &= "    case TKNAV_DELETE" & NL
    o &= "        if (cur < 0) orelse (cur >= a_.Count( )) then return false" & NL
    o &= "        a_.Remove( cur )" & NL
    o &= "        tkNavigator_SetCount( " & nh & ", a_.Count( ) )" & NL
    o &= "        " & n & "_Refresh( )" & NL
    o &= "        return true" & NL
    o &= "    end select" & NL
    o &= "    return " & n & "_MoveTo( target )" & NL
    o &= "end function" & NL

    if li >= 0 then
        dim as FormControl l = doc.Controls[li]
        dim as ustring lh = l.Name & ".Handle"
        o &= NL & "sub Form." & n & "_FromList_( )" & NL
        if (catalog.ItemsBindOf( l ) = "rows") orelse (catalog.ItemsBindOf( l ) = "grid") then
            o &= "    dim as int32 i = " & l.Name & "_Item( )" & NL
        else
            o &= "    dim as int32 i = tkComboBox_GetCurSel( " & lh & " )" & NL
        end if
        o &= "    dim as int32 cur = tkNavigator_GetPosition( " & nh & " )" & NL
        o &= "    if (i < 0) orelse (i = cur) then exit sub" & NL
        o &= "    if " & n & "_MoveTo( i ) = false then" & NL
        NavSelect_( doc, "cur", o, "        " )
        o &= "    end if" & NL
        o &= "end sub" & NL

        ' a saved record's row shows its new values (the list is not refilled from its own SelChange)
        o &= NL & "sub Form." & n & "_ListRow_( byval i as int32 )" & NL
        o &= arr
        o &= "    if (i < 0) orelse (i >= a_.Count( )) then exit sub" & NL
        if catalog.ItemsBindOf( l ) = "rows" then
            for k as long = 0 to l.Items.Count( ) - 1
                if len( l.Items[k].Field ) then
                    o &= "    tkListTree_SetCellText( " & lh & ", i, " & k & ", tkBind_Text( a_[i]." & l.Items[k].Field & " ) )" & NL
                end if
            next
            if len( l.CheckField ) then o &= "    tkListTree_SetCheck( " & lh & ", i, iif( tkBind_Bool( a_[i]." & l.CheckField & " ), 1, 0 ) )" & NL
        elseif catalog.ItemsBindOf( l ) = "grid" then
            if l.ItemsLive then
                ' it reads the array itself: a repaint shows the saved values
                o &= "    tkDataGrid_InvalidateCells( " & lh & ", i, -1, i, -1 )" & NL
            else
                for k as long = 0 to l.Items.Count( ) - 1
                    if len( l.Items[k].Field ) = 0 then continue for
                    dim as ustring vk = catalog.GridValueKind( l.Items[k].Kind )
                    o &= "    tkDataGrid_SetCell" & vk & "( " & lh & ", i, " & k & ", tkBind_" & vk & "( a_[i]." & l.Items[k].Field & " ) )" & NL
                next
            end if
        else
            o &= "    tkComboBox_SetItemText( " & lh & ", i, tkBind_Text( a_[i]." & l.DisplayField & " ) )" & NL
            if len( l.ValueField ) then o &= "    " & l.Name & "_Values_[i] = tkBind_Text( a_[i]." & l.ValueField & " )" & NL
        end if
        o &= "end sub" & NL
    end if
end sub

' The whole .design.tiko for a form that passed validate.Check. sourceName is the form file's name.
public function Generate( byref doc as FormDoc, byref moduleName as const ustring, byref sourceName as const ustring, byref sourceText as const ustring ) as ustring
    dim as Sizes sz
    EffectiveSizes( doc, sz )
    doc.ModuleName = moduleName

    dim as ustring o = "' GENERATED by the tkEdit Form Designer from " & sourceName & ". Do not edit." & NL
    o &= "' source-hash: " & SourceHash( sourceText ) & NL
    o &= "#module """ & moduleName & """" & NL & NL
    o &= "#import ""vendor/tkControls/tkForms""" & NL
    dim as Array( of ustring ) mods = UsedModules_( doc )
    for each mo as ustring in mods
        o &= "#import ""vendor/tkControls/" & mo & """" & NL
    next
    ' a toolbar's drop-down event hands over a popup menu, whose type lives in its own module,
    ' and a menu with entries builds its drop-downs
    dim as boolean needsMenu = false
    dim as boolean needsKeys = AnyShortcut_( doc )
    for i as long = 0 to doc.Controls.Count( ) - 1
        if catalog.IsMenuKind( catalog.ItemsKindOf( doc.Controls[i].TypeName ) ) andalso (doc.Controls[i].Items.Count( ) > 0) then needsMenu = true
    next
    for i as long = 0 to doc.Controls.Count( ) - 1
        dim as TKMETA_CONTROL ptr m = catalog.Find( doc.Controls[i].TypeName )
        for each s as Setting in doc.Controls[i].Events
            dim as TKMETA_EVENT ptr e = tkMeta_FindEvent( m, s.Key )
            if e then
                if instr( e->Sig, "TK_MENU" ) then needsMenu = true
            end if
        next
    next
    if needsMenu then o &= "#import " & Literal_( "vendor/tkControls/tkPopupMenu" ) & NL
    if needsKeys then o &= "#import " & Literal_( "vendor/tkControls/tkKeys" ) & NL
    dim as boolean binds = HasBinding_( doc )
    ' a ValidationError handler names TKBIND_ERRORS, bound controls or not
    dim as boolean needsBind = binds orelse (FindSetting( doc.Events, "ValidationError" ) >= 0) orelse AnyList_( doc )
    if needsBind then o &= "#import " & Literal_( "vendor/tkControls/tkBind" ) & NL
    ' the records' module: what DataType and the lists' ItemTypes come from
    if (binds orelse AnyList_( doc )) andalso (len( doc.DataModule ) > 0) then o &= "#import " & Literal_( doc.DataModule ) & NL
    if AnyList_( doc ) then o &= "#import " & Literal_( "std/containers" ) & NL
    dim as Array( of ustring ) customMods = CustomModules_( doc )
    for each mo as ustring in customMods
        o &= "#import """ & mo & """" & NL
    next
    ' the report modules ReportViewers show (Report Designer RD4), each once
    dim as Array( of ustring ) rptMods
    for i as long = 0 to doc.Controls.Count( ) - 1
        dim as ustring rm = doc.Controls[i].Report
        if len( rm ) = 0 then continue for
        dim as boolean seen = false
        for each x as ustring in rptMods
            if x = rm then seen = true
        next
        if seen = false then
            rptMods.Push( rm )
            o &= "#import " & Literal_( rm ) & NL
        end if
    next
    o &= NL & "using tkForms" & NL & "using tkApp" & NL & "using tkLayout" & NL
    for each mo as ustring in mods
        o &= "using " & mo & NL
    next
    for each mo as ustring in customMods
        o &= "using " & LastPart_( mo ) & NL
    next
    if needsMenu then o &= "using tkPopupMenu" & NL
    if needsKeys then o &= "using tkKeys" & NL
    if needsBind then o &= "using tkBind" & NL
    if AnyList_( doc ) then o &= "using containers" & NL
    ListErrors_( doc, o )
    dim as boolean needsTheme = false
    for i as long = 0 to doc.Controls.Count( ) - 1
        if HasColors_( doc.Controls[i] ) then needsTheme = true
    next
    if needsTheme then o &= "using tkTheme" & NL
    o &= "using tkHost" & NL & "using tkPaint" & NL & NL

    o &= "public partial type Form extends FormBase" & NL
    for i as long = 0 to doc.Controls.Count( ) - 1
        dim as ustring typeName_ = doc.Controls[i].TypeName
        if len( doc.Controls[i].CustomType ) then typeName_ = doc.Controls[i].CustomType
        o &= "    " & doc.Controls[i].Name & " as " & typeName_ & NL
    next
    for i as long = 0 to doc.Controls.Count( ) - 1
        if len( doc.Controls[i].Report ) then o &= "    " & doc.Controls[i].Name & "Report as " & LastPart_( doc.Controls[i].Report ) & ".Report" & NL
    next
    o &= "    declare sub Build( byval owner as TK_FORM ptr = nullptr )" & NL
    ListDecls_( doc, o )
    NavDecls_( doc, o )
    if binds then
        o &= "    declare function LoadFrom( byref r as " & doc.DataType & " ) as boolean" & NL
        o &= "    declare function SaveTo( byref r as " & doc.DataType & " ) as boolean" & NL
    end if
    HandlerDecls_( doc, o )
    o &= "end type" & NL & NL

    Thunks_( doc, o )
    LiveCode_( doc, o )

    o &= "sub Form.Build( byval owner as TK_FORM ptr = nullptr )" & NL
    o &= "    OpenWindow( " & TextExpr_( doc, "Caption", doc.Caption ) & ", " & doc.ClientW & ", " & doc.ClientH & ", owner )" & NL
    o &= "    if Handle = 0 then exit sub" & NL
    WindowCode_( doc, o )
    o &= "    tkLayout_AddContainer( Layout, tkForm_Widget( Handle ), " & doc.ClientW & ", " & doc.ClientH & " )" & NL
    for i as long = 0 to doc.Controls.Count( ) - 1
        CreateControl_( doc, i, sz, o )
    next
    if FindSetting( doc.Events, "Close" ) >= 0 then o &= "    tkForm_OnClose( Handle, @Thunk_Form_Close )" & NL
    if FindSetting( doc.Events, "Resize" ) >= 0 then o &= "    ResizeHook = @Thunk_Form_Resize" & NL
    if FindSetting( doc.Events, "KeyDown" ) >= 0 then o &= "    tkForm_OnKeyDown( Handle, @Thunk_Form_KeyDown )" & NL
    if FindSetting( doc.Events, "Paint" ) >= 0 then o &= "    tkForm_OnPaint( Handle, @Thunk_Form_Paint )" & NL
    if FindSetting( doc.Events, "Destroy" ) >= 0 then o &= "    DestroyHook = @Thunk_Form_Destroy" & NL
    if FindSetting( doc.Events, "ThemeChanged" ) >= 0 then o &= "    tkForm_OnThemeChanged( Handle, @Thunk_Form_ThemeChanged )" & NL
    if FindSetting( doc.Events, "MouseMove" ) >= 0 then o &= "    tkWidget_SetMouseMoveCallback( tkForm_Widget( Handle ), @Thunk_Form_MouseMove )" & NL
    if AnyShortcut_( doc ) then
        o &= "    scope" & NL
        o &= "        dim as TK_KEYMAP ptr keys = tkKeys_MapCreate( )" & NL
        for c as long = 0 to doc.Controls.Count( ) - 1
            if catalog.IsMenuKind( catalog.ItemsKindOf( doc.Controls[c].TypeName ) ) then
                dim as long b = ItemBase_( doc, c )
                for k as long = 0 to doc.Controls[c].Items.Count( ) - 1
                    if len( doc.Controls[c].Items[k].Key ) then
                        o &= "        tkKeys_BindText( keys, " & Literal_( doc.Controls[c].Items[k].Key ) & ", " & (b + k) & " )" & NL
                    end if
                next
            end if
        next
        o &= "        tkKeys_Attach( tkForm_Host( Handle ), keys, @Thunk_Keys )" & NL
        o &= "    end scope" & NL
    end if
    ' context menus, once every control and every PopupMenu exists
    for each c as FormControl in doc.Controls
        if len( c.ContextMenu ) then o &= "    tkContextMenu_Attach( " & c.ContextMenu & ".Handle, " & c.Name & ".Handle )" & NL
    next
    if len( doc.ContextMenu ) then o &= "    tkContextMenu_Attach( " & doc.ContextMenu & ".Handle, tkForm_Widget( Handle ) )" & NL
    ' badges on their targets, once both exist (D-B3)
    for each c as FormControl in doc.Controls
        if (c.TypeName = catalog.BADGE_TYPE) andalso (len( c.AttachTo ) > 0) then
            dim as long dx, dy
            catalog.BadgeOffset( c.AttachOffset, dx, dy )
            o &= "    tkBadge_Attach( " & c.Name & ".Handle, " & c.AttachTo & ".Handle, " & catalog.BadgeCornerConst( c.AttachCorner ) _
               & ", " & dx & ", " & dy & ", " & iif( catalog.BadgeOverlapIsCircle( c.AttachOverlap ), "TKBADGE_OVERLAP_CIRCLE", "TKBADGE_OVERLAP_RECT" ) & " )" & NL
        end if
    next
    o &= "    tkLayout_Apply( Layout )" & NL
    dim as long i = FindSetting( doc.Events, "Load" )
    if i >= 0 then o &= "    " & doc.Events[i].Value & "( )" & NL
    o &= "end sub" & NL
    if binds then BindingCode_( doc, o )
    ListCode_( doc, o )
    NavCode_( doc, o )
    return o
end function
