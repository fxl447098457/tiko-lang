public type CanvasCommitSub as sub( byval owner as any ptr, byref text as const ustring )
public type CanvasChangedSub as sub( byval listener as any ptr )
' A project glyph font the canvas opened (GLYPHS.md V3), at the GLYPH and GLYPH_LARGE sizes.
public type CanvasGlyphFont
    Key as ustring
    Normal as TTF_Font ptr
    Large as TTF_Font ptr
end type
' A glyph font the canvas opened at a GlyphSize in points.
public type CanvasSizedFont
    Key as ustring
    Pt as long
    F as TTF_Font ptr
end type
public type FormCanvas_ as FormCanvas
public type CanvasWireSub as sub( byval host_ as any ptr, byval c as FormCanvas_ ptr, byref name_ as const ustring, byref event_ as const ustring, byval jump as boolean )
' The Resource Center in Pick: kind_ "image" / "font", current the value now, prop the property of
' c's selection (of the form when none) being picked for. True on Select, picked then "res:<name>"
' (or "" for none).
public type CanvasPickFunc as function( byval host_ as any ptr, byval c as FormCanvas_ ptr, byref kind_ as const ustring, _
                                        byref current as const ustring, byref prop as const ustring, byref picked as ustring ) as boolean
' The Glyph Picker: current the character a glyph property has now. True on Select, picked then the
' character ("" for none); the theme's glyph font may have changed by then (GLYPHS.md, GQ1 = A).
public type CanvasGlyphFunc as function( byval host_ as any ptr, byval c as FormCanvas_ ptr, byref current as const ustring, _
                                         byref picked as ustring ) as boolean
public type CanvasRenameSub as sub( byval host_ as any ptr, byval c as FormCanvas_ ptr, byref oldName as const ustring, byref newName as const ustring )
' Controls just dragged over a container that isn't their parent: true moves them into it. what is
' the one control's name (count 1) or empty; page is a tab control's page caption, else "".
public type CanvasParentFunc as function( byval host_ as any ptr, byval c as FormCanvas_ ptr, byref what as const ustring, _
                                          byval count as long, byref parent as const ustring, byref page as const ustring ) as boolean
public type CanvasGoneFunc as function( byval host_ as any ptr, byval c as FormCanvas_ ptr, byref handler as const ustring ) as boolean
public type CanvasHandlerRenameFunc as function( byval host_ as any ptr, byval c as FormCanvas_ ptr, byref oldName as const ustring, byref newName as const ustring ) as boolean
public type CanvasMenuSub as sub( byval host_ as any ptr, byval c as FormCanvas_ ptr, byval x as long, byval y as long )

const as long MARGIN = 16         ' design units of empty surface around the form
const as long GRIP_SIZE = 7       ' a grip's size
const as long BAR = 12            ' a scroll bar's thickness
const as long TRAY_BOX = 20       ' the component tray: a box's height
const as long TRAY_GAP = 8        ' the room around and between its boxes
const as long TRAY_PAD = 8        ' a box's room either side of its name
const as long DRAG_START = 4      ' pixels of travel before a press becomes a drag
const as long MIN_SIZE = 4        ' the smallest a control can be dragged to
const as long PLACE_STEP = 16     ' a Toolbox double click: the first control's offset, and each next one's

enum DragKind
    DragNone = 0
    DragPressed     ' down on a control, not moved far enough yet
    DragMove
    DragResize
    DragFormResize
    DragRubber
    DragDraw
end enum

' Bits of the edges a grip moves.
const as long EDGE_L = 1, EDGE_T = 2, EDGE_R = 4, EDGE_B = 8

public type FormCanvas
    Doc as FormDoc
    Selected as Array( of ustring )     ' the first is what Align lines the others up against
    Tool as ustring                     ' the control type being placed, "" for the pointer
    GridSize as long = 8
    SnapToGrid as boolean = true
    Live as boolean                     ' Test Form: the controls work, nothing is being designed
    ' The project's theme the form wears (THEMES.md, TH7): its appTheme.tktheme; "" = tkEdit's own.
    ' The variant is tkEdit's unless PreviewSet, then PreviewDark's (Form > Preview Light / Dark).
    ThemePath as ustring
    PreviewSet as boolean
    PreviewDark as boolean
    ThemeTables as themefile.ThemeTables
    ' The glyph font (GLYPHS.md): glyph properties draw in it, as in the program; tkEdit's own icon
    ' font holds only the glyphs tkEdit uses. GlyphSrc: what they were opened from.
    GlyphSrc as ustring
    PkgDir as ustring                   ' the toolchain's pkg/: where the bundled icon font is
    GlyphPaths as Array( of Setting )   ' the project's glyph fonts (GLYPHS.md V3): Key = its key, Value = its file
    GlyphOpen as Array( of CanvasGlyphFont )   ' those opened so far
    GlyphSized as Array( of CanvasSizedFont )  ' those opened at a GlyphSize in points
    GlyphFont as TTF_Font ptr
    GlyphFontLarge as TTF_Font ptr
    Building as boolean

    Frame as TK_WIDGET ptr              ' fills the pane
    Glass as TK_WIDGET ptr              ' over everything in Frame
    Surface as TK_WIDGET ptr            ' the form itself; its children are the real controls
    Tray as TK_WIDGET ptr               ' under the form while it has components: a box for each
    TrayGlass as TK_WIDGET ptr          ' over the tray's boxes, so the mouse reaches the canvas, not them
    HBar as TK_WIDGET ptr
    VBar as TK_WIDGET ptr
    Layout as TK_LAYOUT ptr
    Widgets as Array( of TK_WIDGET ptr )    ' one for each of Doc.Controls
    PagesShown as Array( of Setting )       ' lower-case tab control name: the page it's showing

    Owner as any ptr
    OnCommit as CanvasCommitSub
    Listener as any ptr
    OnChanged as CanvasChangedSub       ' the selection, the model or the tool changed
    Host as any ptr                     ' for the joins to the code
    OnWire as CanvasWireSub             ' give an event a handler; jump: and go to it
    OnRenamed as CanvasRenameSub
    OnEditItems as CanvasWireSub        ' name_: the control whose entries to edit
    OnEditColors as CanvasWireSub       ' name_: the control whose [control.colors] to edit
    OnPickResource as CanvasPickFunc    ' a file property's "...": the Resource Center
    OnPickGlyph as CanvasGlyphFunc      ' a glyph property's "...": the Glyph Picker
    OnHandlerGone as CanvasGoneFunc     ' true: the body has code, so keep its declaration
    OnHandlerRenamed as CanvasHandlerRenameFunc ' true: the code's body (and its uses) now go by the new name
    OnContextMenu as CanvasMenuSub      ' a right click at x, y in Glass pixels, the selection already set
    OnAskParent as CanvasParentFunc     ' a drag ended over another container: move into it? (none: never)
    MouseX as long                      ' the mouse's last place in Glass pixels, while MouseIn
    MouseY as long
    MouseIn as boolean
    MenuX as long                       ' where the last right click was, in Glass pixels
    MenuY as long

    Drag as long
    Grip as long                        ' DragResize: EDGE_* bits
    StartX as long                      ' where the press was, in Glass pixels
    StartY as long
    NowX as long
    NowY as long
    DragBase as FormDoc                 ' Doc as it was when the press came
    Pressed as ustring                  ' the control a plain press landed on
    DrawParent as ustring
    DrawPage as long
    ' Design > Tab Order: each control shows its place in Tab order among its siblings, and a click
    ' gives the control under it the next place in its container (1 first, then on round)
    TabOrderMode as boolean
    TabNext as Array( of Setting )      ' per container ("parent|page", lower case): the place its next click gives

    declare function Create( byval parent as TK_WIDGET ptr, byval id as long ) as boolean
    declare sub ApplyProjectTheme( )
    declare function RoleFont( byval f as TK_FORM ptr, byval role as long, byref glyphKey as const ustring = "" ) as TTF_Font ptr
    declare function GlyphFontFor( byref key_ as const ustring, byval large as boolean ) as TTF_Font ptr
    declare function GlyphFontAt( byref key_ as const ustring, byval pt as long ) as TTF_Font ptr
    declare function ShowsDark( ) as boolean
    declare sub Destroy( )
    ' False when the text isn't a form this version can show; the canvas is left as it was.
    declare function LoadText( byref text as const ustring ) as boolean
    declare sub Commit( )
    declare sub Changed( )
    declare function ApplyEdit( byref trial as FormDoc, byval rebuildAll as boolean, byref newName as const ustring ) as ustring
    declare sub RevealAndSelect( byref name_ as const ustring )

    declare sub Clear_( )
    declare sub ApplyItems( byref c as FormControl, byval w as TK_WIDGET ptr )
    declare sub Rebuild( )
    declare sub SyncGeometry( )
    declare sub PlaceSurface( )
    declare function PlaceTray( ) as long
    declare sub ScreenPixels( byref w as long, byref h as long )
    declare sub ContainerClient( byval i as long, byval page as long, byref w as TK_WIDGET ptr )

    declare function ToDesign( byval px as long ) as long
    declare function ToPixels( byval v as long ) as long
    declare function IsSelected( byref name_ as const ustring ) as boolean
    declare function WidgetOf( byref name_ as const ustring ) as TK_WIDGET ptr
    declare function RectOf( byval w as TK_WIDGET ptr ) as TKRECT
    declare function SurfaceRect( ) as TKRECT
    declare function Shows( byval w as TK_WIDGET ptr ) as boolean
    declare function HitControl( byval x as long, byval y as long ) as long
    declare function HitGrip( byval x as long, byval y as long ) as long
    declare function HitFormGrip( byval x as long, byval y as long ) as long
    declare function GripsOf( byval i as long ) as long
    declare sub PlaceAt( byval x as long, byval y as long, byref parent as ustring, byref page as long, byref dx as long, byref dy as long )

    declare sub OnPress( byval x as long, byval y as long, byval mods as long )
    declare sub OnDragTo( byval x as long, byval y as long, byval mods as long )
    declare function ContainerAt( byval x as long, byval y as long, byref skip as Array( of ustring ) ) as long
    declare sub OfferParent( byval x as long, byval y as long )
    declare sub OffTabs( byref names as Array( of ustring ) )
    declare sub OnRelease( byval x as long, byval y as long )
    declare sub OnHover( byval x as long, byval y as long )
    declare sub OnDoubleClick( byval x as long, byval y as long )
    declare sub OnRightPress( byval x as long, byval y as long )
    declare function CanPaste( ) as boolean
    declare function PlaceDefault( byref typeName as const ustring ) as boolean
    declare function OnKey( byval key as long, byval mods as long ) as boolean
    declare sub Paint( byval b as TK_PAINT ptr )
    declare sub PaintSurface( byval b as TK_PAINT ptr )

    declare sub SelectOnly( byref name_ as const ustring )
    declare sub MakeActive( byref name_ as const ustring )
    declare sub Placed( byval i as long )
    declare sub SelectNone( )
    declare sub SelectAll( )
    declare sub SelectNext( byval forward as boolean )
    declare sub Nudge( byval dx as long, byval dy as long, byval resize_ as boolean )
    declare sub DeleteSelection( )
    declare sub Copy( )
    declare sub Cut( )
    declare sub Paste( )
    declare sub PasteAt( byval x as long, byval y as long )
    declare sub PasteBeside( )
    declare sub Align( byval mode as edits.AlignMode )
    declare sub Space( byval down_ as boolean, byval mode as edits.SpaceMode )
    declare sub Center( byval down_ as boolean )
    declare sub ToggleLock( )
    declare sub ToFront( )
    declare sub ToBack( )
    declare sub SetPageOf( byref name_ as const ustring, byval page as long )
    declare sub SetTabOrderMode( byval on_ as boolean )
    declare sub TabClick( byval x as long, byval y as long )
end type

private function SurfaceProc( byval w as TK_WIDGET ptr, byval m as TK_MSG ptr ) as boolean
    if m->msg = TKM_PAINT then
        cast( FormCanvas ptr, w->pData )->PaintSurface( m->pPaint )
        return true
    end if
    return false
end function

private function GlassProc( byval w as TK_WIDGET ptr, byval m as TK_MSG ptr ) as boolean
    dim as FormCanvas ptr c = w->pData
    select case m->msg
    case TKM_PAINT
        c->Paint( m->pPaint )
        return true
    case TKM_LBUTTONDOWN
        tkHost_SetFocus( w->pHost, w )
        if (m->clicks >= 2) andalso (len( c->Tool ) = 0) andalso (c->TabOrderMode = false) then
            c->OnDoubleClick( m->x, m->y )
            return true
        end if
        tkHost_SetCapture( w )
        c->OnPress( m->x, m->y, SDL_GetModState( ) )
        return true
    case TKM_RBUTTONDOWN
        tkHost_SetFocus( w->pHost, w )
        c->OnRightPress( m->x, m->y )
        return true
    case TKM_RBUTTONUP
        return true
    case TKM_MOUSELEAVE
        c->MouseIn = false
        return true
    case TKM_MOUSEMOVE
        c->MouseX = m->x
        c->MouseY = m->y
        c->MouseIn = true
        if c->Drag <> DragNone then
            c->OnDragTo( m->x, m->y, SDL_GetModState( ) )
        else
            c->OnHover( m->x, m->y )
        end if
        return true
    case TKM_LBUTTONUP
        ' finished first: giving up the capture is what TKM_CAPTURECHANGED reads as an interrupted gesture
        c->OnRelease( m->x, m->y )
        if tkHost_GetCapture( w->pHost ) = w then tkHost_ReleaseCapture( w->pHost )
        return true
    case TKM_CAPTURECHANGED
        if c->Drag <> DragNone then
            ' the gesture was taken away: nothing it did stands
            c->Doc = c->DragBase
            c->Drag = DragNone
            c->SyncGeometry( )
            tkWidget_Invalidate( w )
            c->Changed( )
        end if
        return true
    case TKM_MOUSEWHEEL
        ' the wheel scrolls down; Shift+wheel, or a sideways wheel, across
        dim as single wx = m->wheelX, wy = m->wheelY
        if ((SDL_GetModState( ) and SDL_KMOD_SHIFT) <> 0) andalso (wx = 0) then
            wx = -wy
            wy = 0
        end if
        dim as long stp = c->ToPixels( 24 )
        if (wy <> 0) andalso c->VBar->isVisible then tkScrollBar_SetPos( c->VBar, tkScrollBar_GetPos( c->VBar ) - cint( wy * stp ) )
        if (wx <> 0) andalso c->HBar->isVisible then tkScrollBar_SetPos( c->HBar, tkScrollBar_GetPos( c->HBar ) + cint( wx * stp ) )
        c->PlaceSurface( )
        return true
    case TKM_KEYDOWN
        return c->OnKey( m->key, m->mods )
    case TKM_CHAR
        return true
    case TKM_SETFOCUS, TKM_KILLFOCUS
        tkWidget_Invalidate( w )
        return true
    end select
    return false
end function

' The component tray: its background, and a ring around each selected box (just outside it, where
' the box doesn't paint over).
private function TrayProc( byval w as TK_WIDGET ptr, byval m as TK_MSG ptr ) as boolean
    dim as FormCanvas ptr c = w->pData
    select case m->msg
    case TKM_PAINT
        dim as TKTHEME_COLORS t = tkTheme_Get( )
        dim as TKRECT rc
        tkRect_Set( rc, 0, 0, w->cw, w->ch )
        m->pPaint->SetBackColor( t.Window )
        m->pPaint->PaintRect( @rc )
        tkRect_Set( rc, 0, 0, w->cw, 1 )
        m->pPaint->SetBackColor( t.Border )
        m->pPaint->PaintRect( @rc )
        ' a ring around each selected box, the first one thicker as on the form
        dim as long pad = c->ToPixels( 2 )
        for k as long = 0 to c->Selected.Count( ) - 1
            dim as TK_WIDGET ptr b = c->WidgetOf( c->Selected[k] )
            if (b = 0) orelse (b->pParent <> w) then continue for
            tkRect_Set( rc, b->x - pad, b->y - pad, b->x + b->cw + pad, b->y + b->ch + pad )
            m->pPaint->SetPenColor( t.Accent )
            m->pPaint->PaintRoundOutline( @rc, 0, iif( k = 0, 2, 1 ) )
        next
        return true
    end select
    return false
end function

' Over the tray's boxes: they are picked, opened and right-clicked as controls on the form are, so
' the mouse goes on to the glass, in the glass's own pixels.
private function TrayGlassProc( byval w as TK_WIDGET ptr, byval m as TK_MSG ptr ) as boolean
    dim as FormCanvas ptr c = w->pData
    select case m->msg
    case TKM_PAINT
        return true
    case TKM_LBUTTONDOWN, TKM_LBUTTONUP, TKM_RBUTTONDOWN, TKM_RBUTTONUP, TKM_MOUSEMOVE, TKM_MOUSEWHEEL
        dim as TKRECT a, g
        tkWidget_AbsRect( w, a )
        tkWidget_AbsRect( c->Glass, g )
        dim as TK_MSG mm = *m
        mm.x += a.left - g.left
        mm.y += a.top - g.top
        return GlassProc( c->Glass, @mm )
    case TKM_MOUSELEAVE
        return GlassProc( c->Glass, m )
    end select
    return false
end function

private sub OnBarScroll( byval hSB as TK_WIDGET ptr, byval newPos as integer )
    cast( FormCanvas ptr, tkWidget_Parent( hSB )->pData )->PlaceSurface( )
end sub

' What the form sits on: almost black, or almost white. The form itself keeps the theme's own colour.
public function BackdropColor( ) as ulong
    if tkTheme_Get( ).IsDark then return tkRGB( 18, 18, 20 )
    return tkRGB( 250, 249, 246 )
end function

private function FrameProc( byval w as TK_WIDGET ptr, byval m as TK_MSG ptr ) as boolean
    dim as FormCanvas ptr c = w->pData
    select case m->msg
    case TKM_PAINT
        dim as TKRECT rc
        tkRect_Set( rc, 0, 0, w->cw, w->ch )
        m->pPaint->SetBackColor( BackdropColor( ) )
        m->pPaint->PaintRect( @rc )
        return true
    case TKM_SIZE
        c->PlaceSurface( )
        return true
    case TKM_SCALECHANGED
        c->Rebuild( )
        return true
    case TKM_THEMECHANGED
        tkWidget_Invalidate( w )
        return false
    end select
    return false
end function

private function FontRole_( byref s as const ustring ) as long
    select case s
    case "UI_SMALL"    : return TKFONT_UI_SMALL
    case "UI_BOLD"     : return TKFONT_UI_BOLD
    case "UI_LARGE"    : return TKFONT_UI_LARGE
    case "GLYPH"       : return TKFONT_GLYPH
    case "GLYPH_LARGE" : return TKFONT_GLYPH_LARGE
    case "MONO"        : return TKFONT_MONO
    end select
    return TKFONT_UI
end function

' Controls on the canvas never take the keyboard: Tab must not walk into them.
private sub MakeInert_( byval w as TK_WIDGET ptr )
    w->isFocusable = false
    dim as TK_WIDGET ptr k = w->pFirst
    while k
        MakeInert_( k )
        k = k->pNext
    wend
end sub

function FormCanvas.Create( byval parent as TK_WIDGET ptr, byval id as long ) as boolean
    Frame = tkWidget_CreateChild( parent, id, @FrameProc, @this )
    if Frame = 0 then return false
    Glass = tkWidget_CreateChild( Frame, 1, @GlassProc, @this )
    Glass->isFocusable = true
    HBar = tkScrollBar_Create( Frame, 2, false )
    VBar = tkScrollBar_Create( Frame, 3, true )
    tkScrollBar_SetScrollCallback( HBar, @OnBarScroll )
    tkScrollBar_SetScrollCallback( VBar, @OnBarScroll )
    Layout = tkLayout_Create( )
    return true
end function

sub FormCanvas.Destroy( )
    if Frame = 0 then exit sub
    if Layout then tkLayout_Destroy( Layout )
    Layout = 0
    tkWidget_Destroy( Frame )
    Frame = 0
    Glass = 0
    Surface = 0
    Tray = 0
    TrayGlass = 0
end sub

function FormCanvas.ToPixels( byval v as long ) as long
    return tkHost_Scale( Frame->pHost, v )
end function

' Pixels back to design units, rounded to the nearest.
function FormCanvas.ToDesign( byval px as long ) as long
    return cint( px / Frame->pHost->fScale )
end function

function FormCanvas.LoadText( byref text as const ustring ) as boolean
    dim as FormDoc d
    dim as ustring e
    if formfile.Parse( text, d, e ) = false then return false
    if d.Problems.Count( ) then return false
    for each c as FormControl in d.Controls
        if catalog.Find( c.TypeName ) = 0 then return false
        if (len( c.Parent ) > 0) andalso (FindControl( d, c.Parent ) < 0) then return false
    next
    Doc = d
    ' what was selected stays selected, if it's still there
    dim as Array( of ustring ) kept
    for each s as ustring in Selected
        if FindControl( Doc, s ) >= 0 then kept.Push( s )
    next
    Selected = kept
    this.Rebuild( )
    return true
end function

sub FormCanvas.Clear_( )
    if Surface then tkWidget_Destroy( Surface )
    Surface = 0
    if Tray then tkWidget_Destroy( Tray )      ' TrayGlass with it
    Tray = 0
    TrayGlass = 0
    Widgets.Clear( )
    if Layout then tkLayout_Destroy( Layout )
    Layout = tkLayout_Create( )
end sub

' The widget a child of control i goes on.
sub FormCanvas.ContainerClient( byval i as long, byval page as long, byref w as TK_WIDGET ptr )
    dim as TKMETA_CONTROL ptr m = catalog.Find( Doc.Controls[i].TypeName )
    w = Widgets[i]
    select case m->ContainerKind
    case TKMETA_CONTAINER_PAGES       : w = tkTabControl_GetPage( Widgets[i], page )
    case TKMETA_CONTAINER_SCROLLPANEL : w = tkScrollPanel_GetPanel( Widgets[i] )
    end select
end sub

' Every control again, from the model. The tab each tab control was showing survives.
sub FormCanvas.Rebuild( )
    if Frame = 0 then exit sub
    Building = true
    this.Clear_( )
    Surface = tkWidget_CreateChild( Frame, 4, @SurfaceProc, @this )
    tkWidget_SendToBack( Surface )
    Tray = tkWidget_CreateChild( Frame, 5, @TrayProc, @this )
    tkWidget_Show( Tray, false )
    this.ApplyProjectTheme( )               ' before the controls: they read their scope at create

    dim as TK_FORM ptr f = tkForm_FromWidget( Frame )
    dim as codegen.Sizes sz
    codegen.EffectiveSizes( Doc, sz )
    tkLayout_AddContainer( Layout, Surface, Doc.ClientW, Doc.ClientH )
    for i as long = 0 to Doc.Controls.Count( ) - 1
        dim as FormControl c = Doc.Controls[i]
        dim as TKMETA_CONTROL ptr m = catalog.Find( c.TypeName )
        if catalog.IsComponent( c.TypeName ) then
            ' a component (a Timer): its name in a box in the tray under the form, never the real
            ' thing, which would run while being designed; nothing at all on a Test Form
            dim as TK_WIDGET ptr wc = catalog.CreateComponentBox( Tray, i + 1 )
            Widgets.Push( wc )
            if wc = 0 then continue for
            tkLabel_SetText( wc, c.Name )
            tkLabel_SetEllipsis( wc, true )
            tkLabel_SetTransparent( wc, false )
            tkLabel_SetBackColor( wc, tkTheme_Get( ).Selected )
            tkLabel_SetTextColor( wc, tkTheme_Get( ).SelectedText )
            if Live then tkWidget_Show( wc, false ) else MakeInert_( wc )
            continue for
        end if
        dim as TK_WIDGET ptr parent_ = Surface
        if len( c.Parent ) then this.ContainerClient( FindControl( Doc, c.Parent ), c.Page, parent_ )
        dim as ustring arg = m->CreateArgDflt
        if len( m->CreateArg ) then arg = SettingOr( c.Props, m->CreateArg, m->CreateArgDflt )
        dim as TK_WIDGET ptr w = m->Create( parent_, i + 1, arg )
        Widgets.Push( w )
        if w = 0 then continue for
        if m->Name = catalog.CUSTOM_TYPE then
            ' a stand-in: what it's called and what it will be
            dim as ustring shown = c.CustomType
            if len( shown ) = 0 then shown = "?"
            tkLabel_SetText( w, c.Name & " : " & shown )
            tkLabel_SetTransparent( w, false )
            tkLabel_SetBackColor( w, tkTheme_Get( ).Selected )
            tkLabel_SetTextColor( w, tkTheme_Get( ).SelectedText )
        end if
        tkLayout_Add( Layout, w, c.X, c.Y, c.W, c.H, c.Anchor, c.Dock )
        if m->ContainerKind = TKMETA_CONTAINER_PAGES then
            for p as long = 0 to c.Pages.Count( ) - 1
                tkTabControl_AddPage( w, c.Pages[p] )
                if len( PageGlyph( c, p ) ) then tkTabControl_SetPageGlyph( w, p, GlyphChar( PageGlyph( c, p ) ) )
            next
        end if
        this.ApplyItems( c, w )
        ' the font its glyphs come from (its first "<font>:<hex>" glyph): its GLYPH roles draw in that one
        dim as ustring gk
        for each s as Setting in c.Props
            dim as TKMETA_PROP ptr p = tkMeta_FindProp( m, s.Key )
            if (p <> 0) andalso (p->Kind = "glyph") andalso (GlyphCode( s.Value ) <> 0) then
                gk = GlyphFontKey( s.Value )
                exit for
            end if
        next
        if len( gk ) = 0 then
            ' none: its items' (a toolbar's buttons, an icon panel's icons)
            for each it as FormItem in c.Items
                if GlyphCode( it.Glyph ) then
                    gk = GlyphFontKey( it.Glyph )
                    exit for
                end if
            next
        end if
        if len( gk ) = 0 then
            ' none: its tab pages'
            for each pg as ustring in c.PageGlyphs
                if GlyphCode( pg ) then
                    gk = GlyphFontKey( pg )
                    exit for
                end if
            next
        end if
        for each s as Setting in c.Props
            dim as TKMETA_PROP ptr p = tkMeta_FindProp( m, s.Key )
            if p then
                if s.Key = "GlyphFont" then
                    ' below, as the generated code does
                elseif p->Kind = "font" then
                    if p->ApplyFont then p->ApplyFont( w, this.RoleFont( f, FontRole_( s.Value ), gk ) )
                elseif p->bDesign andalso (p->Apply <> 0) then
                    ' a glyph's "<font>:<hex>" is drawn as its character (GLYPHS.md GV7)
                    if p->Kind = "glyph" then p->Apply( w, GlyphChar( s.Value ) ) else p->Apply( w, s.Value )
                end if
            end if
        next
        ' its glyphs in the GLYPH font (Large: GLYPH_LARGE), as the generated code gives every control with one
        dim as TKMETA_PROP ptr gfp = tkMeta_FindProp( m, "GlyphFont" )
        if (gfp <> 0) andalso (gfp->ApplyFont <> 0) then
            dim as TTF_Font ptr gsf = 0
            if codegen.GlyphPoints( c ) > 0 then gsf = this.GlyphFontAt( gk, codegen.GlyphPoints( c ) )
            if gsf = 0 then gsf = this.RoleFont( f, FontRole_( codegen.GlyphRole( c ) ), gk )
            gfp->ApplyFont( w, gsf )
            ' a size in points: the icon box as tall as the font, unless the control sets its own
            dim as TKMETA_PROP ptr isp = tkMeta_FindProp( m, "IconSize" )
            if (codegen.GlyphPoints( c ) > 0) andalso (gsf <> 0) andalso (isp <> 0) andalso (isp->Apply <> 0) _
               andalso (FindSetting( c.Props, "IconSize" ) < 0) then
                dim as long fh = TTF_GetFontHeight( gsf )
                isp->Apply( w, fh & "," & fh )
            end if
            ' a tab bar's glyph box: one width, likewise
            dim as TKMETA_PROP ptr iwp = tkMeta_FindProp( m, "IconWidth" )
            if (codegen.GlyphPoints( c ) > 0) andalso (gsf <> 0) andalso (iwp <> 0) andalso (iwp->Apply <> 0) _
               andalso (FindSetting( c.Props, "IconWidth" ) < 0) then
                iwp->Apply( w, str( TTF_GetFontHeight( gsf ) ) )
            end if
        end if
        ' AutoSize: the size the control asks for becomes its design size. The layout places every
        ' control at its design W and H, in the designer and in the program, so the control's own
        ' resize would not last; this is part of the edit that turned it on or changed its text.
        if SettingOr( c.Props, "AutoSize" ) = "true" then
            dim as long iw = 0, ih = 0
            IdealSize_( c.TypeName, w, iw, ih )
            if (iw > 0) andalso (ih > 0) then
                ' rounded UP: on a scaled screen a design size a pixel short of the ideal one cuts the
                ' caption to "..." (its text must fit whole)
                dim as long dw = this.ToDesign( iw ), dh = this.ToDesign( ih )
                while this.ToPixels( dw ) < iw
                    dw += 1
                wend
                while this.ToPixels( dh ) < ih
                    dh += 1
                wend
                if (dw <> c.W) orelse (dh <> c.H) then
                    Doc.Controls[i].W = dw : Doc.Controls[i].H = dh
                    tkLayout_SetDesignRect( Layout, w, c.X, c.Y, dw, dh )
                end if
            end if
        end if
        ' [control.colors]: the recipe the generated code gives it (the style takes effect once the
        ' canvas wears the project theme)
        if (len( c.StyleName ) > 0) orelse (c.Colors.Count( ) > 0) then
            dim as Array( of TKCOLOR_SRC ) recipe
            colorval.Entries( c.Colors, m, recipe )
            if recipe.Count( ) then
                tkTheme_SetRecipeNamed( w, c.StyleName, @recipe[0], recipe.Count( ) )
            else
                tkTheme_SetRecipeNamed( w, c.StyleName, 0, 0 )
            end if
        end if
        select case m->ContainerKind
        case TKMETA_NOT_CONTAINER
        case TKMETA_CONTAINER_PAGES
            dim as long th = valint( SettingOr( c.Props, "TabHeight", "30" ) )
            for p as long = 0 to c.Pages.Count( ) - 1
                tkLayout_AddContainer( Layout, tkTabControl_GetPage( w, p ), sz.W[i], sz.H[i] - th )
            next
            dim as long sel = valint( SettingOr( PagesShown, lcase( c.Name ), "0" ) )
            if (sel > 0) andalso (sel < c.Pages.Count( )) then tkTabControl_SetCurSel( w, sel )
        case TKMETA_CONTAINER_GROUPBOX
            tkLayout_AddContainer( Layout, w, sz.W[i], sz.H[i], @tkGroupBox_GetClientRect )
        case TKMETA_CONTAINER_SCROLLPANEL
            tkLayout_AddContainer( Layout, tkScrollPanel_GetPanel( w ), sz.W[i], sz.H[i] )
        case else
            tkLayout_AddContainer( Layout, w, sz.W[i], sz.H[i] )
        end select
        if Live = false then MakeInert_( w )
    next
    TrayGlass = tkWidget_CreateChild( Tray, 6, @TrayGlassProc, @this )     ' last: on top of the boxes
    Building = false
    this.PlaceSurface( )
    this.Changed( )
end sub

' A control's entries on the real control. While designing, a menu bar only shows its bar.
sub FormCanvas.ApplyItems( byref c as FormControl, byval w as TK_WIDGET ptr )
    select case catalog.ItemsKindOf( c.TypeName )
    case catalog.ItemsKind.ItemsMenu
        dim as long n = 0
        dim as TK_MENU ptr menus( 0 to 2 )
        for i as long = 0 to c.Items.Count( ) - 1
            dim as FormItem it = c.Items[i]
            n += 1
            dim as boolean hasKids = false
            if i < c.Items.Count( ) - 1 then hasKids = (c.Items[i + 1].Level > it.Level)
            if it.Level = 0 then
                dim as long at_ = tkMenuBar_AddItem( w, it.Text, n )
                if hasKids andalso Live then
                    menus( 0 ) = tkPopupMenu_Create( w->pHost )
                    tkMenuBar_SetDropDown( w, at_, menus( 0 ) )
                end if
            elseif Live then
                if it.Text = "-" then
                    tkPopupMenu_AddSeparator( menus( it.Level - 1 ) )
                else
                    tkPopupMenu_AddItem( menus( it.Level - 1 ), n, it.Text, it.Key )
                    if hasKids then
                        menus( it.Level ) = tkPopupMenu_Create( w->pHost )
                        tkPopupMenu_SetItemSubMenu( menus( it.Level - 1 ), n, menus( it.Level ) )
                    end if
                end if
            end if
        next
    case catalog.ItemsKind.ItemsToolbar
        dim as long n = 0
        for each it as FormItem in c.Items
            n += 1
            tkToolbar_AddItem( w, codegen.ToolbarKindValue( it.Kind ), GlyphChar( it.Glyph ), it.Text, n )
        next
    case catalog.ItemsKind.ItemsIcons
        dim as long n = 0
        for each it as FormItem in c.Items
            n += 1
            tkIconPanel_AddItem( w, codegen.IconKindValue( it.Kind ), GlyphChar( it.Glyph ), n )
        next
    case catalog.ItemsKind.ItemsStatus
        dim as long n = 0
        for each it as FormItem in c.Items
            tkStatusBar_AddPanel( w, it.Text )
            if it.Width then tkStatusBar_SetPanelMinWidth( w, n, it.Width )
            if it.Stretch then tkStatusBar_SetPanelStretch( w, n, true )
            n += 1
        next
    case catalog.ItemsKind.ItemsColumns
        for each it as FormItem in c.Items
            tkListTree_AddColumn( w, it.Text, iif( it.Width > 0, it.Width, 100 ) )
        next
    case catalog.ItemsKind.ItemsTabs
        for i as long = 0 to c.Items.Count( ) - 1
            tkTabBar_AddTab( w, c.Items[i].Text )
            if len( c.Items[i].Glyph ) then tkTabBar_SetGlyph( w, i, GlyphChar( c.Items[i].Glyph ) )
        next
    case catalog.ItemsKind.ItemsList
        for each it as FormItem in c.Items
            select case c.TypeName
            case "SelectBar" : tkSelectBar_AddPanel( w, it.Text )
            case else        : tkComboBox_AddItem( w, it.Text )
            end select
        next
    end select
end sub

' The real controls to where the model says, without rebuilding them: the feedback during a drag.
sub FormCanvas.SyncGeometry( )
    if Surface = 0 then exit sub
    dim as codegen.Sizes sz
    codegen.EffectiveSizes( Doc, sz )
    tkLayout_AddContainer( Layout, Surface, Doc.ClientW, Doc.ClientH )
    for i as long = 0 to Doc.Controls.Count( ) - 1
        if i >= Widgets.Count( ) then exit for
        dim as TK_WIDGET ptr w = Widgets[i]
        if (w = 0) orelse (w->pParent = Tray) then continue for     ' the tray places its own
        dim as FormControl c = Doc.Controls[i]
        tkLayout_SetDesignRect( Layout, w, c.X, c.Y, c.W, c.H )
        tkLayout_SetAnchor( Layout, w, c.Anchor )
        tkLayout_SetDock( Layout, w, c.Dock )
        dim as TKMETA_CONTROL ptr m = catalog.Find( c.TypeName )
        select case m->ContainerKind
        case TKMETA_NOT_CONTAINER
        case TKMETA_CONTAINER_PAGES
            dim as long th = valint( SettingOr( c.Props, "TabHeight", "30" ) )
            for p as long = 0 to c.Pages.Count( ) - 1
                tkLayout_AddContainer( Layout, tkTabControl_GetPage( w, p ), sz.W[i], sz.H[i] - th )
            next
        case TKMETA_CONTAINER_GROUPBOX
            tkLayout_AddContainer( Layout, w, sz.W[i], sz.H[i], @tkGroupBox_GetClientRect )
        case TKMETA_CONTAINER_SCROLLPANEL
            tkLayout_AddContainer( Layout, tkScrollPanel_GetPanel( w ), sz.W[i], sz.H[i] )
        case else
            tkLayout_AddContainer( Layout, w, sz.W[i], sz.H[i] )
        end select
    next
    this.PlaceSurface( )
end sub

' The usable area of the display tkEdit is on, in pixels: how far the design surface scrolls, and
' the largest the form may be dragged (author 2026-11-14). 1920 x 1080 when the display won't say.
sub FormCanvas.ScreenPixels( byref w as long, byref h as long )
    w = this.ToPixels( 1920 )
    h = this.ToPixels( 1080 )
    dim as TK_HOST ptr hs = Frame->pHost
    dim as SDL_Rect rd
    if SDL_GetDisplayUsableBounds( SDL_GetDisplayForWindow( hs->win ), @rd ) = false then exit sub
    if (rd.w <= 0) orelse (rd.h <= 0) then exit sub
    w = cint( rd.w * hs->fDensity )
    h = cint( rd.h * hs->fDensity )
end sub

' The form in the frame, the glass over it all, and scroll bars over room the size of the screen
' (or the form, if larger): there is always somewhere to drag the form's grips out to.
sub FormCanvas.PlaceSurface( )
    if (Frame = 0) orelse (Surface = 0) then exit sub
    if Live then
        tkWidget_Show( HBar, false )
        tkWidget_Show( VBar, false )
        tkWidget_Show( Glass, false )
        if Tray then tkWidget_Show( Tray, false )
        tkWidget_SetPos( Surface, 0, 0, Frame->cw, Frame->ch )
        tkLayout_Apply( Layout )
        exit sub
    end if
    dim as long fw = this.ToPixels( Doc.ClientW ), fh = this.ToPixels( Doc.ClientH )
    dim as long m = this.ToPixels( MARGIN ), bar_ = this.ToPixels( BAR )
    dim as long sw, sh
    this.ScreenPixels( sw, sh )
    dim as long needW = iif( fw > sw, fw, sw ) + 2 * m, needH = iif( fh > sh, fh, sh ) + 2 * m
    dim as long cw = Frame->cw, ch = Frame->ch - this.PlaceTray( )
    dim as boolean showV = needH > ch
    dim as boolean showH = needW > (cw - iif( showV, bar_, 0 ))
    if showH andalso (needH > ch - bar_) then showV = true
    dim as long vw = iif( showV, bar_, 0 ), hh = iif( showH, bar_, 0 )
    dim as long inW = cw - vw, inH = ch - hh
    tkWidget_Show( HBar, showH )
    tkWidget_Show( VBar, showV )
    tkWidget_SetPos( HBar, 0, inH, inW, hh )
    tkWidget_SetPos( VBar, inW, 0, vw, inH )
    tkScrollBar_SetRange( HBar, needW, inW, tkScrollBar_GetPos( HBar ) )
    tkScrollBar_SetRange( VBar, needH, inH, tkScrollBar_GetPos( VBar ) )
    dim as long ox = iif( showH, tkScrollBar_GetPos( HBar ), 0 ), oy = iif( showV, tkScrollBar_GetPos( VBar ), 0 )
    tkWidget_SetPos( Surface, m - ox, m - oy, fw, fh )
    tkWidget_SetPos( Glass, 0, 0, inW, inH )
    tkLayout_Apply( Layout )
    tkWidget_Invalidate( Frame )
end sub

' The tray along the frame's foot: its boxes in the order the components were added, each as wide as
' its name, wrapping onto more rows when the frame is too narrow (the tray grows, up to half the frame).
' The answer is its height, 0 while the form has none.
function FormCanvas.PlaceTray( ) as long
    if Tray = 0 then return 0
    dim as long gap = this.ToPixels( TRAY_GAP ), bh = this.ToPixels( TRAY_BOX ), pad = this.ToPixels( TRAY_PAD )
    dim as long room = Frame->cw - 2 * gap
    dim as long x = gap, y = gap, n = 0
    for i as long = 0 to Doc.Controls.Count( ) - 1
        if i >= Widgets.Count( ) then exit for
        dim as TK_WIDGET ptr w = Widgets[i]
        if (w = 0) orelse (w->pParent <> Tray) then continue for
        dim as TTF_Font ptr f = tkLabel_GetFont( w )
        if f = 0 then f = Frame->pHost->pDefaultFont
        dim as long bw = tkText_Width( f, Doc.Controls[i].Name ) + 2 * pad
        if bw > room then bw = room
        if (x > gap) andalso (x + bw > gap + room) then
            x = gap
            y += bh + gap
        end if
        tkWidget_SetPos( w, x, y, bw, bh )
        x += bw + gap
        n += 1
    next
    dim as long h = 0
    if n then
        h = y + bh + gap
        if h > Frame->ch \ 2 then h = Frame->ch \ 2
    end if
    tkWidget_Show( Tray, n > 0 )
    tkWidget_SetPos( Tray, 0, Frame->ch - h, Frame->cw, h )
    if TrayGlass then tkWidget_SetPos( TrayGlass, 0, 0, Frame->cw, h )
    tkWidget_Invalidate( Tray )
    return h
end function

function FormCanvas.IsSelected( byref name_ as const ustring ) as boolean
    dim as ustring want = lcase( name_ )
    for each s as ustring in Selected
        if lcase( s ) = want then return true
    next
    return false
end function

function FormCanvas.WidgetOf( byref name_ as const ustring ) as TK_WIDGET ptr
    dim as long i = FindControl( Doc, name_ )
    if (i < 0) orelse (i >= Widgets.Count( )) then return 0
    return Widgets[i]
end function

' w's rectangle in Glass pixels.
function FormCanvas.RectOf( byval w as TK_WIDGET ptr ) as TKRECT
    dim as TKRECT rc, g
    tkWidget_AbsRect( w, rc )
    tkWidget_AbsRect( Glass, g )
    tkRect_Offset( rc, -g.left, -g.top )
    return rc
end function

function FormCanvas.SurfaceRect( ) as TKRECT
    return this.RectOf( Surface )
end function

' Is w really on screen, not on a hidden tab page?
function FormCanvas.Shows( byval w as TK_WIDGET ptr ) as boolean
    if (w <> 0) andalso (w->pParent = Tray) then return Tray->isVisible
    while (w <> 0) andalso (w <> Surface)
        if w->isVisible = false then return false
        w = w->pParent
    wend
    return w = Surface
end function

' The topmost control at a point in Glass pixels: children come after their parents in the list.
function FormCanvas.HitControl( byval x as long, byval y as long ) as long
    dim as long i = Doc.Controls.Count( ) - 1
    while i >= 0
        dim as TK_WIDGET ptr w = 0
        if i < Widgets.Count( ) then w = Widgets[i]
        if (w <> 0) andalso this.Shows( w ) then
            dim as TKRECT rc = this.RectOf( w )
            if (x >= rc.left) andalso (x < rc.right) andalso (y >= rc.top) andalso (y < rc.bottom) then return i
        end if
        i -= 1
    wend
    return -1
end function

' The topmost container showing at a point in Glass pixels that isn't one of skip or inside one of
' them; -1 for none (the form).
function FormCanvas.ContainerAt( byval x as long, byval y as long, byref skip as Array( of ustring ) ) as long
    dim as long i = Doc.Controls.Count( ) - 1
    while i >= 0
        dim as TKMETA_CONTROL ptr m = catalog.Find( Doc.Controls[i].TypeName )
        if (i < Widgets.Count( )) andalso (m <> 0) andalso (m->ContainerKind <> TKMETA_NOT_CONTAINER) then
            dim as boolean skipped = false
            dim as long k = i
            while k >= 0
                for each s as ustring in skip
                    if lcase( s ) = lcase( Doc.Controls[k].Name ) then skipped = true
                next
                k = FindControl( Doc, Doc.Controls[k].Parent )
            wend
            dim as TK_WIDGET ptr w = Widgets[i]
            if (skipped = false) andalso (w <> 0) andalso this.Shows( w ) then
                dim as TKRECT rc = this.RectOf( w )
                if (x >= rc.left) andalso (x < rc.right) andalso (y >= rc.top) andalso (y < rc.bottom) then return i
            end if
        end if
        i -= 1
    wend
    return -1
end function

' A move just ended at x, y (Glass pixels). If it ended over a container -- a panel, group box,
' scroll panel or the page a tab control shows -- that isn't where the moved controls are, the host
' is asked whether they go into it; yes moves them in where they now are on screen, with their
' names and handlers. Docked, locked and component controls didn't move, so they don't count.
' Let go over no container at all, the ones that were on a tab control's page go onto the form,
' unasked: off the page they would be clipped out of sight.
sub FormCanvas.OfferParent( byval x as long, byval y as long )
    if OnAskParent = 0 then exit sub
    dim as Array( of ustring ) moved
    for each s as ustring in edits.TopLevelOf( Doc, Selected )
        dim as long i = FindControl( Doc, s )
        if (i >= 0) andalso (Doc.Controls[i].Dock = TK_DOCK_NONE) andalso (Doc.Controls[i].Locked = false) _
           andalso (catalog.IsComponent( Doc.Controls[i].TypeName ) = false) then moved.Push( Doc.Controls[i].Name )
    next
    if moved.Count( ) = 0 then exit sub
    dim as long t = this.ContainerAt( x, y, moved )
    if t < 0 then
        this.OffTabs( moved )
        exit sub
    end if
    dim as TKMETA_CONTROL ptr m = catalog.Find( Doc.Controls[t].TypeName )
    dim as long pg = -1
    dim as ustring pageName
    if m->ContainerKind = TKMETA_CONTAINER_PAGES then
        pg = tkTabControl_GetCurSel( Widgets[t] )
        if (pg < 0) orelse (pg >= Doc.Controls[t].Pages.Count( )) then exit sub
        pageName = Doc.Controls[t].Pages[pg]
    end if
    dim as boolean differs = false
    for each s as ustring in moved
        dim as long i = FindControl( Doc, s )
        if (lcase( Doc.Controls[i].Parent ) <> lcase( Doc.Controls[t].Name )) orelse (Doc.Controls[i].Page <> pg) then differs = true
    next
    if differs = false then exit sub
    dim as ustring one
    if moved.Count( ) = 1 then one = moved[0]
    if OnAskParent( Host, @this, one, moved.Count( ), Doc.Controls[t].Name, pageName ) = false then exit sub
    ' where each one is now on screen, as a point in the container's client
    dim as TK_WIDGET ptr cw_
    this.ContainerClient( t, iif( pg < 0, 0, pg ), cw_ )
    if cw_ = 0 then exit sub
    dim as TKRECT base_ = this.RectOf( cw_ )
    dim as Array( of long ) xs, ys
    for each s as ustring in moved
        dim as TKRECT rc = this.RectOf( Widgets[FindControl( Doc, s )] )
        xs.Push( this.ToDesign( rc.left - base_.left ) )
        ys.Push( this.ToDesign( rc.top - base_.top ) )
    next
    edits.Reparent( Doc, moved, Doc.Controls[t].Name, pg, xs, ys )
    this.Rebuild( )
end sub

' Those of names whose parent is a tab control onto the form, where they now are on screen.
sub FormCanvas.OffTabs( byref names as Array( of ustring ) )
    dim as Array( of ustring ) off
    dim as Array( of long ) xs, ys
    dim as TKRECT base_ = this.RectOf( Surface )
    for each s as ustring in names
        dim as long i = FindControl( Doc, s )
        dim as long p = FindControl( Doc, Doc.Controls[i].Parent )
        if p < 0 then continue for
        dim as TKMETA_CONTROL ptr m = catalog.Find( Doc.Controls[p].TypeName )
        if (m = 0) orelse (m->ContainerKind <> TKMETA_CONTAINER_PAGES) then continue for
        dim as TKRECT rc = this.RectOf( Widgets[i] )
        off.Push( s )
        xs.Push( this.ToDesign( rc.left - base_.left ) )
        ys.Push( this.ToDesign( rc.top - base_.top ) )
    next
    if off.Count( ) = 0 then exit sub
    edits.Reparent( Doc, off, "", -1, xs, ys )
    this.Rebuild( )
end sub

' Which edges control i's grips may move. A docked control can only change its thickness.
function FormCanvas.GripsOf( byval i as long ) as long
    if catalog.IsComponent( Doc.Controls[i].TypeName ) then return 0     ' a component's box only moves
    select case Doc.Controls[i].Dock
    case TK_DOCK_TOP    : return EDGE_B
    case TK_DOCK_BOTTOM : return EDGE_T
    case TK_DOCK_LEFT   : return EDGE_R
    case TK_DOCK_RIGHT  : return EDGE_L
    case TK_DOCK_FILL   : return 0
    end select
    return EDGE_L or EDGE_T or EDGE_R or EDGE_B
end function

private function NearEdge_( byval v as long, byval a as long, byval b as long, byval tol as long, byval lowBit as long, byval highBit as long ) as long
    if abs( v - a ) <= tol then return lowBit
    if abs( v - b ) <= tol then return highBit
    if abs( v - (a + b) \ 2 ) <= tol then return -1     ' the middle grip
    return 0
end function

' The EDGE_* bits of the grip at this point on the one selected control, 0 for none.
function FormCanvas.HitGrip( byval x as long, byval y as long ) as long
    if Selected.Count( ) <> 1 then return 0
    dim as long i = FindControl( Doc, Selected[0] )
    if (i < 0) orelse (i >= Widgets.Count( )) then return 0
    if (Widgets[i] = 0) orelse (this.Shows( Widgets[i] ) = false) then return 0
    dim as TKRECT rc = this.RectOf( Widgets[i] )
    dim as long tol = this.ToPixels( GRIP_SIZE ) \ 2 + 1
    dim as long gx = NearEdge_( x, rc.left, rc.right, tol, EDGE_L, EDGE_R )
    dim as long gy = NearEdge_( y, rc.top, rc.bottom, tol, EDGE_T, EDGE_B )
    if (gx = 0) orelse (gy = 0) then return 0
    if (gx = -1) andalso (gy = -1) then return 0        ' the centre is no grip
    if gx = -1 then gx = 0
    if gy = -1 then gy = 0
    if Doc.Controls[i].Locked then return 0             ' a locked control's grips only show it's locked
    dim as long allowed = this.GripsOf( i )
    ' every edge this grip wants has to be free to move, or it's no grip at all
    if ((gx or gy) and allowed) <> (gx or gy) then return 0
    return gx or gy
end function

' The form's own grips: right, bottom, and the corner.
function FormCanvas.HitFormGrip( byval x as long, byval y as long ) as long
    dim as TKRECT rc = this.SurfaceRect( )
    dim as long tol = this.ToPixels( GRIP_SIZE ) \ 2 + 1
    dim as boolean onR = (abs( x - rc.right ) <= tol), onB = (abs( y - rc.bottom ) <= tol)
    dim as boolean midX = (abs( x - (rc.left + rc.right) \ 2 ) <= tol), midY = (abs( y - (rc.top + rc.bottom) \ 2 ) <= tol)
    if onR andalso onB then return EDGE_R or EDGE_B
    if onR andalso midY then return EDGE_R
    if onB andalso midX then return EDGE_B
    return 0
end function

' Where a control dropped at this point belongs: which parent, which page, and the point in that
' parent's design units.
sub FormCanvas.PlaceAt( byval x as long, byval y as long, byref parent as ustring, byref page as long, byref dx as long, byref dy as long )
    parent = ""
    page = -1
    dim as TKRECT base_ = this.SurfaceRect( )
    dim as long i = this.HitControl( x, y )
    while i >= 0
        dim as TKMETA_CONTROL ptr m = catalog.Find( Doc.Controls[i].TypeName )
        if m->ContainerKind <> TKMETA_NOT_CONTAINER then
            parent = Doc.Controls[i].Name
            dim as long pg = -1
            if m->ContainerKind = TKMETA_CONTAINER_PAGES then
                pg = tkTabControl_GetCurSel( Widgets[i] )
                if pg < 0 then pg = 0
                page = pg
            end if
            dim as TK_WIDGET ptr cw_
            this.ContainerClient( i, iif( pg < 0, 0, pg ), cw_ )
            base_ = this.RectOf( cw_ )
            exit while
        end if
        i = FindControl( Doc, Doc.Controls[i].Parent )
    wend
    dx = this.ToDesign( x - base_.left )
    dy = this.ToDesign( y - base_.top )
end sub

' ---- the mouse --------------------------------------------------------------------------------

sub FormCanvas.OnPress( byval x as long, byval y as long, byval mods as long )
    StartX = x : StartY = y : NowX = x : NowY = y
    DragBase = Doc
    if TabOrderMode then
        this.TabClick( x, y )
        exit sub
    end if
    if len( Tool ) then
        Drag = DragDraw
        dim as long dx, dy
        this.PlaceAt( x, y, DrawParent, DrawPage, dx, dy )
        tkWidget_Invalidate( Glass )
        exit sub
    end if
    Grip = this.HitGrip( x, y )
    if Grip then
        Drag = DragResize
        exit sub
    end if
    Grip = this.HitFormGrip( x, y )
    if Grip then
        Drag = DragFormResize
        exit sub
    end if
    dim as long i = this.HitControl( x, y )
    if i < 0 then
        this.SelectNone( )
        Drag = DragRubber
        exit sub
    end if
    ' a click on another tab shows that page; the tab control is selected as well
    dim as TKMETA_CONTROL ptr m = catalog.Find( Doc.Controls[i].TypeName )
    if m->ContainerKind = TKMETA_CONTAINER_PAGES then
        dim as TK_WIDGET ptr bar_ = tkTabControl_GetTabBar( Widgets[i] )
        dim as TKRECT rc = this.RectOf( bar_ )
        if (y >= rc.top) andalso (y < rc.bottom) then
            dim as long t = tkTabBar_HitTest( bar_, x - rc.left, y - rc.top )
            if (t >= 0) andalso (t <> tkTabControl_GetCurSel( Widgets[i] )) then this.SetPageOf( Doc.Controls[i].Name, t )
        end if
    end if
    dim as ustring nm = Doc.Controls[i].Name
    if mods and (SDL_KMOD_CTRL or SDL_KMOD_SHIFT or SDL_KMOD_GUI) then
        if this.IsSelected( nm ) then
            for k as long = 0 to Selected.Count( ) - 1
                if lcase( Selected[k] ) = lcase( nm ) then
                    Selected.Remove( k )
                    exit for
                end if
            next
            tkWidget_Invalidate( Glass )
            this.Changed( )
            exit sub                    ' what was just dropped from the selection doesn't drag
        end if
        Selected.Push( nm )
        Pressed = ""
        this.Changed( )
    else
        if this.IsSelected( nm ) = false then this.SelectOnly( nm )
        Pressed = nm
    end if
    Drag = DragPressed
    tkWidget_Invalidate( Glass )
end sub

' A right click acts on what it lands on: an unselected control becomes the selection (a selected
' one keeps the whole selection), the bare form selects nothing so Paste lands on the form.
sub FormCanvas.OnRightPress( byval x as long, byval y as long )
    if Drag <> DragNone then exit sub
    MenuX = x
    MenuY = y
    if len( Tool ) then
        Tool = ""
        this.Changed( )
    end if
    dim as long i = this.HitControl( x, y )
    if i >= 0 then
        if this.IsSelected( Doc.Controls[i].Name ) = false then this.SelectOnly( Doc.Controls[i].Name )
    elseif Selected.Count( ) > 0 then
        this.SelectNone( )
    end if
    tkWidget_Invalidate( Glass )
    if OnContextMenu then OnContextMenu( Host, @this, x, y )
end sub

' The clipboard holds controls Copy put there.
function FormCanvas.CanPaste( ) as boolean
    if tkHost_HasClipboardText( ) = false then return false
    return edits.IsClipText( tkHost_GetClipboardText( ) )
end function

sub FormCanvas.OnDragTo( byval x as long, byval y as long, byval mods as long )
    NowX = x : NowY = y
    dim as boolean noSnap = (mods and SDL_KMOD_ALT) <> 0
    dim as long g = iif( SnapToGrid andalso (noSnap = false), GridSize, 1 )
    dim as long dx = this.ToDesign( x - StartX ), dy = this.ToDesign( y - StartY )
    select case Drag
    case DragPressed
        if (abs( x - StartX ) < DRAG_START) andalso (abs( y - StartY ) < DRAG_START) then exit sub
        Drag = DragMove
        this.OnDragTo( x, y, mods )
    case DragMove
        Doc = DragBase
        dim as Array( of ustring ) tops = edits.TopLevelOf( Doc, Selected )
        ' the first control lands on the grid; the rest keep their distance from it
        dim as long ax = dx, ay = dy
        if tops.Count( ) then
            dim as long r = FindControl( Doc, tops[0] )
            ax = edits.Snap( Doc.Controls[r].X + dx, g ) - Doc.Controls[r].X
            ay = edits.Snap( Doc.Controls[r].Y + dy, g ) - Doc.Controls[r].Y
        end if
        for each s as ustring in tops
            dim as long i = FindControl( Doc, s )
            if (Doc.Controls[i].Dock = TK_DOCK_NONE) andalso (Doc.Controls[i].Locked = false) _
               andalso (catalog.IsComponent( Doc.Controls[i].TypeName ) = false) then
                Doc.Controls[i].X += ax
                Doc.Controls[i].Y += ay
            end if
        next
        this.SyncGeometry( )
        this.Changed( )                 ' the inspector's rows follow the mouse
    case DragResize
        Doc = DragBase
        dim as long i = FindControl( Doc, Selected[0] )
        dim as long l = Doc.Controls[i].X, t = Doc.Controls[i].Y
        dim as long r = l + Doc.Controls[i].W, b = t + Doc.Controls[i].H
        if Grip and EDGE_L then l = edits.Snap( l + dx, g )
        if Grip and EDGE_R then r = edits.Snap( r + dx, g )
        if Grip and EDGE_T then t = edits.Snap( t + dy, g )
        if Grip and EDGE_B then b = edits.Snap( b + dy, g )
        if r - l < MIN_SIZE then
            if Grip and EDGE_L then l = r - MIN_SIZE else r = l + MIN_SIZE
        end if
        if b - t < MIN_SIZE then
            if Grip and EDGE_T then t = b - MIN_SIZE else b = t + MIN_SIZE
        end if
        edits.ResizeControl( Doc, i, l, t, r - l, b - t )
        this.SyncGeometry( )
        this.Changed( )
    case DragFormResize
        Doc = DragBase
        dim as long w = Doc.ClientW, h = Doc.ClientH
        if Grip and EDGE_R then w = edits.Snap( w + dx, g )
        if Grip and EDGE_B then h = edits.Snap( h + dy, g )
        dim as long sw, sh
        this.ScreenPixels( sw, sh )
        if w > this.ToDesign( sw ) then w = this.ToDesign( sw )
        if h > this.ToDesign( sh ) then h = this.ToDesign( sh )
        if w < 80 then w = 80
        if h < 60 then h = 60
        edits.ResizeForm( Doc, w, h )
        this.SyncGeometry( )
        this.Changed( )
    case DragRubber, DragDraw
        tkWidget_Invalidate( Glass )
    end select
end sub

sub FormCanvas.OnRelease( byval x as long, byval y as long )
    dim as long d_ = Drag
    Drag = DragNone
    select case d_
    case DragPressed
        ' pressed on one of several without dragging: that one becomes the active control (the
        ' solid one Align lines the others up against) and the others stay selected
        if (len( Pressed ) > 0) andalso (Selected.Count( ) > 1) then this.MakeActive( Pressed )
    case DragMove
        ' let go over a panel, group box, scroll panel or tab page they aren't in: ask to move them in
        this.OfferParent( x, y )
        this.Commit( )
    case DragResize, DragFormResize
        this.Commit( )
    case DragRubber
        dim as long l = iif( x < StartX, x, StartX ), r = iif( x < StartX, StartX, x )
        dim as long t = iif( y < StartY, y, StartY ), b = iif( y < StartY, StartY, y )
        ' the top level of whatever the band started in
        Selected.Clear( )
        for i as long = 0 to Doc.Controls.Count( ) - 1
            if (len( Doc.Controls[i].Parent ) = 0) andalso (i < Widgets.Count( )) then
                if (Widgets[i] <> 0) andalso (Widgets[i]->pParent <> Tray) then
                    dim as TKRECT rc = this.RectOf( Widgets[i] )
                    if (rc.left < r) andalso (rc.right > l) andalso (rc.top < b) andalso (rc.bottom > t) then Selected.Push( Doc.Controls[i].Name )
                end if
            end if
        next
        this.Changed( )
    case DragDraw
        dim as TKMETA_CONTROL ptr m = catalog.Find( Tool )
        if m then
            dim as ustring parent_
            dim as long page_, px, py
            this.PlaceAt( StartX, StartY, parent_, page_, px, py )
            dim as long w = this.ToDesign( abs( x - StartX ) ), h = this.ToDesign( abs( y - StartY ) )
            dim as long g = iif( SnapToGrid, GridSize, 1 )
            ' a plain click gives the type's own size; a drag gives what was drawn
            if (abs( x - StartX ) < DRAG_START) andalso (abs( y - StartY ) < DRAG_START) then
                w = m->Width_
                h = m->Height_
                px = edits.Snap( px, g )
                py = edits.Snap( py, g )
            else
                if x < StartX then px -= w
                if y < StartY then py -= h
                dim as long x2 = edits.Snap( px + w, g ), y2 = edits.Snap( py + h, g )
                px = edits.Snap( px, g )
                py = edits.Snap( py, g )
                w = x2 - px
                h = y2 - py
                if w < MIN_SIZE then w = MIN_SIZE
                if h < MIN_SIZE then h = MIN_SIZE
            end if
            dim as long i = edits.AddControl( Doc, Tool, parent_, page_, px, py, w, h )
            if i >= 0 then
                Tool = ""
                this.SelectOnly( Doc.Controls[i].Name )
                this.Rebuild( )
                this.Commit( )
                this.Placed( i )
            end if
        end if
    end select
    tkWidget_Invalidate( Glass )
end sub

' A tool double-clicked in the Toolbox: one of its default size on the form -- or, when the one
' control selected is a container (a panel, group box, scroll panel, or a tab control's page
' showing), in it -- clear of any already at the same spot there. Each next one steps down and
' right, back to the corner once it would leave its parent.
function FormCanvas.PlaceDefault( byref typeName as const ustring ) as boolean
    dim as TKMETA_CONTROL ptr m = catalog.Find( typeName )
    if m = 0 then return false
    dim as ustring parent_
    dim as long page_ = -1
    dim as long areaW = Doc.ClientW, areaH = Doc.ClientH
    if Selected.Count( ) = 1 then
        dim as long t = FindControl( Doc, Selected[0] )
        if (t >= 0) andalso (t < Widgets.Count( )) then
            dim as TKMETA_CONTROL ptr tm = catalog.Find( Doc.Controls[t].TypeName )
            dim as boolean isPages = (tm <> 0) andalso (tm->ContainerKind = TKMETA_CONTAINER_PAGES)
            if (tm <> 0) andalso (tm->ContainerKind <> TKMETA_NOT_CONTAINER) andalso ((isPages = false) orelse (Doc.Controls[t].Pages.Count( ) > 0)) then
                dim as long pg = -1
                if isPages then
                    pg = tkTabControl_GetCurSel( Widgets[t] )
                    if pg < 0 then pg = 0
                end if
                dim as TK_WIDGET ptr cw_
                this.ContainerClient( t, pg, cw_ )
                if cw_ then
                    parent_ = Doc.Controls[t].Name
                    page_ = pg
                    dim as TKRECT rc = this.RectOf( cw_ )
                    areaW = this.ToDesign( rc.right - rc.left )
                    areaH = this.ToDesign( rc.bottom - rc.top )
                end if
            end if
        end if
    end if
    dim as long stp = edits.Snap( PLACE_STEP, iif( SnapToGrid, GridSize, 1 ) )
    dim as long px = stp, py = stp
    dim as boolean taken = true
    while taken
        taken = false
        for k as long = 0 to Doc.Controls.Count( ) - 1
            if lcase( Doc.Controls[k].Parent ) <> lcase( parent_ ) then continue for
            if Doc.Controls[k].Page <> page_ then continue for
            if (Doc.Controls[k].X = px) andalso (Doc.Controls[k].Y = py) then taken = true
        next
        if taken then
            px += stp
            py += stp
            if (px + m->Width_ > areaW) orelse (py + m->Height_ > areaH) then
                px = stp
                py = stp
                exit while
            end if
        end if
    wend
    dim as long i = edits.AddControl( Doc, typeName, parent_, page_, px, py, m->Width_, m->Height_ )
    if i < 0 then return false
    Tool = ""
    this.SelectOnly( Doc.Controls[i].Name )
    this.Rebuild( )
    this.Commit( )
    this.Placed( i )
    return true
end function

' A control just placed from the Toolbox that has entries (an Edit items row) asks for its editor at
' once. A menu bar, popup menu or toolbar with nothing in it is marked "new", so the host fills it
' with its default entries first; the others open on what they start with (a tab bar's Tab1, a tab
' control's Page1) or empty.
sub FormCanvas.Placed( byval i as long )
    if (i < 0) orelse (i >= Doc.Controls.Count( )) then exit sub
    dim as long kind_ = catalog.ItemsKindOf( Doc.Controls[i].TypeName )
    if kind_ = catalog.ItemsKind.ItemsNone then exit sub
    dim as boolean seeds = catalog.IsMenuKind( kind_ ) orelse (kind_ = catalog.ItemsKind.ItemsToolbar)
    dim as ustring e = iif( seeds andalso (Doc.Controls[i].Items.Count( ) = 0), "new", "" )
    if OnEditItems then OnEditItems( Host, @this, Doc.Controls[i].Name, e, false )
end sub

' A double click wires the default event: of the control under it, or of the form.
sub FormCanvas.OnDoubleClick( byval x as long, byval y as long )
    if OnWire = 0 then exit sub
    dim as long i = this.HitControl( x, y )
    if i >= 0 then
        dim as ustring nm = Doc.Controls[i].Name
        OnWire( Host, @this, nm, "", true )
        exit sub
    end if
    dim as TKRECT rc = this.SurfaceRect( )
    if (x >= rc.left) andalso (x < rc.right) andalso (y >= rc.top) andalso (y < rc.bottom) then OnWire( Host, @this, "", "", true )
end sub

sub FormCanvas.OnHover( byval x as long, byval y as long )
    dim as long g = this.HitGrip( x, y )
    if g = 0 then g = this.HitFormGrip( x, y )
    dim as long c = TK_CURSOR_ARROW
    select case g
    case EDGE_L, EDGE_R : c = TK_CURSOR_SIZEWE
    case EDGE_T, EDGE_B : c = TK_CURSOR_SIZENS
    case EDGE_L or EDGE_T, EDGE_R or EDGE_B : c = TK_CURSOR_SIZENWSE
    case EDGE_R or EDGE_T, EDGE_L or EDGE_B : c = TK_CURSOR_SIZENESW
    end select
    tkWidget_SetCursor( Glass, c )
end sub

' ---- the keyboard -----------------------------------------------------------------------------

function FormCanvas.OnKey( byval key as long, byval mods as long ) as boolean
    dim as boolean shift_ = (mods and SDL_KMOD_SHIFT) <> 0
    dim as boolean ctrl_ = (mods and TK_KMOD_PRIMARY) <> 0
    dim as long stp = iif( ctrl_, 1, GridSize )
    select case key
    case SDLK_LEFT  : this.Nudge( -stp, 0, shift_ )
    case SDLK_RIGHT : this.Nudge( stp, 0, shift_ )
    case SDLK_UP    : this.Nudge( 0, -stp, shift_ )
    case SDLK_DOWN  : this.Nudge( 0, stp, shift_ )
    case SDLK_DELETE, SDLK_BACKSPACE
        this.DeleteSelection( )
    case SDLK_TAB
        this.SelectNext( shift_ = false )
    case SDLK_ESCAPE
        if TabOrderMode then
            this.SetTabOrderMode( false )
        elseif len( Tool ) then
            Tool = ""
            this.Changed( )
        else
            this.SelectNone( )
        end if
        tkWidget_Invalidate( Glass )
    case else
        return false
    end select
    return true
end function

' ---- commands ---------------------------------------------------------------------------------

sub FormCanvas.Commit( )
    if OnCommit then OnCommit( Owner, formfile.Render( Doc ) )
    this.Changed( )
end sub

sub FormCanvas.Changed( )
    if Tray then tkWidget_Invalidate( Tray )        ' its rings follow the selection
    if OnChanged then OnChanged( Listener )
end sub

' An edit from the inspector, on a copy of the model. It stands if it leaves the form no worse;
' otherwise the answer says what's wrong and nothing changes. newName: the selected control's, on a rename.
function FormCanvas.ApplyEdit( byref trial as FormDoc, byval rebuildAll as boolean, byref newName as const ustring ) as ustring
    dim as ustring fault = validate.FirstNewProblem( Doc, trial )
    if len( fault ) then return fault
    Doc = trial
    if len( newName ) then Selected[0] = newName
    if rebuildAll then
        this.Rebuild( )
    else
        this.SyncGeometry( )
    end if
    this.Commit( )
    tkWidget_Invalidate( Glass )
    return ""
end function

' Selects a control, turning any tab page it's on to the front first.
sub FormCanvas.RevealAndSelect( byref name_ as const ustring )
    dim as long i = FindControl( Doc, name_ )
    while i >= 0
        dim as ustring parent_ = Doc.Controls[i].Parent
        if len( parent_ ) = 0 then exit while
        dim as long p = FindControl( Doc, parent_ )
        if p < 0 then exit while
        if Doc.Controls[i].Page >= 0 then this.SetPageOf( Doc.Controls[p].Name, Doc.Controls[i].Page )
        i = p
    wend
    this.SelectOnly( name_ )
end sub

sub FormCanvas.SelectOnly( byref name_ as const ustring )
    Selected.Clear( )
    dim as ustring only_ = name_
    Selected.Push( only_ )
    tkWidget_Invalidate( Glass )
    this.Changed( )
end sub

' name_, already selected, first in the selection: the active control. The rest stay as they are.
sub FormCanvas.MakeActive( byref name_ as const ustring )
    for k as long = 0 to Selected.Count( ) - 1
        if lcase( Selected[k] ) = lcase( name_ ) then
            if k = 0 then exit sub
            dim as ustring nm = Selected[k]
            Selected.Remove( k )
            Selected.Insert( 0, nm )
            tkWidget_Invalidate( Glass )
            this.Changed( )
            exit sub
        end if
    next
end sub

sub FormCanvas.SelectNone( )
    Selected.Clear( )
    tkWidget_Invalidate( Glass )
    this.Changed( )
end sub

sub FormCanvas.SelectAll( )
    Selected.Clear( )
    for i as long = 0 to Doc.Controls.Count( ) - 1
        if len( Doc.Controls[i].Parent ) = 0 then Selected.Push( Doc.Controls[i].Name )
    next
    tkWidget_Invalidate( Glass )
    this.Changed( )
end sub

' Design > Tab Order on or off. On: nothing selected, the pointer tool, every container's next
' click gives place 1.
sub FormCanvas.SetTabOrderMode( byval on_ as boolean )
    TabOrderMode = on_
    TabNext.Clear( )
    if on_ then
        Tool = ""
        Selected.Clear( )
    end if
    tkWidget_Invalidate( Glass )
    this.Changed( )
end sub

' A click in Tab Order mode: the control under it takes its container's next place in Tab order,
' the others among its siblings keeping their order around it (undoable, as any edit). A click on
' another tab of a tab control shows that page instead.
sub FormCanvas.TabClick( byval x as long, byval y as long )
    dim as long i = this.HitControl( x, y )
    if i < 0 then exit sub
    dim as TKMETA_CONTROL ptr m = catalog.Find( Doc.Controls[i].TypeName )
    if m->ContainerKind = TKMETA_CONTAINER_PAGES then
        dim as TK_WIDGET ptr bar_ = tkTabControl_GetTabBar( Widgets[i] )
        dim as TKRECT rc = this.RectOf( bar_ )
        if (y >= rc.top) andalso (y < rc.bottom) then
            dim as long t = tkTabBar_HitTest( bar_, x - rc.left, y - rc.top )
            if (t >= 0) andalso (t <> tkTabControl_GetCurSel( Widgets[i] )) then
                this.SetPageOf( Doc.Controls[i].Name, t )
                tkWidget_Invalidate( Glass )
                exit sub
            end if
        end if
    end if
    dim as ustring nm = Doc.Controls[i].Name
    dim as ustring parent_ = lcase( Doc.Controls[i].Parent )
    dim as long page_ = Doc.Controls[i].Page
    dim as ustring key_ = parent_ & "|" & page_
    dim as long pos_ = 1, k = -1
    for j as long = 0 to TabNext.Count( ) - 1
        if TabNext[j].Key = key_ then
            k = j
            pos_ = valint( TabNext[j].Value )
        end if
    next
    ' its siblings: past the last of them the next click starts again at 1
    dim as long n = 0
    for each c as FormControl in Doc.Controls
        if (lcase( c.Parent ) = parent_) andalso (c.Page = page_) then n += 1
    next
    if pos_ > n then pos_ = 1
    dim as FormDoc trial = Doc
    SetTabPlace( trial, nm, pos_ )
    if len( this.ApplyEdit( trial, false, "" ) ) then exit sub
    dim as Setting s
    s.Key = key_
    s.Value = str( iif( pos_ >= n, 1, pos_ + 1 ) )
    if k >= 0 then
        TabNext[k] = s
    else
        TabNext.Push( s )
    end if
    tkWidget_Invalidate( Glass )
end sub

' Tab is the selection's next control in list order (the designer's own walk, not the form's Tab order).
sub FormCanvas.SelectNext( byval forward as boolean )
    dim as long n = Doc.Controls.Count( )
    if n = 0 then exit sub
    dim as long i = -1
    if Selected.Count( ) then i = FindControl( Doc, Selected[Selected.Count( ) - 1] )
    if forward then i = (i + 1) mod n else i = iif( i <= 0, n - 1, i - 1 )
    this.SelectOnly( Doc.Controls[i].Name )
end sub

sub FormCanvas.Nudge( byval dx as long, byval dy as long, byval resize_ as boolean )
    if Selected.Count( ) = 0 then exit sub
    for each s as ustring in edits.TopLevelOf( Doc, Selected )
        dim as long i = FindControl( Doc, s )
        if Doc.Controls[i].Locked then continue for
        if resize_ then
            dim as long allowed = this.GripsOf( i )
            dim as long w = Doc.Controls[i].W, h = Doc.Controls[i].H
            if allowed and EDGE_R then w += dx
            if allowed and EDGE_B then h += dy
            if w < MIN_SIZE then w = MIN_SIZE
            if h < MIN_SIZE then h = MIN_SIZE
            edits.ResizeControl( Doc, i, Doc.Controls[i].X, Doc.Controls[i].Y, w, h )
        elseif Doc.Controls[i].Dock = TK_DOCK_NONE then
            Doc.Controls[i].X += dx
            Doc.Controls[i].Y += dy
        end if
    next
    this.SyncGeometry( )
    this.Commit( )
end sub

sub FormCanvas.DeleteSelection( )
    if Selected.Count( ) = 0 then exit sub
    ' what the deleted controls' events call, with the parameters they'd have passed
    dim as Array( of Setting ) gone
    for i as long = 0 to Doc.Controls.Count( ) - 1
        dim as boolean going = this.IsSelected( Doc.Controls[i].Name )
        if going = false then
            dim as ustring up = Doc.Controls[i].Parent
            while (len( up ) > 0) andalso (going = false)
                if this.IsSelected( up ) then going = true
                dim as long p = FindControl( Doc, up )
                if p < 0 then exit while
                up = Doc.Controls[p].Parent
            wend
        end if
        if going then
            dim as TKMETA_CONTROL ptr m = catalog.Find( Doc.Controls[i].TypeName )
            for each s as Setting in Doc.Controls[i].Events
                dim as TKMETA_EVENT ptr e = tkMeta_FindEvent( m, s.Key )
                if e then PutSetting( gone, s.Value, e->Params )
            next
            for each it as FormItem in Doc.Controls[i].Items
                if len( it.Handler ) then PutSetting( gone, it.Handler, catalog.ItemHandlerParams( catalog.ItemsKindOf( Doc.Controls[i].TypeName ) ) )
            next
        end if
    next
    edits.DeleteControls( Doc, Selected )
    Selected.Clear( )
    for each s as Setting in gone
        ' one a surviving control still calls isn't gone at all
        dim as boolean inUse = false
        for each ev as Setting in Doc.Events
            if lcase( ev.Value ) = lcase( s.Key ) then inUse = true
        next
        for each k as FormControl in Doc.Controls
            for each ev as Setting in k.Events
                if lcase( ev.Value ) = lcase( s.Key ) then inUse = true
            next
            for each it as FormItem in k.Items
                if lcase( it.Handler ) = lcase( s.Key ) then inUse = true
            next
        next
        if (inUse = false) andalso (OnHandlerGone <> 0) then
            if OnHandlerGone( Host, @this, s.Key ) then
                dim as FormOrphan o
                o.Handler = s.Key
                o.Params = s.Value
                Doc.Orphans.Push( o )
            end if
        end if
    next
    this.Rebuild( )
    this.Commit( )
end sub

sub FormCanvas.Copy( )
    dim as ustring t = edits.CopyText( Doc, Selected )
    if len( t ) then tkHost_SetClipboardText( t )
end sub

sub FormCanvas.Cut( )
    this.Copy( )
    this.DeleteSelection( )
end sub

' At the mouse while it's over the form, else beside what's selected.
sub FormCanvas.Paste( )
    if MouseIn then
        this.PasteAt( MouseX, MouseY )
    else
        this.PasteBeside( )
    end if
end sub

' The copied controls' top-left corner at x, y in Glass pixels, in the container under that point
' (snapped to the grid). A point off the form pastes beside what's selected.
sub FormCanvas.PasteAt( byval x as long, byval y as long )
    dim as TKRECT rc = this.SurfaceRect( )
    if (x < rc.left) orelse (x >= rc.right) orelse (y < rc.top) orelse (y >= rc.bottom) then
        this.PasteBeside( )
        exit sub
    end if
    dim as ustring parent_
    dim as long page_ = -1, dx, dy
    this.PlaceAt( x, y, parent_, page_, dx, dy )
    if SnapToGrid then
        dx = edits.Snap( dx, GridSize )
        dy = edits.Snap( dy, GridSize )
    end if
    if dx < 0 then dx = 0
    if dy < 0 then dy = 0
    dim as Array( of ustring ) added
    if edits.PasteText( Doc, tkHost_GetClipboardText( ), parent_, page_, dx, dy, added, true ) = false then exit sub
    Selected = added
    this.Rebuild( )
    this.Commit( )
end sub

' Into the one selected container, else beside what's selected on the form, a grid step along.
sub FormCanvas.PasteBeside( )
    dim as ustring parent_
    dim as long page_ = -1
    if Selected.Count( ) = 1 then
        dim as long i = FindControl( Doc, Selected[0] )
        dim as TKMETA_CONTROL ptr m = catalog.Find( Doc.Controls[i].TypeName )
        if m->ContainerKind <> TKMETA_NOT_CONTAINER then
            parent_ = Doc.Controls[i].Name
            if m->ContainerKind = TKMETA_CONTAINER_PAGES then page_ = tkTabControl_GetCurSel( Widgets[i] )
        else
            parent_ = Doc.Controls[i].Parent
            page_ = Doc.Controls[i].Page
        end if
    end if
    dim as Array( of ustring ) added
    if edits.PasteText( Doc, tkHost_GetClipboardText( ), parent_, page_, GridSize, GridSize, added ) = false then exit sub
    Selected = added
    this.Rebuild( )
    this.Commit( )
end sub

sub FormCanvas.Align( byval mode as edits.AlignMode )
    edits.AlignControls( Doc, Selected, mode )
    this.SyncGeometry( )
    this.Commit( )
end sub

sub FormCanvas.Space( byval down_ as boolean, byval mode as edits.SpaceMode )
    edits.SpaceControls( Doc, Selected, down_, mode, GridSize )
    this.SyncGeometry( )
    this.Commit( )
end sub

' Centred in what the parent's docked controls leave free of it, as one block.
sub FormCanvas.Center( byval down_ as boolean )
    if Selected.Count( ) = 0 then exit sub
    dim as long i = FindControl( Doc, Selected[0] )
    if i < 0 then exit sub
    dim as ustring parent_ = lcase( Doc.Controls[i].Parent )
    dim as long page_ = Doc.Controls[i].Page
    dim as TKRECT base_ = this.SurfaceRect( )
    dim as long p = FindControl( Doc, parent_ )
    if p >= 0 then
        dim as TK_WIDGET ptr cw_
        this.ContainerClient( p, iif( page_ < 0, 0, page_ ), cw_ )
        base_ = this.RectOf( cw_ )
    end if
    dim as TKRECT a = base_
    for k as long = 0 to Doc.Controls.Count( ) - 1
        if (lcase( Doc.Controls[k].Parent ) <> parent_) orelse (Doc.Controls[k].Page <> page_) then continue for
        if (k >= Widgets.Count( )) orelse (Doc.Controls[k].Dock = TK_DOCK_NONE) then continue for
        if (Widgets[k] = 0) orelse (this.Shows( Widgets[k] ) = false) then continue for
        dim as TKRECT rc = this.RectOf( Widgets[k] )
        select case Doc.Controls[k].Dock
        case TK_DOCK_TOP    : if rc.bottom > a.top then a.top = rc.bottom
        case TK_DOCK_BOTTOM : if rc.top < a.bottom then a.bottom = rc.top
        case TK_DOCK_LEFT   : if rc.right > a.left then a.left = rc.right
        case TK_DOCK_RIGHT  : if rc.left < a.right then a.right = rc.left
        end select
    next
    if down_ then
        edits.CenterControls( Doc, Selected, true, this.ToDesign( a.top - base_.top ), this.ToDesign( a.bottom - base_.top ) )
    else
        edits.CenterControls( Doc, Selected, false, this.ToDesign( a.left - base_.left ), this.ToDesign( a.right - base_.left ) )
    end if
    this.SyncGeometry( )
    this.Commit( )
end sub

' Design > Lock Controls: the selection (nothing selected: every control) locked, or unlocked when it all is.
sub FormCanvas.ToggleLock( )
    if Doc.Controls.Count( ) = 0 then exit sub
    edits.ToggleLock( Doc, Selected )
    tkWidget_Invalidate( Glass )
    this.Commit( )
end sub

sub FormCanvas.ToFront( )
    if Selected.Count( ) = 0 then exit sub
    edits.BringToFront( Doc, Selected )
    this.Rebuild( )
    this.Commit( )
end sub

sub FormCanvas.ToBack( )
    if Selected.Count( ) = 0 then exit sub
    edits.SendToBack( Doc, Selected )
    this.Rebuild( )
    this.Commit( )
end sub

' Shows one page of a tab control on the canvas.
sub FormCanvas.SetPageOf( byref name_ as const ustring, byval page as long )
    dim as TK_WIDGET ptr w = this.WidgetOf( name_ )
    if w then tkTabControl_SetCurSel( w, page )
    PutSetting( PagesShown, lcase( name_ ), str( page ) )
    tkLayout_Apply( Layout )
    tkWidget_Invalidate( Glass )
end sub

' ---- painting ---------------------------------------------------------------------------------

sub FormCanvas.PaintSurface( byval b as TK_PAINT ptr )
    dim as TKRECT rc
    tkRect_Set( rc, 0, 0, Surface->cw, Surface->ch )
    dim as TKTHEME_COLORS ft = tkTheme_Of( Surface )    ' the form's: the project theme when it has one
    b->SetBackColor( ft.Window )
    b->PaintRect( @rc )
    dim as long stp = this.ToPixels( GridSize )
    if Live orelse (SnapToGrid = false) orelse (stp < 4) then exit sub
    b->SetBackColor( ft.Divider )
    dim as long y = stp
    while y < Surface->ch
        dim as long x = stp
        while x < Surface->cw
            dim as TKRECT d
            tkRect_Set( d, x, y, x + 1, y + 1 )
            b->PaintRect( @d )
            x += stp
        wend
        y += stp
    wend
end sub

private sub PaintGrip_( byval b as TK_PAINT ptr, byval x as long, byval y as long, byval sz as long, byval fill_ as ulong, byval edge_ as ulong )
    dim as TKRECT g
    tkRect_Set( g, x - sz \ 2, y - sz \ 2, x - sz \ 2 + sz, y - sz \ 2 + sz )
    b->SetBackColor( fill_ )
    b->PaintRect( @g )
    b->SetPenColor( edge_ )
    b->PaintBorderRect( @g )
end sub

sub FormCanvas.Paint( byval b as TK_PAINT ptr )
    if Surface = 0 then exit sub
    dim as TKTHEME_COLORS t = tkTheme_Get( )
    dim as long sz = this.ToPixels( GRIP_SIZE )

    ' the form's grips, and a line around it
    dim as TKRECT sr = this.SurfaceRect( )
    b->SetPenColor( t.Border )
    b->PaintRoundOutline( @sr, 0, 1 )     ' an outline: PaintBorderRect would fill the form
    PaintGrip_( b, sr.right, (sr.top + sr.bottom) \ 2, sz, t.Surface, t.Border )
    PaintGrip_( b, (sr.left + sr.right) \ 2, sr.bottom, sz, t.Surface, t.Border )
    PaintGrip_( b, sr.right, sr.bottom, sz, t.Surface, t.Border )

    for k as long = 0 to Selected.Count( ) - 1
        dim as long i = FindControl( Doc, Selected[k] )
        if (i < 0) orelse (i >= Widgets.Count( )) then continue for
        if (Widgets[i] = 0) orelse (this.Shows( Widgets[i] ) = false) then continue for
        dim as TKRECT rc = this.RectOf( Widgets[i] )
        ' the control others line up against is the solid one; a locked one's grips are the warning colour
        dim as ulong ink = iif( Doc.Controls[i].Locked, t.Warning, t.Accent )
        dim as ulong fill_ = iif( k = 0, ink, t.Window )
        b->SetPenColor( ink )
        b->PaintRoundOutline( @rc, 0, 1 )
        dim as long allowed = this.GripsOf( i )
        dim as long mx = (rc.left + rc.right) \ 2, my = (rc.top + rc.bottom) \ 2
        if (allowed and EDGE_L) andalso (allowed and EDGE_T) then PaintGrip_( b, rc.left, rc.top, sz, fill_, ink )
        if allowed and EDGE_T then PaintGrip_( b, mx, rc.top, sz, fill_, ink )
        if (allowed and EDGE_R) andalso (allowed and EDGE_T) then PaintGrip_( b, rc.right, rc.top, sz, fill_, ink )
        if allowed and EDGE_L then PaintGrip_( b, rc.left, my, sz, fill_, ink )
        if allowed and EDGE_R then PaintGrip_( b, rc.right, my, sz, fill_, ink )
        if (allowed and EDGE_L) andalso (allowed and EDGE_B) then PaintGrip_( b, rc.left, rc.bottom, sz, fill_, ink )
        if allowed and EDGE_B then PaintGrip_( b, mx, rc.bottom, sz, fill_, ink )
        if (allowed and EDGE_R) andalso (allowed and EDGE_B) then PaintGrip_( b, rc.right, rc.bottom, sz, fill_, ink )
    next

    ' Tab Order: each control's place among its siblings, a badge on its top-left corner
    if TabOrderMode then
        dim as Array( of long ) ranks = TabRanks( Doc )
        b->SetFont( Glass->pHost->pDefaultFont )
        for i as long = 0 to Doc.Controls.Count( ) - 1
            if (i >= Widgets.Count( )) orelse (i >= ranks.Count( )) then exit for
            if (Widgets[i] = 0) orelse (this.Shows( Widgets[i] ) = false) then continue for
            dim as TKRECT rc = this.RectOf( Widgets[i] )
            dim as ustring num = str( ranks[i] )
            dim as TKRECT bg
            tkRect_Set( bg, rc.left, rc.top, rc.left + this.ToPixels( 8 + 7 * len( num ) ), rc.top + this.ToPixels( 16 ) )
            b->SetBackColor( iif( Doc.Controls[i].TabIndex > 0, t.Accent, t.Border ) )
            b->PaintRect( @bg )
            b->SetForeColor( t.Window )
            b->PaintText( num, @bg, TK_DT_CENTER or TK_DT_VCENTER )
        next
    end if

    if (Drag = DragRubber) orelse (Drag = DragDraw) then
        dim as TKRECT band
        tkRect_Set( band, iif( NowX < StartX, NowX, StartX ), iif( NowY < StartY, NowY, StartY ), _
                    iif( NowX < StartX, StartX, NowX ), iif( NowY < StartY, StartY, NowY ) )
        b->SetPenColor( t.Accent )
        b->PaintRoundOutline( @band, 0, 1 )
    end if
end sub

' ---- the project's theme -----------------------------------------------------------------------------

' The variant the form shows: tkEdit's own, unless Form > Preview Light / Dark chose one.
function FormCanvas.ShowsDark( ) as boolean
    if PreviewSet then return PreviewDark
    return tkTheme_Get( ).IsDark
end function

' The form (Surface and every control on it) wears the project's theme -- its variant, shape,
' styles and per-type colours -- as the program will; tkEdit's own theme stays on the rest. No
' theme file, or one that doesn't read: the presets of the variant shown.
' The size a control with AutoSize asks for, in pixels; 0 when it has no such measure.
private sub IdealSize_( byref typeName as const ustring, byval w as TK_WIDGET ptr, byref iw as long, byref ih as long )
    iw = 0 : ih = 0
    select case typeName
    case "Button" : tkButton_GetIdealSize( w, iw, ih )
    case "Label" : tkLabel_GetIdealSize( w, iw, ih )
    case "CheckBox" : tkCheckBox_GetIdealSize( w, iw, ih )
    case "OptionButton" : tkOptionButton_GetIdealSize( w, iw, ih )
    case "ComboBox" : tkComboBox_GetIdealSize( w, iw, ih )
    end select
end sub

' A font role for a control here: GLYPH and GLYPH_LARGE in the theme's glyph font, the rest tkEdit's.
' A project glyph font by its key, opened on first use (the surface owns it); the bundled icons for
' "" or Fluent. 0 when the key has no file.
function FormCanvas.GlyphFontFor( byref key_ as const ustring, byval large as boolean ) as TTF_Font ptr
    if (len( key_ ) = 0) orelse (lcase( key_ ) = lcase( GLYPH_FONT_FLUENT )) then return iif( large, GlyphFontLarge, GlyphFont )
    for each o as CanvasGlyphFont in GlyphOpen
        if lcase( o.Key ) = lcase( key_ ) then return iif( large, o.Large, o.Normal )
    next
    if Surface = 0 then return 0
    dim as ustring path
    for each s as Setting in GlyphPaths
        if lcase( s.Key ) = lcase( key_ ) then path = s.Value
    next
    if len( path ) = 0 then return 0
    dim as CanvasGlyphFont o
    o.Key = key_
    dim as single pt = tkApp_Options( ).FontUISize
    o.Normal = tkHost_OpenFont( Surface->pHost, path, pt )
    o.Large = tkHost_OpenFont( Surface->pHost, path, pt + 2 )
    GlyphOpen.Push( o )
    return iif( large, o.Large, o.Normal )
end function

' A glyph font by its key at a GlyphSize in points, opened on first use; 0 when the key has no file.
function FormCanvas.GlyphFontAt( byref key_ as const ustring, byval pt as long ) as TTF_Font ptr
    for each o as CanvasSizedFont in GlyphSized
        if (lcase( o.Key ) = lcase( key_ )) andalso (o.Pt = pt) then return o.F
    next
    if Surface = 0 then return 0
    dim as ustring path
    if (len( key_ ) = 0) orelse (lcase( key_ ) = lcase( GLYPH_FONT_FLUENT )) then
        path = themefile.GlyphFontPath( PkgDir )
    else
        for each s as Setting in GlyphPaths
            if lcase( s.Key ) = lcase( key_ ) then path = s.Value
        next
    end if
    if len( path ) = 0 then return 0
    dim as CanvasSizedFont o
    o.Key = key_ : o.Pt = pt
    o.F = tkHost_OpenFont( Surface->pHost, path, pt )
    GlyphSized.Push( o )
    return o.F
end function

function FormCanvas.RoleFont( byval f as TK_FORM ptr, byval role as long, byref glyphKey as const ustring ) as TTF_Font ptr
    if (role = TKFONT_GLYPH) orelse (role = TKFONT_GLYPH_LARGE) then
        dim as TTF_Font ptr gf = this.GlyphFontFor( glyphKey, role = TKFONT_GLYPH_LARGE )
        if gf then return gf
    end if
    if (role = TKFONT_GLYPH) andalso (GlyphFont <> 0) then return GlyphFont
    if (role = TKFONT_GLYPH_LARGE) andalso (GlyphFontLarge <> 0) then return GlyphFontLarge
    return tkForm_Font( f, role )
end function

sub FormCanvas.ApplyProjectTheme( )
    if Surface = 0 then exit sub
    dim as themefile.ThemeDoc d
    if len( ThemePath ) then
        dim as ustring none, e
        dim as ustring text = fs.ReadAllText( ThemePath ).ValueOr( none )
        if len( text ) then themefile.Parse( text, d, e )
    end if
    ' the glyph font: a new one rebuilds the controls (they take their fonts as they are made)
    dim as ustring src = themefile.GlyphFontPath( PkgDir )
    ' the project's glyph fonts are part of what was opened from: a list changed rebuilds too
    dim as ustring sig = src
    for each gp as Setting in GlyphPaths
        sig &= "|" & gp.Key & "=" & gp.Value
    next
    if sig <> GlyphSrc then
        GlyphSrc = sig
        GlyphFont = 0 : GlyphFontLarge = 0
        GlyphOpen.Clear( )
        GlyphSized.Clear( )
        if len( src ) then
            dim as single pt = tkApp_Options( ).FontUISize
            GlyphFont = tkHost_OpenFont( Surface->pHost, src, pt )      ' the surface owns them
            GlyphFontLarge = tkHost_OpenFont( Surface->pHost, src, pt + 2 )
        end if
        if Building = false then
            this.Rebuild( )
            exit sub
        end if
    end if
    dim as TKTHEME_COLORS t = themefile.Resolve( d, this.ShowsDark( ) )
    dim as TKTHEME_SHAPE sh = themefile.ShapeOf( d )
    ThemeTables.Build( d )
    tkTheme_ApplyTo( Surface, t, @sh, ThemeTables.StylePtr( ), ThemeTables.Styles.Count( ), _
                     ThemeTables.TypePtr( ), ThemeTables.Types.Count( ) )
    tkWidget_Invalidate( Surface )
end sub
