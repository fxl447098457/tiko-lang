' model -- a form as data: its window, and a flat list of controls whose order is z-order and tab
' order. A control names its parent; a parent always comes before its children.
#module "model"

#import "std/containers"
#import "vendor/tkControls/tkLayout"
using containers
using tkLayout

public const as long FORM_FORMAT = 1

' How a value is spelled in the file. The text form is what every other part of the designer uses.
public enum
    VALUE_TEXT = 0
    VALUE_BOOL
    VALUE_INT
    VALUE_FLOAT
end enum

public type Setting
    Key as ustring
    Value as ustring
    Kind as long
end type

' One entry of a menu, toolbar, status bar, column list or combo box.
public type FormItem
    Text as ustring
    Key as ustring          ' a menu item's shortcut
    Glyph as ustring
    Handler as ustring
    Kind as ustring         ' a toolbar item: command toggle separator split dropdown
    Level as long           ' a menu item's depth: 0 is on the bar
    Width as long
    Origin as long = -1     ' editing tab pages: which page this was, -1 for a new one
end type

public type FormControl
    Name as ustring
    TypeName as ustring
    Parent as ustring
    Page as long = -1               ' which page of a tab control parent, from 0
    X as long
    Y as long
    W as long
    H as long
    Anchor as long = TK_ANCHOR_DEFAULT
    Dock as long = TK_DOCK_NONE
    Props as Array( of Setting )    ' Key = property, Value = its text form
    Events as Array( of Setting )   ' Key = event, Value = handler name
    Pages as Array( of ustring )    ' a tab control's page captions
    Items as Array( of FormItem )
    CustomType as ustring           ' a Custom control: the program's own type
    CustomModule as ustring         ' and the module to import it from
    ' [control.colors]: a style of the project theme by name, and colour-struct fields over it.
    ' Values as colorval spells them: "#RRGGBB[AA]", "@Role", "#dark|#light".
    StyleName as ustring
    Colors as Array( of Setting )
end type

' A handler whose control was deleted while its body still had code in it. Its declaration is kept
' so the user's file goes on compiling until the body is deleted.
public type FormOrphan
    Handler as ustring
    Params as ustring
end type

public type FormDoc
    Caption as ustring
    Translate as boolean                ' texts go through tkForms_Tr
    ModuleName as ustring               ' set while generating; not in the file
    ClientW as long = 400
    ClientH as long = 300
    Events as Array( of Setting )       ' Load, Close
    Controls as Array( of FormControl )
    Orphans as Array( of FormOrphan )
    Problems as Array( of ustring )     ' what reading the file could not accept
end type

' -1 when there is no such control. Names differ in more than case, as tiko's own names do.
public function FindControl( byref doc as FormDoc, byref name_ as const ustring ) as long
    dim as ustring want = lcase( name_ )
    for i as long = 0 to doc.Controls.Count( ) - 1
        if lcase( doc.Controls[i].Name ) = want then return i
    next
    return -1
end function

public function FindSetting( byref list as Array( of Setting ), byref key_ as const ustring ) as long
    for i as long = 0 to list.Count( ) - 1
        if list[i].Key = key_ then return i
    next
    return -1
end function

' The value, or `dflt` when the key is absent.
public function SettingOr( byref list as Array( of Setting ), byref key_ as const ustring, byref dflt as const ustring = "" ) as ustring
    dim as long i = FindSetting( list, key_ )
    if i < 0 then return dflt
    return list[i].Value
end function

public sub PutSetting( byref list as Array( of Setting ), byref key_ as const ustring, byref v as const ustring, byval kind_ as long = VALUE_TEXT )
    dim as long i = FindSetting( list, key_ )
    if i >= 0 then
        list[i].Value = v
        list[i].Kind = kind_
        exit sub
    end if
    dim as Setting s
    s.Key = key_
    s.Value = v
    s.Kind = kind_
    list.Push( s )
end sub

' ---- anchors and docks as the file spells them ------------------------------------------------

' "right bottom" to a mask. Answers false for a word it does not know, leaving the mask default.
public function AnchorFromWords( byref text as const ustring, byref mask as long ) as boolean
    dim as long m = 0
    dim as ustring word
    dim as ustring t = text & " "
    for i as long = 1 to len( t )
        dim as ustring ch = mid( t, i, 1 )
        if ch <> " " then
            word &= ch
        elseif len( word ) then
            select case word
            case "left"   : m or= TK_ANCHOR_LEFT
            case "top"    : m or= TK_ANCHOR_TOP
            case "right"  : m or= TK_ANCHOR_RIGHT
            case "bottom" : m or= TK_ANCHOR_BOTTOM
            case "none"   :
            case else
                mask = TK_ANCHOR_DEFAULT
                return false
            end select
            word = ""
        end if
    next
    mask = m
    return true
end function

public function AnchorWords( byval mask as long ) as ustring
    dim as ustring s
    if mask and TK_ANCHOR_LEFT then s &= " left"
    if mask and TK_ANCHOR_TOP then s &= " top"
    if mask and TK_ANCHOR_RIGHT then s &= " right"
    if mask and TK_ANCHOR_BOTTOM then s &= " bottom"
    if len( s ) = 0 then return "none"
    return mid( s, 2 )
end function

public function DockFromWord( byref word as const ustring, byref dock_ as long ) as boolean
    select case word
    case "none"   : dock_ = TK_DOCK_NONE
    case "top"    : dock_ = TK_DOCK_TOP
    case "bottom" : dock_ = TK_DOCK_BOTTOM
    case "left"   : dock_ = TK_DOCK_LEFT
    case "right"  : dock_ = TK_DOCK_RIGHT
    case "fill"   : dock_ = TK_DOCK_FILL
    case else
        dock_ = TK_DOCK_NONE
        return false
    end select
    return true
end function

public function DockWord( byval dock_ as long ) as ustring
    select case dock_
    case TK_DOCK_TOP    : return "top"
    case TK_DOCK_BOTTOM : return "bottom"
    case TK_DOCK_LEFT   : return "left"
    case TK_DOCK_RIGHT  : return "right"
    case TK_DOCK_FILL   : return "fill"
    end select
    return "none"
end function
