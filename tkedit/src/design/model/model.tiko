' model -- a form as data: its window, and a flat list of controls whose order is z-order and tab
' order. A control names its parent; a parent always comes before its children.
#module "model"

#import "std/containers"
#import "vendor/tkControls/tkLayout"
using containers
using tkLayout

public const as long FORM_FORMAT = 1

' How a value is spelled in the file. The text form is what every other part of the designer uses.
public enum
    VALUE_TEXT = 0
    VALUE_BOOL
    VALUE_INT
    VALUE_FLOAT
end enum

public type Setting
    Key as ustring
    Value as ustring
    Kind as long
end type

' One entry of a menu, toolbar, status bar, column list or combo box.
public type FormItem
    Text as ustring
    Key as ustring          ' a menu item's shortcut
    Glyph as ustring
    Handler as ustring
    Kind as ustring         ' a toolbar item: command toggle separator split dropdown
    Level as long           ' a menu item's depth: 0 is on the bar
    Width as long
    Origin as long = -1     ' editing tab pages: which page this was, -1 for a new one
    Stretch as boolean      ' a status bar panel: takes a share of the spare width (several may)
end type

public type FormControl
    Name as ustring
    TypeName as ustring
    Parent as ustring
    Page as long = -1               ' which page of a tab control parent, from 0
    X as long
    Y as long
    W as long
    H as long
    Anchor as long = TK_ANCHOR_DEFAULT
    Dock as long = TK_DOCK_NONE
    Props as Array( of Setting )    ' Key = property, Value = its text form
    Events as Array( of Setting )   ' Key = event, Value = handler name
    Pages as Array( of ustring )    ' a tab control's page captions
    PageGlyphs as Array( of ustring )   ' and their glyphs ("<font>:<hex>"), by page; may be shorter
    Items as Array( of FormItem )
    CustomType as ustring           ' a Custom control: the program's own type
    CustomModule as ustring         ' and the module to import it from
    ' [control.colors]: a style of the project theme by name, and colour-struct fields over it.
    ' Values as colorval spells them: "#RRGGBB[AA]", "@Role", "#dark|#light".
    StyleName as ustring
    Colors as Array( of Setting )
    ContextMenu as ustring          ' a PopupMenu of the form that a right-click on it opens, "" = none
    Locked as boolean               ' Design > Lock Controls: the designer won't move or resize it
    TabIndex as long                ' its place in Tab order among its siblings (1 first); 0 = none
end type

' A handler whose control was deleted while its body still had code in it. Its declaration is kept
' so the user's file goes on compiling until the body is deleted.
public type FormOrphan
    Handler as ustring
    Params as ustring
end type

public type FormDoc
    Caption as ustring
    Translate as boolean                ' texts go through tkForms_Tr
    ModuleName as ustring               ' set while generating; not in the file
    ClientW as long = 400
    ClientH as long = 300
    ' the window; each "" / 0 / false leaves the run-time default
    StartPosition as ustring            ' "", "CenterScreen", "CenterOwner"
    WindowState as ustring              ' "", "Maximized", "Minimized"
    Resizable as ustring                ' "" (a top-level form resizes, an owned one doesn't), "true", "false"
    MinW as long                        ' size limits of the client, design units
    MinH as long
    MaxW as long
    MaxH as long
    AlwaysOnTop as boolean
    Icon as ustring                     ' an image file
    ContextMenu as ustring              ' a PopupMenu a right-click on the form's own surface opens
    Events as Array( of Setting )       ' catalog.FormEventName's
    Controls as Array( of FormControl )
    Orphans as Array( of FormOrphan )
    Problems as Array( of ustring )     ' what reading the file could not accept
end type

' -1 when there is no such control. Names differ in more than case, as tiko's own names do.
public function FindControl( byref doc as FormDoc, byref name_ as const ustring ) as long
    dim as ustring want = lcase( name_ )
    for i as long = 0 to doc.Controls.Count( ) - 1
        if lcase( doc.Controls[i].Name ) = want then return i
    next
    return -1
end function

' A tab control's page p's glyph ("<font>:<hex>"); "" for none.
public function PageGlyph( byref c as FormControl, byval p as long ) as ustring
    if (p < 0) orelse (p >= c.PageGlyphs.Count( )) then return ""
    return c.PageGlyphs[p]
end function

public function FindSetting( byref list as Array( of Setting ), byref key_ as const ustring ) as long
    for i as long = 0 to list.Count( ) - 1
        if list[i].Key = key_ then return i
    next
    return -1
end function

' The value, or `dflt` when the key is absent.
public function SettingOr( byref list as Array( of Setting ), byref key_ as const ustring, byref dflt as const ustring = "" ) as ustring
    dim as long i = FindSetting( list, key_ )
    if i < 0 then return dflt
    return list[i].Value
end function

public sub PutSetting( byref list as Array( of Setting ), byref key_ as const ustring, byref v as const ustring, byval kind_ as long = VALUE_TEXT )
    dim as long i = FindSetting( list, key_ )
    if i >= 0 then
        list[i].Value = v
        list[i].Kind = kind_
        exit sub
    end if
    dim as Setting s
    s.Key = key_
    s.Value = v
    s.Kind = kind_
    list.Push( s )
end sub

' ---- anchors and docks as the file spells them ------------------------------------------------

' "right bottom" to a mask. Answers false for a word it does not know, leaving the mask default.
public function AnchorFromWords( byref text as const ustring, byref mask as long ) as boolean
    dim as long m = 0
    dim as ustring word
    dim as ustring t = text & " "
    for i as long = 1 to len( t )
        dim as ustring ch = mid( t, i, 1 )
        if ch <> " " then
            word &= ch
        elseif len( word ) then
            select case word
            case "left"   : m or= TK_ANCHOR_LEFT
            case "top"    : m or= TK_ANCHOR_TOP
            case "right"  : m or= TK_ANCHOR_RIGHT
            case "bottom" : m or= TK_ANCHOR_BOTTOM
            case "none"   :
            case else
                mask = TK_ANCHOR_DEFAULT
                return false
            end select
            word = ""
        end if
    next
    mask = m
    return true
end function

public function AnchorWords( byval mask as long ) as ustring
    dim as ustring s
    if mask and TK_ANCHOR_LEFT then s &= " left"
    if mask and TK_ANCHOR_TOP then s &= " top"
    if mask and TK_ANCHOR_RIGHT then s &= " right"
    if mask and TK_ANCHOR_BOTTOM then s &= " bottom"
    if len( s ) = 0 then return "none"
    return mid( s, 2 )
end function

public function DockFromWord( byref word as const ustring, byref dock_ as long ) as boolean
    select case word
    case "none"   : dock_ = TK_DOCK_NONE
    case "top"    : dock_ = TK_DOCK_TOP
    case "bottom" : dock_ = TK_DOCK_BOTTOM
    case "left"   : dock_ = TK_DOCK_LEFT
    case "right"  : dock_ = TK_DOCK_RIGHT
    case "fill"   : dock_ = TK_DOCK_FILL
    case else
        dock_ = TK_DOCK_NONE
        return false
    end select
    return true
end function

public function DockWord( byval dock_ as long ) as ustring
    select case dock_
    case TK_DOCK_TOP    : return "top"
    case TK_DOCK_BOTTOM : return "bottom"
    case TK_DOCK_LEFT   : return "left"
    case TK_DOCK_RIGHT  : return "right"
    case TK_DOCK_FILL   : return "fill"
    end select
    return "none"
end function

' ---- glyph values (docs/tkDesigner/GLYPHS.md, GV7) ----------------------------------------------
' A glyph property holds "<font>:<hex code>", the code as the source font has it: "Fluent:E824".
' Anything else (a plain character from before) is a character in the GLYPH font, as typed.
public const GLYPH_FONT_FLUENT = "Fluent"       ' the bundled Fluent UI System Icons

private function HexCode_( byref t as const ustring ) as ulong
    dim as ustring h = ucase( t )
    if (len( h ) < 2) orelse (len( h ) > 6) then return 0
    for i as long = 1 to len( h )
        dim as long a = asc( mid( h, i, 1 ) )
        if ((a < 48) orelse (a > 57)) andalso ((a < 65) orelse (a > 70)) then return 0
    next
    return culng( valuint( "&h" & h ) )
end function

' The code of a "<font>:<hex>" value; 0 for anything else.
public function GlyphCode( byref v as const ustring ) as ulong
    dim as long c = instr( v, ":" )
    if c < 2 then return 0
    return HexCode_( mid( v, c + 1 ) )
end function

' The font of a "<font>:<hex>" value; "" for anything else.
public function GlyphFontKey( byref v as const ustring ) as ustring
    if GlyphCode( v ) = 0 then return ""
    return left( v, instr( v, ":" ) - 1 )
end function

' "<font>:<hex>", the code upper case, four digits at least.
public function GlyphRef( byref fontKey as const ustring, byval cp as ulong ) as ustring
    dim as ustring h = hex( cp )
    if len( h ) < 4 then h = right( "000" & h, 4 )
    return fontKey & ":" & h
end function

' What a control draws for a glyph value: the code's character, or the value as it is.
public function GlyphChar( byref v as const ustring ) as ustring
    dim as ulong cp = GlyphCode( v )
    if cp then return wchr( cp )
    return v
end function

' What the inspector's code box shows: the hex code of a "<font>:<hex>" value, else the value.
public function GlyphShown( byref v as const ustring ) as ustring
    if GlyphCode( v ) then return mid( v, instr( v, ":" ) + 1 )
    return v
end function

' What the code box's text means, the value it had giving the font: "E824" / "U+E824" in that font
' (the bundled icons when it had none), "<font>:<hex>" as it is, "" none, anything else as typed.
public function GlyphTyped( byref t as const ustring, byref had as const ustring ) as ustring
    dim as ustring s = trim( t )
    if len( s ) = 0 then return ""
    if GlyphCode( s ) andalso (ucase( left( s, 2 ) ) <> "U+") then return GlyphRef( GlyphFontKey( s ), GlyphCode( s ) )
    if ucase( left( s, 2 ) ) = "U+" then s = mid( s, 3 )
    dim as ulong cp = HexCode_( s )
    if cp = 0 then return t
    dim as ustring k = GlyphFontKey( had )
    if len( k ) = 0 then k = GLYPH_FONT_FLUENT
    return GlyphRef( k, cp )
end function

' ---- Tab order (Design > Tab Order) -------------------------------------------------------------
' Each control's place in Tab order among its siblings (the same parent and page), as the program
' visits them: by TabIndex, those without one after, in list order. Index i is control i's place, from 1.
public function TabRanks( byref doc as FormDoc ) as Array( of long )
    dim as Array( of long ) rank
    dim as long n = doc.Controls.Count( )
    for i as long = 0 to n - 1
        rank.Push( 0 )
    next
    for i as long = 0 to n - 1
        if rank[i] then continue for
        ' this control's siblings, in list order, then ordered by their index (stable)
        dim as Array( of long ) sib
        for j as long = 0 to n - 1
            if (lcase( doc.Controls[j].Parent ) = lcase( doc.Controls[i].Parent )) andalso (doc.Controls[j].Page = doc.Controls[i].Page) then sib.Push( j )
        next
        for a as long = 1 to sib.Count( ) - 1
            dim as long k = sib[a], b = a - 1
            dim as long kk = iif( doc.Controls[k].TabIndex > 0, doc.Controls[k].TabIndex, &h7FFFFFFF )
            while (b >= 0) andalso (iif( doc.Controls[sib[b]].TabIndex > 0, doc.Controls[sib[b]].TabIndex, &h7FFFFFFF ) > kk)
                sib[b + 1] = sib[b]
                b -= 1
            wend
            sib[b + 1] = k
        next
        for a as long = 0 to sib.Count( ) - 1
            rank[sib[a]] = a + 1
        next
    next
    return rank
end function

' Control name_ to place pos among its siblings in Tab order; they are numbered 1..n after it, the
' others keeping their order around it. (A click in Tab Order mode: pos counts up per container.)
public sub SetTabPlace( byref doc as FormDoc, byref name_ as const ustring, byval pos_ as long )
    dim as long i = FindControl( doc, name_ )
    if i < 0 then exit sub
    dim as Array( of long ) rank = TabRanks( doc )
    dim as Array( of long ) order                      ' the siblings in their current Tab order, but i
    dim as long n = doc.Controls.Count( )
    for r as long = 1 to n
        for j as long = 0 to n - 1
            if (j <> i) andalso (rank[j] = r) andalso (lcase( doc.Controls[j].Parent ) = lcase( doc.Controls[i].Parent )) _
               andalso (doc.Controls[j].Page = doc.Controls[i].Page) then order.Push( j )
        next
    next
    if pos_ < 1 then pos_ = 1
    if pos_ > order.Count( ) + 1 then pos_ = order.Count( ) + 1
    dim as long at = 1
    for each j as long in order
        if at = pos_ then at += 1                         ' i's place
        doc.Controls[j].TabIndex = at
        at += 1
    next
    doc.Controls[i].TabIndex = pos_
end sub
