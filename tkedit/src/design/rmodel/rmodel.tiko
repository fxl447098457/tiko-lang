' rmodel -- what the Report Designer's palettes show of a report (RD6), without a window: the
' inspector's rows for the report, a band or an item (a hand-written table: report items are not
' widgets, so not controls.toml), their values and their edits; and the field list's entries.
'
' THE INSPECTOR'S KEYS ARE THE FILE'S (x, can_grow, print_at_bottom ...): what the inspector says is
' what the .tkreport says. A target is "" (the report), "band:<id>" or "item:<id>". SetProp changes
' the model and answers "" or why not; the canvas then checks that the result still reads back
' (rcanvas.ApplyProp), so a value the file's reader refuses is refused here too.
#module "rmodel"

#import "std/containers"
#import "tkc/i18n"
#import "vendor/tkControls/tkReportDef"
#import "../redits"
using containers
using tkReportDef
using tkReport
using tkRExpr
using tkBind

public enum RPropKind
    RPropText
    RPropNumber
    RPropBool
    RPropEnum
    RPropFixed          ' shown, not edited (an item's kind)
end enum

public type RProp
    Key   as ustring
    Kind  as RPropKind
    Items as ustring    ' an enum's choices, comma-separated
end type

' A field list row. Kind: a source (0), its field (1), the parameters' heading (2), a parameter (3),
' the built-ins' heading (4), a built-in (5).
public type RField
    Kind   as int32
    Level  as int32
    Label  as ustring
    Source as ustring
    Name   as ustring
end type

private sub P_( byref out_ as Array( of RProp ), byref key_ as const ustring, byval kind_ as RPropKind, byref items as const ustring = "" )
    dim as RProp p
    p.Key = key_
    p.Kind = kind_
    p.Items = items
    out_.Push( p )
end sub

private function Sources_( byval def as TK_REPORTDEF ptr ) as ustring
    dim as ustring s
    for i as int32 = 0 to def->nSources - 1
        s &= "," & def->sources(i).name_
    next
    return s
end function

' The rows for target, in order.
public sub PropsOf( byval def as TK_REPORTDEF ptr, byref target as const ustring, byref out_ as Array( of RProp ) )
    out_.Clear( )
    if def = 0 then exit sub
    if left( target, 5 ) = "item:" then
        dim as int32 i = tkReportDef_FindItem( def, mid( target, 6 ) )
        if i < 0 then exit sub
        dim as ustring k = def->items(i).kind
        P_( out_, "id", RPropKind.RPropText )
        P_( out_, "kind", RPropKind.RPropFixed )
        P_( out_, "x", RPropKind.RPropNumber )
        P_( out_, "y", RPropKind.RPropNumber )
        P_( out_, "w", RPropKind.RPropNumber )
        P_( out_, "h", RPropKind.RPropNumber )
        select case k
        case "text" : P_( out_, "text", RPropKind.RPropText )
        case "field" : P_( out_, "expr", RPropKind.RPropText ) : P_( out_, "format", RPropKind.RPropText )
        case "image" : P_( out_, "text", RPropKind.RPropText ) : P_( out_, "expr", RPropKind.RPropText )
        case "check" : P_( out_, "expr", RPropKind.RPropText )
        case "custom" : P_( out_, "tag", RPropKind.RPropNumber )
        end select
        if (k = "text") orelse (k = "field") then
            P_( out_, "align", RPropKind.RPropEnum, "left,center,right" )
            P_( out_, "valign", RPropKind.RPropEnum, "top,middle,bottom" )
            P_( out_, "wrap", RPropKind.RPropBool )
            P_( out_, "can_grow", RPropKind.RPropBool )
            P_( out_, "font", RPropKind.RPropText )
            P_( out_, "size", RPropKind.RPropNumber )
            P_( out_, "bold", RPropKind.RPropBool )
            P_( out_, "italic", RPropKind.RPropBool )
            P_( out_, "fore", RPropKind.RPropText )
        end if
        if (k <> "line") andalso (k <> "image") then P_( out_, "back", RPropKind.RPropText )
        P_( out_, "border", RPropKind.RPropText )
        P_( out_, "line_color", RPropKind.RPropText )
        P_( out_, "pen", RPropKind.RPropNumber )
        P_( out_, "visible", RPropKind.RPropText )
        if (k = "text") orelse (k = "field") then
            P_( out_, "reset", RPropKind.RPropText )
            P_( out_, "running", RPropKind.RPropBool )
            P_( out_, "incr", RPropKind.RPropText )
        end if
    elseif left( target, 5 ) = "band:" then
        dim as int32 b = tkReportDef_FindBand( def, mid( target, 6 ) )
        if b < 0 then exit sub
        dim as ustring k = def->bands(b).kind
        P_( out_, "id", RPropKind.RPropText )
        P_( out_, "kind", RPropKind.RPropFixed )
        if (k = "detail") orelse (k = "detail_report") then P_( out_, "source", RPropKind.RPropEnum, mid( Sources_( def ), 2 ) )
        if k = "group_header" then P_( out_, "group", RPropKind.RPropText )
        P_( out_, "height", RPropKind.RPropNumber )
        P_( out_, "can_grow", RPropKind.RPropBool )
        P_( out_, "page_break_before", RPropKind.RPropBool )
        P_( out_, "page_break_after", RPropKind.RPropBool )
        if k = "group_header" then P_( out_, "repeat", RPropKind.RPropBool )
        if (k = "page_header") orelse (k = "page_footer") then P_( out_, "print_on_first_page", RPropKind.RPropBool )
        if k = "report_footer" then P_( out_, "print_at_bottom", RPropKind.RPropBool )
        P_( out_, "visible", RPropKind.RPropText )
        P_( out_, "back", RPropKind.RPropText )
    else
        P_( out_, "title", RPropKind.RPropText )
        P_( out_, "paper", RPropKind.RPropEnum, ",A4,Letter,Legal,A3,A5,B5,Tabloid,Executive" )
        P_( out_, "landscape", RPropKind.RPropBool )
        P_( out_, "margin_left", RPropKind.RPropNumber )
        P_( out_, "margin_top", RPropKind.RPropNumber )
        P_( out_, "margin_right", RPropKind.RPropNumber )
        P_( out_, "margin_bottom", RPropKind.RPropNumber )
        P_( out_, "units", RPropKind.RPropEnum, "mm,in,pt" )
        P_( out_, "data_module", RPropKind.RPropText )
        P_( out_, "bool_text", RPropKind.RPropText )
    end if
end sub

' A number as the inspector shows it: to 0.01, without trailing zeros.
public function NumText( byval v as float32 ) as ustring
    dim as long c = clng( int( abs( v ) * 100 + 0.5 ) )
    dim as ustring s = str( c \ 100 )
    dim as long f = c mod 100
    if f then
        s &= "." & right( "0" & f, 2 )
        if right( s, 1 ) = "0" then s = left( s, len( s ) - 1 )
    end if
    if (v < 0) andalso (c <> 0) then s = "-" & s
    return s
end function

private function B_( byval b as boolean ) as ustring
    if b then return "true"
    return "false"
end function

public function GetProp( byval def as TK_REPORTDEF ptr, byref target as const ustring, byref key_ as const ustring ) as ustring
    if def = 0 then return ""
    if left( target, 5 ) = "item:" then
        dim as int32 i = tkReportDef_FindItem( def, mid( target, 6 ) )
        if i < 0 then return ""
        dim byref as TKRD_ITEM it = def->items(i)
        select case key_
        case "id" : return it.id
        case "kind" : return it.kind
        case "x" : return NumText( it.x )
        case "y" : return NumText( it.y )
        case "w" : return NumText( it.w )
        case "h" : return NumText( it.h )
        case "text" : return it.text
        case "expr" : return it.expr
        case "format" : return it.format
        case "align" : return it.align
        case "valign" : return it.valign
        case "wrap" : return B_( it.wrap )
        case "can_grow" : return B_( it.canGrow )
        case "font" : return it.fontSrc
        case "size" : return NumText( it.fontSize )
        case "bold" : return B_( it.bold )
        case "italic" : return B_( it.italic )
        case "fore" : return it.fore
        case "back" : return it.back
        case "border" : return it.border
        case "line_color" : return it.lineColor
        case "pen" : return NumText( it.pen )
        case "visible" : return it.visible
        case "reset" : return it.reset
        case "running" : return B_( it.running )
        case "incr" : return it.incr
        case "tag" : return str( it.tag )
        end select
    elseif left( target, 5 ) = "band:" then
        dim as int32 b = tkReportDef_FindBand( def, mid( target, 6 ) )
        if b < 0 then return ""
        dim byref as TKRD_BAND bd = def->bands(b)
        select case key_
        case "id" : return bd.id
        case "kind" : return bd.kind
        case "source" : return bd.source
        case "group" : return bd.group_
        case "height" : return NumText( bd.height )
        case "can_grow" : return B_( bd.canGrow )
        case "page_break_before" : return B_( bd.breakBefore )
        case "page_break_after" : return B_( bd.breakAfter )
        case "repeat" : return B_( bd.repeat_ )
        case "print_on_first_page" : return B_( bd.printOnFirstPage )
        case "print_at_bottom" : return B_( bd.printAtBottom )
        case "visible" : return bd.visible
        case "back" : return bd.back
        end select
    else
        select case key_
        case "title" : return def->title
        case "paper" : return def->paper
        case "landscape" : return B_( def->landscape )
        case "margin_left" : return NumText( def->mL )
        case "margin_top" : return NumText( def->mT )
        case "margin_right" : return NumText( def->mR )
        case "margin_bottom" : return NumText( def->mB )
        case "units" : return def->units
        case "data_module" : return def->dataModule
        case "bool_text" : return def->boolText
        end select
    end if
    return ""
end function

' s as a number: digits, one point, a leading minus.
private function Num_( byref s as const ustring, byref v as float32 ) as boolean
    dim as ustring t = trim( s )
    if len( t ) = 0 then return false
    dim as long dots = 0
    for i as long = 1 to len( t )
        dim as long ch = asc( mid( t, i, 1 ) )
        if ch = 46 then
            dots += 1
        elseif (ch < 48) orelse (ch > 57) then
            if (i > 1) orelse (ch <> 45) orelse (len( t ) = 1) then return false
        end if
    next
    if dots > 1 then return false
    v = redits.Round2( val( t ) )
    return true
end function

private function IsName_( byref s as const ustring ) as boolean
    if len( s ) = 0 then return false
    for i as long = 1 to len( s )
        dim as long ch = asc( mid( s, i, 1 ) )
        dim as boolean ok = ((ch >= 65) andalso (ch <= 90)) orelse ((ch >= 97) andalso (ch <= 122)) orelse (ch = 95) orelse _
                            ((i > 1) andalso (ch >= 48) andalso (ch <= 57))
        if ok = false then return false
    next
    return true
end function

private function NeedNumber_( ) as ustring
    return i18n.Tr( "report.need_number", "a number, please" )
end function

' One property of target to value. "" = done, else why not (the model is then unchanged).
public function SetProp( byval def as TK_REPORTDEF ptr, byref target as const ustring, byref key_ as const ustring, _
                         byref value as const ustring ) as ustring
    if def = 0 then return "?"
    dim as float32 n
    dim as boolean isNum = Num_( value, n )
    dim as boolean b = (lcase( trim( value ) ) = "true")
    if left( target, 5 ) = "item:" then
        dim as int32 i = tkReportDef_FindItem( def, mid( target, 6 ) )
        if i < 0 then return "?"
        dim byref as TKRD_ITEM it = def->items(i)
        select case key_
        case "x", "y", "w", "h", "size", "pen", "tag"
            if isNum = false then return NeedNumber_( )
            select case key_
            case "x" : it.x = n
            case "y" : it.y = n
            case "w" : it.w = n
            case "h" : it.h = n
            case "size" : it.fontSize = n
            case "pen" : it.pen = n
            case "tag" : it.tag = clngint( n )
            end select
        case "id"
            if IsName_( value ) = false then return value & ": not a name"
            dim as int32 o = tkReportDef_FindItem( def, value )
            if (o >= 0) andalso (o <> i) then return value & ": an item has that id"
            it.id = value
        case "text" : it.text = value
        case "expr" : it.expr = value
        case "format" : it.format = value
        case "align" : it.align = value
        case "valign" : it.valign = value
        case "wrap" : it.wrap = b
        case "can_grow" : it.canGrow = b
        case "font" : it.fontSrc = value
        case "bold" : it.bold = b
        case "italic" : it.italic = b
        case "fore" : it.fore = value
        case "back" : it.back = value
        case "border" : it.border = value
        case "line_color" : it.lineColor = value
        case "visible" : it.visible = value
        case "reset" : it.reset = value
        case "running" : it.running = b
        case "incr" : it.incr = value
        case else : return "?"
        end select
        return ""
    end if
    if left( target, 5 ) = "band:" then
        dim as int32 bi = tkReportDef_FindBand( def, mid( target, 6 ) )
        if bi < 0 then return "?"
        dim byref as TKRD_BAND bd = def->bands(bi)
        select case key_
        case "height"
            if isNum = false then return NeedNumber_( )
            bd.height = n
        case "id"
            if IsName_( value ) = false then return value & ": not a name"
            dim as int32 o = tkReportDef_FindBand( def, value )
            if (o >= 0) andalso (o <> bi) then return value & ": a band has that id"
            ' what names the band follows it
            dim as ustring was = lcase( bd.id )
            for k as int32 = 0 to def->nItems - 1
                if lcase( def->items(k).band ) = was then def->items(k).band = value
            next
            for k as int32 = 0 to def->nBands - 1
                if lcase( def->bands(k).parent ) = was then def->bands(k).parent = value
            next
            bd.id = value
        case "source" : bd.source = value
        case "group" : bd.group_ = value
        case "can_grow" : bd.canGrow = b
        case "page_break_before" : bd.breakBefore = b
        case "page_break_after" : bd.breakAfter = b
        case "repeat" : bd.repeat_ = b
        case "print_on_first_page" : bd.printOnFirstPage = b
        case "print_at_bottom" : bd.printAtBottom = b
        case "visible" : bd.visible = value
        case "back" : bd.back = value
        case else : return "?"
        end select
        return ""
    end if
    select case key_
    case "margin_left", "margin_top", "margin_right", "margin_bottom"
        if isNum = false then return NeedNumber_( )
        select case key_
        case "margin_left" : def->mL = n
        case "margin_top" : def->mT = n
        case "margin_right" : def->mR = n
        case "margin_bottom" : def->mB = n
        end select
    case "title" : def->title = value
    case "paper" : def->paper = value
    case "landscape" : def->landscape = b
    case "units" : def->units = value
    case "data_module" : def->dataModule = value
    case "bool_text" : def->boolText = value
    case else : return "?"
    end select
    return ""
end function

private sub F_( byref out_ as Array( of RField ), byval kind_ as int32, byval level as int32, byref label as const ustring, _
                byref source as const ustring = "", byref name_ as const ustring = "" )
    dim as RField f
    f.Kind = kind_
    f.Level = level
    f.Label = label
    f.Source = source
    f.Name = name_
    out_.Push( f )
end sub

private sub AddSource_( byval def as TK_REPORTDEF ptr, byval si as int32, byval level as int32, byref out_ as Array( of RField ) )
    dim byref as TKRD_SOURCE s = def->sources(si)
    F_( out_, 0, level, s.name_, s.name_ )
    for k as int32 = 0 to s.nFields - 1
        F_( out_, 1, level + 1, s.fields(k).name_, s.name_, s.fields(k).name_ )
    next
    for k as int32 = 0 to def->nCalcs - 1
        if lcase( def->calcs(k).source ) = lcase( s.name_ ) then F_( out_, 1, level + 1, def->calcs(k).name_, s.name_, def->calcs(k).name_ )
    next
    for k as int32 = 0 to def->nSources - 1
        if lcase( def->sources(k).parent ) = lcase( s.name_ ) then AddSource_( def, k, level + 1, out_ )
    next
end sub

' The field list: each top-level source, its fields (the [[source.field]] snapshot) and calculated
' fields, its child sources beneath it; then the parameters and the built-in values. The headings'
' labels are the panel's (translated); a source's is its name.
public sub FieldList( byval def as TK_REPORTDEF ptr, byref out_ as Array( of RField ) )
    out_.Clear( )
    if def = 0 then exit sub
    for i as int32 = 0 to def->nSources - 1
        if len( def->sources(i).parent ) = 0 then AddSource_( def, i, 0, out_ )
    next
    if def->nParams then
        F_( out_, 2, 0, "" )
        for i as int32 = 0 to def->nParams - 1
            F_( out_, 3, 1, def->params(i).name_, "", def->params(i).name_ )
        next
    end if
    F_( out_, 4, 0, "" )
    F_( out_, 5, 1, "PageNumber", "", "PageNumber" )
    F_( out_, 5, 1, "PageCount", "", "PageCount" )
    F_( out_, 5, 1, "RowNumber", "", "RowNumber" )
    F_( out_, 5, 1, "GroupRowNumber", "", "GroupRowNumber" )
    F_( out_, 5, 1, "PrintDate", "", "PrintDate" )
end sub

' ---- the expression editor's side (RD7) -----------------------------------------------------------
' What an expression in band bandId can name: every source's fields as "Source.Field" (and plain
' [Field] for the band's own source), the calculated fields (their kind found by compiling them),
' the parameters. noAggregates: a group key or a filter, where totals mean nothing.
public sub SchemaFor( byval def as TK_REPORTDEF ptr, byref bandId as const ustring, byval noAggregates as boolean, byref sch as TKREXPR_SCHEMA )
    sch.Clear( )
    if def = 0 then exit sub
    for i as int32 = 0 to def->nSources - 1
        for k as int32 = 0 to def->sources(i).nFields - 1
            sch.AddField( def->sources(i).name_ & "." & def->sources(i).fields(k).name_, def->sources(i).fields(k).kind )
        next
    next
    for i as int32 = 0 to def->nParams - 1
        sch.AddParam( def->params(i).name_, def->params(i).kind )
    next
    for i as int32 = 0 to def->nCalcs - 1
        dim as TKREXPR_ERROR e
        sch.defaultSource = def->calcs(i).source
        sch.noAggregates = true
        dim as TK_REXPR ptr x = tkRExpr_Compile( def->calcs(i).expr, sch, e )
        dim as int32 k = TKV_TEXT
        if x then
            k = tkRExpr_Kind( x )
            tkRExpr_Destroy( x )
        end if
        sch.AddField( def->calcs(i).source & "." & def->calcs(i).name_, k )
    next
    sch.defaultSource = redits.SourceOfBand( def, bandId )
    sch.noAggregates = noAggregates
end sub

' The expression text checked where it is used: "" and its kind's name ("float", "text" ...), or
' the first error, with col its 1-based column (0 = none).
public function CheckExpr( byval def as TK_REPORTDEF ptr, byref bandId as const ustring, byval noAggregates as boolean, _
                           byref text as const ustring, byref kindName as ustring, byref col as int32 ) as ustring
    kindName = ""
    col = 0
    dim as TKREXPR_SCHEMA sch
    SchemaFor( def, bandId, noAggregates, sch )
    dim as TKREXPR_ERROR e
    dim as TK_REXPR ptr x = tkRExpr_Compile( text, sch, e )
    if x = 0 then
        col = e.col
        return e.msg
    end if
    kindName = tkReportDef_KindName( tkRExpr_Kind( x ) )
    tkRExpr_Destroy( x )
    return ""
end function

' What the expression editor offers to insert: the fields ([Field] in the band's own source, else
' [Source.Field]), the parameters (@Name), the report values, the functions (Name( )).
public sub Insertables( byval def as TK_REPORTDEF ptr, byref bandId as const ustring, byref out_ as Array( of ustring ) )
    out_.Clear( )
    if def = 0 then exit sub
    for i as int32 = 0 to def->nSources - 1
        for k as int32 = 0 to def->sources(i).nFields - 1
            out_.Push( redits.FieldExpr( def, bandId, def->sources(i).name_, def->sources(i).fields(k).name_ ) )
        next
    next
    for i as int32 = 0 to def->nCalcs - 1
        out_.Push( redits.FieldExpr( def, bandId, def->calcs(i).source, def->calcs(i).name_ ) )
    next
    for i as int32 = 0 to def->nParams - 1
        out_.Push( "@" & def->params(i).name_ )
    next
    dim as ustring fixed = "PageNumber PageCount RowNumber GroupRowNumber PrintDate ReportTitle " & _
        "Sum( ) Count( ) Avg( ) Min( ) Max( ) First( ) Last( ) GroupCount( ) I" & "If( ) IsEmpty( ) Between( ) " & _   ' split: the idiom gate reads a quoted iif( as code
        "Format( ) Len( ) Left( ) Right( ) Mid( ) UCase( ) LCase( ) Trim( ) InStr( ) Replace( ) Str( ) Val( ) " & _
        "PadLeft( ) PadRight( ) Abs( ) Int( ) Round( ) Choose( ) Year( ) Month( ) Day( ) DateAdd( ) DateDiff( ) " & _
        "DateSerial( ) MonthName( ) CInt( ) CFloat( ) CBool( ) CDate( )"
    dim as long a = 1
    while a <= len( fixed )
        dim as long b = instr( a, fixed, " " )
        if b = 0 then b = len( fixed ) + 1
        dim as ustring w = mid( fixed, a, b - a )
        ' "Sum(" and ")" were split by the space inside "( )"
        if w = ")" then
            out_[out_.Count( ) - 1] = out_[out_.Count( ) - 1] & " )"
        elseif len( w ) then
            out_.Push( w )
        end if
        a = b + 1
    wend
end sub

' The inspector's rows the expression editor opens on ("..."), and whether totals are refused there.
public function IsExprKey( byref target as const ustring, byref key_ as const ustring, byref noAggregates as boolean ) as boolean
    noAggregates = false
    if left( target, 5 ) = "item:" then
        select case key_
        case "expr", "visible" : return true
        end select
    elseif left( target, 5 ) = "band:" then
        select case key_
        case "group"
            noAggregates = true
            return true
        case "visible" : return true
        end select
    end if
    return false
end function
