' A Panel's Paint: drawn over its background and border, under its children.
sub PanelSuite( )
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "caption = ""P""" & LF & "width = 300" & LF & "height = 200" & LF _
        & Ctl( "pnl", "Panel" ) & LF & "[control.events]" & LF & "Paint = ""pnl_Paint""" & LF _
        & Ctl( "lbl", "Label", "parent = ""pnl""" & LF & "x = 4" & LF & "y = 4" & LF & "w = 40" & LF & "h = 20" & LF )
    dim as FormDoc d
    Check( ReadForm( src, d ), "panel: the form parses" )
    Accepted( src, "panel: Paint" )
    dim as ustring g = codegen.Generate( d, "frmP", "frmP.tkform", src )
    HasLine( g, "declare sub pnl_Paint( byval p as TKPANEL_PAINTINFO ptr )", "panel: Paint declared" )
    Check( instr( g, "tkForms_ObjectOf( p->hPanel )" ) > 0, "panel: Paint finds its form through the paint info" )
    HasLine( g, "tkPanel_SetPaintCallback( pnl.Handle, @Thunk_pnl_Paint )", "panel: Paint installed" )
end sub

' A TabControl's Closable, SelectedIndex and Font, and its Close event.
sub TabControlSuite( )
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "caption = ""T""" & LF & "width = 300" & LF & "height = 200" & LF _
        & Ctl( "tc", "TabControl", "pages = [""A"", ""B""]" & LF ) & "[control.props]" & LF & "Closable = true" & LF & "SelectedIndex = 1" & LF _
        & LF & "[control.events]" & LF & "Close = ""tc_Close""" & LF
    dim as FormDoc d
    Check( ReadForm( src, d ), "tabcontrol: the form parses" )
    Accepted( src, "tabcontrol: Closable, SelectedIndex and Close" )
    dim as ustring g = codegen.Generate( d, "frmT", "frmT.tkform", src )
    HasLine( g, "tc.Closable = true", "tabcontrol: Closable set" )
    Check( instr( g, "tc.SelectedIndex = 1" ) > instr( g, "tkTabControl_AddPage( tc.Handle, ""B"" )" ), "tabcontrol: SelectedIndex after its pages", g )
    HasLine( g, "declare sub tc_Close( byval idx as int32 )", "tabcontrol: Close declared" )
    HasLine( g, "tkTabControl_SetCloseCallback( tc.Handle, @Thunk_tc_Close )", "tabcontrol: Close installed" )
    dim as TKMETA_CONTROL ptr m = tkMeta_Find( "TabControl" )
    Check( tkMeta_FindProp( m, "Font" ) <> 0, "tabcontrol: a Font property" )
    HasLine( g, "tc.GlyphFont = tkForm_Font( Handle, TKFONT_GLYPH )", "tabcontrol: its glyphs in the GLYPH role" )

    ' a glyph per page: read, written back the same, and set after its page
    dim as ustring src2 = Header( ) & Ctl( "tg", "TabControl", "pages = [""A"", ""B""]" & LF & "page_glyphs = ["""", ""Fluent:E824""]" & LF )
    dim as FormDoc d2
    Check( ReadForm( src2, d2 ) andalso (PageGlyph( d2.Controls[0], 0 ) = "") andalso (PageGlyph( d2.Controls[0], 1 ) = "Fluent:E824"), "tabcontrol: page glyphs read" )
    Check( instr( formfile.Render( d2 ), "page_glyphs = ["""", ""Fluent:E824""]" ) > 0, "tabcontrol: page glyphs written", formfile.Render( d2 ) )
    g = codegen.Generate( d2, "frmT", "frmT.tkform", src2 )
    Check( (instr( g, "tkTabControl_SetPageGlyph( tg.Handle, 1, wchr( &hE824 ) )" ) > instr( g, "tkTabControl_AddPage( tg.Handle, ""B"" )" )) _
           andalso (instr( g, "tkTabControl_SetPageGlyph( tg.Handle, 0" ) = 0), "tabcontrol: a page's glyph set after it, none for a page without", g )
end sub

' A Splitter's two new events: Paint and Message.
sub SplitterSuite( )
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "caption = ""S""" & LF & "width = 300" & LF & "height = 200" & LF _
        & Ctl( "spl", "Splitter" ) & LF & "[control.events]" & LF & "Paint = ""spl_Paint""" & LF & "Message = ""spl_Message""" & LF
    dim as FormDoc d
    Check( ReadForm( src, d ), "splitter: the form parses" )
    Accepted( src, "splitter: Paint and Message" )
    dim as ustring g = codegen.Generate( d, "frmS", "frmS.tkform", src )
    Check( instr( g, "tkForms_ObjectOf( p->hSplitter )" ) > 0, "splitter: Paint finds its form through the paint info" )
    HasLine( g, "tkSplitter_SetPaintCallback( spl.Handle, @Thunk_spl_Paint )", "splitter: Paint installed" )
    HasLine( g, "declare sub spl_Message( byval m as TKSPLITTER_MESSAGEINFO ptr, byref Handled as boolean )", "splitter: Message declared" )
    Check( instr( g, "tkForms_ObjectOf( m->hSplitter )" ) > 0, "splitter: Message finds its form through the message info" )
end sub

' A ScrollPanel's three new events: Paint, Message and Layout (which answers the content height).
sub ScrollPanelSuite( )
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "caption = ""S""" & LF & "width = 300" & LF & "height = 200" & LF _
        & Ctl( "scp", "ScrollPanel" ) & LF & "[control.events]" & LF & "Paint = ""scp_Paint""" & LF & "Message = ""scp_Message""" & LF & "Layout = ""scp_Layout""" & LF
    dim as FormDoc d
    Check( ReadForm( src, d ), "scrollpanel: the form parses" )
    Accepted( src, "scrollpanel: Paint, Message and Layout" )
    dim as ustring g = codegen.Generate( d, "frmS", "frmS.tkform", src )
    Check( instr( g, "tkForms_ObjectOf( p->hScrollPanel )" ) > 0, "scrollpanel: Paint finds its form through the paint info" )
    HasLine( g, "tkScrollPanel_SetPaintCallback( scp.Handle, @Thunk_scp_Paint )", "scrollpanel: Paint installed" )
    Check( instr( g, "tkForms_ObjectOf( m->hScrollPanel )" ) > 0, "scrollpanel: Message finds its form through the message info" )
    HasLine( g, "declare sub scp_Layout( byval cxPanel as int32, byref ContentHeight as int32 )", "scrollpanel: Layout declared" )
    Check( instr( g, "private function Thunk_scp_Layout( byval hPanel as TK_WIDGET ptr, byval cxPanel as int32 ) as int32" ) > 0, "scrollpanel: Layout answers the height", g )
    HasLine( g, "tkScrollPanel_SetLayoutCallback( scp.Handle, @Thunk_scp_Layout )", "scrollpanel: Layout installed" )
    ' SCP_PAINTINFO is the ScrollPanel's own type, though not spelled TK*: a handler file imports it
    dim as Array( of ustring ) im = reconcile.ImportsFor( "byval p as SCP_PAINTINFO ptr", "tkScrollPanel" )
    Check( (im.Count( ) = 1) andalso (im[0] = "tkScrollPanel"), "scrollpanel: a Paint handler's file imports tkScrollPanel" )
end sub

' A VScrollBar's and an HScrollBar's Paint: the paint info names the bar, so the form is found.
sub ScrollBarSuite( )
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "caption = ""S""" & LF & "width = 300" & LF & "height = 200" & LF _
        & Ctl( "vsb", "VScrollBar" ) & LF & "[control.events]" & LF & "Paint = ""vsb_Paint""" & LF _
        & Ctl( "hsb", "HScrollBar" ) & LF & "[control.events]" & LF & "Paint = ""hsb_Paint""" & LF
    dim as FormDoc d
    Check( ReadForm( src, d ), "scrollbars: the form parses" )
    Accepted( src, "scrollbars: Paint" )
    dim as ustring g = codegen.Generate( d, "frmS", "frmS.tkform", src )
    HasLine( g, "declare sub vsb_Paint( byval p as TKVSCROLLBAR_PAINTINFO ptr )", "vscrollbar: Paint declared" )
    HasLine( g, "tkVScrollBar_SetPaintCallback( vsb.Handle, @Thunk_vsb_Paint )", "vscrollbar: Paint installed" )
    HasLine( g, "tkHScrollBar_SetPaintCallback( hsb.Handle, @Thunk_hsb_Paint )", "hscrollbar: Paint installed" )
    Check( instr( g, "tkForms_ObjectOf( p->hScrollBar )" ) > 0, "scrollbars: Paint finds its form through the paint info" )
end sub

' A ColorPicker's ShowAlpha and ActiveTab, its Message, and its Paint: the vendor's callback takes an
' any ptr, which the thunk hands on typed.
sub ColorPickerSuite( )
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "caption = ""C""" & LF & "width = 300" & LF & "height = 200" & LF _
        & Ctl( "clr", "ColorPicker" ) & LF & "[control.props]" & LF & "ShowAlpha = false" & LF & "ActiveTab = ""Web""" & LF _
        & LF & "[control.events]" & LF & "Paint = ""clr_Paint""" & LF & "Message = ""clr_Message""" & LF
    dim as FormDoc d
    Check( ReadForm( src, d ), "colorpicker: the form parses" )
    Accepted( src, "colorpicker: ShowAlpha, ActiveTab, Paint and Message" )
    dim as ustring g = codegen.Generate( d, "frmC", "frmC.tkform", src )
    HasLine( g, "clr.ShowAlpha = false", "colorpicker: ShowAlpha set" )
    HasLine( g, "clr.ActiveTab = CLR_TAB_WEB", "colorpicker: ActiveTab set" )
    HasLine( g, "declare sub clr_Paint( byval p as TKCOLORPICKER_PAINTINFO ptr )", "colorpicker: Paint declared typed" )
    Check( instr( g, "private sub Thunk_clr_Paint( byval p as any ptr )" ) > 0, "colorpicker: the thunk takes the vendor's any ptr", g )
    Check( instr( g, "tkForms_ObjectOf( cast( TKCOLORPICKER_PAINTINFO ptr, p )->hColorPicker )" ) > 0, "colorpicker: Paint finds its form through the paint info" )
    Check( instr( g, "f->clr_Paint( cast( TKCOLORPICKER_PAINTINFO ptr, p ) )" ) > 0, "colorpicker: and hands it on typed" )
    Check( instr( g, "tkForms_ObjectOf( m->hColorPicker )" ) > 0, "colorpicker: Message finds its form through the message info" )
end sub

' A ProgressBar's four events (it had none), and TextMode's Callback, which the Text event serves.
sub ProgressBarSuite( )
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "caption = ""P""" & LF & "width = 300" & LF & "height = 200" & LF _
        & Ctl( "prg", "ProgressBar" ) & LF & "[control.props]" & LF & "TextMode = ""Callback""" & LF _
        & LF & "[control.events]" & LF & "Paint = ""prg_Paint""" & LF & "Message = ""prg_Message""" & LF & "Tooltip = ""prg_Tip""" & LF & "Text = ""prg_Text""" & LF
    dim as FormDoc d
    Check( ReadForm( src, d ), "progressbar: the form parses" )
    Accepted( src, "progressbar: TextMode Callback and four events" )
    dim as ustring g = codegen.Generate( d, "frmP", "frmP.tkform", src )
    HasLine( g, "prg.TextMode = PRG_TEXT_CALLBACK", "progressbar: TextMode Callback" )
    Check( instr( g, "tkForms_ObjectOf( p->hProgressBar )" ) > 0, "progressbar: Paint finds its form through the paint info" )
    Check( instr( g, "tkForms_ObjectOf( m->hProgressBar )" ) > 0, "progressbar: Message finds its form through the message info" )
    HasLine( g, "declare sub prg_Tip( byref Text as ustring )", "progressbar: Tooltip declared" )
    HasLine( g, "declare sub prg_Text( byval nPos as int32, byval nMin as int32, byval nMax as int32, byref Text as ustring )", "progressbar: Text declared" )
    HasLine( g, "tkProgressBar_SetTextCallback( prg.Handle, @Thunk_prg_Text )", "progressbar: Text installed" )
    HasLine( g, "tkProgressBar_SetPaintCallback( prg.Handle, @Thunk_prg_Paint )", "progressbar: Paint installed" )
end sub

' A Chart's four new events: Paint, Message, Tooltip and ValueLabel.
sub ChartSuite( )
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "caption = ""C""" & LF & "width = 300" & LF & "height = 200" & LF _
        & Ctl( "cht", "Chart" ) & LF & "[control.events]" & LF & "Paint = ""cht_Paint""" & LF & "Message = ""cht_Message""" & LF _
        & "Tooltip = ""cht_Tip""" & LF & "ValueLabel = ""cht_Value""" & LF
    dim as FormDoc d
    Check( ReadForm( src, d ), "chart: the form parses" )
    Accepted( src, "chart: Paint, Message, Tooltip and ValueLabel" )
    dim as ustring g = codegen.Generate( d, "frmC", "frmC.tkform", src )
    Check( instr( g, "tkForms_ObjectOf( p->hChart )" ) > 0, "chart: Paint finds its form through the paint info" )
    Check( instr( g, "tkForms_ObjectOf( m->hChart )" ) > 0, "chart: Message finds its form through the message info" )
    HasLine( g, "declare sub cht_Tip( byref Text as ustring )", "chart: Tooltip declared" )
    HasLine( g, "declare sub cht_Value( byval fValue as float64, byval nContext as int32, byref Text as ustring )", "chart: ValueLabel declared" )
    HasLine( g, "tkChart_SetValueLabelCallback( cht.Handle, @Thunk_cht_ValueLabel )", "chart: ValueLabel installed" )
end sub

' A Timer, the first component: created on the form, never laid out, Interval and Tick; placed at its
' own size on the form whatever it's dropped on; no parent, dock or anchors.
' The program's icon: app_icon in the .tkres, the tiko.toml line, the .ico made from an image.
sub AppIconSuite( )
    dim as resfile.ResourceDoc rd
    dim as ustring e, none
    dim as ustring src = "format = 1" & LF & "app_icon = ""logo""" & LF & LF & "[[resource]]" & LF & "name = ""logo""" & LF _
        & "kind = ""image""" & LF & "file = ""logo.png""" & LF
    Check( resfile.Parse( src, rd, e ) andalso (rd.AppIcon = "logo") andalso (resfile.ToText( rd ) = src), "appicon: app_icon read and written back", resfile.ToText( rd ) )
    rd.AppIcon = "nope"
    dim as Array( of ustring ) pr
    resfile.Check( rd, "", pr )
    dim as ustring pr0
    if pr.Count( ) then pr0 = pr[0]
    Check( (pr.Count( ) = 1) andalso (instr( pr0, "app_icon 'nope'" ) > 0), "appicon: one naming no resource is reported", pr0 )

    ' tiko.toml: a table made, an entry added to a list, taken out again, the rest kept
    dim as boolean ch
    dim as ustring rc = "appResources/app.rc"
    dim as ustring t0 = "[package]" & LF & "name = 'a'" & LF & LF & "[target.a]" & LF & "main = 'main.tiko'" & LF
    dim as ustring t1 = appicon.TomlWithResource( t0, "a", rc, true, ch )
    Check( ch andalso (t1 = t0 & LF & "[target.a.windows]" & LF & "resources = [""" & rc & """]" & LF), "appicon: a .windows table made", t1 )
    dim as ustring t2 = appicon.TomlWithResource( t1, "a", rc, true, ch )
    Check( (ch = false) andalso (t2 = t1), "appicon: there already, nothing changes" )
    Check( appicon.TomlWithResource( t1, "a", rc, false, ch ) = t0 & LF & "[target.a.windows]" & LF, "appicon: off, the last entry takes its line" )
    dim as ustring t3 = "[target.a.windows]" & LF & "resources = [""res/x.rc""]  # mine" & LF & "[profile.debug]" & LF
    dim as ustring t4 = appicon.TomlWithResource( t3, "a", rc, true, ch )
    Check( t4 = "[target.a.windows]" & LF & "resources = [""res/x.rc"", """ & rc & """]  # mine" & LF & "[profile.debug]" & LF, "appicon: added to a list, the rest kept", t4 )
    Check( appicon.TomlWithResource( t4, "a", rc, false, ch ) = t3, "appicon: and taken out of it" )

    ' an .ico from a 40x20 PNG: six images, 16..64 as DIBs, 256 as a PNG
    dim as ustring dir_ = fs.PathJoin( fs.TempDir( ).ValueOr( none ), "designall-appicon" )
    fs.CreateDirAll( dir_ )
    dim as ustring png = fs.PathJoin( dir_, "logo.png" ), ico = fs.PathJoin( dir_, "app.ico" )
    dim as SDL_Surface ptr s = SDL_CreateSurface( 40, 20, SDL_PIXELFORMAT_ARGB8888 )
    SDL_FillSurfaceRect( s, 0, &hFFCC2200 )
    dim as string png8 = png
    IMG_SavePNG( s, strptr( png8 ) )
    SDL_DestroySurface( s )
    dim as ustring fault = appicon.MakeIco( png, ico )
    Check( len( fault ) = 0, "appicon: MakeIco writes the .ico", fault )
    dim as Array( of ubyte ) b
    fs.ReadAllBytes( ico, b )
    dim as boolean ok = (b.Count( ) > 6 + 16 * 6) andalso (b[2] = 1) andalso (b[4] = 6)
    if ok then
        ' the entries' sizes (256 is written 0), and the last image starts with PNG's signature
        dim as long want( 0 to 5 ) = { 16, 24, 32, 48, 64, 0 }
        for k as long = 0 to 5
            if b[6 + 16 * k] <> want( k ) then ok = false
        next
        dim as long off = b[6 + 16 * 5 + 12] or (b[6 + 16 * 5 + 13] shl 8) or (b[6 + 16 * 5 + 14] shl 16)
        if (off + 4 > b.Count( )) orelse (b[off + 1] <> 80) orelse (b[off + 2] <> 78) orelse (b[off + 3] <> 71) then ok = false
        ' the 16 px DIB: header 40, 16 wide, 32 tall (with its mask), 32 bits
        dim as long d0 = b[6 + 12] or (b[6 + 13] shl 8)
        if (b[d0] <> 40) orelse (b[d0 + 4] <> 16) orelse (b[d0 + 8] <> 32) orelse (b[d0 + 14] <> 32) then ok = false
    end if
    Check( ok, "appicon: six images, 16..64 px DIBs and a 256 px PNG", str( b.Count( ) ) )
    fs.RemoveFile( png )
    fs.RemoveFile( ico )
end sub

sub TimerSuite( )
    Check( catalog.IsComponent( "Timer" ) andalso (catalog.IsComponent( "Button" ) = false) andalso (catalog.IsComponent( catalog.CUSTOM_TYPE ) = false), "timer: a component, a button isn't" )
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "caption = ""T""" & LF & "width = 300" & LF & "height = 200" & LF _
        & Ctl( "tmr", "Timer", "parent = """"" & LF & "x = 8" & LF & "y = 8" & LF & "w = 72" & LF & "h = 24" & LF ) _
        & "[control.props]" & LF & "Interval = 250" & LF & "Enabled = false" & LF _
        & LF & "[control.events]" & LF & "Tick = ""tmr_Tick""" & LF
    dim as FormDoc d
    Check( ReadForm( src, d ), "timer: the form parses" )
    Accepted( src, "timer: Interval, Enabled and Tick" )
    dim as ustring g = codegen.Generate( d, "frmT", "frmT.tkform", src )
    HasLine( g, "tmr.Create( tkForm_Widget( Handle ), 1 )", "timer: created on the form" )
    Check( instr( g, "tkLayout_Add( Layout, tmr.Handle" ) = 0, "timer: never laid out", g )
    HasLine( g, "tmr.Interval = 250", "timer: Interval set" )
    HasLine( g, "tmr.Enabled = false", "timer: Enabled set" )
    HasLine( g, "declare sub tmr_Tick( )", "timer: Tick declared" )
    HasLine( g, "tkTimer_SetTickCallback( tmr.Handle, @Thunk_tmr_Tick )", "timer: Tick installed" )
    Check( instr( g, "#import ""vendor/tkControls/tkTimer""" ) > 0, "timer: its module imported" )

    ' wherever it's dropped: on the form, at its own size; resizing, docking and anchoring leave it be
    dim as FormDoc e
    e.ClientW = 300
    e.ClientH = 200
    edits.AddControl( e, "Panel", "", -1, 0, 0, 100, 100 )
    dim as long it_ = edits.AddControl( e, "Timer", "Panel1", -1, 10, 10, 300, 300 )
    Check( (it_ >= 0) andalso (len( e.Controls[it_].Parent ) = 0) andalso (e.Controls[it_].W = 72) andalso (e.Controls[it_].H = 24), "timer: dropped in a panel, it lands on the form at its own size" )
    edits.ResizeControl( e, it_, 20, 30, 200, 200 )
    Check( (e.Controls[it_].X = 20) andalso (e.Controls[it_].Y = 30) andalso (e.Controls[it_].W = 72), "timer: it moves, it doesn't resize" )
    edits.SetDock( e, Names( "Timer1" ), TK_DOCK_TOP )
    Check( e.Controls[it_].Dock = TK_DOCK_NONE, "timer: no dock" )
    edits.SetAnchorBit( e, Names( "Timer1" ), TK_ANCHOR_RIGHT, true )
    Check( e.Controls[it_].Anchor = TK_ANCHOR_DEFAULT, "timer: no anchors" )

    ' refused: inside a container, docked, anchored
    dim as ustring pnl = Ctl( "pnl", "Panel", "parent = """"" & LF & "x = 0" & LF & "y = 0" & LF & "w = 100" & LF & "h = 100" & LF )
    Refused( Header( ) & pnl & Ctl( "t2", "Timer", "parent = ""pnl""" & LF ), "belongs to the form" )
    Refused( Header( ) & Ctl( "t3", "Timer", "dock = ""top""" & LF ), "can't be docked" )
    Refused( Header( ) & Ctl( "t4", "Timer", "anchor = ""left right""" & LF ), "has no anchors" )
end sub

' A PopupMenu, the second component: its items as a right-click menu (level 0 the menu that opens),
' Command dispatching them, and the ContextMenu property of a control and of the form.
sub PopupSuite( )
    Check( catalog.ItemsKindOf( "PopupMenu" ) = catalog.ItemsKind.ItemsPopup, "popup: its items are a popup menu's" )
    Check( catalog.IsMenuKind( catalog.ItemsKind.ItemsPopup ) andalso catalog.IsMenuKind( catalog.ItemsKind.ItemsMenu ) andalso (catalog.IsMenuKind( catalog.ItemsKind.ItemsToolbar ) = false), "popup: a menu kind, as a menu bar's" )
    Check( catalog.IsComponent( "PopupMenu" ), "popup: a component" )
    dim as ustring item = LF & "[[control.items]]" & LF
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "caption = ""P""" & LF & "width = 300" & LF & "height = 200" & LF & "context_menu = ""pm""" & LF _
        & Ctl( "pm", "PopupMenu", "parent = """"" & LF & "x = 8" & LF & "y = 8" & LF & "w = 72" & LF & "h = 24" & LF ) _
        & "[control.events]" & LF & "Popup = ""pm_Popup""" & LF _
        & item & "text = ""Cut""" & LF & "key = ""Primary+X""" & LF & "handler = ""pm_Cut""" & LF _
        & item & "text = ""-""" & LF _
        & item & "text = ""More""" & LF _
        & item & "text = ""Deep""" & LF & "level = 1" & LF & "handler = ""pm_Deep""" & LF _
        & Ctl( "btn", "Button", "parent = """"" & LF & "x = 8" & LF & "y = 40" & LF & "w = 80" & LF & "h = 28" & LF & "context_menu = ""pm""" & LF )
    dim as FormDoc d
    Check( ReadForm( src, d ), "popup: the form parses" )
    Check( (d.ContextMenu = "pm") andalso (d.Controls[1].ContextMenu = "pm"), "popup: context_menu read, the form's and a control's" )
    Accepted( src, "popup: items, Popup, ContextMenu" )
    dim as ustring t = formfile.Render( d )
    Check( (instr( t, "context_menu = ""pm""" ) > 0) andalso (instr( instr( t, "context_menu = ""pm""" ) + 1, t, "context_menu = ""pm""" ) > 0), "popup: context_menu written back, both", t )

    dim as ustring g = codegen.Generate( d, "frmP", "frmP.tkform", src )
    Check( instr( g, "menus( 0 ) = tkContextMenu_GetMenu( pm.Handle )" ) > 0, "popup: built into its own menu", g )
    Check( instr( g, "tkPopupMenu_AddItem( menus( 0 ), 1000, ""Cut"", KeyLabel( ""Primary+X"" ) )" ) > 0, "popup: an item with its shortcut" )
    Check( instr( g, "tkPopupMenu_AddSeparator( menus( 0 ) )" ) > 0, "popup: a separator on the menu itself" )
    Check( instr( g, "tkPopupMenu_SetItemSubMenu( menus( 0 ), 1002, menus( 1 ) )" ) > 0, "popup: a submenu" )
    Check( instr( g, "tkPopupMenu_AddItem( menus( 1 ), 1003, ""Deep"" )" ) > 0, "popup: an item in it" )
    HasLine( g, "case 1003 : f->pm_Deep( )", "popup: an item's handler dispatched" )
    HasLine( g, "tkContextMenu_SetCommandCallback( pm.Handle, @Thunk_pm_Command )", "popup: through Command" )
    HasLine( g, "declare sub pm_Popup( byval hSource as TK_WIDGET ptr )", "popup: Popup declared" )
    HasLine( g, "tkKeys_BindText( keys, ""Primary+X"", 1000 )", "popup: its shortcut bound" )
    Check( instr( g, "#import ""vendor/tkControls/tkPopupMenu""" ) > 0, "popup: the menu module imported" )
    HasLine( g, "tkContextMenu_Attach( pm.Handle, btn.Handle )", "popup: attached to the button" )
    HasLine( g, "tkContextMenu_Attach( pm.Handle, tkForm_Widget( Handle ) )", "popup: and to the form" )
    Check( instr( g, "tkContextMenu_Attach( pm.Handle, btn.Handle )" ) > instr( g, "btn.Create(" ), "popup: attached once the button exists" )

    ' rename follows the references; deleting the menu clears them
    edits.RenameControl( d, "pm", "mnuCtx" )
    Check( (d.ContextMenu = "mnuCtx") andalso (d.Controls[1].ContextMenu = "mnuCtx"), "popup: a rename follows the ContextMenus" )
    edits.DeleteControls( d, Names( "mnuCtx" ) )
    Check( (len( d.ContextMenu ) = 0) andalso (len( d.Controls[0].ContextMenu ) = 0), "popup: deleting it clears them" )

    ' refused
    dim as ustring pm2 = Ctl( "pm", "PopupMenu" )
    Refused( Header( ) & pm2 & item & "text = ""x""" & LF & "level = 1" & LF, "first item must be on the menu itself" )
    Refused( Header( ) & Ctl( "b", "Button", "context_menu = ""nope""" & LF ), "context menu 'nope' doesn't exist" )
    Refused( Header( ) & Ctl( "b", "Button" ) & Ctl( "c", "Button", "context_menu = ""b""" & LF ), "isn't a PopupMenu" )
    Refused( Header( ) & pm2 & Ctl( "tm", "Timer", "context_menu = ""pm""" & LF ), "has no context menu" )
end sub

' A Spinner: its style is a create argument; Running is set like any property (never on the canvas).
sub SpinnerSuite( )
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "caption = ""S""" & LF & "width = 300" & LF & "height = 200" & LF _
        & Ctl( "spn", "Spinner", "parent = """"" & LF & "x = 8" & LF & "y = 8" & LF & "w = 32" & LF & "h = 32" & LF ) _
        & "[control.props]" & LF & "Style = ""Dots""" & LF & "Running = true" & LF & "Period = 800" & LF _
        & LF & "[control.events]" & LF & "Paint = ""spn_Paint""" & LF
    dim as FormDoc d
    Check( ReadForm( src, d ), "spinner: the form parses" )
    Accepted( src, "spinner: Style, Running, Period, Paint" )
    dim as ustring g = codegen.Generate( d, "frmS", "frmS.tkform", src )
    HasLine( g, "spn.Create( tkForm_Widget( Handle ), 1, SPN_STYLE_DOTS )", "spinner: created with its style" )
    HasLine( g, "spn.Running = true", "spinner: started" )
    HasLine( g, "spn.Period = 800", "spinner: its period" )
    Check( instr( g, "tkForms_ObjectOf( p->hSpinner )" ) > 0, "spinner: Paint finds its form through the paint info" )
    Refused( Header( ) & Ctl( "s2", "Spinner" ) & "[control.props]" & LF & "Style = ""Wobble""" & LF, "Style" )
    dim as TKMETA_CONTROL ptr m = tkMeta_Find( "Spinner" )
    Check( (m <> 0) andalso (tkMeta_FindProp( m, "Running" ) <> 0) andalso (tkMeta_FindProp( m, "Running" )->bDesign = false), "spinner: Running never runs on the canvas" )
end sub

' An option button placed takes the GroupID of the last one on the same parent.
sub OptionGroupSuite( )
    dim as FormDoc e
    e.ClientW = 300
    e.ClientH = 200
    edits.AddControl( e, "OptionButton", "", -1, 8, 8, 100, 24 )
    edits.SetProperty( e, Names( "OptionButton1" ), "GroupID", "2" )
    dim as long i2 = edits.AddControl( e, "OptionButton", "", -1, 8, 40, 100, 24 )
    Check( SettingOr( e.Controls[i2].Props, "GroupID" ) = "2", "option group: the next one placed joins the last one's group" )
    edits.AddControl( e, "Panel", "", -1, 150, 8, 100, 100 )
    dim as long i3 = edits.AddControl( e, "OptionButton", "Panel1", -1, 8, 8, 80, 24 )
    Check( FindSetting( e.Controls[i3].Props, "GroupID" ) < 0, "option group: not across parents" )
end sub

' The Resource Center's file (appResources.tkres): text, refusals, AddFile, the generated module,
' references renamed, main made to register them.
sub ResourceSuite( )
    dim as ustring e, none
    dim as resfile.ResourceDoc d
    dim as ustring t = "format = 1" & LF & LF & "[[resource]]" & LF & "name = ""logo""" & LF & "kind = ""image""" & LF & "file = ""logo.png""" & LF _
        & LF & "[[resource]]" & LF & "name = ""Body""" & LF & "kind = ""font""" & LF & "file = ""Body.ttf""" & LF & "embed = false" & LF
    Check( resfile.Parse( t, d, e ) andalso (d.Items.Count( ) = 2), "resources: parsed", e )
    Check( d.Items[0].Embed andalso (d.Items[1].Embed = false), "resources: embed on unless written off" )
    Check( resfile.ToText( d ) = t, "resources: the canonical text round-trips", resfile.ToText( d ) )
    dim as Array( of ustring ) probs
    resfile.Check( d, "", probs )
    Check( probs.Count( ) = 0, "resources: a good file has no problems" )

    dim as resfile.ResourceDoc bad
    Check( resfile.Parse( "format = 1" & LF & "[[resource]]" & LF & "name = ""2x""" & LF & "kind = ""sound""" & LF & "file = ""a/b.png""" & LF _
        & "[[resource]]" & LF & "name = ""LOGO""" & LF & "kind = ""image""" & LF & "file = ""x.png""" & LF _
        & "[[resource]]" & LF & "name = ""logo""" & LF & "kind = ""image""" & LF & "file = ""y.png""" & LF & "colour = 1" & LF, bad, e ), "resources: a faulty file still parses" )
    resfile.Check( bad, "", probs )
    Check( probs.Count( ) = 5, "resources: bad name, bad kind, a path for a file, a name taken, an unknown key", strings.Join( probs, " | " ) )
    Check( resfile.Parse( "format = 2" & LF, bad, e ) = false, "resources: a newer format is refused" )

    ' AddFile copies into files/, numbers a clash, names from the stem
    dim as ustring dir_ = fs.PathJoin( fs.TempDir( ).ValueOr( none ), "designall-res" )
    fs.RemoveDirAll( dir_ )
    fs.CreateDirAll( dir_ )
    dim as ustring src = fs.PathJoin( dir_, "my logo.png" )
    fs.WriteAllText( src, "not really a png" )
    dim as resfile.ResourceDoc a
    dim as ustring problem
    dim as long i1 = resfile.AddFile( a, dir_, src, problem )
    dim as long i2 = resfile.AddFile( a, dir_, src, problem )
    Check( (i1 = 0) andalso (i2 = 1) andalso (a.Items[0].Name = "my_logo") andalso (a.Items[1].Name = "my_logo2"), _
        "resources: added under free names from the stem", a.Items[0].Name & " " & a.Items[1].Name )
    Check( (a.Items[0].File = "my logo.png") andalso (a.Items[1].File = "my logo2.png") andalso _
        fs.IsFile( fs.PathJoin( dir_, "files", "my logo2.png" ) ), "resources: copied into files/, a clash numbered", a.Items[1].File )
    Check( a.Items[0].Kind = "image", "resources: the kind from the extension" )
    Check( resfile.AddFile( a, dir_, fs.PathJoin( dir_, "notes.txt" ), problem ) = -1, "resources: not an image or a font is refused", problem )
    resfile.Check( a, dir_, probs )
    fs.RemoveDirAll( dir_ )

    ' the generated module
    dim as ustring g = resfile.Generate( d, "appResources", "appResources.tkres", t )
    Check( instr( g, "#embed gRes0_ ""files/logo.png""" ) > 0, "resources: an embedded one is #embedded", g )
    Check( instr( g, "tkHost_AddResourceData( ""res:logo"", @gRes0_( 0 ), ubound( gRes0_ ) + 1 )" ) > 0, "resources: and registered as bytes" )
    Check( (instr( g, "tkHost_AddResourceFile( ""res:Body"", Where_( ""Body.ttf"" ) )" ) > 0) andalso (instr( g, "gRes1_" ) = 0), _
        "resources: one not built in is registered as a file" )

    ' references
    dim as long n
    Check( resfile.RenameRefs( "a = ""res:Logo""" & LF & "b = ""res:logo2""" & LF & "c = ""res:logo""", "logo", "brand", n ) _
        = "a = ""res:brand""" & LF & "b = ""res:logo2""" & LF & "c = ""res:brand""", "resources: a rename rewrites whole references only" )
    Check( n = 2, "resources: and counts them", str( n ) )
    Check( resfile.Refers( "x = ""res:LOGO""", "logo" ) andalso (resfile.Refers( "x = ""res:logo2""", "logo" ) = false), "resources: Refers" )

    ' main.tiko made to register them, before the theme's options
    dim as ustring m = "#import ""vendor/tkControls/tkApp""" & LF & "#import ""./appTheme""" & LF & "dim as TKAPP_OPTIONS o" & LF _
        & "appTheme.ApplyOptions( o )" & LF & "if tkApp_Init( o ) = false then end 1" & LF, outText
    Check( resfile.InstallIntoMain( m, outText ) = 1, "resources: main takes Register" )
    Check( outText = "#import ""vendor/tkControls/tkApp""" & LF & "#import ""./appResources""" & LF & "#import ""./appTheme""" & LF & "dim as TKAPP_OPTIONS o" & LF _
        & "appResources.Register( )" & LF & "appTheme.ApplyOptions( o )" & LF & "if tkApp_Init( o ) = false then end 1" & LF, _
        "resources: imported, Register before ApplyOptions", outText )
    Check( resfile.InstallIntoMain( outText, m ) = 0, "resources: and only once" )
end sub

' [control.colors] (THEMES.md, TH4): values, migration of the old colour properties, refusals.
sub ColorsSuite( )
    dim as ustring src = Header( ) & Ctl( "l", "Label", "parent = """"" & LF & "x = 0" & LF & "y = 0" & LF & "w = 10" & LF & "h = 10" & LF ) _
        & LF & "[control.props]" & LF & "Text = ""a""" & LF & "BackColor = ""&h80102030""" & LF & "TextColor = ""&hFF336699""" & LF
    dim as FormDoc d
    Check( ReadForm( src, d ), "an old form with colour properties reads" )
    dim as FormControl c = d.Controls[0]
    Check( (FindSetting( c.Props, "TextColor" ) < 0) andalso (FindSetting( c.Props, "BackColor" ) < 0) andalso (FindSetting( c.Props, "Text" ) >= 0), _
        "its colour properties leave [control.props]" )
    Check( SettingOr( c.Colors, "TextColor" ) = "#336699" andalso SettingOr( c.Colors, "BackColor" ) = "#10203080", _
        "and become fields, alpha last", SettingOr( c.Colors, "BackColor" ) )
    dim as ustring t = formfile.Render( d )
    Check( instr( t, "[control.colors]" & LF & "TextColor = ""#336699""" & LF & "BackColor = ""#10203080""" & LF ) > 0, _
        "written in struct order on the next save", t )
    dim as FormDoc d2
    ReadForm( t, d2 )
    Check( formfile.Render( d2 ) = t, "and that round-trips" )

    dim as ustring tb = Header( ) & Ctl( "t", "TextBox", "parent = """"" & LF & "x = 0" & LF & "y = 0" & LF & "w = 10" & LF & "h = 10" & LF ) _
        & LF & "[control.props]" & LF & "CueBannerColor = ""&hFF808080""" & LF
    dim as FormDoc d3
    ReadForm( tb, d3 )
    Check( SettingOr( d3.Controls[0].Colors, "CueColor" ) = "#808080", "TextBox's CueBannerColor is its CueColor" )
    dim as ustring pic = Header( ) & Ctl( "p", "Picture", "parent = """"" & LF & "x = 0" & LF & "y = 0" & LF & "w = 10" & LF & "h = 10" & LF ) _
        & LF & "[control.props]" & LF & "BackColor = ""&hFF808080""" & LF
    dim as FormDoc d4
    ReadForm( pic, d4 )
    Check( (FindSetting( d4.Controls[0].Props, "BackColor" ) >= 0) andalso (d4.Controls[0].Colors.Count( ) = 0), _
        "a control with no colour struct keeps its property" )

    dim as ustring base_ = Header( ) & Ctl( "b", "Button", "parent = """"" & LF & "x = 0" & LF & "y = 0" & LF & "w = 10" & LF & "h = 10" & LF ) & LF & "[control.colors]" & LF
    Accepted( base_ & "style = ""Primary""" & LF & "BackColor = ""#c62828""" & LF & "ForeColor = ""@SelectedText""" & LF, "a style, a colour, a role" )
    dim as FormDoc d5
    ReadForm( base_ & "BackColor = ""#c62828ff""" & LF, d5 )
    Check( SettingOr( d5.Controls[0].Colors, "BackColor" ) = "#C62828", "upper case, an alpha of FF dropped" )
    Refused( base_ & "BackColor = ""red""" & LF, "is not a colour" )
    Refused( base_ & "BackColor = ""@Surfce""" & LF, "'Surfce' is not a theme role" )
    Refused( base_ & "BackColor = { dark = ""#000000"" }" & LF, "is not a colour" )
    Refused( base_ & "BackColor = { dark = ""#000000"", light = ""#FFFFFF"", other = ""#FFFFFF"" }" & LF, "unknown key 'other'" )
    Refused( base_ & "TextColour = ""#000000""" & LF, "Button has no colour 'TextColour'" )
    Refused( base_ & "style = ""2 bad""" & LF, "is not a style name" )
    Refused( Header( ) & Ctl( "p", "Picture", "parent = """"" & LF & "x = 0" & LF & "y = 0" & LF & "w = 10" & LF & "h = 10" & LF ) _
        & LF & "[control.colors]" & LF & "BackColor = ""#000000""" & LF, "Picture has no colours a theme sets" )
end sub

' The .tktheme file and its generated module (THEMES.md, TH4).
function ThemeProblems( byref text as const ustring ) as Array( of ustring )
    dim as themefile.ThemeDoc d
    dim as ustring e
    dim as Array( of ustring ) p
    if themefile.Parse( text, d, e ) = false then
        p.Push( e )
        return p
    end if
    themefile.Check( d, p )
    return p
end function

sub ThemeRefused( byref text as const ustring, byref want as const ustring )
    dim as Array( of ustring ) p = ThemeProblems( text )
    dim as boolean found = false
    for each s as ustring in p
        if instr( s, want ) then found = true
    next
    dim as ustring got = "(none)"
    if p.Count( ) then got = p[0]
    Check( found, "theme refused: " & want, got )
end sub

sub ThemeSuite( byval bAccept as boolean )
    const as string dir_ = "tests/golden/appTheme/"
    dim as ustring none
    dim as ustring golden = fs.ReadAllText( dir_ & "appTheme.tktheme" ).ValueOr( none )
    Check( len( golden ) > 0, "the golden theme was found" )
    dim as themefile.ThemeDoc d
    dim as ustring e
    Check( themefile.Parse( golden, d, e ), "the golden theme parses", e )
    dim as Array( of ustring ) p
    themefile.Check( d, p )
    dim as ustring first_
    if p.Count( ) then first_ = p[0]
    Check( p.Count( ) = 0, "and checks clean", first_ )
    dim as ustring t = themefile.Render( d )
    Check( t = golden, "canonical text comes back byte for byte", t )
    Check( d.Dark.Extra.Count( ) = 2, "tkEdit's own tables are kept", str( d.Dark.Extra.Count( ) ) )
    Check( (d.Styles.Count( ) = 2) andalso (d.Styles[1].Types.Count( ) = 1), "styles and a style's type block" )

    ' messy in, one spelling out
    dim as ustring messy = "format = 1" & CRLF & "[light]" & CRLF & "Accent = '#00ff00'" & CRLF & "[dark]" & CRLF _
        & "Window = ""#10203080""" & CRLF & "Text = ""#ffffffff""" & CRLF & "Surface = ""#000000""" & CRLF & "name = 'M'" & CRLF
    dim as themefile.ThemeDoc dm
    themefile.Parse( "name = 'M'" & CRLF & messy, dm, e )
    dim as ustring tm = themefile.Render( dm )
    Check( tm = "format = 1" & LF & "name = ""M""" & LF & LF & "[dark]" & LF & "Window = ""#102030""" & LF & "Surface = ""#000000""" & LF _
        & "Text = ""#FFFFFF""" & LF & LF & "[light]" & LF & "Accent = ""#00FF00""" & LF, _
        "roles in theme order, upper case, FF dropped, Window made opaque", tm )

    dim as ustring g = themefile.Generate( d, "appTheme", "appTheme.tktheme", golden )
    if bAccept then fs.WriteAllText( dir_ & "appTheme.design.tiko", g )
    dim as ustring gg = fs.ReadAllText( dir_ & "appTheme.design.tiko" ).ValueOr( none )
    Check( g = gg, "the theme generator matches its golden", len( g ) & " vs " & len( gg ) )
    HasLine( g, "t = tkTheme_Derive( t, &hFF1E88E5ul )", "the file's accent" )
    HasLine( g, "t = tkTheme_Derive( t, &hFF1565C0ul )", "a variant's own accent" )
    HasLine( g, "t.Surface = &hFF2A2F3Aul", "a role the variant sets" )
    HasLine( g, "s.CornerRadius = 4", "the shape" )
    HasLine( g, "o.FontUIFile = ""Inter-Regular.ttf""", "the fonts" )
    HasLine( g, "gStyles_( 1 ).remap( TKROLE_SURFACE ) = tkTheme_SrcRole( 0, TKROLE_ERROR )", "a style's remap" )
    HasLine( g, "gStyles_( 1 ).remap( TKROLE_SURFACEHOT ) = tkTheme_SrcDerive( 0, TKDERIVE_HOT, TKROLE_SURFACE )", "the hot face follows the style's" )
    HasLine( g, "gTypes_( 1 ).TypeName = ""Button"" : gTypes_( 1 ).StyleName = ""Danger""", "a style's type block" )
    HasLine( g, "tkApp_SetThemePair( Dark( ), Light( ) )", "both variants installed" )
    Check( instr( themefile.DefaultText( "Default" ), "name = ""Default""" ) > 0, "a new theme is the presets, named" )

    ThemeRefused( "format = 2", "format 2" )
    ThemeRefused( "format = 1" & LF & "name = ""x""" & LF & "[dark]" & LF & "Surfce = ""#000000""" & LF, "'Surfce' is not a theme role" )
    ThemeRefused( "format = 1" & LF & "name = ""x""" & LF & "[dark]" & LF & "Surface = ""@Accent""" & LF, "is not a theme role" )
    ThemeRefused( "format = 1" & LF & "name = ""x""" & LF & "[dark]" & LF & "Surface = ""blue""" & LF, "is not a colour" )
    ThemeRefused( "format = 1" & LF & "name = ""x""" & LF & "[controls.Buttn]" & LF & "BackColor = ""#000000""" & LF, "'Buttn' is not a control with theme colours" )
    ThemeRefused( "format = 1" & LF & "name = ""x""" & LF & "[controls.Picture]" & LF & "BackColor = ""#000000""" & LF, "'Picture' is not a control with theme colours" )
    ThemeRefused( "format = 1" & LF & "name = ""x""" & LF & "[controls.Button]" & LF & "BackColour = ""#000000""" & LF, "Button has no colour 'BackColour'" )
    ThemeRefused( "format = 1" & LF & "name = ""x""" & LF & "[styles.""2nd""]" & LF & "Surface = ""@Accent""" & LF, "is not a style name" )
    ThemeRefused( "format = 1" & LF & "name = ""x""" & LF & "[styles.A]" & LF & "Surface = ""@Accent""" & LF & "[styles.a]" & LF & "Text = ""@Accent""" & LF, "is there twice" )
    ThemeRefused( "format = 1" & LF & "name = ""x""" & LF & "[shape]" & LF & "CornerRadius = -2" & LF, "CornerRadius is -1" )
    ThemeRefused( "format = 1" & LF & "name = ""x""" & LF & "[fonts]" & LF & "ui = { face = ""a"" }" & LF, "unknown key 'face'" )
    ThemeRefused( "format = 1" & LF & "[dark]" & LF, "the theme has no name" )
end sub

' The Theme Center's core (TH5): shipped themes, Resolve, contrast, main.tiko made to install a theme.
sub ThemeCenterCore( )
    ' every shipped theme is canonical, clean, and resolves; High Contrast passes AA in both variants
    dim as ustring cleanThemes( 0 to 3 ) = { "Default", "HighContrast", "Ocean", "Classic" }
    for k as long = 0 to 3
        dim as ustring nm = cleanThemes( k )
        dim as ustring none
        dim as ustring text = fs.ReadAllText( "../../themes/" & nm & ".tktheme" ).ValueOr( none )
        dim as themefile.ThemeDoc d
        dim as ustring e
        dim as Array( of ustring ) p
        dim as boolean ok = themefile.Parse( text, d, e )
        if ok then themefile.Check( d, p )
        Check( ok andalso (p.Count( ) = 0) andalso (themefile.Render( d ) = text), "shipped theme " & nm & ": canonical and clean", e )
    next
    for each nm as ustring in Names( "Forest", "Ember", "Violet" )
        dim as ustring none
        dim as ustring text = fs.ReadAllText( "../../themes/" & nm & ".tktheme" ).ValueOr( none )
        dim as themefile.ThemeDoc d
        dim as ustring e
        Check( themefile.Parse( text, d, e ) andalso (themefile.Render( d ) = text), "shipped theme " & nm & ": canonical", e )
    next
    dim as ustring none
    dim as themefile.ThemeDoc hc
    dim as ustring e
    themefile.Parse( fs.ReadAllText( "../../themes/HighContrast.tktheme" ).ValueOr( none ), hc, e )
    for v as long = 0 to 1
        dim as Array( of ustring ) faults
        themefile.ContrastFaults( themefile.Resolve( hc, v = 0 ), faults )
        dim as ustring first_
        if faults.Count( ) then first_ = faults[0]
        Check( faults.Count( ) = 0, "High Contrast passes its own AA check, " & iif( v = 0, "dark", "light" ), first_ )
    next

    ' Resolve is what the generated Dark( ) / Light( ) build
    dim as themefile.ThemeDoc d
    Check( tkTheme_Equal( themefile.Resolve( d, true ), tkTheme_Dark( ) ) andalso tkTheme_Equal( themefile.Resolve( d, false ), tkTheme_Light( ) ), _
        "an empty theme resolves to the presets" )
    d.Accent = "#E65100"
    PutSetting( d.Dark.Roles, "Surface", "#123456" )
    dim as TKTHEME_COLORS r = themefile.Resolve( d, true )
    Check( (r.Accent = tkTheme_Derive( tkTheme_Dark( ), &hFFE65100ul ).Accent) andalso (r.Surface = &hFF123456ul), "the accent derived, then the roles" )
    dim as Array( of ustring ) faults
    dim as TKTHEME_COLORS bad = tkTheme_Dark( )
    bad.Text = bad.Surface
    themefile.ContrastFaults( bad, faults )
    dim as ustring f0
    if faults.Count( ) then f0 = faults[0]
    Check( instr( f0, "Text on Surface: 1.0:1 (needs 4.5)" ) = 1, "a contrast fault says which pair and how far", f0 )

    ' the preview's tables agree with what the generated module installs
    dim as themefile.ThemeDoc g
    themefile.Parse( fs.ReadAllText( "tests/golden/appTheme/appTheme.tktheme" ).ValueOr( none ), g, e )
    dim as themefile.ThemeTables tb
    tb.Build( g )
    Check( (tb.Styles.Count( ) = 2) andalso (tb.Styles[1].Name = "Danger") andalso (tb.Styles[1].remap( TKROLE_SURFACE ).arg = TKROLE_ERROR), "styles as tables" )
    Check( tb.Styles[1].remap( TKROLE_SURFACEHOT ).kind = TKSRC_DERIVE, "with simple mode for roles" )
    Check( (tb.Types.Count( ) = 2) andalso (tb.Types[1].StyleName = "Danger") andalso (tb.Types[1].n = 4) andalso (tb.Types[1].pSrc->value = &hFFB71C1Cul), _
        "type recipes as tables, pointing at their entries" )

    ' main.tiko made to install the theme
    dim as ustring m = "' app" & LF & "#import ""vendor/tkControls/tkApp""" & LF & "#import ""./frmMain""" & LF & "using tkApp" & LF & LF _
        & "dim as TKAPP_OPTIONS opts" & LF & "if tkApp_Init( opts ) = false then end 1" & LF & "dim as frmMain.Form f" & LF
    dim as ustring o
    Check( themefile.InstallIntoMain( m, o ) = 1, "a new-project main takes the theme" )
    Check( o = "' app" & LF & "#import ""vendor/tkControls/tkApp""" & LF & "#import ""./appTheme""" & LF & "#import ""./frmMain""" & LF & "using tkApp" & LF & LF _
        & "dim as TKAPP_OPTIONS opts" & LF & "appTheme.ApplyOptions( opts )" & LF & "if tkApp_Init( opts ) = false then end 1" & LF & "appTheme.Install( )" & LF _
        & "dim as frmMain.Form f" & LF, "import, ApplyOptions before Init, Install after", o )
    Check( themefile.InstallIntoMain( o, m ) = 0, "and only once" )
    Check( themefile.InstallIntoMain( "print 1" & LF, o ) = -1, "a main with no tkApp_Init is left to the user" )
end sub

' The Colors dialog's core (TH6): where a control's colour comes from.
sub ColorSources( )
    dim as ustring none, e
    dim as themefile.ThemeDoc g
    themefile.Parse( fs.ReadAllText( "tests/golden/appTheme/appTheme.tktheme" ).ValueOr( none ), g, e )
    dim as TKMETA_CONTROL ptr m = tkMeta_Find( "Button" )
    dim as Array( of Setting ) own
    PutSetting( own, "BackColor", "#C62828" )
    dim as long sBack = tkMeta_ColorSlot( m, "BackColor" ), sBackHot = tkMeta_ColorSlot( m, "BackColorHot" )
    dim as long sBorder = tkMeta_ColorSlot( m, "BorderColor" ), sBorderHot = tkMeta_ColorSlot( m, "BorderColorHot" )
    dim as long sFore = tkMeta_ColorSlot( m, "ForeColor" ), sRing = tkMeta_ColorSlot( m, "FocusRingColor" )
    Check( themefile.SourceOf( g, m, "", own, sBack, true ) = themefile.FROM_CONTROL, "a field set on the control" )
    Check( themefile.SourceOf( g, m, "", own, sBackHot, true ) = themefile.FROM_DERIVED, "its part's Hot follows it" )
    dim as Array( of Setting ) none_
    Check( themefile.SourceOf( g, m, "", none_, sBorder, true ) = themefile.FROM_TYPE, "[controls.Button] gives every Button its border" )
    Check( themefile.SourceOf( g, m, "", none_, sBorderHot, true ) = themefile.FROM_TYPE, "and the border's states, by simple mode" )
    Check( themefile.SourceOf( g, m, "Danger", none_, sBorder, true ) = themefile.FROM_STYLE, "a style's block for the type beats the type's" )
    Check( themefile.SourceOf( g, m, "Primary", none_, sBack, true ) = themefile.FROM_STYLE, "a style's remap reaches the face" )
    Check( themefile.SourceOf( g, m, "Primary", none_, sFore, true ) = themefile.FROM_STYLE, "and the text" )
    Check( themefile.SourceOf( g, m, "Primary", none_, sRing, true ) = themefile.FROM_THEME, "a role the style leaves is the theme's" )
    Check( themefile.SourceOf( g, m, "NoSuchStyle", none_, sBack, true ) = themefile.FROM_THEME, "an unknown style is no style" )
    Check( themefile.SourceOf( g, m, "Primary", own, sBack, true ) = themefile.FROM_CONTROL, "the control's own beats its style" )
end sub

' TH8: the fixtures examples/tkControls/tkThemeFile compares tkTheme_Load against -- every shipped
' theme, the golden, the sample's and a Mixed one -- each a copy of its .tktheme plus the module this
' generator makes from it. --accept rewrites them; otherwise they must be current.
sub ThemeLoadFixtures( byval bAccept as boolean )
    const as string fx = "../../../examples/tkControls/tkThemeFile/fixtures/"
    dim as ustring fixNames( 0 to 9 ) = { "Default", "HighContrast", "Ocean", "Forest", "Ember", "Violet", "Classic", "Golden", "Sample", "Mixed" }
    dim as ustring srcs( 0 to 9 ) = { "../../themes/Default.tktheme", "../../themes/HighContrast.tktheme", "../../themes/Ocean.tktheme", _
        "../../themes/Forest.tktheme", "../../themes/Ember.tktheme", "../../themes/Violet.tktheme", "../../themes/Classic.tktheme", _
        "tests/golden/appTheme/appTheme.tktheme", "../../../examples/tkControls/tkDesigned/appTheme/appTheme.tktheme", "" }
    for i as long = 0 to 9
        dim as ustring none, e
        dim as ustring md = "th" & fixNames( i ), dir_ = fx & md & "/"
        dim as ustring themePath = dir_ & md & ".tktheme"
        dim as ustring text
        if len( srcs( i ) ) then
            text = fs.ReadAllText( srcs( i ) ).ValueOr( none )
            if bAccept then
                fs.CreateDirAll( dir_ )
                fs.WriteAllText( themePath, text )
            end if
            Check( fs.ReadAllText( themePath ).ValueOr( none ) = text, "load fixture " & md & ": the theme is current", srcs( i ) )
        else
            text = fs.ReadAllText( themePath ).ValueOr( none )
        end if
        dim as themefile.ThemeDoc d
        dim as Array( of ustring ) p
        dim as boolean ok = (len( text ) > 0) andalso themefile.Parse( text, d, e )
        if ok then themefile.Check( d, p )
        dim as ustring first_ = e
        if p.Count( ) then first_ = p[0]
        Check( ok andalso (p.Count( ) = 0), "load fixture " & md & ": parses and checks clean", first_ )
        dim as ustring g = themefile.Generate( d, md, md & ".tktheme", text )
        if bAccept then fs.WriteAllText( dir_ & md & ".design.tiko", g )
        Check( fs.ReadAllText( dir_ & md & ".design.tiko" ).ValueOr( none ) = g, "load fixture " & md & ": the generated module is current" )
    next
end sub

' [fonts] embed: the four fonts inside the program -- the file round trip, the generated #embed and
' "mem:" registrations (defaults for empty slots, each file once), where a font is found, the copy.
' GLYPHS.md GV7: a glyph value is "<font>:<hex>"; the code box's text read in the value's font; the
' generated code writes the character.
sub GlyphValueSuite( )
    Check( (GlyphCode( "Fluent:E824" ) = &hE824) andalso (GlyphFontKey( "Fluent:E824" ) = "Fluent") andalso (GlyphCode( wchr( &h25B6 ) ) = 0), _
           "glyph: Font:Code reads; a plain character is no code" )
    Check( (GlyphTyped( "f0a", "Material:E8B8" ) = "Material:0F0A") andalso (GlyphTyped( "U+E824", "" ) = "Fluent:E824") _
           andalso (GlyphTyped( "", "Fluent:E824" ) = "") andalso (GlyphTyped( "x", "" ) = "x"), "glyph: the code box typed" )
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "width = 300" & LF & "height = 200" & LF & LF _
        & "[[control]]" & LF & "name = ""B""" & LF & "type = ""Button""" & LF & "parent = """"" & LF _
        & "x = 0" & LF & "y = 0" & LF & "w = 80" & LF & "h = 24" & LF & LF _
        & "[control.props]" & LF & "GlyphLeft = ""Fluent:E824""" & LF
    dim as FormDoc d
    dim as ustring e
    Check( formfile.Parse( src, d, e ), "glyph: the form parses", e )
    dim as ustring g = codegen.Generate( d, "frmG", "frmG.tkform", src )
    Check( instr( g, "B.GlyphLeft = wchr( &hE824 )" ) > 0, "glyph: generated as its character", g )
    Check( instr( g, "B.GlyphFont = tkForm_Font( Handle, TKFONT_GLYPH )" ) > 0, "glyph: no GlyphSize set is the GLYPH role", g )
    PutSetting( d.Controls[0].Props, "GlyphFont", "32" )
    dim as Array( of ustring ) vp
    validate.Check( d, "frmG", vp )
    dim as ustring vp0
    if vp.Count( ) then vp0 = vp[0]
    Check( vp.Count( ) = 0, "glyph: GlyphSize 32 passes the checks", vp0 )
    g = codegen.Generate( d, "frmG", "frmG.tkform", src )
    Check( (instr( g, "dim as TTF_Font ptr gf_ = tkHost.tkHost_OpenFont( tkForm_Host( Handle ), tkApp_GlyphFace( ), 32 )" ) > 0) _
           andalso (instr( g, "B.GlyphFont = gf_" ) > 0) andalso (instr( g, "B.IconSize( TTF_GetFontHeight( gf_ ), TTF_GetFontHeight( gf_ ) )" ) > 0), _
           "glyph: GlyphSize 32 opens the glyph font at 32 points, the icon box fitted to it", g )
    PutSetting( d.Controls[0].Props, "IconSize", "20,20" )
    g = codegen.Generate( d, "frmG", "frmG.tkform", src )
    Check( instr( g, "B.IconSize( TTF_GetFontHeight" ) = 0, "glyph: an ImageSize of its own is left alone", g )
    ' V5: a toolbar button's glyph, at the project's number for it
    dim as ustring tsrc = "format = 1" & LF & LF & "[form]" & LF & "width = 300" & LF & "height = 200" & LF & LF _
        & "[[control]]" & LF & "name = ""T""" & LF & "type = ""Toolbar""" & LF & "parent = """"" & LF _
        & "x = 0" & LF & "y = 0" & LF & "w = 200" & LF & "h = 32" & LF & LF _
        & "[[control.items]]" & LF & "kind = ""command""" & LF & "glyph = ""Fluent:E824""" & LF & "text = ""Go""" & LF
    dim as FormDoc td
    Check( formfile.Parse( tsrc, td, e ) andalso (td.Controls.Count( ) = 1) andalso (td.Controls[0].Items.Count( ) = 1), "glyph: a toolbar's item parses", e )
    dim as Array( of Setting ) codes
    PutSetting( codes, "Fluent:E824", "E000" )
    codegen.SetGlyphCodes( codes )
    g = codegen.Generate( td, "frmT", "frmT.tkform", tsrc )
    dim as Array( of Setting ) none_
    codegen.SetGlyphCodes( none_ )
    Check( instr( g, ", wchr( &hE000 ), " ) > 0, "glyph: a toolbar button's glyph at its merged number", g )
end sub

' GLYPHS.md V3: appGlyphs.tkglyphs -- the defaults, one canonical text, a key from a file name, Add
' copying the file in under a fresh key.
sub GlyphFileSuite( )
    dim as glyphfile.GlyphDoc d
    glyphfile.Defaults( d )
    Check( (d.Fonts.Count( ) = 5) andalso (d.Fonts[0].Key = GLYPH_FONT_FLUENT) andalso (glyphfile.Find( d, "material" ) = 1), _
           "glyphs: the bundled five, Fluent first" )
    PutSetting( d.Codes, "Fluent:E824", "E000" )
    dim as ustring t = glyphfile.Render( d ), e
    dim as glyphfile.GlyphDoc d2
    Check( glyphfile.Parse( t, d2, e ) andalso (d2.Problems.Count( ) = 0) andalso (glyphfile.Render( d2 ) = t), "glyphs: one canonical text", t & e )
    Check( (glyphfile.UniqueKey( d, "my-icons 2" ) = "myicons2") andalso (glyphfile.UniqueKey( d, "Phosphor" ) = "Phosphor2") _
           andalso (glyphfile.UniqueKey( d, "3d" ) = "Font3d"), "glyphs: a key from a file name" )
    const as string dir_ = "tests/bin/glyphs"
    fs.RemoveDirAll( dir_ )
    fs.CreateDirAll( dir_ )
    dim as ustring src = dir_ & "/My Icons.ttf"
    fs.CopyFile( "../../fonts/PsIcons.ttf", src, true )
    dim as ustring problem
    dim as long i = glyphfile.AddFont( d, dir_ & "/appGlyphs", src, problem )
    Check( (i = 5) andalso (d.Fonts[i].Key = "MyIcons") andalso (d.Fonts[i].File = "fonts/My Icons.ttf") _
           andalso (len( glyphfile.FontPath( d.Fonts[i], dir_ & "/appGlyphs", "" ) ) > 0), "glyphs: Add copies it in under a key", problem )
end sub

' GLYPHS.md V4: one font of glyphs from five, each at its new code (the tree's fonts: vendorfetch.sh)
sub FontWriterSuite( )
    const as string tk = "../../../pkg/vendor/tkControls/"
    dim as fontwriter.GlyphTake takes( 0 to 5 )
    dim as string srcs( 0 to 5 ) = { "fonts/FluentSystemIcons-Regular.ttf", "fonts/FluentSystemIcons-Regular.ttf", _
        "glyphfonts/MaterialIcons-Regular.ttf", "glyphfonts/Phosphor.ttf", "glyphfonts/lucide.ttf", "glyphfonts/tabler-icons.ttf" }
    dim as ulong cps( 0 to 5 ) = { &hE824, &hF369, &hE8ED, &hE610, &hE44F, &hF0F7 }
    dim as Array( of fontwriter.GlyphTake ) list
    for i as long = 0 to 5
        takes( i ).Path = tk & srcs( i ) : takes( i ).Code = cps( i ) : takes( i ).Target = &hE000 + i
        list.Push( takes( i ) )
    next
    if fs.IsFile( tk & "glyphfonts/tabler-icons.ttf" ) = false then
        print "  (skipped: the glyph fonts are not fetched -- sh build/vendorfetch.sh --module tkControls)"
        exit sub
    end if
    dim as Array( of ubyte ) bytes
    dim as ustring problem
    Check( fontwriter.Build( list, "Test Glyphs", bytes, problem ) andalso (len( problem ) = 0), "fontwriter: built", problem )
    const as string out_ = "tests/bin/glyphs/glyphs.ttf"
    fs.CreateDirAll( "tests/bin/glyphs" )
    fs.WriteAllBytes( out_, bytes )
    dim as boolean all_ = true
    for i as long = 0 to 5
        if fontwriter.HasGlyph( out_, &hE000 + i ) = false then all_ = false
    next
    Check( all_ andalso (fontwriter.HasGlyph( out_, &hE824 ) = false), "fontwriter: every glyph at its new code, none at its old", str( bytes.Count( ) ) )
    ' each glyph keeps its place in its own font's line box, and this font's line box is the em box
    dim as boolean placed = true
    dim as string where_
    for i as long = 0 to 5
        dim as double sm, sl, om, ol
        dim as long su, ou
        if (fontwriter.GlyphMiddle( tk & srcs( i ), cps( i ), sm, sl, su ) = false) orelse _
           (fontwriter.GlyphMiddle( out_, &hE000 + i, om, ol, ou ) = false) then placed = false : continue for
        dim as double want = (sm - sl) * ou / su + ou / 2
        where_ &= " " & hex( cps( i ) ) & ":" & om & "/" & want & " (src " & sm & " line " & sl & " upem " & su & ", out line " & ol & ")"
        if (abs( om - want ) > 1.5) orelse (ol <> ou / 2) then placed = false
    next
    Check( placed, "fontwriter: each glyph where its font centres it, in an em-box line", where_ )
    ' OS/2 version 4 is 96 bytes: the typo and win metrics at their offsets
    dim as long os2At = -1, os2Len = 0
    for t as long = 0 to ((bytes[4] shl 8) or bytes[5]) - 1
        dim as long r = 12 + 16 * t
        if (bytes[r] = asc( "O" )) andalso (bytes[r + 1] = asc( "S" )) andalso (bytes[r + 2] = asc( "/" )) andalso (bytes[r + 3] = asc( "2" )) then
            os2At = (bytes[r + 8] shl 24) or (bytes[r + 9] shl 16) or (bytes[r + 10] shl 8) or bytes[r + 11]
            os2Len = (bytes[r + 12] shl 24) or (bytes[r + 13] shl 16) or (bytes[r + 14] shl 8) or bytes[r + 15]
        end if
    next
    dim as long typoAsc = -1, winAsc = -1
    if os2At >= 0 then typoAsc = (bytes[os2At + 68] shl 8) or bytes[os2At + 69] : winAsc = (bytes[os2At + 74] shl 8) or bytes[os2At + 75]
    Check( (os2Len = 96) andalso (typoAsc = 500) andalso (winAsc = 500), "fontwriter: OS/2 is 96 bytes, typo and win ascent the em", os2Len & " " & typoAsc & " " & winAsc )
    ' V6: CFF outlines -- a name-keyed font (made from PsIcons by fontTools) and a CID-keyed one
    ' (tkEdit's Noto Sans SC subset: subroutines, FDSelect)
    dim as Array( of fontwriter.GlyphTake ) cff
    dim as string cffSrc( 0 to 3 ) = { "tests/golden/fonts/test-namekeyed-cff.otf", "tests/golden/fonts/test-namekeyed-cff.otf", _
        "../../fonts/NotoSansSC-tkEdit.otf", "../../fonts/NotoSansSC-tkEdit.otf" }
    dim as ulong cffCp( 0 to 3 ) = { &hE824, &hF3DD, &h8D44, &h7CFB }
    for i as long = 0 to 3
        dim as fontwriter.GlyphTake tk2
        tk2.Path = cffSrc( i ) : tk2.Code = cffCp( i ) : tk2.Target = &hE100 + i
        cff.Push( tk2 )
    next
    Check( fontwriter.Build( cff, "CFF Glyphs", bytes, problem ) andalso (len( problem ) = 0), "fontwriter: CFF taken", problem )
    const as string outCff = "tests/bin/glyphs/glyphs-cff.ttf"
    fs.WriteAllBytes( outCff, bytes )
    all_ = true
    for i as long = 0 to 3
        if fontwriter.HasGlyph( outCff, &hE100 + i ) = false then all_ = false
    next
    Check( all_, "fontwriter: CFF glyphs at their new codes" )
end sub

sub EmbedFontsSuite( )
    dim as ustring none
    dim as ustring text = "format = 1" & LF & "name = ""E""" & LF & LF & "[dark]" & LF & LF & "[light]" & LF & LF _
        & "[fonts]" & LF & "embed = true" & LF & "ui = { file = ""My.ttf"", size = 11 }" & LF
    dim as themefile.ThemeDoc d
    dim as ustring e
    Check( themefile.Parse( text, d, e ), "embed: parses", e )
    Check( d.EmbedFonts andalso (d.Problems.Count( ) = 0), "embed: read as true, no problem" )
    Check( themefile.Render( d ) = text, "embed: one canonical text", themefile.Render( d ) )
    dim as Array( of ustring ) files = themefile.EmbeddedFonts( d )
    Check( (files.Count( ) = 4) andalso (files[0] = "My.ttf") andalso (files[1] = "Inter-Bold.ttf"), "embed: the theme's UI font, then the defaults" )
    dim as ustring g = themefile.Generate( d, "appTheme", "appTheme.tktheme", text )
    Check( instr( g, "#embed gFont0_ ""fonts/My.ttf""" ) > 0, "embed: #embed from fonts/", g )
    Check( instr( g, "#embed gFont3_ ""fonts/CascadiaMono-Regular.ttf""" ) > 0, "embed: a default slot embedded too" )
    Check( instr( g, "tkHost_AddFontData( ""mem:My.ttf"", @gFont0_( 0 ), ubound( gFont0_ ) + 1 )" ) > 0, "embed: registered as mem:" )
    Check( (instr( g, "o.FontDir = ""mem:""" ) > 0) andalso (instr( g, "o.FontUIFile = ""My.ttf""" ) > 0) _
           andalso (instr( g, "o.FontUISize = 11" ) > 0), "embed: the options look there" )
    ' no size of its own: the OS's normal size at run time (GLYPHS.md GV2); an old glyph slot is ignored
    d.UISize = 0
    Check( instr( themefile.Generate( d, "appTheme", "appTheme.tktheme", text ), "o.FontUISize = tkApp_SystemFontSize( )" ) > 0, "no size: the OS's" )
    d.UISize = 11
    dim as themefile.ThemeDoc dg
    Check( themefile.Parse( "format = 1" & LF & "name = ""G""" & LF & LF & "[fonts]" & LF & "glyph = { file = ""x.ttf"" }" & LF, dg, e ) _
           andalso (dg.Problems.Count( ) = 0) andalso (instr( themefile.Render( dg ), "glyph" ) = 0), "an old [fonts] glyph reads and goes", e )
    ' off: no #embed, as before
    d.EmbedFonts = false
    Check( instr( themefile.Generate( d, "appTheme", "appTheme.tktheme", text ), "#embed" ) = 0, "embed off: nothing embedded" )
    d.EmbedFonts = true
    ' the same file in two slots is embedded once
    d.UIBold = "My.ttf"
    Check( themefile.EmbeddedFonts( d ).Count( ) = 3, "embed: one file in two slots, once" )
    d.UIBold = ""

    ' where a font comes from, and the copy into appTheme/fonts
    const as string root_ = "tests/bin/embed"
    fs.RemoveDirAll( root_ )
    fs.CreateDirAll( root_ & "/proj/appTheme" )
    fs.CreateDirAll( root_ & "/pkg/vendor/tkControls/fonts" )
    dim as ustring themeDir = root_ & "/proj/appTheme", pkgDir = root_ & "/pkg"
    fs.WriteAllText( root_ & "/proj/My.ttf", "my font" )
    dim as ustring bundledFonts( 0 to 2 ) = { "Inter-Bold.ttf", "FluentSystemIcons-Regular.ttf", "CascadiaMono-Regular.ttf" }
    for i as long = 0 to 2
        fs.WriteAllText( pkgDir & "/vendor/tkControls/fonts/" & bundledFonts( i ), "bundled " & bundledFonts( i ) )
    next
    Check( instr( themefile.FontSource( "My.ttf", themeDir, pkgDir ), "proj" ) > 0, "embed: a project font is found in the project folder" )
    Check( instr( themefile.FontSource( "Inter-Bold.ttf", themeDir, pkgDir ), "pkg" ) > 0, "embed: a bundled one in the toolchain" )
    Check( themefile.FontSource( "Nope.ttf", themeDir, pkgDir ) = "", "embed: an unknown one nowhere" )
    dim as Array( of ustring ) problems
    themefile.CopyEmbeddedFonts( d, themeDir, pkgDir, problems )
    Check( problems.Count( ) = 0, "embed: the copy has no problem" )
    Check( fs.ReadAllText( themeDir & "/fonts/My.ttf" ).ValueOr( none ) = "my font", "embed: the project font copied into fonts/" )
    Check( fs.IsFile( themeDir & "/fonts/CascadiaMono-Regular.ttf" ), "embed: and the defaults" )
    ' a file already in fonts/ is kept (it may be the user's own)
    fs.WriteAllText( themeDir & "/fonts/My.ttf", "edited" )
    themefile.CopyEmbeddedFonts( d, themeDir, pkgDir, problems )
    Check( fs.ReadAllText( themeDir & "/fonts/My.ttf" ).ValueOr( none ) = "edited", "embed: a font already in fonts/ is kept" )
    d.MonoFile = "Missing.ttf"
    dim as Array( of ustring ) p2
    themefile.CopyEmbeddedFonts( d, themeDir, pkgDir, p2 )
    Check( (p2.Count( ) = 1) andalso (instr( p2[0], "Missing.ttf" ) > 0), "embed: a font not found is named" )
end sub

' Data binding (B1): the form's DataType / DataModule and each control's Bind, read, written,
' checked and turned into LoadFrom / SaveTo.
sub BindSuite( )
    dim as ustring hdr = Header( ) & "data_type = ""contactdb.Contact""" & LF & "data_module = ""../contactdb""" & LF
    dim as ustring body = Ctl( "txtName", "TextBox", "bind = ""FirstName""" & LF ) _
        & Ctl( "chkVip", "CheckBox", "bind = ""Flags.Vip""" & LF ) _
        & Ctl( "lblTitle", "Label", "bind = ""Title""" & LF ) _
        & Ctl( "cboKind", "ComboBox", "bind = ""Kind""" & LF ) _
        & Ctl( "nudAge", "NumericUpDown", "bind = ""Age""" & LF ) _
        & Ctl( "dtBorn", "DatePicker", "bind = ""Born""" & LF ) _
        & Ctl( "btnOK", "Button" )
    dim as FormDoc d
    Check( ReadForm( hdr & body, d ), "bind: the form parses" )
    Check( (d.DataType = "contactdb.Contact") andalso (d.DataModule = "../contactdb"), "bind: data_type and data_module read" )
    Check( d.Controls[FindControl( d, "chkVip" )].Bind = "Flags.Vip", "bind: a control's bind read" )
    Check( len( d.Controls[FindControl( d, "btnOK" )].Bind ) = 0, "bind: no bind is empty" )
    dim as ustring t1 = formfile.Render( d )
    Check( instr( t1, "data_type = ""contactdb.Contact""" & LF & "data_module = ""../contactdb""" & LF ) > 0, "bind: the form's keys written", t1 )
    Check( instr( t1, "bind = ""FirstName""" & LF ) > 0, "bind: a control's bind written" )
    dim as FormDoc d2
    ReadForm( t1, d2 )
    Check( formfile.Render( d2 ) = t1, "bind: round trip" )
    Check( instr( formfile.Render( d2 ), "data_type" ) > 0, "bind: kept" )
    dim as FormDoc plain
    ReadForm( Header( ) & Ctl( "b", "Button" ), plain )
    Check( (instr( formfile.Render( plain ), "data_" ) = 0) andalso (instr( formfile.Render( plain ), "bind" ) = 0), "bind: none written when unset" )

    Accepted( hdr & body, "a bound form" )
    Accepted( Header( ) & "data_module = ""../m""" & LF, "a data module before its type" )
    Refused( hdr & Ctl( "btnX", "Button", "bind = ""X""" & LF ), "a Button can't be bound to a field" )
    Refused( hdr & Ctl( "t", "TextBox", "bind = ""1st""" & LF ), "bind '1st' is not a field name" )
    Refused( hdr & Ctl( "t", "TextBox", "bind = ""a..b""" & LF ), "bind 'a..b' is not a field name" )
    Refused( Header( ) & Ctl( "t", "TextBox", "bind = ""Name""" & LF ), "needs the form's DataType first" )
    Refused( Header( ) & "data_type = ""contactdb.""" & LF, "data type 'contactdb.' is not a type name" )
    Refused( hdr & Ctl( "LoadFrom", "Button" ), "control 'LoadFrom' is already a member of every form" )
    Refused( hdr & Ctl( "SaveTo", "Button" ), "control 'SaveTo' is already a member of every form" )

    dim as ustring t = codegen.Generate( d, "frmBind", "frmBind.tkform", "" )
    Check( instr( t, "#import ""vendor/tkControls/tkBind""" & LF & "#import ""../contactdb""" & LF ) > 0, "bind: imports tkBind and the data module" )
    Check( instr( t, LF & "using tkBind" & LF ) > 0, "bind: using tkBind" )
    HasLine( t, "declare function LoadFrom( byref r as contactdb.Contact ) as boolean", "bind: LoadFrom declared" )
    HasLine( t, "declare function SaveTo( byref r as contactdb.Contact ) as boolean", "bind: SaveTo declared" )
    Check( instr( t, LF & "function Form.LoadFrom( byref r as contactdb.Contact ) as boolean" & LF ) > 0, "bind: LoadFrom defined" )
    HasLine( t, "tkTextBox_SetText( txtName.Handle, tkBind_Text( r.FirstName ) )", "bind: text in" )
    HasLine( t, "tkBind_Put( r.FirstName, tkTextBox_GetText( txtName.Handle ) )", "bind: text out" )
    HasLine( t, "tkCheckBox_SetChecked( chkVip.Handle, tkBind_Bool( r.Flags.Vip ) )", "bind: bool in, a nested field" )
    HasLine( t, "tkBind_Put( r.Flags.Vip, tkCheckBox_GetChecked( chkVip.Handle ) )", "bind: bool out" )
    HasLine( t, "tkComboBox_SetCurSel( cboKind.Handle, tkBind_Int( r.Kind ) )", "bind: int in" )
    HasLine( t, "tkBind_Put( r.Kind, clngint( tkComboBox_GetCurSel( cboKind.Handle ) ) )", "bind: int out, as longint" )
    HasLine( t, "tkBind_Put( r.Age, cdbl( tkNumericUpDown_GetValue( nudAge.Handle ) ) )", "bind: float out, as double" )
    HasLine( t, "tkDatePicker_SetDateValue( dtBorn.Handle, tkBind_Date( r.Born ) )", "bind: date in" )
    HasLine( t, "tkBind_Put( r.Born, tkDatePicker_GetDateValue( dtBorn.Handle ) )", "bind: date out" )
    HasLine( t, "tkLabel_SetText( lblTitle.Handle, tkBind_Text( r.Title ) )", "bind: a load-only control loads" )
    Check( instr( t, "tkBind_Put( r.Title" ) = 0, "bind: ...and is not saved" )
    Check( instr( t, "btnOK.Handle, tkBind" ) = 0, "bind: an unbound control is left alone" )
    Check( instr( t, "Form.LoadFrom" ) > instr( t, "sub Form.Build" ), "bind: after Build" )

    ' T4 (claude-docs TIMEPICKER.md 10): the time kind, and a date + time pair on one field saved in
    ' one call -- the time control first here, so the call still takes the date first
    dim as FormDoc dtp
    ReadForm( hdr & Ctl( "tpStart", "TimePicker", "bind = ""Start""" & LF ) & Ctl( "tpAt", "TimePicker", "bind = ""Stamp""" & LF ) _
        & Ctl( "dpAt", "DatePicker", "bind = ""Stamp""" & LF ), dtp )
    dim as ustring tt = codegen.Generate( dtp, "frmT", "frmT.tkform", "" )
    HasLine( tt, "tkTimePicker_SetTimeValue( tpStart.Handle, tkBind_Time( r.Start ) )", "bind: time in" )
    HasLine( tt, "tkBind_Put( r.Start, tkTimePicker_GetTimeValue( tpStart.Handle ) )", "bind: time out" )
    HasLine( tt, "tkBind_Put( r.Stamp, tkDatePicker_GetDateValue( dpAt.Handle ), tkTimePicker_GetTimeValue( tpAt.Handle ) )", "bind: a date + time pair saves in one call, date first" )
    Check( (instr( tt, "tkBind_Put( r.Stamp, tkTimePicker" ) = 0) andalso (instr( tt, "tkBind_Put( r.Stamp, tkDatePicker_GetDateValue( dpAt.Handle ) )" ) = 0), "bind: ...and no half-saves", tt )
    dim as FormDoc dte
    ReadForm( Header( ) & Ctl( "tp", "TimePicker", "" ) & "[control.events]" & LF & "TimeChanged = ""OnT""" & LF, dte )
    Check( instr( codegen.Generate( dte, "frmTE", "frmTE.tkform", "" ), LF & "using tkTimePanel" & LF ) > 0, "a TimeChanged handler brings TKTIME's module (tkTimePanel) into scope" )
    ' the datetime kind (tkDateTimePicker): one control, one value, no pair
    dim as FormDoc ddt
    ReadForm( hdr & Ctl( "dtpEnd", "DateTimePicker", "bind = ""Ends""" & LF ) & "[control.events]" & LF & "DateTimeChanged = ""OnEnd""" & LF, ddt )
    dim as ustring td = codegen.Generate( ddt, "frmDT", "frmDT.tkform", "" )
    HasLine( td, "tkDateTimePicker_SetDateTimeValue( dtpEnd.Handle, tkBind_DateTime( r.Ends ) )", "bind: datetime in" )
    HasLine( td, "tkBind_Put( r.Ends, tkDateTimePicker_GetDateTimeValue( dtpEnd.Handle ) )", "bind: datetime out" )
    Check( instr( td, LF & "using tkTimePanel" & LF ) > 0, "a DateTimeChanged handler brings TKDATETIME's module (tkTimePanel) into scope" )

    dim as FormDoc nb
    ReadForm( hdr & Ctl( "b", "Button" ), nb )
    Check( instr( codegen.Generate( nb, "frmNB", "frmNB.tkform", "" ), "LoadFrom" ) = 0, "bind: a DataType with nothing bound generates nothing" )
    Check( instr( codegen.Generate( nb, "frmNB", "frmNB.tkform", "" ), "tkBind" ) = 0, "bind: ...not even the import" )

    ' paste: a bound control keeps its field in a form with a DataType, loses it in one without
    dim as ustring clip = edits.CopyText( d, Names( "txtName" ) )
    dim as Array( of ustring ) added
    dim as FormDoc withType
    ReadForm( hdr, withType )
    Check( edits.PasteText( withType, clip, "", -1, 0, 0, added ), "bind: paste into a bound form" )
    Check( withType.Controls[withType.Controls.Count( ) - 1].Bind = "FirstName", "bind: ...keeps the field" )
    dim as FormDoc noType
    ReadForm( Header( ), noType )
    dim as Array( of ustring ) added2
    Check( edits.PasteText( noType, clip, "", -1, 0, 0, added2 ), "bind: paste into a form without a DataType" )
    Check( len( noType.Controls[noType.Controls.Count( ) - 1].Bind ) = 0, "bind: ...drops the field" )
end sub

' bind2: a two-value control's second field (a range Slider's upper thumb). The Slider's own bind and
' bind2 entries are not in controls.toml yet, so its table entry stands in for the suite and is put back.
sub Bind2Suite( )
    dim as TKMETA_CONTROL ptr m = catalog.Find( "Slider" )
    Check( m <> 0, "bind2: the Slider is in the table" )
    if m = 0 then exit sub
    dim as TKMETA_CONTROL keep = *m
    if len( m->Bind2Kind ) = 0 then
        m->BindKind = "float" : m->BindGet = "tkSlider_GetValue" : m->BindSet = "tkSlider_SetValue" : m->BindLoadOnly = false
        m->Bind2Kind = "float" : m->Bind2Get = "tkSlider_GetUpperValue" : m->Bind2Set = "tkSlider_SetUpperValue"
        m->Bind2Name = "BindUpper" : m->Bind2When = "Mode=Range"
    end if
    dim as ustring hdr = Header( ) & "data_type = ""shop.Filter""" & LF & "data_module = ""../shop""" & LF
    dim as ustring rangeProps = LF & "[control.props]" & LF & "Mode = ""Range""" & LF
    dim as ustring src = hdr & Ctl( "sldPrice", "Slider", "bind = ""PriceLo""" & LF & "bind2 = ""PriceHi""" & LF ) & rangeProps _
        & Ctl( "txtName", "TextBox", "bind = ""Name""" & LF )
    dim as FormDoc d
    Check( ReadForm( src, d ), "bind2: the form parses" )
    Check( d.Controls[FindControl( d, "sldPrice" )].Bind2 = "PriceHi", "bind2: read" )
    Check( len( d.Controls[FindControl( d, "txtName" )].Bind2 ) = 0, "bind2: none is empty" )
    dim as ustring t1 = formfile.Render( d )
    Check( instr( t1, "bind = ""PriceLo""" & LF & "bind2 = ""PriceHi""" & LF ) > 0, "bind2: written after bind", t1 )
    Check( instr( mid( t1, instr( t1, "txtName" ) ), "bind2" ) = 0, "bind2: not written when unset" )
    dim as FormDoc d2
    ReadForm( t1, d2 )
    Check( formfile.Render( d2 ) = t1, "bind2: round trip" )
    Check( catalog.Bind2Holds( d.Controls[FindControl( d, "sldPrice" )] ), "bind2: holds in Range mode" )

    Accepted( src, "a range slider bound to two fields" )
    Accepted( hdr & Ctl( "sld", "Slider", "bind = ""Lo""" & LF ), "a single slider bound to one field" )
    Refused( hdr & Ctl( "sld", "Slider", "bind2 = ""Hi""" & LF ) & rangeProps, "BindUpper needs Bind first" )
    Refused( hdr & Ctl( "sld", "Slider", "bind = ""Lo""" & LF & "bind2 = ""Hi""" & LF ), "BindUpper needs Mode=Range" )
    Refused( hdr & Ctl( "sld", "Slider", "bind = ""Lo""" & LF & "bind2 = ""Hi""" & LF ) & LF & "[control.props]" & LF & "Mode = ""Single""" & LF, _
        "BindUpper needs Mode=Range" )
    Refused( hdr & Ctl( "sld", "Slider", "bind = ""Lo""" & LF & "bind2 = ""9x""" & LF ) & rangeProps, "BindUpper '9x' is not a field name" )
    Refused( hdr & Ctl( "t", "TextBox", "bind = ""A""" & LF & "bind2 = ""B""" & LF ), "a TextBox has no second value to bind" )

    dim as ustring t = codegen.Generate( d, "frmF", "frmF.tkform", "" )
    dim as long l1 = instr( t, "    tkSlider_SetValue( sldPrice.Handle, tkBind_Float( r.PriceLo ) )" & LF )
    dim as long l2 = instr( t, "    tkSlider_SetUpperValue( sldPrice.Handle, tkBind_Float( r.PriceHi ) )" & LF )
    dim as long l3 = instr( t, "    tkTextBox_SetText( txtName.Handle, tkBind_Text( r.Name ) )" & LF )
    Check( (l1 > 0) andalso (l2 > l1) andalso (l3 > l2), "bind2: LoadFrom lower, upper, then the next control", LineWith( t, "sldPrice" ) )
    dim as long s1 = instr( t, "    tkBind_Put( r.PriceLo, cdbl( tkSlider_GetValue( sldPrice.Handle ) ) )" & LF )
    dim as long s2 = instr( t, "    tkBind_Put( r.PriceHi, cdbl( tkSlider_GetUpperValue( sldPrice.Handle ) ) )" & LF )
    dim as long s3 = instr( t, "    tkBind_Put( r.Name, tkTextBox_GetText( txtName.Handle ) )" & LF )
    Check( (s1 > l3) andalso (s2 > s1) andalso (s3 > s2), "bind2: SaveTo lower, upper, then the next control", LineWith( t, "tkBind_Put" ) )

    ' a single-mode slider's form, should one carry a bind2 anyway, moves the first value only
    dim as FormDoc one
    ReadForm( hdr & Ctl( "sld", "Slider", "bind = ""Lo""" & LF & "bind2 = ""Hi""" & LF ), one )
    Check( instr( codegen.Generate( one, "frmO", "frmO.tkform", "" ), "r.Hi" ) = 0, "bind2: not moved while it doesn't hold" )

    ' paste into a form without a DataType drops both
    dim as ustring clip = edits.CopyText( d, Names( "sldPrice" ) )
    dim as FormDoc noType
    ReadForm( Header( ), noType )
    dim as Array( of ustring ) added
    Check( edits.PasteText( noType, clip, "", -1, 0, 0, added ), "bind2: paste into a form without a DataType" )
    with noType.Controls[noType.Controls.Count( ) - 1]
        Check( (len( .Bind ) = 0) andalso (len( .Bind2 ) = 0), "bind2: ...drops both fields" )
    end with
    *m = keep
end sub

' B2: a bound control's rules (required, minimum, maximum, max_length, format), checked and turned
' into SaveTo's checks, LoadFrom's read-backs and the ValidationError call.
sub RuleSuite( )
    dim as ustring hdr = Header( ) & "data_type = ""shop.Item""" & LF & "data_module = ""../shop""" & LF
    dim as ustring body = Ctl( "txtQty", "TextBox", "bind = ""Qty""" & LF & "required = true" & LF & "minimum = ""1""" & LF & "maximum = ""999""" & LF ) _
        & Ctl( "txtWhen", "TextBox", "bind = ""When""" & LF & "format = ""dd/MM/yyyy""" & LF & "max_length = 10" & LF ) _
        & Ctl( "nudPrice", "NumericUpDown", "bind = ""Price""" & LF & "maximum = ""500""" & LF ) _
        & Ctl( "dtDue", "DatePicker", "bind = ""Due""" & LF & "required = true" & LF & "minimum = ""2026-01-01""" & LF ) _
        & Ctl( "cboKind", "ComboBox", "bind = ""Kind""" & LF & "required = true" & LF ) _
        & Ctl( "chkVip", "CheckBox", "bind = ""Vip""" & LF ) _
        & Ctl( "lblTitle", "Label", "bind = ""Title""" & LF & "format = "".2f""" & LF )
    dim as FormDoc d
    Check( ReadForm( hdr & body, d ), "rules: the form parses" )
    dim as long q = FindControl( d, "txtQty" ), wn = FindControl( d, "txtWhen" )
    Check( d.Controls[q].Required andalso (d.Controls[q].Minimum = "1") andalso (d.Controls[q].Maximum = "999"), "rules: required, minimum, maximum read" )
    Check( (d.Controls[wn].Format = "dd/MM/yyyy") andalso (d.Controls[wn].MaxLength = 10), "rules: format, max_length read" )
    dim as ustring t1 = formfile.Render( d )
    Check( instr( t1, "bind = ""Qty""" & LF & "required = true" & LF & "minimum = ""1""" & LF & "maximum = ""999""" & LF ) > 0, "rules: written after bind", t1 )
    Check( instr( t1, "max_length = 10" & LF & "format = ""dd/MM/yyyy""" & LF ) > 0, "rules: max_length then format" )
    Check( instr( mid( t1, instr( t1, "chkVip" ) ), "required" ) = 0, "rules: none written when unset" )
    dim as FormDoc d2
    ReadForm( t1, d2 )
    Check( formfile.Render( d2 ) = t1, "rules: round trip" )

    Accepted( hdr & body, "a form with rules" )
    Refused( hdr & Ctl( "t", "TextBox", "required = true" & LF ), "t: Required needs Bind first" )
    Refused( hdr & Ctl( "t", "TextBox", "minimum = ""1""" & LF & "maximum = ""2""" & LF ), "t: Minimum Maximum need Bind first" )
    Refused( hdr & Ctl( "c", "CheckBox", "bind = ""V""" & LF & "required = true" & LF ), "a CheckBox has no Required rule" )
    Refused( hdr & Ctl( "n", "NumericUpDown", "bind = ""V""" & LF & "max_length = 3" & LF ), "a NumericUpDown has no MaxLength rule" )
    Refused( hdr & Ctl( "l", "Label", "bind = ""V""" & LF & "required = true" & LF ), "a Label has no Required rule" )
    Refused( hdr & Ctl( "k", "ColorPicker", "bind = ""V""" & LF & "required = true" & LF ), "a ColorPicker has no Required rule" )
    Refused( hdr & Ctl( "t", "TextBox", "bind = ""V""" & LF & "minimum = ""ten""" & LF ), "minimum 'ten' is not a number or a date" )
    Refused( hdr & Ctl( "n", "NumericUpDown", "bind = ""V""" & LF & "minimum = ""2026-01-01""" & LF ), "minimum '2026-01-01' is not a number" )
    Refused( hdr & Ctl( "d", "DatePicker", "bind = ""V""" & LF & "maximum = ""5""" & LF ), "maximum '5' is not a date (yyyy-mm-dd)" )
    Refused( hdr & Ctl( "t", "TextBox", "bind = ""V""" & LF & "minimum = ""1""" & LF & "maximum = ""2026-01-01""" & LF ), "must both be numbers or both dates" )
    Refused( hdr & Ctl( "t", "TextBox", "bind = ""V""" & LF & "minimum = ""10""" & LF & "maximum = ""2""" & LF ), "minimum 10 is above maximum 2" )
    Refused( hdr & Ctl( "t", "TextBox", "bind = ""V""" & LF & "max_length = -1" & LF ), "max length -1 is below 0" )
    Refused( hdr & Ctl( "t", "TextBox", "bind = ""V""" & LF & "format = ""abc""" & LF ), "format 'abc' is neither" )
    Accepted( hdr & Ctl( "t", "TextBox", "bind = ""V""" & LF & "minimum = ""-1.5e2""" & LF & "format = ""08d""" & LF ), "a negative exponent minimum, a number format" )

    dim as ustring t = codegen.Generate( d, "frmItem", "frmItem.tkform", "" )
    HasLine( t, "declare function SaveTo( byref r as shop.Item ) as boolean", "rules: SaveTo is a function" )
    HasLine( t, "tkBind_Check( bindErrors_, txtQty.Handle, ""Qty"", r.Qty, tkTextBox_GetText( txtQty.Handle ), tkBind_Rule( true, ""1"", ""999"", 0, """" ) )", "rules: a text box's check" )
    HasLine( t, "tkBind_Range( bindErrors_, txtQty.Handle, ""Qty"", r.Qty, tkTextBox_GetText( txtQty.Handle ), tkBind_Rule( true, ""1"", ""999"", 0, """" ) )", "rules: ...and its range" )
    Check( instr( t, "tkBind_Range( bindErrors_, txtWhen.Handle" ) = 0, "rules: no range without a minimum or maximum" )
    HasLine( t, "tkBind_Check( bindErrors_, cboKind.Handle, ""Kind"", r.Kind, clngint( tkComboBox_GetCurSel( cboKind.Handle ) ), tkBind_Rule( true, """", """", 0, """", true, -1 ) )", "rules: a combo's Required knows -1" )
    HasLine( t, "tkBind_Check( bindErrors_, nudPrice.Handle, ""Price"", r.Price, cdbl( tkNumericUpDown_GetValue( nudPrice.Handle ) ), tkBind_Rule( false, """", ""500"", 0, """" ) )", "rules: a number's check" )
    Check( instr( t, "tkBind_Check( bindErrors_, chkVip" ) = 0, "rules: a bool isn't checked" )
    Check( instr( t, "tkBind_Check( bindErrors_, lblTitle" ) = 0, "rules: a load-only control isn't checked" )
    HasLine( t, "tkTextBox_SetError( txtQty.Handle, bindErrors_.Has( txtQty.Handle ) )", "rules: a text box's error mark" )
    HasLine( t, "if bindHandled_ = false then tkBind_ShowErrors( Handle, bindErrors_, false )", "rules: SaveTo's report" )
    HasLine( t, "tkBind_Put( r.When, tkTextBox_GetText( txtWhen.Handle ), ""dd/MM/yyyy"" )", "rules: a write in the Format" )
    dim as long nCheck = instr( t, "tkBind_Check( bindErrors_, txtQty" ), nReport = instr( t, "tkBind_ShowErrors( Handle, bindErrors_, false )" )
    dim as long nWrite = instr( t, "tkBind_Put( r.Qty" )
    Check( (nCheck > 0) andalso (nReport > nCheck) andalso (nWrite > nReport), "rules: every check, the report, then the writes" )
    HasLine( t, "tkTextBox_SetText( txtWhen.Handle, tkBind_Text( r.When, ""dd/MM/yyyy"" ) )", "rules: a load in the Format" )
    HasLine( t, "tkLabel_SetText( lblTitle.Handle, tkBind_Text( r.Title, "".2f"" ) )", "rules: a label's Format" )
    HasLine( t, "tkBind_Loaded( bindErrors_, nudPrice.Handle, ""Price"", r.Price, cdbl( tkNumericUpDown_GetValue( nudPrice.Handle ) ) )", "rules: a number read back" )
    HasLine( t, "tkBind_Loaded( bindErrors_, dtDue.Handle, ""Due"", r.Due, tkDatePicker_GetDateValue( dtDue.Handle ) )", "rules: a date read back" )
    Check( instr( t, "tkBind_Loaded( bindErrors_, txtQty" ) = 0, "rules: text isn't read back" )
    HasLine( t, "tkTextBox_SetError( txtQty.Handle, false )", "rules: LoadFrom clears the mark" )
    HasLine( t, "if bindHandled_ = false then tkBind_ShowErrors( Handle, bindErrors_, true )", "rules: LoadFrom's report" )

    ' the form's ValidationError handler is called first; it alone pulls in tkBind
    dim as FormDoc dv
    ReadForm( hdr & LF & "[form.events]" & LF & "ValidationError = ""frm_Invalid""" & LF & body, dv )
    dim as ustring tv = codegen.Generate( dv, "frmItem", "frmItem.tkform", "" )
    HasLine( tv, "    frm_Invalid( bindErrors_, false, bindHandled_ )", "rules: the handler, on save" )
    HasLine( tv, "    frm_Invalid( bindErrors_, true, bindHandled_ )", "rules: ...and on load" )
    HasLine( tv, "declare sub frm_Invalid( byref Errors as TKBIND_ERRORS, byval Loading as boolean, byref Handled as boolean )", "rules: its declaration" )
    dim as FormDoc dn
    ReadForm( Header( ) & LF & "[form.events]" & LF & "ValidationError = ""frm_Invalid""" & LF & Ctl( "b", "Button" ), dn )
    dim as ustring tn = codegen.Generate( dn, "frmN", "frmN.tkform", "" )
    Check( (instr( tn, "#import ""vendor/tkControls/tkBind""" ) > 0) andalso (instr( tn, "LoadFrom" ) = 0), "rules: a handler with nothing bound imports tkBind, generates no LoadFrom" )
    Check( reconcile.ImportsFor( catalog.VALIDATION_PARAMS, "" ).Count( ) = 1 andalso (reconcile.ImportsFor( catalog.VALIDATION_PARAMS, "" )[0] = "tkBind"), _
        "rules: the user's handler file imports tkBind" )

    ' paste into a form with no DataType: the rules go with the field
    dim as ustring clip = edits.CopyText( d, Names( "txtQty" ) )
    dim as FormDoc noType
    ReadForm( Header( ), noType )
    dim as Array( of ustring ) added
    Check( edits.PasteText( noType, clip, "", -1, 0, 0, added ), "rules: paste into a form without a DataType" )
    with noType.Controls[noType.Controls.Count( ) - 1]
        Check( (len( .Bind ) = 0) andalso (.Required = false) andalso (len( .Minimum ) = 0) andalso (len( .Maximum ) = 0), "rules: ...drops them" )
    end with
end sub

' B3: list binding -- a ListTree's rows and a ComboBox's items from an Array( of T ), a DataType field
' (filled by LoadFrom) or an expression (filled by <name>_Fill), and a ComboBox bound by ValueField.
sub ListSuite( )
    dim as ustring hdr = Header( ) & "data_type = ""shop.Order""" & LF & "data_module = ""../shop""" & LF
    dim as ustring lst = Ctl( "lstLines", "ListTree", "items_field = ""Lines""" & LF & "item_type = ""shop.Line""" & LF & "check_field = ""Packed""" & LF ) _
        & LF & "[[control.items]]" & LF & "text = ""Item""" & LF & "field = ""Item""" & LF _
        & LF & "[[control.items]]" & LF & "text = ""Note""" & LF _
        & LF & "[[control.items]]" & LF & "text = ""Total""" & LF & "field = ""Total( )""" & LF
    dim as ustring cbo = Ctl( "cboCountry", "ComboBox", "bind = ""Country""" & LF & "required = true" & LF & "items_source = ""shop.Countries( )""" & LF _
        & "item_type = ""shop.Country""" & LF & "display_field = ""Name""" & LF & "value_field = ""Code""" & LF )
    dim as ustring cb2 = Ctl( "cboCarrier", "ComboBox", "bind = ""CarrierId""" & LF & "items_source = ""Carriers""" & LF & "item_type = ""shop.Carrier""" & LF & "display_field = ""Name""" & LF )
    dim as FormDoc d
    Check( ReadForm( hdr & lst & cbo & cb2, d ), "list: the form parses" )
    dim as long li = FindControl( d, "lstLines" ), ci = FindControl( d, "cboCountry" )
    Check( (d.Controls[li].ItemsField = "Lines") andalso (d.Controls[li].CheckField = "Packed") andalso (d.Controls[li].Items[2].Field = "Total( )"), "list: rows read" )
    Check( (d.Controls[ci].ItemsSource = "shop.Countries( )") andalso (d.Controls[ci].ItemType = "shop.Country") _
        andalso (d.Controls[ci].DisplayField = "Name") andalso (d.Controls[ci].ValueField = "Code"), "list: items read" )
    dim as ustring t1 = formfile.Render( d )
    Check( instr( t1, "items_source = ""shop.Countries( )""" & LF & "item_type = ""shop.Country""" & LF & "display_field = ""Name""" & LF & "value_field = ""Code""" & LF ) > 0, "list: written", t1 )
    Check( instr( t1, "text = ""Item""" & LF & "field = ""Item""" & LF ) > 0, "list: a column's field written" )
    dim as FormDoc d2
    ReadForm( t1, d2 )
    Check( formfile.Render( d2 ) = t1, "list: round trip" )

    Accepted( hdr & lst & cbo & cb2, "a form with lists" )
    Accepted( Header( ) & Ctl( "l", "ListTree", "items_source = ""People""" & LF & "item_type = ""db.Person""" & LF ) & LF & "[[control.items]]" & LF & "text = ""N""" & LF & "field = ""Name""" & LF, _
        "an ItemsSource needs no DataType" )
    Refused( hdr & Ctl( "b", "Button", "items_source = ""X""" & LF ), "a Button has no list to bind" )
    Refused( hdr & Ctl( "c", "ComboBox", "items_field = ""A""" & LF & "items_source = ""B""" & LF & "display_field = ""N""" & LF ), "ItemsField or ItemsSource, not both" )
    Refused( Header( ) & Ctl( "c", "ComboBox", "items_field = ""A""" & LF & "display_field = ""N""" & LF ), "an ItemsField needs the form's DataType first" )
    Refused( hdr & Ctl( "c", "ComboBox", "items_source = 'f( ""x"" )'" & LF & "display_field = ""N""" & LF ), "is not a name or a call" )
    Refused( hdr & Ctl( "c", "ComboBox", "items_source = ""f( (x )""" & LF & "display_field = ""N""" & LF ), "is not a name or a call" )
    ' a list filled in one row at a time: accepted half done, and the generated file says what it lacks
    Accepted( hdr & Ctl( "c", "ComboBox", "items_source = ""S""" & LF ), "a list with no ItemType yet" )
    dim as FormDoc dh
    ReadForm( hdr & Ctl( "c", "ComboBox", "items_source = ""S""" & LF & "item_type = ""T""" & LF ) & Ctl( "l", "ListTree", "items_source = ""S""" & LF & "item_type = ""T""" & LF ), dh )
    dim as ustring th = codegen.Generate( dh, "frmH", "frmH.tkform", "" )
    Check( (instr( th, "#error ""c: its list needs a DisplayField" ) > 0) andalso (instr( th, "#error ""l: its list needs a column with a Field" ) > 0) _
        andalso (instr( th, "c_Fill" ) = 0), "list: a half-done list generates an #error, no code", LineWith( th, "#error" ) )
    Refused( hdr & Ctl( "c", "ComboBox", "display_field = ""N""" & LF ), "DisplayField and ValueField need ItemsField or ItemsSource" )
    Refused( hdr & Ctl( "c", "ComboBox", "items_source = ""S""" & LF & "item_type = ""T""" & LF & "display_field = ""N""" & LF ) & LF & "[[control.items]]" & LF & "text = ""typed""" & LF, _
        "its items come from the list" )
    Refused( hdr & Ctl( "c", "ComboBox", "items_source = ""S""" & LF & "item_type = ""T""" & LF & "display_field = ""1N""" & LF ), "display field '1N' is not a field" )
    Refused( hdr & Ctl( "l", "ListTree", "items_source = ""S""" & LF & "item_type = ""T""" & LF & "display_field = ""N""" & LF ), "shows columns: give each column a Field" )
    Refused( hdr & Ctl( "l", "ListTree", "items_source = ""S""" & LF & "item_type = ""T""" & LF & "check_field = ""1Done""" & LF ) & LF & "[[control.items]]" & LF & "text = ""N""" & LF & "field = ""N""" & LF, _
        "check field '1Done' is not a field" )
    Refused( hdr & Ctl( "l", "ListTree", "items_source = ""S""" & LF & "item_type = ""T""" & LF ) & LF & "[[control.items]]" & LF & "text = ""N""" & LF & "field = ""N( x )""" & LF, "column field 'N( x )' is not a field" )
    Refused( hdr & Ctl( "l", "ListTree", "items_source = ""S""" & LF & "item_type = ""T""" & LF ) & LF & "[[control.items]]" & LF & "text = ""N""" & LF & "field = ""N""" & LF _
        & Ctl( "l_Fill", "Button" ), "l_Fill: the name is taken by l's list" )

    dim as ustring t = codegen.Generate( d, "frmShop", "frmShop.tkform", "" )
    HasLine( t, "cboCountry_Values_ as Array( of ustring )", "list: the values member" )
    HasLine( t, "declare sub cboCountry_Fill( )", "list: an ItemsSource's Fill" )
    Check( instr( t, "declare sub lstLines_Fill" ) = 0, "list: no Fill for an ItemsField (LoadFrom fills it)" )
    HasLine( t, "declare function lstLines_Item( ) as int32", "list: a ListTree's Item" )
    Check( (instr( t, "#import ""std/containers""" ) > 0) andalso (instr( t, LF & "using containers" & LF ) > 0), "list: containers for the arrays" )
    HasLine( t, "    dim as Array( of shop.Country ) a_ = shop.Countries( )", "list: a call's result copied once" )
    HasLine( t, "    dim byref as Array( of shop.Carrier ) a_ = Carriers", "list: a name bound by reference" )
    HasLine( t, "    dim byref as Array( of shop.Line ) a_ = r.Lines", "list: the DataType's field, in LoadFrom" )
    Accepted( hdr & Ctl( "c", "ComboBox", "items_source = ""S""" & LF & "display_field = ""N""" & LF ), "a list whose ItemType is still to come" )
    HasLine( t, "        dim as integer row_ = tkListTree_AddString( lstLines.Handle, tkBind_Text( a_[i_].Item ) )", "list: the first column" )
    Check( instr( t, "row_, 1," ) = 0, "list: a column with no field is left empty" )
    HasLine( t, "        tkListTree_SetCellText( lstLines.Handle, row_, 2, tkBind_Text( a_[i_].Total( ) ) )", "list: a method column" )
    HasLine( t, "        tkListTree_SetItemData( lstLines.Handle, row_, i_ )", "list: the row knows its element" )
    HasLine( t, "        tkListTree_SetCheck( lstLines.Handle, row_, iif( tkBind_Bool( a_[i_].Packed ), 1, 0 ) )", "list: the check" )
    HasLine( t, "    tkListTree_SetCheckBoxes( lstLines.Handle, true )", "list: a CheckField turns the check boxes on" )
    HasLine( t, "        tkComboBox_AddItem( cboCountry.Handle, tkBind_Text( a_[i_].Name ) )", "list: an item's text" )
    HasLine( t, "        cboCountry_Values_.Push( tkBind_Text( a_[i_].Code ) )", "list: its value" )
    Check( instr( t, "cboCarrier_Values_" ) = 0, "list: no ValueField, no values" )
    HasLine( t, "tkComboBox_SetCurSel( cboCountry.Handle, tkBind_IndexOf( cboCountry_Values_, tkBind_Text( r.Country ) ) )", "list: LoadFrom by value" )
    HasLine( t, "tkBind_LoadedPick( bindErrors_, cboCountry.Handle, ""Country"", tkBind_Text( r.Country ), tkComboBox_GetCurSel( cboCountry.Handle ) )", "list: a value not in the list reported" )
    HasLine( t, "tkBind_CheckPick( bindErrors_, cboCountry.Handle, ""Country"", r.Country, cboCountry_Values_, tkComboBox_GetCurSel( cboCountry.Handle ), tkBind_Rule( true, """", """", 0, """", true, -1 ) )", "list: SaveTo checks the value" )
    HasLine( t, "tkBind_PutPick( r.Country, cboCountry_Values_, tkComboBox_GetCurSel( cboCountry.Handle ) )", "list: SaveTo writes the value" )
    HasLine( t, "tkComboBox_SetCurSel( cboCarrier.Handle, tkBind_Int( r.CarrierId ) )", "list: no ValueField binds the index, as B1" )
    HasLine( t, "return tkListTree_GetItemData( lstLines.Handle, row_ )", "list: Item maps the row" )
    Check( (instr( t, "tkBind_Check( bindErrors_, lstLines" ) = 0) andalso (instr( t, "tkBind_Put( r.Lines" ) = 0), "list: a ListTree has no value of its own to bind" )

    ' an ItemsSource alone: Fill and Item, no LoadFrom
    dim as FormDoc dm
    ReadForm( Header( ) & "data_module = ""../db""" & LF & Ctl( "l", "ListTree", "items_source = ""People""" & LF & "item_type = ""db.Person""" & LF ) _
        & LF & "[[control.items]]" & LF & "text = ""N""" & LF & "field = ""FullName( )""" & LF, dm )
    dim as ustring tm = codegen.Generate( dm, "frmMain", "frmMain.tkform", "" )
    Check( (instr( tm, "sub Form.l_Fill( )" ) > 0) andalso (instr( tm, "LoadFrom" ) = 0) andalso (instr( tm, "#import ""vendor/tkControls/tkBind""" ) > 0) _
        andalso (instr( tm, "#import ""../db""" ) > 0), "list: an ItemsSource form without a DataType: Fill, tkBind, its DataModule, no LoadFrom" )

    ' paste into a form with no DataType: an ItemsField goes, with what hangs on it
    dim as ustring clip = edits.CopyText( d, Names( "lstLines" ) )
    dim as FormDoc noType
    ReadForm( Header( ), noType )
    dim as Array( of ustring ) added
    Check( edits.PasteText( noType, clip, "", -1, 0, 0, added ), "list: paste into a form without a DataType" )
    with noType.Controls[noType.Controls.Count( ) - 1]
        Check( (len( .ItemsField ) = 0) andalso (len( .CheckField ) = 0) andalso (len( .Items[0].Field ) = 0), "list: ...drops the list" )
    end with
end sub

' B4: the record navigator -- its records (ItemsSource), the list it follows, the generated IsDirty /
' MoveTo / Refresh / Go_, and its thunks.
' The checked-list controls (claude-docs CHECKED-LISTS.md, C2b / C3b / C4b): a text bind (the chosen
' keys) and a keyed "items" fill -- ValueField is each item's key, so no _Values_ member and no index
' mapping; design-time items through each control's own AddItem.
sub KeyedListSuite( )
    dim as ustring hdr = Header( ) & "data_type = ""shop.Order""" & LF & "data_module = ""../shop""" & LF
    dim as ustring src = hdr _
        & Ctl( "cboTags", "CheckedComboBox", "bind = ""Tags""" & LF & "items_source = ""shop.AllTags( )""" & LF & "item_type = ""shop.Tag""" & LF _
            & "display_field = ""Name""" & LF & "value_field = ""Code""" & LF ) _
        & Ctl( "lstDays", "CheckedList", "bind = ""Days""" & LF ) & LF & "[[control.items]]" & LF & "text = ""Mon""" & LF _
        & Ctl( "tokPeople", "TokenBox", "bind = ""People""" & LF ) & LF & "[[control.items]]" & LF & "text = ""Ann""" & LF
    Check( (catalog.ItemsKindOf( "CheckedList" ) = catalog.ItemsKind.ItemsList) andalso (catalog.ItemsKindOf( "TokenBox" ) = catalog.ItemsKind.ItemsList), _
        "keyed: their items are a text list" )
    Accepted( src, "keyed: a form with the three bound" )
    dim as FormDoc d
    ReadForm( src, d )
    dim as ustring g = codegen.Generate( d, "frmTags", "frmTags.tkform", src )
    HasLine( g, "    tkCheckedCombo_Clear( cboTags.Handle )", "keyed: the control's own Clear" )
    HasLine( g, "        tkCheckedCombo_AddItem( cboTags.Handle, tkBind_Text( a_[i_].Name ), tkBind_Text( a_[i_].Code ) )", "keyed: ValueField is the key" )
    Check( instr( g, "cboTags_Values_" ) = 0, "keyed: no values member" )
    HasLine( g, "tkCheckedCombo_SetCheckedText( cboTags.Handle, tkBind_Text( r.Tags ) )", "keyed: LoadFrom sets the chosen keys" )
    HasLine( g, "tkBind_Put( r.Tags, tkCheckedCombo_GetCheckedText( cboTags.Handle ) )", "keyed: SaveTo reads them" )
    HasLine( g, "tkCheckedList_AddItem( lstDays.Handle, ""Mon"" )", "keyed: a CheckedList's design-time item" )
    HasLine( g, "tkTokenBox_AddItem( tokPeople.Handle, ""Ann"" )", "keyed: a TokenBox's design-time suggestion" )
end sub

' A5 (docs/tkControls/AUTOCOMPLETE.md section 10.4): an AutoComplete binds its text (bind) and, as a
' lookup, its item's id (bind2 BindValue, ValuePolicy=LimitToList); its list fills with ValueField
' as each item's numeric id.
sub AutoCompleteSuite( )
    dim as ustring hdr = Header( ) & "data_type = ""shop.Order""" & LF & "data_module = ""../shop""" & LF
    dim as ustring lookup = LF & "[control.props]" & LF & "ValuePolicy = ""LimitToList""" & LF
    dim as ustring src = hdr _
        & Ctl( "acCountry", "AutoComplete", "bind = ""CountryName""" & LF & "bind2 = ""CountryId""" & LF _
            & "items_source = ""shop.Countries( )""" & LF & "item_type = ""shop.Country""" & LF _
            & "display_field = ""Name""" & LF & "value_field = ""Id""" & LF ) & lookup _
        & Ctl( "acCity", "AutoComplete", "bind = ""City""" & LF ) & LF & "[[control.items]]" & LF & "text = ""Oslo""" & LF
    Check( (catalog.ItemsKindOf( "AutoComplete" ) = catalog.ItemsKind.ItemsList) andalso catalog.ItemsIdKeyed( "AutoComplete" ), _
        "autocomplete: a text list keyed by id" )
    Accepted( src, "autocomplete: a lookup and a free-text box, bound" )
    Refused( hdr & Ctl( "ac", "AutoComplete", "bind = ""A""" & LF & "bind2 = ""B""" & LF ), "BindValue needs ValuePolicy=LimitToList" )
    dim as FormDoc d
    ReadForm( src, d )
    dim as ustring g = codegen.Generate( d, "frmOrder", "frmOrder.tkform", src )
    HasLine( g, "        tkAutoComplete_AddItem( acCountry.Handle, tkBind_Text( a_[i_].Name ), tkBind_Int( a_[i_].Id ) )", _
        "autocomplete: ValueField is each item's id" )
    Check( instr( g, "acCountry_Values_" ) = 0, "autocomplete: no values member" )
    dim as long l1 = instr( g, "tkAutoComplete_SetText( acCountry.Handle, tkBind_Text( r.CountryName ) )" )
    dim as long l2 = instr( g, "tkAutoComplete_SetSelectedId( acCountry.Handle, tkBind_Int( r.CountryId ) )" )
    Check( (l1 > 0) andalso (l2 > l1), "autocomplete: LoadFrom sets the text, then the id", LineWith( g, "acCountry" ) )
    Check( instr( g, "tkBind_Put( r.CountryId, clngint( tkAutoComplete_GetSelectedId( acCountry.Handle ) ) )" ) > 0, _
        "autocomplete: SaveTo reads the id", LineWith( g, "tkBind_Put" ) )
    HasLine( g, "tkAutoComplete_AddItem( acCity.Handle, ""Oslo"" )", "autocomplete: a design-time item" )
end sub

' Rating, Badge, Avatar, AvatarGroup, Chip, ChipGroup (claude-docs RATING-BADGE-AVATAR-CHIP.md, phase D):
' their bind lines, the load-only ones not saved, ChipGroup's bind2, the props' order, an answering event.
sub RbacSuite( )
    dim as ustring hdr = Header( ) & "data_type = ""crm.Contact""" & LF & "data_module = ""../crm""" & LF
    dim as ustring src = hdr _
        & Ctl( "rtg", "Rating", "bind = ""Stars""" & LF ) & LF & "[control.props]" & LF & "Value = 4" & LF & "ItemCount = 10" & LF _
        & Ctl( "bdg", "Badge", "bind = ""Unread""" & LF ) & LF & "[control.props]" & LF & "Kind = ""Count""" & LF & "Text = ""x""" & LF _
        & Ctl( "avt", "Avatar", "bind = ""FullName""" & LF & "bind2 = ""PhotoPath""" & LF ) _
        & Ctl( "avg", "AvatarGroup" ) _
        & Ctl( "chp", "Chip", "bind = ""Vip""" & LF ) & LF & "[control.props]" & LF & "Kind = ""Toggle""" & LF _
        & Ctl( "chg", "ChipGroup", "bind = ""Picked""" & LF & "bind2 = ""Tags""" & LF ) & LF & "[control.events]" & LF & "ItemRemoving = ""chg_Removing""" & LF
    Accepted( src, "rbac: the six controls, bound" )
    dim as FormDoc d
    ReadForm( src, d )
    dim as ustring g = codegen.Generate( d, "frmC", "frmC.tkform", src )
    HasLine( g, "tkRating_SetValue( rtg.Handle, tkBind_Float( r.Stars ) )", "rbac: Rating loads a float" )
    HasLine( g, "tkBind_Put( r.Stars, cdbl( tkRating_GetValue( rtg.Handle ) ) )", "rbac: Rating saves it" )
    HasLine( g, "tkBadge_SetCount( bdg.Handle, tkBind_Int( r.Unread ) )", "rbac: Badge loads its count" )
    Check( instr( g, "tkBind_Put( r.Unread" ) = 0, "rbac: ...load only, never saved" )
    HasLine( g, "tkAvatar_SetDisplayName( avt.Handle, tkBind_Text( r.FullName ) )", "rbac: Avatar loads the name" )
    HasLine( g, "tkAvatar_SetImageFile( avt.Handle, tkBind_Text( r.PhotoPath ) )", "rbac: ...and the picture (BindImage)" )
    Check( instr( g, "tkBind_Put( r.FullName" ) = 0, "rbac: the name is load only" )
    HasLine( g, "tkChip_SetSelected( chp.Handle, tkBind_Bool( r.Vip ) )", "rbac: Chip loads a bool" )
    HasLine( g, "tkBind_Put( r.Vip, tkChip_GetSelected( chp.Handle ) )", "rbac: Chip saves it" )
    dim as long l1 = instr( g, "tkChipGroup_SetSelectedKeys( chg.Handle, tkBind_Text( r.Picked ) )" )
    dim as long l2 = instr( g, "tkChipGroup_SetItemsText( chg.Handle, tkBind_Text( r.Tags ) )" )
    Check( (l1 > 0) andalso (l2 > l1), "rbac: ChipGroup loads its keys, then its items (they commute)", LineWith( g, "chg.Handle" ) )
    HasLine( g, "tkBind_Put( r.Tags, tkChipGroup_GetItemsText( chg.Handle ) )", "rbac: ChipGroup saves its items" )
    dim as long nCount = instr( g, "    rtg.ItemCount = 10" ), nVal = instr( g, "    rtg.Value = 4" )
    Check( (nCount > 0) andalso (nVal > nCount), "rbac: Rating's ItemCount before its Value", nCount & " " & nVal )
    dim as long nText = instr( g, "    bdg.Text = ""x""" ), nKind = instr( g, "    bdg.Kind = TKBADGE_KIND_COUNT" )
    Check( (nText > 0) andalso (nKind > nText), "rbac: Badge's Kind after its content", nText & " " & nKind )
    HasLine( g, "chp.Kind = TKCHIP_TOGGLE", "rbac: an enum prop is its constant" )
    HasLine( g, "bdg.GlyphFont = tkForm_Font( Handle, TKFONT_GLYPH )", "rbac: a glyph-drawing control gets the form's glyph font" )
    Check( instr( g, "    dim as boolean Allow = true" & LF ) > 0, "rbac: ItemRemoving's Allow starts true" )

    ' a Badge hung on another control (D-B3), and an AvatarGroup's designed items
    dim as ustring sa = Header( ) _
        & Ctl( "bdgA", "Badge", "attach_to = ""btnIn""" & LF & "attach_corner = ""BottomLeft""" & LF & "attach_offset = ""2,-3""" & LF & "attach_overlap = ""Circle""" & LF ) _
        & Ctl( "btnIn", "Button" ) _
        & Ctl( "avgI", "AvatarGroup" ) & LF & "[[control.items]]" & LF & "text = ""Ada Lovelace""" & LF & LF & "[[control.items]]" & LF & "text = ""Alan Turing""" & LF
    Accepted( sa, "attach: a Badge on a Button, and a group's items" )
    dim as FormDoc da
    ReadForm( sa, da )
    dim as FormDoc da2
    ReadForm( formfile.Render( da ), da2 )
    Check( formfile.Render( da2 ) = formfile.Render( da ) andalso da2.Controls[0].AttachTo = "btnIn" andalso da2.Controls[0].AttachOffset = "2,-3", _
           "attach: the four attach keys round-trip" )
    dim as ustring ga = codegen.Generate( da, "frmA", "frmA.tkform", sa )
    dim as long nAt = instr( ga, "    tkBadge_Attach( bdgA.Handle, btnIn.Handle, TKBADGE_BOTTOM_LEFT, 2, -3, TKBADGE_OVERLAP_CIRCLE )" )
    Check( (nAt > instr( ga, "btnIn.Create(" )) andalso (instr( ga, "btnIn.Create(" ) > 0) andalso (instr( ga, "tkLayout_Add( Layout, bdgA.Handle" ) = 0), _
           "attach: tkBadge_Attach once the target exists, and no layout entry for the badge", LineWith( ga, "bdgA" ) )
    HasLine( ga, "tkAvatarGroup_AddItem( avgI.Handle, ""Alan Turing"" )", "attach: an AvatarGroup's designed items" )
    Refused( Header( ) & Ctl( "bdgS", "Badge", "attach_to = ""bdgS""" & LF ), "can't attach to itself" )
    Refused( Header( ) & Ctl( "b1", "Badge", "attach_to = ""b2""" & LF ) & Ctl( "b2", "Badge" ), "another Badge" )
    Refused( Header( ) & Ctl( "b1", "Badge", "attach_to = ""nope""" & LF ), "which is not on the form" )
    Refused( Header( ) & Ctl( "btnX", "Button", "attach_to = ""btnIn""" & LF ) & Ctl( "btnIn", "Button" ), "only a Badge attaches" )
    Refused( Header( ) & Ctl( "b1", "Badge", "attach_to = ""btnIn""" & LF & "attach_offset = ""2""" & LF ) & Ctl( "btnIn", "Button" ), "AttachOffset is two whole numbers" )
    edits.RenameControl( da, "btnIn", "btnInbox" )
    dim as boolean renamed = (da.Controls[0].AttachTo = "btnInbox")
    dim as Array( of ustring ) gone
    gone.Push( "btnInbox" )
    edits.DeleteControls( da, gone )
    Check( renamed andalso (da.Controls[0].AttachTo = ""), "attach: a rename of the target follows; deleting it leaves the badge on nothing" )
end sub

sub NavSuite( )
    dim as ustring hdr = Header( ) & "data_type = ""pd.Person""" & LF & "data_module = ""../pd""" & LF
    dim as ustring lst = Ctl( "lstP", "ListTree", "items_source = ""People""" & LF & "item_type = ""pd.Person""" & LF ) _
        & LF & "[[control.items]]" & LF & "text = ""Name""" & LF & "field = ""Name""" & LF
    dim as ustring boxes = Ctl( "txtName", "TextBox", "bind = ""Name""" & LF & "format = """"" & LF ) _
        & Ctl( "chkVip", "CheckBox", "bind = ""Vip""" & LF ) & Ctl( "nudAge", "NumericUpDown", "bind = ""Age""" & LF )
    dim as ustring nav = Ctl( "navP", "Navigator", "items_source = ""People""" & LF & "follows = ""lstP""" & LF )
    dim as FormDoc d
    Check( ReadForm( hdr & lst & boxes & nav, d ), "nav: the form parses" )
    Check( d.Controls[FindControl( d, "navP" )].Follows = "lstP", "nav: follows read" )
    dim as ustring t1 = formfile.Render( d )
    Check( instr( t1, "items_source = ""People""" & LF & "follows = ""lstP""" & LF ) > 0, "nav: follows written", t1 )
    dim as FormDoc d2
    ReadForm( t1, d2 )
    Check( formfile.Render( d2 ) = t1, "nav: round trip" )

    Accepted( hdr & lst & boxes & nav, "a navigator following a list" )
    Accepted( hdr & Ctl( "n", "Navigator" ), "a navigator with no records yet" )
    Refused( hdr & lst & Ctl( "b", "Button", "follows = ""lstP""" & LF ), "only a Navigator follows a list" )
    Refused( hdr & Ctl( "n", "Navigator", "items_source = ""pd.All( )""" & LF ), "a name (People), not 'pd.All( )'" )
    Refused( Header( ) & Ctl( "n", "Navigator", "items_source = ""People""" & LF ), "a Navigator needs the form's DataType first" )
    Refused( hdr & Ctl( "n", "Navigator", "follows = ""lstP""" & LF ) & lst, "Follows needs the Navigator's ItemsSource first" )
    Refused( hdr & Ctl( "n", "Navigator", "items_source = ""People""" & LF & "follows = ""lstX""" & LF ), "follows 'lstX', which is not on the form" )
    Refused( hdr & Ctl( "b", "Button" ) & Ctl( "n", "Navigator", "items_source = ""People""" & LF & "follows = ""b""" & LF ), "which is no ListTree, ComboBox or DataGrid" )
    Refused( hdr & lst & Ctl( "n", "Navigator", "items_source = ""Others""" & LF & "follows = ""lstP""" & LF ), "whose ItemsSource is not Others" )
    Refused( hdr & Ctl( "n", "Navigator", "items_source = ""People""" & LF & "display_field = ""Name""" & LF ), "a Navigator takes ItemsSource (its records) and Follows" )
    Refused( hdr & Ctl( "n", "Navigator" ) & Ctl( "m", "Navigator" ), "a form has one Navigator" )
    Refused( hdr & nav & lst & Ctl( "navP_MoveTo", "Button" ), "navP_MoveTo: the name is taken by navP's records" )
    Refused( hdr & Ctl( "IsDirty", "Button" ), "control 'IsDirty' is already a member of every form" )

    dim as ustring t = codegen.Generate( d, "frmP", "frmP.tkform", "" )
    HasLine( t, "declare function IsDirty( byref r as pd.Person ) as boolean", "nav: IsDirty declared" )
    HasLine( t, "declare function navP_MoveTo( byval i as int32 ) as boolean", "nav: MoveTo declared" )
    HasLine( t, "declare sub navP_Refresh( )", "nav: Refresh declared" )
    HasLine( t, "declare sub navP_FromList_( )", "nav: FromList_ declared" )
    HasLine( t, "if tkBind_Differs( r.Name, tkTextBox_GetText( txtName.Handle ), """" ) then return true", "nav: IsDirty asks a text box" )
    HasLine( t, "if tkBind_Differs( r.Vip, tkCheckBox_GetChecked( chkVip.Handle ) ) then return true", "nav: ...a check box" )
    HasLine( t, "if tkBind_Differs( r.Age, cdbl( tkNumericUpDown_GetValue( nudAge.Handle ) ) ) then return true", "nav: ...a number" )
    HasLine( t, "dim byref as Array( of pd.Person ) a_ = People", "nav: the records by reference" )
    HasLine( t, "if SaveTo( a_[cur] ) = false then return false", "nav: a changed record is saved first, and may refuse" )
    HasLine( t, "navP_ListRow_( cur )", "nav: ...and its row updated" )
    HasLine( t, "tkListTree_SetCurSel( lstP.Handle, i )", "nav: the list follows a move" )
    HasLine( t, "tkListTree_SetCellText( lstP.Handle, i, 0, tkBind_Text( a_[i].Name ) )", "nav: a row's cells from its record" )
    HasLine( t, "lstP_Fill( )", "nav: Refresh refills the list" )
    HasLine( t, "a_.Push( blank_ )", "nav: New appends a blank record" )
    HasLine( t, "a_.Remove( cur )", "nav: Delete removes the current one" )
    HasLine( t, "tkNavigator_SetNavigateCallback( navP.Handle, @Thunk_navP_Navigate )", "nav: Navigate wired with no handler" )
    HasLine( t, "tkListTree_SetSelChangeCallback( lstP.Handle, @Thunk_lstP_SelChange )", "nav: the list's SelChange wired with no handler" )
    Check( instr( t, "    if Allow then f->navP_Go_( action, target )" & LF & "    return false" ) > 0, "nav: the thunk goes, and the navigator takes nothing itself" )
    HasLine( t, "f->navP_FromList_( )", "nav: the list's thunk moves the navigator" )

    ' a user's handlers: Navigate's first (it may say no), the list's after the move
    dim as FormDoc dh
    ReadForm( hdr & lst & LF & "[control.events]" & LF & "SelChange = ""lstP_Sel""" & LF & boxes & nav & LF & "[control.events]" & LF & "Navigate = ""navP_Nav""" & LF, dh )
    dim as ustring th = codegen.Generate( dh, "frmP", "frmP.tkform", "" )
    dim as long a1 = instr( th, "    f->navP_Nav( action, target, Allow )" ), a2 = instr( th, "    if Allow then f->navP_Go_( action, target )" )
    Check( (a1 > 0) andalso (a2 > a1), "nav: the Navigate handler runs before the go", LineWith( th, "navP_Nav" ) )
    dim as long b1 = instr( th, "    f->navP_FromList_( )" ), b2 = instr( th, "    f->lstP_Sel( row )" )
    Check( (b1 > 0) andalso (b2 > b1), "nav: the list handler runs after the follow", LineWith( th, "lstP_Sel" ) )

    ' a navigator with no list, and one with no records yet
    dim as FormDoc dn
    ReadForm( hdr & boxes & Ctl( "navP", "Navigator", "items_source = ""People""" & LF ), dn )
    dim as ustring tn = codegen.Generate( dn, "frmP", "frmP.tkform", "" )
    Check( (instr( tn, "navP_MoveTo" ) > 0) andalso (instr( tn, "FromList_" ) = 0) andalso (instr( tn, "ListRow_" ) = 0), "nav: no list, no list code" )
    dim as FormDoc de
    ReadForm( hdr & boxes & Ctl( "navP", "Navigator" ), de )
    Check( instr( codegen.Generate( de, "frmP", "frmP.tkform", "" ), "navP_MoveTo" ) = 0, "nav: no records, no wiring" )
end sub

' G5: a DataGrid in the designer -- its columns (caption, width, kind, field), its list from an
' Array( of T ) filled by LoadFrom and written back by SaveTo, and examples/tkControls/tkGridForm's
' generated form, kept current here (--accept rewrites it). One check per behaviour.
sub DataGridSuite( byval bAccept as boolean )
    Check( catalog.ItemsKindOf( "DataGrid" ) = catalog.ItemsKind.ItemsGridColumns, "datagrid: its columns are a list of entries" )
    dim as ustring hdr = Header( ) & "data_type = ""shop.Order""" & LF & "data_module = ""../shop""" & LF
    Refused( hdr & Ctl( "g", "DataGrid" ) & LF & "[[control.items]]" & LF & "text = ""N""" & LF & "kind = ""spin""" & LF, "no DataGrid column kind 'spin'" )
    Refused( hdr & Ctl( "g", "DataGrid", "items_field = ""Lines""" & LF & "item_type = ""shop.Line""" & LF & "check_field = ""Paid""" & LF ) _
        & LF & "[[control.items]]" & LF & "text = ""N""" & LF & "field = ""N""" & LF, "a DataGrid has no CheckField" )
    dim as FormDoc dh
    ReadForm( hdr & Ctl( "g", "DataGrid", "items_field = ""Lines""" & LF & "item_type = ""shop.Line""" & LF ) & LF & "[[control.items]]" & LF & "text = ""N""" & LF, dh )
    Check( instr( codegen.Generate( dh, "frmH", "frmH.tkform", "" ), "a column with a Field" ) > 0, "datagrid: a list with no column Field yet says so" )

    ' the fixture: examples/tkControls/tkGridForm/frmGrid
    const as string dir_ = "../../../examples/tkControls/tkGridForm/frmGrid/"
    dim as ustring none
    dim as ustring src = fs.ReadAllText( dir_ & "frmGrid.tkform" ).ValueOr( none )
    dim as FormDoc d
    Check( (len( src ) > 0) andalso ReadForm( src, d ), "datagrid: the tkGridForm fixture parses" )
    dim as Array( of ustring ) p
    validate.Check( d, "frmGrid", p )
    dim as ustring first_
    if p.Count( ) then first_ = p[0]
    Check( p.Count( ) = 0, "datagrid: the fixture validates", first_ )
    dim as ustring t = codegen.Generate( d, "frmGrid", "frmGrid.tkform", src )
    if bAccept then fs.WriteAllText( dir_ & "frmGrid.design.tiko", t )
    Check( fs.ReadAllText( dir_ & "frmGrid.design.tiko" ).ValueOr( none ) = t, "datagrid: tkGridForm's generated form is current" )
    HasLine( t, "tkDataGrid_AddColumnEx( grdLines.Handle, ""Qty"", TKDG_COL_NUMBER, 60 )", "datagrid: a column in its kind" )
    HasLine( t, "        tkDataGrid_SetCellFloat( grdLines.Handle, i_, 1, tkBind_Float( a_[i_].Qty ) )", "datagrid: LoadFrom fills a cell through tkBind" )
    HasLine( t, "        tkBind_Put( a_[i_].Due, tkDataGrid_GetCellDate( grdLines.Handle, i_, 4 ) )", "datagrid: SaveTo writes a cell back" )
    Check( instr( t, "tkBind_Put( a_[i_].Total( )" ) = 0, "datagrid: a method column is not written back" )
    HasLine( t, "if tkDataGrid_EndEdit( grdLines.Handle, true ) = false then return false", "datagrid: SaveTo commits an open edit first" )
    HasLine( t, "declare function grdLines_Item( ) as int32", "datagrid: _Item( )" )
    HasLine( t, "tkDataGrid_SetColumnReadOnly( grdLines.Handle, 5, true )", "datagrid: a method column is read-only" )
    ' the column settings past Text / Width / Kind / Field: read, validated, written back, generated
    Refused( hdr & Ctl( "g", "DataGrid" ) & LF & "[[control.items]]" & LF & "text = ""N""" & LF & "align = ""middle""" & LF, "no DataGrid column align 'middle'" )
    dim as FormDoc dc
    Check( ReadForm( hdr & Ctl( "g", "DataGrid" ) & LF & "[[control.items]]" & LF & "text = ""N""" & LF & "align = ""right""" & LF & "min_width = 40" & LF _
        & "fill = 2" & LF & "read_only = true" & LF & "hidden = true" & LF, dc ) andalso (dc.Controls[0].Items[0].Fill = 2) andalso dc.Controls[0].Items[0].Hidden, _
        "datagrid: a column's align, min_width, fill, read_only, hidden read" )
    Check( instr( formfile.Render( dc ), "align = ""right""" & LF & "min_width = 40" & LF & "fill = 2" & LF & "read_only = true" & LF & "hidden = true" ) > 0, "datagrid: ... and written back" )
    dim as ustring tc = codegen.Generate( dc, "frmC", "frmC.tkform", "" )
    Check( (instr( tc, "c_.align = TKDG_ALIGN_RIGHT" ) > 0) andalso (instr( tc, "c_.minWidth = 40" ) > 0) andalso (instr( tc, "c_.fillWeight = 2" ) > 0) _
        andalso (instr( tc, "c_.readOnly = true" ) > 0) andalso (instr( tc, "c_.visible = false" ) > 0) andalso (instr( tc, "tkDataGrid_SetColumnInfo( g.Handle, 0, c_ )" ) > 0), _
        "datagrid: ... and set on the column", tc )
    ' G7b: a column's footer total
    Refused( hdr & Ctl( "g", "DataGrid" ) & LF & "[[control.items]]" & LF & "text = ""N""" & LF & "summary = ""total""" & LF, "no DataGrid column summary 'total'" )
    dim as FormDoc ds
    Check( ReadForm( hdr & Ctl( "g", "DataGrid" ) & LF & "[[control.items]]" & LF & "text = ""N""" & LF & "summary = ""avg""" & LF, ds ) _
        andalso (ds.Controls[0].Items[0].Summary = "avg"), "datagrid: a column's summary read" )
    Check( instr( formfile.Render( ds ), "summary = ""avg""" ) > 0, "datagrid: ... and written back" )
    dim as ustring tsum = codegen.Generate( ds, "frmS", "frmS.tkform", "" )
    Check( (instr( tsum, "c_.summary = TKDG_SUM_AVG" ) > 0) andalso (instr( tsum, "tkDataGrid_SetColumnInfo( g.Handle, 0, c_ )" ) > 0), _
        "datagrid: ... and set on the column", tsum )

    ' G5b: ItemsLive -- the grid shows the array in place, through generated source procedures
    Refused( hdr & Ctl( "l", "ListTree", "items_live = true" & LF ), "only a DataGrid shows its array in place" )
    Refused( hdr & Ctl( "g", "DataGrid", "items_source = ""shop.All( )""" & LF & "item_type = ""shop.Line""" & LF & "items_live = true" & LF ) _
        & LF & "[[control.items]]" & LF & "text = ""N""" & LF & "field = ""N""" & LF, "a live grid's ItemsSource must be an array it can change" )
    const as string dirL = "../../../examples/tkControls/tkGridForm/frmLive/"
    dim as ustring srcL = fs.ReadAllText( dirL & "frmLive.tkform" ).ValueOr( none )
    dim as FormDoc dl
    Check( (len( srcL ) > 0) andalso ReadForm( srcL, dl ) andalso dl.Controls[0].ItemsLive, "datagrid: the live fixture parses, items_live read" )
    dim as Array( of ustring ) pl
    validate.Check( dl, "frmLive", pl )
    dim as ustring firstL
    if pl.Count( ) then firstL = pl[0]
    Check( pl.Count( ) = 0, "datagrid: the live fixture validates", firstL )
    dim as ustring tl = codegen.Generate( dl, "frmLive", "frmLive.tkform", srcL )
    if bAccept then fs.WriteAllText( dirL & "frmLive.design.tiko", tl )
    Check( fs.ReadAllText( dirL & "frmLive.design.tiko" ).ValueOr( none ) = tl, "datagrid: tkGridForm's live form is current" )
    Check( instr( formfile.Render( dl ), "items_live = true" ) > 0, "datagrid: items_live written back" )
    HasLine( tl, "    tkDataGrid_SetSource( grdLines.Handle, @src_ )", "datagrid: a live grid binds a source" )
    HasLine( tl, "case 1 : tkBind_Put( a_[row_].Qty, v_.f )", "datagrid: a live edit lands in the field" )
    HasLine( tl, "    if tkDataGrid_GetSourceContext( grdLines.Handle ) <> cptr( any ptr, @a_ ) then", "datagrid: SaveTo copies only another array" )

    ' a Navigator following a grid of its records; IsDirty over a grid of the record's lines
    const as string dirN = "../../../examples/tkControls/tkGridForm/frmNav/"
    dim as ustring srcN = fs.ReadAllText( dirN & "frmNav.tkform" ).ValueOr( none )
    dim as FormDoc dn
    Check( (len( srcN ) > 0) andalso ReadForm( srcN, dn ), "datagrid: the navigator fixture parses" )
    dim as Array( of ustring ) pn
    validate.Check( dn, "frmNav", pn )
    dim as ustring firstN
    if pn.Count( ) then firstN = pn[0]
    Check( pn.Count( ) = 0, "datagrid: a navigator may follow a DataGrid", firstN )
    dim as ustring tn = codegen.Generate( dn, "frmNav", "frmNav.tkform", srcN )
    if bAccept then fs.WriteAllText( dirN & "frmNav.design.tiko", tn )
    Check( fs.ReadAllText( dirN & "frmNav.design.tiko" ).ValueOr( none ) = tn, "datagrid: tkGridForm's navigator form is current" )
    Check( instr( tn, "private sub Thunk_grdOrders_CurrentCellChanged(" ) > 0, "datagrid: the followed grid's CurrentCellChanged moves the navigator" )
    HasLine( tn, "if tkDataGrid_IsEditing( grdLines.Handle ) then return true", "datagrid: IsDirty counts a grid's open edit" )
end sub

