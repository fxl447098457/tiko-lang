' designall -- the Form Designer's core, with no window: the file's round trip, validation, the
' generator's output against a golden, the folder walk.
'   designall            run everything, from src/design
'   designall --accept   rewrite the golden from the generator
' exit code = failures; last line "designall selftest: N passed, M failed"
#import "std/containers"
#import "std/fs"
#import "std/strings"
#import "tkd/model"
#import "tkd/formfile"
#import "tkd/validate"
#import "tkd/codegen"
#import "tkd/formtree"
#import "tkd/themefile"
#import "tkd/resfile"
#import "tkd/langfile"
#import "tkd/appicon"
#import "tkd/glyphfile"
#import "tkd/fontwriter"
#import "tkd/canvas"
#import "tkd/edits"
#import "tkd/reconcile"
#import "tkd/catalog"
#import "tkd/rcodegen"
#import "tkd/redits"
#import "tkd/rmodel"
#import "tkd/rrecords"
#import "tkd/rwizard"
#import "tkd/rpreview"
#import "vendor/tkControls/tkReportDef"
#import "vendor/tkControls/tkBind"
#import "vendor/tkControls/tkPrint"
#import "vendor/tkControls/tkLayout"
#import "vendor/tkControls/tkTheme"
#import "vendor/tkControls/tkMeta"
#import "vendor/tkControls/tkIconPanel"
using containers
using model
using tkLayout
using tkTheme
using tkMeta
using tkIconPanel
using tkReportDef
using tkBind
using tkPrint

const as string LF = chr( 10 )
const as string CRLF = chr( 13, 10 )

dim shared as long gPass, gFail

sub Check( byval ok as boolean, byref what as const ustring, byref detail as const ustring = "" )
    if ok then
        gPass += 1
    else
        gFail += 1
        print "FAIL "; what;
        if len( detail ) then print " -- "; detail else print
    end if
end sub

function Header( ) as ustring
    return "format = 1" & LF & LF & "[form]" & LF & "caption = ""F""" & LF & "width = 300" & LF & "height = 200" & LF
end function

function Ctl( byref name_ as const ustring, byref type_ as const ustring, byref rest as const ustring = "" ) as ustring
    return LF & "[[control]]" & LF & "name = """ & name_ & """" & LF & "type = """ & type_ & """" & LF & rest
end function

function ReadForm( byref text as const ustring, byref doc as FormDoc ) as boolean
    dim as ustring e
    return formfile.Parse( text, doc, e )
end function

function ProblemsOf( byref text as const ustring, byref moduleName as const ustring = "frmTest" ) as Array( of ustring )
    dim as FormDoc doc
    dim as Array( of ustring ) out_
    dim as ustring e
    if formfile.Parse( text, doc, e ) = false then
        out_.Push( "parse: " & e )
        return out_
    end if
    validate.Check( doc, moduleName, out_ )
    return out_
end function

' `text` must be refused with a problem containing `want`.
sub Refused( byref text as const ustring, byref want as const ustring, byref moduleName as const ustring = "frmTest" )
    dim as Array( of ustring ) p = ProblemsOf( text, moduleName )
    dim as boolean found = false
    for each s as ustring in p
        if instr( s, want ) then found = true
    next
    dim as ustring got = "(none)"
    if p.Count( ) then got = p[0]
    Check( found, "refused: " & want, got )
end sub

sub Accepted( byref text as const ustring, byref what as const ustring )
    dim as Array( of ustring ) p = ProblemsOf( text )
    dim as ustring got
    if p.Count( ) then got = p[0]
    Check( p.Count( ) = 0, "accepted: " & what, got )
end sub

sub RoundTrip( byref golden as const ustring )
    dim as FormDoc d1
    Check( ReadForm( golden, d1 ), "the golden form parses" )
    dim as ustring t1 = formfile.Render( d1 )
    Check( t1 = golden, "canonical text comes back byte for byte", left( t1, 300 ) )
    dim as FormDoc d2
    ReadForm( t1, d2 )
    Check( formfile.Render( d2 ) = t1, "and again" )

    Check( d1.Caption = "Say ""hi""" & LF & "Two", "escapes in a string", d1.Caption )
    Check( d1.Controls.Count( ) = 11, "every control read", str( d1.Controls.Count( ) ) )
    dim as long i = FindControl( d1, "btnGo" )
    Check( d1.Controls[i].Anchor = (TK_ANCHOR_RIGHT or TK_ANCHOR_BOTTOM), "anchor words" )
    Check( FindControl( d1, "BTNGO" ) = i, "names found without regard to case" )
    Check( d1.Controls[FindControl( d1, "lblNote" )].Anchor = TK_ANCHOR_NONE, "anchor none" )
    Check( d1.Controls[FindControl( d1, "tabs" )].Dock = TK_DOCK_FILL, "dock word" )
    Check( d1.Controls[FindControl( d1, "tabs" )].Pages.Count( ) = 3, "pages list" )
    Check( d1.Orphans.Count( ) = 1, "orphan read" )

    ' Key order, defaults, CRLF and quoting style in: one spelling out.
    dim as ustring messy = "format = 1" & CRLF & "[form]" & CRLF & "height = 200" & CRLF & "width = 300" & CRLF _
        & "caption = 'F'" & CRLF & "[[control]]" & CRLF & "type = ""Button""" & CRLF & "name = ""b""" & CRLF _
        & "anchor = ""top left""" & CRLF & "dock = ""none""" & CRLF & "[control.props]" & CRLF _
        & "Font = ""MONO""" & CRLF & "TextAlign = ""Left""" & CRLF & "Enabled = true" & CRLF & "Text = ""x""" & CRLF
    dim as FormDoc d3
    ReadForm( messy, d3 )
    dim as ustring t3 = formfile.Render( d3 )
    dim as ustring want3 = Header( ) & Ctl( "b", "Button", "parent = """"" & LF & "x = 0" & LF & "y = 0" & LF & "w = 0" & LF & "h = 0" & LF ) _
        & LF & "[control.props]" & LF & "Enabled = true" & LF & "Text = ""x""" & LF & "TextAlign = ""Left""" & LF & "Font = ""MONO""" & LF
    Check( t3 = want3, "a messy file gets the one spelling", t3 )

    ' Awkward values survive.
    dim as FormDoc d4
    d4.Caption = "back\slash ""q"" tab" & chr( 9 ) & "nl" & LF & "bell" & chr( 7 ) & " Ü"
    dim as ustring t4 = formfile.Render( d4 )
    dim as FormDoc d5
    Check( ReadForm( t4, d5 ), "awkward text parses", t4 )
    Check( d5.Caption = d4.Caption, "awkward text survives", d5.Caption )

    ' A float stays a float.
    dim as FormDoc d6
    dim as FormControl onlyOne
    d6.Controls.Push( onlyOne )
    PutSetting( d6.Controls[0].Props, "Ratio", "2", VALUE_FLOAT )
    Check( instr( formfile.Render( d6 ), "Ratio = 2.0" ) > 0, "a whole float keeps its point", formfile.Render( d6 ) )

    dim as FormDoc d7
    dim as ustring e
    Check( formfile.Parse( "format = 2", d7, e ) = false, "a newer format is refused" )
    Check( instr( e, "format 2" ) > 0, "and says so", e )
    dim as FormDoc d8
    Check( formfile.Parse( "not toml [", d8, e ) = false, "malformed text is refused" )
    Check( instr( e, "line 1" ) > 0, "with a position", e )
end sub

sub Validation( )
    dim as ustring b = Header( )
    Accepted( b, "an empty form" )
    Accepted( b & Ctl( "btnOK", "Button" ), "a button" )

    Refused( b & Ctl( "1btn", "Button" ), "not an identifier" )
    Refused( b & Ctl( "my btn", "Button" ), "not an identifier" )
    Refused( b & Ctl( "", "Button" ), "not an identifier" )
    Refused( b & Ctl( "Dim", "Button" ), "reserved word" )
    Refused( b & Ctl( "print", "Button" ), "reserved word" )
    Refused( b & Ctl( "NullPtr", "Button" ), "null pointer constant" )
    Refused( b & Ctl( "Handle", "Button" ), "member of every form" )
    Refused( b & Ctl( "layout", "Button" ), "member of every form" )
    Refused( b & Ctl( "BUILD", "Button" ), "member of every form" )
    Refused( b & Ctl( "CheckBox", "Button" ), "control type or module" )
    Refused( b & Ctl( "tkbutton", "Button" ), "control type or module" )
    Refused( b & Ctl( "frmTest", "Button" ), "same name as its form" )
    Refused( b & Ctl( "a", "Button" ) & Ctl( "A", "Label" ), "duplicate" )
    Refused( b & Ctl( "a", "Sprocket" ), "unknown control type" )
    Refused( b, "can't be a module name", "Form" )
    Refused( b, "not an identifier", "my form" )

    Refused( b & Ctl( "a", "Button", "w = -1" & LF ), "negative" )
    Refused( "format = 1" & LF & "[form]" & LF & "width = 0" & LF, "must be positive" )
    Refused( b & Ctl( "a", "Button", "anchor = ""sideways""" & LF ), "bad anchor" )
    Refused( b & Ctl( "a", "Button", "dock = ""middle""" & LF ), "bad dock" )
    Refused( b & Ctl( "a", "Button", "colour = 1" & LF ), "unknown key" )
    Refused( "bogus = 1" & LF & b, "unknown key" )

    Refused( b & Ctl( "a", "Button", "parent = ""x""" & LF ), "doesn't exist" )
    Refused( b & Ctl( "a", "Button", "parent = ""p""" & LF ) & Ctl( "p", "Panel" ), "must come before" )
    Refused( b & Ctl( "p", "Button" ) & Ctl( "a", "Button", "parent = ""p""" & LF ), "can't hold controls" )
    Accepted( b & Ctl( "p", "Panel" ) & Ctl( "a", "Button", "parent = ""p""" & LF ), "a child of a panel" )
    Refused( b & Ctl( "a", "Button", "page = 0" & LF ), "only applies inside" )
    Refused( b & Ctl( "p", "Panel" ) & Ctl( "a", "Button", "parent = ""p""" & LF & "page = 0" & LF ), "only applies inside" )
    Refused( b & Ctl( "c", "Button", "pages = [""x""]" & LF ), "only applies to a tab" )
    dim as ustring tabbed = b & Ctl( "t", "TabControl", "pages = [""x""]" & LF )
    Refused( tabbed & Ctl( "a", "Button", "parent = ""t""" & LF ), "doesn't exist on" )
    Refused( tabbed & Ctl( "a", "Button", "parent = ""t""" & LF & "page = 1" & LF ), "doesn't exist on" )
    Accepted( tabbed & Ctl( "a", "Button", "parent = ""t""" & LF & "page = 0" & LF ), "a child on a page" )

    dim as ustring props = LF & "[control.props]" & LF
    Refused( b & Ctl( "a", "Button" ) & props & "Nope = 1" & LF, "no property" )
    Refused( b & Ctl( "a", "Button" ) & props & "Text = 1" & LF, "must be a string" )
    Refused( b & Ctl( "a", "Button" ) & props & "Default = ""yes""" & LF, "true or false" )
    Refused( b & Ctl( "a", "Button" ) & props & "Enabled = 1" & LF, "true or false" )
    Refused( b & Ctl( "a", "Button" ) & props & "CornerCurvature = 1.5" & LF, "whole number" )
    Refused( b & Ctl( "a", "Button" ) & props & "TextAlign = ""Middle""" & LF, "must be one of" )
    Refused( b & Ctl( "a", "Button" ) & props & "Font = ""HUGE""" & LF, "font role" )
    Refused( b & Ctl( "a", "Label" ) & props & "TextColor = ""red""" & LF, "colour" )
    Accepted( b & Ctl( "a", "Label" ) & props & "TextColor = ""&hFF00FF00""" & LF, "a colour" )
    Refused( b & Ctl( "a", "ProgressBar" ) & props & "Orientation = ""Up""" & LF, "must be one of" )
    Accepted( b & Ctl( "a", "ProgressBar" ) & props & "Orientation = ""Vertical""" & LF, "a creation choice" )

    dim as ustring ev = LF & "[control.events]" & LF
    Refused( b & Ctl( "a", "Button" ) & ev & "Nope = ""a_x""" & LF, "no event" )
    Refused( b & Ctl( "a", "Button" ) & ev & "Click = ""1x""" & LF, "not an identifier" )
    Refused( b & Ctl( "a", "Button" ) & ev & "Click = ""Show""" & LF, "member of every form" )
    Refused( b & Ctl( "a", "Button" ) & ev & "Click = ""a""" & LF, "same name as a control" )
    Accepted( b & Ctl( "a", "Button" ) & ev & "Click = ""H""" & LF & Ctl( "c", "Button" ) & ev & "Click = ""H""" & LF, "a shared handler" )
    Refused( b & Ctl( "a", "Button" ) & ev & "Click = ""H""" & LF & Ctl( "c", "CheckBox" ) & ev & "CheckChanged = ""H""" & LF, "different parameters" )
    Refused( b & LF & "[form.events]" & LF & "Spin = ""S""" & LF, "no event" )
end sub

' From `a` to the end of its line.
function LineWith( byref text as const ustring, byref a as const ustring ) as ustring
    dim as long i = instr( text, a )
    if i = 0 then return ""
    return mid( text, i, instr( i, text, LF ) - i )
end function

' `line` must be the whole of the line starting with its first 24 characters.
sub HasLine( byref text as const ustring, byref l as const ustring, byref what as const ustring )
    Check( instr( text, "    " & l & LF ) > 0, what, LineWith( text, left( l, 24 ) ) )
end sub

sub Generator( byref source as const ustring, byval bAccept as boolean )
    const as string goldenDir = "tests/golden/frmGolden/"
    dim as FormDoc doc
    ReadForm( source, doc )
    dim as Array( of ustring ) p
    validate.Check( doc, "frmGolden", p )
    dim as ustring first_
    if p.Count( ) then first_ = p[0]
    Check( p.Count( ) = 0, "the golden form validates", first_ )
    dim as ustring t = codegen.Generate( doc, "frmGolden", "frmGolden.tkform", source )
    if bAccept then fs.WriteAllText( goldenDir & "frmGolden.design.tiko", t )
    dim as ustring none
    dim as ustring golden = fs.ReadAllText( goldenDir & "frmGolden.design.tiko" ).ValueOr( none )
    Check( t = golden, "the generator matches its golden", len( t ) & " vs " & len( golden ) )
    Check( codegen.Generate( doc, "frmGolden", "frmGolden.tkform", source ) = t, "the same form gives the same text" )

    ' The rules the golden stands for, spelled out so a careless --accept still shows.
    Check( instr( t, "public partial type Form extends FormBase" ) > 0, "the partial type" )
    HasLine( t, "OpenWindow( ""Say """"hi"""""" & chr( 10 ) & ""Two"", 300, 200, owner )", "the caption is a tiko string" )
    HasLine( t, "btnGo.TextAlign = BTN_ALIGN_RIGHT", "an enum becomes its constant" )
    HasLine( t, "btnGo.Font = tkForm_Font( Handle, TKFONT_UI_BOLD )", "a font role" )
    HasLine( t, "r( 0 ) = tkTheme_SrcFixed( 0, &hFF336699ul )    ' TextColor", "a colour" )
    HasLine( t, "tkTheme_SetRecipeNamed( btnGo.Handle, ""Danger"", @r( 0 ), 12 )", "a style by name, with its fields" )
    HasLine( t, "r( 1 ) = tkTheme_SrcFixed2( 1, &hFFFFFFFFul, &hFFFFF8F8ul )    ' ForeColor", "a colour per variant" )
    HasLine( t, "r( 2 ) = tkTheme_SrcRole( 2, TKROLE_BORDER )    ' BorderColor", "a role" )
    HasLine( t, "r( 3 ) = tkTheme_SrcDerive( 4, TKDERIVE_HOT, 0 )    ' BackColorHot", "simple mode shades a face's Hot" )
    HasLine( t, "r( 6 ) = tkTheme_SrcDerive( 5, TKDERIVE_SAME, 1 )    ' ForeColorHot", "and copies ink's" )
    HasLine( t, "txtBody.Create( tkTabControl_GetPage( tabs.Handle, 1 ), 5, true )", "created on a page, with its choice" )
    HasLine( t, "pbFill.Create( grp.Handle, 7, PRG_VERTICAL )", "an enum creation choice" )
    Check( instr( t, "Multiline =" ) = 0, "a creation choice is not assigned" )
    HasLine( t, "tkLayout_Add( Layout, lblNote.Handle, 4, 32, 80, 24, TK_ANCHOR_NONE )", "anchor none" )
    HasLine( t, "tkLayout_Add( Layout, tabs.Handle, 0, 0, 10, 10, TK_ANCHOR_LEFT or TK_ANCHOR_TOP, TK_DOCK_FILL )", "a dock" )
    ' a docked panel's children are laid out against the docked size: its 100 by the form's 200
    HasLine( t, "tkLayout_AddContainer( Layout, pnlSide.Handle, 100, 200 )", "a docked container's size" )
    ' the tabs fill 200 by 200, less TabHeight's 24
    HasLine( t, "tkLayout_AddContainer( Layout, tkTabControl_GetPage( tabs.Handle, 0 ), 200, 176 )", "a page's size" )
    ' docked on a page: its 30 by the page's height, not the tab control's
    HasLine( t, "tkLayout_AddContainer( Layout, pnlOnPage.Handle, 30, 176 )", "a container docked on a page" )
    Check( instr( t, "tkTabControl_GetPage( tabs.Handle, 2 ), 200" ) = 0, "a page with no children isn't a container" )
    HasLine( t, "tkLayout_AddContainer( Layout, grp.Handle, 100, 60, @tkGroupBox_GetClientRect )", "a group box gives its client area" )
    HasLine( t, "tkLayout_AddContainer( Layout, tkScrollPanel_GetPanel( scp.Handle ), 50, 50 )", "a scroll panel's children are on its panel" )
    dim as long nDecl = 0, at_ = 1
    do
        at_ = instr( at_, t, "declare sub Shared_Click" )
        if at_ = 0 then exit do
        nDecl += 1
        at_ += 1
    loop
    Check( nDecl = 1, "a shared handler is declared once", str( nDecl ) )
    Check( instr( t, "declare sub Gone_Click( byval x as long )" ) > 0, "an orphan keeps its declaration" )
    Check( instr( t, "if f then f->Shared_Click( )" ) > 0, "the thunk calls the handler" )
    Check( instr( t, "tkForms_ObjectOf( hButton )" ) > 0, "the thunk checks the form" )
    Check( instr( t, chr( 13 ) ) = 0, "LF line ends" )

    Check( codegen.SourceHash( "a" & CRLF & "b" ) = codegen.SourceHash( "a" & LF & "b" ), "line ends don't change the hash" )
    Check( codegen.SourceHash( "a" ) <> codegen.SourceHash( "b" ), "content does" )
    Check( len( codegen.SourceHash( "a" ) ) = 16, "a short hash" )
end sub

sub Tree( )
    const as string root_ = "tests/bin/tree"
    fs.RemoveDirAll( root_ )
    fs.CreateDirAll( root_ & "/a/frmOne" )
    fs.CreateDirAll( root_ & "/out/frmSkip" )
    fs.CreateDirAll( root_ & "/bad" )
    dim as ustring good = Header( ) & Ctl( "c", "Button" )
    fs.WriteAllText( root_ & "/a/frmOne/frmOne.tkform", good )
    fs.WriteAllText( root_ & "/out/frmSkip/frmSkip.tkform", good )

    dim as Array( of ustring ) r1
    Check( formtree.Process( root_, false, r1 ) = 1, "check: a missing file is stale" )
    dim as ustring first_
    if r1.Count( ) then first_ = r1[0]
    Check( instr( first_, "frmOne.design.tiko: stale" ) > 0, "and it's named", first_ )
    dim as Array( of ustring ) r2
    Check( formtree.Process( root_, true, r2 ) = 0, "generate succeeds" )
    Check( fs.IsFile( root_ & "/a/frmOne/frmOne.design.tiko" ), "the file is there" )
    Check( fs.IsFile( root_ & "/out/frmSkip/frmSkip.design.tiko" ) = false, "out/ is skipped" )
    dim as Array( of ustring ) r3
    Check( formtree.Process( root_, false, r3 ) = 0, "check: now clean" )
    dim as Array( of ustring ) r4
    formtree.Process( root_, true, r4 )
    Check( r4.Count( ) = 0, "generate again changes nothing" )

    ' Line ends the checkout changed aren't drift.
    dim as ustring none
    dim as ustring asLf = fs.ReadAllText( root_ & "/a/frmOne/frmOne.design.tiko" ).ValueOr( none )
    dim as ustring asCrlf
    for i as long = 1 to len( asLf )
        if mid( asLf, i, 1 ) = LF then asCrlf &= CRLF else asCrlf &= mid( asLf, i, 1 )
    next
    fs.WriteAllText( root_ & "/a/frmOne/frmOne.design.tiko", asCrlf )
    dim as Array( of ustring ) r5
    Check( formtree.Process( root_, false, r5 ) = 0, "CRLF in the checkout isn't drift" )

    ' Any edit to the form makes the generated file stale.
    fs.WriteAllText( root_ & "/a/frmOne/frmOne.tkform", good & "x = 5" & LF )
    dim as Array( of ustring ) r6
    Check( formtree.Process( root_, false, r6 ) = 1, "a changed form is stale" )

    ' A form that doesn't validate is reported and leaves no file.
    fs.WriteAllText( root_ & "/bad/frmBad.tkform", Header( ) & Ctl( "Dim", "Button" ) )
    dim as Array( of ustring ) r7
    Check( formtree.Process( root_, true, r7 ) = 1, "a bad form is one problem" )
    dim as boolean named = false
    for each s as ustring in r7
        if instr( s, "reserved word" ) then named = true
    next
    Check( named, "which says why" )
    Check( fs.IsFile( root_ & "/bad/frmBad.design.tiko" ) = false, "and writes nothing" )

    ' A project's glyphs are written at its appGlyphs numbering, as tkEdit's build writes them.
    const as string proj = "tests/bin/treeglyphs"
    fs.RemoveDirAll( proj )
    fs.CreateDirAll( proj & "/frmG" )
    fs.CreateDirAll( proj & "/appGlyphs" )
    fs.WriteAllText( proj & "/tiko.toml", "[package]" & LF & "name = ""g""" & LF )
    fs.WriteAllText( proj & "/appGlyphs/appGlyphs.tkglyphs", "format = 1" & LF & LF & "[codes]" & LF & """Fluent:F5C2"" = ""E000""" & LF )
    fs.WriteAllText( proj & "/frmG/frmG.tkform", Header( ) & Ctl( "b", "Button", "[control.props]" & LF & "GlyphLeft = ""Fluent:F5C2""" & LF ) )
    dim as Array( of ustring ) r8
    Check( formtree.Process( proj, true, r8 ) = 0, "a form with a glyph generates" )
    dim as ustring g8 = fs.ReadAllText( proj & "/frmG/frmG.design.tiko" ).ValueOr( none )
    Check( instr( g8, "b.GlyphLeft = wchr( &hE000 )" ) > 0, "at the project's numbering, not the source font's", g8 )
    dim as Array( of ustring ) r9
    Check( formtree.Process( proj, false, r9 ) = 0, "and --check-forms agrees" )
end sub

function Names( byval a as ustring, byval b as ustring = "", byval c_ as ustring = "" ) as Array( of ustring )
    dim as Array( of ustring ) r
    r.Push( a )
    if len( b ) then r.Push( b )
    if len( c_ ) then r.Push( c_ )
    return r
end function

function Order( byref d as FormDoc ) as ustring
    dim as ustring s
    for i as long = 0 to d.Controls.Count( ) - 1
        s &= d.Controls[i].Name & " "
    next
    return rtrim( s )
end function

sub EditsSuite( )
    Check( edits.Snap( 13, 8 ) = 16, "snap up" )
    Check( edits.Snap( 11, 8 ) = 8, "snap down" )
    Check( edits.Snap( -13, 8 ) = -16, "snap negative" )
    Check( edits.Snap( 13, 1 ) = 13, "a grid of 1 is no grid" )

    dim as FormDoc d
    d.ClientW = 300 : d.ClientH = 200
    Check( edits.AddControl( d, "Sprocket", "", -1, 0, 0, 1, 1 ) = -1, "an unknown type isn't added" )
    dim as long i = edits.AddControl( d, "Button", "", -1, 8, 8, 80, 24 )
    Check( d.Controls[i].Name = "Button1", "named after its type", d.Controls[i].Name )
    Check( SettingOr( d.Controls[i].Props, "Text" ) = "Button1", "its text is its name" )
    edits.AddControl( d, "Button", "", -1, 8, 40, 80, 24 )
    Check( d.Controls[1].Name = "Button2", "the next number" )
    i = edits.AddControl( d, "TabControl", "", -1, 100, 8, 150, 150 )
    Check( d.Controls[i].Pages.Count( ) = 1, "a tab control starts with a page" )
    Check( SettingOr( d.Controls[i].Props, "Text", "none" ) = "none", "and has no Text" )
    dim as FormDoc tbd
    i = edits.AddControl( tbd, "TabBar", "", -1, 0, 0, 200, 30 )
    Check( (tbd.Controls[i].Items.Count( ) = 1) andalso (tbd.Controls[i].Items[0].Text = "Tab1"), "a tab bar starts with a tab, Tab1" )

    ' z-order: a block moves with its children, and parents stay ahead of them
    dim as FormDoc z
    z.ClientW = 300 : z.ClientH = 200
    edits.AddControl( z, "Panel", "", -1, 0, 0, 100, 100 )    ' Panel1
    edits.AddControl( z, "Label", "Panel1", -1, 0, 0, 10, 10 ) ' Label1 inside it
    edits.AddControl( z, "Button", "", -1, 0, 0, 10, 10 )     ' Button1
    edits.AddControl( z, "Panel", "", -1, 0, 0, 10, 10 )      ' Panel2
    edits.BringToFront( z, Names( "Panel1" ) )
    Check( Order( z ) = "Button1 Panel2 Panel1 Label1", "to the front, with its child", Order( z ) )
    edits.SendToBack( z, Names( "Panel1" ) )
    Check( Order( z ) = "Panel1 Label1 Button1 Panel2", "to the back, with its child", Order( z ) )
    edits.BringToFront( z, Names( "Panel1", "Button1" ) )
    Check( Order( z ) = "Panel2 Panel1 Label1 Button1", "several keep their order", Order( z ) )
    edits.SendToBack( z, Names( "Panel1", "Button1" ) )
    Check( Order( z ) = "Panel1 Label1 Button1 Panel2", "to the back, keeping their order", Order( z ) )
    edits.BringToFront( z, Names( "Label1" ) )
    Check( Order( z ) = "Panel1 Button1 Panel2 Label1", "front among its siblings stays after its parent", Order( z ) )

    ' delete takes what's inside
    dim as FormDoc dl = z
    edits.DeleteControls( dl, Names( "Panel1" ) )
    Check( Order( dl ) = "Button1 Panel2", "delete takes the children", Order( dl ) )

    ' top level of a selection
    dim as Array( of ustring ) tops = edits.TopLevelOf( z, Names( "Panel1", "Label1" ) )
    Check( (tops.Count( ) = 1) andalso (tops[0] = "Panel1"), "a child selected with its parent isn't top level" )

    ' align
    dim as FormDoc a
    a.ClientW = 300 : a.ClientH = 200
    edits.AddControl( a, "Button", "", -1, 10, 20, 100, 30 )
    edits.AddControl( a, "Button", "", -1, 50, 60, 40, 10 )
    edits.AlignControls( a, Names( "Button1", "Button2" ), edits.AlignMode.AlignRights )
    Check( a.Controls[1].X = 70, "align rights", str( a.Controls[1].X ) )
    edits.AlignControls( a, Names( "Button1", "Button2" ), edits.AlignMode.AlignCenters )
    Check( a.Controls[1].X = 40, "align centres", str( a.Controls[1].X ) )
    edits.AlignControls( a, Names( "Button1", "Button2" ), edits.AlignMode.AlignLefts )
    Check( a.Controls[1].X = 10, "align lefts" )
    edits.AlignControls( a, Names( "Button1", "Button2" ), edits.AlignMode.AlignBottoms )
    Check( a.Controls[1].Y = 40, "align bottoms", str( a.Controls[1].Y ) )
    edits.AlignControls( a, Names( "Button1", "Button2" ), edits.AlignMode.AlignMiddles )
    Check( a.Controls[1].Y = 30, "align middles", str( a.Controls[1].Y ) )
    edits.AlignControls( a, Names( "Button1", "Button2" ), edits.AlignMode.AlignTops )
    Check( a.Controls[1].Y = 20, "align tops" )
    edits.AlignControls( a, Names( "Button1", "Button2" ), edits.AlignMode.SameSize )
    Check( (a.Controls[1].W = 100) andalso (a.Controls[1].H = 30), "same size" )
    Check( (a.Controls[0].X = 10) andalso (a.Controls[0].W = 100), "the reference doesn't move" )
    a.Controls[1].Dock = TK_DOCK_TOP
    a.Controls[1].Y = 77
    edits.AlignControls( a, Names( "Button1", "Button2" ), edits.AlignMode.AlignTops )
    Check( a.Controls[1].Y = 77, "a docked control isn't aligned" )

    ' spacing, centring, locking (Design menu)
    dim as FormDoc sp
    sp.ClientW = 300 : sp.ClientH = 200
    edits.AddControl( sp, "Button", "", -1, 10, 10, 40, 20 )
    edits.AddControl( sp, "Button", "", -1, 60, 10, 40, 20 )
    edits.AddControl( sp, "Button", "", -1, 200, 10, 40, 20 )
    edits.SpaceControls( sp, Names( "Button2", "Button1", "Button3" ), false, edits.SpaceMode.SpaceEqual, 8 )
    Check( (sp.Controls[0].X = 10) andalso (sp.Controls[1].X = 105) andalso (sp.Controls[2].X = 200), "make equal: 10 105 200", str( sp.Controls[1].X ) )
    sp.Controls[2].Locked = true
    edits.SpaceControls( sp, Names( "Button1", "Button2", "Button3" ), false, edits.SpaceMode.SpaceRemove, 8 )
    Check( (sp.Controls[0].X = 10) andalso (sp.Controls[1].X = 50) andalso (sp.Controls[2].X = 200), "remove from the active one; the locked one stays", str( sp.Controls[1].X ) )
    edits.CenterControls( sp, Names( "Button1", "Button2" ), false, 0, 300 )
    Check( (sp.Controls[0].X = 110) andalso (sp.Controls[1].X = 150), "centred across as one block", str( sp.Controls[0].X ) )
    edits.ToggleLock( sp, Names( "Button1" ) )
    dim as FormDoc sp2
    dim as ustring spe
    Check( edits.AllLocked( sp, Names( "Button1", "Button3" ) ) andalso formfile.Parse( formfile.Render( sp ), sp2, spe ) andalso _
           sp2.Controls[0].Locked andalso (sp2.Controls[1].Locked = false), "locked, and saved", spe )

    ' Tab order (Design > Tab Order): Button3 first, the others keep their order after it; saved, generated
    SetTabPlace( sp, "Button3", 1 )
    dim as Array( of long ) tr = TabRanks( sp )
    dim as FormDoc sp3
    Check( (tr[0] = 2) andalso (tr[1] = 3) andalso (tr[2] = 1) andalso formfile.Parse( formfile.Render( sp ), sp3, spe ) _
           andalso (sp3.Controls[2].TabIndex = 1) andalso (sp3.Controls[0].TabIndex = 2), "tab order: placed, and saved", spe )
    Check( instr( codegen.Generate( sp, "frmT", "frmT.tkform", "" ), "tkHost.tkWidget_SetTabIndex( Button3.Handle, 1 )" ) > 0, "tab order: generated" )

    ' resizing moves what's anchored inside, at every depth
    dim as FormDoc r
    r.ClientW = 300 : r.ClientH = 200
    edits.AddControl( r, "Panel", "", -1, 10, 10, 100, 100 )
    r.Controls[0].Anchor = TK_ANCHOR_LEFT or TK_ANCHOR_TOP or TK_ANCHOR_RIGHT
    edits.AddControl( r, "Button", "Panel1", -1, 60, 10, 30, 20 )
    r.Controls[1].Anchor = TK_ANCHOR_RIGHT or TK_ANCHOR_TOP
    edits.AddControl( r, "Label", "Panel1", -1, 5, 5, 20, 20 )
    edits.AddControl( r, "Button", "", -1, 200, 170, 80, 24 )
    r.Controls[3].Anchor = TK_ANCHOR_RIGHT or TK_ANCHOR_BOTTOM
    edits.ResizeForm( r, 340, 220 )
    Check( (r.ClientW = 340) andalso (r.ClientH = 220), "the form's size" )
    Check( (r.Controls[3].X = 240) andalso (r.Controls[3].Y = 190), "right and bottom anchored follow the form", r.Controls[3].X & "," & r.Controls[3].Y )
    Check( r.Controls[0].W = 140, "a stretching panel stretches", str( r.Controls[0].W ) )
    Check( r.Controls[1].X = 100, "and what's right-anchored in it moves", str( r.Controls[1].X ) )
    Check( r.Controls[2].X = 5, "and what's left-anchored in it doesn't" )
    edits.ResizeControl( r, 0, 10, 10, 120, 100 )
    Check( r.Controls[1].X = 80, "resizing a control takes its children too", str( r.Controls[1].X ) )
    edits.ResizeControl( r, 3, 0, 0, 80, 24 )
    Check( r.Controls[3].X = 0, "a plain control just goes there" )

    ' a docked container's children follow what the dock gives it
    dim as FormDoc dk
    dk.ClientW = 300 : dk.ClientH = 200
    edits.AddControl( dk, "Panel", "", -1, 0, 0, 50, 10 )
    dk.Controls[0].Dock = TK_DOCK_LEFT
    edits.AddControl( dk, "Button", "Panel1", -1, 10, 170, 30, 20 )
    dk.Controls[1].Anchor = TK_ANCHOR_LEFT or TK_ANCHOR_BOTTOM
    edits.ResizeForm( dk, 300, 260 )
    Check( dk.Controls[1].Y = 230, "a child of a docked panel follows the form", str( dk.Controls[1].Y ) )

    ' copy and paste: fresh names, parents mapped, no handlers
    dim as FormDoc p
    p.ClientW = 300 : p.ClientH = 200
    edits.AddControl( p, "Panel", "", -1, 10, 10, 100, 100 )
    edits.AddControl( p, "Button", "Panel1", -1, 8, 8, 40, 20 )
    PutSetting( p.Controls[1].Events, "Click", "Button1_Click" )
    PutSetting( p.Controls[1].Props, "Text", "Keep" )
    edits.AddControl( p, "Label", "Panel1", -1, 8, 30, 40, 20 )
    edits.AddControl( p, "Panel", "", -1, 200, 10, 50, 50 )
    dim as ustring clip = edits.CopyText( p, Names( "Panel1", "Button1" ) )
    Check( len( clip ) > 0, "copy gives text" )
    dim as Array( of ustring ) added
    Check( edits.PasteText( p, clip, "", -1, 8, 8, added ), "paste works" )
    Check( (added.Count( ) = 1) andalso (added[0] = "Panel3"), "one top-level control, renamed" )
    i = FindControl( p, "Panel3" )
    Check( (p.Controls[i].X = 18) andalso (p.Controls[i].Y = 18), "offset" )
    Check( FindControl( p, "Button2" ) > i, "its child came too, after it" )
    Check( lcase( p.Controls[FindControl( p, "Button2" )].Parent ) = "panel3", "with its parent mapped" )
    Check( FindControl( p, "Label2" ) > i, "every child" )
    Check( SettingOr( p.Controls[FindControl( p, "Button2" )].Props, "Text" ) = "Keep", "properties came" )
    Check( p.Controls[FindControl( p, "Button2" )].Events.Count( ) = 0, "handlers did not" )
    Check( SettingOr( p.Controls[FindControl( p, "Label2" )].Props, "Text" ) = "Label2", "a Text that was its name follows the new name" )
    dim as Array( of ustring ) a2
    Check( edits.PasteText( p, "format = 1", "", -1, 0, 0, a2 ) = false, "paste refuses what isn't controls" )
    Check( edits.PasteText( p, "hello", "", -1, 0, 0, a2 ) = false, "or plain text" )
    dim as Array( of ustring ) a3
    Check( edits.PasteText( p, clip, "Panel2", -1, 0, 0, a3 ), "paste into a container" )
    Check( lcase( p.Controls[FindControl( p, a3[0] )].Parent ) = "panel2", "lands in it" )
    dim as Array( of ustring ) a4
    Check( edits.PasteText( p, clip, "", -1, 40, 48, a4, true ), "paste at a point" )
    Check( (p.Controls[FindControl( p, a4[0] )].X = 40) andalso (p.Controls[FindControl( p, a4[0] )].Y = 48), _
           "the copied controls' top-left corner lands on it" )
    dim as Array( of ustring ) problems
    validate.Check( p, "frmP", problems )
    dim as ustring first_
    if problems.Count( ) then first_ = problems[0]
    Check( problems.Count( ) = 0, "a pasted form validates", first_ )
    dim as ustring noPick = edits.CopyText( p, Names( "NoSuch" ) )
    Check( len( noPick ) = 0, "copying nothing gives nothing" )

    ' one property at a time
    dim as FormDoc q
    q.ClientW = 300 : q.ClientH = 200
    edits.AddControl( q, "Panel", "", -1, 0, 0, 100, 100 )
    edits.AddControl( q, "Button", "Panel1", -1, 0, 0, 40, 20 )
    edits.AddControl( q, "CheckBox", "", -1, 0, 0, 40, 20 )
    edits.RenameControl( q, "Panel1", "pnlMain" )
    Check( (q.Controls[0].Name = "pnlMain") andalso (q.Controls[1].Parent = "pnlMain"), "a rename reaches the children" )
    edits.SetDock( q, Names( "CheckBox1" ), TK_DOCK_TOP )
    Check( q.Controls[2].Dock = TK_DOCK_TOP, "set dock" )
    edits.SetAnchorBit( q, Names( "Button1", "CheckBox1" ), TK_ANCHOR_RIGHT, true )
    Check( (q.Controls[1].Anchor and TK_ANCHOR_RIGHT) andalso (q.Controls[2].Anchor and TK_ANCHOR_LEFT), "an anchor bit, on several" )
    edits.SetAnchorBit( q, Names( "Button1" ), TK_ANCHOR_LEFT, false )
    Check( (q.Controls[1].Anchor and TK_ANCHOR_LEFT) = 0, "an anchor bit off" )
    Check( edits.SetProperty( q, Names( "Button1" ), "Default", "true" ) = "", "a bool" )
    Check( FindSetting( q.Controls[1].Props, "Default" ) >= 0, "is stored" )
    Check( q.Controls[1].Props[FindSetting( q.Controls[1].Props, "Default" )].Kind = VALUE_BOOL, "as a bool" )
    Check( edits.SetProperty( q, Names( "Button1" ), "Default", "false" ) = "", "its default" )
    Check( FindSetting( q.Controls[1].Props, "Default" ) < 0, "removes the line" )
    Check( edits.SetProperty( q, Names( "Button1" ), "Padding", "1,2" ) <> "", "a list of the wrong length is refused" )
    Check( edits.SetProperty( q, Names( "Button1" ), "Padding", "1,2,x,4" ) <> "", "a list with a bad value is refused" )
    Check( edits.SetProperty( q, Names( "Button1" ), "Padding", "1, 2 ,3,4" ) = "", "a list" )
    Check( SettingOr( q.Controls[FindControl( q, "Button1" )].Props, "Padding" ) = "1,2,3,4", "is stored tidy" )
    Check( instr( codegen.Generate( q, "frmQ", "frmQ.tkform", "" ), "Button1.Padding( 1, 2, 3, 4 )" ) > 0, "and generates a call" )
    Check( edits.SetProperty( q, Names( "Button1" ), "Padding", "" ) = "", "empty removes it" )
    Check( edits.SetProperty( q, Names( "Button1" ), "CornerCurvature", "abc" ) <> "", "a non-number is refused" )
    Check( edits.SetProperty( q, Names( "Button1" ), "CornerCurvature", "4" ) = "", "a number isn't" )
    Check( q.Controls[1].Props[FindSetting( q.Controls[1].Props, "CornerCurvature" )].Kind = VALUE_INT, "and is a number in the file" )
    Check( edits.SetProperty( q, Names( "Button1" ), "CornerCurvature", "" ) = "", "empty" )
    Check( FindSetting( q.Controls[1].Props, "CornerCurvature" ) < 0, "removes it" )
    Check( edits.SetProperty( q, Names( "Button1" ), "Nope", "1" ) <> "", "an unknown property is refused" )
    dim as FormDoc qBad = q
    edits.RenameControl( qBad, "Button1", "print" )
    Check( instr( validate.FirstNewProblem( q, qBad ), "reserved" ) > 0, "the new problem is found" )
    Check( len( validate.FirstNewProblem( q, q ) ) = 0, "no change, no new problem" )
    PutSetting( q.Controls[1].Events, "Click", "Button1_Click" )
    edits.RenameControl( q, "Button1", "btnGo" )
    Check( SettingOr( q.Controls[1].Events, "Click" ) = "btnGo_Click", "a rename takes its handler along" )

    ' the text edit
    dim as edits.LineEdit e = edits.DiffLines( "a" & LF & "b" & LF & "c" & LF, "a" & LF & "b" & LF & "c" & LF, LF )
    Check( e.IsNoOp, "no change is no edit" )
    e = edits.DiffLines( "a" & LF & "b" & LF & "c" & LF, "a" & LF & "X" & LF & "c" & LF, LF )
    Check( (e.First = 1) andalso (e.Last = 1) andalso (e.Text = "X" & LF), "one line changed", e.First & "," & e.Last )
    e = edits.DiffLines( "a" & LF & "c" & LF, "a" & LF & "b" & LF & "c" & LF, LF )
    Check( (e.First = 1) andalso (e.Last = 0) andalso (e.Text = "b" & LF), "an insert", e.First & "," & e.Last )
    e = edits.DiffLines( "a" & LF & "b" & LF & "c" & LF, "a" & LF & "c" & LF, LF )
    Check( (e.First = 1) andalso (e.Last = 1) andalso (len( e.Text ) = 0), "a delete", e.First & "," & e.Last )
    e = edits.DiffLines( "a" & CRLF & "b" & CRLF, "a" & LF & "X" & LF, CRLF )
    Check( (e.First = 1) andalso (e.Last = 1) andalso (e.Text = "X" & CRLF), "the buffer's line ends", e.First & "," & e.Last )
    e = edits.DiffLines( "a" & LF & "b", "a" & LF & "b" & LF, LF )
    Check( (e.First = 1) andalso (e.Text = "b" & LF), "a last line that had no break gets one" )
end sub

sub ReconcileSuite( )
    dim as ustring src = "#module ""f""" & LF & LF & "sub Form.A_Click( )" & LF & "    ' a note" & LF & LF & "end sub" & LF & LF _
        & "sub Form.B_Click( byval x as long )" & LF & "    print x" & LF & "end sub" & LF
    dim as long a, b
    Check( reconcile.FindBody( src, "A_Click", a, b ), "a handler is found" )
    Check( (a = 2) andalso (b = 5), "its lines", a & "," & b )
    Check( reconcile.FindBody( src, "a_click", a, b ), "whatever its case" )
    Check( reconcile.IsEmptyBody( src, a, b ), "comments and blanks are empty" )
    reconcile.FindBody( src, "B_Click", a, b )
    Check( reconcile.IsEmptyBody( src, a, b ) = false, "code isn't" )
    Check( reconcile.FindBody( src, "C_Click", a, b ) = false, "an absent one isn't found" )

    reconcile.FindBody( src, "A_Click", a, b )
    dim as ustring cut_ = reconcile.RemoveLines( src, a, b )
    Check( cut_ = "#module ""f""" & LF & LF & "sub Form.B_Click( byval x as long )" & LF & "    print x" & LF & "end sub" & LF, "a handler removed, with its blank line", cut_ )

    dim as long bodyLine
    dim as ustring added = reconcile.AddStub( "#module ""f""" & LF, "H", "byval n as long", bodyLine )
    Check( added = "#module ""f""" & LF & LF & "sub Form.H( byval n as long )" & LF & "    " & LF & "end sub" & LF, "a stub", added )
    Check( bodyLine = 3, "and the line inside it", str( bodyLine ) )
    added = reconcile.AddStub( "x", "H", "", bodyLine )
    Check( instr( added, "x" & LF & LF & "sub Form.H( )" ) = 1, "a missing last line break is made up", added )
    added = reconcile.AddStub( "", "H", "", bodyLine )
    Check( (left( added, 11 ) = "sub Form.H(") andalso (bodyLine = 1), "into an empty file", added )
    Check( len( reconcile.NewCodeFile( "frmX" ) ) > 0 andalso (instr( reconcile.NewCodeFile( "frmX" ), "#module ""frmX""" ) > 0), "a new file has the module" )

    dim as ustring imported = reconcile.EnsureImport( "#module ""f""" & LF & "#import ""std/fs""" & LF & LF & "code" & LF, "tkDatePicker" )
    Check( instr( imported, "#import ""std/fs""" & LF & "#import ""vendor/tkControls/tkDatePicker""" & LF & "using tkDatePicker" & LF ) > 0, "an import goes after the others", imported )
    Check( reconcile.EnsureImport( imported, "tkDatePicker" ) = imported, "only once" )
    imported = reconcile.EnsureImport( imported, "tkToolbar" )
    Check( instr( imported, "#import ""vendor/tkControls/tkDatePicker""" & LF & "#import ""vendor/tkControls/tkToolbar""" & LF & "using tkDatePicker" & LF & "using tkToolbar" & LF ) > 0, "imports stay ahead of every using", imported )

    dim as Array( of ustring ) needs = reconcile.ImportsFor( "byval hMenu as TK_MENU ptr, byval h as TK_HOST ptr", "tkToolbar" )
    Check( (needs.Count( ) = 2) andalso (needs[0] = "tkHost") andalso (needs[1] = "tkPopupMenu"), "the modules a parameter list needs" )
    needs = reconcile.ImportsFor( "byval p as TKDATE ptr", "tkCalendar" )
    Check( (needs.Count( ) = 1) andalso (needs[0] = "tkCalendar"), "a date comes from its control's module" )
    needs = reconcile.ImportsFor( "byval x as long", "tkButton" )
    Check( needs.Count( ) = 0, "plain types need nothing" )

    dim as FormDoc d
    edits.AddControl( d, "Button", "", -1, 0, 0, 10, 10 )
    d.Controls[0].Name = "btnNew"
    PutSetting( d.Controls[0].Events, "Click", "btnNew_Click" )
    dim as ustring code = "sub Form.btnOld_Click( )" & LF & "    btnOld.Text = ""btnOld"" ' btnOld" & LF & "    this.BTNOLD.Text = !""a\""btnOld""" & LF & "    x.btnOld = btnOld_Other" & LF & "    y = btnOldest" & LF & "    /' btnOld '/" & LF & "end sub" & LF
    dim as ustring got = reconcile.RenameInCode( code, "btnOld", "btnNew", d )
    Check( instr( got, "sub Form.btnNew_Click( )" ) > 0, "the handler's definition", got )
    Check( instr( got, "    btnNew.Text = ""btnOld"" ' btnOld" ) > 0, "a use, not its string or comment", got )
    Check( instr( got, "this.btnNew.Text = !""a\""btnOld""" ) > 0, "this., any case, an escaped string", got )
    Check( instr( got, "x.btnOld" ) > 0, "another object's member stays", got )
    Check( instr( got, "btnOld_Other" ) > 0, "a name that isn't a bound handler stays", got )
    Check( instr( got, "btnOldest" ) > 0, "a longer name stays", got )
    Check( instr( got, "/' btnOld '/" ) > 0, "a block comment stays", got )

    dim as FormDoc r
    edits.AddControl( r, "Button", "", -1, 0, 0, 10, 10 )
    PutSetting( r.Controls[0].Events, "Click", "Has_Body" )
    edits.AddControl( r, "Button", "", -1, 0, 0, 10, 10 )
    PutSetting( r.Controls[1].Events, "Click", "No_Body" )
    PutSetting( r.Events, "Load", "Form_Load" )
    dim as FormOrphan o1, o2
    o1.Handler = "Old_Has"
    o2.Handler = "Old_None"
    r.Orphans.Push( o1 )
    r.Orphans.Push( o2 )
    dim as Array( of ustring ) unbound
    dim as ustring text = "sub Form.Has_Body( )" & LF & "end sub" & LF & "sub Form.Old_Has( )" & LF & "end sub" & LF
    Check( reconcile.ReconcileForm( r, text, unbound ), "a missing body is a change" )
    Check( FindSetting( r.Controls[0].Events, "Click" ) >= 0, "what has a body stays bound" )
    Check( FindSetting( r.Controls[1].Events, "Click" ) < 0, "what hasn't is unbound" )
    Check( FindSetting( r.Events, "Load" ) < 0, "a form event likewise" )
    Check( unbound.Count( ) = 2, "and they're listed", str( unbound.Count( ) ) )
    Check( (r.Orphans.Count( ) = 1) andalso (r.Orphans[0].Handler = "Old_Has"), "an orphan with no body is forgotten" )
    dim as Array( of ustring ) u2
    Check( reconcile.ReconcileForm( r, text, u2 ) = false, "nothing further" )

    ' a custom control
    dim as FormDoc cu
    cu.ClientW = 100
    cu.ClientH = 100
    edits.AddControl( cu, "Custom", "", -1, 0, 0, 50, 50 )
    Check( cu.Controls[0].Name = "Custom1", "a stand-in is named" )
    dim as Array( of ustring ) p1
    validate.Check( cu, "frmC", p1 )
    Check( (p1.Count( ) = 1) andalso (instr( p1[0], "name of its type" ) > 0), "with no type it's a problem" )
    cu.Controls[0].CustomType = "Gauge"
    dim as Array( of ustring ) p2
    validate.Check( cu, "frmC", p2 )
    Check( (p2.Count( ) = 1) andalso (instr( p2[0], "module" ) > 0), "nor with no module" )
    cu.Controls[0].CustomModule = "../widgets/gauge"
    dim as Array( of ustring ) p3
    validate.Check( cu, "frmC", p3 )
    Check( p3.Count( ) = 0, "promoted, it's fine" )
    dim as ustring tx = formfile.Render( cu )
    dim as FormDoc cu2
    Check( ReadForm( tx, cu2 ) andalso (formfile.Render( cu2 ) = tx), "and round-trips" )
    Check( cu2.Controls[0].CustomModule = "../widgets/gauge", "with its module" )
    dim as ustring g = codegen.Generate( cu, "frmC", "frmC.tkform", tx )
    Check( instr( g, "    Custom1 as Gauge" & LF ) > 0, "generated as its type", g )
    Check( instr( g, "#import ""../widgets/gauge""" & LF ) > 0, "imported", g )
    Check( instr( g, "using gauge" & LF ) > 0, "by its last part" )
    HasLine( g, "Custom1.Create( tkForm_Widget( Handle ), 1 )", "created like any control" )
    HasLine( g, "tkLayout_Add( Layout, Custom1.Handle, 0, 0, 50, 50 )", "and laid out" )
end sub

sub ItemsSuite( )
    dim as ustring src = Header( ) _
        & Ctl( "mnu", "MenuBar", "dock = ""top""" & LF ) _
        & LF & "[[control.items]]" & LF & "text = ""File""" & LF _
        & LF & "[[control.items]]" & LF & "text = ""Open""" & LF & "level = 1" & LF & "key = ""Primary+O""" & LF & "handler = ""OnOpen""" & LF _
        & LF & "[[control.items]]" & LF & "text = ""-""" & LF & "level = 1" & LF _
        & Ctl( "tb", "Toolbar" ) & LF & "[[control.items]]" & LF & "text = ""Go""" & LF & "kind = ""toggle""" & LF & "handler = ""OnGo""" & LF _
        & Ctl( "sb", "StatusBar" ) & LF & "[[control.items]]" & LF & "text = ""Ready""" & LF & "width = 80" & LF _
        & Ctl( "lst", "ListTree" ) & LF & "[[control.items]]" & LF & "text = ""Name""" & LF & "width = 150" & LF _
        & Ctl( "cbo", "ComboBox" ) & LF & "[[control.items]]" & LF & "text = ""A""" & LF
    dim as FormDoc d
    Check( ReadForm( src, d ), "items parse" )
    Check( d.Controls[0].Items.Count( ) = 3, "a menu's entries", str( d.Controls[0].Items.Count( ) ) )
    Check( d.Controls[0].Items[1].Level = 1, "a level" )
    Check( d.Controls[0].Items[1].Key = "Primary+O", "a shortcut" )
    Check( d.Controls[3].Items[0].Width = 150, "a width" )
    dim as ustring t1 = formfile.Render( d )
    dim as FormDoc d2
    ReadForm( t1, d2 )
    Check( formfile.Render( d2 ) = t1, "items round-trip", t1 )
    dim as Array( of ustring ) p
    validate.Check( d, "frmI", p )
    dim as ustring first_
    if p.Count( ) then first_ = p[0]
    Check( p.Count( ) = 0, "items validate", first_ )

    dim as ustring g = codegen.Generate( d, "frmI", "frmI.tkform", src )
    Check( instr( g, "#import ""vendor/tkControls/tkPopupMenu""" ) > 0, "the popup module is imported", g )
    Check( instr( g, "#import ""vendor/tkControls/tkKeys""" ) > 0, "and the keys" )
    Check( instr( g, "using tkKeys" & LF ) > 0, "and used" )
    Check( instr( g, "tkMenuBar_SetDropDown( mnu.Handle, tkMenuBar_AddItem( mnu.Handle, ""File"", 1000 ), menus( 0 ) )" ) > 0, "a menu with a drop-down", g )
    Check( instr( g, "tkPopupMenu_AddItem( menus( 0 ), 1001, ""Open"", KeyLabel( ""Primary+O"" ) )" ) > 0, "an item with a shortcut", g )
    Check( instr( g, "tkPopupMenu_AddSeparator( menus( 0 ) )" ) > 0, "a separator" )
    Check( instr( g, "declare sub OnOpen( )" ) > 0, "a handler is declared" )
    Check( instr( g, "case 1001 : f->OnOpen( )" ) > 0, "and dispatched" )
    Check( instr( g, "tkMenuBar_SetCommandCallback( mnu.Handle, @Thunk_mnu_Command )" ) > 0, "the dispatcher is installed", g )
    Check( instr( g, "tkKeys_BindText( keys, ""Primary+O"", 1001 )" ) > 0, "the shortcut is bound" )
    Check( instr( g, "tkKeys_Attach( tkForm_Host( Handle ), keys, @Thunk_Keys )" ) > 0, "the key table is attached" )
    Check( instr( g, "tkToolbar_AddItem( tb.Handle, TBR_KIND_TOGGLE, """", ""Go"", 1003 )" ) > 0, "a toolbar item, numbered after the menu's", g )
    Check( instr( g, "case 1003 : f->OnGo( )" ) > 0, "dispatched too" )
    Check( instr( g, "tkStatusBar_AddPanel( sb.Handle, ""Ready"" )" ) > 0, "a panel" )
    Check( instr( g, "tkStatusBar_SetPanelMinWidth( sb.Handle, 0, 80 )" ) > 0, "its width" )
    Check( instr( g, "tkListTree_AddColumn( lst.Handle, ""Name"", 150 )" ) > 0, "a column" )
    Check( instr( g, "tkComboBox_AddItem( cbo.Handle, ""A"" )" ) > 0, "a combo item" )

    ' a status panel's handler: reached through the bar's Click by the panel's index, told the clicks;
    ' the spring is the bar's ExpandPanel property
    dim as ustring sbSrc = Header( ) _
        & Ctl( "sb2", "StatusBar", "" ) & "[control.props]" & LF & "ExpandPanel = 1" & LF _
        & LF & "[[control.items]]" & LF & "text = ""Ready""" & LF _
        & LF & "[[control.items]]" & LF & "text = ""Line""" & LF & "handler = ""OnLine""" & LF
    dim as FormDoc ds
    Check( ReadForm( sbSrc, ds ), "status handlers parse" )
    dim as Array( of ustring ) ps2
    validate.Check( ds, "frmS", ps2 )
    Check( ps2.Count( ) = 0, "and validate" )
    dim as ustring gs = codegen.Generate( ds, "frmS", "frmS.tkform", sbSrc )
    Check( instr( gs, "declare sub OnLine( byval clicks as int32 )" ) > 0, "a panel handler is told the clicks", gs )
    Check( instr( gs, "select case idx" ) > 0, "the bar's Click picks the panel by index" )
    Check( instr( gs, "case 1 : f->OnLine( clicks )" ) > 0, "and calls its handler" )
    Check( instr( gs, "tkStatusBar_SetClickCallback( sb2.Handle, @Thunk_sb2_Click )" ) > 0, "the dispatcher is installed" )
    ' set after the panels exist: the bar refuses a spring index it has no panel for
    Check( instr( gs, "sb2.ExpandPanel = 1" ) > instr( gs, "tkStatusBar_AddPanel( sb2.Handle, ""Line"" )" ), "and the spring set, after the panels", gs )
    ' several panels stretch: saved per panel, and set on each after it is added
    dim as ustring stSrc = Header( ) _
        & Ctl( "sb3", "StatusBar", "" ) _
        & LF & "[[control.items]]" & LF & "text = ""A""" & LF & "stretch = true" & LF _
        & LF & "[[control.items]]" & LF & "text = ""B""" & LF _
        & LF & "[[control.items]]" & LF & "text = ""C""" & LF & "stretch = true" & LF
    dim as FormDoc dst
    Check( ReadForm( stSrc, dst ) andalso dst.Controls[0].Items[0].Stretch andalso (dst.Controls[0].Items[1].Stretch = false) _
           andalso dst.Controls[0].Items[2].Stretch, "stretch read per panel" )
    dim as FormDoc dst2
    ReadForm( formfile.Render( dst ), dst2 )
    Check( formfile.Render( dst2 ) = formfile.Render( dst ) andalso (instr( formfile.Render( dst ), "stretch = true" ) > 0), "and round-trips", formfile.Render( dst ) )
    dim as ustring gst = codegen.Generate( dst, "frmT", "frmT.tkform", stSrc )
    Check( (instr( gst, "tkStatusBar_SetPanelStretch( sb3.Handle, 0, true )" ) > instr( gst, "tkStatusBar_AddPanel( sb3.Handle, ""A"" )" )) _
           andalso (instr( gst, "tkStatusBar_SetPanelStretch( sb3.Handle, 2, true )" ) > 0) andalso (instr( gst, "SetPanelStretch( sb3.Handle, 1" ) = 0), _
           "each stretching panel set, after it is added", gst )

    ' with no entries, none of that is generated
    dim as FormDoc empty_
    empty_.ClientW = 300
    empty_.ClientH = 200
    edits.AddControl( empty_, "Toolbar", "", -1, 0, 0, 10, 10 )
    Check( empty_.Controls[0].Dock = TK_DOCK_TOP, "a new toolbar docks top" )
    dim as ustring g2 = codegen.Generate( empty_, "frmE", "frmE.tkform", "x" )
    Check( instr( g2, "tkKeys" ) = 0, "no keys when no shortcut" )
    Check( instr( g2, "SetClickCallback" ) = 0, "no dispatcher with nothing to dispatch" )

    ' what's refused
    dim as ustring item = LF & "[[control.items]]" & LF
    Refused( Header( ) & Ctl( "a", "Button" ) & item & "text = ""x""" & LF, "can't have items" )
    Refused( Header( ) & Ctl( "t", "TabControl" ) & item & "text = ""x""" & LF, "can't have items" )
    Refused( Header( ) & Ctl( "m", "MenuBar" ) & item & "text = ""x""" & LF & "level = 1" & LF, "first menu item" )
    Refused( Header( ) & Ctl( "m", "MenuBar" ) & item & "text = ""x""" & LF & item & "text = ""y""" & LF & "level = 2" & LF, "indented too far" )
    Refused( Header( ) & Ctl( "m", "MenuBar" ) & item & "text = ""-""" & LF, "separator can't be on the bar" )
    Refused( Header( ) & Ctl( "m", "MenuBar" ) & item & "text = ""x""" & LF & item & "text = ""y""" & LF & "level = 1" & LF & "key = ""Banana+Q""" & LF, "isn't a shortcut" )
    Refused( Header( ) & Ctl( "t", "Toolbar" ) & item & "text = ""x""" & LF & "kind = ""spinner""" & LF, "no toolbar item kind" )
    Refused( Header( ) & Ctl( "m", "MenuBar" ) & item & "text = ""x""" & LF & "handler = ""1bad""" & LF, "not an identifier" )
    Refused( Header( ) & Ctl( "m", "MenuBar" ) & item & "text = ""x""" & LF & "bogus = 1" & LF, "unknown key" )

    ' rename, delete, paste, reconcile
    dim as FormDoc r
    ReadForm( src, r )
    PutSetting( r.Controls[0].Events, "Command", "mnu_Command" )
    r.Controls[0].Items[1].Handler = "mnu_Open"
    edits.RenameControl( r, "mnu", "menuMain" )
    Check( r.Controls[0].Items[1].Handler = "menuMain_Open", "a rename takes an entry's handler along" )
    dim as ustring clip = edits.CopyText( r, Names( "menuMain" ) )
    dim as FormDoc pasted
    pasted.ClientW = 300
    pasted.ClientH = 200
    dim as Array( of ustring ) added
    Check( edits.PasteText( pasted, clip, "", -1, 0, 0, added ), "a menu pastes" )
    Check( pasted.Controls[0].Items.Count( ) = 3, "with its entries" )
    Check( len( pasted.Controls[0].Items[1].Handler ) = 0, "and without their handlers" )

    dim as FormDoc rc2
    ReadForm( src, rc2 )
    dim as Array( of ustring ) un
    Check( reconcile.ReconcileForm( rc2, "sub Form.OnOpen( )" & LF & "end sub" & LF, un ), "an entry's missing body is a change" )
    Check( rc2.Controls[0].Items[1].Handler = "OnOpen", "what has a body stays" )
    Check( len( rc2.Controls[1].Items[0].Handler ) = 0, "what hasn't is unbound" )
    Check( rc2.Controls[1].Items.Count( ) = 1, "and the entry stays" )

    ' tab pages
    dim as FormDoc tp
    tp.ClientW = 300
    tp.ClientH = 200
    edits.AddControl( tp, "TabControl", "", -1, 0, 0, 200, 100 )
    tp.Controls[0].Pages.Push( "Two" )
    edits.AddControl( tp, "Button", "TabControl1", 1, 0, 0, 10, 10 )
    dim as Array( of FormItem ) e1
    dim as FormItem a_, b_
    a_.Text = "Two"
    a_.Origin = 1
    b_.Text = "One"
    b_.Origin = 0
    e1.Push( a_ )
    e1.Push( b_ )
    Check( edits.ApplyPages( tp, 0, e1 ) = "", "pages reordered" )
    Check( tp.Controls[1].Page = 0, "a control goes with its page", str( tp.Controls[1].Page ) )
    dim as Array( of FormItem ) e2
    e2.Push( b_ )
    e2[0].Origin = 1
    Check( instr( edits.ApplyPages( tp, 0, e2 ), "still holds" ) > 0, "a page in use can't go" )
    dim as Array( of FormItem ) e3
    Check( len( edits.ApplyPages( tp, 0, e3 ) ) > 0, "nor all of them" )
end sub

sub TranslateSuite( )
    dim as ustring item = LF & "[[control.items]]" & LF
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "caption = ""Cap""" & LF & "width = 300" & LF & "height = 200" & LF & "translate = true" & LF _
        & Ctl( "b", "Button" ) & LF & "[control.props]" & LF & "Text = ""Go""" & LF & "TooltipText = ""Tip""" & LF & "Font = ""MONO""" & LF _
        & Ctl( "c", "ComboBox" ) & item & "text = ""One""" & LF _
        & Ctl( "t", "TabControl", "pages = [""P""]" & LF )
    dim as FormDoc d
    Check( ReadForm( src, d ), "a translated form parses" )
    Check( d.Translate, "the flag" )
    dim as FormDoc d2
    ReadForm( formfile.Render( d ), d2 )
    Check( d2.Translate andalso (formfile.Render( d2 ) = formfile.Render( d )), "and round-trips", formfile.Render( d ) )
    dim as ustring g = codegen.Generate( d, "frmT", "frmT.tkform", src )
    Check( instr( g, "OpenWindow( tkForms_Tr( ""frmT.Caption"", ""Cap"" )," ) > 0, "the caption goes through the translator", g )
    Check( instr( g, "b.Text = tkForms_Tr( ""frmT.b.Text"", ""Go"" )" ) > 0, "a text property" )
    Check( instr( g, "b.TooltipText = tkForms_Tr( ""frmT.b.TooltipText"", ""Tip"" )" ) > 0, "every text property" )
    Check( instr( g, "tkComboBox_AddItem( c.Handle, tkForms_Tr( ""frmT.c.0"", ""One"" ) )" ) > 0, "an entry" )
    Check( instr( g, "tkTabControl_AddPage( t.Handle, tkForms_Tr( ""frmT.t.Page0"", ""P"" ) )" ) > 0, "a page" )
    Check( instr( g, "tkForm_Font( Handle, TKFONT_MONO )" ) > 0, "a font isn't text" )
    d.Translate = false
    Check( instr( codegen.Generate( d, "frmT", "frmT.tkform", src ), "tkForms_Tr" ) = 0, "not unless asked" )
end sub

' The form's window settings and its own events: file, refusals, generated code.
' Entry ids: a translation key ends in the entry's id, which stays with it however entries move.
sub TranslateIdsSuite( )
    dim as ustring item = LF & "[[control.items]]" & LF
    dim as ustring head = "format = 1" & LF & LF & "[form]" & LF & "caption = ""Cap""" & LF & "width = 300" & LF & "height = 200" & LF
    dim as ustring body = Ctl( "c", "ComboBox" ) & item & "text = ""One""" & LF & item & "text = ""Two""" & LF & item & "text = ""Three""" & LF _
        & Ctl( "t", "TabControl", "pages = [""P"", ""Q""]" & LF ) _
        & Ctl( "tb", "Toolbar" ) & item & "text = ""Go""" & LF & "kind = ""command""" & LF & item & "text = """"" & LF & "kind = ""separator""" & LF _
        & Ctl( "ce", "CodeEdit" ) & LF & "[control.props]" & LF & "Lexer = ""tiko""" & LF
    dim as FormDoc d
    Check( ReadForm( head & "translate = true" & LF & body, d ), "a translated form from before ids parses" )
    dim as ustring g = codegen.Generate( d, "frmT", "frmT.tkform", "" )
    Check( (instr( g, """frmT.c.0"", ""One""" ) > 0) andalso (instr( g, """frmT.c.2"", ""Three""" ) > 0), "an old form keeps its keys: ids are the places", g )
    Check( instr( g, """frmT.t.Page1"", ""Q""" ) > 0, "and its pages' keys" )
    Check( instr( g, "tkForms_Tr( ""frmT.tb.1""" ) = 0, "a separator's empty text isn't translated", g )
    Check( instr( g, "ce.Lexer = ""tiko""" ) > 0, "a CodeEdit's Lexer is not words", g )
    dim as ustring r = formfile.Render( d )
    Check( (instr( r, "id = 2" ) > 0) andalso (instr( r, "page_ids = [0, 1]" ) > 0), "a translated form writes its ids", r )
    dim as FormDoc d2
    ReadForm( r, d2 )
    Check( formfile.Render( d2 ) = r, "and reads them back" )

    ' insert, move, delete: the others keep their keys, the new one gets a fresh id
    dim as long ci = FindControl( d, "c" )
    dim as FormItem nu
    nu.Text = "New"
    d.Controls[ci].Items.Insert( 1, nu )
    FillIds( d.Controls[ci], false )
    Check( d.Controls[ci].Items[1].Id = 3, "a new entry gets one past the highest", str( d.Controls[ci].Items[1].Id ) )
    dim as FormItem sw = d.Controls[ci].Items[0]
    d.Controls[ci].Items[0] = d.Controls[ci].Items[3]
    d.Controls[ci].Items[3] = sw
    d.Controls[ci].Items.Remove( 2 )
    g = codegen.Generate( d, "frmT", "frmT.tkform", "" )
    Check( (instr( g, """frmT.c.2"", ""Three""" ) > 0) andalso (instr( g, """frmT.c.0"", ""One""" ) > 0) andalso (instr( g, """frmT.c.3"", ""New""" ) > 0), "keys follow their entries", g )
    Check( instr( g, """Two""" ) = 0, "a deleted one is gone" )

    ' a page put in front keeps the others' keys
    dim as long ti = FindControl( d, "t" )
    dim as Array( of FormItem ) pages
    dim as FormItem pg
    pg.Text = "New page"
    pages.Push( pg )
    for p as long = 0 to 1
        pg.Text = d.Controls[ti].Pages[p]
        pg.Origin = p
        pg.Id = PageId( d.Controls[ti], p )
        pages.Push( pg )
    next
    Check( len( edits.ApplyPages( d, ti, pages ) ) = 0, "pages apply" )
    g = codegen.Generate( d, "frmT", "frmT.tkform", "" )
    Check( (instr( g, """frmT.t.Page0"", ""P""" ) > 0) andalso (instr( g, """frmT.t.Page2"", ""New page""" ) > 0), "a new page gets a fresh id", g )

    ' what the dialog lists is what the code asks for
    dim as Array( of codegen.TrEntry ) list = codegen.TranslatableTexts( d, "frmT" )
    dim as long calls = 0, at_ = instr( g, "tkForms_Tr( " )
    while at_
        calls += 1
        at_ = instr( at_ + 1, g, "tkForms_Tr( " )
    wend
    dim as boolean allIn = (list.Count( ) = calls)
    for each e as codegen.TrEntry in list
        if instr( g, "tkForms_Tr( """ & e.Key & """, """ & e.Text & """ )" ) = 0 then allIn = false
    next
    Check( allIn andalso (calls > 0), "TranslatableTexts is every key Generate asks for", str( list.Count( ) ) & " / " & calls )
    Check( codegen.TranslatableTexts( d, "frmT" ).Count( ) = list.Count( ), "and asking twice gives the same" )

    ' ids a file gives are kept; a clash or a gap is filled without moving them
    dim as FormControl k
    dim as FormItem a
    a.Id = -1 : k.Items.Push( a )
    a.Id = 0  : k.Items.Push( a )
    a.Id = 0  : k.Items.Push( a )
    FillIds( k, true )
    Check( (k.Items[0].Id = 1) andalso (k.Items[1].Id = 0) andalso (k.Items[2].Id = 2), "a taken place or a repeated id gets a fresh one", k.Items[0].Id & " " & k.Items[1].Id & " " & k.Items[2].Id )

    ' a form that isn't translated is written as it always was
    dim as FormDoc d3
    ReadForm( head & body, d3 )
    r = formfile.Render( d3 )
    Check( (instr( r, "id = " ) = 0) andalso (instr( r, "page_ids" ) = 0), "no ids unless the form is translated", r )
    Check( codegen.TranslatableTexts( d3, "frmT" ).Count( ) = 0, "and nothing to translate" )
end sub

' The project's languages: appLanguages.tklang, its catalogs, and the module that registers them.
sub LangFileSuite( )
    dim as langfile.LangProject pj
    dim as ustring e
    Check( langfile.ParseProject( langfile.DefaultProjectText( ), pj, e ), "a new project's languages read", e )
    Check( (pj.BaseCode = "en") andalso (pj.Languages.Count( ) = 0), "English, no others" )
    dim as ustring src = "format = 1" & LF & "base = ""en""" & LF & "base_name = ""English""" & LF _
        & LF & "[[language]]" & LF & "code = ""fr""" & LF & "name = ""Français""" & LF _
        & LF & "[[language]]" & LF & "code = ""de""" & LF & "name = ""Deutsch""" & LF & "embed = false" & LF
    dim as langfile.LangProject p2
    Check( langfile.ParseProject( src, p2, e ) andalso (langfile.ProjectText( p2 ) = src), "a .tklang round-trips", langfile.ProjectText( p2 ) )
    dim as Array( of ustring ) probs
    langfile.CheckProject( p2, "", probs )
    dim as ustring first_
    if probs.Count( ) then first_ = probs[0]
    Check( probs.Count( ) = 0, "and is right", first_ )
    dim as langfile.LangInfo bad
    bad.Code = "FR"
    p2.Languages.Push( bad )
    bad.Code = "en"
    p2.Languages.Push( bad )
    bad.Code = "9x"
    p2.Languages.Push( bad )
    probs.Clear( )
    langfile.CheckProject( p2, "", probs )
    Check( probs.Count( ) = 3, "twice, the forms' own, and a bad code are faults", str( probs.Count( ) ) )

    ' a catalog: one table per form, the rest of the key quoted; what it was translated from
    dim as ustring ct = "format = 1" & LF & "name = ""Français""" & LF _
        & LF & "[frmMain]" & LF & "Caption = ""Fenêtre""" & LF & """btnOK.Text"" = ""D'accord""" & LF & """mnuMain.3"" = ""Ouvrir""" & LF _
        & LF & "[_source.frmMain]" & LF & "Caption = ""Main""" & LF & """btnOK.Text"" = ""OK""" & LF
    dim as langfile.Catalog cat
    Check( langfile.ParseCatalog( ct, cat, e ), "a catalog reads", e )
    Check( (cat.Name = "Français") andalso (cat.Entries.Count( ) = 3), "its name and entries", str( cat.Entries.Count( ) ) )
    Check( langfile.CatalogText( cat ) = ct, "and round-trips", langfile.CatalogText( cat ) )
    dim as long i = langfile.FindEntry( cat, "frmMain.btnOK.Text" )
    Check( (i >= 0) andalso (cat.Entries[i].Text = "D'accord") andalso (cat.Entries[i].Source = "OK"), "a quoted key's dots are its own" )
    Check( langfile.StateOf( cat, "frmMain.btnOK.Text", "OK" ) = langfile.EntryState.StateDone, "translated from today's text: done" )
    Check( langfile.StateOf( cat, "frmMain.Caption", "Main window" ) = langfile.EntryState.StateStale, "from another text: stale" )
    Check( langfile.StateOf( cat, "frmMain.lblX.Text", "X" ) = langfile.EntryState.StateMissing, "none: missing" )
    Check( langfile.StateOf( cat, "frmMain.mnuMain.3", "Open" ) = langfile.EntryState.StateDone, "no source: taken as done" )
    dim as langfile.Catalog nest
    langfile.ParseCatalog( "format = 1" & LF & "[frmMain.btnOK]" & LF & "Text = ""OK""" & LF & "[_private]" & LF & "x = ""y""" & LF, nest, e )
    Check( (nest.Entries.Count( ) = 1) andalso (langfile.FindEntry( nest, "frmMain.btnOK.Text" ) = 0), "nested tables flatten too; _ tables are skipped" )

    langfile.PutEntry( cat, "frmAbout.Caption", "À propos", "About" )
    Check( cat.Entries[0].Key = "frmAbout.Caption", "a new entry is kept in order" )
    langfile.PutEntry( cat, "frmAbout.Caption", "", "" )
    Check( langfile.FindEntry( cat, "frmAbout.Caption" ) < 0, "an empty text takes it out" )
    Check( langfile.RenameKeys( cat, "frmMain.btnOK.", "frmMain.btnAccept." ) = 1, "a renamed control's keys move" )
    Check( (langfile.FindEntry( cat, "frmMain.btnAccept.Text" ) >= 0) andalso (langfile.FindEntry( cat, "frmMain.btnOK.Text" ) < 0), "to the new name" )
    Check( instr( langfile.CatalogText( cat ), """btnAccept.Text"" = ""OK""" ) > 0, "with what it was translated from" )

    ' the generated module
    dim as langfile.LangProject p3
    langfile.ParseProject( src, p3, e )
    dim as ustring g = langfile.Generate( p3, "appLanguages", "appLanguages.tklang", src )
    Check( instr( g, "#embed gLang0_ ""lang/fr.toml""" & LF ) > 0, "a built-in catalog is embedded", g )
    Check( instr( g, "    tkLanguage_SetBase( ""en"", ""English"" )" & LF ) > 0, "the forms' own language", g )
    Check( instr( g, "    tkLanguage_AddData( ""fr"", ""Français"", @gLang0_( 0 ), ubound( gLang0_ ) + 1 )" & LF ) > 0, "registered from inside", g )
    Check( instr( g, "    if len( Beside_( ""fr.toml"" ) ) then tkLanguage_AddFile( ""fr"", ""Français"", Beside_( ""fr.toml"" ) )" & LF ) > 0, "a copy beside it wins", g )
    Check( instr( g, "        tkLanguage_AddFile( ""de"", ""Deutsch"", ""appLanguages/lang/de.toml"" )" & LF ) > 0, "one not built in: the project's copy", g )
    Check( instr( g, "gLang1_" ) = 0, "and is not embedded" )

    dim as ustring mainText = "#import ""vendor/tkControls/tkApp""" & LF & "#import ""./frmMain""" & LF & "using tkApp" & LF _
        & "dim as TKAPP_OPTIONS options" & LF & "if tkApp_Init( options ) = false then end 1" & LF & "dim as frmMain.Form f" & LF & "f.Build( )" & LF
    dim as ustring outText
    Check( langfile.InstallIntoMain( mainText, outText ) = 1, "main is wired" )
    Check( instr( outText, "#import ""vendor/tkControls/tkApp""" & LF & "#import ""./appLanguages""" & LF ) > 0, "the import beside tkApp's", outText )
    Check( instr( outText, "= false then end 1" & LF & "appLanguages.Register( )" & LF & "appLanguages.UseSystem( )" ) > 0, "before any form is built", outText )
    dim as ustring again
    Check( langfile.InstallIntoMain( outText, again ) = 0, "once" )
end sub

sub WindowSuite( )
    dim as ustring head = "format = 1" & LF & LF & "[form]" & LF & "caption = ""W""" & LF & "width = 300" & LF & "height = 200" & LF
    dim as ustring win = "start_position = ""CenterScreen""" & LF & "window_state = ""Maximized""" & LF & "resizable = true" & LF _
        & "min_width = 200" & LF & "min_height = 150" & LF & "max_width = 800" & LF & "max_height = 600" & LF _
        & "always_on_top = true" & LF & "icon = ""app.png""" & LF
    dim as ustring evs = LF & "[form.events]" & LF & "Load = ""Form_Load""" & LF & "Close = ""Form_Close""" & LF _
        & "Resize = ""Form_Resize""" & LF & "KeyDown = ""Form_KeyDown""" & LF & "Paint = ""Form_Paint""" & LF _
        & "Destroy = ""Form_Destroy""" & LF & "ThemeChanged = ""Form_ThemeChanged""" & LF & "MouseMove = ""Form_MouseMove""" & LF
    dim as ustring src = head & win & evs
    dim as FormDoc d
    Check( ReadForm( src, d ), "window: the form parses" )
    Check( (d.StartPosition = "CenterScreen") andalso (d.WindowState = "Maximized") andalso (d.Resizable = "true") _
        andalso (d.MinW = 200) andalso (d.MinH = 150) andalso (d.MaxW = 800) andalso (d.MaxH = 600) _
        andalso d.AlwaysOnTop andalso (d.Icon = "app.png"), "window: every setting read" )
    Check( formfile.Render( d ) = src, "window: canonical text comes back byte for byte", formfile.Render( d ) )
    Accepted( src, "window: every setting and event" )
    dim as FormDoc plain
    ReadForm( head, plain )
    Check( formfile.Render( plain ) = head, "window: defaults write nothing", formfile.Render( plain ) )
    ' out of order in, catalog order out
    dim as FormDoc d2
    ReadForm( head & LF & "[form.events]" & LF & "Paint = ""P""" & LF & "Load = ""L""" & LF, d2 )
    Check( instr( formfile.Render( d2 ), "Load = ""L""" & LF & "Paint = ""P""" ) > 0, "window: events in the catalog's order" )

    Refused( head & "start_position = ""Middle""" & LF, "no start position" )
    Refused( head & "window_state = ""Huge""" & LF, "no window state" )
    Refused( head & "window_state = ""Maximized""" & LF & "resizable = false" & LF, "has to be resizable" )
    Refused( head & "min_width = -1" & LF, "can't be negative" )
    Refused( head & "min_width = 300" & LF & "max_width = 200" & LF, "below its minimum" )
    Accepted( head & "min_height = 300" & LF, "window: a minimum with no maximum" )
    Refused( head & LF & "[form.events]" & LF & "Paint = ""H""" & LF & "Resize = ""H""" & LF, "different parameters" )

    dim as ustring g = codegen.Generate( d, "frmW", "frmW.tkform", src )
    HasLine( g, "tkForm_SetStartPosition( Handle, TKFORM_POS_CENTER_SCREEN )", "window: start position" )
    HasLine( g, "tkForm_SetResizable( Handle, true )", "window: resizable" )
    HasLine( g, "tkForm_SetMinSize( Handle, 200, 150 )", "window: minimum" )
    HasLine( g, "tkForm_SetMaxSize( Handle, 800, 600 )", "window: maximum" )
    HasLine( g, "tkForm_SetWindowState( Handle, TKFORM_STATE_MAXIMIZED )", "window: state" )
    HasLine( g, "tkForm_SetAlwaysOnTop( Handle, true )", "window: on top" )
    HasLine( g, "tkForm_SetIcon( Handle, ""app.png"" )", "window: icon" )
    HasLine( g, "declare sub Form_Resize( byval cx as int32, byval cy as int32 )", "window: Resize declared" )
    HasLine( g, "declare sub Form_KeyDown( byval keyCode as int32, byval mods as int32, byref Handled as boolean )", "window: KeyDown declared" )
    HasLine( g, "declare sub Form_Paint( byval pPaint as TK_PAINT ptr )", "window: Paint declared" )
    HasLine( g, "declare sub Form_Destroy( )", "window: Destroy declared" )
    HasLine( g, "declare sub Form_ThemeChanged( )", "window: ThemeChanged declared" )
    HasLine( g, "ResizeHook = @Thunk_Form_Resize", "window: Resize hooked after the layout" )
    HasLine( g, "tkForm_OnKeyDown( Handle, @Thunk_Form_KeyDown )", "window: KeyDown hooked" )
    HasLine( g, "tkForm_OnPaint( Handle, @Thunk_Form_Paint )", "window: Paint hooked" )
    HasLine( g, "DestroyHook = @Thunk_Form_Destroy", "window: Destroy hooked" )
    HasLine( g, "tkForm_OnThemeChanged( Handle, @Thunk_Form_ThemeChanged )", "window: ThemeChanged hooked" )
    HasLine( g, "return Handled", "window: KeyDown says whether it took the key" )
    ' MouseMove: the form's watches its own widget; a control's goes through the same tkHost setter
    HasLine( g, "tkWidget_SetMouseMoveCallback( tkForm_Widget( Handle ), @Thunk_Form_MouseMove )", "window: MouseMove hooked" )
    HasLine( g, "declare sub Form_MouseMove( byval x as int32, byval y as int32, byval buttons as int32, byval mods as int32 )", "window: MouseMove declared" )
    dim as ustring srcB = Header( ) & Ctl( "btn", "Button" ) & "[control.events]" & LF & "MouseMove = ""btn_MouseMove""" & LF
    dim as FormDoc dB
    Check( ReadForm( srcB, dB ), "mousemove: a button's parses" )
    Accepted( srcB, "mousemove: a button's MouseMove" )
    dim as ustring gB = codegen.Generate( dB, "frmB", "frmB.tkform", srcB )
    HasLine( gB, "tkWidget_SetMouseMoveCallback( btn.Handle, @Thunk_btn_MouseMove )", "mousemove: a button's hooked" )
    Check( catalog.Find( "Timer" ) <> 0 andalso (tkMeta_FindEvent( catalog.Find( "Timer" ), "MouseMove" ) = 0), "mousemove: not a Timer's" )
    dim as ustring g0 = codegen.Generate( plain, "frmW", "frmW.tkform", head )
    Check( (instr( g0, "tkForm_Set" ) = 0) andalso (instr( g0, "Hook" ) = 0) andalso (instr( g0, "Thunk_Form" ) = 0), "window: nothing unless asked" )
    dim as Array( of ustring ) im = reconcile.ImportsFor( "byval pPaint as TK_PAINT ptr", "" )
    Check( (im.Count( ) = 1) andalso (im[0] = "tkPaint"), "window: a Paint handler's file imports tkPaint" )

    ' a shortcut on an entry with no handler yet: no empty select (tiko refuses one, TKO0418)
    dim as FormDoc mk
    mk.ClientW = 300 : mk.ClientH = 200
    edits.AddControl( mk, "MenuBar", "", -1, 0, 0, 300, 24 )
    dim as FormItem top_, sub_
    top_.Text = "&File"
    sub_.Text = "&Open"
    sub_.Key = "Ctrl+O"
    sub_.Level = 1
    mk.Controls[0].Items.Push( top_ )
    mk.Controls[0].Items.Push( sub_ )
    dim as ustring gk = codegen.Generate( mk, "frmK", "frmK.tkform", formfile.Render( mk ) )
    Check( (instr( gk, "Thunk_Keys" ) > 0) andalso (instr( gk, "select case cmd" ) = 0), "keys: no handler, no select", gk )
    mk.Controls[0].Items[1].Handler = "mnuOpen_Click"
    gk = codegen.Generate( mk, "frmK", "frmK.tkform", formfile.Render( mk ) )
    Check( instr( gk, "select case cmd" & LF & "    case " ) > 0, "keys: a handler gets its case" )

    ' an entries edit: which handlers nothing calls any more, and what each entry calls now
    dim as Array( of FormItem ) olds = mk.Controls[0].Items     ' File, Open (mnuOpen_Click)
    olds[0].Handler = "FileHandler"
    dim as Array( of FormItem ) news = olds
    news[0].Handler = "File_Handler"                             ' renamed
    news[1].Handler = ""                                         ' cleared
    dim as FormDoc after_ = mk
    after_.Controls[0].Items = news
    dim as Array( of Setting ) dr = reconcile.DroppedItemHandlers( olds, news, after_ )
    Check( (dr.Count( ) = 2) andalso (dr[0].Key = "FileHandler") andalso (dr[0].Value = "File_Handler") _
        andalso (dr[1].Key = "mnuOpen_Click") andalso (dr[1].Value = ""), "items: a renamed and a cleared handler", str( dr.Count( ) ) )
    dim as Array( of FormItem ) moved
    moved.Push( news[1] )
    moved.Push( news[0] )                                        ' File moved down, same text
    after_.Controls[0].Items = moved
    dr = reconcile.DroppedItemHandlers( olds, moved, after_ )
    Check( (dr.Count( ) >= 1) andalso (dr[0].Value = "File_Handler"), "items: an entry that moved is found by its text" )
    PutSetting( after_.Events, "Load", "FileHandler" )
    dr = reconcile.DroppedItemHandlers( olds, moved, after_ )
    Check( (dr.Count( ) = 1) andalso (dr[0].Key = "mnuOpen_Click"), "items: a handler still called elsewhere isn't dropped" )
end sub

' A Button's events beyond Click: one about a paint info, two that answer.
sub ButtonEventsSuite( )
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "caption = ""B""" & LF & "width = 300" & LF & "height = 200" & LF _
        & Ctl( "btn", "Button" ) & LF & "[control.props]" & LF & "IconGap = 6" & LF & "IconSize = ""20,20""" & LF _
        & "FocusRing = ""3,2""" & LF & "BorderWidth = 2" & LF _
        & LF & "[control.events]" & LF & "Paint = ""btn_Paint""" & LF & "Tooltip = ""btn_Tooltip""" & LF & "Message = ""btn_Message""" & LF
    dim as FormDoc d
    Check( ReadForm( src, d ), "button: the form parses" )
    Accepted( src, "button: the new properties and events" )
    dim as ustring g = codegen.Generate( d, "frmB", "frmB.tkform", src )
    HasLine( g, "btn.IconGap = 6", "button: IconGap" )
    HasLine( g, "btn.IconSize( 20, 20 )", "button: IconSize" )
    HasLine( g, "btn.FocusRing( 3, 2 )", "button: FocusRing" )
    HasLine( g, "btn.BorderWidth = 2", "button: BorderWidth" )
    HasLine( g, "declare sub btn_Paint( byval p as TKBUTTON_PAINTINFO ptr )", "button: Paint declared" )
    HasLine( g, "declare sub btn_Tooltip( byref Text as ustring )", "button: Tooltip declared" )
    HasLine( g, "declare sub btn_Message( byval m as TKBUTTON_MESSAGEINFO ptr, byref Handled as boolean )", "button: Message declared" )
    Check( instr( g, "dim as Form ptr f = tkForms_ObjectOf( p->hButton )" ) > 0, "button: Paint finds its form through the paint info" )
    Check( instr( g, "private function Thunk_btn_Tooltip( byval hButton as TK_WIDGET ptr ) as ustring" & LF _
        & "    dim as ustring Text" & LF & "    dim as Form ptr f = tkForms_ObjectOf( hButton )" & LF _
        & "    if f then f->btn_Tooltip( Text )" & LF & "    return Text" & LF ) > 0, "button: Tooltip's thunk answers the handler's Text", g )
    Check( instr( g, "private function Thunk_btn_Message( byval m as TKBUTTON_MESSAGEINFO ptr ) as boolean" & LF _
        & "    dim as boolean Handled" & LF & "    dim as Form ptr f = tkForms_ObjectOf( m->hButton )" & LF ) > 0, "button: Message's thunk answers Handled" )
    HasLine( g, "tkButton_SetTooltipCallback( btn.Handle, @Thunk_btn_Tooltip )", "button: Tooltip installed" )
    dim as Array( of ustring ) im = reconcile.ImportsFor( "byval p as TKBUTTON_PAINTINFO ptr", "tkButton" )
    Check( (im.Count( ) = 1) andalso (im[0] = "tkButton"), "button: a handler of a button type imports tkButton" )
    im = reconcile.ImportsFor( "byval h as TK_HOST ptr", "tkButton" )
    Check( (im.Count( ) = 1) andalso (im[0] = "tkHost"), "button: TK_ types aren't the control's" )
end sub

' A TextBox's focus, scroll and message events.
sub TextBoxEventsSuite( )
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "caption = ""T""" & LF & "width = 300" & LF & "height = 200" & LF _
        & Ctl( "txt", "TextBox" ) & LF & "[control.events]" & LF & "FocusChanged = ""txt_Focus""" & LF _
        & "ScrollChanged = ""txt_Scroll""" & LF & "Message = ""txt_Message""" & LF
    dim as FormDoc d
    Check( ReadForm( src, d ), "textbox: the form parses" )
    Accepted( src, "textbox: the new events" )
    dim as ustring g = codegen.Generate( d, "frmT", "frmT.tkform", src )
    HasLine( g, "declare sub txt_Focus( byval bGotFocus as boolean )", "textbox: FocusChanged declared" )
    HasLine( g, "declare sub txt_Scroll( )", "textbox: ScrollChanged declared" )
    HasLine( g, "declare sub txt_Message( byval m as TKTEXTBOX_MESSAGEINFO ptr, byref Handled as boolean )", "textbox: Message declared" )
    Check( instr( g, "private function Thunk_txt_Message( byval m as TKTEXTBOX_MESSAGEINFO ptr ) as boolean" & LF _
        & "    dim as boolean Handled" & LF & "    dim as Form ptr f = tkForms_ObjectOf( m->hTextBox )" & LF ) > 0, "textbox: Message's thunk answers Handled" )
    HasLine( g, "tkTextBox_SetFocusCallback( txt.Handle, @Thunk_txt_FocusChanged )", "textbox: FocusChanged installed" )
    HasLine( g, "tkTextBox_SetScrollChangedCallback( txt.Handle, @Thunk_txt_ScrollChanged )", "textbox: ScrollChanged installed" )
end sub

' A NumericUpDown's tooltip rows and its Paint and Message events.
sub NumericUpDownSuite( )
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "caption = ""N""" & LF & "width = 300" & LF & "height = 200" & LF _
        & Ctl( "nud", "NumericUpDown" ) & LF & "[control.props]" & LF & "TooltipText = ""Qty""" & LF & "HoverTime = 300" & LF _
        & LF & "[control.events]" & LF & "Paint = ""nud_Paint""" & LF & "Message = ""nud_Message""" & LF
    dim as FormDoc d
    Check( ReadForm( src, d ), "numericupdown: the form parses" )
    Accepted( src, "numericupdown: the new rows and events" )
    dim as ustring g = codegen.Generate( d, "frmN", "frmN.tkform", src )
    HasLine( g, "nud.TooltipText = ""Qty""", "numericupdown: TooltipText" )
    HasLine( g, "nud.HoverTime = 300", "numericupdown: HoverTime" )
    Check( instr( g, "dim as Form ptr f = tkForms_ObjectOf( p->hCtrl )" ) > 0, "numericupdown: Paint finds its form through the paint info" )
    Check( instr( g, "private function Thunk_nud_Message( byval m as TKNUMERICUPDOWN_MESSAGEINFO ptr ) as boolean" & LF _
        & "    dim as boolean Handled" & LF & "    dim as Form ptr f = tkForms_ObjectOf( m->hCtrl )" & LF ) > 0, "numericupdown: Message's thunk answers Handled" )
end sub

' A bound before the value it bounds: every setter clamps / snaps, so Build must set Range and
' DecimalPlaces before Value (Position after Range), whatever order the file lists them in -- a form
' saved under the old table order lists Value first. And the writer now saves that order too.
sub PropOrderSuite( )
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "caption = ""O""" & LF & "width = 300" & LF & "height = 200" & LF _
        & Ctl( "nud", "NumericUpDown" ) & LF & "[control.props]" & LF & "Value = 2500000.5" & LF & "DecimalPlaces = 1" & LF _
        & "Range = ""0,5000000""" & LF & LF _
        & Ctl( "prg", "ProgressBar" ) & LF & "[control.props]" & LF & "Position = 150" & LF & "Range = ""0,200""" & LF
    dim as FormDoc d
    Check( ReadForm( src, d ), "proporder: the form parses" )
    dim as ustring g = codegen.Generate( d, "frmO", "frmO.tkform", src )
    dim as long nRange = instr( g, "    nud.Range( " ), nDec = instr( g, "    nud.DecimalPlaces = " ), nVal = instr( g, "    nud.Value = " )
    Check( (nRange > 0) andalso (nDec > 0) andalso (nVal > 0), "proporder: the three NumericUpDown lines", LineWith( g, "nud." ) )
    Check( (nRange < nVal) andalso (nDec < nVal), "proporder: NumericUpDown Range and DecimalPlaces before Value", LineWith( g, "nud.Value" ) )
    dim as long pRange = instr( g, "    prg.Range( " ), pPos = instr( g, "    prg.Position = " )
    Check( (pRange > 0) andalso (pPos > pRange), "proporder: ProgressBar Range before Position", LineWith( g, "prg.Position" ) )
    dim as ustring r = formfile.Render( d )
    Check( (instr( r, "Range = " ) > 0) andalso (instr( r, "Range = " ) < instr( r, "Value = " )), "proporder: the writer saves Range before Value" )
end sub

' InfoBar + Toaster (notifications N5): a bar's create arg, its layout hook right after it joins the
' layout, a Closing thunk answering Allow (true unless the handler says no), its load-only binding;
' a Toaster is created but never laid out, and its events are wired.
sub NotifySuite( )
    dim as ustring src = Header( ) & "data_type = ""orders.Order""" & LF & "data_module = ""../orders""" & LF _
        & Ctl( "bar", "InfoBar", "dock = ""top""" & LF & "bind = ""Notice""" & LF & "[control.props]" & LF & "Severity = ""Warning""" & LF & "Actions = ""Retry|Details""" & LF _
        & LF & "[control.events]" & LF & "Closing = ""bar_Closing""" & LF ) _
        & Ctl( "tst", "Toaster", "[control.props]" & LF & "Position = ""TopRight""" & LF & LF & "[control.events]" & LF & "Action = ""tst_Action""" & LF )
    dim as FormDoc d
    Check( ReadForm( src, d ), "notify: the form parses" )
    Accepted( src, "notify: an InfoBar and a Toaster" )
    dim as ustring g = codegen.Generate( d, "frmN", "frmN.tkform", src )
    dim as long nAdd = instr( g, "tkLayout_Add( Layout, bar.Handle" ), nHook = instr( g, "    tkInfoBar_AttachLayout( bar.Handle, Layout )" & LF )
    Check( (nAdd > 0) andalso (nHook > nAdd), "notify: the bar's layout hook, right after it joins the layout", LineWith( g, "AttachLayout" ) )
    Check( instr( g, "bar.Create( " ) > 0 andalso (instr( LineWith( g, "bar.Create( " ), ", true )" ) > 0), "notify: a designed bar is created open (IsOpen's default)", LineWith( g, "bar.Create( " ) )
    HasLine( g, "bar.Severity = tkNotify.TKN_WARNING", "notify: an enum prop is its (qualified) constant" )
    Check( instr( g, "    dim as boolean Allow = true" & LF ) > 0, "notify: Closing's thunk starts Allow at true", LineWith( g, "Allow" ) )
    Check( instr( g, "tkInfoBar_SetText( bar.Handle, tkBind_Text( r.Notice ) )" ) > 0, "notify: the bar loads its field", LineWith( g, "tkInfoBar_SetText" ) )
    Check( (instr( g, "tst.Create( " ) > 0) andalso (instr( g, "tkLayout_Add( Layout, tst.Handle" ) = 0) andalso _
           (instr( g, "tkToast_SetActionCallback( tst.Handle, @Thunk_tst_Action )" ) > 0), "notify: a Toaster is made, not laid out, its event wired", LineWith( g, "tst." ) )
end sub

' A Slider (S3): its limits before its value whatever the file's order, enum constants, and a
' FormatValue thunk that answers a ustring.
' A PrintPreview (printing R1): Zoom before ZoomMode (a custom zoom, then the mode that may undo it),
' an enum as its constant, and LinkClick's thunk answering its Handled.
sub PrintPreviewSuite( )
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "caption = ""P""" & LF & "width = 400" & LF & "height = 500" & LF _
        & Ctl( "pv", "PrintPreview" ) & LF & "[control.props]" & LF & "ZoomMode = ""Custom""" & LF & "Zoom = 0.75" & LF _
        & "ViewMode = ""Single""" & LF & LF & "[control.events]" & LF & "LinkClick = ""pv_Link""" & LF
    dim as FormDoc d
    Check( ReadForm( src, d ), "preview: the form parses" )
    Accepted( src, "preview: its props and events" )
    dim as ustring g = codegen.Generate( d, "frmP", "frmP.tkform", src )
    dim as long nZoom = instr( g, "    pv.Zoom = 0.75" ), nMode = instr( g, "    pv.ZoomMode = TKPV_ZOOM_CUSTOM" )
    Check( (nZoom > 0) andalso (nMode > nZoom), "preview: Zoom, then ZoomMode", LineWith( g, "pv." ) )
    HasLine( g, "pv.ViewMode = TKPV_VIEW_SINGLE", "preview: an enum prop is its constant" )
    Check( instr( g, "private function Thunk_pv_LinkClick( byval hPreview as TK_WIDGET ptr, byval nPage as int32, byref url as ustring, byval nTargetPage as int32, byval fTargetY as float32 ) as boolean" & LF _
        & "    dim as boolean Handled" & LF ) > 0, "preview: LinkClick's thunk answers its Handled", LineWith( g, "Thunk_pv_LinkClick" ) )
end sub

' A ReportViewer (printing R3): a bool prop, and BeforePrint's thunk answering Allow from true.
sub ReportViewerSuite( )
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "caption = ""R""" & LF & "width = 500" & LF & "height = 560" & LF _
        & Ctl( "rv", "ReportViewer" ) & LF & "[control.props]" & LF & "ShowStatus = false" & LF _
        & LF & "[control.events]" & LF & "BeforePrint = ""rv_Before""" & LF
    dim as FormDoc d
    Check( ReadForm( src, d ), "viewer: the form parses" )
    Accepted( src, "viewer: its props and events" )
    dim as ustring g = codegen.Generate( d, "frmR", "frmR.tkform", src )
    HasLine( g, "rv.ShowStatus = false", "viewer: a bool prop" )
    Check( instr( g, "private function Thunk_rv_BeforePrint( byval hViewer as TK_WIDGET ptr, byref job as TKPRINTJOB ) as boolean" & LF _
        & "    dim as boolean Allow = true" & LF ) > 0, "viewer: BeforePrint's thunk answers Allow, from true", LineWith( g, "Thunk_rv_BeforePrint" ) )
    Check( instr( g, "#import ""vendor/tkControls/tkPrinter""" ) > 0, "viewer: BeforePrint's TKPRINTJOB brings tkPrinter" )

    ' R5: its own report from an Array( of T ) -- B3's list shape "report": a field per column
    dim as ustring rpt = Ctl( "rv", "ReportViewer", "items_source = ""Orders""" & LF & "item_type = ""db.Order""" & LF ) _
        & LF & "[[control.items]]" & LF & "text = ""Customer""" & LF & "width = 160" & LF & "field = ""Customer""" & LF _
        & LF & "[[control.items]]" & LF & "text = ""Note""" & LF _
        & LF & "[[control.items]]" & LF & "text = ""Amount""" & LF & "field = ""Amount""" & LF _
        & LF & "[control.events]" & LF & "BuildReport = ""rv_Build""" & LF
    Accepted( Header( ) & rpt, "viewer report: a ReportViewer bound to an array" )
    Refused( Header( ) & Ctl( "rv", "ReportViewer", "items_source = ""S""" & LF & "item_type = ""T""" & LF & "check_field = ""Done""" & LF ) _
        & LF & "[[control.items]]" & LF & "text = ""N""" & LF & "field = ""N""" & LF, "it has no CheckField" )
    dim as FormDoc dh
    ReadForm( Header( ) & Ctl( "rv", "ReportViewer", "items_source = ""S""" & LF & "item_type = ""T""" & LF ), dh )
    Check( instr( codegen.Generate( dh, "frmH", "frmH.tkform", "" ), "#error ""rv: its list needs a column with a Field" ) > 0, "viewer report: no Field yet, an #error" )
    dim as FormDoc dr
    ReadForm( Header( ) & rpt, dr )
    dim as ustring gr = codegen.Generate( dr, "frmR", "frmR.tkform", "" )
    Check( (instr( gr, "    tkReportViewer_AddField( rv.Handle, ""Customer"", 160 )" & LF & "    tkReportViewer_AddField( rv.Handle, ""Note"", 100 )" & LF ) > 0) _
        andalso (instr( gr, "tkListTree" ) = 0), "viewer report: its fields, in Build", LineWith( gr, "AddField" ) )
    Check( instr( gr, "        tkReportViewer_ClearRows( rv.Handle )" & LF & "        for i_ as int32 = 0 to a_.Count( ) - 1" & LF _
        & "            dim as integer row_ = tkReportViewer_AddRow( rv.Handle )" & LF _
        & "            tkBind_ToValue( a_[i_].Customer, tkReportViewer_Cell( rv.Handle, row_, 0 ) )" & LF _
        & "            tkBind_ToValue( a_[i_].Amount, tkReportViewer_Cell( rv.Handle, row_, 2 ) )" & LF _
        & "        next" & LF & "        tkReportViewer_RefreshReport( rv.Handle )" & LF ) > 0, "viewer report: Fill, a value per Field, then RefreshReport", gr )
    Check( (instr( gr, "#import ""vendor/tkControls/tkReport""" ) > 0) andalso (reconcile.ImportsFor( "byval rpt as TK_REPORT ptr", "tkReportViewer" ).Count( ) = 1) _
        andalso (reconcile.ImportsFor( "byval rpt as TK_REPORT ptr", "tkReportViewer" )[0] = "tkReport"), "viewer report: BuildReport's TK_REPORT brings tkReport, to both files" )

    ' RD4: a designed report -- its module imported once, a member per viewer of the report's own type
    dim as ustring two = Header( ) & Ctl( "rvA", "ReportViewer", "report = ""../rptOrders""" & LF ) _
        & Ctl( "rvB", "ReportViewer", "report = ""../rptOrders""" & LF ) & Ctl( "rvC", "ReportViewer", "report = ""rptMixed""" & LF )
    Accepted( two, "designed report: viewers showing report modules" )
    dim as FormDoc dd
    ReadForm( two, dd )
    Check( dd.Controls[0].Report = "../rptOrders", "designed report: read from the form" )
    dim as ustring gd = codegen.Generate( dd, "frmD", "frmD.tkform", two )
    Check( (instr( gd, "#import ""../rptOrders""" & LF ) > 0) andalso (instr( gd, "#import ""../rptOrders""" & LF ) = instrrev( gd, "#import ""../rptOrders""" & LF )) _
        andalso (instr( gd, "#import ""rptMixed""" & LF ) > 0), "designed report: each report module imported once", gd )
    HasLine( gd, "rvAReport as rptOrders.Report", "designed report: the member, of the report's type" )
    HasLine( gd, "rvCReport as rptMixed.Report", "designed report: a second report's member" )
    Check( instr( formfile.Render( dd ), "report = ""../rptOrders""" & LF ) > 0, "designed report: written back" )
    Refused( Header( ) & Ctl( "b", "Button", "report = ""rptOrders""" & LF ), "only a ReportViewer shows a report" )
    Refused( Header( ) & Ctl( "rv", "ReportViewer", "report = ""../rpt Orders""" & LF ), "is not a report module" )
    Refused( Header( ) & Ctl( "rv", "ReportViewer", "report = ""rptOrders""" & LF ) & Ctl( "rvReport", "Button" ), "rvReport is the name of a control" )
    Refused( Header( ) & Ctl( "rv", "ReportViewer", "report = ""rptOrders""" & LF & "items_source = ""S""" & LF & "item_type = ""T""" & LF ), "not both" )
end sub

sub SliderSuite( )
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "caption = ""S""" & LF & "width = 300" & LF & "height = 200" & LF _
        & Ctl( "sld", "Slider" ) & LF & "[control.props]" & LF & "Value = 500" & LF & "UpperValue = 800" & LF & "Mode = ""Range""" & LF _
        & "Range = ""0,1000""" & LF & "Step = 5" & LF & "Orientation = ""Vertical""" & LF & "ThumbSize = ""12,20""" & LF _
        & LF & "[control.events]" & LF & "FormatValue = ""sld_Format""" & LF & "ValueCommitted = ""sld_Done""" & LF
    dim as FormDoc d
    Check( ReadForm( src, d ), "slider: the form parses" )
    Accepted( src, "slider: its props and events" )
    dim as ustring g = codegen.Generate( d, "frmS", "frmS.tkform", src )
    dim as long nRange = instr( g, "    sld.Range( 0, 1000 )" ), nStep = instr( g, "    sld.Step = 5" )
    dim as long nMode = instr( g, "    sld.Mode = TKSL_MODE_RANGE" ), nVal = instr( g, "    sld.Value = 500" ), nUp = instr( g, "    sld.UpperValue = 800" )
    Check( (nRange > 0) andalso (nStep > 0) andalso (nMode > 0) andalso (nVal > 0) andalso (nUp > 0), "slider: the five lines", LineWith( g, "sld." ) )
    Check( (nRange < nStep) andalso (nStep < nMode) andalso (nMode < nVal) andalso (nVal < nUp), "slider: Range, Step, Mode, then Value, UpperValue", _
           nRange & " " & nStep & " " & nMode & " " & nVal & " " & nUp )
    HasLine( g, "sld.Orientation = TKSL_VERTICAL", "slider: an enum prop is its constant" )
    HasLine( g, "sld.ThumbSize( 12, 20 )", "slider: a list prop" )
    Check( instr( g, "private function Thunk_sld_FormatValue( byval hSlider as TK_WIDGET ptr, byval nValue as float64, byval nWhere as int32 ) as ustring" & LF _
        & "    dim as ustring Text" & LF ) > 0, "slider: FormatValue's thunk answers its Text", LineWith( g, "Thunk_sld_FormatValue" ) )
    HasLine( g, "tkSlider_SetValueCommittedCallback( sld.Handle, @Thunk_sld_ValueCommitted )", "slider: ValueCommitted installed" )
end sub

' A Barcode (BARCODE.md BC3): its symbology at creation, the paper and option rows, a load-only Bind
' (LoadFrom sets the data; SaveTo leaves it), and a dropped one seeded with data the canvas can show.
sub BarcodeSuite( )
    dim as ustring hdr = Header( ) & "data_type = ""shop.Product""" & LF & "data_module = ""../shop""" & LF
    dim as ustring src = hdr & Ctl( "bcSku", "Barcode", "bind = ""Sku""" & LF ) & "[control.props]" & LF _
        & "Symbology = ""EAN13""" & LF & "FitMode = ""Fit""" & LF & "XDimension = 0.4" & LF & "Gs1 = true" & LF _
        & LF & Ctl( "txtName", "TextBox", "bind = ""Name""" & LF )
    dim as FormDoc d
    Check( ReadForm( src, d ), "barcode: the form parses" )
    Accepted( src, "barcode: bound, its rows" )
    dim as ustring g = codegen.Generate( d, "frmB", "frmB.tkform", src )
    Check( instr( g, "TKBC_EAN13" ) > 0, "barcode: the symbology is its constant", LineWith( g, "bcSku" ) )
    HasLine( g, "bcSku.FitMode = TKBC_FIT_FIT", "barcode: an enum row" )
    HasLine( g, "bcSku.Gs1 = true", "barcode: an option row" )
    HasLine( g, "tkBarcode_SetData( bcSku.Handle, tkBind_Text( r.Sku ) )", "barcode: LoadFrom sets the data" )
    dim as long nSave = instr( g, "function Form.SaveTo" )
    Check( (nSave > 0) andalso (instr( nSave, g, "bcSku" ) = 0), "barcode: load only, SaveTo leaves it" )
    ' a navigator with no list to follow still steps an Array: the file imports std/containers (B4)
    dim as FormDoc dn
    ReadForm( hdr & Ctl( "bcSku", "Barcode", "bind = ""Sku""" & LF ) & Ctl( "nav", "Navigator", "items_source = ""Products""" & LF ), dn )
    dim as ustring gn = codegen.Generate( dn, "frmN", "frmN.tkform", "" )
    Check( (instr( gn, "#import ""std/containers""" ) > 0) andalso (instr( gn, LF & "using containers" & LF ) > 0), "a navigator alone imports std/containers" )
    dim as FormDoc nd
    ReadForm( Header( ), nd )
    dim as long i = edits.AddControl( nd, "Barcode", "", -1, 8, 8, 200, 80 )
    Check( (i >= 0) andalso (FindSetting( nd.Controls[i].Props, "Data" ) >= 0), "barcode: a dropped one has Data = its name" )
end sub

' A DatePicker's date rows and its six new events, one answering from a starting value.
sub DatePickerSuite( )
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "caption = ""D""" & LF & "width = 300" & LF & "height = 200" & LF _
        & Ctl( "dtp", "DatePicker" ) & LF & "[control.props]" & LF & "MinDate = ""2026,1,1""" & LF & "Date = ""2026,3,9""" & LF _
        & LF & "[control.events]" & LF & "Parse = ""dtp_Parse""" & LF & "Format = ""dtp_Format""" & LF & "Paint = ""dtp_Paint""" & LF _
        & "DayPaint = ""dtp_DayPaint""" & LF & "Message = ""dtp_Message""" & LF & "Tooltip = ""dtp_Tooltip""" & LF
    dim as FormDoc d
    Check( ReadForm( src, d ), "datepicker: the form parses" )
    Accepted( src, "datepicker: the date rows and new events" )
    dim as ustring g = codegen.Generate( d, "frmD", "frmD.tkform", src )
    HasLine( g, "dtp.MinDate( 2026, 1, 1 )", "datepicker: MinDate" )
    HasLine( g, "dtp.Date( 2026, 3, 9 )", "datepicker: Date" )
    HasLine( g, "declare sub dtp_Parse( byval sText as ustring, byval pDate as TKDATE ptr, byref Accepted as boolean )", "datepicker: Parse declared" )
    HasLine( g, "declare sub dtp_Format( byval pDate as TKDATE ptr, byref sOut as ustring )", "datepicker: Format declared" )
    HasLine( g, "declare sub dtp_Tooltip( byval t as TKDATEPICKER_TOOLTIPINFO ptr, byref Show as boolean )", "datepicker: Tooltip declared" )
    Check( instr( g, "private function Thunk_dtp_Parse( byval hCtrl as TK_WIDGET ptr, byval sText as ustring, byval pDate as TKDATE ptr ) as boolean" & LF _
        & "    dim as boolean Accepted" & LF ) > 0, "datepicker: Parse answers Accepted" )
    Check( instr( g, "    dim as boolean Show = true" & LF & "    dim as Form ptr f = tkForms_ObjectOf( t->hCtrl )" & LF ) > 0, "datepicker: Tooltip's Show starts true" )
    Check( instr( g, "tkForms_ObjectOf( d->hCtrl )" ) > 0, "datepicker: DayPaint finds its form through the day info" )
    HasLine( g, "tkDatePicker_SetFormatCallback( dtp.Handle, @Thunk_dtp_Format )", "datepicker: Format installed" )
    Check( (instr( g, "#import ""vendor/tkControls/tkCalendar""" ) > 0) andalso (instr( g, LF & "using tkCalendar" & LF ) > 0), "datepicker: TKDATE's module is in scope" )
    dim as Array( of ustring ) im = reconcile.ImportsFor( "byval pDate as TKDATE ptr, byref sOut as ustring", "tkDatePicker" )
    Check( (im.Count( ) = 1) andalso (im[0] = "tkCalendar"), "datepicker: a TKDATE handler's file imports tkCalendar", str( im.Count( ) ) )
    im = reconcile.ImportsFor( "byval d as TKDATEPICKER_DAYPAINTINFO ptr", "tkDatePicker" )
    Check( (im.Count( ) = 1) andalso (im[0] = "tkDatePicker"), "datepicker: its own types import tkDatePicker" )
    dim as FormDoc plainDtp
    ReadForm( "format = 1" & LF & LF & "[form]" & LF & "caption = ""D""" & LF & "width = 300" & LF & "height = 200" & LF & Ctl( "dtp", "DatePicker" ), plainDtp )
    Check( instr( codegen.Generate( plainDtp, "frmD", "frmD.tkform", "" ), "tkCalendar" ) = 0, "datepicker: no date event, no tkCalendar" )
end sub

' A Calendar's date and name rows and its five new events.
sub CalendarSuite( )
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "caption = ""C""" & LF & "width = 300" & LF & "height = 260" & LF _
        & Ctl( "cal", "Calendar" ) & LF & "[control.props]" & LF & "AnchorMonth = ""2026,3""" & LF & "SelDate = ""2026,3,9""" & LF _
        & "MonthNames = ""Enero,Febrero""" & LF _
        & LF & "[control.events]" & LF & "Paint = ""cal_Paint""" & LF & "DayPaint = ""cal_DayPaint""" & LF & "MonthYearPaint = ""cal_MyPaint""" & LF _
        & "Message = ""cal_Message""" & LF & "Tooltip = ""cal_Tooltip""" & LF
    dim as FormDoc d
    Check( ReadForm( src, d ), "calendar: the form parses" )
    Accepted( src, "calendar: the new rows and events" )
    dim as ustring g = codegen.Generate( d, "frmC", "frmC.tkform", src )
    HasLine( g, "cal.AnchorMonth( 2026, 3 )", "calendar: AnchorMonth" )
    HasLine( g, "cal.SelDate( 2026, 3, 9 )", "calendar: SelDate" )
    HasLine( g, "cal.MonthNames = ""Enero,Febrero""", "calendar: MonthNames" )
    HasLine( g, "declare sub cal_MyPaint( byval c as TKCALENDAR_MYPAINTINFO ptr )", "calendar: MonthYearPaint declared" )
    Check( instr( g, "tkForms_ObjectOf( c->hCtrl )" ) > 0, "calendar: MonthYearPaint finds its form through the cell info" )
    Check( instr( g, "    dim as boolean Show = true" & LF & "    dim as Form ptr f = tkForms_ObjectOf( t->hCtrl )" & LF ) > 0, "calendar: Tooltip's Show starts true" )
    HasLine( g, "tkCalendar_SetMonthYearPaintCallback( cal.Handle, @Thunk_cal_MonthYearPaint )", "calendar: MonthYearPaint installed" )
    dim as Array( of ustring ) im = reconcile.ImportsFor( "byval c as TKCALENDAR_MYPAINTINFO ptr", "tkCalendar" )
    Check( (im.Count( ) = 1) andalso (im[0] = "tkCalendar"), "calendar: its own types import tkCalendar once" )
end sub

' A CodeEdit's settings and its events, the raw Notify among them.
sub CodeEditSuite( )
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "caption = ""E""" & LF & "width = 400" & LF & "height = 300" & LF _
        & Ctl( "ed", "CodeEdit" ) & LF & "[control.props]" & LF & "WrapMode = ""Word""" & LF & "LineNumbers = true" & LF & "TabWidth = 4" & LF _
        & LF & "[control.events]" & LF & "Change = ""ed_Change""" & LF & "MarginClick = ""ed_Margin""" & LF & "Notify = ""ed_Notify""" & LF _
        & "ContextMenu = ""ed_Menu""" & LF
    dim as FormDoc d
    Check( ReadForm( src, d ), "codeedit: the form parses" )
    Accepted( src, "codeedit: the new rows and events" )
    dim as ustring g = codegen.Generate( d, "frmE", "frmE.tkform", src )
    HasLine( g, "ed.WrapMode = TKCE_WRAP_WORD", "codeedit: WrapMode" )
    HasLine( g, "ed.LineNumbers = true", "codeedit: LineNumbers" )
    HasLine( g, "declare sub ed_Margin( byval margin as int32, byval position as int64, byval modifiers as int32 )", "codeedit: MarginClick declared" )
    HasLine( g, "declare sub ed_Notify( byval n as const TKCE_NOTIFICATION ptr )", "codeedit: Notify declared" )
    HasLine( g, "tkCodeEdit_SetChangeCallback( ed.Handle, @Thunk_ed_Change )", "codeedit: Change installed" )
    Check( tkMeta_Find( "CodeEdit" )->DefaultEvent = "Change", "codeedit: Change is the default event" )
    dim as Array( of ustring ) im = reconcile.ImportsFor( "byval n as const TKCE_NOTIFICATION ptr", "tkCodeEdit" )
    Check( (im.Count( ) = 1) andalso (im[0] = "tkCodeEdit"), "codeedit: a const pointer to its type imports tkCodeEdit" )
end sub

' A CheckBox's Paint, Tooltip and Message events.
sub CheckBoxSuite( )
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "caption = ""K""" & LF & "width = 300" & LF & "height = 200" & LF _
        & Ctl( "chk", "CheckBox" ) & LF & "[control.events]" & LF & "Paint = ""chk_Paint""" & LF & "Tooltip = ""chk_Tip""" & LF _
        & "Message = ""chk_Message""" & LF
    dim as FormDoc d
    Check( ReadForm( src, d ), "checkbox: the form parses" )
    Accepted( src, "checkbox: the new events" )
    dim as ustring g = codegen.Generate( d, "frmK", "frmK.tkform", src )
    Check( instr( g, "tkForms_ObjectOf( p->hCheckBox )" ) > 0, "checkbox: Paint finds its form through the paint info" )
    Check( instr( g, "private function Thunk_chk_Tooltip( byval hCheckBox as TK_WIDGET ptr ) as ustring" & LF & "    dim as ustring Text" & LF ) > 0, "checkbox: Tooltip answers Text" )
    Check( instr( g, "tkForms_ObjectOf( m->hCheckBox )" ) > 0, "checkbox: Message finds its form through the message info" )
    HasLine( g, "tkCheckBox_SetTooltipCallback( chk.Handle, @Thunk_chk_Tooltip )", "checkbox: Tooltip installed" )
end sub

' An OptionButton's Paint, Tooltip and Message events.
sub OptionButtonSuite( )
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "caption = ""O""" & LF & "width = 300" & LF & "height = 200" & LF _
        & Ctl( "opt", "OptionButton" ) & LF & "[control.events]" & LF & "Paint = ""opt_Paint""" & LF & "Tooltip = ""opt_Tip""" & LF _
        & "Message = ""opt_Message""" & LF
    dim as FormDoc d
    Check( ReadForm( src, d ), "optionbutton: the form parses" )
    Accepted( src, "optionbutton: the new events" )
    dim as ustring g = codegen.Generate( d, "frmO", "frmO.tkform", src )
    Check( instr( g, "tkForms_ObjectOf( p->hOptionButton )" ) > 0, "optionbutton: Paint finds its form through the paint info" )
    Check( instr( g, "private function Thunk_opt_Tooltip( byval hOptionButton as TK_WIDGET ptr ) as ustring" & LF & "    dim as ustring Text" & LF ) > 0, "optionbutton: Tooltip answers Text" )
    Check( instr( g, "tkForms_ObjectOf( m->hOptionButton )" ) > 0, "optionbutton: Message finds its form through the message info" )
    HasLine( g, "tkOptionButton_SetMessageCallback( opt.Handle, @Thunk_opt_Message )", "optionbutton: Message installed" )
end sub

' A Toggle's tooltip rows and its Paint and Message events.
sub ToggleSuite( )
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "caption = ""T""" & LF & "width = 300" & LF & "height = 200" & LF _
        & Ctl( "tg", "Toggle" ) & LF & "[control.props]" & LF & "TooltipText = ""Wi-Fi""" & LF & "BorderThickness = 2" & LF _
        & LF & "[control.events]" & LF & "Paint = ""tg_Paint""" & LF & "Message = ""tg_Message""" & LF
    dim as FormDoc d
    Check( ReadForm( src, d ), "toggle: the form parses" )
    Accepted( src, "toggle: the new rows and events" )
    dim as ustring g = codegen.Generate( d, "frmT", "frmT.tkform", src )
    HasLine( g, "tg.TooltipText = ""Wi-Fi""", "toggle: TooltipText" )
