    Check( instr( g, "tkForms_ObjectOf( m->hToggle )" ) > 0, "toggle: Message finds its form through the message info" )
    HasLine( g, "tkToggle_SetMessageCallback( tg.Handle, @Thunk_tg_Message )", "toggle: Message installed" )
