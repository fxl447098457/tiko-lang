format = 1

[form]
caption = "Say \"hi\"\nTwo"
width = 300
height = 200

[form.events]
Load = "Form_Load"
Close = "Form_Close"

[[control]]
name = "pnlSide"
type = "Panel"
parent = ""
x = 0
y = 0
w = 100
h = 50
dock = "left"

[[control]]
name = "btnGo"
type = "Button"
parent = "pnlSide"
x = 4
y = 4
w = 80
h = 24
anchor = "right bottom"

[control.props]
Enabled = false
Text = "Go"
TextAlign = "Right"
Font = "UI_BOLD"

[control.colors]
style = "Danger"
BackColor = "#C62828"
ForeColor = { dark = "#FFFFFF", light = "#FFF8F8" }
BorderColor = "@Border"

[control.events]
Click = "Shared_Click"

[[control]]
name = "lblNote"
type = "Label"
parent = "pnlSide"
x = 4
y = 32
w = 80
h = 24
anchor = "none"

[control.colors]
TextColor = "#336699"

[control.events]
Click = "Shared_Click"

[[control]]
name = "tabs"
type = "TabControl"
parent = ""
x = 0
y = 0
w = 10
h = 10
dock = "fill"
pages = ["One", "Two", "Three"]

[control.props]
TabHeight = 24

[[control]]
name = "txtBody"
type = "TextBox"
parent = "tabs"
page = 1
x = 2
y = 2
w = 100
h = 40

[control.props]
Multiline = true
Text = "a\tb"

[[control]]
name = "grp"
type = "GroupBox"
parent = "tabs"
page = 0
x = 2
y = 2
w = 100
h = 60

[[control]]
name = "pbFill"
type = "ProgressBar"
parent = "grp"
x = 1
y = 1
w = 50
h = 10
dock = "bottom"

[control.props]
Orientation = "Vertical"

[[control]]
name = "scp"
type = "ScrollPanel"
parent = "tabs"
page = 0
x = 110
y = 2
w = 50
h = 50

[[control]]
name = "lblIn"
type = "Label"
parent = "scp"
x = 0
y = 0
w = 10
h = 10

[[control]]
name = "pnlOnPage"
type = "Panel"
parent = "tabs"
page = 1
x = 0
y = 0
w = 30
h = 5
dock = "left"

[[control]]
name = "lblDeep"
type = "Label"
parent = "pnlOnPage"
x = 0
y = 0
w = 10
h = 10

[[orphan]]
handler = "Gone_Click"
params = "byval x as long"
