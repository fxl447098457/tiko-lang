format = 1

[report]
title = "Golden"
data_module = "../shopdata"

[report.events]
BeforePrint = "OnBefore"
PaintItem = "OnPaint"

[[parameter]]
name = "Label"

[[parameter]]
name = "Min"
type = "int"
default = "3"

[[parameter]]
name = "Rate"
type = "float"

[[parameter]]
name = "Paid"
type = "bool"

[[parameter]]
name = "From"
type = "date"

[[parameter]]
name = "At"
type = "time"

[[source]]
name = "Orders"
kind = "array"
item_type = "shopdata.Order"
items_source = "shopdata.Orders( )"

  [[source.field]]
  name = "Id"
  kind = "int"

  [[source.field]]
  name = "Ship.City"

[[source]]
name = "Lines"
kind = "array"
parent = "Orders"
relation = "Lines"
item_type = "shopdata.Line"

  [[source.field]]
  name = "Qty"
  kind = "int"

[[source]]
name = "Rates"
kind = "sqlite"
sql = "select * from rates"

[[source]]
name = "Stock"
kind = "grid"

[[source]]
name = "Extra"

[[band]]
id = "d"
kind = "detail"
source = "Orders"

[[item]]
id = "a"
band = "d"
rect = [0, 0, 100, 14]
text = "{[Id]}"
