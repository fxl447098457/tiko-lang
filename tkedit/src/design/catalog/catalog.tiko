' catalog -- every control type the designer knows: tkMeta's table, plus Custom, a labelled stand-in
' for a control the designer can't create because it's the program's own. It's drawn as a label and
' promoted to a named type and module: at run time that type is what gets created.
#module "catalog"

#import "vendor/tkControls/tkMeta"
#import "vendor/tkControls/tkLabel"
using tkMeta
using tkLabel
using tkHost

public const as string CUSTOM_TYPE = "Custom"

private function CreateStandIn( byval hParent as TK_WIDGET ptr, byval id as long, byref arg as const ustring ) as TK_WIDGET ptr
    dim as TK_WIDGET ptr w = tkLabel_Create( hParent, id )
    tkLabel_SetAlign( w, LBL_ALIGN_CENTER )
    return w
end function

' Which list of entries a control type has, if any.
public enum ItemsKind explicit
    ItemsNone = 0
    ItemsMenu
    ItemsToolbar
    ItemsStatus
    ItemsColumns
    ItemsList
    ItemsPages
end enum

public function ItemsKindOf( byref typeName as const ustring ) as ItemsKind
    select case typeName
    case "MenuBar"    : return ItemsKind.ItemsMenu
    case "Toolbar"    : return ItemsKind.ItemsToolbar
    case "StatusBar"  : return ItemsKind.ItemsStatus
    case "ListTree"   : return ItemsKind.ItemsColumns
    case "ComboBox"   : return ItemsKind.ItemsList
    case "TabControl" : return ItemsKind.ItemsPages
    end select
    return ItemsKind.ItemsNone
end function

public function Find( byref name_ as const ustring ) as TKMETA_CONTROL ptr
    if name_ <> CUSTOM_TYPE then return tkMeta_Find( name_ )
    static as TKMETA_CONTROL standIn
    if standIn.Create = 0 then
        standIn.Name = CUSTOM_TYPE
        standIn.Category = "Custom"
        standIn.Width_ = 120
        standIn.Height_ = 60
        standIn.Create = @CreateStandIn
    end if
    return @standIn
end function
