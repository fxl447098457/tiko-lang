' catalog -- every control type the designer knows: tkMeta's table, plus Custom, a labelled stand-in
' for a control the designer can't create because it's the program's own. It's drawn as a label and
' promoted to a named type and module: at run time that type is what gets created.
#module "catalog"

#import "vendor/tkControls/tkMeta"
#import "vendor/tkControls/tkLabel"
#import "../model"
using tkMeta
using tkLabel
using tkHost
using model

public const as string CUSTOM_TYPE = "Custom"

private function CreateStandIn( byval hParent as TK_WIDGET ptr, byval id as long, byref arg as const ustring ) as TK_WIDGET ptr
    dim as TK_WIDGET ptr w = tkLabel_Create( hParent, id )
    tkLabel_SetAlign( w, LBL_ALIGN_CENTER )
    return w
end function

' A component (tkMeta's visual = false, a Timer): created on the form but never shown or laid out.
' The designer draws it as a fixed box with its name, on the form itself, never inside a container.
public function IsComponent( byref typeName as const ustring ) as boolean
    if typeName = CUSTOM_TYPE then return false
    dim as TKMETA_CONTROL ptr m = tkMeta_Find( typeName )
    return (m <> 0) andalso (m->Visual = false)
end function

' The box that stands for a component on the design surface: a label the canvas names.
public function CreateComponentBox( byval hParent as TK_WIDGET ptr, byval id as long ) as TK_WIDGET ptr
    return CreateStandIn( hParent, id, "" )
end function

' Menu items, a bar's drop-downs or a right-click menu's: text, shortcut, handler, indented levels.
' A MenuBar's level 0 is the bar itself; a PopupMenu's level 0 is the menu that opens.
public function IsMenuKind( byval kind_ as long ) as boolean
    return (kind_ = ItemsKind.ItemsMenu) orelse (kind_ = ItemsKind.ItemsPopup)
end function

' The type whose components a ContextMenu property names.
public const as string POPUP_TYPE = "PopupMenu"

' A Badge hangs on another control (D-B3): its corners and overlaps as the inspector shows them
' (the first is the default), and the constant each one is.
public const as string BADGE_TYPE = "Badge"
public const as string BADGE_CORNERS = "TopRight,TopLeft,BottomRight,BottomLeft"
public const as string BADGE_OVERLAPS = "Rect,Circle"

' 0 .. 3 for a corner's name ("" and an unknown name: TopRight), as TKBADGE_TOP_RIGHT ...
public function BadgeCornerIndex( byref s as const ustring ) as long
    select case lcase( s )
    case "topleft" : return 1
    case "bottomright" : return 2
    case "bottomleft" : return 3
    end select
    return 0
end function

public function BadgeCornerConst( byref s as const ustring ) as string
    select case BadgeCornerIndex( s )
    case 1 : return "TKBADGE_TOP_LEFT"
    case 2 : return "TKBADGE_BOTTOM_RIGHT"
    case 3 : return "TKBADGE_BOTTOM_LEFT"
    end select
    return "TKBADGE_TOP_RIGHT"
end function

public function BadgeOverlapIsCircle( byref s as const ustring ) as boolean
    return lcase( s ) = "circle"
end function

private function IsInt_( byref s as const ustring ) as boolean
    if len( s ) = 0 then return false
    for i as long = 1 to len( s )
        dim as string ch = mid( s, i, 1 )
        if (ch = "-") andalso (i = 1) andalso (len( s ) > 1) then continue for
        if (ch < "0") orelse (ch > "9") then return false
    next
    return true
end function

' "dx,dy" in design units; "" or a malformed part reads 0. FALSE when s is not two integers.
public function BadgeOffset( byref s as const ustring, byref dx as long, byref dy as long ) as boolean
    dx = 0 : dy = 0
    dim as ustring t = trim( s )
    if len( t ) = 0 then return true
    dim as long k = instr( t, "," )
    if k = 0 then return false
    dim as ustring a = trim( left( t, k - 1 ) ), b = trim( mid( t, k + 1 ) )
    if (IsInt_( a ) = false) orelse (IsInt_( b ) = false) then return false
    dx = valint( a ) : dy = valint( b )
    return true
end function


' Which list of entries a control type has, if any.
public enum ItemsKind explicit
    ItemsNone = 0
    ItemsMenu
    ItemsToolbar
    ItemsStatus
    ItemsColumns
    ItemsList
    ItemsPages
    ItemsIcons
    ItemsPopup
    ItemsTabs       ' a TabBar's tabs: a caption and a glyph each
    ItemsGridColumns ' a DataGrid's columns: caption, width, kind, field (G5)
end enum

' An entry handler's parameters, by the kind of control: a status bar panel's is told how many clicks
' (2 for a double click); a menu or toolbar entry's takes none.
public function ItemHandlerParams( byval kind_ as ItemsKind ) as ustring
    if kind_ = ItemsKind.ItemsStatus then return "byval clicks as int32"
    return ""
end function

' The event of the control that reaches its entries' handlers, "" for none: a menu's Command, a
' toolbar's, an icon panel's or a status bar's Click.
public function ItemDispatchEvent( byval kind_ as ItemsKind ) as ustring
    select case kind_
    case ItemsKind.ItemsMenu, ItemsKind.ItemsPopup : return "Command"
    case ItemsKind.ItemsToolbar, ItemsKind.ItemsIcons, ItemsKind.ItemsStatus : return "Click"
    end select
    return ""
end function

' ---- the form's own events, in the order the inspector lists them ----
public function FormEventCount( ) as long
    return 9
end function

public function FormEventName( byval i as long ) as ustring
    select case i
    case 0 : return "Load"
    case 1 : return "Close"
    case 2 : return "Resize"
    case 3 : return "KeyDown"
    case 4 : return "Paint"
    case 5 : return "Destroy"
    case 6 : return "ThemeChanged"
    case 7 : return "MouseMove"
    case 8 : return "ValidationError"
    end select
    return ""
end function

public function IsFormEvent( byref ev as const ustring ) as boolean
    for i as long = 0 to FormEventCount( ) - 1
        if FormEventName( i ) = ev then return true
    next
    return false
end function

' A MouseMove handler's parameters, the form's and a control's alike.
public const as string MOUSEMOVE_PARAMS = "byval x as int32, byval y as int32, byval buttons as int32, byval mods as int32"

' ValidationError (B2): what the form's SaveTo refused (Loading = false) or LoadFrom couldn't show as
' it is (Loading = true). Handled = true keeps the default (a message box) from showing.
public const as string VALIDATION_PARAMS = "byref Errors as TKBIND_ERRORS, byval Loading as boolean, byref Handled as boolean"

' A form event handler's parameters. Resize: the client in pixels, after the layout. KeyDown: a key
' no control claimed. Paint: the form's background, under its controls. MouseMove: pixels from the
' client's top-left, over the form and over any control with no MouseMove of its own.
public function FormEventParams( byref ev as const ustring ) as ustring
    select case ev
    case "Close"   : return "byref Cancel as boolean"
    case "Resize"  : return "byval cx as int32, byval cy as int32"
    case "KeyDown" : return "byval keyCode as int32, byval mods as int32, byref Handled as boolean"
    case "Paint"   : return "byval pPaint as TK_PAINT ptr"
    case "MouseMove" : return MOUSEMOVE_PARAMS
    case "ValidationError" : return VALIDATION_PARAMS
    end select
    return ""
end function

' ---- types an event names that are another module's than its control's ----
' A DatePicker's date events name TKDATE (tkCalendar's), a TimePicker's TKTIME and a DateTimePicker's TKDATETIME (tkTimePanel's); a ListTree's header events name
' TKCOLUMNHEADER_* (tkColumnHeader's); a ReportViewer's TK_REPORT (tkReport's) and TKPRINTJOB (tkPrinter's); a ScrollPanel's SCP_PAINTINFO and SCP_MESSAGEINFO are its own
' but not spelled TK*, so they are listed here too. Both the generated file and the user's need that module in
' scope: a public #import of it by the control's module isn't enough for the names.
public function ForeignTypeCount( ) as long
    return 8
end function

' The type's spelling in upper case, as it follows "AS " (TKDATE alone: TKDATEPICKER_* is not it).
public function ForeignTypePrefix( byval i as long ) as ustring
    select case i
    case 0 : return "TKDATE "
    case 1 : return "TKCOLUMNHEADER_"
    case 2 : return "SCP_"
    case 3 : return "TKBIND_"
    case 4 : return "TKTIME "
    case 5 : return "TKDATETIME "
    case 6 : return "TK_REPORT "
    case 7 : return "TKPRINTJOB "
    end select
    return ""
end function

public function ForeignTypeModule( byval i as long ) as ustring
    select case i
    case 0 : return "tkCalendar"
    case 1 : return "tkColumnHeader"
    case 2 : return "tkScrollPanel"
    case 3 : return "tkBind"
    case 4 : return "tkTimePanel"
    case 5 : return "tkTimePanel"
    case 6 : return "tkReport"
    case 7 : return "tkPrinter"
    end select
    return ""
end function

' The procedure that adds one entry of a text-only list (ItemsList): a combo's item, a select bar's panel.
public function ItemsAddProc( byref typeName as const ustring ) as ustring
    select case typeName
    case "SelectBar"       : return "tkSelectBar_AddPanel"
    case "CheckedList"     : return "tkCheckedList_AddItem"
    case "CheckedComboBox" : return "tkCheckedCombo_AddItem"
    case "TokenBox"        : return "tkTokenBox_AddItem"
    case "AutoComplete"    : return "tkAutoComplete_AddItem"
    case "AvatarGroup"     : return "tkAvatarGroup_AddItem"
    end select
    return "tkComboBox_AddItem"
end function

' The procedure that empties an "items" list before a fill (B3).
public function ItemsClearProc( byref typeName as const ustring ) as ustring
    select case typeName
    case "CheckedList"     : return "tkCheckedList_Clear"
    case "CheckedComboBox" : return "tkCheckedCombo_Clear"
    case "TokenBox"        : return "tkTokenBox_ClearItems"
    case "AutoComplete"    : return "tkAutoComplete_Clear"
    end select
    return "tkComboBox_Clear"
end function

' A list whose AddItem takes a KEY (the checked-list controls): an "items" fill passes ValueField as
' the key, and the control's own value is made of those keys -- no _Values_ member, no index mapping.
public function ItemsKeyed( byref typeName as const ustring ) as boolean
    select case typeName
    case "CheckedList", "CheckedComboBox", "TokenBox" : return true
    end select
    return false
end function

' A list whose AddItem takes a numeric ID (an AutoComplete): an "items" fill passes ValueField as
' each item's id, and the control's own value (BindValue) IS that id -- no _Values_ member, no
' index mapping (docs/tkControls/AUTOCOMPLETE.md section 10.4).
public function ItemsIdKeyed( byref typeName as const ustring ) as boolean
    return typeName = "AutoComplete"
end function

public function ItemsKindOf( byref typeName as const ustring ) as ItemsKind
    select case typeName
    case "MenuBar"    : return ItemsKind.ItemsMenu
    case "PopupMenu"  : return ItemsKind.ItemsPopup
    case "Toolbar"    : return ItemsKind.ItemsToolbar
    case "IconPanel"  : return ItemsKind.ItemsIcons
    case "StatusBar"  : return ItemsKind.ItemsStatus
    case "ListTree"   : return ItemsKind.ItemsColumns
    case "DataGrid"   : return ItemsKind.ItemsGridColumns
    case "ReportViewer" : return ItemsKind.ItemsColumns     ' its report's fields (R5): caption, width, Field
    case "ComboBox"   : return ItemsKind.ItemsList
    case "SelectBar"  : return ItemsKind.ItemsList
    case "CheckedList", "CheckedComboBox", "TokenBox" : return ItemsKind.ItemsList
    case "AutoComplete" : return ItemsKind.ItemsList
    case "AvatarGroup" : return ItemsKind.ItemsList
    case "TabBar"     : return ItemsKind.ItemsTabs
    case "TabControl" : return ItemsKind.ItemsPages
    end select
    return ItemsKind.ItemsNone
end function

public function Find( byref name_ as const ustring ) as TKMETA_CONTROL ptr
    if name_ <> CUSTOM_TYPE then return tkMeta_Find( name_ )
    static as TKMETA_CONTROL standIn
    if standIn.Create = 0 then
        standIn.Name = CUSTOM_TYPE
        standIn.Category = "Custom"
        standIn.Width_ = 120
        standIn.Height_ = 60
        standIn.Create = @CreateStandIn
    end if
    return @standIn
end function

' A two-value control's second binding (tkMeta's bind2, a range Slider's BindUpper) applies: the type
' has one, and the property its Bind2When names holds that value -- the control's own setting, or the
' property's default when the form leaves it unset.
public function Bind2Holds( byref c as FormControl ) as boolean
    dim as TKMETA_CONTROL ptr m = Find( c.TypeName )
    if (m = 0) orelse (len( m->Bind2Kind ) = 0) then return false
    dim as long eq = instr( m->Bind2When, "=" )
    if eq = 0 then return true
    dim as ustring pn = left( m->Bind2When, eq - 1 )
    dim as TKMETA_PROP ptr p = tkMeta_FindProp( m, pn )
    dim as ustring dflt
    if p then dflt = p->DefaultValue
    return lcase( SettingOr( c.Props, pn, dflt ) ) = lcase( mid( m->Bind2When, eq + 1 ) )
end function

' Which of B2's rules (Required Minimum Maximum MaxLength Format) a type's bound value takes: a text
' box all five; a load-only one (a Label) only Format; a date Required and a range; a number a range;
' an int with a "nothing chosen" value (a ComboBox) Required. A bool, a colour, a time: none.
public function RuleAllowed( byval m as TKMETA_CONTROL ptr, byref rule as const ustring ) as boolean
    if m = 0 then return false
    select case m->BindKind
    case "text"
        if m->BindLoadOnly then return rule = "Format"
        return true
    case "date"
        return (rule = "Required") orelse (rule = "Minimum") orelse (rule = "Maximum")
    case "float"
        return (rule = "Minimum") orelse (rule = "Maximum")
    case "int"
        return (len( m->BindNone ) > 0) andalso (rule = "Required")
    end select
    return false
end function

' The rules a control carries, by name, in the inspector's order.
public function RulesSet( byref c as FormControl ) as ustring
    dim as ustring o
    if c.Required then o &= "Required "
    if len( c.Minimum ) then o &= "Minimum "
    if len( c.Maximum ) then o &= "Maximum "
    if c.MaxLength <> 0 then o &= "MaxLength "
    if len( c.Format ) then o &= "Format "
    return rtrim( o )
end function

' ---- B3: list binding ------------------------------------------------------------------------
' A control's list shape (tkMeta's items_bind): "rows" (ListTree), "items" (ComboBox), "grid"
' (DataGrid, G5), "report" (a ReportViewer's own report, R5: a row per element, a field per column),
' "records" (a Navigator), "" none.
public function ItemsBindOf( byref c as FormControl ) as ustring
    dim as TKMETA_CONTROL ptr m = Find( c.TypeName )
    if m = 0 then return ""
    return m->ItemsBind
end function

' The control fills its list from an array: a DataType field or an expression.
public function HasListSource( byref c as FormControl ) as boolean
    return (len( c.ItemsField ) > 0) orelse (len( c.ItemsSource ) > 0)
end function

' What a list with a source still lacks before code can be made for it, "" when nothing: its
' ItemType, a ComboBox's DisplayField, a ListTree column's Field. The inspector fills these in one at
' a time, so validate lets them be missing; the generated file says so with an #error instead.
public function ListMissing( byref c as FormControl ) as ustring
    dim as ustring shape = ItemsBindOf( c )
    if ((shape <> "rows") andalso (shape <> "items") andalso (shape <> "grid") andalso (shape <> "report")) orelse (HasListSource( c ) = false) then return ""
    if len( c.ItemType ) = 0 then return "its list needs an ItemType, the type of its elements"
    if (shape = "items") andalso (len( c.DisplayField ) = 0) then return "its list needs a DisplayField, the text each item shows"
    if (shape = "rows") orelse (shape = "grid") orelse (shape = "report") then
        for each it as FormItem in c.Items
            if len( it.Field ) then return ""
        next
        return "its list needs a column with a Field, the element field it shows"
    end if
    return ""
end function

' A list that is filled from an array, complete enough to generate.
public function ListReady( byref c as FormControl ) as boolean
    dim as ustring shape = ItemsBindOf( c )
    return ((shape = "rows") orelse (shape = "items") orelse (shape = "grid") orelse (shape = "report")) andalso HasListSource( c ) andalso (len( ListMissing( c ) ) = 0)
end function

' A DataGrid column's Kind (G5): "" is text.
public function GridKindOk( byref kind as const ustring ) as boolean
    select case kind
    case "", "text", "number", "check", "combo", "date", "button", "link", "progress" : return true
    end select
    return false
end function

' The tkBind / tkDataGrid value kind a DataGrid column of that Kind moves: Text Float Bool Date.
public function GridValueKind( byref kind as const ustring ) as ustring
    select case kind
    case "number", "progress" : return "Float"
    case "check" : return "Bool"
    case "date" : return "Date"
    end select
    return "Text"
end function

' Its column constant (TKDG_COL_*), as source.
' A DataGrid column's Align ("" = by its kind) as its TKDG_ALIGN_* constant; "" for no such align.
public function GridAlignConst( byref a as const ustring ) as ustring
    select case a
    case ""       : return "TKDG_ALIGN_AUTO"
    case "left"   : return "TKDG_ALIGN_LEFT"
    case "center" : return "TKDG_ALIGN_CENTER"
    case "right"  : return "TKDG_ALIGN_RIGHT"
    end select
    return ""
end function

' G7b: a DataGrid column's footer total ("" = none); "" when the name is not one.
public function GridSummaryConst( byref s as const ustring ) as ustring
    select case s
    case ""      : return "TKDG_SUM_NONE"
    case "sum"   : return "TKDG_SUM_SUM"
    case "count" : return "TKDG_SUM_COUNT"
    case "avg"   : return "TKDG_SUM_AVG"
    case "min"   : return "TKDG_SUM_MIN"
    case "max"   : return "TKDG_SUM_MAX"
    end select
    return ""
end function

public function GridKindConst( byref kind as const ustring ) as ustring
    select case kind
    case "number"   : return "TKDG_COL_NUMBER"
    case "check"    : return "TKDG_COL_CHECK"
    case "combo"    : return "TKDG_COL_COMBO"
    case "date"     : return "TKDG_COL_DATE"
    case "button"   : return "TKDG_COL_BUTTON"
    case "link"     : return "TKDG_COL_LINK"
    case "progress" : return "TKDG_COL_PROGRESS"
    end select
    return "TKDG_COL_TEXT"
end function

' A ComboBox that binds its items' ValueField rather than its index. (A keyed list's value is
' already its items' keys: never.)
public function BindsByValue( byref c as FormControl ) as boolean
    if ItemsKeyed( c.TypeName ) orelse ItemsIdKeyed( c.TypeName ) then return false
    return (ItemsBindOf( c ) = "items") andalso ListReady( c ) andalso (len( c.ValueField ) > 0) andalso (len( c.Bind ) > 0)
end function

' ---- B4: the record navigator ------------------------------------------------------------------
public function IsNavigator( byref c as FormControl ) as boolean
    return ItemsBindOf( c ) = "records"
end function

' The form's navigator, wired: it steps through ItemsSource, an Array( of DataType ). -1 when the
' form has none, or it has no ItemsSource or the form no DataType yet.
public function NavReady( byref doc as FormDoc ) as long
    if len( doc.DataType ) = 0 then return -1
    for i as long = 0 to doc.Controls.Count( ) - 1
        if IsNavigator( doc.Controls[i] ) andalso (len( doc.Controls[i].ItemsSource ) > 0) then return i
    next
    return -1
end function

' The list control a wired navigator follows, ready (B3), or -1.
public function NavList( byref doc as FormDoc ) as long
    dim as long ni = NavReady( doc )
    if (ni < 0) orelse (len( doc.Controls[ni].Follows ) = 0) then return -1
    for i as long = 0 to doc.Controls.Count( ) - 1
        if lcase( doc.Controls[i].Name ) = lcase( doc.Controls[ni].Follows ) then
            if ListReady( doc.Controls[i] ) then return i
            return -1
        end if
    next
    return -1
end function
