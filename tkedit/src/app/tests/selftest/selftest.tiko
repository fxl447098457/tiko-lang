' selftest -- tkEdit --selftest: the real main window, driven by SDL events, at a pinned scale.
' Its config folder lives in <resources>/out/selftest, never the user's. Geometry is asserted, not
' eyeballed (PLAN.md, Verification).
#module "selftest"

#import "std/fs"
#import "std/process"
#import "std/strings"
#import "tkp/platform"
#import "tkc/bundled"
#import "tkc/appinfo"
#import "tkc/build"
#import "tkc/cmdids"
#import "tkc/docencoding"
#import "tkc/i18n"
#import "tkc/instance"
#import "tkc/keybind"
#import "tkc/project"
#import "tkc/runargs"
#import "tkc/session"
#import "tkc/settings"
#import "tka/documents"
#import "tka/editor"
#import "tka/explorer"
#import "tka/findstrip"
#import "tka/outputpane"
#import "tks/dapengine"
#import "tks/parser"
#import "tka/mainwin"
#import "tka/chrome"
#import "tka/completion"
#import "tka/startpanel"
#import "tka/debugpane"
#import "tkc/symboldb"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkPaint"
#import "vendor/tkControls/tkPopupMenu"
#import "vendor/tkControls/tkScrollBar"
#import "vendor/tkControls/tkButton"
#import "vendor/tkControls/tkCodeEdit"
#import "vendor/tkControls/tkMessageBox"
#import "vendor/tkControls/tkStatusBar"
#import "vendor/tkControls/tkTextBox"
#import "vendor/tkControls/tkTabBar"
#import "vendor/tkControls/tkToolbar"
#import "vendor/tkControls/tkTooltip"
#import "vendor/tkControls/tkColumnHeader"
#import "vendor/tkControls/tkListTree"
#import "vendor/tkControls/tkMenuBar"
#import "std/containers"
using containers
using cmdids
using tkCodeEdit
using dapengine
using tkApp
using tkHost
using tkTest
using tkPaint
using tkPopupMenu
using tkScrollBar
using tkButton
using tkMessageBox
using tkStatusBar
using tkTextBox
using tkColumnHeader
using tkListTree
using tkMenuBar
using tkTabBar
using tkToolbar
using tkTooltip
using tkTheme

private type DocRef as documents.Document ptr

' The modifier a command chord is pushed with: tkEdit's Primary, Cmd on macOS. Its own, not
' vendor/tkControls' TK_KMOD_PRIMARY, so the test builds against a toolchain packaged before it.
#if defined( TIKO_OS_MACOS )
const KMOD_PRIMARY = SDL_KMOD_GUI
#else
const KMOD_PRIMARY = SDL_KMOD_CTRL
#endif

' The self-test's score. Each failing check prints one FAIL line.
public type Tally
    passed as long
    failed as long
    declare sub Check( byval ok as boolean, byref what as const ustring )
end type

sub Tally.Check( byval ok as boolean, byref what as const ustring )
    if ok then
        passed += 1
    else
        failed += 1
        print "FAIL "; what
    end if
end sub

private function P( byval sc as single, byref what as const ustring ) as ustring
    return strings.Format( "[{}] {}", sc, what )
end function

' A pane's size as the layout gives it (mainwin.PlacePane): its view, the horizontal scrollbar's
' strip always kept under it, and beside it the vertical bar while that is shown.
private function PaneCH( byref mw as mainwin.Window, byval v as TK_WIDGET ptr ) as long
    return v->ch + tkForm_Scale( mw.form, mainwin.HBAR_CY )
end function

private function PaneCW( byref mw as mainwin.Window, byval v as TK_WIDGET ptr ) as long
    for i as long = 0 to 1
        dim as TK_WIDGET ptr b = mw.vbar( i )
        if tkWidget_IsVisible( b ) andalso (b->x = v->x + v->cw) andalso (b->y = v->y) then return v->cw + b->cw
    next
    return v->cw
end function

' Both find-strip toolbars paint the theme's Surface, the strip's own back colour.
private function StripToolsMatch( byref mw as mainwin.Window ) as boolean
    dim as TKTOOLBAR_COLORS a, b
    tkToolbar_GetColors( mw.Finder.tools, @a )
    tkToolbar_GetColors( mw.Finder.rtools, @b )
    return (a.BackColor = tkTheme_Get( ).Surface) andalso (b.BackColor = tkTheme_Get( ).Surface)
end function

' The find strip's prev / next / close are drawn from a glyph font that has them (PsIcons).
private function StripGlyphsDrawn( byref mw as mainwin.Window ) as boolean
    dim as TTF_Font ptr g = tkToolbar_GetGlyphFont( mw.Finder.tools )
    if g = 0 then return false
    return TTF_FontHasGlyph( g, &hE70E ) andalso TTF_FontHasGlyph( g, &hE70D ) andalso TTF_FontHasGlyph( g, &hE711 )
end function

' A fresh, empty config folder for one pass. Under the install folder (platform.InstallDir), never
' inside a macOS bundle: a file written in tkEdit.app breaks its signature.
private function FreshConfig( ) as ustring
    dim as ustring res = platform.ResourceDir( ).ValueOr( platform.InstallDir( ) )
    dim as ustring cfg = fs.PathJoin( res, "out", "selftest", "config" )
    fs.RemoveDirAll( cfg )
    fs.CreateDirAll( cfg )
    return cfg
end function

' The key-down may close the popup h is (Esc on a chooser); the pump then frees it, so the key-up
' and the pump after it go only to a host that is still open (valgrind: a read of freed memory).
private sub Chord( byval h as TK_HOST ptr, byval key as long, byval sc as long, byval mods as long )
    tkTest_PushKey( h, key, mods, true, sc )
    if tkHost_IsOpen( h ) = false then exit sub
    tkTest_PushKey( h, key, mods, false, sc )
    tkTest_PumpFor( h, 30 )
end sub

' The status panel's middle, in the window's pixels.
' A list w on host h, rendered: more than its back colour and one other -- its rows were drawn.
private function RowsDrawn( byval h as TK_HOST ptr, byval w as TK_WIDGET ptr ) as boolean
    if (h = 0) orelse (w = 0) then return false
    tkHost_RenderTo( h, false )
    dim as TKRECT a
    tkWidget_AbsRect( w, a )
    dim as ulong c0
    dim as long n = tkTest_TonesIn( h, a.left, a.top, a.right - a.left, a.bottom - a.top, c0 )
    if n <= 2 then print strings.Format( "  list: {} tones at {},{} {}x{}", n, a.left, a.top, a.right - a.left, a.bottom - a.top )
    return n > 2
end function

private sub ClickPanel( byref mw as mainwin.Window, byval panel as mainwin.StatusPanel )
    dim as TKRECT rc
    tkStatusBar_GetPanelRect( mw.status, panel, rc )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_Click( h, mw.status->x + (rc.left + rc.right) \ 2, mw.status->y + (rc.top + rc.bottom) \ 2 )
    tkTest_PumpFor( h, 60 )
end sub

' The same on pane 2's status line.
private sub ClickPanel2( byref mw as mainwin.Window, byval panel as mainwin.StatusPanel )
    dim as TKRECT rc
    tkStatusBar_GetPanelRect( mw.status2, panel, rc )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_Click( h, mw.status2->x + (rc.left + rc.right) \ 2, mw.status2->y + (rc.top + rc.bottom) \ 2 )
    tkTest_PumpFor( h, 60 )
end sub

' P0: the frame. Window size, fonts, the editor above one status row, the panels' text, and
' typing reaching the view and moving the caret panel; the position panel's click, and Esc closing
' the find strip from the box or the view.
public sub Pass( byref t as Tally, byval sc as single )
    dim as mainwin.Window mw
    mw.ConfigDir = FreshConfig( )
    t.Check( mw.Create( sc ), P( sc, "main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_PumpFor( h, 200 )

    ' ---- the window
    t.Check( h->fScale = sc, P( sc, "scale pinned" ) )
    dim as long cx = tkForm_Scale( mw.form, mainwin.DEFAULT_CX ), cy = tkForm_Scale( mw.form, mainwin.DEFAULT_CY )
    t.Check( (h->root->cw = cx) andalso (h->root->ch = cy), _
             P( sc, strings.Format( "client {}x{}, want {}x{}", h->root->cw, h->root->ch, cx, cy ) ) )
    ' Wayland sets no window icon without the compositor's xdg-toplevel-icon (WSLg has none): there
    ' the .desktop file names it
    dim as const zstring ptr vd = SDL_GetCurrentVideoDriver( )
    if (vd = 0) orelse (*vd <> "wayland") then t.Check( mw.HasIcon, P( sc, "the window icon is icons/tkedit.png" ) )
    ' vendor/tkControls' tkHost_Create turns SDL's QUIT-on-last-close off (tiko-lang 2b326d97f); before it,
    ' a dirty buffer's save question lost to that QUIT at the close button
    t.Check( SDL_GetHintBoolean( SDL_HINT_QUIT_ON_LAST_WINDOW_CLOSE, true ) = false, _
             P( sc, "the close button queues no QUIT behind OnClose (a dirty buffer's question would lose to it)" ) )
    t.Check( strings.EndsWith( tkForm_RoleFile( mw.form, TKFONT_UI ), mainwin.FONT_UI ), P( sc, "UI font is Inter" ) )
    t.Check( strings.EndsWith( tkForm_RoleFile( mw.form, TKFONT_MONO ), mainwin.FONT_MONO ), P( sc, "mono font is JetBrains Mono" ) )
    ' the code view's own font (Scintilla's): tkEdit's JetBrains Mono, never vendor/tkControls' bundled mono --
    ' carried inside the program (tka/assets), so a registered name, not a file
    t.Check( strings.EndsWith( mw.Look.FontFile, mainwin.FONT_MONO ) andalso tkHost_HasFontData( mw.Look.FontFile ), _
             P( sc, "the code view's font is JetBrains Mono: " & mw.Look.FontFile ) )
    t.Check( strings.EndsWith( tkApp_GlyphFace( ), mainwin.FONT_GLYPH ), P( sc, "glyph font is '" & tkApp_GlyphFace( ) & "'" ) )
    dim as ustring title = *SDL_GetWindowTitle( h->win )
    t.Check( title = appinfo.WindowTitle( ), P( sc, "no buffer: the title is '" & title & "'" ) )
    t.Check( tkApp_Theme( ).IsDark, P( sc, "the dark theme reached the controls" ) )

    ' ---- no buffer yet: the start panel (StartPass has the rest); a click on its New File makes one
    t.Check( mw.ShowsStart( ) andalso tkWidget_IsVisible( mw.Start.frame ), P( sc, "the start panel shows" ) )
    dim as TKRECT nr
    if mw.Start.RowRect( 0, nr ) then
        tkTest_Click( h, mw.Start.frame->x + (nr.left + nr.right) \ 2, mw.Start.frame->y + (nr.top + nr.bottom) \ 2 )
        tkTest_PumpFor( h, 60 )
    end if
    t.Check( mw.ShowsStart( ) andalso mw.Chooser.IsOpen( ) andalso (mw.Choosing = mainwin.PickKind.NewItem), P( sc, "a click on New File opened the New picker" ) )
    Chord( h, SDLK_RETURN, SDL_SCANCODE_RETURN, 0 )     ' its first row: Blank File
    t.Check( (mw.ShowsStart( ) = false) andalso (tkWidget_IsVisible( mw.Start.frame ) = false) andalso (mw.Docs.Count( ) = 1), _
             P( sc, "Blank File put the start panel away, one buffer" ) )
    title = *SDL_GetWindowTitle( h->win )
    t.Check( title = appinfo.WindowTitle( "untitled1" ), P( sc, "title is '" & title & "'" ) )

    ' ---- the layout: the view fills all but one status row (no menu, no panel; the tab strip, on by default, across the top)
    dim as TK_WIDGET ptr v = mw.View( ).Widget( )
    dim as long sh = tkForm_Scale( mw.form, mainwin.STATUS_CY ), top = mw.MenuHeight( ) + mw.TabsHeight( )
    t.Check( mw.StatusHeight( ) = sh, P( sc, strings.Format( "status row {} px", mw.StatusHeight( ) ) ) )
    t.Check( (v->x = 0) andalso (v->y = top) andalso (PaneCW( mw, v ) = cx) andalso (PaneCH( mw, v ) = cy - sh - top), _
             P( sc, strings.Format( "pane at {},{} {}x{}, want 0,{} {}x{}", v->x, v->y, PaneCW( mw, v ), PaneCH( mw, v ), top, cx, cy - sh - top ) ) )
    t.Check( (mw.status->x = 0) andalso (mw.status->y = cy - sh) andalso (mw.status->cw = cx) andalso (mw.status->ch = sh), _
             P( sc, strings.Format( "status at {},{} {}x{}", mw.status->x, mw.status->y, mw.status->cw, mw.status->ch ) ) )
    t.Check( tkHost_GetFocus( h ) = v, P( sc, "the view has the focus" ) )

    ' ---- the status panels
    t.Check( mw.StatusText( mainwin.StatusPanel.Buffer ) = "untitled1", P( sc, "buffer panel: " & mw.StatusText( mainwin.StatusPanel.Buffer ) ) )
    t.Check( mw.StatusText( mainwin.StatusPanel.Position ) = "Ln 1, Col 1", P( sc, "position panel: " & mw.StatusText( mainwin.StatusPanel.Position ) ) )
    t.Check( mw.StatusText( mainwin.StatusPanel.Encoding ) = "UTF-8", P( sc, "encoding panel: " & mw.StatusText( mainwin.StatusPanel.Encoding ) ) )
    t.Check( mw.StatusText( mainwin.StatusPanel.Build ) = "Debug", P( sc, "build panel: " & mw.StatusText( mainwin.StatusPanel.Build ) ) )
    t.Check( mw.StatusText( mainwin.StatusPanel.Message ) = "", P( sc, "no message: '" & mw.StatusText( mainwin.StatusPanel.Message ) & "'" ) )
    t.Check( (mw.StatusText( mainwin.StatusPanel.Settings ) = "Settings") andalso (mw.StatusText( mainwin.StatusPanel.Keys ) = "Keys"), _
             P( sc, "Settings and Keys panels" ) )
    dim as TKRECT rp, rs
    tkStatusBar_GetPanelRect( mw.status, mainwin.StatusPanel.Position, rp )
    tkStatusBar_GetPanelRect( mw.status, mainwin.StatusPanel.Settings, rs )
    t.Check( rs.left >= rp.right, P( sc, "after Ln/Col" ) )
    ' the status line's background is the right-click menu's
    tkHost_RenderTo( h, false )
    dim as ulong sbC = tkTest_PixelAt( h, rs.left + 2, mw.status->y + 2 ) and &hFFFFFFul
    t.Check( sbC = (tkPopupMenu_ThemeColors( tkApp_Theme( ) ).BackColor and &hFFFFFFul), _
             P( sc, strings.Format( "the status line in the menu's colour (&h{} vs &h{})", hex( sbC ), _
             hex( tkPopupMenu_ThemeColors( tkApp_Theme( ) ).BackColor and &hFFFFFFul ) ) ) )
    dim as ustring eol = mw.StatusText( mainwin.StatusPanel.LineEnding )
    t.Check( (eol = "CRLF") orelse (eol = "LF"), P( sc, "line-ending panel: " & eol ) )

    ' ---- typing reaches the view and moves the caret panel (no completion list: P5's own pass)
    mw.Prefs.CodeTips = false
    tkTest_PushText( h, "dim x as long" )
    tkTest_PumpFor( h, 50 )
    t.Check( mw.View( ).Text( ) = "dim x as long", P( sc, "typed text: '" & mw.View( ).Text( ) & "'" ) )
    t.Check( mw.StatusText( mainwin.StatusPanel.Position ) = "Ln 1, Col 14", P( sc, "position after typing: " & mw.StatusText( mainwin.StatusPanel.Position ) ) )
    Chord( h, SDLK_RETURN, SDL_SCANCODE_RETURN, 0 )
    t.Check( mw.View( ).LineCount( ) = 2, P( sc, strings.Format( "Enter made line 2 ({} lines)", mw.View( ).LineCount( ) ) ) )
    t.Check( mw.StatusText( mainwin.StatusPanel.Position ) = "Ln 2, Col 1", P( sc, "position after Enter: " & mw.StatusText( mainwin.StatusPanel.Position ) ) )
    t.Check( mw.View( ).IsModified( ), P( sc, "the buffer is modified" ) )
    t.Check( mw.StatusText( mainwin.StatusPanel.Buffer ) = "untitled1 *", P( sc, "the buffer panel marks it: " & mw.StatusText( mainwin.StatusPanel.Buffer ) ) )

    ' ---- a click on the position panel is Go to Line; Esc closes the strip wherever the focus is
    ClickPanel( mw, mainwin.StatusPanel.Position )
    t.Check( mw.Finder.isOpen andalso (mw.Finder.Mode = findstrip.StripMode.GoTo), P( sc, "the position panel opened Go to Line" ) )
    t.Check( mw.Finder.HasFocus( ), P( sc, "with the focus in its box" ) )
    ClickPanel( mw, mainwin.StatusPanel.Position )
    t.Check( mw.Finder.isOpen = false, P( sc, "a second click closed it" ) )
    t.Check( tkHost_GetFocus( h ) = v, P( sc, "and the view has the focus" ) )
    ClickPanel( mw, mainwin.StatusPanel.Position )
    t.Check( mw.Finder.isOpen andalso (mw.Finder.Mode = findstrip.StripMode.GoTo), P( sc, "a third opened it again" ) )
    Chord( h, SDLK_ESCAPE, SDL_SCANCODE_ESCAPE, 0 )
    t.Check( mw.Finder.isOpen = false, P( sc, "Esc in the box closed it" ) )
    Chord( h, SDLK_F, SDL_SCANCODE_F, KMOD_PRIMARY )
    t.Check( mw.Finder.isOpen andalso (mw.Finder.Mode = findstrip.StripMode.Find), P( sc, "Ctrl+F opened Find" ) )
    mw.View( ).Focus( )
    tkTest_PumpFor( h, 30 )
    t.Check( (tkHost_GetFocus( h ) = v) andalso mw.Finder.isOpen, P( sc, "the view has the focus, the strip still open" ) )
    Chord( h, SDLK_ESCAPE, SDL_SCANCODE_ESCAPE, 0 )
    t.Check( mw.Finder.isOpen = false, P( sc, "Esc in the view closed it" ) )
    t.Check( (v->y = top) andalso (PaneCH( mw, v ) = cy - sh - top), P( sc, strings.Format( "the view is back: y {} h {}", v->y, PaneCH( mw, v ) ) ) )
    t.Check( mw.View( ).Text( ) = "dim x as long" & mw.View( ).EolText( ), P( sc, "Esc typed nothing" ) )

    ' ---- a message goes at the next key; a build's stays
    mw.SetMessage( "a note" )
    Chord( h, SDLK_RIGHT, SDL_SCANCODE_RIGHT, 0 )
    t.Check( (mw.Message = "") andalso (mw.StatusText( mainwin.StatusPanel.Message ) = ""), P( sc, "the next key cleared a message: " & mw.Message ) )
    mw.SetBuildMessage( "Build OK" )
    Chord( h, SDLK_RIGHT, SDL_SCANCODE_RIGHT, 0 )
    t.Check( mw.Message = "Build OK", P( sc, "and kept a build's: " & mw.Message ) )
    mw.SetMessage( "" )

    ' ---- live resize: a live-resize expose (what Windows' sizing loop sends, data1 = 1) lays the
    ' window out at once, before the event loop runs again
    if platform.CurrentOs( ) = platform.Os.Windows then
        dim as SDL_Window ptr win = h->win
        dim as long w0, h0
        SDL_GetWindowSize( win, @w0, @h0 )
        SDL_SetWindowSize( win, w0 - 100, h0 - 60 )
        SDL_SyncWindow( win )
        dim as SDL_Event ev
        ev.type = SDL_EVENT_WINDOW_EXPOSED
        ev.window.windowID = SDL_GetWindowID( win )
        ev.window.data1 = 1
        SDL_PushEvent( @ev )                     ' the watcher runs inside the push
        dim as long pw, ph
        SDL_GetWindowSizeInPixels( win, @pw, @ph )
        t.Check( (h->root->cw = pw) andalso (h->root->ch = ph) andalso (mw.status->cw = pw) andalso (mw.status->y = ph - sh), _
                 P( sc, strings.Format( "the layout followed the live resize: root {}x{}, status at {} {}w (window {}x{})", _
                 h->root->cw, h->root->ch, mw.status->y, mw.status->cw, pw, ph ) ) )
        SDL_SetWindowSize( win, w0, h0 )
        SDL_SyncWindow( win )
        tkTest_PumpFor( h, 100 )
    end if

    ' ---- a click on the message panel shows the output pane, another hides it
    ClickPanel( mw, mainwin.StatusPanel.Message )
    t.Check( mw.OutputShown andalso tkWidget_IsVisible( mw.Out.frame ), P( sc, "the message panel showed the output pane" ) )
    ClickPanel( mw, mainwin.StatusPanel.Message )
    t.Check( (mw.OutputShown = false) andalso (PaneCH( mw, v ) = cy - sh - top), P( sc, "and hid it" ) )
    ClickPanel( mw, mainwin.StatusPanel.Message )
    mw.View( ).Focus( )
    Chord( h, SDLK_ESCAPE, SDL_SCANCODE_ESCAPE, 0 )
    t.Check( (mw.OutputShown = false) andalso (PaneCH( mw, v ) = cy - sh - top), P( sc, "Esc, the focus in the view, hid it too" ) )

    ' ---- the view's right-click menu: ten commands, what cannot be done greyed; Select All runs
    tkTest_Click( h, v->x + v->cw \ 2, v->y + v->ch \ 2, SDL_BUTTON_RIGHT )
    tkTest_PumpFor( h, 60 )
    t.Check( tkPopupMenu_IsOpen( mw.editMenu ), P( sc, "a right click opened the menu" ) )
    t.Check( tkPopupMenu_GetItemCount( mw.editMenu ) = 14, P( sc, strings.Format( "ten commands, four separators ({})", tkPopupMenu_GetItemCount( mw.editMenu ) ) ) )
    t.Check( tkPopupMenu_GetItemEnabled( mw.editMenu, Cmd.Undo ) andalso (tkPopupMenu_GetItemEnabled( mw.editMenu, Cmd.Cut ) = false) andalso _
             (tkPopupMenu_GetItemEnabled( mw.editMenu, Cmd.Redo ) = false), P( sc, "Undo on; Redo, and Cut with no selection, greyed" ) )
    dim as TKRECT ir
    dim as TK_HOST ptr ms = tkPopupMenu_Surface( mw.editMenu )
    if (ms <> 0) andalso tkPopupMenu_GetItemRect( mw.editMenu, 13, ir ) then
        tkTest_Click( ms, (ir.left + ir.right) \ 2, (ir.top + ir.bottom) \ 2 )
        tkTest_PumpFor( h, 60 )
    end if
    t.Check( tkPopupMenu_IsOpen( mw.editMenu ) = false, P( sc, "a pick closed it" ) )
    t.Check( mw.View( ).SelectionLength( ) = mw.View( ).Length( ), P( sc, strings.Format( "Select All selected {} of {}", mw.View( ).SelectionLength( ), mw.View( ).Length( ) ) ) )
    t.Check( mw.View( ).IsHighlighted( ), P( sc, "an untitled buffer is coloured" ) )

    mw.Destroy( )
end sub

' P1: the command table, key dispatch, first-run files, live reload of settings.toml,
' keybindings.toml and the theme file, a broken file changing nothing, settings.toml rewritten.
public sub ConfigPass( byref t as Tally, byval sc as single )
    dim as mainwin.Window mw
    dim as ustring cfg = FreshConfig( )
    mw.ConfigDir = cfg
    t.Check( mw.Create( sc ), P( sc, "config: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_PumpFor( h, 150 )
    mw.NewBlank( )                   ' out of the start panel: a buffer to type in
    dim as ustring nl = wchr( 10 )

    ' ---- first run: both files written, every key set
    dim as ustring sf = fs.PathJoin( cfg, settings.SETTINGS_FILE ), kf = fs.PathJoin( cfg, keybind.KEYBINDINGS_FILE )
    dim as ustring st = fs.ReadAllText( sf ).ValueOr( "" ), kt = fs.ReadAllText( kf ).ValueOr( "" )
    t.Check( (instr( st, nl & "tab_size = 4" & nl ) > 0) andalso (instr( st, "# tab_size" ) = 0), _
             P( sc, "first run wrote settings.toml, every key set" ) )
    t.Check( (instr( kt, nl & "FileSave = 'Primary+S'" & nl ) > 0) andalso (instr( kt, "# FileSave" ) = 0), _
             P( sc, "first run wrote keybindings.toml, every command at its chord" ) )

    ' ---- every command implemented, its shortcut text from the key map
    dim as long greyed = 0
    for i as long = 1 to clng( Cmd.Last_ ) - 1
        if mw.IsImplemented( cast( Cmd, i ) ) = false then greyed += 1
    next
    t.Check( greyed = 0, P( sc, strings.Format( "every command is implemented ({} not)", greyed ) ) )
    ' the Primary modifier by this platform's name: Ctrl, Cmd on macOS
    dim as ustring prim = platform.PrimaryModifierName( )
    t.Check( mw.ShortcutText( Cmd.FileSave ) = prim & "+S", P( sc, "Save shows " & mw.ShortcutText( Cmd.FileSave ) ) )
    t.Check( mw.ShortcutText( Cmd.SplitLeftRight ) = prim & "+\", P( sc, "Split shows " & mw.ShortcutText( Cmd.SplitLeftRight ) ) )

    ' ---- keys: an edit command, and one P1 cannot do yet
    tkTest_PushText( h, "abc" )
    tkTest_PumpFor( h, 30 )
    Chord( h, SDLK_D, SDL_SCANCODE_D, KMOD_PRIMARY )
    t.Check( mw.View( ).LineCount( ) = 2, P( sc, strings.Format( "Ctrl+D duplicated the line ({} lines)", mw.View( ).LineCount( ) ) ) )
    ' a selection: every line it touches, below the last, the selection kept; one undo step
    mw.View( ).SetLineEnding( docencoding.LineEnd.Lf, false )
    mw.View( ).SetText( "one" & nl & "two" & nl & "three" & nl & "four" )
    mw.View( ).SetSelection( 1, 5 )                              ' "ne" + nl + "t"
    Chord( h, SDLK_D, SDL_SCANCODE_D, KMOD_PRIMARY )
    t.Check( mw.View( ).Text( ) = "one" & nl & "two" & nl & "one" & nl & "two" & nl & "three" & nl & "four", _
             P( sc, "Ctrl+D duplicated both selected lines: " & mw.View( ).Text( ) ) )
    t.Check( (mw.View( ).SelectionStart( ) = 1) andalso (mw.View( ).SelectionEnd( ) = 5), _
             P( sc, strings.Format( "the selection stayed put ({}-{})", mw.View( ).SelectionStart( ), mw.View( ).SelectionEnd( ) ) ) )
    mw.View( ).Undo( )
    t.Check( mw.View( ).Text( ) = "one" & nl & "two" & nl & "three" & nl & "four", P( sc, "one Undo took it back" ) )
    ' ending at a line's start does not take that line; the last line has no break of its own
    mw.View( ).SetSelection( 8, 18 )                             ' "three" + nl + "four", to the end
    Chord( h, SDLK_D, SDL_SCANCODE_D, KMOD_PRIMARY )
    t.Check( mw.View( ).Text( ) = "one" & nl & "two" & nl & "three" & nl & "four" & nl & "three" & nl & "four", _
             P( sc, "Ctrl+D duplicated the last lines: " & mw.View( ).Text( ) ) )
    mw.View( ).SetSelection( 0, 4 )                              ' "one" + nl: line 2 not taken
    Chord( h, SDLK_D, SDL_SCANCODE_D, KMOD_PRIMARY )
    t.Check( left( mw.View( ).Text( ), 12 ) = "one" & nl & "one" & nl & "two" & nl, _
             P( sc, "a selection ending at a line start left that line out" ) )

    ' ---- Comment / Uncomment: '' by default (tiko style), ' when double_comment is off; Uncomment
    ' takes either away, with the space after it
    dim as ustring plain = "a" & nl & "    b" & nl & "c"
    t.Check( mw.Prefs.DoubleComment, P( sc, "double_comment is on by default" ) )
    mw.View( ).SetText( plain )
    mw.View( ).SelectAll( )
    mw.Execute( Cmd.CommentBlock )
    t.Check( mw.View( ).Text( ) = "'' a" & nl & "    '' b" & nl & "'' c", P( sc, "Comment inserted '' on each line: " & mw.View( ).Text( ) ) )
    mw.View( ).SelectAll( )
    mw.Execute( Cmd.UncommentBlock )
    t.Check( mw.View( ).Text( ) = plain, P( sc, "Uncomment took the '' away: " & mw.View( ).Text( ) ) )
    mw.Prefs.DoubleComment = false
    mw.View( ).SelectAll( )
    mw.Execute( Cmd.CommentBlock )
    t.Check( mw.View( ).Text( ) = "' a" & nl & "    ' b" & nl & "' c", P( sc, "double_comment off: Comment inserted ': " & mw.View( ).Text( ) ) )
    mw.View( ).SetText( "'' a" & nl & "' b" & nl & "'c" & nl & "''d" & nl & "e" )
    mw.View( ).SelectAll( )
    mw.Execute( Cmd.UncommentBlock )
    t.Check( mw.View( ).Text( ) = "a" & nl & "b" & nl & "c" & nl & "d" & nl & "e", _
             P( sc, "Uncomment took one or two marks away, either setting: " & mw.View( ).Text( ) ) )
    mw.Prefs.DoubleComment = true
    mw.View( ).SetText( "" )                                     ' unmodified: closing it asks nothing

    ' ---- settings.toml: Ctrl+Comma opens it; saving applies it
    Chord( h, SDLK_COMMA, SDL_SCANCODE_COMMA, KMOD_PRIMARY )
    t.Check( lcase( mw.ActivePath( ) ) = lcase( sf ), P( sc, "Ctrl+Comma opened settings.toml: " & mw.ActivePath( ) ) )
    t.Check( mw.View( ).IsHighlighted( ) = false, P( sc, "not coloured: not a source file" ) )
    t.Check( left( mw.View( ).Text( ), 17 ) = "# tkEdit settings", P( sc, "its text is in the view" ) )
    t.Check( mw.StatusText( mainwin.StatusPanel.Buffer ) = settings.SETTINGS_FILE, P( sc, "the buffer panel names it" ) )
    dim as long pts0 = mw.View( ).FontSize( ), lineH0 = mw.View( ).LineHeight( )
    mw.View( ).SetText( "version = 1" & nl & "[editor]" & nl & "tab_size = 2" & nl & "line_numbers = false" & nl & _
                     "font_size = 20" & nl & "[ui]" & nl & "theme = 'light'" & nl )
    Chord( h, SDLK_S, SDL_SCANCODE_S, KMOD_PRIMARY )
    t.Check( mw.View( ).FontSize( ) = 20, P( sc, strings.Format( "font_size applied to the view: {} pt (was {})", mw.View( ).FontSize( ), pts0 ) ) )
    t.Check( mw.View( ).LineHeight( ) > lineH0, P( sc, strings.Format( "and drawn bigger: lines {} px (were {})", mw.View( ).LineHeight( ), lineH0 ) ) )
    t.Check( instr( fs.ReadAllText( sf ).ValueOr( "" ), "tab_size = 2" ) > 0, P( sc, "Ctrl+S wrote settings.toml" ) )
    t.Check( mw.Prefs.TabSize = 2, P( sc, strings.Format( "tab_size applied ({})", mw.Prefs.TabSize ) ) )
    t.Check( (mw.Look.LineNumbers = false) andalso (mw.View( ).MarginWidth( 0 ) = 0), P( sc, "line numbers off in the view" ) )
    t.Check( (mw.Theme.Name = "light") andalso (tkApp_Theme( ).IsDark = false), P( sc, "theme 'light' applied to the controls" ) )
    t.Check( StripToolsMatch( mw ), P( sc, "and the find strip's buttons follow its new back colour" ) )
    t.Check( mw.Look.Text.Back = &hFFFFFF, P( sc, "and to the view's background" ) )
    t.Check( mw.Message = "", P( sc, "no message: " & mw.Message ) )
    ' extra_line_spacing (default 2): pixels above and below each line, at the window's DPI
    scope
        dim as long lineH2 = mw.View( ).LineHeight( )
        mw.View( ).SetText( "version = 1" & nl & "[editor]" & nl & "tab_size = 2" & nl & "line_numbers = false" & nl & _
                         "font_size = 20" & nl & "extra_line_spacing = 0" & nl & "[ui]" & nl & "theme = 'light'" & nl )
        Chord( h, SDLK_S, SDL_SCANCODE_S, KMOD_PRIMARY )
        dim as long want = 2 * cint( 2 * tkHost_Scale( h, 1000 ) / 1000 )
        t.Check( (mw.Look.ExtraLineSpacing = 0) andalso (lineH2 - mw.View( ).LineHeight( ) = want), _
                 P( sc, strings.Format( "extra_line_spacing 0: lines {} px, were {} at the default 2 (2 x {} px less)", _
                                        mw.View( ).LineHeight( ), lineH2, want \ 2 ) ) )
    end scope
    ' a broken file changes nothing and says where
    mw.View( ).SetText( "[editor" & nl & "tab_size = 8" & nl )
    Chord( h, SDLK_S, SDL_SCANCODE_S, KMOD_PRIMARY )
    t.Check( instr( mw.Message, settings.SETTINGS_FILE & ":1:" ) = 1, P( sc, "a parse error names file and line: " & mw.Message ) )
    t.Check( mw.StatusText( mainwin.StatusPanel.Message ) = mw.Message, P( sc, "in the message panel" ) )
    t.Check( (mw.Prefs.TabSize = 2) andalso (mw.Theme.Name = "light"), P( sc, "and the previous settings stay" ) )

    ' ---- keybindings.toml: Ctrl+K; a rebinding is live at once, its shortcut text follows
    mw.View( ).SetText( "version = 1" & nl & "[ui]" & nl & "theme = 'light'" & nl )
    Chord( h, SDLK_S, SDL_SCANCODE_S, KMOD_PRIMARY )
    ' closed and opened again, it lists every key at the value in force
    mw.Execute( Cmd.FileClose )
    Chord( h, SDLK_COMMA, SDL_SCANCODE_COMMA, KMOD_PRIMARY )
    dim as ustring st2 = mw.View( ).Text( )
    t.Check( (lcase( mw.ActivePath( ) ) = lcase( sf )) andalso (instr( st2, "theme = 'light'" ) > 0) andalso _
             (instr( st2, nl & "tab_size = 4" & nl ) > 0) andalso (instr( st2, nl & "[[builds]]" & nl ) > 0) andalso _
             (instr( st2, "# tab_size" ) = 0), P( sc, "reopened, settings.toml sets every key at its value" ) )
    t.Check( mw.View( ).IsModified( ) = false, P( sc, "and is unmodified" ) )
    Chord( h, SDLK_K, SDL_SCANCODE_K, KMOD_PRIMARY )
    t.Check( lcase( mw.ActivePath( ) ) = lcase( kf ), P( sc, "Ctrl+K opened keybindings.toml" ) )
    mw.View( ).SetText( "format = 1" & nl & "[bindings]" & nl & "DuplicateLine = 'Primary+Shift+D'" & nl & _
                     "DeleteLine = 'Primary+S'" & nl )
    Chord( h, SDLK_S, SDL_SCANCODE_S, KMOD_PRIMARY )
    t.Check( mw.Keys.Effective( Cmd.DuplicateLine ) = "Primary+Shift+D", P( sc, "the rebinding applied" ) )
    t.Check( instr( mw.Message, "FileSave and DeleteLine share Primary+S" ) > 0, P( sc, "a shared chord is reported: " & mw.Message ) )
    t.Check( mw.ShortcutText( Cmd.DuplicateLine ) = platform.PrimaryModifierName( ) & "+Shift+D", P( sc, "the shortcut text shows the new chord" ) )
    dim as long before = mw.View( ).LineCount( )
    Chord( h, SDLK_D, SDL_SCANCODE_D, KMOD_PRIMARY or SDL_KMOD_SHIFT )
    t.Check( mw.View( ).LineCount( ) = before + 1, P( sc, strings.Format( "Ctrl+Shift+D duplicates now ({} -> {})", before, mw.View( ).LineCount( ) ) ) )
    Chord( h, SDLK_D, SDL_SCANCODE_D, KMOD_PRIMARY )
    t.Check( mw.View( ).LineCount( ) = before + 1, P( sc, "and Ctrl+D does not" ) )
    ' FileSave and DeleteLine share Ctrl+S: the first in the table wins, so Save still saves
    mw.View( ).SetText( "format = 1" & nl & "[bindings]" & nl )
    Chord( h, SDLK_S, SDL_SCANCODE_S, KMOD_PRIMARY )
    t.Check( mw.Keys.Effective( Cmd.DuplicateLine ) = "Primary+D", P( sc, "an emptied file restores the defaults" ) )
    mw.Execute( Cmd.FileClose )
    Chord( h, SDLK_K, SDL_SCANCODE_K, KMOD_PRIMARY )
    dim as ustring kt2 = mw.View( ).Text( )
    t.Check( (lcase( mw.ActivePath( ) ) = lcase( kf )) andalso (instr( kt2, nl & "DuplicateLine = 'Primary+D'" & nl ) > 0) andalso _
             (instr( kt2, nl & "FileSave = 'Primary+S'" & nl ) > 0) andalso (instr( kt2, "# FileSave" ) = 0), _
             P( sc, "reopened, keybindings.toml lists every command at its chord" ) )

    ' ---- [statusbar] switches hide the Project, Settings and Keys panels
    Chord( h, SDLK_COMMA, SDL_SCANCODE_COMMA, KMOD_PRIMARY )
    mw.View( ).SetText( "version = 1" & nl & "[ui]" & nl & "theme = 'light'" & nl & "[statusbar]" & nl & "show_project = false" & nl & "show_keys = false" & nl )
    Chord( h, SDLK_S, SDL_SCANCODE_S, KMOD_PRIMARY )
    scope
        dim as TKRECT rpj, rst, rky
        tkStatusBar_GetPanelRect( mw.status, mainwin.StatusPanel.Project, rpj )
        tkStatusBar_GetPanelRect( mw.status, mainwin.StatusPanel.Settings, rst )
        tkStatusBar_GetPanelRect( mw.status, mainwin.StatusPanel.Keys, rky )
        t.Check( (rpj.right = rpj.left) andalso (rky.right = rky.left) andalso (rst.right > rst.left), _
                 P( sc, strings.Format( "Project and Keys hidden, Settings shown: {} {} {}", rpj.right - rpj.left, rst.right - rst.left, rky.right - rky.left ) ) )
    end scope

    ' ---- [ui] language (I18N.md): a catalog in the config folder, applied on save; a key it lacks
    ' is English; a code with no catalog is English and says so; saving the catalog applies it
    dim as ustring ld = fs.PathJoin( cfg, "lang" )
    fs.CreateDirAll( ld )
    dim as ustring lf = fs.PathJoin( ld, "de.toml" )
    fs.WriteAtomic( lf, "format = 1" & nl & "name = 'Deutsch'" & nl & "[status]" & nl & "project = 'Projekt'" & nl & _
                        "position = 'Z {0}, Sp {1}'" & nl & "[menu]" & nl & "Cut = 'Ausschneiden'" & nl & _
                        "[output]" & nl & "tab_results = 'Ergebnisse'" & nl & "[find]" & nl & "tool_replace = 'Ersetzen'" & nl & _
                        "[cue]" & nl & "buffer = 'Puffer w" & wchr( &hE4 ) & "hlen'" & nl )
    mw.View( ).SetText( "version = 1" & nl & "[ui]" & nl & "theme = 'light'" & nl & "language = 'de'" & nl )
    Chord( h, SDLK_S, SDL_SCANCODE_S, KMOD_PRIMARY )
    t.Check( lcase( mw.LangPath ) = lcase( lf ), P( sc, "language = 'de' found the config folder's de.toml: " & mw.LangPath ) )
    t.Check( mw.StatusText( mainwin.StatusPanel.Project ) = "Projekt", P( sc, "the Project panel in German: " & mw.StatusText( mainwin.StatusPanel.Project ) ) )
    t.Check( left( mw.StatusText( mainwin.StatusPanel.Position ), 2 ) = "Z ", P( sc, "the position in German: " & mw.StatusText( mainwin.StatusPanel.Position ) ) )
    t.Check( mw.StatusText( mainwin.StatusPanel.Keys ) = "Keys", P( sc, "a text the catalog lacks is English" ) )
    t.Check( i18n.Tr( "menu.Cut", "Cut" ) = "Ausschneiden", P( sc, "the right-click menu's catalog is German" ) )
    t.Check( len( mw.Message ) = 0, P( sc, "no message for a good catalog: " & mw.Message ) )
    t.Check( tkTabBar_GetText( mw.Out.tabs, 0 ) = "Ergebnisse", P( sc, "the output pane's tab relabelled: " & tkTabBar_GetText( mw.Out.tabs, 0 ) ) )
    t.Check( tkTabBar_GetText( mw.Out.tabs, 1 ) = "Log", P( sc, "a tab the catalog lacks is English" ) )
    t.Check( tkToolbar_GetText( mw.Finder.rtools, 0 ) = "Ersetzen", P( sc, "the find strip's Replace relabelled: " & tkToolbar_GetText( mw.Finder.rtools, 0 ) ) )
    mw.OpenChooser( mainwin.PickKind.Buffers )
    t.Check( mw.Chooser.IsOpen( ) andalso (mw.Chooser.Cue = "Puffer w" & wchr( &hE4 ) & "hlen"), P( sc, "a picker's cue in German, read as UTF-8: " & mw.Chooser.Cue ) )
    mw.Chooser.Close( )
    t.Check( mw.OpenFile( lf ), P( sc, "open de.toml" ) )
    mw.View( ).SetText( "[status]" & nl & "project = 'Vorhaben'" & nl )
    Chord( h, SDLK_S, SDL_SCANCODE_S, KMOD_PRIMARY )
    t.Check( mw.StatusText( mainwin.StatusPanel.Project ) = "Vorhaben", P( sc, "saving the catalog applies it: " & mw.StatusText( mainwin.StatusPanel.Project ) ) )
    t.Check( left( mw.StatusText( mainwin.StatusPanel.Position ), 3 ) = "Ln ", P( sc, "a key taken out of it is English again" ) )
    mw.Execute( Cmd.FileClose )
    Chord( h, SDLK_COMMA, SDL_SCANCODE_COMMA, KMOD_PRIMARY )
    t.Check( lcase( mw.ActivePath( ) ) = lcase( sf ), P( sc, "back on settings.toml" ) )
    ' a shipped catalog (no copy in the config folder): lang/fr.toml, carried inside the program
    mw.View( ).SetText( "version = 1" & nl & "[ui]" & nl & "theme = 'light'" & nl & "language = 'fr'" & nl )
    Chord( h, SDLK_S, SDL_SCANCODE_S, KMOD_PRIMARY )
    t.Check( mw.LangPath = bundled.PREFIX & "lang/fr.toml", P( sc, "language = 'fr': the shipped catalog: " & mw.LangPath ) )
    t.Check( (mw.StatusText( mainwin.StatusPanel.Project ) = "Projet") andalso (tkTabBar_GetText( mw.Out.tabs, 0 ) = "R" & wchr( &hE9 ) & "sultats"), _
             P( sc, "in French: " & mw.StatusText( mainwin.StatusPanel.Project ) & ", " & tkTabBar_GetText( mw.Out.tabs, 0 ) ) )
    t.Check( len( mw.Message ) = 0, P( sc, "the shipped catalog loads without a warning: " & mw.Message ) )
    ' French has the widest words: the find strip's label column and its tools grow to them
    mw.Execute( Cmd.Find )
    scope
        dim as TTF_Font ptr fnt = tkForm_Font( mw.form, TKFONT_UI )
        dim as findstrip.StripMode ms( 0 to 3 ) = { findstrip.StripMode.Find, findstrip.StripMode.GoTo, _
                                                    findstrip.StripMode.Project, findstrip.StripMode.Args }
        dim as long widest = tkText_Width( fnt, findstrip.LabelText( findstrip.StripMode.Replace, true ) )
        for i as long = 0 to 3
            dim as long tw = tkText_Width( fnt, findstrip.LabelText( ms( i ) ) )
            if tw > widest then widest = tw
        next
        dim as long fixedW = tkHost_Scale( tkForm_Host( mw.form ), 84 )
        t.Check( mw.Finder.isOpen andalso (widest > fixedW), P( sc, strings.Format( "a French label is wider than the old column ({} > {})", widest, fixedW ) ) )
        t.Check( (widest <= mw.Finder.labelW) andalso (mw.Finder.findBox->x > mw.Finder.labelW), _
                 P( sc, strings.Format( "the labels fit: widest {} in a column of {}, the box at {}", widest, mw.Finder.labelW, mw.Finder.findBox->x ) ) )
        t.Check( (tkToolbar_GetIdealWidth( mw.Finder.tools ) <= mw.Finder.tools->cw) andalso _
                 (tkToolbar_GetIdealWidth( mw.Finder.rtools ) <= mw.Finder.rtools->cw), _
                 P( sc, strings.Format( "the tools hold their words: {}/{}, {}/{}", tkToolbar_GetIdealWidth( mw.Finder.tools ), mw.Finder.tools->cw, _
                                        tkToolbar_GetIdealWidth( mw.Finder.rtools ), mw.Finder.rtools->cw ) ) )
    end scope
    mw.OnFind( findstrip.FindAction.CloseStrip )
    ' the question box's buttons in French, each as wide as its words, none overlapping, inside the box
    scope
        dim as TK_WIDGET ptr box = mainwin.NewAskBox( tkForm_Widget( mw.form ), "x", MBX_BTN_SAVE_DONTSAVE_CANCEL, mw.AskIcon )
        t.Check( (tkMessageBox_GetButtonCount( box ) = 3) andalso _
                 (tkButton_GetText( tkMessageBox_GetButtonHandle( box, 0 ) ) = "Enregistrer") andalso _
                 (tkButton_GetText( tkMessageBox_GetButtonHandle( box, 1 ) ) = "Ne pas enregistrer") andalso _
                 (tkButton_GetText( tkMessageBox_GetButtonHandle( box, 2 ) ) = "Annuler"), _
                 P( sc, "Save / Don't Save / Cancel in French" ) )
        t.Check( (tkMessageBox_GetDefaultButton( box ) = 0) andalso (tkMessageBox_GetCancelID( box ) = MBX_IDCANCEL), _
                 P( sc, "the preset's default and cancel kept" ) )
        ' the icon and the close X are PsIcons codepoints: the fonts they are drawn in must hold them
        dim as TTF_Font ptr gIcon = tkMessageBox_GetGlyphFont( box ), gClose = tkMessageBox_GetCloseGlyphFont( box )
        t.Check( (gIcon <> 0) andalso TTF_FontHasGlyph( gIcon, TKMESSAGEBOX_GLYPH_QUESTION ), P( sc, "the question icon's font has its glyph" ) )
        t.Check( (gClose <> 0) andalso TTF_FontHasGlyph( gClose, TKMESSAGEBOX_GLYPH_CLOSE ), P( sc, "the close X's font has its glyph" ) )
        t.Check( tkMessageBox_GetFont( box ) = tkForm_Font( mw.form, TKFONT_UI ), P( sc, "the text in the form's UI font" ) )
        tkMessageBox_LayoutForTest( box )
        ' ASK_ICON_PT at the window's DPI: taller than the form's large glyphs, its cell as tall as the font
        dim as TKRECT ri
        tkMessageBox_GetIconRect( box, ri )
        t.Check( (gIcon = mw.AskIcon) andalso (TTF_GetFontSize( gIcon ) = mainwin.ASK_ICON_PT) andalso _
                 (TTF_GetFontHeight( gIcon ) > TTF_GetFontHeight( tkForm_Font( mw.form, TKFONT_GLYPH_LARGE ) )) andalso _
                 (ri.bottom - ri.top >= TTF_GetFontHeight( gIcon )), _
                 P( sc, strings.Format( "the icon at {} pt: {} px high against the large glyphs' {}, in a cell of {}", TTF_GetFontSize( gIcon ), _
                                        TTF_GetFontHeight( gIcon ), TTF_GetFontHeight( tkForm_Font( mw.form, TKFONT_GLYPH_LARGE ) ), ri.bottom - ri.top ) ) )
        dim as long bw, bh
        tkMessageBox_GetIdealSize( box, bw, bh )
        dim as TKRECT r( 0 to 2 )
        dim as boolean fits = true
        for i as long = 0 to 2
            tkMessageBox_GetButtonRect( box, i, r( i ) )
            dim as long iw, ih
            tkButton_GetIdealSize( tkMessageBox_GetButtonHandle( box, i ), iw, ih )
            if (r( i ).left < 0) orelse (r( i ).right > bw) orelse (r( i ).right - r( i ).left < iw) then fits = false
        next
        for i as long = 0 to 1
            for j as long = i + 1 to 2
                if (r( i ).right > r( j ).left) andalso (r( j ).right > r( i ).left) then fits = false
            next
        next
        t.Check( fits, P( sc, strings.Format( "the buttons fit the box ({} wide): {}-{} {}-{} {}-{}", bw, r( 0 ).left, r( 0 ).right, _
                                              r( 1 ).left, r( 1 ).right, r( 2 ).left, r( 2 ).right ) ) )
        tkMessageBox_Destroy( box )
    end scope
    ' Chinese (zh): the shipped catalog, and glyphs for it -- Inter has none, so the UI fonts fall back
    ' to the bundled subset of Noto Sans SC (fonts/NotoSansSC-tkEdit.otf), which must hold every
    ' character the catalog uses (tools/make-cjk-font.py cuts it from lang/zh.toml)
    mw.View( ).SetText( "version = 1" & nl & "[ui]" & nl & "theme = 'light'" & nl & "language = 'zh'" & nl )
    Chord( h, SDLK_S, SDL_SCANCODE_S, KMOD_PRIMARY )
    t.Check( (mw.LangPath = bundled.PREFIX & "lang/zh.toml") andalso (len( mw.Message ) = 0), _
             P( sc, "language = 'zh': the shipped catalog, no warning: " & mw.LangPath & " " & mw.Message ) )
    t.Check( mw.StatusText( mainwin.StatusPanel.Project ) = wchr( &h9879, &h76EE ), P( sc, "the Project panel in Chinese: " & mw.StatusText( mainwin.StatusPanel.Project ) ) )
    scope
        dim as ustring zt = bundled.ReadAllText( bundled.PREFIX & "lang/zh.toml" ).ValueOr( "" )
        dim as long nCjk = 0, nMissing = 0
        dim as ustring firstMissing = ""
        for i as long = 1 to len( zt )
            dim as ulong cp = asc( mid( zt, i, 1 ) )
            if cp < &h80 then continue for
            nCjk += 1
            if (mw.CjkFont = 0) orelse (TTF_FontHasGlyph( mw.CjkFont, cp ) = false) then
                nMissing += 1
                if len( firstMissing ) = 0 then firstMissing = "U+" & hex( cp )
            end if
        next
        t.Check( (mw.CjkFont <> 0) andalso (nCjk > 200) andalso (nMissing = 0), _
                 P( sc, strings.Format( "the bundled CJK font holds the catalog's {} characters ({} missing, first {})", nCjk, nMissing, firstMissing ) ) )
        t.Check( TTF_FontHasGlyph( tkForm_Font( mw.form, TKFONT_UI ), &h9879 ) andalso TTF_FontHasGlyph( tkForm_Font( mw.form, TKFONT_UI_BOLD ), &h9879 ), _
                 P( sc, "the UI fonts draw Chinese through their fallbacks" ) )
    end scope
    mw.View( ).SetText( "version = 1" & nl & "[ui]" & nl & "theme = 'light'" & nl & "language = 'xx'" & nl )
    Chord( h, SDLK_S, SDL_SCANCODE_S, KMOD_PRIMARY )
    t.Check( mw.StatusText( mainwin.StatusPanel.Project ) = "Project", P( sc, "a code with no catalog is English" ) )
    t.Check( instr( mw.Message, "no lang/xx.toml; English" ) > 0, P( sc, "and says so: " & mw.Message ) )
    mw.View( ).SetText( "version = 1" & nl & "[ui]" & nl & "theme = 'light'" & nl )
    Chord( h, SDLK_S, SDL_SCANCODE_S, KMOD_PRIMARY )
    t.Check( tkStatusBar_GetPanelVisible( mw.status, mainwin.StatusPanel.Project ) andalso tkStatusBar_GetPanelVisible( mw.status, mainwin.StatusPanel.Keys ), _
             P( sc, "the keys gone: shown again" ) )
    t.Check( (mw.StatusText( mainwin.StatusPanel.Project ) = "Project") andalso (i18n.CurrentCode( ) = "en"), P( sc, "the language gone: English" ) )
    t.Check( (tkTabBar_GetText( mw.Out.tabs, 0 ) = "Results") andalso (tkToolbar_GetText( mw.Finder.rtools, 0 ) = "Replace"), _
             P( sc, "and the tab and the tool back in English" ) )
    Chord( h, SDLK_K, SDL_SCANCODE_K, KMOD_PRIMARY )                    ' back to keybindings.toml, as before

    ' ---- the Settings and Keys panels open their files
    mw.View( ).SetText( "format = 1" & nl & "[bindings]" & nl )
    Chord( h, SDLK_S, SDL_SCANCODE_S, KMOD_PRIMARY )
    ClickPanel( mw, mainwin.StatusPanel.Settings )
    t.Check( lcase( mw.ActivePath( ) ) = lcase( sf ), P( sc, "the Settings panel opened settings.toml: " & mw.ActivePath( ) ) )
    ClickPanel( mw, mainwin.StatusPanel.Keys )
    t.Check( lcase( mw.ActivePath( ) ) = lcase( kf ), P( sc, "the Keys panel opened keybindings.toml: " & mw.ActivePath( ) ) )

    ' ---- the theme file: Ctrl+Shift+T copies the shipped one into the config folder; saving applies it
    Chord( h, SDLK_T, SDL_SCANCODE_T, KMOD_PRIMARY or SDL_KMOD_SHIFT )
    dim as ustring tf = fs.PathJoin( cfg, "themes", "light.toml" )
    t.Check( lcase( mw.ActivePath( ) ) = lcase( tf ), P( sc, "Ctrl+Shift+T opened the user's light.toml: " & mw.ActivePath( ) ) )
    t.Check( instr( mw.View( ).Text( ), "name = ""light""" ) > 0, P( sc, "a copy of the shipped theme" ) )
    mw.View( ).SetText( "[editor]" & nl & "bg = '#fafafa'" & nl & "[ui]" & nl & "bg = '#fdfdfd'" & nl )
    Chord( h, SDLK_S, SDL_SCANCODE_S, KMOD_PRIMARY )
    t.Check( mw.Look.Text.Back = &hFAFAFA, P( sc, "the saved theme applied (&h" & hex( mw.Look.Text.Back ) & ")" ) )
    t.Check( lcase( mw.Theme.Path ) = lcase( tf ), P( sc, "the user's copy wins" ) )

    mw.Destroy( )
end sub

' ================================================================ P2: buffers

' The person, scripted: Ask answers from this queue (MBX_IDOK when empty), Pick from its own.
dim shared as long gAnswers( 0 to 15 )
dim shared as long gAnswerCount, gAsked
dim shared as ustring gPickPath

private function ScriptedAsk( byval f as TK_FORM ptr, byref text as const ustring, byval buttons as long ) as long
    gAsked += 1
    if gAnswerCount = 0 then return MBX_IDOK
    dim as long a = gAnswers( 0 )
    for i as long = 1 to gAnswerCount - 1
        gAnswers( i - 1 ) = gAnswers( i )
    next
    gAnswerCount -= 1
    return a
end function

private sub Answer( byval a as long )
    gAnswers( gAnswerCount ) = a
    gAnswerCount += 1
end sub

private function ScriptedPick( byval f as TK_FORM ptr, byval kind as long, byref suggest as const ustring ) as ustring
    dim as ustring got = gPickPath
    gPickPath = ""
    return got
end function

private function Files( ) as ustring
    dim as ustring res = platform.ResourceDir( ).ValueOr( platform.InstallDir( ) )
    dim as ustring d = fs.PathJoin( res, "out", "selftest", "files" )
    fs.RemoveDirAll( d )
    fs.CreateDirAll( d )
    return d
end function

private sub WriteBytes( byref path as const ustring, byref s as const string )
    dim as Array( of ubyte ) b
    for i as long = 0 to len( s ) - 1
        b.Push( s[i] )
    next
    fs.WriteAllBytes( path, b )
end sub

private function ReadBytes( byref path as const ustring ) as string
    dim as Array( of ubyte ) b
    fs.ReadAllBytes( path, b )
    dim as string s
    for each c as ubyte in b
        s &= chr( c )
    next
    return s
end function

private sub PopKey( byref mw as mainwin.Window, byval key as long, byval sc as long, byval mods as long = 0 )
    if mw.Chooser.Pop = 0 then exit sub
    Chord( mw.Chooser.Pop, key, sc, mods )
    tkTest_PumpFor( tkForm_Host( mw.form ), 40 )
end sub


public sub BufferPass( byref t as Tally, byval sc as single )
    dim as mainwin.Window mw
    mw.ConfigDir = FreshConfig( )
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    gAnswerCount = 0
    t.Check( mw.Create( sc ), P( sc, "buffers: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_PumpFor( h, 150 )
    dim as ustring dir_ = Files( )
    dim as ustring pathA = fs.PathJoin( dir_, "a.tiko" ), pathB = fs.PathJoin( dir_, "b.tiko" ), pathC = fs.PathJoin( dir_, "c.txt" )
    WriteBytes( pathA, "dim a as long" & chr( 10 ) )
    WriteBytes( pathB, "dim b as long" & chr( 13, 10 ) )
    WriteBytes( pathC, "caf" & chr( &hE9 ) & chr( 10 ) )             ' not UTF-8: ANSI

    ' ---- opening: the untitled buffer gives way; encoding and line ending detected
    t.Check( mw.Docs.Count( ) = 1, P( sc, "one untitled buffer at the start" ) )
    t.Check( mw.OpenFile( pathA ), P( sc, "open a.tiko" ) )
    t.Check( mw.Docs.Count( ) = 1, P( sc, strings.Format( "the empty untitled buffer gave way ({} buffers)", mw.Docs.Count( ) ) ) )
    t.Check( mw.StatusText( mainwin.StatusPanel.Buffer ) = "a.tiko", P( sc, "buffer panel: " & mw.StatusText( mainwin.StatusPanel.Buffer ) ) )
    t.Check( mw.StatusText( mainwin.StatusPanel.LineEnding ) = "LF", P( sc, "a.tiko is LF" ) )
    dim as ustring title = *SDL_GetWindowTitle( h->win )
    t.Check( title = "tkEdit - " & pathA, P( sc, "title: " & title ) )
    mw.OpenFile( pathB )
    t.Check( mw.StatusText( mainwin.StatusPanel.LineEnding ) = "CRLF", P( sc, "b.tiko is CRLF" ) )
    mw.OpenFile( pathA )
    t.Check( (mw.Docs.Count( ) = 2) andalso (lcase( mw.ActivePath( ) ) = lcase( pathA )), P( sc, "opening a.tiko again shows its buffer" ) )
    mw.OpenFile( pathC )
    t.Check( mw.StatusText( mainwin.StatusPanel.Encoding ) = "ANSI", P( sc, "c.txt is ANSI: " & mw.StatusText( mainwin.StatusPanel.Encoding ) ) )
    t.Check( mw.View( ).Text( ) = "caf" & wchr( &hE9 ) & chr( 10 ), P( sc, "and decoded" ) )
    t.Check( (mw.View( ).IsHighlighted( ) = false) andalso mw.FindOpen( pathA )->Main.IsHighlighted( ), P( sc, "c.txt plain, a.tiko coloured" ) )
    t.Check( (mw.Mru.Count( ) = 3) andalso (mw.Mru[0] = mw.Active( )), P( sc, "the most recent first" ) )
    t.Check( mw.Recent.Count( ) = 3, P( sc, strings.Format( "three recent files ({})", mw.Recent.Count( ) ) ) )

    ' ---- Ctrl+O: several files at once; closed again
    dim as ustring pathE = fs.PathJoin( dir_, "e.tiko" ), pathF = fs.PathJoin( dir_, "f.tiko" )
    WriteBytes( pathE, "dim e as long" & chr( 10 ) )
    WriteBytes( pathF, "dim f as long" & chr( 10 ) )
    gPickPath = pathE & wchr( 10 ) & pathF
    Chord( h, SDLK_O, SDL_SCANCODE_O, KMOD_PRIMARY )
    t.Check( (mw.Docs.Count( ) = 5) andalso (mw.FindOpen( pathE ) <> 0) andalso (mw.FindOpen( pathF ) <> 0), _
             P( sc, strings.Format( "Ctrl+O opened both picked files ({} buffers)", mw.Docs.Count( ) ) ) )
    mw.CloseDoc( mw.FindOpen( pathF ) )
    mw.CloseDoc( mw.FindOpen( pathE ) )
    mw.ShowDoc( mw.FindOpen( pathC ) )

    ' ---- Ctrl+E: the buffer list, filtered by typing, Enter picks
    Chord( h, SDLK_E, SDL_SCANCODE_E, KMOD_PRIMARY )
    t.Check( mw.Chooser.IsOpen( ) andalso (mw.Choosing = mainwin.PickKind.Buffers), P( sc, "Ctrl+E opened the buffer list" ) )
    t.Check( (mw.Chooser.Query <> 0) andalso (tkTextBox_GetCueBannerText( mw.Chooser.Query ) = "Select edit buffer") andalso _
             tkTextBox_ShowsCue( mw.Chooser.Query ), P( sc, "its query box's cue: Select edit buffer" ) )
    scope   ' the cue is dimmer than the status line's text, which is dimmer than typed text
        dim as ulong cue = tkTextBox_GetCueBannerColor( mw.Chooser.Query ), st = chrome.StatusText( mw.Theme )
        t.Check( ((cue shr 8) and &hFF) < ((st shr 8) and &hFF), P( sc, strings.Format( "the cue (&h{}) is dimmer than the status text (&h{})", hex( cue and &hFFFFFFul ), hex( st and &hFFFFFFul ) ) ) )
    end scope
    t.Check( mw.Chooser.ShownCount( ) = 3, P( sc, strings.Format( "three rows ({})", mw.Chooser.ShownCount( ) ) ) )
    t.Check( RowsDrawn( mw.Chooser.Pop, mw.Chooser.List ), P( sc, "and draws them" ) )
    scope   ' in the right-click menu's colours: the selected first row, a plain second one
        dim as TKPOPUPMENU_COLORS mc = tkPopupMenu_ThemeColors( tkApp_Theme( ) )
        dim as TKRECT la
        tkWidget_AbsRect( mw.Chooser.List, la )
        dim as long ih = tkListTree_GetItemHeightPx( mw.Chooser.List )
        dim as ulong c1 = tkTest_PixelAt( mw.Chooser.Pop, la.left + 3, la.top + 2 ) and &hFFFFFFul
        dim as ulong c2 = tkTest_PixelAt( mw.Chooser.Pop, la.left + 3, la.top + ih + 2 ) and &hFFFFFFul
        t.Check( (c1 = (mc.BackColorHot and &hFFFFFFul)) andalso (c2 = (mc.BackColor and &hFFFFFFul)), _
                 P( sc, strings.Format( "rows in the menu's colours (&h{} &h{})", hex( c1 ), hex( c2 ) ) ) )
    end scope
    ' Ctrl+E opens it where Search Symbol opens: centred at the top of the panes
    dim as long popX = 0, popY = 0
    SDL_GetWindowPosition( mw.Chooser.Pop->win, @popX, @popY )
    dim as long popW = 0, popH = 0
    SDL_GetWindowSize( mw.Chooser.Pop->win, @popW, @popH )
    dim as single dd = h->fDensity
    t.Check( (abs( popX * dd - (h->root->cw - popW * dd) / 2 ) <= 2) andalso (abs( popY * dd - (mw.MenuHeight( ) + tkForm_Scale( mw.form, 32 )) ) <= 2), _
             P( sc, strings.Format( "Ctrl+E: centred at the top, like Search Symbol: {},{} {}x{}", popX, popY, popW, popH ) ) )
    if mw.Chooser.Pop then
        tkTest_PushText( mw.Chooser.Pop, "b.t" )
        tkTest_PumpFor( h, 40 )
    end if
    t.Check( mw.Chooser.ShownCount( ) = 1, P( sc, strings.Format( "'b.t' leaves one row ({})", mw.Chooser.ShownCount( ) ) ) )
    PopKey( mw, SDLK_RETURN, SDL_SCANCODE_RETURN )
    t.Check( (mw.Chooser.IsOpen( ) = false) andalso (lcase( mw.ActivePath( ) ) = lcase( pathB )), P( sc, "Enter showed b.tiko: " & mw.ActivePath( ) ) )
    t.Check( tkHost_GetFocus( h ) = mw.View( ).Widget( ), P( sc, "and the view has the focus" ) )
    ' one click on a row picks it (rows: the most recent first -- b, c, a)
    Chord( h, SDLK_E, SDL_SCANCODE_E, KMOD_PRIMARY )
    if (mw.Chooser.Pop <> 0) andalso (mw.Chooser.List <> 0) then
        dim as TKRECT la
        tkWidget_AbsRect( mw.Chooser.List, la )
        dim as long ih = tkListTree_GetItemHeightPx( mw.Chooser.List )
        tkTest_Click( mw.Chooser.Pop, la.left + (la.right - la.left) \ 2, la.top + 2 * ih + ih \ 2 )
        tkTest_PumpFor( h, 60 )
    end if
    t.Check( (mw.Chooser.IsOpen( ) = false) andalso (lcase( mw.ActivePath( ) ) = lcase( pathA )), P( sc, "one click on the third row showed a.tiko: " & mw.ActivePath( ) ) )
    mw.ShowDoc( mw.FindOpen( pathB ) )

    ' ---- Ctrl+Tab: the next buffer in open order (a, b, c) at once, no popup, wrapping at the end;
    ' Ctrl+Shift+Tab the one before, wrapping at the start
    Chord( h, SDLK_TAB, SDL_SCANCODE_TAB, KMOD_PRIMARY )
    t.Check( (mw.Chooser.IsOpen( ) = false) andalso (lcase( mw.ActivePath( ) ) = lcase( pathC )), P( sc, "Ctrl+Tab showed c: " & mw.ActivePath( ) ) )
    t.Check( tkHost_GetFocus( h ) = mw.View( ).Widget( ), P( sc, "and the view has the focus" ) )
    Chord( h, SDLK_TAB, SDL_SCANCODE_TAB, KMOD_PRIMARY )
    t.Check( lcase( mw.ActivePath( ) ) = lcase( pathA ), P( sc, "Ctrl+Tab on the last wrapped to a: " & mw.ActivePath( ) ) )
    Chord( h, SDLK_TAB, SDL_SCANCODE_TAB, KMOD_PRIMARY or SDL_KMOD_SHIFT )
    t.Check( lcase( mw.ActivePath( ) ) = lcase( pathC ), P( sc, "Ctrl+Shift+Tab on the first wrapped to c: " & mw.ActivePath( ) ) )
    Chord( h, SDLK_TAB, SDL_SCANCODE_TAB, KMOD_PRIMARY or SDL_KMOD_SHIFT )
    t.Check( lcase( mw.ActivePath( ) ) = lcase( pathB ), P( sc, "Ctrl+Shift+Tab: b: " & mw.ActivePath( ) ) )
    Chord( h, SDLK_TAB, SDL_SCANCODE_TAB, KMOD_PRIMARY or SDL_KMOD_SHIFT )
    t.Check( (mw.Chooser.IsOpen( ) = false) andalso (lcase( mw.ActivePath( ) ) = lcase( pathA )), P( sc, "Ctrl+Shift+Tab: a: " & mw.ActivePath( ) ) )

    ' ---- the status panels: the buffer's tooltip is its full path; encoding, line ending, build pick
    t.Check( lcase( mw.StatusTip( mainwin.StatusPanel.Buffer ) ) = lcase( pathA ), P( sc, "the buffer panel's tooltip: " & mw.StatusTip( mainwin.StatusPanel.Buffer ) ) )
    t.Check( mw.StatusTip( mainwin.StatusPanel.Encoding ) = "", P( sc, "no tooltip on the others" ) )
    t.Check( (mw.StatusTip( mainwin.StatusPanel.Settings ) = platform.PrimaryModifierName( ) & "+Comma") andalso _
             (mw.StatusTip( mainwin.StatusPanel.Keys ) = platform.PrimaryModifierName( ) & "+K"), _
             P( sc, "Settings' and Keys' tooltips: their keys: " & mw.StatusTip( mainwin.StatusPanel.Settings ) & " / " & mw.StatusTip( mainwin.StatusPanel.Keys ) ) )
    ClickPanel( mw, mainwin.StatusPanel.Encoding )
    t.Check( mw.Chooser.IsOpen( ) andalso (mw.Choosing = mainwin.PickKind.Encoding), P( sc, "the encoding panel opens a chooser" ) )
    t.Check( mw.Chooser.SelectedTag( ) = clng( docencoding.FileEncoding.Utf8 ), P( sc, "on the current encoding, UTF-8" ) )
    t.Check( (mw.Chooser.Query <> 0) andalso (tkTextBox_GetCueBannerText( mw.Chooser.Query ) = "Select file encoding"), _
             P( sc, "a query box with its cue: Select file encoding" ) )
    PopKey( mw, SDLK_DOWN, SDL_SCANCODE_DOWN )
    PopKey( mw, SDLK_RETURN, SDL_SCANCODE_RETURN )
    t.Check( mw.StatusText( mainwin.StatusPanel.Encoding ) = "UTF-8 (BOM)", P( sc, "UTF-8 (BOM) chosen: " & mw.StatusText( mainwin.StatusPanel.Encoding ) ) )
    ClickPanel( mw, mainwin.StatusPanel.LineEnding )
    t.Check( mw.Chooser.IsOpen( ) andalso (mw.Choosing = mainwin.PickKind.LineEnding), P( sc, "the line-ending panel opens a chooser" ) )
    t.Check( mw.Chooser.SelectedTag( ) = clng( docencoding.LineEnd.Lf ), P( sc, "on the current line ending, LF" ) )
    PopKey( mw, SDLK_UP, SDL_SCANCODE_UP )                             ' the row above: CRLF
    PopKey( mw, SDLK_RETURN, SDL_SCANCODE_RETURN )
    t.Check( mw.StatusText( mainwin.StatusPanel.LineEnding ) = "CRLF", P( sc, "converted to CRLF" ) )
    t.Check( mw.View( ).Text( ) = "dim a as long" & chr( 13, 10 ), P( sc, "the line break converted in the text" ) )
    Chord( h, SDLK_S, SDL_SCANCODE_S, KMOD_PRIMARY )
    t.Check( ReadBytes( pathA ) = chr( &hEF, &hBB, &hBF ) & "dim a as long" & chr( 13, 10 ), P( sc, "saved with a BOM and CRLF" ) )
    ClickPanel( mw, mainwin.StatusPanel.Build )
    t.Check( mw.Chooser.IsOpen( ) andalso (mw.Choosing = mainwin.PickKind.Build), P( sc, "the build panel opens a chooser" ) )
    PopKey( mw, SDLK_DOWN, SDL_SCANCODE_DOWN )
    PopKey( mw, SDLK_RETURN, SDL_SCANCODE_RETURN )
    t.Check( mw.StatusText( mainwin.StatusPanel.Build ) = "Release", P( sc, "the build panel picked Release" ) )
    dim as ustring sfile = fs.PathJoin( mw.ConfigDir, settings.SETTINGS_FILE ), bnl = wchr( 10 )
    dim as ustring relDefault = "name = 'Release'" & bnl & "options = '-O2'" & bnl & "default = true"
    t.Check( (instr( fs.ReadAllText( sfile ).ValueOr( "" ), relDefault ) > 0) andalso (mw.Prefs.DefaultBuild( ) = "Release"), _
             P( sc, "and made it settings.toml's default" ) )
    mw.Execute( Cmd.Settings )
    mw.Execute( Cmd.BuildConfig )
    t.Check( mw.Chooser.SelectedTag( ) = 1, P( sc, "the build list opens on the current one, Release" ) )
    PopKey( mw, SDLK_UP, SDL_SCANCODE_UP )                             ' the row above: Debug
    PopKey( mw, SDLK_RETURN, SDL_SCANCODE_RETURN )
    t.Check( (instr( mw.View( ).Text( ), "name = 'Debug'" & bnl & "options = '-g -exx'" & bnl & "default = true" ) > 0) andalso _
             (mw.View( ).IsModified( ) = false), P( sc, "Debug picked: the open settings.toml reloaded with it" ) )
    mw.Execute( Cmd.FileClose )
    mw.Execute( Cmd.BuildConfig )
    PopKey( mw, SDLK_DOWN, SDL_SCANCODE_DOWN )
    PopKey( mw, SDLK_RETURN, SDL_SCANCODE_RETURN )
    t.Check( lcase( mw.ActivePath( ) ) = lcase( pathA ), P( sc, "back on a.tiko, Release again: " & mw.ActivePath( ) ) )
    ClickPanel( mw, mainwin.StatusPanel.Buffer )
    t.Check( mw.Chooser.IsOpen( ) andalso (mw.Choosing = mainwin.PickKind.Buffers) andalso (mw.Chooser.ShownCount( ) = 3), _
             P( sc, strings.Format( "the buffer panel lists the open files ({})", mw.Chooser.ShownCount( ) ) ) )
    scope   ' a click on the panel opens it where Ctrl+E does: centred at the top of the panes
        dim as long qx = 0, qy = 0, qw = 0, qh = 0
        SDL_GetWindowPosition( mw.Chooser.Pop->win, @qx, @qy )
        SDL_GetWindowSize( mw.Chooser.Pop->win, @qw, @qh )
        t.Check( (abs( qx * h->fDensity - (h->root->cw - qw * h->fDensity) / 2 ) <= 2) andalso (abs( qy * h->fDensity - (mw.MenuHeight( ) + tkForm_Scale( mw.form, 32 )) ) <= 2), _
                 P( sc, strings.Format( "and opens centred at the top, like Ctrl+E: {},{} {}x{}", qx, qy, qw, qh ) ) )
    end scope
    t.Check( mw.StatusText( mainwin.StatusPanel.Buffer ) = "a.tiko (+2 more)", P( sc, "the panel counts the other buffers: " & mw.StatusText( mainwin.StatusPanel.Buffer ) ) )
    PopKey( mw, SDLK_ESCAPE, SDL_SCANCODE_ESCAPE )
    t.Check( mw.Chooser.IsOpen( ) = false, P( sc, "Esc closes it" ) )

    ' ---- split: another buffer in pane 2 (never the same one), a status line under each pane, the
    ' caption naming the focused pane's buffer
    dim as long cx = h->root->cw, cy = h->root->ch
    dim as long top = mw.MenuHeight( ) + mw.TabsHeight( ), sh = mw.StatusHeight( ), bar = tkForm_Scale( mw.form, mainwin.SPLIT_BAR )
    dim as DocRef splitA = mw.FindOpen( pathA ), splitB = mw.FindOpen( pathB )
    t.Check( mw.Pane1 = splitA, P( sc, "a.tiko before the split: " & mw.ActivePath( ) ) )
    Chord( h, SDLK_BACKSLASH, SDL_SCANCODE_BACKSLASH, KMOD_PRIMARY )
    t.Check( (mw.Split = session.SplitMode.Vertical) andalso (mw.Pane2 <> 0) andalso (mw.Pane2 <> mw.Pane1), _
             P( sc, "Ctrl+\ split left/right with another buffer in pane 2" ) )
    if mw.Pane2 = 0 then exit sub
    dim as TK_WIDGET ptr v1 = mw.Pane1->Main.Widget( ), v2 = mw.Pane2->Main.Widget( )
    dim as long w1 = cint( (cx - bar) * 0.5 )
    t.Check( (v1->x = 0) andalso (PaneCW( mw, v1 ) = w1) andalso (PaneCH( mw, v1 ) = cy - sh - top), P( sc, strings.Format( "pane 1 at {} {}x{}", v1->x, PaneCW( mw, v1 ), PaneCH( mw, v1 ) ) ) )
    t.Check( (v2->x = w1 + bar) andalso (PaneCW( mw, v2 ) = cx - w1 - bar) andalso (PaneCH( mw, v2 ) = cy - sh - top) andalso tkWidget_IsVisible( v2 ), _
             P( sc, strings.Format( "pane 2 at {} {}x{}", v2->x, PaneCW( mw, v2 ), PaneCH( mw, v2 ) ) ) )
    t.Check( (mw.splitBar <> 0) andalso (mw.splitBar->x = w1) andalso (mw.splitBar->cw = bar), P( sc, "the bar between them" ) )
    t.Check( (mw.splitBar->y = top) andalso (mw.splitBar->ch = cy - top) andalso (mw.splitFoot <> 0) andalso (mw.splitFoot->x = w1) andalso _
             (mw.splitFoot->y = cy - sh), P( sc, strings.Format( "the bar runs to the bottom: {} {}h", mw.splitBar->y, mw.splitBar->ch ) ) )
    t.Check( (mw.status->x = 0) andalso (mw.status->y = cy - sh) andalso (mw.status->cw = w1) andalso _
             tkWidget_IsVisible( mw.status2 ) andalso (mw.status2->x = w1 + bar) andalso (mw.status2->y = cy - sh) andalso _
             (mw.status2->cw = cx - w1 - bar), P( sc, strings.Format( "a status line under each: {} {}w / {} {}w", _
             mw.status->x, mw.status->cw, mw.status2->x, mw.status2->cw ) ) )
    dim as ustring more_ = strings.Format( " (+{} more)", mw.Docs.Count( ) - 1 )
    t.Check( (tkStatusBar_GetText( mw.status, mainwin.StatusPanel.Buffer ) = "a.tiko" & more_) andalso _
             (tkStatusBar_GetText( mw.status2, mainwin.StatusPanel.Buffer ) = mw.Pane2->DisplayName( ) & more_), _
             P( sc, "each names its pane's buffer: " & tkStatusBar_GetText( mw.status2, mainwin.StatusPanel.Buffer ) ) )
    title = *SDL_GetWindowTitle( h->win )
    t.Check( mw.InPane2 andalso (tkHost_GetFocus( h ) = v2), P( sc, "the new pane has the focus" ) )
    dim as ustring p2name = mw.Pane2->Path
    if len( p2name ) = 0 then p2name = mw.Pane2->DisplayName( )
    t.Check( title = "tkEdit - " & p2name, P( sc, "the caption names pane 2's, its full path: " & title ) )
    Chord( h, SDLK_GRAVE, SDL_SCANCODE_GRAVE, KMOD_PRIMARY )
    title = *SDL_GetWindowTitle( h->win )
    t.Check( (mw.InPane2 = false) andalso (tkHost_GetFocus( h ) = v1) andalso (title = "tkEdit - " & pathA), _
             P( sc, "Ctrl+Tilde moved the focus to pane 1, the caption with it: " & title ) )
    Chord( h, SDLK_GRAVE, SDL_SCANCODE_GRAVE, KMOD_PRIMARY )
    t.Check( mw.InPane2 andalso (tkHost_GetFocus( h ) = v2), P( sc, "and back to pane 2" ) )
    mw.ShowDoc( splitB )
    v2 = mw.Pane2->Main.Widget( )
    t.Check( (mw.Pane2 = splitB) andalso (mw.Pane1 = splitA) andalso (tkHost_GetFocus( h ) = v2), P( sc, "b.tiko in pane 2, a.tiko still in pane 1" ) )
    title = *SDL_GetWindowTitle( h->win )
    t.Check( title = "tkEdit - " & pathB, P( sc, "the caption follows the buffer: " & title ) )
    tkTest_PushText( h, "zz" )
    tkTest_PumpFor( h, 40 )
    t.Check( (left( splitB->Main.Text( ), 2 ) = "zz") andalso (left( splitA->Main.Text( ), 2 ) <> "zz"), P( sc, "typing in pane 2 edits its own buffer only" ) )
    mw.ShowDoc( splitA )
    t.Check( (mw.InPane2 = false) andalso (mw.Pane2 = splitB) andalso (mw.Pane1 = splitA), P( sc, "showing pane 1's buffer from pane 2 moves the focus there" ) )
    ClickPanel2( mw, mainwin.StatusPanel.Buffer )
    t.Check( mw.InPane2 andalso mw.Chooser.IsOpen( ), P( sc, "a click on pane 2's status line focuses pane 2" ) )
    PopKey( mw, SDLK_ESCAPE, SDL_SCANCODE_ESCAPE )
    Chord( h, SDLK_TAB, SDL_SCANCODE_TAB, KMOD_PRIMARY )
    t.Check( (mw.Pane2 <> splitA) andalso (mw.Pane1 = splitA), P( sc, "Ctrl+Tab in pane 2 passes over pane 1's buffer" ) )
    mw.ShowDoc( splitB )
    Chord( h, SDLK_BACKSLASH, SDL_SCANCODE_BACKSLASH, KMOD_PRIMARY or SDL_KMOD_SHIFT )
    v1 = mw.Pane1->Main.Widget( )
    v2 = mw.Pane2->Main.Widget( )
    dim as long h1 = cint( (cy - top - sh - sh - bar) * 0.5 )
    t.Check( (mw.Split = session.SplitMode.Horizontal) andalso (v1->y = top) andalso (PaneCH( mw, v1 ) = h1) andalso (PaneCW( mw, v1 ) = cx) andalso _
             (mw.status->y = top + h1) andalso (mw.status->cw = cx) andalso (v2->y = top + h1 + sh + bar) andalso (PaneCH( mw, v2 ) = cy - top - sh - h1 - sh - bar) andalso _
             (mw.status2->y = cy - sh) andalso (mw.status2->cw = cx), _
             P( sc, strings.Format( "Ctrl+Shift+\ switched to top/bottom: {} {} / status {} / {} {} / status {}", v1->y, PaneCH( mw, v1 ), mw.status->y, v2->y, PaneCH( mw, v2 ), mw.status2->y ) ) )
    Chord( h, SDLK_BACKSLASH, SDL_SCANCODE_BACKSLASH, KMOD_PRIMARY or SDL_KMOD_SHIFT )
    t.Check( (mw.Split = session.SplitMode.None) andalso (mw.Pane2 = 0) andalso (tkWidget_IsVisible( mw.status2 ) = false), P( sc, "the same key again unsplit" ) )
    dim as TK_WIDGET ptr vv = mw.View( ).Widget( )
    t.Check( (vv->x = 0) andalso (vv->y = top) andalso (PaneCW( mw, vv ) = cx) andalso (PaneCH( mw, vv ) = cy - sh - top) andalso (mw.status->cw = cx) andalso _
             (mw.status->y = cy - sh), P( sc, "one pane and one status line fill the window again" ) )
    t.Check( lcase( mw.ActivePath( ) ) = lcase( pathB ), P( sc, "keeping the buffer that had the focus: " & mw.ActivePath( ) ) )

    ' ---- new, save as, close with and without saving
    Chord( h, SDLK_N, SDL_SCANCODE_N, KMOD_PRIMARY )
    Chord( h, SDLK_RETURN, SDL_SCANCODE_RETURN, 0 )     ' the New picker's first row: Blank File
    t.Check( (mw.Docs.Count( ) = 4) andalso mw.Active( )->IsNew( ), P( sc, "Ctrl+N: an untitled buffer" ) )
    tkTest_PushText( h, "print 1" )
    tkTest_PumpFor( h, 30 )
    dim as ustring pathD = fs.PathJoin( dir_, "d.tiko" )
    gPickPath = pathD
    Chord( h, SDLK_S, SDL_SCANCODE_S, KMOD_PRIMARY )
    t.Check( (lcase( mw.ActivePath( ) ) = lcase( pathD )) andalso (fs.ReadAllText( pathD ).ValueOr( "" ) = "print 1"), P( sc, "Ctrl+S on an untitled buffer saved it as d.tiko" ) )
    tkTest_PushText( h, "!" )
    tkTest_PumpFor( h, 30 )
    gAsked = 0
    Answer( MBX_IDCANCEL )
    Chord( h, SDLK_W, SDL_SCANCODE_W, KMOD_PRIMARY )
    t.Check( (gAsked = 1) andalso (mw.FindOpen( pathD ) <> 0), P( sc, "Ctrl+W on a modified buffer asked; Cancel kept it" ) )
    Answer( MBX_IDNO )
    Chord( h, SDLK_W, SDL_SCANCODE_W, KMOD_PRIMARY )
    t.Check( (mw.FindOpen( pathD ) = 0) andalso (fs.ReadAllText( pathD ).ValueOr( "" ) = "print 1"), P( sc, "Don't Save closed it, the file untouched" ) )
    t.Check( mw.Docs.Count( ) = 3, P( sc, strings.Format( "three buffers again ({})", mw.Docs.Count( ) ) ) )

    ' ---- another program writes: the buffer reloads, modified or not, with no question
    dim as DocRef db = mw.FindOpen( pathB )
    WriteBytes( pathB, "dim changed as long" & chr( 13, 10, 13, 10 ) )
    db->Stamp.Size = 0                                                   ' the clock may not tick
    mw.CheckDisk( )
    t.Check( db->Main.Text( ) = "dim changed as long" & chr( 13, 10, 13, 10 ), P( sc, "the unmodified buffer reloaded" ) )
    dim as DocRef da = mw.FindOpen( pathA )
    WriteBytes( pathA, "new a" & chr( 10 ) )
    da->Stamp.Size = 0
    gAsked = 0
    mw.CheckDisk( )
    t.Check( (gAsked = 0) andalso (da->Main.Text( ) = "new a" & chr( 10 )) andalso (da->IsModified( ) = false), _
             P( sc, "the modified buffer reloaded, nothing asked: " & left( da->Main.Text( ), 8 ) ) )

    ' ---- Ctrl+Shift+O: the recent files (settings.toml among them: the build pick opened it; e and f)
    Chord( h, SDLK_O, SDL_SCANCODE_O, KMOD_PRIMARY or SDL_KMOD_SHIFT )
    t.Check( mw.Chooser.IsOpen( ) andalso (mw.Choosing = mainwin.PickKind.Recent) andalso (mw.Chooser.ShownCount( ) = 7), _
             P( sc, strings.Format( "Ctrl+Shift+O lists the recent files ({})", mw.Chooser.ShownCount( ) ) ) )
    t.Check( (mw.Chooser.Query <> 0) andalso (tkTextBox_GetCueBannerText( mw.Chooser.Query ) = "Open recent file"), P( sc, "cue: Open recent file" ) )
    scope   ' where Search Symbol opens: centred at the top of the panes
        dim as long rx = 0, ry = 0, rw = 0, rh = 0
        SDL_GetWindowPosition( mw.Chooser.Pop->win, @rx, @ry )
        SDL_GetWindowSize( mw.Chooser.Pop->win, @rw, @rh )
        t.Check( (abs( rx * h->fDensity - (h->root->cw - rw * h->fDensity) / 2 ) <= 2) andalso (abs( ry * h->fDensity - (mw.MenuHeight( ) + tkForm_Scale( mw.form, 32 )) ) <= 2), _
                 P( sc, strings.Format( "centred at the top, like Search Symbol: {},{} {}x{}", rx, ry, rw, rh ) ) )
    end scope
    PopKey( mw, SDLK_ESCAPE, SDL_SCANCODE_ESCAPE )
    ' a recent file deleted from disk is not offered (still in the list)
    fs.RemoveFile( pathE )
    Chord( h, SDLK_O, SDL_SCANCODE_O, KMOD_PRIMARY or SDL_KMOD_SHIFT )
    dim as boolean showsE = false
    for k as long = 0 to mw.Chooser.Rows.Count( ) - 1
        if mw.Chooser.Rows[k].Cells[1] = "e.tiko" then showsE = true
    next
    t.Check( mw.Chooser.IsOpen( ) andalso (mw.Chooser.ShownCount( ) = 6) andalso (showsE = false) andalso (mw.Recent.Count( ) = 7), _
             P( sc, strings.Format( "e.tiko, deleted, is not offered ({} shown, {} in the list)", mw.Chooser.ShownCount( ), mw.Recent.Count( ) ) ) )
    PopKey( mw, SDLK_ESCAPE, SDL_SCANCODE_ESCAPE )

    ' ---- a drop from the OS opens the file (and on macOS a Finder Open With arrives this way);
    ' last, because the file joins the recent list the checks above count
    dim as ustring pathDrop = fs.PathJoin( dir_, "dropped.tiko" )
    WriteBytes( pathDrop, "dim dropped as long" & chr( 10 ) )
    tkTest_PushDrop( h, pathDrop, 40, 40 )
    tkTest_PumpFor( h, 100 )
    t.Check( lcase( mw.ActivePath( ) ) = lcase( pathDrop ), P( sc, "a dropped file opens: " & mw.ActivePath( ) ) )

    mw.Destroy( )
end sub

' P2: session.toml -- the buffers, the active one, the split and the pane-2 buffer, the build,
' the caret, the recent files -- written by one window and restored by the next.
' ================================================================ the tab strip ([ui] tab_strip)

' Clicks the middle of a split bar (bar: mw.splitBar or mw.splitFoot); clicks = 2 makes it a double
' click, the first press and release then the second, as SDL reports one.
private sub ClickSplitBar( byref mw as mainwin.Window, byval bar as TK_WIDGET ptr, byval clicks as long )
    if bar = 0 then exit sub
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    dim as single px = bar->x + bar->cw \ 2, py = bar->y + bar->ch \ 2
    tkTest_Click( h, px, py, SDL_BUTTON_LEFT, 1 )
    if clicks = 2 then tkTest_Click( h, px, py, SDL_BUTTON_LEFT, 2 )
    tkTest_PumpFor( h, 60 )
end sub

' Clicks the middle of tab idx's rect, or of its X when onClose, in window pixels.
private sub ClickTab( byref mw as mainwin.Window, byval idx as long, byval onClose as boolean = false )
    dim as TKRECT rp, rt, ri, rx
    tkTabBar_GetTabParts( mw.tabs, idx, rp, rt, ri, rx )
    if onClose then rp = rx
    tkTest_Click( tkForm_Host( mw.form ), mw.tabs->x + (rp.left + rp.right) \ 2, mw.tabs->y + (rp.top + rp.bottom) \ 2 )
    tkTest_PumpFor( tkForm_Host( mw.form ), 60 )
end sub

' Writes settings.toml with tab_strip on or off and applies it, as saving it in tkEdit does.
private sub SetTabStrip( byref mw as mainwin.Window, byval onOff as boolean )
    dim as ustring v = "false"
    if onOff then v = "true"
    fs.WriteAtomic( mw.SettingsFile( ), "version = 1" & chr( 10 ) & "[ui]" & chr( 10 ) & "tab_strip = " & v & chr( 10 ) )
    mw.ReloadSettings( )
    tkTest_PumpFor( tkForm_Host( mw.form ), 60 )
end sub

public sub TabsPass( byref t as Tally, byval sc as single )
    dim as mainwin.Window mw
    mw.ConfigDir = FreshConfig( )
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    gAnswerCount = 0
    t.Check( mw.Create( sc ), P( sc, "tabs: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_PumpFor( h, 150 )
    dim as TK_WIDGET ptr root = tkForm_Widget( mw.form )
    dim as long cx = root->cw, cy = root->ch, sh = mw.StatusHeight( )
    dim as ustring dir_ = Files( )
    dim as ustring pathA = fs.PathJoin( dir_, "a.tiko" ), pathB = fs.PathJoin( dir_, "b.tiko" ), pathC = fs.PathJoin( dir_, "c.tiko" )
    WriteBytes( pathA, "dim a as long" & chr( 10 ) )
    WriteBytes( pathB, "dim b as long" & chr( 10 ) )
    WriteBytes( pathC, "dim c as long" & chr( 10 ) )
    mw.OpenFile( pathA )
    mw.OpenFile( pathB )
    mw.OpenFile( pathC )

    ' ---- on by default (a new settings.toml): the strip across the top, the editor below it, down
    ' to the status line; three tabs fit, so no < > buttons
    t.Check( instr( fs.ReadAllText( mw.SettingsFile( ) ).ValueOr( "" ), chr( 10 ) & "tab_strip = true" ) > 0, _
             P( sc, "a new settings.toml says tab_strip = true" ) )
    dim as long th = tkForm_Scale( mw.form, 28 ), mh = mw.MenuHeight( )
    dim as TK_WIDGET ptr vv = mw.View( ).Widget( )
    t.Check( tkWidget_IsVisible( mw.tabNav ) = false, P( sc, "three tabs fit: no < > buttons" ) )
    t.Check( tkWidget_IsVisible( mw.tabs ) andalso (mw.tabs->x = 0) andalso (mw.tabs->y = mh) andalso (mw.tabs->cw = cx) andalso (mw.tabs->ch = th), _
             P( sc, strings.Format( "tab_strip on: the strip at 0,{} {}x{} (under the menu bar)", mw.tabs->y, mw.tabs->cw, mw.tabs->ch ) ) )
    th += mh                                     ' from here: the strip's bottom edge
    t.Check( (vv->y = th) andalso (PaneCH( mw, vv ) = cy - sh - th) andalso (mw.status->y = cy - sh), _
             P( sc, strings.Format( "the editor below it: y {} height {}", vv->y, PaneCH( mw, vv ) ) ) )
    t.Check( (tkTabBar_GetCount( mw.tabs ) = 3) andalso (tkTabBar_GetText( mw.tabs, 0 ) = "a.tiko") andalso _
             (tkTabBar_GetText( mw.tabs, 2 ) = "c.tiko") andalso (tkTabBar_GetCurSel( mw.tabs ) = 2), _
             P( sc, strings.Format( "a tab per buffer in open order, the active selected ({} tabs, sel {})", tkTabBar_GetCount( mw.tabs ), tkTabBar_GetCurSel( mw.tabs ) ) ) )
    t.Check( (tkTabBar_GetClosable( mw.tabs, 0 ) = true) andalso (tkTabBar_GetGlyph( mw.tabs, 0 ) = ""), P( sc, "every tab has its X" ) )
    ' no accent bar on the selected tab: drawn in the tab's own colour, so the 2 px along its top
    ' are the tab's fill (pixels, at the selected tab's top row)
    scope
        dim as TKTABBAR_COLORS tbc
        tkTabBar_GetColors( mw.tabs, @tbc )
        dim as TKRECT rp, rt, ri, rx
        tkTabBar_GetTabParts( mw.tabs, tkTabBar_GetCurSel( mw.tabs ), rp, rt, ri, rx )
        tkTest_PumpFor( h, 30 )
        ' read a frame rendered and NOT presented: after a present the back buffer is undefined
        ' (Metal's comes back black)
        tkHost_RenderTo( h, false )
        dim as long px = mw.tabs->x + (rp.left + rp.right) \ 2
        dim as ulong topPx = tkTest_PixelAt( h, px, mw.tabs->y + rp.top ) and &hFFFFFFul
        dim as ulong midPx = tkTest_PixelAt( h, px, mw.tabs->y + rp.bottom - tkForm_Scale( mw.form, 4 ) ) and &hFFFFFFul
        t.Check( (tbc.AccentColor = tbc.TabBackColorSelected) andalso (topPx = midPx) andalso (topPx = (tbc.TabBackColorSelected and &hFFFFFFul)), _
                 P( sc, "the selected tab has no accent bar: top &h" & hex( topPx ) & ", fill &h" & hex( midPx ) ) )
    end scope

    ' the output pane's tabs likewise (colours only: in the self-test the pane's pixels read back as
    ' one flat colour, so a pixel check there would prove nothing)
    scope
        dim as TKTABBAR_COLORS oc
        tkTabBar_GetColors( mw.Out.tabs, @oc )
        t.Check( oc.AccentColor = oc.TabBackColorSelected, P( sc, "the output pane's selected tab has no accent bar" ) )
    end scope

    ' ---- a click shows that buffer; an edit marks its tab
    ClickTab( mw, 0 )
    t.Check( (lcase( mw.ActivePath( ) ) = lcase( pathA )) andalso (tkTabBar_GetCurSel( mw.tabs ) = 0), P( sc, "a click on a.tiko's tab shows a.tiko: " & mw.ActivePath( ) ) )
    tkTest_PushText( h, "x" )
    tkTest_PumpFor( h, 30 )
    t.Check( tkTabBar_GetText( mw.tabs, 0 ) = "a.tiko *", P( sc, "an edit marks the tab: " & tkTabBar_GetText( mw.tabs, 0 ) ) )
    Chord( h, SDLK_N, SDL_SCANCODE_N, KMOD_PRIMARY )
    Chord( h, SDLK_RETURN, SDL_SCANCODE_RETURN, 0 )     ' the New picker's first row: Blank File
    t.Check( (tkTabBar_GetCount( mw.tabs ) = 4) andalso (tkTabBar_GetCurSel( mw.tabs ) = 3), P( sc, "Ctrl+N adds a tab, selected" ) )
    mw.CloseDoc( mw.Active( ) )
    t.Check( tkTabBar_GetCount( mw.tabs ) = 3, P( sc, "closing it some other way takes its tab" ) )

    ' ---- the X: a modified buffer asks (Cancel keeps it), an unmodified one goes at once
    gAsked = 0
    Answer( MBX_IDCANCEL )
    ClickTab( mw, 0, true )
    t.Check( (gAsked = 1) andalso (mw.FindOpen( pathA ) <> 0) andalso (tkTabBar_GetCount( mw.tabs ) = 3), _
             P( sc, strings.Format( "the X on a modified tab asks; Cancel keeps it ({} asked, {} tabs)", gAsked, tkTabBar_GetCount( mw.tabs ) ) ) )
    gAsked = 0
    ClickTab( mw, 1, true )
    t.Check( (gAsked = 0) andalso (mw.FindOpen( pathB ) = 0) andalso (tkTabBar_GetCount( mw.tabs ) = 2) andalso _
             (tkTabBar_GetText( mw.tabs, 1 ) = "c.tiko"), P( sc, "the X on an unmodified tab closes it without asking" ) )

    ' ---- a drag reorders the buffers too
    tkTabBar_MoveTab( mw.tabs, 0, 1 )
    mw.TabsReordered( )
    t.Check( (lcase( mw.Docs[0]->Path ) = lcase( pathC )) andalso (lcase( mw.Docs[1]->Path ) = lcase( pathA )), P( sc, "a moved tab moves its buffer in open order" ) )
    mw.ShowStatus( )
    t.Check( (tkTabBar_GetText( mw.tabs, 0 ) = "c.tiko") andalso (tkTabBar_GetCount( mw.tabs ) = 2), P( sc, "and the tabs stay as moved" ) )

    ' ---- split: both panes and the bar start below the strip; a tab shows its buffer in the focused pane
    mw.OpenFile( pathB )
    Chord( h, SDLK_BACKSLASH, SDL_SCANCODE_BACKSLASH, KMOD_PRIMARY )
    dim as TK_WIDGET ptr v1 = mw.Pane1->Main.Widget( ), v2 = mw.Pane2->Main.Widget( )
    t.Check( (mw.Split = session.SplitMode.Vertical) andalso (v1->y = th) andalso (v2->y = th) andalso (mw.splitBar->y = th) andalso _
             (PaneCH( mw, v1 ) = cy - sh - th), P( sc, strings.Format( "left/right: both panes below the strip ({} {} bar {})", v1->y, v2->y, mw.splitBar->y ) ) )
    dim as long sel = -1
    for i as long = 0 to mw.Docs.Count( ) - 1
        if mw.Docs[i] = mw.Active( ) then sel = i
    next
    t.Check( tkTabBar_GetCurSel( mw.tabs ) = sel, P( sc, "the focused pane's buffer is the selected tab" ) )
    ' a double click on the bar closes the split, as Ctrl+\ again (author 2026-10-27); one click does not
    ClickSplitBar( mw, mw.splitBar, 1 )
    t.Check( mw.Split = session.SplitMode.Vertical, P( sc, "one click on the left/right bar keeps the split" ) )
    ClickSplitBar( mw, mw.splitBar, 2 )
    t.Check( (mw.Split = session.SplitMode.None) andalso (mw.Pane2 = 0) andalso (mw.splitBar = 0) andalso (mw.splitFoot = 0) andalso _
             (tkWidget_IsVisible( mw.status2 ) = false), P( sc, "a double click on the left/right bar closed the split" ) )
    Chord( h, SDLK_BACKSLASH, SDL_SCANCODE_BACKSLASH, KMOD_PRIMARY )
    ClickSplitBar( mw, mw.splitFoot, 2 )
    t.Check( mw.Split = session.SplitMode.None, P( sc, "so does one on its part through the status row" ) )
    Chord( h, SDLK_BACKSLASH, SDL_SCANCODE_BACKSLASH, KMOD_PRIMARY )
    Chord( h, SDLK_BACKSLASH, SDL_SCANCODE_BACKSLASH, KMOD_PRIMARY or SDL_KMOD_SHIFT )
    v1 = mw.Pane1->Main.Widget( )
    v2 = mw.Pane2->Main.Widget( )
    dim as long bar = mw.splitBar->ch
    dim as long h1 = cint( (cy - th - sh - sh - bar) * mw.SplitRatio )   ' as Layout rounds it
    t.Check( (mw.Split = session.SplitMode.Horizontal) andalso (v1->y = th) andalso (PaneCH( mw, v1 ) = h1) andalso (mw.status->y = th + h1) andalso _
             (v2->y = th + h1 + sh + bar) andalso (v2->y + PaneCH( mw, v2 ) = cy - sh), _
             P( sc, strings.Format( "top/bottom under the strip: {} {} / status {} / {} {}", v1->y, PaneCH( mw, v1 ), mw.status->y, v2->y, PaneCH( mw, v2 ) ) ) )
    dim as long ratio0 = cint( mw.SplitRatio * 1000 )
    ClickSplitBar( mw, mw.splitBar, 2 )
    t.Check( (mw.Split = session.SplitMode.None) andalso (mw.Pane2 = 0) andalso (mw.splitBar = 0), P( sc, "a double click on the top/bottom bar closed the split" ) )
    t.Check( cint( mw.SplitRatio * 1000 ) = ratio0, P( sc, "and moved nothing on the way (the ratio kept)" ) )

    ' ---- more tabs than fit: the < > buttons at the strip's right end, greyed at either end; they
    ' and the wheel scroll the tabs one at a time
    dim as ustring many( 0 to 23 )
    for i as long = 0 to 23
        many( i ) = fs.PathJoin( dir_, "a_rather_long_file_name_" & i & ".tiko" )
        WriteBytes( many( i ), "dim x as long" & chr( 10 ) )
        mw.OpenFile( many( i ) )
    next
    tkTest_PumpFor( h, 60 )
    dim as long nw = tkToolbar_GetIdealWidth( mw.tabNav )
    t.Check( tkWidget_IsVisible( mw.tabNav ) andalso (mw.tabNav->x = cx - nw) andalso (mw.tabNav->y = mh) andalso (mw.tabNav->ch = th - mh) andalso _
             (mw.tabs->cw = cx - nw), P( sc, strings.Format( "{} tabs overflow: the buttons at {} ({} wide), the tabs {} wide", _
                                                       tkTabBar_GetCount( mw.tabs ), mw.tabNav->x, nw, mw.tabs->cw ) ) )
    dim as long lastSel = tkTabBar_GetCurSel( mw.tabs )
    dim as TKRECT rs
    tkTabBar_GetTabRect( mw.tabs, lastSel, rs )
    t.Check( (lastSel = mw.Docs.Count( ) - 1) andalso (rs.right <= mw.tabs->cw) andalso (rs.left >= 0), _
             P( sc, strings.Format( "the last opened is selected and in view ({}-{} of {})", rs.left, rs.right, mw.tabs->cw ) ) )
    t.Check( tkToolbar_GetEnabled( mw.tabNav, 0 ) andalso (tkToolbar_GetEnabled( mw.tabNav, 1 ) = false), _
             P( sc, "scrolled to the end: < works, > greyed" ) )
    dim as long first0 = tkTabBar_GetFirstVisible( mw.tabs )
    dim as TKRECT rb
    tkToolbar_GetItemRect( mw.tabNav, 0, rb )
    tkTest_Click( h, mw.tabNav->x + (rb.left + rb.right) \ 2, mw.tabNav->y + (rb.top + rb.bottom) \ 2 )
    tkTest_PumpFor( h, 60 )
    t.Check( (tkTabBar_GetFirstVisible( mw.tabs ) = first0 - 1) andalso tkToolbar_GetEnabled( mw.tabNav, 1 ), _
             P( sc, strings.Format( "a click on < scrolls one tab left ({} -> {}), > works again", first0, tkTabBar_GetFirstVisible( mw.tabs ) ) ) )
    tkTest_PushWheel( h, mw.tabs->x + mw.tabs->cw \ 2, mw.tabs->y + mw.tabs->ch \ 2, 0, 1 )
    tkTest_PumpFor( h, 60 )
    t.Check( tkTabBar_GetFirstVisible( mw.tabs ) = first0 - 2, P( sc, strings.Format( "the wheel up scrolls one more left ({})", tkTabBar_GetFirstVisible( mw.tabs ) ) ) )
    tkTabBar_SetFirstVisible( mw.tabs, 0 )
    mw.LayoutTabs( )
    t.Check( (tkToolbar_GetEnabled( mw.tabNav, 0 ) = false) andalso tkToolbar_GetEnabled( mw.tabNav, 1 ), P( sc, "at the start: < greyed, > works" ) )
    for i as long = 0 to 23
        mw.CloseDoc( mw.FindOpen( many( i ) ) )
    next
    mw.ShowStatus( )
    t.Check( (tkWidget_IsVisible( mw.tabNav ) = false) andalso (mw.tabs->cw = cx), P( sc, "closed again, all fit: the buttons gone, the tabs full width" ) )

    ' ---- off again: gone, the editor back under the menu bar
    SetTabStrip( mw, false )
    vv = mw.View( ).Widget( )
    t.Check( (tkWidget_IsVisible( mw.tabs ) = false) andalso (tkWidget_IsVisible( mw.tabNav ) = false) andalso (vv->y = mh) andalso (PaneCH( mw, vv ) = cy - sh - mh), _
             P( sc, "tab_strip off: the strip gone, the editor under the menu bar" ) )

    for each d as DocRef in mw.Docs
        d->Main.SetSavePoint( )
    next
    mw.Destroy( )
end sub

public sub SessionPass( byref t as Tally, byval sc as single )
    dim as ustring cfg = FreshConfig( )
    dim as ustring dir_ = Files( )
    dim as ustring pathA = fs.PathJoin( dir_, "a.tiko" ), pathB = fs.PathJoin( dir_, "b.tiko" )
    WriteBytes( pathA, "line 1" & chr( 10 ) & "line 2" & chr( 10 ) & "line 3" & chr( 10 ) )
    WriteBytes( pathB, "dim b as long" & chr( 10 ) )
    scope
        dim as mainwin.Window mw
        mw.ConfigDir = cfg
        mw.Ask = @ScriptedAsk
        mw.Pick = @ScriptedPick
        t.Check( mw.Create( sc ), P( sc, "session: first window" ) )
        if mw.form = 0 then exit sub
        mw.Show( )
        mw.OpenFile( pathB )
        mw.OpenFile( pathA )
        mw.View( ).ToggleBreakpoint( 1 )
        mw.View( ).GoToLine( 2 )
        mw.ToggleSplit( session.SplitMode.Vertical )
        mw.FocusPane( true )
        mw.ShowDoc( mw.FindOpen( pathB ) )
        mw.FocusPane( false )
        mw.CurrentBuild = "Release"
        SDL_SetWindowSize( tkForm_Host( mw.form )->win, 720, 520 )
        SDL_SetWindowPosition( tkForm_Host( mw.form )->win, 140, 130 )
        SDL_SyncWindow( tkForm_Host( mw.form )->win )
        tkTest_PumpFor( tkForm_Host( mw.form ), 100 )
        mw.SaveSession( )
        ' closing everything while split ends (it used to make untitled buffers for ever)
        t.Check( mw.CloseAll( ) andalso (mw.Docs.Count( ) = 1) andalso (mw.Split = session.SplitMode.None), _
                 P( sc, strings.Format( "closing all, split, ends with one buffer ({})", mw.Docs.Count( ) ) ) )
        mw.Destroy( )
    end scope
    t.Check( fs.IsFile( fs.PathJoin( cfg, session.SESSION_FILE ) ), P( sc, "session.toml written" ) )
    dim as mainwin.Window mw2
    mw2.ConfigDir = cfg
    mw2.Ask = @ScriptedAsk
    mw2.Pick = @ScriptedPick
    t.Check( mw2.Create( sc ), P( sc, "session: second window" ) )
    if mw2.form = 0 then exit sub
    mw2.Show( )
    mw2.RestoreSession( )
    tkTest_PumpFor( tkForm_Host( mw2.form ), 100 )
    t.Check( mw2.Docs.Count( ) = 2, P( sc, strings.Format( "two buffers restored ({})", mw2.Docs.Count( ) ) ) )
    t.Check( (mw2.Pane1 <> 0) andalso (lcase( mw2.Pane1->Path ) = lcase( pathA )), P( sc, "pane 1 shows a.tiko" ) )
    t.Check( (mw2.Split = session.SplitMode.Vertical) andalso (mw2.Pane2 <> 0) andalso (mw2.Pane2 = mw2.FindOpen( pathB )), P( sc, "split, b.tiko in pane 2" ) )
    t.Check( (mw2.Pane1 <> 0) andalso (mw2.Pane1->Main.CaretLine( ) = 3), P( sc, "the caret is back on line 3" ) )
    t.Check( (mw2.Pane1 <> 0) andalso mw2.Pane1->Main.HasBreakpoint( 1 ) andalso (mw2.Pane1->Main.Breakpoints( ).Count( ) = 1), _
             P( sc, "the breakpoint on a.tiko line 2 restored" ) )
    t.Check( mw2.CurrentBuild = "Release", P( sc, "the build configuration restored" ) )
    t.Check( mw2.Recent.Count( ) = 2, P( sc, strings.Format( "the recent files restored ({})", mw2.Recent.Count( ) ) ) )
    dim as long wx, wy, ww, wh
    SDL_SyncWindow( tkForm_Host( mw2.form )->win )
    SDL_GetWindowSize( tkForm_Host( mw2.form )->win, @ww, @wh )
    SDL_GetWindowPosition( tkForm_Host( mw2.form )->win, @wx, @wy )
    t.Check( (ww = 720) andalso (wh = 520), P( sc, strings.Format( "the window's size restored: {}x{}", ww, wh ) ) )
    ' Wayland has no window positions; WSLg's X11 places a window as it likes (a check there passed
    ' at one scale and not the other): the place is asserted on Windows only
    if platform.CurrentOs( ) = platform.Os.Windows then
        t.Check( (wx = 140) andalso (wy = 130), P( sc, strings.Format( "and its place: {},{}", wx, wy ) ) )
    end if
    mw2.Destroy( )

    ' files named on the command line: RestoreSession( FALSE ) keeps the window's size and the
    ' recent list, and opens nothing of the last session (main.tiko then opens the named files)
    dim as mainwin.Window mw3
    mw3.ConfigDir = cfg
    mw3.Ask = @ScriptedAsk
    mw3.Pick = @ScriptedPick
    t.Check( mw3.Create( sc ), P( sc, "session: third window" ) )
    if mw3.form = 0 then exit sub
    mw3.Show( )
    mw3.RestoreSession( false )
    tkTest_PumpFor( tkForm_Host( mw3.form ), 100 )
    dim as long w3, h3
    SDL_GetWindowSize( tkForm_Host( mw3.form )->win, @w3, @h3 )
    t.Check( (mw3.Docs.Count( ) = 1) andalso mw3.Docs[0]->IsNew( ) andalso (mw3.Split = session.SplitMode.None), _
             P( sc, strings.Format( "named files instead: no buffer of the last session reopened ({})", mw3.Docs.Count( ) ) ) )
    t.Check( (mw3.Recent.Count( ) = 2) andalso (w3 = 720) andalso (h3 = 520), _
             P( sc, strings.Format( "but the recent files ({}) and the window's size ({}x{}) came back", mw3.Recent.Count( ), w3, h3 ) ) )
    mw3.OpenFile( pathB )
    t.Check( (mw3.Docs.Count( ) = 1) andalso (lcase( mw3.ActivePath( ) ) = lcase( pathB )), P( sc, "and the named file opens alone" ) )
    mw3.Destroy( )
end sub

' ================================================================ P3: find, go to line, bookmarks, typing

private sub StripKey( byref mw as mainwin.Window, byval key as long, byval sc as long, byval mods as long = 0 )
    Chord( tkForm_Host( mw.form ), key, sc, mods )
end sub

public sub FindPass( byref t as Tally, byval sc as single )
    dim as mainwin.Window mw
    mw.ConfigDir = FreshConfig( )
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    t.Check( mw.Create( sc ), P( sc, "find: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_PumpFor( h, 150 )
    mw.NewBlank( )                   ' out of the start panel: a buffer to type in
    dim as ustring nl = chr( 10 )
    mw.View( ).SetLineEnding( docencoding.LineEnd.Lf, false )
    mw.View( ).SetText( "alpha beta alpha" & nl & "ALPHA gamma" & nl & "alpha" & nl )
    dim as long cx = h->root->cw, cy = h->root->ch
    dim as long rowH = tkForm_Scale( mw.form, findstrip.ROW_CY ), sh = mw.StatusHeight( ), top = mw.MenuHeight( ) + mw.TabsHeight( )

    ' ---- Ctrl+F: the strip above the status line, typing finds as it goes
    Chord( h, SDLK_F, SDL_SCANCODE_F, KMOD_PRIMARY )
    t.Check( mw.Finder.isOpen andalso (mw.Finder.Mode = findstrip.StripMode.Find), P( sc, "Ctrl+F opened the find strip" ) )
    t.Check( tkWidget_IsVisible( mw.status ) andalso (mw.status->y = cy - sh) andalso (mw.status->ch = sh), _
             P( sc, strings.Format( "the status line stays at the bottom: {} {}", mw.status->y, mw.status->ch ) ) )
    dim as TK_WIDGET ptr fr = mw.Finder.frame
    t.Check( (fr->y = cy - sh - rowH) andalso (fr->ch = rowH) andalso (fr->cw = cx), P( sc, strings.Format( "one row above it: {} {}x{}", fr->y, fr->cw, fr->ch ) ) )
    t.Check( PaneCH( mw, mw.View( ).Widget( ) ) = cy - sh - rowH - top, P( sc, "the view ends above the strip" ) )
    t.Check( StripToolsMatch( mw ), P( sc, "the buttons share the strip's back colour" ) )
    t.Check( StripGlyphsDrawn( mw ), P( sc, "prev / next / close are in the toolbar's glyph font" ) )
    t.Check( tkHost_GetFocus( h ) = mw.Finder.findBox, P( sc, "the find box has the focus" ) )
    tkTest_PushText( h, "alpha" )
    tkTest_PumpFor( h, 40 )
    t.Check( mw.Finder.status = "1 of 4", P( sc, "typing found the first of four: " & mw.Finder.status ) )
    t.Check( mw.View( ).SelectedText( ) = "alpha", P( sc, "and selected it" ) )
    StripKey( mw, SDLK_RETURN, SDL_SCANCODE_RETURN )
    t.Check( mw.Finder.status = "2 of 4", P( sc, "Enter: the next: " & mw.Finder.status ) )
    t.Check( mw.Finder.findBox <> 0 andalso (tkTextBox_GetText( mw.Finder.findBox ) = "alpha"), P( sc, "Enter typed nothing into the box" ) )
    StripKey( mw, SDLK_F3, SDL_SCANCODE_F3 )
    t.Check( mw.Finder.status = "3 of 4", P( sc, "F3: the next: " & mw.Finder.status ) )
    StripKey( mw, SDLK_RETURN, SDL_SCANCODE_RETURN, SDL_KMOD_SHIFT )
    t.Check( mw.Finder.status = "2 of 4", P( sc, "Shift+Enter: the previous: " & mw.Finder.status ) )
    dim as editor.FindOptions o = mw.Finder.Options( )
    o.MatchCase = true
    mw.Finder.SetOptions( o )
    mw.OnFind( findstrip.FindAction.Changed )
    t.Check( instr( mw.Finder.status, "of 3" ) > 0, P( sc, "Match Case: three: " & mw.Finder.status ) )
    o.MatchCase = false
    mw.Finder.SetOptions( o )
    mw.Finder.SetPhrase( "zzz" )                      ' a setter is silent: say what typing would
    mw.OnFind( findstrip.FindAction.Changed )
    t.Check( mw.Finder.status = "No matches", P( sc, "no match says so: " & mw.Finder.status ) )
    mw.Finder.SetPhrase( "alpha" )
    StripKey( mw, SDLK_ESCAPE, SDL_SCANCODE_ESCAPE )
    t.Check( (mw.Finder.isOpen = false) andalso tkWidget_IsVisible( mw.status ), P( sc, "Esc: the strip is gone, the status line stays" ) )
    t.Check( tkHost_GetFocus( h ) = mw.View( ).Widget( ), P( sc, "and the view has the focus" ) )
    mw.View( ).SetPosition( mw.View( ).Length( ) )
    Chord( h, SDLK_F3, SDL_SCANCODE_F3, 0 )
    t.Check( (mw.View( ).SelectedText( ) = "alpha") andalso (mw.View( ).SelectionStart( ) = 0), _
             P( sc, "F3 with the strip closed finds the last phrase, wrapping to the top" ) )

    ' ---- Ctrl+H: two rows; Replace one, Replace All in one undo step
    mw.View( ).SetPosition( 0 )
    Chord( h, SDLK_H, SDL_SCANCODE_H, KMOD_PRIMARY )
    t.Check( mw.Finder.isOpen andalso (mw.Finder.Mode = findstrip.StripMode.Replace) andalso (fr->ch = rowH * 2) _
             andalso (fr->y = cy - sh - rowH * 2), P( sc, strings.Format( "Ctrl+H: two rows ({} at {})", fr->ch, fr->y ) ) )
    mw.Finder.SetReplacement( "omega" )
    mw.Finder.SetPhrase( "alpha" )
    mw.OnFind( findstrip.FindAction.Changed )         ' the first match selected, as typing does
    Chord( h, SDLK_R, SDL_SCANCODE_R, KMOD_PRIMARY )
    t.Check( left( mw.View( ).Text( ), 5 ) = "omega", P( sc, "Ctrl+R replaced one: " & left( mw.View( ).Text( ), 16 ) ) )
    StripKey( mw, SDLK_RETURN, SDL_SCANCODE_RETURN, KMOD_PRIMARY or SDL_KMOD_ALT )
    t.Check( mw.Finder.status = "3 replaced", P( sc, "Ctrl+Alt+Enter replaced the rest: " & mw.Finder.status ) )
    t.Check( mw.View( ).Text( ) = "omega beta omega" & nl & "omega gamma" & nl & "omega" & nl, P( sc, "every alpha is omega" ) )
    mw.View( ).Undo( )
    t.Check( mw.View( ).Text( ) = "omega beta alpha" & nl & "ALPHA gamma" & nl & "alpha" & nl, P( sc, "one Undo takes Replace All back" ) )
    StripKey( mw, SDLK_ESCAPE, SDL_SCANCODE_ESCAPE )

    ' ---- "Sel": a multi-line selection limits Replace All to it
    mw.View( ).SetText( "x x" & nl & "x x" & nl & "x x" & nl )
    mw.View( ).SetSelection( 0, 8 )                                    ' lines 1-2
    Chord( h, SDLK_H, SDL_SCANCODE_H, KMOD_PRIMARY )
    t.Check( mw.Finder.Options( ).InSelection, P( sc, "a multi-line selection turns Sel on" ) )
    mw.Finder.SetPhrase( "x" )
    mw.Finder.SetReplacement( "yy" )
    tkTest_PumpFor( h, 30 )
    mw.OnFind( findstrip.FindAction.ReplaceEvery )
    t.Check( mw.View( ).Text( ) = "yy yy" & nl & "yy yy" & nl & "x x" & nl, P( sc, "only inside the selection: " & mw.View( ).Text( ) ) )
    StripKey( mw, SDLK_ESCAPE, SDL_SCANCODE_ESCAPE )

    ' ---- Ctrl+G: go to line, and to line:column
    mw.View( ).SetText( "one" & nl & "two" & nl & "three" & nl & "four" & nl )
    Chord( h, SDLK_G, SDL_SCANCODE_G, KMOD_PRIMARY )
    t.Check( mw.Finder.isOpen andalso (mw.Finder.Mode = findstrip.StripMode.GoTo) andalso (fr->ch = rowH), P( sc, "Ctrl+G: one row, Go to Line" ) )
    t.Check( mw.Finder.status = "1 - 5", P( sc, "it says the range: " & mw.Finder.status ) )
    tkTest_PushText( h, "9" )
    tkTest_PumpFor( h, 30 )
    StripKey( mw, SDLK_RETURN, SDL_SCANCODE_RETURN )
    t.Check( mw.Finder.isOpen andalso (instr( mw.Finder.status, "no line" ) > 0), P( sc, "a line past the end is refused: " & mw.Finder.status ) )
    mw.Finder.SetPhrase( "3:3" )
    StripKey( mw, SDLK_RETURN, SDL_SCANCODE_RETURN )
    t.Check( (mw.Finder.isOpen = false) andalso (mw.View( ).CaretLine( ) = 3) andalso (mw.View( ).CaretColumn( ) = 3), _
             P( sc, strings.Format( "3:3 went to Ln {}, Col {}", mw.View( ).CaretLine( ), mw.View( ).CaretColumn( ) ) ) )

    ' ---- bookmarks: toggle, next, previous, the list, clear
    mw.View( ).GoToLine( 0 )
    Chord( h, SDLK_F2, SDL_SCANCODE_F2, KMOD_PRIMARY )
    mw.View( ).GoToLine( 3 )
    Chord( h, SDLK_F2, SDL_SCANCODE_F2, KMOD_PRIMARY )
    t.Check( mw.View( ).Bookmarks( ).Count( ) = 2, P( sc, "Ctrl+F2 twice: two bookmarks" ) )
    mw.View( ).GoToLine( 1 )
    Chord( h, SDLK_F2, SDL_SCANCODE_F2, 0 )
    t.Check( mw.View( ).CaretLine( ) = 4, P( sc, strings.Format( "F2: the next bookmark, line {}", mw.View( ).CaretLine( ) ) ) )
    Chord( h, SDLK_F2, SDL_SCANCODE_F2, 0 )
    t.Check( mw.View( ).CaretLine( ) = 1, P( sc, "F2 again wraps to line 1" ) )
    Chord( h, SDLK_F2, SDL_SCANCODE_F2, SDL_KMOD_SHIFT )
    t.Check( mw.View( ).CaretLine( ) = 4, P( sc, "Shift+F2: the previous" ) )
    Chord( h, SDLK_F4, SDL_SCANCODE_F4, SDL_KMOD_SHIFT )
    t.Check( mw.Chooser.IsOpen( ) andalso (mw.Choosing = mainwin.PickKind.Bookmarks) andalso (mw.Chooser.ShownCount( ) = 2), _
             P( sc, strings.Format( "Shift+F4 lists them ({})", mw.Chooser.ShownCount( ) ) ) )
    PopKey( mw, SDLK_RETURN, SDL_SCANCODE_RETURN )
    t.Check( mw.View( ).CaretLine( ) = 1, P( sc, "picking one goes there" ) )
    Chord( h, SDLK_F2, SDL_SCANCODE_F2, KMOD_PRIMARY or SDL_KMOD_SHIFT )
    t.Check( mw.View( ).Bookmarks( ).Count( ) = 0, P( sc, "Ctrl+Shift+F2 cleared them" ) )

    ' ---- typing: Enter indents, and closes the block it opened
    mw.View( ).SetText( "" )
    tkTest_PushText( h, "sub f( )" )
    tkTest_PumpFor( h, 30 )
    Chord( h, SDLK_RETURN, SDL_SCANCODE_RETURN, 0 )
    dim as ustring tx = mw.View( ).Text( )
    t.Check( tx = "sub f( )" & mw.View( ).EolText( ) & "    " & mw.View( ).EolText( ) & "end sub", _
             P( sc, "Enter after 'sub f( )': indented, 'end sub' below: [" & tx & "]" ) )
    t.Check( (mw.View( ).CaretLine( ) = 2) andalso (mw.View( ).CaretColumn( ) = 5), P( sc, "the caret on the indented line" ) )

    ' ---- the Edit keys belong to the strip's box while it has the focus
    Chord( h, SDLK_F, SDL_SCANCODE_F, KMOD_PRIMARY )
    tkTest_PushText( h, "abc" )
    tkTest_PumpFor( h, 30 )
    dim as long lines0 = mw.View( ).LineCount( )
    Chord( h, SDLK_D, SDL_SCANCODE_D, KMOD_PRIMARY )
    t.Check( mw.View( ).LineCount( ) = lines0, P( sc, "Ctrl+D in the find box did not duplicate an editor line" ) )
    StripKey( mw, SDLK_ESCAPE, SDL_SCANCODE_ESCAPE )

    ' ---- F3 on a selection looks for the selection, not for the last phrase
    dim as editor.FindOptions plain
    mw.Finder.SetOptions( plain )
    mw.Finder.SetPhrase( "gamma" )
    mw.View( ).SetText( "one two one two" & nl )
    mw.View( ).Focus( )
    mw.View( ).SetSelection( 4, 7 )
    Chord( h, SDLK_F3, SDL_SCANCODE_F3, 0 )
    t.Check( (mw.View( ).SelectionStart( ) = 12) andalso (mw.View( ).SelectedText( ) = "two"), _
             P( sc, strings.Format( "F3 on 'two' found the next 'two' at {}", mw.View( ).SelectionStart( ) ) ) )
    t.Check( mw.Finder.Phrase( ) = "two", P( sc, "and it is the phrase now: " & mw.Finder.Phrase( ) ) )

    mw.View( ).SetSavePoint( )
    mw.Destroy( )
end sub

' ================================================================ P4: projects and builds

dim shared as Array( of ustring ) gLaunched
dim shared as string gTerminalEnv           ' putenv keeps the pointer: it must outlive the call
dim shared as string gPathEnv, gPathKeep

private function ScriptedLaunch( byref argv as const Array( of ustring ), byref workDir as const ustring ) as boolean
    dim as ustring s
    for i as long = 0 to argv.Count( ) - 1
        if i then s &= "|"
        s &= argv[i]
    next
    gLaunched.Push( s )
    return true
end function

' The tiko the test builds with: $TKEDIT_TIKO, else the workspace's toolchain.
private function TestCompiler( ) as ustring
    dim as ustring tk = environ( "TKEDIT_TIKO" )
    if len( tk ) andalso fs.IsFile( tk ) then return tk
    if platform.CurrentOs( ) = platform.Os.Windows then
        tk = "C:\dev\tiko-lang\toolchains\tiko-windows\tiko.exe"
    else
        tk = "/mnt/c/dev/tiko-lang/toolchains/tiko-linux/bin/tiko"
    end if
    if fs.IsFile( tk ) then return tk
    return ""
end function

private function WaitBuild( byref mw as mainwin.Window ) as boolean
    dim as double t0 = timer
    do while mw.IsBuilding( )
        tkApp_Pump( )
        SDL_Delay( 20 )
        if timer - t0 > 240 then return false
    loop
    return true
end function

' ================================================================ the Debug tab (D3): layout, tabs, lists

' A tab of a tab strip, clicked where it is drawn.
' The mouse rests on tab idx long enough for a tooltip (500 ms); TRUE when one is showing.
private function TabTipShows( byval h as TK_HOST ptr, byval bar as TK_WIDGET ptr, byval idx as long ) as boolean
    dim as TKRECT rc, a
    tkTabBar_GetTabRect( bar, idx, rc )
    tkWidget_AbsRect( bar, a )
    tkTest_PushMotion( h, a.left + (rc.left + rc.right) / 2 - 3, a.top + (rc.top + rc.bottom) / 2 )
    tkTest_PumpFor( h, 30 )
    tkTest_PushMotion( h, a.left + (rc.left + rc.right) / 2, a.top + (rc.top + rc.bottom) / 2 )
    tkTest_PumpFor( h, 900 )
    dim as TK_TIP ptr tip = tkTabBar_GetTooltipHandle( bar )
    dim as boolean shows = (tip <> 0) andalso tkTooltip_IsVisible( tip )
    tkTest_PushMotion( h, 2, 2 )                    ' away again
    tkTest_PumpFor( h, 30 )
    return shows
end function

private sub ClickStripTab( byval h as TK_HOST ptr, byval bar as TK_WIDGET ptr, byval idx as long )
    dim as TKRECT rc, a
    tkTabBar_GetTabRect( bar, idx, rc )
    tkWidget_AbsRect( bar, a )
    tkTest_Click( h, a.left + (rc.left + rc.right) / 2, a.top + (rc.top + rc.bottom) / 2 )
    tkTest_PumpFor( h, 30 )
end sub

public sub DebugTabPass( byref t as Tally, byval sc as single )
    dim as ustring cfg = FreshConfig( )
    dim as ustring dir_ = fs.PathJoin( Files( ), "dbgtab" )
    fs.CreateDirAll( dir_ )
    dim as ustring nl = chr( 10 )
    dim as ustring fileA = fs.PathJoin( dir_, "a.tiko" )
    fs.WriteAllText( fileA, "dim as long n" & nl & "n = 1" & nl & "    n += 2" & nl & "print n" & nl )
    dim as mainwin.Window mw
    mw.ConfigDir = cfg
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    t.Check( mw.Create( sc ), P( sc, "debug tab: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_PumpFor( h, 100 )
    mw.OpenFile( fileA )
    dim as debugpane.Pane ptr dp = @mw.Out.Debug

    ' ---- the tab, its layout: buttons, the two sides, their tab strips along the bottom
    mw.ShowDebugTab( )
    tkTest_PumpFor( h, 60 )
    t.Check( mw.OutputShown andalso (mw.Out.current = outputpane.OutputTab.Debug) andalso tkWidget_IsVisible( dp->frame ) andalso _
             (tkTabBar_GetCount( mw.Out.tabs ) = 4) andalso (tkTabBar_GetText( mw.Out.tabs, 3 ) = "Debug"), _
             P( sc, "debug tab: the output pane's fourth tab, shown" ) )
    dim as long th = tkHost_Scale( h, debugpane.TOOL_CY )
    dim as long tb = tkHost_Scale( h, debugpane.TABS_CY )
    dim as TK_WIDGET ptr loc = dp->lists( debugpane.DebugList.Locals ), stk = dp->lists( debugpane.DebugList.CallStack )
    t.Check( (dp->tools->y = 0) andalso (dp->tools->ch = th) andalso (loc->y = th) andalso (loc->x = 0), _
             P( sc, strings.Format( "debug tab: buttons on top, the lists right under them, no status line ({}, {})", loc->x, loc->y ) ) )
    t.Check( (dp->ltabs->y = loc->y + loc->ch) andalso (dp->ltabs->y + dp->ltabs->ch = dp->frame->ch) andalso (dp->ltabs->ch = tb) andalso _
             (dp->rtabs->y = dp->ltabs->y), P( sc, strings.Format( "debug tab: both tab strips along the bottom ({}, h {})", dp->ltabs->y, dp->ltabs->ch ) ) )
    t.Check( (dp->split->x = loc->cw) andalso (stk->x = dp->split->x + dp->split->cw) andalso (stk->x + stk->cw = dp->frame->cw) andalso _
             (stk->y = loc->y) andalso (stk->ch = loc->ch), P( sc, strings.Format( "debug tab: the splitter between, at x {}", dp->split->x ) ) )
    t.Check( (tkTabBar_GetText( dp->ltabs, 0 ) = "Locals") andalso (tkTabBar_GetText( dp->ltabs, 2 ) = "Watch") andalso _
             (tkTabBar_GetText( dp->rtabs, 0 ) = "Call Stack") andalso (tkTabBar_GetText( dp->rtabs, 1 ) = "Breakpoints"), _
             P( sc, "debug tab: Locals | Globals | Watch, Call Stack | Breakpoints" ) )
    t.Check( (tkToolbar_GetCount( dp->tools ) = 9) andalso (tkToolbar_GetText( dp->tools, 0 ) = "Continue") andalso _
             (tkToolbar_GetEnabled( dp->tools, 0 )) andalso (tkToolbar_GetEnabled( dp->tools, 4 ) = false), _
             P( sc, "debug tab: seven buttons; no session: Continue (starts) works, Step greyed" ) )
    t.Check( (tkToolbar_GetTooltipText( dp->tools, 0 ) = "F6") andalso (tkToolbar_GetTooltipText( dp->tools, 4 ) = "F11") andalso _
             (len( mw.ShortcutText( Cmd.RunToCursor ) ) > 0) andalso (tkToolbar_GetTooltipText( dp->tools, 8 ) = mw.ShortcutText( Cmd.RunToCursor )), _
             P( sc, "debug tab: each button's tooltip is its key: " & tkToolbar_GetTooltipText( dp->tools, 0 ) & ", " & tkToolbar_GetTooltipText( dp->tools, 8 ) ) )
    dim as ustring kt = fs.ReadAllText( mw.KeysFile( ) ).ValueOr( "" )
    t.Check( instr( kt, "StepInto = 'F11'" ) > 0, P( sc, "debug tab: keybindings.toml binds StepInto" ) )
    fs.WriteAtomic( mw.KeysFile( ), strings.Replace( kt, "StepInto = 'F11'", "StepInto = 'Primary+Alt+F11'" ) )
    mw.ReloadKeys( )
    t.Check( (mw.ShortcutText( Cmd.StepInto ) <> "F11") andalso (tkToolbar_GetTooltipText( dp->tools, 4 ) = mw.ShortcutText( Cmd.StepInto )), _
             P( sc, "debug tab: a key moved in keybindings.toml moves the tooltip: " & tkToolbar_GetTooltipText( dp->tools, 4 ) ) )
    fs.WriteAtomic( mw.KeysFile( ), kt )
    mw.ReloadKeys( )
    t.Check( (TabTipShows( h, mw.Out.tabs, 3 ) = false) andalso (TabTipShows( h, dp->ltabs, 1 ) = false) andalso (TabTipShows( h, dp->rtabs, 1 ) = false), _
             P( sc, "debug tab: no tooltip on the Output pane's tabs, nor on the Debug tab's" ) )

    ' ---- a click on a bottom tab shows its list; the side buttons are the shown tab's
    ClickStripTab( h, dp->ltabs, 2 )
    t.Check( (dp->leftTab = debugpane.DebugList.Watch) andalso tkWidget_IsVisible( dp->lists( 2 ) ) andalso _
             (tkWidget_IsVisible( loc ) = false) andalso tkWidget_IsVisible( dp->ltools ), P( sc, "debug tab: a click on Watch shows it, with its + and delete" ) )
    ClickStripTab( h, dp->rtabs, 1 )
    t.Check( (dp->rightTab = debugpane.DebugList.Breakpoints) andalso tkWidget_IsVisible( dp->lists( 4 ) ) andalso _
             tkWidget_IsVisible( dp->rtools ) andalso (tkWidget_IsVisible( stk ) = false), P( sc, "debug tab: a click on Breakpoints shows it" ) )

    ' ---- the Breakpoints tab lists them, follows the lines, removes one or all
    mw.View( ).GoToLine( 1 )
    Chord( h, SDLK_F9, SDL_SCANCODE_F9, 0 )
    mw.View( ).GoToLine( 2 )
    Chord( h, SDLK_F9, SDL_SCANCODE_F9, 0 )
    dim as TK_WIDGET ptr bl = dp->lists( debugpane.DebugList.Breakpoints )
    t.Check( (dp->Bps.Count( ) = 2) andalso (tkListTree_GetCount( bl ) = 2) andalso (dp->Bps[0].Line = 2) andalso (dp->Bps[1].Text = "n += 2") andalso _
             (tkListTree_GetText( bl, 0 ) = "a.tiko"), P( sc, strings.Format( "breakpoints tab: two rows, a.tiko 2 and 3 ({})", tkListTree_GetCount( bl ) ) ) )
    t.Check( RowsDrawn( h, bl ), P( sc, "breakpoints tab: drawn" ) )
    mw.View( ).GoToLine( 0 )
    mw.View( ).InsertLineAfter( 0, "' a new line" )
    t.Check( (dp->Bps.Count( ) = 2) andalso (dp->Bps[0].Line = 3) andalso (dp->Bps[1].Line = 4), _
             P( sc, strings.Format( "breakpoints tab: a line inserted above, they follow ({}, {})", dp->Bps[0].Line, dp->Bps[1].Line ) ) )
    tkListTree_SetCurSel( bl, 0 )
    dp->SyncButtons( )
    t.Check( tkToolbar_Click( dp->rtools, 0 ) andalso (dp->Bps.Count( ) = 1) andalso (mw.View( ).HasBreakpoint( 2 ) = false) andalso _
             mw.View( ).HasBreakpoint( 3 ), P( sc, "breakpoints tab: remove takes the selected one, from the editor too" ) )
    t.Check( tkToolbar_Click( dp->rtools, 1 ) andalso (dp->Bps.Count( ) = 0) andalso (mw.View( ).Breakpoints( ).Count( ) = 0), _
             P( sc, "breakpoints tab: remove all" ) )
    t.Check( tkToolbar_GetEnabled( dp->rtools, 1 ) = false, P( sc, "breakpoints tab: nothing left: remove all greyed" ) )

    ' ---- Watch: + adds a row being typed in; an expression; the delete button
    tkToolbar_Click( dp->ltools, 0 )
    dim as TK_WIDGET ptr wl = dp->lists( debugpane.DebugList.Watch )
    t.Check( (dp->Watches.Count( ) = 1) andalso tkListTree_IsEditing( wl ), P( sc, "watch: + adds one, being typed in" ) )
    tkListTree_EndEdit( wl, false )
    dp->Watches[0] = "n"
    dp->FillWatch( )
    t.Check( (tkListTree_GetCount( wl ) = 1) andalso (tkListTree_GetText( wl, 0 ) = "n"), P( sc, "watch: the expression's row" ) )
    tkListTree_SetCurSel( wl, 0 )
    dp->SyncButtons( )
    t.Check( tkToolbar_Click( dp->ltools, 1 ) andalso (dp->Watches.Count( ) = 0) andalso (tkListTree_GetCount( wl ) = 0), _
             P( sc, "watch: delete takes it" ) )

    ' ---- the pane's height: its top edge drags; session.toml keeps it
    dim as long y0 = mw.Out.frame->y, h0 = mw.Out.frame->ch
    dim as single bx = tkTest_CX( mw.outBar ), by = tkTest_CY( mw.outBar )
    tkTest_PushButton( h, true, bx, by )
    tkTest_PushMotion( h, bx, by - 60 )
    tkTest_PushMotion( h, bx, by - 120 )
    tkTest_PushButton( h, false, bx, by - 120 )
    tkTest_PumpFor( h, 30 )
    t.Check( (mw.Out.frame->ch > h0 + 100) andalso (mw.Out.frame->y < y0 - 100) andalso (dp->frame->ch = mw.Out.frame->ch - (dp->frame->y)), _
             P( sc, strings.Format( "output pane: its top edge dragged up 120: {} -> {}", h0, mw.Out.frame->ch ) ) )
    mw.SaveSession( )
    dim as ustring sess = fs.ReadAllText( mw.SessionFile( ) ).ValueOr( "" )
    t.Check( instr( sess, "output_height = " & mw.OutCY ) > 0, P( sc, strings.Format( "output pane: session.toml keeps output_height = {}", mw.OutCY ) ) )

    for each d as DocRef in mw.Docs
        d->Main.SetSavePoint( )
    next
    mw.Destroy( )
end sub

' ================================================================ the debugger (D2): a real session

dim shared as string gDebugTermEnv           ' putenv keeps the pointer

' Pumps until the session is stopped (wantStop) or over; FALSE on a 60 s timeout.
private function WaitDebug( byref mw as mainwin.Window, byval wantStop as boolean ) as boolean
    dim as double t0 = timer
    do
        tkApp_Pump( )
        SDL_Delay( 20 )
        if wantStop andalso mw.DebugStopped( ) then return true
        if mw.DebugActive( ) = false then return wantStop = false
        if timer - t0 > 60 then return false
    loop
end function

' Start Debugging builds with -g and stops at a breakpoint; Step Over steps; Stop ends it. Needs
' a tiko ($TKEDIT_TIKO) and lldb-dap; macOS only with TKEDIT_SELFTEST_DEBUG=1 (Developer Mode).
public sub DebugPass( byref t as Tally, byval sc as single )
    dim as ustring tk = TestCompiler( )
    if len( tk ) = 0 then exit sub                        ' BuildPass reports a missing compiler
    if Engine_AdapterPath( ) = "" then
        print "debug: no lldb-dap: the session checks are skipped"
        exit sub
    end if
    if (platform.CurrentOs( ) = platform.Os.MacOS) andalso (environ( "TKEDIT_SELFTEST_DEBUG" ) <> "1") then
        print "debug: macOS without TKEDIT_SELFTEST_DEBUG=1: the session checks are skipped"
        exit sub
    end if
    dim as ustring cfg = FreshConfig( )
    dim as ustring dir_ = fs.PathJoin( Files( ), "dbg" )
    fs.CreateDirAll( dir_ )
    dim as ustring nl = chr( 10 )
    dim as ustring mainF = fs.PathJoin( dir_, "dbg.tiko" )
    fs.WriteAllText( mainF, "dim as long total = 0" & nl & "for i as long = 1 to 3" & nl & "    total += i" & nl & _
                            "next" & nl & "print total" & nl )
    if platform.CurrentOs( ) <> platform.Os.Windows then
        ' a terminal that is a pty and nothing else (WSL has no terminal emulator): script(1)
        dim as ustring fake = fs.PathJoin( cfg, "faketerm" )
        fs.WriteAllText( fake, "#!/bin/sh" & nl & "shift" & nl & "script -qfc ""$*"" /dev/null < /dev/null > /dev/null 2>&1 &" & nl )
        dim as process.Command c = process.Command( "/bin/chmod" )
        c.Arg( "+x" ).Arg( fake )
        dim as process.Child ch
        if ch.Spawn( c ).IsOk( ) then ch.Wait( )
        gDebugTermEnv = "TERMINAL=" & fake
        setenviron gDebugTermEnv
    end if

    dim as mainwin.Window mw
    mw.ConfigDir = cfg
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    t.Check( mw.Create( sc ), P( sc, "debug: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_PumpFor( h, 100 )
    mw.Prefs.Tiko = tk
    mw.OpenFile( mainF )
    mw.View( ).ToggleBreakpoint( 2 )                       ' "    total += i"

    Chord( h, SDLK_F6, SDL_SCANCODE_F6, 0 )
    t.Check( WaitBuild( mw ) andalso mw.BuildSucceeded, P( sc, "debug: F6 built the program (-g)" ) )
    t.Check( instr( " " & mw.BuildFlags & " ", " -g " ) > 0, P( sc, "debug: with -g: " & mw.BuildFlags ) )
    dim as boolean stopped = WaitDebug( mw, true )
    t.Check( stopped, P( sc, "debug: the session stopped: " & mw.DbgStatus ) )
    if stopped then
        t.Check( instr( mw.DbgStatus, "breakpoint" ) > 0 andalso (instr( mw.DbgStatus, "dbg.tiko:3" ) > 0), _
                 P( sc, "debug: at the breakpoint, the entry stop skipped: " & mw.DbgStatus ) )
        t.Check( mw.View( ).ExecLine( ) = 2, P( sc, strings.Format( "debug: the stop line marked ({})", mw.View( ).ExecLine( ) ) ) )
        t.Check( mw.CanRun( Cmd.StepOver ) andalso (mw.CanRun( Cmd.DebugBreak ) = false) andalso mw.CanRun( Cmd.StopDebugging ), _
                 P( sc, "debug: stopped: Step works, Break greyed" ) )
        ' ---- the Debug tab (D3): it showed itself; the stack, the locals, a watch
        dim as debugpane.Pane ptr dp = @mw.Out.Debug
        dim as TK_WIDGET ptr stk = dp->lists( debugpane.DebugList.CallStack ), loc = dp->lists( debugpane.DebugList.Locals )
        t.Check( mw.OutputShown andalso (mw.Out.current = outputpane.OutputTab.Debug), _
                 P( sc, "debug: the Debug tab shows itself" ) )
        t.Check( (tkListTree_GetCount( stk ) >= 1) andalso (lcase( tkListTree_GetText( stk, 0 ) ) = "main") andalso _
                 (tkListTree_GetCellText( stk, 0, 1 ) = "3"), P( sc, strings.Format( "debug: the call stack: main, line 3 ({})", tkListTree_GetCount( stk ) ) ) )
        dim as long totalRow = -1
        for r as long = 0 to tkListTree_GetCount( loc ) - 1
            if lcase( tkListTree_GetText( loc, r ) ) = "total" then totalRow = r
        next
        t.Check( (totalRow >= 0) andalso (tkListTree_GetCellText( loc, totalRow, 1 ) = "0") andalso (tkListTree_GetCellText( loc, totalRow, 2 ) = "long"), _
                 P( sc, "debug: Locals: total = 0, long" ) )
        dp->AddWatch( "TOTAL + 0" )
        dp->AddWatch( "Total" )
        dim as TK_WIDGET ptr wl = dp->lists( debugpane.DebugList.Watch )
        t.Check( (tkListTree_GetCount( wl ) = 2) andalso (tkListTree_GetCellText( wl, 1, 1 ) = "0") andalso _
                 (tkListTree_GetCellText( wl, 0, 1 ) = "<not in scope>"), _
                 P( sc, strings.Format( "debug: Watch: 'Total' is total (case-blind) = 0; an expression lldb's path cannot be is not in scope ({})", tkListTree_GetCellText( wl, 1, 1 ) ) ) )
        Chord( h, SDLK_F10, SDL_SCANCODE_F10, 0 )
        ' the loop's increment is the 'for' line's code: line 2 (or 'next', line 4)
        t.Check( WaitDebug( mw, true ) andalso ((mw.View( ).ExecLine( ) = 1) orelse (mw.View( ).ExecLine( ) = 3)), _
                 P( sc, strings.Format( "debug: F10 stepped over, to line {}", mw.View( ).ExecLine( ) + 1 ) ) )
        totalRow = -1
        for r as long = 0 to tkListTree_GetCount( loc ) - 1
            if lcase( tkListTree_GetText( loc, r ) ) = "total" then totalRow = r
        next
        dim as long k = -1
        if totalRow >= 0 then k = tkListTree_GetItemData( loc, totalRow )
        t.Check( (k >= 0) andalso (tkListTree_GetCellText( loc, totalRow, 1 ) = "1") andalso dp->rows[k].changed, _
                 P( sc, "debug: after the step total = 1, marked changed" ) )
        t.Check( tkListTree_GetCellText( wl, 1, 1 ) = "1", P( sc, "debug: and the watch follows" ) )
        Chord( h, SDLK_F6, SDL_SCANCODE_F6, SDL_KMOD_SHIFT )
        t.Check( WaitDebug( mw, false ), P( sc, "debug: Shift+F6 ended the session: " & mw.DbgStatus ) )
        t.Check( mw.View( ).ExecLine( ) = -1, P( sc, "debug: and the stop line is gone" ) )
        t.Check( (tkListTree_GetCount( stk ) = 0) andalso (tkListTree_GetCount( loc ) = 0) andalso (tkListTree_GetCount( wl ) = 2), _
                 P( sc, "debug: the session over: no stack, no locals, the watches stay" ) )
    end if
    if mw.DebugActive( ) then mw.Execute( Cmd.StopDebugging ) : WaitDebug( mw, false )
    for each d as DocRef in mw.Docs
        d->Main.SetSavePoint( )
    next
    mw.Destroy( )
end sub

' ================================================================ the debugger (D4): trees, sort, data tips

' The first row of a list at a level whose first cell is text, case-blind; -1 = none.
private function FindRow( byval l as TK_WIDGET ptr, byref text_ as const ustring, byval level as long = 0 ) as long
    for r as long = 0 to tkListTree_GetCount( l ) - 1
        if (tkListTree_GetLevel( l, r ) = level) andalso (lcase( tkListTree_GetText( l, r ) ) = lcase( text_ )) then return r
    next
    return -1
end function

' A row expanded as a person does it: selected, then Right.
private sub ExpandByKey( byval h as TK_HOST ptr, byval l as TK_WIDGET ptr, byval row as long )
    tkListTree_SetCurSel( l, row )
    tkHost_SetFocus( h, l )
    Chord( h, SDLK_RIGHT, SDL_SCANCODE_RIGHT, 0 )
end sub

' The top-level rows' first cells, joined by spaces.
private function TopNames( byval l as TK_WIDGET ptr ) as ustring
    dim as ustring s
    for r as long = 0 to tkListTree_GetCount( l ) - 1
        if tkListTree_GetLevel( l, r ) = 0 then s &= iif( len( s ), " ", "" ) & lcase( tkListTree_GetText( l, r ) )
    next
    return s
end function

public sub DebugVarsPass( byref t as Tally, byval sc as single )
    dim as ustring tk = TestCompiler( )
    if (len( tk ) = 0) orelse (Engine_AdapterPath( ) = "") then exit sub     ' DebugPass says why
    if (platform.CurrentOs( ) = platform.Os.MacOS) andalso (environ( "TKEDIT_SELFTEST_DEBUG" ) <> "1") then exit sub
    dim as ustring cfg = FreshConfig( )
    dim as ustring dir_ = fs.PathJoin( Files( ), "dbgvars" )
    fs.CreateDirAll( dir_ )
    dim as ustring nl = chr( 10 )
    dim as ustring mainF = fs.PathJoin( dir_, "vars.tiko" )
    fs.WriteAllText( mainF, "type Point" & nl & "    x as long" & nl & "    y as long" & nl & "end type" & nl & _
        "dim as Point pt" & nl & "dim as long big(0 to 249)" & nl & "dim as long zeta = 1, alpha = 2" & nl & _
        "for i as long = 0 to 2" & nl & "    pt.x += 1" & nl & "    big(i) = i + 5" & nl & "next" & nl & "print pt.x" & nl )
    if platform.CurrentOs( ) <> platform.Os.Windows then
        dim as ustring fake = fs.PathJoin( cfg, "faketerm" )
        fs.WriteAllText( fake, "#!/bin/sh" & nl & "shift" & nl & "script -qfc ""$*"" /dev/null < /dev/null > /dev/null 2>&1 &" & nl )
        dim as process.Command c = process.Command( "/bin/chmod" )
        c.Arg( "+x" ).Arg( fake )
        dim as process.Child ch
        if ch.Spawn( c ).IsOk( ) then ch.Wait( )
        gDebugTermEnv = "TERMINAL=" & fake
        setenviron gDebugTermEnv
    end if
    dim as mainwin.Window mw
    mw.ConfigDir = cfg
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    t.Check( mw.Create( sc ), P( sc, "debug vars: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_PumpFor( h, 100 )
    mw.Prefs.Tiko = tk
    mw.OpenFile( mainF )
    mw.View( ).ToggleBreakpoint( 8 )                       ' "    pt.x += 1"
    mw.Execute( Cmd.StartDebugging )
    dim as boolean stopped = WaitBuild( mw ) andalso WaitDebug( mw, true )
    t.Check( stopped, P( sc, "debug vars: stopped at the breakpoint: " & mw.DbgStatus ) )
    if stopped then
        dim as debugpane.Pane ptr dp = @mw.Out.Debug
        dim as TK_WIDGET ptr loc = dp->lists( debugpane.DebugList.Locals )
        dp->ShowLeft( debugpane.DebugList.Locals )
        tkTest_PumpFor( h, 30 )
        t.Check( TopNames( loc ) = "pt big zeta alpha i", P( sc, "debug vars: Locals in declaration order: " & TopNames( loc ) ) )

        ' ---- a UDT opens on Right: its fields
        dim as long rPt = FindRow( loc, "pt" )
        ExpandByKey( h, loc, rPt )
        t.Check( (FindRow( loc, "x", 1 ) = rPt + 1) andalso (FindRow( loc, "y", 1 ) = rPt + 2) andalso _
                 (tkListTree_GetCellText( loc, rPt + 1, 1 ) = "0"), P( sc, "debug vars: pt opened: x = 0, y" ) )
        ' ---- 250 elements: three index groups; one opens to its 100 elements
        dim as long rBig = FindRow( loc, "big" )
        ExpandByKey( h, loc, rBig )
        dim as long g0 = FindRow( loc, "[0 .. 99]", 1 ), g2 = FindRow( loc, "[200 .. 249]", 1 )
        t.Check( (g0 = rBig + 1) andalso (FindRow( loc, "[100 .. 199]", 1 ) > g0) andalso (g2 > g0), _
                 P( sc, "debug vars: big opened: [0 .. 99] [100 .. 199] [200 .. 249]" ) )
        ExpandByKey( h, loc, g0 )
        t.Check( (tkListTree_GetText( loc, g0 + 1 ) = "big(0)") andalso (tkListTree_GetText( loc, g0 + 100 ) = "big(99)") andalso _
                 (tkListTree_GetText( loc, g0 + 101 ) = "[100 .. 199]") andalso (tkListTree_GetCellText( loc, g0 + 1, 1 ) = "0"), _
                 P( sc, "debug vars: [0 .. 99] opened: big(0) = 0 .. big(99)" ) )

        ' ---- a data tip: the mouse rests on "pt.x" (on its "x")
        dim as long ln8 = 8
        dim as longint posX = tkCodeEdit_Send( mw.View( ).Widget( ), SCI_POSITIONFROMLINE, ln8 ) + 7
        mw.OnDwell( mw.View( ).Widget( ), posX, true )
        t.Check( (mw.DbgTip = "pt.x = 0   (long)") andalso mw.View( ).CallTipShown( ), P( sc, "debug vars: a data tip on pt.x: " & mw.DbgTip ) )
        mw.OnDwell( mw.View( ).Widget( ), -1, false )
        t.Check( (mw.DbgTip = "") andalso (mw.View( ).CallTipShown( ) = false), P( sc, "debug vars: and it goes when the mouse moves on" ) )

        ' ---- a step: what was open is open again, and what changed says so
        Chord( h, SDLK_F10, SDL_SCANCODE_F10, 0 )
        t.Check( WaitDebug( mw, true ), P( sc, "debug vars: F10 stepped" ) )
        rPt = FindRow( loc, "pt" )
        rBig = FindRow( loc, "big" )
        dim as long k = -1
        if FindRow( loc, "x", 1 ) = rPt + 1 then k = tkListTree_GetItemData( loc, rPt + 1 )
        t.Check( (k >= 0) andalso (tkListTree_GetCellText( loc, rPt + 1, 1 ) = "1") andalso dp->rows[k].changed andalso _
                 (dp->rows[tkListTree_GetItemData( loc, rPt + 2 )].changed = false), _
                 P( sc, "debug vars: after the step pt is still open, x = 1 marked changed, y not" ) )
        t.Check( (rBig > 0) andalso (tkListTree_GetText( loc, rBig + 2 ) = "big(0)") andalso (tkListTree_GetCellText( loc, rBig + 2, 1 ) = "0"), _
                 P( sc, "debug vars: and big's [0 .. 99] still open" ) )

        ' ---- a header click sorts by Name; again, the other way; the header says which
        dim as TK_WIDGET ptr hdr = tkListTree_GetHeader( loc )
        dim as TKRECT rc, a
        tkColumnHeader_GetColumnRect( hdr, 0, rc )
        tkWidget_AbsRect( hdr, a )
        tkTest_Click( h, a.left + (rc.left + rc.right) / 2, a.top + (rc.top + rc.bottom) / 2 )
        tkTest_PumpFor( h, 30 )
        t.Check( TopNames( loc ) = "alpha big i pt zeta", P( sc, "debug vars: a click on Name sorts: " & TopNames( loc ) ) )
        t.Check( instr( tkListTree_GetColumnText( loc, 0 ), wchr( &h2191 ) ) > 0, P( sc, "debug vars: the header marks it" ) )
        tkTest_Click( h, a.left + (rc.left + rc.right) / 2, a.top + (rc.top + rc.bottom) / 2 )
        tkTest_PumpFor( h, 30 )
        t.Check( TopNames( loc ) = "zeta pt i big alpha", P( sc, "debug vars: again: the other way: " & TopNames( loc ) ) )
        mw.Execute( Cmd.StopDebugging )
        WaitDebug( mw, false )
    end if
    if mw.DebugActive( ) then mw.Execute( Cmd.StopDebugging ) : WaitDebug( mw, false )
    ' ---- a breakpoint on the program's first statement is at main's own address: that stop is
    '      the breakpoint, not the entry stop a session skips
    mw.View( ).ToggleBreakpoint( 8 )
    mw.View( ).ToggleBreakpoint( 4 )                       ' "dim as Point pt"
    mw.Execute( Cmd.StartDebugging )
    stopped = WaitBuild( mw ) andalso WaitDebug( mw, true )
    t.Check( stopped andalso (mw.View( ).ExecLine( ) = 4) andalso (instr( mw.DbgStatus, "breakpoint" ) > 0), _
             P( sc, "debug vars: a breakpoint on the first statement stops: " & mw.DbgStatus ) )
    if stopped then
        mw.Execute( Cmd.StepOver )
        t.Check( WaitDebug( mw, true ) andalso (mw.View( ).ExecLine( ) > 4), _
                 P( sc, strings.Format( "debug vars: and a step from it is shown, line {}", mw.View( ).ExecLine( ) + 1 ) ) )
    end if
    if mw.DebugActive( ) then mw.Execute( Cmd.StopDebugging ) : WaitDebug( mw, false )
    ' ---- Globals: 'dim shared' only -- a module-level 'dim' is main's local
    mw.View( ).ToggleBreakpoint( 4 )
    dim as ustring procF = fs.PathJoin( dir_, "proc.tiko" )
    fs.WriteAllText( procF, "sub work()" & nl & "    dim as long inner = 3" & nl & "    print inner" & nl & "end sub" & nl & _
        "dim shared as long counter = 7" & nl & "dim as long outer = 9" & nl & "counter += outer" & nl & "work()" & nl )
    mw.OpenFile( procF )
    mw.View( ).ToggleBreakpoint( 2 )                       ' "    print inner"
    mw.Execute( Cmd.StartDebugging )
    stopped = WaitBuild( mw ) andalso WaitDebug( mw, true )
    t.Check( stopped andalso (mw.View( ).ExecLine( ) = 2), P( sc, "debug vars: stopped inside the procedure: " & mw.DbgStatus ) )
    if stopped then
        dim as debugpane.Pane ptr dp = @mw.Out.Debug
        dim as TK_WIDGET ptr loc = dp->lists( debugpane.DebugList.Locals ), glob = dp->lists( debugpane.DebugList.Globals )
        tkTest_PumpFor( h, 30 )
        t.Check( TopNames( loc ) = "inner", P( sc, "debug vars: Locals, the procedure's own: " & TopNames( loc ) ) )
        t.Check( TopNames( glob ) = "counter", P( sc, "debug vars: Globals, dim shared only: " & TopNames( glob ) ) )
        dim as long rCounter = FindRow( glob, "counter" )
        t.Check( (rCounter >= 0) andalso (tkListTree_GetCellText( glob, rCounter, 1 ) = "16"), P( sc, "debug vars: and its value" ) )
    end if
    if mw.DebugActive( ) then mw.Execute( Cmd.StopDebugging ) : WaitDebug( mw, false )
    ' ---- Globals of every module of the program; the compiler's own packages' are not the program's
    mw.View( ).ToggleBreakpoint( 2 )
    dim as ustring multi = fs.PathJoin( dir_, "multi" )
    fs.CreateDirAll( fs.PathJoin( multi, "helper" ) )
    fs.WriteAllText( fs.PathJoin( multi, project.MANIFEST_FILE ), "[package]" & nl & "name = ""app""" & nl & "version = ""0.1.0""" & nl & nl & _
        "[target.main]" & nl & "main = ""main.tiko""" & nl )
    fs.WriteAllText( fs.PathJoin( multi, "helper", "helper.tiko" ), "#module ""helper""" & nl & "dim shared as long gHelp = 41" & nl & _
        "public sub Touch()" & nl & "    gHelp += 1" & nl & "end sub" & nl )
    dim as ustring multiMain = fs.PathJoin( multi, "main.tiko" )
    fs.WriteAllText( multiMain, "#import ""app/helper""" & nl & "#import ""std/fs""" & nl & "#import ""std/strings""" & nl & _
        "dim shared as long gMain = 1" & nl & "helper.Touch()" & nl & "print gMain; fs.IsFile( ""x"" ); strings.Format( ""{}"", 1 )" & nl & "print ""end""" & nl )
    t.Check( mw.OpenProject( fs.PathJoin( multi, project.MANIFEST_FILE ) ), P( sc, "debug vars: the two-module project opened" ) )
    mw.OpenFile( multiMain )
    mw.View( ).ToggleBreakpoint( 6 )                       ' "print ""end"""
    mw.Execute( Cmd.StartDebugging )
    stopped = WaitBuild( mw ) andalso WaitDebug( mw, true )
    t.Check( stopped, P( sc, "debug vars: the two-module program stopped: " & mw.DbgStatus ) )
    if stopped then
        dim as TK_WIDGET ptr glob = mw.Out.Debug.lists( debugpane.DebugList.Globals )
        tkTest_PumpFor( h, 30 )
        t.Check( TopNames( glob ) = "gmain ghelp", P( sc, "debug vars: Globals of both modules, std's left out: " & TopNames( glob ) ) )
        dim as long rHelp = FindRow( glob, "ghelp" )
        t.Check( (rHelp >= 0) andalso (tkListTree_GetCellText( glob, rHelp, 1 ) = "42"), P( sc, "debug vars: and the other module's value" ) )
    end if
    if mw.DebugActive( ) then mw.Execute( Cmd.StopDebugging ) : WaitDebug( mw, false )
    for each d as DocRef in mw.Docs
        d->Main.SetSavePoint( )
    next
    mw.Destroy( )
end sub

' ================================================================ the debugger: macOS says no

' A stand-in lldb-dap (python3): it answers every request, and refuses the launch with the words
' macOS's debugserver used when Developer Mode was off (measured over ssh, 2026-11-07).
private function FakeDapScript( ) as ustring
    dim as ustring nl = chr( 10 )
    return "#!/usr/bin/env python3" & nl & _
        "import sys, json" & nl & _
        "inp = sys.stdin.buffer" & nl & _
        "out = sys.stdout.buffer" & nl & _
        "seq = [0]" & nl & _
        "def send(m):" & nl & _
        "    seq[0] += 1" & nl & _
        "    m['seq'] = seq[0]" & nl & _
        "    b = json.dumps(m).encode()" & nl & _
        "    out.write(b'Content-Length: %d\r\n\r\n' % len(b) + b)" & nl & _
        "    out.flush()" & nl & _
        "def read():" & nl & _
        "    n = 0" & nl & _
        "    while True:" & nl & _
        "        line = inp.readline()" & nl & _
        "        if not line: return None" & nl & _
        "        line = line.strip()" & nl & _
        "        if not line: break" & nl & _
        "        if line.lower().startswith(b'content-length:'): n = int(line.split(b':')[1])" & nl & _
        "    return json.loads(inp.read(n))" & nl & _
        "launch = None" & nl & _
        "while True:" & nl & _
        "    m = read()" & nl & _
        "    if m is None: break" & nl & _
        "    c = m.get('command')" & nl & _
        "    r = {'type': 'response', 'request_seq': m['seq'], 'command': c, 'success': True, 'body': {}}" & nl & _
        "    if c == 'launch':" & nl & _
        "        launch = m['seq']" & nl & _
        "        send({'type': 'event', 'event': 'initialized'})" & nl & _
        "        continue" & nl & _
        "    if c == 'setFunctionBreakpoints': r['body'] = {'breakpoints': [{'id': 1, 'verified': False}]}" & nl & _
        "    send(r)" & nl & _
        "    if c == 'configurationDone' and launch:" & nl & _
        "        send({'type': 'response', 'request_seq': launch, 'command': 'launch', 'success': False, 'body': {'error': {'id': 3, " & _
        "'format': 'process exited with status -1 (this is a non-interactive debug session, cannot get permission to debug processes.)', " & _
        "'showUser': True}}})" & nl & _
        "    if c == 'disconnect': break" & nl
end function

' Linux / macOS: the session refused as macOS refuses it -- the status line and the Debug tab say
' what to do (Developer Mode), not debugserver's words, and the session is over. (Windows attaches
' instead of launching: nothing there asks this permission.)
public sub DebugFailPass( byref t as Tally, byval sc as single )
    if platform.CurrentOs( ) = platform.Os.Windows then exit sub
    dim as ustring tk = TestCompiler( )
    if (len( tk ) = 0) orelse (len( platform.FindOnPath( "python3" ) ) = 0) then
        print "debug fail: no tiko or no python3: skipped"
        exit sub
    end if
    dim as ustring cfg = FreshConfig( )
    dim as ustring dir_ = fs.PathJoin( Files( ), "dbgfail" )
    fs.CreateDirAll( dir_ )
    dim as ustring nl = chr( 10 )
    dim as ustring mainF = fs.PathJoin( dir_, "fail.tiko" )
    fs.WriteAllText( mainF, "dim as long a = 1" & nl & "print a" & nl )
    dim as ustring fake = fs.PathJoin( cfg, "fake-lldb-dap" )
    fs.WriteAllText( fake, FakeDapScript( ) )
    dim as ustring term = fs.PathJoin( cfg, "faketerm" )
    fs.WriteAllText( term, "#!/bin/sh" & nl & "shift" & nl & "script -qfc ""$*"" /dev/null < /dev/null > /dev/null 2>&1 &" & nl )
    dim as process.Command c = process.Command( "/bin/chmod" )
    c.Arg( "+x" ).Arg( fake ).Arg( term )
    dim as process.Child ch
    if ch.Spawn( c ).IsOk( ) then ch.Wait( )
    gDebugTermEnv = "TERMINAL=" & term
    setenviron gDebugTermEnv

    dim as mainwin.Window mw
    mw.ConfigDir = cfg
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    t.Check( mw.Create( sc ), P( sc, "debug fail: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    tkTest_PumpFor( tkForm_Host( mw.form ), 100 )
    mw.Prefs.Tiko = tk
    mw.Prefs.DebugAdapter = fake
    mw.OpenFile( mainF )
    mw.Execute( Cmd.StartDebugging )
    t.Check( WaitBuild( mw ) andalso mw.BuildSucceeded, P( sc, "debug fail: built" ) )
    t.Check( WaitDebug( mw, false ), P( sc, "debug fail: the session ended by itself" ) )
    dim as ustring want = "macOS did not let the debugger control the program: turn on Developer Mode (sudo DevToolsSecurity -enable), or allow it when macOS asks"
    t.Check( mw.DbgStatus = want, P( sc, "debug fail: the status line says to turn on Developer Mode: " & mw.DbgStatus ) )
    t.Check( mw.Out.current = outputpane.OutputTab.Debug, P( sc, "debug fail: the Debug tab shown" ) )
    t.Check( (mw.DebugActive( ) = false) andalso mw.CanRun( Cmd.StartDebugging ) andalso (mw.CanRun( Cmd.StopDebugging ) = false), _
             P( sc, "debug fail: no session left: Start works again, Stop greyed" ) )
    for each d as DocRef in mw.Docs
        d->Main.SetSavePoint( )
    next
    mw.Destroy( )
end sub

public sub BuildPass( byref t as Tally, byval sc as single )
    dim as ustring tk = TestCompiler( )
    t.Check( len( tk ) > 0, "build: a tiko compiler to build with ($TKEDIT_TIKO)" )
    if len( tk ) = 0 then exit sub
    dim as ustring cfg = FreshConfig( )
    dim as ustring dir_ = fs.PathJoin( Files( ), "hello" )
    fs.CreateDirAll( dir_ )
    dim as ustring nl = chr( 10 )
    dim as ustring mainF = fs.PathJoin( dir_, "main.tiko" )
    dim as ustring good = "print ""hello from tkEdit""" & nl
    fs.WriteAllText( mainF, good )

    dim as mainwin.Window mw
    mw.ConfigDir = cfg
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    mw.Launch = @ScriptedLaunch
    t.Check( mw.Create( sc ), P( sc, "build: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_PumpFor( h, 100 )
    mw.Prefs.Tiko = tk
    if platform.CurrentOs( ) <> platform.Os.Windows then
        ' no terminal emulator is guaranteed (WSL has none): name one that exists and does nothing
        gTerminalEnv = "TERMINAL=/bin/true"
        setenviron gTerminalEnv
    end if
    t.Check( mw.CompilerPath( ) = tk, P( sc, "the compiler: " & mw.CompilerPath( ) ) )

    ' ---- no project, settings.toml in front and edited: Ctrl+F5 builds main.tiko, and leaves
    ' settings.toml alone (not built, not saved)
    mw.OpenFile( mainF )
    mw.Execute( Cmd.Settings )
    dim as DocRef sdoc = mw.Active( )
    dim as ustring sText = sdoc->Main.Text( )
    sdoc->Main.ReplaceAllText( sText & nl & nl )                         ' an edit: modified, not saved
    Chord( h, SDLK_F5, SDL_SCANCODE_F5, KMOD_PRIMARY )
    t.Check( WaitBuild( mw ) andalso mw.BuildSucceeded andalso (lcase( mw.BuildMain ) = lcase( mainF )), _
             P( sc, "settings.toml in front: Ctrl+F5 built main.tiko: " & mw.BuildMain ) )
    t.Check( sdoc->IsModified( ) andalso (instr( fs.ReadAllText( mw.SettingsFile( ) ).ValueOr( "" ), sText & nl & nl ) = 0), _
             P( sc, "and did not save settings.toml" ) )
    sdoc->Main.SetSavePoint( )
    mw.CloseDoc( sdoc )
    mw.ShowDoc( mw.FindOpen( mainF ) )

    ' ---- the Project panel with no project: a tiko.toml written in main.tiko's folder (target
    ' "main", main = main.tiko), the project opens, its options file opens; saving it applies it
    t.Check( mw.StatusText( mainwin.StatusPanel.Project ) = "Project", P( sc, "a Project panel" ) )
    ClickPanel( mw, mainwin.StatusPanel.Project )
    dim as ustring pf = fs.PathJoin( dir_, project.MANIFEST_FILE )
    dim as ustring optF = project.OptionsPath( cfg, pf )
    t.Check( mw.ProjOpen andalso fs.IsFile( pf ) andalso (mw.Proj.Targets.Count( ) = 1) andalso _
             (lcase( mw.Proj.MainOf( "main" ) ) = lcase( mainF )), P( sc, "tiko.toml written: target main, main.tiko its main" ) )
    t.Check( (lcase( mw.ActivePath( ) ) = lcase( optF )) andalso (instr( mw.View( ).Text( ), "command_line = " ) > 0) andalso _
             (instr( mw.View( ).Text( ), "manifest = " ) > 0), P( sc, "and the project's options file open: " & mw.ActivePath( ) ) )
    t.Check( mw.StatusTip( mainwin.StatusPanel.Project ) = mw.Proj.Path, P( sc, "the panel's tooltip is the tiko.toml" ) )
    scope
        dim as ustring pt = mw.View( ).Text( )
        dim as long k = instr( pt, "command_line =" )
        dim as long e = instr( k, pt, chr( 10 ) )
        if (k > 0) andalso (e > k) then pt = left( pt, k - 1 ) & "command_line = 'x y'" & mid( pt, e )
        mw.View( ).ReplaceAllText( pt )
    end scope
    Chord( h, SDLK_S, SDL_SCANCODE_S, KMOD_PRIMARY )
    t.Check( mw.ProjOpen andalso (mw.ProjOpts.CommandLine = "x y") andalso (lcase( mw.ProjOpts.Manifest ) = lcase( pf )), _
             P( sc, "saving the hand edit applied it: command line '" & mw.ProjOpts.CommandLine & "'" ) )
    mw.ShowDoc( mw.FindOpen( mainF ) )
    ClickPanel( mw, mainwin.StatusPanel.Project )
    t.Check( (lcase( mw.ActivePath( ) ) = lcase( optF )) andalso mw.ProjOpen andalso (mw.Docs.Count( ) = 2), _
             P( sc, strings.Format( "with the project open the panel shows its options again ({} buffers)", mw.Docs.Count( ) ) ) )
    mw.ShowDoc( mw.FindOpen( mainF ) )
    dim as ustring title = *SDL_GetWindowTitle( h->win )
    t.Check( instr( title, "[" & fs.PathJoin( "hello", project.MANIFEST_FILE ) & "]" ) > 0, P( sc, "the title names the project: " & title ) )

    ' ---- Ctrl+F5: a build that works; the pane stays hidden
    Chord( h, SDLK_F5, SDL_SCANCODE_F5, KMOD_PRIMARY )
    t.Check( mw.IsBuilding( ), P( sc, "Ctrl+F5 started a build" ) )
    t.Check( WaitBuild( mw ), P( sc, "the build ended" ) )
    t.Check( mw.BuildSucceeded, P( sc, "built: " & mw.Message ) )
    t.Check( left( mw.Message, 8 ) = "Build OK", P( sc, "the message says so" ) )
    t.Check( mw.OutputShown = false, P( sc, "the output pane stays hidden" ) )
    scope   ' the log starts with the summary; the message names the program and its size
        dim as ustring lg = mw.Out.LogText( )
        dim as ustring sz = " [" & fs.PathFileName( mw.LastExe ) & " ("
        t.Check( (left( lg, 42 ) = "Successful Compile (Errors 0 Warnings 0)" & nl & nl) andalso _
                 (instr( lg, nl & "Primary Source: " & fs.PathToNative( mw.Proj.MainOf( mw.ProjectTarget( ) ) ) & nl ) > 0) andalso _
                 (instr( lg, nl & "Target Compilation: " & mw.LastExe & " (" ) > 0) andalso (instr( lg, nl & "Compile Time: " ) > 0), _
                 P( sc, "the log starts with the summary: " & left( lg, 120 ) ) )
        t.Check( (instr( mw.Message, sz ) > 0) andalso (right( mw.Message, 8 ) = " bytes)]"), P( sc, "the message ends with the program's size: " & mw.Message ) )
    end scope
    t.Check( fs.IsFile( mw.LastExe ), P( sc, "the program: " & mw.LastExe ) )
    t.Check( (instr( mw.Out.LogText( ), "build" ) > 0) andalso (instr( mw.Out.LogText( ), "{""event""" ) = 0), P( sc, "the log: the command line, no JSON events" ) )
    if fs.IsFile( mw.LastExe ) then
        dim as process.ProcResultOutput po = process.Capture( process.Command( mw.LastExe ) )
        t.Check( po.IsOk( ) andalso (instr( po.Value( ).StdoutText( ), "hello from tkEdit" ) > 0), P( sc, "the program runs" ) )
    end if

    ' ---- Run Arguments (Ctrl+Shift+F5): the row holds the command line; Enter sets it
    Chord( h, SDLK_F5, SDL_SCANCODE_F5, KMOD_PRIMARY or SDL_KMOD_SHIFT )
    t.Check( mw.Finder.isOpen andalso (mw.Finder.Mode = findstrip.StripMode.Args) andalso (mw.Finder.Phrase( ) = "x y"), _
             P( sc, "Ctrl+Shift+F5: the Arguments row, the command line in it: " & mw.Finder.Phrase( ) ) )
    mw.Finder.SetPhrase( "one ""two words""" )
    StripKey( mw, SDLK_RETURN, SDL_SCANCODE_RETURN )
    t.Check( (mw.Finder.isOpen = false) andalso (mw.ProjOpts.CommandLine = "one ""two words""") andalso _
             (instr( fs.ReadAllText( optF ).ValueOr( "" ), "command_line = 'one ""two words""'" ) > 0), _
             P( sc, "Enter set it, in the options file too" ) )
    t.Check( instr( mw.FindOpen( optF )->Main.Text( ), "one ""two words""" ) > 0, P( sc, "and the open options buffer reloaded" ) )

    ' ---- Shift+F5: Run, in a terminal, with the project's command line
    gLaunched.Clear( )
    Chord( h, SDLK_F5, SDL_SCANCODE_F5, SDL_KMOD_SHIFT )
    t.Check( gLaunched.Count( ) = 1, P( sc, strings.Format( "Run launched once ({})", gLaunched.Count( ) ) ) )
    if gLaunched.Count( ) then
        if platform.CurrentOs( ) = platform.Os.Windows then
            t.Check( strings.EndsWith( gLaunched[0], "tkEdit-run.cmd" ), P( sc, "through a .cmd: " & gLaunched[0] ) )
            dim as ustring body = fs.ReadAllText( gLaunched[0] ).ValueOr( "" )
            t.Check( instr( body, """one"" ""two words""" ) > 0, P( sc, "with the command line's arguments" ) )
        elseif platform.CurrentOs( ) = platform.Os.MacOS then
            t.Check( (left( gLaunched[0], 11 ) = "/bin/sh|-c|") andalso (instr( gLaunched[0], "&& exec /usr/bin/open -a Terminal '" ) > 0) _
                     andalso strings.EndsWith( gLaunched[0], "tkEdit-run.command'" ), P( sc, "in Terminal.app: " & gLaunched[0] ) )
        else
            t.Check( (left( gLaunched[0], 13 ) = "/bin/true|-e|") andalso strings.EndsWith( gLaunched[0], "tkEdit-run.sh" ), _
                     P( sc, "in the terminal: " & gLaunched[0] ) )
        end if
    end if

    ' ---- a build that fails: the pane, Results, the first error, a squiggle
    dim as editor.CodeView ptr v = @mw.View( )
    v->ReplaceAllText( "print ""a""" & nl & "NoSuchThing( 1 )" & nl & "print undefinedvariable" & nl )   ' an edit: SetText would be a save point
    Chord( h, SDLK_F5, SDL_SCANCODE_F5, KMOD_PRIMARY )
    t.Check( WaitBuild( mw ), P( sc, "the failing build ended" ) )
    t.Check( mw.BuildSucceeded = false, P( sc, "it failed: " & mw.Message ) )
    t.Check( left( mw.Message, 12 ) = "Build failed" orelse (left( mw.Message, 6 ) = "error "), P( sc, "the message says so: " & mw.Message ) )
    t.Check( (left( mw.Out.LogText( ), 15 ) = "Failed Compile ") andalso (instr( mw.Out.LogText( ), "Target Compilation:" ) = 0) andalso _
             (instr( mw.Message, " bytes)]" ) = 0), P( sc, "a failed build: the summary says so, no program size anywhere" ) )
    t.Check( fs.ReadAllText( mainF ).ValueOr( "" ) <> good, P( sc, "the buffer was saved before the build" ) )
    t.Check( mw.OutputShown andalso (mw.Out.current = outputpane.OutputTab.Results), P( sc, "the output pane opened on Results" ) )
    ' the Log tab's background is the lists'
    mw.Out.ShowTab( outputpane.OutputTab.CompilerLog )
    tkHost_RenderTo( h, false )
    scope
        dim as TKRECT la
        tkWidget_AbsRect( mw.Out.logBox, la )
        dim as ulong lc = tkTest_PixelAt( h, la.right - 6, la.bottom - 6 ) and &hFFFFFFul
        dim as ulong rc_ = tkListTree_GetBackColor( mw.Out.results ) and &hFFFFFFul
        t.Check( lc = rc_, P( sc, strings.Format( "the Log's background is Results' (&h{} vs &h{})", hex( lc ), hex( rc_ ) ) ) )
        ' no frame: its top row, under the tabs, is the background too
        dim as ulong tc_ = tkTest_PixelAt( h, (la.left + la.right) \ 2, la.top ) and &hFFFFFFul
        t.Check( (tkTextBox_GetBorderWidth( mw.Out.logBox ) = 0) andalso (tc_ = rc_), P( sc, strings.Format( "no line under the Log tab (&h{})", hex( tc_ ) ) ) )
    end scope
    mw.Out.ShowTab( outputpane.OutputTab.Results )
    t.Check( mw.Diags.Count( ) >= 2, P( sc, strings.Format( "the diagnostics ({})", mw.Diags.Count( ) ) ) )
    t.Check( tkListTree_GetCount( mw.Out.results ) >= 2, P( sc, strings.Format( "Results rows ({})", tkListTree_GetCount( mw.Out.results ) ) ) )
    t.Check( RowsDrawn( h, mw.Out.results ), P( sc, "and drawn" ) )
    v = @mw.View( )
    t.Check( v->CaretLine( ) = 2, P( sc, strings.Format( "the caret went to the first error, line {}", v->CaretLine( ) ) ) )
    t.Check( v->SquiggleAt( v->SelectionStart( ) ) <> 0, P( sc, "a squiggle under it" ) )
    dim as long cy = h->root->cw * 0 + h->root->ch
    dim as long oh = tkForm_Scale( mw.form, outputpane.PANE_CY ), sh = mw.StatusHeight( ), top = mw.MenuHeight( ) + mw.TabsHeight( )
    t.Check( (mw.Out.frame->y = cy - sh - oh) andalso (mw.Out.frame->ch = oh), P( sc, strings.Format( "the pane above the status line: {} {}", mw.Out.frame->y, mw.Out.frame->ch ) ) )
    t.Check( PaneCH( mw, v->Widget( ) ) = cy - sh - oh - top, P( sc, "the view ends above the pane" ) )
    Chord( h, SDLK_PAGEDOWN, SDL_SCANCODE_PAGEDOWN, SDL_KMOD_ALT )
    t.Check( mw.View( ).CaretLine( ) = 3, P( sc, strings.Format( "Alt+PgDn: the next diagnostic, line {}", mw.View( ).CaretLine( ) ) ) )
    Chord( h, SDLK_PAGEDOWN, SDL_SCANCODE_PAGEDOWN, SDL_KMOD_ALT )
    t.Check( mw.View( ).CaretLine( ) = 2, P( sc, "and it wraps" ) )
    Chord( h, SDLK_PAGEUP, SDL_SCANCODE_PAGEUP, SDL_KMOD_ALT )
    t.Check( mw.View( ).CaretLine( ) = 3, P( sc, "Alt+PgUp: the previous" ) )
    Chord( h, SDLK_GRAVE, SDL_SCANCODE_GRAVE, KMOD_PRIMARY )
    t.Check( mw.OutputHasFocus( ), P( sc, "Ctrl+Tilde reaches the output pane" ) )
    Chord( h, SDLK_GRAVE, SDL_SCANCODE_GRAVE, KMOD_PRIMARY )
    t.Check( tkHost_GetFocus( h ) = mw.View( ).Widget( ), P( sc, "and back to the editor" ) )
    Chord( h, SDLK_F9, SDL_SCANCODE_F9, KMOD_PRIMARY )
    t.Check( (mw.OutputShown = false) andalso (PaneCH( mw, mw.View( ).Widget( ) ) = cy - sh - top), P( sc, "Ctrl+F9 hides the pane" ) )

    ' ---- F5: fixed, built and run
    mw.View( ).ReplaceAllText( good )
    gLaunched.Clear( )
    Chord( h, SDLK_F5, SDL_SCANCODE_F5, 0 )
    t.Check( WaitBuild( mw ) andalso mw.BuildSucceeded, P( sc, "F5 built the fixed program: " & mw.Message ) )
    t.Check( gLaunched.Count( ) = 1, P( sc, "and ran it" ) )
    t.Check( left( mw.Message, 8 ) = "Build OK", P( sc, "the status line keeps the build's result, not 'running': " & mw.Message ) )
    t.Check( (mw.Diags.Count( ) = 0) andalso (mw.View( ).SquiggleAt( 0 ) = 0), P( sc, "the squiggles and rows are gone" ) )

    ' ---- Ctrl+Alt+F5: clean, then build
    Chord( h, SDLK_F5, SDL_SCANCODE_F5, KMOD_PRIMARY or SDL_KMOD_ALT )
    t.Check( WaitBuild( mw ) andalso mw.BuildSucceeded, P( sc, "Ctrl+Alt+F5 rebuilt: " & mw.Message ) )
    t.Check( (instr( mw.Out.LogText( ), " clean " ) > 0) andalso (instr( mw.Out.LogText( ), " build " ) > 0), P( sc, "clean, then build, in the log" ) )

    ' ---- the project: saved, closed, opened again as it was -- its session from the config folder
    mw.View( ).GoToLine( 0 )
    t.Check( mw.SaveProject( ), P( sc, "Save Project" ) )
    t.Check( fs.IsFile( project.SessionPath( cfg, pf ) ), P( sc, "its session is in the config folder" ) )
    t.Check( mw.CloseProject( ) andalso (mw.ProjOpen = false), P( sc, "Close Project" ) )
    t.Check( (mw.Docs.Count( ) = 1) andalso mw.Docs[0]->IsNew( ), P( sc, "its buffers closed" ) )
    t.Check( mw.OpenFile( pf ), P( sc, "opening tiko.toml opens the project" ) )
    t.Check( (mw.Recent.Count( ) > 0) andalso (lcase( mw.Recent.Item( 0 ) ) = lcase( pf )), P( sc, "the project is the most recent file" ) )
    mw.OpenChooser( mainwin.PickKind.Recent )
    t.Check( mw.Chooser.IsOpen( ) andalso (mw.Chooser.Rows.Count( ) > 0) andalso (mw.Chooser.Rows[0].Cells[1] = "tiko.toml  [project]"), _
             P( sc, "the recent list marks it a project" ) )
    mw.Chooser.Close( )
    t.Check( mw.ProjOpen andalso (mw.FindOpen( mainF ) <> 0) andalso (lcase( mw.ActivePath( ) ) = lcase( pf )), _
             P( sc, "main.tiko is back, and tiko.toml shown to edit: " & mw.ActivePath( ) ) )
    t.Check( mw.ProjOpts.CommandLine = "one ""two words""", P( sc, "the command line kept: " & mw.ProjOpts.CommandLine ) )
    ' a file in the folder that was never opened is the project's
    dim as ustring other = fs.PathJoin( dir_, "util.tiko" )
    fs.WriteAllText( other, "' util" & nl )
    dim as boolean hasOther = false
    for each f as ustring in mw.ProjectFiles( true )
        if lcase( f ) = lcase( other ) then hasOther = true
    next
    t.Check( hasOther, P( sc, "util.tiko, never opened, is one of the project's files" ) )

    ' ---- Run Arguments without a project: the file's own, kept in runargs.toml
    t.Check( mw.CloseProject( ), P( sc, "closed again" ) )
    mw.OpenFile( mainF )
    Chord( h, SDLK_F5, SDL_SCANCODE_F5, KMOD_PRIMARY or SDL_KMOD_SHIFT )
    t.Check( mw.Finder.isOpen andalso (mw.Finder.Phrase( ) = ""), P( sc, "no project: the row is empty for main.tiko" ) )
    mw.Finder.SetPhrase( "-v 3" )
    StripKey( mw, SDLK_RETURN, SDL_SCANCODE_RETURN )
    dim as ustring rf = fs.PathJoin( cfg, runargs.RUNARGS_FILE )
    t.Check( (mw.RunStore.Get( mainF ) = "-v 3") andalso fs.IsFile( rf ), P( sc, "set for main.tiko, in runargs.toml" ) )
    t.Check( mw.RunArgsNow( ) = "-v 3", P( sc, "and what Run passes" ) )
    Chord( h, SDLK_F5, SDL_SCANCODE_F5, KMOD_PRIMARY or SDL_KMOD_SHIFT )
    mw.Finder.SetPhrase( "" )
    StripKey( mw, SDLK_RETURN, SDL_SCANCODE_RETURN )
    t.Check( (mw.RunStore.Get( mainF ) = "") andalso (fs.IsFile( rf ) = false), P( sc, "empty cleared it, and the file went" ) )

    mw.Destroy( )

    ' ---- at start, the state of a project whose tiko.toml is gone is pruned; a live one stays
    dim as project.ProjectOptions stale
    stale.Manifest = fs.PathJoin( dir_, "gone", project.MANIFEST_FILE )
    project.WriteOptions( project.OptionsPath( cfg, stale.Manifest ), stale )
    fs.WriteAllText( project.SessionPath( cfg, stale.Manifest ), "version = 1" & nl )
    dim as mainwin.Window mw4
    mw4.ConfigDir = cfg
    mw4.Ask = @ScriptedAsk
    mw4.Pick = @ScriptedPick
    t.Check( mw4.Create( sc ), P( sc, "prune: a window" ) )
    t.Check( (fs.IsFile( project.OptionsPath( cfg, stale.Manifest ) ) = false) andalso (fs.IsFile( project.SessionPath( cfg, stale.Manifest ) ) = false), _
             P( sc, "the gone project's options and session were pruned" ) )
    t.Check( fs.IsFile( optF ) andalso fs.IsFile( project.SessionPath( cfg, pf ) ), P( sc, "the live project's stayed" ) )

    ' ---- the compiler: settings.toml, the PATH, a toolchain beside tkEdit; none = asked for once,
    ' the answer kept in settings.toml (author 2026-10-27). The PATH is emptied around the calls.
    if mw4.form then
        dim as ustring pkg = fs.PathJoin( Files( ), "pkg" )
        dim as ustring ed = fs.PathJoin( pkg, "tkedit" )
        fs.CreateDirAll( fs.PathJoin( ed, "fonts" ) )
        dim as ustring exe = "tiko"
        if platform.CurrentOs( ) = platform.Os.Windows then exe = "tiko.exe"
        dim as ustring sib = fs.PathJoin( pkg, "tiko-host", "bin", exe )
        fs.CreateDirAll( fs.PathParent( sib ) )
        fs.WriteAllText( sib, "" )
        dim as ustring keepRes = mw4.ResourceDir
        mw4.ResourceDir = ed
        mw4.Prefs.Tiko = ""
        gPathKeep = "PATH=" & environ( "PATH" )
        gPathEnv = "PATH="
        setenviron gPathEnv
        t.Check( mw4.CompilerPath( ) = sib, P( sc, "no setting, nothing on the PATH: the toolchain beside tkEdit: " & mw4.CompilerPath( ) ) )
        dim as long asked0 = gAsked
        t.Check( mw4.EnsureCompiler( ) andalso (gAsked = asked0), P( sc, "and nothing is asked" ) )
        fs.RemoveDirAll( fs.PathJoin( pkg, "tiko-host" ) )
        gPickPath = ""
        t.Check( (mw4.EnsureCompiler( ) = false) andalso (gAsked = asked0 + 1), P( sc, "none anywhere: the person is told, then asked; cancelled" ) )
        t.Check( settings.LoadSettings( mw4.SettingsFile( ) ).Value( ).Tiko = "", P( sc, "a cancel writes nothing" ) )
        dim as ustring chosen = fs.PathJoin( Files( ), "chosen-" & exe )
        fs.WriteAllText( chosen, "" )
        gPickPath = chosen
        t.Check( mw4.EnsureCompiler( ) andalso (mw4.Prefs.Tiko = chosen) andalso (mw4.CompilerPath( ) = chosen), _
                 P( sc, "the file chosen is the compiler: " & mw4.CompilerPath( ) ) )
        t.Check( settings.LoadSettings( mw4.SettingsFile( ) ).Value( ).Tiko = chosen, P( sc, "and settings.toml keeps it as [compiler] tiko" ) )
        setenviron gPathKeep
        mw4.ResourceDir = keepRes
    end if
    if mw4.form then mw4.Destroy( )
end sub

' ================================================================ P5: code intelligence

private function WaitScans( byref mw as mainwin.Window, byval atLeast as long ) as boolean
    dim as double t0 = timer
    do while (mw.ScansInstalled < atLeast) orelse (mw.Scanner.Pending( ) > 0)
        tkApp_Pump( )
        SDL_Delay( 20 )
        if timer - t0 > 60 then return false
    loop
    return true
end function

' The list's cell texts of row i, "|"-joined.
private function RowCells( byref mw as mainwin.Window, byval i as long ) as ustring
    if mw.Chooser.List = 0 then return "!"
    dim as ustring s
    for c as long = 0 to mw.Chooser.Columns.Count( ) - 1
        if c then s &= "|"
        s &= tkListTree_GetCellText( mw.Chooser.List, i, c )
    next
    return s
end function

private sub IntelFiles( byref dir_ as const ustring, byref mainF as ustring, byref utilF as ustring )
    dim as ustring nl = chr( 10 )
    mainF = fs.PathJoin( dir_, "main.tiko" )
    utilF = fs.PathJoin( dir_, "util.tiko" )
    fs.WriteAllText( mainF, "type Point" & nl & "    x as long" & nl & "    y as long" & nl & "end type" & nl & nl & _
        "function Twice( byval n as long ) as long" & nl & "    return n * 2" & nl & "end function" & nl & nl & _
        "sub Show( byref p as Point )" & nl & "    print p.x" & nl & "end sub" & nl & nl & _
        "dim as Point pt" & nl & "pt.x = Twice( 3 )" & nl & "Show( pt )" & nl )
    fs.WriteAllText( utilF, "function Helper( ) as long" & nl & "    return 7" & nl & "end function" & nl & nl & _
        "function LongSignature( byref firstParameter as const ustring, byval secondParameter as long, " & _
        "byval thirdParameter as double ) as boolean" & nl & "    return true" & nl & "end function" & nl )
end sub

public sub IntelPass( byref t as Tally, byval sc as single )
    dim as ustring dir_ = fs.PathJoin( Files( ), "intel" )
    fs.CreateDirAll( dir_ )
    dim as ustring mainF, utilF
    IntelFiles( dir_, mainF, utilF )
    dim as mainwin.Window mw
    mw.ConfigDir = FreshConfig( )
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    mw.Launch = @ScriptedLaunch
    t.Check( mw.Create( sc ), P( sc, "intel: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    mw.Prefs.Tiko = TestCompiler( )
    t.Check( mw.Scanner.running, P( sc, "tikoParser loaded: " & mw.Scanner.Lib.LastError( ) ) )
    if mw.Scanner.running = false then
        mw.Destroy( )
        exit sub
    end if
    t.Check( mw.Scanner.Lib.Version( ) = parser.TKP_VERSION, P( sc, strings.Format( "its version is {}", mw.Scanner.Lib.Version( ) ) ) )
    mw.OpenFile( utilF )
    mw.OpenFile( mainF )
    t.Check( WaitScans( mw, 2 ), P( sc, strings.Format( "the scans came back ({}): {}", mw.ScansInstalled, mw.LastScanError ) ) )
    t.Check( mw.Db.HasFile( mainF ) andalso mw.Db.HasFile( utilF ), P( sc, "both files are scanned" ) )

    ' ---- Ctrl+Shift+P: this buffer's procedures; Tab: every open buffer's, with the file; Tab: back;
    ' Ctrl+Shift+P in the list closes it (author 2026-10-27)
    Chord( h, SDLK_P, SDL_SCANCODE_P, KMOD_PRIMARY or SDL_KMOD_SHIFT )
    t.Check( mw.Chooser.IsOpen( ) andalso (mw.Choosing = mainwin.PickKind.Functions), P( sc, "Ctrl+Shift+P opened the functions list" ) )
    t.Check( mw.Chooser.Cue = "Go to function in this file (TAB all files)", P( sc, "the cue says what Tab does: " & mw.Chooser.Cue ) )
    t.Check( mw.Chooser.ShownCount( ) = 2, P( sc, strings.Format( "two in main.tiko ({})", mw.Chooser.ShownCount( ) ) ) )
    t.Check( RowCells( mw, 0 ) = "Twice|function|6", P( sc, "Name | Kind | Line: " & RowCells( mw, 0 ) ) )
    t.Check( RowCells( mw, 1 ) = "Show|sub|10", P( sc, "in source order: " & RowCells( mw, 1 ) ) )
    PopKey( mw, SDLK_TAB, SDL_SCANCODE_TAB )
    t.Check( mw.Chooser.IsOpen( ) andalso mw.FuncsAll andalso (mw.Chooser.ShownCount( ) = 4), _
             P( sc, strings.Format( "Tab: every open buffer ({})", mw.Chooser.ShownCount( ) ) ) )
    t.Check( mw.Chooser.Cue = "Go to function in any open file (TAB active file)", P( sc, "and the cue says Tab goes back: " & mw.Chooser.Cue ) )
    t.Check( mw.Chooser.Columns.Count( ) = 4, P( sc, "with a File column" ) )
    if mw.Chooser.Pop then
        tkTest_PushText( mw.Chooser.Pop, "help" )
        tkTest_PumpFor( h, 40 )
    end if
    t.Check( (mw.Chooser.ShownCount( ) = 1) andalso (RowCells( mw, 0 ) = "Helper|function|1|util.tiko"), P( sc, "'help' leaves Helper: " & RowCells( mw, 0 ) ) )
    PopKey( mw, SDLK_TAB, SDL_SCANCODE_TAB )
    t.Check( (mw.FuncsAll = false) andalso (mw.Chooser.QueryText( ) = "help") andalso (mw.Chooser.ShownCount( ) = 0), _
             P( sc, "Tab again: back to this buffer, the query kept" ) )
    PopKey( mw, SDLK_P, SDL_SCANCODE_P, KMOD_PRIMARY or SDL_KMOD_SHIFT )
    t.Check( mw.Chooser.IsOpen( ) = false, P( sc, "Ctrl+Shift+P in the list closes it" ) )
    Chord( h, SDLK_P, SDL_SCANCODE_P, KMOD_PRIMARY or SDL_KMOD_SHIFT )
    PopKey( mw, SDLK_TAB, SDL_SCANCODE_TAB )
    if mw.Chooser.Pop then
        tkTest_PushText( mw.Chooser.Pop, "help" )
        tkTest_PumpFor( h, 40 )
    end if
    PopKey( mw, SDLK_RETURN, SDL_SCANCODE_RETURN )
    t.Check( (lcase( mw.ActivePath( ) ) = lcase( utilF )) andalso (mw.View( ).CaretLine( ) = 1), P( sc, "Enter opened util.tiko at Helper" ) )

    ' ---- Ctrl+P: files and definitions, fuzzy
    Chord( h, SDLK_P, SDL_SCANCODE_P, KMOD_PRIMARY )
    t.Check( mw.Chooser.IsOpen( ) andalso (mw.Choosing = mainwin.PickKind.Symbols), P( sc, "Ctrl+P opened Search Symbol" ) )
    PopKey( mw, SDLK_P, SDL_SCANCODE_P, KMOD_PRIMARY )
    t.Check( mw.Chooser.IsOpen( ) = false, P( sc, "Ctrl+P again closed it" ) )
    Chord( h, SDLK_P, SDL_SCANCODE_P, KMOD_PRIMARY )
    t.Check( mw.Chooser.ShownCount( ) = 7, P( sc, strings.Format( "2 files + Point, Twice, Show, Helper, LongSignature ({})", mw.Chooser.ShownCount( ) ) ) )
    if mw.Chooser.Pop then
        tkTest_PushText( mw.Chooser.Pop, "twi" )
        tkTest_PumpFor( h, 40 )
    end if
    t.Check( left( RowCells( mw, 0 ), 15 ) = "function|Twice|", P( sc, "'twi': Twice first: " & RowCells( mw, 0 ) ) )
    PopKey( mw, SDLK_RETURN, SDL_SCANCODE_RETURN )
    t.Check( (lcase( mw.ActivePath( ) ) = lcase( mainF )) andalso (mw.View( ).CaretLine( ) = 6), _
             P( sc, strings.Format( "Enter went to Twice, line {}", mw.View( ).CaretLine( ) ) ) )

    ' ---- F12, then back and forward
    dim as editor.CodeView ptr v = @mw.View( )
    v->GoToLine( 14, 9 )                                          ' "pt.x = Twice( 3 )", in Twice
    Chord( h, SDLK_F12, SDL_SCANCODE_F12, 0 )
    t.Check( mw.View( ).CaretLine( ) = 6, P( sc, strings.Format( "F12 went to Twice's definition, line {}", mw.View( ).CaretLine( ) ) ) )
    Chord( h, SDLK_LEFT, SDL_SCANCODE_LEFT, SDL_KMOD_ALT )
    t.Check( mw.View( ).CaretLine( ) = 15, P( sc, strings.Format( "Alt+Left came back, line {}", mw.View( ).CaretLine( ) ) ) )
    Chord( h, SDLK_RIGHT, SDL_SCANCODE_RIGHT, SDL_KMOD_ALT )
    t.Check( mw.View( ).CaretLine( ) = 6, P( sc, "Alt+Right went forward again" ) )
    mw.View( ).GoToLine( 14, 4 )                                  ' "pt.x|": the member x of a Point
    Chord( h, SDLK_F12, SDL_SCANCODE_F12, 0 )
    t.Check( mw.View( ).CaretLine( ) = 2, P( sc, strings.Format( "F12 on pt.x: the field, line {}", mw.View( ).CaretLine( ) ) ) )

    ' ---- Ctrl+PgDn / Ctrl+PgUp
    mw.View( ).GoToLine( 0 )
    Chord( h, SDLK_PAGEDOWN, SDL_SCANCODE_PAGEDOWN, KMOD_PRIMARY )
    t.Check( mw.View( ).CaretLine( ) = 6, P( sc, "Ctrl+PgDn: the next function" ) )
    Chord( h, SDLK_PAGEDOWN, SDL_SCANCODE_PAGEDOWN, KMOD_PRIMARY )
    t.Check( mw.View( ).CaretLine( ) = 10, P( sc, "and the next" ) )
    Chord( h, SDLK_PAGEUP, SDL_SCANCODE_PAGEUP, KMOD_PRIMARY )
    t.Check( mw.View( ).CaretLine( ) = 6, P( sc, "Ctrl+PgUp: the previous" ) )

    ' ---- typing: the picker (tka/completion) -- members after ".", names after three letters, the
    ' calltip after "("; the keys reach the picker, and what it does not use goes on to the editor
    v = @mw.View( )
    v->SetPosition( v->Length( ) )
    dim byref as completion.Picker cp = mw.Completer
    ' "->" lists members as "." does; a comparison's ">" lists nothing
    scope
        dim as ustring keepText = v->Text( )
        tkTest_PushText( h, "pt >" )
        tkTest_PumpFor( h, 40 )
        t.Check( cp.IsOpen( ) = false, P( sc, "a comparison's '>' lists nothing" ) )
        v->SetText( keepText )
        v->SetPosition( v->Length( ) )
        tkTest_PushText( h, "pt->" )
        tkTest_PumpFor( h, 40 )
        t.Check( cp.IsOpen( ) andalso (cp.Count( ) = 2), P( sc, strings.Format( "'pt->' lists Point's two members ({})", cp.Count( ) ) ) )
        cp.Close( )
        v->SetText( keepText )
        v->SetPosition( v->Length( ) )
    end scope
    tkTest_PushText( h, "pt." )
    tkTest_PumpFor( h, 40 )
    t.Check( cp.IsOpen( ) andalso (cp.Count( ) = 2), P( sc, strings.Format( "'pt.' lists Point's two members ({})", cp.Count( ) ) ) )
    t.Check( cp.Selected( ) = "x", P( sc, "x first: " & cp.Selected( ) ) )
    t.Check( (cp.Row( 0 ).Kind = symboldb.SymKind.Field) andalso (cp.Row( 0 ).Detail = "long"), _
             P( sc, "a field, its type the detail: " & cp.Row( 0 ).Detail ) )
    t.Check( v->CompletionsShown( ) = false, P( sc, "Scintilla's own list is not used" ) )
    ' where: under the word's line (above it when the display ends first), the names in line with
    ' the word, two rows tall, MIN_WIDTH .. MAX_WIDTH wide
    scope
        dim as TKRECT a
        tkWidget_AbsRect( v->Widget( ), a )
        dim as long px, py
        v->PointOf( cp.WordStart, px, py )
        dim as long bw = tkHost_Scale( h, 1 )
        dim as long nameX = a.left + px
        dim as boolean under = (cp.Y = a.top + py + v->LineHeight( )) orelse (cp.Y + cp.H = a.top + py)
        t.Check( under, P( sc, strings.Format( "under the line: popup y {} line {}..{}", cp.Y, a.top + py, a.top + py + v->LineHeight( ) ) ) )
        t.Check( cp.X + bw + tkHost_Scale( h, completion.GLYPH_WIDTH ) = nameX, _
                 P( sc, strings.Format( "the names start at the word: popup x {} word x {}", cp.X, nameX ) ) )
        t.Check( cp.H = 2 * cp.RowHeight( ) + 2 * bw, P( sc, strings.Format( "two rows tall: {}", cp.H ) ) )
        t.Check( (cp.W >= tkHost_Scale( h, completion.MIN_WIDTH )) andalso (cp.W <= tkHost_Scale( h, completion.MAX_WIDTH )), _
                 P( sc, strings.Format( "width {} within the limits", cp.W ) ) )
    end scope
    Chord( h, SDLK_DOWN, SDL_SCANCODE_DOWN, 0 )
    t.Check( cp.Selected( ) = "y", P( sc, "Down: y" ) )
    Chord( h, SDLK_HOME, SDL_SCANCODE_HOME, 0 )
    t.Check( cp.Selected( ) = "x", P( sc, "Home: x" ) )
    Chord( h, SDLK_END, SDL_SCANCODE_END, 0 )
    t.Check( cp.Selected( ) = "y", P( sc, "End: y" ) )
    Chord( h, SDLK_UP, SDL_SCANCODE_UP, 0 )
    t.Check( cp.Selected( ) = "x", P( sc, "Up: x" ) )
    tkTest_PushText( h, "Y" )
    tkTest_PumpFor( h, 40 )
    t.Check( cp.IsOpen( ) andalso (cp.Count( ) = 1) andalso (cp.Selected( ) = "y"), _
             P( sc, strings.Format( "typing 'Y' filters, case-blind: {} row(s), {}", cp.Count( ), cp.Selected( ) ) ) )
    t.Check( cp.H = cp.RowHeight( ) + 2 * tkHost_Scale( h, 1 ), P( sc, "and the popup is one row tall" ) )
    Chord( h, SDLK_BACKSPACE, SDL_SCANCODE_BACKSPACE, 0 )
    t.Check( cp.IsOpen( ) andalso (cp.Count( ) = 2) andalso (right( v->TextBeforeCaret( ), 3 ) = "pt."), _
             P( sc, strings.Format( "Backspace went on to the editor: both again ({})", cp.Count( ) ) ) )
    Chord( h, SDLK_DOWN, SDL_SCANCODE_DOWN, 0 )
    dim as long lines_ = v->LineCount( )
    Chord( h, SDLK_RETURN, SDL_SCANCODE_RETURN, 0 )
    t.Check( (cp.IsOpen( ) = false) andalso (right( v->TextBeforeCaret( ), 4 ) = "pt.y") andalso (v->LineCount( ) = lines_), _
             P( sc, "Enter committed y, and no new line: " & v->TextBeforeCaret( ) ) )
    tkTest_PushText( h, " = Twi" )
    tkTest_PumpFor( h, 40 )
    t.Check( cp.IsOpen( ) andalso (cp.Selected( ) = "Twice"), P( sc, "'Twi' offers Twice: " & cp.Selected( ) ) )
    t.Check( (cp.Row( 0 ).Kind = symboldb.SymKind.FunctionProc) andalso (cp.Row( 0 ).Detail = "long") andalso cp.Row( 0 ).HasParams, _
             P( sc, "a function: its result the detail, it takes parameters" ) )
    tkTest_PushText( h, "c(" )
    tkTest_PumpFor( h, 40 )
    t.Check( (cp.IsOpen( ) = false) andalso (right( v->TextBeforeCaret( ), 6 ) = "Twice("), _
             P( sc, "'(' committed Twice (it takes parameters) and went on: " & v->TextBeforeCaret( ) ) )
    t.Check( v->CallTipShown( ), P( sc, "'Twice(' shows the calltip" ) )
    dim as long shortTipH = 0
    ' in the theme's popup colours, not Scintilla's light ones (dark theme: popup #252526, text #D4D4D4)
    scope
        dim as long ctBack = tkCodeEdit_Send( v->Widget( ), SCI_STYLEGETBACK, STYLE_CALLTIP )
        dim as long ctFore = tkCodeEdit_Send( v->Widget( ), SCI_STYLEGETFORE, STYLE_CALLTIP )
        t.Check( (ctBack = &h262525) andalso (ctFore = &hD4D4D4), P( sc, "the calltip's style is the theme's popup: back &h" & hex( ctBack ) & " fore &h" & hex( ctFore ) ) )
        dim as TK_HOST ptr tp = tkCodeEdit_CallTipPopup( )
        dim as ulong px = 0
        if tp then
            tkTest_PumpFor( h, 30 )
            tkHost_RenderTo( tp, false )
            px = tkTest_PixelAt( tp, 2, 2 ) and &hFFFFFFul
            dim as long tw
            SDL_GetWindowSizeInPixels( tp->win, @tw, @shortTipH )
        end if
        t.Check( (tp <> 0) andalso (px = &h252526), P( sc, "and it is drawn so: &h" & hex( px ) ) )
    end scope
    tkTest_PushText( h, "1)" )
    tkTest_PumpFor( h, 40 )
    t.Check( v->CallTipShown( ) = false, P( sc, "')' closes it" ) )
    tkTest_PushText( h, " + Sh" )
    tkTest_PumpFor( h, 40 )
    t.Check( cp.IsOpen( ) = false, P( sc, "two letters list nothing" ) )
    Chord( h, SDLK_SPACE, SDL_SCANCODE_SPACE, KMOD_PRIMARY )
    t.Check( cp.IsOpen( ) andalso (cp.Selected( ) = "Show"), P( sc, "Ctrl+Space does: " & cp.Selected( ) ) )
    Chord( h, SDLK_ESCAPE, SDL_SCANCODE_ESCAPE, 0 )
    t.Check( (cp.IsOpen( ) = false) andalso (right( v->TextBeforeCaret( ), 2 ) = "Sh"), P( sc, "Esc closed it, the text as typed" ) )
    Chord( h, SDLK_SPACE, SDL_SCANCODE_SPACE, KMOD_PRIMARY )
    dim as longint before_ = v->Position( )
    Chord( h, SDLK_LEFT, SDL_SCANCODE_LEFT, 0 )
    t.Check( (cp.IsOpen( ) = false) andalso (v->Position( ) = before_ - 1), P( sc, "Left closed it and still moved the caret" ) )
    Chord( h, SDLK_RIGHT, SDL_SCANCODE_RIGHT, 0 )
    Chord( h, SDLK_SPACE, SDL_SCANCODE_SPACE, KMOD_PRIMARY )
    if cp.IsOpen( ) then
        ' a click in the editor closes it, and lands there
        dim as TKRECT a
        tkWidget_AbsRect( v->Widget( ), a )
        tkTest_Click( h, a.left + (a.right - a.left) \ 2, a.top + tkHost_Scale( h, 10 ) )
        tkTest_PumpFor( h, 40 )
    end if
    t.Check( (cp.IsOpen( ) = false) andalso (v->CaretLine( ) = 1), _
             P( sc, strings.Format( "a click outside closed it, and moved the caret (line {})", v->CaretLine( ) ) ) )
    v->SetPosition( v->Length( ) )
    tkTest_PushText( h, " + Hel" )
    tkTest_PumpFor( h, 40 )
    t.Check( cp.IsOpen( ) andalso (cp.Selected( ) = "Helper") andalso (cp.Row( 0 ).HasParams = false), P( sc, "'Hel' offers Helper, which takes none" ) )
    tkTest_PushText( h, "(" )
    tkTest_PumpFor( h, 40 )
    t.Check( (cp.IsOpen( ) = false) andalso (right( v->TextBeforeCaret( ), 4 ) = "Hel("), _
             P( sc, "so '(' does not commit it: " & v->TextBeforeCaret( ) ) )
    tkTest_PushText( h, ")" )
    tkTest_PumpFor( h, 40 )
    ' keywords complete too: three letters of one offer it; a keyword typed in full is the only match
    ' and lists nothing (Enter must start a line, not accept it), but Ctrl+Space shows it
    Chord( h, SDLK_RETURN, SDL_SCANCODE_RETURN, 0 )
    tkTest_PushText( h, "dec" )
    tkTest_PumpFor( h, 60 )
    t.Check( cp.IsOpen( ) andalso (cp.Selected( ) = "declare") andalso (cp.Row( 0 ).Kind = symboldb.KIND_KEYWORD), _
             P( sc, "'dec' offers the keyword declare: " & cp.Selected( ) ) )
    cp.Close( )
    Chord( h, SDLK_RETURN, SDL_SCANCODE_RETURN, 0 )
    tkTest_PushText( h, "dim" )
    tkTest_PumpFor( h, 60 )
    t.Check( cp.IsOpen( ) = false, P( sc, "'dim' typed in full lists nothing" ) )
    Chord( h, SDLK_SPACE, SDL_SCANCODE_SPACE, KMOD_PRIMARY )
    t.Check( cp.IsOpen( ) andalso (cp.Selected( ) = "dim"), P( sc, "Ctrl+Space after it lists dim: " & cp.Selected( ) ) )
    cp.Close( )
    ' the space after "as" lists the types: tiko's and the scans' (Point is this file's); "has " does not
    Chord( h, SDLK_RETURN, SDL_SCANCODE_RETURN, 0 )
    tkTest_PushText( h, "dim q as " )
    tkTest_PumpFor( h, 60 )
    t.Check( cp.IsOpen( ) andalso (cp.Count( ) > 20), P( sc, strings.Format( "the space after 'dim q as' lists the types ({})", cp.Count( ) ) ) )
    scope
        dim as long k = -1
        for i as long = 0 to cp.Count( ) - 1
            if cp.Row( i ).Name = "long" then k = i
        next
        t.Check( (k >= 0) andalso (cp.Row( k ).Kind = symboldb.KIND_STDTYPE), P( sc, "long among them, as tiko's own type" ) )
    end scope
    tkTest_PushText( h, "Po" )
    tkTest_PumpFor( h, 60 )
    t.Check( cp.IsOpen( ) andalso (cp.Count( ) = 1) andalso (cp.Selected( ) = "Point"), P( sc, "the scan's own type Point is among them: " & cp.Selected( ) ) )
    ' the kind's colour, by pixel: a type's square in the theme's Keyword3
    if cp.IsOpen( ) then
        dim as long gx, gy
        cp.GlyphCenter( 0, gx, gy )
        tkTest_PumpFor( h, 30 )
        tkHost_RenderTo( cp.Pop, false )
        dim as ulong gp = tkTest_PixelAt( cp.Pop, gx, gy ) and &hFFFFFFul
        dim as ulong want = completion.KindColor( symboldb.SymKind.TypeDef, mw.Look ) and &hFFFFFFul
        t.Check( gp = want, P( sc, "the type's glyph is Keyword3: &h" & hex( gp ) & " want &h" & hex( want ) ) )
        dim as long nx = gx + tkHost_Scale( h, completion.GLYPH_WIDTH )
        t.Check( (tkTest_PixelAt( cp.Pop, cp.W - tkHost_Scale( h, 3 ), gy ) and &hFFFFFFul) = (mw.Look.Selection and &hFFFFFF), _
                 P( sc, "the selected row in the selection colour" ) )
    end if
    cp.Close( )
    Chord( h, SDLK_RETURN, SDL_SCANCODE_RETURN, 0 )
    tkTest_PushText( h, "dim r as lon" )
    tkTest_PumpFor( h, 60 )
    t.Check( cp.IsOpen( ) andalso (cp.Selected( ) = "long"), P( sc, "and tiko's: 'as lon' offers long: " & cp.Selected( ) ) )
    Chord( h, SDLK_TAB, SDL_SCANCODE_TAB, 0 )
    t.Check( (cp.IsOpen( ) = false) andalso (right( v->TextBeforeCaret( ), 8 ) = " as long"), P( sc, "Tab commits: " & v->TextBeforeCaret( ) ) )
    Chord( h, SDLK_RETURN, SDL_SCANCODE_RETURN, 0 )
    tkTest_PushText( h, "x = has " )
    tkTest_PumpFor( h, 60 )
    t.Check( cp.IsOpen( ) = false, P( sc, "'has ' lists nothing" ) )
    ' a generic's "( of " lists the types too, and so does a comma in its list; a call's comma does not
    Chord( h, SDLK_RETURN, SDL_SCANCODE_RETURN, 0 )
    tkTest_PushText( h, "dim ga as Array( of " )
    tkTest_PumpFor( h, 60 )
    t.Check( right( v->TextBeforeCaret( ), 10 ) = "Array( of ", P( sc, "typed: " & v->TextBeforeCaret( ) ) )
    t.Check( cp.IsOpen( ) andalso (cp.Count( ) > 20), P( sc, strings.Format( "the space after '( of' lists the types ({})", cp.Count( ) ) ) )
    tkTest_PushText( h, "lon" )
    tkTest_PumpFor( h, 60 )
    t.Check( cp.IsOpen( ) andalso (cp.Selected( ) = "long"), P( sc, "'( of lon' offers long: " & cp.Selected( ) ) )
    cp.Close( )
    Chord( h, SDLK_RETURN, SDL_SCANCODE_RETURN, 0 )
    tkTest_PushText( h, "dim gm as Map( of string, " )
    tkTest_PumpFor( h, 60 )
    t.Check( cp.IsOpen( ) andalso (cp.Count( ) > 20), P( sc, "the space after an 'of' list's comma lists the types" ) )
    cp.Close( )
    Chord( h, SDLK_RETURN, SDL_SCANCODE_RETURN, 0 )
    tkTest_PushText( h, "x = Fn( 1, " )
    tkTest_PumpFor( h, 60 )
    t.Check( cp.IsOpen( ) = false, P( sc, "a call's comma lists nothing" ) )
    ' a property's `set` is a keyword alone on its line and after `end` (LexTiko), never as a
    ' name: `Set( of long )`, `x = set`
    scope
        dim as ustring keep = v->Text( )
        dim as TK_WIDGET ptr sw = v->Widget( )
        dim as ustring lf = chr( 10 )
        v->SetText( "set" & lf & "dim s as Set( of long )" & lf & "End Set" & lf & "x = set  ' set" & lf )
        tkCodeEdit_Send( sw, SCI_COLOURISE, 0, -1 )
        t.Check( tkCodeEdit_Send( sw, SCI_GETSTYLEAT, 0 ) = SCE_B_KEYWORD, P( sc, "set alone on its line is a keyword" ) )
        t.Check( tkCodeEdit_Send( sw, SCI_GETSTYLEAT, 13 ) <> SCE_B_KEYWORD, P( sc, "Set( of long ) is not" ) )
        t.Check( tkCodeEdit_Send( sw, SCI_GETSTYLEAT, 32 ) = SCE_B_KEYWORD, P( sc, "End Set is" ) )
        t.Check( tkCodeEdit_Send( sw, SCI_GETSTYLEAT, 40 ) <> SCE_B_KEYWORD, P( sc, "x = set is not" ) )
        ' an auto-property's accessor clause: `get, set`, `get, private set`, `get, init`; and
        ' `ustring` is in keywords/tiko.txt
        dim as ustring tx = "property P as long get, set" & lf & "property Q as long get, private set" & lf & _
                            "property R as long get, init" & lf & "dim u as ustring" & lf & "f( a, set )" & lf & _
                            "dim s as slice" & lf & "dim v as uslice" & lf & "dim w as wslice" & lf
        v->SetText( tx )
        tkCodeEdit_Send( sw, SCI_COLOURISE, 0, -1 )
        t.Check( tkCodeEdit_Send( sw, SCI_GETSTYLEAT, instr( tx, "get, set" ) + 4 ) = SCE_B_KEYWORD, P( sc, "get, set is" ) )
        t.Check( tkCodeEdit_Send( sw, SCI_GETSTYLEAT, instr( tx, "private set" ) + 7 ) = SCE_B_KEYWORD, P( sc, "get, private set is" ) )
        t.Check( tkCodeEdit_Send( sw, SCI_GETSTYLEAT, instr( tx, "init" ) - 1 ) = SCE_B_KEYWORD, P( sc, "get, init is" ) )
        t.Check( tkCodeEdit_Send( sw, SCI_GETSTYLEAT, instr( tx, "ustring" ) - 1 ) = SCE_B_KEYWORD, P( sc, "ustring is" ) )
        t.Check( tkCodeEdit_Send( sw, SCI_GETSTYLEAT, instr( tx, "as slice" ) + 2 ) = SCE_B_KEYWORD, P( sc, "slice is" ) )
        t.Check( tkCodeEdit_Send( sw, SCI_GETSTYLEAT, instr( tx, "uslice" ) - 1 ) = SCE_B_KEYWORD, P( sc, "uslice is" ) )
        t.Check( tkCodeEdit_Send( sw, SCI_GETSTYLEAT, instr( tx, "wslice" ) - 1 ) = SCE_B_KEYWORD, P( sc, "wslice is" ) )
        t.Check( tkCodeEdit_Send( sw, SCI_GETSTYLEAT, instr( tx, "a, set" ) + 2 ) <> SCE_B_KEYWORD, P( sc, "f( a, set ) is not" ) )
        v->SetText( keep )
        tkCodeEdit_Send( sw, SCI_DOCUMENTEND )
    end scope
    ' a long signature's calltip: one parameter per line (symboldb.FormatCallTip), so taller
    Chord( h, SDLK_RETURN, SDL_SCANCODE_RETURN, 0 )
    tkTest_PushText( h, "LongSignature(" )
    tkTest_PumpFor( h, 60 )
    cp.Close( )
    scope
        dim as TK_HOST ptr tp = tkCodeEdit_CallTipPopup( )
        dim as long tw, th
        if tp then
            tkTest_PumpFor( h, 30 )
            SDL_GetWindowSizeInPixels( tp->win, @tw, @th )
        end if
        t.Check( v->CallTipShown( ) andalso (shortTipH > 0) andalso (th >= 3 * shortTipH), _
                 P( sc, strings.Format( "LongSignature's calltip, a line per parameter: {} px tall, one line {}", th, shortTipH ) ) )
    end scope
    v->CancelCallTip( )
    v->SetSavePoint( )
    ' ---- not in a file that is not source: the same typing in notes.txt lists nothing
    dim as ustring notesF = fs.PathJoin( dir_, "notes.txt" )
    fs.WriteAllText( notesF, "" )
    mw.OpenFile( notesF )
    v = @mw.View( )
    tkTest_PushText( h, "pt." )
    tkTest_PumpFor( h, 40 )
    tkTest_PushText( h, " Twi" )
    tkTest_PumpFor( h, 40 )
    Chord( h, SDLK_SPACE, SDL_SCANCODE_SPACE, KMOD_PRIMARY )
    t.Check( (mw.Completer.IsOpen( ) = false) andalso (v->CallTipShown( ) = false), P( sc, "notes.txt: no completion list, typed or asked for" ) )
    v->SetSavePoint( )
    mw.Destroy( )

    ' ---- no tikoParser: the outline still feeds F4, Ctrl+P and F12
    dim as mainwin.Window m2
    m2.ConfigDir = FreshConfig( )
    m2.Ask = @ScriptedAsk
    m2.Pick = @ScriptedPick
    m2.NoParser = true
    t.Check( m2.Create( sc ), P( sc, "outline: a window without tikoParser" ) )
    if m2.form = 0 then exit sub
    m2.Show( )
    dim as TK_HOST ptr h2 = tkForm_Host( m2.form )
    m2.OpenFile( utilF )
    m2.OpenFile( mainF )
    t.Check( m2.Scanner.running = false, P( sc, "outline: no scanner" ) )
    Chord( h2, SDLK_P, SDL_SCANCODE_P, KMOD_PRIMARY or SDL_KMOD_SHIFT )
    t.Check( m2.Chooser.IsOpen( ) andalso (m2.Chooser.ShownCount( ) = 2), P( sc, strings.Format( "outline: F4 lists two ({})", m2.Chooser.ShownCount( ) ) ) )
    PopKey( m2, SDLK_ESCAPE, SDL_SCANCODE_ESCAPE )
    m2.View( ).GoToLine( 15, 2 )                                  ' "Show( pt )"
    Chord( h2, SDLK_F12, SDL_SCANCODE_F12, 0 )
    t.Check( m2.View( ).CaretLine( ) = 10, P( sc, strings.Format( "outline: F12 found Show, line {}", m2.View( ).CaretLine( ) ) ) )
    m2.Destroy( )
end sub

' ================================================================ P6: Find in Project

public sub PolishPass( byref t as Tally, byval sc as single )
    dim as ustring dir_ = fs.PathJoin( Files( ), "polish" )
    fs.CreateDirAll( dir_ )
    dim as ustring nl = chr( 10 )
    dim as ustring mainF = fs.PathJoin( dir_, "main.tiko" ), libF = fs.PathJoin( dir_, "lib.tiko" )
    dim as ustring hdrF = fs.PathJoin( dir_, "lib.ti" )
    fs.WriteAllText( mainF, "#include ""lib.ti""" & nl & "print Needle( )" & nl )
    fs.WriteAllText( libF, "function Needle( ) as long" & nl & "    return 1 ' needle" & nl & "end function" & nl )
    fs.WriteAllText( hdrF, "declare function Needle( ) as long" & nl )
    dim as mainwin.Window mw
    mw.ConfigDir = FreshConfig( )
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    mw.Launch = @ScriptedLaunch
    mw.NoParser = true
    t.Check( mw.Create( sc ), P( sc, "polish: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )

    ' ---- Ctrl+Shift+F: every project file, unopened ones and unsaved edits too
    mw.OpenFile( mainF )
    mw.Execute( Cmd.ProjectSaveAs )               ' a tiko.toml there: its folder's files are the project's
    mw.View( ).ReplaceAllText( "#include ""lib.ti""" & nl & "print Needle( ) + Needle( )" & nl )   ' unsaved
    Chord( h, SDLK_F, SDL_SCANCODE_F, KMOD_PRIMARY or SDL_KMOD_SHIFT )
    t.Check( mw.Finder.isOpen andalso (mw.Finder.Mode = findstrip.StripMode.Project), P( sc, "Ctrl+Shift+F: the strip, In files" ) )
    mw.Finder.SetPhrase( "needle" )
    StripKey( mw, SDLK_RETURN, SDL_SCANCODE_RETURN )
    t.Check( mw.Found.Count( ) = 5, P( sc, strings.Format( "five matches: two unsaved, two in lib.tiko, one in lib.ti ({})", mw.Found.Count( ) ) ) )
    t.Check( (mw.Finder.isOpen = false) andalso mw.OutputShown andalso (mw.Out.current = outputpane.OutputTab.Search), _
             P( sc, "the Search tab shows them" ) )
    t.Check( tkListTree_GetCount( mw.Out.search ) = 8, P( sc, strings.Format( "three headers + five rows ({})", tkListTree_GetCount( mw.Out.search ) ) ) )
    t.Check( instr( mw.Message, "5 matches in 3 files" ) = 1, P( sc, "the message: " & mw.Message ) )
    t.Check( (lcase( mw.ActivePath( ) ) = lcase( mainF )) andalso (mw.View( ).SelectedText( ) = "Needle"), P( sc, "the first match selected" ) )
    ' one click on the row of lib.tiko's first match (not open yet)
    scope
        dim as long hit = -1
        for k as long = mw.Found.Count( ) - 1 to 0 step -1
            if lcase( mw.Found[k].Path ) = lcase( libF ) then hit = k
        next
        dim as long row = -1
        for r as long = 0 to tkListTree_GetCount( mw.Out.search ) - 1
            if (hit >= 0) andalso (tkListTree_GetItemData( mw.Out.search, r ) = hit) then row = r
        next
        dim as TK_WIDGET ptr surf = tkListTree_GetSurface( mw.Out.search )
        dim as TKRECT sa
        tkWidget_AbsRect( surf, sa )
        dim as long ih = tkListTree_GetItemHeightPx( mw.Out.search )
        dim as long ry = sa.top + (row - tkListTree_GetTopIndex( mw.Out.search )) * ih + ih \ 2
        t.Check( (row >= 0) andalso (ry < sa.bottom), P( sc, strings.Format( "lib.tiko's first match is row {}, on screen at y {}", row, ry ) ) )
        tkTest_Click( h, sa.left + 40, ry )
        tkTest_PumpFor( h, 60 )
    end scope
    t.Check( (lcase( mw.ActivePath( ) ) = lcase( libF )) andalso (mw.View( ).CaretLine( ) = 1), P( sc, "one click on a match in an unopened file opens it there: " & mw.ActivePath( ) ) )
    Chord( h, SDLK_F, SDL_SCANCODE_F, KMOD_PRIMARY or SDL_KMOD_SHIFT )
    dim as editor.FindOptions o = mw.Finder.Options( )
    o.MatchCase = true
    mw.Finder.SetOptions( o )
    mw.Finder.SetPhrase( "needle" )
    StripKey( mw, SDLK_RETURN, SDL_SCANCODE_RETURN )
    t.Check( mw.Found.Count( ) = 1, P( sc, strings.Format( "Match Case: only the comment ({})", mw.Found.Count( ) ) ) )
    Chord( h, SDLK_F, SDL_SCANCODE_F, KMOD_PRIMARY or SDL_KMOD_SHIFT )
    o.MatchCase = false
    o.Regex = true
    mw.Finder.SetOptions( o )
    mw.Finder.SetPhrase( "Need(le" )
    StripKey( mw, SDLK_RETURN, SDL_SCANCODE_RETURN )
    t.Check( mw.Finder.isOpen andalso (mw.Finder.status = "not a valid regular expression"), P( sc, "a bad regex says so: " & mw.Finder.status ) )
    mw.Finder.SetPhrase( "Need[l]e\(" )
    StripKey( mw, SDLK_RETURN, SDL_SCANCODE_RETURN )
    t.Check( mw.Found.Count( ) = 4, P( sc, strings.Format( "a regex: the four calls and declarations ({})", mw.Found.Count( ) ) ) )

    for each d as DocRef in mw.Docs
        d->Main.SetSavePoint( )
    next
    mw.Destroy( )
end sub

' ---- one tkEdit ([ui] single_instance): what a second launch posts to the inbox opens here, the
' timer waits while a modal runs, and the setting takes and lets go of the lock live.
public sub InboxPass( byref t as Tally, byval sc as single )
    dim as mainwin.Window mw
    mw.ConfigDir = FreshConfig( )
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    t.Check( mw.Create( sc ), P( sc, "inbox: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    dim as fs.FileLock g
    mw.ServeInbox( @g )
    t.Check( g.IsHeld( ) andalso (mw.inboxTimer <> 0), P( sc, "the first window holds the lock and reads the inbox" ) )
    dim as fs.FileLock other
    t.Check( instance.Claim( other, mw.ConfigDir ) = false, P( sc, "a second launch cannot claim it" ) )
    tkTest_PumpFor( h, 100 )

    dim as ustring dir_ = Files( )
    dim as ustring pathA = fs.PathJoin( dir_, "in a.tiko" ), pathB = fs.PathJoin( dir_, "inb.ti" )
    WriteBytes( pathA, "dim a as long" & chr( 10 ) )
    WriteBytes( pathB, "dim b as long" & chr( 10 ) )
    dim as Array( of ustring ) handed
    handed.Push( pathA )
    handed.Push( pathB )
    handed.Push( fs.PathJoin( dir_, "gone.tiko" ) )             ' deleted since: skipped
    t.Check( len( instance.Post( mw.ConfigDir, handed ) ) > 0, P( sc, "a message posted" ) )
    tkTest_PumpFor( h, 600 )
    t.Check( (mw.Docs.Count( ) = 2) andalso (mw.FindOpen( pathA ) <> 0) andalso (mw.FindOpen( pathB ) <> 0), _
             P( sc, strings.Format( "both files open, the missing one skipped ({} buffers)", mw.Docs.Count( ) ) ) )
    t.Check( lcase( mw.ActivePath( ) ) = lcase( pathB ), P( sc, "the last one handed over is active" ) )
    t.Check( instance.Take( mw.ConfigDir, instance.NowMs( ), 0 ).Count( ) = 0, P( sc, "the inbox is empty again" ) )

    dim as Array( of ustring ) none_
    instance.Post( mw.ConfigDir, none_ )
    tkTest_PumpFor( h, 600 )
    t.Check( (mw.Docs.Count( ) = 2) andalso (instance.Take( mw.ConfigDir, instance.NowMs( ), 0 ).Count( ) = 0), _
             P( sc, "a launch with no files: taken, no new buffer" ) )

    ' a modal up: the message waits
    dim as ustring pathC = fs.PathJoin( dir_, "c.tiko" )
    WriteBytes( pathC, "dim c as long" & chr( 10 ) )
    dim as Array( of ustring ) one_
    one_.Push( pathC )
    mw.modalDepth = 1
    instance.Post( mw.ConfigDir, one_ )
    tkTest_PumpFor( h, 600 )
    t.Check( mw.FindOpen( pathC ) = 0, P( sc, "while a modal runs the message waits" ) )
    mw.modalDepth = 0
    tkTest_PumpFor( h, 600 )
    t.Check( mw.FindOpen( pathC ) <> 0, P( sc, "and opens once it closes" ) )

    ' the setting, live
    dim as settings.EditorSettings st = mw.Prefs
    st.SingleInstance = false
    settings.WriteFile( mw.SettingsFile( ), st )
    mw.ReloadSettings( )
    t.Check( (g.IsHeld( ) = false) andalso (mw.inboxTimer = 0), P( sc, "single_instance = false lets go of the lock" ) )
    t.Check( instance.Claim( other, mw.ConfigDir ), P( sc, "so another launch could have it" ) )
    other.Release( )
    st.SingleInstance = true
    settings.WriteFile( mw.SettingsFile( ), st )
    mw.ReloadSettings( )
    t.Check( g.IsHeld( ) andalso (mw.inboxTimer <> 0), P( sc, "single_instance = true takes it again" ) )

    for each d as DocRef in mw.Docs
        d->Main.SetSavePoint( )
    next
    mw.Destroy( )
end sub

' ================================================================ the panes' scrollbars (tiko-editor's frmEditorScroll)

public sub ScrollPass( byref t as Tally, byval sc as single )
    dim as mainwin.Window mw
    mw.ConfigDir = FreshConfig( )
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    t.Check( mw.Create( sc ), P( sc, "scroll: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_PumpFor( h, 150 )
    mw.NewBlank( )                   ' out of the start panel: a buffer to type in
    dim as long cx = tkForm_Widget( mw.form )->cw
    dim as long vw = tkForm_Scale( mw.form, mainwin.VBAR_CX ), hh = tkForm_Scale( mw.form, mainwin.HBAR_CY )
    dim as TK_WIDGET ptr vb = mw.vbar( 0 ), hb = mw.hbar( 0 )
    dim as TKSCROLLBAR_STATE ptr vs = tkScrollBar_State( vb ), hs = tkScrollBar_State( hb )

    ' ---- one line: no vertical bar; under the view the horizontal bar's strip, the bar hidden
    dim as TK_WIDGET ptr v = mw.View( ).Widget( )
    t.Check( (tkWidget_IsVisible( vb ) = false) andalso (v->cw = cx), P( sc, strings.Format( "one line: no vertical bar, the view {} wide", v->cw ) ) )
    t.Check( (hb->x = v->x) andalso (hb->y = v->y + v->ch) andalso (hb->cw = v->cw) andalso (hb->ch = hh) andalso _
             (tkWidget_IsVisible( hb ) = false), P( sc, strings.Format( "the horizontal bar's strip under the view: {},{} {}x{}", hb->x, hb->y, hb->cw, hb->ch ) ) )
    dim as ulong track, thumb, divider
    chrome.ScrollBarColors( mw.Theme, track, thumb, divider )
    t.Check( (vs->BackColor = track) andalso (vs->ForeColor = thumb) andalso (vs->ForeColorHot = thumb) andalso vs->bHasDivider andalso _
             (vs->DividerColor = divider) andalso (hs->BackColor = track) andalso (hs->ForeColor = thumb), P( sc, "the bars in the editor's colours, flat" ) )

    ' ---- 300 lines, line 10 400 columns: the vertical bar down the pane's right; Scintilla's range
    dim as ustring path = fs.PathJoin( Files( ), "long.tiko" ), pathB = fs.PathJoin( Files( ), "short.tiko" )
    dim as string body
    for i as long = 1 to 300
        if i = 10 then
            body &= "' " & string( 400, "x" ) & chr( 10 )
        else
            body &= "dim x" & i & " as long" & chr( 10 )
        end if
    next
    WriteBytes( path, body )
    WriteBytes( pathB, "dim b as long" & chr( 10 ) )
    mw.OpenFile( pathB )
    mw.OpenFile( path )
    tkTest_PumpFor( h, 100 )
    v = mw.View( ).Widget( )
    t.Check( tkWidget_IsVisible( vb ) andalso (vb->x = v->x + v->cw) andalso (vb->y = v->y) andalso (vb->cw = vw) andalso _
             (vb->ch = v->ch + hh) andalso (v->cw = cx - vw), _
             P( sc, strings.Format( "the vertical bar at {},{} {}x{}, the view {} wide", vb->x, vb->y, vb->cw, vb->ch, v->cw ) ) )
    t.Check( (vs->nTotal = 301) andalso (vs->nTotal = mw.View( ).DisplayLines( )) andalso (vs->nPage = mw.View( ).LinesOnScreen( )) andalso _
             (vs->nPage > 10) andalso (vs->nPos = 0), P( sc, strings.Format( "its range: {} rows, {} a page, at {}", vs->nTotal, vs->nPage, vs->nPos ) ) )

    ' ---- the view scrolls: the bar follows; the bar scrolls: the view follows
    Chord( h, SDLK_END, SDL_SCANCODE_END, KMOD_PRIMARY )
    tkTest_PumpFor( h, 60 )
    t.Check( (mw.View( ).FirstLine( ) = vs->nTotal - vs->nPage) andalso (vs->nPos = mw.View( ).FirstLine( )), _
             P( sc, strings.Format( "Ctrl+End: view and bar at the last page ({} {})", mw.View( ).FirstLine( ), vs->nPos ) ) )
    dim as long before = mw.View( ).FirstLine( )
    tkTest_PushMotion( h, vb->x + vb->cw \ 2, vb->y + 2 )
    tkTest_Click( h, vb->x + vb->cw \ 2, vb->y + 2 )
    tkTest_PumpFor( h, 60 )
    t.Check( (mw.View( ).FirstLine( ) = before - vs->nPage) andalso (vs->nPos = mw.View( ).FirstLine( )) andalso _
             (tkHost_GetCapture( h ) = 0), P( sc, strings.Format( "a click above the thumb paged the view up: {}", mw.View( ).FirstLine( ) ) ) )
    dim as TKRECT rt = tkScrollBar_GetThumbRect( vb )
    dim as single tx = vb->x + (rt.left + rt.right) \ 2, ty = vb->y + (rt.top + rt.bottom) \ 2
    tkTest_PushMotion( h, tx, ty )
    tkTest_PushButton( h, true, tx, ty )
    tkTest_PushMotion( h, tx, vb->y )
    tkTest_PumpFor( h, 30 )
    t.Check( tkScrollBar_IsDragging( vb ) andalso (mw.View( ).FirstLine( ) = 0) andalso (vs->nPos = 0), _
             P( sc, strings.Format( "the thumb dragged to the top: the view at {}", mw.View( ).FirstLine( ) ) ) )
    tkTest_PushButton( h, false, tx, vb->y )
    tkTest_PushWheel( h, tx, vb->y + vb->ch \ 2, 0, -1 )
    tkTest_PumpFor( h, 30 )
    t.Check( (mw.View( ).FirstLine( ) = 3) andalso (vs->nPos = 3), P( sc, strings.Format( "a wheel notch on the bar: three lines, at {}", mw.View( ).FirstLine( ) ) ) )

    ' ---- the horizontal bar: there while the mouse is over the view or the bar, in pixels
    t.Check( tkWidget_IsVisible( hb ) = false, P( sc, "the mouse on the vertical bar: no horizontal bar" ) )
    tkTest_PushMotion( h, v->x + v->cw \ 2, v->y + v->ch \ 2 )
    tkTest_PumpFor( h, 30 )
    dim as long cw = mw.View( ).CharWidth( )
    t.Check( tkWidget_IsVisible( hb ) andalso (hb->cw = v->cw) andalso (hs->nPos = 0) andalso (hs->nTotal >= 400 * cw) andalso _
             (hs->nPage > 0) andalso (hs->nPage < v->cw) andalso (tkScrollBar_GetWheelStep( hb ) = 3 * cw), _
             P( sc, strings.Format( "the mouse over the view: the horizontal bar, {} px of {}, 3 x {} a notch", hs->nPage, hs->nTotal, cw ) ) )
    tkTest_PushMotion( h, hb->x + hb->cw - 4, hb->y + hb->ch \ 2 )
    tkTest_Click( h, hb->x + hb->cw - 4, hb->y + hb->ch \ 2 )
    tkTest_PumpFor( h, 60 )
    t.Check( tkWidget_IsVisible( hb ) andalso (mw.View( ).XOffset( ) = hs->nPage) andalso (hs->nPos = hs->nPage), _
             P( sc, strings.Format( "a click right of the thumb: the view a page sideways, x {}", mw.View( ).XOffset( ) ) ) )
    tkTest_PushMotion( h, mw.status->x + 10, mw.status->y + mw.status->ch \ 2 )
    tkTest_PumpFor( h, 30 )
    t.Check( tkWidget_IsVisible( hb ) = false, P( sc, "the mouse gone: the horizontal bar too" ) )
    Chord( h, SDLK_HOME, SDL_SCANCODE_HOME, KMOD_PRIMARY )
    tkTest_PumpFor( h, 60 )
    t.Check( (mw.View( ).XOffset( ) = 0) andalso (hs->nPos = 0) andalso (vs->nPos = 0), P( sc, "Ctrl+Home: both bars back at 0" ) )

    ' ---- the vertical bar comes and goes with the rows (a posted Layout: SCN_UPDATEUI comes mid-paint)
    mw.View( ).SetText( "short" )
    tkTest_PumpFor( h, 100 )
    t.Check( (tkWidget_IsVisible( vb ) = false) andalso (v->cw = cx), P( sc, "cut to one line: the vertical bar gone, the view full width" ) )
    mw.View( ).SetText( body )
    tkTest_PumpFor( h, 100 )
    t.Check( tkWidget_IsVisible( vb ) andalso (v->cw = cx - vw) andalso (vs->nTotal = 301), P( sc, "300 lines again: the bar back" ) )
    dim as long page0 = vs->nPage
    mw.Execute( Cmd.ZoomIn )
    mw.Execute( Cmd.ZoomIn )
    tkTest_PumpFor( h, 60 )
    t.Check( (vs->nPage < page0) andalso (vs->nPage = mw.View( ).LinesOnScreen( )), P( sc, strings.Format( "zoomed in: {} rows a page, was {}", vs->nPage, page0 ) ) )
    mw.Execute( Cmd.ZoomReset )

    ' ---- split: each pane its own bars, the vertical ones there even for a short buffer
    Chord( h, SDLK_BACKSLASH, SDL_SCANCODE_BACKSLASH, KMOD_PRIMARY )
    tkTest_PumpFor( h, 60 )
    if mw.Pane2 then
        dim as TK_WIDGET ptr v1 = mw.Pane1->Main.Widget( ), v2 = mw.Pane2->Main.Widget( )
        dim as TK_WIDGET ptr vb2 = mw.vbar( 1 ), hb2 = mw.hbar( 1 )
        t.Check( tkWidget_IsVisible( vb ) andalso tkWidget_IsVisible( vb2 ) andalso (vb->x = v1->x + v1->cw) andalso _
                 (vb2->x = v2->x + v2->cw) andalso (vb2->x + vb2->cw = cx) andalso (hb2->y = v2->y + v2->ch) andalso (hb2->x = v2->x), _
                 P( sc, strings.Format( "split: a vertical bar beside each pane ({} {})", vb->x, vb2->x ) ) )
        t.Check( tkScrollBar_State( vb2 )->nTotal = mw.Pane2->Main.DisplayLines( ), P( sc, "pane 2's bar holds pane 2's rows" ) )
        Chord( h, SDLK_BACKSLASH, SDL_SCANCODE_BACKSLASH, KMOD_PRIMARY )
        tkTest_PumpFor( h, 60 )
    end if
    t.Check( (mw.Pane2 = 0) andalso (tkWidget_IsVisible( mw.vbar( 1 ) ) = false) andalso (tkWidget_IsVisible( mw.hbar( 1 ) ) = false), _
             P( sc, "unsplit: pane 2's bars gone" ) )

    for each d as DocRef in mw.Docs
        d->Main.SetSavePoint( )
    next
    mw.Destroy( )
end sub

' No buffer open (author 2026-11-02): the start panel in the panes' place -- five commands, centred,
' each with the keys in force; a click, or Up/Down and Enter, runs one; what needs a buffer does
' nothing; closing the last buffer brings it back.
' ================================================================ the explorer ([ui] explorer)

private sub SetExplorerKeys( byref mw as mainwin.Window, byref keys as const ustring )
    fs.WriteAtomic( mw.SettingsFile( ), "version = 1" & chr( 10 ) & "[ui]" & chr( 10 ) & keys & chr( 10 ) )
    mw.ReloadSettings( )
    tkTest_PumpFor( tkForm_Host( mw.form ), 60 )
end sub

' One click on the visible row, in the row's middle (past any twisty).
private sub ClickSideRow( byref mw as mainwin.Window, byval vis as long )
    dim as TKRECT a
    tkWidget_AbsRect( mw.Side.rows, a )
    dim as long ih = tkListTree_GetItemHeightPx( mw.Side.rows )
    tkTest_Click( tkForm_Host( mw.form ), (a.left + a.right) \ 2, a.top + vis * ih + ih \ 2 )
    tkTest_PumpFor( tkForm_Host( mw.form ), 60 )
end sub

' Drags a bar by dx pixels along x.
private sub DragBarBy( byref mw as mainwin.Window, byval bar as TK_WIDGET ptr, byval dx as long )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    dim as single px = bar->x + bar->cw \ 2, py = bar->y + bar->ch \ 2
    tkTest_PushMotion( h, px, py )
    tkTest_PushButton( h, true, px, py )
    tkTest_PushMotion( h, px + dx, py )
    tkTest_PushButton( h, false, px + dx, py )
    tkTest_PumpFor( h, 60 )
end sub

public sub ExplorerPass( byref t as Tally, byval sc as single )
    dim as mainwin.Window mw
    mw.ConfigDir = FreshConfig( )
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    t.Check( mw.Create( sc ), P( sc, "explorer: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_PumpFor( h, 150 )
    dim as long cx = h->root->cw, cy = h->root->ch, mh = mw.MenuHeight( ), bar = tkForm_Scale( mw.form, 5 ), sh = mw.StatusHeight( )
    dim as ustring dir_ = Files( ), nl = wchr( 10 )
    dim as ustring pathA = fs.PathJoin( dir_, "a.tiko" ), pathB = fs.PathJoin( dir_, "b.tiko" )
    WriteBytes( pathA, "dim a as long" & chr( 10 ) )
    WriteBytes( pathB, "dim b as long" & chr( 10 ) )
    mw.OpenFile( pathA )
    mw.OpenFile( pathB )

    ' ---- off in a new settings.toml
    dim as ustring st = fs.ReadAllText( mw.SettingsFile( ) ).ValueOr( "" )
    t.Check( (instr( st, nl & "explorer = false" ) > 0) andalso (instr( st, nl & "explorer_side = 'left'" ) > 0), P( sc, "explorer: a new settings.toml has it off, on the left" ) )
    t.Check( (tkWidget_IsVisible( mw.Side.frame ) = false) andalso (tkWidget_IsVisible( mw.sideBar ) = false) andalso (mw.tabs->x = 0) andalso (mw.tabs->cw = cx), _
             P( sc, "explorer: off, the panel and its bar are gone" ) )

    ' ---- on, left: the panel from under the menu bar to the bottom, the bar, then everything else
    SetExplorerKeys( mw, "explorer = true" )
    dim as long sw = mw.SideWidth( )
    dim as TK_WIDGET ptr vv = mw.View( ).Widget( )
    t.Check( tkWidget_IsVisible( mw.Side.frame ) andalso (mw.Side.frame->x = 0) andalso (mw.Side.frame->y = mh) andalso _
             (mw.Side.frame->cw = sw) andalso (mw.Side.frame->ch = cy - mh - sh) andalso (sw = tkForm_Scale( mw.form, 220 )), _
             P( sc, strings.Format( "explorer: left, at {},{} {}x{}", mw.Side.frame->x, mw.Side.frame->y, mw.Side.frame->cw, mw.Side.frame->ch ) ) )
    t.Check( tkWidget_IsVisible( mw.sideBar ) andalso (mw.sideBar->x = sw) andalso (mw.sideBar->cw = bar) andalso (mw.sideBar->y = mh) andalso (mw.sideBar->ch = cy - mh - sh), _
             P( sc, strings.Format( "explorer: the vertical bar at {} {}x{}", mw.sideBar->x, mw.sideBar->cw, mw.sideBar->ch ) ) )
    t.Check( (mw.tabs->x = sw + bar) andalso (mw.tabs->cw = cx - sw - bar) andalso (vv->x = sw + bar) andalso (mw.status->x = 0) andalso (mw.status->cw = cx) andalso (mw.status->y = cy - sh) andalso _
             (mw.menuBar->x = 0) andalso (mw.menuBar->cw = cx), P( sc, "explorer: tabs and editor beside it, the menu bar and status line across the window" ) )
    ' ---- no project: the open buffers, the active one selected, the header's caption alone
    t.Check( (tkListTree_GetCount( mw.Side.rows ) = 2) andalso (tkListTree_GetText( mw.Side.rows, 0 ) = "a.tiko") andalso (tkListTree_GetText( mw.Side.rows, 1 ) = "b.tiko") andalso _
             (tkListTree_GetCurSel( mw.Side.rows ) = 1), P( sc, strings.Format( "explorer: the two buffers in open order, b selected ({} rows)", tkListTree_GetCount( mw.Side.rows ) ) ) )
    t.Check( (mw.Side.Caption = "Explorer") andalso (mw.Side.ProjectName = ""), P( sc, "explorer: the header says Explorer, no project name" ) )
    t.Check( RowsDrawn( h, mw.Side.rows ), P( sc, "explorer: and draws the rows" ) )
    tkHost_RenderTo( h, false )
    scope
        dim as ulong c0
        dim as long n = tkTest_TonesIn( h, mw.Side.frame->x, mw.Side.frame->y, sw, mw.Side.rows->y, c0 )
        t.Check( n > 2, P( sc, strings.Format( "explorer: and the header's text ({} tones)", n ) ) )
    end scope
    ClickSideRow( mw, 0 )
    t.Check( (mw.Active( )->DisplayName( ) = "a.tiko") andalso (tkListTree_GetCurSel( mw.Side.rows ) = 0) andalso (tkHost_GetFocus( h ) = mw.View( ).Widget( )), _
             P( sc, "explorer: one click shows that buffer, and the editor has the focus" ) )
    mw.View( ).ReplaceAllText( "dim a2 as long" & chr( 10 ) )
    tkTest_PumpFor( h, 60 )
    t.Check( tkListTree_GetText( mw.Side.rows, 0 ) = "a.tiko *", P( sc, "explorer: a modified buffer's row says so" ) )
    mw.View( ).Undo( )
    tkTest_PumpFor( h, 60 )

    ' ---- split left | right, the second pane past the first, both beside the panel
    mw.ToggleSplit( session.SplitMode.Vertical )
    tkTest_PumpFor( h, 60 )
    t.Check( (mw.Pane1->Main.Widget( )->x = sw + bar) andalso (mw.splitBar->x > sw + bar) andalso _
             (mw.Pane2->Main.Widget( )->x = mw.splitBar->x + bar) andalso (mw.status2->x = mw.splitBar->x + bar) andalso _
             (mw.status->x = 0) andalso (mw.status->cw = mw.splitBar->x) andalso (mw.status2->x + mw.status2->cw = cx), P( sc, "explorer: a left/right split stays beside it, its status lines fill the row" ) )
    dim as long oldW1 = mw.splitBar->x - (sw + bar)
    DragBarBy( mw, mw.splitBar, tkForm_Scale( mw.form, 40 ) )
    t.Check( abs( mw.splitBar->x - (sw + bar) - (oldW1 + tkForm_Scale( mw.form, 40 )) ) <= 1, _
             P( sc, strings.Format( "explorer: the split's bar lands where it is dragged ({} from {})", mw.splitBar->x - (sw + bar), oldW1 ) ) )
    mw.ToggleSplit( session.SplitMode.Vertical )
    tkTest_PumpFor( h, 60 )

    ' ---- the bar resizes it, and session.toml keeps the width
    DragBarBy( mw, mw.sideBar, tkForm_Scale( mw.form, 60 ) )
    t.Check( (abs( mw.SideWidth( ) - (sw + tkForm_Scale( mw.form, 60 )) ) <= 1) andalso (mw.tabs->x = mw.SideWidth( ) + bar), _
             P( sc, strings.Format( "explorer: dragging the bar: {} wide, was {}", mw.SideWidth( ), sw ) ) )
    mw.SaveSession( )
    t.Check( instr( fs.ReadAllText( mw.SessionFile( ) ).ValueOr( "" ), "explorer_width = " & mw.SideCX ) > 0, _
             P( sc, strings.Format( "explorer: session.toml keeps explorer_width = {}", mw.SideCX ) ) )
    mw.SideCX = explorer.PANEL_CX
    mw.Layout( )

    ' ---- on the right: everything else from x = 0, the bar then the panel at the right edge
    SetExplorerKeys( mw, "explorer = true" & nl & "explorer_side = 'right'" )
    t.Check( (mw.Side.frame->x = cx - sw) andalso (mw.Side.frame->cw = sw) andalso (mw.sideBar->x = cx - sw - bar) andalso (mw.tabs->x = 0) andalso (mw.tabs->cw = cx - sw - bar) andalso _
             (mw.View( ).Widget( )->x = 0) andalso (mw.status->x = 0) andalso (mw.status->cw = cx), P( sc, strings.Format( "explorer: right, at {} and the bar at {}", mw.Side.frame->x, mw.sideBar->x ) ) )
    DragBarBy( mw, mw.sideBar, -tkForm_Scale( mw.form, 60 ) )
    t.Check( abs( mw.SideWidth( ) - (sw + tkForm_Scale( mw.form, 60 )) ) <= 1, P( sc, strings.Format( "explorer: right, dragging its bar left widens it: {}", mw.SideWidth( ) ) ) )
    mw.SideCX = explorer.PANEL_CX
    SetExplorerKeys( mw, "explorer = true" )

    ' ---- a project: its files as a tree, folders first, and its name in the header
    dim as ustring proj = fs.PathJoin( dir_, "demo" )
    fs.CreateDirAll( fs.PathJoin( proj, "src" ) )
    fs.CreateDirAll( fs.PathJoin( proj, "out" ) )
    fs.CreateDirAll( fs.PathJoin( proj, ".hidden" ) )
    WriteBytes( fs.PathJoin( proj, "main.tiko" ), "print 1" & chr( 10 ) )
    WriteBytes( fs.PathJoin( proj, "notes.txt" ), "notes" & chr( 10 ) )
    WriteBytes( fs.PathJoin( proj, "blob.dll" ), "MZ" & chr( 0 ) & "x" )    ' binary: not listed
    WriteBytes( fs.PathJoin( proj, "tiko.toml" ), "[package]" & chr( 10 ) & "name = ""demo""" & chr( 10 ) & "[target.demo]" & chr( 10 ) & "main = ""main.tiko""" & chr( 10 ) )
    WriteBytes( fs.PathJoin( proj, "src", "lib.tiko" ), "dim x as long" & chr( 10 ) )
    WriteBytes( fs.PathJoin( proj, "out", "skip.tiko" ), "dim y as long" & chr( 10 ) )
    WriteBytes( fs.PathJoin( proj, ".hidden", "skip.tiko" ), "dim z as long" & chr( 10 ) )
    t.Check( mw.OpenProject( fs.PathJoin( proj, "tiko.toml" ) ), P( sc, "explorer: the project opens" ) )
    tkTest_PumpFor( h, 60 )
    dim as ustring got = ""
    for r as long = 0 to tkListTree_GetCount( mw.Side.rows ) - 1
        got &= tkListTree_GetText( mw.Side.rows, r ) & ","
    next
    t.Check( got = "src,lib.tiko,main.tiko,notes.txt,tiko.toml,", P( sc, "explorer: the project's files, no out/ or dot-folders: " & got ) )
    t.Check( (tkListTree_GetLevel( mw.Side.rows, 1 ) = 1) andalso (tkListTree_GetLevel( mw.Side.rows, 2 ) = 0), P( sc, "explorer: lib.tiko under src" ) )
    t.Check( (mw.Side.ProjectName = "demo") andalso (mw.Side.HeaderProject( ) = "[demo]"), P( sc, "explorer: the header names the project, in brackets: " & mw.Side.HeaderProject( ) ) )
    t.Check( tkListTree_GetCurSel( mw.Side.rows ) = 2, P( sc, strings.Format( "explorer: main.tiko, the active buffer, selected ({})", tkListTree_GetCurSel( mw.Side.rows ) ) ) )
    ClickSideRow( mw, 3 )
    t.Check( fs.PathFileName( mw.ActivePath( ) ) = "notes.txt", P( sc, "explorer: one click opens a file that is not source: " & mw.ActivePath( ) ) )
    t.Check( tkListTree_GetCurSel( mw.Side.rows ) = 3, P( sc, "explorer: and its row follows" ) )
    ClickSideRow( mw, 0 )
    t.Check( tkListTree_IsCollapsed( mw.Side.rows, 0 ) andalso (tkListTree_GetVisibleCount( mw.Side.rows ) = 4), _
             P( sc, strings.Format( "explorer: a click folds a folder ({} rows)", tkListTree_GetVisibleCount( mw.Side.rows ) ) ) )
    ' a new file shows at the next scan, and a folded folder stays folded
    WriteBytes( fs.PathJoin( proj, "added.tiko" ), "dim q as long" & chr( 10 ) )
    mw.Side.Rescan( )
    t.Check( (tkListTree_GetText( mw.Side.rows, 2 ) = "added.tiko") andalso tkListTree_IsCollapsed( mw.Side.rows, 0 ), P( sc, "explorer: a rescan adds a new file, the folder still folded" ) )
    ClickSideRow( mw, 0 )
    t.Check( tkListTree_IsCollapsed( mw.Side.rows, 0 ) = false, P( sc, "explorer: a second click opens it" ) )

    ' ---- the project closes: the buffers again, no name; off: all as it was
    mw.CloseProject( )
    tkTest_PumpFor( h, 60 )
    t.Check( (mw.Side.ProjectName = "") andalso (tkListTree_GetCount( mw.Side.rows ) = 0), P( sc, strings.Format( "explorer: project closed: no name, no buffers ({} rows)", tkListTree_GetCount( mw.Side.rows ) ) ) )
    t.Check( mw.Start.frame->x = sw + bar, P( sc, "explorer: the start panel sits beside it" ) )
    SetExplorerKeys( mw, "explorer = false" )
    t.Check( (tkWidget_IsVisible( mw.Side.frame ) = false) andalso (mw.Start.frame->x = 0) andalso (mw.Start.frame->cw = cx), P( sc, "explorer: off again: the window is whole" ) )

    ' ---- Ctrl+B: there and gone, and settings.toml follows
    Chord( h, SDLK_B, SDL_SCANCODE_B, KMOD_PRIMARY )
    t.Check( tkWidget_IsVisible( mw.Side.frame ) andalso (mw.Start.frame->x = sw + bar) andalso (instr( fs.ReadAllText( mw.SettingsFile( ) ).ValueOr( "" ), nl & "explorer = true" ) > 0), _
             P( sc, "explorer: Ctrl+B shows it, and settings.toml says true" ) )
    Chord( h, SDLK_B, SDL_SCANCODE_B, KMOD_PRIMARY )
    t.Check( (tkWidget_IsVisible( mw.Side.frame ) = false) andalso (mw.Start.frame->x = 0) andalso (instr( fs.ReadAllText( mw.SettingsFile( ) ).ValueOr( "" ), nl & "explorer = false" ) > 0), _
             P( sc, "explorer: Ctrl+B again hides it, and settings.toml says false" ) )

    mw.Destroy( )
end sub

' ================================================================ a tab's right-click menu, Rename, Duplicate

private sub RightClickTab( byref mw as mainwin.Window, byval idx as long )
    dim as TKRECT rp, rt, ri, rx
    tkTabBar_GetTabParts( mw.tabs, idx, rp, rt, ri, rx )
    tkTest_Click( tkForm_Host( mw.form ), mw.tabs->x + (rt.left + rt.right) \ 2, mw.tabs->y + (rt.top + rt.bottom) \ 2, SDL_BUTTON_RIGHT )
    tkTest_PumpFor( tkForm_Host( mw.form ), 60 )
end sub

private sub PickTabRow( byref mw as mainwin.Window, byval row as long )
    dim as TKRECT ir
    dim as TK_HOST ptr ms = tkPopupMenu_Surface( mw.tabMenu )
    if (ms <> 0) andalso tkPopupMenu_GetItemRect( mw.tabMenu, row, ir ) then
        tkTest_Click( ms, (ir.left + ir.right) \ 2, (ir.top + ir.bottom) \ 2 )
        tkTest_PumpFor( tkForm_Host( mw.form ), 60 )
    end if
end sub

private function TabNames( byref mw as mainwin.Window ) as ustring
    dim as ustring s = ""
    for i as long = 0 to tkTabBar_GetCount( mw.tabs ) - 1
        s &= tkTabBar_GetText( mw.tabs, i ) & ","
    next
    return s
end function

dim shared as TK_HOST ptr gPumpHost
dim shared as SDL_WindowID gPumpWin
dim shared as boolean gPumpAlive

private sub PumpingSelect( byval m as TK_MENU ptr, byval id as long )
    dim as SDL_Event e
    e.type = SDL_EVENT_USER
    SDL_PushEvent( @e )
    tkHost_Pump( gPumpHost )
    gPumpAlive = (SDL_GetWindowFromID( gPumpWin ) <> 0)
end sub

public sub TabMenuPass( byref t as Tally, byval sc as single )
    dim as mainwin.Window mw
    mw.ConfigDir = FreshConfig( )
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    gAnswerCount = 0
    t.Check( mw.Create( sc ), P( sc, "tab menu: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_PumpFor( h, 150 )
    dim as ustring dir_ = Files( )
    dim as ustring names( 0 to 4 ) = { "a.tiko", "b.tiko", "c.tiko", "d.tiko", "e.tiko" }
    for i as long = 0 to 4
        WriteBytes( fs.PathJoin( dir_, names( i ) ), "dim v as long" & chr( 10 ) )
        mw.OpenFile( fs.PathJoin( dir_, names( i ) ) )
    next
    tkTest_PumpFor( h, 60 )

    ' ---- a right click makes the tab active and opens the menu, greyed for where it is
    RightClickTab( mw, 0 )
    t.Check( tkPopupMenu_IsOpen( mw.tabMenu ) andalso (mw.Active( )->DisplayName( ) = "a.tiko"), P( sc, "tab menu: a right click opens it, and that tab is active" ) )
    t.Check( tkPopupMenu_GetItemCount( mw.tabMenu ) = 12, P( sc, strings.Format( "tab menu: nine rows, three separators ({})", tkPopupMenu_GetItemCount( mw.tabMenu ) ) ) )
    t.Check( (tkPopupMenu_GetItemEnabled( mw.tabMenu, 9002 ) = false) andalso tkPopupMenu_GetItemEnabled( mw.tabMenu, 9003 ), P( sc, "tab menu: on the first tab, Left greyed, Right not" ) )
    tkPopupMenu_CloseChain( mw.tabMenu )
    tkTest_PumpFor( h, 60 )

    RightClickTab( mw, 3 )                       ' d: Close Tabs on the Right takes e
    PickTabRow( mw, 11 )
    t.Check( (TabNames( mw ) = "a.tiko,b.tiko,c.tiko,d.tiko,") andalso (mw.Active( )->DisplayName( ) = "d.tiko"), P( sc, "tab menu: Close Tabs on the Right: " & TabNames( mw ) ) )
    RightClickTab( mw, 1 )                       ' b: Close Tabs on the Left takes a
    PickTabRow( mw, 10 )
    t.Check( TabNames( mw ) = "b.tiko,c.tiko,d.tiko,", P( sc, "tab menu: Close Tabs on the Left: " & TabNames( mw ) ) )
    RightClickTab( mw, 1 )                       ' c: Close Others leaves it alone
    PickTabRow( mw, 9 )
    t.Check( TabNames( mw ) = "c.tiko,", P( sc, "tab menu: Close Others: " & TabNames( mw ) ) )
    RightClickTab( mw, 0 )
    t.Check( (tkPopupMenu_GetItemEnabled( mw.tabMenu, Cmd.FileCloseAll ) = false) andalso (tkPopupMenu_GetItemEnabled( mw.tabMenu, 9003 ) = false), P( sc, "tab menu: one tab: Close All and Right greyed" ) )

    ' ---- Rename, through the menu: the file moves, the buffer follows with its edits
    gPickPath = fs.PathJoin( dir_, "renamed.tiko" )
    PickTabRow( mw, 5 )
    t.Check( (mw.Active( )->DisplayName( ) = "renamed.tiko") andalso fs.IsFile( fs.PathJoin( dir_, "renamed.tiko" ) ) andalso (fs.IsFile( fs.PathJoin( dir_, "c.tiko" ) ) = false) andalso _
             (TabNames( mw ) = "renamed.tiko,"), P( sc, "rename: the file moved, the tab says so: " & TabNames( mw ) ) )
    mw.CheckDisk( )
    t.Check( mw.Active( )->ChangedOnDisk( ) = false, P( sc, "rename: not taken for a change on disk" ) )
    mw.View( ).ReplaceAllText( "dim edited as long" & chr( 10 ) )
    gPickPath = fs.PathJoin( dir_, "again.txt" )
    t.Check( mw.Execute( Cmd.FileRename ) andalso mw.Active( )->IsModified( ) andalso (instr( mw.View( ).Text( ), "edited" ) > 0) andalso _
             (instr( fs.ReadAllText( fs.PathJoin( dir_, "again.txt" ) ).ValueOr( "" ), "dim v" ) > 0), P( sc, "rename: edits stay in the buffer, unsaved; the disk keeps the old text" ) )
    t.Check( mw.View( ).IsHighlighted( ) = false, P( sc, "rename: .txt is no longer coloured" ) )

    ' ---- Duplicate: the buffer as it stands, name-1 then name-2, opened; the source is untouched
    t.Check( mw.Execute( Cmd.FileDuplicate ) andalso (mw.Active( )->DisplayName( ) = "again-1.txt") andalso _
             (instr( fs.ReadAllText( fs.PathJoin( dir_, "again-1.txt" ) ).ValueOr( "" ), "edited" ) > 0), P( sc, "duplicate: again-1.txt has the unsaved text, and is active" ) )
    t.Check( mw.Docs[0]->IsModified( ) andalso (mw.Docs[0]->DisplayName( ) = "again.txt"), P( sc, "duplicate: the source is as it was" ) )
    mw.ShowDoc( mw.Docs[0] )
    t.Check( mw.Execute( Cmd.FileDuplicate ) andalso (mw.Active( )->DisplayName( ) = "again-2.txt"), P( sc, "duplicate: the next free number" ) )

    ' ---- a name open in another buffer is refused; a buffer with no file has nothing to move
    gPickPath = fs.PathJoin( dir_, "again-1.txt" )
    mw.Execute( Cmd.FileRename )
    t.Check( (mw.Active( )->DisplayName( ) = "again-2.txt") andalso fs.IsFile( fs.PathJoin( dir_, "again-2.txt" ) ), P( sc, "rename: onto a file open elsewhere is refused" ) )
    mw.NewBlank( )
    t.Check( (mw.CanRun( Cmd.FileRename ) = false) andalso (mw.CanRun( Cmd.FileDuplicate ) = false), P( sc, "rename, duplicate: greyed for an untitled buffer" ) )

    ' ---- a command that pumps, as a real file dialog does, leaves the popup it came from alone until
    ' that click is over: the host is still on the stack (Rename is only ever run from a menu)
    gPumpHost = h
    gPumpAlive = false
    dim as TK_MENU ptr pm = tkPopupMenu_Create( h )
    tkPopupMenu_AddItem( pm, 1, "Pump" )
    tkPopupMenu_SetSelectCallback( pm, @PumpingSelect )
    tkPopupMenu_Show( pm, 40, 40 )
    tkTest_PumpFor( h, 60 )
    dim as TK_HOST ptr ps = tkPopupMenu_Surface( pm )
    dim as TKRECT pr
    if (ps <> 0) andalso tkPopupMenu_GetItemRect( pm, 0, pr ) then
        gPumpWin = ps->winId
        tkTest_Click( ps, (pr.left + pr.right) \ 2, (pr.top + pr.bottom) \ 2 )
        tkTest_PumpFor( h, 60 )
    end if
    t.Check( gPumpAlive, P( sc, "menu: a command's nested pump does not free the menu's surface" ) )
    t.Check( SDL_GetWindowFromID( gPumpWin ) = 0, P( sc, "menu: the surface goes once the click is over" ) )
    tkPopupMenu_Destroy( pm )
    mw.Destroy( )
end sub

' ================================================================ the menu bar ([ui] show_menu)

' Clicks the middle of the menu bar's item idx; the pump after it fires the dropdown's init-popup.
private sub ClickMenuTitle( byref mw as mainwin.Window, byval idx as long )
    dim as TKRECT rc
    tkMenuBar_GetItemRect( mw.menuBar, idx, rc )
    tkTest_Click( tkForm_Host( mw.form ), mw.menuBar->x + (rc.left + rc.right) \ 2, mw.menuBar->y + (rc.top + rc.bottom) \ 2 )
    tkTest_PumpFor( tkForm_Host( mw.form ), 60 )
end sub

' The row index of command id in the menu of its group: rows in table order, a separator where the
' table says (none above a menu's first row).
private function MenuRow( byval id as Cmd ) as long
    dim as cmdids.CommandTable t
    dim as long r = 0
    for each c as Cmd in t.InGroup( t.Info( id ).Group )
        if t.Info( c ).SepBefore andalso (r > 0) then r += 1
        if c = id then return r
        r += 1
    next
    return -1
end function

' Clicks command id's row in the open dropdown m.
private sub ClickMenuRow( byref mw as mainwin.Window, byval m as TK_MENU ptr, byval id as Cmd )
    dim as TKRECT ir
    dim as TK_HOST ptr ms = tkPopupMenu_Surface( m )
    if (ms <> 0) andalso tkPopupMenu_GetItemRect( m, MenuRow( id ), ir ) then
        tkTest_Click( ms, (ir.left + ir.right) \ 2, (ir.top + ir.bottom) \ 2 )
    end if
    tkTest_PumpFor( tkForm_Host( mw.form ), 60 )
end sub

public sub MenuPass( byref t as Tally, byval sc as single )
    dim as mainwin.Window mw
    mw.ConfigDir = FreshConfig( )
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    t.Check( mw.Create( sc ), P( sc, "menu: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_PumpFor( h, 150 )
    dim as long cx = h->root->cw, cy = h->root->ch, sh = mw.StatusHeight( )
    dim as long mh = tkForm_Scale( mw.form, 26 )

    ' ---- on by default (a new settings.toml): along the top, seven menus, the start panel below it
    t.Check( instr( fs.ReadAllText( mw.SettingsFile( ) ).ValueOr( "" ), chr( 10 ) & "show_menu = true" ) > 0, _
             P( sc, "menu: a new settings.toml says show_menu = true" ) )
    t.Check( tkWidget_IsVisible( mw.menuBar ) andalso (mw.menuBar->x = 0) andalso (mw.menuBar->y = 0) andalso _
             (mw.menuBar->cw = cx) andalso (mw.menuBar->ch = mh) andalso (mw.MenuHeight( ) = mh), _
             P( sc, strings.Format( "menu: the bar at {},{} {}x{}, want 0,0 {}x{}", mw.menuBar->x, mw.menuBar->y, mw.menuBar->cw, mw.menuBar->ch, cx, mh ) ) )
    t.Check( (tkMenuBar_GetItemCount( mw.menuBar ) = 7) andalso (tkMenuBar_GetItemText( mw.menuBar, 0 ) = "File") andalso _
             (tkMenuBar_GetItemText( mw.menuBar, 4 ) = "Build") andalso (tkMenuBar_GetItemText( mw.menuBar, 5 ) = "Debug"), _
             P( sc, strings.Format( "menu: seven menus, File .. Debug, Form ({})", tkMenuBar_GetItemCount( mw.menuBar ) ) ) )
    dim as cmdids.CommandTable ct
    dim as boolean rowsOk = true
    for g as long = 0 to clng( MenuGroup.Count_ ) - 1
        dim as Array( of Cmd ) ids = ct.InGroup( cast( MenuGroup, g ) )
        dim as TK_MENU ptr m = tkMenuBar_GetDropDown( mw.menuBar, g )
        dim as long last_ = MenuRow( ids[ids.Count( ) - 1] )
        if (m = 0) orelse (tkPopupMenu_GetItemCount( m ) <> last_ + 1) then rowsOk = false
    next
    t.Check( rowsOk, P( sc, "menu: every command a row of its group's menu, the separators between" ) )
    t.Check( mw.Start.frame->y = mh, P( sc, strings.Format( "menu: the start panel under it ({})", mw.Start.frame->y ) ) )

    ' ---- File opens on a click; with no buffer what acts on one is greyed
    ClickMenuTitle( mw, 0 )
    dim as TK_MENU ptr fm = tkMenuBar_GetDropDown( mw.menuBar, 0 )
    t.Check( tkMenuBar_IsMenuOpen( mw.menuBar ) andalso tkPopupMenu_IsOpen( fm ), P( sc, "menu: a click on File opened it" ) )
    t.Check( tkPopupMenu_GetItemEnabled( fm, Cmd.FileNew ) andalso tkPopupMenu_GetItemEnabled( fm, Cmd.FileOpen ) andalso _
             (tkPopupMenu_GetItemEnabled( fm, Cmd.FileSave ) = false) andalso (tkPopupMenu_GetItemEnabled( fm, Cmd.FileClose ) = false), _
             P( sc, "menu: start panel: New and Open work, Save and Close greyed" ) )
    ' a row runs its command: New, the start panel gives way to the buffer
    ClickMenuRow( mw, fm, Cmd.FileNew )
    t.Check( (tkPopupMenu_IsOpen( fm ) = false) andalso mw.Chooser.IsOpen( ) andalso (mw.Choosing = mainwin.PickKind.NewItem), _
             P( sc, "menu: File > New closed the menu and opened its picker" ) )
    Chord( h, SDLK_RETURN, SDL_SCANCODE_RETURN, 0 )
    t.Check( (mw.Chooser.IsOpen( ) = false) andalso (mw.ShowsStart( ) = false), P( sc, "menu: Enter: Blank File, the start panel gave way" ) )
    ClickMenuTitle( mw, 0 )
    t.Check( tkPopupMenu_GetItemEnabled( fm, Cmd.FileSave ), P( sc, "menu: with a buffer, Save works" ) )
    tkMenuBar_CloseMenu( mw.menuBar )
    tkTest_PumpFor( h, 60 )

    ' ---- Debug, no session: Start and the breakpoint rows work, the session's rows are greyed
    ClickMenuTitle( mw, clng( MenuGroup.Debug ) )
    dim as TK_MENU ptr dm = tkMenuBar_GetDropDown( mw.menuBar, clng( MenuGroup.Debug ) )
    t.Check( tkPopupMenu_GetItemEnabled( dm, Cmd.StartDebugging ) andalso tkPopupMenu_GetItemEnabled( dm, Cmd.ToggleBreakpoint ) andalso _
             tkPopupMenu_GetItemEnabled( dm, Cmd.DeleteAllBreakpoints ) andalso (tkPopupMenu_GetItemEnabled( dm, Cmd.StepOver ) = false) andalso _
             (tkPopupMenu_GetItemEnabled( dm, Cmd.DebugBreak ) = false) andalso (tkPopupMenu_GetItemEnabled( dm, Cmd.StopDebugging ) = false) andalso _
             (tkPopupMenu_GetItemEnabled( dm, Cmd.RunToCursor ) = false), _
             P( sc, "menu: Debug, no session: Start and breakpoints work, Step/Break/Stop/Run to Cursor greyed" ) )
    dim as long si = dm->FindItem( clng( Cmd.StartDebugging ) )
    t.Check( (si >= 0) andalso (dm->items(si).wszAccel = "F6"), P( sc, "menu: Debug: Start Debugging shows F6 once the menu has opened" ) )
    tkMenuBar_CloseMenu( mw.menuBar )
    tkTest_PumpFor( h, 60 )

    ' ---- breakpoints: F9 toggles one; a margin click is a bookmark or a breakpoint ([editor] margin_click)
    mw.View( ).SetText( "dim as long a" & chr( 10 ) & "a = 1" & chr( 10 ) & "a += 2" & chr( 10 ) & "print a" & chr( 10 ) )
    mw.View( ).GoToLine( 1 )
    Chord( h, SDLK_F9, SDL_SCANCODE_F9, 0 )
    t.Check( mw.View( ).HasBreakpoint( 1 ) andalso (mw.View( ).Bookmarks( ).Count( ) = 0), P( sc, "breakpoint: F9 set one, no bookmark" ) )
    dim as long p3 = tkCodeEdit_Send( mw.View( ).Widget( ), SCI_POSITIONFROMLINE, 3 )
    mw.OnMarginClick( mw.View( ).Widget( ), 1, p3 )
    t.Check( mw.View( ).HasBookmark( 3 ) andalso (mw.View( ).HasBreakpoint( 3 ) = false), P( sc, "breakpoint: margin_click = bookmark (the default): a bookmark" ) )
    mw.Prefs.MarginClick = settings.MarginAction.Breakpoint
    mw.OnMarginClick( mw.View( ).Widget( ), 1, p3 )
    t.Check( mw.View( ).HasBreakpoint( 3 ) andalso mw.View( ).HasBookmark( 3 ), P( sc, "breakpoint: margin_click = breakpoint: a breakpoint" ) )
    dim as Array( of long ) bps = mw.View( ).Breakpoints( )
    t.Check( (bps.Count( ) = 2) andalso (bps[0] = 1) andalso (bps[1] = 3), P( sc, strings.Format( "breakpoint: lines 1 and 3 ({})", bps.Count( ) ) ) )
    Chord( h, SDLK_F9, SDL_SCANCODE_F9, KMOD_PRIMARY or SDL_KMOD_SHIFT )
    t.Check( mw.View( ).Breakpoints( ).Count( ) = 0, P( sc, "breakpoint: Ctrl+Shift+F9 deleted them all" ) )
    mw.View( ).ClearBookmarks( )
    mw.Prefs.MarginClick = settings.MarginAction.Bookmark

    ' ---- under it the tab strip, then the editor
    dim as TK_WIDGET ptr v = mw.View( ).Widget( )
    dim as long top = mh + mw.TabsHeight( )
    t.Check( (mw.tabs->y = mh) andalso (v->y = top) andalso (PaneCH( mw, v ) = cy - sh - top), _
             P( sc, strings.Format( "menu: the tabs at {}, the editor at {} h {}", mw.tabs->y, v->y, PaneCH( mw, v ) ) ) )

    ' ---- View > Output: a row runs the same command as its key
    ClickMenuTitle( mw, clng( MenuGroup.View ) )
    ClickMenuRow( mw, tkMenuBar_GetDropDown( mw.menuBar, clng( MenuGroup.View ) ), Cmd.OutputPane )
    t.Check( mw.OutputShown, P( sc, "menu: View > Output showed the output pane" ) )
    mw.ShowOutput( false )

    ' ---- the Menu Bar row has its chord in force
    t.Check( mw.ShortcutText( Cmd.ShowMenu ) <> "", P( sc, "menu: Menu Bar has a chord (" & mw.ShortcutText( Cmd.ShowMenu ) & ")" ) )

    ' ---- Ctrl+Shift+M hides it and says so in settings.toml; again brings it back
    Chord( h, SDLK_M, SDL_SCANCODE_M, KMOD_PRIMARY or SDL_KMOD_SHIFT )
    v = mw.View( ).Widget( )
    t.Check( (tkWidget_IsVisible( mw.menuBar ) = false) andalso (mw.MenuHeight( ) = 0) andalso (mw.tabs->y = 0) andalso _
             (v->y = mw.TabsHeight( )), P( sc, strings.Format( "menu: Ctrl+Shift+M hid it: tabs at {}, editor at {}", mw.tabs->y, v->y ) ) )
    t.Check( instr( fs.ReadAllText( mw.SettingsFile( ) ).ValueOr( "" ), chr( 10 ) & "show_menu = false" ) > 0, _
             P( sc, "menu: and settings.toml says show_menu = false" ) )
    Chord( h, SDLK_M, SDL_SCANCODE_M, KMOD_PRIMARY or SDL_KMOD_SHIFT )
    t.Check( tkWidget_IsVisible( mw.menuBar ) andalso (mw.tabs->y = mh) andalso _
             (instr( fs.ReadAllText( mw.SettingsFile( ) ).ValueOr( "" ), chr( 10 ) & "show_menu = true" ) > 0), _
             P( sc, "menu: again: back, and settings.toml says true" ) )

    ' ---- settings.toml show_menu = false, saved: gone
    fs.WriteAtomic( mw.SettingsFile( ), "version = 1" & chr( 10 ) & "[ui]" & chr( 10 ) & "show_menu = false" & chr( 10 ) )
    mw.ReloadSettings( )
    tkTest_PumpFor( h, 60 )
    t.Check( (tkWidget_IsVisible( mw.menuBar ) = false) andalso (mw.tabs->y = 0), P( sc, "menu: show_menu = false in settings.toml hides it" ) )

    ' ---- the titles and rows in the interface's language
    fs.WriteAtomic( mw.SettingsFile( ), "version = 1" & chr( 10 ) & "[ui]" & chr( 10 ) & "language = 'de'" & chr( 10 ) )
    mw.ReloadSettings( )
    tkTest_PumpFor( h, 60 )
    t.Check( tkWidget_IsVisible( mw.menuBar ) andalso (tkMenuBar_GetItemText( mw.menuBar, 0 ) = "Datei") andalso _
             (tkMenuBar_GetItemText( mw.menuBar, clng( MenuGroup.View ) ) = "Ansicht"), _
             P( sc, strings.Format( "menu: de: {} .. {}", tkMenuBar_GetItemText( mw.menuBar, 0 ), tkMenuBar_GetItemText( mw.menuBar, clng( MenuGroup.View ) ) ) ) )

    for each d as DocRef in mw.Docs
        d->Main.SetSavePoint( )
    next
    mw.Destroy( )
end sub

public sub StartPass( byref t as Tally, byval sc as single )
    dim as mainwin.Window mw
    mw.ConfigDir = FreshConfig( )
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    t.Check( mw.Create( sc ), P( sc, "start: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_PumpFor( h, 150 )
    dim as TK_WIDGET ptr sp = mw.Start.frame
    dim as long cx = h->root->cw, cy = h->root->ch, sh = mw.StatusHeight( )

    ' ---- in the panes' place, no tab strip, no view, no bars; the focus is its own
    t.Check( mw.ShowsStart( ) andalso (mw.Docs.Count( ) = 1) andalso (mw.TabsHeight( ) = 0) andalso (tkWidget_IsVisible( mw.tabs ) = false), _
             P( sc, "start: shown at the start, one (blank) buffer, no tab strip" ) )
    dim as long mh = mw.MenuHeight( )
    t.Check( tkWidget_IsVisible( sp ) andalso (sp->x = 0) andalso (sp->y = mh) andalso (sp->cw = cx) andalso (sp->ch = cy - sh - mh), _
             P( sc, strings.Format( "start: at {},{} {}x{}, want 0,{} {}x{}", sp->x, sp->y, sp->cw, sp->ch, mh, cx, cy - sh - mh ) ) )
    t.Check( (tkWidget_IsVisible( mw.Pane1->Main.Widget( ) ) = false) andalso (tkWidget_IsVisible( mw.vbar( 0 ) ) = false) andalso _
             (tkWidget_IsVisible( mw.hbar( 0 ) ) = false), P( sc, "start: the blank buffer's view and its bars hidden" ) )

    ' ---- nothing open, no project: a row is live only if it would do something
    dim as Cmd liveIds( 0 to 10 ) = { Cmd.FileNew, Cmd.FileOpen, Cmd.Settings, Cmd.KeyboardShortcuts, Cmd.ThemeFile, Cmd.AppExit, _
                                      Cmd.ShowMenu, Cmd.ShowExplorer, Cmd.OutputPane, Cmd.FormNewForm, Cmd.BuildConfig }
    dim as Cmd deadIds( 0 to 18 ) = { Cmd.FileCloseAll, Cmd.FileSaveAll, Cmd.FileRecent, Cmd.ProjectSaveAs, Cmd.ProjectClose, Cmd.SearchSymbol, Cmd.FindInProject, _
                                      Cmd.GoBack, Cmd.GoForward, Cmd.CycleFocus, Cmd.Compile, Cmd.BuildExecute, Cmd.RebuildAll, Cmd.RunExe, Cmd.RunArguments, _
                                      Cmd.NextDiagnostic, Cmd.PrevDiagnostic, Cmd.StartDebugging, Cmd.DeleteAllBreakpoints }
    dim as cmdids.CommandTable startTable
    dim as ustring wrongLive = "", wrongDead = ""
    for i as long = 0 to 10
        if mw.CanRun( liveIds( i ) ) = false then wrongLive &= startTable.Info( liveIds( i ) ).Name & " "
    next
    for i as long = 0 to 18
        if mw.CanRun( deadIds( i ) ) then wrongDead &= startTable.Info( deadIds( i ) ).Name & " "
    next
    t.Check( len( wrongLive ) = 0, P( sc, "start: what still acts is enabled; not: " & wrongLive ) )
    t.Check( len( wrongDead ) = 0, P( sc, "start: what has nothing to act on is greyed; live: " & wrongDead ) )
    t.Check( mw.SourceDoc( ) = 0, P( sc, "start: the hidden buffer is no source file" ) )
    mw.ShowOutput( true )
    t.Check( mw.CanRun( Cmd.CycleFocus ), P( sc, "start: with the output pane up, Next Pane works" ) )
    mw.ShowOutput( false )
    tkTest_PumpFor( h, 30 )
    t.Check( tkHost_GetFocus( h ) = sp, P( sc, "start: the panel has the focus" ) )
    t.Check( (mw.StatusText( mainwin.StatusPanel.Buffer ) = "") andalso (mw.StatusText( mainwin.StatusPanel.Position ) = "") andalso _
             (mw.StatusText( mainwin.StatusPanel.Encoding ) = "") andalso (mw.StatusText( mainwin.StatusPanel.LineEnding ) = "") andalso _
             (mw.StatusText( mainwin.StatusPanel.Build ) = "Debug"), P( sc, "start: the buffer's status panels empty, the build's not" ) )
    dim as ustring title = *SDL_GetWindowTitle( h->win )
    t.Check( title = appinfo.WindowTitle( ), P( sc, "start: the title names no buffer: " & title ) )

    ' ---- the rows: the commands, their names, their keys as the key map has them, their icons
    dim as Cmd want( 0 to 4 ) = { Cmd.FileNew, Cmd.KeyboardShortcuts, Cmd.FileRecent, Cmd.FileOpen, Cmd.Settings }
    dim as ustring names_( 0 to 4 ) = { "New File", "Show All Commands", "Open Recent", "Open File", "Show Settings" }
    t.Check( mw.Start.Rows.Count( ) = 5, P( sc, strings.Format( "start: five rows ({})", mw.Start.Rows.Count( ) ) ) )
    for i as long = 0 to mw.Start.Rows.Count( ) - 1
        if i > 4 then exit for
        dim as startpanel.Row r = mw.Start.Rows[i]
        dim as ustring caps = ""
        for each k as ustring in r.Keys
            if len( caps ) then caps &= "+"
            caps &= k
        next
        t.Check( (r.Tag = clng( want( i ) )) andalso (r.Label = names_( i )) andalso (caps = mw.ShortcutText( want( i ) )) andalso _
                 (len( caps ) > 0), P( sc, strings.Format( "start: row {} '{}' keys {}", i, r.Label, caps ) ) )
        t.Check( (mw.StartIcon <> 0) andalso TTF_FontHasGlyph( mw.StartIcon, r.Glyph ), _
                 P( sc, strings.Format( "start: PsIcons has row {}'s icon U+{}", i, hex( r.Glyph ) ) ) )
    next

    ' ---- the block centred, the rows stacked, the keycaps right-aligned in each row
    dim as TKRECT r0, rn, rk
    mw.Start.RowRect( 0, r0 )
    mw.Start.RowRect( mw.Start.Rows.Count( ) - 1, rn )
    dim as long rowH = tkForm_Scale( mw.form, startpanel.ROW_CY ), pad = tkForm_Scale( mw.form, startpanel.ROW_PAD )
    t.Check( (abs( r0.left - (sp->cw - r0.right) ) <= 1) andalso (abs( r0.top - (sp->ch - rn.bottom) ) <= 1) andalso _
             (r0.left > 0) andalso (r0.top > 0), _
             P( sc, strings.Format( "start: centred: {} left {} right, {} above {} below", r0.left, sp->cw - r0.right, r0.top, sp->ch - rn.bottom ) ) )
    dim as boolean stacked = true, aligned = true
    for i as long = 0 to mw.Start.Rows.Count( ) - 1
        dim as TKRECT ri
        mw.Start.RowRect( i, ri )
        if (ri.top <> r0.top + i * rowH) orelse (ri.bottom - ri.top <> rowH) orelse (ri.left <> r0.left) orelse (ri.right <> r0.right) then stacked = false
        mw.Start.KeysRect( i, rk )
        if (rk.right <> ri.right - pad) orelse (rk.top < ri.top) orelse (rk.bottom > ri.bottom) orelse (rk.left <= ri.left + pad) then aligned = false
    next
    t.Check( stacked, P( sc, "start: the rows stacked, one height, one width" ) )
    t.Check( aligned, P( sc, "start: each row's keycaps end at its right, inside it" ) )
    tkHost_RenderTo( h, false )
    dim as ulong bg = tkTest_PixelAt( h, sp->x + 2, sp->y + 2 ) and &hFFFFFFul
    t.Check( bg = (chrome.Argb( mw.Theme.EdBg ) and &hFFFFFFul), P( sc, strings.Format( "start: the editor's background (&h{})", hex( bg ) ) ) )
    dim as ulong c0
    t.Check( tkTest_TonesIn( h, sp->x + r0.left, sp->y + r0.top, r0.right - r0.left, rn.bottom - r0.top, c0 ) > 2, _
             P( sc, "start: the rows are drawn" ) )

    ' ---- what needs a buffer does nothing
    tkTest_PushText( h, "x" )
    tkTest_PumpFor( h, 30 )
    Chord( h, SDLK_BACKSLASH, SDL_SCANCODE_BACKSLASH, KMOD_PRIMARY )
    Chord( h, SDLK_E, SDL_SCANCODE_E, KMOD_PRIMARY )
    Chord( h, SDLK_W, SDL_SCANCODE_W, KMOD_PRIMARY )
    t.Check( mw.ShowsStart( ) andalso (mw.Docs.Count( ) = 1) andalso (mw.Pane1->Main.Length( ) = 0) andalso (mw.Pane2 = 0) andalso _
             (mw.Chooser.IsOpen( ) = false), P( sc, "start: typing, Ctrl+\, Ctrl+E and Ctrl+W did nothing" ) )

    ' ---- Down Down Enter: Show All Commands, keybindings.toml; closing it brings the panel back
    Chord( h, SDLK_DOWN, SDL_SCANCODE_DOWN, 0 )
    Chord( h, SDLK_DOWN, SDL_SCANCODE_DOWN, 0 )
    t.Check( mw.Start.Sel = 1, P( sc, strings.Format( "start: Down twice: row 1 ({})", mw.Start.Sel ) ) )
    Chord( h, SDLK_RETURN, SDL_SCANCODE_RETURN, 0 )
    t.Check( (mw.ShowsStart( ) = false) andalso (mw.Docs.Count( ) = 1) andalso (lcase( mw.ActivePath( ) ) = lcase( mw.KeysFile( ) )) andalso _
             (tkWidget_IsVisible( sp ) = false) andalso (mw.TabsHeight( ) > 0), _
             P( sc, "start: Enter opened keybindings.toml in the blank's place, tabs back" ) )
    Chord( h, SDLK_F, SDL_SCANCODE_F, KMOD_PRIMARY )
    t.Check( mw.Finder.isOpen, P( sc, "start: Ctrl+F in keybindings.toml opened the find strip" ) )
    Chord( h, SDLK_W, SDL_SCANCODE_W, KMOD_PRIMARY )
    t.Check( mw.ShowsStart( ) andalso (mw.Docs.Count( ) = 1) andalso tkWidget_IsVisible( sp ) andalso (tkHost_GetFocus( h ) = sp) andalso _
             (mw.Finder.isOpen = false) andalso (sp->ch = cy - sh - mh), P( sc, "start: closing the last buffer brought it back, focused, the strip closed" ) )

    ' ---- Ctrl+N: the blank buffer becomes a new one, in front, typed into
    Chord( h, SDLK_N, SDL_SCANCODE_N, KMOD_PRIMARY )
    Chord( h, SDLK_RETURN, SDL_SCANCODE_RETURN, 0 )     ' the New picker's first row: Blank File
    t.Check( (mw.ShowsStart( ) = false) andalso (mw.Docs.Count( ) = 1) andalso mw.Active( )->IsNew( ) andalso _
             (tkHost_GetFocus( h ) = mw.View( ).Widget( )), P( sc, "start: Ctrl+N: one untitled buffer, focused" ) )
    tkTest_PushText( h, "y" )
    tkTest_PumpFor( h, 30 )
    t.Check( mw.View( ).Text( ) = "y", P( sc, "start: and typed into: '" & mw.View( ).Text( ) & "'" ) )
    Answer( MBX_IDNO )                              ' don't save
    Chord( h, SDLK_W, SDL_SCANCODE_W, KMOD_PRIMARY )
    t.Check( mw.ShowsStart( ), P( sc, "start: closed unsaved: the panel again" ) )

    ' ---- a key changed in keybindings.toml changes its keycaps
    dim as ustring kt = fs.ReadAllText( mw.KeysFile( ) ).ValueOr( "" )
    t.Check( instr( kt, "FileNew = 'Primary+N'" ) > 0, P( sc, "start: keybindings.toml binds FileNew" ) )
    fs.WriteAtomic( mw.KeysFile( ), strings.Replace( kt, "FileNew = 'Primary+N'", "FileNew = 'Primary+Alt+J'" ) )
    mw.ReloadKeys( )
    dim as ustring caps0 = ""
    for each k as ustring in mw.Start.Rows[0].Keys
        caps0 &= "[" & k & "]"
    next
    t.Check( caps0 = "[" & platform.PrimaryModifierName( ) & "][Alt][J]", P( sc, "start: New File's keys follow the file: " & caps0 ) )

    mw.Destroy( )
end sub
