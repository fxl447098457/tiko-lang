' designerpass -- a .tkform on its design surface in the real window: everything through SDL events,
' at a pinned scale, with geometry asserted against the model.
#module "selftest"

#import "std/containers"
#import "std/fs"
#import "std/strings"
#import "tkc/cmdids"
#import "tka/documents"
#import "tka/mainwin"
#import "tkd/canvas"
#import "tkd/model"
#import "tkd/edits"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkPaint"
#import "vendor/tkControls/tkTabControl"
#import "vendor/tkControls/tkTabBar"
using containers
using cmdids
using tkApp
using tkHost
using tkTest
using tkPaint
using tkTabControl
using tkTabBar
using model

const as string FORM_TEXT = _
    !"format = 1\n\n[form]\ncaption = \"T\"\nwidth = 400\nheight = 320\n" & _
    !"\n[[control]]\nname = \"btnA\"\ntype = \"Button\"\nparent = \"\"\nx = 16\ny = 16\nw = 80\nh = 24\n" & _
    !"\n[control.props]\nText = \"A\"\n" & _
    !"\n[[control]]\nname = \"pnl\"\ntype = \"Panel\"\nparent = \"\"\nx = 16\ny = 56\nw = 200\nh = 104\n" & _
    !"\n[[control]]\nname = \"btnIn\"\ntype = \"Button\"\nparent = \"pnl\"\nx = 8\ny = 8\nw = 80\nh = 24\n" & _
    !"\n[[control]]\nname = \"lblB\"\ntype = \"Label\"\nparent = \"\"\nx = 240\ny = 16\nw = 100\nh = 24\nanchor = \"top right\"\n" & _
    !"\n[[control]]\nname = \"tabs\"\ntype = \"TabControl\"\nparent = \"\"\nx = 16\ny = 176\nw = 240\nh = 120\npages = [\"One\", \"Two\"]\n"

private sub DragPx( byval h as TK_HOST ptr, byval x0 as long, byval y0 as long, byval x1 as long, byval y1 as long )
    tkTest_PushMotion( h, x0, y0 )
    tkTest_PumpFor( h, 15 )
    tkTest_PushButton( h, true, x0, y0 )
    tkTest_PumpFor( h, 15 )
    tkTest_PushMotion( h, (x0 + x1) \ 2, (y0 + y1) \ 2 )
    tkTest_PumpFor( h, 15 )
    tkTest_PushMotion( h, x1, y1 )
    tkTest_PumpFor( h, 15 )
    tkTest_PushButton( h, false, x1, y1 )
    tkTest_PumpFor( h, 30 )
end sub

private sub ClickPx( byval h as TK_HOST ptr, byval x as long, byval y as long )
    tkTest_PushMotion( h, x, y )
    tkTest_PumpFor( h, 15 )
    tkTest_Click( h, x, y )
    tkTest_PumpFor( h, 30 )
end sub

private sub ClickOn( byval h as TK_HOST ptr, byval w as TK_WIDGET ptr )
    ClickPx( h, tkTest_CX( w ), tkTest_CY( w ) )
end sub

private function Ctl( byval c as canvas.FormCanvas ptr, byref n as const ustring ) byref as FormControl
    return c->Doc.Controls[FindControl( c->Doc, n )]
end function

private function SelText( byval c as canvas.FormCanvas ptr ) as ustring
    dim as ustring s
    for each n as ustring in c->Selected
        s &= n & " "
    next
    return rtrim( s )
end function

' Primary+letter, through the accelerator table.
private sub Primary( byval h as TK_HOST ptr, byval key as long, byval sc as long, byval more as long = 0 )
    Chord( h, key, sc, TK_KMOD_PRIMARY or more )
end sub

public sub DesignerPass( byref t as Tally, byval sc as single )
    dim as mainwin.Window mw
    mw.ConfigDir = FreshConfig( )
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    t.Check( mw.Create( sc ), P( sc, "designer: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_PumpFor( h, 150 )

    dim as ustring path = fs.PathJoin( mw.ConfigDir, "frmT.tkform" )
    fs.WriteAllText( path, FORM_TEXT )
    t.Check( mw.OpenFile( path ), P( sc, "designer: the form opens" ) )
    tkTest_PumpFor( h, 80 )
    dim as DocRef d = mw.Active( )
    dim as canvas.FormCanvas ptr c = d->Designer
    t.Check( c <> 0, P( sc, "designer: on a design surface" ) )
    if c = 0 then
        mw.Destroy( )
        exit sub
    end if

    ' ---- what shows, and where
    t.Check( tkWidget_IsVisible( c->Frame ), P( sc, "the surface shows" ) )
    t.Check( tkWidget_IsVisible( d->Main.Widget( ) ) = false, P( sc, "the text doesn't" ) )
    t.Check( tkWidget_IsVisible( mw.vbar( 0 ) ) = false, P( sc, "the text's scroll bar is hidden" ) )
    t.Check( tkHost_GetFocus( h ) = c->Glass, P( sc, "the keyboard is on the surface" ) )
    t.Check( c->Doc.Controls.Count( ) = 5, P( sc, "every control read" ) )
    dim as TK_WIDGET ptr bA = c->WidgetOf( "btnA" ), bIn = c->WidgetOf( "btnIn" ), pn = c->WidgetOf( "pnl" ), lb = c->WidgetOf( "lblB" ), tb = c->WidgetOf( "tabs" )
    t.Check( (bA->x = tkHost_Scale( h, 16 )) andalso (bA->cw = tkHost_Scale( h, 80 )), P( sc, strings.Format( "a control at its design rectangle: {} {}", bA->x, bA->cw ) ) )
    t.Check( bIn->pParent = pn, P( sc, "a child on its parent" ) )
    t.Check( c->Surface->cw = tkHost_Scale( h, 400 ), P( sc, "the surface is the form's width" ) )
    t.Check( tkHost_HitTest( h, tkTest_CX( bA ), tkTest_CY( bA ) ) = c->Glass, P( sc, "the glass, not the control, takes the mouse" ) )
    t.Check( bA->isFocusable = false, P( sc, "a control on the surface can't take the keyboard" ) )

    dim as ustring text0 = d->Text( )

    ' ---- select
    ClickOn( h, bA )
    t.Check( SelText( c ) = "btnA", P( sc, "a click selects: " & SelText( c ) ) )
    t.Check( d->IsModified( ) = false, P( sc, "selecting changes nothing" ) )
    ClickOn( h, bIn )
    t.Check( SelText( c ) = "btnIn", P( sc, "a click inside a panel takes the child: " & SelText( c ) ) )
    SDL_SetModState( SDL_KMOD_CTRL )
    ClickOn( h, bA )
    SDL_SetModState( SDL_KMOD_NONE )
    t.Check( SelText( c ) = "btnIn btnA", P( sc, "Ctrl adds to the selection: " & SelText( c ) ) )

    ' ---- move, snapped, one undoable step
    ClickOn( h, bA )
    t.Check( SelText( c ) = "btnA", P( sc, "a plain click on one of several selects just it: " & SelText( c ) ) )
    dim as long stp = tkHost_Scale( h, 8 )
    Chord( h, SDLK_ESCAPE, SDL_SCANCODE_ESCAPE, 0 )
    t.Check( c->Selected.Count( ) = 0, P( sc, "Esc selects nothing" ) )
    DragPx( h, tkTest_CX( bA ), tkTest_CY( bA ), tkTest_CX( bA ) + 3 * stp + 2, tkTest_CY( bA ) + stp - 1 )
    t.Check( (Ctl( c, "btnA" ).X = 40) andalso (Ctl( c, "btnA" ).Y = 24), P( sc, strings.Format( "a drag moves and snaps: {},{}", Ctl( c, "btnA" ).X, Ctl( c, "btnA" ).Y ) ) )
    t.Check( bA->x = tkHost_Scale( h, 40 ), P( sc, "the real control went there" ) )
    t.Check( d->IsModified( ), P( sc, "the buffer is modified" ) )
    t.Check( d->Text( ) <> text0, P( sc, "the buffer changed" ) )
    t.Check( instr( d->Text( ), !"x = 40\ny = 24" ) > 0, P( sc, "with the new position" ) )
    dim as ustring text1 = d->Text( )
    Primary( h, SDLK_Z, SDL_SCANCODE_Z )
    tkTest_PumpFor( h, 30 )
    t.Check( d->Text( ) = text0, P( sc, "one Undo takes it back, byte for byte" ) )
    t.Check( d->IsModified( ) = false, P( sc, "and the buffer's clean again" ) )
    bA = c->WidgetOf( "btnA" )
    t.Check( bA->x = tkHost_Scale( h, 16 ), P( sc, "the control went back too" ) )
    t.Check( SelText( c ) = "btnA", P( sc, "the selection survives the rebuild" ) )
    Primary( h, SDLK_Z, SDL_SCANCODE_Z, SDL_KMOD_SHIFT )
    tkTest_PumpFor( h, 30 )
    t.Check( d->Text( ) = text1, P( sc, "Redo puts it back" ) )
    Primary( h, SDLK_Z, SDL_SCANCODE_Z )
    tkTest_PumpFor( h, 30 )
    bA = c->WidgetOf( "btnA" )

    ' ---- resize through a grip
    ClickOn( h, bA )
    dim as TKRECT ra
    tkWidget_AbsRect( bA, ra )
    DragPx( h, ra.right, ra.bottom, ra.right + 2 * stp, ra.bottom + stp )
    t.Check( (Ctl( c, "btnA" ).W = 96) andalso (Ctl( c, "btnA" ).H = 32), P( sc, strings.Format( "the corner grip resizes: {}x{}", Ctl( c, "btnA" ).W, Ctl( c, "btnA" ).H ) ) )
    t.Check( bA->cw = tkHost_Scale( h, 96 ), P( sc, "the real control's width" ) )
    Primary( h, SDLK_Z, SDL_SCANCODE_Z )
    tkTest_PumpFor( h, 30 )
    t.Check( d->Text( ) = text0, P( sc, "undone" ) )
    bA = c->WidgetOf( "btnA" )

    ' ---- rubber band
    dim as TKRECT rs = c->SurfaceRect( ), rg = c->RectOf( c->Glass )
    dim as TKRECT rGlass
    tkWidget_AbsRect( c->Glass, rGlass )
    dim as long ox = rGlass.left + rs.left, oy = rGlass.top + rs.top
    DragPx( h, ox + tkHost_Scale( h, 230 ), oy + tkHost_Scale( h, 4 ), ox + tkHost_Scale( h, 380 ), oy + tkHost_Scale( h, 50 ) )
    t.Check( SelText( c ) = "lblB", P( sc, "a band selects what it touches: " & SelText( c ) ) )

    ' ---- draw
    c->Tool = "Label"
    tkWidget_AbsRect( c->WidgetOf( "pnl" ), ra )
    DragPx( h, ra.left + tkHost_Scale( h, 104 ), ra.top + tkHost_Scale( h, 40 ), ra.left + tkHost_Scale( h, 184 ), ra.top + tkHost_Scale( h, 64 ) )
    dim as long nw = FindControl( c->Doc, "Label1" )
    t.Check( nw >= 0, P( sc, "drawing adds a control" ) )
    if nw >= 0 then
        t.Check( c->Doc.Controls[nw].Parent = "pnl", P( sc, "inside the container it was drawn on" ) )
        t.Check( (c->Doc.Controls[nw].X = 104) andalso (c->Doc.Controls[nw].Y = 40) andalso (c->Doc.Controls[nw].W = 80) andalso (c->Doc.Controls[nw].H = 24), _
                 P( sc, strings.Format( "at the drawn rectangle, snapped: {},{} {}x{}", c->Doc.Controls[nw].X, c->Doc.Controls[nw].Y, c->Doc.Controls[nw].W, c->Doc.Controls[nw].H ) ) )
        t.Check( SelText( c ) = "Label1", P( sc, "and selected" ) )
        t.Check( len( c->Tool ) = 0, P( sc, "the tool goes back to the pointer" ) )
        t.Check( c->WidgetOf( "Label1" )->isFocusable = false, P( sc, "and it's inert" ) )
    end if
    Primary( h, SDLK_Z, SDL_SCANCODE_Z )
    tkTest_PumpFor( h, 30 )
    t.Check( d->Text( ) = text0, P( sc, "undoing the draw" ) )
    t.Check( FindControl( c->Doc, "Label1" ) < 0, P( sc, "it's gone" ) )

    c->Tool = "CheckBox"
    ClickPx( h, ox + tkHost_Scale( h, 300 ), oy + tkHost_Scale( h, 100 ) )
    nw = FindControl( c->Doc, "CheckBox1" )
    t.Check( nw >= 0, P( sc, "a plain click places one too" ) )
    if nw >= 0 then
        t.Check( (c->Doc.Controls[nw].W = 120) andalso (c->Doc.Controls[nw].H = 24), P( sc, "at its type's own size" ) )
        t.Check( c->Doc.Controls[nw].X = 304, P( sc, "on the grid: " & c->Doc.Controls[nw].X ) )
        t.Check( SettingOr( c->Doc.Controls[nw].Props, "Text" ) = "CheckBox1", P( sc, "its text is its name" ) )
    end if
    Primary( h, SDLK_Z, SDL_SCANCODE_Z )
    tkTest_PumpFor( h, 30 )

    ' ---- the tab control: click a tab, draw on that page
    tb = c->WidgetOf( "tabs" )
    dim as TK_WIDGET ptr bar_ = tkTabControl_GetTabBar( tb )
    dim as TKRECT rt, rb
    tkTabBar_GetTabRect( bar_, 1, rt )
    tkWidget_AbsRect( bar_, rb )
    ClickPx( h, rb.left + (rt.left + rt.right) \ 2, rb.top + (rt.top + rt.bottom) \ 2 )
    t.Check( tkTabControl_GetCurSel( tb ) = 1, P( sc, "a click on a tab shows that page" ) )
    t.Check( SelText( c ) = "tabs", P( sc, "and selects the tab control" ) )
    c->Tool = "Button"
    tkWidget_AbsRect( tkTabControl_GetPage( tb, 1 ), ra )
    ClickPx( h, ra.left + tkHost_Scale( h, 16 ), ra.top + tkHost_Scale( h, 16 ) )
    nw = FindControl( c->Doc, "Button1" )
    t.Check( nw >= 0, P( sc, "placed on a page" ) )
    if nw >= 0 then
        t.Check( (c->Doc.Controls[nw].Parent = "tabs") andalso (c->Doc.Controls[nw].Page = 1), P( sc, "on the page showing: " & c->Doc.Controls[nw].Page ) )
        t.Check( tkTabControl_GetCurSel( c->WidgetOf( "tabs" ) ) = 1, P( sc, "and the page stays up through the rebuild" ) )
    end if
    Primary( h, SDLK_Z, SDL_SCANCODE_Z )
    tkTest_PumpFor( h, 30 )
    t.Check( d->Text( ) = text0, P( sc, "undone: " ) )

    ' ---- the form's grip: what's anchored follows
    rs = c->SurfaceRect( )
    tkWidget_AbsRect( c->Glass, rGlass )
    DragPx( h, rGlass.left + rs.right, rGlass.top + rs.bottom, rGlass.left + rs.right + 5 * stp, rGlass.top + rs.bottom + 2 * stp )
    t.Check( (c->Doc.ClientW = 440) andalso (c->Doc.ClientH = 336), P( sc, strings.Format( "the form's corner grip: {}x{}", c->Doc.ClientW, c->Doc.ClientH ) ) )
    t.Check( Ctl( c, "lblB" ).X = 280, P( sc, "a right-anchored control follows: " & Ctl( c, "lblB" ).X ) )
    t.Check( Ctl( c, "btnA" ).X = 16, P( sc, "a left-anchored one stays" ) )
    t.Check( c->Surface->cw = tkHost_Scale( h, 440 ), P( sc, "the surface grew" ) )
    Primary( h, SDLK_Z, SDL_SCANCODE_Z )
    tkTest_PumpFor( h, 30 )
    t.Check( d->Text( ) = text0, P( sc, "undone" ) )

    ' ---- the keyboard
    ClickOn( h, c->WidgetOf( "btnA" ) )
    Chord( h, SDLK_RIGHT, SDL_SCANCODE_RIGHT, 0 )
    t.Check( Ctl( c, "btnA" ).X = 24, P( sc, "an arrow moves a grid step: " & Ctl( c, "btnA" ).X ) )
    Chord( h, SDLK_RIGHT, SDL_SCANCODE_RIGHT, SDL_KMOD_SHIFT )
    t.Check( Ctl( c, "btnA" ).W = 88, P( sc, "Shift+arrow resizes: " & Ctl( c, "btnA" ).W ) )
    Chord( h, SDLK_RIGHT, SDL_SCANCODE_RIGHT, TK_KMOD_PRIMARY )
    t.Check( Ctl( c, "btnA" ).X = 25, P( sc, "Primary+arrow moves one unit: " & Ctl( c, "btnA" ).X ) )
    Chord( h, SDLK_TAB, SDL_SCANCODE_TAB, 0 )
    t.Check( SelText( c ) = "pnl", P( sc, "Tab goes to the next in tab order: " & SelText( c ) ) )
    t.Check( tkHost_GetFocus( h ) = c->Glass, P( sc, "and the keyboard stays on the surface" ) )
    for i as long = 1 to 3
        Primary( h, SDLK_Z, SDL_SCANCODE_Z )
        tkTest_PumpFor( h, 20 )
    next
    t.Check( d->Text( ) = text0, P( sc, "three key edits, three undos" ) )

    ' delete, cascading
    ClickOn( h, c->WidgetOf( "pnl" ) )
    t.Check( SelText( c ) = "pnl", P( sc, "the panel selected" ) )
    Chord( h, SDLK_DELETE, SDL_SCANCODE_DELETE, 0 )
    t.Check( (FindControl( c->Doc, "pnl" ) < 0) andalso (FindControl( c->Doc, "btnIn" ) < 0), P( sc, "Delete takes the panel and its child" ) )
    t.Check( c->Selected.Count( ) = 0, P( sc, "nothing selected after" ) )
    Primary( h, SDLK_Z, SDL_SCANCODE_Z )
    tkTest_PumpFor( h, 30 )
    t.Check( d->Text( ) = text0, P( sc, "undone" ) )

    ' ---- the clipboard, through the Edit keys
    ClickOn( h, c->WidgetOf( "pnl" ) )
    Primary( h, SDLK_C, SDL_SCANCODE_C )
    t.Check( instr( tkHost_GetClipboardText( ), "btnIn" ) > 0, P( sc, "Copy puts the controls on the clipboard" ) )
    ClickPx( h, ox + tkHost_Scale( h, 300 ), oy + tkHost_Scale( h, 200 ) )      ' empty form: nothing selected
    t.Check( c->Selected.Count( ) = 0, P( sc, "nothing selected" ) )
    Primary( h, SDLK_V, SDL_SCANCODE_V )
    tkTest_PumpFor( h, 30 )
    t.Check( SelText( c ) = "Panel1", P( sc, "Paste selects the copy under a new name: " & SelText( c ) ) )
    t.Check( FindControl( c->Doc, "Button1" ) >= 0, P( sc, "its child came" ) )
    t.Check( c->WidgetOf( "Button1" )->pParent = c->WidgetOf( "Panel1" ), P( sc, "on the copy" ) )
    Primary( h, SDLK_Z, SDL_SCANCODE_Z )
    tkTest_PumpFor( h, 30 )
    t.Check( d->Text( ) = text0, P( sc, "undone" ) )
    Primary( h, SDLK_A, SDL_SCANCODE_A )
    t.Check( SelText( c ) = "btnA pnl lblB tabs", P( sc, "Select All takes the top level: " & SelText( c ) ) )

    ' ---- align and z-order
    ClickOn( h, c->WidgetOf( "btnA" ) )
    SDL_SetModState( SDL_KMOD_CTRL )
    ClickOn( h, c->WidgetOf( "lblB" ) )
    SDL_SetModState( SDL_KMOD_NONE )
    c->Align( edits.AlignMode.AlignTops )
    t.Check( d->IsModified( ) = false, P( sc, "aligning what's already aligned changes nothing" ) )
    c->Align( edits.AlignMode.SameWidth )
    t.Check( c->WidgetOf( "lblB" )->cw = tkHost_Scale( h, 80 ), P( sc, "Same Width, against the first selected" ) )
    Primary( h, SDLK_Z, SDL_SCANCODE_Z )
    tkTest_PumpFor( h, 30 )
    ClickOn( h, c->WidgetOf( "btnA" ) )
    c->ToFront( )
    t.Check( c->Doc.Controls[c->Doc.Controls.Count( ) - 1].Name = "btnA", P( sc, "to the front is the end of the list" ) )
    t.Check( tkWidget_Parent( c->WidgetOf( "btnA" ) )->pLast = c->WidgetOf( "btnA" ), P( sc, "and the top of the real z-order" ) )
    Primary( h, SDLK_Z, SDL_SCANCODE_Z )
    tkTest_PumpFor( h, 30 )
    t.Check( d->Text( ) = text0, P( sc, "undone" ) )

    ' ---- a long history, byte for byte
    ClickOn( h, c->WidgetOf( "btnA" ) )
    dim as Array( of ustring ) hist
    hist.Push( d->Text( ) )
    for i as long = 1 to 12
        Chord( h, iif( i mod 2, SDLK_DOWN, SDLK_RIGHT ), iif( i mod 2, SDL_SCANCODE_DOWN, SDL_SCANCODE_RIGHT ), 0 )
        hist.Push( d->Text( ) )
    next
    dim as boolean sameBack = true
    for i as long = 11 to 0 step -1
        Primary( h, SDLK_Z, SDL_SCANCODE_Z )
        if d->Text( ) <> hist[i] then sameBack = false
    next
    t.Check( sameBack, P( sc, "12 undos, each state byte for byte" ) )
    t.Check( d->IsModified( ) = false, P( sc, "clean at the save point" ) )
    dim as boolean sameFwd = true
    for i as long = 1 to 12
        Primary( h, SDLK_Z, SDL_SCANCODE_Z, SDL_KMOD_SHIFT )
        if d->Text( ) <> hist[i] then sameFwd = false
    next
    t.Check( sameFwd, P( sc, "12 redos, likewise" ) )
    tkTest_PumpFor( h, 30 )

    ' ---- commands that need visible text have none to work on
    t.Check( mw.CanRun( Cmd.Find ) = false, P( sc, "Find is off" ) )
    t.Check( mw.CanRun( Cmd.GoToLine ) = false, P( sc, "Go to Line is off" ) )
    t.Check( mw.CanRun( Cmd.DeleteLine ) = false, P( sc, "Delete Line is off" ) )
    t.Check( mw.CanRun( Cmd.Undo ), P( sc, "Undo stays on" ) )
    t.Check( mw.CanRun( Cmd.FileSave ), P( sc, "Save stays on" ) )
    dim as ustring keepText = d->Text( )
    Primary( h, SDLK_F, SDL_SCANCODE_F )
    t.Check( mw.Finder.isOpen = false, P( sc, "Primary+F doesn't open the find strip" ) )
    Primary( h, SDLK_Y, SDL_SCANCODE_Y )
    t.Check( d->Text( ) = keepText, P( sc, "Primary+Y doesn't delete a hidden line" ) )

    ' ---- save
    Primary( h, SDLK_S, SDL_SCANCODE_S )
    tkTest_PumpFor( h, 30 )
    t.Check( d->IsModified( ) = false, P( sc, "Save clears the modified state" ) )
    dim as ustring none
    t.Check( documents.IsFormFile( path ) andalso (fs.ReadAllText( path ).ValueOr( none ) = d->Text( )), P( sc, "and the file is the text" ) )

    ' ---- another buffer, and back
    mw.NewBlank( )
    tkTest_PumpFor( h, 50 )
    t.Check( tkWidget_IsVisible( c->Frame ) = false, P( sc, "another buffer hides the surface" ) )
    t.Check( mw.Active( )->Designer = 0, P( sc, "a text buffer has none" ) )
    t.Check( mw.CanRun( Cmd.Find ), P( sc, "Find is back for text" ) )
    mw.ShowDoc( d )
    tkTest_PumpFor( h, 50 )
    t.Check( tkWidget_IsVisible( c->Frame ), P( sc, "back to the form" ) )
    t.Check( tkHost_GetFocus( h ) = c->Glass, P( sc, "with the keyboard" ) )

    ' ---- someone else rewrites the file
    dim as ustring other = strings.Replace( d->Text( ), "name = ""lblB""", "name = ""lblZZ""" )
    fs.WriteAllText( path, other )
    d->Stamp.Size = 0                       ' whatever the clock's resolution, it reads as changed
    mw.CheckDisk( )
    tkTest_PumpFor( h, 30 )
    t.Check( FindControl( c->Doc, "lblZZ" ) >= 0, P( sc, "a file changed on disk rebuilds the surface" ) )
    fs.WriteAllText( path, "not a form [" )
    d->Stamp.Size = 0
    mw.CheckDisk( )
    tkTest_PumpFor( h, 30 )
    t.Check( d->Designer = 0, P( sc, "a file that no longer reads falls back to text" ) )
    t.Check( tkWidget_IsVisible( d->Main.Widget( ) ), P( sc, "and the text shows" ) )

    ' ---- files that can't be shown open as text
    dim as ustring badPath = fs.PathJoin( mw.ConfigDir, "frmBad.tkform" )
    fs.WriteAllText( badPath, "format = 1" & wchr( 10 ) & "[[control]]" & wchr( 10 ) & "name = ""x""" & wchr( 10 ) & "type = ""Sprocket""" & wchr( 10 ) )
    t.Check( mw.OpenFile( badPath ), P( sc, "an unreadable form still opens" ) )
    tkTest_PumpFor( h, 40 )
    t.Check( mw.Active( )->Designer = 0, P( sc, "as text" ) )
    t.Check( instr( mw.Message, "opened as text" ) > 0, P( sc, "and says so: " & mw.Message ) )

    for each dd as DocRef in mw.Docs
        dd->Main.SetSavePoint( )
    next
    mw.Destroy( )
end sub
