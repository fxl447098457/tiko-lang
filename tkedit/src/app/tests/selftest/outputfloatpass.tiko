' outputfloatpass -- the output pane floated into a window of its own and docked again, as the
' designer's palettes are: its float button, its window's close button, Float Output; its rows and
' text go with it; Ctrl+F9 and Esc from its window; session.toml keeps it. Ends floating, so the
' main window's Destroy is run with the pane on the other window.
#module "selftest"

#import "std/fs"
#import "tkc/cmdids"
#import "tkc/session"
#import "tka/mainwin"
#import "tka/outputpane"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkListTree"
#import "vendor/tkControls/tkToolbar"
using cmdids
using tkApp
using tkHost
using tkTest
using tkListTree
using tkToolbar

' Long enough for a tkApp_RunOnUI (the float button, the close button) to have run.
private sub Settle( byval h as TK_HOST ptr )
    tkTest_PumpFor( h, 60 )
    tkApp_Pump( )
    tkTest_PumpFor( h, 60 )
end sub

public sub OutputFloatPass( byref t as Tally, byval sc as single )
    dim as mainwin.Window mw
    mw.ConfigDir = FreshConfig( )
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    t.Check( mw.Create( sc ), P( sc, "output float: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_PumpFor( h, 150 )
    dim as outputpane.Pane ptr o = @mw.Out

    ' ---- docked, with something in it
    mw.Execute( Cmd.OutputPane )
    tkTest_PumpFor( h, 60 )
    o->SetLog( "the log's text" )
    tkListTree_AddString( o->results, "a result row", -1 )
    t.Check( mw.OutputShown andalso (o->frame->pHost = h) andalso tkWidget_IsVisible( o->frame ), P( sc, "output float: shown docked" ) )
    t.Check( o->floatBtn->x + o->floatBtn->cw <= o->frame->cw, P( sc, "output float: the float button inside the pane" ) )
    t.Check( o->tabs->cw <= o->floatBtn->x, P( sc, "output float: the tabs end before it" ) )
    t.Check( tkToolbar_GetGlyph( o->floatBtn, 0 ) = wchr( &hF582 ), P( sc, "output float: it shows Float" ) )
    dim as long dockedH = o->frame->ch
    t.Check( (dockedH = mw.OutputHeight( )) andalso (dockedH > 0), P( sc, "output float: its docked height" ) )

    ' ---- its float button: a window of its own
    dim as long nForms = tkApp_FormCount( )
    tkTest_PushMotion( h, tkTest_CX( o->floatBtn ), tkTest_CY( o->floatBtn ) )
    tkTest_PumpFor( h, 15 )
    tkTest_Click( h, tkTest_CX( o->floatBtn ), tkTest_CY( o->floatBtn ) )
    Settle( h )
    t.Check( (mw.OutFloat <> 0) andalso mw.OutPlace.On_, P( sc, "output float: the button floats it" ) )
    if mw.OutFloat = 0 then
        mw.Destroy( )
        exit sub
    end if
    dim as TK_HOST ptr fh = tkForm_Host( mw.OutFloat )
    t.Check( tkApp_FormCount( ) = nForms + 1, P( sc, "output float: one more window" ) )
    t.Check( o->frame->pHost = fh, P( sc, "output float: the pane is on it" ) )
    t.Check( (o->frame->x = 0) andalso (o->frame->y = 0) andalso (o->frame->cw = tkForm_Widget( mw.OutFloat )->cw) andalso _
             (o->frame->ch = tkForm_Widget( mw.OutFloat )->ch), P( sc, "output float: and fills it" ) )
    t.Check( (SDL_GetWindowFlags( fh->win ) and SDL_WINDOW_HIDDEN) = 0, P( sc, "output float: the window shows" ) )
    t.Check( (o->LogText( ) = "the log's text") andalso (tkListTree_GetCount( o->results ) = 1), P( sc, "output float: its text and rows went with it" ) )
    t.Check( tkWidget_IsVisible( mw.outBar ) = false, P( sc, "output float: no resize bar on the main window" ) )
    t.Check( mw.OutputHeight( ) = 0, P( sc, "output float: the panes take its room" ) )
    t.Check( tkToolbar_GetGlyph( o->floatBtn, 0 ) = wchr( &hF373 ), P( sc, "output float: the button shows Dock" ) )
    t.Check( tkHost_GetCapture( fh ) = 0, P( sc, "output float: no stray capture on it" ) )

    ' ---- its keys: Ctrl+F9 and Esc hide it, Ctrl+F9 brings it back on the same window
    dim as TK_FORM ptr same = mw.OutFloat
    Chord( fh, SDLK_F9, SDL_SCANCODE_F9, TK_KMOD_PRIMARY )
    tkTest_PumpFor( h, 30 )
    t.Check( (mw.OutputShown = false) andalso ((SDL_GetWindowFlags( fh->win ) and SDL_WINDOW_HIDDEN) <> 0), P( sc, "output float: Ctrl+F9 from it hides it" ) )
    mw.Execute( Cmd.OutputPane )
    tkTest_PumpFor( h, 30 )
    t.Check( mw.OutputShown andalso (mw.OutFloat = same) andalso ((SDL_GetWindowFlags( fh->win ) and SDL_WINDOW_HIDDEN) = 0), _
             P( sc, "output float: and Ctrl+F9 shows it floating again" ) )
    Chord( fh, SDLK_ESCAPE, SDL_SCANCODE_ESCAPE, 0 )
    tkTest_PumpFor( h, 30 )
    t.Check( mw.OutputShown = false, P( sc, "output float: Esc in it hides it" ) )
    mw.Execute( Cmd.OutputPane )
    tkTest_PumpFor( h, 30 )

    ' ---- remembered
    mw.SaveSession( )
    dim as session.SessionResult sr = session.LoadSession( mw.SessionFile( ) )
    t.Check( sr.IsOk( ) andalso sr.Value( ).FloatOutput andalso (sr.Value( ).OutW > 0) andalso (sr.Value( ).OutH > 0), _
             P( sc, "output float: session.toml keeps it floating, and its size" ) )

    ' ---- its close button docks it
    tkTest_PushWindowEvent( fh, SDL_EVENT_WINDOW_CLOSE_REQUESTED )
    Settle( h )
    t.Check( (mw.OutFloat = 0) andalso (mw.OutPlace.On_ = false), P( sc, "output float: the close button docks it" ) )
    t.Check( tkApp_FormCount( ) = nForms, P( sc, "output float: its window is gone" ) )
    t.Check( tkHost_IsOpen( h ), P( sc, "output float: the main window isn't" ) )
    t.Check( (o->frame->pHost = h) andalso tkWidget_IsVisible( o->frame ) andalso mw.OutputShown, P( sc, "output float: the pane is back under the panes, shown" ) )
    t.Check( (o->frame->ch = dockedH) andalso tkWidget_IsVisible( mw.outBar ), P( sc, "output float: at its height, with its bar" ) )
    t.Check( o->frame->pNext = mw.outBar, P( sc, "output float: under its bar again (z-order)" ) )
    t.Check( (o->LogText( ) = "the log's text") andalso (tkListTree_GetCount( o->results ) = 1), P( sc, "output float: its text and rows came back" ) )
    t.Check( tkToolbar_GetGlyph( o->floatBtn, 0 ) = wchr( &hF582 ), P( sc, "output float: the button shows Float again" ) )
    mw.SaveSession( )
    sr = session.LoadSession( mw.SessionFile( ) )
    t.Check( sr.IsOk( ) andalso (sr.Value( ).FloatOutput = false) andalso (sr.Value( ).OutW > 0), P( sc, "output float: docked kept, the window's size too" ) )

    ' ---- Float Output, from hidden: shown, floating, where it was
    mw.ShowOutput( false )
    tkTest_PumpFor( h, 30 )
    mw.Execute( Cmd.OutputFloat )
    Settle( h )
    t.Check( mw.OutputShown andalso (mw.OutFloat <> 0) andalso (o->frame->pHost = tkForm_Host( mw.OutFloat )), P( sc, "output float: Float Output floats and shows it" ) )
    if mw.OutFloat then
        dim as long ww, wh
        SDL_GetWindowSize( tkForm_Host( mw.OutFloat )->win, @ww, @wh )
        t.Check( (ww = sr.Value( ).OutW) andalso (wh = sr.Value( ).OutH), P( sc, "output float: at the size it had" ) )
    end if
    t.Check( mw.CanRun( Cmd.OutputFloat ) andalso (mainwin.InMenu( Cmd.OutputFloat ) = false), P( sc, "output float: a command, not a menu row" ) )
    mw.Destroy( )                                ' floating: the pane comes home first
    t.Check( tkApp_FormCount( ) = nForms - 1, P( sc, "output float: Destroy takes both windows" ) )
end sub
