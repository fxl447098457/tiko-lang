' reportpass -- a .tkreport on the Report Designer's canvas in the real window (RD5): opened as its
' own document kind, its geometry asserted against the model at the pinned scale, and every gesture
' through SDL events -- select, move with snap, resize, a band's height, a move into another band,
' rubber band, keys, clipboard, align, undo -- each one undoable edit of the hidden text.
#module "selftest"

#import "std/containers"
#import "std/fs"
#import "std/strings"
#import "tkc/cmdids"
#import "tka/documents"
#import "tka/mainwin"
#import "tkd/rcanvas"
#import "tkd/redits"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkPaint"
#import "vendor/tkControls/tkPrint"
#import "vendor/tkControls/tkReportDef"
#import "vendor/tkControls/tkTooltip"
#import "vendor/tkControls/tkScrollBar"
using containers
using tkTooltip
using tkScrollBar
using cmdids
using tkApp
using tkHost
using tkTest
using tkPaint
using tkPrint
using tkReportDef
using tkReport

const as string REPORT_TEXT = _
    !"format = 1\n\n[report]\ntitle = \"T\"\n\n[[source]]\nname = \"S\"\n\n" & _
    !"[[band]]\nid = \"title\"\nkind = \"report_header\"\nheight = 30\n\n" & _
    !"[[band]]\nid = \"d\"\nkind = \"detail\"\nsource = \"S\"\nheight = 20\n\n" & _
    !"[[band]]\nid = \"rf\"\nkind = \"report_footer\"\nheight = 20\n\n" & _
    !"[[item]]\nid = \"lbl\"\nband = \"title\"\nrect = [10, 5, 100, 14]\ntext = \"Names\"\n\n" & _
    !"[[item]]\nid = \"fld\"\nband = \"d\"\nkind = \"field\"\nrect = [10, 3, 80, 14]\nexpr = \"[Name]\"\n\n" & _
    !"[[item]]\nid = \"box\"\nband = \"d\"\nkind = \"box\"\nrect = [120, 2, 40, 16]\n"

' Glass pixels to the window's.
private function RpAbs_( byval c as rcanvas.ReportCanvas ptr, byref rc as TKRECT ) as TKRECT
    dim as TKRECT a, r = rc
    tkWidget_AbsRect( c->Glass, a )
    r.left += a.left : r.right += a.left : r.top += a.top : r.bottom += a.top
    return r
end function

private function RpIt_( byval c as rcanvas.ReportCanvas ptr, byref id as const ustring ) byref as TKRD_ITEM
    return c->Def->items(tkReportDef_FindItem( c->Def, id ))
end function

private function RpMid_( byval c as rcanvas.ReportCanvas ptr, byref id as const ustring, byref x as long, byref y as long ) as boolean
    dim as int32 i = tkReportDef_FindItem( c->Def, id )
    if i < 0 then return false
    dim as TKRECT r = RpAbs_( c, c->ItemRect( i ) )
    x = (r.left + r.right) \ 2
    y = (r.top + r.bottom) \ 2
    return true
end function

private function RpSel_( byval c as rcanvas.ReportCanvas ptr ) as ustring
    dim as ustring s
    for each n as ustring in c->Selected
        s &= n & " "
    next
    return rtrim( s )
end function

' Does the item's rect sit at its band's origin plus its model geometry at the canvas's scale?
private function RpAt_( byval c as rcanvas.ReportCanvas ptr, byref id as const ustring, byval sc as single ) as boolean
    dim as int32 i = tkReportDef_FindItem( c->Def, id )
    if i < 0 then return false
    dim byref as TKRD_ITEM it = c->Def->items(i)
    dim as single s = rcanvas.PX_PER_PT * sc
    dim as TKRECT body = c->BandBodyRect( tkReportDef_FindBand( c->Def, it.band ) ), r = c->ItemRect( i )
    return (r.left = body.left + cint( it.x * s )) andalso (r.top = body.top + cint( it.y * s )) andalso _
           (r.right = body.left + cint( (it.x + it.w) * s )) andalso (r.bottom = body.top + cint( (it.y + it.h) * s ))
end function

public sub ReportPass( byref t as Tally, byval sc as single )
    dim as mainwin.Window mw
    mw.ConfigDir = FreshConfig( )
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    t.Check( mw.Create( sc ), P( sc, "report: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_PumpFor( h, 150 )

    ' the file as the writer writes it, so an edit's diff is the edit alone
    dim as ustring e
    dim as TK_REPORTDEF ptr seed = tkReportDef_LoadText( REPORT_TEXT, e )
    dim as ustring path = fs.PathJoin( mw.ConfigDir, "rptT.tkreport" )
    fs.WriteAllText( path, tkReportDef_SaveText( seed ) )
    tkReportDef_Destroy( seed )
    t.Check( mw.OpenFile( path ), P( sc, "report: the file opens" ) )
    tkTest_PumpFor( h, 80 )
    dim as DocRef d = mw.Active( )
    dim as rcanvas.ReportCanvas ptr c = d->Report
    t.Check( (c <> 0) andalso (d->Designer = 0) andalso c->Glass->isVisible andalso (d->Main.Widget( )->isVisible = false), _
             P( sc, "report: on the Report Designer's canvas, its text hidden" ) )
    if c = 0 then
        mw.Destroy( )
        exit sub
    end if
    dim as single s = rcanvas.PX_PER_PT * sc
    dim as float32 g = redits.GridPt( c->Def )
    dim as ustring text0 = d->Text( )

    ' geometry: the band stack and an item, from the model at 96/72 pixels a point times the scale
    dim as TKRECT bt = c->BandBodyRect( tkReportDef_FindBand( c->Def, "title" ) )
    dim as TKRECT bd = c->BandBodyRect( tkReportDef_FindBand( c->Def, "d" ) )
    dim as TKRECT cd = c->CaptionRect( tkReportDef_FindBand( c->Def, "d" ) )
    t.Check( (bt.bottom - bt.top = cint( 30 * s )) andalso (bd.right - bd.left = cint( tkReportDef_ContentWidth( c->Def ) * s )) _
             andalso (bd.top = bt.bottom) andalso (cd.top = bd.top) andalso (cd.bottom = bd.bottom) andalso (cd.right <= c->PaperLeft( )) _
             andalso (cd.right - cd.left = c->GutterW( )), _
             P( sc, strings.Format( "report: bands back to back, each beside its gutter cell, {}x{} px", bd.right - bd.left, bd.bottom - bd.top ) ) )
    t.Check( RpAt_( c, "fld", sc ) andalso RpAt_( c, "lbl", sc ), P( sc, "report: an item's rect is its band's origin plus its points" ) )

    ' WYSIWYG: the band as the engine's painter records it -- the field's expression, at its place
    dim as TK_PRINTDOC ptr doc = tkReportDef_RecordBand( c->Def, tkReportDef_FindBand( c->Def, "d" ), tkReportDef_ContentWidth( c->Def ) )
    dim as boolean sawField = false
    for i as long = 0 to tkPrintDoc_GetOpCount( doc, 0 ) - 1
        dim as TKPRINT_OPINFO oi
        tkPrintDoc_GetOp( doc, 0, i, oi )
        if (oi.op = TKREC_TEXT) andalso (oi.text = "[Name]") then sawField = true
    next
    tkPrintDoc_Destroy( doc )
    t.Check( sawField, P( sc, "report: a band is recorded by the engine's painter, a field as its expression" ) )

    ' select with a click
    dim as long x, y
    RpMid_( c, "fld", x, y )
    ClickPx( h, x, y )
    t.Check( RpSel_( c ) = "fld", P( sc, "report: a click selects: " & RpSel_( c ) ) )

    ' move, snapped to the 1 mm grid
    dim as long stp = cint( g * s )
    DragPx( h, x, y, x + 3 * stp, y )
    t.Check( (RpIt_( c, "fld" ).x = redits.Snap( 10 + 3 * g, g )) andalso (RpIt_( c, "fld" ).y = redits.Snap( 3, g )), _
             P( sc, strings.Format( "report: a drag moves and snaps to the grid: {},{}", RpIt_( c, "fld" ).x, RpIt_( c, "fld" ).y ) ) )
    t.Check( RpAt_( c, "fld", sc ), P( sc, "report: its rect follows" ) )
    t.Check( d->IsModified( ) andalso (d->Text( ) = tkReportDef_SaveText( c->Def )), P( sc, "report: the buffer is the model as the writer writes it" ) )
    Primary( h, SDLK_Z, SDL_SCANCODE_Z )
    tkTest_PumpFor( h, 30 )
    t.Check( (d->Text( ) = text0) andalso (d->IsModified( ) = false) andalso (RpIt_( c, "fld" ).x = 10), P( sc, "report: one Undo takes it back, byte for byte" ) )

    ' resize from the bottom-right grip
    dim as TKRECT gr = RpAbs_( c, c->GripRect( tkReportDef_FindItem( c->Def, "fld" ), 4 ) )
    x = (gr.left + gr.right) \ 2 : y = (gr.top + gr.bottom) \ 2
    DragPx( h, x, y, x + 2 * stp, y + stp )
    t.Check( (RpIt_( c, "fld" ).w = redits.Round2( redits.Snap( 90 + 2 * g, g ) - 10 )) andalso (RpIt_( c, "fld" ).x = 10), _
             P( sc, strings.Format( "report: a grip resizes, snapped: w {}", RpIt_( c, "fld" ).w ) ) )

    ' a band's height, from its bottom edge; the bands below move down
    dim as TKRECT rf0 = c->BandBodyRect( tkReportDef_FindBand( c->Def, "rf" ) )
    bd = RpAbs_( c, c->BandBodyRect( tkReportDef_FindBand( c->Def, "d" ) ) )
    x = bd.left + cint( 4 * s )
    DragPx( h, x, bd.bottom, x, bd.bottom + 4 * stp )
    dim as TKRECT rf1 = c->BandBodyRect( tkReportDef_FindBand( c->Def, "rf" ) )
    dim as float32 want = redits.Snap( 20 + 4 * g, g )
    t.Check( (c->Def->bands(tkReportDef_FindBand( c->Def, "d" )).height = want) andalso (rf1.top - rf0.top = cint( want * s ) - cint( 20 * s )), _
             P( sc, strings.Format( "report: a band's edge sets its height ({}), the next band moves down", c->Def->bands(tkReportDef_FindBand( c->Def, "d" )).height ) ) )

    ' a move into another band
    RpMid_( c, "box", x, y )
    dim as TKRECT rf = RpAbs_( c, rf1 )
    DragPx( h, x, y, x, rf.top + cint( 6 * s ) + (y - RpAbs_( c, c->ItemRect( tkReportDef_FindItem( c->Def, "box" ) ) ).top) )
    t.Check( (RpIt_( c, "box" ).band = "rf") andalso RpAt_( c, "box", sc ), P( sc, "report: dragged into another band, it belongs there: " & RpIt_( c, "box" ).band ) )

    ' rubber band: from an empty part of the title band round the label
    bt = RpAbs_( c, c->BandBodyRect( tkReportDef_FindBand( c->Def, "title" ) ) )
    DragPx( h, bt.left + cint( 200 * s ), bt.top + cint( 2 * s ), bt.left + cint( 5 * s ), bt.top + cint( 25 * s ) )
    t.Check( RpSel_( c ) = "lbl", P( sc, "report: a rubber band selects what it touches: " & RpSel_( c ) ) )

    ' ---- the gutter (author 2026-11-25): each band's name written up its cell; a press there picks the
    ' band; the cell's bottom edge sets the band's height as the paper's does
    scope
        tkTest_PumpFor( h, 20 )
        tkHost_RenderTo( h, false )
        dim as TKRECT gt = RpAbs_( c, c->CaptionRect( tkReportDef_FindBand( c->Def, "title" ) ) )
        dim as ulong gbg
        dim as long tones = tkTest_TonesIn( h, gt.left + 2, gt.top + (gt.bottom - gt.top) \ 4, gt.right - gt.left - 4, (gt.bottom - gt.top) \ 2, gbg )
        t.Check( tones > 2, P( sc, strings.Format( "report: the gutter writes the band's name up its cell ({} tones)", tones ) ) )
        dim as TKRECT gf = RpAbs_( c, c->CaptionRect( tkReportDef_FindBand( c->Def, "rf" ) ) )
        tkTest_Click( h, (gf.left + gf.right) \ 2, (gf.top + gf.bottom) \ 2 )
        tkTest_PumpFor( h, 20 )
        t.Check( (c->SelBand = "rf") andalso (c->Selected.Count( ) = 0), P( sc, "report: a press in the gutter picks the band: " & c->SelBand ) )
        dim as TKRECT gl = c->CaptionRect( tkReportDef_FindBand( c->Def, "d" ) )
        c->OnHover( (gl.left + gl.right) \ 2, (gl.top + gl.bottom) \ 2 )
        t.Check( tkTooltip_GetToolIndex( tkTipHost_Tip( @c->Tip ) ) = tkReportDef_FindBand( c->Def, "d" ), _
                 P( sc, "report: over a gutter cell, the band's tip is offered" ) )
        dim as float32 h0 = c->Def->bands(tkReportDef_FindBand( c->Def, "rf" )).height
        DragPx( h, (gf.left + gf.right) \ 2, gf.bottom - 1, (gf.left + gf.right) \ 2, gf.bottom - 1 + 2 * stp )
        dim as float32 hw = redits.Snap( h0 + 2 * g, g )
        t.Check( c->Def->bands(tkReportDef_FindBand( c->Def, "rf" )).height = hw, _
                 P( sc, strings.Format( "report: the gutter cell's bottom edge sets the height ({} -> {})", h0, c->Def->bands(tkReportDef_FindBand( c->Def, "rf" )).height ) ) )
        c->SelectOnly( "lbl" )                  ' as the rubber band left it, for the keys below
        tkTest_PumpFor( h, 20 )
    end scope

    ' ---- the margin lines (author 2026-11-25): each dragged sets its margin, snapped; the selection stays
    scope
        dim as float32 ml0 = c->Def->mL, mr0 = c->Def->mR
        dim as TKRECT tb = RpAbs_( c, c->BandBodyRect( tkReportDef_FindBand( c->Def, "title" ) ) )
        dim as long my = tb.top + (tb.bottom - tb.top) \ 2, rx = tb.right
        DragPx( h, tb.left, my, tb.left + 2 * stp, my )
        ' the right line: scrolled into view first (the paper is wider than the test's canvas)
        dim as TKRECT ga
        tkWidget_AbsRect( c->Glass, ga )
        if (rx > ga.right - tkHost_Scale( h, 40 )) andalso c->HBar->isVisible then
            tkScrollBar_SetPos( c->HBar, tkScrollBar_GetPos( c->HBar ) + rx - (ga.right - tkHost_Scale( h, 40 )) )
            tkWidget_Invalidate( c->Glass )
            tkTest_PumpFor( h, 20 )
            rx = RpAbs_( c, c->BandBodyRect( tkReportDef_FindBand( c->Def, "title" ) ) ).right
        end if
        DragPx( h, rx, my, rx - 2 * stp, my )
        tkScrollBar_SetPos( c->HBar, 0 )
        tkWidget_Invalidate( c->Glass )
        tkTest_PumpFor( h, 20 )
        t.Check( (c->Def->mL = redits.Snap( ml0 + 2 * g, g )) andalso (c->Def->mR = redits.Snap( mr0 + 2 * g, g )) andalso (RpSel_( c ) = "lbl"), _
                 P( sc, strings.Format( "report: the margin lines set the margins (L {} -> {}, R {} -> {})", ml0, c->Def->mL, mr0, c->Def->mR ) ) )
    end scope

    ' keys: an arrow moves a grid step, Primary+arrow 0.1 pt, Del deletes, Esc deselects
    dim as float32 x0 = RpIt_( c, "lbl" ).x
    Chord( h, SDLK_RIGHT, SDL_SCANCODE_RIGHT, 0 )
    t.Check( RpIt_( c, "lbl" ).x = redits.Round2( x0 + g ), P( sc, strings.Format( "report: Right moves a grid step: {}", RpIt_( c, "lbl" ).x ) ) )
    Chord( h, SDLK_RIGHT, SDL_SCANCODE_RIGHT, TK_KMOD_PRIMARY )
    t.Check( RpIt_( c, "lbl" ).x = redits.Round2( x0 + g + 0.1 ), P( sc, strings.Format( "report: Primary+Right moves 0.1 pt: {}", RpIt_( c, "lbl" ).x ) ) )

    ' the clipboard: a copy pastes a grid step down and across, with an id of its own
    Primary( h, SDLK_C, SDL_SCANCODE_C )
    Primary( h, SDLK_V, SDL_SCANCODE_V )
    tkTest_PumpFor( h, 30 )
    dim as int32 pi_ = tkReportDef_FindItem( c->Def, "lbl1" )
    t.Check( (pi_ >= 0) andalso (RpSel_( c ) = "lbl1") andalso (RpIt_( c, "lbl1" ).band = "title") _
             andalso (RpIt_( c, "lbl1" ).x = redits.Round2( RpIt_( c, "lbl" ).x + g )), P( sc, "report: copy and paste: " & RpSel_( c ) ) )

    ' Shift+click adds as the anchor; Align Lefts lines up on it; Delete; Escape
    RpMid_( c, "fld", x, y )
    tkTest_PushMotion( h, x, y )
    tkTest_PumpFor( h, 15 )
    SDL_SetModState( SDL_KMOD_SHIFT )
    tkTest_Click( h, x, y )
    tkTest_PumpFor( h, 20 )
    SDL_SetModState( SDL_KMOD_NONE )
    t.Check( RpSel_( c ) = "fld lbl1", P( sc, "report: Shift+click adds to the selection, as the anchor: " & RpSel_( c ) ) )
    mw.Execute( Cmd.FormAlignLefts )
    tkTest_PumpFor( h, 20 )
    t.Check( RpIt_( c, "lbl1" ).x = RpIt_( c, "fld" ).x, P( sc, "report: Align Lefts lines them up on the anchor" ) )
    Chord( h, SDLK_DELETE, SDL_SCANCODE_DELETE, 0 )
    t.Check( (tkReportDef_FindItem( c->Def, "fld" ) < 0) andalso (tkReportDef_FindItem( c->Def, "lbl1" ) < 0), P( sc, "report: Delete removes the selection" ) )
    RpMid_( c, "lbl", x, y )
    ClickPx( h, x, y )
    Chord( h, SDLK_ESCAPE, SDL_SCANCODE_ESCAPE, 0 )
    t.Check( c->Selected.Count( ) = 0, P( sc, "report: Escape drops the selection" ) )

    ' saved: its generated module is written (RD4's generator)
    t.Check( mw.SaveDoc( d, false ) andalso fs.IsFile( fs.PathJoin( mw.ConfigDir, "rptT.design.tiko" ) ), P( sc, "report: a save writes rptT.design.tiko" ) )

    ' a file that does not read as a report opens as text, and says so
    dim as ustring badPath = fs.PathJoin( mw.ConfigDir, "rptBad.tkreport" )
    fs.WriteAllText( badPath, !"format = 1\n[[band]]\nid = \"b\"\nkind = \"nope\"\n" )
    t.Check( mw.OpenFile( badPath ) andalso (mw.Active( )->Report = 0) andalso (instr( mw.Message, "opened as text" ) > 0), _
             P( sc, "report: an unreadable report opens as text: " & mw.Message ) )

    for each dd as DocRef in mw.Docs
        dd->Main.SetSavePoint( )
    next
    mw.Destroy( )
end sub
