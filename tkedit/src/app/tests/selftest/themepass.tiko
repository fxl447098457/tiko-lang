' themepass -- the Theme Center (docs/tkDesigner/THEMES.md, TH5) on a new GUI project, through real
' events: the gallery, an accent, High Contrast's own AA check, Dark and Light, a role and its reset,
' the corner radius, a style, Save (main.tiko made to install the theme), Save to Library, Close.
' Tabs are switched by tkTabControl_SetCurSel: that is the tab control's, not what is tested here.
#module "selftest"

#import "std/containers"
#import "std/fs"
#import "tkc/cmdids"
#import "tka/documents"
#import "tka/mainwin"
#import "tkd/themecenter"
#import "tkd/themefile"
#import "tkd/model"
#import "tkc/build"
#import "tkp/platform"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkPaint"
#import "vendor/tkControls/tkListTree"
#import "vendor/tkControls/tkTextBox"
#import "vendor/tkControls/tkButton"
#import "vendor/tkControls/tkLabel"
#import "vendor/tkControls/tkSelectBar"
#import "vendor/tkControls/tkTabControl"
#import "vendor/tkControls/tkTheme"
using containers
using cmdids
using tkApp
using tkListTree
using tkTextBox
using tkButton
using tkLabel
using tkSelectBar
using tkTabControl
using tkTheme
using tkHost
using tkTest
using tkPaint
using model

' Click into a text box, replace what's there by typing.
private sub TypeInto( byval h as TK_HOST ptr, byval box as TK_WIDGET ptr, byref text as const ustring )
    PressIn( h, box )
    Chord( h, SDLK_A, SDL_SCANCODE_A, TK_KMOD_PRIMARY )
    if len( text ) then
        dim as ustring t = text
        tkTest_PushText( h, t )
    else
        Chord( h, SDLK_DELETE, SDL_SCANCODE_DELETE, 0 )
    end if
    tkTest_PumpFor( h, 40 )
end sub

private function GalleryRow( byval list as TK_WIDGET ptr, byref nm as const ustring ) as long
    for r as long = 0 to tkListTree_GetCount( list ) - 1
        if tkListTree_GetText( list, r ) = nm then return r
    next
    return -1
end function

private sub ClickVariant( byval h as TK_HOST ptr, byval sel as TK_WIDGET ptr, byval idx as long )
    dim as TKRECT rc, a
    tkSelectBar_GetPanelRect( sel, idx, rc )
    tkWidget_AbsRect( sel, a )
    dim as long x = a.left + (rc.left + rc.right) \ 2, y = a.top + (rc.top + rc.bottom) \ 2
    tkTest_PushMotion( h, x, y )
    tkTest_PumpFor( h, 15 )
    tkTest_Click( h, x, y )
    tkTest_PumpFor( h, 40 )
end sub

public sub ThemePass( byref t as Tally, byval sc as single )
    dim as ustring tk = TestCompiler( )
    t.Check( len( tk ) > 0, P( sc, "theme: a tiko compiler ($TKEDIT_TIKO)" ) )
    if len( tk ) = 0 then exit sub
    dim as mainwin.Window mw
    mw.ConfigDir = FreshConfig( )
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    mw.Launch = @ScriptedLaunch
    t.Check( mw.Create( sc ), P( sc, "theme: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_PumpFor( h, 150 )
    ' builds with the test's compiler, and on Linux the SDL libraries' path (as finishpass)
    mw.Prefs.Tiko = tk
    dim as ustring ldPath = environ( "LD_LIBRARY_PATH" )
    if len( ldPath ) = 0 then ldPath = LinkPathForBuilds( )
    if (platform.CurrentOs( ) = platform.Os.Linux) andalso (len( ldPath ) > 0) then
        for i as long = 0 to mw.Prefs.Builds.Count( ) - 1
            mw.Prefs.Builds[i].Options &= " -p " & ldPath
        next
    end if
    dim as ustring proj = fs.PathJoin( Files( ), "themeproj" & cint( sc * 100 ) )
    fs.RemoveDirAll( proj )
    t.Check( mw.NewFormProject( proj ), P( sc, "theme: a new GUI project" ) )
    tkTest_PumpFor( h, 100 )
    t.Check( mw.CanRun( Cmd.FormTheme ), P( sc, "Form > Project Theme... with a project open" ) )
    mw.Execute( Cmd.FormTheme )
    tkTest_PumpFor( h, 120 )
    dim as themecenter.ThemeDialog ptr dlg = mw.ThemeDlg
    t.Check( (dlg <> 0) andalso (dlg->Win <> 0), P( sc, "the Theme Center opens" ) )
    if (dlg = 0) orelse (dlg->Win = 0) then
        mw.Destroy( )
        exit sub
    end if
    dim as TK_HOST ptr th = tkForm_Host( dlg->Win )
    tkTest_PumpFor( th, 80 )
    t.Check( dlg->Doc.Name = "Default", P( sc, "on the project's appTheme: " & dlg->Doc.Name ) )
    t.Check( tkListTree_GetCount( dlg->Gallery ) = 6, P( sc, "the gallery: six shipped themes, " & tkListTree_GetCount( dlg->Gallery ) ) )
    dim as TKBUTTON_COLORS bc

    ' ---- an accent: the preview follows, derived as the program will
    TypeInto( th, dlg->TxtAccent, "#E65100" )
    t.Check( dlg->Doc.Accent = "#E65100", P( sc, "an accent typed: " & dlg->Doc.Accent ) )
    tkButton_GetColors( dlg->PvButton, @bc )
    t.Check( bc.FocusRingColor = tkTheme_Derive( tkTheme_Dark( ), &hFFE65100ul ).FocusRing, P( sc, "the preview's focus ring is the derived accent: " & hex( bc.FocusRingColor ) ) )
    t.Check( tkTheme_Get( ).Accent <> tkTheme_Derive( tkTheme_Dark( ), &hFFE65100ul ).Accent, P( sc, "tkEdit's own theme is untouched" ) )

    ' ---- High Contrast from the gallery: its own AA check passes, in both variants
    dim as long row = GalleryRow( dlg->Gallery, "High Contrast" )
    t.Check( row >= 0, P( sc, "High Contrast is in the gallery" ) )
    ClickRow( th, dlg->Gallery, row )
    PressIn( th, dlg->BtnUse )
    t.Check( dlg->Doc.Name = "High Contrast", P( sc, "Use This Theme: " & dlg->Doc.Name ) )
    t.Check( tkLabel_GetText( dlg->LblContrast ) = "Contrast: every pair passes AA", P( sc, "dark: " & tkLabel_GetText( dlg->LblContrast ) ) )
    tkButton_GetColors( dlg->PvButton, @bc )
    t.Check( (bc.BackColor = &hFF000000ul) andalso (bc.BorderColor = &hFFFFFFFFul), _
             P( sc, "the preview wears it, its [controls.Button] border too: " & hex( bc.BackColor ) & " " & hex( bc.BorderColor ) ) )
    ClickVariant( th, dlg->SelVariant, 1 )
    t.Check( dlg->IsDark = false, P( sc, "Light chosen" ) )
    t.Check( tkLabel_GetText( dlg->LblContrast ) = "Contrast: every pair passes AA", P( sc, "light: " & tkLabel_GetText( dlg->LblContrast ) ) )
    tkButton_GetColors( dlg->PvButton, @bc )
    t.Check( (bc.BackColor = &hFFFFFFFFul) andalso (bc.BorderColor = &hFF000000ul), P( sc, "the light variant in the preview: " & hex( bc.BackColor ) ) )

    ' ---- a role in the variant shown, then given back
    tkTabControl_SetCurSel( dlg->Tabs, 1 )
    tkTest_PumpFor( th, 40 )
    ClickRow( th, dlg->Roles, TKROLE_SURFACE )
    TypeInto( th, dlg->TxtRole, "#123456" )
    t.Check( SettingOr( dlg->Doc.Light.Roles, "Surface" ) = "#123456", P( sc, "a role set in Light: " & SettingOr( dlg->Doc.Light.Roles, "Surface" ) ) )
    tkButton_GetColors( dlg->PvButton, @bc )
    t.Check( bc.BackColor = &hFF123456ul, P( sc, "and the preview's face follows it" ) )
    t.Check( instr( tkLabel_GetText( dlg->LblContrast ), "Text on Surface" ) = 1, P( sc, "a poor pair is reported: " & tkLabel_GetText( dlg->LblContrast ) ) )
    PressIn( th, dlg->BtnRoleReset )
    t.Check( (FindSetting( dlg->Doc.Light.Roles, "Surface" ) >= 0) = false, P( sc, "Reset gives the role back to the theme" ) )

    ' ---- the corner radius, by the keyboard on its spinner
    tkTabControl_SetCurSel( dlg->Tabs, 2 )
    tkTest_PumpFor( th, 40 )
    PressIn( th, dlg->NudRadius )
    Chord( th, SDLK_UP, SDL_SCANCODE_UP, 0 )
    Chord( th, SDLK_UP, SDL_SCANCODE_UP, 0 )
    Chord( th, SDLK_UP, SDL_SCANCODE_UP, 0 )
    tkTest_PumpFor( th, 40 )
    t.Check( dlg->Doc.CornerRadius = 2, P( sc, "corner radius -1 + 3: " & dlg->Doc.CornerRadius ) )
    t.Check( tkButton_GetCornerCurvature( dlg->PvButton ) = tkHost_Scale( th, 4 ), P( sc, "the preview's corners follow: " & tkButton_GetCornerCurvature( dlg->PvButton ) ) )

    ' ---- a style, and a line that isn't one
    tkTabControl_SetCurSel( dlg->Tabs, 3 )
    tkTest_PumpFor( th, 40 )
    PressIn( th, dlg->BtnStyleAdd )
    t.Check( (dlg->Doc.Styles.Count( ) = 1) andalso (dlg->Doc.Styles[0].Name = "Style1"), P( sc, "Add makes Style1" ) )
    TypeInto( th, dlg->TxtStyleName, "Primary" )
    t.Check( dlg->Doc.Styles[0].Name = "Primary", P( sc, "renamed: " & dlg->Doc.Styles[0].Name ) )
    tkButton_GetColors( dlg->PvStyled, @bc )
    t.Check( dlg->PvStyled->isVisible andalso (bc.BackColor = themefile.Resolve( dlg->Doc, false ).Accent), P( sc, "the preview's second button wears it: " & hex( bc.BackColor ) ) )
    TypeInto( th, dlg->TxtStyleLines, "Surfce = @Accent" )
    t.Check( instr( tkLabel_GetText( dlg->LblStyleProblem ), "'Surfce'" ) > 0, P( sc, "a bad line is reported: " & tkLabel_GetText( dlg->LblStyleProblem ) ) )
    TypeInto( th, dlg->TxtStyleLines, "Surface = @Error" )
    t.Check( SettingOr( dlg->Doc.Styles[0].Roles, "Surface" ) = "@Error", P( sc, "a good one taken" ) )

    ' ---- Save: the theme, its module, and a main that didn't install it made to
    dim as ustring mainPath = fs.PathJoin( proj, "main.tiko" ), none
    dim as ustring nl = wchr( 10 )
    ' main.tiko closed, so its new text is the file's (an open one takes it in its buffer instead)
    dim as DocRef openMain = mw.FindOpen( mainPath )
    if openMain then
        openMain->Main.SetSavePoint( )
        mw.CloseDoc( openMain )
        tkTest_PumpFor( h, 30 )
    end if
    fs.WriteAllText( mainPath, "#import ""vendor/tkControls/tkApp""" & nl & "#import ""./frmMain""" & nl & "using tkApp" & nl & nl _
        & "dim as TKAPP_OPTIONS options" & nl & "if tkApp_Init( options ) = false then end 1" & nl & "dim as frmMain.Form mainForm" & nl _
        & "mainForm.Build( )" & nl & "end tkApp_Run( mainForm.Wnd )" & nl )
    PressIn( th, dlg->BtnSave )
    tkTest_PumpFor( h, 60 )
    dim as ustring themePath = fs.PathJoin( proj, "appTheme", "appTheme.tktheme" )
    dim as ustring saved = fs.ReadAllText( themePath ).ValueOr( none )
    t.Check( saved = themefile.Render( dlg->Doc ), P( sc, "Save writes the theme" ) )
    t.Check( instr( fs.ReadAllText( fs.PathJoin( proj, "appTheme", "appTheme.design.tiko" ) ).ValueOr( none ), "gStyles_( 0 ).Name = ""Primary""" ) > 0, _
             P( sc, "and its module" ) )
    dim as ustring mainNow = fs.ReadAllText( mainPath ).ValueOr( none )
    t.Check( (instr( mainNow, "appTheme.ApplyOptions( options )" ) > 0) andalso (instr( mainNow, "appTheme.Install( )" ) > 0) _
             andalso (instr( mainNow, "#import ""./appTheme""" ) > 0), P( sc, "and main.tiko installs it" ) )
    mw.StartBuild( build.BuildAction.Compile, false )
    dim as boolean waited = WaitBuild( mw )
    t.Check( waited andalso mw.BuildSucceeded, P( sc, "the project builds with it: " & right( mw.BuildRaw, 400 ) ) )

    ' ---- Save to Library: a copy by the theme's name, and the gallery lists it
    PressIn( th, dlg->BtnLibrary )
    tkTest_PumpFor( th, 40 )
    t.Check( fs.IsFile( fs.PathJoin( mw.ConfigDir, "themes", "High Contrast.tktheme" ) ), P( sc, "Save to Library" ) )
    t.Check( tkListTree_GetCount( dlg->Gallery ) = 7, P( sc, "and the gallery has it: " & tkListTree_GetCount( dlg->Gallery ) ) )
    t.Check( fs.ReadAllText( themePath ).ValueOr( none ) = saved, P( sc, "the project's file is where it was" ) )

    ' ---- Close
    PressIn( th, dlg->BtnClose )
    tkTest_PumpFor( h, 40 )
    t.Check( mw.ThemeDlg = 0, P( sc, "Close" ) )
    for each dd as DocRef in mw.Docs
        dd->Main.SetSavePoint( )
    next
    mw.Destroy( )
end sub
