' bindpass -- data binding in the inspector (Form Designer B1): the form's DataType and DataModule
' rows, a TextBox's Bind row and its "...", which offers the DataType's fields as the scans know
' them (a hand-made set stands in for a scan here); a pick goes in through the row. A ReportViewer's
' Report row, whose "..." offers the project's report modules.
#module "selftest"

#import "std/containers"
#import "std/fs"
#import "tka/mainwin"
#import "tka/documents"
#import "tkc/symboldb"
#import "tkd/canvas"
#import "tkd/edits"
#import "tkd/model"
#import "tkd/panels"
#import "tkd/catalog"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkPopupMenu"
#import "vendor/tkControls/tkTextBox"
#import "vendor/tkControls/tkMeta"
#import "vendor/tkControls/tkLabel"
using containers
using tkApp
using tkHost
using tkTest
using model
using tkPopupMenu
using tkTextBox
using tkMeta
using tkLabel

private function BindRow_( byval ps as panels.DesignPanels ptr, byref key_ as const ustring ) as long
    for i as long = 0 to ps->Rows.Count( ) - 1
        if ps->Rows[i].Key = key_ then return i
    next
    return -1
end function

private function BindSym_( byval k as symboldb.SymKind, byref nm as const ustring, byref ty as const ustring, byval parent as long ) as symboldb.Sym
    dim as symboldb.Sym y
    y.Kind = k : y.Name = nm : y.TypeText = ty : y.Parent = parent : y.LineNo = 1
    y.File = "C:\BINDPASS\PEOPLE.TIKO"
    return y
end function

public sub BindPass( byref t as Tally, byval sc as single )
    dim as mainwin.Window mw
    mw.ConfigDir = FreshConfig( )
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    t.Check( mw.Create( sc ), P( sc, "binding: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_PumpFor( h, 150 )
    dim as ustring proj = fs.PathJoin( Files( ), "bindproj" & cint( sc * 100 ) )
    fs.RemoveDirAll( proj )
    t.Check( mw.NewFormProject( proj ), P( sc, "binding: a new GUI project" ) )
    tkTest_PumpFor( h, 100 )
    dim as DocRef d = mw.Active( )
    dim as canvas.FormCanvas ptr c = 0
    if d then c = d->Designer
    t.Check( c <> 0, P( sc, "binding: the form on its surface" ) )
    if c = 0 then
        mw.Destroy( )
        exit sub
    end if
    dim as FormDoc trial = c->Doc
    edits.AddControl( trial, "TextBox", "", -1, 20, 20, 160, 28 )
    edits.AddControl( trial, "Button", "", -1, 20, 60, 100, 30 )
    t.Check( len( c->ApplyEdit( trial, true, "" ) ) = 0, P( sc, "binding: a TextBox and a Button" ) )

    ' ---- the form's rows
    c->SelectNone( )
    tkTest_PumpFor( h, 60 )
    dim as panels.DesignPanels ptr ps = @mw.Palettes
    t.Check( (BindRow_( ps, "@DataType" ) >= 0) andalso (BindRow_( ps, "@DataModule" ) >= 0), P( sc, "the form has DataType and DataModule rows" ) )
    t.Check( len( ps->Apply( "@DataModule", "../people" ) ) = 0, P( sc, "DataModule set" ) )
    t.Check( len( ps->Apply( "@DataType", "people.Person" ) ) = 0, P( sc, "DataType set" ) )
    t.Check( (c->Doc.DataType = "people.Person") andalso (c->Doc.DataModule = "../people"), P( sc, "both in the model: " & c->Doc.DataType & " " & c->Doc.DataModule ) )
    t.Check( len( ps->Apply( "@DataType", "people." ) ) > 0, P( sc, "a DataType that is no type name is refused" ) )
    t.Check( c->Doc.DataType = "people.Person", P( sc, "...and the old one stays" ) )

    ' ---- a TextBox's Bind row; a Button has none
    c->SelectOnly( "Button1" )
    tkTest_PumpFor( h, 60 )
    t.Check( BindRow_( ps, "@Bind" ) < 0, P( sc, "a Button has no Bind row" ) )
    c->SelectOnly( "TextBox1" )
    tkTest_PumpFor( h, 60 )
    dim as long br = BindRow_( ps, "@Bind" )
    t.Check( (br >= 0) andalso (ps->Rows[br].Btn <> 0), P( sc, "a TextBox has a Bind row with a ""..."" button" ) )
    if br < 0 then
        mw.Destroy( )
        exit sub
    end if

    ' ---- "..." before the type is scanned: no menu
    dim as TK_WIDGET ptr btn = ps->Rows[br].Btn
    ps->ShowFields( btn )
    t.Check( (ps->FieldMenu = 0) orelse (tkPopupMenu_IsOpen( ps->FieldMenu ) = false), P( sc, "no fields known: no menu" ) )

    ' ---- a scan that knows Person: its fields, one level into Address
    dim as symboldb.SymbolSet st
    st.Root = "c:\bindpass\people.tiko"
    st.Syms.Push( BindSym_( symboldb.SymKind.TypeDef, "Address", "", -1 ) )        ' 0
    st.Syms.Push( BindSym_( symboldb.SymKind.Field, "City", "ustring", 0 ) )       ' 1
    st.Syms.Push( BindSym_( symboldb.SymKind.TypeDef, "Person", "", -1 ) )         ' 2
    st.Syms.Push( BindSym_( symboldb.SymKind.Field, "Name", "ustring", 2 ) )       ' 3
    st.Syms.Push( BindSym_( symboldb.SymKind.Field, "Age", "long", 2 ) )           ' 4
    st.Syms.Push( BindSym_( symboldb.SymKind.Field, "Home", "Address", 2 ) )       ' 5
    mw.Db.Install( st )
    ps->ShowFields( btn )
    tkTest_PumpFor( h, 30 )
    t.Check( (ps->FieldMenu <> 0) andalso tkPopupMenu_IsOpen( ps->FieldMenu ), P( sc, "the ""..."" opens a menu" ) )
    dim as ustring names_
    if ps->FieldMenu then
        for i as long = 0 to tkPopupMenu_GetItemCount( ps->FieldMenu ) - 1
            if i then names_ &= "|"
            names_ &= ps->FieldNames[i]
        next
    end if
    t.Check( names_ = "Name|Age|Home|Home.City", P( sc, "the menu lists Person's fields: " & names_ ) )
    if ps->FieldMenu then tkPopupMenu_Hide( ps->FieldMenu )
    ps->PickField( 3 )
    tkTest_PumpFor( h, 30 )
    dim as long ti = FindControl( c->Doc, "TextBox1" )
    t.Check( (ti >= 0) andalso (c->Doc.Controls[ti].Bind = "Home.City"), P( sc, "a pick binds the TextBox" ) )
    t.Check( tkTextBox_GetText( ps->Rows[BindRow_( ps, "@Bind" )].Edit ) = "Home.City", P( sc, "...and the row shows it" ) )

    ' ---- typed: a bad field is refused, a good one taken
    t.Check( len( ps->Apply( "@Bind", "Home..City" ) ) > 0, P( sc, "a field path that is no name is refused" ) )
    t.Check( len( ps->Apply( "@Bind", "Age" ) ) = 0, P( sc, "a typed field is taken" ) )
    t.Check( c->Doc.Controls[ti].Bind = "Age", P( sc, "...into the model" ) )
    ' ---- B2: a bound TextBox's rule rows; validation through them; they go with Bind
    tkTest_PumpFor( h, 60 )
    t.Check( (BindRow_( ps, "@Req" ) >= 0) andalso (BindRow_( ps, "@Min" ) >= 0) andalso (BindRow_( ps, "@Max" ) >= 0) _
        andalso (BindRow_( ps, "@MaxLen" ) >= 0) andalso (BindRow_( ps, "@Fmt" ) >= 0), P( sc, "rules: a bound TextBox has its five rule rows" ) )
    t.Check( len( ps->Apply( "@Min", "ten" ) ) > 0, P( sc, "rules: a Minimum that is no number is refused" ) )
    t.Check( (len( ps->Apply( "@Min", "1" ) ) = 0) andalso (len( ps->Apply( "@Max", "120" ) ) = 0) andalso (len( ps->Apply( "@Req", "true" ) ) = 0), _
        P( sc, "rules: Minimum, Maximum, Required taken" ) )
    t.Check( len( ps->Apply( "@Max", "0" ) ) > 0, P( sc, "rules: a Maximum below the Minimum is refused" ) )
    t.Check( len( ps->Apply( "@MaxLen", "abc" ) ) > 0, P( sc, "rules: a MaxLength that is no number is refused" ) )
    t.Check( len( ps->Apply( "@Fmt", "abc" ) ) > 0, P( sc, "rules: a Format that is neither kind is refused" ) )
    t.Check( len( ps->Apply( "@Fmt", ".1f" ) ) = 0, P( sc, "rules: a number Format taken" ) )
    with c->Doc.Controls[ti]
        t.Check( .Required andalso (.Minimum = "1") andalso (.Maximum = "120") andalso (.Format = ".1f"), P( sc, "rules: all in the model" ) )
    end with
    t.Check( ps->ValueOf( "@Req" ) = "true", P( sc, "rules: the Required row reads it back" ) )
    c->SelectOnly( "Button1" )
    tkTest_PumpFor( h, 60 )
    t.Check( BindRow_( ps, "@Req" ) < 0, P( sc, "rules: a Button has no rule rows" ) )
    c->SelectOnly( "TextBox1" )
    tkTest_PumpFor( h, 60 )
    t.Check( len( ps->Apply( "@Bind", "" ) ) = 0, P( sc, "rules: clearing Bind is taken" ) )
    tkTest_PumpFor( h, 60 )
    with c->Doc.Controls[ti]
        t.Check( (.Required = false) andalso (len( .Minimum ) = 0) andalso (len( .Format ) = 0), P( sc, "rules: ...and takes the rules with it" ) )
    end with
    t.Check( BindRow_( ps, "@Req" ) < 0, P( sc, "rules: ...and the rows go" ) )
    t.Check( len( ps->Apply( "@Bind", "Age" ) ) = 0, P( sc, "rules: bound again" ) )

    ' the DataType can't go while a control is bound to one of its fields
    c->SelectNone( )
    tkTest_PumpFor( h, 60 )
    t.Check( len( ps->Apply( "@DataType", "" ) ) > 0, P( sc, "clearing DataType with a bound control is refused" ) )

    ' ---- a two-value control: a range Slider's BindUpper row (bind2). controls.toml has no Slider
    ' bind yet, so its table entry stands in here and is put back.
    dim as TKMETA_CONTROL ptr m = catalog.Find( "Slider" )
    dim as TKMETA_CONTROL keep
    if m then
        keep = *m
        if len( m->Bind2Kind ) = 0 then
            m->BindKind = "float" : m->BindGet = "tkSlider_GetValue" : m->BindSet = "tkSlider_SetValue"
            m->Bind2Kind = "float" : m->Bind2Get = "tkSlider_GetUpperValue" : m->Bind2Set = "tkSlider_SetUpperValue"
            m->Bind2Name = "BindUpper" : m->Bind2When = "Mode=Range"
        end if
        trial = c->Doc
        edits.AddControl( trial, "Slider", "", -1, 20, 100, 200, 32 )
        t.Check( len( c->ApplyEdit( trial, true, "" ) ) = 0, P( sc, "bind2: a Slider" ) )
        c->SelectOnly( "Slider1" )
        tkTest_PumpFor( h, 60 )
        t.Check( (BindRow_( ps, "@Bind" ) >= 0) andalso (BindRow_( ps, "@Bind2" ) < 0), P( sc, "bind2: a single Slider has Bind, no BindUpper" ) )
        t.Check( len( ps->Apply( "Mode", "Range" ) ) = 0, P( sc, "bind2: Mode = Range" ) )
        tkTest_PumpFor( h, 60 )
        dim as long b2 = BindRow_( ps, "@Bind2" )
        t.Check( (b2 >= 0) andalso (ps->Rows[b2].Btn <> 0), P( sc, "bind2: in Range mode a BindUpper row, with a ""..."" button" ) )
        if b2 >= 0 then
            t.Check( tkLabel_GetText( ps->Rows[b2].Label ) = "BindUpper", P( sc, "bind2: the row is named BindUpper: " & tkLabel_GetText( ps->Rows[b2].Label ) ) )
            t.Check( len( ps->Apply( "@Bind", "Age" ) ) = 0, P( sc, "bind2: the lower value bound" ) )
            ps->ShowFields( ps->Rows[BindRow_( ps, "@Bind2" )].Btn )
            tkTest_PumpFor( h, 30 )
            if ps->FieldMenu then tkPopupMenu_Hide( ps->FieldMenu )
            ps->PickField( 0 )
            tkTest_PumpFor( h, 30 )
            dim as long si = FindControl( c->Doc, "Slider1" )
            t.Check( (si >= 0) andalso (c->Doc.Controls[si].Bind2 = "Name") andalso (c->Doc.Controls[si].Bind = "Age"), _
                P( sc, "bind2: a pick from BindUpper's menu fills BindUpper, not Bind" ) )
            t.Check( len( ps->Apply( "Mode", "Single" ) ) > 0, P( sc, "bind2: back to Single is refused while BindUpper is bound" ) )
            t.Check( len( ps->Apply( "@Bind2", "" ) ) = 0, P( sc, "bind2: BindUpper cleared" ) )
            t.Check( len( ps->Apply( "Mode", "Single" ) ) = 0, P( sc, "bind2: ...then Single is taken" ) )
            tkTest_PumpFor( h, 60 )
            t.Check( BindRow_( ps, "@Bind2" ) < 0, P( sc, "bind2: and the BindUpper row goes" ) )
        end if
        *m = keep
    end if
    ' ---- B3: a ComboBox's and a ListTree's list rows; the element fields' menu from ItemType
    trial = c->Doc
    edits.AddControl( trial, "ComboBox", "", -1, 20, 140, 160, 28 )
    edits.AddControl( trial, "ListTree", "", -1, 200, 140, 200, 120 )
    t.Check( len( c->ApplyEdit( trial, true, "" ) ) = 0, P( sc, "list: a ComboBox and a ListTree" ) )
    c->SelectOnly( "ComboBox1" )
    tkTest_PumpFor( h, 60 )
    t.Check( (BindRow_( ps, "@ItemsField" ) >= 0) andalso (BindRow_( ps, "@ItemsSource" ) >= 0) andalso (BindRow_( ps, "@ItemType" ) >= 0) _
        andalso (BindRow_( ps, "@Display" ) >= 0) andalso (BindRow_( ps, "@Value" ) >= 0) andalso (BindRow_( ps, "@Check" ) < 0), _
        P( sc, "list: a ComboBox's rows: source, type, DisplayField, ValueField" ) )
    t.Check( (len( ps->Apply( "@ItemsSource", "Staff" ) ) = 0) andalso (len( ps->Apply( "@ItemType", "people.Person" ) ) = 0), P( sc, "list: a source and its type" ) )
    dim as long db_ = BindRow_( ps, "@Display" )
    if db_ >= 0 then
        ps->ShowFields( ps->Rows[db_].Btn )
        tkTest_PumpFor( h, 30 )
        dim as ustring dn
        for i as long = 0 to ps->FieldNames.Count( ) - 1
            if i then dn &= "|"
            dn &= ps->FieldNames[i]
        next
        t.Check( dn = "Name|Age|Home|Home.City", P( sc, "list: DisplayField's menu lists ItemType's fields: " & dn ) )
        if ps->FieldMenu then tkPopupMenu_Hide( ps->FieldMenu )
        ps->PickField( 0 )
        tkTest_PumpFor( h, 30 )
    end if
    dim as long cb = FindControl( c->Doc, "ComboBox1" )
    t.Check( (cb >= 0) andalso (c->Doc.Controls[cb].DisplayField = "Name"), P( sc, "list: a pick fills DisplayField" ) )
    t.Check( len( ps->Apply( "@Value", "Age" ) ) = 0, P( sc, "list: a typed ValueField" ) )
    t.Check( len( ps->Apply( "@ItemsField", "Kids" ) ) > 0, P( sc, "list: an ItemsField beside an ItemsSource is refused" ) )
    c->SelectOnly( "ListTree1" )
    tkTest_PumpFor( h, 60 )
    t.Check( (BindRow_( ps, "@Check" ) >= 0) andalso (BindRow_( ps, "@Display" ) < 0), P( sc, "list: a ListTree has CheckField, no DisplayField" ) )

    ' ---- B4: a Navigator's rows: its records and the list it follows
    trial = c->Doc
    edits.AddControl( trial, "Navigator", "", -1, 20, 280, 260, 30 )
    t.Check( len( c->ApplyEdit( trial, true, "" ) ) = 0, P( sc, "nav: a Navigator" ) )
    c->SelectOnly( "Navigator1" )
    tkTest_PumpFor( h, 60 )
    t.Check( (BindRow_( ps, "@ItemsSource" ) >= 0) andalso (BindRow_( ps, "@Follows" ) >= 0) andalso (BindRow_( ps, "@ItemsField" ) < 0) _
        andalso (BindRow_( ps, "@Display" ) < 0), P( sc, "nav: ItemsSource and Follows, no other list rows" ) )
    t.Check( len( ps->Apply( "@ItemsSource", "Staff" ) ) = 0, P( sc, "nav: its records" ) )
    t.Check( len( ps->Apply( "@Follows", "ListTree1" ) ) > 0, P( sc, "nav: following a list on other records is refused" ) )
    t.Check( len( ps->Apply( "@Follows", "ComboBox1" ) ) = 0, P( sc, "nav: following the combo on Staff is taken" ) )
    dim as long nv = FindControl( c->Doc, "Navigator1" )
    t.Check( (nv >= 0) andalso (c->Doc.Controls[nv].Follows = "ComboBox1") andalso (ps->ValueOf( "@Follows" ) = "ComboBox1"), P( sc, "nav: in the model and the row" ) )

    ' ---- RD4: a ReportViewer's Report row; its "..." lists the project's .tkreport modules, a pick sets it
    dim as ustring rptDir = fs.PathJoin( proj, "rptSales" )
    fs.CreateDirAll( rptDir )
    fs.WriteAllText( fs.PathJoin( rptDir, "rptSales.tkreport" ), "format = 1" & chr( 10 ) )
    trial = c->Doc
    edits.AddControl( trial, "ReportViewer", "", -1, 300, 20, 300, 200 )
    c->ApplyEdit( trial, true, "" )
    c->SelectOnly( "ReportViewer1" )
    tkTest_PumpFor( h, 60 )
    dim as long rr = BindRow_( ps, "@Report" )
    dim as ustring rn
    if (rr >= 0) andalso (ps->Rows[rr].Btn <> 0) then
        ps->ShowFields( ps->Rows[rr].Btn )
        tkTest_PumpFor( h, 30 )
        for i as long = 0 to ps->FieldNames.Count( ) - 1
            if i then rn &= "|"
            rn &= ps->FieldNames[i]
        next
        if ps->FieldMenu then tkPopupMenu_Hide( ps->FieldMenu )
        ps->PickField( 0 )
        tkTest_PumpFor( h, 30 )
    end if
    dim as long rvi = FindControl( c->Doc, "ReportViewer1" )
    t.Check( (rn = "../rptSales") andalso (rvi >= 0) andalso (c->Doc.Controls[rvi].Report = "../rptSales"), _
        P( sc, "report: a ReportViewer's Report row offers the project's reports; a pick sets it: " & rn ) )

    mw.Db.Remove( "c:\bindpass\people.tiko" )
    mw.Destroy( )
end sub
