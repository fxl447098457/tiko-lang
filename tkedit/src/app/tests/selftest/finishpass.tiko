' finishpass -- Test Form, New Form, New Project's starts and translatable captions, in the real window.
#module "selftest"

#import "std/containers"
#import "std/fs"
#import "std/process"
#import "std/strings"
#import "tkp/platform"
#import "tkc/build"
#import "tkc/cmdids"
#import "tkc/project"
#import "tka/documents"
#import "tka/mainwin"
#import "tkd/canvas"
#import "tkd/model"
#import "tkd/panels"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkPaint"
#import "vendor/tkControls/tkTextBox"
#import "vendor/tkControls/tkCheckBox"
using containers
using cmdids
using tkApp
using tkHost
using tkTest
using tkPaint
using tkTextBox
using tkCheckBox
using model

public sub FinishPass( byref t as Tally, byval sc as single )
    dim as ustring tk = TestCompiler( )
    t.Check( len( tk ) > 0, P( sc, "finish: a tiko compiler ($TKEDIT_TIKO)" ) )
    if len( tk ) = 0 then exit sub
    dim as mainwin.Window mw
    mw.ConfigDir = FreshConfig( )
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    mw.Launch = @ScriptedLaunch
    t.Check( mw.Create( sc ), P( sc, "finish: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_PumpFor( h, 150 )
    mw.Prefs.Tiko = tk
    dim as ustring ldPath = environ( "LD_LIBRARY_PATH" )
    if len( ldPath ) = 0 then ldPath = LinkPathForBuilds( )
    if (platform.CurrentOs( ) = platform.Os.Linux) andalso (len( ldPath ) > 0) then
        for i as long = 0 to mw.Prefs.Builds.Count( ) - 1
            mw.Prefs.Builds[i].Options &= " -p " & ldPath
        next
    end if
    dim as ustring dir_ = fs.PathJoin( Files( ), "finish" & cint( sc * 100 ) )
    fs.RemoveDirAll( dir_ )
    fs.CreateDirAll( dir_ )

    ' ---- New Form: a folder of its own, three files, on the surface
    t.Check( mw.CanRun( Cmd.FormTest ) = false, P( sc, "Test Form needs a form" ) )
    t.Check( mw.CanRun( Cmd.FormNewForm ), P( sc, "New Form doesn't" ) )
    dim as ustring pth = fs.PathJoin( dir_, "frmOne.tkform" )
    t.Check( mw.NewForm( pth ), P( sc, "New Form" ) )
    tkTest_PumpFor( h, 80 )
    dim as ustring formPath = fs.PathJoin( dir_, "frmOne", "frmOne.tkform" )
    t.Check( fs.IsFile( formPath ), P( sc, "in a folder of its own" ) )
    t.Check( fs.IsFile( fs.PathJoin( dir_, "frmOne", "frmOne.tiko" ) ), P( sc, "with its code" ) )
    t.Check( fs.IsFile( fs.PathJoin( dir_, "frmOne", "frmOne.design.tiko" ) ), P( sc, "and its generated half" ) )
    dim as DocRef d = mw.FindOpen( formPath )
    t.Check( (d <> 0) andalso (d->Designer <> 0) andalso (mw.Active( ) = d), P( sc, "open on a surface" ) )
    if (d = 0) orelse (d->Designer = 0) then
        mw.Destroy( )
        exit sub
    end if
    dim as canvas.FormCanvas ptr c = d->Designer
    t.Check( mw.NewForm( pth ) = false, P( sc, "not twice" ) )
    t.Check( instr( mw.Message, "already exists" ) > 0, P( sc, "it says so: " & mw.Message ) )
    t.Check( mw.NewForm( fs.PathJoin( dir_, "print.tkform" ) ) = false, P( sc, "a reserved word is no form name" ) )
    t.Check( mw.NewForm( fs.PathJoin( dir_, "form.tkform" ) ) = false, P( sc, "nor Form" ) )

    ' a form saved into a folder of its own name doesn't nest
    fs.CreateDirAll( fs.PathJoin( dir_, "frmTwo" ) )
    t.Check( mw.NewForm( fs.PathJoin( dir_, "frmTwo", "frmTwo.tkform" ) ), P( sc, "a form into its own folder" ) )
    t.Check( fs.IsFile( fs.PathJoin( dir_, "frmTwo", "frmTwo.tkform" ) ), P( sc, "doesn't nest" ) )
    mw.ShowDoc( d )
    tkTest_PumpFor( h, 60 )

    ' ---- Test Form: live controls, its own window, the form untouched
    c->Tool = "TextBox"
    dim as TKRECT rs = c->SurfaceRect( ), rg
    tkWidget_AbsRect( c->Glass, rg )
    ClickPx( h, rg.left + rs.left + tkHost_Scale( h, 16 ), rg.top + rs.top + tkHost_Scale( h, 16 ) )
    tkTest_PumpFor( h, 60 )
    c->Tool = "Button"
    ClickPx( h, rg.left + rs.left + tkHost_Scale( h, 360 ), rg.top + rs.top + tkHost_Scale( h, 16 ) )
    tkTest_PumpFor( h, 60 )
    c->Doc.Controls[1].Anchor = 6       ' top and right
    c->Commit( )
    Chord( h, SDLK_S, SDL_SCANCODE_S, TK_KMOD_PRIMARY )
    tkTest_PumpFor( h, 40 )
    dim as ustring before = d->Text( )
    Chord( h, SDLK_F5, SDL_SCANCODE_F5, SDL_KMOD_ALT )
    tkTest_PumpFor( h, 120 )
    t.Check( mw.PreviewForm <> 0, P( sc, "Alt+F5 opens Test Form" ) )
    if mw.PreviewForm then
        dim as TK_HOST ptr ph = tkForm_Host( mw.PreviewForm )
        dim as canvas.FormCanvas ptr pv = mw.Preview
        ' a corner clear of grid dots and grips: the form as designed is the form as run; around it, the backdrop
        tkTest_PumpFor( h, 30 )
        tkTest_PumpFor( ph, 30 )
        tkHost_RenderTo( h, false )        ' the back buffer is undefined after a present
        tkHost_RenderTo( ph, false )
        dim as TKRECT rcDes, rcRun, rcBack
        tkWidget_AbsRect( c->Surface, rcDes )
        tkWidget_AbsRect( pv->Surface, rcRun )
        tkWidget_AbsRect( c->Frame, rcBack )
        dim as ulong pxDes = tkTest_PixelAt( h, rcDes.left + 2, rcDes.top + 2 ), pxRun = tkTest_PixelAt( ph, rcRun.left + 2, rcRun.top + 2 )
        t.Check( pxDes = tkApp_Theme( ).Window, P( sc, "the designer's form is the theme's window colour: " & hex( pxDes ) ) )
        t.Check( pxDes = pxRun, P( sc, "and Test Form's: " & hex( pxDes ) & " " & hex( pxRun ) ) )
        t.Check( tkTest_PixelAt( h, rcBack.left + 2, rcBack.top + 2 ) = canvas.BackdropColor( ), P( sc, "the canvas around it is the backdrop" ) )
        tkTest_PumpFor( ph, 80 )
        t.Check( *SDL_GetWindowTitle( ph->win ) = "frmOne", P( sc, "with the form's caption" ) )
        t.Check( ph->root->cw = tkHost_Scale( ph, 480 ), P( sc, "at the form's size" ) )
        dim as TK_WIDGET ptr tb = pv->WidgetOf( "TextBox1" ), bt = pv->WidgetOf( "Button1" )
        t.Check( tb->isFocusable, P( sc, "its controls take the keyboard" ) )
        t.Check( tkHost_HitTest( ph, tkTest_CX( bt ), tkTest_CY( bt ) ) = bt, P( sc, "and the mouse" ) )
        tkTest_Click( ph, tkTest_CX( tb ), tkTest_CY( tb ) )
        tkTest_PumpFor( ph, 40 )
        dim as ustring typed = "live"
        tkTest_PushText( ph, typed )
        tkTest_PumpFor( ph, 40 )
        t.Check( instr( tkTextBox_GetText( tb ), "live" ) > 0, P( sc, "typing works: " & tkTextBox_GetText( tb ) ) )
        dim as long gap0 = ph->root->cw - (bt->x + bt->cw)
        SDL_SetWindowSize( ph->win, ph->root->cw + tkForm_Scale( mw.PreviewForm, 80 ), ph->root->ch )
        SDL_SyncWindow( ph->win )
        tkTest_PumpFor( ph, 200 )
        t.Check( ph->root->cw - (bt->x + bt->cw) = gap0, P( sc, "a right-anchored control follows the window" ) )
        t.Check( d->Text( ) = before, P( sc, "the form itself isn't touched" ) )
        t.Check( d->IsModified( ) = false, P( sc, "nor modified" ) )
        ' Esc closes it, and the designer carries on
        tkTest_PushKey( ph, SDLK_ESCAPE, 0, true, SDL_SCANCODE_ESCAPE )
        tkTest_PumpFor( h, 100 )
        tkApp_Pump( )
        tkTest_PumpFor( h, 60 )
        t.Check( mw.PreviewForm = 0, P( sc, "Esc closes it" ) )
        t.Check( mw.Preview = 0, P( sc, "and it's cleaned up" ) )
        t.Check( tkHost_IsOpen( h ), P( sc, "the main window is fine" ) )
    end if
    ' twice in a row replaces it, and the close button works too
    mw.Execute( Cmd.FormTest )
    tkTest_PumpFor( h, 80 )
    mw.Execute( Cmd.FormTest )
    tkTest_PumpFor( h, 80 )
    t.Check( mw.PreviewForm <> 0, P( sc, "a second Test Form replaces the first" ) )
    if mw.PreviewForm then
        tkTest_PushWindowEvent( tkForm_Host( mw.PreviewForm ), SDL_EVENT_WINDOW_CLOSE_REQUESTED )
        tkTest_PumpFor( h, 100 )
        tkApp_Pump( )
        tkTest_PumpFor( h, 60 )
        t.Check( mw.PreviewForm = 0, P( sc, "its close button closes it" ) )
    end if

    ' ---- translatable captions
    dim as panels.DesignPanels ptr ps = @mw.Palettes
    c->SelectNone( )
    tkTest_PumpFor( h, 60 )
    dim as long tr_ = -1
    for r as long = 0 to ps->Rows.Count( ) - 1
        if ps->Rows[r].Key = "@Translate" then tr_ = r
    next
    t.Check( tr_ >= 0, P( sc, "a Translatable row" ) )
    if tr_ >= 0 then
        ClickOn( h, ps->Rows[tr_].Edit )
        tkTest_PumpFor( h, 30 )
        t.Check( c->Doc.Translate, P( sc, "it sets the form's flag" ) )
        t.Check( instr( d->Text( ), "translate = true" ) > 0, P( sc, "in the file" ) )
        Chord( h, SDLK_Z, SDL_SCANCODE_Z, TK_KMOD_PRIMARY )
        tkHost_SetFocus( h, c->Glass )
        Chord( h, SDLK_Z, SDL_SCANCODE_Z, TK_KMOD_PRIMARY )
        tkTest_PumpFor( h, 40 )
    end if

    ' ---- a form with no project says what it needs rather than failing to compile
    t.Check( mw.StartBuild( build.BuildAction.Compile, false ) = false, P( sc, "a form alone isn't built" ) )
    t.Check( mw.IsBuilding( ) = false, P( sc, "and nothing started" ) )

    ' a project made around a form's own file says the same
    dim as ustring wrongToml = fs.PathJoin( dir_, "frmTwo", "tiko.toml" )
    fs.WriteAllText( wrongToml, project.NewManifestText( "frmTwo", "frmTwo", "frmTwo.tiko" ) )
    t.Check( mw.OpenProject( wrongToml ), P( sc, "a project whose main is a form opens" ) )
    t.Check( mw.StartBuild( build.BuildAction.Compile, false ) = false, P( sc, "but isn't built" ) )
    mw.CloseProject( )                 ' with one open, Save As Project would save that one
    mw.OpenFile( formPath )            ' opening a project closed what was open, d with it
    tkTest_PumpFor( h, 40 )

    ' Save As Project on a form: a project around it, one folder up, that builds
    t.Check( mw.SaveAsProject( ), P( sc, "Save As Project on a form" ) )
    tkTest_PumpFor( h, 150 )
    t.Check( fs.IsFile( fs.PathJoin( dir_, "tiko.toml" ) ) andalso fs.IsFile( fs.PathJoin( dir_, "main.tiko" ) ), P( sc, "its files are beside the form's folder" ) )
    t.Check( fs.IsFile( fs.PathJoin( dir_, "frmOne", "tiko.toml" ) ) = false, P( sc, "not inside it" ) )
    t.Check( mw.ProjOpen andalso (mw.Active( ) <> 0) andalso (mw.Active( )->Designer <> 0), P( sc, "the project is open, the form in front" ) )
    mw.StartBuild( build.BuildAction.Compile, false )
    t.Check( WaitBuild( mw ) andalso mw.BuildSucceeded, P( sc, "and it builds: " & right( mw.BuildRaw, 500 ) ) )

    ' ---- Save As Project with one open: saved where it is, and nothing is asked
    dim as ustring savedAt = mw.Proj.Path, sessionFile = project.SessionPath( mw.ConfigDir, mw.Proj.Path )
    fs.RemoveFile( sessionFile )
    mw.Execute( Cmd.ProjectSaveAs )
    tkTest_PumpFor( h, 40 )
    t.Check( fs.IsFile( sessionFile ) andalso mw.ProjOpen andalso (mw.Proj.Path = savedAt) andalso (mw.Chooser.IsOpen( ) = false), P( sc, "Save As Project saves the open project, no list" ) )
    t.Check( instr( mw.Message, "saved" ) > 0, P( sc, "and says so: " & mw.Message ) )

    ' ---- File > New: a picker of seven, Blank File first
    mw.Execute( Cmd.FileNew )
    tkTest_PumpFor( h, 40 )
    t.Check( mw.Chooser.IsOpen( ) andalso (mw.Choosing = mainwin.PickKind.NewItem) andalso (mw.Chooser.ShownCount( ) = 7), _
             P( sc, strings.Format( "New: a picker of seven ({})", mw.Chooser.ShownCount( ) ) ) )
    mw.Chooser.Close( )
    ' the starters: an untitled buffer with their text, nothing written
    dim as long starterTags( 0 to 2 ) = { mainwin.NEWITEM_CONSOLE, mainwin.NEWITEM_MODULE, mainwin.NEWITEM_HEADER }
    dim as ustring starterWant( 0 to 2 ) = { "print ", "#module ", "#pragma once" }
    for i as long = 0 to 2
        mw.Choosing = mainwin.PickKind.NewItem
        mw.Chosen( starterTags( i ) )
        tkTest_PumpFor( h, 30 )
        t.Check( mw.Active( )->IsNew( ) andalso mw.Active( )->IsModified( ) andalso (instr( mw.View( ).Text( ), starterWant( i ) ) > 0), _
                 P( sc, "New: a modified untitled buffer with " & starterWant( i ) ) )
        mw.Active( )->Main.SetSavePoint( )
        mw.CloseDoc( mw.Active( ) )
    next
    ' Form...: asks where, and makes it in a folder of its own
    gPickPath = fs.PathJoin( dir_, "frmThree.tkform" )
    mw.Choosing = mainwin.PickKind.NewItem
    mw.Chosen( mainwin.NEWITEM_FORM )
    tkTest_PumpFor( h, 60 )
    t.Check( fs.IsFile( fs.PathJoin( dir_, "frmThree", "frmThree.tkform" ) ), P( sc, "New > Form: in a folder of its own" ) )

    ' ---- New > Console Project: asks for a folder, and builds as it comes
    dim as ustring projC = fs.PathJoin( dir_, "myconsole" )
    gPickPath = projC
    mw.Choosing = mainwin.PickKind.NewItem
    mw.Chosen( mainwin.NEWITEM_CONSOLE_PROJECT )
    tkTest_PumpFor( h, 150 )
    t.Check( mw.ProjOpen andalso fs.IsFile( fs.PathJoin( projC, "tiko.toml" ) ) andalso (lcase( mw.ActivePath( ) ) = lcase( fs.PathJoin( projC, "main.tiko" ) )), _
             P( sc, "New > Console Project: open, its main in front" ) )
    mw.StartBuild( build.BuildAction.Compile, false )
    t.Check( WaitBuild( mw ) andalso mw.BuildSucceeded, P( sc, "and it builds: " & right( mw.BuildRaw, 500 ) ) )

    ' ---- New > GUI Application: a folder, a project, its form in front; builds as it comes
    dim as ustring proj = fs.PathJoin( dir_, "myapp" )
    gPickPath = proj
    mw.Choosing = mainwin.PickKind.NewItem
    mw.Chosen( mainwin.NEWITEM_GUI )
    tkTest_PumpFor( h, 150 )
    t.Check( fs.IsFile( fs.PathJoin( proj, "tiko.toml" ) ) andalso fs.IsFile( fs.PathJoin( proj, "main.tiko" ) ) andalso _
             fs.IsFile( fs.PathJoin( proj, "frmMain", "frmMain.tkform" ) ) andalso (fs.Exists( fs.PathJoin( proj, "shared" ) ) = false), _
             P( sc, "New > GUI Application: tiko.toml, main.tiko, frmMain/, no shared/" ) )
    t.Check( fs.IsFile( fs.PathJoin( proj, "appTheme", "appTheme.tktheme" ) ) andalso fs.IsFile( fs.PathJoin( proj, "appTheme", "appTheme.design.tiko" ) ) _
             andalso (instr( fs.ReadAllText( fs.PathJoin( proj, "main.tiko" ) ).ValueOr( "" ), "appTheme.Install( )" ) > 0), _
             P( sc, "and its theme: appTheme/, installed by main" ) )
    t.Check( mw.ProjOpen andalso (mw.Active( ) <> 0) andalso (mw.Active( )->Designer <> 0), P( sc, "the project open, its form in front" ) )
    t.Check( mw.NewFormProject( proj ) = false, P( sc, "not over an existing project" ) )
    mw.StartBuild( build.BuildAction.Compile, false )
    t.Check( WaitBuild( mw ) andalso mw.BuildSucceeded, P( sc, "the new project builds: " & right( mw.BuildRaw, 500 ) ) )

    for each dd as DocRef in mw.Docs
        dd->Main.SetSavePoint( )
    next

    ' ---- every file closed, the project still open: what works on the project stays live
    mw.CloseAll( )
    tkTest_PumpFor( h, 40 )
    t.Check( mw.ShowsStart( ) andalso mw.ProjOpen andalso mw.CanRun( Cmd.ProjectSaveAs ) andalso mw.CanRun( Cmd.ProjectClose ) andalso mw.CanRun( Cmd.Compile ) andalso _
             mw.CanRun( Cmd.BuildExecute ) andalso mw.CanRun( Cmd.FindInProject ) andalso mw.CanRun( Cmd.SearchSymbol ) andalso mw.CanRun( Cmd.RunArguments ) andalso _
             mw.CanRun( Cmd.StartDebugging ), P( sc, "no file open, a project open: its rows stay enabled" ) )
    t.Check( (mw.CanRun( Cmd.FileCloseAll ) = false) andalso (mw.CanRun( Cmd.FileSaveAll ) = false), P( sc, "and Close All, Save All are grey" ) )

    ' ---- Save As Project with nothing open: nothing to make one of, and no dialog
    mw.CloseProject( )
    tkTest_PumpFor( h, 40 )
    t.Check( mw.ShowsStart( ) andalso (mw.SaveAsProject( ) = false) andalso (mw.ProjOpen = false), P( sc, "Save As Project on the start panel makes nothing" ) )
    t.Check( instr( mw.Message, "no source file" ) > 0, P( sc, "and says why: " & mw.Message ) )
    mw.NewBlank( )
    tkTest_PumpFor( h, 40 )
    t.Check( (mw.CanRun( Cmd.ProjectClose ) = false) andalso mw.CanRun( Cmd.ProjectSaveAs ), P( sc, "a file open, no project: Close Project grey, Save As Project live" ) )
    mw.Destroy( )
end sub
