' langpass -- Languages in a new GUI project, through Translatable's "..." and Form > Languages...,
' driven inside the dialog's modal loop: French added and a Button's text translated; OK writes
' appLanguages (built in) and wires main; the Button renamed, its translation follows; French made
' a file beside the program; the Button's text changed, its translation shows as changed.
#module "selftest"

#import "std/containers"
#import "std/fs"
#import "tkc/cmdids"
#import "tka/documents"
#import "tka/mainwin"
#import "tkd/canvas"
#import "tkd/langdlg"
#import "tkd/langfile"
#import "tkd/edits"
#import "tkd/model"
#import "tkd/panels"
#import "vendor/tkControls/tkListTree"
#import "vendor/tkControls/tkScrollPanel"
#import "vendor/tkControls/tkTextBox"
#import "vendor/tkControls/tkCheckBox"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkButton"
#import "vendor/tkControls/tkMessageBox"
#import "std/strings"
using containers
using cmdids
using tkApp
using tkHost
using tkTest
using tkPaint
using model
using tkListTree
using tkScrollPanel
using tkTextBox
using tkCheckBox
using tkButton
using tkMessageBox

dim shared as long gLangStep, gLangTries, gLangTones
dim shared as ustring gLangSeen         ' what a step read in the dialog
dim shared as ustring gLangFit, gLangRemove
dim shared as boolean gLangFitOk

' The grid's row for key; -1 when it has none.
private function GridRow_( byval dlg as langdlg.LanguagesDialog ptr, byref key_ as const ustring ) as long
    for r as long = 0 to tkListTree_GetCount( dlg->Grid ) - 1
        if tkListTree_GetText( dlg->Grid, r ) = key_ then return r
    next
    return -1
end function

' Posted before the dialog opens: once its modal loop runs, the step's work is done from inside it.
private sub DriveLanguages( byval payload as any ptr )
    dim as mainwin.Window ptr w = payload
    gLangTries += 1
    if (w->LangDlg = 0) orelse (w->LangDlg->IsModal = false) then
        if gLangTries < 100000 then tkApp_RunOnUI( @DriveLanguages, payload )
        exit sub
    end if
    dim as langdlg.LanguagesDialog ptr dlg = w->LangDlg
    select case gLangStep
    case 1
        ' French added: its code and name typed, Enter; the Button's text translated, Enter
        dlg->AddLanguage( )
        tkTextBox_SetText( dlg->TxtCode, "fr" )
        tkTextBox_SetText( dlg->TxtName, "Français" )
        gLangSeen = dlg->ApplyFields( ) & "|" & dlg->FormName & "|" & tkCheckBox_GetChecked( dlg->ChkThisForm )
        dim as long r = GridRow_( dlg, "frmMain.Button1.Text" )
        gLangSeen &= "|" & r
        if r >= 0 then
            tkListTree_SetCurSel( dlg->Grid, r )
            dlg->ShowRow( )
            tkTextBox_SetText( dlg->TxtTrans, "Bonjour" )
            dlg->TakeTranslation( true )
        end if
        ' its rows are drawn (a tkListTree with no paint callback shows a blank list)
        dim as TK_HOST ptr dh = tkForm_Host( dlg->Win )
        tkHost_RenderTo( dh, false )
        dim as TKRECT a
        tkWidget_AbsRect( dlg->Grid, a )
        dim as ulong c0
        dim as long hh = tkListTree_GetHeaderHeight( dlg->Grid )
        gLangTones = tkTest_TonesIn( dh, a.left, a.top + hh, a.right - a.left, a.bottom - a.top - hh, c0 )
    case 2
        ' from the menu: French again, its translation under the new name, done; then not built in
        tkListTree_SetCurSel( dlg->LstLang, 1 )
        dlg->ShowLang( )
        dim as long r = GridRow_( dlg, "frmMain.btnHello.Text" )
        gLangSeen = str( r )
        if r >= 0 then gLangSeen &= "|" & tkListTree_GetCellText( dlg->Grid, r, 2 ) & "|" & tkListTree_GetCellText( dlg->Grid, r, 3 )
        dlg->EmbedToggled( false )
    case 3
        ' the Button's text changed since: its translation shows as changed; Cancel
        tkListTree_SetCurSel( dlg->LstLang, 1 )
        dlg->ShowLang( )
        dim as long r = GridRow_( dlg, "frmMain.btnHello.Text" )
        gLangSeen = str( r )
        if r >= 0 then gLangSeen &= "|" & tkListTree_GetCellText( dlg->Grid, r, 3 )
        ' Keep translation and Delete unused hold their text, side by side inside the grid's width
        dim as TKRECT rv, ru, rg
        tkWidget_AbsRect( dlg->BtnReviewed, rv )
        tkWidget_AbsRect( dlg->BtnUnused, ru )
        tkWidget_AbsRect( dlg->Grid, rg )
        dim as long iv, iu, ih
        tkButton_GetIdealSize( dlg->BtnReviewed, iv, ih )
        tkButton_GetIdealSize( dlg->BtnUnused, iu, ih )
        gLangFit = strings.Format( "{} {} {} {} {} {}", iv, rv.right - rv.left, iu, ru.right - ru.left, ru.left - rv.right, rg.right - ru.right )
        gLangFitOk = (rv.right - rv.left > iv) andalso (ru.right - ru.left > iu) andalso (ru.left > rv.right) andalso (ru.right <= rg.right)
        ' Remove asks: No keeps French; a new German with no translations asks too, Yes removes it
        gAsked = 0
        Answer( MBX_IDNO )
        dim as boolean gone = dlg->RemoveLanguage( )
        gLangRemove = strings.Format( "{} {} {}", gAsked, gone, dlg->Proj.Languages.Count( ) )
        dlg->AddLanguage( )
        tkTextBox_SetText( dlg->TxtCode, "de" )
        tkTextBox_SetText( dlg->TxtName, "Deutsch" )
        dlg->ApplyFields( )
        Answer( MBX_IDYES )
        gone = dlg->RemoveLanguage( )
        gLangRemove &= strings.Format( " {} {} {}", gAsked, gone, dlg->Proj.Languages.Count( ) )
        dlg->Finish( false )
        exit sub
    end select
    dlg->Finish( true )
end sub

public sub LangPass( byref t as Tally, byval sc as single )
    dim as mainwin.Window mw
    mw.ConfigDir = FreshConfig( )
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    t.Check( mw.Create( sc ), P( sc, "languages: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_PumpFor( h, 150 )
    dim as ustring dir_ = Files( )
    dim as ustring proj = fs.PathJoin( dir_, "langproj" & cint( sc * 100 ) )
    fs.RemoveDirAll( proj )
    t.Check( mw.NewFormProject( proj ), P( sc, "languages: a new GUI project" ) )
    tkTest_PumpFor( h, 100 )
    t.Check( mw.CanRun( Cmd.FormLanguages ), P( sc, "Form > Languages... with a project open" ) )
    dim as DocRef d = mw.Active( )
    dim as canvas.FormCanvas ptr c = 0
    if d then c = d->Designer
    t.Check( c <> 0, P( sc, "languages: the form on its surface" ) )
    if c = 0 then
        mw.Destroy( )
        exit sub
    end if
    dim as FormDoc trial = c->Doc
    edits.AddControl( trial, "Button", "", -1, 20, 20, 120, 32 )
    dim as Array( of ustring ) names
    names.Push( "Button1" )
    edits.SetProperty( trial, names, "Text", "Hello" )
    t.Check( len( c->ApplyEdit( trial, true, "" ) ) = 0, P( sc, "a Button that says Hello" ) )
    t.Check( c->Doc.Translate = false, P( sc, "the form starts not translatable" ) )

    ' ---- Translatable's "...": the dialog on this form's texts
    c->SelectNone( )
    tkTest_PumpFor( h, 60 )
    dim as panels.DesignPanels ptr ps = @mw.Palettes
    dim as long tr_ = -1
    for i as long = 0 to ps->Rows.Count( ) - 1
        if ps->Rows[i].Key = "@Translate" then tr_ = i
    next
    t.Check( (tr_ >= 0) andalso (ps->Rows[tr_].Btn <> 0), P( sc, "the Translatable row has a ""..."" button" ) )
    if (tr_ >= 0) andalso (ps->Rows[tr_].Btn <> 0) then
        tkScrollPanel_EnsureVisible( ps->Scroll, ps->Rows[tr_].Btn )
        tkTest_PumpFor( h, 30 )
        gLangStep = 1
        gLangTries = 0
        tkApp_RunOnUI( @DriveLanguages, @mw )
        tkTest_Click( h, tkTest_CX( ps->Rows[tr_].Btn ), tkTest_CY( ps->Rows[tr_].Btn ) )
        tkTest_PumpFor( h, 100 )
    end if
    t.Check( c->Doc.Translate, P( sc, "its ""..."" made the form translatable" ) )
    t.Check( left( gLangSeen, len( "|frmMain|true|" ) ) = "|frmMain|true|" andalso (right( gLangSeen, 2 ) <> "-1"), _
        P( sc, "French taken, the form's own keys shown, the Button's among them: " & gLangSeen ) )
    t.Check( gLangTones > 2, P( sc, "the grid draws its rows: " & gLangTones & " tones" ) )
    dim as ustring langDir = fs.PathJoin( proj, langfile.LANG_MODULE ), none
    dim as ustring tklang = fs.ReadAllText( fs.PathJoin( langDir, "appLanguages.tklang" ) ).ValueOr( none )
    t.Check( (instr( tklang, "code = ""fr""" ) > 0) andalso (instr( tklang, "embed" ) = 0), P( sc, "the .tklang has French, built in: " & tklang ) )
    dim as ustring fr = fs.ReadAllText( fs.PathJoin( langDir, "lang", "fr.toml" ) ).ValueOr( none )
    t.Check( instr( fr, "[frmMain]" & chr( 10 ) & """Button1.Text"" = ""Bonjour""" ) > 0, P( sc, "lang/fr.toml has the translation: " & fr ) )
    t.Check( instr( fr, "[_source.frmMain]" & chr( 10 ) & """Button1.Text"" = ""Hello""" ) > 0, P( sc, "and what it was translated from" ) )
    dim as ustring gen = fs.ReadAllText( fs.PathJoin( langDir, "appLanguages.design.tiko" ) ).ValueOr( none )
    t.Check( instr( gen, "#embed gLang0_ ""lang/fr.toml""" ) > 0, P( sc, "the module builds it in" ) )
    dim as ustring mainText = fs.ReadAllText( fs.PathJoin( proj, "main.tiko" ) ).ValueOr( none )
    if (mw.FindOpen( fs.PathJoin( proj, "main.tiko" ) ) <> 0) then mainText = mw.FindOpen( fs.PathJoin( proj, "main.tiko" ) )->Text( )
    t.Check( (instr( mainText, "#import ""./appLanguages""" ) > 0) andalso (instr( mainText, "appLanguages.Register( )" ) > 0) _
             andalso (instr( mainText, "appLanguages.UseSystem( )" ) > 0), P( sc, "main uses the languages: " & mainText ) )

    ' ---- the Button renamed: its translation goes by the new name
    c->SelectOnly( "Button1" )                  ' the inspector renames the selected control
    trial = c->Doc
    edits.RenameControl( trial, "Button1", "btnHello" )
    t.Check( len( c->ApplyEdit( trial, true, "btnHello" ) ) = 0, P( sc, "Button1 renamed btnHello" ) )
    mw.ControlRenamed( c, "Button1", "btnHello" )
    fr = fs.ReadAllText( fs.PathJoin( langDir, "lang", "fr.toml" ) ).ValueOr( none )
    t.Check( (instr( fr, """btnHello.Text"" = ""Bonjour""" ) > 0) andalso (instr( fr, "Button1" ) = 0), P( sc, "its translation follows: " & fr ) )

    ' ---- Form > Languages...: French no longer built in
    gLangStep = 2
    gLangTries = 0
    tkApp_RunOnUI( @DriveLanguages, @mw )
    t.Check( mw.Execute( Cmd.FormLanguages ), P( sc, "Form > Languages... opened, OK" ) )
    t.Check( left( gLangSeen, 2 ) <> "-1" andalso (instr( gLangSeen, "|Bonjour|" ) > 0) andalso (right( gLangSeen, 1 ) = "|"), _
        P( sc, "the renamed key, translated, nothing to do: " & gLangSeen ) )
    tklang = fs.ReadAllText( fs.PathJoin( langDir, "appLanguages.tklang" ) ).ValueOr( none )
    gen = fs.ReadAllText( fs.PathJoin( langDir, "appLanguages.design.tiko" ) ).ValueOr( none )
    t.Check( (instr( tklang, "embed = false" ) > 0) andalso (instr( gen, "#embed" ) = 0) _
             andalso (instr( gen, """appLanguages/lang/fr.toml""" ) > 0), P( sc, "a file beside the program, the project's copy else: " & gen ) )

    ' ---- the Button's text changed: its translation shows as changed
    trial = c->Doc
    names.Clear( )
    names.Push( "btnHello" )
    edits.SetProperty( trial, names, "Text", "Hi" )
    c->ApplyEdit( trial, true, "" )
    gLangStep = 3
    gLangTries = 0
    tkApp_RunOnUI( @DriveLanguages, @mw )
    t.Check( mw.Execute( Cmd.FormLanguages ), P( sc, "Languages again, Cancel" ) )
    t.Check( gLangSeen <> "-1" andalso (right( gLangSeen, 7 ) = "Changed"), P( sc, "the translation shows as changed: " & gLangSeen ) )
    t.Check( gLangFitOk, P( sc, "Keep translation / Delete unused wider than their text, inside the grid: " & gLangFit ) )
    t.Check( gLangRemove = "1 false 1 2 true 1", P( sc, "Remove asks, with or without translations; No keeps, Yes removes: " & gLangRemove ) )
    t.Check( fs.Exists( fs.PathJoin( langDir, "lang", "fr.toml" ) ), P( sc, "Cancel after Remove keeps fr.toml" ) )
    mw.Destroy( )
end sub
