' panelspass -- the Form Designer's toolbox, object tree and inspector in the real window, docked and
' floating, through SDL events at a pinned scale.
#module "selftest"

#import "std/containers"
#import "std/fs"
#import "std/strings"
#import "tkc/cmdids"
#import "tkc/session"
#import "tka/documents"
#import "tka/mainwin"
#import "tkd/canvas"
#import "tkd/catalog"
#import "tkd/model"
#import "tkd/panels"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkPaint"
#import "vendor/tkControls/tkListTree"
#import "vendor/tkControls/tkTextBox"
#import "vendor/tkControls/tkComboBox"
#import "vendor/tkControls/tkCheckBox"
#import "vendor/tkControls/tkMenuBar"
#import "vendor/tkControls/tkLayout"
#import "vendor/tkControls/tkScrollPanel"
#import "vendor/tkControls/tkToolbar"
#import "vendor/tkControls/tkTheme"
using containers
using cmdids
using tkApp
using tkHost
using tkTest
using tkPaint
using tkListTree
using tkTextBox
using tkComboBox
using tkCheckBox
using tkLayout
using tkScrollPanel
using tkToolbar
using tkTheme
using model

' The Toolbox row showing `name_`.
private function ListRow( byval list as TK_WIDGET ptr, byref name_ as const ustring ) as long
    for r as long = 0 to tkListTree_GetCount( list ) - 1
        if tkListTree_GetText( list, r ) = name_ then return r
    next
    return -1
end function

private sub ClickRow( byval h as TK_HOST ptr, byval list as TK_WIDGET ptr, byval row as long, byval clicks as long = 1 )
    dim as TKRECT rc
    tkWidget_AbsRect( list, rc )
    dim as long rh = tkHost_Scale( list->pHost, tkListTree_GetRowHeight( list ) )
    dim as long x = rc.left + list->cw \ 2, y = rc.top + rh * (row - tkListTree_GetTopIndex( list )) + rh \ 2
    tkTest_PushMotion( h, x, y )
    tkTest_PumpFor( h, 15 )
    tkTest_Click( h, x, y, SDL_BUTTON_LEFT, clicks )
    tkTest_PumpFor( h, 40 )
end sub

private function RowIndex( byref p as panels.DesignPanels, byref key_ as const ustring ) as long
    for i as long = 0 to p.Rows.Count( ) - 1
        if p.Rows[i].Key = key_ then return i
    next
    return -1
end function

private function EditOf( byref p as panels.DesignPanels, byref key_ as const ustring ) as TK_WIDGET ptr
    dim as long i = RowIndex( p, key_ )
    if i < 0 then return 0
    return p.Rows[i].Edit
end function

' Click into a row's text box, replace what's there by typing, press Enter.
private sub TypeInRow( byval h as TK_HOST ptr, byref p as panels.DesignPanels, byref key_ as const ustring, byref text as ustring )
    dim as TK_WIDGET ptr e = EditOf( p, key_ )
    if e = 0 then exit sub
    tkScrollPanel_SetPos( p.Scroll, e->y - tkHost_Scale( h, 8 ) )
    tkTest_PumpFor( h, 20 )
    tkTest_Click( h, tkTest_CX( e ), tkTest_CY( e ) )
    tkTest_PumpFor( h, 30 )
    Chord( h, SDLK_A, SDL_SCANCODE_A, TK_KMOD_PRIMARY )
    tkTest_PushText( h, text )
    tkTest_PumpFor( h, 20 )
    Chord( h, SDLK_RETURN, SDL_SCANCODE_RETURN, 0 )
    tkTest_PumpFor( h, 40 )
end sub

private function Ctl2( byval c as canvas.FormCanvas ptr, byref n as const ustring ) byref as FormControl
    return c->Doc.Controls[FindControl( c->Doc, n )]
end function

public sub PanelsPass( byref t as Tally, byval sc as single )
    dim as mainwin.Window mw
    mw.ConfigDir = FreshConfig( )
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    t.Check( mw.Create( sc ), P( sc, "panels: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_PumpFor( h, 150 )
    dim as ustring path = fs.PathJoin( mw.ConfigDir, "frmP.tkform" )
    fs.WriteAllText( path, FORM_TEXT )
    mw.OpenFile( path )
    tkTest_PumpFor( h, 100 )
    dim as DocRef d = mw.Active( )
    dim as canvas.FormCanvas ptr c = d->Designer
    if c = 0 then
        t.Check( false, P( sc, "panels: the form opened on a surface" ) )
        mw.Destroy( )
        exit sub
    end if
    dim as panels.DesignPanels ptr ps = @mw.Palettes

    ' ---- docked, either side of the surface
    dim as TK_WIDGET ptr left_ = ps->Pal( 0 ).Frame, right_ = ps->Pal( 1 ).Frame
    t.Check( (left_ <> 0) andalso (right_ <> 0), P( sc, "both palettes exist" ) )
    t.Check( tkWidget_IsVisible( left_ ) andalso tkWidget_IsVisible( right_ ), P( sc, "and show" ) )
    t.Check( left_->cw = tkHost_Scale( h, panels.TOOLBOX_CX ), P( sc, "the toolbox's width" ) )
    t.Check( right_->cw = tkHost_Scale( h, panels.INSPECTOR_CX ), P( sc, "the inspector's width" ) )
    t.Check( c->Frame->x = left_->x + left_->cw + tkHost_Scale( h, panels.SPLIT_CX ), P( sc, "the surface starts after the toolbox and its bar" ) )
    t.Check( c->Frame->x + c->Frame->cw + tkHost_Scale( h, panels.SPLIT_CX ) = right_->x, P( sc, strings.Format( "and ends at the inspector's bar: {} {}", c->Frame->x + c->Frame->cw, right_->x ) ) )
    t.Check( right_->x + right_->cw = tkForm_Widget( mw.form )->cw, P( sc, "the inspector reaches the window's edge" ) )

    ' ---- the toolbox
    dim as long rowBtn = ListRow( ps->ToolList, "Button" )
    t.Check( rowBtn > 0, P( sc, "the toolbox lists Button" ) )
    t.Check( tkListTree_GetCurSel( ps->ToolList ) = 0, P( sc, "the pointer is the tool to begin with" ) )
    ClickRow( h, ps->ToolList, rowBtn )
    t.Check( c->Tool = "Button", P( sc, "a click picks the tool: " & c->Tool ) )
    t.Check( tkHost_GetFocus( h ) = c->Glass, P( sc, "and the keyboard goes back to the surface" ) )
    dim as TKRECT rs = c->SurfaceRect( ), rg
    tkWidget_AbsRect( c->Glass, rg )
    tkTest_PushMotion( h, rg.left + rs.left + tkHost_Scale( h, 300 ), rg.top + rs.top + tkHost_Scale( h, 120 ) )
    tkTest_PumpFor( h, 15 )
    tkTest_Click( h, rg.left + rs.left + tkHost_Scale( h, 304 ), rg.top + rs.top + tkHost_Scale( h, 120 ) )
    tkTest_PumpFor( h, 50 )
    t.Check( FindControl( c->Doc, "Button1" ) >= 0, P( sc, "picking and clicking places one" ) )
    t.Check( len( c->Tool ) = 0, P( sc, "the tool is back to the pointer" ) )
    t.Check( tkListTree_GetCurSel( ps->ToolList ) = 0, P( sc, "and the toolbox shows that" ) )
    Chord( h, SDLK_Z, SDL_SCANCODE_Z, TK_KMOD_PRIMARY )
    tkTest_PumpFor( h, 50 )
    t.Check( FindControl( c->Doc, "Button1" ) < 0, P( sc, "undone" ) )

    ' ---- the tree follows the selection, and the other way
    dim as ustring text0 = d->Text( )
    t.Check( tkListTree_GetCount( ps->Tree ) = 6, P( sc, strings.Format( "the tree has the form and five controls: {}", tkListTree_GetCount( ps->Tree ) ) ) )
    ClickOn( h, c->WidgetOf( "lblB" ) )
    tkTest_PumpFor( h, 30 )
    t.Check( tkListTree_GetText( ps->Tree, tkListTree_GetCurSel( ps->Tree ) ) = "lblB", P( sc, "a click on the surface selects in the tree" ) )
    ClickRow( h, ps->Tree, ListRow( ps->Tree, "btnIn" ) )
    t.Check( (c->Selected.Count( ) = 1) andalso (c->Selected[0] = "btnIn"), P( sc, "a click in the tree selects on the surface" ) )
    t.Check( tkListTree_GetLevel( ps->Tree, ListRow( ps->Tree, "btnIn" ) ) = 2, P( sc, "a child is nested under its parent" ) )
    ClickRow( h, ps->Tree, 0 )
    t.Check( c->Selected.Count( ) = 0, P( sc, "the tree's top row is the form" ) )
    tkTest_PumpFor( h, 30 )

    ' ---- the inspector: the form
    t.Check( RowIndex( *ps, "@Caption" ) >= 0, P( sc, "with nothing selected, the form's rows" ) )
    t.Check( tkTextBox_GetText( EditOf( *ps, "@Caption" ) ) = "T", P( sc, "the caption" ) )
    dim as ustring newCap = "Hello"
    TypeInRow( h, *ps, "@Caption", newCap )
    t.Check( c->Doc.Caption = "Hello", P( sc, "typing and Enter sets the caption: " & c->Doc.Caption ) )
    t.Check( d->IsModified( ), P( sc, "the buffer is modified" ) )
    tkHost_SetFocus( h, c->Glass )
    Chord( h, SDLK_Z, SDL_SCANCODE_Z, TK_KMOD_PRIMARY )
    tkTest_PumpFor( h, 50 )
    t.Check( d->Text( ) = text0, P( sc, "one undo, byte for byte" ) )
    t.Check( tkTextBox_GetText( EditOf( *ps, "@Caption" ) ) = "T", P( sc, "and the inspector shows it" ) )

    ' ---- the inspector: a control
    ClickOn( h, c->WidgetOf( "btnA" ) )
    tkTest_PumpFor( h, 50 )
    t.Check( tkTextBox_GetText( EditOf( *ps, "@Name" ) ) = "btnA", P( sc, "the name row" ) )
    t.Check( tkTextBox_GetText( EditOf( *ps, "@X" ) ) = "16", P( sc, "the X row" ) )
    t.Check( tkTextBox_GetText( EditOf( *ps, "Text" ) ) = "A", P( sc, "a property row" ) )
    t.Check( EditOf( *ps, "TextAlign" ) <> 0, P( sc, "an enum row" ) )
    t.Check( tkHost_GetFocus( h ) = c->Glass, P( sc, "selecting leaves the keyboard on the surface" ) )

    dim as ustring newX = "48"
    TypeInRow( h, *ps, "@X", newX )
    t.Check( Ctl2( c, "btnA" ).X = 48, P( sc, "X moves it" ) )
    t.Check( c->WidgetOf( "btnA" )->x = tkHost_Scale( h, 48 ), P( sc, "the real control too" ) )
    dim as ustring newText = "Press"
    TypeInRow( h, *ps, "Text", newText )
    t.Check( SettingOr( Ctl2( c, "btnA" ).Props, "Text" ) = "Press", P( sc, "a property is set" ) )
    dim as ustring bad = "abc"
    TypeInRow( h, *ps, "@X", bad )
    t.Check( Ctl2( c, "btnA" ).X = 48, P( sc, "a non-number is refused" ) )
    t.Check( tkTextBox_GetText( EditOf( *ps, "@X" ) ) = "48", P( sc, "and the row goes back" ) )
    t.Check( instr( mw.Message, "number" ) > 0, P( sc, "with a message: " & mw.Message ) )

    ' a clicked-away edit counts, as Enter does
    dim as TK_WIDGET ptr eW = EditOf( *ps, "@W" )
    tkTest_Click( h, tkTest_CX( eW ), tkTest_CY( eW ) )
    tkTest_PumpFor( h, 30 )
    Chord( h, SDLK_A, SDL_SCANCODE_A, TK_KMOD_PRIMARY )
    dim as ustring newW = "120"
    tkTest_PushText( h, newW )
    tkTest_PumpFor( h, 20 )
    ClickOn( h, c->WidgetOf( "lblB" ) )
    tkTest_PumpFor( h, 50 )
    t.Check( Ctl2( c, "btnA" ).W = 120, P( sc, "clicking away commits what was typed: " & Ctl2( c, "btnA" ).W ) )
    t.Check( tkTextBox_GetText( EditOf( *ps, "@Name" ) ) = "lblB", P( sc, "and the inspector moved on" ) )

    ' ---- the geometry rows follow the mouse, before the button comes up; a gesture taken away puts them back
    dim as long liveBy = tkHost_Scale( h, 40 ), liveX0 = Ctl2( c, "lblB" ).X
    dim as TK_WIDGET ptr liveW = c->WidgetOf( "lblB" )
    dim as long liveCX = tkTest_CX( liveW ), liveCY = tkTest_CY( liveW )
    tkTest_PushMotion( h, liveCX, liveCY )
    tkTest_PumpFor( h, 15 )
    tkTest_PushButton( h, true, liveCX, liveCY )
    tkTest_PumpFor( h, 15 )
    tkTest_PushMotion( h, liveCX - liveBy, liveCY + liveBy )
    tkTest_PumpFor( h, 15 )
    t.Check( (Ctl2( c, "lblB" ).X <> liveX0) andalso (tkTextBox_GetText( EditOf( *ps, "@X" ) ) = str( Ctl2( c, "lblB" ).X )) andalso _
             (tkTextBox_GetText( EditOf( *ps, "@Y" ) ) = str( Ctl2( c, "lblB" ).Y )), P( sc, "X and Y follow a move: " & tkTextBox_GetText( EditOf( *ps, "@X" ) ) ) )
    tkHost_ReleaseCapture( h )
    tkTest_PumpFor( h, 15 )
    t.Check( (Ctl2( c, "lblB" ).X = liveX0) andalso (tkTextBox_GetText( EditOf( *ps, "@X" ) ) = str( liveX0 )), P( sc, "a move taken away: the row goes back" ) )
    tkTest_PushButton( h, false, liveCX - liveBy, liveCY + liveBy )
    tkTest_PumpFor( h, 30 )

    dim as TKRECT liveR
    tkWidget_AbsRect( liveW, liveR )
    dim as long liveW0 = Ctl2( c, "lblB" ).W
    tkTest_PushMotion( h, liveR.right, liveR.bottom )
    tkTest_PumpFor( h, 15 )
    tkTest_PushButton( h, true, liveR.right, liveR.bottom )
    tkTest_PumpFor( h, 15 )
    tkTest_PushMotion( h, liveR.right + liveBy, liveR.bottom + liveBy )
    tkTest_PumpFor( h, 15 )
    t.Check( (Ctl2( c, "lblB" ).W <> liveW0) andalso (tkTextBox_GetText( EditOf( *ps, "@W" ) ) = str( Ctl2( c, "lblB" ).W )) andalso _
             (tkTextBox_GetText( EditOf( *ps, "@H" ) ) = str( Ctl2( c, "lblB" ).H )), P( sc, "width and height follow a resize: " & tkTextBox_GetText( EditOf( *ps, "@W" ) ) ) )
    tkHost_ReleaseCapture( h )
    tkTest_PumpFor( h, 15 )
    tkTest_PushButton( h, false, liveR.right + liveBy, liveR.bottom + liveBy )
    tkTest_PumpFor( h, 30 )

    c->SelectNone( )
    tkTest_PumpFor( h, 50 )
    dim as long liveFW0 = c->Doc.ClientW
    dim as TKRECT liveS = c->SurfaceRect( ), liveG
    tkWidget_AbsRect( c->Glass, liveG )
    dim as long liveFX = liveG.left + liveS.right, liveFY = liveG.top + liveS.bottom
    tkTest_PushMotion( h, liveFX, liveFY )
    tkTest_PumpFor( h, 15 )
    tkTest_PushButton( h, true, liveFX, liveFY )
    tkTest_PumpFor( h, 15 )
    tkTest_PushMotion( h, liveFX + liveBy, liveFY + liveBy )
    tkTest_PumpFor( h, 15 )
    t.Check( (c->Doc.ClientW <> liveFW0) andalso (tkTextBox_GetText( EditOf( *ps, "@FormW" ) ) = str( c->Doc.ClientW )) andalso _
             (tkTextBox_GetText( EditOf( *ps, "@FormH" ) ) = str( c->Doc.ClientH )), P( sc, "the form's size follows its grip: " & tkTextBox_GetText( EditOf( *ps, "@FormW" ) ) ) )
    tkHost_ReleaseCapture( h )
    tkTest_PumpFor( h, 15 )
    tkTest_PushButton( h, false, liveFX + liveBy, liveFY + liveBy )
    tkTest_PumpFor( h, 30 )

    ' rename, and names that can't be
    ClickOn( h, c->WidgetOf( "btnA" ) )
    tkTest_PumpFor( h, 50 )
    dim as ustring nm = "btnGo"
    TypeInRow( h, *ps, "@Name", nm )
    t.Check( FindControl( c->Doc, "btnGo" ) >= 0, P( sc, "a rename" ) )
    t.Check( c->Selected[0] = "btnGo", P( sc, "keeps it selected" ) )
    tkTest_PumpFor( h, 50 )
    t.Check( ListRow( ps->Tree, "btnGo" ) >= 0, P( sc, "and the tree follows" ) )
    nm = "print"
    TypeInRow( h, *ps, "@Name", nm )
    t.Check( FindControl( c->Doc, "btnGo" ) >= 0, P( sc, "a reserved word is refused" ) )
    t.Check( instr( mw.Message, "reserved" ) > 0, P( sc, "and says so: " & mw.Message ) )
    t.Check( tkTextBox_GetText( EditOf( *ps, "@Name" ) ) = "btnGo", P( sc, "the row goes back" ) )
    nm = "lblB"
    TypeInRow( h, *ps, "@Name", nm )
    t.Check( FindControl( c->Doc, "btnGo" ) >= 0, P( sc, "a duplicate is refused" ) )

    ' a renamed parent keeps its children
    ClickOn( h, c->WidgetOf( "pnl" ) )
    tkTest_PumpFor( h, 50 )
    nm = "pnlMain"
    TypeInRow( h, *ps, "@Name", nm )
    t.Check( Ctl2( c, "btnIn" ).Parent = "pnlMain", P( sc, "renaming a parent carries its children" ) )

    ' ---- Anchor and Dock
    ClickOn( h, c->WidgetOf( "btnIn" ) )
    tkTest_PumpFor( h, 50 )
    dim as TK_WIDGET ptr ar = EditOf( *ps, "@AR" )
    t.Check( tkCheckBox_GetChecked( ar ) = false, P( sc, "right isn't anchored yet" ) )
    ClickOn( h, ar )
    t.Check( (Ctl2( c, "btnIn" ).Anchor and TK_ANCHOR_RIGHT) <> 0, P( sc, "the Anchor right box sets it" ) )
    t.Check( (Ctl2( c, "btnIn" ).Anchor and TK_ANCHOR_LEFT) <> 0, P( sc, "and leaves left" ) )
    dim as TK_WIDGET ptr cd = EditOf( *ps, "@Dock" )
    t.Check( tkComboBox_GetText( cd ) = "none", P( sc, "the Dock row: " & tkComboBox_GetText( cd ) ) )
    tkComboBox_SetCurSel( cd, tkComboBox_FindItemByText( cd, "left" ) )
    ps->CommitRow( RowIndex( *ps, "@Dock" ) )
    tkTest_PumpFor( h, 30 )
    t.Check( Ctl2( c, "btnIn" ).Dock = TK_DOCK_LEFT, P( sc, "the Dock row sets it" ) )
    t.Check( c->WidgetOf( "btnIn" )->x = 0, P( sc, "and the real control docks" ) )

    ' a bool and a default: the file holds only what differs
    ClickOn( h, c->WidgetOf( "lblB" ) )
    tkTest_PumpFor( h, 50 )
    dim as TK_WIDGET ptr en = EditOf( *ps, "Enabled" )
    tkScrollPanel_SetPos( ps->Scroll, en->y - tkHost_Scale( h, 8 ) )
    tkTest_PumpFor( h, 20 )
    t.Check( tkCheckBox_GetChecked( en ), P( sc, "Enabled by default" ) )
    ClickOn( h, en )
    t.Check( SettingOr( Ctl2( c, "lblB" ).Props, "Enabled" ) = "false", P( sc, "unticking stores it" ) )
    ClickOn( h, en )
    t.Check( FindSetting( Ctl2( c, "lblB" ).Props, "Enabled" ) < 0, P( sc, "ticking it back removes the line" ) )

    ' several selected: only what they share
    ClickOn( h, c->WidgetOf( "btnGo" ) )
    SDL_SetModState( SDL_KMOD_CTRL )
    ClickOn( h, c->WidgetOf( "lblB" ) )
    SDL_SetModState( SDL_KMOD_NONE )
    tkTest_PumpFor( h, 50 )
    t.Check( RowIndex( *ps, "@Name" ) < 0, P( sc, "no name row for two controls" ) )
    t.Check( RowIndex( *ps, "@AL" ) >= 0, P( sc, "but their anchors" ) )
    t.Check( RowIndex( *ps, "TextAlign" ) < 0, P( sc, "and not what only one has" ) )

    ' ---- the Form menu's commands
    t.Check( mw.CanRun( Cmd.FormAlignTops ), P( sc, "the Form menu acts on a form" ) )
    mw.Execute( Cmd.FormAlignTops )
    t.Check( Ctl2( c, "lblB" ).Y = Ctl2( c, "btnGo" ).Y, P( sc, "Align Tops" ) )
    ClickOn( h, c->WidgetOf( "btnGo" ) )
    tkTest_PumpFor( h, 30 )
    mw.Execute( Cmd.FormBringToFront )
    t.Check( c->Doc.Controls[c->Doc.Controls.Count( ) - 1].Name = "btnGo", P( sc, "Bring to Front" ) )
    mw.Execute( Cmd.FormSnapToGrid )
    t.Check( c->SnapToGrid = false, P( sc, "Snap to Grid toggles" ) )
    mw.Execute( Cmd.FormSnapToGrid )

    ' ---- the layout: rows really drawn, properties right under the header, a bar that drags
    tkTest_PumpFor( h, 30 )
    tkHost_RenderTo( h, false )
    dim as TKRECT rcTools
    tkWidget_AbsRect( ps->ToolList, rcTools )
    dim as long toolRow = tkHost_Scale( h, tkListTree_GetRowHeight( ps->ToolList ) )
    dim as ulong toolBg
    t.Check( tkTest_TonesIn( h, rcTools.left, rcTools.top + toolRow, tkHost_Scale( h, 120 ), toolRow, toolBg ) > 2, P( sc, "the toolbox draws its rows" ) )
    t.Check( ps->Scroll->y = tkHost_Scale( h, panels.HEADER_CY ), P( sc, "the properties start right under the header" ) )
    dim as long tool0 = ps->Pal( 0 ).Frame->cw, surf0 = c->Frame->cw, dragBy = tkHost_Scale( h, 40 )
    dim as single barX = tkTest_CX( ps->BarL ), barY = tkTest_CY( ps->BarL )
    tkTest_PushMotion( h, barX, barY )
    tkTest_PumpFor( h, 15 )
    tkTest_PushButton( h, true, barX, barY )
    tkTest_PumpFor( h, 15 )
    tkTest_PushMotion( h, barX + dragBy, barY )
    tkTest_PumpFor( h, 15 )
    tkTest_PushButton( h, false, barX + dragBy, barY )
    tkTest_PumpFor( h, 30 )
    t.Check( abs( ps->Pal( 0 ).Frame->cw - (tool0 + dragBy) ) <= 1, P( sc, "the bar widens the toolbox" ) )
    t.Check( abs( c->Frame->cw - (surf0 - dragBy) ) <= 1, P( sc, "and the surface gives way" ) )
    ps->ToolCX = 0
    ps->OnLayout( ps->Owner )
    tkTest_PumpFor( h, 30 )
    t.Check( ps->Tree->y >= ps->TreeTitle->y + tkHost_Scale( h, panels.HEADER_CY ), P( sc, "the object tree sits under its header" ) )

    ' a double click on a tool: one of its default size, the pointer back
    dim as long nBefore = c->Doc.Controls.Count( )
    dim as ustring dblTool = tkListTree_GetText( ps->ToolList, 3 )
    ClickRow( h, ps->ToolList, 3, 1 )
    ClickRow( h, ps->ToolList, 3, 2 )
    t.Check( c->Doc.Controls.Count( ) = nBefore + 1, P( sc, "a double click places one " & dblTool ) )
    if c->Doc.Controls.Count( ) = nBefore + 1 then
        with c->Doc.Controls[nBefore]
            t.Check( (.TypeName = dblTool) andalso (.W = catalog.Find( dblTool )->Width_) andalso (.H = catalog.Find( dblTool )->Height_), P( sc, "of its default size" ) )
        end with
        t.Check( len( c->Tool ) = 0, P( sc, "and the pointer is back" ) )
        c->DeleteSelection( )
        tkTest_PumpFor( h, 40 )
    end if

    ' ---- float the toolbox: its window, a wider surface
    dim as long wide0 = c->Frame->cw
    mw.Execute( Cmd.FormFloatToolbox )
    tkTest_PumpFor( h, 120 )
    t.Check( ps->IsFloating( 0 ), P( sc, "the toolbox floats" ) )
    t.Check( c->Frame->cw = wide0 + tkHost_Scale( h, panels.TOOLBOX_CX ) + tkHost_Scale( h, panels.SPLIT_CX ), P( sc, "the surface takes its place" ) )
    dim as TK_FORM ptr ft = ps->Pal( 0 ).Float
    dim as TK_HOST ptr fh = tkForm_Host( ft )
    t.Check( tkHost_GetCapture( fh ) = 0, P( sc, "no stray capture on the float" ) )
    t.Check( ps->Pal( 0 ).Frame->pHost = fh, P( sc, "its widgets live on the float" ) )
    t.Check( ps->Pal( 0 ).Frame->cw = tkForm_Widget( ft )->cw, P( sc, "and fill it" ) )
    ' the float's list works as the docked one did
    dim as ustring floatTool = tkListTree_GetText( ps->ToolList, 2 )
    ClickRow( fh, ps->ToolList, 2 )
    t.Check( c->Tool = floatTool, P( sc, "a click in the float picks the tool: " & c->Tool ) )
    c->Tool = ""
    tkListTree_SetCurSel( ps->ToolList, 0 )
    ' a shortcut pressed in the float reaches the main window's commands
    d->Main.SetSavePoint( )
    t.Check( d->IsModified( ) = false, P( sc, "clean before the float's Ctrl+S" ) )
    ClickOn( h, c->WidgetOf( "lblB" ) )
    Chord( h, SDLK_RIGHT, SDL_SCANCODE_RIGHT, 0 )
    t.Check( d->IsModified( ), P( sc, "an edit" ) )
    Chord( fh, SDLK_S, SDL_SCANCODE_S, TK_KMOD_PRIMARY )
    tkTest_PumpFor( h, 30 )
    t.Check( d->IsModified( ) = false, P( sc, "Ctrl+S from the float saves" ) )
    ' its close button docks it, and the app carries on
    dim as long nForms = tkApp_FormCount( )
    tkTest_PushWindowEvent( fh, SDL_EVENT_WINDOW_CLOSE_REQUESTED )
    tkTest_PumpFor( h, 120 )
    tkApp_Pump( )
    tkTest_PumpFor( h, 60 )
    t.Check( ps->IsFloating( 0 ) = false, P( sc, "the float's close button docks it" ) )
    t.Check( tkApp_FormCount( ) = nForms - 1, P( sc, "its window is gone" ) )
    t.Check( tkHost_IsOpen( h ), P( sc, "the main window isn't" ) )
    t.Check( c->Frame->cw = wide0, P( sc, "the surface gives way again" ) )
    t.Check( ps->Pal( 0 ).Frame->pHost = h, P( sc, "the toolbox is on the main window" ) )
    t.Check( tkListTree_GetCount( ps->ToolList ) > 20, P( sc, "with its rows" ) )

    ' ---- float the inspector, by its own button: an icon the bundled glyph font really holds
    for i as long = 0 to 1
        dim as TK_WIDGET ptr bar = ps->Pal( i ).FloatBtn, pf = ps->Pal( i ).Frame
        dim as TTF_Font ptr gf = tkToolbar_GetGlyphFont( bar )
        t.Check( tkToolbar_GetGlyph( bar, 0 ) = wchr( panels.GLYPH_FLOAT ), P( sc, "the float icon" ) )
        t.Check( (gf <> 0) andalso TTF_FontHasGlyph( gf, panels.GLYPH_FLOAT ) andalso TTF_FontHasGlyph( gf, panels.GLYPH_DOCK ), P( sc, "in the glyph font" ) )
        t.Check( len( tkToolbar_GetTooltipText( bar, 0 ) ) > 0, P( sc, "with a tooltip" ) )
        t.Check( (bar->cw > 0) andalso (bar->cw <= tkHost_Scale( h, 40 )) andalso (bar->x + bar->cw < pf->cw) andalso (bar->y >= 0) andalso (bar->y + bar->ch <= tkHost_Scale( h, panels.HEADER_CY )), _
                 P( sc, "icon-sized, in the header: x=" & bar->x & " y=" & bar->y & " w=" & bar->cw & " h=" & bar->ch ) )
    next
    ' its bar is the header's colour, through a theme change too
    dim as TKTHEME_COLORS keptTheme = tkTheme_Get( )
    dim as TKTOOLBAR_COLORS barColors
    tkToolbar_GetColors( ps->Pal( 1 ).FloatBtn, @barColors )
    t.Check( barColors.BackColor = tkTheme_Get( ).Surface, P( sc, "the float icon's bar is the header's colour" ) )
    tkApp_SetTheme( tkTheme_Light( ) )
    tkToolbar_GetColors( ps->Pal( 1 ).FloatBtn, @barColors )
    t.Check( barColors.BackColor = tkTheme_Light( ).Surface, P( sc, "and follows a theme change" ) )
    tkApp_SetTheme( keptTheme )
    tkTest_PumpFor( h, 20 )
    tkTest_Click( h, tkTest_CX( ps->Pal( 1 ).FloatBtn ), tkTest_CY( ps->Pal( 1 ).FloatBtn ) )
    tkTest_PumpFor( h, 150 )
    t.Check( ps->IsFloating( 1 ), P( sc, "the inspector's Float button floats it" ) )
    t.Check( tkToolbar_GetGlyph( ps->Pal( 1 ).FloatBtn, 0 ) = wchr( panels.GLYPH_DOCK ), P( sc, "and it turns into the dock icon" ) )
    dim as TK_HOST ptr fi = tkForm_Host( ps->Pal( 1 ).Float )
    t.Check( tkTextBox_GetText( EditOf( *ps, "@Name" ) ) = "lblB", P( sc, "with the selection's rows" ) )
    dim as TK_WIDGET ptr eName = EditOf( *ps, "Text" )
    tkScrollPanel_SetPos( ps->Scroll, eName->y - tkHost_Scale( fi, 8 ) )
    tkTest_PumpFor( fi, 20 )
    tkTest_Click( fi, tkTest_CX( eName ), tkTest_CY( eName ) )
    tkTest_PumpFor( fi, 30 )
    Chord( fi, SDLK_A, SDL_SCANCODE_A, TK_KMOD_PRIMARY )
    dim as ustring floated = "Floated"
    tkTest_PushText( fi, floated )
    tkTest_PumpFor( fi, 20 )
    Chord( fi, SDLK_RETURN, SDL_SCANCODE_RETURN, 0 )
    tkTest_PumpFor( h, 40 )
    t.Check( SettingOr( Ctl2( c, "lblB" ).Props, "Text" ) = "Floated", P( sc, "an edit in the float reaches the form" ) )

    ' another buffer hides the float; the form brings it back
    mw.NewBlank( )
    tkTest_PumpFor( h, 60 )
    t.Check( ps->IsShown = false, P( sc, "a text buffer hides the palettes" ) )
    t.Check( tkWidget_IsVisible( ps->Pal( 0 ).Frame ) = false, P( sc, "the docked one" ) )
    t.Check( (SDL_GetWindowFlags( fi->win ) and SDL_WINDOW_HIDDEN) <> 0, P( sc, "and the float" ) )
    t.Check( mw.CanRun( Cmd.FormAlignTops ) = false, P( sc, "and the Form menu is off" ) )
    mw.ShowDoc( d )
    tkTest_PumpFor( h, 80 )
    t.Check( ps->IsShown andalso tkWidget_IsVisible( ps->Pal( 0 ).Frame ), P( sc, "back on the form" ) )
    t.Check( (SDL_GetWindowFlags( fi->win ) and SDL_WINDOW_HIDDEN) = 0, P( sc, "the float too" ) )

    ' ---- remembered
    mw.SaveSession( )
    dim as session.SessionResult sr = session.LoadSession( mw.SessionFile( ) )
    t.Check( sr.IsOk( ) andalso sr.Value( ).FloatProps, P( sc, "session.toml keeps the float" ) )
    t.Check( sr.IsOk( ) andalso (sr.Value( ).FloatToolbox = false), P( sc, "and what's docked" ) )
    t.Check( sr.IsOk( ) andalso (sr.Value( ).PropsW > 0), P( sc, "and its size" ) )

    for each dd as DocRef in mw.Docs
        dd->Main.SetSavePoint( )
    next
    mw.Destroy( )
end sub
