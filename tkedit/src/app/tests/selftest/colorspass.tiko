' colorspass -- a control's Colours row and dialog (docs/tkDesigner/THEMES.md, TH6) on a Button in a new
' GUI project whose theme has a style, through real events: the row and its summary, the style, simple
' mode (Back set, its states derived), a state of its own, a dark|light pair, the previews' colours,
' OK as one change and one undo, Cancel as none. The dialog is opened without its modal loop, as
' itemspass does; the style is chosen by tkComboBox_SetCurSel (a drop-down is the combo box's test).
#module "selftest"

#import "std/containers"
#import "std/fs"
#import "tkc/cmdids"
#import "tka/documents"
#import "tka/mainwin"
#import "tkd/canvas"
#import "tkd/colorsdlg"
#import "tkd/model"
#import "tkd/panels"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkPaint"
#import "vendor/tkControls/tkListTree"
#import "vendor/tkControls/tkTextBox"
#import "vendor/tkControls/tkButton"
#import "vendor/tkControls/tkLabel"
#import "vendor/tkControls/tkComboBox"
#import "vendor/tkControls/tkTabControl"
#import "vendor/tkControls/tkTheme"
using containers
using cmdids
using tkApp
using tkListTree
using tkTextBox
using tkButton
using tkLabel
using tkComboBox
using tkTabControl
using tkTheme
using tkHost
using tkTest
using tkPaint
using model

dim shared as ustring gColorsAsked

private sub RecordColors( byval o as any ptr, byval c as canvas.FormCanvas ptr, byref n as const ustring, byref e as const ustring, byval jump as boolean )
    gColorsAsked = n
end sub

private function RowOf( byval ps as panels.DesignPanels ptr, byref key_ as const ustring ) as long
    for r as long = 0 to ps->Rows.Count( ) - 1
        if ps->Rows[r].Key = key_ then return r
    next
    return -1
end function

public sub ColorsPass( byref t as Tally, byval sc as single )
    dim as mainwin.Window mw
    mw.ConfigDir = FreshConfig( )
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    t.Check( mw.Create( sc ), P( sc, "colours: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_PumpFor( h, 150 )
    dim as ustring proj = fs.PathJoin( Files( ), "colorsproj" & cint( sc * 100 ) )
    fs.RemoveDirAll( proj )
    t.Check( mw.NewFormProject( proj ), P( sc, "colours: a new GUI project" ) )
    tkTest_PumpFor( h, 100 )
    ' its theme gains a style
    dim as ustring nl = wchr( 10 )
    fs.WriteAllText( fs.PathJoin( proj, "appTheme", "appTheme.tktheme" ), "format = 1" & nl & "name = ""Default""" & nl & nl & "[dark]" & nl & nl _
        & "[light]" & nl & nl & "[styles.Primary]" & nl & "Surface = ""@Accent""" & nl )
    dim as DocRef d = mw.Active( )
    dim as canvas.FormCanvas ptr c = 0
    if d then c = d->Designer
    t.Check( c <> 0, P( sc, "colours: the form on its surface" ) )
    if c = 0 then
        mw.Destroy( )
        exit sub
    end if
    dim as panels.DesignPanels ptr ps = @mw.Palettes

    ' ---- a Button, and its Colours row
    dim as TKRECT rs = c->SurfaceRect( ), rg
    tkWidget_AbsRect( c->Glass, rg )
    c->Tool = "Button"
    ClickPx( h, rg.left + rs.left + tkHost_Scale( h, 60 ), rg.top + rs.top + tkHost_Scale( h, 60 ) )
    tkTest_PumpFor( h, 60 )
    dim as long ci = FindControl( c->Doc, "Button1" )
    t.Check( ci >= 0, P( sc, "a Button placed" ) )
    c->SelectOnly( "Button1" )
    tkTest_PumpFor( h, 60 )
    dim as long row = RowOf( ps, "@Colors" )
    t.Check( row >= 0, P( sc, "the inspector has a Colours row" ) )
    if row < 0 then
        mw.Destroy( )
        exit sub
    end if
    t.Check( tkButton_GetText( ps->Rows[row].Edit ) = "Theme", P( sc, "it says Theme: " & tkButton_GetText( ps->Rows[row].Edit ) ) )
    dim as canvas.CanvasWireSub keep = c->OnEditColors
    c->OnEditColors = @RecordColors
    gColorsAsked = ""
    PressIn( h, ps->Rows[row].Edit )
    t.Check( gColorsAsked = "Button1", P( sc, "its button asks for that control: " & gColorsAsked ) )
    c->OnEditColors = keep

    ' ---- the dialog
    dim as ustring text0 = d->Text( )
    mw.OpenColors( c, "Button1" )
    dim as colorsdlg.ColorsDialog ptr dlg = mw.ColorsDlg
    t.Check( (dlg <> 0) andalso (dlg->Win <> 0), P( sc, "the Colours dialog opens" ) )
    if (dlg = 0) orelse (dlg->Win = 0) then
        mw.Destroy( )
        exit sub
    end if
    dim as TK_HOST ptr dh = tkForm_Host( dlg->Win )
    tkTest_PumpFor( dh, 80 )
    t.Check( (dlg->Parts.Count( ) = 4) andalso (dlg->Meta->Colors( dlg->Parts[0] ).Part = "Back"), P( sc, "Simple: Back, Fore, Border, Icon" ) )
    t.Check( tkComboBox_GetCount( dlg->CmbStyle ) = 2, P( sc, "the style list: (none) and the theme's Primary" ) )

    ' the style
    tkComboBox_SetCurSel( dlg->CmbStyle, 1 )
    dlg->FieldChanged( dlg->CmbStyle )
    dim as TKBUTTON_COLORS bc
    dim as TKTHEME_COLORS dark0 = tkTheme_Dark( )
    tkButton_GetColors( dlg->PvLive, @bc )
    t.Check( (dlg->StyleName = "Primary") andalso (bc.BackColor = dark0.Accent), P( sc, "Primary: the preview's face is the Accent: " & hex( bc.BackColor ) ) )
    t.Check( tkLabel_GetText( dlg->PartSources( 0 ) ) = "from the style", P( sc, "and says where it comes from: " & tkLabel_GetText( dlg->PartSources( 0 ) ) ) )

    ' simple mode: Back set, its states follow
    PressIn( dh, dlg->PartEdits( 0 ) )
    Chord( dh, SDLK_A, SDL_SCANCODE_A, TK_KMOD_PRIMARY )
    dim as ustring red = "#C62828"
    tkTest_PushText( dh, red )
    tkTest_PumpFor( dh, 40 )
    tkButton_GetColors( dlg->PvLive, @bc )
    t.Check( bc.BackColor = &hFFC62828ul, P( sc, "Back typed: the preview's face: " & hex( bc.BackColor ) ) )
    t.Check( bc.BackColorHot = tkTheme_DeriveColor( TKDERIVE_HOT, &hFFC62828ul, dark0 ), P( sc, "its Hot face derived: " & hex( bc.BackColorHot ) ) )
    dim as TKBUTTON_COLORS off_
    tkButton_GetColors( dlg->PvOff, @off_ )
    t.Check( off_.BackColorDisabled = tkTheme_DeriveColor( TKDERIVE_DISABLED, &hFFC62828ul, dark0 ), P( sc, "the disabled preview's face derived: " & hex( off_.BackColorDisabled ) ) )
    t.Check( tkLabel_GetText( dlg->PartSources( 0 ) ) = "set on this control", P( sc, "now set on this control" ) )

    ' all states: Hot of its own
    tkTabControl_SetCurSel( dlg->Tabs, 1 )
    tkTest_PumpFor( dh, 40 )
    ClickRow( dh, dlg->Fields, 4 )
    t.Check( tkLabel_GetText( dlg->LblFieldSource ) = "follows this control's Normal colour", P( sc, "BackColorHot follows: " & tkLabel_GetText( dlg->LblFieldSource ) ) )
    PressIn( dh, dlg->TxtField )
    Chord( dh, SDLK_A, SDL_SCANCODE_A, TK_KMOD_PRIMARY )
    dim as ustring acc = "@Accent"
    tkTest_PushText( dh, acc )
    tkTest_PumpFor( dh, 40 )
    tkButton_GetColors( dlg->PvLive, @bc )
    t.Check( bc.BackColorHot = dark0.Accent, P( sc, "a state of its own: Hot = @Accent: " & hex( bc.BackColorHot ) ) )

    ' a pair: ForeColor differs in light mode
    ClickRow( dh, dlg->Fields, 1 )
    PressIn( dh, dlg->ChkPair )
    t.Check( instr( SettingOr( dlg->Colors, "ForeColor" ), "|" ) > 0, P( sc, "Different in light mode makes a pair: " & SettingOr( dlg->Colors, "ForeColor" ) ) )
    PressIn( dh, dlg->TxtField )
    Chord( dh, SDLK_A, SDL_SCANCODE_A, TK_KMOD_PRIMARY )
    dim as ustring white = "#FFFFFF"
    tkTest_PushText( dh, white )
    tkTest_PumpFor( dh, 40 )
    t.Check( left( SettingOr( dlg->Colors, "ForeColor" ), 8 ) = "#FFFFFF|", P( sc, "the box edits the dark half: " & SettingOr( dlg->Colors, "ForeColor" ) ) )
    tkButton_GetColors( dlg->PvLive, @bc )
    t.Check( bc.ForeColor = &hFFFFFFFFul, P( sc, "and the preview's text follows" ) )

    ' ---- OK: one change, one undo
    mw.FinishColors( true )
    tkTest_PumpFor( h, 60 )
    ci = FindControl( c->Doc, "Button1" )
    t.Check( (c->Doc.Controls[ci].StyleName = "Primary") andalso (c->Doc.Controls[ci].Colors.Count( ) = 3), _
             P( sc, "OK: the style and three colours on the control, " & c->Doc.Controls[ci].Colors.Count( ) ) )
    t.Check( (instr( d->Text( ), "[control.colors]" ) > 0) andalso (instr( d->Text( ), "style = ""Primary""" ) > 0) _
             andalso (instr( d->Text( ), "ForeColor = { dark = ""#FFFFFF""" ) > 0), P( sc, "and in the form's text" ) )
    c->SelectOnly( "Button1" )
    tkTest_PumpFor( h, 60 )
    row = RowOf( ps, "@Colors" )
    dim as ustring said
    if row >= 0 then said = tkButton_GetText( ps->Rows[row].Edit )
    t.Check( said = "Primary + 3 colours", P( sc, "the row says so: " & said ) )

    ' ---- the canvas wears the project theme (TH7): the form's scope, the control's recipe in it
    mw.RefreshFormThemes( )                     ' the theme file was written behind tkEdit's back above
    tkTest_PumpFor( h, 40 )
    dim as boolean dk = c->ShowsDark( ), edDark = tkApp_Theme( ).IsDark
    dim as TK_WIDGET ptr cb = c->WidgetOf( "Button1" )
    tkButton_GetColors( cb, @bc )
    dim as TKTHEME_COLORS sk = tkTheme_Of( c->Surface )
    t.Check( (sk.IsDark = dk) andalso (bc.BackColor = &hFFC62828ul) andalso (bc.BackColorHot = sk.Accent), _
             P( sc, "the canvas Button: its Back, and Hot = the form theme's @Accent: " & hex( bc.BackColorHot ) & " " & hex( sk.Accent ) ) )
    t.Check( (bc.ForeColor = &hFFFFFFFFul) = dk, P( sc, "and its Fore pair's half for the variant shown: " & hex( bc.ForeColor ) ) )
    mw.Execute( Cmd.FormPreviewVariant )
    tkTest_PumpFor( h, 40 )
    tkButton_GetColors( cb, @bc )
    sk = tkTheme_Of( c->Surface )
    t.Check( (c->ShowsDark( ) = (dk = false)) andalso (sk.IsDark = (dk = false)), P( sc, "Preview Light / Dark: the other variant" ) )
    t.Check( (bc.BackColorHot = sk.Accent) andalso ((bc.ForeColor = &hFFFFFFFFul) = (dk = false)), _
             P( sc, "and the Button follows: " & hex( bc.BackColorHot ) & " " & hex( bc.ForeColor ) ) )
    t.Check( tkApp_Theme( ).IsDark = edDark, P( sc, "tkEdit's own theme is untouched" ) )
    ' Test Form shows the variant the surface does
    mw.Execute( Cmd.FormTest )
    tkTest_PumpFor( h, 80 )
    t.Check( (mw.Preview <> 0) andalso (mw.Preview->ShowsDark( ) = (dk = false)) _
             andalso (tkTheme_Of( mw.Preview->Surface ).IsDark = (dk = false)), P( sc, "Test Form wears it in that variant" ) )
    if mw.Preview then
        tkButton_GetColors( mw.Preview->WidgetOf( "Button1" ), @bc )
        t.Check( bc.BackColorHot = sk.Accent, P( sc, "its Button too: " & hex( bc.BackColorHot ) ) )
        tkTest_PushKey( tkForm_Host( mw.PreviewForm ), SDLK_ESCAPE, 0, true, SDL_SCANCODE_ESCAPE )
        tkTest_PumpFor( h, 60 )
        tkApp_Pump( )
        tkTest_PumpFor( h, 40 )
    end if
    mw.Execute( Cmd.FormPreviewVariant )        ' back to the variant the checks below expect
    tkTest_PumpFor( h, 30 )
    tkHost_SetFocus( h, c->Glass )
    Chord( h, SDLK_Z, SDL_SCANCODE_Z, TK_KMOD_PRIMARY )
    tkTest_PumpFor( h, 60 )
    ci = FindControl( c->Doc, "Button1" )
    t.Check( (ci >= 0) andalso (len( c->Doc.Controls[ci].StyleName ) = 0) andalso (c->Doc.Controls[ci].Colors.Count( ) = 0) _
             andalso (instr( d->Text( ), "[control.colors]" ) = 0), P( sc, "one Undo takes it all back" ) )

    ' ---- Cancel changes nothing
    dim as ustring text1 = d->Text( )
    mw.OpenColors( c, "Button1" )
    if mw.ColorsDlg then
        PutSetting( mw.ColorsDlg->Colors, "BackColor", "#000000" )
        mw.FinishColors( false )
    end if
    tkTest_PumpFor( h, 40 )
    t.Check( d->Text( ) = text1, P( sc, "Cancel changes nothing" ) )

    for each dd as DocRef in mw.Docs
        dd->Main.SetSavePoint( )
    next
    mw.Destroy( )
end sub
