' chrome -- what a theme and the settings look like on screen: the editor view's resolved look, and
' the few colours mixed from the theme's roles. Pure mapping, no state.
#module "chrome"

#import "tkc/settings"
#import "tkc/themes"
#import "tka/editor"
#import "vendor/tkControls/tkTheme"
using tkTheme

public function Argb( byval c as long ) as ulong
    return &hFF000000ul or (c and &hFFFFFFul)
end function

' a + (b - a) * t, per channel
private function Mix( byval a as long, byval b as long, byval t as single ) as long
    dim as long o = 0
    for sh as long = 0 to 16 step 8
        dim as long x = (a shr sh) and &hFF, y = (b shr sh) and &hFF
        o or= (cint( x + (y - x) * t ) and &hFF) shl sh
    next
    return o
end function

' The status line's text: the theme's dim text a quarter of the way to the status line's background
' (the right-click menu's, Popup), the contrast of a VS Code status bar.
public function StatusText( byref r as TKTHEME_COLORS ) as ulong
    return Argb( Mix( r.TextDim and &hFFFFFF, r.Popup and &hFFFFFF, 0.25 ) )
end function

' The views' scrollbars, flat as tiko-editor's: the editor's background for the track, a thumb a
' fifth of the way to its text colour (no hover brightening), the theme's Border for the divider.
public sub ScrollBarColors( byref t as themes.Theme, byref r as TKTHEME_COLORS, byref track as ulong, byref thumb as ulong, byref divider as ulong )
    track = Argb( t.EdBg )
    thumb = Argb( Mix( t.EdBg, t.EdFg, 0.2 ) )
    divider = Argb( r.Border and &hFFFFFF )
end sub

private function StyleOf( byref s as const themes.StyleSpec ) as editor.Style
    dim as editor.Style o
    o.Fore = s.Fore
    o.Back = s.Back
    o.Bold = s.Bold
    o.Italic = s.Italic
    return o
end function

' The view's look: the theme's colours, the settings' switches, the keywords and the font file.
public function LookOf( byref t as themes.Theme, byref s as const settings.EditorSettings, _
                        byref words as const editor.Keywords, byref fontFile as const ustring, _
                        byref r as TKTHEME_COLORS ) as editor.Look
    dim as editor.Look k
    k.FontFile = fontFile
    k.FontSize = s.FontSize
    k.ExtraLineSpacing = s.ExtraLineSpacing
    k.TabSize = s.TabSize
    k.UseTabs = s.UseTabs
    k.LineNumbers = s.LineNumbers
    k.Whitespace = s.Whitespace
    k.Wrap = s.Wrap
    k.CaretLine = s.CaretLine
    k.IndentGuides = s.IndentGuides
    k.FoldMargin = s.FoldMargin
    k.Words = words
    k.Text = StyleOf( t.Default_ )
    k.Text.Back = t.EdBg
    if k.Text.Fore < 0 then k.Text.Fore = t.EdFg
    k.Comments = StyleOf( t.Comment )
    k.Numbers = StyleOf( t.Number_ )
    k.Keyword1 = StyleOf( t.Keyword )
    k.Keyword2 = StyleOf( t.Keyword2 )
    k.Keyword3 = StyleOf( t.Keyword3 )
    k.Keyword4 = StyleOf( t.Keyword4 )
    k.Strings = StyleOf( t.String_ )
    k.Preprocessor = StyleOf( t.Preprocessor )
    k.Operators = StyleOf( t.Operator_ )
    k.Identifiers = StyleOf( t.Identifier )
    k.Gutter.Fore = t.GutterFg
    k.Gutter.Back = t.Gutter
    k.Caret = t.Caret
    k.CaretLineBack = t.CaretLine
    k.Selection = t.Selection
    k.FoldBack = t.Fold
    k.IndentGuide = t.IndentGuide
    k.Brace = t.Brace
    k.FindMatch = t.FindMatch
    k.ErrorColor = t.ErrorColor
    k.WarningColor = t.WarningColor
    k.Bookmark = t.Bookmark
    k.Breakpoint = t.Breakpoint
    k.ExecLine = t.ExecLine
    k.ExecLineBack = t.ExecLineBack
    ' the call tip as the popups are: the popup colour, the UI text; the parameter being typed in the
    ' keyword colour (the accent is too dark to read on the dark popup)
    k.CallTipBack = r.Popup and &hFFFFFF
    k.CallTipFore = r.PopupText and &hFFFFFF
    k.CallTipHighlight = t.Keyword.Fore
    if k.CallTipHighlight < 0 then k.CallTipHighlight = r.Accent and &hFFFFFF
    return k
end function
