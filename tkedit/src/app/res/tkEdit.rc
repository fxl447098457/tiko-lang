/* tkEdit resources (Windows only). Block comments only: the resource compiler rejects //.
   The icon is drawn by tools/make-icon.py. Its NAME sorts first (IMAGE_AAA_) so Windows takes it
   as the program icon, and SDL takes the first icon for the window class. */
IMAGE_AAA_MAINICON   ICON     "tkedit.ico"

/* The version resource: Explorer's Details tab, and one of the signals Defender's reputation
   scoring weighs (an unsigned exe with none looks more like malware). No preprocessor here, so
   the winver.h names are their values: VS_FFI_FILEFLAGSMASK 0x3F, VOS_NT_WINDOWS32 0x40004,
   VFT_APP 1. The numbers MUST match core/appinfo's VERSION_* -- coreall's appinfo suite checks. */
1 VERSIONINFO
FILEVERSION     0,1,4,0
PRODUCTVERSION  0,1,4,0
FILEFLAGSMASK   0x3F
FILEFLAGS       0x0
FILEOS          0x40004
FILETYPE        0x1
FILESUBTYPE     0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "PlanetSquires Software"
            VALUE "FileDescription",  "tkEdit - an editor for the tiko compiler"
            VALUE "FileVersion",      "0.1.4"
            VALUE "InternalName",     "tkEdit"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Paul Squires, PlanetSquires Software"
            VALUE "OriginalFilename", "tkedit.exe"
            VALUE "ProductName",      "tkEdit"
            VALUE "ProductVersion",   "0.1.4"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
