'    tkEdit - a minimalist keyboard-driven editor for the tiko compiler
'    Copyright (C) 2026 Paul Squires, PlanetSquires Software
'
'    This Source Code Form is subject to the terms of the Mozilla Public
'    License, v. 2.0. If a copy of the MPL was not distributed with this
'    file, You can obtain one at https://mozilla.org/MPL/2.0/.
'
'   tkEdit [files...]     run it, restoring the last session, then opening the files
'   tkEdit --selftest     drive the real window at scale 1.0 and 1.75, print what it saw;
'                         exit code = failures, last line " selftest: N passed, M failed"
'   tkEdit --export-resources DIR   write every file tkEdit carries (themes, languages, keyword
'                         lists, fonts, licences) below DIR, to read or to copy into the config folder
'   tkEdit --licences     print the licences of tkEdit's fonts and of the libraries inside it
'   tkEdit --generate-forms DIR   write the .design.tiko of every .tkform below DIR that needs it
'   tkEdit --check-forms DIR      list the ones that don't match; exit code = problems
'
' ONE FILE (docs/tkEdit/SINGLE-FILE.md): SDL, SDL_ttf, SDL_image and scintk are linked in, and the
' data files are '#embed'ded (tka/assets) -- nothing is looked for beside the program.
#import "std/containers"
#import "std/fs"
#import "std/strings"
#import "tkp/platform"
#import "tkc/bundled"
#import "tkc/project"
#import "tkd/formtree"
#import "vendor/SDL3" link static
#import "vendor/SDL3/ttf" link static
#import "vendor/SDL3/image" link static
#import "vendor/tkControls/tkCodeEdit" link static
#import "tka/assets"
#import "tka/mainwin"
#import "./tests/selftest"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkCodeEdit"
using containers
using tkApp
using tkHost
using tkCodeEdit

assets.Register( )      ' before any font, theme or catalog is asked for

if command( 1 ) = "--export-resources" then
    if len( command( 2 ) ) = 0 then print "tkEdit --export-resources DIR" : end 2
    dim as long nBad
    dim as long nDone = bundled.ExportAll( command( 2 ), nBad )
    print "tkEdit: "; nDone; " files written below "; command( 2 ); iif( nBad > 0, ", " & nBad & " could not be", "" )
    end iif( nBad > 0, 1, 0 )
end if
if (command( 1 ) = "--generate-forms") orelse (command( 1 ) = "--check-forms") then
    if len( command( 2 ) ) = 0 then print "tkEdit "; command( 1 ); " DIR" : end 2
    dim as Array( of ustring ) report
    dim as long nBad = formtree.Process( command( 2 ), command( 1 ) = "--generate-forms", report )
    for each s as ustring in report
        print s
    next
    end nBad
end if
if command( 1 ) = "--licences" then
    dim as Array( of ustring ) lics = bundled.Names( "licences" )
    for each f as ustring in bundled.Names( "fonts" )
        if lcase( right( f, 4 ) ) = ".txt" then lics.Push( f )
    next
    for each f as ustring in lics
        print "==== "; f; " ===="
        print bundled.ReadAllText( bundled.PREFIX & f ).ValueOr( "" )
    next
    end 0
end if

' Files (or a project's tiko.toml) named on the command line take the place of the last session's files and
' project; the window's place and the recent list come back either way.
dim as Array( of ustring ) named
dim as long i = 1
while len( command( i ) )
    dim as ustring a = command( i )
    dim as ustring f = fs.AbsolutePath( a ).ValueOr( a )
    if fs.IsFile( f ) then named.Push( f )
    i += 1
wend
' One tkEdit ([ui] single_instance): another one running takes the files, and this launch ends here.
dim as fs.FileLock instanceLock
if command( 1 ) <> "--selftest" then
    if mainwin.HandedOff( instanceLock, named ) then end 0
end if

dim as TKAPP_OPTIONS opts = mainwin.AppOptions( )
if tkApp_Init( opts ) = false then
    print "tkEdit: SDL could not start: "; *SDL_GetError( )
    end 1
end if

if command( 1 ) = "--selftest" then
    dim as selftest.Tally t
    selftest.Pass( t, 1.0 )
    selftest.Pass( t, 1.75 )
    selftest.ConfigPass( t, 1.0 )
    selftest.BufferPass( t, 1.0 )
    selftest.TabsPass( t, 1.0 )
    selftest.TabsPass( t, 1.75 )
    selftest.MenuPass( t, 1.0 )
    selftest.MenuPass( t, 1.75 )
    selftest.SessionPass( t, 1.0 )
    selftest.FindPass( t, 1.0 )
    selftest.FindPass( t, 1.75 )
    selftest.BuildPass( t, 1.0 )
    selftest.DebugTabPass( t, 1.0 )
    selftest.DebugTabPass( t, 1.75 )
    selftest.DebugPass( t, 1.0 )
    selftest.DebugVarsPass( t, 1.0 )
    selftest.DebugFailPass( t, 1.0 )
    selftest.IntelPass( t, 1.0 )
    selftest.PolishPass( t, 1.0 )
    selftest.InboxPass( t, 1.0 )
    selftest.ScrollPass( t, 1.0 )
    selftest.ScrollPass( t, 1.75 )
    selftest.StartPass( t, 1.0 )
    selftest.StartPass( t, 1.75 )
    selftest.TabMenuPass( t, 1.0 )
    selftest.TabMenuPass( t, 1.75 )
    selftest.ExplorerPass( t, 1.0 )
    selftest.ExplorerPass( t, 1.75 )
    selftest.DesignerPass( t, 1.0 )
    selftest.DesignerPass( t, 1.75 )
    selftest.PanelsPass( t, 1.0 )
    selftest.PanelsPass( t, 1.75 )
    selftest.WiringPass( t, 1.0 )
    selftest.ItemsPass( t, 1.0 )
    selftest.ItemsPass( t, 1.75 )
    selftest.FinishPass( t, 1.0 )
    selftest.ThemePass( t, 1.0 )
    selftest.ColorsPass( t, 1.0 )
    tkApp_Shutdown( )
    print strings.Format( "tkEdit [{}] selftest: {} passed, {} failed", platform.OsName( ), t.passed, t.failed )
    end t.failed
end if

dim as mainwin.Window theWindow
if theWindow.Create( ) = false then
    print "tkEdit: the main window could not be created: "; *SDL_GetError( ); " "; tkCodeEdit_LibraryError( )
    end 1
end if
theWindow.RestoreSession( named.Count( ) = 0 )
for each f as ustring in named
    if project.IsManifest( f ) then theWindow.OpenFile( f )     ' a project first: it closes what is open
next
for each f as ustring in named
    if project.IsManifest( f ) = false then theWindow.OpenFile( f )
next
theWindow.Show( )
theWindow.EnsureCompilerSoon( )          ' no compiler found: ask for one (author 2026-10-27)
theWindow.ServeInbox( @instanceLock )
end tkApp_Run( theWindow.form )
