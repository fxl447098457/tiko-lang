'
' outputpane -- the toggleable pane under the editors (D4): hidden until Ctrl+F9 or a failed build,
' three tabs:
'   Results   the build's diagnostics, a header row per file; Enter or a double click goes there
'   Log       what tiko printed, less its JSON events
'   Search    Find in Project's matches, a header row per file; Enter or a double click goes there
'   Debug     the debugger (tka/debugpane): buttons, Locals/Globals/Watch | Call Stack/Breakpoints
' Rows carry an index the owner gives; what activating one means is the owner's (OnActivate).
' At the tab strip's right end, the float / dock button (as the designer's palettes have): the owner
' moves the frame onto a window of its own and back (tkWidget_Reparent: the lists keep their rows).
' After tiko-studio's tsa/outputpane: its Results, Compiler Log and Search Results (PROVENANCE.md).
#module "outputpane"

#import "std/containers"
#import "tkc/i18n"
#import "tka/debugpane"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkTabBar"
#import "vendor/tkControls/tkListTree"
#import "vendor/tkControls/tkTextBox"
#import "vendor/tkControls/tkToolbar"
using containers
using tkApp
using tkHost
using tkPaint
using tkTheme
using tkTabBar
using tkListTree
using tkTextBox
using tkToolbar

public enum OutputTab explicit
    Results = 0
    CompilerLog = 1
    Search = 2
    Debug = 3
end enum

public type OutputActivateSub as sub( byval owner as any ptr, byval tab_ as OutputTab, byval itemIndex as long )
public type OutputNotifySub as sub( byval owner as any ptr )

public const TAB_CY = 26
public const PANE_CY = 170               ' the pane's height, unscaled
const ID_TABS = 1
const ID_RESULTS = 10
const ID_LOG = 11
const ID_SEARCH = 12
const ID_DEBUG = 13
const ID_FLOAT = 14
const PAD = 4
' PsIcons: the designer palettes' float / dock glyphs (design/panels GLYPH_FLOAT, GLYPH_DOCK)
const GLYPH_FLOAT = &hF582
const GLYPH_DOCK = &hF373

public type Pane
    owner as any ptr
    OnActivate as OutputActivateSub
    OnFloat as OutputNotifySub          ' the float / dock button: the owner toggles, not from inside the click
    frame as TK_WIDGET ptr
    tabs as TK_WIDGET ptr
    results as TK_WIDGET ptr
    logBox as TK_WIDGET ptr
    search as TK_WIDGET ptr
    floatBtn as TK_WIDGET ptr
    floating as boolean                 ' the button shows Dock
    Debug as debugpane.Pane              ' the Debug tab's content
    searchPressed as boolean            ' the button went down on a Search row
    current as OutputTab

    declare sub Create( byval parent as TK_WIDGET ptr, byval id as long, byval owner_ as any ptr )
    declare sub Layout( )
    declare sub ShowTab( byval t as OutputTab )
    declare function Content( byval t as OutputTab ) as TK_WIDGET ptr
    declare sub SetLog( byref text as const ustring )
    declare function LogText( ) as ustring
    declare sub Focus( )
    declare sub ApplyColors( )                  ' after a theme change
    declare sub Relabel( )                      ' the tabs' text in the interface's language
    declare sub SetFloating( byval onOff as boolean )
    declare sub Rehome( )                       ' after a move to another window: that window's fonts
end type

private function PaneOf( byval w as TK_WIDGET ptr ) as Pane ptr
    while w
        if w->ctrlId < 0 then return w->pData
        w = w->pParent
    wend
    return 0
end function

' The float button's bar in the tab strip's own background. Pinned, so set again at every theme.
private sub ColorFloatBar( byval bar as TK_WIDGET ptr )
    dim as TKTOOLBAR_COLORS c = tkToolbar_ThemeColors( tkTheme_Get( ) )
    c.BackColor = tkTabBar_ThemeColors( tkTheme_Get( ) ).BackColor
    tkToolbar_SetColors( bar, @c )
end sub

private function FrameProc( byval w as TK_WIDGET ptr, byval m as TK_MSG ptr ) as boolean
    select case m->msg
    case TKM_PAINT
        dim as TKRECT rc
        tkRect_Set( rc, 0, 0, w->cw, w->ch )
        m->pPaint->SetBackColor( tkTheme_Get( ).Surface )
        m->pPaint->PaintRect( @rc )
        return true
    case TKM_SIZE
        cast( Pane ptr, w->pData )->Layout( )
        return true
    case TKM_THEMECHANGED
        dim as Pane ptr p = w->pData
        if p->floatBtn then ColorFloatBar( p->floatBtn )
        tkWidget_Invalidate( w )
        return true
    end select
    return false
end function

sub Pane.Create( byval parent as TK_WIDGET ptr, byval id as long, byval owner_ as any ptr )
    owner = owner_
    frame = tkWidget_CreateChild( parent, -id, @FrameProc, @this )
    tabs = tkTabBar_Create( frame, ID_TABS )
    tkTabBar_AddTab( tabs, "" )                 ' the tabs' text: Relabel
    tkTabBar_AddTab( tabs, "" )
    tkTabBar_AddTab( tabs, "" )
    tkTabBar_AddTab( tabs, "" )
    for i as long = 0 to 3
        tkTabBar_SetClosable( tabs, i, false )
    next
    tkTabBar_SetTooltipCallback( tabs, @debugpane.NoTabTip )     ' no tooltips on the tabs (author 2026-11-07)
    tkTabBar_SetSelChangeCallback( tabs, sub( byval h as TK_WIDGET ptr, byval idxOld as long, byval idxNew as long )
        dim as Pane ptr p = PaneOf( h )
        if p then p->ShowTab( cast( OutputTab, idxNew ) )
    end sub )
    results = tkListTree_Create( frame, ID_RESULTS )
    logBox = tkTextBox_Create( frame, ID_LOG, true )
    tkTextBox_SetReadOnly( logBox, true )
    tkTextBox_SetBorderWidth( logBox, 0 )   ' no frame: Results and Search have none (author 2026-10-27)
    dim as TK_FORM ptr f = tkForm_FromWidget( frame )
    if f then tkTextBox_SetFont( logBox, tkForm_Font( f, TKFONT_MONO ) )
    this.ApplyColors( )
    search = tkListTree_Create( frame, ID_SEARCH )
    dim as LT_ActivateCallbackSub act = sub( byval h as TK_WIDGET ptr, byval row as integer )
        dim as Pane ptr p = PaneOf( h )
        if (p = 0) orelse (p->OnActivate = 0) then exit sub
        dim as OutputTab t = OutputTab.Results
        if h->ctrlId = ID_SEARCH then t = OutputTab.Search
        p->OnActivate( p->owner, t, tkListTree_GetItemData( h, row ) )
    end sub
    tkListTree_SetActivateCallback( results, act )
    tkListTree_SetActivateCallback( search, act )
    tkListTree_SetPaintCallback( results, @tkListTree_PaintRowDefault )   ' a tkListTree draws no row by itself
    ' a Search row opens on one click: a press on a row, then its release there
    tkListTree_SetMessageCallback( search, function( byval mi as TKLISTTREE_MESSAGEINFO ptr ) as boolean
        dim as Pane ptr p = PaneOf( mi->hList )
        if p = 0 then return false
        if mi->msg = TKM_LBUTTONDOWN then
            p->searchPressed = (mi->idx >= 0)
            return false
        end if
        if mi->msg <> TKM_LBUTTONUP then return false
        dim as boolean wasPressed = p->searchPressed
        p->searchPressed = false
        if (mi->idx < 0) orelse (wasPressed = false) orelse (p->OnActivate = 0) then return false
        p->OnActivate( p->owner, OutputTab.Search, tkListTree_GetItemData( mi->hList, mi->idx ) )
        return true
    end function )
    tkListTree_SetPaintCallback( search, @tkListTree_PaintRowDefault )
    Debug.Create( frame, ID_DEBUG, owner_ )
    floatBtn = tkToolbar_Create( frame, ID_FLOAT )
    if f then tkToolbar_SetGlyphFont( floatBtn, tkForm_Font( f, TKFONT_GLYPH ) )
    ColorFloatBar( floatBtn )
    tkToolbar_AddItem( floatBtn, TBR_KIND_COMMAND, wchr( GLYPH_FLOAT ), "", ID_FLOAT )
    tkToolbar_SetClickCallback( floatBtn, sub( byval h as TK_WIDGET ptr, byval idx as long, byval cid as long )
        dim as Pane ptr p = PaneOf( h )
        if (p <> 0) andalso (p->OnFloat <> 0) then p->OnFloat( p->owner )
    end sub )
    this.Relabel( )
    this.ShowTab( OutputTab.Results )
    tkWidget_Show( frame, false )
end sub

sub Pane.Layout( )
    if frame = 0 then exit sub
    dim as long th = tkHost_Scale( frame->pHost, TAB_CY ), p_ = tkHost_Scale( frame->pHost, PAD ), bw = 0, bh = 0
    if floatBtn then
        tkToolbar_GetIdealSize( floatBtn, bw, bh )
        if bh > th then bh = th
        tkWidget_SetPos( floatBtn, frame->cw - bw - p_, (th - bh) \ 2, bw, bh )
        bw += 2 * p_
    end if
    ' the tabs end where the button's room starts; the strip's background is under the button too
    tkWidget_SetPos( tabs, 0, 0, frame->cw - bw, th )
    tkWidget_SetPos( results, 0, th, frame->cw, frame->ch - th )
    tkWidget_SetPos( logBox, 0, th, frame->cw, frame->ch - th )
    tkWidget_SetPos( search, 0, th, frame->cw, frame->ch - th )
    tkWidget_SetPos( Debug.frame, 0, th, frame->cw, frame->ch - th )
end sub

sub Pane.ShowTab( byval t as OutputTab )
    current = t
    tkWidget_Show( results, t = OutputTab.Results )
    tkWidget_Show( logBox, t = OutputTab.CompilerLog )
    tkWidget_Show( search, t = OutputTab.Search )
    tkWidget_Show( Debug.frame, t = OutputTab.Debug )
    if t = OutputTab.Debug then Debug.SyncButtons( )
    if tkTabBar_GetCurSel( tabs ) <> cast( long, t ) then tkTabBar_SetCurSel( tabs, t )
end sub

function Pane.Content( byval t as OutputTab ) as TK_WIDGET ptr
    if t = OutputTab.CompilerLog then return logBox
    if t = OutputTab.Search then return search
    if t = OutputTab.Debug then return Debug.lists( Debug.leftTab )
    return results
end function

sub Pane.SetLog( byref text as const ustring )
    tkTextBox_SetText( logBox, text )
end sub

function Pane.LogText( ) as ustring
    return tkTextBox_GetText( logBox )
end function

sub Pane.Focus( )
    tkHost_SetFocus( frame->pHost, this.Content( current ) )
end sub

' The Log tab's box in the Results and Search lists' background (a text box's own is the theme's
' Surface): pinned, so it is applied again after every theme change (author 2026-10-27).
sub Pane.ApplyColors( )
    if logBox = 0 then exit sub
    dim as TKTHEME_COLORS t = tkTheme_Get( )
    dim as TKTEXTBOX_COLORS c = tkTextBox_ThemeColors( t )
    c.BackColor = t.Window
    c.OuterBackColor = t.Window
    tkTextBox_SetColors( logBox, @c )
    ' the tabs without the selected tab's accent bar along its top, as tkEdit's tab strip (author
    ' 2026-10-27): the bar takes the tab's own colour
    dim as TKTABBAR_COLORS tbc = tkTabBar_ThemeColors( t )
    tbc.AccentColor = tbc.TabBackColorSelected
    tkTabBar_SetColors( tabs, @tbc )
    if Debug.frame then Debug.ApplyColors( )
end sub

sub Pane.Relabel( )
    tkTabBar_SetText( tabs, OutputTab.Results, i18n.Tr( "output.tab_results", "Results" ) )
    tkTabBar_SetText( tabs, OutputTab.CompilerLog, i18n.Tr( "output.tab_log", "Log" ) )
    tkTabBar_SetText( tabs, OutputTab.Search, i18n.Tr( "output.tab_search", "Search" ) )
    tkTabBar_SetText( tabs, OutputTab.Debug, i18n.Tr( "output.tab_debug", "Debug" ) )
    if Debug.frame then Debug.Relabel( )
    if floatBtn then
        if floating then
            tkToolbar_SetTooltipText( floatBtn, 0, i18n.Tr( "designer.dock", "Dock" ) )
        else
            tkToolbar_SetTooltipText( floatBtn, 0, i18n.Tr( "designer.float", "Float" ) )
        end if
    end if
end sub

sub Pane.SetFloating( byval onOff as boolean )
    floating = onOff
    if floatBtn = 0 then exit sub
    tkToolbar_SetGlyph( floatBtn, 0, wchr( iif( onOff, GLYPH_DOCK, GLYPH_FLOAT ) ) )
    this.Relabel( )
    tkWidget_Invalidate( floatBtn )
end sub

' The fonts the pane's controls were given came from the window they were made on; moved, they
' take the new window's (its scale may differ). Its UI font they find through their surface.
sub Pane.Rehome( )
    dim as TK_FORM ptr f = tkForm_FromWidget( frame )
    if f = 0 then exit sub
    tkTextBox_SetFont( logBox, tkForm_Font( f, TKFONT_MONO ) )
    if floatBtn then tkToolbar_SetGlyphFont( floatBtn, tkForm_Font( f, TKFONT_GLYPH ) )
    Debug.Rehome( )
    this.Layout( )
end sub
