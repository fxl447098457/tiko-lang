public const TIKO_TYPES = "any boolean byte double integer long longint short single string ubyte uinteger " & _
                          "ulong ulongint ushort ustring wstring zstring int8 uint8 int16 uint16 int32 uint32 " & _
                          "int64 uint64 float32 float64 const function sub"
