'' tkiemit.tiko -- a module's interface, written as tiko source (ADR 0017; RFC-0004 §2-3).
''
'' NOTHING IS PRINTED FROM SYMBOLS. The parser recorded where every declaration of the unit
'' lies in the token vector (ast.declRanges), and the interface is those tokens, spelled
'' back after preprocessing -- so it names nothing a macro wrote, which is what makes it
'' hermetic, and it says exactly what the module declared, because it is what the module
'' wrote. The walk is over the unit's MODULE LEVEL: declarations in a module file, outside
'' any procedure, through any number of namespaces. What each becomes:
''
''     sub / function / operator      'declare' and its header; the body stays behind
''     a type's member, out of line   nothing: the type's own 'declare' is the interface
''     a generic, and its members     verbatim, bodies and all: an importer instantiates it
''     declare, type, union, enum,
''     const, type alias, extern      verbatim
''     dim shared                     'extern', linking by the module's own name for it
''     namespace                      the block, holding what was chosen from inside it
''
'' 'private' leaves anything out. 'public' is written as it was, and in an importer it is
'' what separates the names it may use from the ones that are only there for a generic's
'' body to find (RFC-0002 §3).

#import "std/containers"
#include once "driver/tkiemit.ti"
#include once "driver/modresolve.ti"
#include once "pp/pp.ti"
#include once "symbols/mangle.ti"
#include once "symbols/modsym.ti"
#include once "support/text.ti"

namespace Tko.Modules

type TkiWriter_
    as Tko.CompilerContext ptr ctx
    as Tko.TokenVec ptr        toks
    as Tko.AstArena ptr        ast
    as Tko.SymbolTable ptr     syms
    as Tko.SemanticInfo ptr    info
    '' Where the declaration starting at each token ends (exclusive), 0 where none starts.
    as containers.Array( of int32 )     endAt
    as containers.Array( of int32 )     nodeAt
    '' A procedure's FIRST DECLARATION, by node: the symbol keeps it as its payload. Only
    '' that one is written -- fbc refuses a second 'declare' of one signature, and a
    '' definition that follows its 'declare' adds nothing an importer can see.
    as containers.Array( of uint8 )    firstSight
    as string                  text
    '' Per token: 1 once it has been written. The headers the interface needs are the ones
    '' its WRITTEN tokens name something from (RequiredHeaders_).
    as containers.Array( of uint8 )    emitted
    '' The source line the next output line stands for, so '#line' is written only when
    '' the two part.
    as uint32                   lineFile
    as int32                    lineNo
    as boolean                 atLineStart
    as int32                    prevTok
    as Tko.StrVec ptr          aliases
    as Tko.StrVec ptr          spaces
    '' Per token: the qualifier a name a 'using' reached is written with (Qualify_).
    as Tko.StrVec              qual
    '' Token by source location, for the declarations' tokens: open addressing, key loc + 1.
    as containers.Array( of uint32 )    hkey
    as containers.Array( of int32 )     hval
    as int32                    hmask
    '' ...and EVERY token at a location, chained: one '#macro' expanded four times gives four
    '' tokens one location, and a qualifier set on the first alone left the others bare --
    '' fb/mathint.bi's 'as Optional( of short )', declared for each integer width (std/numeric,
    '' 2026-10-10). Per token: the next with its location, or -1; per slot, the last so far.
    as containers.Array( of int32 )     locNext
    as containers.Array( of int32 )     hlast
    '' The '' uses <chain> lines RequiredHeaders_ found: imported modules whose public
    '' headers the written tokens name something from.
    as string                  uses
    '' INDEXES for what was scanned per token or per written name: by FileId, 1 for a file of
    '' the module (InModule_); the chains already in 'uses' (AddUse_); and each public
    '' header's FIRST entry in pr.pubHdrFile, by its file (PubUseOf_).
    as containers.Array( of uint8 )      modMark
    as containers.Set( of string )       usedSeen
    as containers.Map( of uint32, int32 ) pubHdrAt
end type

function InterfaceNamespace( byref chain as string ) as string
    return "__tko_mod_" & Tko.PpModChainIdent( chain )
end function

private function Kind_( byref w as TkiWriter_, byval i as int32 ) as Tko.TokenKind
    if (i < 0) orelse (i >= w.toks->Count) then return Tko.TK_EOF
    return cast( Tko.TokenKind, (*w.toks)[i].kind )
end function

private function FileOf_( byref w as TkiWriter_, byval i as int32 ) as uint32
    return cast( uint32, w.ctx->sources.Decode( (*w.toks)[i].loc ).file )
end function

private function InModule_( byref w as TkiWriter_, byval i as int32 ) as boolean
    dim as uint32 f = FileOf_( w, i )
    if f >= cast( uint32, w.modMark.Count ) then return false
    return (w.modMark[f] <> 0)
end function

'' The end of line that ends the statement starting at i -- a ':' counts.
private function StmtEnd_( byref w as TkiWriter_, byval i as int32 ) as int32
    dim as int32 j = i
    while (Kind_( w, j ) <> Tko.TK_EOL) andalso (Kind_( w, j ) <> Tko.TK_EOF)
        j += 1
    wend
    return j
end function

private sub NewLine_( byref w as TkiWriter_ )
    w.text &= !"\n"
    w.atLineStart = true
    w.lineNo += 1
    w.prevTok = -1
end sub

'' AT THE START OF AN OUTPUT LINE, the '#line' that puts token i where the module wrote
'' it -- when the line in hand no longer does. A token a header's macro wrote has no line
'' in the module to be put on.
private sub Settle_( byref w as TkiWriter_, byval i as int32 )
    if w.atLineStart = false then return
    if InModule_( w, i ) = false then return
    dim as Tko.DecodedLoc d = w.ctx->sources.Decode( (*w.toks)[i].loc )
    if (cast( uint32, d.file ) = w.lineFile) andalso (d.lineNo = w.lineNo) then return
    '' fbc's '#line N' numbers ITS OWN line N, so the line after it is N + 1.
    w.text &= "#line " & (d.lineNo - 1) & " """ & w.ctx->sources.AbsPathOf( d.file ) & """" & !"\n"
    w.lineFile = cast( uint32, d.file )
    w.lineNo = d.lineNo
end sub

'' 'esc.Url', where esc is an import's alias: '__tko_mod_acme_text_esc.Url'.
private function Rewritten_( byref w as TkiWriter_, byval i as int32 ) as string
    dim as string sp = Tko.PpSpell( w.ctx->sources, w.ctx->names, w.ctx->ppLits, (*w.toks)[i] )
    if len( w.qual[i] ) > 0 then
        if Kind_( w, i - 1 ) <> Tko.TK_DOT then return w.qual[i] & "." & sp
    end if
    if w.aliases->Count = 0 then return sp
    if Kind_( w, i ) <> Tko.TK_IDENT then return sp
    if Kind_( w, i + 1 ) <> Tko.TK_DOT then return sp
    if Kind_( w, i - 1 ) = Tko.TK_DOT then return sp
    dim as string low = Tko.Text.LowerAscii( sp )
    for k as int32 = 0 to w.aliases->Count - 1
        if (*w.aliases)[k] = low then return (*w.spaces)[k]
    next
    return sp
end function

'' ONE TOKEN, spaced so it re-lexes as itself: tokens the source wrote side by side stay
'' side by side -- the lexer split them once and will again -- and everything else gets a
'' space, which never joins two tokens into one.
private sub Tok_( byref w as TkiWriter_, byval i as int32 )
    dim as Tko.Token ptr t = @(*w.toks)[i]
    if w.atLineStart then
        Settle_( w, i )
        w.atLineStart = false
    else
        dim as boolean tight = false
        if w.prevTok >= 0 then
            dim as Tko.Token ptr pt = @(*w.toks)[w.prevTok]
            dim as uint16 madeUp = Tko.TF_FROM_MACRO or Tko.TF_SYNTHESISED
            if ((t->flags or pt->flags) and madeUp) = 0 then
                if (t->flags and Tko.TF_SPACE_BEFORE) = 0 then
                    dim as Tko.DecodedLoc a = w.ctx->sources.Decode( pt->loc )
                    dim as Tko.DecodedLoc b = w.ctx->sources.Decode( t->loc )
                    tight = (a.file = b.file) andalso (a.offset + cast( int32, pt->length ) = b.offset)
                end if
            end if
        end if
        if tight = false then w.text &= " "
    end if
    if Kind_( w, i ) = Tko.TK_EOL then
        w.text &= ":"
    else
        w.text &= Rewritten_( w, i )
    end if
    w.emitted[i] = 1
    w.prevTok = i
end sub

'' Tokens a..b-1, a real end of line breaking the output line and a ':' kept as one. A
'' trailing end of line is written as the chunk's own.
private sub Chunk_( byref w as TkiWriter_, byval a as int32, byval b as int32 )
    dim as int32 e = b
    while (e > a) andalso (Kind_( w, e - 1 ) = Tko.TK_EOL)
        e -= 1
    wend
    for i as int32 = a to e - 1
        dim as boolean realEol = (Kind_( w, i ) = Tko.TK_EOL) andalso _
                                 (((*w.toks)[i].flags and Tko.TF_COLON) = 0)
        if realEol then
            NewLine_( w )
        else
            Tok_( w, i )
        end if
    next
    if w.atLineStart = false then NewLine_( w )
end sub

private sub Word_( byref w as TkiWriter_, byref s as string )
    if w.atLineStart = false then w.text &= " "
    w.text &= s
    w.atLineStart = false
    w.prevTok = -1
end sub

'' THE SCOPE A DECLARATION'S NAME LANDS IN. A node that opens a scope of its own -- a
'' type, a namespace -- records that one, and its name is declared in the one around it.
private function DeclScope_( byref w as TkiWriter_, byval n as Tko.NodeId ) as Tko.ScopeId
    dim as Tko.ScopeId sc = w.info->ScopeOf( n )
    dim as Tko.SymScope ptr os = w.syms->ScopeAt( sc )
    if os = nullptr then return sc
    dim as Tko.Symbol ptr ow = w.syms->SymbolAt( os->owner )
    if ow = nullptr then return sc
    dim as Tko.StmtPayload ptr sp = w.ast->StmtOf( n )
    if ow->name = sp->name then return os->parent
    return sc
end function

'' AT THIS LEVEL, and not in a block of the module's top-level code: a 'scope' or an 'if'
'' there declares into a scope of its own, which no importer can reach.
private function AtLevel_( byref w as TkiWriter_, byval n as Tko.NodeId, byval sc as Tko.ScopeId ) as boolean
    dim as Tko.ScopeId ds = DeclScope_( w, n )
    if ds = Tko.SCOPE_NONE then return true
    return ds = sc
end function

'' IS THE PROCEDURE WHOSE HEADER IS a..b-1 GENERIC -- its OWN type parameters, 'f( of T )( ... )'
'' or 'Box( of T ).Get( )'? Only the FIRST parenthesis can say so: a name's '( of' comes
'' before the parameter list, and anything later -- 'byref m as FB.Map( of string, long )',
'' 'as Array( of long )' -- is a generic INSTANCE in a non-generic signature. Taking one of
'' those for the procedure's own made it "generic": its body went into the interface, the
'' importer defined it again, and the link failed on a duplicate symbol.
private function HasTypeParams_( byref w as TkiWriter_, byval a as int32, byval b as int32 ) as boolean
    for i as int32 = a to b - 1
        select case Kind_( w, i )
        case Tko.KW_AS
            return false
        case Tko.TK_LPAREN
            if Kind_( w, i + 1 ) <> Tko.TK_IDENT then return false
            '' 'of' is no keyword: the word after the parenthesis is.
            return Tko.Text.LowerAscii( w.ctx->names.Spelling( _
                cast( Tko.InternId, (*w.toks)[i + 1].literal ) ) ) = "of"
        end select
    next
    return false
end function

'' 'sub f( ) constructor' is the module's initialiser, not something to call.
private function IsStructor_( byref w as TkiWriter_, byval a as int32, byval b as int32 ) as boolean
    dim as int32 depth = 0
    for i as int32 = a + 1 to b - 1
        select case Kind_( w, i )
        case Tko.TK_LPAREN : depth += 1
        case Tko.TK_RPAREN : depth -= 1
        case Tko.KW_CONSTRUCTOR, Tko.KW_DESTRUCTOR
            if depth = 0 then return true
        end select
    next
    return false
end function

'' A PROCEDURE DEFINITION'S HEADER, as a declaration: tokens kw..hEnd-1 after 'declare',
'' less the words a declaration does not take -- 'static' and 'export'.
private sub DeclareHeader_( byref w as TkiWriter_, byval s as int32, byval kw as int32, byval hEnd as int32 )
    Settle_( w, s )
    if kw > s then Tok_( w, s )
    Word_( w, "declare" )
    Tok_( w, kw )
    dim as int32 depth = 0
    for i as int32 = kw + 1 to hEnd - 1
        dim as Tko.TokenKind k = Kind_( w, i )
        if k = Tko.TK_LPAREN then depth += 1
        if k = Tko.TK_RPAREN then depth -= 1
        if (depth = 0) andalso ((k = Tko.KW_STATIC) orelse (k = Tko.KW_EXPORT)) then continue for
        Tok_( w, i )
    next
    NewLine_( w )
end sub

private function VarLinkName_( byref w as TkiWriter_, byval sc as Tko.ScopeId, byval i as int32 ) as string
    dim as Tko.InternId nm = cast( Tko.InternId, (*w.toks)[i].literal )
    dim as Tko.SymbolId sid = w.syms->LookupLocal( sc, nm )
    while sid <> Tko.SYMBOL_NONE
        dim as Tko.Symbol ptr s = w.syms->SymbolAt( sid )
        if s = nullptr then exit while
        if s->kind = cast( uint8, Tko.SYM_VARIABLE ) then
            return Tko.Mangle.ModuleVarName( *w.syms, sid, w.ctx->names )
        end if
        sid = s->altClass
    wend
    return ""
end function

'' 'dim shared' AS AN EXTERN: each name followed by the alias it links by, and each
'' initialiser dropped -- the storage, and what it starts as, are the module's.
private sub SharedVar_( byref w as TkiWriter_, byval s as int32, byval kw as int32, _
                        byval e as int32, byval n as Tko.NodeId, byval sc as Tko.ScopeId )
    '' The names are the N_VAR_ITEMs', found by location.
    dim as containers.Array( of uint32 ) itemLocs
    dim as Tko.StmtPayload ptr sp = w.ast->StmtOf( n )
    for c as int32 = 0 to sp->count - 1
        dim as Tko.NodeId item = w.ast->ChildAt( sp->first, c )
        if w.ast->Kind( item ) = Tko.N_VAR_ITEM then itemLocs.Push( cast( uint32, w.ast->Loc( item ) ) )
    next

    dim as int32 stop_ = e
    while (stop_ > kw) andalso (Kind_( w, stop_ - 1 ) = Tko.TK_EOL)
        stop_ -= 1
    wend
    Settle_( w, s )
    if kw > s then Tok_( w, s )
    '' 'extern' takes the place of 'dim shared'.
    Word_( w, "extern" )
    dim as int32 depth = 0
    dim as boolean dropping = false
    dim as int32 i = kw + 2
    while i < stop_
        dim as Tko.TokenKind k = Kind_( w, i )
        if (k = Tko.TK_LPAREN) orelse (k = Tko.TK_LBRACE) then depth += 1
        if (k = Tko.TK_RPAREN) orelse (k = Tko.TK_RBRACE) then depth -= 1
        if depth = 0 then
            if (k = Tko.TK_EQ) orelse (k = Tko.TK_FATARROW) then dropping = true
            if k = Tko.TK_COMMA then dropping = false
        end if
        if dropping then
            i += 1
            continue while
        end if
        Tok_( w, i )
        dim as boolean isItem = false
        if k = Tko.TK_IDENT then
            for each l as uint32 in itemLocs
                if l = cast( uint32, (*w.toks)[i].loc ) then isItem = true
            next
        end if
        if isItem then
            dim as int32 nameTok = i
            '' ...after its dimensions, if it has them: 'x( 0 to 3 ) alias "..."'. A REDIM's are
            '' run-time sizes of a DYNAMIC array, exported as '( any [, any] )'.
            if (Kind_( w, i + 1 ) = Tko.TK_LPAREN) andalso (Kind_( w, kw ) = Tko.KW_REDIM) then
                dim as int32 rd = 0, rcomma = 0
                do
                    i += 1
                    if Kind_( w, i ) = Tko.TK_LPAREN then rd += 1
                    if Kind_( w, i ) = Tko.TK_RPAREN then rd -= 1
                    if (rd = 1) andalso (Kind_( w, i ) = Tko.TK_COMMA) then rcomma += 1
                loop until (rd = 0) orelse (i >= stop_ - 1)
                dim as string anyDims = "(any"
                for q as int32 = 1 to rcomma
                    anyDims &= ", any"
                next
                Word_( w, anyDims & ")" )
            elseif Kind_( w, i + 1 ) = Tko.TK_LPAREN then
                dim as int32 pd = 0
                do
                    i += 1
                    if Kind_( w, i ) = Tko.TK_LPAREN then pd += 1
                    if Kind_( w, i ) = Tko.TK_RPAREN then pd -= 1
                    Tok_( w, i )
                loop until (pd = 0) orelse (i >= stop_ - 1)
            end if
            dim as string ln = VarLinkName_( w, sc, nameTok )
            if len( ln ) > 0 then Word_( w, "alias """ & ln & """" )
        end if
        i += 1
    wend
    NewLine_( w )
end sub

declare sub Level_( byref w as TkiWriter_, byref i as int32, byval sc as Tko.ScopeId, _
                    byval closer as Tko.TokenKind )

'' A BLOCK OF DECLARATIONS -- a namespace, or an 'extern "C"' -- written as its header, what
'' is chosen from inside it, and its end.
private sub Block_( byref w as TkiWriter_, byval s as int32, byval sc as Tko.ScopeId, _
                    byval closer as Tko.TokenKind )
    dim as int32 hEnd = StmtEnd_( w, s )
    '' The scope a namespace opens, down a dotted name: 'namespace a.b'. An extern block
    '' opens none.
    dim as Tko.ScopeId inner = sc
    for j as int32 = s + 1 to hEnd - 1
        if closer <> Tko.KW_NAMESPACE then exit for
        if Kind_( w, j ) <> Tko.TK_IDENT then continue for
        dim as Tko.SymbolId sid = w.syms->LookupLocal( inner, cast( Tko.InternId, (*w.toks)[j].literal ) )
        dim as Tko.Symbol ptr ns = w.syms->SymbolAt( sid )
        while (ns <> nullptr) andalso (ns->kind <> cast( uint8, Tko.SYM_NAMESPACE ))
            ns = w.syms->SymbolAt( ns->altClass )
        wend
        if ns = nullptr then return
        inner = ns->inner
    next
    Chunk_( w, s, hEnd )
    dim as int32 i = hEnd + 1
    Level_( w, i, inner, closer )
    Word_( w, "end " & Tko.Text.LowerAscii( Tko.TokenKindText( closer ) ) )
    NewLine_( w )
end sub

private sub Declaration_( byref w as TkiWriter_, byval s as int32, byval e as int32, byval sc as Tko.ScopeId )
    dim as Tko.NodeId n = cast( Tko.NodeId, w.nodeAt[s] )
    dim as int32 kw = s
    dim as Tko.TokenKind vis = Kind_( w, s )
    if (vis = Tko.KW_PUBLIC) orelse (vis = Tko.KW_PRIVATE) then kw += 1
    if vis = Tko.KW_PRIVATE then return
    dim as int32 hEnd = StmtEnd_( w, s )

    select case Kind_( w, kw )
    case Tko.KW_SUB, Tko.KW_FUNCTION, Tko.KW_PROPERTY, Tko.KW_OPERATOR, _
         Tko.KW_CONSTRUCTOR, Tko.KW_DESTRUCTOR
        if HasTypeParams_( w, kw, hEnd ) then
            Chunk_( w, s, e )
            return
        end if
        '' A MEMBER DEFINED OUT OF LINE: the type's declaration already carries it. A
        '' property, a constructor and a destructor are never anything else here.
        select case Kind_( w, kw )
        case Tko.KW_PROPERTY, Tko.KW_CONSTRUCTOR, Tko.KW_DESTRUCTOR
            return
        end select
        if Kind_( w, kw + 2 ) = Tko.TK_DOT then return
        if IsStructor_( w, kw, hEnd ) then return
        if w.firstSight[cast( int32, n )] = 0 then return
        DeclareHeader_( w, s, kw, hEnd )

    case Tko.KW_EXTERN
        if Kind_( w, kw + 1 ) = Tko.TK_STRING_LIT then
            Block_( w, s, sc, Tko.KW_EXTERN )
        else
            Chunk_( w, s, e )
        end if

    case Tko.KW_DECLARE
        Chunk_( w, s, e )

    case Tko.KW_TYPE, Tko.KW_UNION, Tko.KW_ENUM, Tko.KW_CONST, Tko.KW_CLASS
        if AtLevel_( w, n, sc ) then Chunk_( w, s, e )

    case Tko.TK_IDENT
        '' 'interface I ... end interface' (docs/tiko-interfaces): a contextual word, so the
        '' node says what the line is.
        '' ...and so is 'partial type' or 'partial class', EVERY part: the importer's parser pools them.
        if (w.ast->Kind( n ) = Tko.N_INTERFACE) orelse _
           ((w.ast->Kind( n ) = Tko.N_TYPE) andalso ((w.ast->Flags( n ) and Tko.NF_PARTIAL_TYPE) <> 0)) then
            if AtLevel_( w, n, sc ) then Chunk_( w, s, e )
        end if

    case Tko.KW_DIM, Tko.KW_STATIC, Tko.KW_REDIM
        '' ...AND 'public redim shared A( any )', which is a dim shared of a dynamic array: it was
        '' never written, and an importer's 'A' was TKO0743 (tiko-editor TE-003).
        if Kind_( w, kw + 1 ) <> Tko.KW_SHARED then return
        if w.ast->Kind( n ) <> Tko.N_VAR then return
        if AtLevel_( w, n, sc ) = false then return
        SharedVar_( w, s, kw, e, n, sc )

    case Tko.KW_NAMESPACE
        Block_( w, s, sc, Tko.KW_NAMESPACE )
    end select
end sub

'' A GENERIC PROCEDURE OR MEMBER BODY, written whole. It goes at the END of its level: the
'' module may have written 'sub Box( of T ).Get( )' above 'type Box', which its unit takes
'' (RFC-0003 §5), and an importer collects the interface in order, so the type must come
'' first there.
private function GenericBody_( byref w as TkiWriter_, byval s as int32 ) as boolean
    dim as int32 kw = s
    dim as Tko.TokenKind vis = Kind_( w, s )
    if vis = Tko.KW_PRIVATE then return false
    if vis = Tko.KW_PUBLIC then kw += 1
    '' A CONST MEMBER is spelled 'const function Box( of T ).IsOpen( )', and read from its
    '' first word it was a 'const' declaration: Declaration_ found it at no level of its
    '' own and dropped it, so an importer instantiated nothing -- a call linked to the
    '' generic's own symbol and 'for each' found no GetIterator( ) (TKO0606).
    if Kind_( w, kw ) = Tko.KW_CONST then kw += 1
    select case Kind_( w, kw )
    case Tko.KW_SUB, Tko.KW_FUNCTION, Tko.KW_PROPERTY, Tko.KW_OPERATOR, _
         Tko.KW_CONSTRUCTOR, Tko.KW_DESTRUCTOR
    case else
        return false
    end select
    return HasTypeParams_( w, kw, StmtEnd_( w, s ) )
end function

'' One level's statements, from i to the end of the unit or, in a block, to its 'end' --
'' where i is left pointing past it.
sub Level_( byref w as TkiWriter_, byref i as int32, byval sc as Tko.ScopeId, _
            byval closer as Tko.TokenKind )
    dim as containers.Array( of int32 ) later
    while i < w.toks->Count
        dim as Tko.TokenKind k = Kind_( w, i )
        if k = Tko.TK_EOF then exit while
        if k = Tko.TK_EOL then
            i += 1
            continue while
        end if
        if (closer <> 0) andalso (k = Tko.KW_END) andalso (Kind_( w, i + 1 ) = closer) then
            i = StmtEnd_( w, i ) + 1
            exit while
        end if
        dim as int32 e = w.endAt[i]
        if e <= i then
            i = StmtEnd_( w, i ) + 1
            continue while
        end if
        '' AN AUTO-PROPERTY'S SYNTHESISED BODY (parser/autoprop.tiko) is never written: the TYPE
        '' carries its accessor clause verbatim, and the importer writes its own bodies from it.
        if ((*w.toks)[i].flags and Tko.TF_AUTOPROP) <> 0 then
            i = e
            continue while
        end if
        if InModule_( w, i ) then
            if GenericBody_( w, i ) then
                later.Push( i )
                later.Push( e )
            else
                Declaration_( w, i, e, sc )
            end if
        end if
        i = e
    wend
    for k as int32 = 0 to later.Count - 2 step 2
        Chunk_( w, later[k], later[k + 1] )
    next
end sub

'' ONE EXPORTED MACRO'S BODY TOKENS, first..first+count-1, spelled for an importer
'' (RFC-0004 §6). HYGIENE: a name the module declares at module level, not written after a
'' '.', is qualified with the module's own namespace -- '__tko_mod_acme_x.Fail_' -- so it
'' means the module's name wherever the macro expands, and no local of the importer's
'' captures it; the importer reaches it through that namespace, which no lookup filters.
'' A parameter, and any other name, is left as written: a macro meant to name its caller's
'' variable still does. An import alias followed by '.' becomes that module's namespace, as
'' in declarations.
private function MacroBody_ _
    ( byref w as TkiWriter_, byref pr as Tko.PpResult, byval k as int32 ) as string
    dim as string outp = ""
    dim as int32 first_ = cast( int32, pr.expBodyFirst[k] )
    dim as int32 count_ = cast( int32, pr.expBodyCount[k] )
    dim as Tko.ScopeId modScope = Tko.ModSym.ModuleScope( *w.syms )
    dim as string ns = InterfaceNamespace( w.ctx->unit.modChain )
    dim as int32 prev = -1
    for i as int32 = first_ to first_ + count_ - 1
        dim as Tko.Token ptr t = @pr.expBody[i]
        dim as Tko.TokenKind tk = cast( Tko.TokenKind, t->kind )
        dim as boolean realEol = (tk = Tko.TK_EOL) andalso ((t->flags and Tko.TF_COLON) = 0)
        if realEol then
            outp &= !"\n"
            prev = -1
            continue for
        end if
        '' Spaced as the source had it: tokens written side by side stay so -- '#x', '##'.
        if prev >= 0 then
            dim as boolean tight = false
            if (t->flags and Tko.TF_SPACE_BEFORE) = 0 then
                dim as Tko.DecodedLoc a = w.ctx->sources.Decode( pr.expBody[prev].loc )
                dim as Tko.DecodedLoc b = w.ctx->sources.Decode( t->loc )
                tight = (a.file = b.file) andalso (a.offset + cast( int32, pr.expBody[prev].length ) = b.offset)
            end if
            if tight = false then outp &= " "
        end if
        dim as string sp = Tko.PpSpell( w.ctx->sources, w.ctx->names, w.ctx->ppLits, *t )
        if tk = Tko.TK_IDENT then
            dim as boolean isParam = false
            for q as int32 = 0 to cast( int32, pr.expParamCount[k] ) - 1
                if pr.expParams[pr.expParamFirst[k] + q] = t->literal then isParam = true
            next
            dim as boolean afterDot = false
            if i > first_ then afterDot = (cast( Tko.TokenKind, pr.expBody[i - 1].kind ) = Tko.TK_DOT)
            dim as boolean beforeDot = false
            if i < first_ + count_ - 1 then beforeDot = (cast( Tko.TokenKind, pr.expBody[i + 1].kind ) = Tko.TK_DOT)
            if (isParam = false) andalso (afterDot = false) then
                dim as string low = Tko.Text.LowerAscii( sp )
                dim as boolean done_ = false
                if beforeDot then
                    for a as int32 = 0 to w.aliases->Count - 1
                        if (*w.aliases)[a] = low then
                            sp = (*w.spaces)[a]
                            done_ = true
                        end if
                    next
                end if
                if done_ = false then
                    dim as Tko.Symbol ptr s = w.syms->SymbolAt( w.syms->LookupLocal( modScope, cast( Tko.InternId, t->literal ) ) )
                    if s <> nullptr then
                        if (s->flags and Tko.SYMF_MODSRC) <> 0 then sp = ns & "." & sp
                    end if
                end if
            end if
        end if
        outp &= sp
        prev = i
    next
    return outp
end function

'' THE MACROS THE MODULE '#export's, each under its interface name (PpModMacroName), which
'' only 'alias.NAME' in an importer expands.
private function ExportedMacros_( byref w as TkiWriter_, byref pr as Tko.PpResult ) as string
    dim as string r = ""
    for k as int32 = 0 to pr.expName.Count - 1
        dim as uint32 fl = pr.expFlags[k]
        dim as string head = Tko.PpModMacroName( w.ctx->unit.modChain, pr.expName[k] )
        if (fl and 1) <> 0 then
            head &= "("
            dim as int32 pc = cast( int32, pr.expParamCount[k] )
            for q as int32 = 0 to pc - 1
                if q > 0 then head &= ", "
                head &= w.ctx->names.Spelling( cast( Tko.InternId, pr.expParams[pr.expParamFirst[k] + q] ) )
                if ((fl and 4) <> 0) andalso (q = pc - 1) then head &= "..."
            next
            head &= ")"
        end if
        dim as string body = MacroBody_( w, pr, k )
        if (fl and 2) <> 0 then
            r &= "#macro " & head & !"\n" & body & !"\n" & "#endmacro" & !"\n"
        else
            r &= "#define " & head & " " & body & !"\n"
        end if
    next
    return r
end function

'' ------------------------------------------------ a name a 'using' reached, qualified
''
'' A MODULE FILE'S 'using' STAYS IN THE MODULE. 'using core' followed by 'declare function
'' F( byref v as DVARIANT )' resolves DVARIANT through the using, but the interface does not
'' repeat the using -- inside the interface's namespace it would let 'com.DVARIANT' find
'' core's name through com, which M16 forbids -- so the importer read a bare DVARIANT and
'' reported it undeclared (fbx/com, 2026-09-29). Such a name is written with the path it
'' needs instead: '__tko_mod_fbx_core.DVARIANT', or 'ns.Inner' after 'using ns'.

private function Encloses_ _
    ( byref w as TkiWriter_, byval outer as Tko.ScopeId, byval inner as Tko.ScopeId ) as boolean
    dim as int32 guard = 0
    while (inner <> Tko.SCOPE_NONE) andalso (guard < Tko.SCOPE_WALK_MAX)
        guard += 1
        if inner = outer then return true
        dim as Tko.SymScope ptr s = w.syms->ScopeAt( inner )
        if s = nullptr then exit while
        inner = s->parent
    wend
    return false
end function

'' The namespace an importer names an imported module's scope by, or "".
private function ImportSpace_( byref w as TkiWriter_, byval owner as Tko.SymbolId ) as string
    for k as int32 = 0 to w.syms->importNs.Count - 1
        if w.syms->importNs[k] = cast( uint32, owner ) then
            return InterfaceNamespace( w.syms->importChains[k] )
        end if
    next
    dim as Tko.Symbol ptr o = w.syms->SymbolAt( owner )
    if o = nullptr then return ""
    dim as string low = Tko.Text.LowerAscii( w.ctx->names.Spelling( o->name ) )
    for k as int32 = 0 to w.aliases->Count - 1
        if (*w.aliases)[k] = low then return (*w.spaces)[k]
    next
    return ""
end function

'' The path symbol 'sid' needs, named from scope 'from_': "" when it is visible there as it is.
private function Qualifier_ _
    ( byref w as TkiWriter_, byval sid as Tko.SymbolId, byval from_ as Tko.ScopeId ) as string
    dim as Tko.Symbol ptr s = w.syms->SymbolAt( sid )
    if s = nullptr then return ""
    select case cast( Tko.SymbolKind, s->kind )
    case Tko.SYM_UDT, Tko.SYM_ENUM, Tko.SYM_TYPEDEF, Tko.SYM_CONSTANT, Tko.SYM_ENUMCONST, _
         Tko.SYM_PROC, Tko.SYM_VARIABLE, Tko.SYM_NAMESPACE
    case else
        return ""
    end select
    dim as string path = ""
    dim as Tko.ScopeId sc = s->parent
    dim as int32 guard = 0
    while (sc <> Tko.SCOPE_NONE) andalso (guard < 64)
        guard += 1
        dim as Tko.SymScope ptr ss = w.syms->ScopeAt( sc )
        if ss = nullptr then return ""
        dim as Tko.Symbol ptr ow = w.syms->SymbolAt( ss->owner )
        select case cast( Tko.ScopeKind, ss->kind )
        case Tko.SCOPEK_GLOBAL, Tko.SCOPEK_MODULE
            exit while
        case Tko.SCOPEK_NAMESPACE
            if Encloses_( w, sc, from_ ) then exit while
            if ow = nullptr then return ""
            dim as string isp = ImportSpace_( w, ss->owner )
            if len( isp ) > 0 then return isp & iif( len( path ) > 0, ".", "" ) & path
            dim as string nm = w.ctx->names.Spelling( ow->name )
            path = nm & iif( len( path ) > 0, ".", "" ) & path
        case Tko.SCOPEK_TYPE
            '' An enum's constant is also its enclosing scope's name; a type's member is not
            '' written qualified at all.
            if ow = nullptr then return ""
            if ow->kind <> cast( uint8, Tko.SYM_ENUM ) then return ""
        case else
            return ""
        end select
        sc = ss->parent
    wend
    return path
end function

private function TokAt_( byref w as TkiWriter_, byval loc as uint32 ) as int32
    if w.hmask = 0 then return -1
    dim as uint32 h = (loc * 2654435761UL) and cast( uint32, w.hmask )
    while w.hkey[h] <> 0
        if w.hkey[h] = loc + 1 then return w.hval[h]
        h = (h + 1) and cast( uint32, w.hmask )
    wend
    return -1
end function

private sub Qualify_( byref w as TkiWriter_ )
    dim as int32 n = 0
    for i as int32 = 0 to w.toks->Count - 1
        w.qual.Push( "" )
        if w.endAt[i] > i then n += w.endAt[i] - i
    next
    dim as int32 sz = 16
    while sz < n * 2
        sz *= 2
    wend
    w.hmask = sz - 1
    for i as int32 = 0 to sz - 1
        w.hkey.Push( 0 )
        w.hval.Push( 0 )
        w.hlast.Push( -1 )
    next
    '' A token in two declarations' ranges is chained once: twice would close a cycle.
    dim as containers.Array( of uint8 ) chained
    for i as int32 = 0 to w.toks->Count - 1
        w.locNext.Push( -1 )
        chained.Push( 0 )
    next
    for a as int32 = 0 to w.toks->Count - 1
        for i as int32 = a to w.endAt[a] - 1
            if chained[i] <> 0 then continue for
            chained[i] = 1
            dim as uint32 loc = cast( uint32, (*w.toks)[i].loc )
            dim as uint32 h = (loc * 2654435761UL) and cast( uint32, w.hmask )
            while (w.hkey[h] <> 0) andalso (w.hkey[h] <> loc + 1)
                h = (h + 1) and cast( uint32, w.hmask )
            wend
            if w.hkey[h] = 0 then
                w.hkey[h] = loc + 1
                w.hval[h] = i
                w.hlast[h] = i
            else
                w.locNext[w.hlast[h]] = i
                w.hlast[h] = i
            end if
        next
    next
    for id as int32 = 1 to w.ast->Count( )
        dim as Tko.NodeId nd = cast( Tko.NodeId, id )
        dim as Tko.InternId nm = Tko.INTERN_NONE
        select case w.ast->Kind( nd )
        case Tko.N_TYPEREF
            dim as Tko.StmtPayload ptr tp = w.ast->StmtOf( id )
            if tp->ownerName <> Tko.INTERN_NONE then continue for
            nm = tp->name
        case Tko.N_IDENT
            nm = w.ast->IdentOf( id )->name
        case else
            continue for
        end select
        if nm = Tko.INTERN_NONE then continue for
        dim as Tko.SymbolId sid = w.info->RefOf( nd )
        dim as Tko.ScopeId from_ = w.info->ScopeOf( nd )
        '' A PARAMETER'S DEFAULT is bound at each call, not where it is written, so its names
        '' carry no binding here: looked up from the declaration's scope, usings and all.
        '' ...AND AN INSTANTIATION, 'Array( of string )', is typed with its instance and bound
        '' to nothing (ResolveTypeRefAt_ returns before SetRef), so after 'using FB' the
        '' generic it names is looked up the same way: the importer has no 'using'.
        if sid = Tko.SYMBOL_NONE then
            dim as Tko.ScopeId look = from_
            if look = Tko.SCOPE_NONE then look = Tko.ModSym.ModuleScope( *w.syms )
            if w.ast->Kind( nd ) = Tko.N_IDENT then
                sid = w.syms->Lookup( look, w.ctx->names.Fold( nm ) )
            elseif w.ast->StmtOf( id )->count > 0 then
                sid = w.syms->LookupTyped( look, w.ctx->names.Fold( nm ), true )
            end if
        end if
        if sid = Tko.SYMBOL_NONE then continue for
        dim as string q = Qualifier_( w, sid, from_ )
        if len( q ) = 0 then continue for
        dim as int32 t = TokAt_( w, cast( uint32, w.ast->Loc( nd ) ) )
        if t < 0 then continue for
        '' The node starts at its first token -- 'const', '..' -- and the name is a few on.
        dim as string want = Tko.Text.LowerAscii( w.ctx->names.Spelling( nm ) )
        for j as int32 = t to t + 6
            if Kind_( w, j ) <> Tko.TK_IDENT then continue for
            dim as string sp = Tko.PpSpell( w.ctx->sources, w.ctx->names, w.ctx->ppLits, (*w.toks)[j] )
            if Tko.Text.LowerAscii( sp ) = want then
                dim as int32 k = j
                while k >= 0
                    w.qual[k] = q
                    k = w.locNext[k]
                wend
                exit for
            end if
        next
    next
end sub

private sub AddUse_( byref w as TkiWriter_, byref used as Tko.StrVec, byref c as string )
    if w.usedSeen.Add( c ) = false then return
    used.Push( c )
end sub

private sub PubUseOf_( byref w as TkiWriter_, byref pr as Tko.PpResult, _
                       byval q as Tko.Symbol ptr, byref used as Tko.StrVec )
    if q = nullptr then return
    dim as uint32 qf = cast( uint32, w.ctx->sources.Decode( q->loc ).file )
    dim as int32 k = -1
    if w.pubHdrAt.TryGet( qf, k ) then AddUse_( w, used, pr.pubHdrChain[k] )
end sub

'' WHICH IMPORTED MODULE'S PUBLIC HEADER a written name comes from, if any: added to used.
'' The symbol the name resolved to says, by its file; for a type reference, so does the name
'' looked up as a type -- a vendor module's alias is often its type's name too ('sqlite3',
'' 'cJSON'), and is found first. A type reference that resolves to nothing is an opaque one: c2t's
'' 'type sqlite3__fwd as sqlite3' declares nothing while the import's alias holds the name
'' (ForwardTypedefTarget_), so nothing says whose it is, and every such header is used.
private sub PubUses_ _
    ( byref w as TkiWriter_, byref pr as Tko.PpResult, byval nd as Tko.NodeId, _
      byval nm as Tko.InternId, byval s as Tko.Symbol ptr, byref used as Tko.StrVec )
    if pr.pubHdrFile.Count = 0 then return
    PubUseOf_( w, pr, s, used )
    if w.ast->Kind( nd ) <> Tko.N_TYPEREF then return
    if nm = Tko.INTERN_NONE then return
    dim as Tko.ScopeId tl = w.info->ScopeOf( nd )
    if tl = Tko.SCOPE_NONE then tl = Tko.ModSym.ModuleScope( *w.syms )
    dim as Tko.Symbol ptr ts = w.syms->SymbolAt( w.syms->LookupTyped( tl, w.ctx->names.Fold( nm ), true ) )
    if ts <> nullptr then
        select case ts->kind
        case cast( uint8, Tko.SYM_UDT ), cast( uint8, Tko.SYM_TYPEDEF ), cast( uint8, Tko.SYM_ENUM )
            PubUseOf_( w, pr, ts, used )
            return
        end select
    end if
    '' A builtin -- 'long' -- has no symbol either, but has a type.
    if w.info->TypeOf_( nd ) <> Tko.TYPE_NONE then return
    for each c as string in pr.pubHdrChain
        AddUse_( w, used, c )
    next
end sub

'' THE HEADERS THE INTERFACE NEEDS (RFC-0004 §3): those a written token names a symbol from,
'' where a symbol belongs to the header the module reached its file through. Every header
'' the module included used to travel, needed or not -- and a header-only library meant for
'' ONE unit, fbsqlite.bi, was then compiled into every importer too, its members defined
'' twice at the link (T91). An exported macro can name anything, so with one, all travel.
private function RequiredHeaders_ _
    ( byref w as TkiWriter_, byref headers as Tko.StrVec, byval pr as Tko.PpResult ptr, _
      byval allOf as boolean ) as string
    dim as containers.Array( of uint8 ) need, byName
    dim as boolean every = allOf orelse (pr = nullptr)
    dim as uint8 seed = iif( every, 1, 0 )
    for k as int32 = 0 to headers.Count - 1
        need.Push( seed )
        byName.Push( seed )
    next
    '' AN IMPORTED MODULE'S PUBLIC HEADERS this interface names something from: an importer
    '' must read them too, though it did not import that module itself. An exported macro
    '' can name anything, so with one, every such module is used.
    dim as Tko.StrVec used
    w.usedSeen.Clear( )
    if (pr <> nullptr) andalso allOf then
        for each c as string in pr->pubHdrChain
            AddUse_( w, used, c )
        next
    end if
    '' THE HEADERS BY FILE, first entry of each: a written name was a scan of both lists.
    dim as containers.Map( of uint32, int32 ) modHdrAt
    w.pubHdrAt.Clear( )
    if pr <> nullptr then
        for k as int32 = 0 to pr->modHdrFile.Count - 1
            modHdrAt.Add( pr->modHdrFile[k], k )
        next
        for k as int32 = 0 to pr->pubHdrFile.Count - 1
            w.pubHdrAt.Add( pr->pubHdrFile[k], k )
        next
    end if
    '' 'public #cinclude' (T101): those travel whatever the interface names.
    if pr <> nullptr then
        for each r as uint32 in pr->modHdrPublic
            if r < cast( uint32, need.Count ) then need[r] = 1
        next
    end if
    if every = false then
        for id as int32 = 1 to w.ast->Count( )
            dim as Tko.NodeId nd = cast( Tko.NodeId, id )
            dim as Tko.InternId nm = Tko.INTERN_NONE
            select case w.ast->Kind( nd )
            case Tko.N_TYPEREF
                nm = w.ast->StmtOf( id )->name
            case Tko.N_IDENT
                nm = w.ast->IdentOf( id )->name
            case else
                continue for
            end select
            dim as int32 t = TokAt_( w, cast( uint32, w.ast->Loc( nd ) ) )
            if t < 0 then continue for
            if w.emitted[t] = 0 then continue for
            dim as Tko.SymbolId sid = w.info->RefOf( nd )
            '' A generic's body is not bound until it is instantiated: its names are
            '' looked up from where they are written.
            if (sid = Tko.SYMBOL_NONE) andalso (nm <> Tko.INTERN_NONE) then
                dim as Tko.ScopeId look = w.info->ScopeOf( nd )
                if look = Tko.SCOPE_NONE then look = Tko.ModSym.ModuleScope( *w.syms )
                sid = w.syms->Lookup( look, w.ctx->names.Fold( nm ) )
            end if
            dim as Tko.Symbol ptr s = w.syms->SymbolAt( sid )
            PubUses_( w, *pr, nd, nm, s, used )
            if s = nullptr then continue for
            dim as uint32 f = cast( uint32, w.ctx->sources.Decode( s->loc ).file )
            dim as int32 k = -1
            if modHdrAt.TryGet( f, k ) then
                dim as int32 r = cast( int32, pr->modHdrRoot[k] )
                if (r >= 0) andalso (r < need.Count) then
                    need[r] = 1
                    byName[r] = 1
                end if
            end if
        next
    end if
    w.uses = ""
    for each c as string in used
        w.uses &= "'' uses " & c & !"\n"
    next
    '' A MODULE'S OWN HEADERS ARE HERMETIC (book ch14: importing a module never captures a name of
    '' yours). One under the module's package root that travels because the interface names
    '' something from it is read in the importer between '#tki hermetic' and '#tki park', and the
    '' macros its subtree defines there reach no further than the interfaces (ppmodhdr.tiko). A
    '' 'public #include' travels whole, macros and all: that is what it asks for.
    dim as containers.Array( of uint8 ) isPub
    for k as int32 = 0 to headers.Count - 1
        isPub.Push( 0 )
    next
    if pr <> nullptr then
        for each r as uint32 in pr->modHdrPublic
            if r < cast( uint32, isPub.Count ) then isPub[r] = 1
        next
    end if
    dim as string root = ""
    if len( w.ctx->unit.modPkgRoot ) > 0 then root = Tko.Text.LowerAscii( AbsPath( w.ctx->unit.modPkgRoot ) )
    if (len( root ) > 0) andalso (right( root, 1 ) <> "/") then root &= "/"
    dim as string res = ""
    for k as int32 = 0 to headers.Count - 1
        if need[k] = 0 then continue for
        dim as boolean herm = (len( root ) > 0) andalso (isPub[k] = 0)
        if herm then herm = (left( Tko.Text.LowerAscii( AbsPath( headers[k] ) ), len( root ) ) = root)
        '' A PUBLIC HEADER THE INTERFACE ITSELF NAMES NOTHING FROM is marked: an importer reads
        '' it only for a module it imported, or reached through 'public', or one an interface
        '' it reads uses (modiface.tiko). Otherwise its names would reach every program above.
        dim as boolean pubOnly = (byName[k] = 0)
        if pubOnly then res &= "'' tki-pub" & !"\n"
        if herm then res &= "#tki hermetic """ & root & """" & !"\n"
        '' A PUBLIC HEADER'S CONSULTED MACROS go round it, for the importer to hold its own
        '' against (src/pp/ppmodhdr.tiko; RFC-0002 V12).
        dim as string req = ""
        if pr <> nullptr then
            for c as int32 = 0 to pr->modConsRoot.Count - 1
                if cast( int32, pr->modConsRoot[c] ) <> k then continue for
                if len( pr->modConsText[c] ) = 0 then
                    req &= "#tki undef " & pr->modConsName[c] & !"\n"
                else
                    req &= "#tki define " & pr->modConsText[c] & !"\n"
                end if
            next
        end if
        if len( req ) > 0 then
            res &= "#tki require """ & w.ctx->unit.modChain & """ """ & headers[k] & """" & !"\n" & req
        end if
        res &= "#include once """ & headers[k] & """" & !"\n"
        if len( req ) > 0 then res &= "#tki end" & !"\n"
        if herm then res &= "#tki park" & !"\n"
        if pubOnly then res &= "'' tki-pub-end" & !"\n"
    next
    return res
end function

'' A PUBLIC OVERLOAD THAT JOINED A HEADER'S NAME (RFC-0001 F4): 'public function
'' GetWindowText overload( byval hWin as HWND ) as ustring' beside windows.bi's
'' three-argument one. At the module's top level the two are one set, and an importer has
'' to see one set too, so it reaches the module's member bare as well as qualified. One
'' '' joins <name>' line per such name, which BindImports reads. A set holding nothing
'' declared outside the module joined nothing; the prelude's names are left alone.
private function Joins_( byref w as TkiWriter_ ) as string
    dim as string r = ""
    dim as Tko.ScopeId ms = Tko.ModSym.ModuleScope( *w.syms )
    if ms = Tko.SCOPE_NONE then return r
    dim as containers.Set( of uint32 ) done_     '' the names joined so far
    for si as int32 = 1 to w.syms->Count( )
        dim as Tko.Symbol ptr ps = w.syms->SymbolAt( cast( Tko.SymbolId, si ) )
        if ps = nullptr then continue for
        if ps->kind <> cast( uint8, Tko.SYM_PROC ) then continue for
        if (ps->parent <> ms) orelse (ps->diedAt <> 0) then continue for
        if (ps->flags and Tko.SYMF_MODSRC) = 0 then continue for
        if (ps->flags and Tko.SYMF_PUBLIC) = 0 then continue for
        if (ps->flags and Tko.SYMF_OVERLOAD) = 0 then continue for
        if done_.Contains( cast( uint32, ps->name ) ) then continue for
        dim as Tko.SymbolId cur = w.syms->LookupLocal( ms, ps->name )
        dim as Tko.Symbol ptr hs = w.syms->SymbolAt( cur )
        if hs = nullptr then continue for
        if hs->kind <> cast( uint8, Tko.SYM_PROC ) then cur = hs->altClass
        dim as boolean joined = false
        dim as int32 guard = 0
        while (cur <> Tko.SYMBOL_NONE) andalso (guard < 100000)
            guard += 1
            dim as Tko.Symbol ptr os = w.syms->SymbolAt( cur )
            if os = nullptr then exit while
            if os->kind <> cast( uint8, Tko.SYM_PROC ) then exit while
            if ((os->flags and Tko.SYMF_MODSRC) = 0) andalso (os->diedAt = 0) then
                if w.ctx->sources.IsBuiltin( os->loc ) = false then joined = true
            end if
            cur = os->nextOverload
        wend
        if joined = false then continue for
        done_.Add( cast( uint32, ps->name ) )
        r &= "'' joins " & w.ctx->names.Spelling( ps->name ) & !"\n"
    next
    return r
end function

function WriteInterface _
    ( byref ctx as Tko.CompilerContext, byref toks as Tko.TokenVec, _
      byref ast as Tko.AstArena, byref syms as Tko.SymbolTable, _
      byref info as Tko.SemanticInfo, byref aliases as Tko.StrVec, _
      byref spaces as Tko.StrVec, byref headers as Tko.StrVec, _
      byval pr as Tko.PpResult ptr ) as string

    dim as TkiWriter_ w
    w.ctx = @ctx : w.toks = @toks : w.ast = @ast : w.syms = @syms : w.info = @info
    w.aliases = @aliases : w.spaces = @spaces
    w.atLineStart = true
    w.prevTok = -1
    for each m as uint32 in ctx.unit.modFiles
        while cast( uint32, w.modMark.Count ) <= m
            w.modMark.Push( 0 )
        wend
        w.modMark[m] = 1
    next
    for j as int32 = 0 to toks.Count - 1
        w.endAt.Push( 0 )
        w.nodeAt.Push( 0 )
        w.emitted.Push( 0 )
    next
    for j as int32 = 0 to ast.Count( )
        w.firstSight.Push( 0 )
    next
    for si as int32 = 1 to syms.Count( )
        dim as Tko.Symbol ptr ps = syms.SymbolAt( cast( Tko.SymbolId, si ) )
        if ps = nullptr then continue for
        if ps->kind <> cast( uint8, Tko.SYM_PROC ) then continue for
        dim as int32 pn = cast( int32, ps->payload )
        if (pn > 0) andalso (pn <= ast.Count( )) then w.firstSight[pn] = 1
    next
    '' ...AND AN OVERLOAD'S DEFINITION IS NOT ITS DECLARATION'S SECOND SIGHTING. OVERLOAD
    '' belongs to the name, so 'declare function F overload( ... )' and the 'function F
    '' overload( ... )' below it are two symbols of one signature in the chain, each the
    '' first sight of its own node -- and both were written, which an importer refused as
    '' TKO0677 (fbx/gui's fbxCWindowPtr). The definition is left out when a declaration of
    '' the same procedure type stands beside it.
    for si as int32 = 1 to syms.Count( )
        dim as Tko.Symbol ptr ps = syms.SymbolAt( cast( Tko.SymbolId, si ) )
        if ps = nullptr then continue for
        if ps->kind <> cast( uint8, Tko.SYM_PROC ) then continue for
        dim as int32 pn = cast( int32, ps->payload )
        if (pn <= 0) orelse (pn > ast.Count( )) then continue for
        if w.firstSight[pn] = 0 then continue for
        if ast.Kind( cast( Tko.NodeId, pn ) ) <> Tko.N_PROC then continue for
        if ast.StmtOf( pn )->b = Tko.NODE_NONE then continue for
        '' ...OF THE SAME SIGNATURE, by mangled name: 'type_' is only the RESULT, so a
        '' definition-only overload 'F( a )' beside 'declare F( a, b )' -- both long -- was taken
        '' for that declaration's definition and left out (ApexWealth AW-003).
        dim as string pmn = Tko.Mangle.ProcName( ast, cast( Tko.NodeId, pn ), syms, ctx.names, ctx.types, info )
        dim as Tko.SymbolId oid = syms.LookupLocal( ps->parent, ps->name )
        dim as int32 guard = 0
        while (oid <> Tko.SYMBOL_NONE) andalso (guard < 1000)
            guard += 1
            dim as Tko.Symbol ptr os = syms.SymbolAt( oid )
            if os = nullptr then exit while
            '' ...the MODULE'S OWN declaration: a header's one of the same result type --
            '' windows.bi's 'GetWindowRect', a LONG, beside the module's overload of it --
            '' is another procedure, and taking it for this one left the overload out.
            if (oid <> cast( Tko.SymbolId, si )) andalso (os->kind = cast( uint8, Tko.SYM_PROC )) _
               andalso (os->parent = ps->parent) andalso (os->type_ = ps->type_) _
               andalso ((os->flags and Tko.SYMF_MODSRC) <> 0) then
                dim as int32 on_ = cast( int32, os->payload )
                if (on_ > 0) andalso (on_ <= ast.Count( )) then
                    if ast.Kind( cast( Tko.NodeId, on_ ) ) = Tko.N_PROC then
                        if (ast.StmtOf( on_ )->b = Tko.NODE_NONE) andalso _
                           (Tko.Mangle.ProcName( ast, cast( Tko.NodeId, on_ ), syms, ctx.names, ctx.types, info ) = pmn) then
                            w.firstSight[pn] = 0
                            exit while
                        end if
                    end if
                end if
            end if
            oid = os->nextOverload
        wend
    next
    '' The OUTERMOST declaration at a token wins -- the longest range starting there.
    for r as int32 = 0 to ast.declRanges.Count - 3 step 3
        dim as int32 a = cast( int32, ast.declRanges[r + 1] )
        dim as int32 b = cast( int32, ast.declRanges[r + 2] )
        if (a < 0) orelse (a >= toks.Count) then continue for
        if b > w.endAt[a] then
            w.endAt[a] = b
            w.nodeAt[a] = cast( int32, ast.declRanges[r] )
        end if
    next

    Qualify_( w )

    dim as string macros = ""
    if pr <> nullptr then macros = ExportedMacros_( w, *pr )
    '' The declarations first: which headers travel depends on what they wrote.
    w.text = "namespace " & InterfaceNamespace( ctx.unit.modChain ) & !"\n"
    w.lineFile = 0
    dim as int32 i = 0
    Level_( w, i, Tko.ModSym.ModuleScope( syms ), 0 )
    w.text &= "end namespace" & !"\n"
    dim as string req = RequiredHeaders_( w, headers, pr, len( macros ) > 0 )
    return "'' tiko-interface 1" & !"\n" & "'' module " & ctx.unit.modChain & !"\n" & _
           w.uses & Joins_( w ) & req & macros & w.text
end function

end namespace
