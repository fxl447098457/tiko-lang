'' doc.ti -- a module's API documentation: the model, read from its interface and its comments,
'' and the pages written from it ('tiko doc', '--emit-doc'; docs/tiko-test-doc RFC-0001 §7).
''
'' THE INTERFACE IS THE SOURCE OF TRUTH for what is documented: the module's .tki text, which a
'' build has (a cache hit included) and which is the module's own tokens spelled back with
'' '#line' marks (tkiemit.tiko). So a signature in the documentation is the one the compiler
'' resolved, and the public filter is the one an importer sees: what is written 'public', at the
'' top level, and the public and protected members of a public type.
''
'' THE WORDS ARE THE COMMENTS ABOVE IT, read from the source file the '#line' names -- the lexer
'' keeps no comments. A declaration's documentation is the block of '' lines directly above it (a
'' blank line ends a block), else the block above its definition when the declaration has none;
'' a field's may be its line's trailing comment. The module's overview is the first block after
'' '#module' in the file named like the module. Divider lines ('' -----) are dropped; indented
'' lines stay indented, so a 4-space example is a code block in Markdown.

#pragma once

#include once "tko.ti"
#include once "driver/driver.ti"

namespace Tko.Doc

    '' THE SOURCE FILES READ for one module's documentation: each file's lines, end to end in one
    '' vector by start and count, read once (docsource.tiko); and the overview block of the last
    '' file Overview read, which the declaration directly below it does not take as its own.
    type DocSources
        as Tko.StrVec paths
        as Tko.StrVec lines
        as containers.Array( of int32 ) starts
        as containers.Array( of int32 ) counts
        as string ovPath
        as int32 ovFirst
        as int32 ovLast
    end type

    type DocSig
        as string text
        as string file_
        as int32 line_
    end type

    type DocMember
        as string kind           '' field method property constructor destructor operator const value
        as string name
        as string vis            '' public, protected
        as string doc
        as containers.Array( of DocSig ) sigs
    end type

    type DocItem
        as string kind           '' function sub operator property type class union interface enum
                                 '' const variable alias macro
        as string name
        as string nsPath         '' 'Detail' for a public namespace's member, else ""
        as string doc
        as string anchor
        as containers.Array( of DocSig ) sigs
        as containers.Array( of DocMember ) members
    end type

    type DocModule
        as string chain          '' std.strings
        as string importPath     '' std/strings
        as string name           '' strings
        as string dir_
        as string overview
        as Tko.StrVec files
        as containers.Array( of DocItem ) items
        as DocSources src
    end type

    '' The model of the module 'chain' in 'dir_' from its interface text.
    declare sub FromInterface _
        ( byref ctx as Tko.CompilerContext, byref iface as string, byref chain as string, _
          byref importPath as string, byref dir_ as string, byref outm as DocModule )

    '' --emit-doc: build the importer of 'dir_', then write its pages into 'outDir'.
    declare function EmitDoc( byref ctx as Tko.CompilerContext, byref dir_ as string, byref outDir as string ) as int32

    '' The pages: Markdown, HTML, the module's doc.json fragment, and its index lines --
    '' 'module <tab> chain <tab> import <tab> summary' then 'item <tab> kind <tab> name <tab> href
    '' <tab> summary' -- that 'tiko doc' builds the index and the search from.
    declare function Markdown( byref m as DocModule ) as string
    declare function Html( byref m as DocModule ) as string
    declare function JsonOf( byref m as DocModule ) as string
    declare function IndexLines( byref m as DocModule ) as string
    '' A whole HTML page: the shared style, the search box, 'body' inside.
    declare function Page( byref title as string, byref body as string, byref rootHref as string ) as string
    '' Documentation text as HTML: paragraphs, indented code, `code`, '- ' lists.
    declare function TextToHtml( byref t as string ) as string
    declare function HtmlEsc( byref s as string ) as string
    '' The first sentence of a text, on one line.
    declare function Summary( byref t as string ) as string

    '' THE SOURCE COMMENTS (docsource.tiko). The comment block directly above line 'line_' of the
    '' file, cleaned; "" when there is none. Lines numbered from 1.
    declare function DocAbove( byref src as DocSources, byref path_ as string, byval line_ as int32 ) as string
    '' The trailing '' comment of line 'line_', or "".
    declare function DocTrailing( byref src as DocSources, byref path_ as string, byval line_ as int32 ) as string
    '' The first comment block after '#module' in the file.
    declare function Overview( byref src as DocSources, byref path_ as string ) as string
    '' The documentation above the DEFINITION of 'qualName' ('Twice', 'TzRules.TryParse') in any
    '' of the files, for a declaration with none of its own.
    declare function DocOfDefinition( byref src as DocSources, byref files as Tko.StrVec, byref qualName as string ) as string
    '' The exported macros of the files: each '#define NAME( p )' / '#macro NAME( p )' that an
    '' '#export' line names, as 'name <tab> signature <tab> file <tab> line'.
    declare sub ExportedMacros( byref src as DocSources, byref files as Tko.StrVec, byref outv as Tko.StrVec )
    '' One line of a source file, or "" (cached per file for the run).
    declare function SourceLine( byref src as DocSources, byref path_ as string, byval line_ as int32 ) as string

end namespace
