'' cmdline.tiko -- see cmdline.ti

#import "std/containers"
#import "std/fs"
#include once "driver/cmdline.ti"
#include once "support/text.ti"

namespace Tko

dim shared as OptInfo optTable( 0 to OPT_COUNT - 1 )
dim shared as boolean optTableReady = false

sub InitOptTable( )
    if optTableReady then return

    optTable(OPT_NONE).spelling = @""
    optTable(OPT_NONE).kind = OPTK_FLAG
    optTable(OPT_NONE).category = OPTCAT_GENERAL
    optTable(OPT_NONE).argName = @""
    optTable(OPT_NONE).help = @""

    #macro OPT( o_id, o_spell, o_kind, o_cat, o_arg, o_help )
        optTable(o_id).spelling = @o_spell
        optTable(o_id).kind = o_kind
        optTable(o_id).category = o_cat
        optTable(o_id).argName = @o_arg
        optTable(o_id).help = @o_help
    #endmacro
    TKO_OPT_LIST( OPT )
    #undef OPT

    optTableReady = true
end sub

function OptInfoOf( byval id as OptId ) as OptInfo ptr
    InitOptTable( )
    dim as boolean bad = (id < 0) orelse (id >= OPT_COUNT)
    if bad then return @optTable(OPT_NONE)
    return @optTable(id)
end function

function CategoryName( byval c as OptCategory ) as string
    select case c
    case OPTCAT_INPUT  : return "Input"
    case OPTCAT_OUTPUT : return "Output"
    case OPTCAT_TARGET : return "Target"
    case OPTCAT_DIAG   : return "Diagnostics"
    case OPTCAT_CIMPORT: return "C header import"
    case OPTCAT_DEVEL  : return "Compiler development"
    case else          : return "General"
    end select
end function

constructor DriverOptions( )
    this.outputPath = ""
    this.exeOutputPath = ""
    this.targetName = ""
    this.target = Tko.HostTarget( )
    this.widthOverride = 0
    this.errFlags = 0
    this.outKind = Tko.OUT_EXE
    this.compileOnly = false
    this.debugInfo = false
    this.threadSafe = false
    this.guiSubsystem = false
    this.stackSize = 2097152
    this.optLevel = 0
    this.showHelp = false
    this.helpCategory = ""
    this.showVersion = false
    this.verbose = false
    this.warningsAsErrors = false
    this.fbcWarnMin = 0
    this.fbcWarnNone = false
    this.pic = false
    this.maxErrors = DIAG_DEFAULT_MAX_ERRORS
    this.maxInstDepth = 64
    this.colorMode = COLOR_AUTO
    this.diagFormat = DIAGFMT_FBC
    this.diagFile = ""
    this.pkgDir = ""
    this.dumpSource = false
    this.dumpTokens = false
    this.lexOnly = false
    this.ppOnly = false
    this.dumpPp = false
    this.dumpAst = false
    this.parseExpr = false
    this.parseOnly = false
    this.dumpTypes = false
    this.dumpSymbols = false
    this.dumpScan = false
    this.resolveOnly = false
    this.dumpIr = false
    this.dumpIrPreAbi = false
    this.verifySelfTest = false
    this.allowUnlowered = false
    this.emitIr = false
    this.emitAsm = false
    this.keepTemps = false
    this.stats = false
    this.timePasses = false
    this.dumpDecisions = false
    this.bootstrapCheck = false
end constructor

end namespace

namespace Tko.Cmdline

function VersionText( byref clangExe as string ) as string
    dim as string v = str( Tko.TKO_VERSION_MAJOR ) & "." & _
                      str( Tko.TKO_VERSION_MINOR ) & "." & _
                      str( Tko.TKO_VERSION_PATCH ) & Tko.TKO_VERSION_SUFFIX

    '' THE DEFAULT TARGET, asked rather than repeated. This said "win64" as a literal, so
    '' it kept saying so after the default became windows-x86_64 -- a version banner that
    '' names the wrong ABI is worse than one that names none. The name carries the
    '' architecture too, so no second, hard-coded "x86_64" goes stale on an arm64 host.
    dim as string os_ = Tko.TargetName( Tko.HostTarget( ) )

    dim as string outp = ""
    '' THE BINARY IS tiko: tiko-lang names the repository, not the program.
    outp += "tiko " & v & chr( 10 )
    outp += "target " & os_ & chr( 10 )
    '' THE THIRD LINE, so 'head -1' readers of the first (check-listings.sh) are untouched.
    if len( clangExe ) > 0 then
        outp += "llvm " & clangExe & chr( 10 )
    else
        outp += "llvm not found -- install LLVM 18 or newer, or set TIKO_CLANG" & chr( 10 )
    end if
    return outp
end function

function HelpText( byval category as string = "" ) as string
    Tko.InitOptTable( )

    dim as string want = Tko.Text.LowerAscii( trim( category ) )
    dim as boolean filtered = (len( want ) > 0)

    dim as string outp = ""
    outp += "usage: tiko [options] <inputs...>" & chr( 10 )
    outp += "       tiko <subcommand> [options] [<targets or roots...>]" & chr( 10 ) & chr( 10 )
    '' THE SUBCOMMANDS (src/build), listed so a tool can ask: tiko-editor-tiko looks for
    '' 'tiko build' here before it builds through it (tiko-build PLAN B6).
    if filtered = false then
        outp += "Subcommands:" & chr( 10 )
        outp += "  tiko build    build the targets of tiko.toml, or the roots given -- cached" & chr( 10 )
        outp += "  tiko clean    remove what 'tiko build' would write" & chr( 10 )
        outp += "  tiko metadata print the project as JSON: targets, profiles, modules" & chr( 10 )
        outp += "  tiko run      build one exe target, then run it with the arguments after --" & chr( 10 )
        outp += "  tiko check    every diagnostic a build would give, through lowering; nothing written" & chr( 10 )
        outp += "  (their options: --profile, --manifest, --options, -j, --message-format, --no-cache)" & chr( 10 )
        outp += "  tiko c2t      translate a C header into a tiko header: tiko c2t <in.h> [-o <out.ti>|-]" & chr( 10 ) & chr( 10 )
    end if

    for c as int32 = Tko.OPTCAT_GENERAL to Tko.OPTCAT_DEVEL
        dim as string catName = Tko.CategoryName( cast( Tko.OptCategory, c ) )
        dim as boolean skip = filtered andalso _
                              (instr( Tko.Text.LowerAscii( catName ), want ) = 0)
        if skip then continue for

        dim as string body = ""
        for i as int32 = 1 to Tko.OPT_COUNT - 1
            dim as Tko.OptInfo ptr info = Tko.OptInfoOf( cast( Tko.OptId, i ) )
            if info->category <> c then continue for

            dim as string spell = *info->spelling
            dim as string arg = *info->argName
            if len( arg ) > 0 then
                if info->kind = Tko.OPTK_JOINED then
                    spell += "<" & arg & ">"
                else
                    spell += " <" & arg & ">"
                end if
            end if
            while len( spell ) < 30
                spell += " "
            wend
            body += "  " & spell & *info->help & chr( 10 )
        next

        if len( body ) > 0 then
            outp += catName & ":" & chr( 10 ) & body & chr( 10 )
        end if
    next

    if filtered andalso (len( outp ) < 40) then
        outp += "  (no options in a category matching '" & category & "')" & chr( 10 )
    end if
    return outp
end function

'' Split "--opt=value" into its two halves. Returns false when there is no '='.
private function SplitEq _
    ( byval arg as string, byref lhs as string, byref rhs as string ) as boolean

    dim as int32 at = instr( arg, "=" )
    if at = 0 then return false
    lhs = left( arg, at - 1 )
    rhs = mid( arg, at + 1 )
    return true
end function

'' tiko-lang ships no headers of its own, and until this it searched no directory it had
'' not been given: '#include "vbcompat.bi"' failed where fbc compiles it clean. fbc's
'' search ends at <exe-dir>/inc, and 144 of the corpus's 145 include failures are that
'' one missing rule -- 17 of them parse completely clean once it is there.
''
'' Appended LAST, so every -i the user gave still wins, and only if the directory
'' actually exists: a search path that is not there costs a stat per include for
'' nothing. Both layouts are tried, because tiko-lang lives in bin/ and fbc does not:
''
''     <exe-dir>/inc        fbc's shape
''     <exe-dir>/../inc     tiko-lang's, with the exe in bin/
''
'' TIKO_INCLUDE overrides both, which is how a build with no bundled headers -- the
'' corpus runs, today -- points at a header set without every caller repeating -i.
private sub AppendDefaultIncludeDir( byref opts as Tko.DriverOptions )
    dim as ustring env_ = environ( "TIKO_INCLUDE" )
    if len( env_ ) > 0 then
        opts.includePaths.Push( env_ )
        return
    end if

    dim as ustring exeDir = exepath( )
    if len( exeDir ) = 0 then return

    dim as ustring cand = fs.PathJoin( exeDir, "inc" )
    if fs.IsDir( cand ) then
        opts.includePaths.Push( cand )
        return
    end if

    cand = fs.PathJoin( fs.PathParent( exeDir ), "inc" )
    if fs.IsDir( cand ) then opts.includePaths.Push( cand )
end sub

'' The library half of the same rule, and it was the half still missing: the include
'' search learned <exe-dir>/inc above, but a link still had to be told where libfb.a
'' was -- the packaged toolchain's own MANIFEST tells the reader to type
'' '-p lib/win64 -p lib/win64-fb' on every build. fbc needs neither, and this is why:
'' it appends <exe-dir>/lib/<target> after the -p paths and searches it last. Measured,
'' not assumed -- 'fbc64 -v hello.bas' emits
''
''     -L "<prefix>\lib\win64" -L "."
''
'' with no -p given, and with '-p X' the X comes FIRST. The directory is per target
'' where inc/ is not, which is fbc's shape too and the reason the two rules cannot
'' share one helper.
''
'' TWO directories are appended, not one, and the second is ours alone. tiko-rt is a
'' partial runtime: its thread layer calls fb_AtomicCasLong, which only fbc's libfb
'' defines, so the packaged tree carries lib/<target>-fb behind lib/<target> and a
'' single -lfb resolves out of whichever has it first. Ours first is the whole point
'' -- reverse them and the link silently picks up fbc's runtime instead. When tiko-rt
'' is complete the '-fb' directory stops existing and this stops finding it; nothing
'' else here changes.
''
'' Appended LAST and only when the directory is really there, for the reason the
'' include rule gives: a -p the user typed still wins, and a path that does not exist
'' buys a stat per library for nothing.
''
'' TIKO_LIBPATH overrides the bundled tree, exactly as TIKO_INCLUDE overrides inc/. It
'' used to be read in FindTools, and only when no -p was given at all; it is read here
'' now because a default pushed into libPaths would have made that test true forever
'' and dropped the variable on the floor without saying so.
private sub AppendBundledLibDirs_( byref opts as Tko.DriverOptions )
    dim as ustring env_ = environ( "TIKO_LIBPATH" )
    if len( env_ ) > 0 then
        opts.defaultLibPaths.Push( env_ )
        '' ...AND ITS '-fb' SIBLING, as the bundled tree gets below (T70). That is
        '' where fbrt0.o lives, the runtime's constructor on every gnu target, and the
        '' link names it only if a library path has it. TIKO_LIBPATH=lib/linux-x86_64
        '' alone linked no fbrt0.o, so fb_hRtInit and fb_hRtExit never ran: no
        '' locale, no "Aborting due to runtime error" on stderr, and nothing said so.
        '' windows-x86_64 has no sibling and needs none -- msvcinit.c does that job.
        dim as ustring dir_ = env_
        do while (len( dir_ ) > 1) andalso _
                 ((right( dir_, 1 ) = "/") orelse (right( dir_, 1 ) = "\"))
            dir_ = left( dir_, len( dir_ ) - 1 )
        loop
        if fs.IsDir( dir_ & "-fb" ) then opts.defaultLibPaths.Push( dir_ & "-fb" )
        return
    end if

    dim as ustring exeDir = exepath( )
    if len( exeDir ) = 0 then return

    '' <exe-dir>/lib is fbc's shape, which the packaged toolchain copies;
    '' <exe-dir>/../lib is the development tree, where the exe sits in bin/.
    dim as ustring root = fs.PathJoin( exeDir, "lib" )
    if fs.IsDir( root ) = false then
        root = fs.PathJoin( fs.PathParent( exeDir ), "lib" )
        if fs.IsDir( root ) = false then return
    end if

    dim as ustring cand = fs.PathJoin( root, opts.targetName )
    if fs.IsDir( cand ) then opts.defaultLibPaths.Push( cand )

    cand = fs.PathJoin( root, opts.targetName & "-fb" )
    if fs.IsDir( cand ) then opts.defaultLibPaths.Push( cand )
end sub

'' ...AND THE CURRENT DIRECTORY, LAST. fbc searches it -- measured, its link line
'' ends '-L "<its own lib>" -L "."' -- and this did not, which was a deliberate
'' omission and a wrong one.
''
'' The cost was not theoretical. 'tiko -dll thing.bas' writes thing.dll and
'' libthing.dll.a into the working directory, and 'tiko -l thing use.bas' then could
'' not find either: the only paths searched were the bundled ones under the compiler.
'' Building a library and linking against it beside itself is the obvious workflow
'' and it failed on the shipped toolchain.
''
'' LAST, AFTER THE BUNDLED TREE, which is also fbc's order. A stray libfb.a in the
'' working directory must not win against the runtime that was shipped with the
'' compiler -- that is how a build picks up something nobody meant it to.
''
'' UNCONDITIONAL, including when TIKO_LIBPATH replaced the bundled tree: fbc adds it
'' whatever else it was told, and a variable that says where the RUNTIME lives is
'' not a statement about the working directory.
private sub AppendDefaultLibDir( byref opts as Tko.DriverOptions )
    AppendBundledLibDirs_( opts )
    opts.defaultLibPaths.Push( "." )
end sub

'' THE OPTIONS BY SPELLING, and the joined ones in table order, built once: an argument was
'' up to three scans of the whole table (exact, the '--opt=' half, joined). The first row of
'' a spelling wins, as the scan's did; the joined list keeps the table's order, so the
'' longest-prefix rule below picks what it picked.
dim shared as containers.Map( of string, int32 ) optBySpelling
dim shared as containers.Array( of int32 ) optJoined
dim shared as boolean optIndexReady = false

private sub InitOptIndex_( )
    Tko.InitOptTable( )
    if optIndexReady then return
    for i as int32 = 1 to Tko.OPT_COUNT - 1
        dim as Tko.OptInfo ptr info = Tko.OptInfoOf( cast( Tko.OptId, i ) )
        optBySpelling.Add( *info->spelling, i )
        if info->kind = Tko.OPTK_JOINED then optJoined.Push( i )
    next
    optIndexReady = true
end sub

sub InitTables( )
    Tko.InitDiagTable( )
    Tko.DiagIdFromName( "" )            '' builds the by-name index
    Tko.InitOptTable( )
    InitOptIndex_( )
    Tko.InitTokenTables( )
    Tko.InitNodeTables( )               '' and the infix precedences
    Tko.InitIntrinsicTable( )
    Tko.InitBuiltins( )
    Tko.InitSymNames( )
end sub

function OptIdOfSpelling( byref spell as string ) as Tko.OptId
    InitOptIndex_( )
    dim as int32 at = 0
    if optBySpelling.TryGet( spell, at ) then return cast( Tko.OptId, at )
    return Tko.OPT_NONE
end function

private function MatchExact( byval arg as string ) as Tko.OptId
    return OptIdOfSpelling( arg )
end function

'' Longest joined prefix wins, so "-Wno-" beats a hypothetical "-W".
private function MatchJoined _
    ( byval arg as string, byref value as string ) as Tko.OptId

    InitOptIndex_( )
    dim as Tko.OptId best = Tko.OPT_NONE
    dim as int32 bestLen = 0

    for each i as int32 in optJoined
        dim as Tko.OptInfo ptr info = Tko.OptInfoOf( cast( Tko.OptId, i ) )
        dim as string spell = *info->spelling
        dim as int32 n = len( spell )
        dim as boolean fits = (len( arg ) > n) andalso (left( arg, n ) = spell)
        if fits andalso (n > bestLen) then
            best = cast( Tko.OptId, i )
            bestLen = n
            value = mid( arg, n + 1 )
        end if
    next
    return best
end function

'' THE LEVEL fbc GIVES EACH WARNING tiko shares with it, -1 for one fbc has not got.
'' fbc prints the level beside the number -- 'warning 4(2)' -- and every row was read off
'' fbc-modern's own output, not its sources. A tiko-only warning (a cache it could not
'' write, a statement it left out) has no fbc level to compare and '-w' never hides it;
'' '-Wno-<id>' still does.
private function FbcWarnLevel_( byval d as Tko.DiagId ) as int32
    select case d
    case Tko.TKO0830 : return 2      '' warning 4,  suspicious pointer assignment
    case Tko.TKO0968 : return 1      '' warning 5,  implicit conversion (pointer to integer)
    case Tko.TKO0970 : return 2      '' warning 2,  passing pointer to scalar
    case Tko.TKO0833 : return 2      '' warning 3,  passing different pointer types
    case Tko.TKO0205 : return 2      '' warning 8,  literal number too big, truncated
    case Tko.TKO0206 : return 1      '' warning 44, suffix ignored
    case Tko.TKO0201 : return 1      '' warning 12, missing closing quote
    case Tko.TKO0931 : return 1      '' warning 34, '=' parsed as equality in an argument
    case Tko.TKO0984 : return 1      '' warning 25, overflow in constant conversion
    end select
    return -1
end function

function Parse _
    ( byref args as Tko.StrVec, byref opts as Tko.DriverOptions, _
      byref diags as Tko.DiagnosticEngine ) as boolean

    Tko.InitOptTable( )

    dim as boolean ok = true
    dim as boolean noMoreOptions = false
    dim as int32 i = 0
    dim as int32 n = args.Count

    while i < n
        dim as string arg = args[i]

        dim as boolean isOption = (len( arg ) > 1) andalso (arg[0] = asc( "-" ))
        if noMoreOptions orelse (isOption = false) then
            opts.inputs.Push( arg )
            i += 1
            continue while
        end if

        if arg = "--" then
            noMoreOptions = true
            i += 1
            continue while
        end if

        '' Three spellings are tried in order: exact, --opt=value, then joined.
        dim as string value = ""
        dim as boolean haveValue = false
        dim as Tko.OptId id = MatchExact( arg )

        if id = Tko.OPT_NONE then
            dim as string lhs = "", rhs = ""
            if SplitEq( arg, lhs, rhs ) then
                id = MatchExact( lhs )
                if id <> Tko.OPT_NONE then
                    value = rhs
                    haveValue = true
                end if
            end if
        end if

        if id = Tko.OPT_NONE then
            id = MatchJoined( arg, value )
            if id <> Tko.OPT_NONE then haveValue = true
        end if

        if id = Tko.OPT_NONE then
            diags.ReportGlobal( Tko.TKO0100, arg )
            ok = false
            i += 1
            continue while
        end if

        dim as Tko.OptInfo ptr info = Tko.OptInfoOf( id )

        '' A separated value is consumed only for OPTK_VALUE, and only when the
        '' next argument exists. --help is the one option whose value is optional.
        dim as boolean wantsValue = (info->kind = Tko.OPTK_VALUE) orelse _
                                    (info->kind = Tko.OPTK_OPTVALUE)
        if wantsValue andalso (haveValue = false) then
            dim as boolean optionalValue = (info->kind = Tko.OPTK_OPTVALUE)
            dim as boolean hasNext = (i + 1 < n)

            '' An OPTIONAL value must be attached: '--dump-tokens=pp', never
            '' '--dump-tokens pp'. Consuming a separate argument would make
            '' 'tiko-lang --dump-tokens file.bas' ambiguous -- and it silently ate the
            '' input file when this was first written.
            dim as boolean takeIt = hasNext andalso (optionalValue = false)

            if takeIt then
                value = args[i + 1]
                haveValue = true
                i += 1
            elseif optionalValue = false then
                diags.ReportGlobal( Tko.TKO0101, arg )
                ok = false
                i += 1
                continue while
            end if
        end if

        select case id
        case Tko.OPT_HELP
            opts.showHelp = true
            if haveValue then opts.helpCategory = value
        case Tko.OPT_VERSION  : opts.showVersion = true
        case Tko.OPT_VERBOSE  : opts.verbose = true
        case Tko.OPT_RESTART  : '' see options.ti: the restart is not a flag here
        case Tko.OPT_EXTENDED : '' see options.ti: '-z <option>' is taken and dropped

        case Tko.OPT_INCLUDE  : opts.includePaths.Push( value )
        case Tko.OPT_PKGDIR   : opts.pkgDir = value
        case Tko.OPT_BUILDONLY : opts.buildOnlyUnit = valint( value )
        case Tko.OPT_DEFINE   : opts.defines.Push( value )
        case Tko.OPT_LIBPATH  : opts.libPaths.Push( value )
        case Tko.OPT_MAINMOD  : opts.mainModule = value
        case Tko.OPT_LIB      : opts.libs.Push( value )
        case Tko.OPT_LINKOPT
            '' fbc splits at commas and drops nothing else; an empty piece passes nothing.
            dim as int32 st = 1
            do
                dim as int32 cm = instr( st, value, "," )
                dim as string piece = iif( cm = 0, mid( value, st ), mid( value, st, cm - st ) )
                if len( piece ) > 0 then opts.linkerOpts.Push( piece )
                if cm = 0 then exit do
                st = cm + 1
            loop

        case Tko.OPT_OUTPUT
            opts.outputPath = value
            '' The input it follows, or "" when it came before every input.
            opts.outputFor.Push( iif( opts.inputs.Count > 0, opts.inputs[opts.inputs.Count - 1], "" ) )
            opts.outputFor.Push( value )
        case Tko.OPT_EXEOUT   : opts.exeOutputPath = value
        case Tko.OPT_COMPILE  : opts.compileOnly = true
        '' -dylib IS -dll. fbc's own help says 'Same as -dylib' and the two set one
        '' flag there too; the second spelling exists for the platforms where the
        '' artefact is a .so rather than a .dll.
        case Tko.OPT_DLL, Tko.OPT_DYLIB : opts.outKind = Tko.OUT_DLL
        case Tko.OPT_STATICLIB          : opts.outKind = Tko.OUT_STATICLIB
        '' BITS, ORED, whatever the order: '-exx -e' is still -exx, because each level's
        '' bits contain the one below's. The values are fbc's, measured with __FB_ERR__
        '' on fbc-modern 1.20 (T63, T64): -g sets 32, 64 and 128 as well as emitting
        '' debug information, and each -e<part> option sets the one bit it names.
        case Tko.OPT_ERRCHK      : opts.errFlags or= 513
        case Tko.OPT_ERRCHKX     : opts.errFlags or= 515
        case Tko.OPT_ERRCHKXX    : opts.errFlags or= 1823
        case Tko.OPT_DEBUG       : opts.debugInfo = true : opts.errFlags or= 224
        case Tko.OPT_EARRAY      : opts.errFlags or= 8
        case Tko.OPT_ENULLPTR    : opts.errFlags or= 16
        case Tko.OPT_EASSERT     : opts.errFlags or= 32
        case Tko.OPT_EDEBUGINFO  : opts.debugInfo = true : opts.errFlags or= 64
        case Tko.OPT_EDEBUG      : opts.errFlags or= 128
        case Tko.OPT_ELOCATION   : opts.errFlags or= 256
        case Tko.OPT_EUNWIND     : opts.errFlags or= 512
        case Tko.OPT_EARRAYDIMS  : opts.errFlags or= 1024
        case Tko.OPT_MT       : opts.threadSafe = true

        case Tko.OPT_OPTLEVEL
            '' '-O 2' AS fbc TAKES IT, the level a separate argument; and only a DIGIT: '-Os'
            '' read as valint( "s" ) = 0 and built at -O0 in silence -- fbc's 81 (F-64).
            if (len( value ) = 0) andalso (i + 1 < n) then
                if (len( args[i + 1] ) = 1) andalso (instr( "0123", args[i + 1] ) > 0) then value = args[i + 1] : i += 1
            end if
            dim as int32 lvl = valint( value )
            dim as boolean bad = (len( value ) <> 1) orelse (instr( "0123", value ) = 0)
            if bad then
                diags.ReportGlobal( Tko.TKO0106, value, "-O" )
                ok = false
            else
                opts.optLevel = lvl
            end if

        case Tko.OPT_TARGET
            dim as boolean known = false
            dim as Tko.TargetId t = Tko.TargetFromName( value, known )
            if known = false then
                diags.ReportGlobal( Tko.TKO0103, value )
                ok = false
            else
                opts.target = t
                opts.targetName = Tko.TargetName( t )
            end if

        '' -m32 and -m64 pick the WIDTH of the target family, and are resolved after
        '' the whole line is read so that they do not depend on where they appear.
        case Tko.OPT_M64      : opts.widthOverride = 64
        case Tko.OPT_M32      : opts.widthOverride = 32

        '' '-s gui' IS fbc's, and measured there: no '-s' and '-s console' both give PE
        '' subsystem 3, '-s gui' gives 2, and fbc hands ld '-subsystem windows'. Without
        '' it a GUI program -- tracks -- linked as a console one and opened a stray console
        '' window beside its own. Any other value is refused rather than guessed at.
        case Tko.OPT_SUBSYS
            select case Tko.Text.LowerAscii( value )
            case "gui"     : opts.guiSubsystem = true
            case "console" : opts.guiSubsystem = false
            case else
                diags.ReportGlobal( Tko.TKO0106, value, "-s" )
                ok = false
            end select

        '' '-t <KB>': THE STACK OF A WINDOWS EXECUTABLE, fbc's option with fbc's rule, measured
        '' over fbc-modern 1.20 from the PE header: the value is read as valint reads it ('abc'
        '' is 0, '12x' is 12, '&h100' is 256) and multiplied by 1024; a NEGATIVE one changes
        '' nothing, so '-t 100 -t -5' keeps 100 KB; under 64 KB becomes 64 KB. The default,
        '' 2 MB, is fbc's for a 64-bit target. A '#cmdline "-t ..."' comes later and wins.
        case Tko.OPT_STACK
            dim as int64 bytes = clngint( valint( value ) ) * 1024
            if bytes >= 0 then
                if bytes < 65536 then bytes = 65536
                opts.stackSize = bytes
            end if

        case Tko.OPT_WERROR   : opts.warningsAsErrors = true
        case Tko.OPT_PIC      : opts.pic = true
        case Tko.OPT_WNO
            dim as Tko.DiagId d = Tko.DiagIdFromName( value )
            if d = Tko.DIAG_NONE then
                diags.ReportGlobal( Tko.TKO0105, value )
            '' AN ERROR CANNOT BE SILENCED: '-Wno-TKO0743' over 'print undefinedThing + 1'
            '' exited 0 with the statement dropped (audit F-37). Only a warning or a note.
            elseif Tko.DiagInfoOf( d )->defaultSev = Tko.SEV_ERROR then
                diags.ReportGlobal( Tko.TKO0106, value, "-Wno" )
                ok = false
            '' ...NOR A STATEMENT LEFT OUT OF THE BUILD. TKO0995 is '--allow-unlowered's warning
            '' that the program runs without a statement; silencing it made that silent again
            '' (review ARCH-10 / MIR-06, LATER-PLAN D step 5).
            elseif d = Tko.TKO0995 then
                diags.ReportGlobal( Tko.TKO0106, value, "-Wno" )
                ok = false
            else
                opts.ignoredDiags.Push( Tko.DiagIdName( d ) )
            end if

        '' fbc's '-w'. The LAST one decides the level, as fbc's does ('-w 2 -w 1' shows a
        '' level-2 warning); 'error' is a separate switch and survives a later level.
        '' Measured, fbc-modern: 'all' and 'pedantic' hide nothing, 'none' hides every
        '' warning, 'error' reports each as 'error warning 4(2)', '-w 3' hides warning
        '' 4(2), and a word it does not know ('-w bogus') is level 0 -- valint's reading.
        case Tko.OPT_WLEVEL
            select case Tko.Text.LowerAscii( value )
            case "all", "pedantic"
                opts.fbcWarnMin = 0 : opts.fbcWarnNone = false
            case "none"
                opts.fbcWarnNone = true
            case "error"
                opts.warningsAsErrors = true
            case else
                opts.fbcWarnMin = valint( value ) : opts.fbcWarnNone = false
            end select

        case Tko.OPT_MAXERR
            dim as int32 m = valint( value )
            if m < 1 then
                diags.ReportGlobal( Tko.TKO0106, value, "-fmax-errors" )
                ok = false
            else
                opts.maxErrors = m
            end if

        case Tko.OPT_MAXINSTDEPTH
            dim as int32 m = valint( value )
            if m < 1 then
                diags.ReportGlobal( Tko.TKO0106, value, "-maxinstdepth" )
                ok = false
            else
                opts.maxInstDepth = m
            end if

        case Tko.OPT_COLOR
            dim as string w = Tko.Text.LowerAscii( value )
            select case w
            case "always" : opts.colorMode = Tko.COLOR_ALWAYS
            case "never"  : opts.colorMode = Tko.COLOR_NEVER
            case "auto"   : opts.colorMode = Tko.COLOR_AUTO
            case else
                diags.ReportGlobal( Tko.TKO0106, value, "--color" )
                ok = false
            end select

        case Tko.OPT_DIAGFMT
            dim as string w = Tko.Text.LowerAscii( value )
            select case w
            case "fbc" : opts.diagFormat = Tko.DIAGFMT_FBC
            case "gnu" : opts.diagFormat = Tko.DIAGFMT_GNU
            case else
                diags.ReportGlobal( Tko.TKO0106, value, "--diagnostics-format" )
                ok = false
            end select

        '' The last one wins, as -o does -- which is also what lets a '#cmdline' in the
        '' source redirect it, the source winning over the command line as fbc's rule is.
        '' '--diagnostics-file=' names nothing, and is the missing-argument error.
        case Tko.OPT_DIAGFILE
            if len( value ) = 0 then
                diags.ReportGlobal( Tko.TKO0101, arg )
                ok = false
            else
                opts.diagFile = value
            end if

        case Tko.OPT_DUMPSRC   : opts.dumpSource = true
        case Tko.OPT_DUMPTOK
            opts.dumpTokens = true
            if haveValue then
                dim as string w = Tko.Text.LowerAscii( value )
                select case w
                case "pp"  : opts.dumpPp = true
                case "raw" : opts.dumpPp = false
                case else
                    diags.ReportGlobal( Tko.TKO0106, value, "--dump-tokens" )
                    ok = false
                end select
            end if
        case Tko.OPT_LEXONLY   : opts.lexOnly = true
        case Tko.OPT_PPONLY    : opts.ppOnly = true
        case Tko.OPT_DUMPAST   : opts.dumpAst = true
        case Tko.OPT_PARSEEXPR : opts.parseExpr = true
        case Tko.OPT_PARSEONLY : opts.parseOnly = true
        case Tko.OPT_DUMPTYPES : opts.dumpTypes = true
        case Tko.OPT_DUMPSYMS  : opts.dumpSymbols = true
        case Tko.OPT_DUMPSCAN  : opts.dumpScan = true
        case Tko.OPT_RESOLVE   : opts.resolveOnly = true
        case Tko.OPT_MANGLE    : opts.dumpMangle = true
        case Tko.OPT_PRINTGRAPH : opts.printGraph = true
        case Tko.OPT_PRINTCINC : opts.printCIncludes = true
        case Tko.OPT_EMITTKI   : opts.emitTki = true
        case Tko.OPT_FRONTEND : opts.frontendOnly = true
        case Tko.OPT_NOMODCACHE : opts.noModuleCache = true
        case Tko.OPT_CLEANMODCACHE : opts.cleanModuleCache = true
        case Tko.OPT_CHECK     : opts.checkOnly = true
        case Tko.OPT_DUMPDECIDE : opts.checkOnly = true : opts.dumpDecisions = true
        case Tko.OPT_UDT       : opts.dumpUdt = true
        case Tko.OPT_CIMPORT_PROBE : opts.cimportProbe = value
        case Tko.OPT_CINCLUDE  : opts.cIncludes.Push( value )
        case Tko.OPT_CIMPORT   : opts.cimportHeaders.Push( value )
        case Tko.OPT_CIMPORT_OUT : opts.cimportOut = value
        case Tko.OPT_CCACHEDIR : opts.cCacheDir = value
        case Tko.OPT_CIMPORT_MANIFEST : opts.cimportManifest = value
        case Tko.OPT_CDEFINE   : opts.cDefines.Push( value )
        case Tko.OPT_CSYSROOT  : opts.cSysroot = value
        case Tko.OPT_COPT      : opts.cOpts.Push( value )
        case Tko.OPT_CNOMACROS : opts.cNoMacros = true
        case Tko.OPT_CNOVERIFY : opts.cNoVerify = true
        case Tko.OPT_CNOCACHE  : opts.cNoCache = true
        case Tko.OPT_NORPATH   : opts.noRpath = true
        case Tko.OPT_NOCOPYLIBS : opts.noCopyLibs = true
        case Tko.OPT_VTABLE    : opts.dumpVtable = true
        case Tko.OPT_ITABLE    : opts.dumpItable = true
        case Tko.OPT_RTL       : opts.dumpRtl = true
        case Tko.OPT_DUMPIR    : opts.dumpIr = true
        case Tko.OPT_DUMPIR_PREABI : opts.dumpIr = true : opts.dumpIrPreAbi = true
        case Tko.OPT_VERIFY_SELFTEST : opts.verifySelfTest = true
        case Tko.OPT_ALLOWUNLOWERED : opts.allowUnlowered = true
        case Tko.OPT_EMITIR    : opts.emitIr = true
        case Tko.OPT_EMITASM   : opts.emitAsm = true
        case Tko.OPT_KEEPTEMPS : opts.keepTemps = true
        case Tko.OPT_STATS     : opts.stats = true
        case Tko.OPT_TIMEPASS  : opts.timePasses = true
        case Tko.OPT_SUBSET    : opts.bootstrapCheck = true
        end select

        i += 1
    wend

    '' The width override. -m32 AND -m64 RESOLVE TO A TARGET here, after the whole
    '' line is read, so that '-target windows-x86_64 -m32' and '-m32 -target
    '' windows-x86_64' mean the same thing: they pick the 32- or 64-bit member of
    '' the family the target belongs to. Only the Windows x86 family has both
    '' members -- the question is its osKind and arch, not a target id (lint's
    '' TARGETID rule, and the ids live in TargetNarrowTo32 alone). Against
    '' linux-x86_64 or macos-arm64, -m32 is refused rather than ignored -- silently
    '' producing a 64-bit binary for someone who asked for 32 is worse than telling
    '' them (the rule D14 wrote stays, the target set it was written about no
    '' longer does). The 32-bit member is the MinGW ABI: msvcrt.dll ships in
    '' Windows in-box, so what it produces runs on an install no UCRT update has
    '' reached.
    if opts.widthOverride = 32 then
        dim as boolean narrowable = false
        dim as Tko.TargetId t32 = Tko.TargetNarrowTo32( opts.target, narrowable )
        if narrowable = false then
            diags.ReportGlobal( Tko.TKO0104, Tko.TargetName( opts.target ) )
            ok = false
        else
            opts.target = t32
        end if
    elseif opts.widthOverride = 64 then
        '' '-m64' ASKS FOR THE 64-BIT MEMBER and the family's 32-bit member is not
        '' it. Refused, not second-guessed: two explicit width statements that
        '' disagree do not resolve by position.
        if (Tko.TargetOs( opts.target ) = Tko.OS_WINDOWS) andalso _
           (Tko.TargetArch( opts.target ) = Tko.ARCH_X86_32) then
            diags.ReportGlobal( Tko.TKO0107, Tko.TargetName( opts.target ) )
            ok = false
        end if
    end if
    opts.targetName = Tko.TargetName( opts.target )

    '' -x AS fbc HAS IT, measured on fbc-modern 1.20: the exe, DLL or library is written to
    '' the path as given -- no extension added -- wherever on the line it stands, the last one
    '' winning, and over any -o; with -c it is ignored and each object keeps its own name.
    if (len( opts.exeOutputPath ) > 0) andalso (opts.compileOnly = false) then
        opts.outputPath = opts.exeOutputPath
    end if

    if opts.pic andalso Tko.TargetIsWindows( opts.target ) then
        diags.ReportGlobal( Tko.TKO0123, opts.targetName )
        ok = false
    end if

    '' '-w' BECOMES '-Wno-' for each warning it hides, so it rides on the one mechanism
    '' that already reaches every pass -- after the loop, because the last '-w' wins.
    for d as int32 = 0 to Tko.DIAG_COUNT - 1
        dim as int32 lv = FbcWarnLevel_( cast( Tko.DiagId, d ) )
        if lv < 0 then continue for
        if opts.fbcWarnNone orelse (lv < opts.fbcWarnMin) then
            opts.ignoredDiags.Push( Tko.DiagIdName( cast( Tko.DiagId, d ) ) )
        end if
    next

    opts.userIncludeCount = opts.includePaths.Count
    AppendDefaultIncludeDir( opts )
    AppendDefaultLibDir( opts )

    return ok
end function

end namespace
