'' androidapp.ti -- 'tiko -app': an SDL3 program as a signed Android APK (docs/tiko-android A4), or
'' with -appbundle an App Bundle for Play (A6).
''
'' The program is linked as a shared libmain.so whose main module is tko_AppMain, run by tiko-rt's
'' SDL_main (lib/rt/src/c/fbrtapp.c). This module stages that link and then assembles the APK with
'' the Android SDK's own tools, no Gradle:
''
''   AndroidManifest.xml   generated: TikoActivity, the app's id, label and version (-appversion),
''                         its icon (-appicon: res/mipmap/ic_launcher, aapt2 compile --dir), minSdk 29,
''                         targetSdk 36
''   aapt2 link            against the newest platform's android.jar
''   jar -uMf              assets/: the modules' run-time files and the -appassets tree (jar, not
''                         aapt2 -A, which names a nested asset with a backslash on Windows)
''   jar -u0Mf             classes.dex (vendor/SDL3's, built once by vendorfetch) and
''                         lib/<abi>/libmain.so, STORED, as extractNativeLibs=false requires
''   zipalign -P 16 -f 4   the .so on 16 KB pages, as Android 15+ devices need
''   apksigner             with -appkey's key, its passwords read by apksigner from
''                         TIKO_ANDROID_KS_PASS / TIKO_ANDROID_KEY_PASS; else the standard debug key
''                         (~/.android/debug.keystore, made by keytool when absent)
''
'' -appbundle instead: aapt2 link --proto-format into a directory, the base module laid out as
'' bundletool wants it and zipped by jar, bundletool build-bundle, then jarsigner.
''
'' Found as the NDK is (toolchain.tiko): the SDK through ANDROID_HOME, ANDROID_SDK_ROOT, then the
'' host's default place; the JDK through JAVA_HOME, then Android Studio's bundled one.

#pragma once

#include once "tko.ti"
#include once "driver/driver.ti"

namespace Tko.AndroidApp

    '' Where the link writes libmain.so under -app: <output>.libmain.so, beside the objects --
    '' a file, so a link that fails leaves nothing behind. Package moves it into the APK.
    declare function LinkPath( byref ctx as Tko.CompilerContext ) as string

    '' The APK at ctx.options.outputPath, from the libmain.so LinkPath named, staged in
    '' <output>.stage. True when it was written; false with 'why' saying which step failed and
    '' how. Either way the stage and the linked file are removed, unless -R keeps temporaries.
    declare function Package( byref ctx as Tko.CompilerContext, byref why as string ) as boolean

end namespace
