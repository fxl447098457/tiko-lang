'' main.tiko -- tiko-lang entry point.
''
'' Deliberately trivial: collect the argument vector and hand it to the driver. Every
'' decision, including how to fail, belongs to Driver.Run so that the whole compiler is
'' reachable in-process from the test runner and from a fuzz harness.

#import "std/containers"
#include once "driver/driver.ti"
#include once "build/build.ti"
#include once "driver/cmdline.ti"

using Tko

dim as StrVec args

'' THE ARGUMENTS, BY COUNT AND AS UTF-8 (audit F-48, F-64). command( i ) is the ANSI code
'' page on Windows, and the compiler reads every string as UTF-8: 'tiko "ünï/hé.bas"'
'' could not open its own input where fbc builds it. And 'while len( command( i ) ) > 0'
'' stopped at the first EMPTY argument -- 'tiko "" a.bas' compiled nothing; fbc skips it.
#ifdef __FB_WIN32__
    extern "windows"
        declare function W_GetCommandLineW_ alias "GetCommandLineW" ( ) as wstring ptr
        declare function W_CommandLineToArgvW_ alias "CommandLineToArgvW" _
            ( byval cmd as wstring ptr, byval argc as int32 ptr ) as wstring ptr ptr
        declare function W_LocalFree_ alias "LocalFree" ( byval h as any ptr ) as any ptr
        declare function W_WideCharToMultiByte_ alias "WideCharToMultiByte" _
            ( byval cp as uint32, byval flags as uint32, byval src as wstring ptr, byval srcLen as int32, _
              byval dst as zstring ptr, byval dstLen as int32, byval def_ as zstring ptr, _
              byval usedDef as int32 ptr ) as int32
    end extern
    #inclib "shell32"
    dim as int32 wargc = 0
    dim as wstring ptr ptr wargv = W_CommandLineToArgvW_( W_GetCommandLineW_( ), @wargc )
    if wargv <> nullptr then
        for i as int32 = 1 to wargc - 1
            dim as int32 need = W_WideCharToMultiByte_( 65001, 0, wargv[i], -1, nullptr, 0, nullptr, nullptr )
            dim as string u8 = space( iif( need > 0, need - 1, 0 ) )
            if need > 1 then W_WideCharToMultiByte_( 65001, 0, wargv[i], -1, strptr( u8 ), need, nullptr, nullptr )
            if len( u8 ) > 0 then args.Push( u8 )   '' an EMPTY argument is skipped, as fbc skips it
        next
        W_LocalFree_( wargv )
    else
        for i as int32 = 1 to __FB_ARGC__ - 1
            if len( *__FB_ARGV__[i] ) > 0 then args.Push( *__FB_ARGV__[i] )
        next
    end if
#else
    for i as int32 = 1 to __FB_ARGC__ - 1
        if len( *__FB_ARGV__[i] ) > 0 then args.Push( *__FB_ARGV__[i] )
    next
#endif

'' THE COMPILER RUNS ON A 1 GB STACK. Every stage recurses over the tree, and on the 2 MB
'' main stack 200 nested IFs, a 3,000-term '+' chain or 1,000 nested parentheses crashed
'' with 0xC0000005 and no diagnostic (F-46). 64 MB stopped at ~20,000 terms, below fbc's
'' 25,000 '+' and its 50,000+ '&' (audit Phase 5); 1 GB took a 200,000-term chain. A
'' thread is the one portable way to choose the size -- Linux gives the main thread
'' whatever ulimit says -- and the size is RESERVED, not committed: on Windows
'' threadcreate COMMITS its whole stack (1 GB of commit charge per compile, measured),
'' so CreateThread is called with STACK_SIZE_PARAM_IS_A_RESERVATION; Linux maps it lazily.
'' Should the thread not start, the compile runs here as it always did.
'' TWO ON ARM64: its unoptimised frames are bigger. Measured on the Mac (docs/tiko-macos M8):
'' the Debug compiler hit the 1 GB thread's guard page between a 100,000- and a 149,000-term
'' chain, and so crashed (SIGBUS) where it should refuse past PARSE_MAX_CHAIN; Release took
'' 149,000 in 1 GB. Reserved, not committed, there as on Linux. It was keyed on Darwin, and
'' linux-arm64's Debug compiler segfaulted on the same chain (diagnostics/limit-chain, in the
'' Lima VM, docs/tiko-linux-arm64 L4): it is the architecture's frames, not the OS.
#if defined( __FB_ARM__ )
    const BIG_STACK_ as uinteger = 2048ull * 1024 * 1024
#else
    const BIG_STACK_ as uinteger = 1024ull * 1024 * 1024
#endif
type RunJob_
    as StrVec ptr args
    as int32 rc
end type

private sub RunOnBigStack_( byval p as any ptr )
    dim as RunJob_ ptr j = p
    j->rc = Tko.Build.Entry( *j->args )
end sub

dim as RunJob_ job
job.args = @args
Tko.Cmdline.InitTables( )                  '' before any thread (review ARCH-07)
#ifdef __FB_WIN32__
    extern "Windows"
        declare function CreateThread_ alias "CreateThread" ( byval attrs as any ptr, byval stackSize as uinteger, _
            byval start as function( byval as any ptr ) as uint32, byval param as any ptr, _
            byval flags as uint32, byval tid as uint32 ptr ) as any ptr
        declare function WaitForSingleObject_ alias "WaitForSingleObject" ( byval h as any ptr, byval ms as uint32 ) as uint32
        declare function CloseHandle_ alias "CloseHandle" ( byval h as any ptr ) as int32
    end extern
    private function BigStackEntry_ stdcall( byval p as any ptr ) as uint32
        RunOnBigStack_( p )
        return 0
    end function
    dim as any ptr wth = CreateThread_( nullptr, BIG_STACK_, @BigStackEntry_, @job, &h00010000, nullptr )
    if wth = nullptr then end Tko.Build.Entry( args )
    WaitForSingleObject_( wth, &hFFFFFFFFul )
    CloseHandle_( wth )
#else
    dim as any ptr th = threadcreate( @RunOnBigStack_, @job, BIG_STACK_ )
    if th = nullptr then end Tko.Build.Entry( args )
    threadwait( th )
#endif
end job.rc
