'' ppforeignlib.tiko -- the files a directive names: a '#foreignlib' spec resolved to a library
'' file, the quoted-path search '#include' and '#embed' share, and '#embed' itself.
''
'' Included from directive.tiko, above PpInclude. Split out at the 1500-line lint cap.

'' '#foreignlib' (fbc-modern RFC-0005). The rules below are fbc's, read from
'' fbForeignLibResolve and then checked against its own error tests:
''
''     #foreignlib ID (STATIC|DYNAMIC) "spec" (, "spec")*
''
' A spec of "system:name" is handed to the linker as a bare name and resolved no
'' further. Anything else is a BASE NAME made absolute against the directory of the
'' source that wrote it, then probed -- most specific variant first:
''
''     stem_<os>_<arch>   stem_<os>   stem_<arch>   stem
''
'' with the extensions the kind and target allow. An axis with no tag drops the
'' variants that would need it rather than inventing a spelling.
'' The tags are the OS and arch halves of the target's name, so 'stem_macos_arm64' is what a
'' library built for macos-arm64 is called, as 'stem_linux_x86_64' is for linux-x86_64.
private function ForeignLibOsTag_( byref e as PpEngine ) as string
    select case e.cfg->targetOs
    case OS_WINDOWS : return "windows"
    case OS_LINUX   : return "linux"
    case OS_DARWIN  : return "macos"
    end select
    TargetIce( "ForeignLibOsTag_", e.cfg->targetOs )
    return ""
end function

'' It stays a function because the variant list is built around an axis that CAN be
'' empty: every target has one today.
private function ForeignLibArchTag_( byref e as PpEngine ) as string
    select case e.cfg->targetArch
    case ARCH_X86_64  : return "x86_64"
    case ARCH_ARM64   : return "arm64"
    '' ARCH_X86_32 spells 'x86', the mingw-w64 and fbc name for the width, so a
    '' library variant built for TARGET_WIN32 is 'stem_windows_x86' beside
    '' 'stem_windows_x86_64'.
    case ARCH_X86_32  : return "x86"
    end select
    TargetIce( "ForeignLibArchTag_", e.cfg->targetArch )
    return ""
end function

'' STATIC prefers an archive, DYNAMIC an import library. Windows gets '.lib' in
'' both: it is the MSVC spelling of each. A Darwin shared library is a '.dylib'.
private sub ForeignLibExts_ _
    ( byref e as PpEngine, byval isStatic as boolean, byref outp as StrVec )
    if isStatic then
        outp.Push( ".a" )
        if e.cfg->targetOs = OS_WINDOWS then outp.Push( ".lib" )
        return
    end if
    select case e.cfg->targetOs
    case OS_WINDOWS
        outp.Push( ".dll.a" )
        outp.Push( ".lib" )
        outp.Push( ".dll" )
    case OS_LINUX
        outp.Push( ".so" )
    case OS_DARWIN
        outp.Push( ".dylib" )
    case else
        TargetIce( "ForeignLibExts_", e.cfg->targetOs )
    end select
end sub

'' One spec to a file on disk, or "" if nothing matched. 'tried' collects every
'' candidate so the diagnostic can list them -- fbc's does, and a probe that fails
'' silently on four variants times three extensions is a bad afternoon.
private function ForeignLibResolve_ _
    ( byref e as PpEngine, byval at as SourceLoc, byref spec as string, _
      byval isStatic as boolean, byref tried as string ) as string

    tried = ""

    '' 'system:name' resolves nothing -- the linker is expected to know it.
    if lcase( left( spec, 7 ) ) = "system:" then
        return mid( spec, 8 )
    end if
    '' ...NOR 'framework:Name', a macOS framework: kept whole, and the Mach-O link writes it
    '' '-framework Name' (codegen/toolchain.tiko). A static SDL3 needs a dozen (Cocoa, Metal...).
    if lcase( left( spec, 10 ) ) = "framework:" then return spec

    '' SOURCE-RELATIVE, not relative to the working directory: a binding written in
    '' a header must find the library sitting beside that header whoever includes it.
    dim as string base_ = spec
    for i as int32 = 1 to len( base_ )
        if mid( base_, i, 1 ) = "\" then mid( base_, i, 1 ) = "/"
    next
    dim as boolean absolute_ = false
    if instr( base_, ":" ) > 0 then absolute_ = true
    if left( base_, 1 ) = "/" then absolute_ = true
    if absolute_ = false then
        '' The PHYSICAL file, unlike '#include' above: '#foreignlib' is tiko's own
        '' (RFC-0005) and probes for binaries that ship beside the real source, where
        '' a '#line' name is a fiction about text rather than a place on disk.
        dim as DecodedLoc d = e.src->Decode( at )
        dim as string here = e.src->PathOf( d.file )
        dim as string dir_ = ""
        for i as int32 = len( here ) to 1 step -1
            dim as uint8 c = here[i - 1]
            if (c = 47) orelse (c = 92) then
                dir_ = left( here, i )
                exit for
            end if
        next
        base_ = dir_ & base_
    end if

    dim as string dirPart = ""
    dim as string stem = base_
    for i as int32 = len( base_ ) to 1 step -1
        dim as uint8 c = base_[i - 1]
        if (c = 47) orelse (c = 92) then
            dirPart = left( base_, i )
            stem = mid( base_, i + 1 )
            exit for
        end if
    next
    if len( stem ) = 0 then return ""

    dim as string os_ = ForeignLibOsTag_( e )
    dim as string arch = ForeignLibArchTag_( e )

    dim as StrVec variants
    if (len( os_ ) > 0) andalso (len( arch ) > 0) then variants.Push( stem & "_" & os_ & "_" & arch )
    if len( os_ ) > 0 then variants.Push( stem & "_" & os_ )
    if len( arch ) > 0 then variants.Push( stem & "_" & arch )
    variants.Push( stem )

    dim as StrVec exts
    ForeignLibExts_( e, isStatic, exts )

    for v as int32 = 0 to variants.Count - 1
        for x as int32 = 0 to exts.Count - 1
            dim as string cand = dirPart & variants[v] & exts[x]
            dim as int32 fh = freefile
            if open( cand for input as #fh ) = 0 then
                close #fh
                return cand
            end if
            tried += "    " & cand & chr( 10 )
        next
    next
    return ""
end function

'' ------------------------------------------------------------ #embed
'' '#embed NAME "file"' (docs/tiko-embed RFC-0001), and the quoted-path search it shares
'' with '#include "..."'.
''
'' THE DIRECTIVE IS A DECLARATION. '[public] #embed NAME "file"' becomes, where it stands,
''
''     [public] dim shared as const ubyte NAME( 0 to N - 1 ) = { 0 }
''
'' -- a declaration every later pass already knows, with a short initialiser that fbc and
'' tiko both zero-fill. The bytes never become tokens: the tokens written here all carry the
'' directive's own location, so the '{' does too, and lowering (mir/lowerembed.tiko) finds the
'' initialiser by that location and fills the global from the file. The obvious alternative,
'' writing the bytes out as '{ 77, 90, 144, ... }', costs about 280 bytes of compiler memory
'' per byte embedded -- 783 MB for a 2.8 MB file, measured (RFC §3).
''
'' NOT ALLOWED INSIDE A PROCEDURE OR A TYPE, and nothing here has to say so: the declaration
'' written is a 'dim shared', which the parser already refuses there.

const EMBED_MAX_BYTES = 268435456     '' 256 MiB (RFC E3)

'' The text between a string literal token's quotes, as '#include' reads its path.
private function PpQuotedText_( byref e as PpEngine, byref t as Token ) as string
    dim as string spelled = SpellOf( e, t )
    dim as int32 a = instr( spelled, """" )
    dim as int32 b = instrrev( spelled, """" )
    if (a > 0) andalso (b > a) then return mid( spelled, a + 1, b - a - 1 )
    return ""
end function

'' THE PLACES A QUOTED PATH IS LOOKED FOR, in order: the INCLUDING file's directory, then
'' the working directory, then the -i paths and the toolchain's inc/ -- fbc's order for
'' '#include', measured (T97). The first is what makes a library's internal includes work
'' wherever it is used from. '#include' and '#embed' both search exactly this list.
''
'' A '#line' NAME IS WHAT A RELATIVE PATH RESOLVES AGAINST -- measured, and it surprised me:
'' after '#line 5 "sub/fake.bas"', '#include "h.bi"' picks sub/h.bi and falls back to the
'' working directory only when that does not exist. The generator that emitted the '#line' is
'' describing where the text came FROM, and fbc takes it at its word.
''
'' A LEADING SLASH IS NOT A ROOT EXCEPT AS WRITTEN. AfxNova writes '#include once
'' "/crt/string.bi"' and '"/fbc-int/array.bi"'; fbc finds both under its include path
'' (measured, scratchpad afx/inc1.bas), where joining the absolute spelling found nothing. So
'' the directory joins drop it, and only the second candidate, the path as written, keeps it.
''
'' THE WORKING DIRECTORY COMES SECOND, before every -i directory and the toolchain's inc/ --
'' fbc's order, measured (T97): with 'a.bi' in the working directory and in an -i directory,
'' fbc takes the working directory's, and a 'datetime.bi' there wins over the toolchain's own.
private sub PpQuotedCandidates_ _
    ( byref e as PpEngine, byval at as SourceLoc, byref rel as string, byref cands as containers.Array( of ustring ) )

    '' The directory of the INCLUDING file. Done by hand rather than through PathSplit,
    '' which wants an Array( of ustring ) and would cost more than it saves.
    dim as DecodedLoc d = e.src->Decode( at )
    dim as string here = e.src->ShownPathOf( d )
    dim as string dir_ = ""
    for i as int32 = len( here ) to 1 step -1
        dim as uint8 c = here[i - 1]
        dim as boolean isSep = (c = 47) orelse (c = 92)
        if isSep then
            dir_ = left( here, i )
            exit for
        end if
    next

    dim as ustring relJ = rel
    if len( rel ) > 1 then
        if (left( rel, 1 ) = "/") orelse (left( rel, 1 ) = "\") then relJ = mid( rel, 2 )
    end if
    cands.Push( fs.PathJoin( dir_, relJ ) )
    cands.Push( rel )
    for each p as string in *e.cfg->includePaths
        cands.Push( fs.PathJoin( p, relJ ) )
    next
end sub

'' '[public] #embed NAME "file"'. 'public' arrives as cincPublic, set by PpModPublicCInclude.
private sub PpEmbed( byref e as PpEngine, byval at as SourceLoc )
    dim as boolean isPublic = e.modst.cincPublic
    dim as Token nt
    dim as boolean haveName = PeekOnLine( e, nt )
    if haveName then haveName = (Tk( nt ) = TK_IDENT)
    if haveName = false then
        Report( e, TKO0342, at, "a name must follow '#embed'" )
        SkipToEol( e )
        return
    end if
    '' The name AS WRITTEN, not as interned: it is spelled into the declaration, and from
    '' there into a module's interface and its link name.
    dim as string nm = SpellOf( e, nt )
    Advance( e )

    dim as Token pt
    dim as boolean havePath = PeekOnLine( e, pt )
    if havePath then havePath = (Tk( pt ) = TK_STRING_LIT)
    if havePath = false then
        Report( e, TKO0342, at, "a quoted file name must follow '" & nm & "'" )
        SkipToEol( e )
        return
    end if
    dim as string rel = PpQuotedText_( e, pt )
    Advance( e )
    dim as Token extra
    if PeekOnLine( e, extra ) then
        Report( e, TKO0342, extra.loc, "nothing may follow the file name" )
        SkipToEol( e )
        return
    end if
    if len( rel ) = 0 then
        Report( e, TKO0342, pt.loc, "the file name is empty" )
        return
    end if

    '' EXISTENCE BY STAT, NEVER BY LOADING: '#include' probes with LoadFile, which would read
    '' a binary into the source manager and decode it as text. The bytes are lowering's to read.
    dim as containers.Array( of ustring ) cands
    PpQuotedCandidates_( e, at, rel, cands )
    dim as ustring found = ""
    dim as StrVec missed_
    for each cnd as ustring in cands
        if fs.IsFile( cnd ) then
            found = cnd
            exit for
        end if
        missed_.Push( cnd )
    next
    if len( found ) = 0 then
        Report( e, TKO0341, at, rel )
        return
    end if
    '' Recorded as '#include' records them: a file created at a missed candidate later would
    '' be found instead, and a cache entry has to notice.
    for each m_ as string in missed_
        e.outp->probesMissed.Push( m_ )
    next

    dim as fs.FsResultUStr abs_ = fs.AbsolutePath( found )
    dim as ustring ap = found
    if abs_.IsOk( ) then ap = fs.PathNormalize( abs_.Value( ) )
    dim as fs.FsResultInfo st = fs.Stat( ap )
    if st.IsOk( ) = false then
        Report( e, TKO0341, at, rel )
        return
    end if
    dim as int64 size_ = st.Value( ).Size( )
    if size_ = 0 then
        Report( e, TKO0344, at, rel )
        return
    end if
    if size_ > EMBED_MAX_BYTES then
        Report( e, TKO0345, at, rel, str( size_ ) )
        return
    end if

    e.outp->embedLocs.Push( cast( uint32, at ) )
    e.outp->embedPaths.Push( ap )
    e.outp->embedSizes.Push( size_ )

    dim as string raw = "dim shared as const ubyte " & nm & "( 0 to " & str( size_ - 1 ) & " ) = { 0 }"
    if isPublic then raw = "public " & raw
    dim as TokenVec tv
    RelexInto( e, raw, at, tv )
    for i as int32 = 0 to tv.Count - 1
        EmitTok( e, tv[i] )
    next
end sub
