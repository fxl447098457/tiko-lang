'' tikoparser.ti -- THE CONTRACT of parser.dll: tiko's front end, for an editor.
''
'' An editor hands the DLL a source file (or its unsaved text) and gets back every symbol
'' the file and everything it includes or imports declares: kind, name as written, type as
'' text, owner, file and line, the body's line range, a few flags, and how often each is
'' read and written. The DLL runs tiko's own preprocessor, parser, Collect, Resolve and
'' Check -- the same code the compiler runs -- and stops before code generation.
''
'' THIS FILE IS COPIED INTO THE EDITOR. It is self-contained on purpose: nothing here
'' includes a tiko header, so the copy compiles in a host that has none of them.
''
'' LAYOUT. The record layout is the one tiko-editor's earlier fbc-based scanner used
'' (FBCP_* version 2), so the host's indexes carry over unchanged; this is version 3.
''
'' WHAT A HOST MAY RELY ON:
''   - Lines are 1-based; 0 = unknown. Columns are 1-based byte columns, 0 = unknown.
''   - A procedure WITH a body is reported AT its body: its file, and lineNum = bodyLine =
''     the header line; bodyEndLine = the line its END is on. Declare-only: bodyLine = 0.
''   - Parameters are children of their procedure IN DECLARATION ORDER, a member's
''     implicit THIS first (TKP_SYMBFLAG_INSTANCE, type text = the TYPE's name).
''   - A type as text is the bare type name, then space-separated modifiers:
''     "Widget ptr", "const Node ptr", "string * 20". A TYPE/UNION record's type text is
''     the name of what it EXTENDS ("object" for 'extends object'), or none.
''   - Filenames are absolute and UPPERCASED; the root file is fileOffsets[0].
''   - An '#import' alias is a NAMESPACE record at the '#import' line whose children are
''     the imported module's PUBLIC symbols, located in the module's own source -- and its
''     '#export'ed macros, as DEFINE records at their '#define', the body as type text.
''     A facade's are all of it (RFC-0009): 'fs.PathJoin' is '#define PathJoin FB.PathJoin'.
''   - Strings in the pool are UTF-16, NUL-terminated; offsets count wchars.
''
'' THREADING: every call from ONE thread at a time. Each scan is independent -- nothing is
'' kept between calls -- so the only rule is not to overlap them.

#pragma once

const TKP_VERSION = 5        '' 4: TKP_OPTIONS.pkgDir; 5: unsaved overlays, TKP_FLAG_MODULE_ROOT
const TKP_VERSION_MIN = 4    '' a host built against 4 still passes its shorter TKP_OPTIONS

'' Return codes.
const TKP_OK          = 0
const TKP_E_BADARGS   = -1     '' a required pointer was NULL, or the file name was empty
const TKP_E_VERSION   = -2     '' options.version is not TKP_VERSION

enum TKP_KIND
    TKP_KIND_SUB = 1
    TKP_KIND_FUNCTION
    TKP_KIND_PARAM
    TKP_KIND_TYPE
    TKP_KIND_UNION
    TKP_KIND_FIELD
    TKP_KIND_ENUM
    TKP_KIND_ENUMVAL
    TKP_KIND_VAR
    TKP_KIND_CONST
    TKP_KIND_TYPEDEF
    TKP_KIND_DEFINE
    TKP_KIND_NAMESPACE
end enum

'' TKP_SYMBOL.flags
const TKP_SYMBFLAG_BYREF      = &h0001   '' BYREF parameter, or a 'dim byref'
const TKP_SYMBFLAG_SHARED     = &h0002
const TKP_SYMBFLAG_STATIC     = &h0004
const TKP_SYMBFLAG_UDTTYPE    = &h0008   '' declared AS a TYPE/UNION, directly or through ptr
const TKP_SYMBFLAG_ENUMTYPE   = &h0010   '' declared AS an ENUM
const TKP_SYMBFLAG_LOCAL      = &h0020   '' declared inside a procedure body
const TKP_SYMBFLAG_INSTANCE   = &h0040   '' the implicit THIS
const TKP_SYMBFLAG_OPTIONAL   = &h0080   '' a parameter with a default value
const TKP_SYMBFLAG_ARRAY      = &h0100   '' an array variable or field, or an array parameter
const TKP_SYMBFLAG_REFTRACKED = &h0200   '' readCount/writeCount are MEANINGFUL for this
                                         ''   symbol; when clear they are UNKNOWN -- do not
                                         ''   read 0 as "unused". Clear on every member of
                                         ''   an overload set: a call binds the set's head.
const TKP_SYMBFLAG_EXPORT     = &h0400   '' an EXPORTed procedure: callable from outside
                                         ''   anything this scan can see

type TKP_SYMBOL
    kind         as long       '' TKP_KIND
    flags        as long       '' TKP_SYMBFLAG_*
    nameOffset   as long       '' into stringPool
    typeOffset   as long       '' type as text, into stringPool; -1 if none
    parentIndex  as long       '' owning proc/TYPE/UNION/ENUM/namespace in symbols[]; -1
    fileIndex    as long       '' into fileOffsets[]; -1 if unknown
    lineNum      as long
    colNum       as long
    bodyLine     as long       '' a procedure with a body: its header line, else 0
    bodyEndLine  as long       '' ...and the line its END is on, else 0
    readCount    as long       '' source references that READ it
    writeCount   as long       '' source references that WRITE it (assignment targets)
    refFileIndex as long       '' an exported macro's body names a declaration: its file; else -1
    refLine      as long       '' ...and its line; else 0
end type

type TKP_DIAG
    errNum      as long        '' the TKO number: TKO0743 is 743
    fileIndex   as long        '' -1 if the diagnostic has no location
    lineNum     as long
    textOffset  as long        '' the message, into stringPool
end type

type TKP_RESULT
    version     as long        '' TKP_VERSION
    symbolCount as long
    symbols     as TKP_SYMBOL ptr
    fileCount   as long
    fileOffsets as long ptr    '' filename of file i: @stringPool[fileOffsets[i]]
    diagCount   as long
    diags       as TKP_DIAG ptr
    poolChars   as long        '' total wchars in stringPool
    stringPool  as wstring ptr
end type

'' TKP_OPTIONS.flags
const TKP_FLAG_MODULE_ROOT = 1   '' a file opening '#module' is scanned as its whole module (v5)
type TKP_OPTIONS
    version      as long                '' must be TKP_VERSION
    flags        as long
    includeCount as long
    includePaths as wstring ptr ptr     '' search paths for #include and #import, in order
    defineCount  as long
    defines      as wstring ptr ptr     '' "NAME" or "NAME=VALUE"
    pkgDir       as wstring ptr         '' the toolchain's pkg folder, for '#import "std/..."';
                                        '' NULL = TIKO_PKG, else beside the HOST's executable
    '' version 5: UNSAVED BUFFERS, standing in for those files wherever they are read.
    overlayCount as long
    overlayPaths as wstring ptr ptr     '' each file's path
    overlayTexts as zstring ptr ptr     '' each file's text, UTF-8, NUL-terminated
end type

'' THE ENTRY POINTS, as a host loads them with DYLIBLOAD / GetProcAddress by these
'' names: TIKOPARSER_VERSION, TIKOPARSER_SCAN, TIKOPARSER_SCAN_TEXT, TIKOPARSER_FREE.
''
''   version    the TKP_VERSION the DLL was built with. Ask first; refuse a mismatch.
''   scan       scan the file at wszFile, as the compiler would read it from disk.
''   scan_text  scan pszText (the file's unsaved bytes, any encoding tiko reads) as if it
''              were the file wszName: its folder anchors same-directory #includes.
''   free       release a result. Every result, and only through this.
''
'' Both scans return TKP_OK with a result for a file full of errors: the errors are in
'' diags, and every declaration the front end got through is in symbols.
type TKP_VERSION_FN   as function( ) as long
type TKP_SCAN_FN      as function( byval wszFile as wstring ptr, byval options as TKP_OPTIONS ptr, _
                                   byval ppResult as TKP_RESULT ptr ptr ) as long
type TKP_SCAN_TEXT_FN as function( byval pszText as zstring ptr, byval wszName as wstring ptr, _
                                   byval options as TKP_OPTIONS ptr, _
                                   byval ppResult as TKP_RESULT ptr ptr ) as long
type TKP_FREE_FN      as sub( byval pResult as TKP_RESULT ptr )
