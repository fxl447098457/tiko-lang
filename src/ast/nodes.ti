'' nodes.ti -- the AST node model.
''
'' Nodes live in arenas and are addressed by a 32-bit NodeId, not a pointer
'' (docs/plan/05 section 1 -- decision D7). Every node header is the same 16 bytes, so
'' traversal, dumping and location lookup need no per-kind switch; the variable part
'' lives in a per-kind payload array indexed by the header's 'data' field.
''
'' Invariants:
''   - NodeId 0 is NODE_NONE and refers to nothing.
''   - Every node's loc lies inside a loaded file.
''   - The AST is a TREE. Instantiation produces new subtrees, never shared ones.
''   - An Error node exists only if a diagnostic was emitted for it.

#ifndef __TKO_AST_NODES_BI__
#define __TKO_AST_NODES_BI__

#include once "tko.ti"
#include once "source/location.ti"
#include once "lexer/token.ti"

namespace Tko

    type NodeId as uint32
    const NODE_NONE as NodeId = 0

    '' NODE( name, category )
    #macro TKO_NODE_LIST( NODE )
        NODE( N_ERROR,        NCAT_EXPR )

        '' ---- expressions
        NODE( N_INT_LIT,      NCAT_EXPR )
        NODE( N_FLOAT_LIT,    NCAT_EXPR )
        NODE( N_STRING_LIT,   NCAT_EXPR )
        NODE( N_STRCAT,       NCAT_EXPR )   '' adjacent literals: "a" "b" is one string
        NODE( N_IDENT,        NCAT_EXPR )
        NODE( N_UNARY,        NCAT_EXPR )
        NODE( N_BINARY,       NCAT_EXPR )
        NODE( N_CALL,         NCAT_EXPR )   '' also array indexing, until resolution
        NODE( N_INDEX,        NCAT_EXPR )   '' explicit [ ] form
        NODE( N_MEMBER,       NCAT_EXPR )   '' a.b and a->b
        NODE( N_DEREF,        NCAT_EXPR )   '' *p
        NODE( N_ADDROF,       NCAT_EXPR )   '' @x, varptr, strptr, procptr
        NODE( N_CAST,         NCAT_EXPR )   '' cast/ctype/cptr
        NODE( N_SIZEOF,       NCAT_EXPR )
        NODE( N_TYPEOF,       NCAT_EXPR )
        NODE( N_IIF,          NCAT_EXPR )
        NODE( N_PAREN,        NCAT_EXPR )   '' kept: diagnostics and faithful dumps
        NODE( N_TUPLE,        NCAT_EXPR )
        NODE( N_INITIALIZER,  NCAT_EXPR )   '' { ... }
        '' A CAPTURING LAMBDA'S closure object: the invoke procedure in 'target', one
        '' capture per child (NF_BYREF says which kind), and the generated closure
        '' TYPE's name in 'name'. See lambda.bas.
        NODE( N_CLOSURE,      NCAT_EXPR )
        NODE( N_NEW,          NCAT_EXPR )
        NODE( N_DELETE,       NCAT_EXPR )
        NODE( N_FUNCRESULT,   NCAT_EXPR )
        NODE( N_ELLIPSIS,     NCAT_EXPR )
        NODE( N_ELIDED,       NCAT_EXPR )   '' an ARGUMENT that was left out: 'f( 1, , 3 )'
                                            '' and 'locate ,,0'. A node rather than a
                                            '' gap, because the ARITY has to survive --
                                            '' that call passes three arguments.
        NODE( N_GLOBALSCOPE,  NCAT_EXPR )   '' the '..' of '..x' -- the base of a member
                                            '' access that names the GLOBAL scope, as
                                            '' against '.x', whose base is the open WITH.   '' '...' as an ARRAY BOUND, where the size
                                            '' comes from the initializer. Legal nowhere
                                            '' else, so it is read only in a bound.   '' the FUNCTION/OPERATOR/PROPERTY keyword
                                            '' as an assignment TARGET. Assignable and
                                            '' not readable: fbc rejects 'print function'.

        '' ---- type references (syntactic, not semantic types)
        NODE( N_TYPEREF,      NCAT_TYPE )   '' builtin or named, with ptr/array suffixes

        '' ---- statements
        NODE( N_BLOCK,        NCAT_STMT )   '' a statement list
        NODE( N_AMBIGUOUS,    NCAT_STMT )   '' call-or-assign; the resolver decides (plan 04 s6)
        NODE( N_IF,           NCAT_STMT )
        NODE( N_IF_BRANCH,    NCAT_STMT )   '' one cond + body of an IF/ELSEIF
        NODE( N_SELECT,       NCAT_STMT )
        NODE( N_CASE,         NCAT_STMT )
        NODE( N_CASE_RANGE,   NCAT_STMT )   '' 'a TO b' or 'IS < a'
        NODE( N_PRINT_SEP,    NCAT_STMT )   '' ';' or ',' between PRINT items
        NODE( N_FOR,          NCAT_STMT )
        NODE( N_FOREACH,      NCAT_STMT )
        NODE( N_DO,           NCAT_STMT )
        NODE( N_WHILE,        NCAT_STMT )
        NODE( N_WITH,         NCAT_STMT )
        NODE( N_SCOPE,        NCAT_STMT )
        NODE( N_DEFER,        NCAT_STMT )   '' 'defer <stmt>' -- FBC-Modern, CONTEXTUAL
        NODE( N_SPAWN,        NCAT_STMT )   '' 'spawn f( a )' -- FBC-Modern, CONTEXTUAL
        NODE( N_RETURN,       NCAT_STMT )
        NODE( N_EXIT,         NCAT_STMT )
        NODE( N_END_STMT,     NCAT_STMT )   '' END [exitcode] -- terminates the program
        NODE( N_CONTINUE,     NCAT_STMT )
        NODE( N_GOTO,         NCAT_STMT )
        NODE( N_LABEL,        NCAT_STMT )
        NODE( N_INTRINSIC,    NCAT_STMT )   '' PRINT, OPEN, DRAW ... (plan 04 s5)
        NODE( N_ASM,          NCAT_STMT )   '' parsed only to reject (plan 01 s5.6)
        NODE( N_DELETE_STMT,  NCAT_STMT )   '' 'delete p' / 'delete[] p'
        NODE( N_ASSERT,       NCAT_STMT )   '' '#assert expr' -- compile-time, not PP
        NODE( N_UNDEF,        NCAT_STMT )   '' '#undef name' of a DECLARED symbol
        NODE( N_ERROR_STMT,   NCAT_STMT )

        '' ---- declarations
        NODE( N_MODULE,       NCAT_DECL )
        NODE( N_VAR,          NCAT_DECL )   '' dim/redim/var/static/shared/common/extern
        NODE( N_VAR_ITEM,     NCAT_DECL )   '' one name in a dim list
        NODE( N_CONST,        NCAT_DECL )
        NODE( N_TYPE,         NCAT_DECL )   '' type/union/class
        NODE( N_FIELD,        NCAT_DECL )
        NODE( N_ENUM,         NCAT_DECL )
        NODE( N_ENUM_ITEM,    NCAT_DECL )
        NODE( N_TYPEDEF,      NCAT_DECL )
        NODE( N_PROC,         NCAT_DECL )   '' sub/function/property/ctor/dtor/operator
        NODE( N_PARAM,        NCAT_DECL )
        NODE( N_NAMESPACE,    NCAT_DECL )
        NODE( N_USING,        NCAT_DECL )
        NODE( N_OPTION,       NCAT_DECL )
        NODE( N_EXTERN_BLOCK, NCAT_DECL )
        NODE( N_ERROR_DECL,   NCAT_DECL )
        '' 'interface I ... end interface' (docs/tiko-interfaces): name; 'b' type params;
        '' 'c' an N_BLOCK of the 'inherits' typerefs, first written first; children the
        '' member N_PROCs, all declarations. Last in the list so no kind number moves.
        NODE( N_INTERFACE,    NCAT_DECL )
    #endmacro

    enum NodeCategory
        NCAT_EXPR = 0
        NCAT_TYPE
        NCAT_STMT
        NCAT_DECL
    end enum

    enum NodeKind
        N_NONE = 0
        #define NODE( n_name, n_cat ) n_name,
        TKO_NODE_LIST( NODE )
        #undef NODE
        N_KIND_COUNT
    end enum

    '' Unary and binary operators are the token kind that spelled them, so the parser
    '' does not translate and the dump can print the original spelling.
    type AstNode                    '' 16 bytes
        as uint16    kind
        as uint16    flags
        as SourceLoc loc
        as uint32     data           '' index into this kind's payload array
    end type

    const NF_ARROW      as uint16 = &h0001   '' N_MEMBER used '->'
    const NF_FROM_MACRO as uint16 = &h0002
    const NF_HAS_COMMA  as uint16 = &h0004   '' N_TUPLE / N_PAREN: a comma was present
    const NF_SINGLE_LINE as uint16 = &h0008  '' 'if c then s' rather than a block
    const NF_BYREF      as uint16 = &h0010
    const NF_PTR        as uint16 = &h0020
    const NF_ARRAY      as uint16 = &h0040
    const NF_UNTIL      as uint16 = &h0080   '' N_DO: until rather than while
    const NF_POST_COND  as uint16 = &h0100   '' N_DO: condition on the LOOP
    const NF_IS_UNION   as uint16 = &h0200
    const NF_PARTIAL_TYPE as uint16 = &h0400 '' N_TYPE: written 'partial type' (parser/partialtype.tiko)
    const NF_SHARED     as uint16 = &h0400
    const NF_STATIC     as uint16 = &h0800
    const NF_PRESERVE   as uint16 = &h1000   '' redim preserve
    const NF_CONST      as uint16 = &h2000
    const NF_PROC_TYPE  as uint16 = &h4000   '' N_TYPEREF: 'sub(...)' / 'function(...) as T'
    const NF_QUALIFIED  as uint16 = &h8000   '' N_PROC: 'Stack.Push' -- a member DEFINITION
    '' N_TUPLE: written as 'type( ... )' rather than as a bare '( ... )'.
    ''
    '' THE BIT IS SHARED WITH NF_UNTIL, which is N_DO's and can never appear on an
    '' N_TUPLE -- every bit of the ushort is spoken for, and widening the field to
    '' carry one more would touch every node in the arena. Sharing per NODE KIND is
    '' the same thing the payload fields already do.
    ''
    '' It has to be distinguishable: fbc ACCEPTS 'function = type( 5, 6 )' and REJECTS
    '' 'function = ( 5, 6 )' with error 7, and the two build the same node otherwise.
    const NF_TYPE_LITERAL as uint16 = &h0080

    '' N_BINARY: the comparison ReadCallAssignAsCall_ builds when it re-reads 'f( x ) = v' as
    '' 'f( x = v )', as fbc does -- so Check can give fbc's warning 34 for the one it built and
    '' not for an 'f( x = v )' written that way (T19). Shares NF_HAS_COMMA's bit, which is
    '' N_TUPLE's and N_PAREN's and never an N_BINARY's.
    const NF_FOLDED_EQ as uint16 = &h0004

    '' N_AMBIGUOUS: the assignment was written '=>', which the parser otherwise folds into '='.
    '' 'f( 0 ) => 2' can never be the comparison 'f( 0 = 2 )', so ReadCallAssignAsCall_ leaves
    '' it the byref result's assignment -- measured, fbc stores 2 and does not warn, where
    '' 'f( 0 ) = 3' stores nothing and warns 34 (T19). Shares NF_HAS_COMMA's bit.
    const NF_FAT_ARROW as uint16 = &h0004

    '' N_PARAM: 'byval' was WRITTEN. The passing mode is not decided by the parser --
    '' with neither keyword the default depends on the TYPE, which is not resolved yet
    '' -- so the absence of NF_BYREF cannot mean "byval" on its own.
    ''
    '' Shares its bit with NF_POST_COND, which is N_DO's and can never appear on an
    '' N_PARAM, the same way NF_TYPE_LITERAL shares with NF_UNTIL.
    const NF_BYVAL_WRITTEN as uint16 = &h0100

    '' N_FOREACH: the loop was written with a NAME LIST -- 'for each (k, v) in c'.
    '' The parser rewrites that into the ordinary form plus a 'var' at the top of the
    '' body, so nothing downstream can tell from the shape alone; only the check that
    '' the element really is a tuple of the right arity needs to know, and it is the
    '' one thing the rewrite cannot express.
    ''
    '' Shares its bit with NF_IS_UNION, which is N_TYPE's and can never appear on an
    '' N_FOREACH, the same way NF_TYPE_LITERAL shares with NF_UNTIL.
    const NF_DESTRUCTURE as uint16 = &h0200

    '' PLACEMENT NEW -- 'new( p ) T'. The placement expression is CHILD 0 and the
    '' constructor arguments (or the array count) follow it, so the two uses of the
    '' child list stay exactly as they were for an ordinary 'new'.
    ''
    '' Shares its bit with NF_PRESERVE, which is REDIM's and can never appear on an
    '' N_NEW -- the same sharing NF_TYPE_LITERAL and NF_DESTRUCTURE already do.
    const NF_PLACEMENT as uint16 = &h1000
    '' N_NEW: 'new T[n] { any }', the array left uninitialised. Shares its bit with
    '' NF_HAS_COMMA, which is N_TUPLE's and N_PAREN's and can never appear on an N_NEW.
    const NF_NOINIT as uint16 = &h0004
    '' N_IDENT / N_MEMBER: the name is CALLED, addressed or taken by 'procptr' -- so it is
    '' not a paren-less read, which picks its overload by arity (see ParenlessMethodOf_).
    '' Same bit again: neither kind can carry NF_HAS_COMMA or NF_NOINIT.
    const NF_CALL_TARGET as uint16 = &h0004
    '' N_IDENT: the name is a FUNCTION-LIKE MACRO's, written without '(' -- TF_BARE_FNMACRO.
    '' Resolve binds it to nothing, so it is TKO0743 as it is fbc's error 42. Shares its bit
    '' with NF_SINGLE_LINE, which only an N_IF carries.
    const NF_BARE_MACRO as uint16 = &h0008
    '' N_INTRINSIC: built in EXPRESSION position -- 'r = close( 1 )', not 'close 1'. The node is the
    '' statement's, so nothing else says which to re-read it as (RewriteShadowedIntrinsic_).
    '' Shares NF_HAS_COMMA's bit, which an N_INTRINSIC never carries.
    const NF_INTR_EXPR as uint16 = &h0004
    '' N_IDENT: a statement keyword read again as a call's name (IntrinsicOrCall). Its spelling
    '' is a builtin's, so an unbound one is still undeclared (undeclared.tiko). NF_ARROW's bit,
    '' which only an N_MEMBER carries.
    const NF_KW_CALLEE as uint16 = &h0001
    '' N_PARAM: a TYPED VARIADIC -- 'args( ) as T ...', the last parameter, packed from every
    '' argument past the fixed ones (docs/tiko-params/RFC-0001). Always beside NF_ARRAY: the
    '' callee sees an ordinary array parameter. Same bit again: NF_SINGLE_LINE is N_IF's.
    const NF_VARIADIC as uint16 = &h0008

    '' N_VAR: THE DECLARATION WAS WRITTEN, and its nodes were built where it stands.
    '' The parser also SYNTHESIZES declarations -- a lambda's captures, a spawn's frame,
    '' a select-channel binding, a destructuring 'for each' -- and builds them AFTER the
    '' body they are prepended to, so their node ids run backwards against the statements
    '' below them. Anything reading the arena as a proxy for source order has to ask
    '' first; see MarkShadow_, where a capture came to hide itself from its own body.
    ''
    '' Positive, rather than a 'synthesized' bit, so a synthesizer added later is left
    '' out by default instead of by remembering. Shares its bit with NF_ARROW, which is
    '' N_MEMBER's and can never appear on an N_VAR.
    const NF_DECL_WRITTEN as uint16 = &h0001

    '' N_TUPLE: the target list of 'let ( a, b ) = x' -- FreeBASIC's multiple assignment,
    '' which takes a UDT's fields in order and is NOT tuple destructuring: fbc accepts
    '' 'let ( x, y ) = u' over a UDT and refuses '( x, y ) = u' (371). The parser consumes
    '' LET, so this is the only record of it. Shares NF_SHARED's bit, which is N_VAR's.
    const NF_LET_LIST as uint16 = &h0400

    '' N_PROC reuses StmtPayload.extra as a modifier set. The ushort NF_ flags are
    '' fully allocated, and these are meaningful for exactly one node kind.
    const PF_OVERLOAD   as uint16 = &h0001   '' the OVERLOAD keyword was written
    const PF_CONST      as uint16 = &h0002   '' 'const function T.F( )' -- a const method
    const PF_STATIC     as uint16 = &h0004   '' 'static sub T.S( )' -- no implicit THIS
    const PF_ABSTRACT   as uint16 = &h0008
    const PF_VIRTUAL    as uint16 = &h0010
    const PF_FOREIGN    as uint16 = &h0020   '' inside EXTERN "C" / "Windows" ...
    const PF_PRIVATE    as uint16 = &h0040   '' module-static: no linker-visible name

    '' The calling convention AS WRITTEN. Mutually exclusive, and all three absent means
    '' NONE WAS WRITTEN -- which is not the same as the default: a definition with no
    '' convention inherits its DECLARE's, and fbc refuses one that contradicts it
    '' ("Calling convention does not match DECLARE prototype").
    ''
    '' On win64 the convention has no effect on the emitted name at all -- cdecl,
    '' stdcall and pascal all give plain 'CD', 'ST', 'PA'. On win32 it decides the
    '' decoration, and PASCAL decorates like CDECL rather than like STDCALL, which is
    '' the one part of this a reader will get wrong from first principles.
    const PF_CDECL      as uint16 = &h0080
    const PF_STDCALL    as uint16 = &h0100
    const PF_PASCAL     as uint16 = &h0200

    '' AN ELLIPSIS THE PARSER REFUSED, in 'extra' of its N_PARAM: fbc's error 312, '...'
    '' in a procedure that is not CDECL (parser/typeref.tiko, CheckVarargConv_). The '...'
    '' stays, as fbc keeps it, so the procedure is still variadic to everything after;
    '' the mark only tells Collect the statement has had its one error.
    const PARAM_VARARG_REFUSED as uint16 = 1

    '' Member visibility, from a 'private:' / 'protected:' / 'public:' label in a TYPE
    '' body. Neither bit set is PUBLIC, which is the default fbc gives an unlabelled
    '' member. Carried in StmtPayload.extra on N_FIELD as well as N_PROC, so the name
    '' says member rather than proc -- and note PF_PRIVATE above is a DIFFERENT thing,
    '' module-static linkage, which is why these are not called PF_PRIVATE.
    '' 'function f( ) as long EXPORT' -- the procedure joins the DLL's export table.
    '' The keyword was consumed by the trailing-modifier loop and recorded nowhere,
    '' so fbc emitted 'define dllexport i32 @"AddUp"' where tiko-lang emitted
    '' 'define i32 @"AddUp"' -- measured. A DLL built from that exports nothing.
    ''
    const PF_MEMB_PRIVATE   as uint16 = &h0400
    const PF_MEMB_PROTECTED as uint16 = &h0800

    '' A GENERIC PROCEDURE -- 'function Ok( of T, E )( byval v as T ) as ...'. The
    '' parameter list is currently SKIPPED by the parser, so nothing downstream can
    '' tell the declaration from an ordinary one, and its body lowered as if T were a
    '' real type: aggregates of SIZE ZERO, stores into void slots, a function emitted
    '' under a name no call site will ever use. Recording it is what lets lowering
    '' decline instead of producing that.
    const PF_GENERIC_PROC   as uint16 = &h1000
    '' A procedure TYPE that returns BYREF: 'as function( ) byref as zstring'. The
    '' modifier sits before the AS, which is what made it a parse error rather than
    '' a flag -- the same shape the byref-returning DECLARATION had.
    const PF_BYREF_RESULT   as uint16 = &h2000
    '' A CAPTURING LAMBDA'S '__fbinvoke'. Its FIRST parameter is the closure object,
    '' written by the parser rather than by the source, so nothing may read the
    '' parameter list as the lambda's own.
    const PF_CLOSURE_INVOKE as uint16 = &h4000

    '' 'declare sub f( ) OVERRIDE' -- a TRAILING modifier, and not a reserved word: it
    '' arrives as an identifier and is recognised by spelling, as 'defer' and 'each' are.
    '' Recorded because it is a PROMISE that has to be checked -- fbc's error 223, "Not
    '' overriding any virtual method" -- and the trailing-modifier loop used to consume
    '' it with everything else, so a promise that was not kept said nothing at all.
    const PF_OVERRIDE       as uint16 = &h8000

    '' A TRAILING 'constructor' / 'destructor' -- a MODULE structor, which the C
    '' runtime calls around main. Nothing to do with a UDT's constructor: this is
    '' 'sub f( ) constructor' at module level, which fbcunit's SUITE and TEST macros
    '' use to register every test before main runs.
    ''
    '' PAST BIT 15, which is why StmtPayload.extra is a ULONG.
    const PF_MODCTOR        as uint32 = &h00010000
    const PF_MODDTOR        as uint32 = &h00020000
    '' 'function f( ) as long EXPORT' -- the procedure joins the DLL's export table.
    '' The keyword was consumed by the trailing-modifier loop and recorded nowhere,
    '' so fbc emitted 'define dllexport i32 @"AddUp"' where tiko-lang emitted
    '' 'define i32 @"AddUp"'. A DLL built from that exports nothing.
    ''
    '' &h00040000 AND NOT &h1000, which is where this was first put -- and &h1000 is
    '' PF_GENERIC_PROC. The collision did not error: an exported function was read as
    '' a generic one, generics are not emitted until instantiated, and the module came
    '' out with no functions in it at all. The low sixteen bits are ALL spoken for;
    '' anything added here goes above PF_MODDTOR.
    const PF_EXPORT         as uint32 = &h00040000

    '' INSIDE 'extern "C++"', which is NOT the same as PF_FOREIGN. A foreign block
    '' takes the spelling VERBATIM and ignores OVERLOAD; a C++ one MANGLES, and
    '' mangles the SOURCE SPELLING rather than the uppercased name. Measured:
    ''
    ''     sub g2( byval n as integer )        inside extern "C++"'
    ''         -> _Z2g2u7INTEGER
    ''     sub h( byval n as integer )         outside it
    ''         -> H
    ''
    '' so the two cannot share a bit: reading "C++" as foreign emitted four
    '' overloads all named 'f1' and clang refused the module.
    const PF_CXX            as uint32 = &h00080000
    '' 'public' AND 'private' ON ANY DECLARATION, as written (ADR 0017). PF_PRIVATE above is
    '' the procedure-only meaning fbc gives the keyword; these two record the word on every
    '' kind, for module code, where they decide what an importer may see. High bits,
    '' clear of N_TYPE's packing and N_ENUM's EXPLICIT bit in the same field.
    const PF_VIS_PUBLIC     as uint32 = &h00100000
    const PF_VIS_PRIVATE    as uint32 = &h00200000
    '' A 'lib "name"' CLAUSE: the procedure is a library's export, linked by its own name or
    '' alias -- never nested under a module's chain (ADR 0017 §19).
    const PF_LIB            as uint32 = &h00400000
    '' 'function f( ) as T( )' -- THE RESULT IS A DYNAMIC ARRAY of T. A TIKO EXTENSION: fbc has
    '' no array result. Set by ResultTypeRef_ (parser/declparam.tiko) and read by Resolve, which
    '' wraps the written result type in DynArrayOf( T, 0 ).
    const PF_ARRAY_RESULT   as uint32 = &h00800000
    '' 'sub f( ) static' -- a TRAILING static: every local the body declares is static.
    '' Measured, fbc's 'dim n' there counts 1 2 3 over three calls; tiko swallowed the word
    '' with the other trailing modifiers and the locals started over on every call.
    const PF_STATIC_LOCALS  as uint32 = &h01000000
    '' N_TYPE: 'type T extern "c"' -- A TIKO EXTENSION. The record is laid out by the TARGET'S C
    '' RULE (MSVC on windows-x86_64, SysV on linux-x86_64) instead of fbc's, which differs for
    '' bit-fields and for a packed record's alignment. #cinclude and c2t write it on every
    '' record they emit. A high bit, clear of the packing that shares 'extra'.
    const PF_C_LAYOUT       as uint32 = &h02000000
    '' N_TYPE: written 'class ... end class' (docs/tiko-interfaces). The node is the one
    '' 'type ... extends object' (or the 'inherits' base) builds; only 'end class', the
    '' body's 'inherits' line and the dump read the bit.
    const PF_CLASS          as uint32 = &h04000000
    '' AN AUTO-PROPERTY'S SYNTHESISED ACCESSOR (docs/tiko-properties R8): 'declare property N as T
    '' get, set' in a TYPE. The parser writes the trivial bodies after 'end type' in every unit that
    '' sees the type, so they are emitted weak, as an implicit constructor is (autoprop.tiko).
    const PF_AUTOPROP       as uint32 = &h08000000
    '' ...and its SETTER when the clause is 'get' or 'get, init': only the type's own constructors
    '' may call it (propaccess.tiko, TKO0596).
    const PF_INIT_ONLY      as uint32 = &h10000000
    '' N_TYPE: 'type T as view' (docs/tiko-slices RFC-0002 §3) -- a type that may hold string
    '' slices, and lives only where a slice may: a local, a parameter or a result.
    const PF_VIEW_TYPE      as uint32 = &h20000000
    '' N_VAR's OWN 'extra' (its items carry KW_REDIM in theirs): 'extern import' -- a variable
    '' a DLL exports, reached through its import pointer (T85). See llvmglobal.tiko.
    const VF_DLLIMPORT      as uint32 = &h00000001

    type UnaryPayload
        as uint16 op                '' TokenKind
        as NodeId operand
    end type

    type BinaryPayload
        as uint16 op                '' TokenKind
        as NodeId lhs
        as NodeId rhs
    end type

    type LiteralPayload
        as uint64 intValue
        as float64   fltValue
        as int32     strFile         '' FileId the span indexes -- NOT the node's loc,
                                    '' which macro expansion is free to rewrite
        as int32     strOffset       '' raw span in that buffer
        as int32     strLength
        as uint8    strKind
        as uint8    suffix
        as uint8    radix
        as uint8    strWide         '' a unicode escape in the text -- see Literal.strWide
    end type

    type IdentPayload
        as InternId name            '' folded
        as int32     spellOffset     '' original spelling, in the source buffer
        as int32     spellLength
    end type

    '' Child lists live in ONE shared pool as (offset, count), so no node allocates.
    '' first/count are SIGNED on purpose. With ulong, 'count - 1' underflows to
    '' 4294967295 whenever count is 0, and every loop over an empty child list runs
    '' four billion times. Signed counts make that impossible rather than careful.
    type ListPayload
        as NodeId target            '' callee, base, or 0
        as int32   first             '' index into the child pool
        as int32   count
    end type

    '' The general statement/declaration payload. Slots are named by role rather than
    '' by construct so one record serves every node kind; which slots are meaningful
    '' is documented per kind in parser/stmt.bas.
    '' A calling convention, resolved. CC_NONE is 'none written'.
    enum CallConv
        CC_NONE = 0
        CC_CDECL
        CC_STDCALL
        CC_PASCAL
    end enum

    declare function CallConvOf( byval procFlags as uint16 ) as CallConv
    declare function CallConvName( byval c as CallConv ) as string

    type StmtPayload
        as InternId name            '' declared or referenced name, 0 if none
        as NodeId   a               '' cond / target / typeref / iterator
        as NodeId   b               '' body / init / value
        as NodeId   c               '' else / step / extra
        as int32     first           '' child list, into the shared pool (signed: see ListPayload)
        as int32     count
        as uint16   op              '' keyword that spelled it, for dumps
        '' ULONG, NOT USHORT. All sixteen PF_* bits were allocated, and a trailing
        '' 'constructor' had nowhere to be recorded -- the parser recognised it,
        '' checked it, and then threw it away, so a module constructor was emitted as
        '' an ordinary procedure that nothing ever called. Widening here was cheaper
        '' and more honest than borrowing an NF_* bit that happens to be free for
        '' N_PROC today.
        as uint32    extra           '' levels for EXIT/CONTINUE, intrinsic id, PF_* ...
                                    '' -- and, on an OPEN, its CLAUSE WORDS: see
                                    '' the OPEN_* codes below.
        as InternId aliasName       '' N_PROC: the ALIAS spelling, CASE PRESERVED, or 0
        as InternId ownerName       '' N_PROC: the QUALIFIER of 'Widget.Method' --
                                    '' the last component lands in .name, and without
                                    '' this the type a member belongs to is lost
        as InternId rawName         '' N_PROC: the source spelling, CASE PRESERVED.
                                    '' Identifiers intern FOLDED, so the only record
                                    '' of how a name was written is kept here -- and
                                    '' EXTERN "C" emits exactly what was written.
    end type

    type NodeVec    as containers.Array( of AstNode )
    type UnaryVec   as containers.Array( of UnaryPayload )
    type BinaryVec  as containers.Array( of BinaryPayload )
    type LiteralVec2 as containers.Array( of LiteralPayload )
    type IdentVec   as containers.Array( of IdentPayload )
    type ListVec    as containers.Array( of ListPayload )
    type StmtVec    as containers.Array( of StmtPayload )
    type ChildPool  as containers.Array( of uint32 )
    type NodeIdVec  as containers.Array( of uint32 )   '' a working list of NodeIds

    '' A SIDE TABLE'S NodeId -> index of its NEWEST entry, caught up from 'seen' (the pool
    '' elements indexed so far) on each lookup and rebuilt if the pool ever shrank, so it gives
    '' the backward scan's answer whoever pushed. The scans ran per N_CALL and N_INTRINSIC
    '' Resolve looked at, and a miss -- the normal case -- read the whole table.
    type NodeSideIndex
        as containers.Map( of uint32, int32 ) at_
        as int32 seen
    end type

    type AstArena
    private:
        as NodeVec     nodes        '' index 0 is a permanent N_NONE sentinel
        as UnaryVec    unaries
        as BinaryVec   binaries
        as LiteralVec2 literals
        as IdentVec    idents
        as ListVec     lists
        as StmtVec     stmts
        as ChildPool   children
    public:

        '' THE TOKEN RANGE a declaration was parsed from, for the declarations that
        '' may have to be parsed a SECOND time: a generic's TYPE body and the
        '' out-of-line definitions of its members.
        ''
        '' Instantiating a generic member cannot share the generic's nodes, because
        '' SemanticInfo is keyed by NodeId and two instantiations would write two
        '' different types onto one node. Fresh nodes are the only answer, and a
        '' re-parse is how they are got -- the token buffer only ever grows, so an
        '' index recorded during the first parse stays valid.
        ''
        '' Triples (node, firstTok, lastTok), appended in parse order and found by node
        '' through tokenRangeAt. Only N_TYPE and out-of-line N_PROC definitions are
        '' recorded.
        as ChildPool   tokenRanges

        '' EVERY DECLARATION OF A MODULE UNIT, as (node, firstTok, endTok) triples, endTok
        '' exclusive -- what its interface is written from (ADR 0017, RFC-0004 §3). Kept
        '' apart from tokenRanges, whose readers take every N_TYPE there to be a generic.
        '' Empty outside a module unit.
        as ChildPool   declRanges

        '' TOP-LEVEL NODES CREATED AFTER PARSING -- today, the instantiated members of
        '' a generic. They are not children of the unit's root block, whose child list
        '' was closed when it was built, so every later pass has to walk them
        '' separately or they are typed and never emitted.
        as ChildPool   extraTopLevel

        '' THE TYPE ARGUMENTS AT A CALL SITE -- 'Ok( of Decimal, FinanceError )( v )'.
        ''
        '' A side table rather than a field on the call, because every reader of an
        '' N_CALL expects its target to be an N_IDENT and its children to be arguments;
        '' putting the type list in either place would change a shape a dozen files
        '' already depend on. Triples (call node, first, count) into the shared child
        '' pool, found by node through callTypeArgAt -- every N_CALL asks, and explicit
        '' type arguments are rare, so nearly every question is a miss.
        as ChildPool   callTypeArgs

        '' THE PRIORITY OF A MODULE STRUCTOR -- 'sub f( ) constructor 101'. Pairs (proc
        '' node, priority), only for the ones that WROTE a number; the rest are the
        '' default. A side table for callTypeArgs' reason: StmtPayload has no field
        '' left for an N_PROC that is not already somebody else's.
        as ChildPool   structorPrio

        '' THE 'FB' A SPAWN OR A SELECT CHANNEL WAS GIVEN when the unit did not import std/tasks
        '' (Parse.TasksNs): pairs (node, construct: 0 'spawn', 1 'select channel'). The node
        '' is the qualifier's N_IDENT, or the select context's N_TYPEREF. A program may declare
        '' a stand-in FB.Spawn of its own -- tests/mir/src/spawn.bas does -- so nothing is said
        '' unless it does not resolve; then undeclared.tiko reports TKO0423 for it.
        as ChildPool   tasksQual

        '' COLLECTION INITIALISERS -- 'dim a as Array( of integer ) = { 1, 2 }', a tiko
        '' extension. Triples (item, original brace list, N_BLOCK of the method-call
        '' statements Resolve built for that declarator) in the shared child pool. See
        '' ast/collinit.tiko and symbols/collinit.tiko.
        as ChildPool   collInit

        '' WHERE A PROCEDURE'S BODY ENDS -- pairs (proc node, loc of the last token of its
        '' 'end sub' / 'end function' ...), one per definition with a body. Nothing in the
        '' compiler reads it: the editor scan (src/driver/scan*.bas) does, to answer "which
        '' procedure is the caret in". A side table for structorPrio's reason.
        as ChildPool   procEnds

        '' tokenRanges, callTypeArgs and collInit by node: SideTableFind (ast/collinit.tiko).
        as NodeSideIndex tokenRangeAt
        as NodeSideIndex callTypeArgAt
        as NodeSideIndex collInitAt
        '' 'implements' LISTS (docs/tiko-interfaces): pairs (declaration, N_BLOCK). On an N_TYPE
        '' the block holds one N_TYPEREF per interface its body lists; on an N_PROC, one per
        '' 'implements I.M' entry, the typeref's ownerName naming I and its name M. A side
        '' table so no tree walk reaches the interface names before Resolve knows them.
        '' ast/astimpl.tiko.
        as ChildPool   implementsLists
        as NodeSideIndex implementsAt

        '' WHICH PAYLOAD POOL EACH NODE KIND WAS BUILT IN, as the parser's constructors saw it:
        '' AstPool, POOL_MIXED for a kind built in two. Read only by the -g pool check below.
        as uint8       kindPool(0 to N_KIND_COUNT - 1)

        declare constructor( )
        declare sub RecordTokens _
            ( byval id as NodeId, byval firstTok as int32, byval lastTok as int32 )
        '' False when nothing was recorded for this node, which is the normal case.
        declare function TokensOf _
            ( byval id as NodeId, byref firstTok as int32, byref lastTok as int32 ) as boolean
        declare sub RecordProcEnd( byval id as NodeId, byval endLoc as SourceLoc )
        declare sub RecordCallTypeArgs _
            ( byval id as NodeId, byval firstArg as int32, byval argCount as int32 )
        '' False when the call carried none, which is the normal case.
        declare function CallTypeArgsOf _
            ( byval id as NodeId, byref firstArg as int32, byref argCount as int32 ) as boolean
        declare function Kind( byval id as NodeId ) as NodeKind
        declare function Loc( byval id as NodeId ) as SourceLoc
        declare function Count( ) as int32

        '' TYPED PAYLOAD ACCESS (review ARCH-11, LATER-PLAN F). A node's 'data' indexes ONE of
        '' the pools above, chosen by how it was built, and nothing but the reader's memory said
        '' which: a list node's index read as a statement index is a valid-looking record from
        '' the wrong pool (latesweeps4.tiko records that abort). Each of these reads one pool,
        '' and in a -g build of the compiler checks the pool the node's kind was built in and
        '' stops at the first wrong read (AstPoolFault). One index each: they inline.
        declare function StmtOf( byval id as NodeId ) as StmtPayload ptr
        declare function IdentOf( byval id as NodeId ) as IdentPayload ptr
        declare function ListOf( byval id as NodeId ) as ListPayload ptr
        declare function UnaryOf( byval id as NodeId ) as UnaryPayload ptr
        declare function BinaryOf( byval id as NodeId ) as BinaryPayload ptr
        declare function LiteralOf( byval id as NodeId ) as LiteralPayload ptr
        '' Child 'i' of a list or statement whose children start at 'first' in the shared pool.
        declare function ChildAt( byval first as int32, byval i as int32 ) as NodeId
        declare function Flags( byval id as NodeId ) as uint16
        '' THE NODE RECORD, for the passes that build or rewrite one in place (the parser, Resolve's
        '' rewrites, generic instantiation). Nothing outside src/ast indexes 'nodes' itself -- lint
        '' rule 15 -- so a reader cannot take a node's 'data' to the wrong pool by hand.
        declare function DataOf( byval id as NodeId ) as uint32
        declare function NodeAt( byval id as NodeId ) as AstNode ptr
        declare sub OrFlags( byval id as NodeId, byval f as uint16 )
        declare sub SetKind( byval id as NodeId, byval k as uint16 )
        declare sub SetLoc( byval id as NodeId, byval l as SourceLoc )
        declare sub SetData( byval id as NodeId, byval d as uint32 )
        '' THE POOLS THEMSELVES, by index -- for the code that BUILDS nodes (the parser, Resolve's
        '' rewrites, generic instantiation) and the few readers that hold a payload index rather
        '' than a node. The pools are private (review ARCH-11, LATER-PLAN F step 3): these are the
        '' only way in, so a read by node goes through StmtOf and its siblings, and the -g check.
        declare function StmtAt( byval i as int32 ) as StmtPayload ptr
        declare sub PushStmt( byref v as StmtPayload )
        declare function StmtPoolCount( ) as int32
        declare function ListAt( byval i as int32 ) as ListPayload ptr
        declare sub PushList( byref v as ListPayload )
        declare function ListPoolCount( ) as int32
        declare function IdentAt( byval i as int32 ) as IdentPayload ptr
        declare sub PushIdent( byref v as IdentPayload )
        declare function IdentPoolCount( ) as int32
        declare function UnaryAt( byval i as int32 ) as UnaryPayload ptr
        declare sub PushUnary( byref v as UnaryPayload )
        declare function UnaryPoolCount( ) as int32
        declare function BinaryAt( byval i as int32 ) as BinaryPayload ptr
        declare sub PushBinary( byref v as BinaryPayload )
        declare function BinaryPoolCount( ) as int32
        declare function LiteralAt( byval i as int32 ) as LiteralPayload ptr
        declare sub PushLiteral( byref v as LiteralPayload )
        declare function LiteralPoolCount( ) as int32
        declare function ChildSlot( byval i as int32 ) as uint32
        declare sub SetChildSlot( byval i as int32, byval v as uint32 )
        declare sub PushChild( byval v as uint32 )
        declare function ChildPoolCount( ) as int32
        declare sub PushNode( byref n as AstNode )
        '' Every node slot, the N_NONE sentinel at 0 included -- Count( ) is one fewer.
        declare function NodePoolCount( ) as int32
    end type

    enum AstPool
        POOL_NONE = 0
        POOL_UNARY
        POOL_BINARY
        POOL_LITERAL
        POOL_IDENT
        POOL_LIST
        POOL_STMT
        POOL_MIXED = 255
    end enum

    '' A -g build's pool check failed: says which node, kind and pools, and ends the process.
    declare sub AstPoolFault( byval id as NodeId, byval kind as NodeKind, byval want as AstPool, _
                              byval got as AstPool )

    #macro AST_POOL_CHECK_( want_ )
        #if __FB_DEBUG__
            scope
                dim as NodeKind k__ = cast( NodeKind, this.nodes[cast( int32, id )].kind )
                dim as uint8 got__ = this.kindPool(k__)
                if (got__ <> POOL_NONE) andalso (got__ <> POOL_MIXED) andalso (got__ <> (want_)) then
                    AstPoolFault( id, k__, want_, cast( AstPool, got__ ) )
                end if
            end scope
        #endif
    #endmacro

    private function AstArena.StmtOf( byval id as NodeId ) as StmtPayload ptr
        AST_POOL_CHECK_( POOL_STMT )
        return @this.stmts[cast( int32, this.nodes[cast( int32, id )].data )]
    end function
    private function AstArena.IdentOf( byval id as NodeId ) as IdentPayload ptr
        AST_POOL_CHECK_( POOL_IDENT )
        return @this.idents[cast( int32, this.nodes[cast( int32, id )].data )]
    end function
    private function AstArena.ListOf( byval id as NodeId ) as ListPayload ptr
        AST_POOL_CHECK_( POOL_LIST )
        return @this.lists[cast( int32, this.nodes[cast( int32, id )].data )]
    end function
    private function AstArena.UnaryOf( byval id as NodeId ) as UnaryPayload ptr
        AST_POOL_CHECK_( POOL_UNARY )
        return @this.unaries[cast( int32, this.nodes[cast( int32, id )].data )]
    end function
    private function AstArena.BinaryOf( byval id as NodeId ) as BinaryPayload ptr
        AST_POOL_CHECK_( POOL_BINARY )
        return @this.binaries[cast( int32, this.nodes[cast( int32, id )].data )]
    end function
    private function AstArena.LiteralOf( byval id as NodeId ) as LiteralPayload ptr
        AST_POOL_CHECK_( POOL_LITERAL )
        return @this.literals[cast( int32, this.nodes[cast( int32, id )].data )]
    end function
    private function AstArena.ChildAt( byval first as int32, byval i as int32 ) as NodeId
        return cast( NodeId, this.children[first + i] )
    end function
    private function AstArena.Flags( byval id as NodeId ) as uint16
        return this.nodes[cast( int32, id )].flags
    end function
    private function AstArena.DataOf( byval id as NodeId ) as uint32
        return this.nodes[cast( int32, id )].data
    end function
    private function AstArena.NodeAt( byval id as NodeId ) as AstNode ptr
        return @this.nodes[cast( int32, id )]
    end function
    private sub AstArena.OrFlags( byval id as NodeId, byval f as uint16 )
        this.nodes[cast( int32, id )].flags or= f
    end sub
    private sub AstArena.SetKind( byval id as NodeId, byval k as uint16 )
        this.nodes[cast( int32, id )].kind = k
    end sub
    private sub AstArena.SetLoc( byval id as NodeId, byval l as SourceLoc )
        this.nodes[cast( int32, id )].loc = l
    end sub
    private sub AstArena.SetData( byval id as NodeId, byval d as uint32 )
        this.nodes[cast( int32, id )].data = d
    end sub
    private function AstArena.StmtAt( byval i as int32 ) as StmtPayload ptr
        return @this.stmts[i]
    end function
    private sub AstArena.PushStmt( byref v as StmtPayload )
        this.stmts.Push( v )
    end sub
    private function AstArena.StmtPoolCount( ) as int32
        return this.stmts.Count
    end function
    private function AstArena.ListAt( byval i as int32 ) as ListPayload ptr
        return @this.lists[i]
    end function
    private sub AstArena.PushList( byref v as ListPayload )
        this.lists.Push( v )
    end sub
    private function AstArena.ListPoolCount( ) as int32
        return this.lists.Count
    end function
    private function AstArena.IdentAt( byval i as int32 ) as IdentPayload ptr
        return @this.idents[i]
    end function
    private sub AstArena.PushIdent( byref v as IdentPayload )
        this.idents.Push( v )
    end sub
    private function AstArena.IdentPoolCount( ) as int32
        return this.idents.Count
    end function
    private function AstArena.UnaryAt( byval i as int32 ) as UnaryPayload ptr
        return @this.unaries[i]
    end function
    private sub AstArena.PushUnary( byref v as UnaryPayload )
        this.unaries.Push( v )
    end sub
    private function AstArena.UnaryPoolCount( ) as int32
        return this.unaries.Count
    end function
    private function AstArena.BinaryAt( byval i as int32 ) as BinaryPayload ptr
        return @this.binaries[i]
    end function
    private sub AstArena.PushBinary( byref v as BinaryPayload )
        this.binaries.Push( v )
    end sub
    private function AstArena.BinaryPoolCount( ) as int32
        return this.binaries.Count
    end function
    private function AstArena.LiteralAt( byval i as int32 ) as LiteralPayload ptr
        return @this.literals[i]
    end function
    private sub AstArena.PushLiteral( byref v as LiteralPayload )
        this.literals.Push( v )
    end sub
    private function AstArena.LiteralPoolCount( ) as int32
        return this.literals.Count
    end function
    private function AstArena.ChildSlot( byval i as int32 ) as uint32
        return this.children[i]
    end function
    private sub AstArena.SetChildSlot( byval i as int32, byval v as uint32 )
        this.children[i] = v
    end sub
    private sub AstArena.PushChild( byval v as uint32 )
        this.children.Push( v )
    end sub
    private function AstArena.ChildPoolCount( ) as int32
        return this.children.Count
    end function
    private sub AstArena.PushNode( byref n as AstNode )
        this.nodes.Push( n )
    end sub
    private function AstArena.NodePoolCount( ) as int32
        return this.nodes.Count
    end function

    declare function NodeKindName( byval k as NodeKind ) as string

    '' ast/collinit.tiko.
    declare sub RecordCollInit _
        ( byref ast as AstArena, byval item as NodeId, byval braces as NodeId, _
          byval block as NodeId )
    declare function CollInitOf( byref ast as AstArena, byval item as NodeId ) as NodeId
    '' ast/astimpl.tiko: AstArena.implementsLists.
    declare sub RecordImplements( byref ast as AstArena, byval decl as NodeId, byval list as NodeId )
    declare function ImplementsOf( byref ast as AstArena, byval decl as NodeId ) as NodeId
    '' The index of the newest 'stride'-wide entry of 'pool' whose first element is id, or -1.
    declare function SideTableFind _
        ( byref ix as NodeSideIndex, byref pool as ChildPool, byval stride as int32, _
          byval id as NodeId ) as int32

    declare function NodeKindCategory( byval k as NodeKind ) as NodeCategory

    '' OPEN's clause words, packed into StmtPayload.extra on the N_INTRINSIC node.
    ''
    '' EVERY ONE IS A SMALL INTEGER TO FBC rather than a separate entry point -- mode,
    '' access and lock all ride in the fb_FileOpen argument list -- and the numbering was
    '' MEASURED from fbc's own C output, not guessed:
    ''
    ''   mode    BINARY 0  RANDOM 1  INPUT 2  OUTPUT 3  APPEND 4
    ''   access  (none) 0  READ 1    WRITE 2  READ WRITE 3
    ''   lock    (none) 0  READ 1    WRITE 2  READ WRITE 3
    ''
    '' OMITTING 'FOR' IS NOT MODE 0. It is RANDOM, mode 1 -- the same code the word
    '' RANDOM gives -- so a missing clause and a written one are indistinguishable by
    '' design. 'SHARED' likewise compiles to lock 0, indistinguishable from writing no
    '' LOCK at all, and the default record length is 0 rather than 128.
    ''
    '' Here rather than beside either user because the parser packs these bits and
    '' lowering unpacks them, and two spellings of the same field would drift.
    const OPEN_MODE_MASK     as uint16 = &h0007
    const OPEN_ACCESS_SHIFT  as int32   = 3
    const OPEN_ACCESS_MASK   as uint16 = &h0018
    const OPEN_LOCK_SHIFT    as int32   = 5
    const OPEN_LOCK_MASK     as uint16 = &h0060
    const OPEN_HAS_ENCODING  as uint16 = &h0080

end namespace

#endif
