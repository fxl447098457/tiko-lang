'' proccheck.tiko -- WHAT A PROCEDURE DEFINITION AND AN INDEX EXPRESSION MAY NOT SAY.
''
'' Split out of visibility.tiko at the 1500-line lint cap and included from it, inside its
'' namespace, after the helpers it calls and before Walk_.

'' CONST AND STATIC ON A DEFINITION MUST AGREE WITH THE DECLARATION -- fbc errors 218 and
'' 217, "CONST used here" / "STATIC used here". MEASURED, all six ways: a modifier the
'' declaration did not have is refused; one it did have may be repeated or left off.
'' The same shape as the byref-result agreement below, and read the same way: the symbol
'' the definition bound points at the declaration node.
sub CheckModifierAgrees_ ( byref c as Ctx, byval id as NodeId )
    dim as StmtPayload ptr sp = _
        c.ast->StmtOf( id )
    if sp->b = NODE_NONE then return
    dim as Symbol ptr s = c.syms->SymbolAt( c.info->RefOf( id ) )
    if s = nullptr then return
    dim as NodeId decl = cast( NodeId, s->payload )
    if (decl = NODE_NONE) orelse (decl = id) then return
    if c.ast->Kind( decl ) <> N_PROC then return
    dim as StmtPayload ptr dp = _
        c.ast->StmtOf( decl )
    if ((sp->extra and PF_STATIC) <> 0) andalso ((dp->extra and PF_STATIC) = 0) then
        c.diags->Report( TKO0696, PointRange( c.ast->Loc( id ) ), "STATIC" )
    end if
    if ((sp->extra and PF_CONST) <> 0) andalso ((dp->extra and PF_CONST) = 0) then
        c.diags->Report( TKO0696, PointRange( c.ast->Loc( id ) ), "CONST" )
    end if
    '' ...AND VIRTUAL / ABSTRACT -- fbc's errors 219 and 220, "VIRTUAL used here, but
    '' not in the DECLARE statement". Measured over 'virtual sub UDT.f( )' against a
    '' plain 'declare sub f( )'; with 'declare virtual sub f( )' it is accepted.
    if ((sp->extra and PF_VIRTUAL) <> 0) andalso _
       ((dp->extra and (PF_VIRTUAL or PF_ABSTRACT)) = 0) then
        c.diags->Report( TKO0696, PointRange( c.ast->Loc( id ) ), "VIRTUAL" )
    end if
    if ((sp->extra and PF_ABSTRACT) <> 0) andalso ((dp->extra and PF_ABSTRACT) = 0) then
        c.diags->Report( TKO0696, PointRange( c.ast->Loc( id ) ), "ABSTRACT" )
    end if
    '' ...AND A BODY FOR A METHOD THE DECLARATION CALLED ABSTRACT -- fbc error 224 --
    '' whether or not the definition repeats the word. CheckAbstractBody_ sees only the
    '' definition's own modifiers.
    if ((dp->extra and PF_ABSTRACT) <> 0) andalso ((sp->extra and PF_ABSTRACT) = 0) then
        c.diags->Report( TKO0646, PointRange( c.ast->Loc( id ) ), _
                         c.names->Spelling( sp->name ) )
    end if
end sub

'' SOME OPERATORS ARE MEMBERS OR NOTHING -- fbc error 152, "Operator must be a member
'' function". MEASURED at module level: 'let', 'cast', '[]' and the compound assignments
'' are refused, while a binary '+' is the ordinary free operator and is accepted.
sub CheckMemberOnlyOperator_ ( byref c as Ctx, byval id as NodeId )
    dim as StmtPayload ptr sp = _
        c.ast->StmtOf( id )
    if cast( TokenKind, sp->op ) <> KW_OPERATOR then return
    if (c.ast->Flags( id ) and NF_QUALIFIED) <> 0 then return
    if ProcOwner_( c, id ) <> TYPE_NONE then return
    dim as string nm = Text.LowerAscii( c.names->Spelling( sp->name ) )
    dim as boolean memberOnly = false
    select case nm
    '' NOT '->': a GLOBAL 'operator ->' is legal, and fb/comptr.bi, fb/sharedptr.bi and
    '' four of this suite's own MIR tests define one. Listing it refused all fourteen
    '' corpus files that include those headers.
    case "let", "cast", "[]", "+=", "-=", "*=", "/=", "\=", "^=", "&=", _
         "mod=", "shl=", "shr=", "and=", "or=", "xor=", "eqv=", "imp="
        memberOnly = true
    '' ...AND '@', 'new', 'delete', their '[]' forms and the FOR protocol -- measured
    '' 2026-09-19, each one 152 at module level on fbc-modern 1.20 and 1.10.1.
    case "@", "new", "new[]", "delete", "delete[]", "for", "step", "next"
        memberOnly = true
    end select
    if memberOnly = false then return
    c.diags->Report( TKO0697, PointRange( c.ast->Loc( id ) ), nm )
end sub

'' ...AND THE REST ARE NEVER MEMBERS -- fbc error 153, "Operator cannot be a member
'' function": every arithmetic, comparison and logical operator, the unary functions
'' ('not', 'abs', 'len' ...) and '->', which is legal only as a global. Measured
'' 2026-09-19, each one declared inside a type, fbc-modern 1.20 and 1.10.1 agreeing.
sub CheckNonMemberOperator_ ( byref c as Ctx, byval id as NodeId )
    dim as StmtPayload ptr sp = _
        c.ast->StmtOf( id )
    if cast( TokenKind, sp->op ) <> KW_OPERATOR then return
    '' A MEMBER is one whose owner is a TYPE. A dotted name alone does not say so:
    '' 'operator op.+( ... )' over a NAMESPACE op is a global operator
    '' (tests/mir/namespace-operator.bas), while 'operator T.cast( )' is T's.
    dim as string nm = Text.LowerAscii( c.names->Spelling( sp->name ) )
    '' 'andalso' and 'orelse' are overloadable NOWHERE -- fbc's 157, member or global.
    if (nm = "andalso") orelse (nm = "orelse") then
        c.diags->Report( TKO0792, PointRange( c.ast->Loc( id ) ), nm )
        return
    end if
    dim as boolean isMember = (ProcOwner_( c, id ) <> TYPE_NONE)
    if isMember = false then return
    select case nm
    case "+", "-", "*", "/", "\", "mod", "shl", "shr", "and", "or", "xor", "imp", "eqv", _
         "^", "&", "=", "<>", "<", ">", "<=", ">=", "not", "abs", "sgn", "fix", "frac", _
         "int", "exp", "log", "sin", "asin", "cos", "acos", "tan", "atn", "len", "->"
        c.diags->Report( TKO0790, PointRange( c.ast->Loc( id ) ), nm )
    end select
end sub

'' AN OPERATOR TAKES AS MANY OPERANDS AS IT HAS -- fbc error 1, "Argument count mismatch".
'' A MEMBER's own object is implicit: 'let' and the compound assignments, '[]', 'new',
'' 'new[]', 'delete' and 'delete[]' take one; 'cast' none; 'for' and 'step' at most one;
'' 'next' one or two. A GLOBAL binary operator takes two -- '+', '-' and '*' one or two,
'' being unary as well -- and a global unary one ('not', 'abs', 'len', '->' ...) one.
'' Measured 2026-09-19 on fbc-modern 1.20 and 1.10.1, for declarations and for members
'' defined outside their type; tiko-lang accepted every count. What fbc refuses for other
'' reasons -- a member '+', a global '@', 'andalso' -- is not asked here.
sub CheckOperatorArity_ ( byref c as Ctx, byval id as NodeId )
    dim as StmtPayload ptr sp = _
        c.ast->StmtOf( id )
    if cast( TokenKind, sp->op ) <> KW_OPERATOR then return
    dim as int32 n = 0
    for i as int32 = 0 to sp->count - 1
        if c.ast->Kind( c.ast->ChildAt( sp->first, i ) ) = N_PARAM then n += 1
    next
    '' A MEMBER is one whose owner is a TYPE. A dotted name alone does not say so:
    '' 'operator op.+( ... )' over a NAMESPACE op is a global operator
    '' (tests/mir/namespace-operator.bas), while 'operator T.cast( )' is T's.
    dim as boolean isMember = (ProcOwner_( c, id ) <> TYPE_NONE)
    dim as string nm = Text.LowerAscii( c.names->Spelling( sp->name ) )
    dim as int32 lo = -1, hi = -1
    if isMember then
        select case nm
        case "let", "+=", "-=", "*=", "/=", "\=", "^=", "&=", "mod=", "shl=", "shr=", _
             "and=", "or=", "xor=", "eqv=", "imp=", "[]", "new", "new[]", "delete", "delete[]"
            lo = 1 : hi = 1
        case "cast"
            lo = 0 : hi = 0
        case "for", "step"
            lo = 0 : hi = 1
        case "next"
            lo = 1 : hi = 2
        end select
    else
        select case nm
        case "=", "<>", "<", ">", "<=", ">=", "/", "\", "mod", "shl", "shr", "and", "or", _
             "xor", "imp", "eqv", "^", "&"
            lo = 2 : hi = 2
        case "+", "-", "*"
            lo = 1 : hi = 2
        case "not", "abs", "sgn", "fix", "frac", "int", "exp", "log", "sin", "asin", "cos", _
             "acos", "tan", "atn", "len", "->"
            lo = 1 : hi = 1
        end select
    end if
    if lo < 0 then return
    if (n >= lo) andalso (n <= hi) then return
    dim as string want = str( lo )
    if hi <> lo then want &= " or " & str( hi )
    c.diags->Report( TKO0789, PointRange( c.ast->Loc( id ) ), nm, want )
end sub

'' '[ ]' IS POINTER INDEXING, and needs a pointer -- fbc error 28, "Expected pointer".
'' Measured: 'n[0]' over an integer and 'x[0]' over a UDT with no 'operator []' are
'' refused; 'p[0]' over a pointer and 's[0]' over a STRING are the ordinary uses. A UDT
'' that declares 'operator []' is left alone: that is the other ordinary use.
sub CheckIndexNeedsPointer_ ( byref c as Ctx, byval id as NodeId )
    dim as ListPayload ptr lp = _
        c.ast->ListOf( id )
    if lp->target = NODE_NONE then return
    if lp->count = 0 then return
    dim as TypeId t = c.info->TypeOf_( lp->target )
    if t = TYPE_NONE then return
    dim as TypeId u = c.types->Unqualify( t )
    if c.types->Kind( u ) = TK_REFERENCE then u = c.types->Unqualify( c.types->Inner( u ) )
    select case c.types->Kind( u )
    case TK_POINTER, TK_ARRAY
        return
    case TK_UDT
        if StructorOf_( c, u, "[]" ) <> nullptr then return
        if Tko.Slices.SliceUnitOfType( *c.types, *c.names, u ) <> Tko.Slices.SU_NONE then return   '' 'v[i]' over a string slice
    case TK_BUILTIN
        select case c.types->BuiltinOf( u )
        case TY_STRING, TY_ZSTRING, TY_WSTRING, TY_USTRING, TY_FIXSTR, TY_FIXUSTR
            return
        end select
    case else
        return
    end select
    c.diags->Report( TKO0700, PointRange( c.ast->Loc( id ) ) )
end sub


'' 'new zstring' AND 'new wstring' HAVE NOTHING TO ALLOCATE -- fbc error 28, "Expected
'' pointer" -- and so do their vector forms 'new zstring[10]'; a FIXED one, 'new zstring
'' * 10' or 'new string * 10', is error 201, "The NEW operator cannot be used with
'' fixed-length strings". 'new string' and 'new integer' are the ordinary uses.
sub CheckNewString_ ( byref c as Ctx, byval id as NodeId )
    dim as ListPayload ptr lp = _
        c.ast->ListOf( id )
    if lp->target = NODE_NONE then return
    dim as TypeId t = c.info->TypeOf_( lp->target )
    if t = TYPE_NONE then return
    dim as TypeId u = c.types->Unqualify( t )
    if c.types->IsInterface( u ) then                                 '' docs/tiko-interfaces
        c.diags->Report( TKO1007, PointRange( c.ast->Loc( id ) ), c.types->Name( u ) )
        return
    end if
    '' 'new T' AND 'new T[n]' CONSTRUCT BY DEFAULT -- fbc's 183 over a type with
    '' constructors but none taking no argument, '{ any }' included. tiko built them
    '' and called nothing. The placement buffer is not a constructor argument.
    if c.types->Kind( u ) = TK_UDT then
        dim as int32 nArgs = lp->count
        if (c.ast->Flags( id ) and NF_PLACEMENT) <> 0 then nArgs -= 1
        dim as boolean isArr = ((c.ast->Flags( id ) and NF_ARRAY) <> 0)
        if (isArr orelse cbool( nArgs <= 0 )) andalso (HasDefaultCtor_( c, u, false ) = false) then
            c.diags->Report( TKO0657, PointRange( c.ast->Loc( id ) ), c.names->Spelling( c.types->NameOf( u ) ) )
        end if
        return
    end if
    if c.types->Kind( u ) = TK_ARRAY then
        '' A fixed-length string is an array of a character builtin.
        dim as TypeId el = c.types->Unqualify( c.types->Inner( u ) )
        if c.types->Kind( el ) <> TK_BUILTIN then return
        select case c.types->BuiltinOf( el )
        case TY_ZSTRING, TY_WSTRING, TY_FIXSTR, TY_FIXUSTR
            c.diags->Report( TKO0706, PointRange( c.ast->Loc( id ) ) )
        end select
        return
    end if
    if c.types->Kind( u ) <> TK_BUILTIN then return
    select case c.types->BuiltinOf( u )
    case TY_ZSTRING, TY_WSTRING
        c.diags->Report( TKO0705, PointRange( c.ast->Loc( id ) ) )
    case TY_STRING
        '' 'new string( any )' AND 'new string[10] { any }' -- fbc error 24, measured on
        '' fbc-modern 1.20, 2026-09-29 (pointers/new-string-anyinit.bas, new-vector-...). A
        '' STRING is a descriptor that must start empty; an integer or a ustring takes 'any'.
        dim as uint16 fl = c.ast->Flags( id )
        dim as boolean anyInit = ((fl and NF_NOINIT) <> 0)
        dim as int32 a0 = iif( (fl and NF_PLACEMENT) <> 0, 1, 0 )
        if (anyInit = false) andalso ((fl and NF_ARRAY) = 0) andalso (lp->count = a0 + 1) then
            dim as NodeId an = c.ast->ChildAt( lp->first, a0 )
            if c.ast->Kind( an ) = N_IDENT then
                anyInit = (lcase( c.names->Spelling( c.ast->IdentOf( an )->name ) ) = "any")
            end if
        end if
        if anyInit then c.diags->Report( TKO0885, PointRange( c.ast->Loc( id ) ) )
    end select
end sub

'' 'not p' OVER A POINTER -- fbc error 20, "Type mismatch". A pointer is compared, not
'' negated: 'if p = 0' is the spelling. Measured against 'not n' over an integer, which is
'' the ordinary bitwise use.
sub CheckNotPointer_ ( byref c as Ctx, byval id as NodeId )
    dim as UnaryPayload ptr up = _
        c.ast->UnaryOf( id )
    if cast( TokenKind, up->op ) <> KW_NOT then return
    if up->operand = NODE_NONE then return
    dim as TypeId t = c.info->TypeOf_( up->operand )
    if t = TYPE_NONE then return
    if c.types->Kind( c.types->Unqualify( t ) ) <> TK_POINTER then return
    c.diags->Report( TKO0707, PointRange( c.ast->Loc( id ) ) )
end sub

'' 'p += 1' OVER A PROCEDURE POINTER -- fbc error 20. The binary '+' was already refused
'' (TKO0646); the compound spelling reached lowering. 'ip += 1' over a data pointer is
'' the ordinary use.
sub CheckProcPtrCompound_ ( byref c as Ctx, byval id as NodeId )
    dim as StmtPayload ptr sp = _
        c.ast->StmtOf( id )
    select case cast( TokenKind, sp->op )
    case TK_PLUSEQ, TK_MINUSEQ
    case else
        return
    end select
    if sp->a = NODE_NONE then return
    if IsProcPtr_( c, c.info->TypeOf_( sp->a ) ) = false then return
    c.diags->Report( TKO0646, PointRange( c.ast->Loc( id ) ) )
end sub

'' A GRAPHICS STATEMENT'S IMAGE TARGET IS A POINTER -- 'line img, (0,0)-(1,1), c' draws
'' into what 'img' points at. MEASURED: an 'any ptr' or 'ubyte ptr' target is accepted,
'' an integer, a string or any other non-pointer builtin is fbc error 28 ("Expected
'' pointer"), and a UDT is accepted only when it declares 'operator cast( ) as any ptr'
'' (otherwise error 99). PSET, PUT and CIRCLE measure the same as LINE.
''
'' The parser marks a written target with GFX_HASTARGET in 'extra' and keeps it in 'a';
'' the flag is read here under its own name because gfx.bas is not visible from this pass.
const VIS_GFX_HASTARGET as uint16 = &h0200

sub CheckGfxTarget_ ( byref c as Ctx, byval id as NodeId )
    dim as StmtPayload ptr sp = _
        c.ast->StmtOf( id )
    select case cast( TokenKind, sp->op )
    case KW_LINE, KW_PSET, KW_CIRCLE, KW_PAINT, KW_GET, KW_PUT, KW_DRAW
    case else
        return
    end select
    if (sp->extra and VIS_GFX_HASTARGET) = 0 then return
    if sp->a = NODE_NONE then return
    dim as TypeId t = c.info->TypeOf_( sp->a )
    if t = TYPE_NONE then return
    '' THE TARGET IS WRITTEN, so a CONST one is fbc's 119 -- 'dim p as const any ptr' or
    '' 'as const FB.IMAGE ptr' handed to LINE or GET. Measured: those two refuse a const
    '' image while imagedestroy, imageinfo and PUT's SOURCE image take one.
    dim as TypeId pt = c.types->Unqualify( t )
    if c.types->Kind( pt ) = TK_POINTER then
        if c.types->IsConst( c.types->Inner( pt ) ) then
            c.diags->Report( TKO0617, PointRange( c.ast->Loc( sp->a ) ), _
                             "the image target" )
            return
        end if
    end if
    dim as TypeId u = c.types->Unqualify( t )
    if c.types->Kind( u ) = TK_REFERENCE then u = c.types->Unqualify( c.types->Inner( u ) )
    select case c.types->Kind( u )
    case TK_POINTER
        return
    case TK_UDT
        '' A CONVERSION OPERATOR MAY SUPPLY THE POINTER, and which one is a question of
        '' overload choice this pass does not model -- any 'cast' at all is enough to
        '' decline.
        '' ...AND IT MUST BE ONE CAST TO A POINTER, exactly -- measured on fbc-modern 1.20,
        '' 2026-09-30: a type whose only cast is 'as string' or 'as integer' is fbc's 99, and
        '' one with 'as ubyte ptr' and 'as ulong ptr' both is its 98 (gfx/image-expr-cast-
        '' overload-nomatch and -ambigious). Any other cast beside the one is fine.
        '' ...unless one of them is 'as any ptr', the exact match, which fbc takes over the rest
        '' (gfx/image-expr.bas: 'as any ptr' beside 'as FB.IMAGE ptr').
        dim as int32 ptrCasts = 0
        dim as boolean anyPtr = false
        dim as Symbol ptr gcs = StructorOf_( c, u, "cast" )
        for guard as int32 = 0 to 63
            if gcs = nullptr then exit for
            dim as TypeId grt = c.types->Unqualify( gcs->type_ )
            if c.types->Kind( grt ) = TK_REFERENCE then grt = c.types->Unqualify( c.types->Inner( grt ) )
            if c.types->Kind( grt ) = TK_POINTER then
                ptrCasts += 1
                dim as TypeId gin = c.types->Unqualify( c.types->Inner( grt ) )
                if (c.types->Kind( gin ) = TK_BUILTIN) andalso (c.types->BuiltinOf( gin ) = TY_ANY) then anyPtr = true
            end if
            gcs = c.syms->SymbolAt( gcs->nextOverload )
        next
        if (ptrCasts = 1) orelse anyPtr then return
        if ptrCasts > 1 then
            c.diags->Report( TKO0916, PointRange( c.ast->Loc( sp->a ) ) )
            return
        end if
        c.diags->Report( TKO0709, PointRange( c.ast->Loc( sp->a ) ) )
    case TK_ARRAY
        '' AN ARRAY IS A LEGAL IMAGE BUFFER -- 'line array, (0,0)-(w,h), c' over a plain
        '' 'dim array( ... )' is what gfx/image-expr.bas calls the NIDXARRAY form, and fbc
        '' compiles it. Only a SCALAR target is the error.
        ''
        '' ...EXCEPT A FIXED STRING, which is an array of a CHARACTER builtin and is not a
        '' buffer: 'dim z as zstring * 32 : line z, ...' is fbc's 28, measured for zstring
        '' and wstring alike, while the ubyte array beside it compiles.
        dim as TypeId ael = c.types->Unqualify( c.types->Inner( u ) )
        if c.types->Kind( ael ) = TK_BUILTIN then
            select case c.types->BuiltinOf( ael )
            case TY_ZSTRING, TY_WSTRING, TY_USTRING, TY_FIXSTR, TY_FIXUSTR
                c.diags->Report( TKO0708, PointRange( c.ast->Loc( sp->a ) ) )
            end select
        end if
        return
    case TK_BUILTIN
        '' AN ARRAY ELEMENT IS THE BUFFER'S FIRST BYTE, and fbc takes it: 'line a( 0 ),
        '' (0,0)-(w,h), c' over 'dim a( 0 to n ) as ubyte' compiles, while a plain scalar
        '' and a string are both error 28. gfx/image-expr.bas writes the element form
        '' twice, under a comment naming it. So a SUBSCRIPT of an array declines.
        dim as NodeKind tk = c.ast->Kind( sp->a )
        if (tk = N_INDEX) orelse (tk = N_CALL) then
            dim as ListPayload ptr tl = _
                c.ast->ListOf( sp->a )
            '' The TARGET'S TYPE decides, not its symbol kind: 'pudt->array( 0 )' reaches
            '' an array FIELD through a pointer and image-expr.bas writes that too.
            if tl->count > 0 then
                dim as TypeId tt = c.types->Unqualify( c.info->TypeOf_( tl->target ) )
                if tt <> TYPE_NONE then
                    if c.types->Kind( tt ) = TK_ARRAY then return
                end if
                dim as Symbol ptr ts = c.syms->SymbolAt( c.info->RefOf( tl->target ) )
                if ts <> nullptr then
                    if c.types->Kind( c.types->Unqualify( ts->type_ ) ) = TK_ARRAY then
                        return
                    end if
                end if
            end if
        end if
        c.diags->Report( TKO0708, PointRange( c.ast->Loc( sp->a ) ) )
    end select
end sub

'' A CASE VALUE MUST BE THE SUBJECT'S KIND -- fbc error 24, "Invalid data types". Measured:
'' 'select case s' over a string with 'case 0' is refused, and so is 'select case 0' with
'' 'case "a"' or 'case wstr( "a" )'; a fixed wstring subject measures the same as a
'' string. Only the string/number divide is asked -- an integer subject with a double
'' case is a conversion, not this.
private sub CaseValueKind_ _
    ( byref c as Ctx, byval v as NodeId, byval subjStr as boolean )
    if v = NODE_NONE then return
    dim as NodeKind vk = c.ast->Kind( v )
    if vk = N_CASE_RANGE then
        '' A STATEMENT NODE, not a binary: 'a TO b' and 'IS < a' keep their operands in
        '' the stmt payload's 'a' and 'b'. Reading it as a binary indexed the wrong pool
        '' and took the compiler down on every SELECT -- the ninth time this codebase
        '' has made the payload-pool mistake.
        dim as StmtPayload ptr rp = _
            c.ast->StmtOf( v )
        CaseValueKind_( c, rp->a, subjStr )
        CaseValueKind_( c, rp->b, subjStr )
        return
    end if
    dim as TypeId t = c.info->TypeOf_( v )
    if t = TYPE_NONE then return
    dim as TypeId u = c.types->Unqualify( t )
    if c.types->Kind( u ) = TK_REFERENCE then u = c.types->Unqualify( c.types->Inner( u ) )
    if c.types->Kind( u ) = TK_ARRAY then u = c.types->Unqualify( c.types->Inner( u ) )
    if c.types->Kind( u ) <> TK_BUILTIN then return
    '' A CHARACTER READ THROUGH A POINTER IS A NUMBER AND A STRING BOTH -- the same
    '' duality CheckStringNumberAssign_ declines over. compound/select_const.bas writes
    '' 'select case as const *p' over a 'zstring ptr' and then numeric cases.
    if CharAccess_( c, v, u ) then return
    dim as boolean vStr = IsStringyType_( c, u )
    if vStr = subjStr then return
    if vStr = false then
        select case c.types->BuiltinOf( u )
        case TY_BYTE, TY_UBYTE, TY_SHORT, TY_USHORT, TY_LONG, TY_ULONG, _
             TY_INTEGER, TY_UINTEGER, TY_LONGINT, TY_ULONGINT, TY_SINGLE, TY_DOUBLE, _
             TY_INT128, TY_UINT128
        case else
            return
        end select
    end if
    c.diags->Report( TKO0714, PointRange( c.ast->Loc( v ) ) )
end sub

'' A CASE VALUE THE SUBJECT CANNOT HOLD, under AS CONST -- fbc's warning 25, "Overflow in
'' constant conversion": the value is converted to the subject's type to index the table.
'' A plain SELECT compares in the promoted type and fbc says nothing there. Measured, over
'' forty probes:
''
''     ubyte / case 300, case -1, case 250 to 300        warning (one per bound out)
''     byte  / case 127, 128, 129                        two warnings, one line
''     long  / case 2147483648, &hFFFFFFFF               warning
''     ulong / case -1         ulongint / case -1        warning
''     integer, longint / case &hFFFFFFFFFFFFFFFF        none: fbc types that literal
''                                                       INTEGER, value -1
''     integer / case 18446744073709551615ull            warning: ULONGINT, 2^64 - 1
''     boolean / case 1, case 2                          warning; case -1, case 0 none
''     an ENUM subject, a FLOAT case value               never
''
'' so the rule is the value READ IN ITS OWN TYPE against the subject type's range.
private sub CaseValueRange_ _
    ( byref c as Ctx, byval v as NodeId, byval lo as int64, byval hi as int64, _
      byval subjUns64 as boolean, byref subjName as string )

    if (v = NODE_NONE) orelse (c.srcMgr = nullptr) then return
    dim as TypeId vt = c.info->TypeOf_( v )
    if vt = TYPE_NONE then return
    dim as TypeId vu = c.types->Unqualify( vt )
    if c.types->Kind( vu ) <> TK_BUILTIN then return
    dim as boolean vUns = false
    dim as int32 vw = 64
    select case c.types->BuiltinOf( vu )
    case TY_UBYTE                : vUns = true : vw = 8
    case TY_USHORT               : vUns = true : vw = 16
    case TY_ULONG                : vUns = true : vw = 32
    case TY_UINTEGER, TY_ULONGINT : vUns = true
    case TY_BYTE                 : vw = 8
    case TY_SHORT                : vw = 16
    case TY_LONG                 : vw = 32
    case TY_INTEGER, TY_LONGINT, TY_BOOLEAN
    case else
        return                                      '' a float or a string: not this
    end select
    if (c.types->target.pointerBits = 32) then
        select case c.types->BuiltinOf( vu )
        case TY_INTEGER, TY_UINTEGER : vw = 32
        end select
    end if
    dim as ScopeId sc = c.info->ScopeOf( v )
    dim as Check.ConstVal cv = Check.ConstOf( _
        *c.ast, v, *c.srcMgr, *c.names, c.types->target.pointerBits, c.syms, sc )
    if cv.known = false then return
    dim as int64 x = cv.value
    '' A NEGATIVE BIT PATTERN OF AN UNSIGNED VALUE is 2^63 or more: it fits only a 64-bit
    '' unsigned subject, and no signed one. ...EXCEPT A NEGATION, which fbc types INTEGER
    '' whatever it negates: '-2147483648' is INTEGER -2147483648 and fits a long, where
    '' tiko types it after its UINTEGER operand.
    dim as NodeId bare = v
    while c.ast->Kind( bare ) = N_PAREN
        dim as ListPayload ptr pp = _
            c.ast->ListOf( bare )
        if pp->count < 1 then exit while
        bare = cast( NodeId, c.ast->ChildSlot( pp->first ) )
    wend
    if c.ast->Kind( bare ) = N_UNARY then
        dim as UnaryPayload ptr up = _
            c.ast->UnaryOf( bare )
        if cast( TokenKind, up->op ) = TK_MINUS then vUns = false : cv.uns = false
    end if
    '' AT ITS OWN WIDTH: 'culng( 4294967295ull )' folds sign-extended, -1, and is the ulong
    '' 4294967295 -- which a ulong subject holds.
    if vw < 64 then
        x = x and ((1ll shl vw) - 1)
        if (vUns = false) andalso (x >= (1ll shl (vw - 1))) then x -= (1ll shl vw)
    end if
    '' THE TYPE DECIDES, not the folder's own 'uns' flag: 'const c as long = -2147483648'
    '' carries the unsigned flag of the 2147483648 it negated, and is a long all the same.
    dim as boolean big = vUns andalso (x < 0)
    dim as boolean fits
    if big then
        fits = subjUns64
    elseif subjUns64 then
        fits = (x >= 0)
    else
        fits = (x >= lo) andalso (x <= hi)
    end if
    if fits then return
    dim as string shown = iif( big, str( cast( ulongint, x ) ), str( x ) )
    c.diags->Report( TKO0979, PointRange( c.ast->Loc( v ) ), shown, subjName )
end sub

'' The subject type's range, then every case value against it.
private sub CheckSelectConstRange_ _
    ( byref c as Ctx, byval sp as StmtPayload ptr, byval su as TypeId, byref subjName as string )

    dim as int64 lo = 0, hi = 0
    dim as boolean uns64 = false
    dim as boolean wide = (c.types->target.pointerBits = 64)
    select case c.types->BuiltinOf( su )
    case TY_BYTE           : lo = -128 : hi = 127
    case TY_UBYTE, TY_ZSTRING : lo = 0 : hi = 255
    case TY_SHORT          : lo = -32768 : hi = 32767
    case TY_USHORT         : lo = 0 : hi = 65535
    case TY_LONG           : lo = -2147483648ll : hi = 2147483647ll
    case TY_ULONG          : lo = 0 : hi = 4294967295ll
    case TY_BOOLEAN        : lo = -1 : hi = 0
    case TY_INTEGER
        if wide then
            lo = -9223372036854775807ll - 1 : hi = 9223372036854775807ll
        else
            lo = -2147483648ll : hi = 2147483647ll
        end if
    case TY_UINTEGER
        if wide then
            uns64 = true
        else
            lo = 0 : hi = 4294967295ll
        end if
    case TY_LONGINT        : lo = -9223372036854775807ll - 1 : hi = 9223372036854775807ll
    case TY_ULONGINT       : uns64 = true
    case else
        return
    end select

    dim as ListPayload ptr lp = _
        c.ast->ListOf( sp->b )
    for i as int32 = 0 to lp->count - 1
        dim as NodeId cs = c.ast->ChildAt( lp->first, i )
        if c.ast->Kind( cs ) <> N_CASE then continue for
        dim as StmtPayload ptr csp = _
            c.ast->StmtOf( cs )
        for j as int32 = 0 to csp->count - 1
            dim as NodeId pn = c.ast->ChildAt( csp->first, j )
            if pn = NODE_NONE then continue for
            if c.ast->Kind( pn ) = N_CASE_RANGE then
                dim as StmtPayload ptr rp = _
                    c.ast->StmtOf( pn )
                if cast( TokenKind, rp->op ) <> 0 then continue for   '' 'case is': TKO0419
                CaseValueRange_( c, rp->a, lo, hi, uns64, subjName )
                CaseValueRange_( c, rp->b, lo, hi, uns64, subjName )
            else
                CaseValueRange_( c, pn, lo, hi, uns64, subjName )
            end if
        next
    next
end sub

sub CheckSelectCaseKinds_ ( byref c as Ctx, byval id as NodeId )
    dim as StmtPayload ptr sp = _
        c.ast->StmtOf( id )
    if (sp->a = NODE_NONE) orelse (sp->b = NODE_NONE) then return
    if c.ast->Kind( sp->b ) <> N_BLOCK then return
    dim as TypeId st = c.info->TypeOf_( sp->a )
    if st = TYPE_NONE then return
    dim as TypeId su = c.types->Unqualify( st )
    if c.types->Kind( su ) = TK_REFERENCE then su = c.types->Unqualify( c.types->Inner( su ) )
    if c.types->Kind( su ) = TK_ARRAY then su = c.types->Unqualify( c.types->Inner( su ) )
    '' A UDT SUBJECT IS fbc's 24 whatever casts it declares -- measured over one casting to long,
    '' one to string and one with none. tiko took its cast. A tuple is tiko's own, not judged;
    '' and a type whose base chain ENDS IN A BUILTIN -- 'extends wstring', 'extends zstring' --
    '' is a string to fbc, whose own udt-wstring/select.bas selects on one.
    if (c.types->Kind( su ) = TK_UDT) andalso (TcTuple_( c, su ) = false) then
        if Tko.Slices.SliceUnitOfType( *c.types, *c.names, su ) <> Tko.Slices.SU_NONE then return   '' a string slice selects as its text (docs/tiko-slices)
        dim as TypeId bb = c.types->BaseOf( su )
        for guard as int32 = 0 to 63
            if bb = TYPE_NONE then exit for
            if c.types->Kind( c.types->Unqualify( bb ) ) <> TK_UDT then return
            bb = c.types->BaseOf( c.types->Unqualify( bb ) )
        next
        c.diags->Report( TKO0964, PointRange( c.ast->Loc( sp->a ) ), c.names->Spelling( c.types->NameOf( su ) ) )
        return
    end if
    if c.types->Kind( su ) <> TK_BUILTIN then return
    if cast( TokenKind, sp->op ) = KW_CONST then
        '' A CHARACTER THROUGH A POINTER is its code: a ubyte for a zstring. A wide one is
        '' left alone -- its width is the target's.
        if CharAccess_( c, sp->a, su ) = false then
            CheckSelectConstRange_( c, sp, su, c.types->Name( su ) )
        elseif c.types->BuiltinOf( su ) = TY_ZSTRING then
            CheckSelectConstRange_( c, sp, su, "ubyte" )
        end if
    end if
    if CharAccess_( c, sp->a, su ) then return
    '' AS CONST OVER A FLOAT is fbc's 24 at the SELECT itself, measured over 'double' and
    '' 'single': a table cannot be indexed by one. tiko compiled it as a plain SELECT.
    if cast( TokenKind, sp->op ) = KW_CONST then
        select case c.types->BuiltinOf( su )
        case TY_SINGLE, TY_DOUBLE
            c.diags->Report( TKO0978, PointRange( c.ast->Loc( sp->a ) ), c.types->Name( su ) )
            return
        end select
    end if
    dim as boolean subjStr = IsStringyType_( c, su )
    if subjStr = false then
        select case c.types->BuiltinOf( su )
        case TY_BYTE, TY_UBYTE, TY_SHORT, TY_USHORT, TY_LONG, TY_ULONG, _
             TY_INTEGER, TY_UINTEGER, TY_LONGINT, TY_ULONGINT, TY_SINGLE, TY_DOUBLE, _
             TY_INT128, TY_UINT128
        case else
            return
        end select
    end if
    dim as ListPayload ptr lp = _
        c.ast->ListOf( sp->b )
    for i as int32 = 0 to lp->count - 1
        dim as NodeId cs = c.ast->ChildAt( lp->first, i )
        if c.ast->Kind( cs ) <> N_CASE then continue for
        dim as StmtPayload ptr csp = _
            c.ast->StmtOf( cs )
        for j as int32 = 0 to csp->count - 1
            CaseValueKind_( c, c.ast->ChildAt( csp->first, j ), subjStr )
        next
    next
end sub

'' 'with' TAKES A UDT VALUE -- fbc error 24 for 'with 0', 'with @x' (a POINTER, even to a
'' UDT) and 'with cptr( UDT ptr, 0 )'. A dereference, a field or a variable of UDT type
'' are the ordinary subjects.
sub CheckWithSubject_ ( byref c as Ctx, byval id as NodeId )
    dim as StmtPayload ptr sp = _
        c.ast->StmtOf( id )
    if sp->a = NODE_NONE then return
    '' 'with this' IS THE COMMONEST WITH IN ANY METHOD, and tiko-lang types 'this' as a
    '' POINTER because that is what the ABI passes -- the same exemption the dot rule
    '' makes. Judging its type refused this suite's own const-method test.
    if IsThisBase_( c, sp->a ) then return
    dim as TypeId t = c.info->TypeOf_( sp->a )
    if t = TYPE_NONE then return
    dim as TypeId u = c.types->Unqualify( t )
    if c.types->Kind( u ) = TK_REFERENCE then u = c.types->Unqualify( c.types->Inner( u ) )
    select case c.types->Kind( u )
    case TK_UDT
        return
    case TK_POINTER, TK_BUILTIN
        c.diags->Report( TKO0715, PointRange( c.ast->Loc( sp->a ) ) )
    end select
end sub

'' AN ARROW THROUGH A UDT VALUE -- fbc error 28, "Expected pointer", for '(*p)->i' and
'' '(**pp)->i' where the left side is the object itself. CheckDeref_ leaves a UDT alone
'' because a type may overload 'operator ->'; when it declares none, the arrow has
'' nothing to go through.
'' The first entry of ProcNameIndex for folded name 'want', or -1 -- see visctx.ti.
private function ProcsNamed_ ( byref c as Ctx, byval want as InternId ) as int32
    dim as ProcNameIndex ptr x = @c.procsByName
    while x->builtTo < c.syms->symbols.Count
        dim as int32 i = x->builtTo
        x->builtTo += 1
        dim as Symbol ptr s = @c.syms->symbols[i]
        if s->kind <> cast( uint8, SYM_PROC ) then continue while
        dim as uint32 key = cast( uint32, c.names->Fold( s->name ) )
        dim as int32 e = x->sid.Count, t = -1
        x->sid.Push( cast( uint32, i ) )
        x->nxt.Push( -1 )
        if x->tail.TryGet( key, t ) then
            x->nxt[t] = e
        else
            x->head.Put( key, e )
        end if
        x->tail.Put( key, e )
    wend
    dim as int32 e = -1
    if x->head.TryGet( cast( uint32, want ), e ) then return e
    return -1
end function

private function ArrowOperatorAnywhere_ ( byref c as Ctx ) as boolean
    dim as InternId nm = c.names->Fold( c.names->GetString( "->" ) )
    return ProcsNamed_( c, nm ) >= 0
end function

sub CheckArrowOnValue_ ( byref c as Ctx, byval id as NodeId )
    dim as BinaryPayload ptr mp = _
        c.ast->BinaryOf( id )
    if cast( TokenKind, mp->op ) <> TK_ARROW then return
    if mp->lhs = NODE_NONE then return
    dim as TypeId t = c.info->TypeOf_( mp->lhs )
    if t = TYPE_NONE then return
    dim as TypeId u = c.types->Unqualify( t )
    if c.types->Kind( u ) = TK_REFERENCE then u = c.types->Unqualify( c.types->Inner( u ) )
    if c.types->Kind( u ) <> TK_UDT then return
    if StructorOf_( c, u, "->" ) <> nullptr then return
    '' A GLOBAL 'operator ->( byref x as UDT )' MAKES THE ARROW LEGAL TOO, and which one
    '' applies is overload choice this pass does not model -- so any procedure of that
    '' name anywhere is enough to decline. Four of this suite's MIR tests define one.
    if ArrowOperatorAnywhere_( c ) then return
    c.diags->Report( TKO0716, PointRange( c.ast->Loc( id ) ) )
end sub

'' 'base.f( )' TO AN ABSTRACT METHOD -- fbc error 307, "Non-virtual call to ABSTRACT
'' method". An explicit base call binds statically, and there is no body to bind to.
sub CheckBaseCallAbstract_ ( byref c as Ctx, byval id as NodeId )
    dim as BinaryPayload ptr mp = _
        c.ast->BinaryOf( id )
    if mp->lhs = NODE_NONE then return
    if c.ast->Kind( mp->lhs ) <> N_IDENT then return
    dim as InternId bn = _
        c.ast->IdentOf( mp->lhs )->name
    if c.names->Fold( bn ) <> c.names->Fold( c.baseName ) then return
    dim as Symbol ptr ps = c.syms->SymbolAt( c.info->RefOf( id ) )
    if ps = nullptr then return
    if ps->kind <> cast( uint8, SYM_PROC ) then return
    dim as NodeId decl = cast( NodeId, ps->payload )
    if (decl = NODE_NONE) orelse (c.ast->Kind( decl ) <> N_PROC) then return
    dim as StmtPayload ptr dp = _
        c.ast->StmtOf( decl )
    if (dp->extra and PF_ABSTRACT) = 0 then return
    c.diags->Report( TKO0717, PointRange( c.ast->Loc( id ) ), c.names->Spelling( ps->name ) )
end sub

'' Does any procedure of this name exist anywhere -- member or global? Overload choice is
'' not modelled here, so one is enough to decline.
private function ProcNamedAnywhere_ ( byref c as Ctx, byref nm as string ) as boolean
    dim as InternId want = c.names->Fold( c.names->GetString( nm ) )
    return ProcsNamed_( c, want ) >= 0
end function

'' 'erase x' OVER AN ARRAY OF A TYPE WITH STRUCTORS reconstructs every element, and fbc
'' will only do that through a plain one: a default constructor whose parameter is merely
'' DEFAULTED is error 176, one with a calling convention written on it 174, and a
'' destructor with one 175. Measured, one corpus file each; a parameterless cdecl pair is
'' the ordinary case.
sub CheckEraseStructors_ ( byref c as Ctx, byval id as NodeId, byval here as TypeId )
    dim as StmtPayload ptr sp = _
        c.ast->StmtOf( id )
    if cast( TokenKind, sp->op ) <> KW_ERASE then return
    for i as int32 = 0 to sp->count - 1
        dim as NodeId arg = c.ast->ChildAt( sp->first, i )
        if arg = NODE_NONE then continue for
        dim as Symbol ptr av = c.syms->SymbolAt( c.info->RefOf( arg ) )
        if av = nullptr then continue for
        if av->type_ = TYPE_NONE then continue for
        dim as TypeId u = c.types->Unqualify( av->type_ )
        if c.types->Kind( u ) <> TK_ARRAY then continue for
        dim as TypeId el = c.types->Unqualify( c.types->Inner( u ) )
        if c.types->Kind( el ) <> TK_UDT then continue for
        '' THE DESTRUCTOR IS CALLED, so a private or protected one is fbc's 206 from where it
        '' cannot be reached -- visibility/private-dtor-public-erase and its protected twin,
        '' which the cdecl rule below used to catch by accident. TKO0633, as for a 'dim'.
        CheckOneStructor_( c, el, "__dtor", here, c.ast->Loc( arg ), av->name )
        '' ...AND ONLY A FIXED ARRAY IS RECONSTRUCTED: a DYNAMIC one's elements are destroyed
        '' and freed, so its constructors are not asked -- measured on fbc-modern 1.20,
        '' 2026-09-30, a defaulted or stdcall default constructor over 'dim x( )' is fine. A
        '' WRITTEN 'cdecl' is cdecl: only stdcall and pascal are refused
        '' (visibility/private-dtor-private-usage and its two siblings write 'destructor cdecl').
        dim as Symbol ptr ct = iif( c.types->IsDynArray( u ), cast( Symbol ptr, 0 ), StructorOf_( c, el, "__ctor" ) )
        dim as int32 guard = 0
        while (ct <> nullptr) andalso (guard < 1000)
            guard += 1
            dim as NodeId cd = cast( NodeId, ct->payload )
            if (cd <> NODE_NONE) andalso (c.ast->Kind( cd ) = N_PROC) then
                if RequiredParams_( c, cd ) = 0 then
                    dim as StmtPayload ptr cp = _
                        c.ast->StmtOf( cd )
                    if ParamCount_( c, cd ) > 0 then
                        c.diags->Report( TKO0719, PointRange( c.ast->Loc( arg ) ) )
                    elseif (cp->extra and (PF_STDCALL or PF_PASCAL)) <> 0 then
                        c.diags->Report( TKO0719, PointRange( c.ast->Loc( arg ) ) )
                    end if
                    exit while
                end if
            end if
            ct = c.syms->SymbolAt( ct->nextOverload )
        wend
        dim as Symbol ptr dt = StructorOf_( c, el, "__dtor" )
        if dt <> nullptr then
            dim as NodeId dd = cast( NodeId, dt->payload )
            if (dd <> NODE_NONE) andalso (c.ast->Kind( dd ) = N_PROC) then
                dim as StmtPayload ptr dp = _
                    c.ast->StmtOf( dd )
                if (dp->extra and (PF_STDCALL or PF_PASCAL)) <> 0 then
                    c.diags->Report( TKO0719, PointRange( c.ast->Loc( arg ) ) )
                end if
            end if
        end if
    next
end sub

'' A UDT COMPARED WITH ANYTHING needs an 'operator =' (or '<>', ...) -- fbc error 20 for
'' 'print (t = e1)' over a type that declares none, and for two values of one plain type
'' alike. Any procedure of the operator's name, member or global, is enough to decline.
function TupleLike_ ( byref c as Ctx, byval t as TypeId ) as boolean
    if t = TYPE_NONE then return false
    if c.types->Kind( t ) <> TK_UDT then return false
    dim as InternId nm = c.types->NameOf( t )
    if nm = 0 then return true
    dim as string sp = c.names->Spelling( nm )
    if len( sp ) = 0 then return true
    dim as string h = left( sp, 1 )
    return (h = "(") orelse (h = "$") orelse (h = "~")
end function

'' ...AND ARITHMETIC OR LOGIC ON A UDT THAT NO OPERATOR TAKES is fbc's error 20 as well.
'' Measured on fbc-modern 1.20, 2026-09-25: 'a1 + a2', 'a1 + b1', 'a1 * 2', 'a1 and a2' and
'' 'print a1 + a2' over types declaring no operator, an 'operator +( A, A )' used with a B,
'' and fbc's generics/fail-globalop-conflict.bas -- a generic 'operator +' over two
'' Box( of T ) given a Box( of integer ) and a Box( of double ). tiko dropped each statement
'' in silence. Check binds a user operator to the node (UserBinaryOp_), or types it through
'' an 'operator cast' (UdtOperandBinaryType_); a node with a UDT operand, both operand
'' types known, and NEITHER is the case. Not inside a template: its T operands are
'' untyped, and so is not reported.
'' WHAT AN OPERAND IS, for the two sweeps below: 0 nothing judged here (a UDT, a 'void'
'' result, 'any', an untyped one), 1 a number, boolean, enum or pointer, 2 a string --
'' a fixed-length one being an ARRAY of a string builtin. Two strings are judged only off
'' '+' and '&': 'wstring + ustring' is a concatenation BinaryResult does not type.
private function OperandClass_( byref c as Ctx, byval t as TypeId ) as int32
    dim as TypeId t0 = t
    select case c.types->Kind( t )
    case TK_POINTER, TK_ENUM : return 1
    case TK_ARRAY : t = c.types->Unqualify( c.types->Inner( t ) )
    case TK_BUILTIN
    case else : return 0
    end select
    if c.types->Kind( t ) <> TK_BUILTIN then return 0
    select case c.types->BuiltinOf( t )
    case TY_VOID, TY_ANY, TY_CVA_LIST : return 0
    case TY_STRING, TY_ZSTRING, TY_WSTRING, TY_USTRING, TY_FIXSTR, TY_FIXUSTR : return 2
    end select
    '' A BARE ARRAY of numbers has its own diagnostic.
    return iif( c.types->Kind( t0 ) = TK_ARRAY, 0, 1 )
end function

'' TKO0820 ONCE PER EXPRESSION: Check's binary case reports a declared operator no operand
'' reaches (UnviableUserOp_, udtcastu.tiko) before these sweeps see the same node.
private sub Report0820_( byref c as Ctx, byval id as NodeId, byref opText as string )
    for i as int32 = 0 to c.diags->pending.Count - 1
        if (c.diags->pending[i].id = TKO0820) andalso (c.diags->pending[i].range.first = c.ast->Loc( id )) then return
    next
    c.diags->Report( TKO0820, PointRange( c.ast->Loc( id ) ), opText )
end sub

'' IN AN INSTANCE OF A GENERIC GLOBAL OPERATOR the string rules below stay silent: tiko makes
'' one for every T its type is instantiated with, fbc only for a use (InstantiateGlobalOpsFor_,
'' generic.tiko), so 'x.v * k' at T = string is a body fbc never builds (global-operators.bas).
private function InGlobalOpInst_( byref c as Ctx ) as boolean
    if c.curProc = NODE_NONE then return false
    dim as StmtPayload ptr pp = c.ast->StmtOf( c.curProc )
    if (pp->op <> cast( uint16, KW_OPERATOR )) orelse (pp->ownerName <> 0) then return false
    return c.info->InstFrameOf( c.curProc ) <> 0    '' an instantiated body (instframe.tiko)
end function

private sub UdtArith_ ( byref c as Ctx, byval id as NodeId, byval bp as BinaryPayload ptr )
    if (bp->lhs = NODE_NONE) orelse (bp->rhs = NODE_NONE) then return
    if c.info->RefOf( id ) <> SYMBOL_NONE then return
    if c.info->TypeOf_( id ) <> TYPE_NONE then return
    dim as TypeId lt = c.types->Unqualify( c.info->TypeOf_( bp->lhs ) )
    dim as TypeId rt = c.types->Unqualify( c.info->TypeOf_( bp->rhs ) )
    if (lt = TYPE_NONE) orelse (rt = TYPE_NONE) then return
    if c.types->Kind( lt ) = TK_REFERENCE then lt = c.types->Unqualify( c.types->Inner( lt ) )
    if c.types->Kind( rt ) = TK_REFERENCE then rt = c.types->Unqualify( c.types->Inner( rt ) )
    if (c.types->Kind( lt ) = TK_TUPLE) orelse (c.types->Kind( rt ) = TK_TUPLE) then return
    if TupleLike_( c, lt ) orelse TupleLike_( c, rt ) then return
    dim as boolean lUdt = (c.types->Kind( lt ) = TK_UDT)
    dim as boolean rUdt = (c.types->Kind( rt ) = TK_UDT)
    '' ...AND OVER TWO PLAIN OPERANDS that no builtin operator takes -- 's + 1', 'b + 1',
    '' 'p + 1.5', all error 20. BinaryResult left them untyped and a concatenation
    '' fallback lowered them: 's + 1' printed "x1". Two strings take only '+' and '&' here:
    '' '"a" \ "b"', 's * s', 's and s' are error 20 (fbc 1.10.1, 2026-11-22), and were TKO0994.
    if (lUdt orelse rUdt) = false then
        dim as int32 lc = OperandClass_( c, lt ), rc = OperandClass_( c, rt )
        dim as boolean strOk = (lc = 2) andalso (rc = 2) andalso _
            ((cast( TokenKind, bp->op ) = TK_PLUS) orelse (cast( TokenKind, bp->op ) = TK_AMP) _
             orelse InGlobalOpInst_( c ))
        if (lc <> 0) andalso (rc <> 0) andalso (strOk = false) then
            Report0820_( c, id, _
                             lcase( TokenKindText( cast( TokenKind, bp->op ) ) ) )
        end if
        return
    end if
    if lUdt then
        if StructorOf_( c, lt, "cast" ) <> nullptr then return
    end if
    if rUdt then
        if StructorOf_( c, rt, "cast" ) <> nullptr then return
    end if
    Report0820_( c, id, _
                     lcase( TokenKindText( cast( TokenKind, bp->op ) ) ) )
end sub

'' ...AND SO IS A COMPOUND ASSIGNMENT OR A UNARY OPERATOR THAT NOTHING TAKES. Measured on
'' fbc-modern 1.20, 2026-09-25, over a type A declaring nothing, a type N declaring only
'' 'operator cast( ) as long' and a Q with only a global 'operator +( Q, Q )':
''
''     'a1 += 1', 'a1 and= a2', 'q1 -= q2', 'k += a1', 'n1 += 1'     error 20
''     'not a1', '-a1', '+a1'                                        error 20
''     'k += n1', '-n1', 'q1 += q2'                                  accepted
''
'' tiko dropped every one of the first two lines in silence, or took '+a1' and 'k += a1'.
'' A compound Check bound to a binary operator (CompoundUserOp_, checkwalk.tiko) is taken;
'' so is one over a type that declares the self-operator; one over a type with an
'' 'operator let' AND a cast or some operator of the name, whose result the 'let' may
'' convert and which is not judged here ('l1 += 1' over a 'let' alone is error 20); and a
'' scalar target with a UDT value that declares a cast. A property target is a call.
private function CompoundSelfName_( byval op as TokenKind ) as string
    select case op
    case TK_PLUSEQ   : return "+="
    case TK_MINUSEQ  : return "-="
    case TK_STAREQ   : return "*="
    case TK_SLASHEQ  : return "/="
    case TK_BSLASHEQ : return "\="
    case TK_CARETEQ  : return "^="
    case TK_AMPEQ    : return "&="
    case KW_AND, KW_OR, KW_XOR, KW_IMP, KW_EQV, KW_MOD, KW_SHL, KW_SHR
        return lcase( TokenKindText( op ) ) & "="
    end select
    return ""
end function

'' A POINTER IN A COMPOUND ASSIGNMENT OTHER THAN '+=' AND '-=' -- fbc's error 20, as the
'' binary operator is (TKO0820 here). Measured on fbc-modern 1.20, 2026-10-13: 'n *= p', '/=',
'' '\=', 'mod=', 'and=', 'or=', 'xor=', 'shl=', 'shr=' and '^=' over an integer target, and
'' 'p *= 2', 'p and= 2', 'p shl= 1' over a pointer one; tiko compiled every one. Not '&=',
'' which concatenates, nor 'imp=' / 'eqv=', which were not measured; a UDT side is
'' CheckUdtCompound_'s.
sub CheckPtrCompound_ ( byref c as Ctx, byval id as NodeId )
    if c.info->AmbiguousOf( id ) <> AMB_ASSIGN then return
    dim as StmtPayload ptr sp = c.ast->StmtOf( id )
    select case cast( TokenKind, sp->op )
    case TK_STAREQ, TK_SLASHEQ, TK_BSLASHEQ, TK_CARETEQ, KW_AND, KW_OR, KW_XOR, KW_MOD, KW_SHL, KW_SHR
    case else
        return
    end select
    if (sp->a = NODE_NONE) orelse (sp->b = NODE_NONE) then return
    dim as TypeId lt = c.types->Unqualify( c.info->TypeOf_( sp->a ) )
    dim as TypeId rt = c.types->Unqualify( c.info->TypeOf_( sp->b ) )
    if (lt = TYPE_NONE) orelse (rt = TYPE_NONE) then return
    if c.types->Kind( lt ) = TK_REFERENCE then lt = c.types->Unqualify( c.types->Inner( lt ) )
    if c.types->Kind( rt ) = TK_REFERENCE then rt = c.types->Unqualify( c.types->Inner( rt ) )
    dim as TypeKind lk = c.types->Kind( lt ), rk = c.types->Kind( rt )
    if (lk <> TK_POINTER) andalso (rk <> TK_POINTER) then return
    if (lk <> TK_POINTER) andalso (lk <> TK_BUILTIN) then return
    if (rk <> TK_POINTER) andalso (rk <> TK_BUILTIN) then return
    dim as string selfNm = CompoundSelfName_( cast( TokenKind, sp->op ) )
    Report0820_( c, id, left( selfNm, len( selfNm ) - 1 ) )
end sub

'' ...AND A STRING ON EITHER SIDE of one. fbc 1.10.1, 2026-11-22: a string target takes '&='
'' and '+=' a string, nothing else ('s -= "b"', 's += 1' error 20); a number target takes no
'' string at all ('n *= "3"'; '&=' is TKO0635's). tiko compiled 'n += "3"' and stopped on
'' TKO0994 for the rest.
sub CheckStrCompound_ ( byref c as Ctx, byval id as NodeId )
    if c.info->AmbiguousOf( id ) <> AMB_ASSIGN then return
    dim as StmtPayload ptr sp = c.ast->StmtOf( id )
    dim as TokenKind op = cast( TokenKind, sp->op )
    dim as string selfNm = CompoundSelfName_( op )
    if (len( selfNm ) = 0) orelse (op = TK_AMPEQ) then return
    if (sp->a = NODE_NONE) orelse (sp->b = NODE_NONE) then return
    dim as TypeId lt = c.types->Unqualify( c.info->TypeOf_( sp->a ) )
    dim as TypeId rt = c.types->Unqualify( c.info->TypeOf_( sp->b ) )
    if (lt = TYPE_NONE) orelse (rt = TYPE_NONE) then return
    if c.types->Kind( lt ) = TK_REFERENCE then lt = c.types->Unqualify( c.types->Inner( lt ) )
    if c.types->Kind( rt ) = TK_REFERENCE then rt = c.types->Unqualify( c.types->Inner( rt ) )
    dim as int32 lc = OperandClass_( c, lt ), rc = OperandClass_( c, rt )
    if (lc = 0) orelse (rc = 0) orelse ((lc <> 2) andalso (rc <> 2)) then return
    if (op = TK_PLUSEQ) andalso (lc = 2) andalso (rc = 2) then return
    if InGlobalOpInst_( c ) then return
    Report0820_( c, id, left( selfNm, len( selfNm ) - 1 ) )
end sub

sub CheckUdtCompound_ ( byref c as Ctx, byval id as NodeId )
    if c.info->AmbiguousOf( id ) <> AMB_ASSIGN then return
    if c.info->RefOf( id ) <> SYMBOL_NONE then return
    dim as StmtPayload ptr sp = c.ast->StmtOf( id )
    dim as string selfNm = CompoundSelfName_( cast( TokenKind, sp->op ) )
    if len( selfNm ) = 0 then return
    if (sp->a = NODE_NONE) orelse (sp->b = NODE_NONE) then return
    dim as Symbol ptr ls = c.syms->SymbolAt( c.info->RefOf( sp->a ) )
    if (ls <> nullptr) andalso (ls->kind = cast( uint8, SYM_PROC )) then return
    dim as TypeId lt = c.types->Unqualify( c.info->TypeOf_( sp->a ) )
    dim as TypeId rt = c.types->Unqualify( c.info->TypeOf_( sp->b ) )
    if (lt = TYPE_NONE) orelse (rt = TYPE_NONE) then return
    if c.types->Kind( lt ) = TK_REFERENCE then lt = c.types->Unqualify( c.types->Inner( lt ) )
    if c.types->Kind( rt ) = TK_REFERENCE then rt = c.types->Unqualify( c.types->Inner( rt ) )
    if (c.types->Kind( lt ) = TK_TUPLE) orelse (c.types->Kind( rt ) = TK_TUPLE) then return
    if TupleLike_( c, lt ) orelse TupleLike_( c, rt ) then return
    dim as boolean lUdt = (c.types->Kind( lt ) = TK_UDT)
    dim as boolean rUdt = (c.types->Kind( rt ) = TK_UDT)
    if lUdt then
        if StructorOf_( c, lt, selfNm ) <> nullptr then return
        if StructorOf_( c, lt, "let" ) <> nullptr then
            if StructorOf_( c, lt, "cast" ) <> nullptr then return
            if ProcNamedAnywhere_( c, left( selfNm, len( selfNm ) - 1 ) ) then return
        end if
    elseif rUdt then
        if StructorOf_( c, rt, "cast" ) <> nullptr then return
    else
        return
    end if
    Report0820_( c, id, selfNm )
end sub

'' '*i' OVER A NUMBER and '@5' OVER A LITERAL -- fbc's 28 and 24. A string is left to
'' the rules that already judge it -- except a USTRING, which no rule judged: '*u' (the
'' old DWSTRING buffer operator) reached lowering untyped and stopped on TKO0994.
sub CheckDerefAddrOperand_ ( byref c as Ctx, byval id as NodeId, byval k as NodeKind )
    dim as UnaryPayload ptr up = c.ast->UnaryOf( id )
    dim as NodeId opnd = up->operand
    if opnd = NODE_NONE then return
    if k = N_ADDROF then
        select case c.ast->Kind( opnd )
        case N_INT_LIT, N_FLOAT_LIT
            c.diags->Report( TKO0951, PointRange( c.ast->Loc( id ) ) )
        end select
        return
    end if
    '' '*p.i' over a pointer p is TKO0630's, on the '.', and not reported twice.
    if c.ast->Kind( opnd ) = N_MEMBER then return
    dim as TypeId t = c.types->Unqualify( c.info->TypeOf_( opnd ) )
    if t = TYPE_NONE then return
    if c.types->Kind( t ) = TK_REFERENCE then t = c.types->Unqualify( c.types->Inner( t ) )
    select case c.types->Kind( t )
    case TK_ENUM
    case TK_BUILTIN
        select case c.types->BuiltinOf( t )
        case TY_STRING, TY_ZSTRING, TY_WSTRING, TY_FIXSTR, TY_ANY
            return
        end select
    case else
        return
    end select
    c.diags->Report( TKO0950, PointRange( c.ast->Loc( id ) ) )
end sub

sub CheckUdtUnary_ ( byref c as Ctx, byval id as NodeId )
    dim as UnaryPayload ptr up = c.ast->UnaryOf( id )
    select case cast( TokenKind, up->op )
    case TK_MINUS, TK_PLUS, KW_NOT
    case else
        return
    end select
    if up->operand = NODE_NONE then return
    if c.info->RefOf( id ) <> SYMBOL_NONE then return
    dim as TypeId t = c.types->Unqualify( c.info->TypeOf_( up->operand ) )
    if c.types->Kind( t ) = TK_REFERENCE then t = c.types->Unqualify( c.types->Inner( t ) )
    if c.types->Kind( t ) <> TK_UDT then
        '' ...and over a plain operand Check could not type: '-b' over a boolean.
        if (t = TYPE_NONE) orelse (c.info->TypeOf_( id ) <> TYPE_NONE) then return
        if OperandClass_( c, t ) = 0 then return
        if (c.types->Kind( t ) = TK_POINTER) andalso (up->op = KW_NOT) then return
    else
        if TupleLike_( c, t ) then return
        if StructorOf_( c, t, "cast" ) <> nullptr then return
    end if
    Report0820_( c, id, _
                     lcase( TokenKindText( cast( TokenKind, up->op ) ) ) )
end sub

'' ...AND EVERY ELEMENT OF THE TUPLE HAS TO COMPARE. Measured on fbc-modern 1.20,
'' 2026-09-25, over '(V, long)':
''
''     V with 'operator =' only     '=' prints -1     '<>' error 20
''     V with 'operator <>' only    '<>' prints 0     '=' error 20
''     V with neither               both error 20, and so with an 'operator cast' too
''
'' tiko typed none of these and so dropped the statement; typed, it emitted a call to an
'' operator that does not exist and clang refused the module. A UDT element needs the
'' operator written for THAT comparison, over two of itself -- the same one the lowering
'' calls (TupleUdtCmpOp_ in mir/lowertup.tiko) -- and a tuple element, its own elements.
private function UdtHasCmpOp_ _
    ( byref c as Ctx, byval ut as TypeId, byref nm as string ) as boolean
    dim as ScopeId sc = cast( ScopeId, c.types->DeclScopeOf( ut ) )
    if sc = SCOPE_NONE then return false
    dim as SymbolId cur = c.syms->Lookup( sc, c.names->Fold( c.names->GetString( nm ) ) )
    for guard as int32 = 0 to 255
        if cur = SYMBOL_NONE then exit for
        dim as Symbol ptr os = c.syms->SymbolAt( cur )
        if os = nullptr then exit for
        dim as NodeId pn = cast( NodeId, os->payload )
        dim as boolean isOp = (os->kind = cast( uint8, SYM_PROC )) andalso (pn <> NODE_NONE)
        if isOp then isOp = (c.ast->Kind( pn ) = N_PROC)
        if isOp then
            dim as StmtPayload ptr pp = c.ast->StmtOf( pn )
            if pp->op = cast( uint16, KW_OPERATOR ) then
                dim as int32 np = 0
                dim as boolean bothMine = true
                for i as int32 = 0 to pp->count - 1
                    dim as NodeId prm = c.ast->ChildAt( pp->first, i )
                    if c.ast->Kind( prm ) <> N_PARAM then continue for
                    dim as StmtPayload ptr qp = c.ast->StmtOf( prm )
                    if c.types->Unqualify( c.info->TypeOf_( qp->a ) ) <> ut then bothMine = false
                    np += 1
                next
                if (np = 2) andalso bothMine then return true
            end if
        end if
        cur = os->nextOverload
    next
    return false
end function

private function TupleElemsCompare_ _
    ( byref c as Ctx, byval t as TypeId, byref nm as string, byval depth as int32 ) as boolean
    if depth > 16 then return true
    if c.types->Kind( t ) <> TK_UDT then return true
    dim as InternId tn = c.types->NameOf( t )
    if tn = 0 then return true
    dim as ScopeId ds = cast( ScopeId, c.types->DeclScopeOf( t ) )
    dim as SymbolId ts = c.syms->LookupLocalTyped( ds, tn, true )
    if ts = SYMBOL_NONE then ts = c.syms->LookupTyped( ds, tn, true )
    dim as Symbol ptr s = c.syms->SymbolAt( ts )
    if s = nullptr then return true
    if s->inner = SCOPE_NONE then return true
    dim as SymScope ptr sc = c.syms->ScopeAt( s->inner )
    if sc = nullptr then return true
    dim as SymbolId cur = sc->firstSym
    for guard as int32 = 0 to 9999
        if cur = SYMBOL_NONE then exit for
        dim as Symbol ptr f = c.syms->SymbolAt( cur )
        if f = nullptr then exit for
        if f->kind = cast( uint8, SYM_FIELD ) then
            dim as TypeId ft = c.types->Unqualify( f->type_ )
            if TupleLike_( c, ft ) then
                if TupleElemsCompare_( c, ft, nm, depth + 1 ) = false then return false
            elseif c.types->Kind( ft ) = TK_UDT then
                '' ...OR A NUMERIC CAST: measured on fbc-modern, a tuple element of a type with
                '' 'operator =' and 'cast( ) as long' but no '<>' compares by the cast for '<>' --
                '' where tiko refused it, TKO0720 -- while a STRING cast does not (error 20, below).
                if (UdtHasCmpOp_( c, ft, nm ) = false) andalso (Tko.Check.NumericCastPick( *c.syms, *c.types, *c.names, ft, TYPE_NONE ) = SYMBOL_NONE) then return false
            end if
        end if
        cur = f->nextInScope
    next
    return true
end function

'' WHICH CAST A UDT OPERAND NEEDS, with no user operator. Measured on fbc-modern, over casts to
'' 'string', 'ustring', 'byref as zstring', 'byref as wstring', the two string pointers and long:
''
''   '&'                         each UDT side needs a string cast -- a pointer one is not   20
''   two UDTs: + - * / and the comparisons
''                               each side needs a number or a BYREF z/wstring cast; 'string'
''                               and 'ustring' do not count ('s = s' is 20, 'w = w' is -1)
''   one UDT against a string: '+' and the comparisons
''                               the UDT needs a string cast ('m + "x"' is 20)
''
'' tiko took whichever cast it found, or failed to lower. A tuple, a generic instance and a type
'' extending a builtin are not judged here.
function PlainUdtOperand_ ( byref c as Ctx, byval t as TypeId ) as boolean
    if c.types->Kind( t ) <> TK_UDT then return false
    if TupleLike_( c, t ) then return false
    if instr( c.names->Spelling( c.types->NameOf( t ) ), "<" ) > 0 then return false
    if c.types->BaseOf( t ) <> TYPE_NONE then return false
    return (StructorOf_( c, t, "cast" ) <> nullptr)
end function

'' What a UDT's casts offer: a number, a string (by value or a BYREF z/wstring), a BYREF z/wstring.
private sub UdtCastKinds_ _
    ( byref c as Ctx, byval t as TypeId, byref hasNum as boolean, byref hasStr as boolean, byref hasCharRef as boolean )
    hasNum = false : hasStr = false : hasCharRef = false
    dim as Symbol ptr cs = StructorOf_( c, t, "cast" )
    for guard as int32 = 0 to 255
        if cs = nullptr then exit for
        dim as TypeId rt = c.types->Unqualify( cs->type_ )
        dim as boolean byRes = false
        dim as NodeId pn = cast( NodeId, cs->payload )
        if (pn <> NODE_NONE) andalso (c.ast->Kind( pn ) = N_PROC) then
            byRes = ((c.ast->StmtOf( pn )->extra and PF_BYREF_RESULT) <> 0) orelse _
                    ((c.ast->Flags( pn ) and NF_BYREF) <> 0)
        end if
        if c.types->Kind( rt ) = TK_REFERENCE then rt = c.types->Unqualify( c.types->Inner( rt ) ) : byRes = true
        if byRes andalso (c.types->Kind( rt ) = TK_POINTER) then rt = c.types->Unqualify( c.types->Inner( rt ) )
        select case c.types->Kind( rt )
        case TK_ENUM : hasNum = true
        case TK_BUILTIN
            select case c.types->BuiltinOf( rt )
            case TY_STRING, TY_USTRING : hasStr = true
            case TY_ZSTRING, TY_WSTRING
                if byRes then hasStr = true : hasCharRef = true
            case TY_VOID, TY_ANY
            case else : hasNum = true
            end select
        end select
        cs = c.syms->SymbolAt( cs->nextOverload )
    next
end sub

private sub UdtCastOperands_ ( byref c as Ctx, byval id as NodeId, byval bp as BinaryPayload ptr )
    if (bp->lhs = NODE_NONE) orelse (bp->rhs = NODE_NONE) then return
    if c.info->RefOf( id ) <> SYMBOL_NONE then return
    dim as TypeId lt = c.types->Unqualify( c.info->TypeOf_( bp->lhs ) )
    dim as TypeId rt = c.types->Unqualify( c.info->TypeOf_( bp->rhs ) )
    if (lt = TYPE_NONE) orelse (rt = TYPE_NONE) then return
    if c.types->Kind( lt ) = TK_REFERENCE then lt = c.types->Unqualify( c.types->Inner( lt ) )
    if c.types->Kind( rt ) = TK_REFERENCE then rt = c.types->Unqualify( c.types->Inner( rt ) )
    dim as boolean lU = PlainUdtOperand_( c, lt ), rU = PlainUdtOperand_( c, rt )
    if (lU orelse rU) = false then return
    dim as boolean lN, lS, lC, rN, rS, rC
    if lU then UdtCastKinds_( c, lt, lN, lS, lC )
    if rU then UdtCastKinds_( c, rt, rN, rS, rC )
    dim as TokenKind op = cast( TokenKind, bp->op )
    dim as boolean bad = false
    if op = TK_AMP then
        if lU andalso (lS = false) then bad = true
        if rU andalso (rS = false) then bad = true
        '' ...and its BEST cast against STRING must be text: fbc's 20 when a pointer or a number
        '' outscores the string casts, or two tie (castpick.tiko).
        if lU andalso (Tko.Check.UdtStrCastFit( *c.ast, *c.syms, *c.types, *c.names, lt, Tko.Check.CT_STRING ) > 0) then bad = true
        if rU andalso (Tko.Check.UdtStrCastFit( *c.ast, *c.syms, *c.types, *c.names, rt, Tko.Check.CT_STRING ) > 0) then bad = true
    else
        select case op
        case TK_PLUS, TK_MINUS, TK_STAR, TK_SLASH, TK_EQ, TK_NE, TK_LT, TK_GT, TK_LE, TK_GE
        case else
            return
        end select
        if lU andalso rU then
            bad = ((lN orelse lC) = false) orelse ((rN orelse rC) = false)
        elseif (op <> TK_MINUS) andalso (op <> TK_STAR) andalso (op <> TK_SLASH) then
            if OperandClass_( c, iif( lU, rt, lt ) ) = 2 then bad = iif( lU, lS, rS ) = false
        end if
        '' A UDT AGAINST A NUMBER takes a number from its casts -- a numeric one or a character
        '' reference. Strings or pointers alone are fbc's 20: tiko tried a concatenation and ICEd.
        if (lU xor rU) andalso (OperandClass_( c, iif( lU, rt, lt ) ) = 1) then
            if (op = TK_PLUS) orelse (op = TK_MINUS) orelse (op = TK_STAR) orelse (op = TK_SLASH) then
                dim as boolean nOk = iif( lU, lN orelse lC, rN orelse rC )
                if nOk = false then bad = true
            end if
        end if
    end if
    if bad then Report0820_( c, id, lcase( TokenKindText( op ) ) )
end sub

'' IS t, OR A TYPE IT EXTENDS, THE TYPE p?
private function IsOrExtends_ ( byref c as Ctx, byval t as TypeId, byval p as TypeId ) as boolean
    for guard as int32 = 0 to 63
        if t = TYPE_NONE then return false
        if t = p then return true
        t = c.types->Unqualify( c.types->BaseOf( t ) )
    next
    return false
end function

'' COULD ANY OPERATOR OF THIS NAME COMPARE lt WITH rt? Check binds the one that does
'' (RefOf); this declines only where it might have missed one. Measured on fbc-modern
'' 1.20, 2026-10-18: with a global 'operator =( Other, Other )' in scope, 'x = y' over a
'' type with no '=' is still error 20. tiko declined on ANY procedure named '=', the
'' comparison went untyped, and the build stopped on TKO0994 -- any program importing
'' std/fs (FileId's '=') hit it. An operator is out only when it is not generic and both
'' its parameters are UDTs neither operand is or extends; anything less certain declines.
private function CmpOpMayApply_ _
    ( byref c as Ctx, byref nm as string, byval lt as TypeId, byval rt as TypeId ) as boolean
    dim as InternId want = c.names->Fold( c.names->GetString( nm ) )
    dim as int32 e = ProcsNamed_( c, want )
    while e >= 0
        dim as Symbol ptr s = @c.syms->symbols[cast( int32, c.procsByName.sid[e] )]
        e = c.procsByName.nxt[e]
        dim as NodeId pn = cast( NodeId, s->payload )
        if (pn = NODE_NONE) orelse (c.ast->Kind( pn ) <> N_PROC) then return true
        dim as StmtPayload ptr pp = c.ast->StmtOf( pn )
        if (pp->extra and PF_GENERIC_PROC) <> 0 then return true
        dim as int32 np = 0
        for k as int32 = 0 to pp->count - 1
            dim as NodeId prm = c.ast->ChildAt( pp->first, k )
            if c.ast->Kind( prm ) <> N_PARAM then continue for
            np += 1
            dim as StmtPayload ptr qp = c.ast->StmtOf( prm )
            dim as TypeId p = c.types->Unqualify( c.info->TypeOf_( qp->a ) )
            if c.types->Kind( p ) = TK_REFERENCE then p = c.types->Unqualify( c.types->Inner( p ) )
            if c.types->Kind( p ) <> TK_UDT then return true
            if IsOrExtends_( c, lt, p ) orelse IsOrExtends_( c, rt, p ) then return true
        next
        if np <> 2 then return true
    wend
    return false
end function

sub CheckUdtCompare_ ( byref c as Ctx, byval id as NodeId )
    dim as BinaryPayload ptr bp = _
        c.ast->BinaryOf( id )
    UdtCastOperands_( c, id, bp )
    dim as string opnm = ""
    select case cast( TokenKind, bp->op )
    case TK_EQ : opnm = "="
    case TK_NE : opnm = "<>"
    case TK_LT : opnm = "<"
    case TK_GT : opnm = ">"
    case TK_LE : opnm = "<="
    case TK_GE : opnm = ">="
    case TK_PLUS, TK_MINUS, TK_STAR, TK_SLASH, TK_BACKSLASH, TK_CARET, TK_AMP, _
         KW_MOD, KW_AND, KW_OR, KW_XOR, KW_EQV, KW_IMP, KW_SHL, KW_SHR
        UdtArith_( c, id, bp )
        return
    case else
        return
    end select
    if (bp->lhs = NODE_NONE) orelse (bp->rhs = NODE_NONE) then return
    dim as TypeId lt = c.types->Unqualify( c.info->TypeOf_( bp->lhs ) )
    dim as TypeId rt = c.types->Unqualify( c.info->TypeOf_( bp->rhs ) )
    if (lt = TYPE_NONE) orelse (rt = TYPE_NONE) then return
    if c.types->Kind( lt ) = TK_REFERENCE then lt = c.types->Unqualify( c.types->Inner( lt ) )
    if c.types->Kind( rt ) = TK_REFERENCE then rt = c.types->Unqualify( c.types->Inner( rt ) )
    if IfaceCompareJudged_( c, id, opnm, lt, rt ) then return       '' semiface.tiko
    '' A TUPLE COMPARES ELEMENTWISE and is not this question -- this suite's own
    '' tuple-compare test writes 'if a = b' over two '(long, long)'. Its kind, or its
    '' synthesized name, is what tells one apart from a declared UDT.
    ''
    '' ...but only BETWEEN TWO OF ONE TYPE, and only for '=' and '<>'. Measured on fbc-modern
    '' 1.20, 2026-09-25 (its errors/tuple-errors.bas): '<', '>', '<=' and '>=' on tuples are
    '' error 20 -- lexicographic order is not defined -- and so is '=' between two DIFFERENT
    '' tuple types, '(long, long)' against '(double, double)', against the literal '(1, 2)',
    '' which is '(integer, integer)', or against a scalar. tiko accepted them all.
    dim as boolean lTup = (c.types->Kind( lt ) = TK_TUPLE) orelse TupleLike_( c, lt )
    dim as boolean rTup = (c.types->Kind( rt ) = TK_TUPLE) orelse TupleLike_( c, rt )
    if lTup orelse rTup then
        dim as boolean eqOp = (opnm = "=") orelse (opnm = "<>")
        if eqOp andalso (lt = rt) then
            if TupleElemsCompare_( c, lt, opnm, 0 ) then return
        end if
        c.diags->Report( TKO0720, PointRange( c.ast->Loc( id ) ), opnm )
        return
    end if
    dim as boolean lUdt = (c.types->Kind( lt ) = TK_UDT)
    dim as boolean rUdt = (c.types->Kind( rt ) = TK_UDT)
    if (lUdt orelse rUdt) = false then return
    if c.info->RefOf( id ) <> SYMBOL_NONE then return
    if CmpOpMayApply_( c, opnm, lt, rt ) then return
    '' A UDT AGAINST A NUMBER OR AN ENUM compares by a number from its casts -- a numeric one
    '' or a BYREF z/wstring -- as '+ - * /' do (UdtCastOperands_). Measured on fbc-modern 1.20,
    '' 2026-11-13: with casts to string, ustring, zstring ptr or any ptr alone, 'n = 5',
    '' '5 <> n', 'n < i' and 'n >= 5.0' are each error 20, and so is 'n = k' for an enum k;
    '' tiko let them through and stopped on TKO0994, the comparison never lowered. sys/win/com's
    '' CInt96 (casts to CURRENCY, VARIANT, STRING) with its 'operator =' private was the case.
    '' Against a POINTER a pointer cast compares, and fbc takes it.
    if lUdt xor rUdt then
        dim as TypeId ut = iif( lUdt, lt, rt )
        dim as TypeId ot = iif( lUdt, rt, lt )
        dim as boolean numSide = ((c.types->Kind( ot ) = TK_BUILTIN) orelse (c.types->Kind( ot ) = TK_ENUM)) andalso (OperandClass_( c, ot ) = 1)
        if numSide andalso PlainUdtOperand_( c, ut ) then
            dim as boolean uN, uS, uC
            UdtCastKinds_( c, ut, uN, uS, uC )
            if (uN orelse uC) = false then
                Report0820_( c, id, opnm )
                return
            end if
        end if
        '' ...AND AGAINST A POINTER by its pointer cast, PtrCastPick's (lowering calls the same one).
        '' Measured, same day: over 'long ptr' alone 'x = pd' (a double ptr) is 20 and 'x = pa' (any
        '' ptr) compares; over [long ptr, double ptr] 'x = pa' is 98; with no pointer cast a numeric
        '' one compares and a string one alone is 20.
        if (c.types->Kind( ot ) = TK_POINTER) andalso PlainUdtOperand_( c, ut ) then
            select case Tko.Check.PtrCastFit( *c.ast, *c.syms, *c.types, *c.names, ut, ot )
            case 1
                Report0820_( c, id, opnm )
                return
            case 2
                c.diags->Report( TKO0660, PointRange( c.ast->Loc( id ) ), "operator cast" )
                return
            case -1
                dim as boolean pN, pS, pC
                UdtCastKinds_( c, ut, pN, pS, pC )
                if (pN orelse pC) = false then
                    Report0820_( c, id, opnm )
                    return
                end if
            end select
        end if
    end if
    '' A conversion operator on the UDT may turn it into something comparable.
    if lUdt then
        if StructorOf_( c, lt, "cast" ) <> nullptr then return
    end if
    if rUdt then
        if StructorOf_( c, rt, "cast" ) <> nullptr then return
    end if
    c.diags->Report( TKO0720, PointRange( c.ast->Loc( id ) ), opnm )
end sub
