'' fold128.ti -- 128-bit integer arithmetic for the constant folder (constfold.tiko).
''
'' tiko's int128 / uint128 (types/type.ti) fold at compile time like every other integer,
'' and FreeBASIC -- the language the compiler is written in -- has no 128-bit type to fold
'' them in. So a value is two 64-bit halves and each operator is written out here, with
'' LLVM's i128 semantics: everything wraps modulo 2^128, '\' truncates toward zero, MOD
'' takes the dividend's sign, a shift count is taken modulo 128 (the emitter masks it so).

#ifndef __TKO_FOLD128_BI__
#define __TKO_FOLD128_BI__

#include once "tko.ti"
#include once "symbols/check.ti"

namespace Tko.Check

    type I128
        as uint64 lo
        as uint64 hi
    end type

    declare function I128Of( byval lo as uint64, byval hi as uint64 ) as I128
    declare function I128Add( byref a as I128, byref b as I128 ) as I128
    declare function I128Sub( byref a as I128, byref b as I128 ) as I128
    declare function I128Mul( byref a as I128, byref b as I128 ) as I128
    declare function I128Neg( byref a as I128 ) as I128
    declare function I128IsZero( byref a as I128 ) as boolean
    declare function I128IsNeg( byref a as I128 ) as boolean
    '' Quotient and remainder; false for a zero divisor. Signed: truncated toward zero.
    declare function I128DivMod _
        ( byref a as I128, byref b as I128, byval signed_ as boolean, _
          byref q as I128, byref r as I128 ) as boolean
    declare function I128Shl( byref a as I128, byval n as int32 ) as I128
    declare function I128Shr( byref a as I128, byval n as int32, byval arith as boolean ) as I128
    '' -1, 0 or 1.
    declare function I128Cmp( byref a as I128, byref b as I128, byval signed_ as boolean ) as int32

    '' The folder's side (constfold.tiko): a ConstVal at 128 bits (any width widens by its own
    '' signedness), one made from (lo, hi), and the operators over them -- None when the
    '' operator does not fold.
    declare function Const128Wide( byref v as ConstVal ) as I128
    declare function Const128Of( byref x as I128, byval uns as boolean ) as ConstVal
    declare function Fold128Unary( byval op as Tko.TokenKind, byref v as ConstVal ) as ConstVal
    declare function Fold128Binary( byval op as Tko.TokenKind, byref l as ConstVal, byref r as ConstVal ) as ConstVal

end namespace

#endif
