'' semslice.tiko -- what 's[lo to hi]' may be written on, and a constant slice that cannot fit
'' (docs/tiko-slices RFC-0001 §3, §5). Asked of every N_CALL by latesweeps2.tiko; only the
'' '__tko_slice' calls parser/sliceexpr.tiko builds answer.
''
'' HERE AND NOT IN CHECK: Check types a node more than once, so a report made while typing it
'' came out twice, and Check has no source manager to fold a constant bound with. The sweep
'' visits a node once and has both.

#import "std/containers"
#include once "symbols/sem.ti"
#include once "diag/diagids.ti"
#include once "symbols/check.ti"
#include once "symbols/checkslice.ti"
#include once "types/udtlayout.ti"

namespace Tko.Sem

#include once "symbols/visctx.ti"
#include once "symbols/semcalls.ti"

'' A bound folded to a constant, or not known.
private function SliceBound_ _
    ( byref c as Ctx, byval ix as NodeId, byval at as NodeId, byref v as int64 ) as boolean
    if c.srcMgr = nullptr then return false
    dim as ScopeId sc = c.info->ScopeOf( ix )
    if sc = SCOPE_NONE then sc = c.info->ScopeOf( at )
    if sc = SCOPE_NONE then sc = SCOPE_GLOBAL
    dim as Check.ConstVal cv = Check.ConstOf( *c.ast, ix, *c.srcMgr, *c.names, 64, _
        c.syms, sc, 0, c.types, c.info )
    if cv.known = false then return false
    v = cv.value
    return true
end function

'' 'slice( p )' / 'slice( p, n )' (RFC-0001 §3): the slice type named as a constructor over a
'' zstring or wstring POINTER of its width, and an optional count. The pointer's const is not
'' in the call's type, so ConstPtrCtor_ answers it for TKO1052.
private function SliceCtorType_ ( byref c as Ctx, byval id as NodeId ) as TypeId
    if c.ast->Kind( id ) <> N_CALL then return TYPE_NONE
    dim as ListPayload ptr lp = c.ast->ListOf( id )
    if lp->target = NODE_NONE then return TYPE_NONE
    dim as Symbol ptr ts = c.syms->SymbolAt( c.info->RefOf( lp->target ) )
    if ts = nullptr then return TYPE_NONE
    if (ts->kind <> cast( uint8, SYM_UDT )) andalso (ts->kind <> cast( uint8, SYM_TYPEDEF )) then return TYPE_NONE
    if Slices.SliceUnitOfType( *c.types, *c.names, ts->type_ ) = Slices.SU_NONE then return TYPE_NONE
    return ts->type_
end function

private function ConstPtrCtor_ ( byref c as Ctx, byval id as NodeId ) as boolean
    if SliceCtorType_( c, id ) = TYPE_NONE then return false
    dim as ListPayload ptr lp = c.ast->ListOf( id )
    if lp->count < 1 then return false
    dim as TypeId at = c.types->Unqualify( c.info->TypeOf_( c.ast->ChildAt( lp->first, 0 ) ) )
    if c.types->Kind( at ) <> TK_POINTER then return false
    return c.types->IsConst( c.types->Inner( at ) )
end function

sub CheckSliceCtor_ ( byref c as Ctx, byval id as NodeId )
    dim as TypeId st = SliceCtorType_( c, id )
    if st = TYPE_NONE then return
    dim as ListPayload ptr lp = c.ast->ListOf( id )
    dim as TypeId at = TYPE_NONE
    if lp->count >= 1 then at = c.info->TypeOf_( c.ast->ChildAt( lp->first, 0 ) )
    dim as Slices.SliceSource ss
    dim as boolean ok = (lp->count = 1) orelse (lp->count = 2)
    if ok andalso (at <> TYPE_NONE) then
        ok = (Slices.SliceSourceOf( *c.types, *c.names, at, ss ) = Slices.SliceUnitOfType( *c.types, *c.names, st )) andalso (ss = Slices.SS_PTR)
    end if
    if ok = false then c.diags->Report( TKO1050, PointRange( c.ast->Loc( lp->target ) ), iif( at = TYPE_NONE, "( )", c.types->Name( at ) ) )
end sub

sub CheckSliceCall_ ( byref c as Ctx, byval id as NodeId )
    CheckSliceCtor_( c, id )
    if Slices.IsSliceCall( *c.ast, *c.names, id ) = false then return
    dim as ListPayload ptr cp = c.ast->ListOf( id )
    dim as NodeId src = c.ast->ChildAt( cp->first, 0 )
    dim as TypeId st = c.info->TypeOf_( src )
    if st = TYPE_NONE then return
    dim as Slices.SliceSource ss
    if Slices.SliceSourceOf( *c.types, *c.names, st, ss ) = Slices.SU_NONE then
        c.diags->Report( TKO1050, PointRange( c.ast->Loc( cp->target ) ), c.types->Name( st ) )
        return
    end if

    '' RFC-0001 §5: valid iff 0 <= lo <= hi + 1 <= len. Without the source's length only the
    '' first two can be judged; 'string * N' has a constant one, and 'zstring * N' holds at
    '' most N - 1 units whatever is in it.
    dim as int64 lo, hi
    dim as boolean loK = SliceBound_( c, c.ast->ChildAt( cp->first, 1 ), id, lo )
    dim as boolean hiK = SliceBound_( c, c.ast->ChildAt( cp->first, 2 ), id, hi )
    dim as int64 cap = -1
    if (ss = Slices.SS_FIXED) orelse (ss = Slices.SS_ZFIXED) then
        dim as TypeId bt = c.types->Unqualify( st )
        if c.types->Kind( bt ) = TK_REFERENCE then bt = c.types->Unqualify( c.types->Inner( bt ) )
        if c.types->Kind( bt ) = TK_ARRAY then
            cap = c.types->ElemCount( bt )
            if ss = Slices.SS_ZFIXED then cap -= 1
        end if
    end if
    dim as boolean bad = false
    if loK andalso (lo < 0) then bad = true
    if loK andalso hiK andalso (lo > hi + 1) then bad = true
    if hiK andalso (hi < -1) then bad = true
    if hiK andalso (cap >= 0) andalso (hi + 1 > cap) then bad = true
    if bad = false then return
    dim as string nm = c.types->Name( st )
    if c.ast->Kind( src ) = N_IDENT then nm = c.names->Spelling( c.ast->IdentOf( src )->name )
    dim as string upper = "len - 1"
    if cap >= 0 then upper = str( cap - 1 )
    c.diags->Report( TKO1051, PointRange( c.ast->Loc( cp->target ) ), _
        iif( loK, str( lo ), "lo" ) & " to " & iif( hiK, str( hi ), "hi" ), nm, upper )
end sub

'' CONST TEXT STAYS CONST (RFC-0001 §2, TKO1052). A slice of a literal, a const string or a
'' temporary is a 'const slice', and handing it to a mutable one would let 'v[i] = x' write
'' where nothing may. Judged wherever a slice value lands: an initialiser, an assignment, a
'' 'return', an argument. The reverse, mutable into const, is the ordinary widening.
private function ConstDropped_ ( byref c as Ctx, byval dst as TypeId, byval src as TypeId ) as boolean
    if (dst = TYPE_NONE) orelse (src = TYPE_NONE) then return false
    if Slices.SliceUnitOfType( *c.types, *c.names, dst ) = Slices.SU_NONE then return false
    if Slices.SliceUnitOfType( *c.types, *c.names, src ) = Slices.SU_NONE then return false
    '' Through 'v[i]': the element is const exactly when its slice is (SliceElemType).
    dim as boolean dc = c.types->IsConst( Slices.SliceElemType( *c.types, *c.names, dst ) )
    dim as boolean sc = c.types->IsConst( Slices.SliceElemType( *c.types, *c.names, src ) )
    return sc andalso (dc = false)
end function

'' ...AND 'slice( p )' over a 'const zstring ptr' into a mutable slice.
private function CtorDropped_ ( byref c as Ctx, byval dst as TypeId, byval src as NodeId ) as boolean
    if Slices.SliceUnitOfType( *c.types, *c.names, dst ) = Slices.SU_NONE then return false
    if c.types->IsConst( Slices.SliceElemType( *c.types, *c.names, dst ) ) then return false
    return ConstPtrCtor_( c, src )
end function

private sub ReportDropped_ ( byref c as Ctx, byval at as NodeId, byval dst as TypeId )
    dim as string nm = "slice"
    select case Slices.SliceUnitOfType( *c.types, *c.names, dst )
    case Slices.SU_UTF16 : nm = "uslice"
    case Slices.SU_WIDE : nm = "wslice"
    end select
    c.diags->Report( TKO1052, PointRange( c.ast->Loc( at ) ), nm )
end sub

'' A STRING FOR A MUTABLE SLICE PARAMETER (RFC-0001 §8): only a same-width variable -- or a
'' pointer -- is viewed in place. A literal, a temporary or another width would be copied into
'' a temporary first, and a write through the slice would land in the copy and be lost:
'' TKO1053. A CONST string variable is TKO1052, as a const slice is.
private sub MutableSliceArg_ ( byref c as Ctx, byval pt as TypeId, byval arg as NodeId )
    dim as Slices.SliceUnit pu = Slices.SliceUnitOfType( *c.types, *c.names, pt )
    if pu = Slices.SU_NONE then return
    if c.types->IsConst( Slices.SliceElemType( *c.types, *c.names, pt ) ) then return
    dim as TypeId at = c.info->TypeOf_( arg )
    if at = TYPE_NONE then return
    dim as Slices.SliceSource ss
    dim as Slices.SliceUnit au = Slices.SliceSourceOf( *c.types, *c.names, at, ss )
    if (au = Slices.SU_NONE) orelse (ss = Slices.SS_SLICE) then return
    dim as NodeId u = arg
    while (c.ast->Kind( u ) = N_PAREN) andalso (c.ast->ListOf( u )->count = 1)
        u = c.ast->ChildAt( c.ast->ListOf( u )->first, 0 )
    wend
    dim as boolean own = (ss = Slices.SS_PTR)
    select case c.ast->Kind( u )
    case N_IDENT
        dim as Symbol ptr s = c.syms->SymbolAt( c.info->RefOf( u ) )
        if s <> nullptr then own = (s->kind = cast( uint8, SYM_VARIABLE )) orelse (s->kind = cast( uint8, SYM_PARAMETER )) orelse (s->kind = cast( uint8, SYM_FIELD ))
    case N_MEMBER, N_INDEX, N_DEREF
        own = true
    case N_CALL
        dim as Symbol ptr ts = c.syms->SymbolAt( c.info->RefOf( c.ast->ListOf( u )->target ) )
        if ts <> nullptr then own = (ts->kind = cast( uint8, SYM_VARIABLE )) orelse (ts->kind = cast( uint8, SYM_PARAMETER )) orelse (ts->kind = cast( uint8, SYM_FIELD ))
    case N_STRING_LIT, N_STRCAT, N_BINARY
        own = false
    end select
    dim as string pn = c.types->Name( c.types->Unqualify( pt ) )
    if c.types->Kind( c.types->Unqualify( pt ) ) = TK_TYPEDEF then pn = c.types->Name( c.types->Unqualify( c.types->Inner( c.types->Unqualify( pt ) ) ) )
    if (au <> pu) orelse (own = false) then
        dim as string sn = "string"
        if pu = Slices.SU_UTF16 then sn = "ustring"
        if pu = Slices.SU_WIDE then sn = "wstring"
        c.diags->Report( TKO1053, PointRange( c.ast->Loc( arg ) ), pn, sn, c.types->Name( at ) )
        return
    end if
    '' A const variable, or a pointer to const text.
    dim as boolean cst = c.types->IsConst( at )
    if (cst = false) andalso (c.types->Kind( c.types->Unqualify( at ) ) = TK_POINTER) then cst = c.types->IsConst( c.types->Inner( c.types->Unqualify( at ) ) )
    if cst then c.diags->Report( TKO1052, PointRange( c.ast->Loc( arg ) ), pn )
end sub

sub CheckSliceConst_ ( byref c as Ctx, byval id as NodeId, byval resultType as TypeId )
    select case c.ast->Kind( id )
    case N_VAR_ITEM
        dim as StmtPayload ptr ip = c.ast->StmtOf( id )
        if (ip->a = NODE_NONE) orelse (ip->b = NODE_NONE) then return
        if ConstDropped_( c, c.info->TypeOf_( ip->a ), c.info->TypeOf_( ip->b ) ) orelse CtorDropped_( c, c.info->TypeOf_( ip->a ), ip->b ) then ReportDropped_( c, ip->b, c.info->TypeOf_( ip->a ) )
    case N_AMBIGUOUS
        if c.info->AmbiguousOf( id ) <> AMB_ASSIGN then return
        dim as StmtPayload ptr sp = c.ast->StmtOf( id )
        if (sp->a = NODE_NONE) orelse (sp->b = NODE_NONE) then return
        dim as TypeId lt = c.info->TypeOf_( sp->a )
        if (lt = TYPE_NONE) andalso (c.ast->Kind( sp->a ) = N_FUNCRESULT) then lt = resultType
        if ConstDropped_( c, lt, c.info->TypeOf_( sp->b ) ) orelse CtorDropped_( c, lt, sp->b ) then ReportDropped_( c, sp->b, lt )
    case N_RETURN
        dim as NodeId e = c.ast->StmtOf( id )->a
        if e = NODE_NONE then return
        if ConstDropped_( c, resultType, c.info->TypeOf_( e ) ) orelse CtorDropped_( c, resultType, e ) then ReportDropped_( c, e, resultType )
    case N_CALL
        dim as ListPayload ptr lp = c.ast->ListOf( id )
        if lp->target = NODE_NONE then return
        dim as Symbol ptr callee = c.syms->SymbolAt( c.info->RefOf( id ) )
        if callee = nullptr then callee = c.syms->SymbolAt( c.info->RefOf( lp->target ) )
        if callee = nullptr then return
        if callee->kind <> cast( uint8, SYM_PROC ) then return
        dim as NodeId decl = cast( NodeId, callee->payload )
        if decl = NODE_NONE then return
        if c.ast->Kind( decl ) <> N_PROC then return
        dim as StmtPayload ptr pp = c.ast->StmtOf( decl )
        dim as int32 ai = 0
        for i as int32 = 0 to pp->count - 1
            dim as NodeId prm = c.ast->ChildAt( pp->first, i )
            if c.ast->Kind( prm ) <> N_PARAM then continue for
            if ai >= lp->count then exit for
            dim as NodeId arg = c.ast->ChildAt( lp->first, ai )
            ai += 1
            dim as StmtPayload ptr prp = c.ast->StmtOf( prm )
            if prp->a = NODE_NONE then continue for
            dim as TypeId pt = c.info->TypeOf_( prp->a )
            if ConstDropped_( c, pt, c.info->TypeOf_( arg ) ) orelse CtorDropped_( c, pt, arg ) then ReportDropped_( c, arg, pt )
            MutableSliceArg_( c, pt, arg )
            if Slices.SliceIntoZstring( *c.types, c.info->TypeOf_( arg ), pt ) then c.diags->Report( TKO0698, PointRange( c.ast->Loc( arg ) ) )
        next
    end select
end sub

'' ============================================================ RFC-0002: lifetime (P3a)
''
'' A slice borrows; these rules keep the borrow inside what it borrows from, with no annotations.
'' Every slice value has an ORIGIN -- the storage it ultimately points into -- ranked by how long
'' it lives: FOREVER (a literal, a shared or static string, a pointer, which is trusted), CALLER
'' (a byref string parameter, a slice parameter, a field through 'this'), LOCAL at a scope, and
'' TEMP (a call's result, a concatenation, a copy made for an argument), which ends with the
'' statement. UNKNOWN is let through: a rule that cannot see must not refuse.
const ORG_FOREVER = 0
const ORG_CALLER = 1
const ORG_LOCAL = 2
const ORG_TEMP = 3
const ORG_UNKNOWN = 4

type SliceOrigin
    as int32    kind
    as ScopeId  scope_
    as SymbolId sym
end type

private function Org_( byval k as int32, byval sc as ScopeId = SCOPE_NONE, byval s as SymbolId = SYMBOL_NONE ) as SliceOrigin
    dim as SliceOrigin o
    o.kind = k : o.scope_ = sc : o.sym = s
    return o
end function

'' a encloses b (or is b): what lives in a lives at least as long as what lives in b.
private function Encloses_( byref c as Ctx, byval a as ScopeId, byval b as ScopeId ) as boolean
    dim as int32 guard = 0
    while (b <> SCOPE_NONE) andalso (guard < 256)
        guard += 1
        if b = a then return true
        dim as SymScope ptr ss = c.syms->ScopeAt( b )
        if ss = nullptr then exit while
        b = ss->parent
    wend
    return false
end function

'' The shorter-lived of two origins.
private function Shorter_( byref c as Ctx, byref a as SliceOrigin, byref b as SliceOrigin ) as SliceOrigin
    if a.kind = ORG_UNKNOWN then return b
    if b.kind = ORG_UNKNOWN then return a
    if a.kind <> b.kind then
        if a.kind > b.kind then return a
        return b
    end if
    if a.kind <> ORG_LOCAL then return a
    if Encloses_( c, a.scope_, b.scope_ ) then return b
    return a
end function

private function LifeUnparen_( byref c as Ctx, byval e as NodeId ) as NodeId
    while (e <> NODE_NONE) andalso (c.ast->Kind( e ) = N_PAREN)
        if c.ast->ListOf( e )->count <> 1 then exit while
        e = c.ast->ChildAt( c.ast->ListOf( e )->first, 0 )
    wend
    return e
end function

'' A SLICE, OR A VIEW-KIND TYPE (RFC-0002 §3), which borrows as a slice does.
private function IsSliceT_( byref c as Ctx, byval t as TypeId ) as boolean
    if Slices.SliceUnitOfType( *c.types, *c.names, t ) <> Slices.SU_NONE then return true
    return Slices.IsViewType( *c.ast, *c.syms, *c.types, *c.names, t )
end function

'' A GENERIC INSTANCE WITH A SLICE OR VIEW TYPE ARGUMENT -- 'Array( of slice )' -- would keep slices
'' where nothing tracks them. The instance is named by its key, 'array<41>', the argument type
'' ids (symbols/generic.tiko); each is asked, and so is a nested instance.
private function GenericHoldsSlice_( byref c as Ctx, byval t as TypeId, byval depth as int32 = 0 ) as boolean
    if (t = TYPE_NONE) orelse (depth > 8) then return false
    t = c.types->Unqualify( t )
    if c.types->Kind( t ) <> TK_UDT then return false
    dim as string ks = c.names->Spelling( c.types->NameOf( t ) )
    dim as integer lt = instr( ks, "<" )
    if (lt = 0) orelse (right( ks, 1 ) <> ">") then return false
    dim as string args = mid( ks, lt + 1, len( ks ) - lt - 1 ) & ","
    dim as integer at = 1
    while at <= len( args )
        dim as integer cm = instr( at, args, "," )
        dim as string one = mid( args, at, cm - at )
        at = cm + 1
        if (len( one ) = 0) orelse (len( one ) > 9) then continue while
        dim as boolean digits = true
        for k as integer = 1 to len( one )
            if (asc( one, k ) < 48) orelse (asc( one, k ) > 57) then digits = false
        next
        if digits = false then continue while
        dim as TypeId a = cast( TypeId, valint( one ) )
        if (cast( int32, a ) <= 0) orelse (cast( int32, a ) >= c.types->Count( )) then continue while
        if IsSliceT_( c, a ) orelse GenericHoldsSlice_( c, a, depth + 1 ) then return true
    wend
    return false
end function

'' A variable or parameter as storage: where a string, or a slice, held in it lives.
private function SymOrigin_( byref c as Ctx, byval s as Symbol ptr, byval sid as SymbolId ) as SliceOrigin
    if s = nullptr then return Org_( ORG_UNKNOWN )
    select case s->kind
    case cast( uint8, SYM_VARIABLE )
        if (s->flags and (SYMF_SHARED or SYMF_STATIC or SYMF_EXTERN or SYMF_COMMON)) <> 0 then return Org_( ORG_FOREVER, , sid )
        return Org_( ORG_LOCAL, s->parent, sid )
    case cast( uint8, SYM_PARAMETER )
        if s->type_ = TYPE_NONE then return Org_( ORG_UNKNOWN )
        '' A SLICE PARAMETER borrows from the caller's storage, byval or not; a BYREF one of any
        '' type IS the caller's storage; a byval string is the callee's own copy.
        if IsSliceT_( c, s->type_ ) then return Org_( ORG_CALLER, , sid )
        select case c.types->Kind( c.types->Unqualify( s->type_ ) )
        case TK_REFERENCE, TK_ARRAY : return Org_( ORG_CALLER, , sid )
        end select
        return Org_( ORG_LOCAL, s->parent, sid )
    case cast( uint8, SYM_FIELD )
        return Org_( ORG_CALLER, , sid )                     '' through 'this'
    case cast( uint8, SYM_CONSTANT )
        return Org_( ORG_FOREVER, , sid )
    end select
    return Org_( ORG_UNKNOWN )
end function

'' WHERE A STRING EXPRESSION'S TEXT LIVES -- the source of 's[lo to hi]'.
private function StorageOrigin_( byref c as Ctx, byval e as NodeId ) as SliceOrigin
    e = LifeUnparen_( c, e )
    if e = NODE_NONE then return Org_( ORG_UNKNOWN )
    dim as TypeId et = c.info->TypeOf_( e )
    if et <> TYPE_NONE then
        if c.types->Kind( c.types->Unqualify( et ) ) = TK_POINTER then return Org_( ORG_FOREVER )
    end if
    select case c.ast->Kind( e )
    case N_STRING_LIT, N_STRCAT
        return Org_( ORG_FOREVER )
    case N_IDENT
        dim as SymbolId sid = c.info->RefOf( e )
        return SymOrigin_( c, c.syms->SymbolAt( sid ), sid )
    case N_MEMBER
        if (c.ast->Flags( e ) and NF_ARROW) <> 0 then return Org_( ORG_FOREVER )
        dim as BinaryPayload ptr mp = c.ast->BinaryOf( e )
        if cast( TokenKind, mp->op ) = TK_ARROW then return Org_( ORG_FOREVER )
        return StorageOrigin_( c, mp->lhs )
    case N_DEREF, N_INDEX
        return Org_( ORG_FOREVER )
    case N_CALL
        dim as ListPayload ptr lp = c.ast->ListOf( e )
        dim as Symbol ptr ts = c.syms->SymbolAt( c.info->RefOf( lp->target ) )
        if ts <> nullptr then
            select case ts->kind
            case cast( uint8, SYM_VARIABLE ), cast( uint8, SYM_PARAMETER ), cast( uint8, SYM_FIELD )
                return StorageOrigin_( c, lp->target )        '' an array element
            end select
        end if
        return Org_( ORG_TEMP )
    end select
    return Org_( ORG_TEMP )
end function

declare function SliceOrigin_ ( byref c as Ctx, byval e as NodeId ) as SliceOrigin

'' A CALL RETURNING A SLICE borrows from every argument it could have taken one from: each
'' slice argument, each string bound to a byref or slice parameter. No annotations, so the
'' result's origin is the shortest of theirs (RFC-0002 §5); with none, nothing to borrow from.
function CallOrigin_( byref c as Ctx, byval e as NodeId ) as SliceOrigin
    dim as SliceOrigin o = Org_( ORG_FOREVER )
    dim as ListPayload ptr lp = c.ast->ListOf( e )
    dim as Symbol ptr callee = c.syms->SymbolAt( c.info->RefOf( e ) )
    if callee = nullptr then callee = c.syms->SymbolAt( c.info->RefOf( lp->target ) )
    if callee = nullptr then return Org_( ORG_UNKNOWN )
    if callee->kind <> cast( uint8, SYM_PROC ) then return Org_( ORG_UNKNOWN )
    dim as NodeId decl = cast( NodeId, callee->payload )
    if decl = NODE_NONE then return Org_( ORG_UNKNOWN )
    if c.ast->Kind( decl ) <> N_PROC then return Org_( ORG_UNKNOWN )
    dim as StmtPayload ptr pp = c.ast->StmtOf( decl )
    dim as int32 ai = 0
    for i as int32 = 0 to pp->count - 1
        dim as NodeId prm = c.ast->ChildAt( pp->first, i )
        if c.ast->Kind( prm ) <> N_PARAM then continue for
        if ai >= lp->count then exit for
        dim as NodeId arg = c.ast->ChildAt( lp->first, ai )
        ai += 1
        dim as StmtPayload ptr prp = c.ast->StmtOf( prm )
        if prp->a = NODE_NONE then continue for
        dim as TypeId pt = c.info->TypeOf_( prp->a )
        dim as SliceOrigin ao = Org_( ORG_UNKNOWN )
        if IsSliceT_( c, pt ) then
            if IsSliceT_( c, c.info->TypeOf_( arg ) ) then
                ao = SliceOrigin_( c, arg )
            else
                '' A string argument: viewed in place when its width matches and it has storage
                '' of its own, else a temporary copy (lowerslice.tiko LowerSliceArg).
                dim as Slices.SliceSource ss
                dim as Slices.SliceUnit au = Slices.SliceSourceOf( *c.types, *c.names, c.info->TypeOf_( arg ), ss )
                ao = StorageOrigin_( c, arg )
                if (au <> Slices.SliceUnitOfType( *c.types, *c.names, pt )) andalso (ao.kind <> ORG_FOREVER) then ao = Org_( ORG_TEMP )
            end if
        elseif (c.ast->Flags( prm ) and NF_BYREF) <> 0 then
            ao = StorageOrigin_( c, arg )
        else
            continue for
        end if
        o = Shorter_( c, o, ao )
    next
    return o
end function

'' The variable an assignment target writes into: 'v', 'v.f', '(v).f.g' -- not through a pointer.
private function TargetRoot_( byref c as Ctx, byval e as NodeId ) as SymbolId
    dim as int32 guard = 0
    while guard < 64
        guard += 1
        e = LifeUnparen_( c, e )
        select case c.ast->Kind( e )
        case N_IDENT
            return c.info->RefOf( e )
        case N_MEMBER
            if (c.ast->Flags( e ) and NF_ARROW) <> 0 then return SYMBOL_NONE
            dim as BinaryPayload ptr mp = c.ast->BinaryOf( e )
            if cast( TokenKind, mp->op ) = TK_ARROW then return SYMBOL_NONE
            e = mp->lhs
        case else
            return SYMBOL_NONE
        end select
    wend
    return SYMBOL_NONE
end function

'' A SLICE OR VIEW VARIABLE'S ORIGIN: the shortest of everything ever bound into it -- its
'' initialiser, each assignment to it or to a field of it, and each call that hands it to a
'' byref slice or view parameter (which may store any of that call's other arguments in it).
'' A variable nothing is bound into views nothing and lives FOREVER. Flow-insensitive, so sound
'' whatever the order; 'dim v as slice = s[0 to 2] : return v' over a byref s is legal.
private function VarOrigin_( byref c as Ctx, byval sid as SymbolId ) as SliceOrigin
    dim as int32 ck, cs, cy
    if c.sliceOrgKind.TryGet( cast( uint32, sid ), ck ) andalso c.sliceOrgScope.TryGet( cast( uint32, sid ), cs ) andalso c.sliceOrgSym.TryGet( cast( uint32, sid ), cy ) then
        return Org_( ck, cast( ScopeId, cs ), cast( SymbolId, cy ) )
    end if
    if c.sliceOrgBusy.Contains( cast( uint32, sid ) ) then return Org_( ORG_UNKNOWN )
    c.sliceOrgBusy.Put( cast( uint32, sid ), 1 )
    dim as SliceOrigin o = Org_( ORG_FOREVER )
    dim as Symbol ptr s = c.syms->SymbolAt( sid )
    dim as int32 first = 1
    if s <> nullptr then
        if (s->payload > 0) andalso (s->payload <= cast( uint32, c.ast->Count( ) )) then first = cast( int32, s->payload )
    end if
    for i as int32 = first to c.ast->Count( )
        dim as NodeId n = cast( NodeId, i )
        select case c.ast->Kind( n )
        case N_VAR_ITEM
            if (i = first) andalso (c.ast->StmtOf( n )->b <> NODE_NONE) then o = Shorter_( c, o, SliceOrigin_( c, c.ast->StmtOf( n )->b ) )
        case N_AMBIGUOUS
            if c.info->AmbiguousOf( n ) <> AMB_ASSIGN then continue for
            dim as StmtPayload ptr sp = c.ast->StmtOf( n )
            if (sp->a = NODE_NONE) orelse (sp->b = NODE_NONE) then continue for
            if TargetRoot_( c, sp->a ) <> sid then continue for
            o = Shorter_( c, o, SliceOrigin_( c, sp->b ) )
        case N_CALL
            dim as ListPayload ptr lp = c.ast->ListOf( n )
            for k as int32 = 0 to lp->count - 1
                dim as NodeId a = c.ast->ChildAt( lp->first, k )
                if TargetRoot_( c, a ) = sid then
                    dim as TypeId at = c.info->TypeOf_( a )
                    if IsSliceT_( c, at ) orelse Slices.IsViewType( *c.ast, *c.syms, *c.types, *c.names, at ) then
                        o = Shorter_( c, o, CallOrigin_( c, n ) )
                        exit for
                    end if
                end if
            next
        end select
    next
    c.sliceOrgBusy.Remove( cast( uint32, sid ) )
    c.sliceOrgKind.Put( cast( uint32, sid ), o.kind )
    c.sliceOrgScope.Put( cast( uint32, sid ), cast( int32, o.scope_ ) )
    c.sliceOrgSym.Put( cast( uint32, sid ), cast( int32, o.sym ) )
    return o
end function

'' WHERE A SLICE-TYPED EXPRESSION'S TEXT LIVES.
function SliceOrigin_ ( byref c as Ctx, byval e as NodeId ) as SliceOrigin
    e = LifeUnparen_( c, e )
    if e = NODE_NONE then return Org_( ORG_UNKNOWN )
    select case c.ast->Kind( e )
    case N_IDENT
        dim as SymbolId sid = c.info->RefOf( e )
        dim as Symbol ptr s = c.syms->SymbolAt( sid )
        if s = nullptr then return Org_( ORG_UNKNOWN )
        if (s->kind = cast( uint8, SYM_VARIABLE )) andalso ((s->flags and (SYMF_SHARED or SYMF_STATIC or SYMF_EXTERN or SYMF_COMMON)) = 0) then return VarOrigin_( c, sid )
        return SymOrigin_( c, s, sid )
    case N_CALL
        if Slices.IsSliceCall( *c.ast, *c.names, e ) then
            dim as NodeId src = c.ast->ChildAt( c.ast->ListOf( e )->first, 0 )
            if IsSliceT_( c, c.info->TypeOf_( src ) ) then return SliceOrigin_( c, src )
            return StorageOrigin_( c, src )
        end if
        if SliceCtorType_( c, e ) <> TYPE_NONE then return Org_( ORG_FOREVER )   '' slice( p ): trusted
        dim as ListPayload ptr lp = c.ast->ListOf( e )
        if c.ast->Kind( lp->target ) = N_IDENT then
            if lcase( c.names->Spelling( c.ast->IdentOf( lp->target )->name ) ) = "iif" then
                if lp->count = 3 then
                    dim as SliceOrigin a = SliceOrigin_( c, c.ast->ChildAt( lp->first, 1 ) )
                    dim as SliceOrigin b = SliceOrigin_( c, c.ast->ChildAt( lp->first, 2 ) )
                    return Shorter_( c, a, b )
                end if
            end if
        end if
        return CallOrigin_( c, e )
    case N_MEMBER, N_INDEX, N_DEREF
        return StorageOrigin_( c, e )
    end select
    return Org_( ORG_UNKNOWN )
end function

private function OriginName_( byref c as Ctx, byref o as SliceOrigin ) as string
    dim as Symbol ptr s = c.syms->SymbolAt( o.sym )
    if s = nullptr then return "a temporary"
    return c.names->Spelling( s->name )
end function

'' A slice value landing in storage that lives in scope dstScope (a local), or that the caller
'' owns (dstCaller). The value's origin must live at least as long.
private sub JudgeBinding_ _
    ( byref c as Ctx, byval value as NodeId, byval dstSym as SymbolId, _
      byval dstScope as ScopeId, byval dstCaller as boolean )
    dim as SliceOrigin o = SliceOrigin_( c, value )
    dim as Symbol ptr ds = c.syms->SymbolAt( dstSym )
    dim as string dn = "?"
    if ds <> nullptr then dn = c.names->Spelling( ds->name )
    select case o.kind
    case ORG_TEMP
        c.diags->Report( TKO1058, PointRange( c.ast->Loc( value ) ) )
    case ORG_LOCAL
        if dstCaller then
            c.diags->Report( TKO1061, PointRange( c.ast->Loc( value ) ), dn )
        elseif Encloses_( c, o.scope_, dstScope ) = false then
            c.diags->Report( TKO1057, PointRange( c.ast->Loc( value ) ), dn, OriginName_( c, o ) )
        end if
    end select
end sub

private function SliceName_( byref c as Ctx, byval t as TypeId ) as string
    select case Slices.SliceUnitOfType( *c.types, *c.names, t )
    case Slices.SU_NARROW : return "slice"
    case Slices.SU_UTF16 : return "uslice"
    case Slices.SU_WIDE : return "wslice"
    end select
    return "view '" & c.types->Name( c.types->Unqualify( t ) ) & "'"
end function

'' '@v' over a slice, stored rather than passed (RFC-0002 §2): TKO1056.
private sub JudgeAddrStore_( byref c as Ctx, byval value as NodeId )
    value = LifeUnparen_( c, value )
    if value = NODE_NONE then return
    if c.ast->Kind( value ) <> N_ADDROF then return
    dim as NodeId op = LifeUnparen_( c, c.ast->UnaryOf( value )->operand )
    if c.ast->Kind( op ) <> N_IDENT then return   '' a named slice; an element is the generic argument's error
    if IsSliceT_( c, c.info->TypeOf_( op ) ) = false then return
    c.diags->Report( TKO1056, PointRange( c.ast->Loc( value ) ), c.names->Spelling( c.ast->IdentOf( op )->name ) )
end sub

private sub JudgeReturn_( byref c as Ctx, byval e as NodeId )
    dim as SliceOrigin ro = SliceOrigin_( c, e )
    if ro.kind = ORG_TEMP then
        c.diags->Report( TKO1059, PointRange( c.ast->Loc( e ) ), "a temporary" )
    elseif ro.kind = ORG_LOCAL then
        c.diags->Report( TKO1059, PointRange( c.ast->Loc( e ) ), "local '" & OriginName_( c, ro ) & "'" )
    end if
end sub

'' ONCE: the user's declaration comes first in source order. The instance's own body -- and
'' the instances it makes in turn, 'ArrayIterator( of slice )' inside 'Array( of slice )' -- are
'' walked after it and would report the same mistake again inside the library's source.
private sub GenericArgOnce_( byref c as Ctx, byval id as NodeId, byval t as TypeId )
    if c.sliceGenSeen.Contains( 0 ) then return
    c.sliceGenSeen.Put( 0, 1 )
    c.diags->Report( TKO1054, PointRange( c.ast->Loc( id ) ), "slice", "a generic type argument" )
end sub

sub CheckSliceLife_ ( byref c as Ctx, byval id as NodeId, byval resultType as TypeId )
    select case c.ast->Kind( id )
    case N_VAR_ITEM
        dim as StmtPayload ptr ip = c.ast->StmtOf( id )
        dim as SymbolId sid = c.info->RefOf( id )
        '' AN ITEM'S OWN BINDING MAY BE EMPTY: looked up by name where it was declared, as
        '' declshape.tiko does.
        if sid = SYMBOL_NONE then sid = c.syms->LookupTyped( c.info->ScopeOf( id ), ip->name, false )
        if ip->b <> NODE_NONE then JudgeAddrStore_( c, ip->b )
        if ip->a <> NODE_NONE then
            dim as TypeId wt = c.info->TypeOf_( ip->a )
            if (IsSliceT_( c, wt ) = false) andalso GenericHoldsSlice_( c, wt ) then
                GenericArgOnce_( c, id, wt )
                return
            end if
        end if
        '' ...AND WHEN NOTHING NAMES IT, the symbol whose declaration this item is -- asked only of a
        '' slice-typed item, so the walk is rare.
        if (sid = SYMBOL_NONE) andalso (ip->a <> NODE_NONE) andalso IsSliceT_( c, c.info->TypeOf_( ip->a ) ) then
            for si as int32 = 1 to c.syms->symbols.Count - 1
                if c.syms->symbols[si].payload = cast( uint32, id ) then
                    if c.syms->symbols[si].kind = cast( uint8, SYM_VARIABLE ) then sid = cast( SymbolId, si ) : exit for
                end if
            next
        end if
        dim as Symbol ptr s = c.syms->SymbolAt( sid )
        if s = nullptr then return
        dim as TypeId vt = s->type_
        dim as boolean isArr = (c.ast->Flags( id ) and NF_ARRAY) <> 0
        if vt <> TYPE_NONE then
            if (c.types->Kind( c.types->Unqualify( vt ) ) = TK_ARRAY) orelse c.types->IsDynArray( c.types->Unqualify( vt ) ) then isArr = true : vt = c.types->Inner( c.types->Unqualify( vt ) )
        end if
        if IsSliceT_( c, vt ) = false then return
        dim as string what = ""
        if (s->flags and SYMF_SHARED) <> 0 then what = "shared"
        if (s->flags and SYMF_STATIC) <> 0 then what = "static"
        if (s->flags and SYMF_COMMON) <> 0 then what = "common"
        if (s->flags and SYMF_EXTERN) <> 0 then what = "extern"
        if isArr then what = "an array element"
        if len( what ) then
            c.diags->Report( TKO1054, PointRange( c.ast->Loc( id ) ), SliceName_( c, vt ), what )
            return
        end if
        if ip->b <> NODE_NONE then JudgeBinding_( c, ip->b, sid, s->parent, false )
    case N_AMBIGUOUS
        dim as StmtPayload ptr sp = c.ast->StmtOf( id )
        if (sp->a = NODE_NONE) orelse (sp->b = NODE_NONE) then return
        if (c.ast->Kind( sp->a ) = N_FUNCRESULT) andalso IsSliceT_( c, resultType ) then JudgeReturn_( c, sp->b ) : return
        if c.info->AmbiguousOf( id ) <> AMB_ASSIGN then return
        JudgeAddrStore_( c, sp->b )
        '' 'function = e', and BASIC's 'Name = e' to the enclosing function: a return.
        dim as boolean isResult = (c.ast->Kind( sp->a ) = N_FUNCRESULT)
        if (isResult = false) andalso (c.ast->Kind( sp->a ) = N_IDENT) then
            dim as Symbol ptr fs = c.syms->SymbolAt( c.info->RefOf( sp->a ) )
            if fs <> nullptr then isResult = (fs->kind = cast( uint8, SYM_PROC ))
        end if
        if isResult then
            if IsSliceT_( c, resultType ) then JudgeReturn_( c, sp->b )
            return
        end if
        if IsSliceT_( c, c.info->TypeOf_( sp->a ) ) = false then return
        '' A SPAWN'S FRAME, filled by the parser's '__tko_sf->__ARG_k = arg' (parser/spawn.tiko): the
        '' frame is a heap object the new task reads after this frame may be gone.
        scope
            dim as NodeId fm = LifeUnparen_( c, sp->a )
            if c.ast->Kind( fm ) = N_MEMBER then
                dim as NodeId fr = c.ast->BinaryOf( fm )->rhs
                if c.ast->Kind( fr ) = N_IDENT then
                    if left( lcase( c.names->Spelling( c.ast->IdentOf( fr )->name ) ), 6 ) = "__arg_" then
                        dim as NodeId av = LifeUnparen_( c, sp->b )
                        dim as string an = SliceName_( c, c.info->TypeOf_( sp->a ) )
                        if c.ast->Kind( av ) = N_IDENT then an = c.names->Spelling( c.ast->IdentOf( av )->name )
                        c.diags->Report( TKO1060, PointRange( c.ast->Loc( sp->b ) ), "'spawn'", an )
                        return
                    end if
                end if
            end if
        end scope
        '' THE STORAGE WRITTEN: a variable, or a field of one -- 'lx.src = s[0 to 3]' binds into lx.
        dim as SymbolId did = TargetRoot_( c, sp->a )
        dim as Symbol ptr dsym = c.syms->SymbolAt( did )
        if dsym = nullptr then return
        dim as boolean caller = false
        select case dsym->kind
        case cast( uint8, SYM_PARAMETER )
            '' A byref parameter, or 'this' -- the caller's object -- is storage the caller owns.
            caller = (c.types->Kind( c.types->Unqualify( dsym->type_ ) ) = TK_REFERENCE) orelse _
                     (c.types->Kind( c.types->Unqualify( dsym->type_ ) ) = TK_POINTER)
        case cast( uint8, SYM_FIELD )
            caller = true                                    '' a field through implicit 'this'
        case cast( uint8, SYM_VARIABLE )
        case else
            return
        end select
        JudgeBinding_( c, sp->b, did, dsym->parent, caller )
    case N_RETURN
        dim as NodeId e = c.ast->StmtOf( id )->a
        if e = NODE_NONE then return
        JudgeAddrStore_( c, e )
        if IsSliceT_( c, resultType ) then JudgeReturn_( c, e )
    case N_NEW
        dim as TypeId nt = c.info->TypeOf_( id )
        if nt = TYPE_NONE then return
        nt = c.types->Unqualify( nt )
        if c.types->Kind( nt ) <> TK_POINTER then return
        if IsSliceT_( c, c.types->Inner( nt ) ) then
            c.diags->Report( TKO1054, PointRange( c.ast->Loc( id ) ), SliceName_( c, c.types->Inner( nt ) ), "allocated with new" )
        end if
    case N_FIELD
        dim as StmtPayload ptr fp = c.ast->StmtOf( id )
        if fp->a = NODE_NONE then return
        dim as TypeId ft = c.info->TypeOf_( fp->a )
        if (IsSliceT_( c, ft ) = false) andalso GenericHoldsSlice_( c, ft ) then
            GenericArgOnce_( c, id, ft )
            return
        end if
        if IsSliceT_( c, ft ) = false then return
        dim as string tn = "?"
        dim as Symbol ptr ow = nullptr
        dim as SymScope ptr fss = c.syms->ScopeAt( c.info->ScopeOf( id ) )
        if fss <> nullptr then ow = c.syms->SymbolAt( fss->owner )
        if ow <> nullptr then
            tn = c.names->Spelling( ow->name )
            '' A VIEW-KIND TYPE MAY HOLD ONE (RFC-0002 §3); it obeys the same rules itself.
            if Slices.IsViewType( *c.ast, *c.syms, *c.types, *c.names, ow->type_ ) then return
        end if
        '' A SPAWN'S FRAME copies the call's arguments into a heap object (parser/spawn.tiko).
        if left( lcase( c.names->Spelling( fp->name ) ), 6 ) = "__arg_" then
            c.diags->Report( TKO1060, PointRange( c.ast->Loc( id ) ), "'spawn'", SliceName_( c, ft ) )
            return
        end if
        c.diags->Report( TKO1055, PointRange( c.ast->Loc( id ) ), tn, c.names->Spelling( fp->name ) )
    case N_CLOSURE
        '' A CAPTURING LAMBDA copies or references each capture into its closure object, which
        '' outlives the frame (RFC-0002 §2). One child per capture.
        dim as StmtPayload ptr cp = c.ast->StmtOf( id )   '' a statement payload (resolvesynth.tiko)
        for k as int32 = 0 to cp->count - 1
            dim as NodeId cap = c.ast->ChildAt( cp->first, k )
            if IsSliceT_( c, c.info->TypeOf_( cap ) ) then
                dim as string cn = "?"
                if c.ast->Kind( cap ) = N_IDENT then cn = c.names->Spelling( c.ast->IdentOf( cap )->name )
                c.diags->Report( TKO1060, PointRange( c.ast->Loc( cap ) ), "a lambda", cn )
            end if
        next
    end select
end sub


'' ============================================================ RFC-0002 §6: the source lock (P4)
''
'' A string is mutable in place and 's &= "x"' may move its buffer (fb_hStrRealloc), so a slice
'' of s taken before is left pointing at freed memory. Between a slice's binding and its last
'' use, a REALLOC-CAPABLE write to what it borrows from is TKO1062 -- within one procedure;
'' through a callee's byref parameter is the -exx anchor's (P5).
''
'' One walk per procedure body (and the module's own code), in source order, keeping:
''   what each slice or view variable borrows NOW -- string variables and parameters, rebinding
''     replaces, a field assignment adds;
''   WRITES that may reallocate -- assignment, '&=', 'let', swap, input, line input, a byref
''     non-const argument -- over a var-length string or a UDT that may hold one; a write in
''     place ('s[i] = x', the MID statement) is none;
''   PENDING writes: a write to s while a slice v borrows s. A later use of v is the error; a
''     rebinding of v ends it;
''   per LOOP, the uses and rebindings seen in it: a write inside a loop is also an error when
''     v was used earlier in the body and not rebound before that use -- the next iteration
''     reads it.

type LockState
    as containers.Array( of uint32 ) bv, bs          '' v borrows s, now
    as containers.Array( of uint32 ) pv, ps, pw      '' pending: v, s, the write's node
    as containers.Array( of uint8 )  pdone            '' reported or ended
    as containers.Array( of uint32 ) uv, un, urb      '' use log: v, node, rebind-log count then
    as containers.Array( of uint32 ) rv               '' rebind log: v
    as containers.Array( of uint32 ) lpU, lpR, lpP    '' open loops: use, rebind and pending marks
    as containers.Array( of uint32 ) pq, uq           '' the walk's order of each write and use
    as uint32 seq
end type

private function LockLine_( byref c as Ctx, byval n as NodeId ) as int32
    if c.srcMgr = nullptr then return 0
    return c.srcMgr->Decode( c.ast->Loc( n ) ).lineNo
end function

private sub LockReport_( byref c as Ctx, byref st as LockState, byval k as int32, byval useNode as NodeId )
    if st.pdone[k] <> 0 then return
    st.pdone[k] = 1
    dim as Symbol ptr ss = c.syms->SymbolAt( cast( SymbolId, st.ps[k] ) )
    dim as Symbol ptr vs = c.syms->SymbolAt( cast( SymbolId, st.pv[k] ) )
    if (ss = nullptr) orelse (vs = nullptr) then return
    c.diags->Report( TKO1062, PointRange( c.ast->Loc( cast( NodeId, st.pw[k] ) ) ), _
        c.names->Spelling( ss->name ), c.names->Spelling( vs->name ), str( LockLine_( c, useNode ) ) )
end sub

'' The variable or parameter at the root of a string expression, for the borrow -- SYMBOL_NONE for
'' a literal, a temporary or anything through a pointer.
private function StringRoot_( byref c as Ctx, byval e as NodeId ) as SymbolId
    e = LifeUnparen_( c, e )
    select case c.ast->Kind( e )
    case N_IDENT, N_MEMBER
        dim as SymbolId r = TargetRoot_( c, e )
        dim as Symbol ptr s = c.syms->SymbolAt( r )
        if s = nullptr then return SYMBOL_NONE
        if (s->kind = cast( uint8, SYM_VARIABLE )) orelse (s->kind = cast( uint8, SYM_PARAMETER )) then return r
    case N_CALL
        '' An array element: the array's variable.
        dim as ListPayload ptr lp = c.ast->ListOf( e )
        dim as Symbol ptr ts = c.syms->SymbolAt( c.info->RefOf( lp->target ) )
        if ts <> nullptr then
            if (ts->kind = cast( uint8, SYM_VARIABLE )) orelse (ts->kind = cast( uint8, SYM_PARAMETER )) then return StringRoot_( c, lp->target )
        end if
    end select
    return SYMBOL_NONE
end function

'' THE STRINGS A SLICE OR VIEW VALUE BORROWS, appended to out_.
private sub LockSources_( byref c as Ctx, byref st as LockState, byval e as NodeId, byref out_ as containers.Array( of uint32 ), byval depth as int32 = 0 )
    if depth > 16 then return
    e = LifeUnparen_( c, e )
    if e = NODE_NONE then return
    select case c.ast->Kind( e )
    case N_IDENT, N_MEMBER
        dim as SymbolId r = TargetRoot_( c, e )
        if r = SYMBOL_NONE then return
        for i as int32 = 0 to st.bv.Count - 1
            if st.bv[i] = cast( uint32, r ) then out_.Push( st.bs[i] )
        next
    case N_CALL
        dim as ListPayload ptr lp = c.ast->ListOf( e )
        if Slices.IsSliceCall( *c.ast, *c.names, e ) then
            dim as NodeId src = c.ast->ChildAt( lp->first, 0 )
            if IsSliceT_( c, c.info->TypeOf_( src ) ) then
                LockSources_( c, st, src, out_, depth + 1 )
            else
                dim as SymbolId r = StringRoot_( c, src )
                if r <> SYMBOL_NONE then out_.Push( cast( uint32, r ) )
            end if
            return
        end if
        '' A call returning a slice, or iif: every slice argument, every string root argument.
        for k as int32 = 0 to lp->count - 1
            dim as NodeId a = c.ast->ChildAt( lp->first, k )
            if IsSliceT_( c, c.info->TypeOf_( a ) ) then
                LockSources_( c, st, a, out_, depth + 1 )
            else
                dim as SymbolId r = StringRoot_( c, a )
                if r <> SYMBOL_NONE then out_.Push( cast( uint32, r ) )
            end if
        next
    end select
end sub

'' MAY A WRITE OF THIS TYPE REALLOCATE: a var-length string, or a UDT, which may hold one.
private function ReallocType_( byref c as Ctx, byval t as TypeId ) as boolean
    if t = TYPE_NONE then return false
    t = c.types->Unqualify( t )
    if c.types->Kind( t ) = TK_REFERENCE then t = c.types->Unqualify( c.types->Inner( t ) )
    if IsSliceT_( c, t ) then return false
    select case c.types->Kind( t )
    case TK_BUILTIN
        select case c.types->BuiltinOf( t )
        case TY_STRING, TY_USTRING : return true
        end select
    case TK_UDT
        return true
    end select
    return false
end function

private sub LockWrite_( byref c as Ctx, byref st as LockState, byval s as SymbolId, byval w as NodeId )
    if s = SYMBOL_NONE then return
    for i as int32 = 0 to st.bv.Count - 1
        if st.bs[i] = cast( uint32, s ) then
            st.seq += 1
            st.pv.Push( st.bv[i] ) : st.ps.Push( cast( uint32, s ) ) : st.pw.Push( cast( uint32, w ) ) : st.pdone.Push( 0 ) : st.pq.Push( st.seq )
        end if
    next
end sub

private sub LockUse_( byref c as Ctx, byref st as LockState, byval v as SymbolId, byval n as NodeId )
    for k as int32 = 0 to st.pv.Count - 1
        if (st.pv[k] = cast( uint32, v )) andalso (st.pdone[k] = 0) then LockReport_( c, st, k, n )
    next
    st.seq += 1
    st.uv.Push( cast( uint32, v ) ) : st.un.Push( cast( uint32, n ) ) : st.urb.Push( cast( uint32, st.rv.Count ) ) : st.uq.Push( st.seq )
end sub

'' v is bound to a value borrowing srcs: a whole rebinding replaces what it borrowed and ends
'' its pending writes; a field assignment adds.
private sub LockBind_( byref c as Ctx, byref st as LockState, byval v as SymbolId, byref srcs as containers.Array( of uint32 ), byval whole as boolean )
    if whole then
        for i as int32 = st.bv.Count - 1 to 0 step -1
            if st.bv[i] = cast( uint32, v ) then st.bs[i] = 0
        next
        for k as int32 = 0 to st.pv.Count - 1
            if st.pv[k] = cast( uint32, v ) then st.pdone[k] = 1
        next
        st.rv.Push( cast( uint32, v ) )
    end if
    for j as int32 = 0 to srcs.Count - 1
        st.bv.Push( cast( uint32, v ) ) : st.bs.Push( srcs[j] )
    next
end sub

'' A slice or view variable a node names, or SYMBOL_NONE.
private function SliceVar_( byref c as Ctx, byval e as NodeId ) as SymbolId
    dim as SymbolId r = c.info->RefOf( e )
    dim as Symbol ptr s = c.syms->SymbolAt( r )
    if s = nullptr then return SYMBOL_NONE
    if (s->kind <> cast( uint8, SYM_VARIABLE )) andalso (s->kind <> cast( uint8, SYM_PARAMETER )) then return SYMBOL_NONE
    if IsSliceT_( c, s->type_ ) = false then return SYMBOL_NONE
    return r
end function

declare sub LockWalk_( byref c as Ctx, byref st as LockState, byval id as NodeId, byval root as NodeId )

'' A slice-typed dim item's symbol: its binding, a lookup where it was declared, or the symbol whose
'' declaration it is (CheckSliceLife_ meets the same empty binding).
private function ItemSym_( byref c as Ctx, byval id as NodeId ) as SymbolId
    dim as StmtPayload ptr ip = c.ast->StmtOf( id )
    '' 'var v = s[0 to 4]' WRITES NO TYPE: its value's type is the slice's.
    dim as TypeId wt = TYPE_NONE
    if ip->a <> NODE_NONE then wt = c.info->TypeOf_( ip->a ) else wt = c.info->TypeOf_( ip->b )
    if IsSliceT_( c, wt ) = false then return SYMBOL_NONE
    dim as SymbolId sid = c.info->RefOf( id )
    if sid = SYMBOL_NONE then sid = c.syms->LookupTyped( c.info->ScopeOf( id ), ip->name, false )
    if sid = SYMBOL_NONE then
        for si as int32 = 1 to c.syms->symbols.Count - 1
            if (c.syms->symbols[si].payload = cast( uint32, id )) andalso (c.syms->symbols[si].kind = cast( uint8, SYM_VARIABLE )) then return cast( SymbolId, si )
        next
    end if
    return sid
end function

private sub LockLoopEnd_( byref c as Ctx, byref st as LockState )
    dim as int32 top = st.lpU.Count - 1
    dim as int32 uStart = cast( int32, st.lpU[top] ), rStart = cast( int32, st.lpR[top] ), pStart = cast( int32, st.lpP[top] )
    for k as int32 = pStart to st.pv.Count - 1
        if st.pdone[k] <> 0 then continue for
        '' A use of v in this loop BEFORE the write, with no rebinding of v in the loop before it.
        for u as int32 = uStart to st.uv.Count - 1
            if st.uv[u] <> st.pv[k] then continue for
            if st.uq[u] >= st.pq[k] then continue for
            dim as boolean rebound = false
            for r as int32 = rStart to cast( int32, st.urb[u] ) - 1
                if st.rv[r] = st.pv[k] then rebound = true : exit for
            next
            if rebound = false then LockReport_( c, st, k, cast( NodeId, st.un[u] ) ) : exit for
        next
    next
    st.lpU.Pop( ) : st.lpR.Pop( ) : st.lpP.Pop( )
end sub

sub LockWalk_( byref c as Ctx, byref st as LockState, byval id as NodeId, byval root as NodeId )
    if (id = NODE_NONE) orelse c.diags->Stopped( ) then return
    dim as NodeKind k = c.ast->Kind( id )
    '' A NESTED PROCEDURE or type is walked as its own body.
    if (id <> root) andalso ((k = N_PROC) orelse (k = N_TYPE)) then return
    select case k
    case N_IDENT
        dim as SymbolId v = SliceVar_( c, id )
        if v <> SYMBOL_NONE then LockUse_( c, st, v, id )
        return
    case N_BINARY
        LockWalk_( c, st, c.ast->BinaryOf( id )->lhs, root )
        LockWalk_( c, st, c.ast->BinaryOf( id )->rhs, root )
        return
    case N_MEMBER
        LockWalk_( c, st, c.ast->BinaryOf( id )->lhs, root )
        return
    case N_UNARY, N_ADDROF, N_DEREF
        LockWalk_( c, st, c.ast->UnaryOf( id )->operand, root )
        return
    case N_CALL, N_INDEX, N_PAREN, N_TUPLE, N_INITIALIZER, N_STRCAT, N_NEW
        dim as ListPayload ptr lp = c.ast->ListOf( id )
        if k <> N_NEW then LockWalk_( c, st, lp->target, root )
        for i as int32 = 0 to lp->count - 1
            LockWalk_( c, st, c.ast->ChildAt( lp->first, i ), root )
        next
        '' A STRING PASSED BYREF to a non-const parameter may be reassigned by the callee.
        if k = N_CALL then
            dim as Symbol ptr callee = c.syms->SymbolAt( c.info->RefOf( id ) )
            if callee = nullptr then callee = c.syms->SymbolAt( c.info->RefOf( lp->target ) )
            if callee <> nullptr then
                if (callee->kind = cast( uint8, SYM_PROC )) andalso (callee->payload <> 0) then
                    dim as NodeId decl = cast( NodeId, callee->payload )
                    if c.ast->Kind( decl ) = N_PROC then
                        dim as StmtPayload ptr pp = c.ast->StmtOf( decl )
                        dim as int32 ai = 0
                        for i as int32 = 0 to pp->count - 1
                            dim as NodeId prm = c.ast->ChildAt( pp->first, i )
                            if c.ast->Kind( prm ) <> N_PARAM then continue for
                            if ai >= lp->count then exit for
                            dim as NodeId arg = c.ast->ChildAt( lp->first, ai )
                            ai += 1
                            if (c.ast->Flags( prm ) and NF_BYREF) = 0 then continue for
                            dim as TypeId pt = c.info->TypeOf_( c.ast->StmtOf( prm )->a )
                            if (pt = TYPE_NONE) orelse c.types->IsConst( pt ) then continue for
                            if ReallocType_( c, pt ) then LockWrite_( c, st, StringRoot_( c, arg ), id )
                        next
                    end if
                end if
            end if
        end if
        return
    end select
    '' Any other expression -- a literal, a closure, an intrinsic-shaped one -- has nothing to walk.
    if (NodeKindCategory( k ) <> NCAT_STMT) andalso (NodeKindCategory( k ) <> NCAT_DECL) then return

    if (k = N_MODULE) orelse (k = N_BLOCK) then
        dim as ListPayload ptr lp = c.ast->ListOf( id )
        for i as int32 = 0 to lp->count - 1
            LockWalk_( c, st, c.ast->ChildAt( lp->first, i ), root )
        next
        return
    end if

    dim as StmtPayload ptr sp = c.ast->StmtOf( id )
    select case k
    case N_VAR_ITEM
        LockWalk_( c, st, sp->b, root )
        dim as SymbolId v = ItemSym_( c, id )
        if (v <> SYMBOL_NONE) andalso (sp->b <> NODE_NONE) andalso IsSliceT_( c, c.syms->SymbolAt( v )->type_ ) then
            dim as containers.Array( of uint32 ) srcs
            LockSources_( c, st, sp->b, srcs )
            LockBind_( c, st, v, srcs, true )
        end if
        return
    case N_AMBIGUOUS
        if c.info->AmbiguousOf( id ) <> AMB_ASSIGN then exit select
        LockWalk_( c, st, sp->b, root )
        dim as NodeId lhs = LifeUnparen_( c, sp->a )
        dim as SymbolId tr = TargetRoot_( c, lhs )
        if tr = SYMBOL_NONE then
            '' 'a[i] = x', 'mid( a, ... ) = x', '*p = x': the target expression's own uses.
            LockWalk_( c, st, sp->a, root )
            return
        end if
        '' A field of a variable reads the variable's other fields: walk the base's uses.
        if c.ast->Kind( lhs ) = N_MEMBER then LockWalk_( c, st, c.ast->BinaryOf( lhs )->lhs, root )
        dim as Symbol ptr ts = c.syms->SymbolAt( tr )
        if (ts <> nullptr) andalso IsSliceT_( c, ts->type_ ) andalso IsSliceT_( c, c.info->TypeOf_( lhs ) ) then
            dim as containers.Array( of uint32 ) srcs
            LockSources_( c, st, sp->b, srcs )
            LockBind_( c, st, tr, srcs, c.ast->Kind( lhs ) = N_IDENT )
        elseif ReallocType_( c, c.info->TypeOf_( lhs ) ) then
            LockWrite_( c, st, tr, id )
        end if
        return
    case N_INTRINSIC
        select case cast( TokenKind, sp->op )
        case KW_SWAP, KW_INPUT, KW_LINE
            '' The operands: in 'a' / 'b' for some statements, in the child list for others.
            dim as NodeId opnd( 1 ) = { sp->a, sp->b }
            for i as int32 = 0 to 1
                if opnd( i ) = NODE_NONE then continue for
                if ReallocType_( c, c.info->TypeOf_( opnd( i ) ) ) then LockWrite_( c, st, StringRoot_( c, opnd( i ) ), id )
            next
            for i as int32 = 0 to sp->count - 1
                dim as NodeId a = c.ast->ChildAt( sp->first, i )
                if ReallocType_( c, c.info->TypeOf_( a ) ) then LockWrite_( c, st, StringRoot_( c, a ), id )
            next
        end select
    case N_FOR, N_FOREACH, N_DO, N_WHILE
        st.lpU.Push( cast( uint32, st.uv.Count ) ) : st.lpR.Push( cast( uint32, st.rv.Count ) ) : st.lpP.Push( cast( uint32, st.pv.Count ) )
        LockWalk_( c, st, sp->a, root )
        LockWalk_( c, st, sp->b, root )
        LockWalk_( c, st, sp->c, root )
        for i as int32 = 0 to sp->count - 1
            LockWalk_( c, st, c.ast->ChildAt( sp->first, i ), root )
        next
        LockLoopEnd_( c, st )
        return
    end select
    LockWalk_( c, st, sp->a, root )
    LockWalk_( c, st, sp->b, root )
    LockWalk_( c, st, sp->c, root )
    for i as int32 = 0 to sp->count - 1
        LockWalk_( c, st, c.ast->ChildAt( sp->first, i ), root )
    next
end sub

'' One procedure body, or the module's own statements -- only in a unit that declares a slice or
'' view variable or parameter at all, asked once (sliceGenSeen key 1: 1 none, 2 some), so a
'' program without slices pays for no walk.
sub CheckSliceLock_ ( byref c as Ctx, byval id as NodeId )
    dim as int32 any_ = 0
    if c.sliceGenSeen.TryGet( 1, any_ ) = false then
        any_ = 1
        for si as int32 = 1 to c.syms->symbols.Count - 1
            dim as Symbol ptr s = @c.syms->symbols[si]
            if (s->kind <> cast( uint8, SYM_VARIABLE )) andalso (s->kind <> cast( uint8, SYM_PARAMETER )) then continue for
            if s->type_ = TYPE_NONE then continue for
            if IsSliceT_( c, s->type_ ) then any_ = 2 : exit for
        next
        c.sliceGenSeen.Put( 1, any_ )
    end if
    if any_ <> 2 then return
    dim as LockState st
    LockWalk_( c, st, id, id )
end sub


end namespace
