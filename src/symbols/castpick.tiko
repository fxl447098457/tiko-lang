'' castpick.tiko -- WHICH 'operator cast' A STRING CONTEXT CALLS: one rule, for Check and lowering.
''
'' fbc picks a cast by SCORE against one target type -- symbFindCastOvlProc / hCheckCastOvl --
'' and a tie is an ambiguous call. The score of each cast's RESULT against the target is the
'' string table of hCalcTypesDiff (FULL = 500, HALF = 300, minus a distance). That rule, and
'' which target each statement asks with, were MEASURED: tka-probes/phase4/pc runs 81 overload
'' sets (each subset of { string, ustring, byref zstring, zstring ptr, byref wstring,
'' wstring ptr, long, double, any ptr } of size one and two, both orders) through 20 statements
'' under fbc-modern, and this table reproduces every one of the 648 string-context cells:
''
''     print u / s = u / dim as string s = u / "x" & u / u & wstr( "x" ) / f( byval string )
''                                                           target STRING
''     dim as ustring s = u                                  target USTRING
''     dim as wstring * N s = u                              target WSTRING
''
'' A WINNER THAT IS NOT TEXT -- a pointer or a number -- converts to nothing: fbc's 24 (print,
'' initialiser), 181 (assignment), 20 (concatenation). fbc's own initialiser path drops such a
'' statement silently, which tiko does not copy.
''
'' Its own unit (build/sources.txt), namespace Tko.Check, declared in check.ti.

#import "std/containers"
#include once "symbols/check.ti"

namespace Tko.Check

'' WHAT A CAST YIELDS, in the terms the table scores. A 'byref as zstring' result is the string
'' itself (CR_CHAR), held as a reference -- or, past Check, as a pointer the proc's NF_BYREF
'' flag marks -- where 'as zstring ptr' is a pointer (CR_CHARPTR).
function CastResultClass _
    ( byref ast as Tko.AstArena, byref syms as Tko.SymbolTable, byref types as Tko.TypeContext, _
      byval sym as Tko.SymbolId ) as int32

    dim as Tko.Symbol ptr s = syms.SymbolAt( sym )
    if (s = nullptr) orelse (s->type_ = Tko.TYPE_NONE) then return CR_NONE
    dim as boolean byrefRes = false
    dim as Tko.NodeId pn = cast( Tko.NodeId, s->payload )
    if (pn <> Tko.NODE_NONE) andalso (ast.Kind( pn ) = Tko.N_PROC) then
        byrefRes = ((ast.Flags( pn ) and Tko.NF_BYREF) <> 0)
    end if
    dim as Tko.TypeId rt = types.Unqualify( s->type_ )
    if types.Kind( rt ) = Tko.TK_REFERENCE then
        rt = types.Unqualify( types.Inner( rt ) )
        byrefRes = true
    end if
    if types.Kind( rt ) = Tko.TK_POINTER then
        dim as Tko.TypeId inner = types.Unqualify( types.Inner( rt ) )
        if types.Kind( inner ) = Tko.TK_BUILTIN then
            select case types.BuiltinOf( inner )
            case Tko.TY_ZSTRING : return iif( byrefRes, CR_CHAR, CR_CHARPTR )
            case Tko.TY_WSTRING : return iif( byrefRes, CR_WCHAR, CR_WCHARPTR )
            end select
        end if
        return CR_OTHERPTR
    end if
    '' A FIXED-LENGTH result is the string flavour it holds.
    if types.Kind( rt ) = Tko.TK_ARRAY then
        dim as Tko.TypeId el = types.Unqualify( types.Inner( rt ) )
        if types.Kind( el ) = Tko.TK_BUILTIN then
            select case types.BuiltinOf( el )
            case Tko.TY_ZSTRING : return CR_CHAR
            case Tko.TY_WSTRING : return CR_WCHAR
            case Tko.TY_FIXSTR  : return CR_STRING
            case Tko.TY_FIXUSTR : return CR_USTRING
            end select
        end if
        return CR_NONE
    end if
    if types.Kind( rt ) = Tko.TK_ENUM then return CR_INT
    if types.Kind( rt ) <> Tko.TK_BUILTIN then return CR_NONE
    select case types.BuiltinOf( rt )
    case Tko.TY_STRING  : return CR_STRING
    case Tko.TY_USTRING : return CR_USTRING
    case Tko.TY_ZSTRING : return CR_CHAR
    case Tko.TY_WSTRING : return CR_WCHAR
    case Tko.TY_SINGLE, Tko.TY_DOUBLE : return CR_FLOAT
    case Tko.TY_VOID, Tko.TY_ANY : return CR_NONE
    end select
    return CR_INT
end function

'' THE SCORE of a cast yielding CLS against TARGET (CT_*): higher is better, 0 no match.
function StrCastScore( byval target as int32, byval cls as int32 ) as int32
    select case target
    case CT_STRING
        select case cls
        case CR_STRING   : return 500
        case CR_CHAR     : return 499
        case CR_CHARPTR  : return 498
        case CR_USTRING  : return 298
        case CR_WCHAR    : return 297
        case CR_WCHARPTR : return 296
        end select
    case CT_USTRING
        '' A 'zstring ptr' does NOT reach a ustring (fbc: "NOT from a ustring").
        select case cls
        case CR_USTRING  : return 500
        case CR_CHAR     : return 499
        case CR_STRING   : return 298
        case CR_WCHAR, CR_WCHARPTR : return 297
        end select
    case CT_WSTRING
        select case cls
        case CR_WCHAR    : return 500
        case CR_WCHARPTR : return 499
        case CR_USTRING  : return 299
        case CR_STRING   : return 298
        case CR_CHAR     : return 297
        case CR_CHARPTR  : return 296
        case CR_FLOAT    : return 1        '' a float scores, below every string: then converts to nothing
        end select
    end select
    return 0
end function

'' THE CAST A STRING CONTEXT CALLS, or NONE. OUTCOME says which: CP_OK, CP_NONE (no cast scored),
'' CP_AMBIGUOUS (fbc's error 98 -- two casts share the best score) or CP_NOCONV (a pointer or a
'' number won, which converts to no string). WINCLS is the winner's CR_* class.
function StrCastPick _
    ( byref ast as Tko.AstArena, byref syms as Tko.SymbolTable, byref types as Tko.TypeContext, _
      byref names as Tko.Interner, byval udt as Tko.TypeId, byval target as int32, _
      byref outcome as int32, byref winCls as int32 ) as Tko.SymbolId

    outcome = CP_NONE
    winCls = CR_NONE
    if udt = Tko.TYPE_NONE then return Tko.SYMBOL_NONE
    dim as Tko.TypeId u = types.Unqualify( udt )
    if types.Kind( u ) = Tko.TK_REFERENCE then u = types.Unqualify( types.Inner( u ) )
    if types.Kind( u ) <> Tko.TK_UDT then return Tko.SYMBOL_NONE
    dim as Tko.SymbolId best = Tko.SYMBOL_NONE
    dim as int32 bestScore = 0, nBest = 0, bestCls = CR_NONE
    dim as Tko.SymbolId cur = StructorNamed( syms, types, names, u, "cast" )
    dim as int32 guard = 0
    while (cur <> Tko.SYMBOL_NONE) andalso (guard < 4096)
        guard += 1
        dim as Tko.Symbol ptr cs = syms.SymbolAt( cur )
        if cs = nullptr then exit while
        dim as int32 cls = CastResultClass( ast, syms, types, cur )
        dim as int32 sc = StrCastScore( target, cls )
        if sc > bestScore then
            best = cur : bestScore = sc : nBest = 1 : bestCls = cls
        elseif (sc = bestScore) andalso (sc > 0) then
            nBest += 1
        end if
        cur = cs->nextOverload
    wend
    if best = Tko.SYMBOL_NONE then return Tko.SYMBOL_NONE
    winCls = bestCls
    if nBest > 1 then
        outcome = CP_AMBIGUOUS
        return Tko.SYMBOL_NONE
    end if
    select case bestCls
    case CR_STRING, CR_USTRING, CR_CHAR, CR_WCHAR
        outcome = CP_OK
        return best
    end select
    outcome = CP_NOCONV
    return best
end function

'' DOES A UDT REACH A STRING CONTEXT asking TARGET? -1 not this question (not a UDT, or no cast
'' at all -- other diagnostics own those), 0 it does, 1 its best cast converts to no string (a
'' pointer or a number won, or nothing scored), 2 two casts tie (fbc's error 98). Measured on
'' fbc-modern, the 1 is error 24 for print and an initialiser, 181 for an assignment, 20 for '&',
'' 58 for an argument.
function UdtStrCastFit _
    ( byref ast as Tko.AstArena, byref syms as Tko.SymbolTable, byref types as Tko.TypeContext, _
      byref names as Tko.Interner, byval udt as Tko.TypeId, byval target as int32 ) as int32

    if udt = Tko.TYPE_NONE then return -1
    dim as Tko.TypeId u = types.Unqualify( udt )
    if types.Kind( u ) = Tko.TK_REFERENCE then u = types.Unqualify( types.Inner( u ) )
    if types.Kind( u ) <> Tko.TK_UDT then return -1
    if StructorNamed( syms, types, names, u, "cast" ) = Tko.SYMBOL_NONE then return -1
    dim as int32 oc, cls
    StrCastPick( ast, syms, types, names, u, target, oc, cls )
    select case oc
    case CP_OK        : return 0
    case CP_AMBIGUOUS : return 2
    end select
    return 1
end function

'' WHICH OVERLOAD OF A BUILT-IN A UDT ARGUMENT REACHES -- 'left', 'right' and the VAL family,
'' whose runtime declarations are overload SETS: VAL over { byref const string, byref const
'' wstring }, LEFT and RIGHT over those and 'byref const ustring' (rtl-string.bas). fbc resolves
'' the call as any overloaded one (symb-proc.bas): per parameter, the cast that best fits its
'' CONST type (symbFindCastOvlProc / hCheckCastOvl, where a non-const 'as string' is only a type
'' match for 'const string' and 'byref as zstring' outscores it), then that cast's fit to the
'' parameter (hCalcTypesDiff), remapped by hCheckCastOvlEx -- anything below an exact half match
'' collapses to one constant, which is what makes 'val( u )' over a ustring cast error 98.
'' Fitted to all 162 measured cells of tka-probes/phase4/pc (81 cast sets x left, val), 0 misfit.
''
'' OUTCOME: CP_OK (the cast to call, PARAM the overload: CT_STRING / CT_WSTRING / CT_USTRING),
'' CP_AMBIGUOUS (fbc's 98), CP_NONE (no overload reached, 99) or CP_NOCONV (a number won, 58).
const OVL_U = 1000
const OVL_FULL = 5 * OVL_U, OVL_TYPE = 4 * OVL_U, OVL_HALF = 3 * OVL_U
const OVL_CAST = 2 * OVL_U, OVL_CONV = OVL_U, OVL_STRUCTCONV = 333

private function OvlIsPtr_( byval k as int32 ) as boolean
    return (k = CR_CHARPTR) orelse (k = CR_WCHARPTR) orelse (k = CR_OTHERPTR)
end function

private function OvlClass_( byval k as int32 ) as int32   '' 1 string, 2 float, 0 integer
    select case k
    case CR_STRING, CR_USTRING : return 1
    case CR_FLOAT              : return 2
    end select
    return 0
end function

'' hCalcTypesDiff( param P, arg A ) over cast-result classes, no expression.
private function OvlDiff_( byval p as int32, byval a as int32 ) as int32
    dim as int32 cp = OvlClass_( p ), ca = OvlClass_( a )
    if cp = 0 then
        if ca = 0 then
            if p = CR_CHAR then return iif( a = CR_CHAR, OVL_FULL, iif( a = CR_WCHAR, OVL_HALF - 3, 0 ) )
            if p = CR_WCHAR then return iif( a = CR_CHAR, OVL_HALF - 3, iif( a = CR_WCHAR, OVL_FULL, 0 ) )
            if (p = CR_CHARPTR) andalso (a = CR_CHAR) then return OVL_FULL - 1
            if (p = CR_CHARPTR) andalso (a = CR_WCHAR) then return OVL_HALF - 4
            if (p = CR_WCHARPTR) andalso (a = CR_CHAR) then return OVL_HALF - 4
            if (p = CR_WCHARPTR) andalso (a = CR_WCHAR) then return OVL_FULL - 1
            if (a = CR_CHAR) orelse (a = CR_WCHAR) then return 0
            if OvlIsPtr_( p ) then
                if OvlIsPtr_( a ) = false then return 0
                if (p = CR_OTHERPTR) orelse (a = CR_OTHERPTR) then return OVL_HALF
                return iif( p = a, OVL_FULL, 0 )
            end if
            if OvlIsPtr_( a ) then return 0
            return OVL_HALF - 1
        end if
        if ca = 2 then return iif( OvlIsPtr_( p ), 0, OVL_HALF - 20 )
        if p = CR_CHAR then return OVL_FULL - 1
        if p = CR_CHARPTR then return iif( a = CR_USTRING, 0, OVL_FULL - 2 )
        if p = CR_WCHAR then return OVL_HALF - 3
        if p = CR_WCHARPTR then return iif( a = CR_USTRING, OVL_HALF - 3, OVL_HALF - 4 )
        return 0
    end if
    if cp = 2 then
        if ca = 0 then return iif( OvlIsPtr_( a ), 0, OVL_HALF - 20 )
        if ca = 2 then return OVL_FULL
        return 0
    end if
    if ca = 1 then return iif( cbool( p = CR_USTRING ) = cbool( a = CR_USTRING ), OVL_FULL, OVL_HALF - 2 )
    if a = CR_CHAR then return iif( p = CR_USTRING, OVL_FULL - 3, OVL_FULL - 2 )
    if a = CR_WCHAR then return iif( p = CR_USTRING, OVL_HALF - 1, OVL_HALF - 2 )
    return 0
end function

'' Whether a cast's result is CONST -- 'byref as const wstring' is a FULL match for a const
'' parameter of its own type, a plain one only a TYPE match.
private function OvlResConst_( byref syms as Tko.SymbolTable, byref types as Tko.TypeContext, byval sym as Tko.SymbolId ) as boolean
    dim as Tko.Symbol ptr s = syms.SymbolAt( sym )
    if s = nullptr then return false
    dim as Tko.TypeId rt = s->type_
    if types.IsConst( rt ) then return true
    dim as Tko.TypeId ru = types.Unqualify( rt )
    if (types.Kind( ru ) = Tko.TK_REFERENCE) orelse (types.Kind( ru ) = Tko.TK_POINTER) then return types.IsConst( types.Inner( ru ) )
    return false
end function

function IntrStrOvlPick _
    ( byref ast as Tko.AstArena, byref syms as Tko.SymbolTable, byref types as Tko.TypeContext, _
      byref names as Tko.Interner, byval udt as Tko.TypeId, byval withUStr as boolean, _
      byref outcome as int32, byref outParam as int32 ) as Tko.SymbolId

    outcome = CP_NONE
    outParam = 0
    if udt = Tko.TYPE_NONE then return Tko.SYMBOL_NONE
    dim as Tko.TypeId u = types.Unqualify( udt )
    if types.Kind( u ) = Tko.TK_REFERENCE then u = types.Unqualify( types.Inner( u ) )
    if types.Kind( u ) <> Tko.TK_UDT then return Tko.SYMBOL_NONE
    dim as Tko.SymbolId head = StructorNamed( syms, types, names, u, "cast" )
    if head = Tko.SYMBOL_NONE then return Tko.SYMBOL_NONE
    dim as int32 bestM = -999999, nBestM = 0, bestP = 0, bestCls = CR_NONE
    dim as Tko.SymbolId bestSym = Tko.SYMBOL_NONE
    dim as boolean anyP = false
    for pi as int32 = 0 to iif( withUStr, 2, 1 )
        dim as int32 pcls = CR_STRING, pct = CT_STRING
        if pi = 1 then pcls = CR_WCHAR : pct = CT_WSTRING
        if pi = 2 then pcls = CR_USTRING : pct = CT_USTRING
        '' the cast fbc finds for this parameter
        dim as Tko.SymbolId cur = head, win = Tko.SYMBOL_NONE
        dim as int32 winSc = 0, nWin = 0, winCls = CR_NONE, guard = 0
        while (cur <> Tko.SYMBOL_NONE) andalso (guard < 4096)
            guard += 1
            dim as Tko.Symbol ptr cs = syms.SymbolAt( cur )
            if cs = nullptr then exit while
            dim as int32 k = CastResultClass( ast, syms, types, cur )
            dim as int32 sc
            if k = pcls then
                sc = iif( OvlResConst_( syms, types, cur ), OVL_FULL, OVL_TYPE )
            else
                sc = OvlDiff_( k, pcls )
            end if
            if sc > winSc then
                win = cur : winSc = sc : nWin = 1 : winCls = k
            elseif (sc = winSc) andalso (sc > 0) then
                nWin += 1
            end if
            cur = cs->nextOverload
        wend
        if win = Tko.SYMBOL_NONE then continue for
        if nWin > 1 then
            outcome = CP_AMBIGUOUS
            return Tko.SYMBOL_NONE
        end if
        anyP = true
        '' ...and how well it fits the parameter, as hCheckCastOvlEx remaps it
        dim as int32 m = OvlDiff_( pcls, winCls )
        if winCls = pcls then m = OVL_FULL
        if m >= OVL_TYPE then
            m = m - OVL_TYPE + OVL_CAST
        elseif m >= OVL_HALF then
            m = m - OVL_TYPE + OVL_CONV
        else
            m = OVL_STRUCTCONV
        end if
        if m > bestM then
            bestM = m : nBestM = 1 : bestP = pct : bestSym = win : bestCls = winCls
        elseif m = bestM then
            nBestM += 1
        end if
    next
    if anyP = false then return Tko.SYMBOL_NONE
    if nBestM > 1 then
        outcome = CP_AMBIGUOUS
        return Tko.SYMBOL_NONE
    end if
    outParam = bestP
    if bestCls = CR_FLOAT then
        outcome = CP_NOCONV
        return bestSym
    end if
    outcome = CP_OK
    return bestSym
end function

'' DOES 't' -- a UDT, or a slice (whose prelude TYPE declares one) -- DECLARE AN 'operator cast'
'' WHOSE RESULT IS EXACTLY 'want', a STRING or a USTRING? Then 'cast( want, x )' is that conversion
'' and of that type, as fbc-modern takes it (measured 2026-11-07: print, '&', '=', dim, select case
'' and arguments over one); without it the cast is refused (TKO0756 and TKO0803, latesweeps3.tiko,
'' TKO0890, staticdef.tiko). Read by the cast's typing in intrinsics.tiko. Typed, the cast reaches
'' every rule a string value meets: untyped it stopped on TKO0994 under 'len', 'asc', 'instr' and
'' 'select case', and as the initializer of a pointer or a number, which fbc refuses (error 24).
function UdtCastsToStr _
    ( byref syms as Tko.SymbolTable, byref types as Tko.TypeContext, byref names as Tko.Interner, _
      byval t as Tko.TypeId, byval want as Tko.BuiltinType ) as boolean
    if (want <> Tko.TY_STRING) andalso (want <> Tko.TY_USTRING) then return false
    dim as Tko.TypeId u = types.Unqualify( t )
    if types.Kind( u ) = Tko.TK_REFERENCE then u = types.Unqualify( types.Inner( u ) )
    if types.Kind( u ) <> Tko.TK_UDT then return false
    dim as Tko.SymbolId cs = StructorNamed( syms, types, names, u, "cast" )
    while cs <> Tko.SYMBOL_NONE
        dim as Tko.Symbol ptr s = syms.SymbolAt( cs )
        if s = nullptr then exit while
        dim as Tko.TypeId r = types.Unqualify( s->type_ )
        if types.Kind( r ) = Tko.TK_REFERENCE then r = types.Unqualify( types.Inner( r ) )
        if (types.Kind( r ) = Tko.TK_BUILTIN) andalso (types.BuiltinOf( r ) = want) then return true
        cs = s->nextOverload
    wend
    return false
end function

end namespace
