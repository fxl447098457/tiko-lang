'' resolve.tiko -- see resolve.ti

#import "std/containers"
#include once "symbols/resolvectx.ti"
#include once "support/irtext.ti"
#include once "symbols/mangle.ti"
#include once "symbols/check.ti"
#include once "lexer/keywords.ti"
namespace Tko

#include once "symbols/resolveinfo.tiko"

end namespace

namespace Tko.Resolve

'' The scope '..' names. NOT SCOPE_GLOBAL, which holds only the builtins -- a module's
'' own declarations live in a SCOPEK_MODULE scope one level inside it, so looking in
'' the global scope found nothing and '..x' bound to no symbol at all.
''
'' Walking outward rather than caching an id keeps this correct if a file ever opens
'' more than one module scope.
'' Defined below; ResolveTypeRef above it resolves a 'typeof' operand expression.
declare function RedimReachesOuter_( byref c as Ctx, byval here as Tko.ScopeId, byval item as Tko.NodeId, byval nm as Tko.InternId, byval et as Tko.TypeId ) as boolean
declare sub WalkExpr _
    ( byref c as Ctx, byval id as Tko.NodeId, byval scope_ as Tko.ScopeId )

'' A procedure symbol declared STATIC. Static-ness lives on the AST payload, not on the
'' symbol, so it is read back through 'payload' -- which for a proc is its N_PROC node.
private function IsStaticProc_ _
    ( byref c as Ctx, byval sid as Tko.SymbolId ) as boolean

    if sid = Tko.SYMBOL_NONE then return false
    dim as Tko.Symbol ptr s = c.syms->SymbolAt( sid )
    if s = nullptr then return false
    if s->kind <> cast( uint8, Tko.SYM_PROC ) then return false
    dim as Tko.NodeId n = cast( Tko.NodeId, s->payload )
    if n = Tko.NODE_NONE then return false
    if cast( int32, n ) >= c.ast->NodePoolCount( ) then return false
    if c.ast->Kind( n ) <> Tko.N_PROC then return false
    dim as Tko.StmtPayload ptr sp = StmtOf( c, n )
    return ((sp->extra and Tko.PF_STATIC) <> 0)
end function

private function FileScopeOf_ _
    ( byref c as Ctx, byval from_ as Tko.ScopeId ) as Tko.ScopeId

    dim as Tko.ScopeId sc = from_
    dim as int32 guard = 0
    while (sc <> Tko.SCOPE_NONE) andalso (guard < Tko.SCOPE_WALK_MAX)
        guard += 1
        dim as Tko.SymScope ptr s_ = c.syms->ScopeAt( sc )
        if s_ = nullptr then exit while
        if s_->kind = cast( uint8, Tko.SCOPEK_MODULE ) then return sc
        sc = s_->parent
    wend
    return Tko.SCOPE_GLOBAL
end function

'' ------------------------------------------------------------- type references

'' A syntactic TypeRef becomes a semantic TypeId. Builtin spellings map straight to
'' the fixed builtin ids; a named type is looked up.

'' The unsigned counterpart of an integer type, or TYPE_NONE when there is not one.
''
'' TYPE_NONE rather than the original: 'unsigned' applied to something with no unsigned
'' form is an error, and returning the signed type would compile a declaration whose type
'' is not what was written.
private function UnsignedCounterpart _
    ( byref c as Ctx, byval t as Tko.TypeId ) as Tko.TypeId

    if t = Tko.TYPE_NONE then return Tko.TYPE_NONE
    if c.types->Kind( t ) <> Tko.TK_BUILTIN then return Tko.TYPE_NONE
    select case c.types->BuiltinOf( t )
    case Tko.TY_BYTE, Tko.TY_UBYTE         : return c.types->Builtin( Tko.TY_UBYTE )
    case Tko.TY_SHORT, Tko.TY_USHORT       : return c.types->Builtin( Tko.TY_USHORT )
    case Tko.TY_LONG, Tko.TY_ULONG         : return c.types->Builtin( Tko.TY_ULONG )
    case Tko.TY_INTEGER, Tko.TY_UINTEGER   : return c.types->Builtin( Tko.TY_UINTEGER )
    case Tko.TY_LONGINT, Tko.TY_ULONGINT   : return c.types->Builtin( Tko.TY_ULONGINT )
    end select
    return Tko.TYPE_NONE
end function
#include once "symbols/resolvetype.tiko"

'' ------------------------------------------------------------------- walking

'' THIS, inside a method body. Collect declares the parameter -- it is never written, so
'' nothing else would -- and this gives it the owning type. Without it 'this.v' was
'' untyped, 'this.M( )' lowered with no receiver at all, and every unqualified reference
'' to a sibling member had nothing to resolve against.
''
'' The type comes from the enclosing scope chain rather than from the procedure's name:
'' a member DEFINITION opens its scope inside the TYPE's, which is what makes 'this', the
'' sibling fields and the mangled name all come out of one arrangement.
'' A dotted type name, in its own file at the 1500-line cap.
#include once "symbols/resolvedot.tiko"
#include once "symbols/resolvesize.tiko"
#include once "symbols/resolvesel.tiko"
#include once "symbols/resolveudt.tiko"
#include once "symbols/resolvearr.tiko"
#include once "symbols/resolveintr.tiko"
#include once "symbols/resolveunbound.tiko"
#include once "symbols/collinit.tiko"

private sub BindThis _
    ( byref c as Ctx, byval procScope as Tko.ScopeId, _
      byval ownerName as Tko.InternId = 0 )
    dim as Tko.SymbolId tsid = _
        c.syms->LookupLocal( procScope, c.names->Fold( c.names->GetString( "this" ) ) )
    if tsid = Tko.SYMBOL_NONE then return
    dim as Tko.Symbol ptr ts = c.syms->SymbolAt( tsid )
    if ts = nullptr then return
    if ts->type_ <> Tko.TYPE_NONE then return

    dim as Tko.ScopeId cur = procScope
    while cur <> Tko.SCOPE_NONE
        dim as Tko.SymScope ptr s = c.syms->ScopeAt( cur )
        if s = nullptr then exit while
        if s->kind = cast( uint8, Tko.SCOPEK_TYPE ) then
            '' A POINTER to the type, not the type: the ABI passes an address, fbc's
            '' own C spells the parameter 'struct $1T*', and every member access
            '' already reaches through a pointer base.
            dim as Tko.Symbol ptr owner = c.syms->SymbolAt( s->owner )
            if owner <> nullptr then
                if owner->type_ <> Tko.TYPE_NONE then
                    ts->type_ = c.types->Pointer_( owner->type_ )
                end if
            end if
            exit while
        end if
        cur = s->parent
    wend

    '' NO TYPE SCOPE ANYWHERE UP THE CHAIN. A member DEFINED OUTSIDE its namespace --
    ''
    ''     namespace ns : type UDT : ... : end type : end namespace
    ''     constructor ns.UDT( ) : ... : end constructor
    ''
    '' -- opens its body at MODULE scope, so the walk above finds nothing and 'this'
    '' stays untyped. It then gets a VOID slot, and the receiver store into it is what
    '' the MIR verifier had been reporting for twelve corpus files.
    ''
    '' The procedure's own qualified name is what says which type it belongs to. It may
    '' be a PATH -- 'a.b.UDT' -- so it walks the same way a qualified TYPE REFERENCE
    '' does.
    if (ts->type_ = Tko.TYPE_NONE) andalso (ownerName <> 0) then
        dim as Tko.SymbolId osid = LookupDottedType_( c, procScope, ownerName )
        dim as Tko.Symbol ptr os = c.syms->SymbolAt( osid )
        if os <> nullptr then
            if os->type_ <> Tko.TYPE_NONE then
                ts->type_ = c.types->Pointer_( os->type_ )
            end if
        end if
    end if
end sub

'' Give a just-declared name its type. The symbol is found by NAME in the scope
'' Collect recorded, rather than by threading a SymbolId through the AST: the
'' declaration and its symbol are in the same scope by construction.
sub BindDeclType _
    ( byref c as Ctx, byval scope_ as Tko.ScopeId, byval nm as Tko.InternId, _
      byval t as Tko.TypeId, byval force as boolean )

    if (nm = 0) orelse (t = Tko.TYPE_NONE) then return
    '' A VALUE's type. If a type name shares the spelling, the slot may hold either
    '' one, so the class is asked for rather than assumed.
    dim as Tko.SymbolId sid = c.syms->LookupLocalTyped( scope_, nm, false )
    dim as Tko.Symbol ptr s = c.syms->SymbolAt( sid )
    if s = nullptr then return
    '' FIRST BINDING WINS, except when the caller says otherwise. The BACKPATCH
    '' pass revisits a declaration whose type was built over something not
    '' resolved yet -- 'dim as t p' where 't' aliases a pointer to a type declared
    '' LATER -- and the whole point of the revisit is to replace what the first
    '' pass left. Without the override the symbol kept its pointer-to-nothing, so
    '' '*p = 0' had an untyped target and declined while the same program with the
    '' two types in the other order lowered.
    if force then
        s->type_ = t
    elseif s->type_ = Tko.TYPE_NONE then
        s->type_ = t
    end if
end sub

#include once "symbols/resolveinh.tiko"

'' 'Box( of long )( 7 )' -- CONSTRUCTING A GENERIC, which is not a generic PROCEDURE
'' call and was not handled beside one.
''
'' The callee names the GENERIC and the instantiation arguments are recorded against
'' the CALL, so the ordinary binding pointed the call at the TEMPLATE: the constructor
'' was looked for on a type that has none, the arguments were dropped, and a 'dim'
'' default-constructed instead. 'Channel( of long )( 1 )' is exactly this shape, so a
'' channel was getting capacity 0.
''
'' Instantiated through the same entry a TYPE REFERENCE uses, so 'Box( of long )( 7 )'
'' and 'dim as Box( of long )' name one type and not two.
private function GenericCtorCall_ _
    ( byref c as Ctx, byval id as Tko.NodeId, byval lp as Tko.ListPayload ptr, _
      byval scope_ as Tko.ScopeId ) as boolean

    if lp->target = Tko.NODE_NONE then return false
    dim as int32 taFirst, taCount
    if c.ast->CallTypeArgsOf( id, taFirst, taCount ) = false then return false
    if taCount <= 0 then return false

    dim as Tko.SymbolId gsid = c.info->RefOf( lp->target )
    dim as Tko.Symbol ptr gs = c.syms->SymbolAt( gsid )
    if gs = nullptr then return false
    if gs->kind <> cast( uint8, Tko.SYM_UDT ) then return false

    dim as Tko.StmtPayload gsp
    gsp.name = gs->name
    gsp.first = taFirst
    gsp.count = taCount
    dim as Tko.TypeId inst = InstantiateGeneric_( c, id, @gsp, scope_, gsid )
    if inst = Tko.TYPE_NONE then return false
    c.info->SetType( id, inst )
    c.info->SetType( lp->target, inst )
    return true
end function
'' THE TYPE BOUND TO A GENERIC PARAMETER OF THIS NAME, or nothing. The stack is
'' searched from the top so an inner instantiation shadows an outer one, which is the
'' same walk ResolveTypeRef makes for a type reference.
'' Is this symbol an OUTER name -- one declared in a namespace, a module or the global
'' scope -- rather than something the procedure or its own type owns? That is the
'' only case an inherited member is allowed to beat.
function SymbolIsOuterName_ _
    ( byref c as Ctx, byval sid as Tko.SymbolId ) as boolean

    dim as Tko.Symbol ptr s = c.syms->SymbolAt( sid )
    if s = nullptr then return false
    dim as Tko.SymScope ptr sc = c.syms->ScopeAt( s->parent )
    if sc = nullptr then return false
    select case cast( Tko.ScopeKind, sc->kind )
    case Tko.SCOPEK_GLOBAL, Tko.SCOPEK_MODULE, Tko.SCOPEK_NAMESPACE
        return true
    end select
    return false
end function

'' A type parameter, or 'cva_list', named in expression position (T84).
#include once "symbols/exprtypename.tiko"

'' The two SYNTHESISED TYPES -- a spawn's frame and a capturing lambda's closure --
'' split out at the 1500-line cap and INCLUDED here, inside the same namespace.
'' Nothing moved changed in the move.
#include once "symbols/resolvesynth.tiko"

private sub WalkExpr _
    ( byref c as Ctx, byval id as Tko.NodeId, byval scope_ as Tko.ScopeId )

    if id = Tko.NODE_NONE then return
    dim as Tko.NodeKind k = c.ast->Kind( id )
    dim as Tko.AstNode ptr n = c.ast->NodeAt( id )

    select case k
    case Tko.N_CLOSURE
        '' A CAPTURING LAMBDA. Its captures are names in THIS scope and nowhere else.
        BuildClosureType_( c, id, scope_ )
        return

    case Tko.N_IDENT
        '' A FUNCTION-LIKE MACRO'S NAME WITHOUT '(' BINDS NOTHING: fbc never looks it up, so
        '' it is undeclared (error 42, TKO0743) even where a 'using' shows a symbol so named.
        if ((n->flags and Tko.NF_BARE_MACRO) <> 0) andalso BareMacroAtGlobal_( c, scope_ ) then
            c.st->undefined_ += 1
            NoteUnbound_( c, id, scope_ )
            return
        end if
        dim as Tko.InternId nm = IdentNameOf( c, id )
        '' A name in EXPRESSION position wants the VALUE, not a type of the same
        '' spelling. 'sub UDT1( )' beside 'type UDT1' is legal -- the two live in
        '' different classes -- and the slot holds whichever came first, so a plain
        '' lookup found the TYPE and reported "'udt1' is a type, not a procedure" for
        '' a call to the SUB.
        ''
        '' LookupTyped falls back to the plain lookup when no value of that name
        '' exists, so a type reference that does reach here still resolves.
        '' THE ENCLOSING TYPE COMES BEFORE THE MODULE, AND AFTER THE PROCEDURE'S OWN
        '' LOCALS. LookupTyped walks locals and then straight out to the namespace,
        '' and a method's scope chain does NOT pass through its own type -- the type
        '' is reached by InheritedMember_, which was only tried when the whole walk
        '' had already failed. So a member body naming something the type inherits
        '' bound to a module-level name of the same spelling instead:
        ''
        ''     private sub f( )            <- module level
        ''     sub B.test_proc( ) : f( )   <- fbc calls A.f, tiko called the global
        ''
        '' It is the ordinary shape of an inherited helper, and nine corpus suites
        '' are built on it. The locals still win: a parameter or a DIM named the
        '' same thing shadows the member, which is why the search is in three steps
        '' rather than two.
        dim as Tko.SymbolId sid = c.syms->LookupTyped( scope_, nm, false )
        sid = VisibleToUse_( c, VisibleAbove_( c, sid, id, scope_, nm ), scope_ )  '' fbc's 42
        sid = FieldInitName_( c, id, sid, nm )   '' in a field's '= value' (D11, geninit.tiko)
        if sid = Tko.SYMBOL_NONE then sid = LabelRef_( c, scope_, nm )  '' resolvestmt.tiko
        '' ...AND AN INHERITED MEMBER BEATS A MODULE-LEVEL NAME. The walk above
        '' reaches the procedure's locals and its OWN type's members, and then goes
        '' straight out to the namespace; an INHERITED member is not on that chain
        '' at all -- the base's scope is the type of a field named 'base' -- so it
        '' was only ever consulted when the whole walk had already failed. A module
        '' level name of the same spelling therefore won:
        ''     private sub f( )            <- module level
        ''     sub B.test_proc( ) : f( )   <- fbc calls A.f, tiko called the global
        ''
        '' ONLY WHEN THE HIT IS AN OUTER ONE: a local, a parameter and the type's own
        '' member all still win. Searching the base chain first made 'f( )' inside B
        '' call A.f even where B DECLARES ITS OWN f -- the virtual-dispatch golden.
        if sid <> Tko.SYMBOL_NONE then
            if SymbolIsOuterName_( c, sid ) then
                dim as Tko.SymbolId inh = Tko.SYMBOL_NONE
                if InheritedMember_( c, scope_, nm, inh ) then sid = inh
            end if
        end if
        if sid <> Tko.SYMBOL_NONE then
            c.info->SetRef( id, sid )
            c.st->references += 1
            '' __FUNCTION__ types PER USE -- 'zstring * n' where n is the length of the
            '' enclosing procedure's name -- so it is settled here, where the scope is
            '' in hand. Check cannot: Collect records scopes and never walks a
            '' procedure BODY, so ScopeOf on an expression node inside one is
            '' SCOPE_NONE. At module level there is no enclosing procedure and the node
            '' stays untyped, which is fbc's answer too: it expands __FUNCTION__ to the
            '' undeclared __FB_MAINPROC__ and reports error 42.
            dim as Tko.Symbol ptr fs = c.syms->SymbolAt( sid )
            if fs <> nullptr then
                if (fs->flags and Tko.SYMF_FUNCNAME) <> 0 then
                    dim as string fn = Tko.Mangle.EnclosingProcName( _
                        *c.syms, scope_, *c.names )
                    c.info->SetType( id, c.types->ArrayOf( _
                        c.types->Builtin( Tko.TY_ZSTRING ), 1, len( fn ) + 1 ) )
                elseif (fs->type_ = Tko.TYPE_NONE) andalso (fs->parent = Tko.SCOPE_GLOBAL) andalso (lcase( c.names->Spelling( nm ) ) = "__function_nq__") then
                    '' __FUNCTION_NQ__ IS THE ENCLOSING PROCEDURE, UNQUOTED: '@__FUNCTION_NQ__' is its
                    '' address (fbc's manual defines/functionnq.bas), and a value use stays an error.
                    dim as Tko.ScopeId fq = scope_
                    while fq <> Tko.SCOPE_NONE
                        dim as Tko.SymScope ptr fqs = c.syms->ScopeAt( fq )
                        if fqs = nullptr then exit while
                        if fqs->kind = cast( uint8, Tko.SCOPEK_PROC ) then c.info->SetRef( id, fqs->owner ) : exit while
                        fq = fqs->parent
                    wend
                end if
            end if
        elseif InheritedMember_( c, scope_, nm, sid ) then
            '' AN INHERITED MEMBER NAMED WITHOUT A BASE. 'v = 5' inside a method of a
            '' type that EXTENDS another names the base's field, and the ordinary
            '' scope walk cannot reach it: the base's scope is not a PARENT of the
            '' derived type's, it is the type of a field named 'base'.
            ''
            '' Check's own FieldOf_ has walked that chain since inheritance landed --
            '' which is why 'x.v' worked the whole time and 'v' did not. Every
            '' unqualified read, write and '@' of an inherited field declined.
            c.info->SetRef( id, sid )
            c.st->references += 1
        elseif TypeNamedInExpr_( c, nm ) <> Tko.TYPE_NONE then
            '' A TYPE PARAMETER NAMED IN EXPRESSION POSITION, inside a generic being
            '' instantiated. 'sizeof( T )' parses T as an EXPRESSION -- an N_IDENT --
            '' not as a type reference, so ResolveTypeRef's substitution never saw it
            '' and the node stayed untyped. Every spelling declined:
            ''
            ''     dim as uinteger k = sizeof( T )
            ''     print n * sizeof( T )
            ''     function SzOf( of T )( ) as uinteger : return sizeof( T )
            ''
            '' -- and fb/comptr.bi's ComHeapPtr.Alloc is written as
            '' 'cptr( T ptr, CoTaskMemAlloc( count * sizeof( T ) ) )', so the whole
            '' allocation produced nothing.
            ''
            '' ONLY WHEN NOTHING ELSE ANSWERS, which is what the position in this
            '' chain says: a VARIABLE named 't' still wins, the mirror of the rule
            '' typeparam-shadowing states for the type side.
            ''
            '' The TYPE only, and no reference: the name denotes a type, and giving
            '' it a symbol would make every later pass read it as a value with
            '' storage.
            c.info->SetType( id, TypeNamedInExpr_( c, nm ) )
        elseif cast( int32, nm ) <= TKO_KEYWORD_COUNT then
            '' A keyword used in expression position -- LEN, ASC, SIN. It is a
            '' BUILTIN, not an undefined name. This is free to detect because the
            '' keyword spellings are interned FIRST and so occupy ids 1..N
            '' contiguously (see lexer/token.ti).
            c.st->builtins += 1
            '' ...EXCEPT VA_FIRST (no 64-bit target has it: TKO0981) and the cva statements, which have
            '' no value (TKO0987): both said by the unbound-name pass (undeclared.tiko), not as a TKO0994.
            if ((n->flags and Tko.NF_KW_CALLEE) <> 0) orelse (instr( "|va_first|cva_start|cva_end|cva_copy|", "|" & lcase( c.names->Spelling( nm ) ) & "|" ) > 0) then NoteUnbound_( c, id, scope_ )
        else
            c.st->undefined_ += 1
            if c.st->unresolvedNames.Count < 200000 then
                c.st->unresolvedNames.Push( cast( uint32, nm ) )
            end if
            NoteUnbound_( c, id, scope_ )
        end if

    case Tko.N_UNARY, Tko.N_ADDROF, Tko.N_DEREF
        WalkExpr( c, c.ast->UnaryAt( cast( int32, n->data ) )->operand, scope_ )

    case Tko.N_BINARY
        '' BOTH OPERANDS READ BEFORE EITHER IS WALKED. A payload pointer points INTO
        '' the AST arena and resolving a generic RE-PARSES its members into fresh
        '' nodes, so the arena moves and 'bp' dangles: 'bp->rhs' after the walk is
        '' whatever occupies the freed block -- a NodeId out of range, indexed
        '' without a bound. Confirmed, not reasoned: reserving every arena so it
        '' cannot reallocate makes the crash disappear.
        dim as Tko.BinaryPayload ptr bp = c.ast->BinaryAt( cast( int32, n->data ) )
        dim as Tko.NodeId blhs = bp->lhs
        dim as Tko.NodeId brhs = bp->rhs
        WalkExpr( c, blhs, scope_ )
        '' 'a IS T' HAS A TYPE ON THE RIGHT. Walking it as an expression leaves the
        '' type unresolved, and the test then has nothing to compare against.
        if c.ast->Kind( brhs ) = Tko.N_TYPEREF then
            ResolveTypeRef( c, brhs, scope_ )
        else
            WalkExpr( c, brhs, scope_ )
        end if
        DivByConstZero_( c, id, scope_ )

    case Tko.N_MEMBER
        '' Only the base: the member name needs the base's type.
        dim as Tko.BinaryPayload ptr mb = c.ast->BinaryAt( cast( int32, n->data ) )

        '' '.field' WITH NO BASE is the WITH shorthand, and the base it wants is the
        '' subject of the innermost open WITH. The parser cannot supply it -- it does
        '' not track which WITH is open -- so it is filled in here, by pointing the
        '' member at the subject's own node.
        ''
        '' That makes the tree a DAG: one expression node reached from two places, and
        '' lowered once per use. Which is why only an LVALUE is accepted as a subject
        '' (see WalkStmt's N_WITH) -- re-evaluating 'p' or '*q' is free and gives the
        '' same answer, while re-evaluating a CALL would run it once per '.field', and
        '' fbc runs it once.
        if mb->lhs = Tko.NODE_NONE then
            if c.withSubject.Count > 0 then
                mb->lhs = cast( Tko.NodeId, _
                                c.withSubject[c.withSubject.Count - 1] )
            else
                '' NO OPEN 'with' AT ALL, and then a leading '.' is the ENCLOSING
                '' SCOPE'S -- the same thing '..' names. Measured, inside
                '' 'private sub T.s1( )' over a type with a static 'x' and a shared
                '' 'x' beside it: 'x' and 'T.x' both read the STATIC member and '.x'
                '' and '..x' both read the shared one.
                ''
                '' Left baseless it resolved to nothing, and the statement holding it
                '' declined -- 32 of them in structs/global-static.bas and as many
                '' again in namespace/global3.bas, whose whole subject this is.
                if c.ast->Kind( mb->rhs ) = Tko.N_IDENT then
                    dim as Tko.SymbolId dsid = c.syms->LookupInNamespace( _
                        FileScopeOf_( c, scope_ ), IdentNameOf( c, mb->rhs ) )
                    '' ...AND THE USINGS IN EFFECT HERE. One written INSIDE a procedure
                    '' is registered on the procedure's own scope, not on the file's, so
                    '' the probe above cannot see it -- and fbc accepts
                    '' 'sub s( ) : using n1 : r = .v1 : end sub'.
                    if dsid = Tko.SYMBOL_NONE then
                        dsid = c.syms->LookupThroughUsings( _
                            scope_, IdentNameOf( c, mb->rhs ) )
                    end if
                    if dsid <> Tko.SYMBOL_NONE then
                        c.info->SetRef( mb->rhs, dsid )
                        c.info->SetRef( id, dsid )
                        return
                    end if
                end if
            end if
        end if
        '' OPERANDS BEFORE THE WALK -- same reason as N_BINARY above.
        dim as Tko.NodeId mlhs = mb->lhs
        dim as Tko.NodeId mrhs = mb->rhs
        WalkExpr( c, mlhs, scope_ )

        '' EXCEPT when the base is a NAMESPACE. 'ns.Greet' is a QUALIFIED NAME, not a
        '' member access on a value, so the member is looked up in the namespace's own
        '' scope and bound here -- there is no base type to wait for.
        ''
        '' Without this the head of 'ns.Greet( 1 )' was a namespace and the call was
        '' reported as "'ns' is a namespace, not a procedure". fbcunit's CU_ASSERT
        '' expands to exactly that shape, which is why it accounted for the bulk of
        '' every unlowered count in the corpus.
        '' '..x' -- the base is the GLOBAL SCOPE itself, so the member is looked up there, VALUE class
        '' first: 'type INITCOMMONCONTROLSEX' holds the slot CWindow's '..InitCommonControlsEx' needs.
        '' A chain '..a.b.v' needs nothing more: '..a' binds to the namespace, then the path below.
        if c.ast->Kind( mlhs ) = Tko.N_GLOBALSCOPE then
            if c.ast->Kind( mrhs ) = Tko.N_IDENT then
                dim as Tko.SymbolId gsid = c.syms->LookupLocalTyped( FileScopeOf_( c, scope_ ), IdentNameOf( c, mrhs ), false )
                if gsid = Tko.SYMBOL_NONE then gsid = c.syms->LookupInNamespace( FileScopeOf_( c, scope_ ), IdentNameOf( c, mrhs ) )
                if gsid <> Tko.SYMBOL_NONE then
                    c.info->SetRef( mrhs, gsid )
                    c.info->SetRef( id, gsid )
                end if
            end if
            return
        end if

        '' A NAME THAT IS BOTH A TYPE AND A PROCEDURE: as the BASE of a member
        '' access it is the TYPE. An identifier in expression position deliberately
        '' prefers the VALUE class -- see the N_IDENT case -- and that is right
        '' everywhere except here, because a PROCEDURE has no members to reach.
        ''
        '' Measured, and it is not hypothetical: 'crt/time.bi' declares a global
        '' 'localtime', 'fb/chrono.bi' declares 'FB.LocalTime', and including both
        '' made every 'LocalTime.<static>( )' inside the namespace resolve to the C
        '' function. Ten statements in tui/tuiterm_.bas, thirteen in the corpus,
        '' and fbc compiles all of them.
        ''
        '' ONLY WHEN THE TYPE ACTUALLY HAS THE MEMBER, so a genuine call whose
        '' result is reached into is untouched.
        if c.ast->Kind( mlhs ) = Tko.N_IDENT then
            dim as Tko.Symbol ptr bp0 = c.syms->SymbolAt( c.info->RefOf( mlhs ) )
            if bp0 <> nullptr then
                if bp0->kind = cast( uint8, Tko.SYM_PROC ) then
                    if c.ast->Kind( mrhs ) = Tko.N_IDENT then
                        dim as Tko.SymbolId tsid3 = c.syms->LookupTyped( _
                            scope_, IdentNameOf( c, mlhs ), true )
                        dim as Tko.Symbol ptr ty3 = c.syms->SymbolAt( tsid3 )
                        if ty3 <> nullptr then
                            dim as boolean isUdt = _
                                (ty3->kind = cast( uint8, Tko.SYM_UDT ))
                            dim as boolean hasIn = (ty3->inner <> Tko.SCOPE_NONE)
                            if isUdt andalso hasIn then
                                dim as Tko.SymbolId m3 = c.syms->LookupLocal( _
                                    ty3->inner, IdentNameOf( c, mrhs ) )
                                if m3 <> Tko.SYMBOL_NONE then
                                    c.info->SetRef( mlhs, tsid3 )
                                end if
                            end if
                        end if
                    end if
                end if
            end if
        end if

        LookPastField_( c, mlhs, mrhs, scope_ )         '' a field named like a namespace (TK-001)
        dim as Tko.SymbolId bsid = c.info->RefOf( mlhs )
        dim as Tko.Symbol ptr bs = c.syms->SymbolAt( bsid )
        if bs <> nullptr then
            if bs->kind = cast( uint8, Tko.SYM_NAMESPACE ) then
                if c.ast->Kind( mrhs ) = Tko.N_IDENT then
                    '' IdentNameOf, not StmtOf: an N_IDENT is not a statement payload,
                    '' and reading it as one is the pool mistake this codebase keeps
                    '' making.
                    '' LookupInNamespace, not LookupLocal: a namespace may get the
                    '' name from its OWN using, and a single hash probe never sees
                    '' one.
                    '' Through the module's own namespace, as an exported macro's body is
                    '' written: every name of it (RFC-0004 §6). Through an alias: its public.
                    c.syms->privileged = c.syms->IsImportNs( bsid )
                    dim as Tko.SymbolId msid = _
                        c.syms->LookupInNamespace( bs->inner, IdentNameOf( c, mrhs ) )
                    c.syms->privileged = false
                    if msid <> Tko.SYMBOL_NONE then
                        c.info->SetRef( mrhs, msid )
                        c.info->SetRef( id, msid )
                    end if
                end if
            elseif bs->kind = cast( uint8, Tko.SYM_ENUM ) then
                '' 'E.elem' -- AN ENUM MEMBER NAMED THROUGH ITS ENUM, which is the
                '' only spelling an EXPLICIT enum has. Unbound, the expression was
                '' untyped and everything built on it declined.
                if c.ast->Kind( mrhs ) = Tko.N_IDENT then
                    dim as Tko.SymbolId esid = _
                        c.syms->LookupLocal( bs->inner, IdentNameOf( c, mrhs ) )
                    if esid <> Tko.SYMBOL_NONE then
                        c.info->SetRef( mrhs, esid )
                        c.info->SetRef( id, esid )
                    end if
                end if
            elseif bs->kind = cast( uint8, Tko.SYM_UDT ) then
                '' 'T.foo( )' where T is the TYPE, not a variable of it: a STATIC
                '' member, qualified by its type exactly as a namespace member is by
                '' its namespace. The base being the UDT SYMBOL is what tells this from
                '' 'obj.foo( )', whose base is a VARIABLE.
                ''
                '' Bound ONLY when the member is actually static. fbc rejects a
                '' non-static one -- error 214, 'Member isn't static' -- and binding it
                '' here would lower a member call with NO RECEIVER, silently. Leaving
                '' it unbound keeps the existing diagnostic: the wrong message for the
                '' right outcome, which is the safe half to be wrong on.
                if c.ast->Kind( mrhs ) = Tko.N_IDENT then
                    dim as Tko.SymbolId msid = _
                        c.syms->LookupLocal( bs->inner, IdentNameOf( c, mrhs ) )

                    '' ...AND THEN IN WHAT THE TYPE EXTENDS. A STATIC member is called
                    '' through a type NAME, and it may be the DERIVED one: fbc compiles
                    '' 'Child.foo( )' over a foo declared on Parent and emits
                    '' '_ZN6PARENT3FOOEv(  );' for it, the same call it emits for
                    '' 'Parent.foo( )' on the line above. Searching only the type's own
                    '' scope missed it, so nothing was bound and the walk fell back to
                    '' resolving 'Child' itself -- a SYM_UDT, and the diagnostic
                    '' "'child' is a type, not a procedure".
                    dim as Tko.ScopeId bsc = cast( Tko.ScopeId, bs->inner )
                    dim as int32 bdepth = 0
                    do while (msid = Tko.SYMBOL_NONE) andalso (bdepth < 32)
                        bsc = BaseScopeOf_( c, bsc )
                        if bsc = Tko.SCOPE_NONE then exit do
                        msid = c.syms->LookupLocal( bsc, IdentNameOf( c, mrhs ) )
                        bdepth += 1
                    loop

                    '' A CONSTANT declared inside a TYPE is reached the same way and
                    '' takes no receiver at all: 'type T : const c0 = 7 : end type'
                    '' then 'T.c0' is 7 to fbc, and 'var w = T.c0' is an INTEGER.
                    '' Only procedures were bound here, so every such reference was
                    '' untyped -- 270 of the corpus's remaining verifier failures are
                    '' one file doing exactly this, 'var i00 = T0.c0'.
                    '' A NESTED TYPE is bound for the same reason: 'T0.T1.c1' is
                    '' one member access on another, and the inner one has to resolve
                    '' to the nested UDT before the outer can look inside it. Neither
                    '' takes a receiver, which is what separates both from an
                    '' instance member.
                    dim as Tko.Symbol ptr ms = c.syms->SymbolAt( msid )
                    dim as boolean isConstMember = false
                    if ms <> nullptr then
                        select case cast( Tko.SymbolKind, ms->kind )
                        case Tko.SYM_CONSTANT, Tko.SYM_ENUMCONST, Tko.SYM_UDT, _
                             Tko.SYM_ENUM, Tko.SYM_TYPEDEF
                            isConstMember = true
                        end select
                    end if

                    if IsStaticProc_( c, msid ) orelse isConstMember then
                        c.info->SetRef( mrhs, msid )
                        c.info->SetRef( id, msid )
                    end if
                end if
            end if
        end if

    case Tko.N_NEW
        '' 'new T' -- the TARGET IS A TYPE, not a value, so it is resolved as a type
        '' reference and the ordinary WalkExpr below would find nothing to bind.
        dim as Tko.ListPayload ptr np = ListOf( c, id )
        if np->target <> Tko.NODE_NONE then
            dim as Tko.TypeId nt = ResolveTypeRef( c, np->target, scope_ )
            if nt <> Tko.TYPE_NONE then c.info->SetType( np->target, nt )
        end if
        for i as int32 = 0 to np->count - 1
            WalkExpr( c, c.ast->ChildAt( np->first, i ), scope_ )
        next
        return

    case Tko.N_INTRINSIC
        '' An INTRINSIC IN EXPRESSION POSITION -- 'r = get( #f, 1, b )', as the corpus writes
        '' every file GET and PUT. The statement's node, so its operands live in the
        '' STATEMENT payload; without this case none were resolved: the channel unbound.
        if RewriteShadowedIntrinsic_( c, id, scope_ ) then WalkExpr( c, id, scope_ ) : return
        dim as Tko.StmtPayload ptr ip = StmtOf( c, id )
        if ip->a <> Tko.NODE_NONE then WalkExpr( c, ip->a, scope_ )
        if ip->b <> Tko.NODE_NONE then WalkExpr( c, ip->b, scope_ )
        '' ...AND 'c', which is where the parser puts OPEN's record length. Left
        '' unwalked, 'open( f for binary as #1 len = n )' had an unresolved 'n' and the
        '' whole expression declined -- while a foldable 'len = 8 + 8' worked, and so
        '' did the same OPEN written as a STATEMENT, which is what made it look like an
        '' expression-form gap rather than a missing walk.
        if ip->c <> Tko.NODE_NONE then WalkExpr( c, ip->c, scope_ )
        for i as int32 = 0 to ip->count - 1
            dim as Tko.NodeId arg = c.ast->ChildAt( ip->first, i )
            if c.ast->Kind( arg ) <> Tko.N_ELIDED then WalkExpr( c, arg, scope_ )
        next
        return

    case Tko.N_CALL, Tko.N_INDEX, Tko.N_PAREN, Tko.N_TUPLE, Tko.N_INITIALIZER, _
         Tko.N_STRCAT
        dim as Tko.ListPayload ptr lp = ListOf( c, id )
        '' 'type<P>( 5, 6 )' PUTS A TYPE IN THE TARGET, not an expression. Walking it
        '' as one leaves the literal with no type at all, and every use of it -- an
        '' initialiser, an argument, a parameter default -- then has nothing to build.
        if (lp->target <> Tko.NODE_NONE) andalso _
           (c.ast->Kind( lp->target ) = Tko.N_TYPEREF) then
            if ResolveTypeRef( c, lp->target, scope_ ) = Tko.TYPE_NONE then PendExprTypeRef_( c, lp->target, scope_ )
        else
            WalkExpr( c, lp->target, scope_ )
        end if
        '' '..NAME( )' IS THE BUILTIN, and a USING does not hide one -- see BuiltinCallTarget_.
        BuiltinCallTarget_( c, lp, scope_ )

        '' THE CALL NODE CARRIES ITS CALLEE, which lowering reads off it. A direct
        '' call gets one because the target's own binding is copied up elsewhere; a
        '' call THROUGH A PROCEDURE POINTER did not, so 'dim as sub( ) p = procptr( f )
        '' : p( )' reached lowering with no callee at all and was counted as unbound.
        '' The target is a VARIABLE here, and that is exactly what says the call is
        '' indirect.
        for i as int32 = 0 to lp->count - 1
            dim as Tko.NodeId arg = c.ast->ChildAt( lp->first, i )
            '' 'cast( long, x )' and 'cptr( any ptr, x )' put a TYPE in argument
            '' position. WalkExpr has nothing to say about one, and leaving it
            '' unresolved left every cast untyped -- the type argument IS the result.
            if c.ast->Kind( arg ) = Tko.N_TYPEREF then
                if ResolveTypeRef( c, arg, scope_ ) = Tko.TYPE_NONE then PendExprTypeRef_( c, arg, scope_ )
            else
                WalkExpr( c, arg, scope_ )
            end if
        next
        if c.ast->Kind( id ) = Tko.N_CALL then
            LenOperandPrefix_( c, id, scope_ )   '' 'len( NS.f( ) )' is f in view -- see there
            '' 'Ok( of Decimal, FinanceError )( v )' -- A GENERIC PROCEDURE, whose type
            '' arguments the parser recorded against this node. Tried BEFORE the
            '' ordinary binding below: the target names the GENERIC, and copying that
            '' binding up would point the call at a procedure with no code.
            dim as Tko.SymbolId gpi = InstantiateGenericProc_( c, id, scope_ )
            if gpi <> Tko.SYMBOL_NONE then
                c.info->SetRef( id, gpi )
                c.info->SetRef( lp->target, gpi )
            elseif GenericCtorCall_( c, id, lp, scope_ ) then
                '' Bound to the INSTANTIATION by the call above.
            elseif c.info->RefOf( id ) = Tko.SYMBOL_NONE then
                c.info->SetRef( id, c.info->RefOf( lp->target ) )
            end if
        end if
    end select
end sub
#include once "symbols/resolveamb.tiko"

sub WalkStmt _
    ( byref c as Ctx, byval id as Tko.NodeId, byval scope_ as Tko.ScopeId )

    if id = Tko.NODE_NONE then return
    c.syms->usePos = cast( uint32, id )    '' which side of an '#undef': see UndefSym
    dim as Tko.NodeKind k = c.ast->Kind( id )
    dim as Tko.NodeCategory cat = Tko.NodeKindCategory( k )

    '' Collect recorded the scope for anything that opened one; otherwise inherit.
    dim as Tko.ScopeId here = c.info->ScopeOf( id )
    if here = Tko.SCOPE_NONE then here = scope_
    StatementChecks_( c, id, here )  '' a runtime procedure's name, defer -- resolvestmt.tiko

    '' A STATEMENT KEYWORD NAMING A PROCEDURE HERE IS A CALL -- RewriteShadowedIntrinsic_.
    if k = Tko.N_INTRINSIC then
        if RewriteShadowedIntrinsic_( c, id, here ) then
            k = c.ast->Kind( id )
            cat = Tko.NodeKindCategory( k )
        end if
    end if

    if cat = Tko.NCAT_EXPR then
        WalkExpr( c, id, here )
        return
    end if

    '' AS CONST refuses four things a plain SELECT accepts. Checked here, not in the
    '' parser, because three of the four need the case values FOLDED -- and a named
    '' 'const' only has a value by the time Resolve reaches it.
    if k = Tko.N_SELECT then SelectConstCheck_( c, id, here )

    select case k
    case Tko.N_MODULE, Tko.N_BLOCK
        '' FIRST AND COUNT SNAPSHOTTED, and the pending instantiations drained BETWEEN
        '' statements -- see WalkBlock_ for why both.
        WalkBlock_( c, id, here )
        return

    case Tko.N_SPAWN
        '' 'spawn f( a, ... )'. The parser rewrote it into ordinary statements --
        '' allocate the frame, copy the arguments in, hand it to fb_Spawn -- and
        '' they hang off 'b'. Only the FRAME TYPE is left, and it is built here
        '' because nothing later can see the callee's declaration from this scope.
        BuildSpawnFrame_( c, id, here )
        WalkStmt( c, StmtOf( c, id )->b, here )
        return

    case Tko.N_ASSERT
        '' '#assert expr' -- a COMPILE-TIME check, not a runtime one, and not a
        '' preprocessor directive either: its expression is ordinary FreeBASIC and may
        '' name constants, enum members and sizeof, which the preprocessor cannot see.
        ''
        '' Measured against fbc: '#assert 1 = 2' is error 308, "#ASSERT condition
        '' failed"; '#assert sizeof(integer) = 8' and '#assert B = 1' over an enum
        '' member pass; and a condition that is NOT constant -- '#assert i = 1' over a
        '' variable -- is error 11, "Expected constant". So an unfoldable condition is
        '' a diagnostic in its own right, not something to pass over quietly.
        ''
        '' 720 of these stood unlowered, which said nothing about them being unchecked:
        '' they emit no code either way, so the decline was the only trace that the
        '' check itself was missing.
        dim as Tko.StmtPayload ptr asp = StmtOf( c, id )
        WalkExpr( c, asp->a, here )
        dim as Tko.Check.ConstVal av = Tko.Check.ConstOf( _
            *c.ast, asp->a, *c.srcMgr, *c.names, _
            c.types->target.pointerBits, c.syms, here )
        '' REPORTED ONLY WHEN THE ANSWER IS KNOWN AND FALSE. fbc also rejects a
        '' condition that is not constant at all -- '#assert i = 1' over a variable is
        '' its error 11 -- but tiko-lang's constant evaluator cannot fold 'sizeof( T )', and
        '' '#assert sizeof( integer ) = 8' appears in seventeen corpus files. Reporting
        '' every unfoldable condition would turn all of them into errors fbc does not
        '' have, so the check stays SILENT where it cannot tell. A missing diagnostic
        '' is a gap; a false one is a wrong compiler. TKO0605 is spelled and left for
        '' when sizeof folds.
        if av.known andalso (av.value = 0) then
            c.diags->Report( Tko.TKO0604, Tko.PointRange( c.ast->Loc( id ) ) )
        end if
        return

    case Tko.N_UNDEF
        '' '#undef' OF A NAME ONLY A USING REACHES -- fbc's error 123, and the one half of
        '' it Collect cannot see: usings are registered HERE, in source order. 'extra' = 1
        '' is Collect's mark that its own lookup found nothing (UndefKeeps_).
        dim as Tko.StmtPayload ptr udp = StmtOf( c, id ) : c.rtlUndef.Push( cast( uint32, c.names->Fold( udp->name ) ) )   '' + frees a runtime name (RtlNameAt_)
        if udp->extra = 1 then
            dim as Tko.Symbol ptr us = c.syms->SymbolAt( c.syms->LookupThroughUsings( here, udp->name ) )
            if us <> nullptr then
                c.diags->Report( Tko.TKO0779, Tko.PointRange( c.ast->Loc( id ) ), c.names->Spelling( udp->name ) )
                c.diags->AddNote( Tko.TKO0901, Tko.PointRange( us->loc ) )
            end if
        end if
        return

    case Tko.N_USING
        '' 'using FB' makes a namespace's names visible unqualified from here on. It
        '' was PARSED and then dropped -- 175 statements that did nothing -- which is
        '' why the runtime headers have to write 'FB.FB_RTERROR_ILLEGALFUNCTIONCALL' in
        '' full and say so in their own comments.
        ''
        '' Registered against the scope the USING appears in, so it applies for the
        '' rest of that scope and no further, and searched after the scope's own names
        '' and before its parent's -- a local declaration beats an import, an import
        '' beats an outer name.
        ''
        '' A DOTTED path -- 'using a.b' -- is walked component by component, the same
        '' way a qualified type name is: only the FIRST is visible from here, and each
        '' later one is looked up INSIDE what the previous opened.
        '' ...AND A COMMA LIST, 'using a, b', keeps each later path as a child N_USING, in
        '' order: the loop takes the statement itself (u = -1), then each child.
        dim as Tko.StmtPayload ptr usp = StmtOf( c, id )
        for u as int32 = -1 to usp->count - 1
            dim as Tko.NodeId un = id
            if u >= 0 then un = c.ast->ChildAt( usp->first, u )
            dim as Tko.InternId unm = StmtOf( c, un )->name
            if unm = 0 then continue for
            c.info->SetScope( un, here )
            dim as Tko.SymbolId nsid = LookupDottedNamespace_( c, here, unm )
            dim as Tko.Symbol ptr nss = c.syms->SymbolAt( nsid )
            '' ...AND A PATH THAT NAMES NO NAMESPACE ABOVE IT -- nothing, a type, a variable,
            '' one declared below, an inner one from outside its parent -- is fbc's error 8
            '' (3 for a bad later component; fbc-modern 1.20, 2026-09-30). It was dropped.
            dim as boolean nsOk = (nss <> nullptr)
            if nsOk then nsOk = (nss->kind = cast( uint8, Tko.SYM_NAMESPACE )) andalso (DeclaredBelow_( c, nsid, un, here ) = false)
            if nsOk = false then c.diags->Report( Tko.TKO0923, Tko.PointRange( c.ast->Loc( un ) ), c.names->Spelling( unm ) )
            if nsOk = false then continue for
            c.syms->AddUsing( here, nss->inner, cast( uint32, un ) )
            c.info->SetRef( un, nsid )    '' for CheckUsingAmbiguity_ (declshape.tiko)
        next
        return

    case Tko.N_WITH
        '' 'with expr' ... '.field' ... 'end with'. The subject is resolved once, then
        '' pushed so every baseless member inside takes it as a base.
        ''
        '' ONLY AN LVALUE. The base is shared by pointing at the subject's node, so the
        '' subject is lowered once per use inside the body; that is free for a variable
        '' or a dereference and WRONG for anything with a side effect. A subject that
        '' is not an lvalue leaves the stack alone, the members stay baseless, and the
        '' body declines exactly as it did before -- which is the honest outcome, not a
        '' silently doubled call.
        dim as Tko.StmtPayload ptr wsp = StmtOf( c, id )
        '' 'with( x )' IS THE SPELLING THE CORPUS USES, and the parentheses are a node.
        '' The subject is normalised to what is inside them so the kind test below sees
        '' the expression itself -- and so LOWERING keys its evaluated address on the
        '' same node the members were pointed at.
        '' N_PAREN keeps its contents in the CHILD LIST, not in 'target' -- MakeList
        '' builds it with no target at all -- and exactly one of them unless a comma
        '' was written, which makes it a tuple instead.
        while c.ast->Kind( wsp->a ) = Tko.N_PAREN
            dim as Tko.ListPayload ptr pl2 = _
                c.ast->ListOf( wsp->a )
            if pl2->count <> 1 then exit while
            wsp->a = cast( Tko.NodeId, c.ast->ChildSlot( pl2->first ) )
        wend
        WalkExpr( c, wsp->a, here )
        dim as boolean pushed = false
        if wsp->a <> Tko.NODE_NONE then
            select case c.ast->Kind( wsp->a )
            case Tko.N_IDENT, Tko.N_MEMBER, Tko.N_DEREF, Tko.N_INDEX, Tko.N_CALL, _
                 Tko.N_TUPLE
                '' N_CALL IS HOW AN ARRAY ELEMENT IS SPELLED -- 'with status( i )' --
                '' and the parser cannot tell it from a procedure call, so the node
                '' kind stays N_CALL through resolution. Refusing it left every member
                '' inside baseless, and 'with( status( hFindSlot( @this ) ) )' is how
                '' structs/temp-var-dtors is written from end to end.
                ''
                '' The re-evaluation the comment above warns about is answered in
                '' LOWERING instead: the subject's ADDRESS is computed ONCE into a
                '' temporary and every '.field' inside the body reads that, so a
                '' subject with a side effect runs once, which is what fbc does.
                ''
                '' N_TUPLE IS 'with( type<UDT>( 123 ) )' -- a type literal, which has an
                '' address because a temporary is built for it. The same once-evaluated
                '' slot serves it.
                c.withSubject.Push( cast( uint32, wsp->a ) )
                pushed = true
            end select
        end if
        WalkStmt( c, wsp->b, here )
        if pushed then c.withSubject.Pop( )
        return

    case Tko.N_AMBIGUOUS
        ResolveAmbiguous( c, id, here )
        return

    case Tko.N_TYPEREF
        ResolveTypeRef( c, id, here )
        return

    case Tko.N_ENUM
        '' THE MEMBERS' VALUES. Nothing computed them: every enum constant in the tree
        '' was ZERO. 'error( FB.FB_RTERROR_ILLEGALFUNCTIONCALL )' raised error 0, and
        '' every SELECT CASE over an enum compared against 0 -- lowered, verified, and
        '' wrong, with nothing to report.
        ''
        '' The rule, measured by RUNNING fbc: numbering starts at 0, an explicit
        '' '= expr' sets the running value, and each later member is the previous plus
        '' one. 'A, B, C = 10, D, F = K + 1, G' with 'const K = 7' prints 0 1 10 11 8 9.
        '' The initialiser is a constant EXPRESSION and may name another constant, which
        '' is why this is here and not in Collect: folding it needs the symbol table
        '' populated and a SourceManager, and Collect has neither at that point.
        dim as Tko.StmtPayload ptr esp = StmtOf( c, id )
        '' AN ANONYMOUS ENUM GETS A GENERATED NAME, because its members need a TYPE
        '' like any others and a type here is made from one. Without it they stayed
        '' UNTYPED, and an untyped argument leaves the whole call untyped: the
        '' result type went missing, 'call void g( ... )' came out where the
        '' callee returns a long, and every use of the value declined.
        ''
        '' That is 'setlocale( LC_ALL, 0 )', every 'CoCreateInstance( ...,
        '' CLSCTX_INPROC_SERVER, ... )' and 'astNew( AST_VAR )' -- LC_ALL, CLSCTX_*
        '' and AST_* are all anonymous-enum members, and the lines that declined
        '' never mention an enum.
        ''
        '' 'TMP$' is fbc's own spelling: measured, '#print typeof( X )' over a
        '' member of an anonymous enum prints 'TMP$2' and the next one 'TMP$3'. The
        '' NUMBER is the declaring NODE rather than a compilation-order counter --
        '' nothing can observe it that fbc can be asked about, since the name is
        '' not spellable in source, and a node id is stable across passes.
        dim as Tko.InternId enumName = esp->name
        if enumName = 0 then
            enumName = c.names->Fold( c.names->GetString( "TMP$" & str( cast( int32, id ) ) ) )
        end if
        '' The scope Collect opened for this enum, when it has one. An ANONYMOUS
        '' enum has no symbol and so no scope, and its members live only outside.
        ''
        '' Read off the SYMBOL, not from info->SetScope: 'here' above is
        '' ScopeOf( id ), so recording the enum's own scope on the N_ENUM node
        '' moved 'here' INTO the enum -- and then the members published in the
        '' ENCLOSING scope never got a value or a type at all. That is a bare
        '' 'OP__COUNT' as an array bound going unfoldable, silently.
        dim as Tko.ScopeId escope = Tko.SCOPE_NONE
        if esp->name <> 0 then
            dim as Tko.Symbol ptr eos = _
                c.syms->SymbolAt( c.syms->LookupLocal( here, esp->name ) )
            if eos <> nullptr then
                if eos->kind = cast( uint8, Tko.SYM_ENUM ) then escope = eos->inner
            end if
        end if
        dim as int64 enumNext = 0
        for i as int32 = 0 to esp->count - 1
            dim as Tko.NodeId it = c.ast->ChildAt( esp->first, i )
            if c.ast->Kind( it ) <> Tko.N_ENUM_ITEM then continue for
            dim as Tko.StmtPayload ptr ip = StmtOf( c, it )
            if ip->b <> Tko.NODE_NONE then
                '' WALKED, not only folded. ConstOf answers the VALUE without binding
                '' anything, so an initialiser like 'NEXTCONST = T.MYCONST' reached
                '' every later pass with no symbol on it at all -- and the member-access
                '' checks, which need one, could say nothing about it. IN THE ENUM'S OWN
                '' SCOPE, walked AND folded: an EXPLICIT enum publishes nothing outside, so
                '' 'blue = green * 2' found no 'green', did not fold, and took the running
                '' value -- 3 where fbc prints 4 -- with the name left unbound as well.
                dim as Tko.ScopeId isc = iif( escope <> Tko.SCOPE_NONE, escope, here )
                WalkExpr( c, ip->b, isc )
                dim as Tko.Check.ConstVal ev = Tko.Check.ConstOf( _
                    *c.ast, ip->b, *c.srcMgr, *c.names, 64, c.syms, isc )
                '' An initialiser that will not fold leaves the running value alone:
                '' wrong by ONE member rather than by all of them.
                if ev.known then enumNext = ev.value
            end if
            '' TWO symbols may carry one member: the enum's OWN scope always holds
            '' it, and the enclosing scope holds it too when the name was free
            '' there. Both need the value, or 'E.K' and a bare 'K' disagree.
            for pass_ as int32 = 0 to 1
            dim as Tko.ScopeId lsc = here
            if pass_ = 1 then
                lsc = escope
                if lsc = Tko.SCOPE_NONE then continue for
            end if
            dim as Tko.SymbolId esid = c.syms->LookupLocal( lsc, ip->name )
            dim as Tko.Symbol ptr es = c.syms->SymbolAt( esid )
            if (es <> nullptr) andalso (pass_ = 0) then if es->loc <> c.ast->Loc( it ) then es = nullptr   '' THIS member's: another enum's (an explicit one's) took the bare name's value (enum-decls.bas)
            if es <> nullptr then
                if es->kind = cast( uint8, Tko.SYM_ENUMCONST ) then
                    '' On a SYM_ENUMCONST 'payload' is THE VALUE ITSELF, not a node id.
                    es->payload = enumNext
                    '' And its TYPE is the enum, which is what fbc says: '#print
                    '' typeof( B )' for a member of 'enum E2' prints E2. Without it the
                    '' member was untyped and anything reading it -- a PRINT item, a
                    '' comparison -- had nothing to work from. An ANONYMOUS enum has no
                    '' name to make one from, so it is given the generated one above.
                    es->type_ = c.types->NamedType( Tko.TK_ENUM, enumName, _
                                                    cast( uint32, here ) )
                end if
            end if
            next
            enumNext += 1
        next
        return

    case Tko.N_VAR, Tko.N_CONST
        '' Resolving a declaration's TypeRef is not enough: the SYMBOL has to carry
        '' the result, or every later use of the name is untyped. Collect could not
        '' do this -- a type may be declared after the variable that uses it, which
        '' is exactly why type references are resolved in this pass and not that one.
        dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
        if sp->op = cast( uint16, Tko.KW_REDIM ) then
            '' EXCEPT WITH AN 'AS' CLAUSE, which declares the array as well as sizing
            '' it: 'redim foo( 1 to 2 ) as integer' is how a dynamic array is brought
            '' into existence in one line, and the corpus's own redim test writes
            '' nothing else. Collect now declares those, and they need a TYPE here for
            '' the same reason a DIM does -- the bounds path below only walks the
            '' bounds. A DYNAMIC array type, whatever bounds were written: the whole
            '' point of the form is that they are set at run time.
            dim as boolean declares = false
            for i as int32 = 0 to sp->count - 1
                dim as Tko.NodeId it3 = c.ast->ChildAt( sp->first, i )
                if c.ast->Kind( it3 ) <> Tko.N_VAR_ITEM then continue for
                dim as Tko.StmtPayload ptr ip3 = StmtOf( c, it3 )
                if ip3->a = Tko.NODE_NONE then continue for
                declares = true
                dim as Tko.TypeId bt3 = ResolveTypeRef( c, ip3->a, here )
                if bt3 = Tko.TYPE_NONE then continue for
                if RedimReachesOuter_( c, here, it3, ip3->name, bt3 ) then continue for   '' resolvemodalias.tiko (TE-013)
                '' RANK 0 MEANS UNSPECIFIED, and EMPTY PARENS ARE RANK 0. Measured:
                '' 'redim a() as T' emits the same descriptor 'dim a() as T' does --
                '' DIMENSIONS 0 and FLAGS 8, eight dimension-table slots, 240 bytes --
                '' where a written rank gives DIMENSIONS n and FLAGS 16 + n. Forcing a
                '' minimum of one made it a 72-byte one-dimensional descriptor, so the
                '' two spellings of the same declaration disagreed about their own size.
                dim as int32 ndim = 1
                if ip3->c <> Tko.NODE_NONE then
                    if c.ast->Kind( ip3->c ) = Tko.N_BLOCK then
                        ndim = c.ast->ListOf( ip3->c )->count
                    end if
                end if
                if ndim < 0 then ndim = 0
                BindDeclType( c, here, ip3->name, c.types->DynArrayOf( bt3, ndim ), false )
            next

            '' A REDIM declares nothing -- the array already exists -- but its BOUNDS
            '' are ordinary runtime expressions and have to be resolved like any
            '' other. Returning here without walking them left 'redim a(0 to n)' with
            '' an unbound 'n', so lowering could not produce a value for it and the
            '' whole statement declined. Only a redim to CONSTANT bounds worked, which
            '' is the least interesting kind.
            for i as int32 = 0 to sp->count - 1
                dim as Tko.NodeId item = c.ast->ChildAt( sp->first, i )
                if c.ast->Kind( item ) <> Tko.N_VAR_ITEM then continue for
                dim as Tko.StmtPayload ptr rp = StmtOf( c, item )
                '' 'redim x.array( 0 to 9 )' and 'redim ( a )( 0 to 9 )' name their
                '' array through an EXPRESSION, which the parser puts in the slot a
                '' REDIM otherwise leaves empty. It is an ordinary lvalue and has to be
                '' resolved like one, or lowering has an unbound name to take the
                '' address of.
                if rp->extra = cast( uint16, Tko.KW_REDIM ) then
                    if rp->b <> Tko.NODE_NONE then WalkStmt( c, rp->b, here )
                elseif rp->a = Tko.NODE_NONE then
                    '' A BARE 'redim a( ... )' names an array that already exists and
                    '' declares nothing, so nothing bound its item to that array -- and
                    '' the post-Check rank test then had no symbol to read the declared
                    '' rank from. Bound here, where the scope is at hand.
                    dim as Tko.SymbolId rsid = VisibleToUse_( c, VisibleAbove_( c, c.syms->Lookup( here, rp->name ), item, here, rp->name ), here )   '' as seen ABOVE this line
                    if rsid <> Tko.SYMBOL_NONE then c.info->SetRef( item, rsid )
                end if
                if rp->c = Tko.NODE_NONE then continue for
                if c.ast->Kind( rp->c ) <> Tko.N_BLOCK then continue for
                dim as Tko.ListPayload ptr rl = _
                    c.ast->ListOf( rp->c )
                for d as int32 = 0 to rl->count - 1
                    WalkStmt( c, c.ast->ChildAt( rl->first, d ), here )
                next
            next
            return
        end if
        for i as int32 = 0 to sp->count - 1
            dim as Tko.NodeId item = c.ast->ChildAt( sp->first, i )
            if c.ast->Kind( item ) <> Tko.N_VAR_ITEM then continue for
            dim as Tko.StmtPayload ptr ip = StmtOf( c, item )
            dim as Tko.TypeId t = ResolveTypeRef( c, ip->a, here )
            '' 'dim as long a(0 to 9)' is an ARRAY of long, not a long. Without this a
            '' local array reserved one ELEMENT. A RETURNED one is dynamic: resolvearr.tiko.
            t = ArrayFromBoundsNode( c, t, ip->c, ip->b, here )
            t = ReturnedLocalArray_( c, id, item, t, here )
            ArrayTooBig_( c, t, item, ip->name )
            if c.ast->Kind( id ) = Tko.N_CONST then
                ConstBoundCheck_( c, item, scope_ )
            end if
            if (c.ast->Flags( item ) and Tko.NF_QUALIFIED) <> 0 then
                CheckStaticMemberVar_( c, scope_, item, ip->ownerName, ip->name )
            end if
            '' 'dim BYREF rb as integer = a' ALIASES a. Its type is a REFERENCE, which
            '' is the same shape a byref PARAMETER has -- and every piece of the model
            '' already follows from that one fact: the slot lowers to a pointer, and
            '' AddrOfVar loads it, so every read, write and '@' goes through the
            '' indirection. Only the DECLARATION had to learn to store an address.
            '' EITHER NODE MAY CARRY IT. A leading 'byref' belongs to the whole
            '' declaration and sits on the N_VAR; one written again after a comma
            '' belongs to that item alone and sits on the item.
            dim as uint16 brf = _
                (c.ast->Flags( id ) or _
                 c.ast->Flags( item ))
            if (brf and Tko.NF_BYREF) <> 0 then
                if t <> Tko.TYPE_NONE then t = c.types->Reference( t )
            end if
            '' ...AND A TYPE BUILT OVER SOMETHING NOT RESOLVED YET is revisited too.
            '' See TypeIsIncomplete_.
            dim as boolean revisit = (t = Tko.TYPE_NONE)
            if revisit = false then revisit = TypeIsIncomplete_( c, t )
            if revisit then
                '' A DECLARATION WITH NO TYPE AND NO INITIALISER is the DEFAULT-TYPE
                '' feature -- 'dim a', 'dim b%', 'byval s$'. fbc refuses those outside
                '' -lang deprecated/fblite/qb (its error 147), and tiko-lang implements
                '' #lang "fb" only. Reported rather than left untyped: the symbol
                '' otherwise reaches lowering with no type, gets a VOID SLOT, and the
                '' store into it is a verify failure three passes later with nothing
                '' to say where it came from.
                ''
                '' Only when there is no TYPE REFERENCE at all. An unresolved type NAME
                '' stays silent, deliberately -- it may come from a header this build
                '' did not read.
                if (ip->a = Tko.NODE_NONE) andalso (ip->b = Tko.NODE_NONE) then
                    c.diags->Report( Tko.TKO0320, _
                        Tko.PointRange( c.ast->Loc( item ) ), _
                        c.names->Spelling( ip->name ) )
                end if
                c.pendingItem.Push( cast( uint32, item ) )
                c.pendingScope.Push( cast( uint32, here ) )
            end if
            '' AFTER the revisit test, not before it: a declaration whose type is not
            '' resolved yet comes through here twice, and reporting on the first pass
            '' gave the same error two lines apart.
            BindDeclType( c, here, ip->name, t, false )
            if CollInit_( c, id, item, t, revisit, here, sp, ip ) = false then
                if revisit = false then InitTooMany_( c, t, ip->b, ip->name, here )
            end if
            WalkStmt( c, ip->b, here )
            '' ...AND THE BOUNDS. 'dim a( 1 to n )' sizes its array at RUN TIME, and
            '' the bounds are ordinary expressions exactly as a REDIM's are -- which
            '' the branch above walks for precisely this reason. Here they were only
            '' CONST-FOLDED, by ArrayFromBoundsNode, so a non-constant bound left 'n'
            '' with no symbol, lowering could produce no value for it, and the
            '' fb_ArrayRedimEx that allocates the array was never emitted.
            if ip->c <> Tko.NODE_NONE then
                if c.ast->Kind( ip->c ) = Tko.N_BLOCK then
                    dim as Tko.ListPayload ptr dl = _
                        c.ast->ListOf( ip->c )
                    for d as int32 = 0 to dl->count - 1
                        WalkStmt( c, cast( Tko.NodeId, _
                            c.ast->ChildSlot( dl->first + d ) ), here )
                    next
                end if
            end if
        next
        return

    case Tko.N_PARAM
        '' THE WHOLE RULE IS IN BindParamType_, because a parameter whose type is
        '' not resolvable YET has to be bound again later -- see the pending list
        '' below and the second half of BackpatchTypedefs.
        dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
        if BindParamType_( c, id, here ) = Tko.TYPE_NONE then
            if sp->a <> Tko.NODE_NONE then
                c.pendParam.Push( cast( uint32, id ) )
                c.pendParamScope.Push( cast( uint32, here ) )
            end if
        end if
        '' Where the PROCEDURE is declared, not inside it -- see ParamDefaultScope_.
        c.inParamDefault = true : WalkStmt( c, sp->b, ParamDefaultScope_( c, here ) ) : c.inParamDefault = false
        return

    case Tko.N_TYPEDEF
        '' 'type myint as long'. Collect gave the symbol a NAMED type of its own, with
        '' nothing behind it, so every 'dim as myint' resolved to nothing and lowered to
        '' void -- silently, since an unknown type name is deliberately not reported
        '' (it may come from a header this build did not read).
        ''
        '' A TYPEDEF IS TRANSPARENT. Measured from fbc: 'sub F( byval a as myint )' and
        '' 'sub G( byval a as long )' mangle to _Z1Fi and _Z1Gi -- the same encoding, so
        '' the alias leaves no trace in the ABI. Binding the symbol straight to the
        '' aliased type therefore gives the right answer for type checking, for layout
        '' and for mangling at once, rather than needing each to unwrap it.
        '' Set DIRECTLY rather than through BindDeclType, which only fills a type that
        '' is still TYPE_NONE. Collect has already put a placeholder named type here, so
        '' the ordinary bind is a silent no-op -- which is exactly what it did.
        if PreludeTypedefLost( c, id, here ) then return
        dim as Tko.StmtPayload ptr tsp = StmtOf( c, id )
        c.typedefNode.Push( cast( uint32, id ) )
        c.typedefScope.Push( cast( uint32, here ) )
        dim as Tko.TypeId aliased = ResolveTypeRef( c, tsp->a, here )
        '' ...OR A FORWARD REFERENCE TO A TYPE NOBODY DEFINES -- and HERE, not in
        '' the backpatch: see ForwardTypedefTarget_.
        if aliased = Tko.TYPE_NONE then aliased = ForwardTypedefTarget_( c, tsp, here )
        if (aliased <> Tko.TYPE_NONE) andalso (tsp->name <> 0) then
            '' The TYPEDEF, not a variable of the same name -- when the variable was
            '' declared first it holds the slot, and the typedef never got its type.
            dim as Tko.SymbolId tsid = c.syms->LookupLocalTyped( here, tsp->name, true )
            dim as Tko.Symbol ptr tsym = c.syms->SymbolAt( tsid )
            if tsym <> nullptr then
                if tsym->kind = cast( uint8, Tko.SYM_TYPEDEF ) then tsym->type_ = aliased
            end if
        end if
        '' The extra names of 'type as integer a, b'.
        for i as int32 = 0 to tsp->count - 1
            WalkStmt( c, c.ast->ChildAt( tsp->first, i ), here )
        next
        return

    case Tko.N_FIELD
        dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
        '' A TYPE IS NOT VISIBLE IN ITS OWN 'extends' CLAUSE. 'type UDT1 extends
        '' UDT1' inside a namespace names the OUTER UDT1 -- fbc compiles it and
        '' prints -1 for 'is' against the inner one -- but the lookup starts in the
        '' type's own scope, found ITSELF, and the type became its own base: no
        '' layout, so 'new ns1.UDT1' had nothing to size.
        ''
        '' The base is a synthesised FIELD named 'base' -- a keyword, so no user
        '' field can be called that -- and it is the only field whose type may not
        '' see the type around it.
        dim as Tko.ScopeId fhere = here
        dim as boolean isBaseFld = _
            (sp->name = c.names->Fold( c.names->GetString( "base" ) ))
        if isBaseFld then
            dim as Tko.SymScope ptr fsc = c.syms->ScopeAt( here )
            if fsc <> nullptr then
                if fsc->parent <> Tko.SCOPE_NONE then fhere = fsc->parent
            end if
        end if
        dim as Tko.TypeId t = ResolveTypeRef( c, sp->a, fhere )
        '' ...AND A SCALAR FIELD BUILT OVER A TYPEDEF STILL UNFILLED is revisited too, as a local is
        '' (TypeIsIncomplete_): 'as LPHANDLE ph' over 'type LPHANDLE as HANDLE ptr' written above
        '' 'type HANDLE as any ptr' -- windows.bi's order -- kept a pointer to the placeholder, and
        '' '*m.ph' / 'm.ph[ i ]' declined (fbc-examples r2ice03, fbsound plug-ds).
        dim as boolean pendIt = (t = Tko.TYPE_NONE)
        if (pendIt = false) andalso (sp->count = 0) then pendIt = TypeIsIncomplete_( c, t )
        if pendIt then c.pendField.Push( cast( uint32, id ) ) : c.pendFieldScope.Push( cast( uint32, here ) )
        '' ...AND IF IT STILL FOUND ITSELF, from one scope further out. A namespace
        '' holds the type being declared as well, so stepping out ONE level is not
        '' enough for 'namespace ns1 : type UDT1 extends UDT1'. Stepping out
        '' unconditionally would be wrong -- a base declared BESIDE this type in
        '' the same namespace is an ordinary sibling and must still be found -- so
        '' the retry happens only when the answer IS this type.
        if isBaseFld andalso (t <> Tko.TYPE_NONE) then
            dim as Tko.SymScope ptr osc = c.syms->ScopeAt( here )
            if osc <> nullptr then
                dim as Tko.Symbol ptr osy = c.syms->SymbolAt( osc->owner )
                if osy <> nullptr then
                    if c.types->Unqualify( t ) = c.types->Unqualify( osy->type_ ) then
                        dim as Tko.SymScope ptr psc = c.syms->ScopeAt( fhere )
                        if psc <> nullptr then
                            if psc->parent <> Tko.SCOPE_NONE then
                                t = ResolveTypeRef( c, sp->a, psc->parent )
                            end if
                        end if
                    end if
                end if
            end if
        end if
        '' A field declared with bounds is an ARRAY of that type. The bounds are
        '' low/high pairs and the element count is their product -- which the layout
        '' needs, and which was simply lost while the bounds were being skipped.
        t = FieldArrayType_( c, t, sp, here )   '' resolvearr.tiko: a 'redim' field is dynamic
        '' A FIELD ARRAY HAS THE SAME LIMIT -- 'as byte test(0 to &h7FFFFFFF)' inside a
        '' type is fbc's error 50 exactly as at module level. Four corpus files.
        ArrayTooBig_( c, t, id, sp->name )
        BindDeclType( c, here, sp->name, t, false )

        '' THE FIELD'S '= value'. Nothing walked it, so every name inside it stayed
        '' unbound -- and lowering did not decline on that, it lowered the unbound
        '' thing: 'e as integer = f()' and 'h as integer = g' each stored a garbage
        '' word where fbc stores 42 and 5. Check types every expression node in the
        '' arena on its own, so binding the names here is all that was missing.
        ''
        '' In the FIELD'S OWN SCOPE, which chains to the one around it: a module-level
        '' const, variable or function is what these initialisers name in practice.
        if sp->c <> Tko.NODE_NONE then FieldInitWalk_( c, sp->c, here, sp->name )   '' geninit.tiko

        '' A BITFIELD is marked, not modelled. 'b' holds the width expression; the
        '' declared type is the storage UNIT's, not the field's, so reading or writing
        '' it as an ordinary field of that type would touch the whole unit and clobber
        '' the fields packed beside it. Until the packed layout and the masked access
        '' exist, the mark is what makes lowering decline instead.
        if sp->b <> Tko.NODE_NONE then
            dim as Tko.SymbolId fsid = c.syms->LookupLocal( here, sp->name )
            dim as Tko.Symbol ptr fs = c.syms->SymbolAt( fsid )
            if fs <> nullptr then
                '' On a SYM_FIELD carrying SYMF_BITFIELD, 'payload' is THE WIDTH IN
                '' BITS. Nothing else uses a field's payload, and the layout needs a
                '' number rather than an expression to place the field at all.
                dim as Tko.Check.ConstVal wv = Tko.Check.ConstOf( _
                    *c.ast, sp->b, *c.srcMgr, *c.names, 64, c.syms, here )
                if wv.known andalso (wv.value > 0) andalso (wv.value <= 64) then
                    fs->flags or= Tko.SYMF_BITFIELD
                    fs->payload = cast( int32, wv.value )
                end if
            end if
        end if
        return

    case Tko.N_FOR, Tko.N_FOREACH
        '' 'for i as integer' DECLARES i, and Collect named it -- but nothing bound
        '' its TYPE, so every use of the counter came out untyped. The 'as' clause
        '' is in 'c', which is also what told Collect it was a declaration.
        dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
        if sp->c <> Tko.NODE_NONE then
            dim as Tko.TypeId t = ResolveTypeRef( c, sp->c, here )
            '' 'for each BYREF v as long in a' BINDS THE ELEMENT, not a copy of it.
            '' The parser records the keyword in the statement's own 'op' and
            '' nothing read it, so the variable was an ordinary local and 'v *= 10'
            '' multiplied a copy thrown away -- fbc leaves the array 10, 50 and
            '' tiko-lang left it 1, 5.
            ''
            '' A REFERENCE TYPE is how every other alias is spelled here -- a byref
            '' parameter, 'dim byref r = x' -- so the rest of the compiler needs
            '' nothing new: it already reads and writes through one.
            if (k = Tko.N_FOREACH) andalso (t <> Tko.TYPE_NONE) then
                if cast( Tko.TokenKind, sp->op ) = Tko.KW_BYREF then
                    if c.types->Kind( t ) <> Tko.TK_REFERENCE then
                        t = c.types->Reference( t )
                    end if
                end if
            end if
            if (sp->a <> Tko.NODE_NONE) andalso _
               (c.ast->Kind( sp->a ) = Tko.N_IDENT) then
                dim as Tko.IdentPayload ptr ip = _
                    c.ast->IdentOf( sp->a )
                BindDeclType( c, here, ip->name, t, false )
            end if
        end if
        '' The SEQUENCE first, so its type is known before the variable is bound.
        for i as int32 = 0 to sp->count - 1
            WalkStmt( c, c.ast->ChildAt( sp->first, i ), here )
        next

        '' FOR EACH WITH NO 'as' CLAUSE takes the sequence's ELEMENT type. Without
        '' this the loop variable was declared and untyped, and the whole statement
        '' declined for want of a slot to load the element into.
        WalkExpr( c, sp->a, here )

        '' Bound through the RESOLVED REFERENCE, not by looking the name up again:
        '' the variable lives in the loop's OWN scope, which is not the scope this
        '' walk is carrying, so a name lookup here binds nothing and the loop
        '' variable stays untyped -- which is what it did.
        if (k = Tko.N_FOREACH) andalso (sp->c = Tko.NODE_NONE) andalso _
           (sp->count = 1) andalso (sp->a <> Tko.NODE_NONE) then
            dim as Tko.SymbolId vsid = c.info->RefOf( sp->a )
            dim as Tko.Symbol ptr vsym = c.syms->SymbolAt( vsid )
            if vsym <> nullptr then
                if vsym->type_ = Tko.TYPE_NONE then
                    '' From the sequence's SYMBOL, not from TypeOf_: an
                    '' expression's type is CHECK's to record and Check has not run,
                    '' so asking here returns nothing for every sequence there is.
                    '' That is what left the variable untyped even once it was
                    '' correctly declared.
                    dim as Tko.NodeId seqE = cast( Tko.NodeId, c.ast->ChildSlot( sp->first ) )
                    dim as Tko.TypeId seqT = Tko.TYPE_NONE
                    dim as Tko.Symbol ptr ssym = c.syms->SymbolAt( c.info->RefOf( seqE ) )
                    if ssym <> nullptr then seqT = ssym->type_
                    '' A BYREF PARAMETER IS A REFERENCE TO THE CONTAINER. Testing
                    '' the reference's own kind found neither an array nor a UDT, so
                    '' 'for each e in a' over a 'byref a as Array( of T )' left the
                    '' loop variable untyped -- and fbc's own stats.bi takes every
                    '' container that way.
                    if seqT <> Tko.TYPE_NONE then
                        seqT = c.types->Unqualify( seqT )
                        if c.types->Kind( seqT ) = Tko.TK_REFERENCE then
                            seqT = c.types->Unqualify( c.types->Inner( seqT ) )
                        end if
                    end if
                    if seqT <> Tko.TYPE_NONE then
                        if c.types->Kind( seqT ) = Tko.TK_ARRAY then
                            vsym->type_ = c.types->Inner( seqT )
                        elseif c.types->Kind( seqT ) = Tko.TK_UDT then
                            '' A USER COLLECTION -- the RFC-0002 iterator protocol.
                            '' Its element type is the return type of the ITERATOR's
                            '' Value( ), two lookups away: GetIterator gives the
                            '' iterator's type and Value gives the element's.
                            ''
                            '' Typed HERE and not in lowering, which is where it used
                            '' to happen. Check runs in between, so a variable typed
                            '' during lowering is untyped for the whole of Check --
                            '' and 'if y = 20' inside the loop body then produced NO
                            '' CONDITION at all, which went out as a conditional
                            '' branch with nothing to branch on.
                            vsym->type_ = IterElemType_( c, seqT )
                        end if
                    end if
                    '' ...AND BYREF WITH NO 'as' CLAUSE IS STILL BYREF. The wrap
                    '' above only runs when a type was WRITTEN, and
                    '' 'for each byref v in d' writes none.
                    if cast( Tko.TokenKind, sp->op ) = Tko.KW_BYREF then
                        if vsym->type_ <> Tko.TYPE_NONE then
                            if c.types->Kind( vsym->type_ ) <> Tko.TK_REFERENCE then
                                vsym->type_ = c.types->Reference( vsym->type_ )
                            end if
                        end if
                    end if
                end if
            end if
        end if

        WalkStmt( c, sp->b, here )
        return

    case Tko.N_PROC
        dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
        dim as Tko.SymbolId saved = c.currentProc
        c.currentProc = c.info->RefOf( id )
        '' The RETURN type belongs on the procedure's symbol, or a call to it can
        '' never be typed. Parameters are bound by the N_PARAM case below.
        dim as Tko.NodeId retRef = sp->a
        dim as Tko.TypeId ret = ProcResultType_( c, id, here )
        '' RE-FETCHED, because ResolveTypeRef may have INSTANTIATED A GENERIC, which
        '' re-parses into fresh nodes and moves ast.stmts -- leaving the 'sp' above
        '' pointing into a freed block that everything below reads.
        sp = StmtOf( c, id )
        dim as Tko.Symbol ptr ps = c.syms->SymbolAt( c.currentProc )
        if (ps <> nullptr) andalso (ret <> Tko.TYPE_NONE) andalso _
           (ps->type_ = Tko.TYPE_NONE) then
            ps->type_ = ret
        end if
        '' ...AND A RESULT THAT WILL NOT RESOLVE YET IS REVISITED. 'as LRESULT' over
        '' 'type LRESULT as LONG_PTR' declared later in the unit came out VOID and
        '' stayed void; see BindParamType_ for the parameter half of the same fact.
        if (ret = Tko.TYPE_NONE) andalso (retRef <> Tko.NODE_NONE) then
            c.pendResultProc.Push( cast( uint32, id ) )
            c.pendResultProcScope.Push( cast( uint32, here ) )
        end if
        BindThis( c, here, sp->ownerName )
        ResolveImplements_( c, id, here )      '' 'implements I.M': the I's -- resolvetype.tiko
        dim as int32 pCount = sp->count, pFirst = sp->first, pBody = sp->b
        for i as int32 = 0 to pCount - 1
            WalkStmt( c, cast( Tko.NodeId, c.ast->ChildSlot( pFirst + i ) ), here )
        next
        WalkStmt( c, pBody, here )
        c.currentProc = saved
        return
    end select

    '' Everything else: recurse through the general slots.
    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    if sp = nullptr then return
    WalkStmt( c, sp->a, here )
    '' ...BUT A TYPE'S '( of T, E )' LIST DECLARES ITS PARAMETERS, as undeclared.tiko already
    '' knows: walked as expressions, each name bound to whatever the scope had -- a module's
    '' private 'function E' -- and std's Result( of T, E ) failed inside result.tiko with
    '' TKO0776 'argument 1 of e is left out' (tiko-studio TS-002).
    if (k <> Tko.N_TYPE) andalso (k <> Tko.N_INTERFACE) then WalkStmt( c, sp->b, here )
    if k = Tko.N_TYPE then ResolveImplements_( c, id, here )    '' its 'implements' lines
    WalkStmt( c, sp->c, here )
    for i as int32 = 0 to sp->count - 1
        WalkStmt( c, c.ast->ChildAt( sp->first, i ), here )
    next
end sub

#include once "symbols/resolvemodalias.tiko"

sub Run _
    ( byref u as Tko.FrontUnit, byref st as Stats, _
      byval parser as any ptr, byval maxInstDepth as int32 )

    dim as Ctx c
    c.parser = parser
    c.srcMgr = u.src
    c.ast = u.ast
    c.syms = u.syms
    c.types = u.types
    c.names = u.names
    c.diags = u.diags
    c.info = u.info
    c.st = @st
    c.currentProc = Tko.SYMBOL_NONE : c.maxInstDepth = maxInstDepth

    c.info->Resize( c.ast->Count( ) )

    '' Before discovery AND after it -- see ModuleTypedefsFirst_.
    if (c.syms->modFileCount > 0) orelse (c.syms->importNs.Count > 0) then ModuleTypedefsFirst_( c )
    DiscoverInstantiations_( c, *c.ast, u.root, *c.diags, *c.info )
    if (c.syms->modFileCount > 0) orelse (c.syms->importNs.Count > 0) then ModuleTypedefsFirst_( c )
    WalkStmt( c, u.root, Tko.SCOPE_GLOBAL )
    c.syms->usePos = Tko.USEPOS_LATEST
    InstantiatePending_( c )
    InstantiatePendingProcs_( c )
    BackpatchTypedefs( c )
    '' AFTER the walk: a type declared inside a procedure may not have methods, and
    '' deciding that needs every field's type resolved.
    CheckNoMethodsInProc_( c )
    if c.syms->joinCopy.Count > 0 then JoinTwinsAfter_( c )
    if c.syms->modFileCount > 0 then ModuleJoinsAfter_( c )
end sub
#include once "symbols/resolvedump.tiko"

'' WalkExpr for another unit: a generic instance's field initialiser (geninit.tiko).
sub BindExpr_( byref c as Ctx, byval id as Tko.NodeId, byval scope_ as Tko.ScopeId )
    WalkExpr( c, id, scope_ )
end sub

end namespace
