'' type.ti -- the semantic type model.
''
'' Types are CANONICAL and INTERNED: a TypeId is a 32-bit handle, and two structurally
'' identical types share one id, so type equality is an integer compare
'' (docs/plan/06 section 1). That is what makes tuples' structural identity natural
'' rather than special-cased.
''
'' The model is TARGET-INDEPENDENT. Sizes and alignments come from a TargetLayout that
'' is injected, never hard-coded here, so "do not assume BASIC integer types map
'' identically across platforms" is structurally impossible to get wrong.
''
'' Invariants:
''   - TypeId 0 is TYPE_NONE.
''   - The builtin ids are FIXED small constants, so a builtin lookup is free and a
''     dump is stable across runs.
''   - Interning is by structural key: Pointer(Long) asked for twice is one id.

#ifndef __TKO_TYPE_BI__
#define __TKO_TYPE_BI__

#include once "tko.ti"
#include once "support/intern.ti"

namespace Tko

    type TypeId as uint32
    const TYPE_NONE as TypeId = 0

    '' BUILTIN( id name, spelling, bits, signed, class )
    ''
    '' 'integer' and 'uinteger' are POINTER-SIZED -- 32-bit on a 32-bit target, 64 on
    '' a 64-bit one -- while 'long'/'ulong' are always 32 and 'longint'/'ulongint'
    '' always 64. That is the single most common source of ported-code bugs, so the
    '' width here is a PROPERTY resolved by the data layout, not a number.
    #macro TKO_BUILTIN_LIST( BUILTIN )
        BUILTIN( TY_VOID,     "void",     0,   false, TC_VOID  )
        BUILTIN( TY_BYTE,     "byte",     8,   true,  TC_INT   )
        BUILTIN( TY_UBYTE,    "ubyte",    8,   false, TC_INT   )
        BUILTIN( TY_SHORT,    "short",    16,  true,  TC_INT   )
        BUILTIN( TY_USHORT,   "ushort",   16,  false, TC_INT   )
        BUILTIN( TY_LONG,     "long",     32,  true,  TC_INT   )
        BUILTIN( TY_ULONG,    "ulong",    32,  false, TC_INT   )
        BUILTIN( TY_INTEGER,  "integer",  0,   true,  TC_INTPTR )
        BUILTIN( TY_UINTEGER, "uinteger", 0,   false, TC_INTPTR )
        BUILTIN( TY_LONGINT,  "longint",  64,  true,  TC_INT   )
        BUILTIN( TY_ULONGINT, "ulongint", 64,  false, TC_INT   )
        BUILTIN( TY_SINGLE,   "single",   32,  true,  TC_FLOAT )
        BUILTIN( TY_DOUBLE,   "double",   64,  true,  TC_FLOAT )
        BUILTIN( TY_BOOLEAN,  "boolean",  8,   false, TC_BOOL  )
        BUILTIN( TY_STRING,   "string",   0,   false, TC_STRING )
        BUILTIN( TY_ZSTRING,  "zstring",  8,   false, TC_ZSTRING )
        BUILTIN( TY_WSTRING,  "wstring",  0,   false, TC_WSTRING )
        BUILTIN( TY_USTRING,  "ustring",  0,   false, TC_USTRING )
        '' 'string * N' -- THE FIXED-LENGTH, SPACE-PADDED STRING, and a THIRD string
        '' flavour rather than a spelling of either of the two above it. Measured:
        ''
        ''   storage        exactly N bytes, no terminator and no room for one
        ''   initial value  N SPACES (memset value 32), where a zstring gets NULs
        ''   capacity       N usable characters, where 'zstring * N' holds N-1
        ''   runtime length passed as '&h8000000000000000 or N' -- the SIGN BIT is the
        ''                  tag that says "fixed-length", and the low bits carry N
        ''   len()          a COMPILE-TIME CONSTANT N, never a call, never content
        ''
        '' Modelled as an ARRAY of this one-byte element, exactly as zstring and wstring
        '' are, so the size and alignment fall out of the array rule. It was previously
        '' resolved to the plain 'string' builtin -- a 24-byte DESCRIPTOR where fbc has
        '' N raw bytes -- so every one was the wrong size and every access read the
        '' wrong thing.
        BUILTIN( TY_FIXSTR,   "fixstr",   8,   false, TC_ZSTRING )
        '' THE VARARG CURSOR, 'cva_list'. Opaque: no conversions, no arithmetic, and
        '' the only things that read it are the four cva_* intrinsics, each of which
        '' takes its ADDRESS. Its width comes from TargetLayout because it differs by
        '' target in a way nothing else here does.
        BUILTIN( TY_CVA_LIST, "cva_list", 0,   false, TC_CVA   )
        BUILTIN( TY_ANY,      "any",      0,   false, TC_ANY   )
        '' 'ustring * N' -- THE FIXED-LENGTH UTF-16 STRING, and its ELEMENT type, the
        '' same way 'string * N' is an array of TY_FIXSTR and 'zstring * N' an array of
        '' TY_ZSTRING.
        ''
        '' Without it 'ustring * N' was an array of N USTRING DESCRIPTORS: measured,
        '' fbc gives 'type Cell : as ustring * 4 text : end type' a sizeof of 8 and
        '' tiko-lang gave it 96. Every object holding one was twelve times too big,
        '' every field after it sat at the wrong offset, and it lowered and verified.
        ''
        '' TWO BYTES ON EVERY TARGET. A ustring is UTF-16 code units everywhere, unlike
        '' a wstring, whose unit is 2 bytes on Windows and 4 on Linux -- so its size
        '' cannot come from wcharBytes and does not follow the wstring rule.
        BUILTIN( TY_FIXUSTR,  "fixustr",  16,  false, TC_USTRING )
    #endmacro

    enum TypeClass
        TC_VOID = 0
        TC_INT
        TC_INTPTR       '' integer/uinteger: width comes from the target
        TC_FLOAT
        TC_BOOL
        TC_STRING       '' var-len FBSTRING descriptor
        TC_ZSTRING
        TC_WSTRING      '' 2 bytes/unit on Windows, 4 on Linux -- a real FB difference
        TC_USTRING      '' FBUSTRING; UTF-16 code units on EVERY target
        TC_ANY
        TC_CVA          '' cva_list: opaque, and target-sized
    end enum

    enum BuiltinType
        TY_NONE = 0
        #define BUILTIN( b_id, b_name, b_bits, b_signed, b_class ) b_id,
        TKO_BUILTIN_LIST( BUILTIN )
        #undef BUILTIN
        TY_BUILTIN_COUNT
    end enum

    enum TypeKind
        TK_ERROR = 0
        TK_BUILTIN
        TK_POINTER
        TK_REFERENCE
        TK_ARRAY
        TK_PROC
        TK_UDT
        TK_ENUM
        TK_TYPEDEF
        TK_TUPLE
        TK_FORWARD      '' named but not yet complete
    end enum

    const TF_CONST    as uint16 = &h0001
    const TF_COMPLETE as uint16 = &h0002
    '' A PROCEDURE TYPE THAT ENDS IN '...'. Part of the TYPE, not of a declaration:
    '' 'sub cdecl( byval as integer, ... )' and 'sub cdecl( byval as integer )' are
    '' two different procedure-pointer types and fbc mangles them apart -- '...zE'
    '' against nothing -- so two overloads distinguished only by the ellipsis
    '' collided on one symbol.
    const TF_VARIADIC as uint16 = &h0004
    '' A PASCAL PROCEDURE TYPE, whose arguments go in REVERSE -- on x86-64 too, measured:
    '' fbc-modern defines 'function P pascal ( a, b )' as 'i32 @P( i32 %B, i32 %A )'. A
    '' call through the pointer must know, so it is part of the type. Not of the mangled
    '' name: fbc writes a pascal and a cdecl procedure-pointer parameter identically.
    const TF_PASCAL   as uint16 = &h0008
    '' A PROCEDURE TYPE WHOSE LAST PARAMETER IS A TYPED VARIADIC -- 'args( ) as T ...'
    '' (docs/tiko-params/RFC-0001). The ABI is the array parameter's, so the flag changes
    '' nothing about the call but how its arguments are written: a call through the
    '' pointer packs them, as a direct call does.
    const TF_TYPED_VARIADIC as uint16 = &h0010
    '' A UDT DECLARED 'extern "c"' -- laid out by the target's C rule, not fbc's. See
    '' PF_C_LAYOUT and PlaceGroupC in types/udtlayout.tiko.
    const TF_C_LAYOUT as uint16 = &h0020
    '' A UDT DECLARED 'interface ... end interface' (docs/tiko-interfaces §7.1): its value is a
    '' 16-byte reference -- the object's address and an itable -- laid out from two hidden
    '' fields. IsInterface is the only question the rest of the compiler asks.
    const TF_INTERFACE as uint16 = &h0040

    type TypeInfo
        as uint8    kind
        as uint8    builtin        '' BuiltinType, when kind = TK_BUILTIN
        as uint16   flags
        as TypeId   inner          '' pointee / referent / element / return type
        as InternId name           '' UDT, enum, typedef
        '' THE SOURCE SPELLING, CASE PRESERVED, for a UDT declared inside an
        '' 'extern "C++"' block -- 0 for everything else. FreeBASIC folds a name and
        '' the mangler uppercases it, which is right for an FB type and wrong for a
        '' C++ one: measured, fbc writes 'DigitalClock( byval as FBQWidget ptr )' as
        '' '_ZN12DIGITALCLOCKC1EP9FBQWidget' -- the OWNER uppercased because it is an
        '' FB type, and the PARAMETER's type in its own case because it is not.
        as InternId rawName

        as int32     first          '' element list (tuple, proc params), into a pool
                                   '' TK_ARRAY: (lo, hi) pairs, into boundPool
        as int32     count
        as int32     dims           '' array rank; -1 for a dynamic array
        as int32     packing        '' UDT: the 'field = N' cap, 0 for none
        as int32     elems          '' TK_ARRAY: TOTAL element count across all
                                   '' dimensions, which is what a layout needs;
                                   '' 0 when the count is not known
        as uint32    declScope      '' UDT/ENUM/TYPEDEF: the scope it was declared in.
                                   '' Part of the IDENTITY -- two namespaces may each
                                   '' hold a 'Vec' -- and part of the mangled name,
                                   '' which spells a namespaced UDT as N<prefix>3VECE.
        '' TK_UDT: what this type EXTENDS, or TYPE_NONE. The fact lives in the symbol
        '' table -- 'extends T' is a field named 'base' -- and is copied here because
        '' ConversionCost is handed a TypeContext and nothing else, and cannot ask a
        '' question of the symbol table to answer "is this argument a derived type of
        '' that parameter". Filled once by Check.
        as TypeId   baseType
    end type

    '' The targets tiko-lang can compile for. X86-64 WAS THE ARCHITECTURE (D14):
    '' 32-bit Windows was removed 2026-09-04 and x86-32 Linux never existed --
    '' it is a THIRD set of layout numbers (wchar is 4 bytes there, and 8-byte
    '' alignment differs) and nobody asked for it. TARGET_WIN32 puts 32-bit
    '' Windows back (2026-11-08), the MinGW ABI under 'i686-w64-windows-gnu':
    '' msvcrt.dll ships in Windows in-box, so its programs run where no UCRT
    '' update (KB2999226) has landed. Linux and macOS have no 32-bit member and
    '' '-m32' against them stays an error.
    ''
    '' ARM64 ARRIVES AS macOS ON APPLE SILICON (docs/tiko-macos RFC-0001): a new member
    '' here, a new TargetLayout, and a THIRD AbiKind -- AAPCS64 is not a variation on
    '' either of the two that existed. See tiko-rt RFC-0007 section 9.
    enum TargetId
        TARGET_WIN64 = 0
        TARGET_LINUX_X86_64
        '' THE MICROSOFT ABI. The same machine, the same calling convention and the
        '' same type layout as TARGET_WIN64 -- what differs is the TRIPLE clang is
        '' given and the LINK LINE that follows from it. It is a separate target and
        '' not a flag on win64 because the runtime archive is a different file:
        '' lib/windows-x86_64/libfb.a, built for the UCRT, whose imports are
        '' __acrt_iob_func and _stricmp where the MinGW one has __iob_func and
        '' strcasecmp. Mixing them links and then fails at runtime.
        TARGET_WINDOWS_X86_64
        '' APPLE SILICON, Mach-O, 'arm64-apple-macosx13.0' (macOS 13 is the minimum).
        '' Its classifier is AAPCS64 with Apple's variations, its own branch in
        '' src/codegen/abi.tiko -- never SysV's.
        TARGET_MACOS_ARM64
        '' THE 32-BIT WIDTH OF THE WINDOWS FAMILY, and the MinGW ABI, like TARGET_WIN64:
        '' the triple is 'i686-w64-windows-gnu' and the runtime links msvcrt. It is what
        '' '-m32' selects on a Windows host (and '-target win64 -m32' resolves to). The
        '' ABI is its own AbiKind, ABI_WIN32 -- cdecl, every argument on the stack,
        '' 4-byte slots -- which is SIMPLER than either 64-bit ABI and bypasses the
        '' frontend eightbyte classification entirely. The layout numbers it needs were
        '' recorded when it was removed and are restored in TargetLayoutFor verbatim.
        TARGET_WIN32
    end enum

    '' Target facts, injected. The frontend never hard-codes a size.
    type TargetLayout
        as int32 pointerBits        '' 64
        as int32 wcharBytes         '' 2 on Windows, 4 on Linux
        as int32 stringBytes        '' sizeof( FBSTRING ) -- 24 on x86-64
        as int32 stringAlign
        as int32 maxAlign
        '' sizeof( cva_list ) and its alignment. MEASURED, and it is not derivable from
        '' the pointer width: fbc emits '__builtin_memset( &ARGS, 0, N )' at every
        '' 'dim as cva_list' declaration, and N is 8 on win64, 4 on win32 and 24 on
        '' Linux x86-64 -- where a va_list is the SysV register-save record, not a
        '' pointer. Getting it wrong is a stack overwrite, not a wrong number.
        as int32 cvaListBytes
        as int32 cvaListAlign
        '' WHETHER A cva_list IS ONE POINTER -- 'char *' to C -- or a record. Its MANGLING
        '' follows from it ('Pc' against 'A1_13__va_list_tag'), which is target-dependent
        '' in a way no width explains -- see BuiltinCode. Windows and Darwin/arm64 say
        '' pointer; SysV x86-64 says record.
        as boolean cvaListIsPointer
        '' Whether C's plain 'char' is signed. It is on all three targets (Apple's arm64
        '' keeps it signed where AAPCS64 itself says unsigned); recorded so that a target
        '' where it is not cannot inherit the assumption.
        as boolean charSigned
        '' THE OPERATING SYSTEM AND THE ARCHITECTURE, the two facts every other boolean
        '' here was standing in for.
        as TargetOsKind   osKind
        as TargetArchKind arch
        '' Windows or not: DERIVED from osKind (= OS_WINDOWS) by TargetLayoutFor and kept
        '' as a field because the record layout and a calling-convention rule ask it.
        as boolean isWindows
        '' THE C LIBRARY, NOT THE PLATFORM. windows-x86_64 links ucrtbase and win64 links
        '' MinGW's msvcrt, and they do not export the same setjmp: the UCRT has
        '' '__intrinsic_setjmp' and not '_setjmp', MinGW the other way round. isWindows
        '' is true for both, so LowerOnError_ needs this one to tell them apart.
        as boolean isMsvc
    end type

    type TypeVec  as containers.Array( of TypeInfo )
    type TypeIdVec2 as containers.Array( of uint32 )

    type TypeLayout
        as int32 size
        as int32 align
    end type

    '' A CHAINED HASH INDEX OVER THE TYPE TABLE, for one lookup key.
    ''
    '' Every finder in TypeContext used to scan the table from TypeId 1, so interning
    '' was quadratic in the number of types. windows.bi plus AfxNova's CWindow.inc is
    '' enough to make that the whole cost of a compile: measured 2026-09-14, resolve on
    '' tracks ran past four minutes with every sample inside TypeContext.Find.
    ''
    '' It stores HASHES, not keys. A bucket's chain holds every TypeId whose key hashed
    '' there, and the finder re-tests its own full predicate on each -- so a collision
    '' costs a comparison, never a wrong answer. CHAINS ARE IN ASCENDING TypeId ORDER,
    '' and that is the contract: the scans returned the FIRST match, a TypeId is an
    '' identity, and the index must hand back the same one.
    type TypeIndex
        as TypeIdVec2  buckets     '' bucket -> first TypeId in it, 0 = empty
        as TypeIdVec2  lasts       '' bucket -> last TypeId in it
        as TypeIdVec2  chain       '' TypeId -> next TypeId in its bucket, 0 = end
        as TypeIdVec2  hashes      '' TypeId -> its hash, kept for Rehash
        as int32        mask

        declare constructor( )
        '' 'id' must be the next TypeId: the table only ever appends.
        declare sub Add( byval id as TypeId, byval h as uint32 )
        declare function Lookup( byval h as uint32 ) as TypeId
        declare function After( byval id as TypeId ) as TypeId

        private:
        declare sub Link_( byval id as int32 )
        declare sub Rehash( byval slots as int32 )
    end type

    type TypeContext
        as TypeVec       types
        as TypeIdVec2    pool        '' element lists
        as containers.Array( of int64 ) boundPool   '' TK_ARRAY (lo, hi) pairs
        as Interner ptr  names
        as TargetLayout  target
        '' THE INTERNING INDEXES, one per finder's key -- see TypeIndex. Push_ files every
        '' entry under all five whatever its kind, so each covers exactly what the scan it
        '' replaced covered. No key field is written after a push, which is what keeps an
        '' index built at push time true.
        as TypeIndex     byShape     '' kind, inner, flags, dims        Find
        as TypeIndex     byArray     '' kind, inner, dims, elems        ArrayOf
        as TypeIndex     byBuiltin   '' kind, builtin, flags            (Un)Qualify
        as TypeIndex     byName      '' kind, name, declScope           NamedType, (Un)Qualify
        as TypeIndex     byProc      '' kind, inner, count, variadic    ProcType
        '' GENERIC INSTANTIATIONS, FOR THE MANGLER. An instantiation's NAME is a
        '' structural key -- 'BOX<3>', the numbers TypeIds -- and it was mangled as if it
        '' were a source name: '_ZN7BOX<15>3PUTE8FBSTRING' where fbc writes
        '' '_ZN3BoxI8FBSTRINGE3PUTES0_'. Only the tiko-built side could link to it, so
        '' no tiko object could be linked against an fbc-built one that used a generic.
        '' Keyed by that folded name; the declared spelling and the argument TypeIds
        '' are what the Itanium template form needs. See Mangle.RegisterInst.
        as containers.Array( of uint32 ) instName
        as containers.Array( of uint32 ) instSpell
        as containers.Array( of int32 )  instArgFirst
        as containers.Array( of int32 )  instArgCount
        as containers.Array( of uint32 ) instArgs
        '' ...AND WHERE EACH NAME IS in instName. FindInst_ scanned it on every
        '' instantiation, tuple, procedure and mangled UDT component, instantiations
        '' x those (2026-10-21). Written only by RegisterInst, which never repeats a name.
        as containers.Map( of uint32, int32 ) instAt
        '' NAME A BUILTIN THE WAY THIS PROGRAM DOES (T34): int32, float64, uint8 ... rather than
        '' long, double, ubyte. Those sized names are prelude typedefs, so a type that came from
        '' 'int32' IS 'long' here and the spelling is gone; the driver sets this per unit from
        '' which style the unit's own source writes (unit.tiko). Display only -- nothing that
        '' compares a name looks at a builtin's.
        as boolean spellSized
        '' WHAT CONVERTS TO AN INTERFACE (docs/tiko-interfaces §5.3), for ConversionCost, which
        '' is handed this context and nothing else -- the reason baseType is here too. Keyed
        '' (from, interface); the value is the inheritance distance, 0 for a type that lists it
        '' or an interface's direct base. Filled by ComputeImplementations (types/itable.tiko).
        as containers.Map( of int64, int32 ) ifaceConv
        declare sub NoteIfaceConv( byval from as TypeId, byval iface as TypeId, byval links as int32 )
        '' -1 when 'from' (a UDT or an interface) does not convert to 'iface'.
        declare function IfaceConvLinks( byval from as TypeId, byval iface as TypeId ) as int32

        declare constructor( )
        declare sub Attach( byval it as Interner ptr, byref tgt as TargetLayout )

        declare function Builtin( byval b as BuiltinType ) as TypeId
        declare function Pointer_( byval pointee as TypeId ) as TypeId
        declare function Reference( byval referent as TypeId ) as TypeId
        '' 'bounds' is rank (lo, hi) PAIRS, in declaration order. Retaining them is
        '' what makes indexing lowerable: the address of a(i,j) needs each dimension's
        '' stride and the lbound bias, and the total element count alone gives neither.
        declare function ArrayOf _
            ( byval elem as TypeId, byval rank as int32, _
              byval elems as int32 = 0, _
              byval bounds as containers.Array( of int64 ) ptr = nullptr ) as TypeId
        '' The declared bounds of one dimension. 'known' is false for an array whose
        '' bounds were not constant, in which case nothing may be folded.
        declare function ArrayBound _
            ( byval t as TypeId, byval dim_ as int32, byval hi as boolean, _
              byref known as boolean ) as int64
        declare function Qualify( byval t as TypeId, byval fl as uint16 ) as TypeId
        '' A UDT, ENUM or TYPEDEF is identified by its NAME, not structurally, so it
        '' needs its own finder: Find( ) compares inner/flags/rank and would collapse
        '' two unrelated types into one.
        declare function NamedType _
            ( byval k as TypeKind, byval nm as InternId, _
              byval declScope as uint32 = 0, byval rawNm as InternId = 0 ) as TypeId
        declare function NameOf( byval t as TypeId ) as InternId
        declare function ElemCount( byval t as TypeId ) as int32
        declare function ProcParamCount( byval t as TypeId ) as int32
        declare function ProcParam _
            ( byval t as TypeId, byval i as int32 ) as TypeId
        declare function Packing( byval t as TypeId ) as int32
        declare function DeclScopeOf( byval t as TypeId ) as uint32
        '' The type a UDT extends, and the number of 'extends' links from a derived
        '' type up to one of its bases -- 0 when they are the same type, -1 when 'to_'
        '' is not a base of 'from_' at all.
        declare function BaseOf( byval t as TypeId ) as TypeId
        declare sub SetBase( byval t as TypeId, byval b as TypeId )
        declare function BaseDistance _
            ( byval from_ as TypeId, byval to_ as TypeId ) as int32
        declare sub SetPacking( byval t as TypeId, byval n as int32 )
        '' 'type T extern "c"' -- see TF_C_LAYOUT.
        declare function IsCLayout( byval t as TypeId ) as boolean
        declare sub SetCLayout( byval t as TypeId )
        declare function IsInterface( byval t as TypeId ) as boolean
        declare sub SetInterface( byval t as TypeId )
        '' THE RESULT OF A PROCEDURE TYPE, set AFTER the fact. A procedure type whose
        '' result names a typedef declared later in the unit is built with no result at
        '' all, and everything already bound to it keeps that TypeId -- so the repair
        '' has to land on the type itself. See BackpatchTypedefs.
        declare sub SetProcResult( byval t as TypeId, byval ret as TypeId )
        '' ...AND ONE OF ITS PARAMETERS, on the same terms and for the same reason:
        '' see SetProcResult. A parameter that named a typedef declared later is the
        '' commoner half of that, because win/windef.bi writes both LPARAM and LRESULT
        '' ahead of the include that declares what they alias.
        declare sub SetProcParam _
            ( byval t as TypeId, byval idx as int32, byval pt as TypeId )
        '' Qualify( ) can only ADD flags. Removing const needs its own operation --
        '' 'Qualify( t, 0 )' silently returns t unchanged.
        declare function Unqualify( byval t as TypeId ) as TypeId
        declare function ProcType _
            ( byval ret as TypeId, byref params as TypeIdVec2, _
              byval variadic as boolean = false, byval pascal_ as boolean = false, _
              byval typedVar as boolean = false ) as TypeId

        declare function Kind( byval t as TypeId ) as TypeKind
        declare function BuiltinOf( byval t as TypeId ) as BuiltinType
        declare function DynArrayOf _
            ( byval elem as TypeId, byval rank as int32 ) as TypeId
        declare function IsDynArray( byval t as TypeId ) as boolean
        declare function DynRank( byval t as TypeId ) as int32
        declare function Inner( byval t as TypeId ) as TypeId
        declare function IsConst( byval t as TypeId ) as boolean
        '' A procedure type written with a trailing '...'.
        declare function IsVariadic( byval t as TypeId ) as boolean
        '' A procedure type written 'pascal' -- see TF_PASCAL.
        declare function IsPascal( byval t as TypeId ) as boolean
        declare function IsTypedVariadic( byval t as TypeId ) as boolean

        declare function Layout( byval t as TypeId ) as TypeLayout
        declare function Name( byval t as TypeId ) as string
        declare function Count( ) as int32

        private:
        '' Parameters are not named 'kind'/'inner': those collide with the member
        '' functions Kind( ) and Inner( ) inside a member body.
        declare function Find _
            ( byval wantKind as TypeKind, byval innerT as TypeId, byval fl as uint16, _
              byval rank as int32 ) as TypeId
        '' Appends one entry and files it under every index. The only way in after slot 0.
        declare function Push_( byref n as TypeInfo ) as TypeId
    end type

    declare function BuiltinName( byval b as BuiltinType ) as string
    declare function BuiltinClass( byval b as BuiltinType ) as TypeClass
    '' The builtin one of tiko's ten fixed-width names -- int8 .. uint64, float32, float64 --
    '' stands for, in any case; TY_NONE for any other name.
    declare function FixedWidthBuiltin( byref nm as string ) as BuiltinType
    declare function DefaultTargetLayout( ) as TargetLayout
    '' The layout of one target. Every number in it is measured from fbc for that
    '' target, not derived from the width.
    declare function TargetLayoutFor( byval t as TargetId ) as TargetLayout
    '' The target tiko-lang defaults to when none is named: the one it is running on.
    declare function HostTarget( ) as TargetId
    declare function TargetName( byval t as TargetId ) as string
    declare function TargetFromName( byval nm as string, byref ok as boolean ) as TargetId
    declare function TargetIs64( byval t as TargetId ) as boolean
    declare function TargetIsWindows( byval t as TargetId ) as boolean
    declare function TargetOs( byval t as TargetId ) as TargetOsKind
    declare function TargetArch( byval t as TargetId ) as TargetArchKind
    '' '-m32': the Windows x86 family's 32-bit member, or false for a family that has none.
    declare function TargetNarrowTo32( byval t as TargetId, byref narrowable as boolean ) as TargetId

    '' --dump-types. Byte-stable: a golden artefact, and the thing the layout
    '' differential compares against fbc.
    declare function DumpTypes( byref tc as TypeContext ) as string

end namespace

#endif
