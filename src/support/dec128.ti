'' dec128.ti -- a 128-bit integer, held as two 64-bit halves, in decimal.
''
'' tiko's int128 / uint128 (types/type.ti) have constants that FreeBASIC -- the language
'' the compiler is written in -- has no type to hold, so they travel as (hi, lo) and are
'' written out here: as an LLVM 'i128' operand, as DATA text, as the folded STR( ) of a
'' constant. 'signed_' reads hi's top bit as the sign.

#ifndef __TKO_DEC128_BI__
#define __TKO_DEC128_BI__

#include once "tko.ti"

namespace Tko.Text

    declare function Dec128( byval hi as uint64, byval lo as uint64, byval signed_ as boolean ) as string

end namespace

#endif
