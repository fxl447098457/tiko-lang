'' dec128.tiko -- see dec128.ti

#import "std/containers"
#include once "support/dec128.ti"

namespace Tko.Text

'' Four 32-bit limbs, most significant first, divided by 10^9 until zero: nine digits a
'' round, each round's remainder the next group from the right.
function Dec128( byval hi as uint64, byval lo as uint64, byval signed_ as boolean ) as string
    dim as boolean neg = signed_ andalso ((hi and &h8000000000000000ull) <> 0)
    if neg then
        lo = not lo
        hi = not hi
        lo += 1
        if lo = 0 then hi += 1
    end if
    dim as uint64 w(0 to 3)
    w(0) = hi shr 32
    w(1) = hi and &hFFFFFFFFull
    w(2) = lo shr 32
    w(3) = lo and &hFFFFFFFFull
    dim as string r
    do
        dim as uint64 rem_ = 0
        dim as boolean more = false
        for i as int32 = 0 to 3
            dim as uint64 cur = (rem_ shl 32) or w(i)
            w(i) = cur \ 1000000000ull
            rem_ = cur mod 1000000000ull
            if w(i) <> 0 then more = true
        next
        if more then
            r = right( "00000000" & str( rem_ ), 9 ) & r
        else
            r = str( rem_ ) & r
            exit do
        end if
    loop
    if neg then r = "-" & r
    return r
end function

end namespace
