'' prelude.tiko -- the declarations fbc makes that are in no header and no source.
''
'' Split out of parser.tiko when that file passed the 1500-line lint cap: the prelude is
'' TEXT, and text grows. Nothing moved with it changed.
''
'' #included rather than compiled separately, so PreludeText stays private to the parser
'' and there is no second translation unit for a string constant.

'' THE BUILTIN PRELUDE: what fbc declares that is in no header and no source.
''
'' 'object' is the type every UDT with a virtual method extends, and it is nowhere --
'' fbc predeclares it. Measured, it is exactly one pointer:
''
''     struct $10fb_Object$ { void* VPTR$; };
''     __FB_STATIC_ASSERT( sizeof( struct $10fb_Object$ ) == 8 );   // win32: 4
''
'' The rest is the runtime procedures fbc predeclares in the GLOBAL SCOPE. They are not
'' reserved words -- 'dim as long kill' is fbc error 4, DUPLICATED DEFINITION, not a
'' syntax error -- so the lexer must keep treating them as identifiers and only the
'' declaration makes them mean anything.
''
'' WRITTEN AS SOURCE AND LEXED, rather than built as AST by hand. The 'object' type was
'' built by hand first and it was already at the limit of what is readable; a procedure
'' with parameters and an ALIAS is well past it.
''
'' See docs/language/object-abi.md for the rest of the OBJECT shape.
private function PreludeText( ) as string
    dim as string t = ""
    t += "type object" & chr( 10 )
    t += "    vptr as any ptr" & chr( 10 )
    t += "end type" & chr( 10 )
    t += "" & chr( 10 )
    t += "'' The runtime procedures fbc predeclares in the global scope. EXTERN ""rtlib"" because" & chr( 10 )
    t += "'' they are FBCALL: the name a linker sees is the ALIAS, verbatim, and foreign" & chr( 10 )
    t += "'' linkage is what stops the mangler wrapping it -- 'sub F overload alias ""lower""'" & chr( 10 )
    t += "'' is _Z5loweri, which is not the symbol the runtime exports -- and the block's" & chr( 10 )
    t += "'' convention is fbc's fb.h, stdcall on 32-bit Windows and cdecl everywhere else." & chr( 10 )
    t += "'' EXTERN ""C"" HERE WAS A BUG ON WIN32: it made every predeclared call cdecl while" & chr( 10 )
    t += "'' libfb.a's exports are stdcall -- measured, '_fb_FileFree@0' -- so 'freefile' and" & chr( 10 )
    t += "'' 'environ' failed the link with an undefined '_fb_FileFree' the archive spells" & chr( 10 )
    t += "'' differently. The three RTL synthesis sites (FuncAddrOfRtl, the string family, the" & chr( 10 )
    t += "'' procptr family) already read RtlCallConv; this block is the fourth place a runtime" & chr( 10 )
    t += "'' call is born, and the only one written as source." & chr( 10 )
    t += "extern ""rtlib""" & chr( 10 )
    t += "" & chr( 10 )
    t += "'' Every omitted argument's value was MEASURED from what fbc emits, and not one of" & chr( 10 )
    t += "'' them is guessable:" & chr( 10 )
    t += "''   SLEEP with no argument is fb_Sleep( -1 ), a DIFFERENT entry point from the" & chr( 10 )
    t += "''     two-argument form -- fbc never calls fb_SleepEx with a defaulted second one." & chr( 10 )
    t += "''   LOCATE takes FIVE parameters, not three; row and col default to 0 because FB" & chr( 10 )
    t += "''     rows are 1-based, and the cursor defaults to -1, distinct from the legal 0." & chr( 10 )
    t += "''   CLS with no argument is fb_Cls( -65536 ), which is &hFFFF0000 read as signed." & chr( 10 )
    t += "''   RANDOMIZE's seed is a DOUBLE and defaults to -1.0." & chr( 10 )
    t += "''   COMMAND defaults to -1, and 0 is a legal distinct value (the program name)." & chr( 10 )
    t += "''   SHELL with no argument passes a temp descriptor over the EMPTY STRING, never a" & chr( 10 )
    t += "''     null pointer." & chr( 10 )
    t += "declare function kill alias ""fb_FileKill"" ( byref f as const string ) as long" & chr( 10 )
    t += "'' What 'assert' and 'assertwarn' call under -g -- see the macros __FB_DEBUG__ seeds." & chr( 10 )
    t += "'' A reserved spelling, because only those macros ever name them." & chr( 10 )
    t += "declare sub __tko_assert alias ""fb_Assert"" ( byval f as zstring ptr, byval ln as long, byval fn as zstring ptr, byval ex as zstring ptr )" & chr( 10 )
    t += "declare sub __tko_assertwarn alias ""fb_AssertWarn"" ( byval f as zstring ptr, byval ln as long, byval fn as zstring ptr, byval ex as zstring ptr )" & chr( 10 )
    t += "declare function mkdir alias ""fb_MkDir"" ( byref d as const string ) as long" & chr( 10 )
    t += "declare function rmdir alias ""fb_RmDir"" ( byref d as const string ) as long" & chr( 10 )
    t += "declare function chdir alias ""fb_ChDir"" ( byref d as const string ) as long" & chr( 10 )
    t += "declare function curdir alias ""fb_CurDir"" ( ) as string" & chr( 10 )
    t += "declare function shell alias ""fb_Shell"" ( byref cmd as const string = """" ) as long" & chr( 10 )
    t += "declare function exepath alias ""fb_ExePath"" ( ) as string" & chr( 10 )
    t += "declare function exec alias ""fb_Exec"" _" & chr( 10 )
    t += "    ( byref f as const string, byref args as const string ) as long" & chr( 10 )
    t += "declare function environ alias ""fb_GetEnviron"" ( byref n as const string ) as string" & chr( 10 )
    t += "declare function setenviron alias ""fb_SetEnviron"" ( byref s as const string ) as long" & chr( 10 )
    t += "declare function command alias ""fb_Command"" ( byval n as long = -1 ) as string" & chr( 10 )
    t += "declare function timer alias ""fb_Timer"" ( ) as double" & chr( 10 )
    '' DATE AND TIME were in the runtime table with NO CALLER AT ALL, so every use of
    '' either declined -- as an argument, in a DIM and in a PRINT alike, and
    '' fbcunit's own run_tests writes 'print_output( date() & " " & time() )'.
    '' Measured: 'FBSTRING* fb_Date( void )' and 'FBSTRING* fb_Time( void )', both
    '' with no parameter, which is why they belong beside CURDIR and not beside
    '' COMMAND.
    t += "declare function date alias ""fb_Date"" ( ) as string" & chr( 10 )
    t += "declare function time alias ""fb_Time"" ( ) as string" & chr( 10 )
    '' INKEY is the same shape and was missing outright: 'FBSTRING* fb_Inkey( void )',
    '' measured. Without it 's = inkey' declined, and an interactive loop is written
    '' 's = inkey: while s = "": s = inkey: wend'.
    t += "declare function inkey alias ""fb_Inkey"" ( ) as string" & chr( 10 )
    t += "'' THE REST OF THE PREDECLARED BUILTINS, each alias MEASURED from fbc's own C." & chr( 10 )
    t += "'' None of them is guessable and two are traps:" & chr( 10 )
    t += "''   RND with no argument is fb_Rnd( 1.0f ) -- the default is ONE, not 0 or -1," & chr( 10 )
    t += "''     and the parameter is SINGLE while the result is DOUBLE." & chr( 10 )
    t += "''   POS AND CSRLIN ARE THE X AND Y THE OTHER WAY ROUND: csrlin is the ROW and" & chr( 10 )
    t += "''     compiles to fb_GetY, pos is the COLUMN and compiles to fb_GetX. Getting" & chr( 10 )
    t += "''     that backwards links cleanly and returns the wrong number." & chr( 10 )
    t += "''   POS IS ALSO TWO ENTRY POINTS: bare it is fb_GetX( ), with an argument it is" & chr( 10 )
    t += "''     fb_Pos( n ) -- a different function, not a defaulted one. Declaring it with" & chr( 10 )
    t += "''     a default would send both to one symbol; it is an OVERLOAD PAIR instead." & chr( 10 )
    t += "''     CSRLIN has no argument form at all: fbc rejects 'csrlin( 0 )' outright." & chr( 10 )
    t += "''   FRE returns a POINTER-SIZED unsigned -- uint64 on win64, uint32 on win32 --" & chr( 10 )
    t += "''     so it is uinteger, not ulongint." & chr( 10 )
    t += "''   LOC and LOF return LONGINT on BOTH targets. They do NOT narrow on win32, which" & chr( 10 )
    t += "''     is the opposite of the string-length family beside them." & chr( 10 )
    t += "declare function eof alias ""fb_FileEof"" ( byval f as long ) as long" & chr( 10 )
    t += "declare function lof alias ""fb_FileSize"" ( byval f as long ) as longint" & chr( 10 )
    t += "declare function loc alias ""fb_FileLocation"" ( byval f as long ) as longint" & chr( 10 )
    t += "declare function lpos alias ""fb_LPos"" ( byval f as long ) as long" & chr( 10 )
    t += "declare function inp alias ""fb_In"" ( byval port as ushort ) as long" & chr( 10 )
    t += "declare function rnd alias ""fb_Rnd"" ( byval n as single = 1.0 ) as double" & chr( 10 )
    t += "declare function fre alias ""fb_GetMemAvail"" ( byval n as long = 0 ) as uinteger" & chr( 10 )
    t += "declare function csrlin alias ""fb_GetY"" ( ) as long" & chr( 10 )
    t += "declare function pos alias ""fb_GetX"" ( ) as long" & chr( 10 )
    t += "declare function pos overload alias ""fb_Pos"" ( byval n as long ) as long" & chr( 10 )
    t += "'' The three zero-argument runtime QUERIES. Measured, and all three return a" & chr( 10 )
    t += "'' 32-bit LONG on both targets, not the pointer-sized 'integer' a count would use." & chr( 10 )
    t += "declare function freefile alias ""fb_FileFree"" ( ) as long" & chr( 10 )
    t += "declare function err alias ""fb_ErrorGetNum"" ( ) as long" & chr( 10 )
    t += "declare function erl alias ""fb_ErrorGetLineNum"" ( ) as long" & chr( 10 )
    t += "'' ERFN AND ERMN return the name as a ZSTRING PTR -- '*erfn( )' is how a program" & chr( 10 )
    t += "'' reads it, and an undeclared call has no pointee to dereference. Measured." & chr( 10 )
    t += "declare function erfn alias ""fb_ErrorGetFuncName"" ( ) as zstring ptr" & chr( 10 )
    t += "declare function ermn alias ""fb_ErrorGetModName"" ( ) as zstring ptr" & chr( 10 )
    t += "'' THE ASSERTION HELPER, which the corpus calls DIRECTLY as well as through the ASSERT" & chr( 10 )
    t += "'' macro: '#define assert_(e) if (e) = 0 then fb_Assert( __FILE__, __LINE__," & chr( 10 )
    t += "'' __FUNCTION__, #e )' is how three of the generics files write every check they make." & chr( 10 )
    t += "'' Its line number is int64 on BOTH targets, measured -- not the pointer-sized" & chr( 10 )
    t += "'' 'integer' the rest of the runtime uses for a count." & chr( 10 )
    t += "declare sub fb_assert alias ""fb_Assert"" _" & chr( 10 )
    t += "    ( byval fil as zstring ptr, byval lin as longint, _" & chr( 10 )
    t += "      byval fun as zstring ptr, byval msg as zstring ptr )" & chr( 10 )
    t += "declare sub beep alias ""fb_Beep"" ( )" & chr( 10 )
    t += "declare sub cls alias ""fb_Cls"" ( byval mode as long = -65536 )" & chr( 10 )
    t += "declare sub randomize alias ""fb_Randomize"" _" & chr( 10 )
    t += "    ( byval seed as double = -1.0, byval algorithm as long = 0 )" & chr( 10 )
    t += "declare function locate alias ""fb_Locate"" _" & chr( 10 )
    t += "    ( byval row as long = 0, byval col as long = 0, byval cursor as long = -1, _" & chr( 10 )
    t += "      byval a4 as long = 0, byval a5 as long = 0 ) as long" & chr( 10 )
    t += "'' SLEEP HAS TWO ENTRY POINTS, and only one of them was declared. The two-argument" & chr( 10 )
    t += "'' form is fb_SleepEx and it RETURNS int32; the one-argument form is fb_Sleep and" & chr( 10 )
    t += "'' returns nothing. Measured -- 'sleep 100, 1' emits 'fb_SleepEx( 100, 1 )' and" & chr( 10 )
    t += "'' 'sleep 100' emits 'fb_Sleep( 100 )'. With only the one-argument declaration," & chr( 10 )
    t += "'' 'sleep n, flag' passed TWO arguments to a ONE-parameter function and nothing" & chr( 10 )
    t += "'' said so: 14 corpus files, and the largest single family the verifier's call" & chr( 10 )
    t += "'' arity rule found." & chr( 10 )
    t += "declare sub sleep overload alias ""fb_Sleep"" ( byval ms as long = -1 )" & chr( 10 )
    t += "declare function sleep overload alias ""fb_SleepEx"" _" & chr( 10 )
    t += "    ( byval ms as long, byval k as long ) as long" & chr( 10 )
    t += "declare function threadcreate alias ""fb_ThreadCreate"" _" & chr( 10 )
    t += "    ( byval proc_ as any ptr, byval param as any ptr = 0, _" & chr( 10 )
    t += "      byval stacksize as integer = 0 ) as any ptr" & chr( 10 )
    t += "declare sub threadwait alias ""fb_ThreadWait"" ( byval h as any ptr )" & chr( 10 )
    t += "declare function mutexcreate alias ""fb_MutexCreate"" ( ) as any ptr" & chr( 10 )
    t += "declare sub mutexdestroy alias ""fb_MutexDestroy"" ( byval m as any ptr )" & chr( 10 )
    t += "declare sub mutexlock alias ""fb_MutexLock"" ( byval m as any ptr )" & chr( 10 )
    t += "declare sub mutexunlock alias ""fb_MutexUnlock"" ( byval m as any ptr )" & chr( 10 )
    t += "declare function condcreate alias ""fb_CondCreate"" ( ) as any ptr" & chr( 10 )
    t += "declare sub conddestroy alias ""fb_CondDestroy"" ( byval m as any ptr )" & chr( 10 )
    t += "declare sub condsignal alias ""fb_CondSignal"" ( byval m as any ptr )" & chr( 10 )
    t += "declare sub condbroadcast alias ""fb_CondBroadcast"" ( byval m as any ptr )" & chr( 10 )
    t += "declare sub condwait alias ""fb_CondWait"" ( byval m as any ptr, byval x as any ptr )" & chr( 10 )
    t += "" & chr( 10 )
    t += "" & chr( 10 )
    t += "'' THE GRAPHICS ENTRY POINTS THAT ARE ORDINARY CALLS. The statements with their own" & chr( 10 )
    t += "'' coordinate syntax -- LINE, PSET, CIRCLE, PAINT, GET, PUT -- are not here; these are" & chr( 10 )
    t += "'' the ones that are a name and a plain argument list, so a declaration is all they" & chr( 10 )
    t += "'' need. Measured defaults, and see docs/language/graphics-abi.md for the rest." & chr( 10 )
    t += "''" & chr( 10 )
    t += "'' SCREEN, IMAGECREATE and POINT are KEYWORDS in this lexer and cannot be declared;" & chr( 10 )
    t += "'' they keep their intrinsic path." & chr( 10 )
    t += "declare function screenres alias ""fb_GfxScreenRes"" _" & chr( 10 )
    t += "    ( byval w as long, byval h as long, byval depth as long = 8, _" & chr( 10 )
    t += "      byval pages as long = 1, byval flags as long = 0, _" & chr( 10 )
    t += "      byval refresh as long = 0 ) as long" & chr( 10 )
    t += "declare function screenset alias ""fb_GfxPageSet"" _" & chr( 10 )
    t += "    ( byval work as long = -1, byval visible as long = -1 ) as long" & chr( 10 )
    t += "'' SCREENCOPY and FLIP are the same runtime call. Measured." & chr( 10 )
    t += "declare function screencopy alias ""fb_GfxFlip"" _" & chr( 10 )
    t += "    ( byval src as long = -1, byval dst as long = -1 ) as long" & chr( 10 )
    t += "declare function flip alias ""fb_GfxFlip"" _" & chr( 10 )
    t += "    ( byval src as long = -1, byval dst as long = -1 ) as long" & chr( 10 )
    t += "declare sub screenlock alias ""fb_GfxLock"" ( )" & chr( 10 )
    t += "declare sub screenunlock alias ""fb_GfxUnlock"" _" & chr( 10 )
    t += "    ( byval start as long = -1, byval finish as long = -1 )" & chr( 10 )
    t += "declare function screensync alias ""fb_GfxWaitVSync"" ( ) as long" & chr( 10 )
    t += "declare function screenptr alias ""fb_GfxScreenPtr"" ( ) as any ptr" & chr( 10 )
    '' SCREENEVENT'S ARGUMENT IS OPTIONAL, and fbc's rtl-gfx entry says so -- default
    '' 0. Without it the argument-less form, which PEEKS without consuming, did not
    '' compile (TKO0776).
    t += "declare function screenevent alias ""fb_GfxEvent"" ( byval e as any ptr = 0 ) as long" & chr( 10 )
    t += "declare function screenglproc alias ""fb_GfxGetGLProcAddress"" _" & chr( 10 )
    t += "    ( byval nm as zstring ptr ) as any ptr" & chr( 10 )
    t += "declare sub windowtitle alias ""fb_GfxSetWindowTitle"" ( byref t as const string )" & chr( 10 )
    '' THE IMAGE THESE READ IS A CONST POINTER, which is how fbc declares them and is
    '' why 'dim a as const FB.IMAGE ptr' can be passed to either. Measured: fbc accepts
    '' a 'const any ptr' argument to imagedestroy, imageinfo and PUT's source image,
    '' and refuses one as the target of LINE or GET (error 119, they write it).
    '' Declaring them non-const here made gfx/image-expr.bas a false rejection as soon
    '' as the const-pointer rule could tell the two spellings apart.
    t += "declare sub imagedestroy alias ""fb_GfxImageDestroy"" ( byval img as const any ptr )" & chr( 10 )
    t += "declare sub imageconvertrow alias ""fb_GfxImageConvertRow"" _" & chr( 10 )
    t += "    ( byval src as any ptr, byval srcbpp as long, byval dst as any ptr, _" & chr( 10 )
    t += "      byval dstbpp as long, byval w as long, byval isrgba as long = 1 )" & chr( 10 )
    t += "declare function multikey alias ""fb_Multikey"" ( byval sc as long ) as long" & chr( 10 )
    t += "'' SETMOUSE's sentinels are INCONSISTENT, and that is measured: an omitted y is" & chr( 10 )
    t += "'' &h80000000 while an omitted cursor or clip is -1." & chr( 10 )
    t += "declare function setmouse alias ""fb_SetMouse"" _" & chr( 10 )
    t += "    ( byval x as long = &h80000000, byval y as long = &h80000000, _" & chr( 10 )
    t += "      byval cursor as long = -1, byval clip as long = -1 ) as long" & chr( 10 )
    t += "" & chr( 10 )
    t += "'' THE BYREF OUTPUTS. An omitted output is not a special case in the runtime and not" & chr( 10 )
    t += "'' one here: it is a BYREF PARAMETER WITH A DEFAULT, and fbc materialises a temporary" & chr( 10 )
    t += "'' holding that default and passes its address. Measured -- 'screeninfo a' emits" & chr( 10 )
    t += "'' 'TMP = 0' five times and passes five addresses -- and the same shape appears for a" & chr( 10 )
    t += "'' written rvalue, 'screencontrol 100, 5'. So each family's sentinel is nothing more" & chr( 10 )
    t += "'' exotic than the value it declares, which is why they differ: SCREENINFO's outputs" & chr( 10 )
    t += "'' start at 0 and SCREENCONTROL's at &h80000000." & chr( 10 )
    t += "''" & chr( 10 )
    t += "'' GETJOYSTICK's buttons parameter is FreeBASIC 'integer' -- 64-bit on win64, 32 on" & chr( 10 )
    t += "'' win32 -- and fbc REJECTS a 'long' there with error 58 rather than converting, which" & chr( 10 )
    t += "'' is what a byref parameter has to do." & chr( 10 )
    t += "''" & chr( 10 )
    t += "'' fbc passes SCREENINFO's driver string as a temp DESCRIPTOR over the empty string" & chr( 10 )
    t += "'' where tiko-lang builds a real temporary; neither is read after the call." & chr( 10 )
    t += "'' THREE OF THEM ARE OVERLOADED ON THE WIDTH OF THEIR OUTPUTS, and that is measured:" & chr( 10 )
    t += "'' 'screeninfo w, h' over LONGs is fb_GfxScreenInfo32 and over INTEGERs is" & chr( 10 )
    t += "'' fb_GfxScreenInfo64, a different entry point taking int64*. Declaring only the 32-bit" & chr( 10 )
    t += "'' half is not a partial answer -- it passes an int64* where an int32* belongs, and the" & chr( 10 )
    t += "'' callee then writes four bytes into an eight-byte slot and leaves the rest as it was." & chr( 10 )
    t += "''" & chr( 10 )
    t += "'' IMAGEINFO IS overloaded the same way, and the note here used to say it was" & chr( 10 )
    t += "'' not -- that an 'integer' output was fbc's error 58. Re-measured: both spellings" & chr( 10 )
    t += "'' compile clean, 'long' outputs give fb_GfxImageInfo32 and 'integer' outputs" & chr( 10 )
    t += "'' fb_GfxImageInfo64( void*, int64*, int64*, int64*, int64*, void**, int64* )." & chr( 10 )
    t += "'' With only the 32-bit half declared, the integer form DECLINED." & chr( 10 )
    t += "declare sub screeninfo overload alias ""fb_GfxScreenInfo32"" _" & chr( 10 )
    t += "    ( byref w as long = 0, byref h as long = 0, byref depth as long = 0, _" & chr( 10 )
    t += "      byref bpp as long = 0, byref pitch as long = 0, byref rate as long = 0, _" & chr( 10 )
    t += "      byref driver as string = """" )" & chr( 10 )
    t += "'' THE 64-BIT HALVES TAKE LONGINT AND REQUIRE WIDTH AND HEIGHT, as fbc declares them --" & chr( 10 )
    t += "'' measured on fbc-modern 1.20, 2026-09-30: 'screeninfo w, h' over LONGINTs or INTEGERs is" & chr( 10 )
    t += "'' fb_GfxScreenInfo64, 'screeninfo w' over an INTEGER is error 58, and a bare 'screeninfo' or" & chr( 10 )
    t += "'' 'imageinfo img' is the 32-bit one (gfx/screeninfo-params, gfx/imageinfo-params). With" & chr( 10 )
    t += "'' every output defaulted the bare call matched both, and 'integer' refused a LONGINT." & chr( 10 )
    t += "declare sub screeninfo overload alias ""fb_GfxScreenInfo64"" _" & chr( 10 )
    t += "    ( byref w as longint, byref h as longint, byref depth as longint = 0, _" & chr( 10 )
    t += "      byref bpp as longint = 0, byref pitch as longint = 0, _" & chr( 10 )
    t += "      byref rate as longint = 0, byref driver as string = """" )" & chr( 10 )
    t += "declare function getmouse overload alias ""fb_GetMouse"" _" & chr( 10 )
    t += "    ( byref x as long = 0, byref y as long = 0, byref wheel as long = 0, _" & chr( 10 )
    t += "      byref buttons as long = 0, byref clip as long = 0 ) as long" & chr( 10 )
    t += "declare function getmouse overload alias ""fb_GetMouse64"" _" & chr( 10 )
    t += "    ( byref x as integer = 0, byref y as integer = 0, byref wheel as integer = 0, _" & chr( 10 )
    t += "      byref buttons as integer = 0, byref clip as integer = 0 ) as long" & chr( 10 )
    t += "'' SCREENCONTROL takes a STRING as well, and its omitted outputs start at &h80000000" & chr( 10 )
    t += "'' where SCREENINFO's start at 0 -- the sentinel is nothing but the default each" & chr( 10 )
    t += "'' declaration carries." & chr( 10 )
    t += "declare sub screencontrol overload alias ""fb_GfxControl_i32"" _" & chr( 10 )
    t += "    ( byval item as long, byref a as long = &h80000000, _" & chr( 10 )
    t += "      byref b as long = &h80000000, byref c as long = &h80000000, _" & chr( 10 )
    t += "      byref d as long = &h80000000 )" & chr( 10 )
    t += "declare sub screencontrol overload alias ""fb_GfxControl_i64"" _" & chr( 10 )
    t += "    ( byval item as long, byref a as integer = &h80000000, _" & chr( 10 )
    t += "      byref b as integer = &h80000000, byref c as integer = &h80000000, _" & chr( 10 )
    t += "      byref d as integer = &h80000000 )" & chr( 10 )
    t += "declare sub screencontrol overload alias ""fb_GfxControl_s"" _" & chr( 10 )
    t += "    ( byval item as long, byref s as string )" & chr( 10 )
    t += "declare function imageinfo overload alias ""fb_GfxImageInfo32"" _" & chr( 10 )
    t += "    ( byval img as const any ptr, byref w as long = 0, byref h as long = 0, _" & chr( 10 )
    t += "      byref bpp as long = 0, byref pitch as long = 0, _" & chr( 10 )
    t += "      byref pixdata as any ptr = 0, byref a7 as long = 0 ) as long" & chr( 10 )
    t += "declare function imageinfo overload alias ""fb_GfxImageInfo64"" _" & chr( 10 )
    t += "    ( byval img as const any ptr, byref w as longint, byref h as longint, _" & chr( 10 )
    t += "      byref bpp as longint = 0, byref pitch as longint = 0, _" & chr( 10 )
    t += "      byref pixdata as any ptr = 0, byref a7 as longint = 0 ) as long" & chr( 10 )
    t += "declare function getjoystick alias ""fb_GfxGetJoystick"" _" & chr( 10 )
    t += "    ( byval id as long = 0, byref buttons as integer = 0, _" & chr( 10 )
    t += "      byref a1 as single = 0, byref a2 as single = 0, byref a3 as single = 0, _" & chr( 10 )
    t += "      byref a4 as single = 0, byref a5 as single = 0, byref a6 as single = 0, _" & chr( 10 )
    t += "      byref a7 as single = 0, byref a8 as single = 0 ) as long" & chr( 10 )
    t += "" & chr( 10 )
    t += "end extern" & chr( 10 )
    t += "" & chr( 10 )
    t += "'' THE FIXED-WIDTH TYPE NAMES, tiko's own: fbc has none of them. Typedefs rather" & chr( 10 )
    t += "'' than keywords, and typedefs in the prelude, because existing code already owns" & chr( 10 )
    t += "'' these names -- win/basetsd.bi writes 'type INT32 as long', jpeglib.bi 'type INT32" & chr( 10 )
    t += "'' as clong', and any program may have a variable called int32 -- and a prelude" & chr( 10 )
    t += "'' declaration LOSES to the program's (collectdecl.tiko, Declare_). Only these ten:" & chr( 10 )
    t += "'' INTEGER and UINTEGER change size with the target and have no fixed-width name." & chr( 10 )
    t += "type int8 as byte" & chr( 10 )
    t += "type uint8 as ubyte" & chr( 10 )
    t += "type int16 as short" & chr( 10 )
    t += "type uint16 as ushort" & chr( 10 )
    t += "type int32 as long" & chr( 10 )
    t += "type uint32 as ulong" & chr( 10 )
    t += "type int64 as longint" & chr( 10 )
    t += "type uint64 as ulongint" & chr( 10 )
    t += "type float32 as single" & chr( 10 )
    t += "type float64 as double" & chr( 10 )
    t += "" & chr( 10 )
    t += "'' NULLPTR, tiko's own: a null pointer that is a POINTER, so an overload, 'var' and a" & chr( 10 )
    t += "'' generic see one -- '0' is an integer to all three (docs/tiko-nullptr RFC). A" & chr( 10 )
    t += "'' constant rather than a keyword for the reason the typedefs above are: fbc's own" & chr( 10 )
    t += "'' virtual/fbrtti.bi has a field called nullptr, and whatever a program declares" & chr( 10 )
    t += "'' by that name -- module-level, local, parameter or field -- replaces this one." & chr( 10 )
    t += "const nullptr as any ptr = 0" & chr( 10 )
    t += "" & chr( 10 )
    t += "'' THE STRING SLICES, tiko's own (docs/tiko-slices RFC-0001): a borrowed view of" & chr( 10 )
    t += "'' code units, made by 's[lo to hi]'. Three words -- data, length in units, and the" & chr( 10 )
    t += "'' source descriptor or null (RFC-0002 §7) -- the same with and without -exx. Real" & chr( 10 )
    t += "'' TYPEs, so passing, returning and copying one is the ordinary aggregate path. The" & chr( 10 )
    t += "'' compiler finds them by the reserved '__tko_' names (symbols/checkslice.tiko); the" & chr( 10 )
    t += "'' public names are typedefs, and like the sized names above a program's own" & chr( 10 )
    t += "'' declaration of one replaces only the typedef." & chr( 10 )
    t += "type __tko_strslice" & chr( 10 )
    t += "    __data as ubyte ptr" & chr( 10 )
    t += "    __len as integer" & chr( 10 )
    t += "    __anchor as any ptr" & chr( 10 )
    t += "    declare operator cast( ) as string" & chr( 10 )
    t += "end type" & chr( 10 )
    t += "type __tko_ustrslice" & chr( 10 )
    t += "    __data as ushort ptr" & chr( 10 )
    t += "    __len as integer" & chr( 10 )
    t += "    __anchor as any ptr" & chr( 10 )
    t += "    declare operator cast( ) as ustring" & chr( 10 )
    t += "end type" & chr( 10 )
    t += "type __tko_wstrslice" & chr( 10 )
    t += "    __data as wstring ptr" & chr( 10 )
    t += "    __len as integer" & chr( 10 )
    t += "    __anchor as any ptr" & chr( 10 )
    t += "    declare operator cast( ) byref as const wstring" & chr( 10 )
    t += "end type" & chr( 10 )
    t += "type slice as __tko_strslice" & chr( 10 )
    t += "type uslice as __tko_ustrslice" & chr( 10 )
    t += "type wslice as __tko_wstrslice" & chr( 10 )
    return t
end function

'' The procedures the prelude declares, as "|name|name|...|". A predeclared procedure
'' written 'sleep :' is a CALL and not a label -- fbc's rule, see parserend.tiko's
'' IsLabelHere_ -- and the prelude is parsed AFTER the unit's own statements (Unit
'' keeps the unit's node numbers stable that way), so a label is decided long before
'' these declarations are. Read out of the text instead. Lowercase, as the interner is.
function PreludeProcSpellings( ) as string
    dim as string t = lcase( PreludeText( ) )
    dim as string out_ = "|"
    dim as int32 i = 1
    do
        dim as int32 a = instr( i, t, "declare " )
        if a = 0 then exit do
        i = a + 8
        dim as int32 w = instr( i, t, " " )
        if w = 0 then exit do
        dim as string kw = mid( t, i, w - i )
        if (kw = "sub") orelse (kw = "function") then
            dim as int32 k = w + 1
            dim as int32 e = k
            while e <= len( t )
                dim as uint8 ch = t[e - 1]
                dim as boolean alnum = ((ch >= 97) andalso (ch <= 122)) orelse _
                                       ((ch >= 48) andalso (ch <= 57)) orelse (ch = 95)
                if alnum = false then exit while
                e += 1
            wend
            dim as string nm = mid( t, k, e - k )
            if (len( nm ) > 0) andalso (instr( out_, "|" & nm & "|" ) = 0) then
                out_ &= nm & "|"
            end if
        end if
    loop
    return out_
end function

