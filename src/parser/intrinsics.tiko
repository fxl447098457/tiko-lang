'' intrinsics.tiko -- the intrinsic statement grammars.  Included by parser.tiko.
''
'' Dispatch is on the registry, so adding an intrinsic is a table row plus, sometimes,
'' a function (docs/plan/04 section 5).
''
'' Every parser here obeys the same two rules as the rest of the parser: it consumes
'' at least one token per iteration, and it never runs past the end of the line.

namespace Tko

dim shared as uint8   intrForm( 0 to TK_KIND_COUNT - 1 )
dim shared as boolean intrReady = false

sub InitIntrinsicTable( )
    if intrReady then return
    for i as int32 = 0 to TK_KIND_COUNT - 1
        intrForm(i) = cast( uint8, IFORM_NONE )
    next
    #macro INTR( i_kind, i_form )
        intrForm(i_kind) = cast( uint8, i_form )
    #endmacro
    TKO_INTRINSIC_LIST( INTR )
    #undef INTR
    intrReady = true
end sub

function IntrinsicFormOf( byval k as TokenKind ) as IntrinsicForm
    InitIntrinsicTable( )
    dim as boolean bad = (k < 0) orelse (k >= TK_KIND_COUNT)
    if bad then return IFORM_NONE
    return cast( IntrinsicForm, intrForm(k) )
end function

'' Only these forms may BEGIN a statement. Expression functions and context modifiers
'' must not, or 'x = len(s)' would parse as a LEN statement.
function IsStatementIntrinsic( byval k as TokenKind ) as boolean
    select case IntrinsicFormOf( k )
    case IFORM_GENERIC, IFORM_NOARGS, IFORM_PRINT, IFORM_INPUT, IFORM_LINE, _
         IFORM_OPEN, IFORM_FILENUM, IFORM_GETPUT, IFORM_DATA, IFORM_ON, _
         IFORM_SWAP, IFORM_NAME, IFORM_GFX, IFORM_UNSUPPORTED
        return true
    end select
    return false
end function

end namespace

namespace Tko.Parse

'' Comma-separated expressions to end of line. The workhorse: two thirds of the
'' registry needs nothing more.
private sub IntrArgList( byref p as Tko.ParserState, byref items as Tko.NodeIdVec )
    do
        if (Peek( p ) = Tko.TK_EOL) orelse AtEnd( p ) then exit do
        dim as int32 before = p.pos
        '' 'locate ,,0' -- an intrinsic's arguments may be elided too.
        dim as Tko.NodeId arg = ArgOrElided( p, Tko.TK_EOL )
        items.Push( cast( uint32, arg ) )
        '' The no-progress guard exists to stop a loop that cannot consume anything.
        '' An ELIDED argument consumes nothing BY DEFINITION, so it has to be exempt --
        '' the comma after it is what advances, and without this 'locate ,,0' bailed
        '' out on its first argument.
        if (p.ast->Kind( arg ) <> Tko.N_ELIDED) andalso (p.pos = before) then exit do
        if Accept( p, Tko.TK_COMMA ) = false then exit do
    loop
end sub

'' '#n' or '#n,' -- a file number, which several forms accept as a leading argument.
private function IntrFileNum( byref p as Tko.ParserState ) as Tko.NodeId
    if Peek( p ) <> Tko.TK_HASH then return Tko.NODE_NONE
    Advance( p )
    return Expression( p, Tko.PREC_POSTFIX )
end function

'' PRINT / LPRINT / WRITE.
''   [#n,] [USING fmt;] expr [ ; | , ] expr ...
'' The separators are semantically meaningful -- ';' suppresses the column advance --
'' so they are recorded as N_PRINT_SEP children rather than skipped.
private sub IntrPrint( byref p as Tko.ParserState, byref sp as Tko.StmtPayload )
    '' WRITE TAKES NEITHER ';' NOR 'using', where PRINT takes both. Measured against
    '' fbc: 'write s, t' and even a trailing 'write s,' compile, while 'write s;',
    '' 'write s; t', 'write #1, s;', 'write ;' and 'write using "&"; s' are all its
    '' error 3 (and 'write #1; s' its error 16). tiko read the WRITE list with PRINT's
    '' grammar and accepted every one of them: the ';' forms wrote a stray separator
    '' and 'write using' was marked as a USING statement, which lowering then declined
    '' -- so the whole statement vanished with nothing said.
    dim as boolean isWrite = (cast( Tko.TokenKind, sp.op ) = Tko.KW_WRITE)
    sp.a = IntrFileNum( p )
    if sp.a <> Tko.NODE_NONE then
        '' A ';' after the file number is left for the loop below to report.
        if Accept( p, Tko.TK_COMMA ) = false then
            if isWrite = false then Accept( p, Tko.TK_SEMICOLON )
        end if
    end if

    '' A 'using' FORMAT IS FOLLOWED BY ';', AND THE ITEMS IT FORMATS ARE SEPARATED BY ';'
    '' ONLY -- measured, 'print using "#", 1', 'print using "#"', 'print using "#"; 1, 2'
    '' and 'print "a", using "#"; 1, 2' are all fbc's error 47, expected ';'. tiko took
    '' a ',' in either place (audit F-71).
    dim as boolean afterUsing = false
    if (Peek( p ) = Tko.KW_USING) andalso (isWrite = false) then
        Advance( p )
        sp.c = Expression( p )
        Expect( p, Tko.TK_SEMICOLON, ";" )
        afterUsing = true
        sp.extra = 1                      '' marks the USING form for lowering
    end if

    '' Separators are INTERLEAVED with the items as N_PRINT_SEP markers, because what
    '' follows an item decides how it prints: fbc passes 0 for ';', 2 for ',' and 1 for
    '' end-of-statement as the third argument to every fb_Print* call. Dropping them
    '' would make 'print a; b', 'print a, b' and 'print a;' indistinguishable, and all
    '' three produce different output.
    dim as Tko.NodeIdVec items
    do
        if (Peek( p ) = Tko.TK_EOL) orelse AtEnd( p ) then exit do
        '' 'if c then print i end if' -- the item list must stop at what closes the
        '' enclosing single-line statement, or it eats it.
        if EndsSingleLineStmt( p ) then exit do
        dim as Tko.TokenKind k = Peek( p )
        '' Neither of WRITE's two refusals -- see the head of this procedure. One
        '' diagnostic and then the rest of the line, which is what ErrorNode's own
        '' 'silent' flag is for.
        if isWrite andalso cbool( (k = Tko.TK_SEMICOLON) orelse (k = Tko.KW_USING) ) then
            ErrorNode( p, Tko.TKO0420 )
            exit do
        end if
        if (k = Tko.TK_COMMA) andalso afterUsing then
            ErrorNode( p, Tko.TKO0401, ";" )
            exit do
        end if
        if (k = Tko.TK_SEMICOLON) orelse (k = Tko.TK_COMMA) then
            dim as Tko.Token t = Cur( p )
            Advance( p )
            dim as Tko.StmtPayload ssp
            ssp.op = cast( uint16, k )
            items.Push( cast( uint32, MakeStmt( p, Tko.N_PRINT_SEP, t.loc, ssp ) ) )
            continue do
        end if
        '' 'using' CAN APPEAR AFTER THE LIST HAS STARTED: 'print "ghi"; ", "; using
        '' "&"; "jkl"' prints the first two items normally and the rest through the
        '' format. Only the LEADING form was read -- the one right after the file
        '' number -- so a later 'using' was parsed as an expression naming something
        '' called 'using', and the statement declined. Both print_using corpus files
        '' write it.
        ''
        '' Recorded IN PLACE, as a separator-shaped marker carrying the format, because
        '' the POSITION is the whole meaning: what precedes it prints plainly and what
        '' follows it prints through the format.
        if k = Tko.KW_USING then
            dim as Tko.Token ut = Cur( p )
            Advance( p )
            dim as Tko.StmtPayload usp
            usp.op = cast( uint16, Tko.KW_USING )
            usp.a = Expression( p )
            items.Push( cast( uint32, MakeStmt( p, Tko.N_PRINT_SEP, ut.loc, usp ) ) )
            Expect( p, Tko.TK_SEMICOLON, ";" )
            afterUsing = true
            continue do
        end if
        dim as int32 before = p.pos
        items.Push( cast( uint32, Expression( p ) ) )
        if p.pos = before then exit do
        '' AN ITEM ENDS AT A SEPARATOR OR THE END OF THE LIST. Measured: 'print 1 2',
        '' 'print a b', 'print 1; 2 3; 4' and 'print "a" using "&"' are all fbc's error
        '' 3, while 'print "x" "y"' is one item -- adjacent literals concatenate in the
        '' expression. Reading the next item anyway accepted all four without a word.
        if (Peek( p ) <> Tko.TK_SEMICOLON) andalso (Peek( p ) <> Tko.TK_COMMA) then exit do
    loop

    sp.first = p.ast->ChildPoolCount( )
    sp.count = items.Count
    for i as int32 = 0 to items.Count - 1
        p.ast->PushChild( items[i] )
    next
end sub

'' INPUT / WINPUT / LINE INPUT.
''   [#n,] [;] [prompt ( ; | , )] var [, var]
'' The prompt is a string literal followed by ';' or ',', which is the only thing that
'' distinguishes it from the first variable.
private sub IntrInput( byref p as Tko.ParserState, byref sp as Tko.StmtPayload )
    '' fbc reads the leading ';' BEFORE the '#': 'input ;#1, a' compiles, and so does a ';'
    '' after the file number, 'input #1; a' (parser-quirk-file.bas, cInputStmt; measured).
    if Accept( p, Tko.TK_SEMICOLON ) then sp.extra or= 4
    sp.a = IntrFileNum( p )
    if sp.a <> Tko.NODE_NONE then
        if Accept( p, Tko.TK_COMMA ) = false then Accept( p, Tko.TK_SEMICOLON )
    end if

    '' A LEADING ';' -- 'input ; a' -- suppresses the newline the runtime would echo
    '' after the user presses return. It comes before the prompt, so it cannot be folded
    '' into the prompt handling below, and without it the ';' is read as the start of an
    '' expression and the whole statement fails to parse.
    ''
    '' Worth the note: this one missing token produced 9,568 of the corpus's 11,719
    '' error nodes, because four machine-generated syntax tests exercise every INPUT
    '' variation about 1,200 times each.
    '' BIT 4, not 1. LINE INPUT arrives here with 'extra' already set to 1 to say so,
    '' and overwriting it made a LINE INPUT and a semicolon-suppressed INPUT
    '' indistinguishable -- the flags are a SET, and each needs its own bit. Read above, before the '#'.

    '' LINE INPUT'S PROMPT IS ANY STRING EXPRESSION; INPUT's is a literal. LINE INPUT
    '' has one destination, so whatever is followed by ';' or ',' before it is the
    '' prompt -- measured, fbc passes 'line input p; s' and 'line input p & "!"; s' to
    '' fb_LineInput as the prompt, and rejects 'input p; s' (error 3). Taking only a
    '' literal here left 'line input p; s' as TKO0420.
    ''
    '' THE SEPARATOR IS RECORDED, bit 8 for a COMMA: it decides the "? " and was being
    '' dropped. fbc: 'input "x", a' and 'line input "x", s' add no question mark, and
    '' 'input "x"; a' and 'line input "x"; s' do.
    dim as boolean isLine = ((sp.extra and 1) <> 0) andalso (sp.a = Tko.NODE_NONE)
    '' AN EMPTY LINE INPUT PROMPT -- 'line input , s', 'line input ;; s': the separator alone.
    '' fbc passes "" with the same flags as a prompt's: ',' no "? ", ';' a "? " -- bit 16, as
    '' there is no prompt node to say so (syntax/line-input.bas).
    dim as boolean bareSep = cbool( (Peek( p ) = Tko.TK_COMMA) orelse (Peek( p ) = Tko.TK_SEMICOLON) )
    bareSep = bareSep andalso isLine
    if bareSep then
        sp.extra or= iif( Peek( p ) = Tko.TK_COMMA, 8, 16 )
        Advance( p )
    elseif (Peek( p ) = Tko.TK_STRING_LIT) orelse isLine then
        dim as int32 save = p.pos
        dim as Tko.NodeId prompt = Expression( p, iif( isLine, Tko.PREC_ANDALSO, Tko.PREC_POSTFIX ) )
        dim as boolean isPrompt = (Peek( p ) = Tko.TK_SEMICOLON) orelse _
                                  (Peek( p ) = Tko.TK_COMMA)
        if isPrompt then
            sp.c = prompt
            if Peek( p ) = Tko.TK_COMMA then sp.extra or= 8
            Advance( p )
        else
            p.pos = save
        end if
    end if

    dim as Tko.NodeIdVec items
    IntrArgList( p, items )
    sp.first = p.ast->ChildPoolCount( )
    sp.count = items.Count
    for i as int32 = 0 to items.Count - 1
        p.ast->PushChild( items[i] )
    next
end sub

'' OPEN f FOR mode [ACCESS a] [LOCK l] AS [#]n [LEN = x]
'' The modifiers are context keywords, which is why they are in the registry as
'' IFORM_CONTEXT: they are only meaningful here.
'' OPEN, in both spellings. As a STATEMENT the clauses run to end of line; as an
'' EXPRESSION -- 'if open( "x", for output, as #1 ) <> 0' -- they run to the closing
'' paren and the whole thing yields the error code. Measured: fbc accepts the
'' expression form with every clause the statement takes, the comma-less QB spelling
'' 'open( f for input as #1 )', ACCESS, ENCODING, and 'open pipe( ... )'.
private sub IntrOpen _
    ( byref p as Tko.ParserState, byref sp as Tko.StmtPayload, _
      byval stopParen as boolean = false )

    '' THE DEFAULT MODE IS RANDOM, NOT ZERO. Leaving 'extra' at 0 would say BINARY, and
    '' an OPEN with no FOR clause would silently be opened in the wrong mode.
    sp.extra = (sp.extra and not Tko.OPEN_MODE_MASK) or 1

    sp.a = Expression( p )
    '' 'open scrn "dead" for input as #1' -- SCRN, CONS and ERR name their device and take
    '' no file name: fbc's error 5, "Expected 'AS'" (fbc-modern 1.20, 2026-09-29;
    '' qb/file_open_scrn_fail). LPT, COM and PIPE do take one. The string was collected as a
    '' stray item.
    if (sp.a <> Tko.NODE_NONE) andalso (p.ast->Kind( sp.a ) = Tko.N_IDENT) andalso (Peek( p ) = Tko.TK_STRING_LIT) then
        dim as string dev = lcase( p.names->Spelling( p.ast->IdentOf( sp.a )->name ) )
        if cbool( (dev = "scrn") orelse (dev = "cons") orelse (dev = "err") ) andalso (p.silent = false) then
            p.diags->Report( Tko.TKO0915, Tko.PointRange( Cur( p ).loc ), dev )
        end if
    end if

    dim as Tko.NodeIdVec items
    do
        if (Peek( p ) = Tko.TK_EOL) orelse AtEnd( p ) then exit do
        if stopParen andalso (Peek( p ) = Tko.TK_RPAREN) then exit do
        dim as Tko.TokenKind k = Peek( p )

        '' THE MODE, ACCESS AND LOCK WORDS ARE SMALL INTEGERS, and they were consumed
        '' and DISCARDED -- so every OPEN reached lowering with no idea what it was
        '' opening the file for. Measured from fbc, and none of the numbering is
        '' guessable:
        ''
        ''   mode    BINARY 0  RANDOM 1  INPUT 2  OUTPUT 3  APPEND 4
        ''   access  (none) 0  READ 1    WRITE 2  READ WRITE 3
        ''   lock    (none) 0  READ 1    WRITE 2  READ WRITE 3
        ''
        '' OMITTING 'FOR' IS NOT MODE 0. It is RANDOM, mode 1 -- the same code the word
        '' RANDOM gives -- so a missing clause and a written one are indistinguishable
        '' by design. And 'SHARED' compiles to lock 0, indistinguishable from writing no
        '' LOCK at all.
        if k = Tko.KW_FOR then
            Advance( p )
            if (Peek( p ) <> Tko.TK_EOL) andalso (AtEnd( p ) = false) then
                select case Peek( p )
                case Tko.KW_BINARY : sp.extra = (sp.extra and not Tko.OPEN_MODE_MASK) or 0
                case Tko.KW_RANDOM : sp.extra = (sp.extra and not Tko.OPEN_MODE_MASK) or 1
                case Tko.KW_INPUT  : sp.extra = (sp.extra and not Tko.OPEN_MODE_MASK) or 2
                case Tko.KW_OUTPUT : sp.extra = (sp.extra and not Tko.OPEN_MODE_MASK) or 3
                case Tko.KW_APPEND : sp.extra = (sp.extra and not Tko.OPEN_MODE_MASK) or 4
                end select
                Advance( p )
            end if
            continue do
        end if
        if (k = Tko.KW_ACCESS) orelse (k = Tko.KW_LOCK) then
            Advance( p )
            '' 'access read write' is two words -- but ONLY those two. Consuming every
            '' keyword until AS swallowed the LOCK clause that follows: 'access write
            '' lock read write' read as one four-word access list and gave access 3,
            '' lock 0, where fbc gives access 2, lock 3.
            dim as int32 rw_ = 0
            do
                select case Peek( p )
                case Tko.KW_READ  : rw_ or= 1
                case Tko.KW_WRITE : rw_ or= 2
                case else : exit do
                end select
                Advance( p )
            loop
            if k = Tko.KW_ACCESS then
                sp.extra = (sp.extra and not Tko.OPEN_ACCESS_MASK) or _
                           cast( uint16, rw_ shl Tko.OPEN_ACCESS_SHIFT )
            else
                sp.extra = (sp.extra and not Tko.OPEN_LOCK_MASK) or _
                           cast( uint16, rw_ shl Tko.OPEN_LOCK_SHIFT )
            end if
            continue do
        end if
        if k = Tko.KW_AS then
            Advance( p )
            if Peek( p ) = Tko.TK_HASH then Advance( p )
            sp.b = Expression( p, Tko.PREC_POSTFIX )
            continue do
        end if
        '' ENCODING takes a string that is not one of the clause keywords, so without
        '' this it would fall through to the trailing-expression case and be collected
        '' as a filename.
        if k = Tko.KW_ENCODING then
            Advance( p )
            if (Peek( p ) <> Tko.TK_EOL) andalso (AtEnd( p ) = false) then
                '' RECORDED, so lowering knows to use the Encod entry point. The
                '' encoding is the ONE clause fbc does not reduce to an integer -- it
                '' passes the string through raw and unvalidated, so "bogus" compiles.
                sp.extra or= Tko.OPEN_HAS_ENCODING
                items.Push( cast( uint32, Expression( p ) ) )
            end if
            continue do
        end if
        if k = Tko.KW_LEN then
            Advance( p )
            '' 'len => 1' -- '=>' is an exact synonym for '=' in this clause too.
            if Accept( p, Tko.TK_EQ ) = false then Accept( p, Tko.TK_FATARROW )
            sp.c = Expression( p )
            continue do
        end if
        if k = Tko.TK_COMMA then
            Advance( p )
            continue do
        end if

        dim as int32 before = p.pos
        items.Push( cast( uint32, Expression( p ) ) )
        if p.pos = before then exit do
    loop

    sp.first = p.ast->ChildPoolCount( )
    sp.count = items.Count
    for i as int32 = 0 to items.Count - 1
        p.ast->PushChild( items[i] )
    next
end sub

'' CLOSE / SEEK / LOCK / UNLOCK: '#n [, expr ...]', and CLOSE takes a list of them.
'' 'open( ... )' / 'open pipe( ... )' in EXPRESSION position. The cursor is on OPEN.
function OpenExprCall( byref p as Tko.ParserState ) as Tko.NodeId
    dim as Tko.Token t = Cur( p )
    dim as int32 tok0 = p.pos
    Advance( p )                                    '' OPEN
    '' 'pipe' is not a keyword -- it arrives as an identifier, the same way the
    '' statement form sees it.
    '' ...AND IT IS KEPT, in the statement form's shape: the device as 'a', the name as the
    '' first child. Dropped, 'open pipe( "ls x" for input as #1 )' opened a FILE called
    '' "ls x" and failed (file/pipe.bas); fbc calls fb_FileOpenPipe.
    dim as Tko.NodeId devN = Tko.NODE_NONE
    if Peek( p ) = Tko.TK_IDENT then
        dim as Tko.Token dt = Cur( p )
        devN = MakeIdent( p, dt )
        Advance( p )
    end if
    if Accept( p, Tko.TK_LPAREN ) = false then
        return ErrorNode( p, Tko.TKO0401, "(" )
    end if
    dim as Tko.StmtPayload sp
    sp.op = cast( uint16, Tko.KW_OPEN )
    IntrOpen( p, sp, true )
    Expect( p, Tko.TK_RPAREN, ")" )
    if (devN <> Tko.NODE_NONE) andalso (sp.a <> Tko.NODE_NONE) then
        dim as int32 nf = p.ast->ChildPoolCount( )
        p.ast->PushChild( cast( uint32, sp.a ) )
        for i as int32 = 0 to sp.count - 1
            dim as uint32 ch = p.ast->ChildSlot( sp.first + i )   '' a copy: Push may move the array
            p.ast->PushChild( ch )
        next
        sp.first = nf : sp.count += 1
        sp.a = devN
    end if
    return KeepIntrinsicTokens( p, MakeStmt( p, Tko.N_INTRINSIC, t.loc, sp ), tok0 )
end function

'' 'get( #f, 1, b )' IN EXPRESSION POSITION, which yields the error code and is how the
'' corpus writes every one of them: 'CU_ASSERT( get( #f, 1, b ) = 0 )'.
''
'' Same shape as OPEN above and for the same reason: the '#channel' marker is not an
'' expression, so a generic call parse chokes on it -- it came out as a CALL to an
'' identifier 'get' with an N_ERROR argument, and nothing downstream could recognise
'' that as the statement it is.
'' 'close( n )' IN EXPRESSION POSITION, which yields the ERROR CODE.
''
'' The same shape OPEN and GET already have: the STATEMENT parser reads a comma list to
'' end of line, which in an expression would swallow whatever follows the ')'. This
'' reads exactly one channel and stops at the paren, and it builds the SAME N_INTRINSIC
'' node the statement form does, so lowering needs no second shape.
''
'' Only ONE channel, or none: 'close #1, #2' is two calls and has no single value to
'' be. fbc
'' does not accept the comma form in an expression either.
function CloseExprCall( byref p as Tko.ParserState ) as Tko.NodeId
    dim as Tko.Token t = Cur( p )
    dim as int32 tok0 = p.pos
    Advance( p )                                    '' CLOSE
    if Accept( p, Tko.TK_LPAREN ) = false then
        return ErrorNode( p, Tko.TKO0401, "(" )
    end if

    dim as Tko.StmtPayload sp
    sp.op = cast( uint16, Tko.KW_CLOSE )
    '' 'close( )' WITH NO CHANNEL is the close-all form, and it has a value too --
    '' measured, 'e = close( )' is 'vr$1 = fb_FileCloseAll( )'. An empty list here is
    '' that, not a missing argument.
    dim as Tko.NodeIdVec items
    if Peek( p ) <> Tko.TK_RPAREN then
        if Peek( p ) = Tko.TK_HASH then Advance( p )
        items.Push( cast( uint32, Expression( p ) ) )
    end if
    Expect( p, Tko.TK_RPAREN, ")" )

    sp.first = p.ast->ChildPoolCount( )
    sp.count = items.Count
    for i as int32 = 0 to items.Count - 1
        p.ast->PushChild( items[i] )
    next
    return KeepIntrinsicTokens( p, MakeStmt( p, Tko.N_INTRINSIC, t.loc, sp ), tok0 )
end function

'' WHETHER A LIST SPELLS get OR put is noted as the list grows (GetPutKnown_): each name's
'' spelling is folded once, not two strings per name per GET or PUT.
private function GetPutKnown_ _
    ( byref p as Tko.ParserState, byref ix as Tko.ProcNameIndex, byref names as Tko.NodeIdVec, _
      byval isGet as boolean ) as boolean
    if names.Count < ix.spelledSeen then
        ix.spelledSeen = 0
        ix.hasGet = false
        ix.hasPut = false
    end if
    while ix.spelledSeen < names.Count
        dim as string s = Tko.Text.LowerAscii( p.names->Spelling( cast( Tko.InternId, names[ix.spelledSeen] ) ) )
        if s = "get" then ix.hasGet = true
        if s = "put" then ix.hasPut = true
        ix.spelledSeen += 1
    wend
    return iif( isGet, ix.hasGet, ix.hasPut )
end function

'' DOES THE '( ... )' AFTER GET/PUT HOLD A TOP-LEVEL COMMA? The file form always does -- '#f, , x'
'' -- and 'get( x )' without one is a method named get, called from a sibling (fbc-examples r2ice10).
'' p.pos is at the keyword; the '(' follows it.
'' ...AND NOT A PROCEDURE OF THAT NAME. With no '#' after the '(', a method or procedure called get
'' or put that the parse has already declared is the call: 'get( buf( 0 ), l, , TRUE )' in a sibling
'' method of chisock's TYPE (fbc-examples r3ice05). fbc decides it by symbol; this is IsLabelHere_'s
'' rule -- a method only inside a member body.
function GetPutHasComma( byref p as Tko.ParserState ) as boolean
    if HasTok( p, p.pos + 2 ) then
        if cast( Tko.TokenKind, p.toks->At( p.pos + 2 ).kind ) <> Tko.TK_HASH then
            '' BY SPELLING: a keyword token carries no interned name.
            dim as boolean isGet = (Peek( p ) = Tko.KW_GET)
            if GetPutKnown_( p, p.procIx, p.procNames, isGet ) then return false
            if p.memberDepth > 0 then
                if GetPutKnown_( p, p.memberProcIx, p.memberProcNames, isGet ) then return false
            end if
        end if
    end if
    dim as int32 depth = 0
    dim as int32 i = p.pos + 2
    while HasTok( p, i )
        dim as Tko.TokenKind tk = cast( Tko.TokenKind, p.toks->At( i ).kind )
        if (tk = Tko.TK_EOL) orelse (tk = Tko.TK_EOF) then return false
        if tk = Tko.TK_LPAREN then depth += 1
        if tk = Tko.TK_RPAREN then
            if depth = 0 then return false
            depth -= 1
        end if
        if (tk = Tko.TK_COMMA) andalso (depth = 0) then return true
        i += 1
    wend
    return false
end function

function GetPutExprCall( byref p as Tko.ParserState ) as Tko.NodeId
    dim as Tko.Token t = Cur( p )
    dim as Tko.TokenKind k = Peek( p )
    dim as int32 tok0 = p.pos
    Advance( p )                                    '' GET or PUT
    if Accept( p, Tko.TK_LPAREN ) = false then
        return ErrorNode( p, Tko.TKO0401, "(" )
    end if

    dim as Tko.StmtPayload sp
    sp.op = cast( uint16, k )
    '' Bit 1 is the FILE form, which is the only one that can appear here: the
    '' graphics GET/PUT has its own coordinate grammar and no value.
    sp.extra = 1
    if Peek( p ) = Tko.TK_HASH then Advance( p )
    sp.a = Expression( p, Tko.PREC_POSTFIX )
    Accept( p, Tko.TK_COMMA )

    '' The position and the destination, either of which may be written empty.
    dim as Tko.NodeIdVec items
    do
        if Peek( p ) = Tko.TK_RPAREN then exit do
        if Peek( p ) = Tko.TK_COMMA then
            items.Push( cast( uint32, _
                NewNodeAt( p, Tko.N_ELIDED, Cur( p ).loc, 0 ) ) )
            Advance( p )
            continue do
        end if
        dim as int32 before = p.pos
        items.Push( cast( uint32, Expression( p ) ) )
        if p.pos = before then exit do
        if Accept( p, Tko.TK_COMMA ) = false then exit do
    loop
    Expect( p, Tko.TK_RPAREN, ")" )

    sp.first = p.ast->ChildPoolCount( )
    sp.count = items.Count
    for i as int32 = 0 to items.Count - 1
        p.ast->PushChild( items[i] )
    next
    return KeepIntrinsicTokens( p, MakeStmt( p, Tko.N_INTRINSIC, t.loc, sp ), tok0 )
end function

'' LOCK AND UNLOCK TAKE A RANGE, and the 'to' half was being dropped in silence:
'' 'lock #1, 3 to 9' parsed as two operands, the loop exited on the token it did not
'' recognise, and the 9 never reached lowering. Measured on fbc:
''
''     lock #1, 5        fb_FileLockLarge( 1, 5ll, 0ll )   -- the second bound is 0
''     lock #1, 3 to 9   fb_FileLockLarge( 1, 3ll, 9ll )
''
'' ...so the missing bound is 0 and NOT a repeat of the first, which is what a guess
'' would have written. The 'to' is accepted only for LOCK and UNLOCK: CLOSE and SEEK
'' share this form and fbc has no range for either.
private sub IntrFileNumList _
    ( byref p as Tko.ParserState, byref sp as Tko.StmtPayload, _
      byval k as Tko.TokenKind )

    dim as boolean takesRange = (k = Tko.KW_LOCK) orelse (k = Tko.KW_UNLOCK)
    dim as Tko.NodeIdVec items
    do
        if (Peek( p ) = Tko.TK_EOL) orelse AtEnd( p ) then exit do
        if Peek( p ) = Tko.TK_HASH then Advance( p )
        dim as int32 before = p.pos
        items.Push( cast( uint32, Expression( p ) ) )
        if p.pos = before then exit do
        dim as boolean atRange = takesRange andalso (items.Count = 2)
        if atRange then
            if Accept( p, Tko.KW_TO ) then
                items.Push( cast( uint32, Expression( p ) ) )
                exit do
            end if
        end if
        if Accept( p, Tko.TK_COMMA ) = false then exit do
    loop
    sp.first = p.ast->ChildPoolCount( )
    sp.count = items.Count
    for i as int32 = 0 to items.Count - 1
        p.ast->PushChild( items[i] )
    next
end sub

'' GET and PUT are TWO statements sharing one keyword:
''   file:     GET #n, [pos], var
''   graphics: PUT [target,] (x, y), source [, mode]
'' A leading '#' or a leading '(' is what tells them apart.
private sub IntrGetPut( byref p as Tko.ParserState, byref sp as Tko.StmtPayload )
    dim as boolean isFile = (Peek( p ) = Tko.TK_HASH)
    sp.extra = iif( isFile, 1, 2 )

    if isFile then
        Advance( p )
        sp.a = Expression( p, Tko.PREC_POSTFIX )
        Accept( p, Tko.TK_COMMA )
    end if

    '' THE GRAPHICS FORM HAS ITS OWN COORDINATE GRAMMAR -- see gfx.tiko. Bit 1 of
    '' 'extra' is what says which of the two statements this is, so the graphics flags
    '' start above it.
    if isFile = false then
        if ParseGfxGetPut( p, sp.op = cast( uint16, Tko.KW_PUT ), sp ) then return
    end if

    dim as Tko.NodeIdVec items
    '' THE FILE FORM IS POSITIONAL -- '#f, pos, var, amount, bytesread' -- so an EMPTY slot
    '' is kept, as the expression form keeps it: 'put #1, , buf( 0 ), 10' dropped the
    '' position and read as position buf( 0 ), variable 10.
    if isFile then
        do
            if (Peek( p ) = Tko.TK_EOL) orelse AtEnd( p ) then exit do
            dim as int32 before = p.pos
            items.Push( cast( uint32, ArgOrElided( p, Tko.TK_EOL, false ) ) )
            if Accept( p, Tko.TK_COMMA ) = false then exit do
            if p.pos = before then exit do
        loop
    end if
    do
        if isFile then exit do
        if (Peek( p ) = Tko.TK_EOL) orelse AtEnd( p ) then exit do
        if Peek( p ) = Tko.TK_COMMA then
            Advance( p )
            continue do
        end if
        dim as int32 before = p.pos
        items.Push( cast( uint32, Expression( p ) ) )
        if p.pos = before then exit do
    loop

    sp.first = p.ast->ChildPoolCount( )
    sp.count = items.Count
    for i as int32 = 0 to items.Count - 1
        p.ast->PushChild( items[i] )
    next
end sub

'' LINE is two statements too: 'LINE INPUT ...' and the graphics LINE.
private sub IntrLine( byref p as Tko.ParserState, byref sp as Tko.StmtPayload )
    if Peek( p ) = Tko.KW_INPUT then
        Advance( p )
        sp.extra = 1
        IntrInput( p, sp )
        return
    end if
    '' THE GRAPHICS LINE, which has its own coordinate grammar -- see gfx.tiko. Bit 1
    '' says which of the two statements this is; the graphics flags start above it.
    sp.extra = 2
    dim as Tko.Token lt = Cur( p )
    ParseGfxStmt( p, lt, Tko.KW_LINE, sp )
end sub

'' DATA holds literals, not expressions: unquoted words are data, not identifiers.
'' They are kept as raw tokens because only the DATA table cares what they say.
'' Each item is a full constant EXPRESSION, not a token.
''
'' This used to push ONE NODE PER TOKEN, so 'data -1.5e-3' became two items -- a bare
'' '-' recorded as an empty identifier, then the float -- and 'data 1+2' became three.
'' fbc parses an expression and FOLDS it: 'data &hFF' and 'data 1+2' are stored as the
'' text "255" and "3". A bare undeclared word is fbc error 42, so there is no
'' QB-style unquoted-string case that an expression parse would break.
private sub IntrData( byref p as Tko.ParserState, byref sp as Tko.StmtPayload )
    dim as Tko.NodeIdVec items
    do
        if (Peek( p ) = Tko.TK_EOL) orelse AtEnd( p ) then exit do
        dim as int32 before = p.pos
        items.Push( cast( uint32, Expression( p ) ) )
        '' The no-progress guard: an item that consumed nothing would loop forever.
        if p.pos = before then exit do
        if Accept( p, Tko.TK_COMMA ) = false then exit do
    loop
    sp.first = p.ast->ChildPoolCount( )
    sp.count = items.Count
    for i as int32 = 0 to items.Count - 1
        p.ast->PushChild( items[i] )
    next
end sub

'' ON expr GOTO l1, l2 ...   /   ON [LOCAL] ERROR GOTO label
private sub IntrOn( byref p as Tko.ParserState, byref sp as Tko.StmtPayload )
    '' LOCAL IS RECORDED (T69): 'extra' is 4 rather than 1, because the handler it
    '' installs is restored when the procedure returns -- see LowerOnError_.
    dim as boolean isLocal = false
    if Peek( p ) = Tko.KW_LOCAL then
        isLocal = true
        Advance( p )
    end if

    if Peek( p ) = Tko.KW_ERROR then
        Advance( p )
        sp.extra = iif( isLocal, 4, 1 )
        if (Peek( p ) = Tko.KW_GOTO) orelse (Peek( p ) = Tko.KW_GOSUB) then Advance( p )
        '' 'ON ERROR GOTO 0' DISABLES THE HANDLER, and it is the only integer spelling
        '' that means anything here: a NUMERIC LABEL is fbc's error 146 in the fb
        '' dialect -- 'Only valid in -lang deprecated or fblite or qb' -- so there is no
        '' 'on error goto 5' to target.
        ''
        '' THE TWO CASES ARE NOT ONE. This took 'Cur( p ).literal' for both, and on an
        '' INT_LIT that field is an index into the LITERAL POOL rather than an InternId:
        '' 'on error goto 0' came out naming a label called 'chr', which is simply
        '' whatever intern id 0 happens to be. It would have installed a handler at a
        '' label nobody wrote.
        if Peek( p ) = Tko.TK_IDENT then
            sp.name = cast( Tko.InternId, Cur( p ).literal )
            Advance( p )
        elseif Peek( p ) = Tko.TK_INT_LIT then
            '' name stays 0, which is what lowering reads as 'disable'.
            Advance( p )
        end if
        return
    end if

    '' WHICH JUMP, recorded. 'on n goto' and 'on n gosub' were both coming out as
    '' 'extra = 2', so lowering could not tell a jump from a call and had to refuse
    '' both. GOSUB pushes a return address; GOTO does not.
    sp.extra = 2
    sp.a = Expression( p )
    if Peek( p ) = Tko.KW_GOSUB then
        '' ...AND 'on n gosub' IS GOSUB (T86): refused as the bare statement is. It used to
        '' pass the front end and fail in clang, 'value doesn't match function result type'.
        ErrorNode( p, Tko.TKO0409, "GOSUB" )
        sp.extra = 3
        Advance( p )
    elseif Peek( p ) = Tko.KW_GOTO then
        Advance( p )
    end if

    dim as Tko.NodeIdVec items
    do
        if (Peek( p ) = Tko.TK_EOL) orelse AtEnd( p ) then exit do
        dim as Tko.Token t = Cur( p )
        items.Push( cast( uint32, MakeIdent( p, t ) ) )
        Advance( p )
        if Accept( p, Tko.TK_COMMA ) = false then exit do
    loop
    sp.first = p.ast->ChildPoolCount( )
    sp.count = items.Count
    for i as int32 = 0 to items.Count - 1
        p.ast->PushChild( items[i] )
    next
end sub

'' TWO MORE SHAPES fbc's fb dialect refuses with its error 146 (T86), each a whole
'' statement, reached from Statement's dispatch on the first token:
''
''     call Hello( )        'CALL' before a call -- TKO0408, "expected a statement", before
''     10 print "x"         a NUMBERED LINE -- TKO0420 at the token after the number
''
'' Measured on fbc-modern 1.20, 2026-10-03. The rest of the line is skipped: it is the
'' qb-dialect statement the reader meant, and nothing in it can be checked as fb.
private function LegacyStatement_( byref p as Tko.ParserState ) as Tko.NodeId
    dim as Tko.NodeId n
    '' A NUMBER IS A LINE NUMBER ONLY AS A PHYSICAL LINE'S FIRST TOKEN. After a ':' it is
    '' an expression statement -- ': 0 = 1' is the literal-target error, not this.
    if Peek( p ) = Tko.TK_INT_LIT then
        dim as boolean lineStart = (p.pos = 0)
        if lineStart = false then lineStart = ((Cur( p ).flags and Tko.TF_AT_LINE_START) <> 0)
        if lineStart = false then return ParseAmbiguous( p )
    end if
    if Peek( p ) = Tko.KW_CALL then
        n = ErrorNode( p, Tko.TKO0409, "CALL" )
    else
        n = ErrorNode( p, Tko.TKO0944 )
    end if
    '' UP TO THE LINE'S END, NOT PAST IT: Statement consumes the terminator, and taking
    '' it here as well swallowed the next line -- '20 end' after '10 print' went unseen.
    do while (Peek( p ) <> Tko.TK_EOL) andalso (AtEnd( p ) = false)
        Advance( p )
    loop
    return n
end function

private function NextIsRParen_( byref p as Tko.ParserState ) as boolean
    if HasTok( p, p.pos + 1 ) = false then return false
    return cast( Tko.TokenKind, p.toks->At( p.pos + 1 ).kind ) = Tko.TK_RPAREN
end function

'' THE KEYWORD'S TOKENS, KEPT ON AN INTRINSIC IN EXPRESSION POSITION, so Resolve can read it
'' again as a call of a procedure of that name -- RewriteShadowedIntrinsic_.
function KeepIntrinsicTokens _
    ( byref p as Tko.ParserState, byval n as Tko.NodeId, byval tok0 as int32 ) as Tko.NodeId
    if (n <> Tko.NODE_NONE) andalso (p.pos > tok0) then
        p.ast->RecordTokens( n, tok0, p.pos - 1 )
        p.ast->OrFlags( n, Tko.NF_INTR_EXPR )
    end if
    return n
end function

'' A KEYWORD THIS PARSE ALREADY KNOWS AS A PROCEDURE: 'sub' anywhere, a method only inside a
'' member body, where it is 'this.name'. IsLabelHere_'s rule and GetPutHasComma's.
private function KeywordNamesProc_( byref p as Tko.ParserState, byval k as Tko.TokenKind ) as boolean
    if Tko.IsKeywordKind( k ) = false then return false
    dim as uint32 nm = cast( uint32, p.names->GetString( Tko.Text.LowerAscii( Tko.TokenKindText( k ) ) ) )
    if KnownProc_( p, false, nm ) then return true
    if p.memberDepth = 0 then return false
    return KnownProc_( p, true, nm )
end function

'' A STATEMENT KEYWORD THAT NAMES A PROCEDURE, WHERE THE STATEMENT'S OWN GRAMMAR REFUSES THE LINE.
'' fbc looks the name up before it tries the statement (cProcCallOrAssign, then cQuirkStmt), so
'' a method called Get, Put, Line, Name, Swap ... is a plain call from a sibling. Measured on
'' fbc-modern 1.20, 2026-11-09, forty keywords by six call shapes: every 'Get( )', 'Name 1' and
'' 'Swap( 1 )' over a same-named own or inherited method calls it. Only Resolve can say which
'' procedure a name means, so a line that does parse as the statement is left for
'' RewriteShadowedIntrinsic_; this is the other half, the lines it would never see, because
'' the statement's parser had already reported them. Nothing reported is kept, and the parse
'' starts over as the call: a name that then binds to nothing is an undeclared name, at this line.
function IntrinsicOrCall( byref p as Tko.ParserState ) as Tko.NodeId
    dim as Tko.TokenKind k = Peek( p )
    if KeywordNamesProc_( p, k ) = false then return ParseIntrinsic( p )

    dim as int32 tok0 = p.pos, errors0 = p.errors
    dim as boolean silent0 = p.silent
    dim as int32 pendAt, errAt, warnAt, supAt
    p.diags->Snapshot( pendAt, errAt, warnAt, supAt )
    dim as int32 reported0 = p.diags->ErrorCount( )
    dim as Tko.NodeId n = ParseIntrinsic( p )
    '' 'Line 1' REPORTS NOTHING and stops before the 1, so the statement's own end check would.
    dim as boolean atEnd_ = (Peek( p ) = Tko.TK_EOL) orelse (Peek( p ) = Tko.TK_COLON) orelse AtEnd( p ) orelse EndsSingleLineStmt( p )
    if atEnd_ andalso (p.errors = errors0) andalso (p.diags->ErrorCount( ) = reported0) then return n

    p.diags->RollBack( pendAt, errAt, warnAt, supAt )
    p.errors = errors0
    p.silent = silent0
    p.pos = tok0
    p.toks->At( tok0 ).literal = cast( uint32, p.names->GetString( Tko.Text.LowerAscii( Tko.TokenKindText( k ) ) ) )
    p.toks->At( tok0 ).kind = cast( uint16, Tko.TK_IDENT )
    dim as Tko.NodeId callN = CallStatement( p )
    if (callN <> Tko.NODE_NONE) andalso (p.ast->Kind( callN ) = Tko.N_AMBIGUOUS) then
        dim as Tko.NodeId callee = p.ast->StmtOf( callN )->a
        if (callee <> Tko.NODE_NONE) andalso (p.ast->Kind( callee ) = Tko.N_CALL) then callee = p.ast->ListOf( callee )->target
        if (callee <> Tko.NODE_NONE) andalso (p.ast->Kind( callee ) = Tko.N_IDENT) then p.ast->OrFlags( callee, Tko.NF_KW_CALLEE )
    end if
    return callN
end function

'' The entry point: dispatch on the registry.
function ParseIntrinsic( byref p as Tko.ParserState ) as Tko.NodeId
    dim as Tko.Token t = Cur( p )
    dim as Tko.TokenKind k = Peek( p )
    dim as Tko.StmtPayload sp
    sp.op = cast( uint16, k )

    '' '?' is PRINT, and is not a keyword at all.
    dim as Tko.IntrinsicForm form = Tko.IFORM_PRINT
    if k = Tko.TK_QUESTION then
        '' ...AND IT IS RECORDED AS ONE. Keeping TK_QUESTION in 'op' made a second
        '' statement kind out of a pure synonym, and the lowerer dispatches on the
        '' op: every '?' reached the end of the dispatcher and declined, while the
        '' 'print' beside it lowered. syntax/non-indexed-array.bas writes it.
        sp.op = cast( uint16, Tko.KW_PRINT )
    else
        form = Tko.IntrinsicFormOf( k )
    end if
    Advance( p )

    select case form
    case Tko.IFORM_PRINT    : IntrPrint( p, sp )
    case Tko.IFORM_INPUT    : IntrInput( p, sp )
    case Tko.IFORM_LINE     : IntrLine( p, sp )
    case Tko.IFORM_OPEN     : IntrOpen( p, sp )
    case Tko.IFORM_FILENUM  : IntrFileNumList( p, sp, k )
    case Tko.IFORM_GETPUT   : IntrGetPut( p, sp )
    case Tko.IFORM_DATA     : IntrData( p, sp )
    case Tko.IFORM_ON       : IntrOn( p, sp )

    case Tko.IFORM_SWAP, Tko.IFORM_NAME
        sp.a = Expression( p )
        if Accept( p, Tko.TK_COMMA ) = false then Accept( p, Tko.KW_AS )
        sp.b = Expression( p )

    case Tko.IFORM_CVA_ARG
        '' cva_arg( list, TYPE ). The second argument is a TYPE REFERENCE, not an
        '' expression, so the argument list cannot be parsed generically.
        Expect( p, Tko.TK_LPAREN, "(" )
        sp.a = Expression( p )
        Expect( p, Tko.TK_COMMA, "," )
        sp.c = TypeRef( p )
        Expect( p, Tko.TK_RPAREN, ")" )

    case Tko.IFORM_UNSUPPORTED
        ErrorNode( p, Tko.TKO0409, Tko.TokenKindText( k ) )
        '' To the line's end, not past it -- as LegacyStatement_ does, and for its
        '' reason: a second 'gosub' on the next line went unreported (T86).
        do while (Peek( p ) <> Tko.TK_EOL) andalso (AtEnd( p ) = false)
            Advance( p )
        loop

    case else
        '' LSET AND RSET TAKE AN ASSIGNMENT, and '=>' spells one. Measured: fbc
        '' compiles 'lset s => "x"' and 'rset s => "x"' and both pad exactly as the
        '' '=' spelling does, while 'if x => 3 then' is fbc error 31 -- so '=>' is an
        '' ASSIGNMENT token and never a comparison, and it does NOT belong in the
        '' infix precedence table beside '='.
        ''
        '' The '=' form needs nothing here: Expression reads 's = "x"' as one
        '' N_BINARY, which is what LowerLrset expects. The arrow has no infix entry,
        '' so the expression stopped at 's' and the rest of the line was dropped
        '' SILENTLY -- quirk/assignment-token.bas writes one of each.
        ''
        '' Built as TK_EQ, because that is what it means and what the lowering reads.
        if (k = Tko.KW_LSET) orelse (k = Tko.KW_RSET) then
            '' ...AND SO DOES A COMMA, which is the spelling the corpus actually uses
            '' and the one this had no case for. Measured: fbc emits the SAME call for
            '' all three -- 'lset x, y', 'lset x = y' and 'lset x => y' are byte for
            '' byte 'fb_StrLset( &X$0, (FBSTRING*)&Y$0 )'.
            ''
            '' Without it the comma form dropped its SOURCE in silence, exactly as the
            '' arrow did before the note below was written: the expression stopped at
            '' 'x' and ', y' was never parsed. The statement then declined for want of
            '' an assignment, which is the visible symptom of a parse that lost half
            '' its meaning.
            dim as Tko.NodeId lrLhs = Expression( p )
            dim as Tko.NodeIdVec lrItems
            dim as boolean lrJoined = (Peek( p ) = Tko.TK_FATARROW) orelse _
                                      (Peek( p ) = Tko.TK_COMMA)
            if lrJoined then
                dim as Tko.Token lrAt = Cur( p )
                Advance( p )
                dim as Tko.BinaryPayload lrBp
                lrBp.op = cast( uint16, Tko.TK_EQ )
                lrBp.lhs = lrLhs
                lrBp.rhs = Expression( p )
                p.ast->PushBinary( lrBp )
                lrLhs = NewNodeAt( p, Tko.N_BINARY, lrAt.loc, _
                                    cast( uint32, p.ast->BinaryPoolCount( ) - 1 ) )
            end if
            lrItems.Push( cast( uint32, lrLhs ) )
            sp.first = p.ast->ChildPoolCount( )
            sp.count = lrItems.Count
            for i as int32 = 0 to lrItems.Count - 1
                p.ast->PushChild( lrItems[i] )
            next
            return MakeStmt( p, Tko.N_INTRINSIC, t.loc, sp )
        end if

        '' THE COORDINATE-SYNTAX STATEMENTS have a grammar of their own -- see gfx.tiko.
        '' '(x,y)-(x,y)' was parsed as an expression, which made it a BINARY MINUS of
        '' two tuples, and 'step(1,2)' a CALL to a procedure named 'step'. Faithful to
        '' nothing: the tree said subtract where the source said "from here to there".
        select case k
        case Tko.KW_LINE, Tko.KW_PSET, Tko.KW_PRESET, Tko.KW_CIRCLE, Tko.KW_PAINT, _
             Tko.KW_VIEW, Tko.KW_WINDOW, Tko.KW_DRAW
            if ParseGfxStmt( p, t, k, sp ) then
                return MakeStmt( p, Tko.N_INTRINSIC, t.loc, sp )
            end if
        case Tko.KW_PALETTE
            if ParseGfxPalette( p, sp ) then
                return MakeStmt( p, Tko.N_INTRINSIC, t.loc, sp )
            end if
        end select

        '' 'color( )' IS 'color', measured: fb_Color( 0, 0, 3 ) for both, and the cva statements report
        '' a wrong count themselves (TKO0988). For the rest '( )' reports itself in Primary.
        dim as boolean emptyOk = (k = Tko.KW_COLOR) orelse (k = Tko.KW_CVA_START) orelse (k = Tko.KW_CVA_END) orelse (k = Tko.KW_CVA_COPY)
        if emptyOk andalso (Peek( p ) = Tko.TK_LPAREN) andalso NextIsRParen_( p ) then
            Advance( p ) : Advance( p )
            return MakeStmt( p, Tko.N_INTRINSIC, t.loc, sp )
        end if

        dim as Tko.NodeIdVec items
        IntrArgList( p, items )
        sp.first = p.ast->ChildPoolCount( )
        sp.count = items.Count
        for i as int32 = 0 to items.Count - 1
            p.ast->PushChild( items[i] )
        next
    end select

    return MakeStmt( p, Tko.N_INTRINSIC, t.loc, sp )
end function

end namespace

namespace Tko.Parse

'' A TYPE KEYWORD CALLED LIKE A FUNCTION -- 'ustring( "x" )', 'long( 5 )', 'zstring( 5 )' --
'' is fbc's error 9, 'Expected expression' (error 3 inside a PRINT list, which stops there).
'' Measured on fbc-modern 1.20, 2026-09-26, over ustring, zstring, integer, long, double,
'' byte, boolean and any. The expression layer took it for an intrinsic call that nothing
'' binds, and the statement was dropped in silence: 'dim u as ustring = ustring( "VARIANT" )'
'' printed an empty line. 'string( n, c )' and 'wstring( n, c )' ARE functions, and 'sub'
'' and 'function' start a lambda, which the expression layer parses before asking this.
function TypeKeywordCalled _
    ( byref p as Tko.ParserState, byval k as Tko.TokenKind ) as boolean

    '' ...AND 'typeof( x )' IN A VALUE POSITION, fbc's error 9 as well (3 inside a PRINT list):
    '' 'print typeof( x )', 'x = typeof( x )', 'if typeof( x ) = typeof( long )'. Measured,
    '' 2026-09-26. tiko typed nothing for it and printed nothing, or compared two types and
    '' answered. '#assert' and a call argument are the exceptions -- TypeofArgExpression.
    if (k <> Tko.KW_TYPEOF) andalso (Tko.IsTypeKeyword( k ) = false) then return false
    select case k
    case Tko.KW_STRING, Tko.KW_WSTRING, Tko.KW_SUB, Tko.KW_FUNCTION
        return false
    end select
    if HasTok( p, p.pos + 1 ) = false then return false
    return (cast( Tko.TokenKind, p.toks->At( p.pos + 1 ).kind ) = Tko.TK_LPAREN)
end function

'' A CALL ARGUMENT, where 'typeof( x )' may stand for a TYPE. 'peek( typeof( b ), pb )',
'' 'poke( typeof( b ), pb, v )' and 'procptr( s, typeof( t ) )' are fbc's, and tests/mir
'' writes all three. The argument is parsed exactly as before; only 'typeof' is let through.
function TypeofArgExpression( byref p as Tko.ParserState ) as Tko.NodeId
    dim as boolean saved = p.typeofOk
    p.typeofOk = true
    dim as Tko.NodeId e = Expression( p )
    p.typeofOk = saved
    return e
end function

'' ...BUT ONLY FOR A CALLEE THAT TAKES A TYPE. Measured on fbc-modern 1.20, 2026-09-28:
''
''     F( typeof( x ) )   G( typeof( x ) )   F typeof( x )      error 1, argument count
''     ( typeof( x ) ) anywhere -- 's = ...', 'x = ...', 'if ... = 1', 'F( ... )'   error 9
''
'' tiko let 'typeof' through every call argument and every parenthesis (ArgOrElided parses
'' both), so each of those statements was dropped in silence. Now ArgOrElided lets it through
'' only for 'peek' here and for the statement intrinsics ('poke') -- 'procptr' reads its
'' second argument itself, and 'sizeof'/'len' go through TypeArgCall. Anywhere else the
'' expression layer reports TKO0400, as it does for a bare 'x = typeof( x )'.
function TypeofArgCallee( byref p as Tko.ParserState, byval callee as Tko.NodeId ) as boolean
    if callee = Tko.NODE_NONE then return false
    if p.ast->Kind( callee ) <> Tko.N_IDENT then return false
    dim as string nm = Tko.Text.LowerAscii( _
        p.names->Spelling( p.ast->IdentOf( callee )->name ) )
    return (nm = "peek")
end function

end namespace
