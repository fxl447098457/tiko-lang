'' expr.ti -- the expression parser.
''
'' A Pratt engine over the measured precedence table. The parser is a pure function of
'' the token stream: it never consults symbols or types (docs/plan/01 section 1).
''
'' Invariants:
''   - Always returns a valid NodeId. On failure that is an N_ERROR node, and a
''     diagnostic has been emitted for it.
''   - Never consumes TK_EOL or TK_EOF: statements own their terminators.
''   - Recursion is capped, so no input can overflow the stack.

#ifndef __TKO_EXPR_BI__
#define __TKO_EXPR_BI__

#include once "tko.ti"
#include once "ast/nodes.ti"
#include once "parser/prectable.ti"
#include once "lexer/token.ti"
#include once "lexer/lexer.ti"
#include once "source/manager.ti"
#include once "diag/engine.ti"
#include once "support/intern.ti"

namespace Tko

    const PARSE_MAX_DEPTH as int32 = 256
    '' Statement nesting and the length of one operator chain (audit F-46): past them the
    '' later stages' recursion ran out of stack with no diagnostic. TKO0991 says so instead.
    '' The chain is ~5 KB of stack per operator on the 1 GB compile thread (driver/main.tiko):
    '' 150,000 leaves room, where fbc segfaults at 50,000 '+' and the old 12,000 refused
    '' a 50,000-term '&' fbc compiles. fbc dies at 250 nested IFs; 1,024 holds.
    const PARSE_MAX_BLOCKS as int32 = 1024
    const PARSE_MAX_CHAIN as int32 = 150000

    '' procNames / memberProcNames AS A SET, for the per-statement questions that scanned them
    '' (IsLabelHere_, ParenlessFnCall_: thousands of names with windows.bi), and whether one of
    '' them spells GET or PUT (GetPutHasComma). Caught up from the counts on each question and
    '' rebuilt if the list shrank: generic.tiko assigns whole lists to a fresh ParserState.
    type ProcNameIndex
        as containers.Set( of uint32 ) ids
        as int32                 seen
        as int32                 spelledSeen
        as boolean              hasGet
        as boolean              hasPut
    end type

    type ParserState
        as TokenVec ptr         toks
        '' When set, the token buffer is filled ON DEMAND from the preprocessor
        '' (docs/plan/03 section 6.1). The buffer only grows, so a saved p.pos stays
        '' valid and backtracking is unaffected.
        as any ptr              stream      '' PpStream ptr, or 0 for a fixed vector
        as LiteralVec ptr       litPool     '' the lexer's literal pool for these tokens
        as int32                 pos
        as AstArena ptr         ast
        as SourceManager ptr    src
        as Interner ptr         names
        as DiagnosticEngine ptr diags
        '' The keyword table, so the parser can LEX a prelude of its own. fbc predeclares
        '' a set of runtime procedures -- 'kill', 'sleep', 'locate' -- that are in no
        '' header and are not reserved words either: 'dim as long kill' is a DUPLICATED
        '' DEFINITION, not a syntax error. Writing them as source and lexing it is what
        '' lets them be declared the way everything else is.
        as any ptr              kw          '' KeywordTable ptr, or 0 for no prelude
        as int32                 depth
        '' How many BLOCKS enclose the cursor -- see Block in parserend.tiko.
        as int32                 blockDepth
        '' How many TYPE/UNION bodies enclose the cursor. An anonymous 'union' or
        '' 'type' is legal ONLY inside one; at module level a bare 'type' is an error
        '' worth keeping, so the two cases are told apart by this rather than by
        '' silently accepting both.
        as int32                 aggDepth
        as int32                 partialDepth     '' the aggDepth of a 'partial type' body being parsed; 0 = none
        as boolean               sawPartial       '' the unit wrote 'partial type' (MergePartialTypes)
        '' Whether the innermost of those is a UNION. Anonymous ones must alternate -- see
        '' TKO0877 in decltype.tiko.
        as boolean              aggUnion
        '' How many PROCEDURE BODIES enclose the cursor. Only module-level declarations
        '' are told to the preprocessor for 'defined( X )', because fbc's answer is
        '' scope-respecting: measured, a local or a parameter is NOT visible to
        '' 'defined' once its procedure has ended. Recording one would make a later
        '' '#ifndef' skip a declaration it should have taken -- silently.
        as int32                 procDepth
        '' Inside the body of a 'sub f( ) static': a 'dim' or 'var' there is 'static'.
        as boolean              staticLocals
        '' How many NAMESPACE bodies enclose the cursor: a name declared in one is not one a
        '' module-level '#define' collides with (PpNoteDeclared's atTop, T62)...
        as int32                 nsDepth
        '' ...UNLESS a module-level 'using' imports that namespace: then fbc refuses the
        '' '#define' too. The enclosing namespaces' path, folded and dotted ("a.b"), told to
        '' the preprocessor with every declaration in them; "" at module level.
        as string               nsPath
        '' NAMES THAT MAY BE A FUNCTION-LIKE MACRO'S: an ENUM member and a 'using' path. Above
        '' zero, DeclName does not refuse one (BareMacroDecl_, declkind.tiko).
        as int32                 bareNameOk
        '' Above zero while a procedure BODY's parameters are read: those enter the
        '' procedure's table, so BareMacroDecl_ refuses one; a DECLARE's do not.
        as int32                 bodyParams
        '' THE CHAINS OF THE INTERFACES THE UNIT HAS READ (CompilerContext.ifaceChains), or 0:
        '' where 'spawn' and 'select' name their runtime -- see Parse.TasksNs.
        as StrVec ptr           ifaceChains
        '' THE CONVENTION A PROCEDURE GETS WHEN IT WRITES NONE -- fbc's 'fbcall', stdcall
        '' on Windows and cdecl on Linux. Only the '...' rule reads it (CheckVarargConv_),
        '' and CC_NONE, the default, turns that rule off: the prelude and a generic
        '' re-parse re-read text the unit's own parse has already asked about.
        as uint8                fbcallConv
        '' ...and the default the enclosing EXTERN block gives instead: cdecl for "C" and
        '' "C++", stdcall for "Windows" and "Windows-MS", CC_NONE for "rtlib" and outside
        '' any block, where the target's applies.
        as uint8                externConv
        '' A '...' REFUSED WHILE SILENT, as (node, diagnostic, convention) triples. A
        '' speculative parse reports nothing, and the one whose result is KEPT --
        '' 'typeof( sub( ..., ... ) )' -- owes the report afterwards; see
        '' FlushVarargPending_.
        as containers.Array( of uint32 ) varargPending
        '' THE LIBRARIES 'declare ... lib "name"' ASKS FOR. The clause was parsed and
        '' the name THROWN AWAY, so 'declare function SHCreateItemFromParsingName lib
        '' "shell32"' linked against nothing -- 'undefined symbol', with the library
        '' sitting in the toolchain all along. Interned ids, drained by the driver
        '' into the same list '#inclib' feeds.
        as containers.Array( of uint32 ) declLibs
        '' A PROCEDURE'S 'implements I.M' LIST (docs/tiko-interfaces), read in the trailing-
        '' modifier loop before the N_PROC exists: the N_BLOCK, and the token the declaration
        '' began at, so a list is only ever taken by the declaration that read it.
        as NodeId                pendingImpl
        as int32                 pendingImplTok
        as int32                 errors
        as boolean              silent      '' suppress cascades after an error
        '' A MODULE UNIT: every declaration's token range goes to ast->declRanges.
        as boolean              recordDecls
        '' LAMBDAS, HOISTED. 'function( ) as long ... end function' written where an
        '' expression belongs is an ordinary procedure with a generated name --
        '' measured, fbc emits one and assigns its ADDRESS -- so the N_PROC is moved
        '' to module level and the expression becomes '@<that name>'. Collected here
        '' because the expression parser has no way to reach the module's child list.
        '' Inside a PROCPTR argument list, where 'T.+=' and 'T.[]' name a member by
        '' its OPERATOR token rather than by a word. Nowhere else in an expression is
        '' an operator legal after a dot, so the member parser only accepts one while
        '' this is set.
        as boolean              inProcPtrArg
        '' Where 'typeof( x )' may stand for a TYPE: '#assert', which compares types, and a
        '' call argument -- 'peek( typeof( b ), pb )'. See TypeKeywordCalled.
        as boolean              typeofOk
        as NodeIdVec            lambdas
        as int32                 lambdaSeq
        '' HOW MANY ANONYMOUS NAMESPACES have been opened. 'namespace' with no name
        '' is legal, and two of them are two DIFFERENT namespaces -- fbc names them
        '' LABEL$2, LABEL$7 from a counter of its own. A LINE NUMBER will not do:
        '' every token of a macro expansion carries the INVOCATION's location, so
        '' 508 expansions of one macro all report the same line and collide.
        as int32                 anonNsSeq
        '' How many GENERIC procedure bodies enclose the cursor. A lambda written
        '' inside one is a TEMPLATE like the body around it -- its own body names the
        '' generic's type parameters, which stand for nothing at module level -- so it
        '' is hoisted carrying PF_GENERIC_PROC and lowering leaves it alone. Each
        '' INSTANTIATION re-parses the body and hoists a lambda of its own, with the
        '' flag cleared and a sequence number no other instantiation can produce.
        as int32                 genericDepth
        '' ...and the TYPE-PARAMETER LIST of each, innermost last. A lambda written inside
        '' one takes the innermost as its own 'c', so Resolve can tell that its 'as T'
        '' names the generic's parameter and not a module-level T -- see
        '' TemplateTypeParam_. fb/sort.bi's comparison lambdas are exactly that.
        as NodeIdVec            genericParams
        '' How many 'var (a, b) = expr' declarations have been desugared. Each needs a
        '' temporary of its own: two in one loop body, or one nested inside another,
        '' must not name the same thing.
        as int32                 destructureSeq
        '' Inside the THEN-BRANCH OF A SINGLE-LINE IF, where an ELSE on the same line
        '' belongs to that IF and not to the statement being parsed. EndOfStatement
        '' otherwise walks to the line's end and DISCARDS whatever it passes, which is
        '' how 'if c then a else b' lost its else branch in silence.
        as boolean              stopAtElse
        '' 'next x, y' closes two FORs: how many NEXTs a multi-name NEXT has left for the
        '' FORs around the one it closed, and how many FOR bodies enclose the cursor.
        '' parserend.tiko's AcceptNext_.
        as int32                 pendingNext
        as int32                 forDepth
        '' How many '#pragma reserve (asm)' records the blocks have already judged.
        as int32                 asmSeen
        '' The PROCEDURES declared so far, the prelude's included. fbc reads 'name :' as
        '' a label only when 'name' is not a procedure it knows at that point
        '' (parser-label.bas), so 'sleep : end 0' is a call and then END. See
        '' parserend.tiko's IsLabelHere_.
        as NodeIdVec            procNames
        '' ...and the PRELUDE's, as "|name|...|", filled on first use. The prelude is
        '' parsed after the unit's own statements, so its declarations are not in
        '' procNames while a label is being decided.
        as string               preludeProcs
        '' METHODS, which fbc sees by bare name only inside a member procedure's body
        '' (implicit 'this'), and how many member bodies enclose the cursor.
        as NodeIdVec            memberProcNames
        as int32                 memberDepth
        as ProcNameIndex        procIx, memberProcIx   '' parserend.tiko's KnownProc_
        '' A THREAD-MAKING CALL HAS BEEN READ (makeident.tiko NoteThreadUse_), and the two names
        '' that are one, folded, looked up the first time an identifier is.
        as boolean              mtNoted
        as InternId             mtCreate, mtWait
        '' AUTO-PROPERTIES OF THE TYPE BEING READ whose accessor bodies are owed after its 'end type',
        '' as AP_STRIDE int32s each -- see autoprop.tiko.
        as containers.Array( of int32 ) autoProps
    end type

end namespace

namespace Tko.Parse

'' Defined in spawn.tiko: the namespace 'spawn' and 'select' name their runtime through.
declare function TasksNs( byref p as Tko.ParserState ) as string
declare sub TasksQual( byref p as Tko.ParserState, byval n as Tko.NodeId, byval what as int32 )

'' Defined in intrinsics.tiko: 'open( ... )' used as an EXPRESSION. Declared here
'' because Primary needs it and expr.tiko is compiled before that file.
declare function OpenExprCall( byref p as Tko.ParserState ) as Tko.NodeId
declare function GetPutExprCall( byref p as Tko.ParserState ) as Tko.NodeId
declare function GetPutHasComma( byref p as Tko.ParserState ) as boolean
'' Defined in parserend.tiko: is nm in procNames (member: memberProcNames)?
declare function KnownProc_( byref p as Tko.ParserState, byval member as boolean, byval nm as uint32 ) as boolean
declare function CloseExprCall( byref p as Tko.ParserState ) as Tko.NodeId
'' Defined in intrinsics.tiko -- see there.
declare function IntrinsicOrCall( byref p as Tko.ParserState ) as Tko.NodeId
declare function KeepIntrinsicTokens _
    ( byref p as Tko.ParserState, byval n as Tko.NodeId, byval tok0 as int32 ) as Tko.NodeId

'' Defined in decl.tiko: an ANONYMOUS procedure used as a value --
''   dim as function( byref as T, byref as T ) as boolean less = _
''       function( byref x as T, byref y as T ) as boolean
''           return x < y
''       end function
'' Same routing reason as OpenExprCall: Primary needs it, decl.tiko is compiled later.
declare function TryLambdaExpr( byref p as Tko.ParserState ) as Tko.NodeId
declare function ArgOrElided _
    ( byref p as Tko.ParserState, byval closer as Tko.TokenKind, byval tyOk as boolean = true ) as Tko.NodeId

    declare sub ChainTooLong_( byref p as Tko.ParserState )
    declare function FoldConstIif_( byref p as Tko.ParserState, byval n as Tko.NodeId ) as Tko.NodeId
    declare function Expression _
        ( byref p as Tko.ParserState, byval minPrec as int32 = 1, _
          byval seed as Tko.NodeId = Tko.NODE_NONE ) as Tko.NodeId

    '' Parse one whole token vector as a single expression. Used by the expression
    '' tests and by the precedence differential harness.
    declare function OneExpression( byref p as Tko.ParserState ) as Tko.NodeId

    '' Shared with parser.tiko. Not private: the statement layer is a separate module.
    '' True when buffer index 'want' exists, pulling from the preprocessor if needed.
    declare function HasTok( byref p as Tko.ParserState, byval want as int32 ) as boolean
    declare function Peek( byref p as Tko.ParserState ) as Tko.TokenKind
    declare function Cur( byref p as Tko.ParserState ) as Tko.Token
    declare sub Advance( byref p as Tko.ParserState )
    declare function Accept( byref p as Tko.ParserState, byval k as Tko.TokenKind ) as boolean
    '' A type keyword called like a function -- see parser/intrinsics.tiko.
    declare function TypeKeywordCalled _
        ( byref p as Tko.ParserState, byval k as Tko.TokenKind ) as boolean
    declare function TypeofArgExpression( byref p as Tko.ParserState ) as Tko.NodeId
    declare function TypeofArgCallee( byref p as Tko.ParserState, byval callee as Tko.NodeId ) as boolean
    '' Lives in decltype.tiko: a calling convention, and with 'nameless' the
    '' OVERLOAD and ALIAS that may sit where a CONSTRUCTOR's name would be.
    declare function TakeProcPrefix_ _
        ( byref p as Tko.ParserState, byref sp as Tko.StmtPayload, _
          byval nameless as boolean = false ) as boolean

    '' 'trycast( T, x )' at the cursor (docs/tiko-interfaces §5.5): the contextual word, a '(',
    '' and no procedure of that name seen -- parser/declclass.tiko.
    declare function TryCastHere( byref p as Tko.ParserState, byval k as Tko.TokenKind ) as boolean

    '' 's[lo to hi]': the cursor on 'to', 'lo' in items[0]. Builds the '__tko_slice' call --
    '' parser/sliceexpr.tiko (docs/tiko-slices RFC-0001 §3).
    declare function SliceTail _
        ( byref p as Tko.ParserState, byval target as Tko.NodeId, _
          byref items as Tko.NodeIdVec, byval loc as Tko.SourceLoc ) as Tko.NodeId

    declare function ErrorNode _
        ( byref p as Tko.ParserState, byval id as Tko.DiagId, _
          byval a0 as string = "" ) as Tko.NodeId
    declare function Expect _
        ( byref p as Tko.ParserState, byval k as Tko.TokenKind, _
          byval what as string ) as boolean
    declare function MakeIdent( byref p as Tko.ParserState, byref t as Tko.Token ) as Tko.NodeId
    '' A token as the node it is: literals stay literals. See the comment on it.
    declare function MakeTokenNode _
        ( byref p as Tko.ParserState, byref t as Tko.Token ) as Tko.NodeId
    declare function MakeList _
        ( byref p as Tko.ParserState, byval kind as Tko.NodeKind, byval loc as Tko.SourceLoc, _
          byval target as Tko.NodeId, byref items as Tko.NodeIdVec ) as Tko.NodeId
    declare sub MarkCallTarget_( byref p as Tko.ParserState, byval n as Tko.NodeId )
    declare sub MarkSymbolArgs_ _
        ( byref p as Tko.ParserState, byval target as Tko.NodeId, byref items as Tko.NodeIdVec )
    declare function MakeStmt _
        ( byref p as Tko.ParserState, byval kind as Tko.NodeKind, byval loc as Tko.SourceLoc, _
          byref sp as Tko.StmtPayload ) as Tko.NodeId
    declare function MakeAddrOfName _
        ( byref p as Tko.ParserState, byval nm as Tko.InternId, _
          byval loc as Tko.SourceLoc, byval spellOff as int32, _
          byval spellLen as int32 ) as Tko.NodeId

    declare function NewNodeAt _
        ( byref p as Tko.ParserState, byval kind as Tko.NodeKind, byval loc as Tko.SourceLoc, _
          byval payload as uint32 ) as Tko.NodeId

    declare function Dump _
        ( byref ast as Tko.AstArena, byref src as Tko.SourceManager, _
          byref names as Tko.Interner, byval root as Tko.NodeId ) as string

end namespace

#endif
