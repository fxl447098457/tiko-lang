'' parser.ti -- statements, declarations and the unit entry point.
''
'' Recursive descent, one function per construct, over the preprocessed token vector.
'' The parser never consults symbols or types (docs/plan/01 section 1): where FreeBASIC
'' appears to require it -- 'Foo 1, 2' versus 'Foo = 1' -- it emits N_AMBIGUOUS and the
'' resolver decides (docs/plan/04 section 6).
''
'' Invariants:
''   - Always returns a module node, however damaged the input.
''   - Never loops forever: every recovery path consumes at least one token.
''   - One diagnostic per statement; the rest of a broken statement is suppressed.

#ifndef __TKO_PARSER_BI__
#define __TKO_PARSER_BI__

#include once "tko.ti"
#include once "parser/expr.ti"
'' The parser tells the preprocessor what it has DECLARED, so 'defined( X )' can answer
'' for a TYPE or a CONST and not only for a macro -- see NoteDeclaredName_ in decl.tiko.
'' expr.tiko already reaches this header to pull tokens through PpEnsure.
#include once "pp/pp.ti"
'' 'class', 'interface' and 'implements' -- the parts that need no procedure parser.
#include once "parser/declclass.ti"

namespace Tko.Parse

    '' Parse a whole token vector as a module.
    declare function Unit( byref p as Tko.ParserState ) as Tko.NodeId

    '' One statement, or NODE_NONE at end of input.
    declare function Statement( byref p as Tko.ParserState ) as Tko.NodeId
    declare function CallStatement( byref p as Tko.ParserState ) as Tko.NodeId

    '' A syntactic type reference: 'integer', 'Foo ptr ptr', 'sub( byval as long )'.
    declare function TypeRef( byref p as Tko.ParserState ) as Tko.NodeId

    '' AUTO-PROPERTIES -- autoprop.tiko: a TYPE member 'declare property N as T get, set', and the
    '' accessor bodies it owes, written after 'end type' from the owner's name tokens.
    declare function AutoPropMember _
        ( byref p as Tko.ParserState, byref members as Tko.NodeIdVec, byval vis as uint32 ) as boolean
    declare sub AutoPropBodies( byref p as Tko.ParserState, byval own0 as int32, byval own1 as int32 )
    '' THE PROPERTY BLOCK -- propblock.tiko: 'property T.P as X' with 'get' / 'set' sections, rewritten
    '' in the buffer into the split form before the procedure parser reads it.
    declare sub PropertyBlock( byref p as Tko.ParserState )

    '' THE TEST BLOCK -- testblock.tiko: 'test "name" ... end test', registered with std/testing in a
    '' test build and dropped otherwise. EndTestHere_: the cursor is on the 'end test' closing one.
    declare function TestBlockHead( byref p as Tko.ParserState, byval k as Tko.TokenKind ) as boolean
    declare function TestBlock( byref p as Tko.ParserState ) as Tko.NodeId
    declare function EndTestHere_( byref p as Tko.ParserState ) as boolean
    '' 'match' -- match.tiko: at a statement's start, desugars a match statement, or the match
    '' expressions inside the statement, in the token buffer (docs/tiko-comparison RFC-0001-match).
    declare sub MatchRewrite( byref p as Tko.ParserState )
    '' 'err = x' / 'err => x' at a statement's start -- parserend.tiko.
    declare function ErrAssignStmt_( byref p as Tko.ParserState, byval k as Tko.TokenKind ) as boolean

    '' The procedures the builtin prelude declares, as "|name|name|...|" -- prelude.tiko.
    declare function PreludeProcSpellings( ) as string

    declare function DumpTree _
        ( byref ast as Tko.AstArena, byref src as Tko.SourceManager, _
          byref names as Tko.Interner, byval root as Tko.NodeId ) as string

end namespace

#endif
