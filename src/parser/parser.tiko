'' parser.tiko -- see parser.ti
''
'' StmtPayload slot conventions, by node kind:
''
''   N_IF          b = branch list (N_IF_BRANCH each), c = else block
''   N_IF_BRANCH   a = condition, b = body block
''   N_SELECT      a = subject, b = case list, c = case else block
''   N_CASE        b = body block, first/count = pattern list
''   N_CASE_RANGE  a = low, b = high, op = relational token for 'IS <op>'
''   N_FOR         a = counter, b = body, c = 'as T' TypeRef or NONE,
''                 children = [from, to, step], any of which may be NONE
''   N_FOREACH     a = loop variable, b = body, c = 'as T' TypeRef or NONE,
''                 children = [sequence]
''   N_DO/N_WHILE  a = condition, b = body
''   N_WITH        a = subject, b = body
''   N_SCOPE       b = body
''   N_RETURN      a = value
''   N_EXIT/N_CONT extra = level count, op = target keyword
''   N_GOTO/N_LABEL name
''   N_AMBIGUOUS   a = target expression, b = rhs, op = assignment token (0 = call),
''                 first/count = paren-less argument list
''   N_INTRINSIC   op = keyword, first/count = arguments
''   N_VAR         first/count = N_VAR_ITEM list, op = the declaring keyword
''   N_VAR_ITEM    name, a = typeref, b = initialiser, c = array bounds list
''   N_CONST       name, a = typeref, b = value
''   N_TYPE        name, first/count = members
''   N_FIELD       name, a = typeref, b = bitfield width
''   N_ENUM        name, first/count = N_ENUM_ITEM
''   N_ENUM_ITEM   name, b = value
''   N_PROC        name, a = return typeref, b = body, first/count = params, op = kind
''   N_PARAM       name, a = typeref, b = default value
''   N_NAMESPACE   name, first/count = members
''   N_TYPEREF     name, a = element typeref, first/count = args or dims

#import "std/containers"
#include once "parser/parser.ti"
#include once "parser/intrinsics.ti"
#include once "support/text.ti"
#include once "support/irtext.ti"
namespace Tko.Parse

declare function IsDeclarationStart( byval k as Tko.TokenKind ) as boolean
declare function Declaration( byref p as Tko.ParserState ) as Tko.NodeId
declare function Block( byref p as Tko.ParserState ) as Tko.NodeId : declare function BlockBody_( byref p as Tko.ParserState ) as Tko.NodeId

'' Defined in decl.tiko, which is compiled after this file: the body rewrite that turns
'' the destructuring FOR EACH into the ordinary one.
declare function ForEachDestructure_ _
    ( byref p as Tko.ParserState, byref t as Tko.Token, byval tmpName as Tko.InternId, _
      byref names as Tko.NodeIdVec, byval body as Tko.NodeId ) as Tko.NodeId
declare sub EndOfStatement( byref p as Tko.ParserState )

'' Defined in parserend.tiko, included after this file: what closes a block, and what
'' closes a single-line statement.
declare function NextTokIs_ _
    ( byref p as Tko.ParserState, byval k as Tko.TokenKind ) as boolean
declare function ClosesABlock( byval k as Tko.TokenKind ) as boolean
declare function IsBlockEnderAt( byref p as Tko.ParserState ) as boolean
declare sub MarkLetList_( byref p as Tko.ParserState, byval n as Tko.NodeId )
declare function AcceptNext_( byref p as Tko.ParserState, byval openedAt as Tko.SourceLoc = 0, byval isEach as boolean = false ) as boolean
declare function IsLabelHere_( byref p as Tko.ParserState ) as boolean
declare function ParenlessFnCall_( byref p as Tko.ParserState, byval callee as Tko.NodeId, _
    byval loc as Tko.SourceLoc, byref args as Tko.NodeIdVec ) as Tko.NodeId
declare sub EndOperand_( byref p as Tko.ParserState, byref ep as Tko.StmtPayload ) : declare function IsRelOp_( byval k as Tko.TokenKind ) as boolean : declare function EndsSingleLineStmt( byref p as Tko.ParserState ) as boolean : declare sub HeaderIdent_( byref p as Tko.ParserState, byref sp as Tko.StmtPayload, byval onm as Tko.InternId ) : declare sub ParenGroupOperand_( byref p as Tko.ParserState, byref sp as Tko.StmtPayload, byref args as Tko.NodeIdVec )
declare function CheckEndOfStatement_( byref p as Tko.ParserState, byval n as Tko.NodeId = Tko.NODE_NONE ) as boolean
declare function EndClosesOther_ _
    ( byref p as Tko.ParserState, byval what as Tko.TokenKind ) as boolean

'' Defined in selchan.tiko, included after this file: 'select channel' and its test.
declare function SelectIsChannel_( byref p as Tko.ParserState ) as boolean
declare function ParseSelectChannel_ _
    ( byref p as Tko.ParserState, byref t as Tko.Token ) as Tko.NodeId
declare sub SkipEols( byref p as Tko.ParserState )
declare sub AsmReserveInBlock_( byref p as Tko.ParserState, byval blockAt as Tko.SourceLoc )  '' declempty.tiko
declare function AtEnd( byref p as Tko.ParserState ) as boolean
declare function ParseIntrinsic( byref p as Tko.ParserState ) as Tko.NodeId
declare sub ParseParamList( byref p as Tko.ParserState, byref sp as Tko.StmtPayload )

function AtEnd( byref p as Tko.ParserState ) as boolean
    return (Peek( p ) = Tko.TK_EOF) orelse p.diags->Stopped( )     '' the error cap ends it too
end function

sub SkipEols( byref p as Tko.ParserState )
    while Peek( p ) = Tko.TK_EOL
        Advance( p )
    wend
end sub

sub EndOfStatement( byref p as Tko.ParserState )
    if p.pendingNext > 0 then return       '' 'next x, y': the rest is the next FOR's
    '' A statement never consumes more than its own terminator.
    ''
    '' WHAT IT PASSES OVER, IT DISCARDS -- silently, which is the point of the ELSE
    '' exception below. Inside the then-branch of a SINGLE-LINE IF the 'else' on the
    '' same line belongs to the IF, not to the statement just parsed, and walking past
    '' it threw the whole else branch away with no diagnostic: 'if c then a else b'
    '' came out as one branch and counted as fully lowered while fbc ran the other arm.
    while (Peek( p ) <> Tko.TK_EOL) andalso (AtEnd( p ) = false)
        if p.stopAtElse then
            if Peek( p ) = Tko.KW_ELSE then return
            '' ...AND 'END IF' CLOSES IT TOO, for the same reason and at the same
            '' cost: 'if 0 then y = 1 end if: y = 2' walked past the 'end if', ate
            '' the ':' as its terminator, and the branch loop took 'y = 2' INTO THE
            '' THEN-BRANCH, so it ran only when the condition held -- fbc leaves
            '' y = 2 and tiko left 0. numbers/cast_f2l.bas and cast_f2ll.bas define
            '' CU_ASSERT_EQUAL in exactly that shape, so EVERY assertion in both
            '' vanished into a branch that never ran and both reported zero.
            if Peek( p ) = Tko.KW_ENDIF then return
            if Peek( p ) = Tko.KW_END then
                if HasTok( p, p.pos + 1 ) then
                    if p.toks->At( p.pos + 1 ).kind = cast( uint8, Tko.KW_IF ) then
                        return
                    end if
                end if
            end if
        end if
        Advance( p )
    wend
    if Peek( p ) = Tko.TK_EOL then Advance( p )
end sub

'' Recovery: consume to the next line, guaranteeing progress so no input can loop.
private sub Sync( byref p as Tko.ParserState )
    dim as int32 before = p.pos
    EndOfStatement( p )
    if p.pos = before then Advance( p )
end sub

''  Does an '=' follow the token at the cursor? Used to tell a statement intrinsic
'' from a variable or field of the same name. '==' is not an operator in FreeBASIC, so
'' a single TK_EQ is unambiguous.
private function FollowedByAssign( byref p as Tko.ParserState ) as boolean
    if HasTok( p, p.pos + 1 ) = false then return false
    return (cast( Tko.TokenKind, p.toks->At( p.pos + 1 ).kind ) = Tko.TK_EQ)
end function

'' A statement list, stopping before whatever closes the enclosing construct.
function BlockBody_( byref p as Tko.ParserState ) as Tko.NodeId
    dim as Tko.Token t = Cur( p )
    dim as Tko.NodeIdVec items
    do
        if p.pendingNext > 0 then exit do      '' 'next x, y' -- see AcceptNext_
        SkipEols( p )
        AsmReserveInBlock_( p, t.loc )
        if AtEnd( p ) then exit do
        if IsBlockEnderAt( p ) then exit do
        dim as Tko.NodeId s = Statement( p )
        if s <> Tko.NODE_NONE then items.Push( cast( uint32, s ) )
    loop
    return MakeList( p, Tko.N_BLOCK, t.loc, Tko.NODE_NONE, items )
end function

'' 'END IF', 'END SUB' ... -- accepted with or without the trailing keyword, because
'' fbc accepts both and a missing one is diagnosed by the caller, not here.
'' 'expected end X' WITHOUT saying where X opened is a poor diagnostic, and it cost a
'' long session: the parser runs to EOF, the error lands on the last line of the file,
'' and nothing points at the construct that was never closed. The opener's location is
'' in hand at every call site, so it is carried and reported as a note.
private sub ExpectEnd _
    ( byref p as Tko.ParserState, byval what as Tko.TokenKind, _
      byval openedAt as Tko.SourceLoc = 0 )

    '' 'endif' is one token and closes an IF on its own.
    if (what = Tko.KW_IF) andalso (Peek( p ) = Tko.KW_ENDIF) then
        Advance( p )
        return
    end if
    '' ...NOT AN END CLOSING ANOTHER BLOCK: taken as ours, 'end sub' inside an unclosed
    '' IF left SUB on the line and the SUB ran on to end of file.
    if EndClosesOther_( p, what ) = false then
        if Accept( p, Tko.KW_END ) then
            if Peek( p ) = what then Advance( p )
            return
        end if
    end if
    ErrorNode( p, Tko.TKO0405, Tko.TokenKindText( what ) )
    if openedAt <> 0 then
        p.diags->AddNote( Tko.TKO0905, Tko.PointRange( openedAt ), _
                          Tko.TokenKindText( what ) )
    end if
end sub

'' ---------------------------------------------------------------- type references

#include once "parser/typeref.tiko"

'' ------------------------------------------------------------------- statements

private function ParseIf( byref p as Tko.ParserState ) as Tko.NodeId
    dim as Tko.Token t = Cur( p )
    Advance( p )

    dim as Tko.StmtPayload sp
    dim as Tko.NodeIdVec branches

    dim as Tko.StmtPayload first_
    first_.a = Expression( p )
    if Peek( p ) = Tko.KW_THEN then Advance( p )

    '' 'if c then stmt' on one line is the same node with a flag, so semantics and
    '' lowering see one shape (docs/plan/04 section 4).
    dim as boolean singleLine = (Peek( p ) <> Tko.TK_EOL) andalso (AtEnd( p ) = false)
    if singleLine then
        dim as Tko.NodeIdVec one
        '' 'if (e) then else stmt' -- AN EMPTY THEN-BRANCH, which is legal and which
        '' the corpus writes: optimizations/self_compare.bas defines CHECK_TRUE as
        '' 'if (e) then else CU_FAIL( ... )'. Asked for a statement, the parser found
        '' ELSE and reported 'expected a statement' -- the one shape here that fails
        '' LOUDLY rather than silently.
        if Peek( p ) <> Tko.KW_ELSE then
            '' AN ELSE ON THIS LINE IS THIS IF'S. Without the flag, the statement
            '' layer's EndOfStatement walked to the line's end and discarded
            '' 'else print "b"' whole -- see EndOfStatement. Saved and restored
            '' rather than set and cleared, because 'if a then if b then x else y'
            '' nests one of these inside another and the ELSE binds to the INNER if.
            dim as boolean savedSAE = p.stopAtElse
            p.stopAtElse = true
            '' EVERY STATEMENT ON THE LINE, not just the first. 'if c then a : b'
            '' puts BOTH in the then-branch -- one statement was taken and 'b' fell
            '' out into the enclosing block, where it ran UNCONDITIONALLY.
            ''
            '' Measured, and it is the corpus's own idiom:
            ''
            ''     if( n = 0 ) then g_destroyed += 1 : deallocate( s )
            ''
            '' -- com/comptr-noimport.bas's Release_. The deallocate ran on EVERY
            '' call, so the first Release freed the object and the second wrote
            '' through it: 0xC0000374, heap corruption, with the right answer
            '' printed on the way past.
            ''
            '' ':' AND A NEWLINE BOTH LEX AS AN EOL, and the SEPARATOR THE LAST
            '' STATEMENT ATE is what says which. TF_COLON exists for exactly this
            '' question -- 'name:' is a label and 'name' alone is a call -- and it
            '' survives macro expansion, which the physical line does NOT: every
            '' token of an expansion carries the invocation's location, so three
            '' consecutive 'assert_( ... )' lines looked like one line and the
            '' second and third were swallowed into the first's then-branch.
            dim as int32 slGuard = 0
            do
                slGuard += 1
                if slGuard > 10000 then exit do
                dim as Tko.NodeId s = Statement( p )
                if s <> Tko.NODE_NONE then one.Push( cast( uint32, s ) )
                if s = Tko.NODE_NONE then exit do
                if AtEnd( p ) then exit do
                if p.pos <= 0 then exit do
                if (p.toks->At( p.pos - 1 ).flags and Tko.TF_COLON) = 0 then exit do
                if (Peek( p ) = Tko.KW_ELSE) orelse (Peek( p ) = Tko.KW_ENDIF) then exit do
                '' 'if c then s : end if' closes the IF; 'if c then end' is the END
                '' STATEMENT and is this branch's last statement, so only the pair
                '' stops the loop.
                if Peek( p ) = Tko.KW_END then
                    if HasTok( p, p.pos + 1 ) then
                        if p.toks->At( p.pos + 1 ).kind = cast( uint8, Tko.KW_IF ) then
                            exit do
                        end if
                    end if
                end if
            loop
            p.stopAtElse = savedSAE
        end if
        first_.b = MakeList( p, Tko.N_BLOCK, t.loc, Tko.NODE_NONE, one )
        branches.Push( cast( uint32, MakeStmt( p, Tko.N_IF_BRANCH, t.loc, first_ ) ) )

        '' ...and the ELSE that follows an empty then-branch is this IF's, so it is
        '' taken here. The two halves are inseparable: leaving the ELSE for the
        '' enclosing statement loop reports the same 'expected a statement' one token
        '' later.
        ''
        '' BOTH SHAPES REACH HERE: an EMPTY then-branch leaves the cursor on the
        '' 'else' because nothing ate the line, and a then-STATEMENT leaves it there
        '' because 'stopAtElse' told EndOfStatement to stop short of it.
        '' ...AND ONLY IF THE LINE DID NOT END FIRST. The 'end if' test below already
        '' applies that rule; the ELSE did not, so a SINGLE-LINE if nested inside a
        '' BLOCK if stole the block's else:
        ''
        ''   if( c ) then / if( i > 0 ) then return -1 / else / b = 9 / end if
        '' fbc answers 9, -1, 3 for the three inputs and tiko answered 3, -1, 9 --
        '' the arms swapped. That is verbatim the shape of IPowChecked in
        '' fb/mathint.bi, so a SHIPPED HEADER was being miscompiled.
        ''
        '' ':' and a newline both lex as an EOL and TF_COLON tells them apart; a '_'
        '' continuation produces NO token at all. So 'a : b else' and 'a _ else' are
        '' ours and 'a <newline> else' is not. A PHYSICAL-LINE test cannot draw this
        '' line -- the continued form spans several physical lines and is one
        '' statement.
        dim as boolean elseIsOurs = (Peek( p ) = Tko.KW_ELSE)
        if elseIsOurs andalso (p.pos > 0) then
            dim as Tko.Token ptr pv = @p.toks->At( p.pos - 1 )
            if pv->kind = cast( uint8, Tko.TK_EOL ) then
                elseIsOurs = ((pv->flags and Tko.TF_COLON) <> 0)
            end if
        end if
        if elseIsOurs then
            Advance( p )
            '' EVERY STATEMENT ON THE LINE HERE TOO. The then-branch above already
            '' loops; the else-branch took ONE statement and the rest fell out into
            '' the ENCLOSING block, where they ran unconditionally:
            ''
            ''     b = 2 : if 0 then b = 3 else dim as integer a = 5: b = a
            ''
            '' left 'b = a' at module level, so b kept 2 where fbc gives 5. It is
            '' the corpus's own idiom -- compound/if.bas's test_singleline_scope
            '' writes all three arms that way over line continuations.
            dim as Tko.NodeIdVec eone
            dim as int32 elGuard = 0
            '' ...AND THE SAME STOP, so an 'end if' after the else-statement is left for
            '' this IF below rather than walked past and discarded -- see EndOfStatement.
            dim as boolean elSavedSAE = p.stopAtElse
            p.stopAtElse = true
            do
                elGuard += 1
                if elGuard > 10000 then exit do
                dim as Tko.NodeId es = Statement( p )
                if es <> Tko.NODE_NONE then eone.Push( cast( uint32, es ) )
                if es = Tko.NODE_NONE then exit do
                if AtEnd( p ) then exit do
                if p.pos <= 0 then exit do
                '' The SEPARATOR THE LAST STATEMENT ATE says whether the line went
                '' on -- ':' and a newline lex alike, and only TF_COLON tells them
                '' apart. Same rule as the then-branch's loop.
                if (p.toks->At( p.pos - 1 ).flags and Tko.TF_COLON) = 0 then exit do
                if (Peek( p ) = Tko.KW_ELSE) orelse (Peek( p ) = Tko.KW_ENDIF) then exit do
                if Peek( p ) = Tko.KW_END then
                    if HasTok( p, p.pos + 1 ) then
                        if p.toks->At( p.pos + 1 ).kind = cast( uint8, Tko.KW_IF ) then
                            exit do
                        end if
                    end if
                end if
            loop
            p.stopAtElse = elSavedSAE
            sp.c = MakeList( p, Tko.N_BLOCK, t.loc, Tko.NODE_NONE, eone )
        end if
        '' 'if c then s : end if' terminates explicitly. ':' and a newline both lex
        '' as an EOL, so the token kinds cannot tell them apart -- only the LINE can:
        ''
        ''     if ( a mod b ) <> 0 then        <- a block IF
        ''         if negA <> negB then q -= 1 <- a single-line IF
        ''     end if                          <- belongs to the BLOCK if
        ''
        '' Taking that 'end if' because it merely came next left the block IF open,
        '' which then consumed the enclosing 'end function', which left a namespace
        '' unclosed hundreds of lines later. The 'end' is this IF's only if it is on
        '' this IF's own line.
        if (Peek( p ) = Tko.KW_END) andalso HasTok( p, p.pos + 1 ) then
            if p.toks->At( p.pos + 1 ).kind = cast( uint8, Tko.KW_IF ) then
                if p.src->Decode( Cur( p ).loc ).physLine = _
                   p.src->Decode( t.loc ).physLine then
                    Advance( p )
                    Advance( p )
                end if
            end if
        end if
        '' 'endif' is the same close in one word -- fbc accepts 'if 1 then print endif'
        '' -- and was left for the enclosing block, which it then closed.
        if Peek( p ) = Tko.KW_ENDIF then
            if p.src->Decode( Cur( p ).loc ).physLine = p.src->Decode( t.loc ).physLine then
                Advance( p )
            end if
        end if

        dim as Tko.NodeId n = MakeStmt( p, Tko.N_IF, t.loc, sp )
        p.ast->OrFlags( n, Tko.NF_SINGLE_LINE )
        dim as Tko.StmtPayload done_
        done_.b = MakeList( p, Tko.N_BLOCK, t.loc, Tko.NODE_NONE, branches )
        '' THE ELSE BLOCK TRAVELS IN 'c', and this payload REPLACES the node's, so
        '' it has to be carried across or the branch just parsed is thrown away.
        done_.c = sp.c
        *p.ast->StmtAt( cast( int32, p.ast->DataOf( n ) ) ) = done_
        return n
    end if

    first_.b = Block( p )
    branches.Push( cast( uint32, MakeStmt( p, Tko.N_IF_BRANCH, t.loc, first_ ) ) )

    while Peek( p ) = Tko.KW_ELSEIF
        dim as Tko.Token et = Cur( p )
        Advance( p )
        dim as Tko.StmtPayload br
        br.a = Expression( p )
        if Peek( p ) = Tko.KW_THEN then Advance( p )
        br.b = Block( p )
        branches.Push( cast( uint32, MakeStmt( p, Tko.N_IF_BRANCH, et.loc, br ) ) )
    wend

    if Accept( p, Tko.KW_ELSE ) then sp.c = Block( p )

    sp.b = MakeList( p, Tko.N_BLOCK, t.loc, Tko.NODE_NONE, branches )
    ExpectEnd( p, Tko.KW_IF )
    return MakeStmt( p, Tko.N_IF, t.loc, sp )
end function

private function ParseSelect( byref p as Tko.ParserState ) as Tko.NodeId
    dim as Tko.Token t = Cur( p )
    Advance( p )
    '' 'select channel' IS A DIFFERENT STATEMENT, not a SELECT CASE with a subject
    '' called 'channel'. Read as one, its cases were patterns -- 'receive', 'timeout'
    '' -- and 'v from ch' was demoted into the case BODY, which parsed without error
    '' and only showed up as skips in lowering.
    if SelectIsChannel_( p ) then return ParseSelectChannel_( p, t )
    if Peek( p ) = Tko.KW_CASE then Advance( p )
    '' 'as const' IS RECORDED, not just consumed. fbc builds a JUMP TABLE for it and
    '' refuses four things it accepts in a plain SELECT -- 'is', a non-constant case,
    '' a backwards range, and a span over 8192 -- so the flag has to survive parsing
    '' or Resolve cannot tell the two statements apart. It rides in 'op', which is
    '' unused on an N_SELECT.
    dim as boolean isConst = false
    if Peek( p ) = Tko.KW_AS then
        Advance( p )                          '' 'select case as const'
        if Peek( p ) = Tko.KW_CONST then
            Advance( p )
            isConst = true
        end if
    end if

    dim as Tko.StmtPayload sp
    if isConst then sp.op = cast( uint16, Tko.KW_CONST )
    sp.a = Expression( p )

    dim as Tko.NodeIdVec cases
    do
        SkipEols( p )
        if Peek( p ) <> Tko.KW_CASE then exit do
        dim as Tko.Token ct = Cur( p )
        Advance( p )

        if Accept( p, Tko.KW_ELSE ) then
            if sp.c <> Tko.NODE_NONE then p.diags->Report( Tko.TKO0956, Tko.PointRange( ct.loc ) )   '' fbc's 35
            sp.c = Block( p )
            continue do
        end if

        dim as Tko.StmtPayload cs
        dim as Tko.NodeIdVec patterns
        do
            dim as Tko.Token pt = Cur( p )
            dim as Tko.StmtPayload pat
            if Accept( p, Tko.KW_IS ) then
                '' Measured: 'case is > 5' under AS CONST is fbc error 9, "Expected
                '' expression, found 'is'" -- refused at the 'is' itself, before the
                '' relation is even read. A table index cannot be a comparison.
                if isConst then
                    p.diags->Report( Tko.TKO0419, Tko.PointRange( pt.loc ) )
                end if
                if IsRelOp_( Peek( p ) ) = false then ErrorNode( p, Tko.TKO0401, "a relational operator" )   '' fbc's 285
                pat.op = cast( uint16, Peek( p ) )
                Advance( p )
                pat.a = Expression( p )
                patterns.Push( cast( uint32, MakeStmt( p, Tko.N_CASE_RANGE, pt.loc, pat ) ) )
            else
                pat.a = Expression( p )
                if Accept( p, Tko.KW_TO ) then
                    pat.b = Expression( p )
                    patterns.Push( cast( uint32, MakeStmt( p, Tko.N_CASE_RANGE, pt.loc, pat ) ) )
                else
                    patterns.Push( cast( uint32, pat.a ) )
                end if
            end if
            if Accept( p, Tko.TK_COMMA ) = false then exit do
        loop

        cs.first = p.ast->ChildPoolCount( )
        cs.count = patterns.Count
        for i as int32 = 0 to patterns.Count - 1
            p.ast->PushChild( patterns[i] )
        next
        cs.b = Block( p )
        cases.Push( cast( uint32, MakeStmt( p, Tko.N_CASE, ct.loc, cs ) ) )
    loop

    '' fbc error 34, "Expected 'CASE', found 'end'" -- and it fires on a PLAIN select
    '' too, not only AS CONST. A lone 'case else' satisfies it: that is why the test is
    '' on both slots and not on the case count alone.
    dim as boolean hasElse = (sp.c <> Tko.NODE_NONE)
    if (cases.Count = 0) andalso (hasElse = false) then
        p.diags->Report( Tko.TKO0418, Tko.PointRange( t.loc ) )
    end if

    sp.b = MakeList( p, Tko.N_BLOCK, t.loc, Tko.NODE_NONE, cases )
    ExpectEnd( p, Tko.KW_SELECT )
    return MakeStmt( p, Tko.N_SELECT, t.loc, sp )
end function

private function ParseFor( byref p as Tko.ParserState ) as Tko.NodeId
    dim as Tko.Token t = Cur( p )
    Advance( p )

    '' FOR EACH is FBC-Modern's; 'each' is CONTEXTUAL, so it arrives as an identifier
    '' and is recognised by spelling (probes V2).
    dim as boolean isEach = false
    if Peek( p ) = Tko.TK_IDENT then
        dim as Tko.InternId id = cast( Tko.InternId, Cur( p ).literal )
        if p.names->Spelling( id ) = "each" then
            '' 'each' IS AN ORDINARY IDENTIFIER, so 'for each as long = 1 to 3' and
            '' 'for each = 4 to 6' are counted loops over a variable that happens to be
            '' called that -- both of which fbc compiles. What separates them is the
            '' NEXT token: the counted form always has AS or '=' after the counter's
            '' name, and FOR EACH never does (a name, '(' or 'in' follows). Without the
            '' lookahead 'each' was eaten as the marker and the rest read as a
            '' sequence, which is a parse error two tokens later.
            isEach = true
            if HasTok( p, p.pos + 1 ) then
                dim as Tko.TokenKind nk = cast( Tko.TokenKind, p.toks->At( p.pos + 1 ).kind )
                if (nk = Tko.KW_AS) orelse (nk = Tko.TK_EQ) then isEach = false
            end if
            if isEach then Advance( p )
        end if
    end if

    dim as Tko.StmtPayload sp
    if isEach then
        dim as boolean isByref = false
        if Accept( p, Tko.KW_BYREF ) then
            isByref = true
            sp.op = cast( uint16, Tko.KW_BYREF )
        end if

        '' 'for each (k, v) in c' -- THE LIST FORM, desugared here into the ordinary
        '' one over a hidden element and one 'var' per name:
        ''
        ''     for each $fe<n> in c
        ''         var k = $fe<n>._1, v = $fe<n>._2
        ''         BODY
        ''     next
        ''
        '' -- a shape every later pass already handles completely, which is why this
        '' is a parse rewrite and not a lowering of its own. Each name is typed by ITS
        '' OWN element rather than by the tuple, the element is evaluated once, a
        '' STRING half is copy-initialised by the ordinary declaration path so it owns
        '' its data, and the names are redeclared per iteration because they are
        '' declared INSIDE the body -- which is what makes the ctor/dtor counts balance.
        dim as Tko.NodeIdVec dnames
        dim as Tko.InternId feTmp = Tko.INTERN_NONE
        if Peek( p ) = Tko.TK_LPAREN then
            '' BYREF binds the whole element or nothing: there is no spelling for one
            '' name by reference and another by value.
            if isByref then return ErrorNode( p, Tko.TKO0411 )
            Advance( p )
            do
                if Peek( p ) <> Tko.TK_IDENT then return ErrorNode( p, Tko.TKO0406 )
                dnames.Push( cast( uint32, cast( Tko.InternId, Cur( p ).literal ) ) )
                Advance( p )
                if Accept( p, Tko.TK_COMMA ) = false then exit do
            loop
            Expect( p, Tko.TK_RPAREN, ")" )
            '' '(a)' IS A PARENTHESISED EXPRESSION everywhere else in the grammar, and
            '' one name has nothing to destructure, so it is rejected here rather than
            '' silently taken as either.
            if dnames.Count < 2 then return ErrorNode( p, Tko.TKO0412 )
            p.destructureSeq += 1
            feTmp = p.names->GetString( "$fe" & str( p.destructureSeq ) )
            dim as Tko.IdentPayload tip
            tip.name = feTmp
            p.ast->PushIdent( tip )
            sp.a = NewNodeAt( p, Tko.N_IDENT, t.loc, cast( uint32, p.ast->IdentPoolCount( ) - 1 ) )
        else
            sp.a = Expression( p, Tko.PREC_POSTFIX )
        end if

        if Accept( p, Tko.KW_AS ) then
            '' One type cannot describe elements that differ, and per-name types would
            '' spell out what the tuple already says.
            if dnames.Count > 0 then return ErrorNode( p, Tko.TKO0410 )
            sp.c = TypeRef( p )
        end if
        '' 'in' is contextual too.
        if Peek( p ) = Tko.TK_IDENT then
            dim as Tko.InternId id = cast( Tko.InternId, Cur( p ).literal )
            if p.names->Spelling( id ) = "in" then Advance( p )
        end if
        dim as Tko.NodeId seq = Expression( p )
        sp.first = p.ast->ChildPoolCount( )
        sp.count = 1
        p.ast->PushChild( cast( uint32, seq ) )
        p.forDepth += 1
        sp.b = Block( p )
        p.forDepth -= 1
        dim as uint16 eachFlags = 0
        if dnames.Count > 0 then
            sp.b = ForEachDestructure_( p, t, feTmp, dnames, sp.b )
            eachFlags = Tko.NF_DESTRUCTURE
        end if
        AcceptNext_( p, t.loc, true )
        dim as Tko.NodeId en = MakeStmt( p, Tko.N_FOREACH, t.loc, sp )
        p.ast->OrFlags( en, eachFlags )
        return en
    end if

    sp.a = Expression( p, Tko.PREC_POSTFIX )
    if Accept( p, Tko.KW_AS ) then sp.c = TypeRef( p )

    '' children are ALWAYS the three slots [from, to, step], NODE_NONE where absent.
    '' They used to be a packed list with the step in 'c', which silently overwrote
    '' the 'as T' TypeRef parsed above -- 'for i as integer' lost its type.
    dim as Tko.NodeIdVec bounds
    dim as Tko.NodeId fromExpr = Tko.NODE_NONE
    dim as Tko.NodeId toExpr = Tko.NODE_NONE
    dim as Tko.NodeId stepExpr = Tko.NODE_NONE
    '' 'for j => 1 to 2' -- the same synonym, in the initialiser.
    '' TWO SIDE-EFFECTING CALLS IN ONE 'orelse' DO NOT BEHAVE. Written as
    '' 'if Accept( TK_EQ ) orelse Accept( TK_FATARROW ) then', the arrow was consumed and
    '' the TOKEN AFTER IT went missing -- this very line lost the 'to 3' of
    '' 'for j => 1 to 3'. Each Accept advances, so they are sequenced explicitly.
    dim as boolean sawInit = Accept( p, Tko.TK_EQ )
    if sawInit = false then sawInit = Accept( p, Tko.TK_FATARROW )
    if sawInit then fromExpr = Expression( p )
    if Expect( p, Tko.KW_TO, "to" ) then toExpr = Expression( p )   '' fbc's 12: 'for i = 1' was an ICE
    if Accept( p, Tko.KW_STEP ) then stepExpr = Expression( p )

    sp.first = p.ast->ChildPoolCount( )
    sp.count = 3
    p.ast->PushChild( cast( uint32, fromExpr ) )
    p.ast->PushChild( cast( uint32, toExpr ) )
    p.ast->PushChild( cast( uint32, stepExpr ) )

    p.forDepth += 1
    sp.b = Block( p )
    p.forDepth -= 1
    if sp.b <> Tko.NODE_NONE then p.ast->SetLoc( sp.b, Cur( p ).loc )   '' the NEXT, for diagnostics
    AcceptNext_( p, t.loc )

    return MakeStmt( p, Tko.N_FOR, t.loc, sp )
end function

private function ParseDo( byref p as Tko.ParserState ) as Tko.NodeId
    dim as Tko.Token t = Cur( p )
    Advance( p )

    dim as Tko.StmtPayload sp
    dim as uint16 flags = 0

    if Peek( p ) = Tko.KW_WHILE then
        Advance( p )
        sp.a = Expression( p )
    elseif Peek( p ) = Tko.KW_UNTIL then
        Advance( p )
        flags or= Tko.NF_UNTIL
        sp.a = Expression( p )
    end if

    sp.b = Block( p )

    if Accept( p, Tko.KW_LOOP ) then
        if Peek( p ) = Tko.KW_WHILE then
            Advance( p )
            flags or= Tko.NF_POST_COND
            sp.c = Expression( p )
        elseif Peek( p ) = Tko.KW_UNTIL then
            Advance( p )
            flags or= Tko.NF_POST_COND or Tko.NF_UNTIL
            sp.c = Expression( p )
        end if
    else
        ErrorNode( p, Tko.TKO0405, "loop" )
    end if

    dim as Tko.NodeId n = MakeStmt( p, Tko.N_DO, t.loc, sp )
    p.ast->OrFlags( n, flags )
    return n
end function

private function ParseWhile( byref p as Tko.ParserState ) as Tko.NodeId
    dim as Tko.Token t = Cur( p )
    Advance( p )
    dim as Tko.StmtPayload sp
    sp.a = Expression( p )
    sp.b = Block( p )
    if Accept( p, Tko.KW_WEND ) = false then ExpectEnd( p, Tko.KW_WHILE )
    return MakeStmt( p, Tko.N_WHILE, t.loc, sp )
end function

private function ParseWith( byref p as Tko.ParserState ) as Tko.NodeId
    dim as Tko.Token t = Cur( p )
    Advance( p )
    dim as Tko.StmtPayload sp
    sp.a = Expression( p )
    sp.b = Block( p )
    ExpectEnd( p, Tko.KW_WITH )
    return MakeStmt( p, Tko.N_WITH, t.loc, sp )
end function

private function ParseScope( byref p as Tko.ParserState ) as Tko.NodeId
    dim as Tko.Token t = Cur( p )
    Advance( p )
    dim as Tko.StmtPayload sp
    sp.b = Block( p )
    ExpectEnd( p, Tko.KW_SCOPE )
    return MakeStmt( p, Tko.N_SCOPE, t.loc, sp )
end function

private function ParseExitLike _
    ( byref p as Tko.ParserState, byval kind as Tko.NodeKind ) as Tko.NodeId

    dim as Tko.Token t = Cur( p )
    Advance( p )
    dim as Tko.StmtPayload sp
    sp.extra = 0
    '' 'exit for, for' names the target repeatedly; count how deep it goes.
    do
        dim as Tko.TokenKind k = Peek( p )
        dim as boolean target = (k = Tko.KW_FOR) orelse (k = Tko.KW_DO) orelse _
                                (k = Tko.KW_WHILE) orelse (k = Tko.KW_SELECT) orelse _
                                (k = Tko.KW_SUB) orelse (k = Tko.KW_FUNCTION) orelse _
                                (k = Tko.KW_SCOPE) orelse (k = Tko.KW_PROPERTY) orelse _
                                (k = Tko.KW_CONSTRUCTOR) orelse (k = Tko.KW_DESTRUCTOR) orelse _
                                (k = Tko.KW_OPERATOR) orelse (k = Tko.KW_ANY)
        if target = false then exit do
        if sp.op = 0 then sp.op = cast( uint16, k )
        sp.extra += 1
        Advance( p )
        if Accept( p, Tko.TK_COMMA ) = false then exit do
    loop
    return MakeStmt( p, kind, t.loc, sp )
end function

'' A KEYWORD directly followed by '(' is an expression, not a statement -- 'cast(...)',
'' 'mid(...)', 'cuint(...)', 'strptr(...)'. It is safe to say so this late in the
'' dispatch: every keyword that BEGINS a statement has already been matched by the
'' cases above, by IsDeclarationStart, or by IsStatementIntrinsic, which deliberately
'' excludes the IFORM_EXPR family for exactly this reason -- 'x = len(s)' must not
'' parse as a LEN statement.
''
'' Testing the '(' rather than enumerating the keywords is what makes this cover the
'' whole conversion family without a list that would go stale.
'' 'type<UDT>( ... )' AT THE HEAD OF A STATEMENT -- the TYPE LITERAL, not a type
'' declaration. A '<' immediately after the keyword settles it: a declaration is
'' 'type Name', and none of the shapes IsDeclarationStart covers can have '<' there.
''
'' Without this, 'type<UDT>( ).copyToGlobal( )' went to the declaration parser and came
'' back as TKO0406, 'expected an identifier', while the very same expression inside a
'' PRINT parsed and lowered -- only the statement position consults IsDeclarationStart.
'' structs/anon-access.bas writes both spellings on adjacent lines.
function IsTypeLiteralHere( byref p as Tko.ParserState ) as boolean
    if Peek( p ) <> Tko.KW_TYPE then return false
    if HasTok( p, p.pos + 1 ) = false then return false
    return (cast( Tko.TokenKind, p.toks->At( p.pos + 1 ).kind ) = Tko.TK_LT)
end function

private function KeywordLedExpression _
    ( byref p as Tko.ParserState, byval k as Tko.TokenKind ) as boolean

    if Tko.IsKeywordKind( k ) = false then return false
    '' The type literal is keyword-led too, and its second token is '<' rather than
    '' the '(' every other one has.
    if IsTypeLiteralHere( p ) then return true
    if HasTok( p, p.pos + 1 ) = false then return false
    return (cast( Tko.TokenKind, p.toks->At( p.pos + 1 ).kind ) = Tko.TK_LPAREN)
end function

'' Whether the parenthesised group starting at 'at' is a PARAMETER LIST rather than an
'' expression. Decided by AS, BYREF or BYVAL appearing at depth one -- a parameter
'' cannot be written without one of them, and an expression cannot contain one there.
private function LooksLikeParamList _
    ( byref p as Tko.ParserState, byval at as int32 ) as boolean

    dim as int32 depth = 0
    dim as int32 i = at
    '' Bounded: a runaway scan over a file with an unbalanced paren would otherwise
    '' walk the whole token stream on every 'operator ='.
    dim as int32 guard = 0
    while HasTok( p, i ) andalso (guard < 4096)
        dim as Tko.TokenKind k = cast( Tko.TokenKind, p.toks->At( i ).kind )
        select case k
        case Tko.TK_LPAREN
            depth += 1
        case Tko.TK_RPAREN
            depth -= 1
            if depth <= 0 then return false
        case Tko.KW_AS, Tko.KW_BYREF, Tko.KW_BYVAL
            if depth = 1 then return true
        case Tko.TK_EOL
            return false
        end select
        i += 1
        guard += 1
    wend
    return false
end function


'' 'function =' / 'operator =' / 'property =', and nothing else that starts with one
'' of those keywords. The cross-kind rules fbc enforces -- 'function =' is a syntax
'' error inside a SUB -- are deliberately NOT checked here: accepting a little more
'' than fbc never loses a file, and rejecting a little more would.
private function IsResultAssign _
    ( byref p as Tko.ParserState, byval k as Tko.TokenKind ) as boolean

    dim as boolean isResultKw = (k = Tko.KW_FUNCTION) orelse _
                                (k = Tko.KW_OPERATOR) orelse (k = Tko.KW_PROPERTY)
    if isResultKw = false then return false
    if HasTok( p, p.pos + 1 ) = false then return false
    '' '=>' IS THE OTHER ASSIGNMENT TOKEN and is legal here too: 'function => i'
    '' and 'operator => i' are quirk/assignment-token.bas's spellings, and testing
    '' for TK_EQ alone made each of them 'expected end FUNCTION' -- which loses the
    '' REST OF THE BODY, not just that line. PROPERTY was unaffected only because
    '' its body happened to end before the arrow could matter.
    dim as Tko.TokenKind rk = cast( Tko.TokenKind, p.toks->At( p.pos + 1 ).kind )
    if (rk <> Tko.TK_EQ) andalso (rk <> Tko.TK_FATARROW) then return false

    '' 'operator = ( a, b ) as string' IS A DEFINITION, not a result assignment, and
    '' the comment on the caller has always said the two are told apart by what
    '' follows the '='. But a '(' ALONE IS NOT ENOUGH: inside an operator body
    '' 'operator = ( v + 1 )' is a result assignment of a parenthesised expression,
    '' and treating that as a definition loses the whole body. That is a real
    '' regression this code made once -- 176,000 instructions stopped being emitted
    '' corpus-wide, while the DECLINE count went DOWN, because a statement inside a
    '' body that failed to parse is not a statement that declined.
    ''
    '' What actually separates them is a PARAMETER LIST: a definition's parentheses
    '' hold 'byref a as T', so an AS, BYREF or BYVAL appears at paren depth one. An
    '' expression can contain none of those at that depth -- 'cast( integer, x )'
    '' puts its type one level deeper.
    if k = Tko.KW_OPERATOR then
        if HasTok( p, p.pos + 2 ) then
            if cast( Tko.TokenKind, p.toks->At( p.pos + 2 ).kind ) = Tko.TK_LPAREN then
                '' ...OR A GENERIC PARAMETER LIST, which holds no AS, BYREF or BYVAL
                '' and so looked like a parenthesised expression:
                ''
                ''     operator = ( of T )( byref x as Box( of T ), ... ) as integer
                ''
                '' was read as a RESULT ASSIGNMENT of '( of T )' and failed to parse,
                '' so the whole operator was lost -- TKO0401 at the T. Only '=' is
                '' affected: no other operator spelling can begin a result assignment,
                '' which is why the '<>' beside it in generics/global-operators.bas
                '' had always worked.
                if HasTok( p, p.pos + 3 ) then
                    dim as Tko.Token o3 = p.toks->At( p.pos + 3 )
                    if cast( Tko.TokenKind, o3.kind ) = Tko.TK_IDENT then
                        dim as string w = Tko.Text.LowerAscii( _
                            p.names->Spelling( cast( Tko.InternId, o3.literal ) ) )
                        if w = "of" then return false
                    end if
                end if
                if LooksLikeParamList( p, p.pos + 2 ) then return false
            end if
        end if
    end if
    return true
end function

'' The three-way ambiguity of docs/plan/04 section 6: a leading expression is a call,
'' an assignment, or a paren-less call with arguments. The parser does not decide.
private function ParseAmbiguous( byref p as Tko.ParserState ) as Tko.NodeId
    dim as Tko.Token t = Cur( p )
    dim as Tko.StmtPayload sp
    sp.a = Expression( p, Tko.PREC_POSTFIX )
    MarkCallTarget_( p, sp.a )      '' an assigned or statement-called name is no paren-less read

    dim as Tko.TokenKind k = Peek( p )
    '' '=>' IS AN EXACT SYNONYM FOR '=' wherever an assignment is written -- measured,
    '' fbc takes 'i => 5' as 'i = 5', and the same in a FOR initialiser and a default
    '' parameter value. The COMPOUND arrows were already handled, here and two blocks
    '' below; the plain one lexes as its own token and matched nothing, so 'i => 5' was
    '' read as the expression 'i' followed by a paren-less call.
    dim as boolean isAssign = (k = Tko.TK_EQ) orelse (k = Tko.TK_FATARROW) orelse _
                              (k = Tko.TK_PLUSEQ) orelse _
                              (k = Tko.TK_MINUSEQ) orelse (k = Tko.TK_STAREQ) orelse _
                              (k = Tko.TK_SLASHEQ) orelse (k = Tko.TK_BSLASHEQ) orelse _
                              (k = Tko.TK_CARETEQ) orelse (k = Tko.TK_AMPEQ)
    if isAssign then
        dim as boolean fatArrow = (k = Tko.TK_FATARROW) : if fatArrow then k = Tko.TK_EQ
        sp.op = cast( uint16, k )
        Advance( p )
        '' 'i +=> 1' IS THE SAME STATEMENT AS 'i += 1'. FreeBASIC spells every
        '' compound assignment two ways, and the second lexes as the operator token
        '' followed by a bare '>' -- so the arrow is consumed here rather than given
        '' its own token, and nothing below this line can tell which was written.
        '' Without it 'i +=> 1' was 'expected an expression' at the '>'.
        Accept( p, Tko.TK_GT )
        sp.b = Expression( p )
        dim as Tko.NodeId an = MakeStmt( p, Tko.N_AMBIGUOUS, t.loc, sp )
        if fatArrow then p.ast->OrFlags( an, Tko.NF_FAT_ARROW )
        return an
    end if

    '' A COMPOUND ASSIGNMENT SPELLED WITH A SPACE -- 'i + => 5' and 'i + = 5'. The fused
    '' '+=' is one token and was always taken; separated, the operator arrives on its own
    '' and the statement read as the expression 'i' followed by a paren-less call.
    '' Measured: fbc takes both as 'i += 5'.
    dim as uint16 spacedOp = 0
    select case k
    case Tko.TK_PLUS      : spacedOp = cast( uint16, Tko.TK_PLUSEQ )
    case Tko.TK_MINUS     : spacedOp = cast( uint16, Tko.TK_MINUSEQ )
    case Tko.TK_STAR      : spacedOp = cast( uint16, Tko.TK_STAREQ )
    case Tko.TK_SLASH     : spacedOp = cast( uint16, Tko.TK_SLASHEQ )
    case Tko.TK_BACKSLASH : spacedOp = cast( uint16, Tko.TK_BSLASHEQ )
    case Tko.TK_CARET     : spacedOp = cast( uint16, Tko.TK_CARETEQ )
    case Tko.TK_AMP       : spacedOp = cast( uint16, Tko.TK_AMPEQ )
    end select
    if (spacedOp <> 0) andalso HasTok( p, p.pos + 1 ) then
        dim as Tko.TokenKind k3 = cast( Tko.TokenKind, p.toks->At( p.pos + 1 ).kind )
        if (k3 = Tko.TK_EQ) orelse (k3 = Tko.TK_FATARROW) then
            sp.op = spacedOp
            Advance( p )
            Advance( p )
            if k3 = Tko.TK_EQ then Accept( p, Tko.TK_GT )
            sp.b = Expression( p )
            return MakeStmt( p, Tko.N_AMBIGUOUS, t.loc, sp )
        end if
    end if

    '' THE WORD-SPELLED COMPOUND ASSIGNMENTS: 'and=', 'or=', 'xor=', 'imp=', 'eqv=',
    '' 'mod=', 'shl=', 'shr=', 'andalso=' and 'orelse='. They are TWO TOKENS, because
    '' the operator is a keyword and the '=' is its own -- so nothing recognised them
    '' and 't1 and= t2' parsed as the expression 't1' followed by a paren-less call to
    '' something named 'and'. Measured: fbc emits 'T1 = T1 & T2' for the first of them.
    '' ...and the word-spelled ones take the arrow too -- 'i and=> 1' -- where it is
    '' ONE token, because '=>' after a keyword lexes as TK_FATARROW rather than as an
    '' '=' with a '>' behind it.
    if Tko.IsWordAssignOp( k ) andalso HasTok( p, p.pos + 1 ) then
        dim as Tko.TokenKind k2 = cast( Tko.TokenKind, p.toks->At( p.pos + 1 ).kind )
        if (k2 = Tko.TK_EQ) orelse (k2 = Tko.TK_FATARROW) then
            sp.op = cast( uint16, k )
            Advance( p )
            Advance( p )
            sp.b = Expression( p )
            return MakeStmt( p, Tko.N_AMBIGUOUS, t.loc, sp )
        end if
    end if

    '' Anything else on the line is a paren-less argument list.
    dim as Tko.NodeIdVec args : ParenGroupOperand_( p, sp, args )  '' 'f (x) * 0' -- parserend.tiko

    '' 'proc (x), y' IS ONE CALL WITH TWO ARGUMENTS, the first of them parenthesised.
    '' The postfix parser has already taken '(x)' as the call's whole ARGUMENT LIST,
    '' so what followed the ')' was read as more paren-less arguments and the comma
    '' produced an ELIDED one: 'proc1 (4), 4' came out as 'proc1( 4 )' followed by
    '' <elided> and 4. Measured, all three shapes:
    ''
    ''   p2 (4), 4        ->  4, 4        two arguments
    ''   p3 (1), 2, 3     ->  1, 2, 3     three
    ''   p2 (1, 2)        ->  1, 2        the paren IS the list, nothing follows
    ''
    '' -- so the rule is exactly: A COMMA AFTER THE CLOSING PAREN means the group was
    '' the FIRST ARGUMENT. structs/anon-param.bas writes ten of them.
    ''
    '' Only the ONE-ARGUMENT group is lifted. 'p2 (1, 2), 3' would make the group a
    '' TUPLE argument, which is a different question and is left declining rather
    '' than guessed at.
    if Peek( p ) = Tko.TK_COMMA then
        if p.ast->Kind( sp.a ) = Tko.N_CALL then
            dim as Tko.ListPayload ptr lcp = _
                p.ast->ListOf( sp.a )
            if (lcp->count = 1) andalso (lcp->target <> Tko.NODE_NONE) then
                dim as Tko.NodeId inner = _
                    cast( Tko.NodeId, p.ast->ChildSlot( lcp->first ) )
                sp.a = lcp->target
                args.Push( cast( uint32, inner ) )
                Advance( p )        '' the comma
            end if
        end if
    end if

    dim as boolean more = (Peek( p ) <> Tko.TK_EOL) andalso (AtEnd( p ) = false)
    if EndsSingleLineStmt( p ) then more = false
    if more then
        do
            '' Same rule as the PRINT list: 'if c then f 1, 2 end if' must not take
            '' 'end' and 'if' as two more arguments.
            if EndsSingleLineStmt( p ) then exit do
            '' 'locate ,,0' -- a PAREN-LESS call may elide arguments too, and the
            '' empty slots still count. LOCATE is not in the intrinsic registry, so
            '' this is the list it actually goes through.
            args.Push( cast( uint32, ArgOrElided( p, Tko.TK_EOL, false ) ) )  '' 'F typeof( x )' is fbc's 1
            if Accept( p, Tko.TK_COMMA ) = false then exit do
        loop
    end if
    dim as Tko.NodeId fnCall = ParenlessFnCall_( p, sp.a, t.loc, args )  '' 'hex 5' -- parserend.tiko
    if fnCall <> Tko.NODE_NONE then sp.a = fnCall : args.Clear( )
    sp.first = p.ast->ChildPoolCount( )
    sp.count = args.Count
    for i as int32 = 0 to args.Count - 1
        p.ast->PushChild( args[i] )
    next

    return MakeStmt( p, Tko.N_AMBIGUOUS, t.loc, sp )
end function

end namespace

#include once "parser/decl.tiko"
#include once "parser/gfx.tiko"
#include once "parser/intrinsics.tiko"
'' 'select channel' desugars into a scope full of ordinary statements, so it needs
'' every node builder above it.
#include once "parser/selchan.tiko"
'' 'spawn' desugars the same way, and for the same reason.
#include once "parser/spawn.tiko"
#include once "parser/undef.tiko"
#include once "parser/defer.tiko"

namespace Tko.Parse

'' True when the identifier at the cursor is the given contextual word. FBC-Modern's
'' additions -- defer, each, in, of, spawn -- are NOT reserved, so they can only be
'' recognised by spelling and only where the grammar expects them.
'' IS THE 'defer' UNDER THE CURSOR THE KEYWORD, or a variable of that name?
''
'' 'defer' is CONTEXTUAL: FBC-Modern does not reserve it, and generics/defer.bas says
'' so in as many words -- 'everything below is a program that predates the feature and
'' must keep compiling and behaving identically'. Claimed unconditionally, 'defer = 4'
'' parsed as DEFER followed by a statement beginning with '=' and died on it.
''
'' The keyword is claimed only when what follows BEGINS A STATEMENT, tested in that
'' POSITIVE form as fbc's hIsDeferStmt does: a NAME, a KEYWORD other than 'as', or the
'' end of the statement. A reject-list of assignment operators was not closed: fbc CALLS
'' 'sub defer' for 'defer( 5 )', 'defer 5' and 'defer -1', and tiko deferred and dropped
'' all three; 'defer( 1 ) = 3' over an array was TKO0652, and 'defer.field_ = 4' over a
'' UDT was lost. A TYPE SUFFIX ('defer$') is never the keyword, and 'shl=' / 'mod=',
'' which arrive here as two tokens, stay assignments -- 'defer shl= 1' assigns in fbc.
private function DeferIsKeyword_( byref p as Tko.ParserState ) as boolean
    if (Cur( p ).flags and Tko.TF_HAS_SUFFIX) <> 0 then return false
    '' The statement ends at 'defer': claimed, as fbc claims it, so a bare 'defer' is
    '' read as the statement it is rather than as a call.
    if HasTok( p, p.pos + 1 ) = false then return true
    dim as Tko.TokenKind k1 = cast( Tko.TokenKind, p.toks->At( p.pos + 1 ).kind )
    if k1 = Tko.TK_EOL then return (DeferIsLabel_( p ) = false)  '' 'defer :' -- parser/defer.tiko
    if k1 = Tko.TK_IDENT then return true
    if Tko.IsKeywordKind( k1 ) = false then return false
    if k1 = Tko.KW_AS then return false

    dim as boolean opIsBin = false
    select case k1
    case Tko.KW_SHL, Tko.KW_SHR, Tko.KW_AND, Tko.KW_OR, Tko.KW_XOR, _
         Tko.KW_EQV, Tko.KW_IMP, Tko.KW_MOD
        opIsBin = true
    end select
    if opIsBin then
        if HasTok( p, p.pos + 2 ) = false then return true
        if cast( Tko.TokenKind, p.toks->At( p.pos + 2 ).kind ) = Tko.TK_EQ then
            return false
        end if
    end if
    return true
end function

private function IsContextual _
    ( byref p as Tko.ParserState, byref word as string ) as boolean

    if Peek( p ) <> Tko.TK_IDENT then return false
    dim as Tko.InternId nm = cast( Tko.InternId, Cur( p ).literal )
    return p.names->Spelling( nm ) = word
end function

'' Hoisted into one boolean: FreeBASIC warns 38 on a mixed boolean/non-boolean
'' 'andalso' chain, and the house rule is to name the condition rather than silence it.
private function DeferStatementHead_ _
    ( byref p as Tko.ParserState, byval k as Tko.TokenKind ) as boolean

    if k <> Tko.TK_IDENT then return false
    if IsContextual( p, "defer" ) = false then return false
    return DeferIsKeyword_( p )
end function

'' 'spawn f( a, b )' -- FBC-Modern, and CONTEXTUAL for the same reason DEFER is:
'' 'dim shared as long spawn : spawn = 4 : print spawn' compiles, measured.
''
'' The keyword is claimed only when a NAME follows it, which is the shape every use
'' has -- 'spawn f( ... )', and 'spawn f' with no arguments. That leaves the variable
'' spellings alone: 'spawn = 4' and its compound forms are an assignment, and
'' 'spawn( i ) = 5' over an ARRAY of that name begins with '(' rather than a name.
''
'' Measured: fbc claims the keyword even when what follows is not a call at all --
'' 'spawn z' is error 357, not a call to something named spawn.
private function SpawnStatementHead_ _
    ( byref p as Tko.ParserState, byval k as Tko.TokenKind ) as boolean

    if k <> Tko.TK_IDENT then return false
    if IsContextual( p, "spawn" ) = false then return false
    if HasTok( p, p.pos + 1 ) = false then return false
    return (cast( Tko.TokenKind, p.toks->At( p.pos + 1 ).kind ) = Tko.TK_IDENT)
end function

'' '=>' IS THE OTHER ASSIGNMENT TOKEN, and it is legal wherever '=' is in a
'' statement position: 'err => 0' is quirk/assignment-token.bas's spelling and it
'' was a parse error, which stopped that file dead and took the twenty statements
'' after it with it.
private function ErrAssignStmt_ _
    ( byref p as Tko.ParserState, byval k as Tko.TokenKind ) as boolean

    if k <> Tko.KW_ERR then return false
    if HasTok( p, p.pos + 1 ) = false then return false
    dim as Tko.TokenKind nk = cast( Tko.TokenKind, p.toks->At( p.pos + 1 ).kind )
    return ((nk = Tko.TK_EQ) orelse (nk = Tko.TK_FATARROW))
end function

function Statement( byref p as Tko.ParserState ) as Tko.NodeId
    SkipEols( p )
    if AtEnd( p ) then return Tko.NODE_NONE

    p.silent = false
    dim as Tko.Token t = Cur( p )
    dim as Tko.TokenKind k = Peek( p )
    dim as Tko.NodeId n = Tko.NODE_NONE
    dim as boolean consumesLine = true

    select case k
    case Tko.KW_CALL, Tko.TK_INT_LIT : n = LegacyStatement_( p )   '' T86, intrinsics.tiko
    case Tko.KW_IF
        n = ParseIf( p )
        '' A single-line IF's inner statement already ran EndOfStatement and so ate
        '' the line's EOL. Running it again here would skip forward to the NEXT EOL
        '' and swallow whatever followed -- an 'end sub' or a 'wend' -- whole. It
        '' only showed up when the IF was the LAST statement of a block, because
        '' otherwise the token it ate was an ordinary statement that reparsed fine.
        if (n <> Tko.NODE_NONE) andalso _
           ((p.ast->Flags( n ) and Tko.NF_SINGLE_LINE) <> 0) then
            consumesLine = false
        end if
    case Tko.KW_SELECT    : n = ParseSelect( p )
    case Tko.KW_FOR       : n = ParseFor( p )
    case Tko.KW_DO        : n = ParseDo( p )
    case Tko.KW_WHILE     : n = ParseWhile( p )
    case Tko.KW_WITH      : n = ParseWith( p )
    case Tko.KW_SCOPE     : n = ParseScope( p )
    case Tko.KW_EXIT      : n = ParseExitLike( p, Tko.N_EXIT )
    case Tko.KW_CONTINUE  : n = ParseExitLike( p, Tko.N_CONTINUE )

    case Tko.KW_RETURN
        Advance( p )
        dim as Tko.StmtPayload sp
        dim as boolean hasValue = (Peek( p ) <> Tko.TK_EOL) andalso (AtEnd( p ) = false)
        if hasValue then sp.a = Expression( p )
        n = MakeStmt( p, Tko.N_RETURN, t.loc, sp )

    case Tko.KW_GOTO
        Advance( p )
        dim as Tko.StmtPayload sp
        if (Peek( p ) = Tko.TK_IDENT) orelse (Peek( p ) = Tko.TK_INT_LIT) then
            sp.name = cast( Tko.InternId, Cur( p ).literal )
            Advance( p )
        end if
        n = MakeStmt( p, Tko.N_GOTO, t.loc, sp )

    case Tko.KW_DELETE
        '' DELETE is classed as an OPERATOR in the keyword table, so it never reached
        '' the statement dispatch -- 54 corpus errors from one missing case.
        Advance( p )
        dim as Tko.StmtPayload sp
        if Accept( p, Tko.TK_LBRACKET ) then
            Expect( p, Tko.TK_RBRACKET, "]" )
            sp.extra = 1
        end if
        sp.a = Expression( p )
        n = MakeStmt( p, Tko.N_DELETE_STMT, t.loc, sp )

    case Tko.TK_HASH
        '' '#assert' is passed through by the preprocessor because its expression is a
        '' COMPILE-TIME one that can name types ('#assert typeof( a ) = typeof( b )'),
        '' so it belongs to the parser, not the PP. See probe P2. So is an '#undef' of a
        '' name that is not a macro: it removes a DECLARED symbol -- see UndefSym.
        dim as int32 save = p.pos
        Advance( p )
        dim as string hw = ""
        if Peek( p ) = Tko.TK_IDENT then
            hw = p.names->Spelling( cast( Tko.InternId, Cur( p ).literal ) )
        end if
        dim as Tko.StmtPayload sp
        if hw = "assert" then
            Advance( p )
            p.typeofOk = true : sp.a = Expression( p ) : p.typeofOk = false
            n = MakeStmt( p, Tko.N_ASSERT, t.loc, sp )
        elseif (hw = "undef") andalso NextTokIs_( p, Tko.TK_IDENT ) then
            n = UndefStmt_( p, t )
        else
            p.pos = save
            n = ErrorNode( p, Tko.TKO0408 )
            Sync( p )
            return n
        end if

    case Tko.KW_ASM
        '' Parsed only so it can be rejected with a real diagnostic rather than
        '' miscompiled (docs/plan/01 section 5.6).
        Advance( p )
        dim as Tko.StmtPayload sp
        '' ...UNLESS THE BLOCK IS EMPTY, in which case there is no assembly to refuse.
        '' pp/pragma-reserve-7.bas writes
        ''
        ''     asm
        ''         #if defined(symbol)
        ''             #error
        ''         #endif
        ''     end asm
        ''
        '' -- a body that is nothing at all once the preprocessor has run, and the
        '' file's subject is the '#pragma reserve' above it rather than the asm.
        '' Emitting an N_ASM with no content is what an empty block MEANS.
        dim as int32 asmFirst = p.pos
        while (Peek( p ) <> Tko.KW_END) andalso (AtEnd( p ) = false)
            Advance( p )
        wend
        dim as boolean asmEmpty = true
        for ai as int32 = asmFirst to p.pos - 1
            if cast( Tko.TokenKind, p.toks->At( ai ).kind ) <> Tko.TK_EOL then
                asmEmpty = false
                exit for
            end if
        next
        '' 'extra' is 1 for an EMPTY block, which is what lets lowering emit nothing
        '' for it rather than record an unlowered statement.
        if asmEmpty then sp.extra = 1
        n = MakeStmt( p, Tko.N_ASM, t.loc, sp )
        if asmEmpty = false then ErrorNode( p, Tko.TKO0407 )
        ExpectEnd( p, Tko.KW_ASM )

    case else
        '' 'function = expr' -- BASIC's result assignment written with the KEYWORD
        '' rather than the procedure's name. It has to be tested before the
        '' declaration dispatch, which would otherwise read FUNCTION as the start of
        '' a nested procedure and consume the enclosing 'end function' looking for a
        '' body. That is why 158 corpus files reported 'expected end FUNCTION' at EOF.
        ''
        '' The '=' is the whole disambiguator, and it is enough: at module level
        '' 'operator = ( ... )' is a global operator DEFINITION, but that spelling has
        '' a '(' after the '=' rather than an expression -- and a definition cannot
        '' appear where a statement is being parsed inside a body.
        ''
        '' Measured against fbc: assignment only. 'function += 1' is error 61 and
        '' 'print function' is error 6, so the keyword is a WRITE-ONLY target.
        if IsResultAssign( p, k ) then
            dim as Tko.StmtPayload sp
            sp.a = NewNodeAt( p, Tko.N_FUNCRESULT, t.loc, 0 )
            Advance( p )                       '' the keyword
            sp.op = cast( uint16, Tko.TK_EQ )
            Advance( p )                       '' the '='
            sp.b = Expression( p )
            n = MakeStmt( p, Tko.N_AMBIGUOUS, t.loc, sp )
        '' 'constructor( ... )' AS A STATEMENT IS A CALL, NOT A DEFINITION -- one constructor
        '' delegating to another of the same type. A definition always names the type first
        '' ('constructor Q( )', 'constructor N.Q( )'), so a '(' straight after the keyword can
        '' only be the argument list of a call.
        ''
        '' Measured on fbc, and the second half is as important as the first:
        ''
        ''     constructor Q( byval z as integer )
        ''         constructor( )        ->  _ZN1QC1Ev( THIS );
        ''         this.n += z
        ''     end constructor
        ''
        '' ...and the DELEGATING constructor gets NO PROLOGUE of its own: fbc's C for it has
        '' no memset at all, while the default constructor it calls has one. The explicit call
        '' REPLACES the implicit initialisation, exactly as an explicit 'base( )' does.
        ''
        '' This was not a missing feature so much as a parse that ran away: 'constructor( )'
        '' opened a new constructor, its 'end constructor' closed that, and the enclosing
        '' 'end namespace' closed the real one. warnings/suffix-fb.bas lost a namespace 300
        '' lines further down and reported 'expected end NAMESPACE' at end of file.
        ''
        '' 'base( )', 'x.constructor( )' and 'base.constructor( )' already worked: each begins
        '' with something that is not a declaration keyword, so each already reached
        '' ParseAmbiguous.
        elseif (k = Tko.KW_CONSTRUCTOR) andalso NextTokIs_( p, Tko.TK_LPAREN ) then
            n = ParseAmbiguous( p )
        elseif (IsDeclarationStart( k ) orelse InterfaceHere( p )) andalso (IsTypeLiteralHere( p ) = false) then
            n = Declaration( p )
        elseif Tko.IsStatementIntrinsic( k ) andalso FollowedByAssign( p ) then
            '' A statement intrinsic whose name is being ASSIGNED to is not the
            '' statement -- it is a variable or a field that happens to share the
            '' spelling. fb/tuibuffer.bi has a field called 'width' and assigns it
            '' unqualified from inside a method:
            ''
            ''     width = cast( ubyte, TuiCharWidth( cp ) )
            ''
            '' which tiko-lang routed to the WIDTH statement and then failed on the '='.
            '' Measured: fbc accepts a FIELD named 'width' and rejects a VARIABLE of
            '' that name outright, so the field case is the one that matters.
            ''
            '' No statement intrinsic takes an '=' where its first argument goes, so
            '' the token settles it without the symbol table -- and what comes out is
            '' the ordinary call-or-assign ambiguity, which Resolve decides.
            n = ParseAmbiguous( p )
        elseif Tko.IsStatementIntrinsic( k ) then
            dim as int32 intrTok0 = p.pos
            n = ParseIntrinsic( p )
            '' THE TOKENS ARE KEPT so Resolve can read the statement again as a CALL. A
            '' statement keyword is not reserved from procedure names: fbc accepts
            '' 'private sub Line( byref e as EmitCtx, byref t as string )' inside a
            '' namespace and 'Line( e, "x" )' there calls it -- measured, all three of
            '' 'Line( e, "a" )', 'Line e, "b"' and a call from a later block of the same
            '' namespace. Only the symbol table can say which this is, and the parser
            '' runs before there is one. See RewriteShadowedIntrinsic_.
            if (n <> Tko.NODE_NONE) andalso (p.pos > intrTok0) then
                p.ast->RecordTokens( n, intrTok0, p.pos - 1 )
            end if
        elseif SpawnStatementHead_( p, k ) then
            '' The whole statement is the CALL: 'spawn' contributes nothing but the
            '' keyword, so the node holds one child and every later pass reads the
            '' call out of it the way THREADCALL's does.
            dim as Tko.Token st = Cur( p )
            Advance( p )
            dim as Tko.StmtPayload ssp
            ssp.a = Expression( p, Tko.PREC_POSTFIX )
            '' DESUGARED, when the shape allows it: a frame allocated and filled
            '' at the spawn, a hoisted thunk that calls the target and deletes
            '' the frame, and fb_Spawn between them. See parser/spawn.tiko.
            '' Anything else -- a callee that is not a plain name, or an
            '' expression that is not a call at all -- keeps the bare node and
            '' declines, which is what every 'spawn' did before.
            n = MakeSpawn_( p, st, ssp.a )
            if n = Tko.NODE_NONE then
                n = MakeStmt( p, Tko.N_SPAWN, st.loc, ssp )
            end if

        elseif DeferStatementHead_( p, k ) then
            '' 'defer' is CONTEXTUAL in FBC-Modern -- not reserved, so it arrives as
            '' an identifier and is recognised by spelling, exactly as 'each' and
            '' 'in' are. Without this it parsed as a CALL to something named defer.
            n = DeferStmt_( p, consumesLine )  '' parser/defer.tiko
        elseif k = Tko.TK_IDENT then
            '' 'name:' is a label -- unless 'name' is a procedure -- and anything else is
            '' the call-or-assign ambiguity. See parserend.tiko's IsLabelHere_.
            dim as boolean isLabel = IsLabelHere_( p )
            if isLabel then
                dim as Tko.StmtPayload sp
                sp.name = cast( Tko.InternId, t.literal )
                Advance( p )
                Advance( p )
                n = MakeStmt( p, Tko.N_LABEL, t.loc, sp )
                consumesLine = false
            else
                n = ParseAmbiguous( p )
            end if
        elseif k = Tko.TK_DOT then
            '' '.field = 1' inside a WITH. It is the same call-or-assign ambiguity as
            '' a bare name, just with the base left to the enclosing WITH.
            n = ParseAmbiguous( p )
        elseif k = Tko.TK_LPAREN then
            '' A PARENTHESISED assignment target: '(a) = 5', '(*p) = 5', '(arr(1)) = 5'.
            '' The parentheses are permitted around an lvalue and change nothing, so the
            '' statement is the same call-or-assign ambiguity as a bare name.
            n = ParseAmbiguous( p )
        elseif k = Tko.KW_LET then
            '' 'let (a, b) = f( )' -- the multiple assignment, the ONLY 'let' in the fb
            '' dialect: 'let a = 5' is fbc's error 146 (T86), TKO0409 here. What follows
            '' is the ordinary call-or-assign ambiguity either way.
            if NextTokIs_( p, Tko.TK_LPAREN ) = false then ErrorNode( p, Tko.TKO0409, "LET" )
            Advance( p )
            n = ParseAmbiguous( p )
            MarkLetList_( p, n )    '' not tuple destructuring -- see NF_LET_LIST, parserend.tiko
        elseif KeywordLedExpression( p, k ) then
            '' A statement whose head is a KEYWORD-led expression rather than a name:
            ''
            ''     cast( U, x ).i = 5        mid( s, 1, 1 ) = "H"
            ''     cptr( short ptr, p ) += 1  cuint( g( ) )        strptr( s ) = 0
            ''
            '' fbc parses all of these; two of them it then REJECTS -- 'strptr(s) = 0'
            '' is error 119 and a literal on the left is error 24 -- but it rejects
            '' them in the semantic pass, having parsed the statement. tiko-lang died in the
            '' parser, so those files failed for the wrong reason and their goldens
            '' could never match.
            n = ParseAmbiguous( p )
        elseif (k = Tko.TK_INT_LIT) orelse (k = Tko.TK_FLOAT_LIT) orelse _
               (k = Tko.TK_STRING_LIT) then
            '' '0 = 1' and '"" = "a"'. fbc parses these and rejects them semantically,
            '' and the corpus tests exactly that. Accepting the parse is what lets the
            '' rejection happen in the right pass.
            n = ParseAmbiguous( p )
        elseif k = Tko.KW_END then
            '' 'END [exitcode]' TERMINATES THE PROGRAM. Reaching here at all means
            '' IsBlockEnderAt already decided this END does not close a block.
            Advance( p )
            dim as Tko.StmtPayload ep
            EndOperand_( p, ep )   '' parserend.tiko: 'end if' with no IF is not an exit code
            n = MakeStmt( p, Tko.N_END_STMT, t.loc, ep )
        elseif k = Tko.KW_BASE then
            '' 'base.vs( )' -- a call on the BASE-class receiver. Like '.field' inside a
            '' WITH, the base is implicit and what follows is an ordinary member
            '' expression, so it is the same call-or-assign ambiguity.
            '' A BARE 'base' IS NOTHING -- fbc error 120, "Expected period", for 'print
            '' base : i1' and for 'base' alone on a line. Only '.' and a base-constructor
            '' argument list may follow it. Measured; two corpus files.
            if HasTok( p, p.pos + 1 ) then
                dim as Tko.TokenKind bk = cast( Tko.TokenKind, p.toks->At( p.pos + 1 ).kind )
                if (bk <> Tko.TK_DOT) andalso (bk <> Tko.TK_LPAREN) then
                    p.diags->Report( Tko.TKO0735, Tko.PointRange( t.loc ) )
                end if
            end if
            n = ParseAmbiguous( p )
        elseif k = Tko.TK_STAR then
            '' Assignment THROUGH A POINTER: '*p = 5', '**pp = 5'. A statement may begin
            '' with the dereference operator, and the target is an ordinary lvalue
            '' expression from there -- the same call-or-assign ambiguity again.
            n = ParseAmbiguous( p )
        elseif ErrAssignStmt_( p, k ) then
            '' 'err = n' -- ERR IS A PSEUDO-VARIABLE, readable AND assignable, and the
            '' two halves go to different entry points. Measured:
            ''
            ''     e = err     int32 vr = fb_ErrorGetNum( );  E = (int64)vr
            ''     err = 5     fb_ErrorSetNum( 5 )
            ''
            '' The READ has always worked: the prelude declares 'err' aliased to
            '' fb_ErrorGetNum, so it is an ordinary call. The WRITE never reached the
            '' statement parser at all -- ERR is a KEYWORD, so it fell off the end of
            '' this dispatch and was 'expected a statement', with fb_ErrorSetNum in
            '' the runtime table and no caller.
            ''
            '' A STATEMENT OF ITS OWN rather than the call-or-assign ambiguity: the
            '' name resolves to the prelude FUNCTION, so an assignment to it would
            '' read as 'function = expr', the result assignment, which is a different
            '' statement with a different meaning.
            Advance( p )
            Advance( p )
            dim as Tko.StmtPayload erp
            erp.op = cast( uint16, Tko.KW_ERR )
            erp.a = Expression( p )
            n = MakeStmt( p, Tko.N_INTRINSIC, t.loc, erp )
        elseif k = Tko.TK_QUESTION then
            n = ParseIntrinsic( p )       '' '?' is PRINT
        else
            n = ErrorNode( p, Tko.TKO0408 )
            Sync( p )
            return n
        end if
    end select

    if consumesLine then
        if CheckEndOfStatement_( p, n ) then EndOfStatement( p )
    end if
    return n
end function

'' A STATEMENT READ AS A CALL OR AN ASSIGNMENT, whatever its first token looks like.
'' Resolve re-reads a statement-keyword statement through this once the keyword's
'' spelling turns out to name a procedure of the program's own.
function CallStatement( byref p as Tko.ParserState ) as Tko.NodeId
    return ParseAmbiguous( p )
end function

#include once "parser/prelude.tiko"

'' The prelude, parsed. Returns nothing without a keyword table (a test harness's ParserState).
private sub ParsePrelude( byref p as Tko.ParserState, byref items as Tko.NodeIdVec )
    if p.kw = nullptr then return
    if p.src = nullptr then return

    dim as Tko.FileId vf = p.src->AddVirtual( "<builtin>", PreludeText( ) )
    dim as Tko.Lex.Result r
    Tko.Lex.Run( *p.src, vf, *p.names, *cast( Tko.KeywordMap ptr, p.kw ), *p.diags, r )

    '' A SEPARATE ParserState over a FIXED token vector: no preprocessor, so 'stream' is
    '' zero and HasTok reads the vector directly; the shared nodes belong to this unit.
    dim as Tko.ParserState q
    q.toks = @r.tokens
    q.stream = nullptr
    q.litPool = @r.literals
    q.ast = p.ast
    q.src = p.src
    q.names = p.names
    q.diags = p.diags
    q.kw = nullptr
    q.pos = 0
    '' THE TARGET'S CONVENTION TRAVELS -- see PreludeText for what CC_NONE cost.
    q.fbcallConv = p.fbcallConv

    dim as int32 guard = 0
    do
        guard += 1
        if guard > 10000 then exit do
        SkipEols( q )
        if AtEnd( q ) then exit do
        dim as int32 before = q.pos
        dim as Tko.NodeId s = Statement( q )
        if s <> Tko.NODE_NONE then items.Push( cast( uint32, s ) )
        if q.pos = before then Advance( q )
    loop
    '' The prelude's procedures -- SLEEP, KILL, LOCATE -- are known to the unit's labels.
    for each nm as uint32 in q.procNames
        p.procNames.Push( nm )
    next
end sub

function Unit( byref p as Tko.ParserState ) as Tko.NodeId
    dim as Tko.Token t = Cur( p )
    dim as Tko.NodeIdVec items
    do
        SkipEols( p )
        if AtEnd( p ) then exit do
        dim as int32 before = p.pos
        dim as Tko.NodeId s = Statement( p )
        if s <> Tko.NODE_NONE then items.Push( cast( uint32, s ) )
        if p.pos = before then Advance( p )        '' guaranteed progress
    loop
    '' LAST, not first. Collect is a whole pass before anything looks a name up, so
    '' declaring the prelude after the unit's own statements changes nothing -- and it
    '' keeps every NodeId in the file the number it already had, which is what the dumps
    '' and their goldens are written in.
    '' THE HOISTED LAMBDAS, before the prelude and after the unit's own statements.
    '' Each is an ordinary module-level procedure by the time anything looks at it;
    '' the expression that wrote one holds '@its name'.
    for i as int32 = 0 to p.lambdas.Count - 1
        items.Push( p.lambdas[i] )
    next

    ParsePrelude( p, items )
    return MakeList( p, Tko.N_MODULE, t.loc, Tko.NODE_NONE, items )
end function

#include once "parser/parserdump.tiko"
