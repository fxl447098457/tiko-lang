'' lowerstrargs.tiko -- the STRING TEMPORARIES a call site builds for its arguments.
''
'' A byval var-length string argument takes a descriptor the CALLER makes and deletes;
'' a fixed 'ustring * N' against a byref ustring parameter takes a COPY, because the
'' runtime has no ustring temp-descriptor borrow to lend it one. Both are the call
'' site's own bookkeeping rather than anything about the callee.
''
'' Split out of lowercall.tiko at the 1500-line cap and INCLUDED from it, inside the
'' same namespace. Nothing moved here changed in the move.

'' IS THIS ARGUMENT A GENUINELY NARROW STRING?
''
'' The question a USTRING parameter has to ask, and there was no predicate for it.
'' IsStringType answers true for BOTH flavours, and a CONCATENATION has no type of its
'' own at all -- so neither alone can tell 'al' + 'pha' from a & b over two ustrings.
'' The terms are asked one at a time, which is what ConcatHasWideTerm_ beside it
'' already does for the wide case and for the same reason.
''
'' A 'ustring * N' source is deliberately NOT narrow here: FixedUStrArgTemp_ owns it,
'' and it copies in, calls, copies back and deletes.
function ConcatHasUStrTerm_ _
    ( byref c as Ctx, byval e as Tko.NodeId ) as boolean

    if e = Tko.NODE_NONE then return false
    if IsUStringType( c, c.info->TypeOf_( e ) ) then return true
    if c.ast->Kind( e ) <> Tko.N_BINARY then return false
    dim as containers.Array( of uint32 ) uvt
    FlattenConcat( c, e, uvt )
    for k as int32 = 0 to uvt.Count - 1
        if IsUStringType( c, c.info->TypeOf_( cast( Tko.NodeId, uvt[k] ) ) ) then
            return true
        end if
    next
    return false
end function

function NarrowStrArg_ _
    ( byref c as Ctx, byval e as Tko.NodeId ) as boolean

    if e = Tko.NODE_NONE then return false
    '' Anything wide or ustring-shaped belongs to one of the other arms.
    if TermIsWide_( c, e ) then return false
    if ConcatHasWideTerm_( c, e ) then return false
    if ConcatHasUStrTerm_( c, e ) then return false
    dim as int64 fkn
    if StrSwapKind_( c, c.info->TypeOf_( e ), fkn ) = 4 then return false
    dim as Tko.TypeId at = c.info->TypeOf_( e )
    if at <> Tko.TYPE_NONE then
        if IsStringType( c, at ) then return (IsUStringType( c, at ) = false)
        '' A fixed NARROW string counts: 'zstring * N' and 'string * N' both assign
        '' into a descriptor the same way a var-length one does.
        dim as int32 sk = StrSwapKind_( c, at, fkn )
        return (sk = 1) orelse (sk = 3)
    end if
    '' NO TYPE AT ALL is a concatenation or an intrinsic call; the wide and ustring
    '' tests above have already refused every one of those that is not narrow.
    return (c.ast->Kind( e ) = Tko.N_BINARY)
end function

'' IS THIS CALLEE A RUNTIME ENTRY POINT RATHER THAN A PROCEDURE?
''
'' It decides which shape a byref string argument takes, and the two are opposites.
'' fbc hands a RUNTIME entry point a POOL descriptor -- 'fb_GfxScreenInfo32( ...,
'' fb_StrAllocTempDescZEx( "", 0 ) )' -- because the entry point consumes it before
'' returning and the slot is free again immediately. It hands a USER procedure a
'' real temporary, because the callee's own string work would recycle that slot
'' underneath it.
''
'' ASKED OF THE ALIAS, because that is what the distinction actually is. SCREENINFO,
'' IMAGEINFO, GETMOUSE and their siblings reach lowering as ordinary declarations --
'' the prelude writes them with 'alias "fb_GfxScreenInfo32"' so that overload
'' resolution can pick between the 32- and 64-bit forms -- so nothing about the CALL
'' says which kind it is. The alias does: a procedure bound to a libfb symbol is
'' libfb, wherever its declaration was written.
private function RuntimeEntryCallee_ _
    ( byref c as Ctx, byval callee as Tko.SymbolId ) as boolean

    if callee = Tko.SYMBOL_NONE then return false
    dim as Tko.Symbol ptr sym = c.syms->SymbolAt( callee )
    if sym = nullptr then return false
    dim as Tko.NodeId pn = cast( Tko.NodeId, sym->payload )
    if pn = Tko.NODE_NONE then return false
    if c.ast->Kind( pn ) <> Tko.N_PROC then return false
    dim as Tko.StmtPayload ptr sp = _
        c.ast->StmtOf( pn )
    if sp->aliasName = 0 then return false
    '' ...AND DECLARED IN THE PRELUDE, which is what stands in for fbc's own runtime
    '' table. A HEADER's declaration is an ordinary procedure to fbc whatever its alias
    '' says: fb/string.bi binds 'IsNumeric' to "fb_StrIsNumeric", and measured, fbc
    '' passes it a REAL temporary -- 'fb_StrAssign( &TMP, -1, "42", 3, 0 );
    '' fb_StrIsNumeric( &TMP ); fb_StrDelete( &TMP )'. Handed a pool descriptor that the
    '' callee never releases, every call with a literal leaked one slot: after 255 of
    '' them the pool was dry, and each later temporary string in the program came back
    '' empty. fbstr_pad's leak test failed, and its every later assertion with it.
    if c.srcMgr <> nullptr then
        if c.srcMgr->IsBuiltin( c.ast->Loc( pn ) ) = false then return false
    end if
    dim as string al = c.names->Spelling( sp->aliasName )
    if left( al, 3 ) = "fb_" then return true
    return (left( al, 5 ) = "__fb_")
end function

'' A USTRING FOR A RUNTIME ENTRY'S NARROW STRING PARAMETER IS CONVERTED FIRST. The prelude
'' declares mkdir, chdir, rmdir, kill and dir with 'byref as const string', and the arms
'' in lowercall.tiko that build a narrow temporary are for USER procedures -- a runtime
'' entry takes its argument's own descriptor -- so a ustring path reached fb_MkDir as its
'' FBUSTRING, read as narrow: the UTF-16 'C:' is the string "C". fb/fsdir.bi's fixtures
'' are made that way, and fsinfo_dir aborted on the first ListDir. Measured, fbc writes
'' 'vr = fb_UStrToStr( &ROOT, -1 ); fb_MkDir( vr )', and so does this. Leaves 'outa'
'' alone for any other argument, parameter or callee.
sub RuntimeUStrNarrowArg_ _
    ( byref c as Ctx, byval callee as Tko.SymbolId, byval argNode as Tko.NodeId, _
      byval pt as Tko.TypeId, byref outa as MirValue )

    if IsStringType( c, pt ) = false then exit sub
    if IsUStringType( c, pt ) then exit sub
    if RuntimeEntryCallee_( c, callee ) = false then exit sub
    dim as MirValue v
    if UStrToStrAny_( c, argNode, v ) then outa = v
end sub

'' A USTRING AS A NARROW STRING: 'fb_UStrToStr( u, -1 )', a POOL descriptor, which a runtime
'' entry consumes. A typed ustring -- a variable, a field, a call result -- and a
'' CONCATENATION WITH A USTRING TERM, which has no type of its own and so needs asking
'' term by term. Measured, 'setenviron( ev & "=xyz" )' over a ustring 'ev' is
'' 'vr = fb_UStrConcat( &TMP, ... ); fb_SetEnviron( fb_UStrToStr( vr, -1 ) )'. False,
'' emitting nothing, for anything else.
function UStrToStrAny_( byref c as Ctx, byval e as Tko.NodeId, byref outv as MirValue ) as boolean
    if UStrToStrTemp_( c, e, outv ) then return true
    if ConcatHasUStrTerm_( c, e ) = false then return false
    dim as MirValue dv
    if StrDescriptorOf_( c, e, dv ) = false then return false
    dim as containers.Array( of uint32 ) ua
    PushStrArg( ua, dv )
    outv = EmitRtl( c, RTL_USTR_TO_STR, ua )
    return (outv.kind <> cast( uint8, MV_NONE ))
end function

'' ANY STRING AS A NARROW DESCRIPTOR, for an entry point that has only a narrow form -- DRAW
'' STRING, DRAW, WIDTH's device name. Measured, fbc converts a ustring with fb_UStrToStr (its
'' fb_GfxDrawStringUStr aside, which libtkogfx does not have) and a wide value into a narrow
'' temporary with fb_WstrAssignToA; every narrow shape is StrDescriptorOf_'s. A ustring or
'' wide operand reached these entry points as its own descriptor or not at all (an ICE).
function NarrowOperandAny_( byref c as Ctx, byval e as Tko.NodeId, byref outv as MirValue ) as boolean
    if UStrToStrAny_( c, e, outv ) then return true
    dim as boolean wideSrc = IsWideString_( c, c.info->TypeOf_( e ) ) orelse TermIsWide_( c, e ) orelse ConcatHasWideTerm_( c, e )
    if wideSrc then return WideToNarrowTemp_( c, e, outv )
    return StrDescriptorOf_( c, e, outv )
end function

'' A USTRING WHERE A ZSTRING'S BYTES ARE WANTED -- a 'zstring ptr' or 'byref as zstring'
'' parameter, NAME's two paths -- is a NARROW COPY, not its own data pointer, which is
'' UTF-16: 'C:\...' read as narrow is the string "C". fileexists, filelen and
'' filedatetime over a ustring path all answered for a file called "C", and NAME renamed
'' nothing. Measured, fbc converts into a REAL temporary and deletes it after the call:
''
''     vr = fb_UStrToStr( &A, -1 );  fb_StrAssign( &TMP, -1, vr, -1, 0 );
''     fb_FileExists( *(char**)&TMP );  fb_StrDelete( &TMP )
''
'' -- not the pool descriptor itself, which a procedure that is not a runtime entry never
'' releases, so each call would leak a slot. The temporary dies with the statement, as
'' ZstrDataOf_'s other rvalue borrows do. False, emitting nothing, for a non-ustring.
''
'' STRPTR AND SADD ARE THE EXCEPTION, and ask UStrDataArg_ before ZstrDataOf_: over a
'' ustring they are its OWN UTF-16 buffer. Measured, 'strptr( u ) = sadd( u )' is true
'' under fbc and the first unit is 104, 'h' -- a copy would be neither.
function UStrZstrData_( byref c as Ctx, byval e as Tko.NodeId, byref outv as MirValue ) as boolean
    dim as MirValue nv
    if UStrToStrAny_( c, e, nv ) = false then return false
    dim as int32 ztmp = NewTempLocal( c, MT_AGG, c.types->target.stringBytes )
    if ztmp < 0 then return false
    dim as MirValue zd
    zd.kind = cast( uint8, MV_LOCAL )
    zd.ty = cast( uint8, MT_PTR )
    zd.id = ztmp
    ZeroStrDescriptor( c, zd )
    dim as containers.Array( of uint32 ) za
    PushStrArg( za, zd )
    PushStrArg( za, nv )
    za.Push( cast( uint32, MV_CONST_INT ) ) : za.Push( 0 )
    EmitRtl( c, RTL_STR_ASSIGN, za )
    c.strTemps.Push( cast( uint32, ztmp ) )
    outv = LowerExprLoad( c, zd, MT_PTR )
    return (outv.kind <> cast( uint8, MV_NONE ))
end function

'' DOES THIS ARGUMENT PASS ITS OWN DESCRIPTOR TO A BYREF STRING PARAMETER?
''
'' Measured, and the rule is narrower than it looks: ONLY A VAR-LENGTH STRING
'' LVALUE does. Everything else -- a literal, a 'zstring * N', a 'string * N', a
'' concatenation, a function result, '*pz' -- gets a zeroed temporary, fb_StrAssign
'' in, the call, and fb_StrDelete after; the two fixed kinds also get a copy BACK.
'' One probe, seven arguments, fbc's own C:
''
''     P( "lit" )   memset TMP; fb_StrAssign( &TMP, -1, "lit", 4, 0 ); P( &TMP ); delete
''     P( v )       P( &V )                    -- and ONLY this one
''     P( z )       temp, call, fb_StrAssign( Z, 8, &TMP, -1, 0 ), delete
''     P( fx )      temp, call, fb_StrAssign( FX, tag, &TMP, -1, -1 ), delete
''     P( v & "c" ) concat into TMP11, fb_StrAssign into TMP12, P( &TMP12 ), delete
''     P( F( ) )    temp, call, delete
''     P( *pz )     temp, call, delete
''
'' WHY IT MATTERS, and it is not tidiness. tiko-lang answered every one of those
'' with fb_StrAllocTempDescZEx or fb_StrAllocTempDescF -- descriptors from libfb's
'' small ROTATING POOL. A pool slot is meant to live until the runtime call that
'' consumes it; handed to a USER function it stays live across the whole body, and
'' the callee's own string work recycles the very slot its parameter points at.
'' Measured: 'sub P( byref s as string )' printing 's' saw the text of a literal
'' from its OWN print statement, and 'P( "xx" )' reported len 4.
''
'' A USTRING AGAINST A NARROW PARAMETER IS A TEMPORARY TOO. Measured, for a
'' var-length ustring passed to 'byref s as string' and to 'byref s as const string'
'' alike -- fbc's own C:
''
''     memset TMP; vr = fb_UStrToStr( &U, -1 ); fb_StrAssign( &TMP, -1, vr, -1, 0 )
''     P( &TMP ); fb_StrDelete( &TMP )           -- and NO copy back
''
'' This used to answer 'owns its descriptor' for every cross-flavour pair, calling
'' that refusing to answer. It was not: the ustring's FBUSTRING went to the callee as
'' an FBSTRING, which read its UTF-16 buffer as narrow text -- 'AB' arrived as 'A',
'' NUL. The self-hosted compiler read TIKO_LIBPATH that way into its library list and
'' could not find libfb, and printed every file name it had been handed as mojibake.
''
'' The OTHER direction -- a narrow argument against a ustring parameter -- is decided
'' before this is asked, by its own arm in lowercall.tiko.
function StrArgOwnDescriptor_ _
    ( byref c as Ctx, byval e as Tko.NodeId, byval pt as Tko.TypeId ) as boolean

    if e = Tko.NODE_NONE then return true
    dim as Tko.TypeId at = c.info->TypeOf_( e )
    '' NO TYPE is a concatenation or an intrinsic's result -- string-shaped by the
    '' time it gets here, and one of the shapes fbc copies.
    if at = Tko.TYPE_NONE then return false
    at = c.types->Unqualify( at )
    '' A STRING SLICE HAS NO DESCRIPTOR OF ITS OWN: its cast is a temporary, the hazard above.
    if SliceUnitBytes( c, at ) > 0 then return false
    if IsStringType( c, at ) = false then
        '' A FIXED NARROW STRING is copied; anything that is not a string at all is
        '' NOT THIS RULE'S BUSINESS. 'takesS( 0 )' is an error the checker already
        '' reports, and building it a temporary out of fb_LongintToStr would lower a
        '' call the compiler had just refused -- an implicit conversion tiko-lang
        '' does not have, emitted underneath a diagnostic.
        dim as int64 fn_
        dim as int32 fk = StrSwapKind_( c, at, fn_ )
        '' ...AND A 'ustring * N' FOR A NARROW PARAMETER is a conversion into a temporary, as a
        '' var-length ustring is (below): fbc-modern 1.20 copies it through fb_UStrAssignToA.
        '' Answering 'owns it' sent a constructor's 'byref as string' the UTF-16 buffer itself,
        '' read as an FBSTRING -- 'B( uf )' and 'dim b as B = uf' saw "" where fbc prints the text.
        if (fk = 4) andalso (IsUStringType( c, pt ) = false) then return false
        return (fk <> 1) andalso (fk <> 3)
    end if
    '' A ustring into a narrow parameter is copied -- see above.
    if IsUStringType( c, at ) andalso (IsUStringType( c, pt ) = false) then return false
    if IsUStringType( c, at ) <> IsUStringType( c, pt ) then return true
    select case c.ast->Kind( e )
    case Tko.N_MEMBER
        '' A QUALIFIED CONST NAMES NO STORAGE. 'ns.P' and a module's 'ec.P' are member
        '' nodes, and answering 'owns it' sent the const to a user procedure as a POOL
        '' descriptor -- the hazard above. 'for i = 1 to len( s ) : r &= mid( s, i, 1 )'
        '' came back EMPTY: fb_StrLen consumed the slot before the loop began, while
        '' 'F( LC )' over a bare const copied into a temporary and was right. Measured,
        '' fbc copies both: 'fb_StrAssign( &TMP, -1, "plain", 6, 0 ); F( &TMP )'.
        ''
        '' A PROPERTY GETTER, 'o.Name', is the same shape -- a member node that is a CALL
        '' -- and came back empty the same way; fbc copies its result too.
        ''
        '' Only the two kinds that cannot be storage are refused. Answering 'copy' for a
        '' member that IS storage would lose a byref write silently, so anything else --
        '' including no symbol at all -- keeps passing its own descriptor.
        dim as Tko.Symbol ptr msy = c.syms->SymbolAt( c.info->RefOf( e ) )
        if msy <> nullptr then
            select case msy->kind
            case cast( uint8, Tko.SYM_CONSTANT ), cast( uint8, Tko.SYM_PROC )
                return false
            end select
        end if
        return true
    case Tko.N_INDEX, Tko.N_DEREF
        return true
    case Tko.N_CALL
        '' AN ARRAY ELEMENT IS SPELLED AS A CALL, and it is storage like any variable.
        '' Falling to 'false' below built a temporary for 'modr( a( 1 ) )' over 'byref s
        '' as string', so the callee wrote the copy and the element kept its old value:
        '' fbc prints 'qX' where tiko printed 'q'. Measured, fbc passes the element's own
        '' descriptor, 'MODR( (FBSTRING*)A$0 + 1 )', and the same for a 'byref as string'
        '' function's result, which is somebody else's descriptor too.
        return IsArrayIndex( c, e ) orelse CallReturnsByref_( c, e )
    case Tko.N_IDENT
        '' AN IDENTIFIER THAT NAMES STORAGE owns its descriptor; one that merely LOOKS
        '' like an identifier does not. 'curdir', 'time' and 'date' take no arguments and
        '' no parentheses, so each is a lone N_IDENT typed STRING -- and each is a CALL
        '' whose result is a descriptor from libfb's small ROTATING POOL.
        ''
        '' Answering 'owns it' handed the pool slot straight to a user procedure:
        ''
        ''     %5 = call ptr fb_CurDir()
        ''     call void _ZN7AFXNOVA8DWSTRINGaSER8FBSTRING(@d, %5)
        ''
        '' and DWSTRING's 'operator let' does its own string work -- 'this.Clear :
        '' this.Add( ansiStr )' -- which recycles the very slot its parameter points at.
        '' 'dim as DWSTRING d = curdir' came out EMPTY. tiko-editor saved the current
        '' directory that way before a compile and could not put the process back.
        '' Measured, fbc copies first: 'memset( &TMP, 0, 24 ); vr = fb_CurDir();
        '' fb_StrAssign( &TMP, -1, vr, -1, 0 ); ..aSER8FBSTRING( &D, &TMP );'.
        ''
        '' This is the hazard THIS FUNCTION'S OWN HEADER describes, reached by the one
        '' shape the node kind cannot tell apart from a variable.
        dim as Tko.Symbol ptr vsy = c.syms->SymbolAt( c.info->RefOf( e ) )
        if vsy = nullptr then return false
        select case vsy->kind
        case cast( uint8, Tko.SYM_VARIABLE ), cast( uint8, Tko.SYM_PARAMETER ), _
             cast( uint8, Tko.SYM_FIELD )
            return true
        end select
        return false
    end select
    return false
end function

'' DOES A 'byref as string' PARAMETER OF A CONVERTING CONSTRUCTOR HAVE TO BUILD A
'' TEMPORARY for this argument? Two reasons it must, and LowerConvCtorInit_ knew only
'' the first: the argument is WIDE, or it is a narrow string that does not own a
'' descriptor -- which, for an argument the address arm there can reach at all, means a
'' FIXED one, 'zstring * N' or 'string * N'.
''
'' A fixed string is an ARRAY of a character builtin, so IsStringType says no to it and
'' the byref arm took its ADDRESS: the constructor read an FBSTRING out of the
'' characters. tiko-editor's theme writer is
''
''     function Theme_RoleName( byval idx as long ) as DWSTRING
''         return gThemeRoleDef(idx).name        '' name is 'zstring * 32'
''
'' -- and the DWSTRING built from it took its buffer pointer from the text 'role.bac',
'' so saving a theme died at 0xC0000005. Measured, fbc converts through a temporary and
'' copies back, the parameter being byref and not const:
''
''     memset( &TMP, 0, 24 );
''     fb_StrAssign( &TMP, -1, (void*)GZ$, 32ll, 0 );
''     _ZN1UC1ER8FBSTRINGj( this, &TMP, 0u );
''     fb_StrAssign( (void*)GZ$, 32ll, &TMP, -1, 0 );  fb_StrDelete( &TMP );
''
'' CtorArgValue_ already builds that temporary; all this decides is that the address arm
'' must not claim the argument first. THE COPY-BACK IS STILL NOT EMITTED, as it is not
'' for any of ByvalStrTemp_'s callers -- recorded in its own header.
function NarrowStrCtorParamConverts_ _
    ( byref c as Ctx, byval argNode as Tko.NodeId, byval pt as Tko.TypeId ) as boolean

    if pt = Tko.TYPE_NONE then return false
    if argNode = Tko.NODE_NONE then return false
    dim as Tko.TypeId u = c.types->Unqualify( pt )
    if c.types->Kind( u ) = Tko.TK_REFERENCE then u = c.types->Unqualify( c.types->Inner( u ) )
    if c.types->Kind( u ) <> Tko.TK_BUILTIN then return false
    if c.types->BuiltinOf( u ) <> Tko.TY_STRING then return false
    if TermIsWide_( c, argNode ) then return true
    return (StrArgOwnDescriptor_( c, argNode, u ) = false)
end function

'' THE CALLER-BUILT DESCRIPTOR for one byval var-length string argument: zeroed,
'' assigned from the source, and passed by ADDRESS. The slot comes back so the call
'' site can delete it afterwards.
function ByvalStrTemp_ _
    ( byref c as Ctx, byval argNode as Tko.NodeId, byval pt as Tko.TypeId, _
      byref outa as MirValue, byref outSlot as int32 ) as boolean

    outSlot = -1
    if argNode = Tko.NODE_NONE then return false
    '' A STRING-TO-STRING 'cast' IS THE IDENTITY -- see StrIdentityConvOperand_.
    dim as Tko.NodeId sica = StrIdentityConvOperand_( c, argNode )
    if sica <> Tko.NODE_NONE then argNode = sica
    '' PARENTHESES CHANGE NOTHING about a byval copy, and every arm below asked about the
    '' node itself: 'S( (A(1) & ":") )' over a 'wstring * 260' element and a byval ustring
    '' was no concatenation to the wide arm, and the statement was dropped (TKO0994, TE-011).
    argNode = Unparen_( c, argNode )
    '' A UTF-16 CONCATENATION FOR A USTRING PARAMETER is built as one, into the copy:
    '' 'bv( a & a )' over 'byval u as ustring' went through fb_UStrAssignToA and the
    '' callee read a NARROW descriptor as UTF-16 -- mojibake, and an over-read of 2 x len.
    '' ...AND A STRING INTRINSIC OVER A USTRING ('TakeU( ucase( u ) )', mid, trim, ltrim, rtrim,
    '' lcase): UStrResultArgTemp_ builds its descriptor through LowerStrRvalue and copies it, as
    '' fbc does ('vr = fb_UStrUcase( &U, -1 ); fb_UStrAssign( &TMP, -1, vr, -1, 0 )'). Only the
    '' concatenation asked it, so these reached the ustring-source arm below, whose LowerExpr has
    '' no arm for an intrinsic: the statement was dropped (TKO0994) -- tracks-2026 TB-008, every
    '' PsControls setter taking 'byval Text as ustring'.
    if IsUStringType( c, pt ) then
        dim as Tko.NodeKind uak = c.ast->Kind( Unparen_( c, argNode ) )
        if (uak = Tko.N_BINARY) orelse (uak = Tko.N_CALL) then
            if UStrResultArgTemp_( c, argNode, pt, outa, outSlot, true ) then return true
        end if
    end if
    '' A 'ustring * N' FOR A USTRING PARAMETER is copied with its TAGGED length, as fbc does:
    ''     fb_UStrAssign( &TMP, -1, UF, <tag>, 0 ); TAKEU( &TMP ); fb_UStrDelete( &TMP )
    '' IsUStringType says yes to it, so the var-length arm below claimed it and passed the
    '' buffer's address with length -1 -- read as a descriptor, and every 'byval as ustring'
    '' parameter, constructor or method alike, received "" (fbc-modern 1.20 prints the text).
    if IsUStringType( c, pt ) then
        if FixedUStrArgTemp_( c, argNode, outa, outSlot ) then return true
    end if
    dim as int32 slot = NewTempLocal( c, MT_AGG, c.types->target.stringBytes )
    if slot < 0 then return false
    dim as MirValue dst
    dst.kind = cast( uint8, MV_LOCAL )
    dst.ty = cast( uint8, MT_PTR )
    dst.id = slot
    ZeroStrDescriptor( c, dst )
    '' The same assignment a 'dim as string s = expr' makes, so every source shape --
    '' a literal, a fixed-length string, a concatenation -- reaches the entry point it
    '' already had. A WIDE source is its own conversion: measured,
    '' 'takeByvalString( whex( n ) )' is 'fb_WstrAssignToA( &TMP, -1, TMP_wide, 0 )'
    '' and not fb_StrAssign.
    '' A WIDE SOURCE FOR A USTRING TEMPORARY converts through fb_WstrToUStr and
    '' then assigns the descriptor it hands back. Measured, for a wide rvalue
    '' against a 'byref as const ustring':
    ''
    ''   vr = fb_WstrToUStr( TMP_wide )
    ''   fb_UStrAssign( &TMP_u, -1, vr, -1, 0 )
    ''   G( &TMP_u )
    ''
    '' The narrow conversion below refuses a ustring destination outright, so
    '' without this the temporary was built NARROW whatever the parameter said --
    '' an FBSTRING where an FBUSTRING belongs -- and the call declined.
    ''
    '' THE WIDE TEMPORARY ITSELF IS STILL LEAKED, as every wide temporary here is:
    '' fbc emits an fb_WstrDelete for it and tiko-lang models no wide lifetime. That
    '' is a leak and not a wrong answer, and it is recorded in rtl.ti's own header.
    if IsUStringType( c, pt ) andalso _
       (TermIsWide_( c, argNode ) orelse ConcatHasWideTerm_( c, argNode )) then
        dim as MirValue uv
        '' A CONCATENATION IS HANDLED BY THE CONVERTER, which builds its wide
        '' temporary first -- see WideTermAsUStr_.
        if WideTermAsUStr_( c, argNode, uv ) = false then return false
        dim as containers.Array( of uint32 ) uargs
        uargs.Push( cast( uint32, dst.kind ) ) : uargs.Push( cast( uint32, dst.id ) )
        PushStrLen_( c, uargs, -1 )
        uargs.Push( cast( uint32, uv.kind ) ) : uargs.Push( cast( uint32, uv.id ) )
        PushStrLen_( c, uargs, -1 )
        uargs.Push( cast( uint32, MV_CONST_INT ) ) : uargs.Push( 0 )
        EmitRtl( c, RTL_USTR_ASSIGN, uargs )
        outSlot = slot
        outa = dst
        return true
    end if

    '' A GENUINELY NARROW SOURCE FOR A USTRING TEMPORARY converts through
    '' fb_UStrAssignFromA.
    ''
    '' The wide arm above takes a wide source; a narrow one fell to
    '' LowerStringAssignToSlot, which fills the temporary as an FBSTRING -- the exact
    '' mistake that arm's own comment warns about, one case along. An FBSTRING and an
    '' FBUSTRING share a 24-byte layout, so it linked, verified, and compared wrong:
    '' the callee read 'len' UTF-16 units out of a narrow buffer.
    ''
    '' Measured, fbc converts in and copies BACK, because the parameter is byref:
    ''
    ''     fb_UStrAssignFromA( &TMP$8$0, -1, &SV$0, -1, 0, 0 );
    ''     EQUALSREF( &TMP$8$0 );
    ''     fb_UStrAssignToA( &SV$0, -1, &TMP$8$0, -1, 0, 0 );
    ''
    '' THE COPY-BACK IS NOT EMITTED HERE. FixedUStrArgTemp_'s caller registers one
    '' through ustrBackNode/ustrBackSlot for the 'ustring * N' case; wiring the same
    '' list for this one is owed, and until it is, a callee that WRITES through such a
    '' parameter loses the write. Every reading callee is correct, which is what the
    '' corpus does. Recorded rather than guessed.
    if IsUStringType( c, pt ) andalso NarrowStrArg_( c, argNode ) then
        dim as MirValue nsv
        if StrDescriptorOf_( c, argNode, nsv ) = false then return false
        dim as containers.Array( of uint32 ) nargs
        nargs.Push( cast( uint32, dst.kind ) ) : nargs.Push( cast( uint32, dst.id ) )
        PushStrLen_( c, nargs, -1 )
        nargs.Push( cast( uint32, nsv.kind ) ) : nargs.Push( cast( uint32, nsv.id ) )
        PushStrLen_( c, nargs, -1 )
        nargs.Push( cast( uint32, MV_CONST_INT ) ) : nargs.Push( 0 )
        nargs.Push( cast( uint32, MV_CONST_INT ) ) : nargs.Push( 0 )
        EmitRtl( c, RTL_USTR_FROM_A, nargs )
        outSlot = slot
        outa = dst
        return true
    end if

    '' A USTRING SOURCE FOR A USTRING TEMPORARY IS A USTRING ASSIGNMENT. Measured, for a
    '' var-length ustring passed to 'byval s as ustring':
    ''
    ''     memset( &TMP, 0, 24 ); fb_UStrAssign( &TMP, -1, &U, -1, 0 ); TAKEU( &TMP )
    ''     fb_UStrDelete( &TMP )
    ''
    '' Neither arm above owns it -- the source is not wide and not narrow -- so it fell
    '' to LowerStringAssignToSlot, which filled the temporary through fb_UStrAssignToA:
    '' a NARROW descriptor the callee then read as UTF-16. The self-hosted compiler's
    '' Text.UStringToUtf8( byval s as ustring ) returned mojibake that way, so
    '' SourceManager.Find never matched a header it had already loaded and every
    '' '#include once' included it again.
    ''
    '' AN ADDRESSABLE USTRING ONLY, looked through a byref -- 'byref absPath as ustring'
    '' is exactly the shape Find passes on. A ustring RVALUE is not measured here and
    '' declines rather than take the narrow path it used to.
    scope
        dim as Tko.TypeId uat = c.types->Unqualify( c.info->TypeOf_( argNode ) )
        if uat <> Tko.TYPE_NONE then
            if c.types->Kind( uat ) = Tko.TK_REFERENCE then
                uat = c.types->Unqualify( c.types->Inner( uat ) )
            end if
        end if
        if IsUStringType( c, pt ) andalso IsUStringType( c, uat ) then
            '' A 'const as ustring' HAS NO ADDRESS: the temporary is initialised from its
            '' text, as 'dim w as ustring = G' is -- fb_UStrInit from a UTF-16 literal.
            '' LowerAddr answered NONE and 'P( G )' was dropped (TKO0994).
            '' (IsConstNameRef_ answers 'may be' for every bare name; the text confirms it.)
            dim as string bct
            if IsConstNameRef_( c, argNode ) andalso ConstStringTextOf_( c, argNode, bct ) then
                c.f->locals[slot].frontendType = c.types->Builtin( Tko.TY_USTRING )
                if LowerStringInit( c, slot, argNode, argNode ) = false then return false
                outSlot = slot
                outa = dst
                return true
            end if
            dim as MirValue usrc
            '' A CALL RESULT HAS NO ADDRESS: its value IS the descriptor pointer, and
            '' fb_UStrAssign consumes it -- see the caller in lowercall.tiko. So is a
            '' PAREN-LESS call or a property, 'TakeU( o.GetU )': LowerAddr answered with
            '' the procedure's CODE address, and fb_UStrAssign read it as a descriptor.
            '' ...BUT NOT A SUBSCRIPT OVER A UDT: Check records its 'operator []' on the
            '' N_INDEX, so 'F( a[ 0 ] )' over containers.Array( of ustring ) looked like a
            '' paren-less call, and LowerExpr loaded the 24-byte descriptor through the byref
            '' result where fb_UStrAssign wants its address -- clang refused it (AW-004).
            '' LowerAddr's N_INDEX arm (LowerPtrIndex) already hands back the operator's
            '' pointer, byref or not. fbc-modern 1.20 prints the element.
            dim as Tko.Symbol ptr ups = nullptr
            if c.ast->Kind( argNode ) <> Tko.N_INDEX then
                ups = c.syms->SymbolAt( c.info->RefOf( argNode ) )
            end if
            dim as boolean upc = false
            if ups <> nullptr then upc = (ups->kind = cast( uint8, Tko.SYM_PROC ))
            '' ...BUT AN ARRAY ELEMENT IS AN N_CALL TOO -- 'w( 1 )' parses as one -- and it
            '' HAS an address: taking its value handed fb_UStrAssign the 24-byte
            '' descriptor itself, which clang refused (T65).
            dim as boolean isCall = (c.ast->Kind( argNode ) = Tko.N_CALL)
            if isCall then isCall = (IsArrayIndex( c, argNode ) = false)
            if isCall orelse upc then
                usrc = LowerExpr( c, argNode )
            else
                usrc = LowerAddr( c, argNode )
            end if
            if usrc.kind = cast( uint8, MV_NONE ) then return false
            dim as containers.Array( of uint32 ) usa
            usa.Push( cast( uint32, dst.kind ) ) : usa.Push( cast( uint32, dst.id ) )
            PushStrLen_( c, usa, -1 )
            usa.Push( cast( uint32, usrc.kind ) ) : usa.Push( cast( uint32, usrc.id ) )
            PushStrLen_( c, usa, -1 )
            usa.Push( cast( uint32, MV_CONST_INT ) ) : usa.Push( 0 )
            EmitRtl( c, RTL_USTR_ASSIGN, usa )
            outSlot = slot
            outa = dst
            return true
        end if
    end scope

    '' A UDT FOR A USTRING TEMPORARY is 'dim as ustring tmp = u': LowerStringInit asks fbc's cast
    '' pick with the USTRING target, and the temporary is built as UTF-16 whatever the cast yields.
    '' It fell to LowerStringAssignToSlot below, which builds a NARROW descriptor -- measured, a
    '' 'cast as ustring' returning "abc" reached 'byval u as ustring' as len 3 of U+6261, 'c' and
    '' garbage (the UTF-8 bytes read as UTF-16), where fbc passes "abc".
    if IsUStringType( c, pt ) andalso IsUdtValue_( c, Unparen_( c, argNode ) ) then
        c.f->locals[slot].frontendType = c.types->Builtin( Tko.TY_USTRING )
        if LowerStringInit( c, slot, argNode, argNode ) = false then return false
        outSlot = slot
        outa = dst
        return true
    end if

    if LowerWideToNarrowSlot( c, slot, pt, argNode ) then
    elseif LowerStringAssignToSlot( c, slot, argNode ) = false then
        return false
    end if
    outSlot = slot
    outa = dst
    return true
end function

'' A USTRING RVALUE AGAINST A USTRING PARAMETER IS COPIED, CALLED ON AND DELETED. Measured,
'' for a user sub and for fb/string.bi's runtime-aliased declarations alike:
''
''   vr = MK( 1 )             fb_UStrAssign( &TMP, -1, vr, -1, 0 )   TAKE( &TMP )
''   vr = fb_UStrUcase( &U )  fb_UStrAssign( &TMP, -1, vr, -1, 0 )   TAKE( &TMP )
''   vr = fb_UStrConcat( .. ) fb_UStrAssign( &TMP, -1, vr, -1, 0 )   fb_UStrStartsWith( &TMP, .. )
''   ... fb_UStrDelete( &TMP ) after the statement
''
'' -- ucase, lcase, trim, ltrim, rtrim, left, right, mid and a 'u & "x"' chain all the
'' same. tiko passed vr itself: nothing released it (fb/fsinfo.bi's 'PathNormalize(
'' PathJoin( r, p ) )' ran the Linux descriptor pool dry after ~530 includes), and the
'' callee's first ustring assignment CONSUMED it, so 'dim s as string = u' then 'len( u )'
'' read 0. This used to ask for a call to a declared PROCEDURE only; the rule is the
'' argument's SHAPE. (A built-in intrinsic consuming a temporary directly -- 'len( ucase(
'' u ) )' -- never comes through the call path.)
''
'' 'anyChain' also copies an ALL-UTF-16 chain, which a ustring parameter leaves to
'' StrDescriptorOf_ and a wide one never reaches -- see WideArgOperand_.
function UStrResultArgTemp_ _
    ( byref c as Ctx, byval argNode as Tko.NodeId, byval pt as Tko.TypeId, _
      byref outa as MirValue, byref outSlot as int32, _
      byval anyChain as boolean = false ) as boolean

    outSlot = -1
    if argNode = Tko.NODE_NONE then return false
    if IsUStringType( c, pt ) = false then return false
    dim as Tko.NodeId an = Unparen_( c, argNode )
    '' UTF-16 only: a narrow or a wide rvalue has its own arm before this one.
    dim as boolean isU = IsUStringType( c, c.types->Unqualify( c.info->TypeOf_( an ) ) )
    dim as MirValue rv
    '' AN LVALUE PASSES ITS OWN DESCRIPTOR; only something with no address is copied.
    select case c.ast->Kind( an )
    case Tko.N_CALL
        '' A CALL, NOT AN ELEMENT: 'oldkeys( i )' is an N_CALL too, and has an address.
        '' fb/map.bi's Reserve loaded the 24 bytes where a pointer belongs. A declared
        '' procedure, or a built-in the resolver bound to nothing ('ucase( u )').
        dim as Tko.ListPayload ptr ucp = _
            c.ast->ListOf( an )
        if ucp->target = Tko.NODE_NONE then return false
        '' THE STRING INTRINSICS are spelled as calls and decided by their FIRST ARGUMENT,
        '' as LowerUStrIntrin_ decides them -- not by whatever the name binds to.
        dim as boolean intrin = false
        if (c.ast->Kind( ucp->target ) = Tko.N_IDENT) andalso (ucp->count >= 1) then
            dim as Tko.IdentPayload ptr uip = _
                c.ast->IdentOf( ucp->target )
            select case LowerSpelling_( c.ix, *c.names, uip->name )
            case "ucase", "lcase", "trim", "ltrim", "rtrim", "left", "right", "mid"
                dim as Tko.NodeId ua0 = cast( Tko.NodeId, c.ast->ChildSlot( ucp->first ) )
                '' ...or a ustring CHAIN, which Check types STRING: 'TakeU( ucase( u & "x" ) )'
                intrin = IsUStringType( c, c.info->TypeOf_( ua0 ) ) orelse IsUStrChain_( c, ua0 )
            end select
        end if
        '' ...AND 'cast( ustring, x )' over a UDT / uslice: LowerStrRvalue builds its USTRING
        '' too. LowerExpr took it for x itself and passed the UDT's bytes as a descriptor.
        if UStrUdtCastOperand_( c, an ) <> Tko.NODE_NONE then intrin = true
        if intrin then
            '' The intrinsic's descriptor comes from LowerStrRvalue; LowerExpr has no arm
            '' for it and answered nothing, so the argument declined back to vr itself.
            if LowerStrRvalue( c, an, rv ) = false then return false
        else
            if isU = false then return false
            if IsArrayIndex( c, an ) then return false
            '' A CALL THROUGH A PROCEDURE POINTER is a call too: 'Use( pp( 2, "" ) )' handed
            '' the result's pool temporary itself to a 'byref as const ustring', and the
            '' callee read len 0 where fbc-modern 1.20 prints the folder (TS-004).
            dim as Tko.Symbol ptr ucs = c.syms->SymbolAt( c.info->RefOf( ucp->target ) )
            dim as boolean isProc = false
            if ucs <> nullptr then isProc = (ucs->kind = cast( uint8, Tko.SYM_PROC ))
            if isProc = false then
                dim as Tko.TypeId uct = c.info->TypeOf_( ucp->target )
                if uct = Tko.TYPE_NONE then return false
                uct = c.types->Unqualify( uct )
                if c.types->Kind( uct ) = Tko.TK_POINTER then uct = c.types->Unqualify( c.types->Inner( uct ) )
                if c.types->Kind( uct ) <> Tko.TK_PROC then return false
            end if
            rv = LowerExpr( c, an )
        end if
    '' A PAREN-LESS CALL IS A CALL. 'TakeU( o.GetU )', 'TakeU( FreeU )' and a property
    '' 'o.PU' are ustring RVALUES exactly as 'o.GetU( )' is, and fbc copies all three the
    '' same way -- 'vr = _ZN1T4GETUEi( &O$0, 0 ); fb_UStrAssign( &TMP, -1, vr, -1, 0 )'.
    '' Without this arm a ustring parameter was handed the pool temporary itself, which
    '' the callee's first read consumed ('len( u )' 0), and a WIDE one took LowerAddr's
    '' answer: the procedure's code address, read as a descriptor. A name bound to a
    '' procedure only -- a variable or a field passes its own descriptor.
    case Tko.N_IDENT, Tko.N_MEMBER
        if isU = false then return false
        dim as Tko.Symbol ptr bps = c.syms->SymbolAt( c.info->RefOf( an ) )
        if bps = nullptr then return false
        if bps->kind <> cast( uint8, Tko.SYM_PROC ) then return false
        rv = LowerExpr( c, an )
    case Tko.N_INTRINSIC
        if isU = false then return false
        rv = LowerExpr( c, an )
    case Tko.N_BINARY
        dim as containers.Array( of uint32 ) uterms
        FlattenConcat( c, an, uterms )
        if uterms.Count < 2 then return false
        if ConcatTermsAreU_( c, uterms ) = false then return false
        '' ALL UTF-16 ('UTake( a & b )') already builds its one temporary through
        '' StrDescriptorOf_; only a MIXED chain ('u & "x"') came out wrong there.
        dim as boolean mixed = false
        for ti as int32 = 0 to uterms.Count - 1
            if StrTermFlavour_( c, cast( Tko.NodeId, uterms[ti] ) ) <> STF_UTF16 then mixed = true
        next
        if (mixed = false) andalso (anyChain = false) then return false
        dim as int32 cslot = NewTempLocal( c, MT_AGG, c.types->target.stringBytes )
        if cslot < 0 then return false
        dim as MirValue cdst
        cdst.kind = cast( uint8, MV_LOCAL ) : cdst.ty = cast( uint8, MT_PTR ) : cdst.id = cslot
        ZeroStrDescriptor( c, cdst )
        if LowerUStrChain( c, cdst, true, uterms, false ) = false then return false
        outSlot = cslot
        outa = cdst
        return true
    case else
        return false
    end select
    if rv.kind = cast( uint8, MV_NONE ) then return false
    dim as int32 slot = NewTempLocal( c, MT_AGG, c.types->target.stringBytes )
    if slot < 0 then return false
    dim as MirValue dst
    dst.kind = cast( uint8, MV_LOCAL ) : dst.ty = cast( uint8, MT_PTR ) : dst.id = slot
    ZeroStrDescriptor( c, dst )
    dim as containers.Array( of uint32 ) args
    args.Push( cast( uint32, dst.kind ) ) : args.Push( cast( uint32, dst.id ) )
    PushStrLen_( c, args, -1 )
    args.Push( cast( uint32, rv.kind ) ) : args.Push( cast( uint32, rv.id ) )
    PushStrLen_( c, args, -1 )
    args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( 0 )
    EmitRtl( c, RTL_USTR_ASSIGN, args )
    outSlot = slot
    outa = dst
    return true
end function

'' A USTRING RVALUE FOR A WIDE PARAMETER IS COPIED, AND ITS DATA POINTER PASSED. Measured,
'' against 'byval p as wstring ptr' and 'byref w as wstring' alike:
''
''     FBUSTRING* vr$3 = _ZN1T4GETUEi( &O$0, 0 );
''     fb_UStrAssign( (void*)&TMP$10$0, -1ll, (void*)vr$3, -1ll, 0 );
''     TAKEW( (uint16*)*(uint16**)&TMP$10$0 );
''     fb_UStrDelete( (FBUSTRING*)&TMP$10$0 );
''
'' -- for a call with or without parentheses, a property, 'ucase( u )', 'u1 & u2' and
'' '"x" & u'. WideOperand_ owns none of them (a ustring is not WSTRING-typed), so every
'' one fell to NarrowToWideTemp_. A paren-less call or a property reached UStrDataArg_,
'' whose LowerAddr answered with the PROCEDURE'S address and loaded its first eight bytes
'' of machine code as the data pointer: fbx's CISaveFileDialog example died in
'' 'OutputDebugStringW( psfd.GetResultString )'. Every other rvalue went through
'' fb_StrAssign as if it were NARROW, and the callee saw one character. A ustring LVALUE
'' is not claimed -- its own data pointer is already UTF-16, see UStrDataArg_ -- and
'' anything else is WideOperand_'s, unchanged. The temporary joins 'temps'.
function WideArgOperand_ _
    ( byref c as Ctx, byval argNode as Tko.NodeId, byref outa as MirValue, _
      byref temps as containers.Array( of uint32 ), byref tempTypes as containers.Array( of uint32 ) ) as boolean

    dim as Tko.TypeId ut = c.types->Builtin( Tko.TY_USTRING )
    dim as MirValue ud
    dim as int32 slot = -1
    if UStrResultArgTemp_( c, argNode, ut, ud, slot, true ) = false then
        return WideOperand_( c, argNode, outa )
    end if
    temps.Push( cast( uint32, slot ) )
    tempTypes.Push( cast( uint32, ut ) )
    dim as MirInst fa
    fa.op = cast( uint16, M_FIELD_ADDR ) : fa.ty = cast( uint8, MT_PTR )
    fa.a = ud : fa.imm = 0
    dim as MirValue pa = Emit( c, fa )
    if pa.kind = cast( uint8, MV_NONE ) then return false
    outa = LowerExprLoad( c, pa, MT_PTR )
    return (outa.kind <> cast( uint8, MV_NONE ))
end function

'' A UDT FOR A WIDE PARAMETER IS ITS CAST, picked for a WSTRING target as fbc picks it. Measured on
'' fbc-modern 1.20 over 'byref as const wstring', each returning its text whole:
''
''     'byref as wstring' or a 'wstring ptr' cast   passed as it is      (UserCastToWide_)
''     an 'as ustring' cast                         a ustring temporary, its UTF-16 data passed --
''                                                  WideArgOperand_'s shape for a ustring rvalue
''     an 'as string' cast                          a string temporary, widened from its data
''
'' tiko took the UDT's own ADDRESS as the wide text (len 0), and widening a ustring cast's result
'' as if it were narrow stopped at its first NUL ("a" of "abc"). FALSE when the type has no cast
'' that reaches; Check has reported that one (argmismatch.tiko).
declare function WideConcatStep_( byref c as Ctx, byref args as containers.Array( of uint32 ), byval r as RtlId, byref acc as MirValue ) as boolean   '' lowerwstr.tiko
function UdtWideArg_ _
    ( byref c as Ctx, byval argNode as Tko.NodeId, byref outa as MirValue, _
      byref temps as containers.Array( of uint32 ), byref tempTypes as containers.Array( of uint32 ) ) as boolean

    if IsUdtValue_( c, Unparen_( c, argNode ) ) = false then return false
    dim as int32 saveT = c.strCastTarget
    c.strCastTarget = Tko.Check.CT_WSTRING
    dim as Tko.SymbolId sym
    dim as int32 sk = ScoredStrTerm_( c, c.types->Unqualify( c.info->TypeOf_( argNode ) ), sym )
    dim as boolean ok = false
    if sk = 2 then
        dim as Tko.TypeId ut = c.types->Builtin( Tko.TY_USTRING )
        dim as MirValue ud
        dim as int32 slot = -1
        if ByvalStrTemp_( c, argNode, ut, ud, slot ) = false then slot = -1
        if slot >= 0 then
            c.f->locals[slot].frontendType = ut
            temps.Push( cast( uint32, slot ) )
            tempTypes.Push( cast( uint32, ut ) )
            dim as MirInst fa
            fa.op = cast( uint16, M_FIELD_ADDR ) : fa.ty = cast( uint8, MT_PTR )
            fa.a = ud : fa.imm = 0
            dim as MirValue pa = Emit( c, fa )
            if pa.kind <> cast( uint8, MV_NONE ) then
                outa = LowerExprLoad( c, pa, MT_PTR )
                ok = (outa.kind <> cast( uint8, MV_NONE ))
            end if
        end if
    elseif sk = 1 then
        '' A NARROW CAST goes into a string temporary the call deletes, and is widened from its data:
        '' fbc's 'vr = CAST( &U ); fb_StrAssign( &TMP, .., vr, .. ); fb_StrToWstr( TMP.data )'.
        '' Widening the cast's result directly (NarrowToWideTemp_) never released it, and each call
        '' kept one of the runtime's 256 temporary descriptors -- after 255 calls in a loop every
        '' string in the program came back empty.
        dim as Tko.TypeId st = c.types->Builtin( Tko.TY_STRING )
        dim as MirValue sd
        dim as int32 slot = -1
        if ByvalStrTemp_( c, argNode, st, sd, slot ) = false then slot = -1
        if slot >= 0 then
            c.f->locals[slot].frontendType = st
            temps.Push( cast( uint32, slot ) )
            tempTypes.Push( cast( uint32, st ) )
            dim as MirInst fd
            fd.op = cast( uint16, M_FIELD_ADDR ) : fd.ty = cast( uint8, MT_PTR )
            fd.a = sd : fd.imm = 0
            dim as MirValue dpa = Emit( c, fd )
            if dpa.kind <> cast( uint8, MV_NONE ) then
                dim as MirValue dp = LowerExprLoad( c, dpa, MT_PTR )
                dim as containers.Array( of uint32 ) wargs
                wargs.Push( cast( uint32, dp.kind ) ) : wargs.Push( cast( uint32, dp.id ) )
                ok = WideConcatStep_( c, wargs, RTL_STR_TO_WSTR, outa )
            end if
        end if
    elseif sk = 3 then
        ok = UserCastToWide_( c, argNode, outa )
    end if
    c.strCastTarget = saveT
    return ok
end function

'' A FIXED 'ustring * N' COPIED INTO A DESCRIPTOR, for a byref USTRING parameter.
'' The narrow family BORROWS one -- fb_StrAllocTempDescF over the same bytes -- and
'' the runtime has no ustring counterpart, so this is a real copy.
private function FixedUStrArgTemp_ _
    ( byref c as Ctx, byval argNode as Tko.NodeId, _
      byref outa as MirValue, byref outSlot as int32 ) as boolean

    outSlot = -1
    if argNode = Tko.NODE_NONE then return false
    dim as int64 tag
    if StrSwapKind_( c, c.info->TypeOf_( argNode ), tag ) <> 4 then return false
    dim as MirValue src = LowerAddr( c, argNode )
    if src.kind = cast( uint8, MV_NONE ) then return false

    dim as int32 slot = NewTempLocal( c, MT_AGG, c.types->target.stringBytes )
    if slot < 0 then return false
    dim as MirValue dst
    dst.kind = cast( uint8, MV_LOCAL )
    dst.ty = cast( uint8, MT_PTR )
    dst.id = slot
    ZeroStrDescriptor( c, dst )

    dim as containers.Array( of uint32 ) args
    args.Push( cast( uint32, dst.kind ) ) : args.Push( cast( uint32, dst.id ) )
    PushStrLen_( c, args, -1 )
    args.Push( cast( uint32, src.kind ) ) : args.Push( cast( uint32, src.id ) )
    PushStrLen_( c, args, tag )
    args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( 0 )
    EmitRtl( c, RTL_USTR_ASSIGN, args )

    outSlot = slot
    outa = dst
    return true
end function

'' A 'ustring * N' READ BY INPUT OR LINE INPUT goes through a ustring temporary that is copied
'' back. Measured, fbc:
''
''     fb_UStrAssign( &TMP, -1, UF, <tag>, 0 )
''     fb_InputUStr( &TMP )                  -- or fb_FileLineInputUStr( 1, &TMP )
''     fb_UStrAssign( UF, <tag>, &TMP, -1, -1 )
''     fb_UStrDelete( &TMP )
''
'' tiko handed the runtime the raw UTF-16 buffer where an FBUSTRING* belongs, and the
'' program died inside the read. 'outa' becomes the temporary's address; UFixDestBack_
'' writes it back and deletes it, and is a no-op for slot -1.
function UFixDestTemp_ _
    ( byref c as Ctx, byval e as Tko.NodeId, byref outa as MirValue, _
      byref outSlot as int32 ) as boolean
    return FixedUStrArgTemp_( c, e, outa, outSlot )
end function

sub UFixDestBack_( byref c as Ctx, byval e as Tko.NodeId, byval slot as int32 )
    if slot < 0 then exit sub
    dim as containers.Array( of uint32 ) nodes, slots
    nodes.Push( cast( uint32, e ) ) : slots.Push( cast( uint32, slot ) )
    CopyBackUStrArgs_( c, nodes, slots )
    ReleaseUStrOut_( c, slot )
end sub

'' A USTRING ITEM FOR AN OUTPUT ENTRY POINT -- fb_WriteUStr, fb_PrintUsingUStr, whose
'' argument is an FBUSTRING DESCRIPTOR and nothing else. Measured, fbc:
''
''   write u          fb_WriteUStr( 0, &U$0, 1 )                    its own descriptor
''   write o.fu       fb_WriteUStr( 0, (uint8*)&O$0 + 8, 1 )        a field, likewise
''   write uf         fb_UStrAssign( &TMP, -1, UF$0, <tag>, 0 )     'ustring * N': a copy
''                    fb_WriteUStr( 0, &TMP, 1 ) ... fb_UStrDelete( &TMP )
''   write u1 & u2    fb_UStrConcat( &TMP1, ... ) then the same copy, call and delete
''   write o.GetU( )  vr = GETU( ); the same copy, call and delete
''
'' -- and PRINT USING writes exactly the same three shapes around fb_PrintUsingUStr. So
'' an rvalue is COPIED and the copy deleted after the call (its slot comes back in
'' 'outSlot'), and only an addressable var-length ustring passes its own descriptor.
'' fbc also copies a 'ustring * N' BACK afterwards, which is its byref convention; there
'' is nothing to copy back from an output call, and the bytes written are the same.
function UStrOutOperand_ _
    ( byref c as Ctx, byval it as Tko.NodeId, byref outv as MirValue, _
      byref outSlot as int32 ) as boolean

    outSlot = -1
    dim as Tko.TypeId ut = c.types->Builtin( Tko.TY_USTRING )
    '' Every RVALUE: a call, a paren-less call, a property, an intrinsic, and -- with
    '' 'anyChain' -- a concatenation whose terms are ustrings.
    if UStrResultArgTemp_( c, it, ut, outv, outSlot, true ) then return true
    if FixedUStrArgTemp_( c, it, outv, outSlot ) then return true
    '' A UDT CASTING TO A USTRING passes the cast's own descriptor, as PRINT does (T50).
    if UdtCastIsUStr_( c, it ) then return StrDescriptorOf_( c, it, outv )
    if IsUStringType( c, c.info->TypeOf_( it ) ) = false then return false
    '' A 'const as ustring' HAS NO ADDRESS: it is copied like an rvalue, into a temporary
    '' initialised from its text as 'dim w as ustring = G' is. LowerAddr answered NONE,
    '' and 'write G', 'print using "&"; G' and 'w = G' over a 'wstring * N' were dropped.
    dim as string oct
    if IsConstNameRef_( c, it ) andalso ConstStringTextOf_( c, it, oct ) then
        dim as int32 cs = NewTempLocal( c, MT_AGG, c.types->target.stringBytes )
        if cs < 0 then return false
        c.f->locals[cs].frontendType = ut
        if LowerStringInit( c, cs, it, it ) = false then return false
        outv.kind = cast( uint8, MV_LOCAL ) : outv.ty = cast( uint8, MT_PTR ) : outv.id = cs
        outSlot = cs
        return true
    end if
    outv = LowerAddr( c, it )
    return (outv.kind <> cast( uint8, MV_NONE ))
end function

'' The fb_UStrDelete for what UStrOutOperand_ copied, emitted AFTER the output call.
'' Nothing to do when the item passed its own descriptor.
sub ReleaseUStrOut_( byref c as Ctx, byval slot as int32 )
    if slot < 0 then exit sub
    dim as MirValue tv
    tv.kind = cast( uint8, MV_LOCAL ) : tv.ty = cast( uint8, MT_PTR ) : tv.id = slot
    dim as containers.Array( of uint32 ) da
    da.Push( cast( uint32, tv.kind ) ) : da.Push( cast( uint32, tv.id ) )
    EmitRtl( c, RTL_USTR_DELETE, da )
end sub

'' A UDT THAT CASTS ONLY TO A WSTRING, against a narrow 'byref as string', is a
'' CONVERSION and not an address. Measured on fbc, a BSTRING-shaped type -- 'cast( )
'' byref as const wstring' and 'cast( ) as any ptr' -- against 'byref s as string':
''
''     uint16* vr$1 = _ZN1BcvwEv( BS$1 );
''     fb_WstrAssignToA( (void*)&TMP$2$1, -1ll, vr$1, 0 );
''     _ZN1D3ADDER8FBSTRINGj( THIS$1, &TMP$2$1, 0u );
''     fb_StrDelete( (FBSTRING*)&TMP$2$1 );
''
'' No arm of the call's string-parameter branch owned it -- the argument is not
'' wide-typed -- so it reached LowerAddr and the callee was handed the OBJECT where an
'' FBSTRING belongs. It lowered and verified. The caller tries StrDescriptorOf_ first,
'' which keeps a narrow cast ahead of this one; a USTRING parameter is not measured and
'' is left alone. fbc copies nothing back, so neither does this.
function WideUdtStrArgTemp_ _
    ( byref c as Ctx, byval argNode as Tko.NodeId, byval pt as Tko.TypeId, _
      byref outa as MirValue, byref temps as containers.Array( of uint32 ), _
      byref tempTypes as containers.Array( of uint32 ) ) as boolean

    if argNode = Tko.NODE_NONE then return false
    if IsUStringType( c, pt ) then return false
    dim as Tko.TypeId at = c.types->Unqualify( c.info->TypeOf_( argNode ) )
    if WideCastOverload_( c, at ) = Tko.SYMBOL_NONE then return false
    dim as Tko.TypeId nsp = c.types->Builtin( Tko.TY_STRING )
    dim as int32 slot = -1
    if ByvalStrTemp_( c, argNode, nsp, outa, slot ) = false then return false
    temps.Push( cast( uint32, slot ) )
    tempTypes.Push( cast( uint32, nsp ) )
    return true
end function

'' ...and the COPY BACK, after the call. fbc emits it whether or not the parameter
'' is CONST, so it is emitted here the same way rather than reasoned about: a
'' const parameter makes it a no-op, and guessing which is which would be a
'' semantic fork over an observable write.
'' A NARROW OR WIDE LVALUE PASSED THROUGH A USTRING TEMPORARY IS COPIED BACK TOO. Measured,
'' fbc over 'byref x as ustring':
''
''     pru( s )     fb_UStrAssignFromA( &TMP, -1, &S, -1, 0, 0 ) ... fb_UStrAssignToA( &S, -1, &TMP, -1, 0, 0 )
''     pru( f )     ... fb_UStrAssignToA( F, <tag>, &TMP, -1, -1, 0 )       'string * 8'
''     pru( z )     ... fb_UStrAssignToA( Z, 8, &TMP, -1, 0, 0 )            'zstring * 8'
''     pru( w )     ... fb_UStrAssignToW( W, 8, &TMP, -1 )                  'wstring * 8'
''     pru( *pz )   nothing: no declared length
''
'' tiko built the temporary and dropped it, so a callee's write never reached 's'. The slot
'' is recorded with UBACK_MARK set, which is how CopyBackUStrArgs_ tells a USTRING temporary
'' from the narrow ones the list otherwise holds. Only storage qualifies: a literal, a
'' concatenation, a call or a constant has nothing to write back into.
const UBACK_MARK = &h40000000ul
sub UStrBackPush_ _
    ( byref c as Ctx, byval e as Tko.NodeId, byval slot as int32, _
      byref nodes as containers.Array( of uint32 ), byref slots as containers.Array( of uint32 ) )

    if (e = Tko.NODE_NONE) orelse (slot < 0) then exit sub
    dim as Tko.NodeId ue = Unparen_( c, e )
    select case c.ast->Kind( ue )
    case Tko.N_IDENT, Tko.N_MEMBER, Tko.N_INDEX, Tko.N_DEREF
    case else
        exit sub
    end select
    dim as Tko.Symbol ptr sy = c.syms->SymbolAt( c.info->RefOf( ue ) )
    if sy <> nullptr then
        select case sy->kind
        case cast( uint8, Tko.SYM_CONSTANT ), cast( uint8, Tko.SYM_PROC )
            exit sub
        end select
    end if
    dim as Tko.TypeId at = c.info->TypeOf_( ue )
    if at = Tko.TYPE_NONE then exit sub
    if IsUStringType( c, at ) then exit sub
    dim as int64 tag
    dim as int32 fk = StrSwapKind_( c, at, tag )
    dim as boolean ok = false
    if (fk = 1) orelse (fk = 2) orelse (fk = 3) then ok = (tag <> 0)
    if ok = false then ok = IsStringType( c, at )
    if ok = false then exit sub
    nodes.Push( cast( uint32, ue ) )
    slots.Push( cast( uint32, slot ) or UBACK_MARK )
end sub

private sub CopyBackFromUTemp_ _
    ( byref c as Ctx, byval an as Tko.NodeId, byval slot as int32 )

    dim as MirValue dst = LowerAddr( c, an )
    if dst.kind = cast( uint8, MV_NONE ) then exit sub
    dim as int64 tag = -1
    dim as int32 fk = StrSwapKind_( c, c.info->TypeOf_( an ), tag )
    if (fk <> 1) andalso (fk <> 2) andalso (fk <> 3) then tag = -1
    dim as containers.Array( of uint32 ) args
    args.Push( cast( uint32, dst.kind ) ) : args.Push( cast( uint32, dst.id ) )
    PushStrLen_( c, args, tag )
    args.Push( cast( uint32, MV_LOCAL ) ) : args.Push( cast( uint32, slot ) )
    PushStrLen_( c, args, -1 )
    if fk = 2 then
        EmitRtl( c, RTL_USTR_TO_W, args )
        exit sub
    end if
    dim as int64 fill = 0
    if fk = 3 then fill = -1
    args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( cast( uint32, cast( uint64, fill ) ) )
    args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( 0 )
    EmitRtl( c, RTL_USTR_TO_A, args )
end sub

private sub CopyBackUStrArgs_ _
    ( byref c as Ctx, byref nodes as containers.Array( of uint32 ), _
      byref slots as containers.Array( of uint32 ) )

    for k as int32 = nodes.Count - 1 to 0 step -1
        dim as Tko.NodeId an = cast( Tko.NodeId, nodes[k] )
        if (slots[k] and PBACK_MARK) <> 0 then           '' a property's temporary: its setter (R12)
            PropertyCopyBack_( c, an, cast( int32, slots[k] and (not PBACK_MARK) ) )
            continue for
        end if
        if (slots[k] and UBACK_MARK) <> 0 then
            CopyBackFromUTemp_( c, an, cast( int32, slots[k] and (not UBACK_MARK) ) )
            continue for
        end if
        dim as int64 tag
        '' THE FIXED KINDS, all three. fbc copies the temporary back into a
        '' 'ustring * N', a 'zstring * N' and a 'string * N' alike -- the
        '' parameter is byref, so a callee that writes through it must be seen.
        '' The trailing flag is the one fbc emits for each: 0 for the narrow
        '' kinds' own assignment and -1 for the space-padded one.
        dim as int32 fk = StrSwapKind_( c, c.info->TypeOf_( an ), tag )
        if (fk <> 4) andalso (fk <> 1) andalso (fk <> 3) andalso (fk <> 2) then continue for   '' 2: 'wstring * N', below
        '' A FIXED KIND WITH NO DECLARED LENGTH IS NOT ONE. An UNSIZED zstring --
        '' what a 'zstring ptr' points at, and what '*p' is -- reports kind 1 with a
        '' tag of 0, and copying back through it WROTE INTO WHATEVER THE POINTER
        '' NAMED. For a literal that is read-only memory:
        ''
        ''     dim as zstring ptr p = @"abc" : takes( *p )     -- segfault
        ''
        '' fbc emits the copy-back only for a SIZED lvalue -- 'fb_StrAssign( Z$0,
        '' 8ll, ... )' for a 'zstring * 8' -- and none at all for '*p'. It is
        '' fbcunit's own report_init_file( *filename ), so ex09 died in the harness.
        '' EXACTLY ZERO, not 'not positive': a real fixed length arrives ENCODED --
        '' FixedStrLenArg_ sets the high bit, so 'zstring * 8' carries
        '' -9223372036854775784 -- and only the UNSIZED form reports a plain 0.
        if tag = 0 then continue for
        dim as MirValue dst = LowerAddr( c, an )
        if dst.kind = cast( uint8, MV_NONE ) then continue for
        dim as MirValue src
        src.kind = cast( uint8, MV_LOCAL )
        src.ty = cast( uint8, MT_PTR )
        src.id = cast( int32, slots[k] )
        dim as containers.Array( of uint32 ) args
        '' A 'wstring * N' TAKES THE NARROW TEMPORARY BACK WIDENED: fbc emits 'fb_WstrAssignFromA( W$0,
        '' 4ll, &TMP, -1ll )' after the call (functions/param-string-copyback.bas); tiko dropped it.
        '' ...BUT NOT A PATH'S: its temporary is UTF-8 (c.stmt.pathUtf8), which fb_WstrAssignFromA would
        '' decode as ANSI into the caller's wstring, and the file statements never write it.
        if (fk = 2) andalso c.stmt.pathUtf8 then continue for
        if fk = 2 then
            args.Push( cast( uint32, dst.kind ) ) : args.Push( cast( uint32, dst.id ) )
            args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( cast( uint32, tag ) )
            args.Push( cast( uint32, src.kind ) ) : args.Push( cast( uint32, src.id ) )
            PushStrLen_( c, args, -1 )
            EmitRtl( c, RTL_WSTR_ASSIGN_FROMA, args )
            continue for
        end if
        args.Push( cast( uint32, dst.kind ) ) : args.Push( cast( uint32, dst.id ) )
        PushStrLen_( c, args, tag )
        args.Push( cast( uint32, src.kind ) ) : args.Push( cast( uint32, src.id ) )
        PushStrLen_( c, args, -1 )
        if fk = 4 then
            args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( cast( uint32, -1 ) )
            EmitRtl( c, RTL_USTR_ASSIGN, args )
        else
            dim as int64 bflag = 0
            if fk = 3 then bflag = -1
            args.Push( cast( uint32, MV_CONST_INT ) )
            args.Push( cast( uint32, cast( uint64, bflag ) ) )
            EmitRtl( c, RTL_STR_ASSIGN, args )
        end if
    next
end sub

'' A CONSTRUCTOR'S BYREF STRING PARAMETER GIVEN A FIXED STRING WRITES BACK -- measured, fbc
'' converts 'K( z )' over a 'zstring * 16' or a 'string * 10' through a temporary and then
'' 'fb_StrAssign( Z$, 16, &TMP, -1, 0 )'; a constructor that changed its argument changed
'' 'z'. tiko built the temporary and dropped it, so 'z' kept its old text (audit F-71,
'' LOW-13). The pairs CtorArgValue_ recorded for the temporaries above 'mark' are written
'' back here, just before ReleaseStrTemps_ deletes them; the rest stay for an outer mark.
sub CopyBackStrArgs( byref c as Ctx, byref nodes as containers.Array( of uint32 ), byref slots as containers.Array( of uint32 ) )
    CopyBackUStrArgs_( c, nodes, slots )
end sub

sub FlushStrCopyBacks( byref c as Ctx, byval mark as int32 )
    if c.strBackSlot.Count = 0 then exit sub
    dim as containers.Array( of uint32 ) nodes, slots, keepN, keepS
    for k as int32 = 0 to c.strBackSlot.Count - 1
        dim as boolean mine = false
        for j as int32 = mark to c.strTemps.Count - 1
            if c.strTemps[j] = (c.strBackSlot[k] and (not UBACK_MARK)) then mine = true : exit for
        next
        if mine then
            nodes.Push( c.strBackNode[k] ) : slots.Push( c.strBackSlot[k] )
        else
            keepN.Push( c.strBackNode[k] ) : keepS.Push( c.strBackSlot[k] )
        end if
    next
    c.strBackNode.Clear( ) : c.strBackSlot.Clear( )
    for k as int32 = 0 to keepN.Count - 1
        c.strBackNode.Push( keepN[k] ) : c.strBackSlot.Push( keepS[k] )
    next
    if (nodes.Count > 0) andalso (c.curBlock >= 0) then CopyBackUStrArgs_( c, nodes, slots )
end sub

'' ...and their release, after the call returns.
private sub DeleteStrArgTemps_ _
    ( byref c as Ctx, byref slots as containers.Array( of uint32 ), _
      byref types as containers.Array( of uint32 ), byval defer as boolean = false )

    '' A BYREF RESULT MAY BE ONE OF THEM: 'function g( byval s as string ) byref as string' returns
    '' its own byval copy, which the caller owns -- fbc deletes it at the END OF THE STATEMENT, after
    '' the result is read. Deleted here, 'g( s ) = "magic"' compared freed memory (temp-strings.bas).
    if defer then
        for k as int32 = 0 to slots.Count - 1
            c.f->locals[cast( int32, slots[k] )].frontendType = cast( Tko.TypeId, types[k] )
            c.strTemps.Push( slots[k] )
        next
        return
    end if
    for k as int32 = slots.Count - 1 to 0 step -1
        dim as MirValue a
        a.kind = cast( uint8, MV_LOCAL )
        a.ty = cast( uint8, MT_PTR )
        a.id = cast( int32, slots[k] )
        dim as containers.Array( of uint32 ) args
        args.Push( cast( uint32, a.kind ) ) : args.Push( cast( uint32, a.id ) )
        EmitRtl( c, StrRtlFor_( c, cast( Tko.TypeId, types[k] ), RTL_STR_DELETE ), args )
    next
end sub


'' Moved from lowercall.tiko at the 1500-line cap; nothing in them changed.
'' Does parameter 'idx' declare 'byref as wstring'? The referent is what decides, and
'' a REFERENCE type has to be unwrapped to see it -- the recurring lesson in this
'' codebase, that a reference is transparent to TypeOf_.
function ParamWantsWideRef_ _
    ( byref c as Ctx, byval callee as Tko.SymbolId, byval sigT as Tko.TypeId, _
      byval idx as int32 ) as boolean

    dim as Tko.TypeId pt = ArgParamType_( c, callee, sigT, idx )
    if pt = Tko.TYPE_NONE then return false
    dim as Tko.TypeId pu = c.types->Unqualify( pt )
    if c.types->Kind( pu ) = Tko.TK_REFERENCE then
        pu = c.types->Unqualify( c.types->Inner( pu ) )
    end if
    if c.types->Kind( pu ) <> Tko.TK_BUILTIN then return false
    return (c.types->BuiltinOf( pu ) = Tko.TY_WSTRING)
end function

'' A NARROW string argument: a var-length one, or a zstring in either spelling. The
'' wide kinds answer false -- they need no conversion.
function IsNarrowStrArg_( byref c as Ctx, byval t as Tko.TypeId ) as boolean
    if t = Tko.TYPE_NONE then return false
    if IsStringType( c, t ) then return true
    dim as int64 zn
    dim as int32 k = StrSwapKind_( c, t, zn )
    return (k = 0) orelse (k = 1) orelse (k = 3)
end function

'' 'str( u )' OVER A USTRING IS THE CONVERSION TO NARROW, not the identity. Measured:
'' fbc emits 'fb_UStrAssignToA( &TMP, -1, U, -1, 0, -1 )' for a var-len ustring, a ustring
'' rvalue ('u & "c"') and a 'ustring * N' alike -- the assignment 'dim s as string = u'
'' makes. Taken as the identity, the UTF-16 buffer went out as narrow text ('ab' read as
'' 'a', NUL) and a 'ustring * N' came back empty. fbsqlite's hToUtf8 is 'return str(
'' textValue )', so every SQL string it built reached SQLite that way.
''
'' FALSE when no term of the operand is a ustring: the caller's identity path is right
'' for those. TRUE otherwise, with 'outv' the narrow temporary -- or MV_NONE if it could
'' not be filled, which the caller reports as a decline.
function UStrOperandToNarrow_ _
    ( byref c as Ctx, byval sa as Tko.NodeId, byref outv as MirValue ) as boolean

    dim as containers.Array( of uint32 ) terms
    FlattenConcat( c, sa, terms )
    dim as boolean anyU16 = false
    for i as int32 = 0 to terms.Count - 1
        if StrTermFlavour_( c, cast( Tko.NodeId, terms[i] ) ) = STF_UTF16 then anyU16 = true
    next
    if anyU16 = false then return false

    dim as MirValue none_
    outv = none_
    dim as int32 uslot = NewTempLocal( c, MT_AGG, c.types->target.stringBytes )
    if uslot < 0 then return true
    dim as MirValue ud
    ud.kind = cast( uint8, MV_LOCAL )
    ud.ty = cast( uint8, MT_PTR )
    ud.id = uslot
    ZeroStrDescriptor( c, ud )
    if LowerStringAssignToSlot( c, uslot, sa ) = false then return true
    '' Released at the END OF THE STATEMENT, beside the other string temporaries.
    c.strTemps.Push( cast( uint32, uslot ) )
    outv = ud
    return true
end function

'' A NARROW ARGUMENT FOR A 'byref as ustring' PARAMETER, wherever that parameter is met
'' outside the ordinary call path: a constructor called explicitly, one run for 'dim x as
'' T = init', one run as an implicit conversion to a byval UDT, and 'operator []'.
'' Measured, 'Take( "lit" )' over a byval DbValue with 'constructor( byref textValue as
'' ustring )':
''
''     fb_UStrAssign( &TMP_u, -1, (uint16[]){...}, <len>, 0 )
''     _ZN7DBVALUEC1ER9FBUSTRING( &TMP, &TMP_u )
''
'' lowercall.tiko had this arm; none of these did, so a literal's ADDRESS or a narrow
'' variable's own descriptor went where an FBUSTRING* belongs, and fbsqlite bound every
'' text value as empty or garbage.
''
'' FALSE, touching nothing, when the parameter is not a ustring or the argument is not
'' narrow. TRUE with 'outv' the temporary's address, on the statement's string
'' temporaries with its USTRING flavour so that fb_UStrDelete releases it.
function UStrParamArgTemp_ _
    ( byref c as Ctx, byval argNode as Tko.NodeId, byval pt as Tko.TypeId, _
      byref outv as MirValue ) as boolean
    dim as containers.Array( of uint32 ) tt
    return UStrRefArg_( c, argNode, pt, outv, c.strTemps, tt, c.strBackNode, c.strBackSlot )
end function

'' THE ONE STRING-TO-POINTER ENCODER (audit G3): a string argument for a 'zstring ptr' or a
'' 'wstring ptr' parameter, or in a variadic tail. A call and a constructor take the same
'' shapes -- measured, fbc over 'constructor( byval p as zstring ptr )':
''
''     T( s )      _ZN1TC1EPc( &A, *(char**)&S )                         its data pointer
''     T( f )      fb_StrAssign( &TMP, -1, F, <tag>, 0 ); ... *(char**)&TMP
''                 fb_StrAssign( F, <tag>, &TMP, -1, -1 )                 terminated, copied back
''     T( w )      vr = fb_WstrToStr( W ); fb_StrAssign( &TMP, ... )      a narrow temporary
''     T( u, 1 )   _ZN1TC1EPwi( &G, *(uint16**)&U, 1 )                    a ustring's UTF-16 data
''
'' -- and the constructor path had only the wide half, so 'T( s )' over a 'zstring ptr' went out
'' as an operand with no kind (TKO0993). 'ppt' NONE with 'vararg' is a variadic tail, which
'' takes a 'string * N' raw, as fbc does for printf. 1 encoded into 'outv'; 0 not a string
'' argument for a pointer, nothing emitted; -1 one that did not lower.
function PtrStrArg_ _
    ( byref c as Ctx, byval e as Tko.NodeId, byval ppt as Tko.TypeId, byval vararg as boolean, _
      byref outv as MirValue, byref temps as containers.Array( of uint32 ), byref tempTypes as containers.Array( of uint32 ), _
      byref backN as containers.Array( of uint32 ), byref backS as containers.Array( of uint32 ) ) as int32

    dim as boolean wantsZPtr = false
    dim as boolean wantsWPtr = false
    dim as Tko.TypeId at = c.info->TypeOf_( e )
    '' 'cast( string, x )' HAS NO TYPE OF ITS OWN (StrIdentityConvOperand_), so nothing below
    '' claimed it and the call went out with an operand of no kind (TKO0993). The TYPEREF names
    '' the type. It is an rvalue, so it takes the temporary below, never the operand's own data.
    dim as boolean strCast = false
    if at = Tko.TYPE_NONE then
        dim as Tko.NodeId ue = Unparen_( c, e )
        if StrIdentityConvOperand_( c, ue ) <> Tko.NODE_NONE then
            at = c.types->Unqualify( c.info->TypeOf_( cast( Tko.NodeId, c.ast->ChildSlot( c.ast->ListOf( ue )->first ) ) ) )
            strCast = (at <> Tko.TYPE_NONE)
        end if
    end if
    dim as int64 akn
    dim as int32 ak = StrSwapKind_( c, at, akn )
    if ppt <> Tko.TYPE_NONE then
        if c.types->Kind( c.types->Unqualify( ppt ) ) <> Tko.TK_POINTER then return 0
        dim as Tko.TypeId pin = c.types->Unqualify( c.types->Inner( c.types->Unqualify( ppt ) ) )
        if c.types->Kind( pin ) <> Tko.TK_BUILTIN then return 0
        if c.types->BuiltinOf( pin ) = Tko.TY_ZSTRING then
            '' A WIDE ARGUMENT COUNTS TOO, converted into the same narrow temporary; and a FIXED
            '' one, which IsStringType says no to -- 'zstring * 50' is an ARRAY of the character.
            wantsZPtr = IsStringType( c, at ) orelse IsWideString_( c, at ) orelse cbool( ak = 1 ) orelse cbool( ak = 3 )
        elseif c.types->BuiltinOf( pin ) = Tko.TY_WSTRING then
            '' A NARROW ARGUMENT COUNTS TOO, and is CONVERTED (fb_StrToWstr); 'string * N' too.
            wantsWPtr = IsWideString_( c, at ) orelse IsStringType( c, at ) orelse cbool( ak = 1 ) orelse cbool( ak = 3 )
        end if
    elseif vararg andalso (at <> Tko.TYPE_NONE) then
        '' A NARROW STRING IN A VARIADIC TAIL IS ITS DATA POINTER; a descriptor by value made
        '' 'printf( !"%s", s )' print nothing.
        wantsZPtr = (IsStringType( c, at ) andalso (IsUStringType( c, at ) = false)) orelse cbool( ak = 1 ) orelse cbool( ak = 3 )
    end if

    if wantsWPtr then
        if WideArgOperand_( c, e, outv, temps, tempTypes ) = false then NarrowToWideTemp_( c, e, outv )
        if outv.kind = cast( uint8, MV_NONE ) then return -1
        return 1
    end if
    if wantsZPtr = false then return 0
    '' 'string * N': terminated + copied back (FixStrZArgTemp_); a vararg takes the raw bytes.
    if (ppt <> Tko.TYPE_NONE) andalso FixStrZArgTemp_( c, e, outv, temps, tempTypes, backN, backS ) then return 1
    if (strCast = false) andalso ZstrDataOf_( c, e, outv ) then return 1
    '' AN RVALUE HAS NO DESCRIPTOR TO TAKE THE DATA POINTER OUT OF: fbc builds one, passes its
    '' data pointer and deletes it after the call -- the byval string temporary, read one level
    '' further. A NARROW one whatever the source: a wide argument is converted into it.
    dim as Tko.TypeId zpt = at
    if IsStringType( c, zpt ) = false then zpt = c.types->Builtin( Tko.TY_STRING )
    dim as MirValue zt
    dim as int32 slot = -1
    if ByvalStrTemp_( c, e, zpt, zt, slot ) = false then return -1
    temps.Push( cast( uint32, slot ) )
    tempTypes.Push( cast( uint32, zpt ) )
    outv = LowerExprLoad( c, zt, MT_PTR )
    if outv.kind = cast( uint8, MV_NONE ) then return -1
    return 1
end function

'' ...FOR A PROPERTY'S INDEX, on the statement's own lists: PushPropIndexArgs_ (lowerswap.tiko) has
'' none of a call's. ReleaseStrTemps_ deletes a temporary by its slot's type, so it is recorded here.
function PropPtrStrArg_ _
    ( byref c as Ctx, byval e as Tko.NodeId, byval ppt as Tko.TypeId, byref outv as MirValue ) as int32

    dim as int32 mark = c.strTemps.Count
    dim as containers.Array( of uint32 ) tt
    dim as int32 r = PtrStrArg_( c, e, ppt, false, outv, c.strTemps, tt, c.strBackNode, c.strBackSlot )
    for j as int32 = 0 to tt.Count - 1
        if mark + j >= c.strTemps.Count then exit for
        c.f->locals[cast( int32, c.strTemps[mark + j] )].frontendType = cast( Tko.TypeId, tt[j] )
    next
    return r
end function

'' THE ONE 'byref as ustring' ENCODER (audit G3) -- the USTRING twin of NarrowRefStrArg_, for a
'' call, a constructor, an operator and a self-operator alike. Four shapes need a temporary;
'' everything else is a ustring that owns its descriptor and passes it. Measured, fbc:
''
''   wide           vr = fb_WstrToUStr( W ); fb_UStrAssign( &TMP, -1, vr, -1, 0 ) ...
''                  fb_UStrAssignToW( W, 8, &TMP, -1 )                  (a sized lvalue)
''   narrow         fb_UStrAssignFromA( &TMP, -1, &S, -1, 0, 0 ) ...
''                  fb_UStrAssignToA( &S, -1, &TMP, -1, 0, 0 )          (UStrBackPush_)
''   'ustring * N'  fb_UStrAssign( &TMP, -1, UF, <tag>, 0 ) ...
''                  fb_UStrAssign( UF, <tag>, &TMP, -1, -1 )            (FixedUStrArgTemp_)
''   ustring rvalue a copy, deleted after the call -- any chain (UStrResultArgTemp_)
''
'' The call path had all four and the others only two, so a constructor handed a 'ustring * N'
'' got the raw UTF-16 buffer where an FBUSTRING* belongs and the program died
'' (tka-probes/phase4/t_strargs6.bas). The ORDER is the call path's, measured one arm at a time:
'' 'UTake( a & b )' over two ustrings has no type and must reach the rvalue arm, not the narrow
'' one -- NarrowStrArg_ asks the terms. The caller passes its own lists (see NarrowRefStrArg_).
function UStrRefArg_ _
    ( byref c as Ctx, byval e as Tko.NodeId, byval pt as Tko.TypeId, byref outv as MirValue, _
      byref temps as containers.Array( of uint32 ), byref tempTypes as containers.Array( of uint32 ), _
      byref backN as containers.Array( of uint32 ), byref backS as containers.Array( of uint32 ) ) as boolean

    if (e = Tko.NODE_NONE) orelse (pt = Tko.TYPE_NONE) then return false
    dim as Tko.TypeId pu = c.types->Unqualify( pt )
    if c.types->Kind( pu ) = Tko.TK_REFERENCE then pu = c.types->Unqualify( c.types->Inner( pu ) )
    if IsUStringType( c, pu ) = false then return false
    dim as Tko.TypeId ut = c.types->Builtin( Tko.TY_USTRING )
    dim as int32 slot = -1
    dim as boolean back = true
    dim as boolean wideSrc = IsWideString_( c, c.info->TypeOf_( e ) ) orelse ConcatHasWideTerm_( c, e ) orelse LitHasUnicodeEscape_( c, e )
    if wideSrc orelse NarrowStrArg_( c, e ) then
        if ByvalStrTemp_( c, e, ut, outv, slot ) = false then return false
    elseif FixedUStrArgTemp_( c, e, outv, slot ) then
        if slot >= 0 then backN.Push( cast( uint32, e ) ) : backS.Push( cast( uint32, slot ) )
        back = false
    elseif UStrResultArgTemp_( c, e, ut, outv, slot, true ) then
        back = false
    elseif IsUdtValue_( c, Unparen_( c, e ) ) then
        '' A UDT: its text cast into a ustring temporary (ByvalStrTemp_), nothing copied back --
        '' measured, fbc over 'byref as const ustring' and a 'cast as ustring' or 'as string'
        '' passes "abc" where tiko passed the narrow cast's descriptor (len 0 or 3, empty text).
        if ByvalStrTemp_( c, e, ut, outv, slot ) = false then return false
        back = false
    else
        return false
    end if
    if slot >= 0 then
        c.f->locals[slot].frontendType = ut
        temps.Push( cast( uint32, slot ) )
        tempTypes.Push( cast( uint32, ut ) )
        if back then UStrBackPush_( c, e, slot, backN, backS )
    end if
    return true
end function

'' THE ONE NARROW 'byref as string' ENCODER (audit G3). Every path that hands a 'byref as
'' string' parameter an argument -- a call, a constructor, an implicit constructor
'' conversion, an operator, a self-operator -- asks the same two questions and gets the
'' same two answers from here:
''
''   does it need a temporary?   NarrowStrCtorParamConverts_: a wide argument, or one that
''                               does not own its descriptor (StrArgOwnDescriptor_)
''   is the temporary copied back?  StrBackPushNarrow_: a SIZED fixed or wide lvalue, always --
''                               measured, fbc copies back even over a 'byref as const
''                               string' (tka-probes/phase4/t_constback.bas), and never into
''                               a 'ustring * N' (its temporary is a narrow conversion)
''
'' Measured, fbc over 'constructor( byref x as const string )' and 'zstring * 8':
''
''     fb_StrAssign( &TMP, -1, Z, 8, 0 );  _ZN1TC1ERK8FBSTRING( &A, &TMP );
''     fb_StrAssign( Z, 8, &TMP, -1, 0 );  fb_StrDelete( &TMP )
''
'' The paths had grown five copies, with three copy-back rules (none, non-const only, always)
'' and two wide rules. The caller passes its own lists, because the lifetimes differ: a call
'' deletes after the call, a constructor at the end of the statement. FALSE, touching
'' nothing, when no temporary is needed -- the caller passes the argument's own descriptor.
function NarrowRefStrArg_ _
    ( byref c as Ctx, byval e as Tko.NodeId, byval pt as Tko.TypeId, byref outv as MirValue, _
      byref temps as containers.Array( of uint32 ), byref tempTypes as containers.Array( of uint32 ), _
      byref backN as containers.Array( of uint32 ), byref backS as containers.Array( of uint32 ) ) as boolean

    if NarrowStrCtorParamConverts_( c, e, pt ) = false then return false
    dim as Tko.TypeId snt = c.types->Builtin( Tko.TY_STRING )
    dim as int32 slot = -1
    if ByvalStrTemp_( c, e, snt, outv, slot ) = false then return false
    if slot >= 0 then
        c.f->locals[slot].frontendType = snt
        temps.Push( cast( uint32, slot ) )
        tempTypes.Push( cast( uint32, snt ) )
        StrBackPushNarrow_( c, e, slot, backN, backS )
    end if
    return true
end function

'' ...THE COPY-BACK half: a 'string * N', a sized 'zstring * N' or 'wstring * N' lvalue gets
'' the narrow temporary back (CopyBackUStrArgs_ picks the entry). '*pz' has no declared
'' length and fbc writes nothing back into it; a 'ustring * N' is a conversion, not a copy.
sub StrBackPushNarrow_ _
    ( byref c as Ctx, byval e as Tko.NodeId, byval slot as int32, _
      byref backN as containers.Array( of uint32 ), byref backS as containers.Array( of uint32 ) )

    dim as int64 tag
    dim as int32 fk = StrSwapKind_( c, c.info->TypeOf_( e ), tag )
    if (fk <> 1) andalso (fk <> 2) andalso (fk <> 3) then exit sub
    if tag = 0 then exit sub
    backN.Push( cast( uint32, e ) ) : backS.Push( cast( uint32, slot ) )
end sub

'' THE SAME, for a path whose temporaries live for the statement (c.strTemps) and whose
'' copy-backs FlushStrCopyBacks emits -- a self-operator, an operator operand, a constructor.
function NarrowParamArgTemp_ _
    ( byref c as Ctx, byval argNode as Tko.NodeId, byval pt as Tko.TypeId, _
      byref outv as MirValue ) as boolean
    dim as containers.Array( of uint32 ) tt
    return NarrowRefStrArg_( c, argNode, pt, outv, c.strTemps, tt, c.strBackNode, c.strBackSlot )
end function

