'' lowerctl.tiko -- control-flow lowering: SELECT CASE, labels and GOTO.
''
'' Split out of lower.tiko when that file passed the 1500-line lint cap, by subject
'' rather than by size: what is here is the multi-way and non-local transfers, while
'' lower.tiko keeps IF, the loops and the cleanup machinery they share.

#import "std/containers"
#include once "mir/lowerall.ti"
#include once "lexer/keywords.ti"

namespace Tko.Mir

declare function MemberNamed_ _
    ( byref c as Ctx, byval t as Tko.TypeId, byref nm as string ) as Tko.SymbolId


'' Local to this file.
declare function LowerCaseTest _
    ( byref c as Ctx, byref slotAddr as MirValue, byval mt as MirType, _
      byval isUns as boolean, byval val as Tko.NodeId, _
      byval subjT as Tko.TypeId = Tko.TYPE_NONE ) as MirValue
declare function LabelSlot( byref c as Ctx, byval nm as Tko.InternId ) as int32
'' lowerswitch.tiko: 'select case as const' as one switch, or false for the chain.
declare function LowerSelectSwitch _
    ( byref c as Ctx, byval sp as Tko.StmtPayload ptr, byref slotAddr as MirValue, _
      byval mt as MirType, byval isUns as boolean, byval subjT as Tko.TypeId, _
      byval joinB as int32 ) as boolean
declare function LabelBlockOf( byref c as Ctx, byval slot as int32 ) as int32

'' SELECT CASE, lowered as a COMPARISON CHAIN.
''
'' docs/plan/09 section 4 also lists a dense-switch and a jump-table form. The chain is
'' correct for every shape, including the ranged and relational ones a switch cannot
'' express, so it is what exists first; the denser forms are an optimisation over a
'' working lowering rather than a prerequisite for one.
''
'' The SUBJECT IS EVALUATED ONCE, into a slot. Re-evaluating it per case would call a
'' function once per branch tested -- observable whenever it has side effects.

'' A decline part-way THROUGH a statement, attributed to the kind of statement it was
'' inside. The statement-dispatch counter says which statements were never started; this
'' says which ones were started and could not be finished, and that is the larger number
'' by more than an order of magnitude.
'' A node whose location is in the SOURCE rather than in a macro body. Every node the
'' preprocessor produced carries NF_FROM_MACRO, and its location is the '#define' line
'' -- so a decline inside 'CU_ASSERT( x )' was reported against one line of fbcunit.bi,
'' 1,071 times, whatever it was really about. The argument's own tokens come from the
'' INVOCATION, so the first descendant without the flag is where the work is.
private function NonMacroNode_( byref c as Ctx, byval n0 as uint32 ) as uint32
    dim as Tko.NodeId n = cast( Tko.NodeId, n0 )
    for guard as int32 = 0 to 15
        if n = Tko.NODE_NONE then return n0
        '' NF_FROM_MACRO is declared and never set, so the test is the LOCATION
        '' itself: a node that came from a macro body sits in the file the '#define'
        '' is in, and the argument the caller wrote does not. Descend while the file
        '' MATCHES the statement's, which is the macro's when there is one.
        if c.ast->Loc( n ) <> c.ast->Loc( cast( Tko.NodeId, c.stmt.curStmtNode ) ) then
            if c.srcMgr->Decode( c.ast->Loc( n ) ).file <> _
               c.srcMgr->Decode( c.ast->Loc( cast( Tko.NodeId, c.stmt.curStmtNode ) ) ).file then
                return cast( uint32, n )
            end if
        end if
        '' Descend into the first child that has one. The payload pool differs per
        '' KIND, which is the mistake this codebase has made seven times, so only the
        '' three shapes that wrap a single operand are followed.
        select case c.ast->Kind( n )
        case Tko.N_PAREN, Tko.N_CALL, Tko.N_INDEX, Tko.N_TUPLE
            dim as Tko.ListPayload ptr lp = _
                c.ast->ListOf( n )
            if lp->count < 1 then return cast( uint32, n )
            n = cast( Tko.NodeId, c.ast->ChildSlot( lp->first ) )
        case Tko.N_BINARY
            dim as Tko.BinaryPayload ptr bp = _
                c.ast->BinaryOf( n )
            n = bp->lhs
        case Tko.N_UNARY
            dim as Tko.UnaryPayload ptr up = _
                c.ast->UnaryOf( n )
            n = up->operand
        case else
            return cast( uint32, n )
        end select
    next
    return n0
end function

'' THE SITE'S FILE NAME, CUT DOWN TO THE REPOSITORY. '__FILE__' expands to the path fbc
'' was given, which is ABSOLUTE for some sources and relative for others -- so a skip-site
'' line in a golden held the checkout's own directory, and the same test passed in one tree
'' and failed in another. Measured the hard way: tests/diagnostics/const-target-and-decl
'' differed between C:\dev\tiko-iso and C:\dev\tiko-iso2 by nothing but that.
private function SkipSiteName_( byref fileName as string ) as string
    dim as int32 at = instr( fileName, "src" & chr( 92 ) )
    if at = 0 then at = instr( fileName, "src/" )
    if at = 0 then return fileName
    return mid( fileName, at )
end function

sub SkipAt _
    ( byref c as Ctx, byref fileName as string, byval lineNo as int32 )

    c.st->skipped += 1
    '' TIKO_TRACE_SKIP names the PROCEDURE each decline is in. A count says how much is
    '' owed and nothing about what to write; twice now the answer to "what is missing"
    '' has been a short list of names rather than a feature.
    if len( environ( "TIKO_TRACE_SKIP" ) ) > 0 then
        '' ...and the SOURCE LINE the declining statement came from. A compiler line
        '' says which branch gave up; only the source line says what it gave up on,
        '' and the two largest parse-gap items were invisible without it.
        dim as string where = ""
        dim as uint32 blameAt = c.stmt.curStmtNode
        if c.stmt.blameNode <> 0 then blameAt = NonMacroNode_( c, c.stmt.blameNode )
        if (c.srcMgr <> nullptr) andalso (blameAt <> 0) then
            dim as Tko.DecodedLoc sl = _
                c.srcMgr->Decode( c.ast->Loc( cast( Tko.NodeId, blameAt ) ) )
            where = " at " & c.srcMgr->PathOf( sl.file ) & ":" & str( sl.lineNo )
        end if
        print "SKIP " & fileName & ":" & str( lineNo ) & " in " & _
              iif( c.f <> nullptr, c.names->Spelling( c.f->name ), "?" ) & where
    end if
    '' The site, found by linear scan: about twenty of them, so a map would cost more
    '' than it saved and would not keep the order stable across runs.
    dim as Tko.InternId fid = c.names->GetString( SkipSiteName_( fileName ) )
    dim as boolean seen = false
    for i as int32 = 0 to c.st->skipSiteN.Count - 1
        if (c.st->skipSiteFile[i] = cast( uint32, fid )) andalso _
           (c.st->skipSiteLine[i] = lineNo) then
            c.st->skipSiteN[i] += 1
            seen = true
            exit for
        end if
    next
    if seen = false then
        c.st->skipSiteFile.Push( cast( uint32, fid ) )
        c.st->skipSiteLine.Push( lineNo )
        c.st->skipSiteN.Push( 1 )
    end if
    dim as int32 k = cast( int32, c.stmt.curStmtKind )
    while c.st->innerKind.Count <= k
        c.st->innerKind.Push( 0 )
    wend
    c.st->innerKind[k] += 1
    '' THE SOURCE LINE, kept for a build to report -- the first twenty, which is enough
    '' to say what to look at and no more than an error list should hold.
    if c.st->skipLocs.Count < 20 then
        dim as uint32 locAt = c.stmt.curStmtNode
        if c.stmt.blameNode <> 0 then locAt = NonMacroNode_( c, c.stmt.blameNode )
        if locAt <> 0 then
            c.st->skipLocs.Push( cast( uint32, c.ast->Loc( cast( Tko.NodeId, locAt ) ) ) )
            c.st->skipKinds.Push( cast( uint32, c.stmt.curStmtKind ) )
        end if
    end if
    '' CONSUMED. A blame set for one decline must not be reported for the next.
    c.stmt.blameNode = 0
end sub

'' Which HALF of a declined call statement is at fault: a callee that bound to nothing,
'' or a callee that bound and still emitted nothing. The two need completely different
'' work -- a missing declaration against a missing lowering -- and the count against
'' N_AMBIGUOUS alone cannot tell them apart.
''
'' The unbound callee's NAME is recorded too. Twice now the answer to "what is missing"
'' has been a short list of names rather than a feature.
sub CountUnlowredCall( byref c as Ctx, byval call_ as Tko.NodeId )
    if call_ = Tko.NODE_NONE then return
    '' The CALLEE, whichever spelling was used: an N_CALL keeps it in the list payload,
    '' while the paren-less statement form IS the callee. Counting the second as 'other'
    '' hid 19,629 unbound calls in a bucket named for something else, and made a shape
    '' histogram of callees look like a histogram of statements.
    dim as Tko.NodeId target = call_
    dim as boolean bound = false
    if c.ast->Kind( call_ ) = Tko.N_CALL then
        dim as Tko.ListPayload ptr cp = _
            c.ast->ListOf( call_ )
        target = cp->target
        bound = (c.info->RefOf( call_ ) <> Tko.SYMBOL_NONE)
    else
        bound = (c.info->RefOf( call_ ) <> Tko.SYMBOL_NONE)
    end if
    if bound then
        c.st->ambCallNoCode += 1
        return
    end if
    c.st->ambCallUnbound += 1
    if target = Tko.NODE_NONE then return
    '' AN UNDECLARED NAME CALLED AS A STATEMENT -- 'here is an error on line 4', 'bar 1, 2'
    '' -- is fbc's 42, and was reported here until every undeclared name was: it is now
    '' Check.ReportUndeclared's (symbols/undeclared.tiko), which saw this one too and
    '' reported it a second time.
    dim as int32 tk = cast( int32, c.ast->Kind( target ) )
    while c.st->ambUnboundShape.Count <= tk
        c.st->ambUnboundShape.Push( 0 )
    wend
    c.st->ambUnboundShape[tk] += 1
    '' A MEMBER callee: record the member's own name, and whether the base typed. The
    '' base is what decides which question this is -- "no such member on that type" or
    '' "no type to look in".
    if c.ast->Kind( target ) = Tko.N_MEMBER then
        dim as Tko.BinaryPayload ptr mb = _
            c.ast->BinaryOf( target )
        if c.info->TypeOf_( mb->lhs ) = Tko.TYPE_NONE then
            c.st->ambMemberBaseUntyped += 1
        else
            c.st->ambMemberBaseTyped += 1
        end if
        if c.ast->Kind( mb->rhs ) <> Tko.N_IDENT then return
        if c.st->ambMemberNames.Count >= 200000 then return
        dim as Tko.IdentPayload ptr mp = _
            c.ast->IdentOf( mb->rhs )
        c.st->ambMemberNames.Push( cast( uint32, mp->name ) )
        return
    end if

    if c.ast->Kind( target ) <> Tko.N_IDENT then return
    if c.st->ambUnboundNames.Count >= 200000 then return
    '' An N_IDENT's payload is an IDENT, not a statement. Reading it through StmtOf
    '' indexes a different pool -- the mistake this project has made six times.
    dim as Tko.IdentPayload ptr ip = _
        c.ast->IdentOf( target )
    c.st->ambUnboundNames.Push( cast( uint32, ip->name ) )
end sub

'' Records an unlowered STATEMENT, by kind, so the next thing to implement is something
'' to read off rather than guess at.
sub SkipStmt( byref c as Ctx, byval id as Tko.NodeId )
    SkipHere( c )
    dim as int32 k = cast( int32, c.ast->Kind( id ) )
    while c.st->skippedKind.Count <= k
        c.st->skippedKind.Push( 0 )
    wend
    c.st->skippedKind[k] += 1

    if c.ast->Kind( id ) <> Tko.N_INTRINSIC then return
    '' Every intrinsic shares one node kind, so the keyword is counted separately.
    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    for i as int32 = 0 to c.st->skippedIntrOp.Count - 1
        if c.st->skippedIntrOp[i] = cast( uint32, sp->op ) then
            c.st->skippedIntrN[i] += 1
            return
        end if
    next
    c.st->skippedIntrOp.Push( cast( uint32, sp->op ) )
    c.st->skippedIntrN.Push( 1 )
end sub

'' 'END [exitcode]' terminates the program: a direct fb_End call, measured from fbc.
''
'' IT RUNS NO CLEANUPS, and that is measured too rather than assumed by analogy with
'' RETURN. A trace program holding a live destructor and a live string prints neither
'' before exiting -- END bypasses every open scope, where RETURN runs them all
'' innermost-first. So there is deliberately no EmitCleanupsTo here, and the scope's
'' cleanup ends up in the unreachable block after the call, which is exactly right: it is
'' the normal exit path, and END is not one.
sub LowerEndStmt( byref c as Ctx, byval id as Tko.NodeId )
    dim as Tko.StmtPayload ptr esp = StmtOf( c, id )
    dim as MirValue code
    if esp->a <> Tko.NODE_NONE then
        code = Coerce( c, LowerExpr( c, esp->a ), MT_I32 )
    end if
    if code.kind = cast( uint8, MV_NONE ) then code = ConstInt( c, 0, MT_I32 )
    dim as containers.Array( of uint32 ) ea
    ea.Push( cast( uint32, code.kind ) ) : ea.Push( cast( uint32, code.id ) )
    EmitRtl( c, RTL_END, ea )
    '' fb_End does not return, so nothing follows it in the same block.
    Terminate( c, MTERM_UNREACHABLE, -1, -1, NoVal( ) )
    c.curBlock = NewBlock( c, "end.after" )
end sub

'' 'exit X' and 'continue X'.
''
'' The parser records the TARGET KEYWORD and a LEVEL COUNT -- 'exit for, for' names
'' 'for' twice and leaves the SECOND-innermost for loop. Both were being ignored: every
'' exit broke the innermost breakTo entry whatever it was, so
''
''     for i as long = 1 to 3
''       for j as long = 1 to 3
''         exit for, for          <-- left the INNER loop, silently
''
'' and 'exit sub' declined outright, which is 1,594 corpus statements.
''
'' The five procedure keywords are a RETURN, not a break: EXIT SUB and EXIT FUNCTION
'' leave the procedure, running every open scope's cleanups on the way, exactly as a
'' bare RETURN does. A function's result comes from its result slot.
sub LowerExitLike _
    ( byref c as Ctx, byval id as Tko.NodeId, byval isExit as boolean )

    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    dim as Tko.TokenKind want = cast( Tko.TokenKind, sp->op )
    dim as int32 levels = sp->extra
    if levels < 1 then levels = 1

    '' EXIT SUB / FUNCTION / PROPERTY / CONSTRUCTOR / DESTRUCTOR / OPERATOR.
    dim as boolean isProcExit = _
        (want = Tko.KW_SUB) orelse (want = Tko.KW_FUNCTION) orelse _
        (want = Tko.KW_PROPERTY) orelse (want = Tko.KW_CONSTRUCTOR) orelse _
        (want = Tko.KW_DESTRUCTOR) orelse (want = Tko.KW_OPERATOR)
    if isExit andalso isProcExit then
        '' See lower.tiko: a return's temporaries cannot wait for the statement
        '' to end, because the terminator ends the block first.
        ReleaseUdtTemps_( c, c.stmtUdtMark )
        '' A STRING RESULT LEAVES THROUGH fb_StrAllocTempResult, exactly as a bare
        '' 'return' does. Loading the descriptor and returning IT gave 'ret [24 x i8]'
        '' in a function declared to return a pointer, and clang refused the module --
        '' AfxNova's DWStrAcode, 'if pwszStr = NULL then exit function'.
        if LowerStringReturn( c, Tko.NODE_NONE ) then return
        '' ...AND A UDT RETURNED THROUGH THE HIDDEN POINTER RETURNS THAT POINTER, as the
        '' end of the body does. There is no result slot to load, so this said 'ret void'
        '' -- AfxNova's DWStrBase64EncodeW, 'if bRes = 0 or cchStr = 0 then exit function'.
        if (c.udtResult = false) andalso (c.sretParam >= 0) then
            EmitCleanupsTo( c, 0 )
            dim as MirValue xsp
            xsp.kind = cast( uint8, MV_LOCAL )
            xsp.ty = cast( uint8, MT_PTR )
            xsp.id = c.sretParam
            Terminate( c, MTERM_RET, -1, -1, LowerExprLoad( c, xsp, MT_PTR ) )
            c.curBlock = -1
            return
        end if
        dim as MirValue rv = LoadResult( c )
        EmitCleanupsTo( c, 0 )
        Terminate( c, MTERM_RET, -1, -1, rv )
        c.curBlock = -1
        return
    end if
    '' 'continue sub' does not exist, and neither does 'continue select/scope'.
    if (isExit = false) andalso isProcExit then
        SkipHere( c )
        return
    end if

    '' Walk outwards counting only frames of the requested KIND. 'exit any' and an
    '' unnamed target take whatever is innermost.
    dim as boolean anyKind = (want = 0) orelse (want = Tko.KW_ANY)
    dim as int32 at = -1
    dim as int32 seen = 0
    for i as int32 = c.loopKind.Count - 1 to 0 step -1
        dim as boolean match = anyKind
        if match = false then match = (c.loopKind[i] = cast( int32, want ))
        '' CONTINUE only ever targets a loop: a select or scope frame has no
        '' continue target, and stepping over it would branch to -1.
        if (isExit = false) andalso (c.contTo[i] < 0) then match = false
        if match then
            seen += 1
            if seen = levels then
                at = i
                exit for
            end if
        end if
    next

    if at < 0 then
        SkipHere( c )
        return
    end if

    dim as int32 dest = c.breakTo[at]
    if isExit = false then dest = c.contTo[at]
    '' A SCOPE frame carries -1 until the first 'exit scope' asks for a block. The
    '' id is written back so the scope itself branches there on the way out.
    if isExit andalso (dest < 0) andalso (c.loopKind[at] = cast( int32, Tko.KW_SCOPE )) then
        dest = NewBlock( c, "scope.exit" )
        c.breakTo[at] = dest
    end if
    if dest < 0 then
        SkipHere( c )
        return
    end if

    EmitCleanupsTo( c, c.loopScope[at] )
    Terminate( c, MTERM_BR, dest, -1, NoVal( ) )
    c.curBlock = -1
end sub


declare function StrSwapKind_ _
    ( byref c as Ctx, byval t as Tko.TypeId, byref n as int64 ) as int32
declare function LowerStrCaseTest_ _
    ( byref c as Ctx, byref slotAddr as MirValue, byval wide as boolean, _
      byval val as Tko.NodeId ) as MirValue
declare function StrCaseCompare_ _
    ( byref c as Ctx, byref slotAddr as MirValue, byval wide as boolean, _
      byval val as Tko.NodeId, byval op as Tko.TokenKind ) as MirValue

sub LowerSelect( byref c as Ctx, byval id as Tko.NodeId )
    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    if sp->b = Tko.NODE_NONE then
        SkipHere( c )
        return
    end if

    dim as Tko.TypeId subjT = c.info->TypeOf_( sp->a )
    '' A USTRING CHAIN SUBJECT IS A USTRING, whatever Check says of '&' -- see IsUStrChain_.
    '' Typed STRING, 'select case u & "y"' copied the UTF-16 temporary with fb_StrAssign and
    '' compared it narrow, so no case matched. fbc: fb_UStrCompare per case value.
    dim as boolean subjChainU = IsUStrChain_( c, sp->a ) orelse UdtCastIsUStr_( c, sp->a )   '' ...or a uslice / ustring-casting UDT
    if subjChainU then subjT = c.types->Builtin( Tko.TY_USTRING )
    dim as MirType mt = LowerType( subjT, *c.types )

    '' THE SUBJECT'S TEMPORARIES DIE ONCE IT IS STORED, before the first CASE is tested.
    '' Measured, the body under fbc's 'select case takeR( mkH( 7 ) )' already sees the
    '' destructor's count, and so does the one under 'select case makeS( 5 ).s', whose
    '' string is copied out first.
    dim as int32 smark = c.udtTemps.Count

    '' A STRING SUBJECT IS COMPARED, NOT LOADED. 'select case s : case "a"' was
    '' loading the DESCRIPTOR'S first eight bytes and comparing them against the
    '' literal's ADDRESS truncated to 32 bits -- verifier-clean, no decline, and wrong
    '' every time. fbc emits one fb_StrCompare per case value and tests its result
    '' against zero, which is what the ordinary string comparison already does.
    ''
    '' The subject is evaluated ONCE into a slot holding its descriptor pointer, so a
    '' subject with a side effect runs once however many cases follow.
    dim as int32 strMode = -1
    '' THE PROBE'S ANSWER IS THE SUBJECT. StrDescriptorOf_ emits the subject's code, so asking
    '' it twice ran 'select case f( )' twice over a slice-returning f, and the first pool
    '' descriptor was never released: one lost per execution of the SELECT.
    dim as MirValue subjProbe
    dim as boolean subjProbed = false
    '' ...AND A WIDE CHAIN, which Check types STRING: 'select case w & "y"' went to the
    '' narrow descriptor path, declined, and the whole SELECT was dropped -- no case ran.
    '' fbc compares every case value against the chain with fb_WstrCompare.
    if TermIsWide_( c, sp->a ) orelse IsWideChain_( c, sp->a ) then
        strMode = 1
    else
        dim as int64 sn0
        if IsStringType( c, subjT ) orelse (StrSwapKind_( c, subjT, sn0 ) >= 0) then
            strMode = 0
        elseif c.types->Kind( subjT ) = Tko.TK_UDT then
            if StrDescriptorOf_( c, sp->a, subjProbe ) then
                strMode = 0
                subjProbed = true
            end if
        end if
    end if

    '' 'SELECT CASE AS CONST *p' OVER A STRING POINTER IS A JUMP ON THE CHARACTER, not a string
    '' compare: fbc's compound/select_const.bas walks a zstring this way, 250 included. tiko copied
    '' the rest of the string and compared it against each case turned into text -- case else.
    if (strMode >= 0) andalso (cast( Tko.TokenKind, sp->op ) = Tko.KW_CONST) andalso _
       (CharLvalueTy_( c, sp->a ) <> MT_VOID) then
        strMode = -1
        mt = CharLvalueTy_( c, sp->a )   '' the character, unsigned: 250 is 250
        subjT = c.types->Builtin( iif( mt = MT_I8, Tko.TY_UBYTE, iif( c.types->target.wcharBytes = 4, Tko.TY_ULONG, Tko.TY_USHORT ) ) )
    end if
    dim as MirValue slotAddr
    dim as int32 swmark = c.wstrTemps.Count
    if strMode >= 0 then
        dim as MirValue sv
        dim as boolean got = false
        if strMode = 1 then
            got = WideOperand_( c, sp->a, sv )
        elseif subjProbed then
            sv = subjProbe
            got = true
        else
            got = StrDescriptorOf_( c, sp->a, sv )
        end if
        if got = false then
            SkipHere( c )
            return
        end if
        '' A SUBJECT THAT IS NOT ITS OWN DESCRIPTOR IS COPIED FIRST, and the copy is what
        '' the cases compare. Measured, over 'select case lcase( Spell( id ) )':
        ''
        ''     vr = fb_StrLcase2( SPELL( ID ), 0 )
        ''     fb_StrInit( &TMP, -1, vr, -1, 0 )
        ''     fb_StrCompare( &TMP, -1, "new", 4 ) ... one per case value
        ''     fb_StrDelete( &TMP )       -- on the RETURN out of a case as well
        ''
        '' The slot held the TEMPORARY'S POINTER instead, and fb_StrCompare releases a
        '' temporary argument: the first case value freed it, and every later one used it
        '' after the free and released it again. That corrupts the runtime's descriptor
        '' pool for good -- after one fall-through over four values, every later str()
        '' came back empty. The self-hosted compiler's IsAllocOperator_ is exactly this
        '' select, so from its first operator on every mangled name lost its lengths.
        ''
        '' A fixed-length or zstring subject arrives as a pool descriptor too, and is
        '' copied the same way; only a var-length string LVALUE is compared in place.
        '' The copy is released by its scope, which a RETURN inside a case runs.
        ''
        '' ...AND A SUBJECT THAT BUILT A TEMPORARY IS COPIED EVEN WHEN IT OWNS ITS
        '' DESCRIPTOR: 'makeS( 5 ).s' is a field of the object about to be destroyed.
        '' ...AND A USTRING TEMPORARY TOO. It was excluded, and fb_UStrCompare releases a
        '' temporary argument exactly as fb_StrCompare does: 'select case lcase( s )' matched
        '' its first case value and compared freed memory for the rest, so tracks' ticker
        '' table refused every 'futures' and 'stock' row. fbc: fb_UStrInit into a temporary.
        dim as boolean subjU = IsUStringType( c, subjT )
        '' ...AND A USTRING CHAIN IS ALWAYS ITS fb_UStrConcat TEMPORARY. StrArgOwnDescriptor_
        '' saw Check's STRING against the USTRING subject and said "owns it", so the first
        '' case value released it: 'case "Ux", "Uy"' missed. fbc: fb_UStrInit into TMP.
        dim as boolean copySubj = (strMode = 0)
        dim as boolean askOwn = copySubj andalso (c.udtTemps.Count = smark)
        '' ...AND A STRING SLICE IS ALWAYS A POOL DESCRIPTOR over its bytes (LowerSliceCast).
        '' StrArgOwnDescriptor_ answers "owns it" for anything that is not a string, so the
        '' first case value released it and each later one released it again, and two later
        '' temporaries then shared one descriptor: instr( f( ), "." ) compared f( ) with itself.
        dim as boolean subjSlice = (Slices.SliceUnitOfType( *c.types, *c.names, subjT ) <> Slices.SU_NONE)
        if askOwn andalso (not subjChainU) andalso (not subjSlice) then
            copySubj = (StrArgOwnDescriptor_( c, sp->a, subjT ) = false)
        end if
        if copySubj then
            dim as int32 dslot = NewTempLocal( c, MT_AGG, c.types->target.stringBytes )
            if dslot < 0 then
                SkipHere( c )
                return
            end if
            if subjU then c.f->locals[dslot].frontendType = subjT
            dim as MirValue dsc
            dsc.kind = cast( uint8, MV_LOCAL )
            dsc.ty = cast( uint8, MT_PTR )
            dsc.id = dslot
            ZeroStrTempAtEntry_( c, dsc )
            dim as containers.Array( of uint32 ) dargs
            dargs.Push( cast( uint32, dsc.kind ) ) : dargs.Push( cast( uint32, dsc.id ) )
            PushStrLen_( c, dargs, -1 )
            dargs.Push( cast( uint32, sv.kind ) ) : dargs.Push( cast( uint32, sv.id ) )
            PushStrLen_( c, dargs, -1 )
            dargs.Push( cast( uint32, MV_CONST_INT ) ) : dargs.Push( 0 )
            EmitRtl( c, iif( subjU, RTL_USTR_INIT, RTL_STR_ASSIGN ), dargs )
            c.cleanupNode.Push( 0 )
            c.cleanupSlot.Push( dslot )
            c.cleanupType.Push( 0 )
            sv = dsc
        end if
        dim as int32 pslot = NewTempLocal( c, MT_PTR, c.types->target.pointerBits \ 8 )
        if pslot < 0 then
            SkipHere( c )
            return
        end if
        '' THE SLOT CARRIES THE SUBJECT'S FLAVOUR: StrCaseCompare_ has only this slot to ask,
        '' and a bare pointer temp answered "not ustring", so 'select case name_' over a
        '' ustring compared UTF-16 with fb_StrCompare and matched nothing -- tracks' trade
        '' database refused its own '#tradedb' header. fbc: fb_UStrCompare per case value.
        if IsUStringType( c, subjT ) then c.f->locals[pslot].frontendType = subjT
        slotAddr.kind = cast( uint8, MV_LOCAL )
        slotAddr.ty = cast( uint8, MT_PTR )
        slotAddr.id = pslot
        StoreThrough( c, slotAddr, sv )
        '' A WIDE or USTRING subject, or a descriptor compared in place, still points into
        '' what it came from, so only a copied subject lets its temporaries go here.
        if copySubj then ReleaseUdtTemps_( c, smark )
    else
        if mt = MT_VOID then
            SkipHere( c )
            return
        end if
        dim as MirValue subj = LowerExpr( c, sp->a )
        if subj.kind = cast( uint8, MV_NONE ) then
            SkipHere( c )
            return
        end if
        '' A BOOLEAN SUBJECT IS STORED NORMALISED, as every case value is compared. The literal
        '' TRUE lowers as i8 -1, and the slot kept those bits while LowerCaseTest coerces each
        '' case value to the subject's type, which gives 1: 'select case true' matched no case,
        '' 'case true' included, and fell to 'case else'. A boolean variable already holds 0 or
        '' 1, which is why 'select case b' and 'select case false' worked. fbc: 'take a coat'.
        if IsBooleanType( c, subjT ) then
            subj = CoerceTy( c, subj, mt, c.info->TypeOf_( sp->a ), subjT )
        end if
        dim as int32 slot = NewTempLocal( c, mt, c.types->Layout( subjT ).size )
        slotAddr.kind = cast( uint8, MV_LOCAL )
        slotAddr.ty = cast( uint8, MT_PTR )
        slotAddr.id = slot
        dim as MirInst st0
        st0.op = cast( uint16, M_STORE )
        st0.ty = cast( uint8, MT_VOID )
        st0.a = slotAddr
        st0.b = subj
        Emit( c, st0 )
        '' An AGGREGATE subject keeps them to the end of the statement: its bytes are
        '' what the cases read.
        if mt <> MT_AGG then ReleaseUdtTemps_( c, smark )
    end if

    '' A WIDE SUBJECT'S TEMPORARIES ARE THE SELECT'S OWN SCOPE. Every case reads them, so
    '' they outlive the subject -- but on the statement-wide list only sel.join released
    '' them, and a RETURN out of a case leaked the chain: 'select case "a" & wstr( k )'
    '' in a function that returns from its case. Measured, fbc deletes the subject on
    '' that path before its 'goto' to the exit, and at the end of the SELECT.
    dim as boolean wideScope = (strMode = 1)
    if wideScope then
        PushScope( c, cast( uint32, id ) or SCOPE_KEY_OPT )
        for k as int32 = swmark to c.wstrTemps.Count - 1
            c.cleanupNode.Push( CLEANUP_WSTR_DELETE )
            c.cleanupSlot.Push( cast( int32, c.wstrTemps[k] ) )
            c.cleanupType.Push( 0 )
        next
        while c.wstrTemps.Count > swmark
            c.wstrTemps.Pop( )
        wend
    end if

    dim as Tko.ListPayload ptr lp = _
        c.ast->ListOf( sp->b )
    dim as int32 joinB = NewBlock( c, "sel.join" )
    '' A SELECT is a break TARGET: 'exit select' leaves it. It pushes no continue
    '' target -- 'continue select' does not exist -- so -1 marks the slot as one that
    '' must never be branched to.
    c.breakTo.Push( joinB )
    c.contTo.Push( -1 )
    c.loopScope.Push( c.scopeMark.Count )
    c.loopKind.Push( cast( int32, Tko.KW_SELECT ) )
    dim as boolean isUns = IsUnsignedType( c, subjT )

    '' AS CONST over an integer subject whose every case is a constant it holds: one
    '' switch, which LLVM can make a table -- lowerswitch.tiko. Otherwise the chain.
    dim as boolean switched = false
    if strMode < 0 then
        switched = LowerSelectSwitch( c, sp, slotAddr, mt, isUns, subjT, joinB )
    end if

    for i as int32 = 0 to iif( switched, -1, lp->count - 1 )
        dim as Tko.NodeId cs = c.ast->ChildAt( lp->first, i )
        if c.ast->Kind( cs ) <> Tko.N_CASE then continue for
        dim as Tko.StmtPayload ptr cp = StmtOf( c, cs )
        dim as int32 bodyB = NewBlock( c, "sel.body" )
        dim as int32 nextB = NewBlock( c, "sel.next" )

        '' Several values in one CASE are alternatives: any match enters the body, so
        '' each failed test falls through to the next value rather than to the body.
        for v as int32 = 0 to cp->count - 1
            dim as Tko.NodeId val = c.ast->ChildAt( cp->first, v )
            dim as int32 moreB = nextB
            if v < cp->count - 1 then moreB = NewBlock( c, "sel.alt" )
            '' A CASE VALUE'S TEMPORARIES DIE BEFORE ITS BRANCH, on both edges. fbc puts the
            '' destructor on the MATCH edge only, so a value that does not match leaks its
            '' temporary -- and 'case takeR( mkH( 1 ) ) to takeR( mkH( 2 ) )' destroys the
            '' second one on the edge that never built it, printing a garbage value. The
            '' match edge is measured and matched; the other edge is a deliberate divergence.
            dim as int32 vmark = c.udtTemps.Count
            dim as MirValue cond
            if strMode >= 0 then
                cond = LowerStrCaseTest_( c, slotAddr, (strMode = 1), val )
            else
                cond = LowerCaseTest( c, slotAddr, mt, isUns, val, subjT )
            end if
            ReleaseUdtTemps_( c, vmark )
            if cond.kind = cast( uint8, MV_NONE ) then
                SkipHere( c )
                Terminate( c, MTERM_BR, moreB, -1, NoVal( ) )
            else
                Terminate( c, MTERM_CONDBR, bodyB, moreB, cond )
            end if
            c.curBlock = moreB
        next
        if cp->count = 0 then Terminate( c, MTERM_BR, bodyB, -1, NoVal( ) )

        dim as int32 savedCur = c.curBlock
        c.curBlock = bodyB
        PushScope( c, cast( uint32, cp->b ) )
        LowerBlock( c, cp->b )
        CloseScope( c )
        Terminate( c, MTERM_BR, joinB, -1, NoVal( ) )
        c.curBlock = savedCur
    next

    '' CASE ELSE is the trailing block, reached when every test failed.
    if (switched = false) andalso (sp->c <> Tko.NODE_NONE) then
        PushScope( c, cast( uint32, sp->c ) )
        LowerBlock( c, sp->c )
        CloseScope( c )
    end if
    Terminate( c, MTERM_BR, joinB, -1, NoVal( ) )
    c.breakTo.Pop( )
    c.contTo.Pop( )
    c.loopScope.Pop( )
    c.loopKind.Pop( )
    c.curBlock = joinB
    if wideScope then CloseScope( c )
end sub

'' One CASE value against a STRING subject: fb_StrCompare or fb_WstrCompare, then the
'' case's operator against ZERO -- the same shape an ordinary string comparison takes.
''
'' 'slotAddr' holds the subject's DESCRIPTOR POINTER (narrow) or its uint16* (wide),
'' evaluated once before the first case.
private function LowerStrCaseTest_ _
    ( byref c as Ctx, byref slotAddr as MirValue, byval wide as boolean, _
      byval val as Tko.NodeId ) as MirValue

    dim as MirValue none_
    if val = Tko.NODE_NONE then return none_

    dim as Tko.TokenKind op = Tko.TK_EQ
    dim as Tko.NodeId lhsV = val
    dim as Tko.NodeId hiV = Tko.NODE_NONE
    if c.ast->Kind( val ) = Tko.N_CASE_RANGE then
        dim as Tko.StmtPayload ptr rp = StmtOf( c, val )
        lhsV = rp->a
        if cast( Tko.TokenKind, rp->op ) <> 0 then
            '' 'case is > "d"'.
            op = cast( Tko.TokenKind, rp->op )
        else
            '' 'case "a" to "c"' -- inclusive at both ends, so two comparisons.
            op = Tko.TK_GE
            hiV = rp->b
        end if
    end if

    dim as MirValue c1 = StrCaseCompare_( c, slotAddr, wide, lhsV, op )
    if c1.kind = cast( uint8, MV_NONE ) then return none_
    if hiV = Tko.NODE_NONE then return c1
    dim as MirValue c2 = StrCaseCompare_( c, slotAddr, wide, hiV, Tko.TK_LE )
    if c2.kind = cast( uint8, MV_NONE ) then return none_
    dim as MirInst i3
    i3.op = cast( uint16, M_AND )
    i3.ty = cast( uint8, MT_I8 )
    i3.a = c1
    i3.b = c2
    return Emit( c, i3 )
end function

'' One comparison of the stored subject against one case value.
private function StrCaseCompare_ _
    ( byref c as Ctx, byref slotAddr as MirValue, byval wide as boolean, _
      byval val as Tko.NodeId, byval op as Tko.TokenKind ) as MirValue

    dim as MirValue none_
    dim as MirValue subjPtr = LowerExprLoad( c, slotAddr, MT_PTR )
    if subjPtr.kind = cast( uint8, MV_NONE ) then return none_

    dim as containers.Array( of uint32 ) args
    dim as MirValue cmp
    if wide then
        dim as MirValue rv
        if WideOperand_( c, val, rv ) = false then
            if NarrowToWideTemp_( c, val, rv ) = false then return none_
        end if
        args.Push( cast( uint32, subjPtr.kind ) ) : args.Push( cast( uint32, subjPtr.id ) )
        args.Push( cast( uint32, rv.kind ) ) : args.Push( cast( uint32, rv.id ) )
        cmp = EmitRtl( c, RTL_WSTR_COMPARE, args )
    else
        '' The subject is a descriptor, so its length is -1; the case value pushes its
        '' own (pointer, length) pair the way every string term does.
        args.Push( cast( uint32, subjPtr.kind ) ) : args.Push( cast( uint32, subjPtr.id ) )
        args.Push( cast( uint32, MV_CONST_INT ) )
        args.Push( cast( uint32, cast( uint64, -1 ) ) )
        '' THE SUBJECT'S FLAVOUR, taken from the slot it was stored in: there is no
        '' subject NODE here, only its address, and the case value is usually a narrow
        '' literal that says nothing about which comparison is wanted.
        dim as boolean isU = false
        if slotAddr.kind = cast( uint8, MV_LOCAL ) then
            if (slotAddr.id >= 0) andalso (slotAddr.id < c.f->locals.Count) then
                isU = IsUStringType( c, c.f->locals[slotAddr.id].frontendType )
            end if
        end if
        '' A REAL STRING AS THE CASE VALUE IS CONVERTED, not reinterpreted -- the same
        '' fact as an ordinary ustring comparison. A literal still follows the subject.
        if isU then
            if UStrCmpOperand_( c, args, val ) = false then return none_
            cmp = EmitRtl( c, RTL_USTR_COMPARE, args )
        else
            if EmitStrTerm( c, args, val, false ) = false then return none_
            cmp = EmitRtl( c, RTL_STR_COMPARE, args )
        end if
    end if
    if cmp.kind = cast( uint8, MV_NONE ) then return none_

    dim as MirInst ins
    ins.op = cast( uint16, BinOpFor( op, MT_I32, false ) )
    ins.ty = cast( uint8, MT_I8 )
    ins.a = cmp
    ins.b = ConstInt( c, 0, MT_I32 )
    if ins.op = cast( uint16, M_NONE ) then return none_
    return Emit( c, ins )
end function

private function MirTypeBits_( byval t as MirType ) as int32
    select case t
    case MT_I8  : return 8
    case MT_I16 : return 16
    case MT_I32 : return 32
    case MT_I64 : return 64
    end select
    return 0
end function

'' DOES A SAME-SIGNEDNESS CASE VALUE NEED NO PROMOTION? When it is no wider than the
'' subject, or a constant inside the subject's range. Anything else -- a wider
'' variable, or a constant outside -- is compared in the promoted type.
private function CaseValueFits_ _
    ( byref c as Ctx, byval smt as MirType, byval vmt as MirType, _
      byval uns as boolean, byval vnode as Tko.NodeId ) as boolean

    dim as int32 sw = MirTypeBits_( smt )
    dim as int32 vw = MirTypeBits_( vmt )
    if (sw = 0) orelse (vw = 0) then return true
    if vw <= sw then return true
    if vnode = Tko.NODE_NONE then return false
    dim as Tko.ScopeId sc = c.info->ScopeOf( vnode )
    if sc = Tko.SCOPE_NONE then sc = c.procScope
    if sc = Tko.SCOPE_NONE then sc = c.modScope
    dim as Tko.Check.ConstVal cv = Tko.Check.ConstOf( _
        *c.ast, vnode, *c.srcMgr, *c.names, c.types->target.pointerBits, c.syms, sc )
    if cv.known = false then return false
    dim as int64 v = cv.value
    if uns then
        if v < 0 then return false
        return (v <= ((1ll shl sw) - 1))
    end if
    return (v >= -(1ll shl (sw - 1))) andalso (v <= ((1ll shl (sw - 1)) - 1))
end function

'' THE TYPE A CASE COMPARISON HAPPENS IN. A SELECT CASE test is a comparison, and fbc
'' promotes the subject and the case value exactly as it does for one written out --
'' see lowerexpr.tiko. Comparing at the SUBJECT's width and signedness answered the
'' wrong thing for a mixed pair. Measured against fbc:
''
''     dim as ulong ul = 10  : select case ul : case is < -1   fbc 'ge', tiko 'lt'
''     dim as ubyte ub = 200 : select case ub : case is > l    fbc 'gt', tiko 'le'
''     dim as integer i = -8 : select case i  : case is < ui   fbc 'lt', tiko 'ge'
''
'' False when either side is not an integer: a BOOLEAN subject normalises instead --
'' 'case TRUE' over a boolean is an equality against its storage value -- and a string
'' subject has its own path. The caller then keeps the subject's own width, as before.
private function CasePromote_ _
    ( byref c as Ctx, byval subjT as Tko.TypeId, byval valT as Tko.TypeId, _
      byref pmt as MirType, byref puns as boolean, _
      byval vnode as Tko.NodeId = Tko.NODE_NONE ) as boolean

    if (subjT = Tko.TYPE_NONE) orelse (valT = Tko.TYPE_NONE) then return false
    if IsBooleanType( c, subjT ) orelse IsBooleanType( c, valT ) then return false
    dim as MirType smt = LowerType( subjT, *c.types )
    dim as MirType vmt = LowerType( valT, *c.types )
    '' A MIXED pair is promoted -- see lowerexpr.tiko -- and so is a WIDER value of the
    '' same signedness, unless it is a constant the subject's own width holds exactly.
    '' Narrowing the value to the subject was taken to be harmless at the same sign, and
    '' it is not: over 'dim as short s = -2', 'case 65534' became -2 and matched, and over
    '' a long 0, 'case 4294967296' became 0. fbc compares in the promoted type and
    '' matches neither. A constant that fits keeps the narrow compare it always had.
    if IsUnsignedType( c, subjT ) = IsUnsignedType( c, valT ) then
        if CaseValueFits_( c, smt, vmt, IsUnsignedType( c, subjT ), vnode ) then return false
    end if
    dim as boolean okS = (smt = MT_I8) orelse (smt = MT_I16) orelse _
                         (smt = MT_I32) orelse (smt = MT_I64)
    dim as boolean okV = (vmt = MT_I8) orelse (vmt = MT_I16) orelse _
                         (vmt = MT_I32) orelse (vmt = MT_I64)
    if (okS = false) orelse (okV = false) then return false
    dim as Tko.TypeId pt = Tko.Check.BinaryResult( Tko.TK_PLUS, subjT, valT, *c.types )
    if pt = Tko.TYPE_NONE then return false
    dim as MirType p = LowerType( pt, *c.types )
    dim as boolean okP = (p = MT_I8) orelse (p = MT_I16) orelse _
                         (p = MT_I32) orelse (p = MT_I64)
    if okP = false then return false
    pmt = p
    puns = IsUnsignedType( c, pt )
    return true
end function





'' One CASE value against the subject: an equality, a range, or a relational test.
private function LowerCaseTest _
    ( byref c as Ctx, byref slotAddr as MirValue, byval mt as MirType, _
      byval isUns as boolean, byval val as Tko.NodeId, _
      byval subjT as Tko.TypeId = Tko.TYPE_NONE ) as MirValue

    dim as MirValue none_
    if val = Tko.NODE_NONE then return none_

    if c.ast->Kind( val ) = Tko.N_CASE_RANGE then
        dim as Tko.StmtPayload ptr rp = StmtOf( c, val )
        dim as Tko.TokenKind op = cast( Tko.TokenKind, rp->op )
        if op <> 0 then
            '' 'case is > 10' -- a relational test against one operand, in the type the
            '' two promote to.
            dim as MirType rmt = mt
            dim as boolean runs = isUns
            CasePromote_( c, subjT, c.info->TypeOf_( rp->a ), rmt, runs, rp->a )
            dim as MirValue cur = _
                CoerceTy( c, LowerExprLoad( c, slotAddr, mt ), rmt, subjT )
            dim as MirValue rhs = CoerceTy( c, LowerExpr( c, rp->a ), rmt, _
                                            c.info->TypeOf_( rp->a ), subjT )
            if rhs.kind = cast( uint8, MV_NONE ) then return none_
            dim as MirInst ins
            ins.op = cast( uint16, BinOpFor( op, rmt, runs ) )
            ins.ty = cast( uint8, MT_I8 )
            ins.a = cur
            ins.b = rhs
            if ins.op = cast( uint16, M_NONE ) then return none_
            return Emit( c, ins )
        end if

        '' 'case 4 to 6' -- inclusive at both ends, each end promoted with the subject
        '' on its own: the two ends need not be the same type.
        dim as MirType lmt = mt
        dim as boolean luns = isUns
        CasePromote_( c, subjT, c.info->TypeOf_( rp->a ), lmt, luns, rp->a )
        dim as MirValue lo = CoerceTy( c, LowerExpr( c, rp->a ), lmt, _
                                       c.info->TypeOf_( rp->a ), subjT )
        dim as MirValue c1 = none_
        if lo.kind <> cast( uint8, MV_NONE ) then
            dim as MirInst i1
            i1.op = cast( uint16, BinOpFor( Tko.TK_GE, lmt, luns ) )
            i1.ty = cast( uint8, MT_I8 )
            i1.a = CoerceTy( c, LowerExprLoad( c, slotAddr, mt ), lmt, subjT )
            i1.b = lo
            c1 = Emit( c, i1 )
        end if
        dim as MirType hmt = mt
        dim as boolean huns = isUns
        CasePromote_( c, subjT, c.info->TypeOf_( rp->b ), hmt, huns, rp->b )
        dim as MirValue hi = CoerceTy( c, LowerExpr( c, rp->b ), hmt, _
                                       c.info->TypeOf_( rp->b ), subjT )
        if (c1.kind = cast( uint8, MV_NONE )) orelse (hi.kind = cast( uint8, MV_NONE )) then
            return none_
        end if
        dim as MirInst i2
        i2.op = cast( uint16, BinOpFor( Tko.TK_LE, hmt, huns ) )
        i2.ty = cast( uint8, MT_I8 )
        i2.a = CoerceTy( c, LowerExprLoad( c, slotAddr, mt ), hmt, subjT )
        i2.b = hi
        dim as MirValue c2 = Emit( c, i2 )
        dim as MirInst i3
        i3.op = cast( uint16, M_AND )
        i3.ty = cast( uint8, MT_I8 )
        i3.a = c1
        i3.b = c2
        return Emit( c, i3 )
    end if

    '' TO THE SUBJECT'S TYPE, not merely to its width. A BOOLEAN subject holds 0 or
    '' 1 and the corpus writes 'case TRUE' with TRUE defined as -1, so the plain
    '' width coercion compared 1 against 255 and every such case fell to 'case
    '' else'. CoerceTy with the subject's type id narrows the way a store into a
    '' boolean does, which is what fbc compares.
    '' EQUALITY PROMOTES TOO, for the WIDTH rather than the sign: 'ulong 4294967295 =
    '' long -1' is false to fbc and true if the two meet as 32 bits.
    dim as MirType emt = mt
    dim as boolean euns = isUns
    CasePromote_( c, subjT, c.info->TypeOf_( val ), emt, euns, val )
    dim as MirValue rhs2 = CoerceTy( c, LowerExpr( c, val ), emt, _
                                     c.info->TypeOf_( val ), subjT )
    if rhs2.kind = cast( uint8, MV_NONE ) then return none_
    dim as MirInst ins2
    ins2.op = cast( uint16, BinOpFor( Tko.TK_EQ, emt, euns ) )
    ins2.ty = cast( uint8, MT_I8 )
    ins2.a = CoerceTy( c, LowerExprLoad( c, slotAddr, mt ), emt, subjT )
    ins2.b = rhs2

    return Emit( c, ins2 )
end function



'' 'on n goto l1, l2, l3' -- the COMPUTED GOTO, which was not lowered at all.
''
'' Measured semantics, and the two facts that matter are both in the range test fbc
'' emits:
''
''   TMP = (uint64)I$0;
''   if( (TMP - 1ull) > 2ull ) goto label$5;   <- past the list: FALL THROUGH
''   goto *tmp$7[TMP - 1ull];
''
'' -- the list is ONE-BASED, so the selector has 1 subtracted from it, and the test is
'' UNSIGNED, which is what makes a selector of 0 (or any negative) fall through in a
'' single comparison rather than needing two.
''
'' THE DISPATCH ITSELF IS A CHAIN HERE, not a jump table. fbc uses GCC's computed goto
'' over a static array of label addresses; MIR has BR and CONDBR and nothing else, so
'' the same choice is made with one equality test per label. Semantically identical --
'' the range test above still runs first, so the chain is entered only for a selector
'' that names a label -- and O(N) where fbc is O(1). The corpus's longest list is
'' three.
''
'' 'on n GOSUB' is a separate statement -- it pushes a return address -- and is NOT
'' lowered: it declines rather than jumping without one. 'on error goto' likewise; it
'' needs the error-handler machinery, which is not built.
'' fb_ErrorSetHandler returns the handler it replaced: 'ON LOCAL ERROR' keeps it.
private sub SaveOldHandler_( byref c as Ctx, byref old as MirValue )
    if old.kind = cast( uint8, MV_NONE ) then return
    dim as MirInst st
    st.op = cast( uint16, M_STORE )
    st.ty = cast( uint8, MT_VOID )
    st.a.kind = cast( uint8, MV_LOCAL )
    st.a.ty = cast( uint8, MT_PTR )
    st.a.id = c.errLocalHandler
    st.b = old
    Emit( c, st )
end sub

'' 'ON ERROR GOTO label' and 'ON ERROR GOTO 0'. Measured from fbc's own C:
''
''     fb_ErrorSetHandler( &&label$2 );      installs
''     fb_ErrorSetHandler( (void*)0ull );    'goto 0' clears it
''
'' The handler is an ADDRESS OF A LABEL -- GCC's '&&label', LLVM's blockaddress -- and
'' the runtime hands it back from a failed check for the caller to jump to. That jump is
'' the other half, at the check sites.
''
'' RESUME AND RESUME NEXT ARE NOT PART OF THIS and are not planned: fbc passes their
'' addresses as fb_ErrorThrowAt's third and fourth arguments and passes NULL for both in
'' a program that uses neither, which is what this emits.
private sub LowerOnError_( byref c as Ctx, byval id as Tko.NodeId )
    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )

    '' 'ON LOCAL ERROR' SAVES WHAT IT REPLACES (T69); ResolveErrorJumps_ puts it back
    '' before every 'ret'. Measured, fbc-modern 1.20:
    ''
    ''     TMP$1 = fb_ErrorSetHandler( &&label$4 );     the first ON LOCAL ERROR
    ''     label$3: fb_ErrorSetHandler( TMP$1 );        the procedure's exit
    ''
    '' At the FIRST such statement, not at entry, and nothing at module level -- both
    '' as fbc. tiko has more to put back than the handler: the setjmp buffer, which
    '' names THIS frame once the statement has run. Left behind, the caller's next
    '' error longjmped into a frame that had returned and crashed, its own handler
    '' never reached. fb_ErrorJmpBuf arms the buffer as it hands it over; harmless,
    '' since the handler is replaced and the buffer re-captured before anything runs.
    dim as boolean saving = false
    if (sp->extra = 4) andalso (c.errLocalSave = 0) andalso _
       (c.curProcSym <> Tko.SYMBOL_NONE) then
        dim as int32 hs = NewTempLocal( c, MT_PTR, 8 )
        dim as int32 bs = NewTempLocal( c, MT_AGG, ERR_LOCAL_JMP_BYTES )
        if (hs >= 0) andalso (bs >= 0) then
            dim as containers.Array( of uint32 ) none
            dim as MirValue jb = EmitRtl( c, RTL_ERROR_JMPBUF, none )
            if jb.kind <> cast( uint8, MV_NONE ) then
                dim as containers.Array( of uint32 ) cp
                cp.Push( cast( uint32, MV_LOCAL ) ) : cp.Push( cast( uint32, bs ) )
                cp.Push( cast( uint32, jb.kind ) ) : cp.Push( cast( uint32, jb.id ) )
                cp.Push( cast( uint32, MV_CONST_INT ) ) : cp.Push( ERR_LOCAL_JMP_BYTES )
                EmitRtl( c, RTL_MEM_COPY, cp )
                c.errLocalSave = bs + 1
                c.errLocalHandler = hs
                saving = true
            end if
        end if
    end if

    dim as containers.Array( of uint32 ) args
    if sp->name = 0 then
        '' 'ON ERROR GOTO 0' -- a null handler. The parser leaves the name empty for the
        '' integer form, which in the fb dialect can only be 0: a numeric label is fbc's
        '' error 146 here, so there is no other integer to mean.
        args.Push( cast( uint32, MV_CONST_INT ) )
        args.Push( 0 )
        dim as MirValue old0 = EmitRtl( c, RTL_ERROR_SET_HANDLER, args )
        if saving then SaveOldHandler_( c, old0 )
        return
    end if

    dim as int32 slot = LabelSlot( c, sp->name )
    dim as int32 d = c.labelDepth[slot]
    if (d < 0) orelse (d = LABEL_AMBIGUOUS) then
        SkipHere( c )
        return
    end if

    '' THE ADDRESS IS NOT KNOWN YET, and cannot be made known by creating the block
    '' early. A block is an EXTENT over the function's one instruction list, so blocks
    '' have to be created in the order they are FILLED -- see Emit. Calling LabelBlockOf
    '' here made the handler's block exist before the code between here and the label,
    '' and everything after was then emitted into the wrong extent: the handler came out
    '' as a bare 'br' into the jump block, the jump block branched back to it, and the
    '' two formed a loop that hung the assembler. The IR read plausibly.
    ''
    '' So the operand goes out as a null placeholder and ResolveErrorJumps_ rewrites it
    '' once the label has been reached and its block exists in order.
    dim as int32 argAt = c.m->argPool.Count
    args.Push( cast( uint32, MV_CONST_INT ) )
    args.Push( 0 )
    dim as MirValue old = EmitRtl( c, RTL_ERROR_SET_HANDLER, args )
    if saving then SaveOldHandler_( c, old )
    c.errPendingArg.Push( cast( uint32, argAt ) )
    c.errPendingSlot.Push( cast( uint32, slot ) )

    '' AND THE LANDING POINT FOR A THROW IN ANOTHER PROCEDURE.
    ''
    '' fbc's thrower RETURNS the handler's address and the raising procedure does
    '' 'goto *vr$1' -- across functions, into whichever one installed the handler.
    '' LLVM's indirectbr cannot leave its own function, so that worked here only when
    '' the throw and its ON ERROR were in the SAME procedure; a throw in a callee ran
    '' off the 'unreachable' after the call and died on int3 (measured: STATUS_BREAKPOINT
    '' from com/comptr-error-path.bas, and from a four-line repro).
    ''
    '' So the frame is captured HERE, with the C library's own setjmp, and the runtime
    '' longjmps into it -- lib/rt/src/c/errjmp.c. It has to be this frame: a buffer
    '' captured inside a runtime helper would name a frame that has already returned.
    '' NOTHING IS UNWOUND on the way, which is the behaviour the corpus pins down --
    '' longjmp restores registers and the stack pointer and runs no destructor and no
    '' DEFER, exactly as fbc's computed goto does by doing even less.
    ''
    '' setjmp RETURNS TWICE: 0 when it is called, non-zero when longjmp arrives. The
    '' non-zero arm asks the runtime which handler is current -- the address is not a
    '' constant this procedure holds -- and jumps through it. The destination list is
    '' filled by ResolveErrorJumps_ with every handler block in this procedure, the
    '' same patch the throw sites use.
    dim as containers.Array( of uint32 ) noargs
    dim as MirValue buf = EmitRtl( c, RTL_ERROR_JMPBUF, noargs )
    if buf.kind = cast( uint8, MV_NONE ) then return

    dim as containers.Array( of uint32 ) sjargs
    sjargs.Push( cast( uint32, buf.kind ) )
    sjargs.Push( cast( uint32, buf.id ) )
    '' A NULL FRAME POINTER, deliberately. MSVC's _setjmp takes (env, frame) and a
    '' null frame is the jump that does NOT unwind SEH, which is the FreeBASIC
    '' semantics; glibc's _setjmp takes (env) alone and ignores the second register.
    sjargs.Push( cast( uint32, MV_CONST_INT ) )
    sjargs.Push( 0 )
    dim as RtlId sjId = RTL_SETJMP
    if c.types->target.isMsvc then sjId = RTL_SETJMP_MSVC
    dim as MirValue sj = EmitRtl( c, sjId, sjargs )
    if sj.kind = cast( uint8, MV_NONE ) then return

    dim as MirInst cmp
    cmp.op = cast( uint16, M_ICMP_NE )
    cmp.ty = cast( uint8, MT_I32 )
    cmp.a = sj
    cmp.b = ConstInt( c, 0, MT_I32 )
    dim as MirValue cond = Emit( c, cmp )
    if cond.kind = cast( uint8, MV_NONE ) then return

    '' THE JUMP BLOCK FIRST, for the reason EmitErrorJump_ gives: a block is an extent
    '' over one instruction list, so they have to be filled in creation order.
    dim as int32 jumpB = NewBlock( c, "onerr.caught" )
    dim as int32 contB = NewBlock( c, "onerr.armed" )
    Terminate( c, MTERM_CONDBR, jumpB, contB, cond )

    c.curBlock = jumpB
    dim as containers.Array( of uint32 ) hargs
    dim as MirValue h = EmitRtl( c, RTL_ERROR_GET_HANDLER, hargs )
    c.errIndirectBlocks.Push( cast( uint32, jumpB ) )
    Terminate( c, MTERM_INDIRECTBR, -1, -1, h )
    c.curBlock = contB
end sub

sub LowerOnGoto( byref c as Ctx, byval id as Tko.NodeId )
    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    '' 'ON ERROR GOTO' is its own statement and not a computed goto at all; 4 is
    '' 'ON LOCAL ERROR GOTO'.
    if (sp->extra = 1) orelse (sp->extra = 4) then
        LowerOnError_( c, id )
        return
    end if
    '' 3 is 'on n gosub'; that is not this either.
    if sp->extra <> 2 then
        SkipHere( c )
        return
    end if
    if (sp->count < 1) orelse (sp->a = Tko.NODE_NONE) then
        SkipHere( c )
        return
    end if

    '' EVERY LABEL FIRST. A list naming one this procedure has not got would leave a
    '' branch to a block that never exists, so nothing is emitted until all of them
    '' are known -- the same rule LowerGoto applies to its single label.
    dim as containers.Array( of uint32 ) blocks
    for i as int32 = 0 to sp->count - 1
        dim as Tko.NodeId ln = c.ast->ChildAt( sp->first, i )
        if c.ast->Kind( ln ) <> Tko.N_IDENT then
            SkipHere( c )
            return
        end if
        dim as Tko.IdentPayload ptr lip = _
            c.ast->IdentOf( ln )
        dim as int32 slot = LabelSlot( c, lip->name )
        dim as int32 d = c.labelDepth[slot]
        if (d < 0) orelse (d = LABEL_AMBIGUOUS) then
            SkipHere( c )
            return
        end if
        blocks.Push( cast( uint32, LabelBlockOf( c, slot ) ) )
    next

    dim as MirValue sel = LowerExpr( c, sp->a )
    if sel.kind = cast( uint8, MV_NONE ) then
        SkipHere( c )
        return
    end if
    sel = Coerce( c, sel, MT_I64, true )

    '' THE LIST IS ONE-BASED: the index is the selector minus one.
    dim as MirValue one
    one.kind = cast( uint8, MV_CONST_INT )
    one.ty = cast( uint8, MT_I64 )
    one.id = 1
    dim as MirInst sub_
    sub_.op = cast( uint16, M_SUB )
    sub_.ty = cast( uint8, MT_I64 )
    sub_.a = sel
    sub_.b = one
    dim as MirValue idx = Emit( c, sub_ )
    if idx.kind = cast( uint8, MV_NONE ) then
        SkipHere( c )
        return
    end if

    '' ...and the range test is UNSIGNED, so 0 and every negative selector fall
    '' through on the same comparison.
    dim as MirValue hi
    hi.kind = cast( uint8, MV_CONST_INT )
    hi.ty = cast( uint8, MT_I64 )
    hi.id = cast( uint32, sp->count - 1 )
    dim as MirInst cmp
    cmp.op = cast( uint16, M_ICMP_UGT )
    cmp.ty = cast( uint8, MT_I64 )
    cmp.a = idx
    cmp.b = hi
    dim as MirValue over = Emit( c, cmp )
    if over.kind = cast( uint8, MV_NONE ) then
        SkipHere( c )
        return
    end if

    dim as int32 afterB = NewBlock( c, "on.after" )
    dim as int32 testB = NewBlock( c, "on.test" )
    Terminate( c, MTERM_CONDBR, afterB, testB, over )

    for i as int32 = 0 to sp->count - 1
        c.curBlock = testB
        dim as MirValue k
        k.kind = cast( uint8, MV_CONST_INT )
        k.ty = cast( uint8, MT_I64 )
        k.id = cast( uint32, i )
        dim as MirInst eq
        eq.op = cast( uint16, M_ICMP_EQ )
        eq.ty = cast( uint8, MT_I64 )
        eq.a = idx
        eq.b = k
        dim as MirValue hit = Emit( c, eq )
        if hit.kind = cast( uint8, MV_NONE ) then
            SkipHere( c )
            return
        end if
        dim as int32 nextB = afterB
        if i < (sp->count - 1) then nextB = NewBlock( c, "on.test" )
        Terminate( c, MTERM_CONDBR, cast( int32, blocks[i] ), nextB, hit )
        testB = nextB
    next

    c.curBlock = afterB
end sub


sub LowerDo( byref c as Ctx, byval id as Tko.NodeId )
    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    dim as uint16 flags = c.ast->Flags( id )
    dim as boolean postCond = ((flags and Tko.NF_POST_COND) <> 0)
    dim as boolean isUntil = ((flags and Tko.NF_UNTIL) <> 0)

    dim as int32 headB = NewBlock( c, "do.head" )
    dim as int32 bodyB = NewBlock( c, "do.body" )
    dim as int32 exitB = NewBlock( c, "do.exit" )
    Terminate( c, MTERM_BR, iif( postCond, bodyB, headB ), -1, NoVal( ) )

    '' THE POST-TEST CONDITION LIVES IN 'c', NOT IN 'a', and this read 'a' either way.
    ''
    '' The parser puts a LEADING 'do while c' in sp.a and a TRAILING 'loop while c' in
    '' sp.c -- they can both be present, which is why they are separate fields. Reading
    '' only 'a' meant a post-test loop saw NO condition at all and fell to the
    '' unconditional else-branch below:
    ''
    ''     do.head1:  br do.body2
    ''     do.body2:  ... br do.head1
    ''     do.exit3:  <unreachable>
    ''
    '' -- an infinite loop, for EVERY 'loop while' and 'loop until' in the language.
    '' Measured: 'do : i += 1 : loop while i < 10' prints 10 under fbc and never
    '' terminates under tiko, while the pre-test spellings were right all along.
    ''
    '' Nothing caught it because no golden asserts a post-test loop's RUNTIME
    '' behaviour and the IR it produces is perfectly well formed -- the verifier has
    '' nothing to object to. build/runscan.sh found it as a 30-second timeout in
    '' scopes/dtor_eol_eof2.bas.
    dim as Tko.NodeId condE = sp->a
    if postCond then condE = sp->c

    c.curBlock = headB
    if condE <> Tko.NODE_NONE then
        '' A UDT temporary made by the CONDITION dies here, not at the end of the
        '' loop: the head runs again on every iteration and the slot is the same one.
        dim as int32 umark = c.udtTemps.Count
        dim as MirValue cond = LowerCondition( c, condE )
        ReleaseUdtTemps_( c, umark )
        '' UNTIL is the same test with the arms swapped, which is cheaper than
        '' emitting a negation and is exactly what fbc's own lowering does.
        if isUntil then
            Terminate( c, MTERM_CONDBR, exitB, bodyB, cond )
        else
            Terminate( c, MTERM_CONDBR, bodyB, exitB, cond )
        end if
    else
        Terminate( c, MTERM_BR, bodyB, -1, NoVal( ) )
    end if

    c.curBlock = bodyB
    c.breakTo.Push( exitB )
    c.contTo.Push( headB )
    c.loopScope.Push( c.scopeMark.Count )
    c.loopKind.Push( cast( int32, Tko.KW_DO ) )
    PushScope( c, cast( uint32, sp->b ) )
    LowerBlock( c, sp->b )
    CloseScope( c )
    c.loopScope.Pop( )
    c.loopKind.Pop( )
    c.breakTo.Pop( )
    c.contTo.Pop( )
    Terminate( c, MTERM_BR, headB, -1, NoVal( ) )
    c.curBlock = exitB
end sub


sub LowerIf _
    ( byref c as Ctx, byval id as Tko.NodeId, byval sp as Tko.StmtPayload ptr )

    '' The branches hang off a list of N_IF_BRANCH, each with its own condition; the
    '' ELSE body is 'c'.
    dim as Tko.NodeId branches = sp->b
    if branches = Tko.NODE_NONE then
        SkipHere( c )
        return
    end if
    dim as Tko.ListPayload ptr lp = _
        c.ast->ListOf( branches )

    dim as int32 joinB = NewBlock( c, "if.join" )
    for i as int32 = 0 to lp->count - 1
        dim as Tko.NodeId br = c.ast->ChildAt( lp->first, i )
        if c.ast->Kind( br ) <> Tko.N_IF_BRANCH then continue for
        dim as Tko.StmtPayload ptr bp = StmtOf( c, br )
        dim as int32 thenB = NewBlock( c, "if.then" )
        dim as int32 elseB = NewBlock( c, "if.else" )
        '' A CONDITION THAT WOULD NOT LOWER IS A DECLINE. It used to go out as
        '' 'condbr _, then, else' -- a conditional branch with NO CONDITION -- which
        '' the verifier passes and a backend cannot mean anything by. The IF counted as
        '' fully lowered while its test had vanished, which is the worst of the three
        '' outcomes and is how 'if a + b = c' looked for as long as a concatenation
        '' could not be compared.
        ''
        '' The branch still goes out, to the THEN side: an unconditional entry is no
        '' more wrong than a missing condition and keeps the block graph well formed,
        '' and the decline beside it is what says the test is missing.
        ''
        '' THE CONDITION'S TEMPORARIES DIE BEFORE THE BRANCH, on both edges. Measured, fbc
        '' runs the destructor of the temporary in 'if takeR( mkH( 0 ) ) = 1' ahead of an
        '' ELSEIF's own test, and ahead of a THEN body that reads the count. Waiting for the
        '' end of the IF ran it after the body instead.
        '' EVERY KIND OF TEMPORARY THE CONDITION MAKES IS RELEASED ON THE CONDITION'S OWN
        '' PATH. The UDT mark below has always been here; the string and wide ones were
        '' not, so those temporaries stayed on the statement's list and LowerStmt released
        '' them at the END -- which is the JOIN BLOCK, the one block every arm reaches.
        ''
        '' An ELSEIF's condition is evaluated only when the arms before it failed, so the
        '' join then freed a temporary that path never created:
        ''
        ''     if.else7:   %31 = fb_WstrLeft( .. )   store @$tmp6, %31
        ''     if.then6:   store @okind, 1           br if.join5
        ''     if.join5:   %38 = load @$tmp6         fb_WstrDelete( %38 )
        ''
        '' -- uninitialised on the first pass and an ALREADY-FREED pointer on every one
        '' after it. 'if left( wl, 1 ) = "a" ... elseif left( wl, 2 ) = "b2"' over an
        '' AfxNova DWSTRING corrupted the heap in a dozen iterations, and tiko-editor
        '' died at 0xC0000374 classifying the first line of its own settings file.
        ''
        '' Measured: fbc destroys the condition's temporary immediately after the compare
        '' that used it -- '_ZN7AFXNOVA8DWSTRINGD1Ev( &TMP$9807$2 )' on the next line --
        '' inside the arm, never at the join.
        dim as int32 cmark = c.udtTemps.Count
        dim as int32 csmark = c.strTemps.Count
        dim as int32 cwmark = c.wstrTemps.Count
        dim as MirValue cond = LowerCondition( c, bp->a )
        ReleaseUdtTemps_( c, cmark )
        ReleaseStrTemps_( c, csmark )
        ReleaseWstrTemps_( c, cwmark )
        if cond.kind = cast( uint8, MV_NONE ) then
            SkipHere( c )
            Terminate( c, MTERM_BR, thenB, -1, NoVal( ) )
        else
            Terminate( c, MTERM_CONDBR, thenB, elseB, cond )
        end if
        '' AN ARM IS A SCOPE, and neither of them was one.
        ''
        '' Every other block-forming construct in this compiler brackets its body
        '' with PushScope/CloseScope -- LowerSelect, LowerDo, LowerFor, N_SCOPE, the
        '' loop bodies -- and IF did not. So a destructor or a 'defer' registered
        '' inside an arm stayed on the cleanup list until the PROCEDURE scope closed,
        '' and because nothing popped it BOTH arms' cleanups were still there:
        ''
        ''     if n = 1 then : dim t as Tr : ... : else : dim u as Tr : ... : end if
        ''
        '' printed 'then-body|after-if~T~T' where fbc prints 'then-body~T|after-if'.
        '' The second destructor ran over an object that was NEVER CONSTRUCTED, and
        '' over a type holding a string that is a release of a descriptor nothing
        '' wrote -- the probe crashed. Measured against fbc, which destroys at the
        '' END OF THE ARM, before the statement after the IF.
        c.curBlock = thenB
        PushScope( c, cast( uint32, bp->b ) )
        LowerBlock( c, bp->b )
        CloseScope( c )
        Terminate( c, MTERM_BR, joinB, -1, NoVal( ) )
        c.curBlock = elseB
    next

    '' ...AND THE ELSE BODY, for the same reason.
    if sp->c <> Tko.NODE_NONE then
        PushScope( c, cast( uint32, sp->c ) )
        LowerBlock( c, sp->c )
        CloseScope( c )
    end if
    Terminate( c, MTERM_BR, joinB, -1, NoVal( ) )
    c.curBlock = joinB
end sub

end namespace
