'' lowerimpl.tiko -- the constructor and destructor fbc writes for you.
''
'' 'type T : a as long : s as string : end type' declares neither, and fbc SYNTHESISES
'' both. Without them 'dim as T x : x.s = "hi"' handed fb_StrAssign a descriptor full of
'' whatever the stack held, which the runtime reads as an existing allocation and frees.
'' Not a leak -- a crash, from a program with no diagnostic against it.
''
'' Measured from fbc's own C output. The parts that are not guessable:
''
''   THE TRIGGERS ARE PER-OPERATION AND INDEPENDENT. A field with a user DESTRUCTOR
''   gives the enclosing type a destructor and NOTHING else; a field with a user
''   CONSTRUCTOR gives it a constructor and no destructor; 'extends object' gives it a
''   constructor -- the vptr store -- and no destructor. Declaring one of them never
''   suppresses the others.
''
''   THE BODY IS PREPENDED TO A USER-WRITTEN ONE, not used instead of it. A written
''   constructor still gets the base call, the field initialisation and the vptr store
''   in front of its own statements, and a written destructor still gets the field
''   releases and the base call after them. So this file is not only about types that
''   declare nothing.
''
''   CONSTRUCTOR ORDER: base, then fields in DECLARATION order, then the vptr.
''   DESTRUCTOR ORDER: the vptr, then the body, then fields in REVERSE declaration
''   order, then the base. Both measured, and the reverse is not symmetry -- it was
''   read off the offsets fbc emits.
''
'' NOT DONE, and stated rather than hidden: the implicit COPY CONSTRUCTOR and the
'' implicit 'operator let'. fbc synthesises both wherever it synthesises a constructor,
'' and without them 'dim as T y = x' and 'x = y' over a type holding a string copy the
'' descriptor bitwise -- two descriptors owning one buffer. That is the same class of
'' bug as the one this file fixes and it is still open.

#import "std/containers"
#include once "mir/lowerctx.ti"
#include once "mir/lowerstr.ti"
#include once "mir/lowercall.ti"
#include once "mir/lowerstruct.ti"
#include once "mir/lowerexpr.ti"
namespace Tko.Mir

'' Defined in lowerstr.tiko. IsStringType is true for a FIXED-LENGTH string too, and one
'' of those is bytes rather than a descriptor: zeroing it or handing it to fb_StrDelete
'' would be releasing something that was never allocated. Kind 0 is the var-length one.
declare function StrSwapKind_ _
    ( byref c as Ctx, byval t as Tko.TypeId, byref n as int64 ) as int32

private function IsObjectT_( byref c as Ctx, byval t as Tko.TypeId ) as boolean
    if t = Tko.TYPE_NONE then return false
    if c.types->Kind( t ) <> Tko.TK_UDT then return false
    return (c.types->NameOf( t ) = c.names->GetString( "object" ))
end function

'' The base a UDT extends, or nothing. 'extends' is a field named 'base' at offset 0.
private function ImplBaseOf_( byref c as Ctx, byval t as Tko.TypeId ) as Tko.TypeId
    if t = Tko.TYPE_NONE then return Tko.TYPE_NONE
    if c.types->Kind( t ) <> Tko.TK_UDT then return Tko.TYPE_NONE
    dim as Tko.SymbolId ts = UdtSymOf_( c, t )
    dim as Tko.Symbol ptr s = c.syms->SymbolAt( ts )
    if s = nullptr then return Tko.TYPE_NONE
    if s->inner = Tko.SCOPE_NONE then return Tko.TYPE_NONE
    dim as Tko.SymbolId bf = c.syms->LookupLocal( s->inner, c.vts->baseName )
    if bf = Tko.SYMBOL_NONE then return Tko.TYPE_NONE
    dim as Tko.Symbol ptr b = c.syms->SymbolAt( bf )
    if b = nullptr then return Tko.TYPE_NONE
    if b->kind <> cast( uint8, Tko.SYM_FIELD ) then return Tko.TYPE_NONE
    return b->type_
end function

'' The UDT symbol a TypeId belongs to.
function UdtSymOf_( byref c as Ctx, byval t as Tko.TypeId ) as Tko.SymbolId
    if t = Tko.TYPE_NONE then return Tko.SYMBOL_NONE
    if c.types->Kind( t ) <> Tko.TK_UDT then return Tko.SYMBOL_NONE
    dim as Tko.InternId tn = c.types->NameOf( t )
    if tn = 0 then return Tko.SYMBOL_NONE
    dim as Tko.ScopeId ds = cast( Tko.ScopeId, c.types->DeclScopeOf( t ) )
    dim as Tko.SymbolId ts = c.syms->LookupLocalTyped( ds, tn, true )
    if ts = Tko.SYMBOL_NONE then ts = c.syms->LookupTyped( ds, tn, true )
    return ts
end function

'' Does a member of this type need INITIALISING -- a string descriptor zeroed, a dynamic
'' array's descriptor built, a nested constructor run, a vptr stored?
private function TypeNeedsInitWalk_( byref c as Ctx, byval t as Tko.TypeId ) as boolean
    if t = Tko.TYPE_NONE then return false
    if IsStringType( c, t ) then return true
    if c.types->IsDynArray( t ) then return true
    if c.types->Kind( t ) = Tko.TK_ARRAY then
        '' A 'string * N' IS SPACE-FILLED, so it is work. Measured, fbc synthesises
        '' a constructor that fills each field with the right byte:
        ''
        ''     memset( (int64*)THIS, 0, 8 );              as integer n
        ''     memset( (uint8*)THIS + 8, 32, 4 );          as string * 4 a
        ''     memset( (int64*)(THIS + 16), 0, 8 );        as integer m
        ''
        '' Without this an all-fixed-string UDT answered 'nothing to initialise',
        '' no constructor was synthesised, and the blanket zero-fill left NULs
        '' where fbc leaves spaces: 'dim x as T1' over 'as string * 10 a' compared
        '' unequal to space( 10 ). A LOCAL of the same type was already right,
        '' which is why it survived. 'zstring * N' and 'wstring * N' stay zeroed.
        dim as Tko.TypeId el = t
        do while c.types->Kind( el ) = Tko.TK_ARRAY
            dim as Tko.TypeId nx = c.types->Inner( el )
            if nx = Tko.TYPE_NONE then exit do
            el = nx
        loop
        if c.types->Kind( el ) = Tko.TK_BUILTIN then
            if c.types->BuiltinOf( el ) = Tko.TY_FIXSTR then return true
        end if
        return TypeNeedsInit_( c, c.types->Inner( t ) )
    end if
    if c.types->Kind( t ) <> Tko.TK_UDT then return false

    '' A TABLE MEANS A VPTR, and the vptr is stored by the constructor.
    if c.vts <> nullptr then
        if c.vts->Find( t ) >= 0 then return true
    end if
    if StructorWithArity( c, StructorOf( c, t, "__ctor" ), 0 ) <> Tko.SYMBOL_NONE then
        return true
    end if

    dim as Tko.SymbolId ts = UdtSymOf_( c, t )
    dim as Tko.Symbol ptr s = c.syms->SymbolAt( ts )
    if s = nullptr then return false
    if s->inner = Tko.SCOPE_NONE then return false
    dim as Tko.SymScope ptr sc = c.syms->ScopeAt( s->inner )
    if sc = nullptr then return false
    dim as Tko.SymbolId cur = sc->firstSym
    dim as int32 guard = 0
    while (cur <> Tko.SYMBOL_NONE) andalso (guard < 100000)
        guard += 1
        dim as Tko.Symbol ptr f = c.syms->SymbolAt( cur )
        if f = nullptr then exit while
        if f->kind = cast( uint8, Tko.SYM_FIELD ) then
            '' A DECLARED '= value' IS ITSELF WORK, whatever the field's type says.
            '' Without this an all-scalar UDT answered "nothing to initialise" and no
            '' constructor was synthesised at all, so there was no prologue for the
            '' stores below to go in.
            if FieldInitOf_( c, f ) <> Tko.NODE_NONE then return true
            if f->type_ <> t then
                if TypeNeedsInit_( c, f->type_ ) then return true
            end if
        end if
        cur = f->nextInScope
    wend
    return false
end function

'' ...and RELEASING? A string, a dynamic array, or anything holding one.
''
'' NOT the same set as above, which is what the measurement said and symmetry would
'' not: 'extends object' needs a constructor and no destructor, and a field with a
'' user constructor needs a constructor and no destructor either.
private function TypeNeedsDtorWalk_( byref c as Ctx, byval t as Tko.TypeId ) as boolean
    if t = Tko.TYPE_NONE then return false
    if IsObjectT_( c, t ) then return false
    if IsStringType( c, t ) then return true
    if c.types->IsDynArray( t ) then return true
    if c.types->Kind( t ) = Tko.TK_ARRAY then return TypeNeedsDtor_( c, c.types->Inner( t ) )
    if c.types->Kind( t ) <> Tko.TK_UDT then return false

    if StructorWithArity( c, StructorOf( c, t, "__dtor" ), 0 ) <> Tko.SYMBOL_NONE then
        return true
    end if

    dim as Tko.SymbolId ts = UdtSymOf_( c, t )
    dim as Tko.Symbol ptr s = c.syms->SymbolAt( ts )
    if s = nullptr then return false
    if s->inner = Tko.SCOPE_NONE then return false
    dim as Tko.SymScope ptr sc = c.syms->ScopeAt( s->inner )
    if sc = nullptr then return false
    dim as Tko.SymbolId cur = sc->firstSym
    dim as int32 guard = 0
    while (cur <> Tko.SYMBOL_NONE) andalso (guard < 100000)
        guard += 1
        dim as Tko.Symbol ptr f = c.syms->SymbolAt( cur )
        if f = nullptr then exit while
        if f->kind = cast( uint8, Tko.SYM_FIELD ) then
            if f->type_ <> t then
                if TypeNeedsDtor_( c, f->type_ ) then return true
            end if
        end if
        cur = f->nextInScope
    wend
    return false
end function

private function AnyFieldNeeds_ _
    ( byref c as Ctx, byval t as Tko.TypeId, byval forDtor as boolean ) as boolean

    dim as Tko.SymbolId ts = UdtSymOf_( c, t )
    dim as Tko.Symbol ptr s = c.syms->SymbolAt( ts )
    if s = nullptr then return false
    if s->inner = Tko.SCOPE_NONE then return false
    dim as Tko.SymScope ptr sc = c.syms->ScopeAt( s->inner )
    if sc = nullptr then return false
    dim as Tko.SymbolId cur = sc->firstSym
    dim as int32 guard = 0
    while (cur <> Tko.SYMBOL_NONE) andalso (guard < 100000)
        guard += 1
        dim as Tko.Symbol ptr f = c.syms->SymbolAt( cur )
        if f = nullptr then exit while
        if (f->kind = cast( uint8, Tko.SYM_FIELD )) andalso (f->type_ <> t) then
            if forDtor then
                if TypeNeedsDtor_( c, f->type_ ) then return true
            else
                '' The same question as in TypeNeedsInit_, asked of THIS type's own
                '' constructor: a field with an initialiser gives it a body to have.
                if FieldInitOf_( c, f ) <> Tko.NODE_NONE then return true
                if TypeNeedsInit_( c, f->type_ ) then return true
            end if
        end if
        cur = f->nextInScope
    wend
    return false
end function

'' A DIFFERENT QUESTION FROM TypeNeedsInit_, and conflating the two put a dead 'load
'' this' in the prologue of every structor of every ordinary UDT.
''
''   TypeNeedsInit_( T )  -- "a MEMBER of type T needs initialising", which is true
''                           when T has a constructor of its own.
''   NeedsCtorBody_( T )  -- "T's OWN constructor has work to do", which that same
''                           constructor's existence says nothing about.
''
'' The base is an ordinary field here, so a base needing initialisation is covered by
'' the field scan.
function NeedsCtorBody_( byref c as Ctx, byval t as Tko.TypeId ) as boolean
    if t = Tko.TYPE_NONE then return false
    if IsObjectT_( c, t ) then return false
    if c.types->Kind( t ) <> Tko.TK_UDT then return false
    if c.vts <> nullptr then
        if c.vts->Find( t ) >= 0 then return true
    end if
    return AnyFieldNeeds_( c, t, false )
end function

function NeedsDtorBody_( byref c as Ctx, byval t as Tko.TypeId ) as boolean
    if t = Tko.TYPE_NONE then return false
    if IsObjectT_( c, t ) then return false
    if c.types->Kind( t ) <> Tko.TK_UDT then return false
    return AnyFieldNeeds_( c, t, true )
end function

'' The fields of a UDT, in declaration order, as (symbol, offset) pairs.
private sub FieldsInOrder_ _
    ( byref c as Ctx, byval t as Tko.TypeId, byref outv as containers.Array( of uint32 ) )

    dim as Tko.SymbolId ts = UdtSymOf_( c, t )
    dim as Tko.Symbol ptr s = c.syms->SymbolAt( ts )
    if s = nullptr then return
    if s->inner = Tko.SCOPE_NONE then return
    dim as Tko.SymScope ptr sc = c.syms->ScopeAt( s->inner )
    if sc = nullptr then return
    dim as Tko.SymbolId cur = sc->firstSym
    dim as int32 guard = 0
    while (cur <> Tko.SYMBOL_NONE) andalso (guard < 100000)
        guard += 1
        dim as Tko.Symbol ptr f = c.syms->SymbolAt( cur )
        if f = nullptr then exit while
        '' THE BASE IS NOT A FIELD HERE. It is constructed by its own call, before
        '' everything else, and treating it as an ordinary member would run its
        '' initialisation twice.
        if (f->kind = cast( uint8, Tko.SYM_FIELD )) andalso (f->name <> c.vts->baseName) then
            outv.Push( cast( uint32, cur ) )
        end if
        cur = f->nextInScope
    wend
end sub

'' A THIRD QUESTION, and conflating it with NeedsCtorBody_ left a WRITTEN constructor
'' with no prologue at all:
''
''   NeedsCtorBody_( T )     -- "must one be SYNTHESISED for T", which fbc answers no to
''                              for 'type D : n as integer : m as integer : end type':
''                              it emits no constructor for that type at all.
''   CtorPrologueWork_( T )  -- "GIVEN that a constructor exists, is there anything in
''                              front of the body" -- and every FIELD is, because each
''                              one that nothing else initialises is zeroed.
''
'' Measured: fbc's written 'constructor B( )' over two plain integers is two memsets
'' and then the body's own 'n = 7'. Asking the first question of the second's caller
'' meant the memsets were never emitted and the field the body does not write read
'' whatever the frame held.
function CtorPrologueWork_( byref c as Ctx, byval t as Tko.TypeId ) as boolean
    if NeedsCtorBody_( c, t ) then return true
    if t = Tko.TYPE_NONE then return false
    if IsObjectT_( c, t ) then return false
    if c.types->Kind( t ) <> Tko.TK_UDT then return false
    if ImplBaseOf_( c, t ) <> Tko.TYPE_NONE then return true
    dim as containers.Array( of uint32 ) flds
    FieldsInOrder_( c, t, flds )
    return (flds.Count > 0)
end function

'' The address of one field, given the object's address.
private function FieldAddr_ _
    ( byref c as Ctx, byref thisPtr as MirValue, byval t as Tko.TypeId, _
      byval nm as Tko.InternId ) as MirValue

    dim as boolean found = false
    dim as int32 off = c.udts->FieldOffset( t, nm, found )
    dim as MirValue none_
    if found = false then return none_
    dim as MirInst fa
    fa.op = cast( uint16, M_FIELD_ADDR )
    fa.ty = cast( uint8, MT_PTR )
    fa.a = thisPtr
    fa.imm = off
    return Emit( c, fa )
end function


'' ...and one member's release.
private sub DestroyMember_ _
    ( byref c as Ctx, byref addr as MirValue, byval ft as Tko.TypeId )

    if addr.kind = cast( uint8, MV_NONE ) then return
    if IsStringType( c, ft ) then
        if StrSwapKind_( c, ft, 0 ) = 0 then
            dim as containers.Array( of uint32 ) args
            args.Push( cast( uint32, addr.kind ) ) : args.Push( cast( uint32, addr.id ) )
            EmitRtl( c, StrRtlFor_( c, ft, RTL_STR_DELETE ), args )
        end if
        return
    end if
    '' A DYNAMIC ARRAY FIELD IS ERASED THE WAY 'erase' ERASES ONE, which for an element
    '' with structors means fb_ArrayEraseObj and the element's constructor and
    '' destructor -- not the bare fb_ArrayErase this used to emit. Measured, the
    '' generated destructor of a 'Box( of E )' holding an 'E' that declares both is
    ''
    ''     fb_ArrayEraseObj( THIS, (void*)&_ZN1EC1Ev, (void*)&_ZN1ED1Ev );
    ''
    '' -- and with the plain call NO ELEMENT WAS EVER DESTRUCTED, so every string an
    '' element held leaked, in a destructor that verified and counted as lowered. The
    '' LOCAL 'dim as E a( any )' already got this right; only the FIELD did not.
    ''
    '' EmitEraseDynAt_ is the same routine 'erase this.items' uses, so the two spellings
    '' cannot drift apart again.
    if c.types->IsDynArray( ft ) then
        EmitEraseDynAt_( c, addr, ft )
        return
    end if

    '' A FIXED ARRAY OF STRINGS AS A FIELD owns N descriptors, and NOTHING released
    '' them: the generated destructor walked the field list, found a type that is
    '' neither a string nor a dynamic array nor a UDT, and returned. Every string in
    '' every element leaked, in a destructor that verified and counted as lowered.
    ''
    '' Measured: fbc builds a temporary descriptor over the field and hands it to
    '' fb_ArrayDestructStr -- the same call it makes for a LOCAL fixed string array,
    '' which tiko-lang already got right. functions/bydesc.bas is one, and the
    '' USTRING twin is fb_ArrayDestructUStr.
    ''
    '' A UDT ELEMENT is NOT done here. fbc emits an inline reverse loop of element
    '' destructor calls for a field, and fb_ArrayDestructObj for a local; tiko-lang
    '' unrolls the local. Which of those a field should be is a choice, not a
    '' measurement, so it is left declining rather than guessed -- and it is a REAL
    '' leak, recorded in HANDOFF.
    if c.types->Kind( ft ) = Tko.TK_ARRAY then
        dim as Tko.TypeId aet = c.types->Inner( ft )
        if aet = Tko.TYPE_NONE then return

        '' A UDT ELEMENT IS DESTROYED ONE AT A TIME, LAST FIRST. fbc writes an
        '' inline reverse loop for a field and fb_ArrayDestructObj for a LOCAL of
        '' the same shape; tiko-lang UNROLLS the local, so unrolling the field is
        '' what keeps its own two spellings the same. All three destroy every
        '' element exactly once, in reverse -- the observable part.
        ''
        '' The recursion is the point: an element with its own destructor, one with
        '' only an implicit one, and a nested aggregate all go back through here.
        if IsStringType( c, aet ) = false then
            if c.types->Kind( aet ) <> Tko.TK_UDT then return
            dim as boolean aeD = (StructorWithArity( c, StructorOf( c, aet, "__dtor" ), 0 ) <> Tko.SYMBOL_NONE)
            if aeD = false then aeD = TypeNeedsDtor_( c, aet )
            if aeD = false then return
            dim as int64 aeN = FixedArrayElems( c, ft )
            if aeN <= 0 then return
            dim as int32 aeSz = SizeOfType( c, aet )
            if aeSz <= 0 then return
            for k as int64 = aeN - 1 to 0 step -1
                dim as MirInst afa
                afa.op = cast( uint16, M_FIELD_ADDR )
                afa.ty = cast( uint8, MT_PTR )
                afa.a = addr
                afa.imm = cast( int32, k * aeSz )
                dim as MirValue aea = Emit( c, afa )
                if aea.kind = cast( uint8, MV_NONE ) then return
                DestroyMember_( c, aea, aet )
            next
            return
        end if
        '' Only a VAR-LENGTH element owns anything; a 'zstring * N' element is
        '' bytes in place, exactly as it is for a scalar field above.
        dim as boolean aeU = IsUStringType( c, aet )
        if aeU = false then
            if StrSwapKind_( c, aet, 0 ) <> 0 then return
        end if
        dim as MirValue adesc
        if SynthFixedArrayDesc( c, addr, ft, adesc ) = false then return
        dim as containers.Array( of uint32 ) aargs
        aargs.Push( cast( uint32, adesc.kind ) ) : aargs.Push( cast( uint32, adesc.id ) )
        if aeU then
            EmitRtl( c, RTL_ARRAY_DESTRUCT_USTR, aargs )
        else
            EmitRtl( c, RTL_ARRAY_DESTRUCT_STR, aargs )
        end if
        return
    end if

    if c.types->Kind( ft ) <> Tko.TK_UDT then return

    dim as Tko.SymbolId dtor = StructorWithArity( c, StructorOf( c, ft, "__dtor" ), 0 )
    if dtor <> Tko.SYMBOL_NONE then
        dim as containers.Array( of uint32 ) none_
        EmitStructorCall( c, dtor, -1, @addr, @none_ )
        return
    end if
    if TypeNeedsDtor_( c, ft ) then CallImplicitDtor_( c, ft, addr )
end sub

'' The base call, the fields in DECLARATION order, then the vptr. Measured order, and
'' this runs in front of a user-written constructor's own statements as well.
sub EmitCtorPrologue_ _
    ( byref c as Ctx, byval t as Tko.TypeId, byref thisPtr as MirValue, _
      byval skipBase as boolean = false )

    if thisPtr.kind = cast( uint8, MV_NONE ) then return

    '' AN EXPLICIT 'base( ... )' REPLACES THE IMPLICIT DEFAULT BASE CONSTRUCTION.
    '' Measured: fbc's C for a constructor that writes one contains the chosen base
    '' constructor and NOTHING ELSE for the base. Emitting both ran the base
    '' constructor TWICE -- over the same storage, so a base that allocates leaked and
    '' one that counts counted twice, with nothing to say so.
    dim as Tko.TypeId bt = ImplBaseOf_( c, t )
    if skipBase then bt = Tko.TYPE_NONE
    if (bt <> Tko.TYPE_NONE) andalso (bt <> t) then
        '' The base subobject is at offset 0, so its address is this one -- but it is
        '' taken through field.addr all the same, because fbc's cast says so and a
        '' later change to that offset would otherwise be silent.
        dim as MirValue ba = FieldAddr_( c, thisPtr, t, c.vts->baseName )
        if ba.kind <> cast( uint8, MV_NONE ) then
            dim as Tko.SymbolId bc = StructorWithArity( c, StructorOf( c, bt, "__ctor" ), 0 )
            if bc <> Tko.SYMBOL_NONE then
                dim as containers.Array( of uint32 ) none_
                EmitStructorCall( c, bc, -1, @ba, @none_ )
            elseif TypeNeedsInit_( c, bt ) then
                CallImplicitCtor_( c, bt, ba )
            else
                '' A BASE WITH NO CONSTRUCTOR AT ALL IS ZEROED. Measured: fbc emits
                '' 'memset( (P*)THIS, 0, sizeof(P) )' as the first statement of the
                '' derived constructor, and tiko-lang emitted NOTHING -- it did not
                '' decline either, it silently left the base subobject holding whatever
                '' the allocation held.
                dim as int32 bsz2 = SizeOfType( c, bt )
                if bsz2 > 0 then
                    dim as containers.Array( of uint32 ) bz
                    bz.Push( cast( uint32, ba.kind ) ) : bz.Push( cast( uint32, ba.id ) )
                    bz.Push( cast( uint32, MV_CONST_INT ) ) : bz.Push( 0 )
                    bz.Push( cast( uint32, MV_CONST_INT ) ) : bz.Push( cast( uint32, bsz2 ) )
                    EmitRtl( c, RTL_MEMSET, bz )
                end if
            end if
        end if
    end if

    dim as containers.Array( of uint32 ) flds
    FieldsInOrder_( c, t, flds )
    for i as int32 = 0 to flds.Count - 1
        dim as Tko.Symbol ptr f = c.syms->SymbolAt( cast( Tko.SymbolId, flds[i] ) )
        if (f = nullptr) orelse UnionMemberSkip_( c, t, i, thisPtr ) then continue for   '' a UNION: zeroed, then its FIRST member's (lowermember.tiko)
        dim as Tko.NodeId fi = FieldInitOf_( c, f )
        '' '= ANY' IS THE WHOLE PROLOGUE SKIPPED FOR THIS FIELD -- no zero fill, no
        '' member constructor, no store, and not even the field.addr: fbc's constructor
        '' mentions the field nowhere at all. See FieldInitIsAny_ for the four probes;
        '' the one that decides the placement is 'i as inner = any', where inner
        '' declares a constructor and fbc's synthesised constructor is EMPTY. Skipping
        '' only the store would still have called it.
        ''
        '' The DESTRUCTOR is deliberately not changed to match: fbc still destroys an
        '' 'any' field, which is asymmetric and is what it does.
        if FieldInitIsAny_( c, fi ) then
            '' ...WITH ONE EXCEPTION, AND IT IS MEASURED RATHER THAN REASONED. A
            '' DYNAMIC ARRAY field still gets its whole descriptor: fbc's constructor
            '' for 'd(any) as long = any' writes the two pointers, the element size,
            '' the dimension count and the dimTB memset exactly as it would without the
            '' 'any'. Nothing else survives -- a USTRING field beside it in the same
            '' probe is left untouched and then DELETED by the destructor, which is
            '' fbc's own hazard and is copied here rather than second-guessed.
            if c.types->IsDynArray( f->type_ ) then
                dim as MirValue da = FieldAddr_( c, thisPtr, t, f->name )
                if da.kind <> cast( uint8, MV_NONE ) then InitMember_( c, da, f->type_ )
            end if
            continue for
        end if

        if BitfieldMemberInit_( c, thisPtr, t, f, fi ) then continue for   '' a bitfield: through its unit (lowerbf.tiko)
        dim as MirValue fa = FieldAddr_( c, thisPtr, t, f->name )
        if fa.kind = cast( uint8, MV_NONE ) then continue for
        '' A FIELD WITH NOTHING ELSE TO INITIALISE IT IS ZEROED, and this ran off the
        '' end of the loop instead. Measured, and it is a PER-FIELD memset of the
        '' field's own declared size rather than one over the whole object:
        ''
        ''   type Outer : k as integer = 9 : inn as Inner : arr(0 to 2) as integer : _
        ''                z as zstring * 8 : end type
        ''
        ''     *(int64*)THIS = 9ll;
        ''     __builtin_memset( (struct $5INNER*)((uint8*)THIS +  8ll), 0, 16ll );
        ''     __builtin_memset( (int64*)        ((uint8*)THIS + 24ll), 0, 24ll );
        ''     __builtin_memset( (char*)         ((uint8*)THIS + 48ll), 0,  8ll );
        ''
        '' It is not conditional on anything: a WRITTEN constructor gets the same zeros
        '' in front of its own statements -- fbc emits both memsets before the user's
        '' 'n = 7' -- and so does the one synthesised for 'extends object'. Without it
        '' 'type Q : a as integer = 5 : b as integer : end type' read b as whatever the
        '' frame held where fbc reads 0, which is the half of the field initialisers
        '' that a fully-initialised probe cannot show.
        ''
        '' A field that IS initialised is not zeroed first: fbc writes the value alone,
        '' and the string descriptor's own zeroing is InitMember_'s.
        dim as boolean needsInit = TypeNeedsInit_( c, f->type_ )
        if (needsInit = false) andalso (fi = Tko.NODE_NONE) then
            dim as int32 fsz = SizeOfType( c, f->type_ )
            if fsz > 0 then
                dim as containers.Array( of uint32 ) fz
                fz.Push( cast( uint32, fa.kind ) ) : fz.Push( cast( uint32, fa.id ) )
                fz.Push( cast( uint32, MV_CONST_INT ) ) : fz.Push( 0 )
                fz.Push( cast( uint32, MV_CONST_INT ) ) : fz.Push( cast( uint32, fsz ) )
                EmitRtl( c, RTL_MEMSET, fz )
            end if
            continue for
        end if

        '' A CONSTRUCTOR CALL AS THE INITIALISER REPLACES THE DEFAULT CONSTRUCTION.
        '' Measured: fbc's body for 'as A a = A( "456" )' is the chosen constructor and
        '' nothing before it. Running InitMember_ as well constructs the field TWICE --
        '' and for a type whose default constructor assigns a string, the second run
        '' overwrites a descriptor that already owns a buffer.
        dim as boolean fiIsCtorCall = false
        if fi <> Tko.NODE_NONE then
            if c.types->Kind( c.types->Unqualify( f->type_ ) ) = Tko.TK_UDT then
                fiIsCtorCall = (c.ast->Kind( fi ) = Tko.N_CALL)
                '' ...and so does a bare value that picks a converting constructor:
                '' 'host as DWSTRING = "127.0.0.1"' is fbc's DWSTRING( byref as string )
                '' on the field and nothing before it. See FieldConvCtorPick_.
                if fiIsCtorCall = false then
                    fiIsCtorCall = (FieldConvCtorPick_( c, f->type_, fi ) <> Tko.SYMBOL_NONE)
                end if
                '' ...and a value of the field's own type, copied or constructed once.
                if fiIsCtorCall = false then fiIsCtorCall = FieldSameTypeInit_( c, f->type_, fi )
            end if
        end if
        if needsInit andalso (fiIsCtorCall = false) then InitMember_( c, fa, f->type_ )
        RedimFieldInit_( c, fa, f )   '' 'redim a( 2 to 6 )' in the type -- lowerdesc.tiko
        '' AFTER the default initialisation, not instead of it: a field that needs a
        '' descriptor built still needs it, and the declared value goes on top.
        if fi <> Tko.NODE_NONE then EmitFieldInit_( c, fa, f->type_, fi )
    next

    '' LAST, after the fields -- measured. A derived constructor therefore overwrites
    '' what the base's just stored, which is what makes a virtual call inside a base
    '' constructor body reach the BASE override.
    StoreVptr_( c, t, thisPtr )
end sub

'' The fields in REVERSE declaration order, then the base. Runs AFTER a user-written
'' destructor's own statements.
sub EmitDtorEpilogue_ _
    ( byref c as Ctx, byval t as Tko.TypeId, byref thisPtr as MirValue )

    if thisPtr.kind = cast( uint8, MV_NONE ) then return

    dim as containers.Array( of uint32 ) flds
    FieldsInOrder_( c, t, flds )
    for i as int32 = flds.Count - 1 to 0 step -1
        dim as Tko.Symbol ptr f = c.syms->SymbolAt( cast( Tko.SymbolId, flds[i] ) )
        if f = nullptr then continue for
        if TypeNeedsDtor_( c, f->type_ ) = false then continue for
        DestroyMember_( c, FieldAddr_( c, thisPtr, t, f->name ), f->type_ )
    next

    dim as Tko.TypeId bt = ImplBaseOf_( c, t )
    if (bt <> Tko.TYPE_NONE) andalso (bt <> t) then
        dim as MirValue ba = FieldAddr_( c, thisPtr, t, c.vts->baseName )
        if ba.kind <> cast( uint8, MV_NONE ) then
            dim as Tko.SymbolId bd = StructorWithArity( c, StructorOf( c, bt, "__dtor" ), 0 )
            if bd <> Tko.SYMBOL_NONE then
                dim as containers.Array( of uint32 ) none_
                EmitStructorCall( c, bd, -1, @ba, @none_ )
            elseif TypeNeedsDtor_( c, bt ) then
                CallImplicitDtor_( c, bt, ba )
            end if
        end if
    end if
end sub

'' Does this type need a synthesised ASSIGNMENT -- 'operator let' -- and the COPY
'' CONSTRUCTOR that is built on it?
''
'' The same trigger set as the constructor, in every measured row. Without one,
'' 'dim as T y = x' and 'x = y' over a type holding a string copy the DESCRIPTOR
'' bitwise, and the two objects then own one buffer: a double free at scope exit, not a
'' leak.
''
'' A DYNAMIC ARRAY MEMBER STOPS IT. fbc copies one with fb_ArrayRedimTo and an element
'' loop; emitting an assignment that skipped the array would be worse than the bitwise
'' copy that happens today, because it would look like the field had been handled.
'' A DYNAMIC ARRAY MEMBER USED TO SUPPRESS THE WHOLE LET BODY, which left every copy
'' of such a type as a bitwise store of the DESCRIPTOR -- two objects over one buffer,
'' erased twice. CopyMember_ deep-copies the array now, so the body is wanted here
'' exactly as it is for any other member that cannot be copied bitwise.
function NeedsLetBody_( byref c as Ctx, byval t as Tko.TypeId ) as boolean
    '' 'object' is never bit-copied: its let is empty, its copy the runtime's (virtual/byval-copy.bas).
    if IsObjectT_( c, c.types->Unqualify( t ) ) then return true
    if NeedsCtorBody_( c, t ) then return true
    return HasDynArrayMember_( c, t )
end function

private function HasDynArrayWalk_( byref c as Ctx, byval t as Tko.TypeId ) as boolean
    if t = Tko.TYPE_NONE then return false
    if c.types->IsDynArray( t ) then return true
    if c.types->Kind( t ) <> Tko.TK_UDT then return false
    dim as Tko.SymbolId ts = UdtSymOf_( c, t )
    dim as Tko.Symbol ptr s = c.syms->SymbolAt( ts )
    if s = nullptr then return false
    if s->inner = Tko.SCOPE_NONE then return false
    dim as Tko.SymScope ptr sc = c.syms->ScopeAt( s->inner )
    if sc = nullptr then return false
    dim as Tko.SymbolId cur = sc->firstSym
    dim as int32 guard = 0
    while (cur <> Tko.SYMBOL_NONE) andalso (guard < 100000)
        guard += 1
        dim as Tko.Symbol ptr f = c.syms->SymbolAt( cur )
        if f = nullptr then exit while
        if (f->kind = cast( uint8, Tko.SYM_FIELD )) andalso (f->type_ <> t) then
            if HasDynArrayMember_( c, f->type_ ) then return true
        end if
        cur = f->nextInScope
    wend
    return false
end function

'' The VALUE at 'base + off', loaded as 'mt'. The array descriptor's own fields are
'' reached this way and nowhere else in this file.
'' The ADDRESS of a SYNTHESISED structor. FuncAddrOf names a WRITTEN procedure through
'' its symbol; an implicit one has no symbol, only the name EmitImplicit_ will give it,
'' so the function-table entry is found or declared by that name exactly as
'' CallImplByName_ does -- and the body is REQUESTED, or the address would point at a
'' declaration nothing ever defines.
function ImplStructorAddr_ _
    ( byref c as Ctx, byval t as Tko.TypeId, byval kind_ as int32 ) as MirValue

    dim as MirValue none_
    dim as string nm
    if kind_ = 1 then
        nm = ImplicitCtorName_( c, t )
    else
        nm = ImplicitDtorName_( c, t )
    end if
    if len( nm ) = 0 then return none_
    WantImplicit_( c, t, kind_ )
    dim as Tko.InternId id = c.names->GetString( nm )
    dim as int32 fidx = c.m->OldestFunctionNamed( id )
    if fidx < 0 then
        dim as MirFunction ptr decl = c.m->AddFunction( id, MT_VOID )
        decl->isDefinition = false
        '' AN IMPLICIT STRUCTOR TAKES POINTERS. 'this' is parameter zero and the
        '' right-hand side, where there is one, parameter one -- the same shape a
        '' written structor gets, and the reason both can be called through one path.
        decl->AddParam( MT_PTR )
        fidx = c.m->functions.Count - 1
    end if
    dim as MirInst fa
    fa.op = cast( uint16, M_FUNC_ADDR )
    fa.ty = cast( uint8, MT_PTR )
    fa.callee = cast( uint32, fidx )
    return Emit( c, fa )
end function

'' Store 'v' through the address 'addr'.
private sub ImplStoreTo_ _
    ( byref c as Ctx, byref addr as MirValue, byref v as MirValue )

    if (addr.kind = cast( uint8, MV_NONE )) orelse _
       (v.kind = cast( uint8, MV_NONE )) then return
    dim as MirInst st
    st.op = cast( uint16, M_STORE )
    st.ty = cast( uint8, MT_VOID )
    st.a = addr
    st.b = v
    Emit( c, st )
end sub

'' Advance the pointer held in the slot at 'addr' by 'n' BYTES. M_PTR_ADD takes a byte
'' offset already, so nothing here scales by an element size a second time.
private sub ImplBumpPtr_ _
    ( byref c as Ctx, byref addr as MirValue, byval n as int32 )

    if addr.kind = cast( uint8, MV_NONE ) then return
    dim as MirValue cur = LowerExprLoad( c, addr, MT_PTR )
    if cur.kind = cast( uint8, MV_NONE ) then return
    dim as MirType dit = MT_I64
    if c.types->target.pointerBits = 32 then dit = MT_I32
    dim as MirValue step_ = ConstInt( c, n, dit )
    dim as MirInst pa
    pa.op = cast( uint16, M_PTR_ADD )
    pa.ty = cast( uint8, MT_PTR )
    pa.a = cur
    pa.b = step_
    dim as MirValue nxt = Emit( c, pa )
    ImplStoreTo_( c, addr, nxt )
end sub

private function ImplFieldAt_ _
    ( byref c as Ctx, byref base_ as MirValue, byval off as int32, _
      byval mt as MirType ) as MirValue

    dim as MirValue none_
    if base_.kind = cast( uint8, MV_NONE ) then return none_
    dim as MirInst fa
    fa.op = cast( uint16, M_FIELD_ADDR )
    fa.ty = cast( uint8, MT_PTR )
    fa.a = base_
    fa.imm = off
    dim as MirValue a = Emit( c, fa )
    if a.kind = cast( uint8, MV_NONE ) then return none_
    return LowerExprLoad( c, a, mt )
end function

'' One member copied from another object of the same type.
private sub CopyMember_ _
    ( byref c as Ctx, byref dst as MirValue, byref src as MirValue, byval ft as Tko.TypeId )

    if (dst.kind = cast( uint8, MV_NONE )) orelse (src.kind = cast( uint8, MV_NONE )) then
        return
    end if

    '' A FIXED ARRAY FIELD IS COPIED ELEMENT BY ELEMENT, and it was copied BITWISE.
    ''
    '' The tail of this sub loads and stores the whole field, which for an array of
    '' var-length strings duplicates N DESCRIPTORS and leaves both objects pointing
    '' at one buffer each. Measured:
    ''
    ''     type Box3 : as string items( 0 to 3 ) : end type
    ''     dim a as Box3 : a.items(0) = \"ada\"
    ''     dim b as Box3 = a
    ''     a.items(0) = \"changed\"
    ''
    '' fbc leaves b as \"ada\"; tiko printed \"cha\" -- b reading a's reallocated buffer
    '' through its stale length -- and then exited 0xC0000374 on the double free.
    ''
    '' fbc's synthesised 'operator let' is a LOOP of fb_StrAssign, one per element,
    '' stride 24:
    ''
    ''     TMP$3 = THIS; TMP$4 = RHS; TMP$2 = 0
    ''     label$6: fb_StrAssign( TMP$3, -1, TMP$4, -1, 0 )
    ''              TMP$3 += 24; TMP$4 += 24; TMP$2 += 1
    ''              if TMP$2 <> 4 goto label$6
    ''
    '' UNROLLED here rather than looped, which is what DestroyMember_ already does
    '' for the same shape -- and the recursion is the point: a string element, a UDT
    '' element and a nested aggregate all come back through this sub.
    '' A DYNAMIC array is NOT this: its slot is a descriptor with its own copy rule
    '' further down, and claiming it here made 'dim b as T = a' over one emit nothing
    '' at all -- dynarray-elem-copy and udt-dynarray-copy both went silent.
    dim as boolean cFixedArr = (c.types->Kind( ft ) = Tko.TK_ARRAY)
    if cFixedArr then cFixedArr = (c.types->IsDynArray( ft ) = false)
    '' ...AND A FIXED-LENGTH STRING IS NOT ONE, though it is a TK_ARRAY of characters
    '' underneath. It has no bounds for FixedArrayElems to count, so this branch
    '' returned on 'ceN <= 0' having copied NOTHING: 'zstring * N', 'wstring * N' and
    '' 'ustring * N' all came out empty from every synthesised let and copy
    '' constructor -- which is any UDT that also holds a field with a structor.
    '' fb/tuibuffer.bi's TuiCell ('ustring * 4 text' beside a TuiStyle whose TuiColor
    '' has a constructor) is that shape, and every blank cell the tui library made
    '' was empty. It is plain bytes, so it takes the bitwise tail below, as that
    '' tail's own comment always said it did.
    dim as int64 cfsN = 0
    if cFixedArr then cFixedArr = (StrSwapKind_( c, ft, cfsN ) <= 0)
    if cFixedArr then
        dim as Tko.TypeId cet = c.types->Inner( ft )
        if cet = Tko.TYPE_NONE then return
        dim as int64 ceN = FixedArrayElems( c, ft )
        if ceN <= 0 then return
        dim as int32 ceSz = SizeOfType( c, cet )
        if ceSz <= 0 then return
        for k as int64 = 0 to ceN - 1
            dim as MirInst cda
            cda.op = cast( uint16, M_FIELD_ADDR )
            cda.ty = cast( uint8, MT_PTR )
            cda.a = dst
            cda.imm = cast( int32, k * ceSz )
            dim as MirValue cdv = Emit( c, cda )
            if cdv.kind = cast( uint8, MV_NONE ) then return
            dim as MirInst csa
            csa.op = cast( uint16, M_FIELD_ADDR )
            csa.ty = cast( uint8, MT_PTR )
            csa.a = src
            csa.imm = cast( int32, k * ceSz )
            dim as MirValue csv = Emit( c, csa )
            if csv.kind = cast( uint8, MV_NONE ) then return
            CopyMember_( c, cdv, csv, cet )
        next
        return
    end if

    '' A VAR-LENGTH STRING IS ASSIGNED, not copied: the descriptor owns a buffer, and
    '' fb_StrAssign is what releases the old one and takes a copy of the new.
    ''
    '' AND A USTRING IS A DIFFERENT CALL. fb_StrAssign copies LEN BYTES and a
    '' USTRING's length counts CODE UNITS, so a sixteen-character field came out
    '' eight characters followed by eight of whatever lay next in the process --
    '' environment strings, in the probe. It reads as a truncation and it is an
    '' OVERREAD. The generated destructor already called fb_UStrDelete for the same
    '' field, so the two disagreed about what the field was. A bare 'ustring =
    '' ustring' was always right; only the GENERATED member copy was wrong, and
    '' assignment, copy construction, a byval parameter, a result and an array copy
    '' all reach it.
    dim as int64 sn = 0
    if IsStringType( c, ft ) andalso (StrSwapKind_( c, ft, sn ) = 0) then
        dim as containers.Array( of uint32 ) args
        args.Push( cast( uint32, dst.kind ) ) : args.Push( cast( uint32, dst.id ) )
        args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( cast( uint32, -1 ) )
        args.Push( cast( uint32, src.kind ) ) : args.Push( cast( uint32, src.id ) )
        args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( cast( uint32, -1 ) )
        args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( cast( uint32, 0 ) )
        EmitRtl( c, iif( IsUStringType( c, ft ), RTL_USTR_ASSIGN, RTL_STR_ASSIGN ), args )
        return
    end if

    '' A DYNAMIC ARRAY FIELD IS DEEP-COPIED, and copying the DESCRIPTOR instead is
    '' worse than doing nothing: the two objects then share one buffer and BOTH
    '' destructors erase it. Measured over 'type Box: dim as double arr( any )' and
    '' 'dim as Box b = a', where fbc's generated LET is
    ''
    ''     fb_ArrayRedimTo( THIS, __FB_RHS__, 0, NULL, NULL );
    ''     <element loop: PTR to PTR, SIZE bytes>
    ''
    '' -- the resize first, out of the source's own descriptor, then the elements.
    '' fbc walks them one at a time because an element may have its own assignment;
    '' where none does, the loop is a straight byte copy of SIZE bytes and memcpy is
    '' the same thing. An element type that DOES need per-element work declines
    '' rather than guessing -- see below.
    if c.types->IsDynArray( ft ) then
        dim as Tko.TypeId et = c.types->Inner( ft )
        '' EVERY SHAPE THAT NEEDS fbc'S PER-ELEMENT LOOP, declined together: a
        '' var-length string element is an fb_StrAssign each, and a UDT element
        '' with an assignment of its own is a call each. A byte copy of either
        '' would alias a buffer the same way the descriptor copy did.
        dim as int64 esn = 0
        dim as boolean elemVarStr = false
        if IsStringType( c, et ) then
            elemVarStr = (StrSwapKind_( c, et, esn ) = 0)
        end if
        '' AN ELEMENT THAT ASSIGNS ITSELF needs fbc's loop rather than a byte copy:
        '' a var-length string element is an fb_StrAssign each, a UDT element with
        '' its own LET is a call each, and a byte copy of either would alias the
        '' buffer exactly the way the descriptor copy did.
        dim as boolean perElem = elemVarStr
        if StructorOf( c, et, "let" ) <> Tko.SYMBOL_NONE then perElem = true
        if NeedsLetBody_( c, et ) then perElem = true

        '' fb_ArrayRedimTo( dst, src, isString, ctor, dtor ). Measured, over the same
        '' 'dim as A y = x' with the element type varied:
        ''
        ''     double        ( ..., 0,  NULL,       NULL )
        ''     string        ( ..., -1, NULL,       NULL )
        ''     E with both   ( ..., 0,  &_ZN1EC1Ev, &_ZN1ED1Ev )
        ''
        '' -- so the flag says STRING and the last two are the element's structors,
        '' which the runtime runs over the elements it grows and drops. Passing NULL
        '' where one belongs leaves a grown element unconstructed, so an element
        '' needing an IMPLICIT structor declines here: FuncAddrOf names a WRITTEN
        '' procedure and a synthesised one has no symbol to name.
        dim as MirValue nulp = ConstInt( c, 0, MT_PTR )
        dim as MirValue flag = ConstInt( c, iif( elemVarStr, -1, 0 ), MT_I32 )
        dim as MirValue ector = nulp
        dim as MirValue edtor = nulp
        dim as Tko.SymbolId ecs = _
            StructorWithArity( c, StructorOf( c, et, "__ctor" ), 0 )
        dim as Tko.SymbolId eds = _
            StructorWithArity( c, StructorOf( c, et, "__dtor" ), 0 )
        if ecs <> Tko.SYMBOL_NONE then
            ector = FuncAddrOf( c, ecs, true )
        elseif TypeNeedsInit_( c, et ) andalso (elemVarStr = false) then
            ector = ImplStructorAddr_( c, et, 1 )
        end if
        if eds <> Tko.SYMBOL_NONE then
            edtor = FuncAddrOf( c, eds, true )
        elseif TypeNeedsDtor_( c, et ) andalso (elemVarStr = false) then
            edtor = ImplStructorAddr_( c, et, 0 )
        end if
        if (ector.kind = cast( uint8, MV_NONE )) orelse _
           (edtor.kind = cast( uint8, MV_NONE )) then
            SkipHere( c )
            return
        end if
        dim as containers.Array( of uint32 ) ra
        ra.Push( cast( uint32, dst.kind ) ) : ra.Push( cast( uint32, dst.id ) )
        ra.Push( cast( uint32, src.kind ) ) : ra.Push( cast( uint32, src.id ) )
        ra.Push( cast( uint32, flag.kind ) ) : ra.Push( cast( uint32, flag.id ) )
        ra.Push( cast( uint32, ector.kind ) ) : ra.Push( cast( uint32, ector.id ) )
        ra.Push( cast( uint32, edtor.kind ) ) : ra.Push( cast( uint32, edtor.id ) )
        EmitRtl( c, RTL_ARRAY_REDIM_TO, ra )

        '' PTR is at one pointer in and SIZE at two -- the descriptor layout in
        '' lowerdesc.tiko, halved on win32 like every other offset there. The copy
        '' reads the SOURCE's byte count, which is what fbc's loop bound is.
        dim as int32 pb = c.types->target.pointerBits \ 8
        dim as MirType dit = MT_I64
        if c.types->target.pointerBits = 32 then dit = MT_I32
        dim as MirValue dp = ImplFieldAt_( c, dst, pb, MT_PTR )
        dim as MirValue sp_ = ImplFieldAt_( c, src, pb, MT_PTR )
        dim as MirValue sz = ImplFieldAt_( c, src, pb * 2, dit )
        if (dp.kind = cast( uint8, MV_NONE )) orelse _
           (sp_.kind = cast( uint8, MV_NONE )) orelse _
           (sz.kind = cast( uint8, MV_NONE )) then
            SkipHere( c )
            return
        end if
        if perElem = false then
            dim as containers.Array( of uint32 ) ma
            ma.Push( cast( uint32, dp.kind ) ) : ma.Push( cast( uint32, dp.id ) )
            ma.Push( cast( uint32, sp_.kind ) ) : ma.Push( cast( uint32, sp_.id ) )
            ma.Push( cast( uint32, sz.kind ) ) : ma.Push( cast( uint32, sz.id ) )
            EmitRtl( c, RTL_MEM_COPY, ma )
            return
        end if

        '' THE PER-ELEMENT LOOP, which is fbc's shape:
        ''
        ''     TMP2 = THIS->PTR;  TMP3 = RHS->PTR;  TMP4 = TMP3 + RHS->SIZE;
        ''     while TMP3 < TMP4:  *TMP2 = *TMP3;  TMP2 += len;  TMP3 += len
        ''
        '' -- bounded by the SOURCE's byte count and stepped by the element size.
        '' The two cursors are slots because this IR has no phi: a temp would have
        '' to be redefined across the back edge.
        dim as int32 elen = SizeOfType( c, et )
        if elen <= 0 then
            SkipHere( c )
            return
        end if
        dim as int32 dcur = NewTempLocal( c, MT_PTR, pb )
        dim as int32 scur = NewTempLocal( c, MT_PTR, pb )
        if (dcur < 0) orelse (scur < 0) then
            SkipHere( c )
            return
        end if
        dim as MirValue dcurA, scurA
        dcurA.kind = cast( uint8, MV_LOCAL ) : dcurA.ty = cast( uint8, MT_PTR )
        dcurA.id = dcur
        scurA.kind = cast( uint8, MV_LOCAL ) : scurA.ty = cast( uint8, MT_PTR )
        scurA.id = scur
        ImplStoreTo_( c, dcurA, dp )
        ImplStoreTo_( c, scurA, sp_ )

        '' The end pointer is the source base plus its byte count, computed ONCE:
        '' the source is not written through here, so it cannot move.
        dim as MirInst ea
        ea.op = cast( uint16, M_PTR_ADD )
        ea.ty = cast( uint8, MT_PTR )
        ea.a = sp_
        ea.b = sz
        dim as MirValue endp = Emit( c, ea )

        dim as int32 headB = NewBlock( c, "arrcopy.head" )
        dim as int32 bodyB = NewBlock( c, "arrcopy.body" )
        dim as int32 doneB = NewBlock( c, "arrcopy.done" )
        dim as MirValue noCond
        Terminate( c, MTERM_BR, headB, -1, noCond )

        c.curBlock = headB
        dim as MirValue sNow = LowerExprLoad( c, scurA, MT_PTR )
        dim as MirInst cmp
        cmp.op = cast( uint16, M_ICMP_ULT )
        cmp.ty = cast( uint8, MT_I32 )
        cmp.a = sNow
        cmp.b = endp
        dim as MirValue more = Emit( c, cmp )
        Terminate( c, MTERM_CONDBR, bodyB, doneB, more )

        c.curBlock = bodyB
        dim as MirValue dEl = LowerExprLoad( c, dcurA, MT_PTR )
        dim as MirValue sEl = LowerExprLoad( c, scurA, MT_PTR )
        CopyMember_( c, dEl, sEl, et )
        ImplBumpPtr_( c, dcurA, elen )
        ImplBumpPtr_( c, scurA, elen )
        Terminate( c, MTERM_BR, headB, -1, noCond )

        c.curBlock = doneB
        return
    end if

    if c.types->Kind( ft ) = Tko.TK_UDT then
        '' THE FIELD'S SAME-TYPE LET, not the head of its chain -- the rule LowerAssign
        '' already follows for 'y = x'. AfxNova's DWSTRING declares 'let( byref as
        '' wstring )' first, so a synthesised let over a DWSTRING field called THAT with
        '' the source field's address, and the copy read the descriptor's own bytes as
        '' text: tracks' 'result = frmCalendar_Show( ... )' came back with a 3-character
        '' date. No same-type overload falls through to the implicit let or a byte copy,
        '' as it does for a whole assignment.
        dim as containers.Array( of uint32 ) sletT
        sletT.Push( cast( uint32, ft ) )
        dim as Tko.SymbolId lt = PickCtor( c, StructorOf( c, ft, "let" ), sletT )
        if lt <> Tko.SYMBOL_NONE then
            dim as containers.Array( of uint32 ) args
            args.Push( cast( uint32, src.kind ) ) : args.Push( cast( uint32, src.id ) )
            EmitStructorCall( c, lt, -1, @dst, @args )
            return
        end if
        if NeedsLetBody_( c, ft ) then
            CallImplicitLet_( c, ft, dst, src )
            return
        end if
    end if

    '' EVERYTHING ELSE IS BITWISE -- a scalar, a fixed-length string, a fixed array, or
    '' a UDT with nothing to say about assignment. fbc writes a memcpy; here the whole
    '' value is loaded and stored, which is what an aggregate assignment is in this IR.
    dim as MirType mt = LowerType( ft, *c.types )
    if mt = MT_VOID then mt = MT_AGG
    '' AN AGGREGATE FIELD CARRIES ITS SIZE, and this one did not.
    ''
    '' Both addresses here are FIELD ADDRESSES -- temps -- and the emitter sizes an
    '' aggregate from its STORAGE: a local's slot, a global's size, or the
    '' instruction's own imm. A temp is none of those, so it answered zero and the
    '' copy came out as
    ''
    ''     %t3 = load [0 x i8], ptr %t1
    ''     store [0 x i8] %t3, ptr %t2
    ''
    '' -- ZERO BYTES MOVED. Measured on a plain UDT holding a nested struct beside a
    '' string: fbc prints '7 8 n' for 'y = x' and tiko printed '0 0 n'. The string
    '' field was fine, because it goes through fb_StrAssign above; only the
    '' aggregate one was silently dropped. Nothing declined and nothing verified
    '' wrong -- this is a synthesised 'operator let', so it reaches every UDT that
    '' has a nested aggregate field and no written assignment.
    dim as int64 fsz = 0
    if mt = MT_AGG then fsz = cast( int64, SizeOfType( c, ft ) )
    dim as MirValue v
    if fsz > 0 then
        dim as MirInst ld
        ld.op = cast( uint16, M_LOAD )
        ld.ty = cast( uint8, MT_AGG )
        ld.a = src
        ld.imm = fsz
        v = Emit( c, ld )
    else
        v = LowerExprLoad( c, src, mt )
    end if
    if v.kind = cast( uint8, MV_NONE ) then return
    dim as MirInst st
    st.op = cast( uint16, M_STORE )
    st.ty = cast( uint8, MT_VOID )
    st.a = dst
    st.b = v
    if fsz > 0 then st.imm = fsz
    Emit( c, st )
end sub

'' The base, then every field in DECLARATION order. Measured; the reverse belongs to
'' the destructor and nowhere else.
sub EmitLetBody_ _
    ( byref c as Ctx, byval t as Tko.TypeId, byref dst as MirValue, byref src as MirValue )

    dim as Tko.TypeId bt = ImplBaseOf_( c, t )
    '' ...BUT NEVER OBJECT, which is nothing but the vptr. Copying it gave the destination
    '' the SOURCE's table: 'new Shape( aCircle )', 'dim as Shape s = aCircle' and 's =
    '' aCircle' all dispatched as a Circle, where fbc's copy keeps Shape's own. The vptr
    '' is the object's type, not part of its value.
    if cbool( bt <> Tko.TYPE_NONE ) andalso cbool( bt <> t ) andalso (IsObjectT_( c, bt ) = false) then
        CopyMember_( c, FieldAddr_( c, dst, t, c.vts->baseName ), _
                     FieldAddr_( c, src, t, c.vts->baseName ), bt )
    end if
    dim as containers.Array( of uint32 ) flds
    FieldsInOrder_( c, t, flds )
    for i as int32 = 0 to flds.Count - 1
        dim as Tko.Symbol ptr f = c.syms->SymbolAt( cast( Tko.SymbolId, flds[i] ) )
        if f = nullptr then continue for
        CopyMember_( c, FieldAddr_( c, dst, t, f->name ), _
                     FieldAddr_( c, src, t, f->name ), f->type_ )
    next
end sub

'' The emitted name of a synthesised structor, spelled the way fbc spells a written
'' one: '_ZN1TC1Ev' and '_ZN1TD1Ev'. A type already in a namespace encodes as
'' 'N2NS1TE' and is not wrapped twice.
private function ImplStructorName_ _
    ( byref c as Ctx, byval t as Tko.TypeId, byval suffix as string ) as string

    '' UNQUALIFIED. A structor belongs to the TYPE, not to a const view of it: mangling
    '' a 'const T' gave '_ZNK2T1C1Ev', the CONST-METHOD spelling, and a constructor is
    '' never const. So 'dim as const T c = T( )' called a name nothing defines while
    '' the real '_ZN2T1C1Ev' sat beside it.
    t = c.types->Unqualify( t )
    dim as Tko.Mangle.Substitutions subs
    dim as string code = Tko.Mangle.TypeCode( t, *c.types, *c.syms, *c.names, subs )
    if len( code ) = 0 then return ""
    if left( code, 1 ) = "N" then
        '' 'N2NS1TE' -> 'N2NS1TC1Ev': the trailing E belongs to the nested name and the
        '' structor code goes inside it.
        return "_Z" + left( code, len( code ) - 1 ) + suffix + "Ev"
    end if
    return "_ZN" + code + suffix + "Ev"
end function

function ImplicitCtorName_( byref c as Ctx, byval t as Tko.TypeId ) as string
    '' OBJECT'S CONSTRUCTOR IS THE RUNTIME'S, under a name nothing else would produce:
    '' fbc declares 'void _ZN10fb_Object$C1Ev( struct $10fb_Object$* )' and never
    '' defines it. Synthesising one here instead gave every 'extends object' chain an
    '' EMPTY constructor named after a type -- so the vptr the runtime stores was never
    '' stored at all, and the base of the chain kept whatever the stack held.
    ''
    '' NOT DECORATED FOR WIN32 -- except that LLVM's i386 COFF backend prefixes an
    '' underscore to EVERY external name, and the runtime's oop_object.c defines this
    '' one through an asm label spelled literally '_ZN10fb_Object$C1Ev'. The IR escape
    '' '\01' turns the backend's prefixing off for the one symbol, so the object
    '' carries what fbc's own win32 libfb.a carries (measured, clang 21.1.3,
    '' i686-w64-windows-gnu, 2026-11-08). On the 64-bit targets nothing prefixes and
    '' the plain spelling stands.
    if IsObjectT_( c, t ) then
        if c.types->target.pointerBits = 32 then return "\01_ZN10fb_Object$C1Ev"
        return "_ZN10fb_Object$C1Ev"
    end if
    return ImplStructorName_( c, t, "C1" )
end function

'' 'operator let' and the COPY CONSTRUCTOR, as fbc spells them: '_ZN1TaSERKS_' and
'' '_ZN1TC1ERKS_'. 'RK' + T's OWN substitution is 'const T&', which both take. It is
'' not always 'S_': fbc writes '_ZN2NS3RECaSERKS0_', '_ZN3BoxI8FBSTRINGEaSERKS1_' and
'' '_ZN8FBTUPLE2Ii8FBSTRINGEC1ERKS1_', and tiko wrote 'RKS_' for all three.
function ImplicitLetName_( byref c as Ctx, byval t as Tko.TypeId ) as string
    '' Unqualified, for the reason ImplStructorName_ gives.
    t = c.types->Unqualify( t )
    if IsObjectT_( c, t ) then return ""
    dim as Tko.Mangle.Substitutions subs
    dim as string code = Tko.Mangle.TypeCode( t, *c.types, *c.syms, *c.names, subs )
    if len( code ) = 0 then return ""
    dim as string sref = Tko.Mangle.SelfRef( subs, t )
    if left( code, 1 ) = "N" then return "_Z" + left( code, len( code ) - 1 ) + "aSERK" + sref
    return "_ZN" + code + "aSERK" + sref
end function

function ImplicitCopyName_( byref c as Ctx, byval t as Tko.TypeId ) as string
    '' Unqualified, for the reason ImplStructorName_ gives.
    t = c.types->Unqualify( t )
    if IsObjectT_( c, t ) then
        '' The '\01' escape, for the reason ImplicitCtorName_ records.
        if c.types->target.pointerBits = 32 then return "\01_ZN10fb_Object$C1ERKS_"
        return "_ZN10fb_Object$C1ERKS_"
    end if
    dim as Tko.Mangle.Substitutions subs
    dim as string code = Tko.Mangle.TypeCode( t, *c.types, *c.syms, *c.names, subs )
    if len( code ) = 0 then return ""
    dim as string sref = Tko.Mangle.SelfRef( subs, t )
    if left( code, 1 ) = "N" then return "_Z" + left( code, len( code ) - 1 ) + "C1ERK" + sref
    return "_ZN" + code + "C1ERK" + sref
end function

function ImplicitDtorName_( byref c as Ctx, byval t as Tko.TypeId ) as string
    '' OBJECT HAS NO DESTRUCTOR. Measured: a module holding only 'dim shared as object'
    '' emits a _GLOBAL__I and no _GLOBAL__D at all.
    if IsObjectT_( c, t ) then return ""
    return ImplStructorName_( c, t, "D1" )
end function

'' A call to one, declared if this module has not defined it.
private sub CallImplByName_ _
    ( byref c as Ctx, byref nm as string, byref selfv as MirValue )

    if len( nm ) = 0 then return
    if selfv.kind = cast( uint8, MV_NONE ) then return
    dim as Tko.InternId id = c.names->GetString( nm )
    dim as int32 fidx = c.m->OldestFunctionNamed( id )
    if fidx < 0 then
        dim as MirFunction ptr decl = c.m->AddFunction( id, MT_VOID )
        decl->isDefinition = false
        '' AN IMPLICIT STRUCTOR TAKES POINTERS. 'this' is parameter zero and the
        '' right-hand side, where there is one, parameter one -- the same shape a
        '' written structor gets, and the reason both can be called through one path.
        decl->AddParam( MT_PTR )
        fidx = c.m->functions.Count - 1
    end if
    dim as int32 first = c.m->argPool.Count \ 2
    c.m->argPool.Push( cast( uint32, selfv.kind ) )
    c.m->argPool.Push( cast( uint32, selfv.id ) )
    dim as MirInst ins
    ins.op = cast( uint16, M_CALL )
    ins.ty = cast( uint8, MT_VOID )
    ins.first = first
    ins.count = 1
    ins.callee = fidx
    Emit( c, ins )
end sub

'' Kind: 0 destructor, 1 constructor, 2 'operator let', 3 copy constructor.
sub WantImplicit_ _
    ( byref c as Ctx, byval t as Tko.TypeId, byval k as int32 )

    '' UNQUALIFIED, because the NAME already is and the two have to agree.
    '' ImplStructorName_ unqualifies before it mangles, so 'const T2' and 'T2' both
    '' ask for '_ZN2T2C1Ev'; this list did not, and EmitImplicitStructors looks the
    '' recorded id up with 'c.udts->Find( t )', which is keyed on the unqualified one.
    '' So 'dim as const T2 c2 = T2( )' over a T2 holding a string emitted the CALL and
    '' never the BODY -- 'undefined symbol: T2::T2()' -- while the same program
    '' without the word linked and ran. It compiled clean either way, which is why
    '' only build/linkscan.sh found it; const-object-init.out had carried the two
    '' bare 'declare's since that golden was written.
    t = c.types->Unqualify( t )

    dim as int64 key = (cast( int64, cast( uint32, t ) ) shl 32) or cast( int64, cast( uint32, k ) )
    if c.ix.implWantedAt.Contains( key ) then return
    c.ix.implWantedAt.Put( key, c.implWantedType.Count )
    c.implWantedType.Push( cast( uint32, t ) )
    c.implWantedKind.Push( k )
end sub

private sub CallImplTwo_ _
    ( byref c as Ctx, byref nm as string, byref dst as MirValue, byref src as MirValue )

    if len( nm ) = 0 then return
    if (dst.kind = cast( uint8, MV_NONE )) orelse (src.kind = cast( uint8, MV_NONE )) then
        return
    end if
    dim as Tko.InternId id = c.names->GetString( nm )
    dim as int32 fidx = c.m->OldestFunctionNamed( id )
    if fidx < 0 then
        dim as MirFunction ptr decl = c.m->AddFunction( id, MT_VOID )
        decl->isDefinition = false
        '' AN IMPLICIT STRUCTOR TAKES POINTERS. 'this' is parameter zero and the
        '' right-hand side, where there is one, parameter one -- the same shape a
        '' written structor gets, and the reason both can be called through one path.
        decl->AddParam( MT_PTR )
        decl->AddParam( MT_PTR )
        fidx = c.m->functions.Count - 1
    end if
    dim as int32 first = c.m->argPool.Count \ 2
    c.m->argPool.Push( cast( uint32, dst.kind ) )
    c.m->argPool.Push( cast( uint32, dst.id ) )
    c.m->argPool.Push( cast( uint32, src.kind ) )
    c.m->argPool.Push( cast( uint32, src.id ) )
    dim as MirInst ins
    ins.op = cast( uint16, M_CALL )
    ins.ty = cast( uint8, MT_VOID )
    ins.first = first
    ins.count = 2
    ins.callee = fidx
    Emit( c, ins )
end sub

sub CallImplicitLet_ _
    ( byref c as Ctx, byval t as Tko.TypeId, byref dst as MirValue, byref src as MirValue )
    WantImplicit_( c, t, 2 )
    CallImplTwo_( c, ImplicitLetName_( c, t ), dst, src )
end sub

sub CallImplicitCopy_ _
    ( byref c as Ctx, byval t as Tko.TypeId, byref dst as MirValue, byref src as MirValue )
    WantImplicit_( c, t, 3 )
    CallImplTwo_( c, ImplicitCopyName_( c, t ), dst, src )
end sub

sub CallImplicitCtor_ _
    ( byref c as Ctx, byval t as Tko.TypeId, byref selfv as MirValue )
    WantImplicit_( c, t, 1 )
    CallImplByName_( c, ImplicitCtorName_( c, t ), selfv )
end sub

sub CallImplicitDtor_ _
    ( byref c as Ctx, byval t as Tko.TypeId, byref selfv as MirValue )
    WantImplicit_( c, t, 0 )
    CallImplByName_( c, ImplicitDtorName_( c, t ), selfv )
end sub

'' One synthesised structor, as a real function with a real name -- not as code inlined
'' at each use. A vtable slot names one, an array's elements are constructed by calling
'' one in a loop, and 'new T' calls one; giving it a body in one place is what lets all
'' of those refer to it.
private sub EmitOneImplicit_ _
    ( byref c as Ctx, byval t as Tko.TypeId, byval kind_ as int32 )

    dim as string nm = ""
    select case kind_
    case 0 : nm = ImplicitDtorName_( c, t )
    case 1 : nm = ImplicitCtorName_( c, t )
    case 2 : nm = ImplicitLetName_( c, t )
    case else : nm = ImplicitCopyName_( c, t )
    end select
    if len( nm ) = 0 then return
    dim as Tko.InternId id = c.names->GetString( nm )
    '' Down one name's chain rather than over every function: the same name really
    '' can have two entries, a declaration and a definition.
    dim as int32 at = c.m->FirstFunctionNamed( id )
    while at >= 0
        if c.m->functions[at] = nullptr then exit while
        if c.m->functions[at]->isDefinition then return
        at = c.m->functions[at]->nextSameName - 1
    wend

    dim as boolean twoArgs = (kind_ >= 2)
    dim as MirFunction ptr f = c.m->AddFunction( id, MT_VOID )
    f->isDefinition = true
    '' WEAK, FOR THE REASON AN INSTANTIATED GENERIC IS. A SYNTHESISED structor is
    '' emitted by every translation unit that needs one, so two modules using the same
    '' UDT each define it and the linker sees duplicates -- twenty of them on the
    '' bootstrap, all constructors, copy constructors, assignment operators and
    '' destructors that nobody wrote. COMDAT folds them.
    f->isWeak = true
    f->AddParam( MT_PTR )
    if twoArgs then f->AddParam( MT_PTR )

    dim as MirFunction ptr savedF = c.f
    dim as int32 savedB = c.curBlock
    c.f = f
    c.st->functions += 1
    c.curBlock = NewBlock( c, "entry" )

    '' THIS arrives as parameter zero, exactly as it does for a written structor, and
    '' the right-hand side as parameter one.
    dim as MirValue selfv
    selfv.kind = cast( uint8, MV_PARAM )
    selfv.ty = cast( uint8, MT_PTR )
    selfv.id = 0
    dim as MirValue rhs
    rhs.kind = cast( uint8, MV_PARAM )
    rhs.ty = cast( uint8, MT_PTR )
    rhs.id = 1

    select case kind_
    case 1
        EmitCtorPrologue_( c, t, selfv )
    case 0
        '' THE VPTR FIRST, so the rest of this destructor -- and anything it calls --
        '' sees this type's own table rather than the derived one that was there.
        StoreVptr_( c, t, selfv )
        EmitDtorEpilogue_( c, t, selfv )
    case 2
        EmitLetBody_( c, t, selfv, rhs )
    case else
        '' THE COPY CONSTRUCTOR IS THE DEFAULT ONE FOLLOWED BY THE ASSIGNMENT, exactly
        '' as fbc writes it -- not a field-by-field copy of its own. So a string field
        '' is zeroed and then assigned rather than assigned over a descriptor that was
        '' never initialised.
        EmitCtorPrologue_( c, t, selfv )
        '' The same-type let, for the reason CopyMember_ gives: a converting let
        '' declared first would be handed the source object's address.
        dim as containers.Array( of uint32 ) sletT
        sletT.Push( cast( uint32, t ) )
        dim as Tko.SymbolId lt = PickCtor( c, StructorOf( c, t, "let" ), sletT )
        if lt <> Tko.SYMBOL_NONE then
            dim as containers.Array( of uint32 ) args
            args.Push( cast( uint32, rhs.kind ) ) : args.Push( cast( uint32, rhs.id ) )
            EmitStructorCall( c, lt, -1, @selfv, @args )
        else
            CallImplicitLet_( c, t, selfv, rhs )
        end if
    end select

    Terminate( c, MTERM_RET, -1, -1, NoVal( ) )
    c.f = savedF
    c.curBlock = savedB
end sub

'' Is this a FIXED array whose element type needs a constructor -- or a destructor?
function ArrayElemNeedsInit_( byref c as Ctx, byval t as Tko.TypeId ) as boolean
    if t = Tko.TYPE_NONE then return false
    if c.types->Kind( t ) <> Tko.TK_ARRAY then return false
    if c.types->IsDynArray( t ) then return false
    dim as Tko.TypeId el = c.types->Inner( t )
    if c.types->Kind( el ) <> Tko.TK_UDT then return false
    return TypeNeedsInit_( c, el )
end function

function ArrayElemNeedsDtor_( byref c as Ctx, byval t as Tko.TypeId ) as boolean
    if t = Tko.TYPE_NONE then return false
    if c.types->Kind( t ) <> Tko.TK_ARRAY then return false
    if c.types->IsDynArray( t ) then return false
    dim as Tko.TypeId el = c.types->Inner( t )
    if c.types->Kind( el ) <> Tko.TK_UDT then return false
    return TypeNeedsDtor_( c, el )
end function

'' AN ARRAY OF T IS N OBJECTS, and each one is constructed and destroyed. 'dim as T
'' a( 0 to 2 )' with a string in T left three uninitialised descriptors, and the first
'' assignment through one freed whatever the stack held.
''
'' fbc emits a COUNTED LOOP forward for construction and hands destruction to
'' fb_ArrayDestructObj with the destructor as a function pointer. The loop here goes
'' BACKWARDS for destruction, which is what 'delete[]' was measured doing and what the
'' reverse-declaration-order rule says for fields; whether the runtime helper agrees
'' was NOT determined -- it is inside the runtime, which was not read.
''
'' Unrolled rather than looped. A loop needs a counter slot and three blocks in the
'' CLEANUP path, which runs at every exit of every enclosing scope; the arrays this
'' reaches are small and the instruction count is bounded by the element count, which
'' is a compile-time constant or this is not a fixed array at all.
sub EmitArrayElems_ _
    ( byref c as Ctx, byval slot as int32, byval at as Tko.TypeId, byval isCtor as boolean, byval skip as int32 = 0 )

    if slot < 0 then return
    dim as MirValue sbase
    sbase.kind = cast( uint8, MV_LOCAL )
    sbase.ty = cast( uint8, MT_PTR )
    sbase.id = slot
    EmitArrayElemsAt_( c, sbase, at, isCtor, skip )
end sub

'' The same, from an ADDRESS rather than a slot: a module-lifetime array is a global.
sub EmitArrayElemsAt_ _
    ( byref c as Ctx, byref base_ as MirValue, byval at as Tko.TypeId, byval isCtor as boolean, byval skip as int32 = 0 )

    if base_.kind = cast( uint8, MV_NONE ) then return
    if c.types->Kind( at ) <> Tko.TK_ARRAY then return
    if c.types->IsDynArray( at ) then return
    dim as Tko.TypeId el = c.types->Inner( at )
    if c.types->Kind( el ) <> Tko.TK_UDT then return
    dim as int32 n = c.types->ElemCount( at )
    if (n <= 0) orelse (n > 4096) then return
    dim as int32 esz = SizeOfType( c, el )
    if esz <= 0 then return

    for k as int32 = iif( isCtor, skip, 0 ) to n - 1   '' 'skip': built by an initialiser
        dim as int32 idx = iif( isCtor, k, n - 1 - k )
        dim as MirInst fa
        fa.op = cast( uint16, M_FIELD_ADDR )
        fa.ty = cast( uint8, MT_PTR )
        fa.a = base_
        fa.imm = idx * esz
        dim as MirValue ea = Emit( c, fa )
        if ea.kind = cast( uint8, MV_NONE ) then return
        if isCtor then
            dim as Tko.SymbolId ct = StructorWithArity( c, StructorOf( c, el, "__ctor" ), 0 )
            if ct <> Tko.SYMBOL_NONE then
                dim as containers.Array( of uint32 ) none_
                EmitStructorCall( c, ct, -1, @ea, @none_ )
            else
                CallImplicitCtor_( c, el, ea )
            end if
        else
            dim as Tko.SymbolId dt = StructorWithArity( c, StructorOf( c, el, "__dtor" ), 0 )
            if dt <> Tko.SYMBOL_NONE then
                dim as containers.Array( of uint32 ) none_
                EmitStructorCall( c, dt, -1, @ea, @none_ )
            else
                CallImplicitDtor_( c, el, ea )
            end if
        end if
    next
end sub


'' Every implicit structor this unit needs.
''
'' ON DEMAND, and the demand grows as the bodies are written: a constructor emitted here
'' may call a field's or a base's, which was not wanted when the walk started. The list
'' is append-only and the index carries over, so each entry is visited once however many
'' rounds it takes.
sub EmitImplicitStructors( byref c as Ctx )
    if (c.vts = nullptr) orelse (c.udts = nullptr) then return

    WantVirtualImplicitDtors_( c ) : dim as int32 at = 0   '' lowervtab.tiko
    dim as int32 guard = 0
    while (at < c.implWantedType.Count) andalso (guard < 100000)
        guard += 1
        dim as Tko.TypeId t = cast( Tko.TypeId, c.implWantedType[at] )
        dim as int32 kind_ = c.implWantedKind[at]
        at += 1
        if t = Tko.TYPE_NONE then continue while
        if c.udts->Find( t ) < 0 then continue while
        '' OBJECT'S OWN STRUCTORS ARE THE RUNTIME'S, not this module's.
        if IsObjectT_( c, t ) then continue while
        '' A WRITTEN ONE WINS. fbc prepends the same body to it rather than emitting a
        '' second function, and that is done where it is lowered.
        dim as boolean written = false
        select case kind_
        case 0
            written = (StructorWithArity( c, StructorOf( c, t, "__dtor" ), 0 ) <> Tko.SYMBOL_NONE)
        case 1
            written = (StructorWithArity( c, StructorOf( c, t, "__ctor" ), 0 ) <> Tko.SYMBOL_NONE)
        case 2
            '' THE SAME-TYPE ONE, as the call sites ask. A type declaring only a CONVERTING
            '' 'let( byval d as double )' has none, and they called the synthesised copy --
            '' which this, counting any 'let' as written, never emitted: 'undefined symbol
            '' COLEDATETIMESPAN::operator=(const&)' in fbx/datetime. fbc copies it (42).
            dim as containers.Array( of uint32 ) selfT
            selfT.Push( cast( uint32, t ) )
            written = (PickCtor( c, StructorOf( c, t, "let" ), selfT ) <> Tko.SYMBOL_NONE)
        case else
            '' THE WHOLE CHAIN -- see CopyCtorOf_. A type whose copy constructor is
            '' not the first one-argument one was given a SYNTHESISED copy as well.
            written = (CopyCtorOf_( c, t ) <> Tko.SYMBOL_NONE)
        end select
        if written then continue while
        EmitOneImplicit_( c, t, kind_ )
    wend
end sub

#include once "mir/lowerimplmemo.tiko"

end namespace
