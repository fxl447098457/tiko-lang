'' lowerprocptr.tiko -- 'procptr', in all four of its spellings.
''
'' Split out of lowerintr.tiko at the 1500-line cap and included from it in the same
'' place.



declare function SameProcResult_ _
    ( byref c as Ctx, byval a as Tko.TypeId, byval b as Tko.TypeId ) as boolean
declare function SameParamType_ _
    ( byref c as Ctx, byval callee as Tko.SymbolId, byval pi as int32, _
      byval st as Tko.TypeId, byval si as int32 ) as boolean
declare function ProcPickByType_ _
    ( byref c as Ctx, byval fnE as Tko.NodeId, byval st as Tko.TypeId ) as Tko.SymbolId
declare function ProcPtrByType_ _
    ( byref c as Ctx, byval fnE as Tko.NodeId, byval st as Tko.TypeId, _
      byref outv as MirValue ) as boolean

'' E LOWERED AS A VALUE OF TYPE T. Only one thing reads T: an '@f' or a 'procptr( f )' that
'' IS e, where f names an overload set -- the overload is the one whose signature T is.
'' Without it the address was always the FIRST overload's: over 'f( byval as long )' and
'' 'f( byval as double )', 'dim p as sub( byval as double ) = @f : p( 1.5 )' ran the LONG
'' body with a double's bits in it. Measured, fbc takes the overload the target names --
'' '_Z1Fd' -- for a store, an initialiser, an argument and a field alike.
function LowerExprWant_ _
    ( byref c as Ctx, byval e as Tko.NodeId, byval t as Tko.TypeId ) as MirValue

    dim as Tko.NodeId savedN = c.procWantNode
    dim as Tko.TypeId savedT = c.procWantType
    c.procWantNode = e
    c.procWantType = t
    dim as MirValue v = LowerExpr( c, e )
    c.procWantNode = savedN
    c.procWantType = savedT
    return v
end function

'' The address LowerExprWant_ asked for, when ID is the node it asked about and names one
'' procedure of an overload set. False -- nothing emitted -- otherwise, and the caller
'' carries on as it always did.
function ProcAddrForWanted_ _
    ( byref c as Ctx, byval id as Tko.NodeId, byref outv as MirValue ) as boolean

    if (id = Tko.NODE_NONE) orelse (id <> c.procWantNode) then return false
    dim as Tko.NodeId fnE = Tko.NODE_NONE
    select case c.ast->Kind( id )
    case Tko.N_ADDROF
        fnE = c.ast->UnaryOf( id )->operand
    case Tko.N_CALL
        dim as Tko.ListPayload ptr lp = _
            c.ast->ListOf( id )
        if (lp->count <> 1) orelse (lp->target = Tko.NODE_NONE) then return false
        fnE = cast( Tko.NodeId, c.ast->ChildSlot( lp->first ) )
    end select
    if fnE = Tko.NODE_NONE then return false
    dim as Tko.Symbol ptr s = c.syms->SymbolAt( c.info->RefOf( fnE ) )
    if s = nullptr then return false
    if s->kind <> cast( uint8, Tko.SYM_PROC ) then return false
    if s->nextOverload = Tko.SYMBOL_NONE then return false
    '' WHICH OVERLOAD IS CHECK'S, recorded on 'f' (checkdecide.tiko DecideProcAddr_) by the same
    '' signature rule ProcPickByType_ applies -- and '@f' is typed by it, where Check used to
    '' type it from the overload Resolve bound (overload re-pick refactor, Phase 1). None
    '' recorded is no match: the address is the bound overload's, as before.
    dim as Tko.SymbolId pick = c.info->DecisionOf( fnE )
    if pick = Tko.SYMBOL_NONE then return false
    outv = FuncAddrOf( c, pick )
    return (outv.kind <> cast( uint8, MV_NONE ))
end function

'' The overload in the chain that starts at whatever 'fnE' is bound to whose signature
'' is the procedure type 'sigN' names, as an M_FUNC_ADDR.
private function ProcPtrBySignature_ _
    ( byref c as Ctx, byval fnE as Tko.NodeId, byval sigN as Tko.NodeId, _
      byref outv as MirValue ) as boolean

    dim as Tko.TypeId st = c.types->Unqualify( c.info->TypeOf_( sigN ) )
    '' ...OR A TYPEDEF NAMING THE SIGNATURE. 'type t as sub( byval as single )'
    '' followed by 'procptr( s, t )' writes the second argument as an ORDINARY
    '' IDENTIFIER, not a type reference, so it carries no type of its own and the
    '' selector found nothing -- while the spelled-out 'sub( byval as single )'
    '' beside it worked. fbc answers the same address for both: 'P1$0 =
    '' (tmp$4)&_Z1Sf'.
    if st = Tko.TYPE_NONE then
        if c.ast->Kind( sigN ) = Tko.N_IDENT then
            dim as Tko.Symbol ptr tsy = c.syms->SymbolAt( c.info->RefOf( sigN ) )
            if tsy <> nullptr then
                select case cast( Tko.SymbolKind, tsy->kind )
                case Tko.SYM_TYPEDEF, Tko.SYM_UDT
                    st = c.types->Unqualify( tsy->type_ )
                end select
            end if
        end if
    end if
    return ProcPtrByType_( c, fnE, st, outv )
end function

'' ...the same, for a procedure TYPE already in hand -- or a pointer to one.
'' THE OVERLOAD ITSELF, for ProcPtrByType_ and the shadow audit beside its caller.
function ProcPickByType_ _
    ( byref c as Ctx, byval fnE as Tko.NodeId, byval st as Tko.TypeId ) as Tko.SymbolId

    if st = Tko.TYPE_NONE then return Tko.SYMBOL_NONE
    st = c.types->Unqualify( st )
    if c.types->Kind( st ) = Tko.TK_POINTER then
        st = c.types->Unqualify( c.types->Inner( st ) )
    end if
    if c.types->Kind( st ) <> Tko.TK_PROC then return Tko.SYMBOL_NONE

    dim as Tko.SymbolId first_ = c.info->RefOf( fnE )
    if first_ = Tko.SYMBOL_NONE then return Tko.SYMBOL_NONE

    dim as int32 want = c.types->ProcParamCount( st )
    dim as Tko.TypeId wantRet = c.types->Inner( st )
    dim as Tko.SymbolId cur = first_
    while cur <> Tko.SYMBOL_NONE
        dim as Tko.Symbol ptr cs = c.syms->SymbolAt( cur )
        if cs = nullptr then exit while
        if cs->kind = cast( uint8, Tko.SYM_PROC ) then
            dim as boolean ok = (ParamCountOf( c, cur ) = want)
            if ok then ok = SameProcResult_( c, cs->type_, wantRet )
            if ok then
                for i as int32 = 0 to want - 1
                    if SameParamType_( c, cur, i, st, i ) = false then
                        ok = false
                        exit for
                    end if
                next
            end if
            if ok then return cur
        end if
        cur = cs->nextOverload
    wend
    return Tko.SYMBOL_NONE
end function

function ProcPtrByType_ _
    ( byref c as Ctx, byval fnE as Tko.NodeId, byval st as Tko.TypeId, _
      byref outv as MirValue ) as boolean

    dim as Tko.SymbolId pick = ProcPickByType_( c, fnE, st )
    if pick = Tko.SYMBOL_NONE then return false
    outv = FuncAddrOf( c, pick )
    return (outv.kind <> cast( uint8, MV_NONE ))
end function


'' Two RESULT types. A SUB spells its absence TWO WAYS: a declared one carries
'' TYPE_NONE and a procedure TYPE carries the VOID builtin, because ResolveTypeRef
'' fills one in where a declaration leaves the field empty.
function SameProcResult_ _
    ( byref c as Ctx, byval a as Tko.TypeId, byval b as Tko.TypeId ) as boolean
    dim as boolean av = (a = Tko.TYPE_NONE)
    dim as boolean bv = (b = Tko.TYPE_NONE)
    if av = false then
        if c.types->Kind( a ) = Tko.TK_BUILTIN then
            av = (c.types->BuiltinOf( a ) = Tko.TY_VOID)
        end if
    end if
    if bv = false then
        if c.types->Kind( b ) = Tko.TK_BUILTIN then
            bv = (c.types->BuiltinOf( b ) = Tko.TY_VOID)
        end if
    end if
    if av andalso bv then return true
    if av orelse bv then return false
    return (c.types->Unqualify( a ) = c.types->Unqualify( b ))
end function


'' One parameter of a declared procedure against one of a procedure TYPE. The
'' reference wrapper is stripped from both because only the proc type carries it;
'' BYREF is compared from the parameter node's own flag against that wrapper.
function SameParamType_ _
    ( byref c as Ctx, byval callee as Tko.SymbolId, byval pi as int32, _
      byval st as Tko.TypeId, byval si as int32 ) as boolean

    dim as Tko.TypeId want = c.types->ProcParam( st, si )
    if want = Tko.TYPE_NONE then return false
    dim as boolean wantRef = (c.types->Kind( want ) = Tko.TK_REFERENCE)
    if wantRef then want = c.types->Inner( want )

    dim as Tko.TypeId got = ParamTypeAt( c, callee, pi )
    if got = Tko.TYPE_NONE then return false
    if c.types->Kind( got ) = Tko.TK_REFERENCE then got = c.types->Inner( got )

    if c.types->Unqualify( got ) <> c.types->Unqualify( want ) then return false
    return (ParamIsByref( c, callee, pi ) = wantRef)
end function


declare function FirstDeclaredOf_( byref c as Ctx, byval sid as Tko.SymbolId ) as Tko.SymbolId

function LowerProcPtr _
    ( byref c as Ctx, byval id as Tko.NodeId, byref outv as MirValue ) as boolean

    if c.ast->Kind( id ) <> Tko.N_CALL then return false
    dim as Tko.ListPayload ptr lp = _
        c.ast->ListOf( id )
    '' 'procptr( T.constructor, sub( byval as integer ) )' WRITES A SECOND ARGUMENT to
    '' pick between overloads, so one is not the only legal count.
    if (lp->count <> 1) andalso (lp->count <> 2) then return false
    if lp->target = Tko.NODE_NONE then return false
    if c.ast->Kind( lp->target ) <> Tko.N_IDENT then return false
    dim as Tko.IdentPayload ptr ip = _
        c.ast->IdentOf( lp->target )
    if LowerSpelling_( c.ix, *c.names, ip->name ) <> "procptr" then return false

    '' The operand names a PROCEDURE. Anything else -- an overload set nothing chose
    '' between, a name that did not resolve -- has no single address to take.
    dim as Tko.NodeId fnE = cast( Tko.NodeId, c.ast->ChildSlot( lp->first ) )

    '' THE OVERLOAD THE TARGET'S TYPE NAMES -- see LowerExprWant_.
    if lp->count = 1 then
        if ProcAddrForWanted_( c, id, outv ) then return true
    end if

    '' 'procptr( T.m, VIRTUAL )' IS NOT AN ADDRESS. Measured: fbc folds it to the
    '' member's VTABLE SLOT INDEX as an int64 -- 1 for the second virtual member and 0
    '' for the first -- which is what pointers/procptr-virtual.bas asserts against its
    '' own INDEX constants. Emitting the procedure's address instead would be a
    '' well-typed value and the wrong number.
    if lp->count = 2 then
        dim as Tko.NodeId va = cast( Tko.NodeId, c.ast->ChildSlot( lp->first + 1 ) )
        if IsVirtualArg_( c, va ) then
            if c.ast->Kind( fnE ) <> Tko.N_MEMBER then return false
            dim as Tko.BinaryPayload ptr vmb = _
                c.ast->BinaryOf( fnE )
            dim as Tko.TypeId vot = c.types->Unqualify( c.info->TypeOf_( vmb->lhs ) )
            if vot = Tko.TYPE_NONE then
                '' 'T.m' names the TYPE, not a value, so the base carries no type of
                '' its own: it is the type reference itself.
                vot = c.types->Unqualify( c.info->TypeOf_( fnE ) )
                if c.ast->Kind( vmb->lhs ) = Tko.N_IDENT then
                    dim as Tko.SymbolId vts2 = c.info->RefOf( vmb->lhs )
                    dim as Tko.Symbol ptr vtsy = c.syms->SymbolAt( vts2 )
                    if vtsy <> nullptr then vot = c.types->Unqualify( vtsy->type_ )
                end if
            end if
            if vot = Tko.TYPE_NONE then return false
            dim as Tko.SymbolId vps = c.info->RefOf( fnE )
            if vps = Tko.SYMBOL_NONE then vps = c.info->RefOf( vmb->rhs )
            if vps = Tko.SYMBOL_NONE then return false
            dim as Tko.Symbol ptr vpsy = c.syms->SymbolAt( vps )
            if vpsy = nullptr then return false
            if c.vts = nullptr then return false

            '' THE DECLARATION ITSELF MUST SAY VIRTUAL OR ABSTRACT. A derived type's
            '' override written as a plain 'declare sub proc1( )' fills the base's slot
            '' and is dispatched through it -- but fbc answers -1 for
            '' 'procptr( D.proc1, virtual )', not the slot it occupies. Measured, and
            '' the answer is a CONSTANT either way rather than a decline.
            dim as int32 vslot = -1
            dim as Tko.NodeId vpn = cast( Tko.NodeId, vpsy->payload )
            if (vpn <> Tko.NODE_NONE) andalso (c.ast->Kind( vpn ) = Tko.N_PROC) then
                dim as uint16 vmods = StmtOf( c, vpn )->extra
                if (vmods and (Tko.PF_VIRTUAL or Tko.PF_ABSTRACT)) <> 0 then
                    vslot = c.vts->SlotOf( vot, vps, vpn )
                end if
            end if
            outv = ConstInt( c, vslot, MT_I64 )
            return true
        end if
    end if

    '' 'procptr( f, sub( ) )' PICKS AN OVERLOAD BY SIGNATURE. Measured, over two subs
    '' called 's' and two members called 'M':
    ''
    ''   procptr( s, sub( ) )                 &_Z1Sv
    ''   procptr( s, sub( byval as byte ) )   &_Z1Sa
    ''   procptr( C.M, sub( byval as long ) ) &_ZN1C1MEi
    ''
    '' Check PICKS AND TYPES it too, in MemberProcPtr_ -- but the ref it writes onto
    '' the operand does not survive: TypeOf_ is asked about that node again later and
    '' the ordinary member binding puts the FIRST overload back. So the selection is
    '' repeated here, over the chain that hangs off whatever IS bound, and the two
    '' agree because they read the same signature.
    ''
    '' Matched on ARITY, each parameter's type and its passing mode, and the result
    '' type. A SUB spells its absent result two ways -- TYPE_NONE on a declaration and
    '' the VOID builtin in a procedure TYPE, which is what ResolveTypeRef fills in --
    '' so comparing them raw made every 'procptr( s, sub( ) )' miss its own overload.
    if lp->count = 2 then
        dim as Tko.NodeId sigN = cast( Tko.NodeId, c.ast->ChildSlot( lp->first + 1 ) )
        dim as boolean sigOk = (c.ast->Kind( sigN ) = Tko.N_TYPEREF)
        if sigOk = false then sigOk = (c.ast->Kind( sigN ) = Tko.N_IDENT)
        if sigOk then
            dim as MirValue sv
            if ProcPtrBySignature_( c, fnE, sigN, sv ) then
                outv = sv
                return true
            end if
        end if
    end if

    '' A RUNTIME ENTRY POINT, which fbc predeclares and nothing in the source declares:
    '' 'procptr( fb_ArrayRedimEx )'. Its address is the same M_FUNC_ADDR over the
    '' inventory's own linker name. ...ONLY WHEN NOTHING IN THE SOURCE IS NAMED SO: fbcunit's
    '' 'procptr( val )' over a 'sub val' (a TEST named val) took the address of fb_VAL, and
    '' the suite runner called it -- an access violation (functions/fixstr_arg.bas).
    '' The name's own lookup, from where it is written: the operand of an intrinsic is not
    '' always bound by Resolve, and a bare 'val' then read as the runtime's.
    dim as Tko.SymbolId usid = c.info->RefOf( fnE )
    if (usid = Tko.SYMBOL_NONE) andalso (c.ast->Kind( fnE ) = Tko.N_IDENT) then
        usid = c.syms->Lookup( c.info->ScopeOf( fnE ), c.ast->IdentOf( fnE )->name )
    end if
    dim as boolean userBound = false
    dim as Tko.Symbol ptr ubs = c.syms->SymbolAt( usid )
    if ubs <> nullptr then userBound = (ubs->kind = cast( uint8, Tko.SYM_PROC )) andalso ((ubs->flags and Tko.SYMF_BUILTIN) = 0)
    if userBound then   '' ...and declared in the program, not the prelude's runtime declarations
        dim as Tko.SourceFile ptr usf = c.srcMgr->FileAt( c.srcMgr->Decode( ubs->loc ).file )
        if (usf = nullptr) orelse usf->isVirtual then userBound = false
    end if
    if userBound andalso (lp->count = 1) andalso (c.info->RefOf( fnE ) = Tko.SYMBOL_NONE) then
        outv = FuncAddrOf( c, usid )
        return (outv.kind <> cast( uint8, MV_NONE ))
    end if
    if (c.ast->Kind( fnE ) = Tko.N_IDENT) andalso (userBound = false) then
        dim as Tko.IdentPayload ptr rip = _
            c.ast->IdentOf( fnE )
        dim as RtlId rr = RtlByName( c.names->Spelling( rip->name ) )
        '' ...AND AN INTRINSIC NAMES ONE TOO. 'procptr( cls )' is '&fb_Cls' --
        '' measured, for sixty spellings -- so the keyword resolves to the same
        '' address the runtime name does.
        if rr = RTL_NONE then
            rr = IntrinsicProcPtrRtl_( Tko.Text.LowerAscii( _
                c.names->Spelling( rip->name ) ) )
        end if
        if rr <> RTL_NONE then
            dim as boolean is32 = (c.types->target.pointerBits = 32)
            dim as Tko.InternId rnm = c.names->GetString( RtlLinkName( rr, is32 ) )
            dim as int32 ridx = c.m->OldestFunctionNamed( rnm )
            if ridx < 0 then
                dim as MirFunction ptr rdecl = _
                    c.m->AddFunction( rnm, RtlReturn( rr, is32 ) )
                rdecl->isDefinition = false
                RtlSignature( rdecl, rr, is32, (c.types->target.osKind = Tko.OS_DARWIN) andalso (c.types->target.arch = Tko.ARCH_ARM64) )
                '' THE CONVENTION RIDES ON THE SIGNATURE, as at the other two
                '' synthetic-declaration sites: the emitter spells 'x86_stdcallcc'
                '' from it and LLVM adds the '@N' on win32.
                rdecl->callConv = RtlCallConv( rr, is32 )
                ridx = c.m->functions.Count - 1
            end if
            dim as MirInst rfa
            rfa.op = cast( uint16, M_FUNC_ADDR )
            rfa.ty = cast( uint8, MT_PTR )
            rfa.callee = cast( uint32, ridx )
            outv = Emit( c, rfa )
            return (outv.kind <> cast( uint8, MV_NONE ))
        end if
    end if

    '' CHECK DECIDES WHICH PROCEDURE, and if it could not, neither can this. A second
    '' argument that selected nothing leaves the whole expression untyped -- and
    '' emitting an address for it anyway put a pointer in a VOID slot, which is a
    '' verify failure rather than a decline. 'procptr( T.m, virtual )' is exactly that
    '' shape: it names which OVERRIDE to point at, which this path cannot answer.
    if lp->count = 2 then
        if c.info->TypeOf_( id ) = Tko.TYPE_NONE then return false
    end if

    '' AN ABSTRACT MEMBER HAS NO BODY, AND ITS PROCPTR IS NULL. Measured: fbc prints -1
    '' for 'cint( procptr( B.proc1 ) ) = 0' over 'declare abstract sub proc1( )'. The
    '' address of the declaration linked against nothing at -O0 and, at -O2, LLVM took
    '' it as non-null and folded the test false (pointers/procptr-virtual.bas).
    scope
        dim as Tko.Symbol ptr aps = c.syms->SymbolAt( c.info->RefOf( fnE ) )
        if aps <> nullptr then
            dim as Tko.NodeId apn = cast( Tko.NodeId, aps->payload )
            if (apn <> Tko.NODE_NONE) andalso (c.ast->Kind( apn ) = Tko.N_PROC) then
                if (StmtOf( c, apn )->extra and Tko.PF_ABSTRACT) <> 0 then
                    outv = ConstInt( c, 0, MT_PTR )
                    return (outv.kind <> cast( uint8, MV_NONE ))
                end if
            end if
        end if
    end scope
    '' WITH NO SIGNATURE, THE OVERLOAD DECLARED FIRST -- what Check typed it as (MemberProcPtr_); the
    '' binding's chain head is not in declaration order (pointers/procptr-member.bas).
    dim as Tko.SymbolId fsid = c.info->RefOf( fnE )
    if (lp->count = 1) andalso (c.ast->Kind( fnE ) = Tko.N_MEMBER) then fsid = FirstDeclaredOf_( c, fsid )
    outv = FuncAddrOf( c, fsid )
    return (outv.kind <> cast( uint8, MV_NONE ))
end function

'' The overload in sid's chain whose declaration comes first -- the arena is in source order.
private function FirstDeclaredOf_( byref c as Ctx, byval sid as Tko.SymbolId ) as Tko.SymbolId
    dim as Tko.Symbol ptr hs = c.syms->SymbolAt( sid )
    if hs = nullptr then return sid
    '' the chain from its HEAD, wherever the binding landed in it
    dim as Tko.SymbolId cur = c.syms->LookupLocal( hs->parent, hs->name )
    if cur = Tko.SYMBOL_NONE then cur = sid
    dim as Tko.SymbolId best = sid
    dim as int32 bestAt = &h7FFFFFFF, guard = 0
    while (cur <> Tko.SYMBOL_NONE) andalso (guard < 4096)
        guard += 1
        dim as Tko.Symbol ptr s = c.syms->SymbolAt( cur )
        if s = nullptr then exit while
        dim as int32 pn = cast( int32, s->payload )
        if (pn > 0) andalso (pn < bestAt) then
            if c.ast->Kind( cast( Tko.NodeId, pn ) ) = Tko.N_PROC then bestAt = pn : best = cur
        end if
        cur = s->nextOverload
    wend
    return best
end function

'' The ADDRESS OF A RUNTIME ENTRY POINT, as an M_FUNC_ADDR over the function table.
''
'' PUT passes one -- the blender for its blend mode -- and no source expression names
'' it, so it is reached the way ERASE reaches a destructor: by asking the inventory
'' rather than the symbol table.
