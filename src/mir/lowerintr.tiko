'' lowerintr.tiko -- statement INTRINSICS whose lowering is a runtime call.
''
'' Split out of lower.tiko when that file passed the 1500-line lint cap. What belongs
'' here is the quirk statements that are calls and nothing else -- no control flow of
'' their own, no state -- with the runtime shape MEASURED from fbc's own C output
'' rather than assumed. PRINT and SWAP live in lowerstr.tiko instead, because both are
'' really about the string runtime.

#import "std/containers"
#include once "mir/lowerall.ti"

namespace Tko.Mir

declare function AggIifArm_ _
    ( byref c as Ctx, byref dst as MirValue, byval e as Tko.NodeId, _
      byval slot as int32 = -1, byval ft as Tko.TypeId = Tko.TYPE_NONE ) as boolean
declare function StrSwapKind_ _
    ( byref c as Ctx, byval t as Tko.TypeId, byref n as int64 ) as int32

'' CLOSE. Every corpus form is the same shape: a list of file numbers, each closed in
'' turn, and an EMPTY list closing all of them.
''
'' Measured from fbc's own C output: 'close #1' is 'fb_FileClose( 1 )', 'close 1' the
'' same call -- the '#' is decoration and the parser has already dropped it -- 'close
'' #1, #2' is two calls in source order, and a bare 'close' is 'fb_FileCloseAll( )'.
'' No new shape, no state, nothing conditional.
function LowerClose( byref c as Ctx, byval id as Tko.NodeId ) as boolean
    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )

    if sp->count = 0 then
        dim as containers.Array( of uint32 ) none_
        EmitRtl( c, RTL_FILE_CLOSEALL, none_ )
        return true
    end if

    for i as int32 = 0 to sp->count - 1
        dim as Tko.NodeId it = c.ast->ChildAt( sp->first, i )
        '' An ELIDED slot is 'close ,' -- the corpus reaches it through a variadic
        '' macro invoked with an empty argument. fbc closes nothing for it.
        if c.ast->Kind( it ) = Tko.N_ELIDED then continue for
        dim as MirValue fn = LowerExprN_( c, it )
        if fn.kind = cast( uint8, MV_NONE ) then return false
        dim as containers.Array( of uint32 ) args
        fn = CoerceTy( c, fn, MT_I32, NumSrcType_( c, it ))
        args.Push( cast( uint32, fn.kind ) ) : args.Push( cast( uint32, fn.id ) )
        EmitRtlErrorCheck_( c, id, EmitRtl( c, RTL_FILE_CLOSE, args ) )    '' -e (T68)
    next
    return true
end function

'' 'close( n )' IN EXPRESSION POSITION, which yields the ERROR CODE.
''
'' The parser builds the same N_INTRINSIC node either way, so this is the statement
'' form with its result kept rather than discarded -- measured, 'e = close(0)' is
'' 'vr$1 = fb_FileClose( 0 )' and nothing else. Only ONE channel: 'close #1, #2' is two
'' calls and has no single value to be, and fbc does not accept the comma form in an
'' expression anyway.
''
'' file/close.bas asks it ten times, every one about a channel that is not open.
function LowerCloseCall_ _
    ( byref c as Ctx, byval id as Tko.NodeId, byref outv as MirValue ) as boolean

    if c.ast->Kind( id ) <> Tko.N_INTRINSIC then return false
    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    if sp->op <> cast( uint16, Tko.KW_CLOSE ) then return false

    '' 'close( )' WITH NO CHANNEL closes them all, and has a value of its own:
    '' measured, 'e = close( )' is 'vr$1 = fb_FileCloseAll( )'.
    if sp->count = 0 then
        dim as containers.Array( of uint32 ) none_
        outv = EmitRtl( c, RTL_FILE_CLOSEALL, none_ )
        return (outv.kind <> cast( uint8, MV_NONE ))
    end if
    if sp->count <> 1 then return false
    dim as Tko.NodeId it = cast( Tko.NodeId, c.ast->ChildSlot( sp->first ) )
    if c.ast->Kind( it ) = Tko.N_ELIDED then return false

    dim as MirValue fn = LowerNumArg_( c, it, MT_I32 )
    if fn.kind = cast( uint8, MV_NONE ) then return false
    dim as containers.Array( of uint32 ) args
    args.Push( cast( uint32, fn.kind ) ) : args.Push( cast( uint32, fn.id ) )
    outv = EmitRtl( c, RTL_FILE_CLOSE, args )
    return (outv.kind <> cast( uint8, MV_NONE ))
end function

'' ERROR n -- raise a runtime error.
''
'' Measured from fbc's own C:
''
''     void* vr$0 = fb_ErrorThrowEx( 5, 2, (char*)"er.bas", (void*)0, (void*)0 );
''     goto *vr$0;
''
'' Five arguments: the error number, THE SOURCE LINE, THE SOURCE FILE NAME, and two
'' resume labels that are null in -lang fb. The return value is the address of the
'' installed handler, and fbc jumps to it.
''
'' THE RETURN VALUE IS THE JUMP, and it was being thrown away. This block ended
'' UNREACHABLE, on the reasoning that tiko-lang had neither an indirect-branch
'' terminator nor an address-of-label value and so could not install a handler at
'' all. Both have existed since the -exx bounds checks were lowered: ON ERROR GOTO
'' already emits fb_ErrorSetHandler with a real 'blockaddr', and a failed bounds
'' check already jumps through EmitErrorJump_. Only 'error n' was left behind.
''
'' So every program with a handler ran off the end of the throw: measured, an eight
'' line 'on error goto caught : error( 5 )' printed NOTHING and exited 3 under
'' tiko-lang where fbc prints 'caught ok', and com/comptr-error-path.bas -- which
'' raises inside a sub -- exited 139.
''
'' WHERE THE PROCEDURE HAS NO HANDLER NOTHING CHANGES: ResolveErrorJumps_ turns an
'' indirect jump with no destinations back into UNREACHABLE, which is what the 191
'' abort sites in the runtime headers were relying on and still get.
function LowerError( byref c as Ctx, byval id as Tko.NodeId ) as boolean
    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    if sp->count <> 1 then return false
    dim as Tko.NodeId numE = cast( Tko.NodeId, c.ast->ChildSlot( sp->first ) )
    dim as MirValue num = LowerNumArg_( c, numE, MT_I32 )
    if num.kind = cast( uint8, MV_NONE ) then return false

    dim as Tko.DecodedLoc d = c.srcMgr->Decode( c.ast->Loc( id ) )
    dim as string fname = ""
    dim as Tko.SourceFile ptr sf = c.srcMgr->FileAt( d.file )
    if sf <> nullptr then fname = c.names->Spelling( sf->displayPath )
    '' A MODULE'S GENERIC, compiled from the module's interface, is named by the source
    '' file its '#line' points at -- sharedptr.tiko, not std.memory.tki.
    if sf <> nullptr then
        if sf->isVirtual andalso (d.shownName <> Tko.INTERN_NONE) then fname = c.srcMgr->ShownPathOf( d )
    end if

    dim as containers.Array( of uint32 ) args
    args.Push( cast( uint32, num.kind ) ) : args.Push( cast( uint32, num.id ) )
    args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( cast( uint32, d.lineNo ) )
    args.Push( cast( uint32, MV_GLOBAL ) )
    args.Push( cast( uint32, c.m->AddStringLiteral( fname, *c.names ) ) )
    args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( 0 )
    args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( 0 )
    dim as MirValue jr = EmitRtl( c, RTL_ERROR_THROW, args )

    if jr.kind = cast( uint8, MV_NONE ) then
        Terminate( c, MTERM_UNREACHABLE, -1, -1, NoVal( ) )
    else
        '' The destinations are patched in at the end of the procedure, because a
        '' raise can be lowered BEFORE the ON ERROR that installs the handler.
        c.errIndirectBlocks.Push( cast( uint32, c.curBlock ) )
        Terminate( c, MTERM_INDIRECTBR, -1, -1, jr )
    end if
    c.curBlock = NewBlock( c, "error.after" )
    return true
end function

'' The DESTRUCTOR of a UDT, or SYMBOL_NONE. Named 'destructor' in its own scope.
private function DtorOf_( byref c as Ctx, byval t as Tko.TypeId ) as Tko.SymbolId
    if t = Tko.TYPE_NONE then return Tko.SYMBOL_NONE
    if c.types->Kind( t ) <> Tko.TK_UDT then return Tko.SYMBOL_NONE
    '' By the UDT's symbol rather than looking its name up: a TypeId does not carry the
    '' scope it was declared in in a form Lookup can take, and the same spelling may
    '' name a UDT in two namespaces. The identity being matched is the TYPE, which is
    '' unique. The first such symbol, as the scan over 1 .. Count - 1 found it, from
    '' c.ix.udtSymByType -- that scan ran per 'new' and per 'delete'.
    dim as int32 hi = c.syms->Count( ) - 1
    while c.ix.udtSymScanned < hi
        c.ix.udtSymScanned += 1
        dim as Tko.Symbol ptr us = c.syms->SymbolAt( cast( Tko.SymbolId, c.ix.udtSymScanned ) )
        if us = nullptr then continue while
        if us->kind <> cast( uint8, Tko.SYM_UDT ) then continue while
        if us->type_ = Tko.TYPE_NONE then continue while
        if c.ix.udtSymByType.Find( cast( uint32, us->type_ ) ) < 0 then
            c.ix.udtSymByType.Put( cast( uint32, us->type_ ), c.ix.udtSymScanned )
        end if
    wend
    dim as int32 at = c.ix.udtSymByType.Find( cast( uint32, t ) )
    if at < 0 then return Tko.SYMBOL_NONE
    dim as Tko.Symbol ptr us = c.syms->SymbolAt( cast( Tko.SymbolId, at ) )
    if us->inner = Tko.SCOPE_NONE then return Tko.SYMBOL_NONE
    return c.syms->LookupLocal( us->inner, c.names->Fold( c.names->GetString( "__dtor" ) ) )
end function

'' DELETE p -- run the destructor, then release the storage.
''
'' Measured from fbc's own C, which is smaller than the keyword suggests:
''
''     if( P$0 == (struct $1T*)0ull) goto label$5;
''     _ZN1TD1Ev( P$0 );
''     free( (void*)P$0 );
''     label$5:;
''
'' A NULL CHECK, the destructor called with the pointer itself as the receiver, and
'' libc's free -- not an fb_* entry point. 'delete[] q' over a scalar array is the same
'' without the destructor call.
''
'' AN ARRAY of a type that HAS a destructor runs one per element, last first, with the
'' count read from the cookie 'new T[n]' wrote before the first element, and releases
'' the cookie's address -- LowerDeleteArray_ in lowernew.tiko (T37).
'' 'new T', 'new T( args )', 'new T[ n ]'.
''
'' Measured, and the surprises are worth stating because none of them is guessable:
''
''   - THE ALLOCATOR IS ALWAYS libc calloc( bytes, 1 ) -- never malloc, never a runtime
''     helper. Every allocation is therefore ZERO-FILLED BY CONSTRUCTION, which is what
''     lets 'new string' work with no constructor call at all: the zeroing IS the
''     FBSTRING's initialisation.
''   - THE NULL GUARD IS INLINE, AT THE CALL SITE, around the construction. The runtime
''     never sees a null.
''   - THE COOKIE IS KEYED ON "THE TYPE HAS A DESTRUCTOR", NOT ON "THIS IS AN ARRAY".
''     'new C[n]' where C has a constructor but no destructor allocates no cookie at
''     all. Where there IS one it is 8 bytes holding the ELEMENT COUNT -- not a byte
''     size -- written at offset 0, with the returned pointer bumped past it.
''   - The temp is assigned to the user's variable only AFTER construction.
''
'' Implemented here: the SCALAR forms, with and without a constructor. The ARRAY form
'' declines: it needs a construction loop and a cookie whose presence depends on a
'' property of T that is invisible at the delete site, and getting that half-right is
'' worse than declining it.
'' 'new' and its array form, in their own file at the 1500-line cap.
#include once "mir/lowernew.tiko"

'' The constructor of a type taking 'want' arguments, or nothing. Structors live in the
'' type's scope under a synthetic name, because neither has a name of its own in the
'' source.
function CtorOf_ _
    ( byref c as Ctx, byval t as Tko.TypeId, byval want as int32 ) as Tko.SymbolId
    if t = Tko.TYPE_NONE then return Tko.SYMBOL_NONE
    if c.types->Kind( t ) <> Tko.TK_UDT then return Tko.SYMBOL_NONE
    dim as Tko.SymbolId head = StructorOf( c, t, "__ctor" )
    if head = Tko.SYMBOL_NONE then return Tko.SYMBOL_NONE
    return StructorWithArity( c, head, want )
end function

function LowerDelete( byref c as Ctx, byval id as Tko.NodeId ) as boolean
    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    if sp->a = Tko.NODE_NONE then return false

    dim as Tko.TypeId pt = c.info->TypeOf_( sp->a )
    if pt = Tko.TYPE_NONE then return false
    if c.types->Kind( c.types->Unqualify( pt ) ) <> Tko.TK_POINTER then return false
    dim as Tko.TypeId el = c.types->Unqualify( c.types->Inner( c.types->Unqualify( pt ) ) )   '' unqualified: a 'const A ptr' still deletes through the vtable (virtual.bas)

    dim as Tko.SymbolId dtor = DtorOf_( c, el )
    '' ...and the destructor fbc writes for you, for the same reason: 'delete p' over a
    '' type holding a string freed the object with the string's buffer still attached.
    dim as boolean implDtor = false
    if dtor = Tko.SYMBOL_NONE then
        implDtor = (c.types->Kind( el ) = Tko.TK_UDT) andalso TypeNeedsDtor_( c, el )
    end if
    '' THE PARSER RECORDS 'delete[]' IN 'extra', NOT IN THE NODE FLAGS -- see the
    '' KW_DELETE case, which writes 'sp.extra = 1' for the bracketed form. Reading
    '' NF_ARRAY here answered FALSE for every 'delete[]' there has ever been, so the
    '' array form chose the SCALAR 'operator delete' and the guard below that refuses
    '' an array delete over a type with a destructor never fired either.
    dim as boolean isArray = (sp->extra <> 0)
    '' Hoisted to a boolean local: 'x <> y orelse b' mixes a comparison with a boolean
    '' and fbc warns 38 on it.
    dim as boolean anyDtor = (dtor <> Tko.SYMBOL_NONE)
    if anyDtor = false then anyDtor = implDtor
    if isArray andalso anyDtor then return LowerDeleteArray_( c, sp->a, el, dtor, implDtor )

    dim as MirValue p = LowerExpr( c, sp->a )
    if p.kind = cast( uint8, MV_NONE ) then return false
    p = Coerce( c, p, MT_PTR )

    '' 'if p <> 0 then ... end if', in the shape fbc emits: a compare, a conditional
    '' branch, the body, and a join.
    dim as MirValue zero = ConstInt( c, 0, MT_PTR )
    dim as MirInst cmp
    cmp.op = cast( uint16, M_ICMP_NE )
    cmp.ty = cast( uint8, MT_I32 )
    cmp.a = p
    cmp.b = zero
    dim as MirValue cond = Emit( c, cmp )
    if cond.kind = cast( uint8, MV_NONE ) then return false

    dim as int32 bodyB = NewBlock( c, "del.body" )
    dim as int32 joinB = NewBlock( c, "del.join" )
    Terminate( c, MTERM_CONDBR, bodyB, joinB, cond )
    c.curBlock = bodyB

    if dtor <> Tko.SYMBOL_NONE then
        if EmitVirtualDtor_( c, el, dtor, p ) = false then EmitStructorCall( c, dtor, -1, @p )
    elseif implDtor then
        CallImplicitDtor_( c, el, p )
    end if

    '' A STRING HAS NO UDT DESTRUCTOR AND STILL NEEDS RELEASING. 'delete ps' over a
    '' 'string ptr' is 'fb_StrDelete( PS ); free( PS )' -- measured -- and without the
    '' first the descriptor's own allocation leaked on every one.
    if IsStringType( c, el ) then
        dim as containers.Array( of uint32 ) sda
        sda.Push( cast( uint32, p.kind ) ) : sda.Push( cast( uint32, p.id ) )
        EmitRtl( c, StrRtlFor_( c, el, RTL_STR_DELETE ), sda )
    end if

    '' A TYPE'S OWN 'operator delete' IS THE DEALLOCATOR, the mirror of the
    '' 'operator new' lowernew.tiko now calls. Measured, fbc calls it:
    ''
    ''     delete p    ->  _ZN3BARdlEPv( (void*)P$0 )
    ''
    '' and tiko emitted the runtime free instead, so a type that allocated through
    '' its own operator was released through a different one. STATIC, so the pointer
    '' is the only argument. The DESTRUCTOR above still runs either way: the two are
    '' separate obligations and fbc emits both.
    dim as Tko.SymbolId opDel = _
        StructorWithArity( c, StructorOf( c, el, iif( isArray, "delete[]", "delete" ) ), 1 )
    if opDel <> Tko.SYMBOL_NONE then
        dim as containers.Array( of uint32 ) da
        da.Push( cast( uint32, p.kind ) ) : da.Push( cast( uint32, p.id ) )
        EmitDirectCall_( c, opDel, MT_VOID, da )
    else
        dim as containers.Array( of uint32 ) fargs
        fargs.Push( cast( uint32, p.kind ) ) : fargs.Push( cast( uint32, p.id ) )
        EmitAllocCall_( c, RTL_FREE, fargs )   '' a program's own 'deallocate' if it has one
    end if

    Terminate( c, MTERM_BR, joinB, -1, NoVal( ) )
    c.curBlock = joinB
    return true
end function

'' 'a += b' and its six siblings. The operator was READ BY THE PARSER, recorded on the
'' statement, and then IGNORED: every compound assignment lowered to a plain store of
'' the right-hand side, so 'q += w' compiled as 'q = w'. Verifier-clean, no decline, no
'' diagnostic -- a silent miscompile of one of the commonest statements in the language.
''
'' The target's address is taken ONCE and the read, the operation and the write all go
'' through it, so an lvalue with a side effect -- 'arr( f( ) ) += 1' -- calls f once, as
'' fbc does.
''
'' It computes in the BINARY OPERATOR's result type -- 'x op= y' is 'x = x op y'.
''
'' '^=' is absent on purpose: power needs a runtime call tiko-lang's inventory does not carry
'' yet, and declining is the honest answer where inventing a shift would not be.

function LowerCompoundAssign _
    ( byref c as Ctx, byval target as Tko.NodeId, byval value as Tko.NodeId, _
      byval op as Tko.TokenKind ) as boolean

    '' THE WORD-SPELLED FORMS TOO -- 'and=', 'shl=', 'mod=' and the rest. Each is the
    '' same read-modify-write with the operator spelled as a keyword; the parser now
    '' records the keyword itself in 'op', so the mapping is the identity for them.
    ''
    '' 'andalso=' and 'orelse=' are NOT here: they are control flow, and lowering them
    '' as a plain AND would evaluate the right side unconditionally.
    '' 'andalso=' and 'orelse=' ARE THE SHORT-CIRCUIT FORM, and lowering them as a
    '' plain AND would evaluate the right side unconditionally. Measured, 'i andalso=
    '' side( )' is exactly 'i = i andalso side( )':
    ''
    ''     if( I == 0 ) goto SHORT;  vr = SIDE( );  TMP = -( vr != 0 );  goto JOIN;
    ''     SHORT: TMP = 0;  JOIN: I = TMP;
    if (op = Tko.KW_ANDALSO) orelse (op = Tko.KW_ORELSE) then
        dim as Tko.TypeId stt = c.info->TypeOf_( target )
        if stt = Tko.TYPE_NONE then return false
        dim as MirType smt = LowerType( stt, *c.types )
        if (smt = MT_VOID) orelse (smt = MT_AGG) then return false
        dim as MirValue sv = LowerShortCircuitParts_( c, target, value, _
                                                      (op = Tko.KW_ANDALSO), smt )
        if sv.kind = cast( uint8, MV_NONE ) then return false
        dim as MirValue sa = LowerAddr( c, target )
        if sa.kind = cast( uint8, MV_NONE ) then return false
        StoreThrough( c, sa, CoerceTy( c, sv, smt, stt) )
        return true
    end if

    dim as Tko.TypeId tt = c.info->TypeOf_( target )
    if tt = Tko.TYPE_NONE then return false

    '' A SELF-OPERATOR ON A UDT IS A MEMBER CALL, and it was not lowered at all: this
    '' function bailed on MT_AGG before it ever looked for one, so 'u += v' over a type
    '' declaring 'operator +=' declined -- while 'u = u + v' beside it, through a global
    '' 'operator +', lowered perfectly.
    ''
    '' Measured: no temporary anywhere, no read-modify-write. fbc emits the member call
    '' with the TARGET'S ADDRESS as the receiver and nothing else:
    ''
    ''     _ZN1TpLERS_( &U$0, &V$0 );
    ''
    '' The operator's member NAME is the spelling it was declared with -- '+=' for the
    '' punctuation ones and 'and=' for the word ones, which is exactly what the parser
    '' interns for 'operator and=' (two tokens, one name).
    if SelfOpMemberCall_( c, target, value, op, tt ) then return true

    '' ...AND THE MEMBER CALL IS TRIED BEFORE THE OPERATOR MAP, because '&=' is not IN
    '' that map. It is a CONCATENATION and never an arithmetic operator, so it reached
    '' 'case else' and declined before SelfOpMemberCall_ -- which has known '&=' since
    '' it was written -- ever ran. Nothing to do with strings: a UDT declaring both
    '' '+=' and '&=' over plain integers lowered the first and declined the second.
    '' Measured, fbc: '_ZN3BARv27selfcatERS_( &L$0, &R$0 );'.

    dim as Tko.TokenKind bop = Tko.TK_EOF
    select case op
    case Tko.TK_PLUSEQ   : bop = Tko.TK_PLUS
    case Tko.TK_MINUSEQ  : bop = Tko.TK_MINUS
    case Tko.TK_STAREQ   : bop = Tko.TK_STAR
    case Tko.TK_SLASHEQ  : bop = Tko.TK_SLASH
    case Tko.TK_BSLASHEQ : bop = Tko.TK_BACKSLASH
    case Tko.TK_CARETEQ  : bop = Tko.TK_CARET
    case Tko.KW_AND, Tko.KW_OR, Tko.KW_XOR, Tko.KW_IMP, Tko.KW_EQV, _
         Tko.KW_MOD, Tko.KW_SHL, Tko.KW_SHR
        bop = op
    case else            : return false
    end select

    dim as MirType mt = LowerType( tt, *c.types )
    if (mt = MT_VOID) orelse (mt = MT_AGG) then return false

    '' A BITFIELD TARGET HAS NO ADDRESS: it is bits inside a unit its neighbours
    '' share, so 'x.a += 1' is a read, an add and a masked write rather than a store
    '' through an address. The plain path asked LowerAddr for one and declined.
    '' Measured -- fbc emits the whole read-modify-write in one line.
    if BitfieldCompound_( c, target, value, bop ) then return true
    dim as int32 pcr = PropertyCompound_( c, target, value, bop ) : if pcr >= 0 then return (pcr = 1)   '' a property: get, op, set

    '' THE ARITHMETIC RUNS IN WHAT 'target op value' WOULD BE, by Check's table: the target's
    '' type rounded a float operand first ('i += 0.5' printed 1, fbc 2) and worked '\' and
    '' 'mod' unpromoted. A pointer target or a UDT operand keeps the target's type.
    dim as Tko.TypeId rt = Tko.Check.BinaryResult( bop, tt, c.info->TypeOf_( value ), *c.types )
    dim as MirType wt = MT_VOID
    if rt <> Tko.TYPE_NONE then wt = LowerType( rt, *c.types )
    if (wt = MT_VOID) orelse (wt = MT_AGG) orelse (wt = MT_PTR) then
        rt = tt
        wt = mt
        if bop = Tko.TK_SLASH then wt = iif( mt = MT_F32, MT_F32, MT_F64 )
        if bop = Tko.TK_CARET then wt = MT_F64
    end if

    dim as MirValue addr = LowerAddr( c, target )
    if addr.kind = cast( uint8, MV_NONE ) then return false
    '' THROUGH A CONVERSION-FREE CAST THE SLOT IS THE OPERAND'S. 'cast( integer, bp ) += 8' is
    '' 'BP = (int8*)((int64)BP + 8)', measured: read as the pointer, worked as the integer the
    '' cast names, stored back as the pointer. See NoConvOperand_.
    dim as MirType smt = mt
    dim as Tko.TypeId sct = Tko.TYPE_NONE
    dim as Tko.NodeId scop = NoConvOperand_( c, target )
    if scop <> Tko.NODE_NONE then
        sct = c.types->Unqualify( c.info->TypeOf_( scop ) )
        if c.types->Kind( sct ) = Tko.TK_REFERENCE then sct = c.types->Inner( sct )
        smt = LowerType( sct, *c.types )
    end if
    dim as MirValue cur = LowerExprLoad( c, addr, smt )
    if cur.kind = cast( uint8, MV_NONE ) then return false
    if smt <> mt then cur = CoerceTy( c, cur, mt, sct, tt )
    cur = CoerceTy( c, cur, wt, tt)
    dim as MirValue rhs : if UserConvToScalar_( c, value, rt, rhs ) = false then rhs = LowerExpr( c, value )
    if rhs.kind = cast( uint8, MV_NONE ) then return false
    '' A POINTER TARGET KEEPS ITS OFFSET AN INTEGER. Coercing the right-hand side to
    '' the TARGET's type makes it a POINTER, and the scale and the add then came out
    '' as 'mul ptr' and 'add ptr' -- neither is an LLVM instruction, so 'p += n' over
    '' any pointer refused to emit. M_PTR_ADD below takes a byte offset.
    dim as boolean ptrTarget = (PtrArithElem_( c, tt ) > 0)
    if ptrTarget then
        ptrTarget = (bop = Tko.TK_PLUS) orelse (bop = Tko.TK_MINUS)
    end if
    dim as MirType offT = MT_I64
    if c.types->target.pointerBits = 32 then offT = MT_I32
    if ptrTarget then
        rhs = CoerceTy( c, rhs, offT, c.info->TypeOf_( value ))
    else
        rhs = CoerceTy( c, rhs, wt, c.info->TypeOf_( value ))
    end if

    '' POINTER ARITHMETIC IS SCALED BY THE POINTEE HERE TOO. 'p += 1' over a
    '' 'short ptr' is '(uint8*)P$0 + 2ll' to fbc and was a one-BYTE add here --
    '' the same silent miscompile the binary path had, in the other half of the
    '' language. The element size comes from the ASSIGNMENT TARGET'S type, which
    '' is what makes 'cptr( short ptr, pt ) += 1' advance by two even though pt
    '' is an 'any ptr'.
    if ptrTarget then
        dim as int32 pesz = PtrArithElem_( c, tt )
        if pesz > 1 then
            dim as MirInst psc
            psc.op = cast( uint16, M_MUL )
            psc.ty = cast( uint8, offT )
            psc.a = rhs
            psc.b = ConstInt( c, pesz, offT )
            rhs = Emit( c, psc )
            if rhs.kind = cast( uint8, MV_NONE ) then return false
        end if
        '' 'p -= n' IS 'p + (-n)': M_PTR_ADD has no subtracting form, and fbc
        '' writes the same -- 'r -= 2' over an 'integer ptr' is '(uint8*)R + -16'.
        if bop = Tko.TK_MINUS then
            dim as MirInst png
            png.op = cast( uint16, M_SUB )
            png.ty = cast( uint8, offT )
            png.a = ConstInt( c, 0, offT )
            png.b = rhs
            rhs = Emit( c, png )
            if rhs.kind = cast( uint8, MV_NONE ) then return false
        end if
        dim as MirInst ppa
        ppa.op = cast( uint16, M_PTR_ADD )
        ppa.ty = cast( uint8, MT_PTR )
        ppa.a = Coerce( c, cur, MT_PTR, false )
        ppa.b = rhs
        dim as MirValue pres = Emit( c, ppa )
        if pres.kind = cast( uint8, MV_NONE ) then return false
        StoreThrough( c, addr, pres )
        return true
    end if

    dim as MirValue res
    if bop = Tko.TK_CARET then
        dim as containers.Array( of uint32 ) pa
        pa.Push( cast( uint32, cur.kind ) ) : pa.Push( cast( uint32, cur.id ) )
        pa.Push( cast( uint32, rhs.kind ) ) : pa.Push( cast( uint32, rhs.id ) )
        res = EmitRtl( c, RTL_POW, pa )
    elseif (bop = Tko.KW_IMP) orelse (bop = Tko.KW_EQV) then
        res = EmitImpEqv_( c, bop, wt, cur, rhs )
    else
        dim as MirOp mop = BinOpFor( bop, wt, IsUnsignedType( c, rt ) )
        if mop = M_NONE then return false
        dim as MirInst bi
        bi.op = cast( uint16, mop )
        bi.ty = cast( uint8, wt )
        bi.a = cur
        bi.b = rhs
        res = Emit( c, bi )
    end if
    if res.kind = cast( uint8, MV_NONE ) then return false

    '' THE RESULT CONVERTS AS AN ASSIGNMENT'S VALUE DOES -- rounded, unsigned, normalised
    '' into a boolean ('bo and= 2' is true). A boolean result is already 0 or 1.
    dim as MirValue sv = res
    if IsBooleanType( c, rt ) = false then sv = CoerceTy( c, res, mt, rt, tt )
    dim as MirInst st
    st.op = cast( uint16, M_STORE )
    st.ty = cast( uint8, MT_VOID )
    st.a = addr
    st.b = sv
    if smt <> mt then st.b = CoerceTy( c, st.b, smt, tt, sct )   '' back into the operand's own slot
    Emit( c, st )
    return true
end function




'' A BITFIELD MEMBER ACCESS, as the address of its storage UNIT plus the bits it owns.
'' Returns false when the member is not a bitfield, so the caller carries on as before.
''

'' One arm of a string iif into its temporary: fb_StrInit, or for a USTRING iif the
'' declaration path, which already converts, renders and nests in UTF-16.
private function StrIifArmInit_ _
    ( byref c as Ctx, byval isU as boolean, byval slot as int32, byref taddr as MirValue, _
      byval e as Tko.NodeId ) as boolean
    if isU then return LowerStringInit( c, slot, e, e )
    return StrInitFrom_( c, taddr, e )
end function

'' A STRING 'iif'. Measured from fbc:
''
''     if( C == 0 ) goto label$2;
''     fb_StrInit( &TMP$4, -1, &A, -1, 0 );
''     goto label$4;
''   label$2:
''     fb_StrInit( &TMP$4, -1, &B, -1, 0 );
''   label$4:
''     fb_StrAssign( &R, -1, &TMP$4, -1, 0 );
''     fb_StrDelete( &TMP$4 );
''
'' The temporary is INITIALISED in each arm, not assigned: it has no prior contents,
'' and fb_StrAssign on uninitialised descriptor bytes would free whatever pointer
'' happened to be there. Its life ends with the STATEMENT, which is shorter than any
'' scope, so it is registered on the statement-temporary list rather than the scope
'' cleanup list.
''
'' ...AND A USTRING iif IS THE SAME SHAPE IN UTF-16: fb_UStrInit in each arm and
'' fb_UStrDelete after, measured. IsStringType claims USTRING too, so the narrow
'' fb_StrInit copied a UTF-16 descriptor's units as bytes and every consumer read the
'' temporary back as UTF-16: 'iif( f, left( r, 1 ), r )' over "C:" gave "C" + NUL.
function LowerStringIif_ _
    ( byref c as Ctx, byval condE as Tko.NodeId, byval thenE as Tko.NodeId, _
      byval elseE as Tko.NodeId, byref outv as MirValue ) as boolean

    dim as MirValue cond = LowerCondition( c, condE )
    if cond.kind = cast( uint8, MV_NONE ) then return false

    '' A ustring CHAIN counts: Check types it STRING, fbc and the iif row in Check USTRING.
    dim as boolean isU = IsUStringType( c, c.info->TypeOf_( thenE ) ) orelse _
                         IsUStringType( c, c.info->TypeOf_( elseE ) ) orelse _
                         IsUStrChain_( c, thenE ) orelse IsUStrChain_( c, elseE ) orelse UdtCastIsUStr_( c, thenE ) orelse UdtCastIsUStr_( c, elseE )
    dim as int32 slot = NewTempLocal( c, MT_AGG, c.types->target.stringBytes )
    if slot < 0 then return false
    '' The slot's TYPE is what ReleaseStrTemps_ picks fb_UStrDelete by, and what
    '' LowerStringInit reads to initialise each arm as 'dim as ustring t = arm' would.
    if isU then c.f->locals[slot].frontendType = c.types->Builtin( Tko.TY_USTRING )
    dim as MirValue taddr
    taddr.kind = cast( uint8, MV_LOCAL )
    taddr.ty = cast( uint8, MT_PTR )
    taddr.id = slot
    '' ZEROED BEFORE THE BRANCH, and that is not tidiness. The slot is registered
    '' for deletion at the end of the statement, and a NESTED iif puts one of these
    '' inside an ARM -- so on the path that arm does not take, fb_StrDelete runs on
    '' a descriptor no fb_StrInit ever wrote and frees whatever the stack held:
    ''
    ''     d = iif( 0, iif( 0, a, b ), c )      fbc prints c; tiko segfaulted
    ''
    '' A string LOCAL has been zeroed since it existed; only these temporaries were
    '' not. Emitted here, in the block before the CONDBR, so both paths see it.
    ZeroStrDescriptor( c, taddr )

    dim as int32 thenB = NewBlock( c, "iif.then" )
    dim as int32 elseB = NewBlock( c, "iif.else" )
    dim as int32 joinB = NewBlock( c, "iif.join" )
    Terminate( c, MTERM_CONDBR, thenB, elseB, cond )

    '' AN ARM'S OWN TEMPORARIES -- UDT, STRING AND WIDE -- DIE IN THAT ARM, as in LowerIif: the
    '' statement-end flush emits every delete and destructor in the JOIN, which the other path
    '' reaches too. 'iif( c, strings.Format( "a" ), strings.Format( "b" ) )' destroyed the untaken
    '' arm's never-built FormatString there: 0xC0000374 (tests/driver/iif-untaken-temps).
    c.curBlock = thenB
    dim as int32 stm = c.strTemps.Count, tum = c.udtTemps.Count, twm = c.wstrTemps.Count
    if StrIifArmInit_( c, isU, slot, taddr, thenE ) = false then return StrIifAbandon_( c, joinB, elseB )
    ReleaseUdtTemps_( c, tum )
    ReleaseStrTemps_( c, stm )
    ReleaseWstrTemps_( c, twm )
    Terminate( c, MTERM_BR, joinB, -1, NoVal( ) )

    c.curBlock = elseB
    dim as int32 sem = c.strTemps.Count, eum = c.udtTemps.Count, ewm = c.wstrTemps.Count
    if StrIifArmInit_( c, isU, slot, taddr, elseE ) = false then return StrIifAbandon_( c, joinB, -1 )
    ReleaseUdtTemps_( c, eum )
    ReleaseStrTemps_( c, sem )
    ReleaseWstrTemps_( c, ewm )
    Terminate( c, MTERM_BR, joinB, -1, NoVal( ) )

    c.curBlock = joinB
    c.strTemps.Push( cast( uint32, slot ) )
    outv = taddr
    return true
end function

'' A STRING-TYPED ARM THAT HAS AN ADDRESS -- a variable, a field, an element. False
'' when it is string-typed and has none, which is a CALL: 'iif( c, hex( 1 ), hex( 2 ) )'
'' used to reach the descriptor path below only because Check computed no type for an
'' intrinsic call, and the moment the radix family was typed the type test claimed the
'' arm and then asked an N_CALL for an address it has not got. Falling through instead
'' of declining is what makes the two orderings agree.
private function StringArmAddr_ _
    ( byref c as Ctx, byval e as Tko.NodeId, byref args as containers.Array( of uint32 ) ) as boolean

    if IsStringType( c, c.info->TypeOf_( e ) ) = false then return false
    if NamesProc_( c, e ) then return false   '' its "address" is its code: a CALL
    dim as MirValue sv = LowerAddr( c, e )
    if sv.kind = cast( uint8, MV_NONE ) then return false
    args.Push( cast( uint32, sv.kind ) ) : args.Push( cast( uint32, sv.id ) )
    args.Push( cast( uint32, MV_CONST_INT ) )
    args.Push( cast( uint32, cast( uint64, -1 ) ) )
    return true
end function

'' fb_StrInit( dst, -1, src, srcLen, 0 ) for one arm. A literal passes its own bytes
'' and a length that INCLUDES the terminator, which is the fb_StrInit convention and
'' not the fb_StrAllocTempDescZEx one.
function StrInitFrom_ _
    ( byref c as Ctx, byref dst as MirValue, byval e as Tko.NodeId ) as boolean

    dim as containers.Array( of uint32 ) args
    args.Push( cast( uint32, dst.kind ) ) : args.Push( cast( uint32, dst.id ) )
    args.Push( cast( uint32, MV_CONST_INT ) )
    args.Push( cast( uint32, cast( uint64, -1 ) ) )

    '' A CONCATENATION ARM -- 'iif( c, a + b, "" )' -- FIRST, before the type tests. A
    '' concat IS string-typed, so IsStringType below claims it and then asks for its
    '' ADDRESS, which it has not got. Same ordering trap as everywhere else in this
    '' file: a recogniser has to run before the test that would swallow it.
    dim as MirValue ccv
    if ConcatToTemp_( c, e, ccv ) then
        args.Push( cast( uint32, ccv.kind ) ) : args.Push( cast( uint32, ccv.id ) )
        args.Push( cast( uint32, MV_CONST_INT ) )
        args.Push( cast( uint32, cast( uint64, -1 ) ) )
        args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( 0 )
        EmitRtl( c, RTL_STR_INIT, args )
        return true
    end if

    dim as int64 zn
    if c.ast->Kind( e ) = Tko.N_STRING_LIT then
        dim as string lit = StringLitText_( c, e )
        args.Push( cast( uint32, MV_GLOBAL ) )
        args.Push( cast( uint32, c.m->AddStringLiteral( lit, *c.names ) ) )
        args.Push( cast( uint32, MV_CONST_INT ) )
        args.Push( cast( uint32, len( lit ) + 1 ) )
    elseif StrSwapKind_( c, c.info->TypeOf_( e ), zn ) = 1 then
        '' A FIXED-LENGTH NARROW ARM passes its address and its DECLARED LENGTH, not
        '' -1: there is no descriptor to read a length out of. Measured --
        '' 'fb_StrInit( &TMP$5, -1ll, FA$1, 8ll, 0 )'.
        dim as MirValue zv = LowerAddr( c, e )
        if zv.kind = cast( uint8, MV_NONE ) then return false
        args.Push( cast( uint32, zv.kind ) ) : args.Push( cast( uint32, zv.id ) )
        args.Push( cast( uint32, MV_CONST_INT ) )
        args.Push( cast( uint32, zn ) )
    elseif StringArmAddr_( c, e, args ) then
        '' handled: a string-typed arm that has an address
    else
        '' ANYTHING THAT HANDS BACK A DESCRIPTOR -- 'hex( n )', 'trim( s )', a nested
        '' string iif. fbc puts the call's result in a temporary and inits from it:
        '' 'vr$6 = fb_HEX_l( 123 ); fb_StrInit( &TMP$4, -1ll, vr$6, -1ll, 0 )'.
        '' Without this an arm whose type Check does not compute -- which is every
        '' intrinsic call -- declined the whole iif.
        dim as MirValue dv
        if StrDescriptorOf_( c, e, dv ) = false then return false
        if dv.kind = cast( uint8, MV_NONE ) then return false
        args.Push( cast( uint32, dv.kind ) ) : args.Push( cast( uint32, dv.id ) )
        args.Push( cast( uint32, MV_CONST_INT ) )
        args.Push( cast( uint32, cast( uint64, -1 ) ) )
    end if
    args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( 0 )
    EmitRtl( c, RTL_STR_INIT, args )
    return true
end function


'' A UDT 'iif', as an ADDRESS.
''
'' Same branch shape as the scalar form, but the temporary is the UDT itself and what
'' comes back is where it lives -- so '(iif( c, a, b )).i' can take an offset off it
'' without the call being lowered twice.
function LowerAggIif_ _
    ( byref c as Ctx, byval condE as Tko.NodeId, byval thenE as Tko.NodeId, _
      byval elseE as Tko.NodeId, byref outv as MirValue ) as boolean

    dim as Tko.TypeId ft = c.info->TypeOf_( thenE )
    if ft = Tko.TYPE_NONE then ft = c.info->TypeOf_( elseE )
    if ft = Tko.TYPE_NONE then return false
    dim as int32 sz = SizeOfType( c, ft )
    if sz <= 0 then return false

    dim as MirValue cond = LowerCondition( c, condE )
    if cond.kind = cast( uint8, MV_NONE ) then return false

    dim as int32 slot = NewTempLocal( c, MT_AGG, sz )
    if slot < 0 then return false
    dim as MirValue taddr
    taddr.kind = cast( uint8, MV_LOCAL )
    taddr.ty = cast( uint8, MT_PTR )
    taddr.id = slot

    dim as int32 thenB = NewBlock( c, "iif.then" )
    dim as int32 elseB = NewBlock( c, "iif.else" )
    dim as int32 joinB = NewBlock( c, "iif.join" )
    Terminate( c, MTERM_CONDBR, thenB, elseB, cond )

    '' THE RESULT IS A TEMPORARY AND IS DESTROYED LIKE ONE. It was never registered,
    '' so '( iif( c, C( 1 ), C( 2 ) ) ).i' constructed an object and destroyed
    '' nothing at all -- a leak, and for a type owning a buffer a lost one.
    if TypeNeedsDtor_( c, ft ) then
        c.udtTemps.Push( cast( uint32, slot ) )
        c.udtTempTypes.Push( cast( uint32, ft ) )
    end if

    '' ...AND EACH ARM'S OWN TEMPORARIES DIE IN THAT ARM, exactly as the scalar
    '' form's do: the flush runs in the join, which both arms reach.
    c.curBlock = thenB
    dim as int32 atm = c.udtTemps.Count
    if AggIifArm_( c, taddr, thenE, slot, ft ) = false then return false
    ReleaseUdtTemps_( c, atm )
    Terminate( c, MTERM_BR, joinB, -1, NoVal( ) )

    c.curBlock = elseB
    dim as int32 aem = c.udtTemps.Count
    if AggIifArm_( c, taddr, elseE, slot, ft ) = false then return false
    ReleaseUdtTemps_( c, aem )
    Terminate( c, MTERM_BR, joinB, -1, NoVal( ) )

    c.curBlock = joinB
    outv = taddr
    return true
end function

'' One arm, INTO the temporary -- constructed there where it can be, copied where it
'' cannot, and bit-copied only as the last resort it always was.
''
'' Measured against fbc, which draws the line at whether the arm is a TEMPORARY:
''
''     ( iif( c, C( 1 ), C( 2 ) ) ).i    ctors 1 copies 0 dtors 1  -- built IN PLACE
''     z = iif( c, a, b )                ctors 0 copies 1 dtors 4  -- a is an LVALUE
''
'' tiko bit-copied in both: the second ran NO copy constructor, so a type owning a
'' buffer left the slot and the local sharing one pointer.
private function AggIifArm_ _
    ( byref c as Ctx, byref dst as MirValue, byval e as Tko.NodeId, _
      byval slot as int32 = -1, byval ft as Tko.TypeId = Tko.TYPE_NONE ) as boolean

    '' A CONSTRUCTOR CALL OR A TYPE LITERAL IS BUILT WHERE IT LANDS. Lowered as a
    '' value it goes into a temporary of its own and is copied out, which is one
    '' construction and one destruction more than fbc runs.
    if (slot >= 0) andalso (ft <> Tko.TYPE_NONE) then
        if LowerCtorInit( c, slot, ft, e ) then return true
    end if
    '' AN LVALUE OF THE TYPE IS COPY-CONSTRUCTED, not stored over.
    if ft <> Tko.TYPE_NONE then
        if c.types->Unqualify( c.info->TypeOf_( e ) ) = c.types->Unqualify( ft ) then
            dim as Tko.SymbolId acc = CopyCtorOf_( c, ft )
            if acc = Tko.SYMBOL_NONE then acc = InitCopyCtorOf_( c, ft )   '' or one with DEFAULTED trailing params: an initialisation, fbc resolves it (temp-var-dtors.bas)
            if (acc <> Tko.SYMBOL_NONE) orelse NeedsLetBody_( c, ft ) then
                dim as MirValue asrc = LowerAddr( c, e )
                if asrc.kind <> cast( uint8, MV_NONE ) then
                    if acc <> Tko.SYMBOL_NONE then
                        dim as containers.Array( of uint32 ) aargs
                        aargs.Push( cast( uint32, asrc.kind ) ) : aargs.Push( cast( uint32, asrc.id ) )
                        EmitStructorCall( c, acc, -1, @dst, @aargs )
                    else
                        CallImplicitCopy_( c, ft, dst, asrc )
                    end if
                    return true
                end if
            end if
        end if
    end if

    '' AN LVALUE ARM, no copy ctor: the temporary is DEFAULT-CONSTRUCTED, then bit-copied (fbc; expressions/iif.bas).
    if cbool( slot >= 0 ) andalso cbool( ft <> Tko.TYPE_NONE ) andalso cbool( c.types->Unqualify( c.info->TypeOf_( e ) ) = c.types->Unqualify( ft ) ) then
        dim as Tko.SymbolId adc = CtorOf_( c, c.types->Unqualify( ft ), 0 )
        if adc <> Tko.SYMBOL_NONE then EmitStructorCall( c, adc, slot )
    end if
    dim as MirValue v = LowerExpr( c, e )
    if v.kind = cast( uint8, MV_NONE ) then
        dim as MirValue a = LowerAddr( c, e )
        if a.kind = cast( uint8, MV_NONE ) then return false
        v = LowerExprLoad( c, a, MT_AGG )
    end if
    if v.kind = cast( uint8, MV_NONE ) then return false
    dim as MirInst st
    st.op = cast( uint16, M_STORE )
    st.ty = cast( uint8, MT_VOID )
    st.a = dst
    st.b = v
    Emit( c, st )
    return true
end function


'' 'iif( cond, a, b )' as a RUNTIME expression. Returns false when the node is not one,
'' so the caller carries on.
''
'' MIR has no phi, so the value comes out of a TEMPORARY SLOT written on both arms --
'' which is exactly the shape fbc emits:
''
''     if( C == 0ll) goto label$2;
''     TMP = 10ll;  goto label$3;
''     label$2:;  TMP = 20ll;
''     label$3:;  R = TMP;
''
'' It produced NOTHING before, and did not decline: 'dim as integer r = iif( c, 10,
'' 20 )' allocated r, stored nothing and printed whatever the stack held. The DIM
'' initialiser skipped its store whenever the value would not lower, silently.
function LowerIif _
    ( byref c as Ctx, byval id as Tko.NodeId, byval mt as MirType, _
      byref outv as MirValue ) as boolean

    if c.ast->Kind( id ) <> Tko.N_CALL then return false
    dim as Tko.ListPayload ptr lp = _
        c.ast->ListOf( id )
    if lp->count <> 3 then return false
    if lp->target = Tko.NODE_NONE then return false
    if c.ast->Kind( lp->target ) <> Tko.N_IDENT then return false
    dim as Tko.IdentPayload ptr ip = _
        c.ast->IdentOf( lp->target )
    if LowerSpelling_( c.ix, *c.names, ip->name ) <> "iif" then return false

    '' The result type is the one the surrounding expression asked for; an aggregate
    '' or an untyped one has no temporary to write, so it declines.
    dim as Tko.NodeId condE = cast( Tko.NodeId, c.ast->ChildSlot( lp->first ) )
    dim as Tko.NodeId thenE = cast( Tko.NodeId, c.ast->ChildSlot( lp->first + 1 ) )
    dim as Tko.NodeId elseE = cast( Tko.NodeId, c.ast->ChildSlot( lp->first + 2 ) )

    '' The result type is the one the surrounding expression asked for; failing that,
    '' the CALL's own -- which Check does not compute for iif -- and failing that, an
    '' ARM's. An aggregate or a type nothing can name has no temporary to write, so it
    '' declines rather than inventing a slot.
    dim as Tko.TypeId ft = c.info->TypeOf_( id )
    if ft = Tko.TYPE_NONE then ft = c.info->TypeOf_( thenE )
    if ft = Tko.TYPE_NONE then ft = c.info->TypeOf_( elseE )
    dim as MirType rt = mt
    if (rt = MT_VOID) andalso (ft <> Tko.TYPE_NONE) then rt = LowerType( ft, *c.types )

    '' A WIDE iif -- 'iif( c, wstr( "aaaa" ), wstr( "b" ) )' -- is a POINTER
    '' temporary rather than a descriptor: measured, fbc measures, allocates and
    '' assigns in each arm and releases the result with fb_WstrDelete. WideOperand_ has
    '' known how to build one all along, but only a caller ALREADY IN A WIDE CONTEXT
    '' reached it -- so a wide iif in an ordinary expression, 'len( iif( c, wstr(
    '' "aaaa" ), wstr( "b" ) ) )', declined with nothing wide about the surroundings
    '' to route it.
    ''
    '' By SHAPE, not by type: Check computes no type for 'wstr( x )', so an arm made of
    '' one is untyped and 'ft' above is TYPE_NONE for the whole call.
    if TermIsWide_( c, thenE ) orelse TermIsWide_( c, elseE ) then
        if LowerWideIif_( c, condE, thenE, elseE, outv ) then return true
    end if

    '' A STRING iif builds a DESCRIPTOR, not a value, so it takes a different shape:
    '' fb_StrInit into a temporary in each arm, and an fb_StrDelete once the
    '' consuming statement is done with it.
    if IsStringType( c, ft ) orelse SliceMeetsString( c, thenE, elseE ) then   '' ...or a slice arm beside a string one
        return LowerStringIif_( c, condE, thenE, elseE, outv )
    end if

    '' A UDT iif builds its result in a TEMPORARY and yields that temporary's ADDRESS,
    '' because a UDT result is usually read through -- '(iif( c, a, b )).i' is the
    '' shape the corpus writes. The value path below loads it.
    if rt = MT_AGG then
        if c.types->Kind( ft ) <> Tko.TK_UDT then return false
        dim as MirValue aa
        if LowerAggIif_( c, condE, thenE, elseE, aa ) = false then return false
        outv = LowerExprLoad( c, aa, MT_AGG )
        return (outv.kind <> cast( uint8, MV_NONE ))
    end if

    if rt = MT_VOID then return false

    dim as MirValue cond = LowerCondition( c, condE )
    if cond.kind = cast( uint8, MV_NONE ) then return false

    dim as int32 slot = NewTempLocal( c, rt, c.types->Layout( ft ).size )
    if slot < 0 then return false
    dim as MirValue taddr
    taddr.kind = cast( uint8, MV_LOCAL )
    taddr.ty = cast( uint8, MT_PTR )
    taddr.id = slot

    dim as int32 thenB = NewBlock( c, "iif.then" )
    dim as int32 elseB = NewBlock( c, "iif.else" )
    dim as int32 joinB = NewBlock( c, "iif.join" )
    Terminate( c, MTERM_CONDBR, thenB, elseB, cond )

    '' AN ARM'S OWN TEMPORARIES DIE IN THAT ARM, not at the end of the statement.
    '' Both arms push onto the one flat udtTemps list and the statement-end flush
    '' emits every destructor in the JOIN block -- so the arm that DID NOT RUN had
    '' its temporary destroyed anyway, on storage no constructor ever touched.
    '' Measured against fbc, which runs neither:
    ''
    ''     iif( c0, (type<C>( )).i, 456 )     ctors 0 dtors 0 -> ctors 0 dtors 1
    ''     iif( c0, (type<C>( )).i, (type<C>( )).i )   1 and 1 -> 1 and 2
    ''
    '' That is not a miscount: it is a destructor call on an unconstructed object,
    '' and for a type that frees a buffer it is a free of whatever the stack held.
    '' The loop head already draws exactly this line -- see lowerctl.tiko, where a
    '' condition's temporaries die inside the head because the head runs again.
    '' ...AND THE STRING TEMPORARIES WITH THEM. A wide 'right( w, 2 )' built in the arm
    '' that did not run left its slot unwritten, and the statement-end fb_WstrDelete in
    '' the join freed whatever the stack held -- the previous call's pointer, already
    '' freed: 0xC0000374. fbc deletes an arm's temporary inside the arm.
    c.curBlock = thenB
    dim as int32 tmark = c.udtTemps.Count
    dim as int32 tsmark = c.strTemps.Count
    dim as int32 twmark = c.wstrTemps.Count
    dim as MirValue tv = LowerExpr( c, thenE )
    if tv.kind <> cast( uint8, MV_NONE ) then
        dim as MirInst ts
        ts.op = cast( uint16, M_STORE )
        ts.ty = cast( uint8, MT_VOID )
        ts.a = taddr
        ts.b = CoerceTy( c, tv, rt, c.info->TypeOf_( thenE ))
        Emit( c, ts )
    end if
    ReleaseUdtTemps_( c, tmark )
    ReleaseStrTemps_( c, tsmark )
    ReleaseWstrTemps_( c, twmark )
    Terminate( c, MTERM_BR, joinB, -1, NoVal( ) )

    c.curBlock = elseB
    dim as int32 emark = c.udtTemps.Count
    dim as int32 esmark = c.strTemps.Count
    dim as int32 ewmark = c.wstrTemps.Count
    dim as MirValue ev = LowerExpr( c, elseE )
    if ev.kind <> cast( uint8, MV_NONE ) then
        dim as MirInst es
        es.op = cast( uint16, M_STORE )
        es.ty = cast( uint8, MT_VOID )
        es.a = taddr
        es.b = CoerceTy( c, ev, rt, c.info->TypeOf_( elseE ))
        Emit( c, es )
    end if
    ReleaseUdtTemps_( c, emark )
    ReleaseStrTemps_( c, esmark )
    ReleaseWstrTemps_( c, ewmark )
    Terminate( c, MTERM_BR, joinB, -1, NoVal( ) )

    c.curBlock = joinB
    outv = LowerExprLoad( c, taddr, rt )
    return (outv.kind <> cast( uint8, MV_NONE ))
end function

'' 'procptr( f )' -- THE ADDRESS OF A PROCEDURE. Returns false when the node is not one.
''
'' fbc spells it '(tmp$2)&F', a plain function address, and stores it in an ordinary
'' pointer. MIR carries it as M_FUNC_ADDR over the function's table index, because a
'' MirValue has no kind for a function and the index is what the dump and the backend
'' both need.
''
'' It produced NOTHING before, which the DIM initialiser then dropped silently:
'' 'dim as sub( ) p = procptr( tests.x.init )' left p uninitialised.
'' Is this argument the bare keyword VIRTUAL -- the second argument of
'' 'procptr( T.m, virtual )'? The parser leaves it as an identifier.
private function IsVirtualArg_( byref c as Ctx, byval a as Tko.NodeId ) as boolean
    if a = Tko.NODE_NONE then return false
    if c.ast->Kind( a ) <> Tko.N_IDENT then return false
    dim as Tko.IdentPayload ptr ip = _
        c.ast->IdentOf( a )
    return (LowerSpelling_( c.ix, *c.names, ip->name ) = "virtual")
end function

'' THE RUNTIME ENTRY POINT BEHIND AN INTRINSIC, for 'procptr( cls )'. Measured, one
'' spelling at a time, by reading what fbc assigns: 'ZZ0$1 = (void*)&fb_Cls'.
'' TWO OF THEM ARE NOT THE ENTRY POINT THE EXPRESSION FORM USES: 'pos( 0 )' is fb_Pos
'' and a bare 'pos' is fb_GetX; 'dir( pattern )' is fb_Dir and 'dir( )' is fb_DirNext.
'' procptr takes the NO-ARGUMENT one in both cases, which is not derivable from the
'' spelling and would have been wrong by a plausible-looking name. The RADIX and
'' MEMORY families answer with the first overload -- fb_HEX_b, not fb_HEX_l -- and
'' 'allocate' with libc's malloc rather than anything in libfb.
private function IntrinsicProcPtrRtl_( byref nm as string ) as RtlId
    select case nm
    case "cls"          : return RTL_CLS
    case "beep"         : return RTL_BEEP
    case "locate"       : return RTL_LOCATE
    case "csrlin"       : return RTL_CSRLIN
    case "pos"          : return RTL_GETX
    case "chdir"        : return RTL_CHDIR
    case "mkdir"        : return RTL_MKDIR
    case "rmdir"        : return RTL_RMDIR
    case "kill"         : return RTL_KILL
    case "curdir"       : return RTL_CURDIR
    case "dir"          : return RTL_DIR_NEXT
    case "eof"          : return RTL_FILE_EOF
    case "loc"          : return RTL_FILE_LOC
    case "lof"          : return RTL_FILE_LOF
    case "freefile"     : return RTL_FILE_FREE
    case "reset"        : return RTL_FILE_RESET
    case "date"         : return RTL_DATE
    case "time"         : return RTL_TIME
    case "timer"        : return RTL_TIMER
    case "randomize"    : return RTL_RANDOMIZE
    case "rnd"          : return RTL_RND
    case "sleep"        : return RTL_SLEEP
    case "environ"      : return RTL_ENVIRON
    case "setenviron"   : return RTL_SETENVIRON
    case "command"      : return RTL_COMMAND
    case "exepath"      : return RTL_EXEPATH
    case "exec"         : return RTL_EXEC
    case "shell"        : return RTL_SHELL
    case "erl"          : return RTL_ERR_LINE
    case "ermn"         : return RTL_ERR_MODNAME
    case "erfn"         : return RTL_ERR_FUNCNAME
    case "threadcreate" : return RTL_THREAD_CREATE
    case "threadwait"   : return RTL_THREAD_WAIT
    case "condcreate"   : return RTL_COND_CREATE
    case "conddestroy"  : return RTL_COND_DESTROY
    case "condsignal"   : return RTL_COND_SIGNAL
    case "condbroadcast": return RTL_COND_BROADCAST
    case "allocate"     : return RTL_MALLOC
    case "callocate"    : return RTL_CALLOC
    case "reallocate"   : return RTL_REALLOC
    case "deallocate"   : return RTL_FREE
    case "mutexcreate"  : return RTL_MUTEX_CREATE
    case "mutexdestroy" : return RTL_MUTEX_DESTROY
    case "mutexlock"    : return RTL_MUTEX_LOCK
    case "mutexunlock"  : return RTL_MUTEX_UNLOCK
    case "hex"          : return RTL_HEX_B
    case "oct"          : return RTL_OCT_B
    case "bin"          : return RTL_BIN_B
    case "space"        : return RTL_STR_SPACE
    case "left"         : return RTL_STR_LEFT
    case "right"        : return RTL_STR_RIGHT
    case "val"          : return RTL_VAL
    case "valint"       : return RTL_VALINT
    case "vallng"       : return RTL_VALLNG
    case "valuint"      : return RTL_VALUINT
    case "valulng"      : return RTL_VALULNG
    case "wbin"         : return RTL_WBIN_B
    case "whex"         : return RTL_WHEX_B
    case "woct"         : return RTL_WOCT_B
    case "wspace"       : return RTL_WSTR_SPACE
    '' 'stop' AND 'system' ARE BOTH fb_End, measured -- the same entry the module
    '' epilogue calls, not one of their own.
    case "stop", "system" : return RTL_END
    case "clear"        : return RTL_MEMSET
    case "bload"        : return RTL_BLOAD
    case "bsave"        : return RTL_BSAVE
    case "chain"        : return RTL_CHAIN
    case "run"          : return RTL_RUN
    case "dylibload"    : return RTL_DYLIB_LOAD
    case "dylibsymbol"  : return RTL_DYLIB_SYMBOL
    case "dylibfree"    : return RTL_DYLIB_FREE
    case "getkey"       : return RTL_GETKEY
    case "inkey"        : return RTL_INKEY
    case "multikey"     : return RTL_MULTIKEY
    case "getmouse"     : return RTL_GETMOUSE
    case "setmouse"     : return RTL_SETMOUSE
    case "out"          : return RTL_OUT
    case "inp"          : return RTL_INP
    case "pcopy"        : return RTL_PCOPY
    case "pmap"         : return RTL_PMAP
    case "pointcoord"   : return RTL_POINTCOORD
    case "screenlist"   : return RTL_SCREENLIST
    case "setdate"      : return RTL_SETDATE
    case "settime"      : return RTL_SETTIME
    case "wait"         : return RTL_WAIT
    case "fre"          : return RTL_FRE
    end select
    return RTL_NONE
end function
#include once "mir/lowerprocptr.tiko"

function FuncAddrOfRtl( byref c as Ctx, byval r as RtlId ) as MirValue
    dim as MirValue none_
    dim as boolean is32 = (c.types->target.pointerBits = 32)
    dim as Tko.InternId nm = c.names->GetString( RtlLinkName( r, is32 ) )
    dim as int32 idx = c.m->OldestFunctionNamed( nm )
    if idx < 0 then
        dim as MirFunction ptr d = c.m->AddFunction( nm, RtlReturn( r, is32 ) )
        d->isDefinition = false
        RtlSignature( d, r, is32, (c.types->target.osKind = Tko.OS_DARWIN) andalso (c.types->target.arch = Tko.ARCH_ARM64) )
        '' THE CONVENTION RIDES ON THE SIGNATURE now, not the name -- on win32 the
        '' emitter spells 'x86_stdcallcc' from it. See RtlCallConv.
        d->callConv = RtlCallConv( r, is32 )
        idx = c.m->functions.Count - 1
    end if
    dim as MirInst fa
    fa.op = cast( uint16, M_FUNC_ADDR )
    fa.ty = cast( uint8, MT_PTR )
    fa.callee = cast( uint32, idx )
    return Emit( c, fa )
end function

'' ANDALSO / ORELSE: the right operand is evaluated only when the left does not
'' already decide the answer. The result is materialised through a slot rather than a
'' phi, which is what keeps this IR phi-free.
function LowerShortCircuit _
    ( byref c as Ctx, byval id as Tko.NodeId, byval bp as Tko.BinaryPayload ptr, _
      byval mt as MirType ) as MirValue

    return LowerShortCircuitParts_( c, bp->lhs, bp->rhs, _
        (cast( Tko.TokenKind, bp->op ) = Tko.KW_ANDALSO), mt )
end function

'' ...from its PIECES, because 'i andalso= e' is the same construct with no binary
'' node to hand over: the target is the left operand and the statement stores the
'' result back into it.
function LowerShortCircuitParts_ _
    ( byref c as Ctx, byval lhsE as Tko.NodeId, byval rhsE as Tko.NodeId, _
      byval isAnd as boolean, byval mt as MirType ) as MirValue

    dim as MirValue v

    '' THE ANSWER LIVES IN A SLOT, because MIR has no phis and the join cannot name
    '' "whichever side ran". It used to return the RIGHT operand's value from the join
    '' -- correct only when the right side actually ran, and undefined on exactly the
    '' path short-circuiting exists for. It verified, because a value is a value.
    ''
    '' fbc does the same thing with a temporary, and NORMALISES the result: measured,
    ''
    ''     r = (a <> 0) andalso (b <> 0)
    ''         if( A == 0 ) goto SHORT;  TMP = -(B != 0);  goto JOIN;
    ''         SHORT: TMP = 0;  JOIN: R = (int32)TMP;
    ''
    '' so the short-circuit constant is 0 for ANDALSO and -1 for ORELSE, and the taken
    '' side contributes its own value, which a comparison has already negated.
    dim as MirType rty = mt
    if (rty = MT_VOID) orelse (rty = MT_AGG) then rty = MT_I32
    dim as int32 slot = NewTempLocal( c, rty, TyWidthBytes_( rty ) )
    if slot < 0 then return v
    dim as MirValue dst
    dst.kind = cast( uint8, MV_LOCAL )
    dst.ty = cast( uint8, MT_PTR )
    dst.id = slot

    dim as MirValue l = LowerExpr( c, lhsE )
    if l.kind = cast( uint8, MV_NONE ) then return v

    dim as int32 rhsB = NewBlock( c, "sc.rhs" )
    dim as int32 shortB = NewBlock( c, "sc.short" )
    dim as int32 joinB = NewBlock( c, "sc.join" )
    if isAnd then
        Terminate( c, MTERM_CONDBR, rhsB, shortB, l )
    else
        Terminate( c, MTERM_CONDBR, shortB, rhsB, l )
    end if

    '' THE RIGHT SIDE'S TEMPORARIES DIE IN THE RIGHT SIDE'S BLOCK, for the reason
    '' LowerIif gives above: the statement-end flush runs in the JOIN, which the
    '' SHORT-CIRCUIT path also reaches, so a temporary the right side never built
    '' was destroyed anyway. 'if c0 andalso (type<C>( )).i' ran one destructor on
    '' unconstructed storage where fbc runs none.
    '' ...and the STRING temporaries too -- see LowerIif: fbc deletes right( )'s wide
    '' temporary inside this branch, and a join-side delete freed a stale pointer.
    c.curBlock = rhsB
    dim as int32 rmark = c.udtTemps.Count
    dim as int32 rsmark = c.strTemps.Count
    dim as int32 rwmark = c.wstrTemps.Count
    dim as MirValue r = LowerExpr( c, rhsE )
    if r.kind <> cast( uint8, MV_NONE ) then
        '' NORMALISED, and it is not optional: measured, fbc writes
        '' 'TMP = -( (int64)vr != 0 )' for the taken side whatever the operand was.
        '' Storing the operand's own value made 'r = 1 andalso 7' come out 7 where
        '' FreeBASIC says -1 -- a wrong answer that lowered, verified and looked
        '' entirely ordinary. When the operand IS a comparison the two agree, which
        '' is why every test written with one passed.
        '' A FLOAT OPERAND COMPARES WITH fcmp. 'CU_ASSERT( (0.0 andalso 0.0) = 0 )'
        '' emitted 'icmp ne double 0.0, 0.0' -- which is not an instruction, so the
        '' module was refused. The CONDITION half of this same operator already used
        '' fcmp; only the normalising test on the taken side did not.
        dim as MirInst nz
        dim as boolean rFlt = IsFloatTy( cast( MirType, r.ty ) )
        nz.op = cast( uint16, iif( rFlt, M_FCMP_NE, M_ICMP_NE ) )
        nz.ty = cast( uint8, MT_I32 )
        nz.a = r
        if rFlt then
            nz.b = ConstFloat( c, 0.0, cast( MirType, r.ty ) )
        else
            nz.b = ConstInt( c, 0, cast( MirType, r.ty ) )
        end if
        dim as MirValue bv = Emit( c, nz )
        if bv.kind <> cast( uint8, MV_NONE ) then
            dim as MirInst ng
            ng.op = cast( uint16, M_NEG )
            ng.ty = cast( uint8, rty )
            ng.a = Coerce( c, bv, rty, false )
            dim as MirValue nv = Emit( c, ng )
            if nv.kind <> cast( uint8, MV_NONE ) then r = nv
        end if
        dim as MirInst st1
        st1.op = cast( uint16, M_STORE )
        st1.ty = cast( uint8, MT_VOID )
        st1.a = dst
        st1.b = Coerce( c, r, rty, false )
        Emit( c, st1 )
    end if
    ReleaseUdtTemps_( c, rmark )
    ReleaseStrTemps_( c, rsmark )
    ReleaseWstrTemps_( c, rwmark )
    Terminate( c, MTERM_BR, joinB, -1, NoVal( ) )

    c.curBlock = shortB
    dim as MirInst st2
    st2.op = cast( uint16, M_STORE )
    st2.ty = cast( uint8, MT_VOID )
    st2.a = dst
    st2.b = ConstInt( c, iif( isAnd, cast( int64, 0 ), cast( int64, -1 ) ), rty )
    Emit( c, st2 )
    Terminate( c, MTERM_BR, joinB, -1, NoVal( ) )

    c.curBlock = joinB
    if r.kind = cast( uint8, MV_NONE ) then return v
    return LowerExprLoad( c, dst, rty )
end function

'' A call, given its PIECES rather than a node: FreeBASIC spells one two ways and both
'' have to reach the same code. 'W( 1, 2 )' is an N_CALL with its arguments in a list;
'' 'W 1, 2' is a STATEMENT whose 'a' is the callee and whose children are the arguments.

'' The BUILT-IN PROCEDURE table and its lowering, split out at the 1500-line cap and
'' INCLUDED here, inside the same namespace. Nothing moved changed in the move.
#include once "mir/lowerbuiltin.tiko"

'' Its TYPE follows the operand too -- '#print typeof( strptr( w ) )' is
'' 'WSTRING * 4 PTR' -- so a narrow answer made 'dim pw as wstring ptr = strptr( w )'
'' an incompatible initialiser as well as an unlowered one.
'' 'varptr( x )' -- see the dispatch site for what fbc emits for each shape.
''
'' NOT sadd: measured, 'sadd( s )' is '*(char**)&S$0' -- the var-length string's
'' DATA pointer -- where 'varptr( s )' is '&S$0', its DESCRIPTOR's address. Two
'' different answers, and only this one is LowerAddr's.
function LowerVarPtrCall_ _
    ( byref c as Ctx, byval id as Tko.NodeId, byref outv as MirValue ) as boolean

    if c.ast->Kind( id ) <> Tko.N_CALL then return false
    dim as Tko.ListPayload ptr cp = _
        c.ast->ListOf( id )
    if cp->count <> 1 then return false
    if cp->target = Tko.NODE_NONE then return false
    if c.ast->Kind( cp->target ) <> Tko.N_IDENT then return false
    dim as Tko.IdentPayload ptr ip = _
        c.ast->IdentOf( cp->target )
    dim as string nm = LowerSpelling_( c.ix, *c.names, ip->name )
    if nm <> "varptr" then return false

    dim as Tko.NodeId a0 = cast( Tko.NodeId, c.ast->ChildSlot( cp->first ) )
    outv = LowerAddr( c, a0 )
    return (outv.kind <> cast( uint8, MV_NONE ))
end function

function LowerStrPtrCall_ _
    ( byref c as Ctx, byval id as Tko.NodeId, byref outv as MirValue ) as boolean

    if c.ast->Kind( id ) <> Tko.N_CALL then return false
    dim as Tko.ListPayload ptr cp = _
        c.ast->ListOf( id )
    if cp->count <> 1 then return false
    if cp->target = Tko.NODE_NONE then return false
    if c.ast->Kind( cp->target ) <> Tko.N_IDENT then return false
    dim as Tko.IdentPayload ptr ip = _
        c.ast->IdentOf( cp->target )
    '' SADD IS THE SAME THING BY ANOTHER NAME. Measured: 'sadd( s )' emits
    '' '*(char**)&S$0' -- the descriptor's DATA POINTER -- byte for byte what
    '' 'strptr( s )' emits, and over a fixed string both give the buffer's address.
    '' It was not implemented at all, so 'mid( *sadd( s ), 1 ) = "0"' declined while
    '' the strptr line beside it in the same corpus file lowered.
    dim as string spnm = LowerSpelling_( c.ix, *c.names, ip->name )
    if (spnm <> "strptr") andalso (spnm <> "sadd") then return false

    dim as Tko.NodeId a0 = cast( Tko.NodeId, c.ast->ChildSlot( cp->first ) )
    if TermIsWide_( c, a0 ) then return WideOperand_( c, a0, outv )

    '' A UDT THAT CASTS TO A ZSTRING IS THE CAST, and the cast's result already IS the
    '' char* this asks for -- measured, 'strptr( u )' emits '_ZN1UcvcEv( &U1$0 )' and
    '' nothing else. ZstrDataOf_ wants a string it can take the data pointer out of and
    '' a UDT is not one, so every use of it declined.
    dim as MirValue ucv
    dim as boolean ucRaw = false
    if UserCastToStr_( c, a0, ucv, ucRaw ) andalso ucRaw then
        outv = ucv
        return true
    end if

    return UStrDataArg_( c, a0, outv ) orelse ZstrDataOf_( c, a0, outv )   '' a ustring's OWN data -- see UStrZstrData_
end function


'' SEEK and COLOR, split out at the 1500-line cap.
#include once "mir/lowerdev.tiko"

function LowerIntrinsicStmt( byref c as Ctx, byval id as Tko.NodeId ) as boolean
    dim as Tko.StmtPayload ptr ip = StmtOf( c, id )
    dim as boolean handled = false
    '' 'threadcall f( a )' AS A STATEMENT is the same call with its handle discarded.
    if ip->op = cast( uint16, Tko.KW_THREADCALL ) then
        dim as MirValue tcv
        handled = LowerThreadCall_( c, id, tcv )
    end if
    if ip->op = cast( uint16, Tko.KW_PRINT ) then handled = LowerPrint( c, id )
    if ip->op = cast( uint16, Tko.KW_SWAP ) then handled = LowerSwap( c, id )
    if ip->op = cast( uint16, Tko.KW_CLOSE ) then handled = LowerClose( c, id )
    if ip->op = cast( uint16, Tko.KW_OPEN ) then handled = LowerOpen_( c, id )
    if ip->op = cast( uint16, Tko.KW_ERROR ) then handled = LowerError( c, id )
    if ip->op = cast( uint16, Tko.KW_ERASE ) then handled = LowerErase( c, id )
    if ip->op = cast( uint16, Tko.KW_WRITE ) then handled = LowerWrite( c, id )
    if ip->op = cast( uint16, Tko.KW_POKE ) then handled = LowerPoke( c, id )
    if ip->op = cast( uint16, Tko.KW_SEEK ) then handled = LowerSeekStmt_( c, id )
    if ip->op = cast( uint16, Tko.KW_COLOR ) then handled = LowerColorStmt_( c, id )
    if ip->op = cast( uint16, Tko.KW_WIDTH ) then handled = LowerWidthStmt_( c, id )
    if ip->op = cast( uint16, Tko.KW_LOCK ) then handled = LowerLockStmt_( c, id, false )
    if ip->op = cast( uint16, Tko.KW_UNLOCK ) then handled = LowerLockStmt_( c, id, true )
    if ip->op = cast( uint16, Tko.KW_NAME ) then handled = LowerNameStmt_( c, id )
    '' 'err = n' -- the WRITE half of the ERR pseudo-variable. The READ is an
    '' ordinary call, through the prelude's alias to fb_ErrorGetNum.
    if ip->op = cast( uint16, Tko.KW_ERR ) then handled = LowerErrSet_( c, id )
    if ip->op = cast( uint16, Tko.KW_LSET ) then handled = LowerLrset( c, id, false )
    if ip->op = cast( uint16, Tko.KW_RSET ) then handled = LowerLrset( c, id, true )
    if ip->op = cast( uint16, Tko.KW_READ ) then handled = LowerRead( c, id )
    if ip->op = cast( uint16, Tko.KW_RESTORE ) then handled = LowerRestore( c, id )
    '' A DATA statement emits no code: its descriptor array was built by the
    '' pre-pass, before anything else was lowered.
    if ip->op = cast( uint16, Tko.KW_DATA ) then handled = (c.dataHead >= 0)
    '' LINE is two unrelated statements sharing a keyword: bit 1 of 'extra' is
    '' LINE INPUT, bit 2 the graphics form, which needs libfbgfx and declines.
    if ip->op = cast( uint16, Tko.KW_LINE ) then
        if (ip->extra and 1) <> 0 then
            handled = LowerLineInput( c, id )      '' every string kind; Check refuses the rest (TKO0967)
        elseif (ip->extra and 2) <> 0 then
            '' The GRAPHICS line. Bit 1 is what tells the two statements apart.
            handled = LowerGfxStmt( c, id )
        end if
    end if
    '' THE GRAPHICS FAMILY, which has its own coordinate grammar and its own
    '' measured defaults -- see lowergfx.tiko.
    select case cast( Tko.TokenKind, ip->op )
    case Tko.KW_PSET, Tko.KW_PRESET, Tko.KW_CIRCLE, Tko.KW_PAINT, _
         Tko.KW_VIEW, Tko.KW_WINDOW, Tko.KW_DRAW, Tko.KW_PALETTE, Tko.KW_SCREEN
        handled = LowerGfxStmt( c, id )
    case Tko.KW_GET, Tko.KW_PUT
        '' GET and PUT share a keyword with the FILE statements, exactly as LINE
        '' does. Bit 1 of 'extra' is the graphics form.
        if (ip->extra and 2) <> 0 then
            handled = LowerGfxStmt( c, id )
        else
            dim as MirValue gv
            handled = LowerFileGetPut( c, id, _
                (ip->op = cast( uint16, Tko.KW_PUT )), gv )
            if handled then EmitRtlErrorCheck_( c, id, gv )     '' -e (T68)
        end if
    end select
    if ip->op = cast( uint16, Tko.KW_INPUT ) then handled = LowerInput( c, id, false )
    '' 'on n goto l1, l2, ...' -- the computed goto; see LowerOnGoto for the
    '' one-based index and the unsigned range test, both measured.
    if ip->op = cast( uint16, Tko.KW_ON ) then
        LowerOnGoto( c, id )
        handled = true
    end if
    '' THE VARARG CURSOR. Builtins, not runtime calls -- see lowercva.tiko.
    if ip->op = cast( uint16, Tko.KW_CVA_START ) then handled = LowerCvaStart( c, id )
    if ip->op = cast( uint16, Tko.KW_CVA_COPY ) then handled = LowerCvaCopy( c, id )
    if ip->op = cast( uint16, Tko.KW_CVA_END ) then handled = LowerCvaEnd( c, id )
    return handled
end function


'' EVERYTHING SPELLED LIKE A CALL THAT IS NOT ONE, in the order it has to be tried:
'' a conversion intrinsic is a keyword with no callee, an 'iif' is a conditional, a
'' type name builds a value, and the graphics and string intrinsics each have their
'' own shape. Only what survives all of them is an actual call.
''
'' Split out of lower.tiko when that file reached the 1500-line cap for the third
'' time. Nothing about it changed in the move.
declare function LowerCall _
    ( byref c as Ctx, byval id as Tko.NodeId, byval mt as MirType ) as MirValue

function LowerCallExpr_ _
    ( byref c as Ctx, byval id as Tko.NodeId, byval mt as MirType ) as MirValue

    dim as MirValue v
    '' A PROCEDURE OF THE PROGRAM'S OWN spelled like a builtin -- see CallsUserProcNamedLikeBuiltin.
    if CallsUserProcNamedLikeBuiltin( c, id ) then return LowerCall( c, id, mt )
    '' A conversion intrinsic is a KEYWORD: the coercion its result asks for. 'trycast' is loweritab.tiko's.
    if LowerTryCast_( c, id, v ) then return v
    if IsConvIntrinsic( c, id ) then return LowerConvIntrinsic( c, id, mt )
    '' 'iif( c, a, b )' is a CONDITIONAL, not a call: only one arm may run.
    dim as MirValue iifv
    if LowerIif( c, id, mt, iifv ) then return iifv
    '' 'T( args )' builds a VALUE of T. The callee is a TYPE, not a procedure, so
    '' the ordinary call path below finds nothing to call.
    dim as MirValue tcv
    if LowerTypeCtorExpr_( c, id, tcv ) then return tcv

    '' 'new T' allocates and constructs; it is not a call to anything named 'new'.
    dim as MirValue nwv
    if LowerNew_( c, id, nwv ) then return nwv
    '' 'procptr( f )' is a function's ADDRESS, not a call to it.
    dim as MirValue ppv
    if LowerProcPtr( c, id, ppv ) then return ppv
    '' 'cva_arg( list, T )' is a builtin over the vararg cursor -- see lowercva.tiko.
    dim as MirValue cav
    if LowerCvaArg( c, id, cav ) then return cav
    '' 'dir( ... )' -- five spellings over two families of runtime entry point.
    dim as MirValue drv
    if LowerDir( c, id, drv ) then return drv
    '' 'bit( v, n )' and its two setters are bit arithmetic, not calls.
    dim as MirValue btv
    if LowerBitOp( c, id, btv ) then return btv
    '' 'peek( [T,] p )' is a LOAD through the pointer -- the read half of POKE.
    dim as MirValue pkv
    if LowerPeek( c, id, pkv ) then return pkv
    '' 'len( x )' is a runtime call for a string and a constant for anything else.
    dim as MirValue lnv : if LowerLen( c, id, lnv ) then return lnv
    if LowerSliceCall( c, id, lnv ) then return lnv   '' 's[lo to hi]', lowerslice.tiko

    '' 'offsetof( T, field )' -- a compile-time integer from the measured layout.
    dim as MirValue oov
    if LowerOffsetOf( c, id, oov ) then return oov
    '' '__FB_QUERY_SYMBOL__( q, sym )' -- a compile-time answer about a SYMBOL rather
    '' than about a value, so there is nothing to emit but the integer.
    dim as MirValue qsv
    if LowerQuerySymbol_( c, id, qsv ) then return qsv
    '' int / fix / frac / abs / sgn / sqr and the transcendentals. A mix of gcc
    '' builtins, runtime calls and a plain floor -- see LowerMathCall_.
    '' 'varptr( x )' IS '@x', for every shape of x. Measured -- fbc emits
    '' '(void*)&I$0' for a scalar, '(void*)&S$0' for a var-length STRING (its
    '' DESCRIPTOR's address, not its data), '(void*)Z$0' for a 'zstring * N', and the
    '' element address for 'varptr( a( 1 ) )'. That is LowerAddr's answer in every case.
    ''
    '' It had NO LOWERING AT ALL -- parsed, typed, and then nothing -- so every use
    '' declined, including 'p = varptr( i )' over a plain local.
    dim as MirValue vpv
    if LowerVarPtrCall_( c, id, vpv ) then return vpv
    dim as MirValue mtv
    if LowerMathCall_( c, id, mtv ) then return mtv
    '' 'asc', 'instr', 'instrrev' and the val family: string intrinsics whose
    '' RESULT IS A NUMBER, so they arrive here rather than through the descriptor
    '' path that hex and trim take.
    dim as MirValue snv
    if LowerStrNumCall_( c, id, snv ) then return snv
    '' 'lbound(a)' / 'ubound(a)' over a DYNAMIC array is a runtime call; over a
    '' fixed one both fold at compile time and never reach here.
    dim as MirValue abv
    if LowerArrayBoundCall( c, id, abv ) then return abv
    '' 'wstr( x )' widens into a wide temporary; 'imagecreate' and 'point' are the
    '' two graphics EXPRESSIONS, keywords that cannot be declared in the prelude.
    dim as MirValue wcv
    if LowerWstrOf( c, id, wcv ) then return wcv
    if LowerGfxExprCall_( c, id, wcv ) then return wcv
    if LowerStrPtrCall_( c, id, wcv ) then return wcv
    if LowerRgbCall_( c, id, wcv ) then return wcv
    '' 'screen( row, col )' -- the console READ, which shares a keyword with the
    '' SCREEN statement and swaps its arguments on the way to fb_ReadXY.
    if LowerScreenFn_( c, id, wcv ) then return wcv
    '' 'name( old, new )' -- the rename, with its result kept.
    if LowerNameFn_( c, id, wcv ) then return wcv
    '' Indexing and calling share a spelling; an array subscript is an address to
    '' load from, not a call to make.
    if IsArrayIndex( c, id ) then
        dim as MirValue addr = LowerArrayIndex( c, id )
        if addr.kind = cast( uint8, MV_NONE ) then return v
        '' THE ELEMENT'S SIZE TRAVELS WITH THE LOAD -- the address is computed, so
        '' nothing else can answer for it. See LowerExprLoad.
        dim as Tko.TypeId ixt = c.info->TypeOf_( id )
        return LowerExprLoad( c, addr, LowerType( ixt, *c.types ), _
                              SizeOfType( c, ixt ) )
    end if
    return LowerCall( c, id, mt )
end function


end namespace
