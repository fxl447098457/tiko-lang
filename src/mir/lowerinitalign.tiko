'' lowerinitalign.tiko -- AlignInitValues_: the leaf each initialiser value starts at.
'' #included by lowerudtlit.tiko, inside its namespace: it uses FlattenUdtFields_ and that
'' unit's other private helpers.

'' THE LEAF EACH VALUE STARTS AT, found by walking the values against the FIELDS rather
'' than flattening both and pairing them by position. Measured on fbc-modern:
''
''     dim as foo a = ( 1, { 2 }, { 5, 6 } )     f1 = 2 0 0, f3 = 5 6
''     dim as Q   q = ( ( 1 ), 3 )               p = ( 1, 0 ), z = 3
''
'' -- a NESTED list fills its own field and pads it, and the next value goes to the next
'' field. Pairing flattened values by position wrote f1 = 2 5 6, f3 = 0 0 and p = ( 1, 3 ),
'' z = 0, silently. A value WITHOUT brackets still flows on into a UDT field's leaves,
'' which fbc also accepts ('type<Outer>( 1, 2, 3 )'). Each field's leaves are read off
'' FlattenUdtFields_'s own offsets, so the two cannot disagree. Any shape this does not
'' model answers false and the caller pairs by position as before.
declare function AlignUdt_ _
    ( byref c as Ctx, byval t as Tko.TypeId, byval leaf0 as int32, byval lst as Tko.NodeId, _
      byref ci as int32, byref vNode as containers.Array( of uint32 ), byref vStart as containers.Array( of uint32 ), _
      byval depth as int32, byval inBase as boolean = false ) as boolean

private function IsBracketed_( byref c as Ctx, byval v as Tko.NodeId ) as boolean
    select case c.ast->Kind( v )
    case Tko.N_TUPLE, Tko.N_PAREN, Tko.N_INITIALIZER : return true
    end select
    return false
end function

private function ListCount_( byref c as Ctx, byval lst as Tko.NodeId ) as int32
    return c.ast->ListOf( lst )->count
end function

private function ListAt_( byref c as Ctx, byval lst as Tko.NodeId, byval i as int32 ) as Tko.NodeId
    return cast( Tko.NodeId, c.ast->ChildSlot( c.ast->ListOf( lst )->first + i ) )
end function

'' ONE UDT-TYPED SLOT -- a field or an element -- at leaf 'start', from list position ci.
private function AlignUdtSlot_ _
    ( byref c as Ctx, byval ut as Tko.TypeId, byval start as int32, byval lst as Tko.NodeId, _
      byref ci as int32, byref vNode as containers.Array( of uint32 ), byref vStart as containers.Array( of uint32 ), _
      byval depth as int32 ) as boolean

    dim as Tko.NodeId v = ListAt_( c, lst, ci )
    if IsBracketed_( c, v ) then
        ci += 1
        dim as int32 sub_ = 0
        if AlignUdt_( c, ut, start, v, sub_, vNode, vStart, depth + 1 ) = false then return false
        return (sub_ >= ListCount_( c, v ))
    end if
    dim as Tko.TypeId vt = c.info->TypeOf_( v )
    if vt <> Tko.TYPE_NONE then
        if c.types->Kind( c.types->Unqualify( vt ) ) = Tko.TK_UDT then
            vNode.Push( cast( uint32, v ) ) : vStart.Push( cast( uint32, start ) )
            ci += 1
            return true
        end if
    end if
    return AlignUdt_( c, ut, start, lst, ci, vNode, vStart, depth + 1 )   '' unbracketed: flows on
end function

private function AlignElem_ _
    ( byref c as Ctx, byval et as Tko.TypeId, byval start as int32, byval lst as Tko.NodeId, _
      byref ci as int32, byref vNode as containers.Array( of uint32 ), byref vStart as containers.Array( of uint32 ), _
      byval depth as int32 ) as boolean

    if (c.types->Kind( et ) = Tko.TK_UDT) andalso (IsStringType( c, et ) = false) then
        return AlignUdtSlot_( c, et, start, lst, ci, vNode, vStart, depth )
    end if
    dim as Tko.NodeId v = ListAt_( c, lst, ci )
    select case c.ast->Kind( v )
    case Tko.N_TUPLE, Tko.N_INITIALIZER : return false
    end select
    vNode.Push( cast( uint32, v ) ) : vStart.Push( cast( uint32, start ) )
    ci += 1
    return true
end function

function AlignUdt_ _
    ( byref c as Ctx, byval t as Tko.TypeId, byval leaf0 as int32, byval lst as Tko.NodeId, _
      byref ci as int32, byref vNode as containers.Array( of uint32 ), byref vStart as containers.Array( of uint32 ), _
      byval depth as int32, byval inBase as boolean = false ) as boolean

    if depth > 8 then return false
    dim as int32 ui = c.udts->Find( t )
    if ui < 0 then return false
    dim as containers.Array( of uint32 ) lo, lty, lft
    if FlattenUdtFields_( c, t, 0, lo, lty, 0, lft, inBase ) = false then return false
    dim as int32 n = ListCount_( c, lst )
    dim as int32 li = 0
    '' WHICH FIELDS TAKE A VALUE AT ALL: a UNION -- named, or anonymous inside the type --
    '' takes ONE, for its FIRST alternative; every later one is skipped. Measured on
    '' fbc-modern (dim/union-init.bas): '( 1, 2, 3 )' over 'a, union { i, d }, c' is a = 1,
    '' i = 2, c = 3; over 'union { a, type { b, c } }, d' '( 1, 2 )' is a = 1, d = 2; and a
    '' field typed as a named union takes one value. The anonymous levels come from each
    '' field symbol's anonDepth / anonOpen / anonUnionMask, as the layout reads them.
    dim as Tko.SymbolId usym = UdtSymOf_( c, t )
    dim as Tko.Symbol ptr us = c.syms->SymbolAt( usym )
    if us = nullptr then return false
    dim as Tko.SymScope ptr usc = c.syms->ScopeAt( us->inner )
    if usc = nullptr then return false
    dim as Tko.SymbolId fcur = usc->firstSym
    dim as boolean isU( 0 to 16 )
    dim as int32 alt( 0 to 16 )
    isU( 0 ) = IsUnionType_( c, t )
    for i as int32 = 0 to c.udts->udts[ui].count - 1
        dim as Tko.UdtField ptr fld = @c.udts->fields[c.udts->udts[ui].first + i]
        dim as Tko.TypeId ft = c.types->Unqualify( fld->type_ )
        dim as int32 fsz = SizeOfType( c, ft )
        '' The i-th FIELD symbol is the i-th laid-out field; a mismatch is not modelled.
        dim as Tko.Symbol ptr fs = nullptr
        while fcur <> Tko.SYMBOL_NONE
            dim as Tko.Symbol ptr cand = c.syms->SymbolAt( fcur )
            fcur = cand->nextInScope
            if cand->kind = cast( uint8, Tko.SYM_FIELD ) then
                fs = cand
                exit while
            end if
        wend
        if (fs = nullptr) orelse (fs->name <> fld->name) then return false
        '' THE BASE THE CONSTRUCTOR BUILDS TAKES VALUES FOR ITS FIELDS, NOT FOR ITS
        '' VPTR -- ON THE BASE CHAIN OF THE TYPE BEING INITIALISED, AND NOWHERE ELSE.
        '' 'extends object' -- and any base with a constructor -- was built by the
        '' prologue before this list runs; FlattenUdtFields_ dropped the vptr's leaves
        '' (same measurement, same reason), so the values for the base's own fields are
        '' paired by walking INTO the base. Without the walk the value fell through to
        '' the whole-object store that overwrote the vptr -- the Dog half of t2_oop,
        '' on win32 and win64 alike. A class reached as an ORDINARY FIELD's type keeps
        '' the original walk: its value is one whole object, not a field list (Map's
        '' ( pairkey, long ) pair is why the flag exists -- measured,
        '' tests/std/generics/container-map). A plain base -- no ctor, no vptr --
        '' fills positionally, as fbc does.
        if ((depth = 0) orelse inBase) andalso (c.udts->baseName <> 0) andalso _
           (fld->name = c.udts->baseName) then
            dim as Tko.TypeId bt = c.types->Unqualify( fld->type_ )
            if (c.types->Kind( bt ) = Tko.TK_UDT) andalso _
               (TypeNeedsInit_( c, bt ) orelse _
                (StructorWithArity( c, StructorOf( c, bt, "__ctor" ), 0 ) <> Tko.SYMBOL_NONE)) then
                dim as int32 a2 = li, b2 = li
                while (b2 < lo.Count) andalso (cast( int32, lo[b2] ) < fld->offset + fsz)
                    b2 += 1
                wend
                if b2 > a2 then
                    if ci >= n then return true   '' the rest takes its defaults
                    if AlignUdt_( c, bt, leaf0 + a2, lst, ci, vNode, vStart, depth + 1, true ) = false then return false
                end if
                li = b2
                continue for
            end if
        end if
        dim as int32 fd = fs->anonDepth
        if fd > 16 then return false
        dim as int32 firstNew = fd - fs->anonOpen + 1
        for lv as int32 = firstNew to fd
            if lv >= 1 then
                isU( lv ) = ((fs->anonUnionMask and cast( uint16, 1 shl (lv - 1) )) <> 0)
                alt( lv ) = 0
            end if
        next
        dim as boolean skipF = false
        for lv as int32 = 0 to fd
            if isU( lv ) then
                if (lv = fd) orelse (lv + 1 >= firstNew) then alt( lv ) += 1
                if alt( lv ) > 1 then skipF = true
            end if
        next
        dim as int32 a = li, b = li
        if skipF = false then
            if (a < lo.Count) andalso (cast( int32, lo[a] ) < fld->offset) then return false
        end if
        while (b < lo.Count) andalso (cast( int32, lo[b] ) < fld->offset + fsz)
            b += 1
        wend
        if b > li then li = b
        if skipF then continue for
        if b = a then continue for
        if ci >= n then return true   '' the rest takes its defaults
        dim as int64 fsn
        dim as int32 fsk = StrSwapKind_( c, ft, fsn )
        if (c.types->Kind( ft ) = Tko.TK_UDT) andalso (IsStringType( c, ft ) = false) then
            if AlignUdtSlot_( c, ft, leaf0 + a, lst, ci, vNode, vStart, depth ) = false then return false
        elseif (c.types->Kind( ft ) = Tko.TK_ARRAY) andalso (c.types->IsDynArray( ft ) = false) andalso _
               (fsk <> 1) andalso (fsk <> 2) andalso (fsk <> 4) then
            if fsk = 3 then return false   '' fbc refuses a 'string * N' field in a list
            dim as Tko.TypeId et = c.types->Unqualify( c.types->Inner( ft ) )
            dim as int32 ne = c.types->ElemCount( ft )
            if (ne <= 0) orelse (((b - a) mod ne) <> 0) then return false
            dim as int32 pe = (b - a) \ ne
            dim as Tko.NodeId v = ListAt_( c, lst, ci )
            if c.ast->Kind( v ) = Tko.N_INITIALIZER then
                ci += 1
                dim as int32 c2 = 0
                for j as int32 = 0 to ne - 1
                    if c2 >= ListCount_( c, v ) then exit for
                    if AlignElem_( c, et, leaf0 + a + j * pe, v, c2, vNode, vStart, depth + 1 ) = false then return false
                next
                if c2 < ListCount_( c, v ) then return false
            else
                for j as int32 = 0 to ne - 1
                    if ci >= n then exit for
                    if AlignElem_( c, et, leaf0 + a + j * pe, lst, ci, vNode, vStart, depth + 1 ) = false then return false
                next
            end if
        else
            dim as Tko.NodeId v = ListAt_( c, lst, ci )
            select case c.ast->Kind( v )
            case Tko.N_TUPLE, Tko.N_INITIALIZER : return false
            end select
            vNode.Push( cast( uint32, v ) ) : vStart.Push( cast( uint32, leaf0 + a ) )
            ci += 1
        end if
    next
    return true
end function

'' ONE DIMENSION'S BRACE LIST at leaf 'base_': the innermost holds elements, every other one
'' a brace list per index. More entries than the dimension holds is not this.
private function AlignDim_ _
    ( byref c as Ctx, byval et as Tko.TypeId, byval d as int32, byval rank as int32, _
      byval ext as int32 ptr, byval strd as int32 ptr, byval base_ as int32, byval lst as Tko.NodeId, _
      byref vNode as containers.Array( of uint32 ), byref vStart as containers.Array( of uint32 ) ) as boolean

    dim as int32 n = ListCount_( c, lst )
    if n > ext[d] then return false
    if d < rank - 1 then
        for j as int32 = 0 to n - 1
            dim as Tko.NodeId sub_ = ListAt_( c, lst, j )
            if c.ast->Kind( sub_ ) <> Tko.N_INITIALIZER then return false
            if AlignDim_( c, et, d + 1, rank, ext, strd, base_ + j * strd[d], sub_, vNode, vStart ) = false then return false
        next
        return true
    end if
    dim as int32 ci = 0
    for j as int32 = 0 to ext[d] - 1
        if ci >= n then exit for
        if AlignElem_( c, et, base_ + j * strd[d], lst, ci, vNode, vStart, 1 ) = false then return false
    next
    return (ci >= n)
end function

'' The whole initialiser: true when every value found its field and none was left over.
function AlignInitValues_ _
    ( byref c as Ctx, byval t as Tko.TypeId, byval init as Tko.NodeId, _
      byref vNode as containers.Array( of uint32 ), byref vStart as containers.Array( of uint32 ) ) as boolean

    if t = Tko.TYPE_NONE then return false
    t = c.types->Unqualify( t )
    '' ...OR A STATIC ARRAY, one element's leaves after another (FoldAggInit_), and each
    '' NESTING LEVEL ONE DIMENSION: '{ ( 1 ), ( 2 ) }' over a two-field UDT is ( 1, 0 ),
    '' ( 2, 0 ), and '{ { { 1, 2, 3 }, { 4, 5, 6 } }, ... }' over 'array( 1 to 3, 1 to 3,
    '' 1 to 4 )' pads every row to four and every plane to three rows. Pairing flattened
    '' values by position shifted them (dim/array_init.bas, a 'static' procedure).
    if c.types->Kind( t ) = Tko.TK_ARRAY then
        if c.types->IsDynArray( t ) then return false
        if c.ast->Kind( init ) <> Tko.N_INITIALIZER then return false
        dim as int32 rank = c.types->types[cast( int32, t )].dims
        if (rank < 1) orelse (rank > 8) then return false
        dim as Tko.TypeId aet = c.types->Unqualify( c.types->Inner( t ) )
        dim as int32 pe = 1
        if (c.types->Kind( aet ) = Tko.TK_UDT) andalso (IsStringType( c, aet ) = false) then
            dim as containers.Array( of uint32 ) po, pty, pft
            if FlattenUdtFields_( c, aet, 0, po, pty, 0, pft ) = false then return false
            pe = po.Count
        elseif LowerType( aet, *c.types ) = MT_AGG then
            return false   '' fixed strings and the like: FixStrArrayImage_ answers those
        end if
        '' THE STRIDE OF EACH DIMENSION, in leaves.
        dim as int32 ext( 0 to 7 ), strd( 0 to 7 )
        for d as int32 = 0 to rank - 1
            dim as boolean k1 = false, k2 = false
            dim as int64 lo = c.types->ArrayBound( t, d, false, k1 )
            dim as int64 hi = c.types->ArrayBound( t, d, true, k2 )
            if (k1 = false) orelse (k2 = false) orelse (hi < lo) then return false
            ext( d ) = cast( int32, hi - lo + 1 )
        next
        strd( rank - 1 ) = pe
        for d as int32 = rank - 2 to 0 step -1
            strd( d ) = strd( d + 1 ) * ext( d + 1 )
        next
        if AlignDim_( c, aet, 0, rank, @ext( 0 ), @strd( 0 ), 0, init, vNode, vStart ) = false then return false
        return (vNode.Count > 0)
    end if
    if c.types->Kind( t ) <> Tko.TK_UDT then return false
    select case c.ast->Kind( init )
    case Tko.N_TUPLE, Tko.N_PAREN
    case else
        return false
    end select
    dim as int32 ci = 0
    if AlignUdt_( c, t, 0, init, ci, vNode, vStart, 0 ) = false then return false
    if ci < ListCount_( c, init ) then return false
    return (vNode.Count > 0)
end function
