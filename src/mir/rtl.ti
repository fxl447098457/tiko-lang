        RTL( RTL_LPRINT_SHORT,         "fb_LPrintShort",          "v",   "lsl"       )
        RTL( RTL_LPRINT_SINGLE,        "fb_LPrintSingle",         "v",   "lfl"       )
        RTL( RTL_LPRINT_STRING,        "fb_LPrintString",         "v",   "lpl"       )
