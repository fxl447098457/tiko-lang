        RTL( RTL_H_STR_DEL_TEMP,        "fb_hStrDelTemp",          "l",   "p"         )
        RTL( RTL_RENAME,                "rename",                  "l",   "pp"        )   '' fb_rename
        RTL( RTL_PATH_RENAME,           "fb_hPathRename",          "l",   "pp"        )   '' NAME (lib/rt/src/fs/upath.tiko)
        RTL( RTL_MEM_MOVE,              "memmove",                 "p",   "ppz"       )   '' fb_MemMove
        RTL( RTL_MEM_COPY,              "memcpy",                  "p",   "ppz"       )   '' fb_MemCopy
        RTL( RTL_DIVDI3,                "__divdi3",                "q",   "qq"        )   '' fb___divdi3
        RTL( RTL_UDIVDI3,               "__udivdi3",               "q",   "qq"        )   '' fb___udivdi3
        RTL( RTL_MODDI3,                "__moddi3",                "q",   "qq"        )   '' fb___moddi3
        RTL( RTL_UMODDI3,               "__umoddi3",               "q",   "qq"        )   '' fb___umoddi3
        RTL( RTL_FIXUNSDFDI,            "__fixunsdfdi",            "q",   "d"         )   '' fb___fixunsdfdi
        RTL( RTL_C_MAIN,                "__main",                  "v",   ""          )   '' fb___main
        RTL( RTL_LEFT_SELF,             "fb_LEFTSELF",             "v",   "pz"        )   '' fb_LeftSelf
    #endmacro

    enum RtlId
        RTL_NONE = 0
        #define RTL( r_id, r_sym, r_ret, r_args ) r_id,
        TKO_RTL_LIST( RTL )
        #undef RTL
        RTL_COUNT
    end enum

    '' The UNDECORATED name. win32 used to decorate it here -- a leading underscore
    '' and, for everything but the variadic entries, a stdcall '@N', measured as
    '' '_fb_StrAssign@20' -- but LLVM's i386 COFF backend applies both decorations
    '' itself from the call's convention, so the bare name is what the IR carries and
    '' RtlCallConv says which one. See RtlLinkName.
    declare function RtlTypeOfLetter _
        ( byref c as string, byval is32 as boolean ) as MirType
    declare function RtlSymbol _
        ( byval r as RtlId, byval is32 as boolean = false ) as string
    declare function RtlLinkName _
        ( byval r as RtlId, byval is32 as boolean ) as string
    '' THE CONVENTION AN RTL ENTRY IS CALLED WITH: cdecl on every 64-bit target
    '' (the conventions collapse there), and on win32 stdcall except the measured
    '' cdecl families. The synthetic declarations of the runtime inventory carry
    '' it, and the emitter spells 'x86_stdcallcc' from it.
    declare function RtlCallConv( byval r as RtlId, byval is32 as boolean ) as uint8
    '' The 'z' letter as a type: the pointer-width signed integer of every RTL
    '' count, index and length tag -- i64 on the 64-bit targets, i32 on win32.
    declare function RtlWordType( byval is32 as boolean ) as MirType
    '' 'is32' is win32: Linux is 64-bit only by decision.
    declare function RtlReturn( byval r as RtlId, byval is32 as boolean ) as MirType
    declare function RtlParams( byval r as RtlId ) as string
    declare function RtlByName( byref nm as string ) as RtlId
    declare function RtlArity( byval r as RtlId ) as int32
    '' Fills a DECLARATION's signature from the runtime inventory. The arity alone used
    '' to be recorded, which is all MIR needed while nothing read a signature; an LLVM
    '' 'declare' needs the types, and the inventory is where they already are.
    '' narrowExt: record each i8/i16 parameter's and result's extension (macos-arm64).
    declare sub RtlSignature _
        ( byval f as MirFunction ptr, byval r as RtlId, byval is32 as boolean, _
          byval narrowExt as boolean )
    declare function RtlParamType _
        ( byval r as RtlId, byval i as int32, byval is32 as boolean ) as MirType

    '' The whole inventory, for --dump-rtl and for the differential against the
    '' signatures fbc emits.
    declare function DumpRtl( byval is32 as boolean ) as string

end namespace

#endif
