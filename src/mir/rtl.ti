'' rtl.ti -- the ONE place that knows the runtime's interface.
''
'' docs/plan/11 section 3: no 'fb_StrAssign' string literal anywhere else in tiko-lang. That
'' buys one place to audit against the runtime, signature checking at MIR construction
'' rather than a crash at run time, and a dumpable inventory that can be diffed
'' against the library's actual exports.
''
'' The signatures were MEASURED, not transcribed. fbc's own rtl-*.bas tables are
'' compiler source and are GPL -- and docs/plan/11 already flags the runtime licence
'' as a prerequisite for release -- so instead 'fbc -r' was used: the C intermediate
'' it leaves DECLARES every runtime function it calls. That is licence-clean and it is
'' better evidence, being what fbc actually emits rather than what a table says.
'' tools/gen/rtl-truth.py regenerates it and checks every name against libfb.a.

#ifndef __TKO_RTL_BI__
#define __TKO_RTL_BI__

#include once "tko.ti"
#include once "mir/mir.ti"

namespace Tko.Mir

    '' RTL( id, symbol, return type, parameter types )
    ''
    '' The parameter spelling is the MIR type letters, so a mismatch at a call site is
    '' a build-time failure rather than a linker error:
    ''   v void   b i8   s i16   l i32   q i64   f f32   d f64   p ptr
    ''   B i8, S i16 -- the runtime's uint8 / uint16: the same MIR type as b / s, but on
    ''   macos-arm64 the caller extends a narrow argument (zeroext for B S, signext for
    ''   b s), and the runtime, compiled by tiko, trusts the upper bits (RtlSignature)
    ''   z POINTER-WIDTH -- 'ssize_t', i64 on win64 and i32 on win32
    ''
    '' 'z' is the reason the return column is a letter too. fb_StrLen returns a length,
    '' which follows the pointer: 'int64' on win64 and 'int32' on win32, measured from
    '' what fbc declares. Only the two PrintLongint entries keep a genuine 'q'.
    ''   '.' marks a VARIADIC tail: a REDIM's bounds are passed as a variable number
    ''   of trailing arguments, so only the fixed prefix can be checked.
    ''
    '' A var-length string is passed as a POINTER TO ITS DESCRIPTOR with a length of
    '' -1; a literal is passed as its bytes with the real length. That convention is
    '' why every string entry takes (ptr, i64) pairs rather than one argument.
    #macro TKO_RTL_LIST( RTL )
        '' The program entry pair. fbc emits these ONLY for the main translation unit:
        '' fb_Init before the module-level body, fb_End after its cleanups.
        RTL( RTL_INIT,              "fb_Init",             "v",   "lpl"   )
        RTL( RTL_END,               "fb_End",              "v",   "l"     )
        '' Same argument shape as fb_StrAssign, but for a DECLARATION with an
        '' initialiser. fbc uses Init there and Assign only for a later store; a local
        '' with no initialiser instead gets its 24-byte descriptor zeroed.
        RTL( RTL_STR_INIT,          "fb_StrInit",          "p",   "pzpzl" )
        RTL( RTL_STR_ASSIGN,        "fb_StrAssign",        "p",   "pzpzl" )
        RTL( RTL_STR_CONCAT_ASSIGN, "fb_StrConcatAssign",  "p",   "pzpzl" )
        RTL( RTL_STR_CONCAT,        "fb_StrConcat",        "p",   "ppzpz"  )
        RTL( RTL_STR_COMPARE,       "fb_StrCompare",       "l",   "pzpz"  )
        RTL( RTL_STR_DELETE,        "fb_StrDelete",        "v",   "p"     )
        '' USTRING -- the UTF-16 flavour, with its OWN descriptor and its own entry
        '' points. Same shapes as the narrow family above, and that symmetry is the
        '' trap: 'dim as ustring v = "x"' lowered to fb_StrInit with a NARROW literal,
        '' so a UTF-16 descriptor held narrow bytes and fb_StrDelete was called on an
        '' FBUSTRING. It compiled, it verified, and it counted as lowered.
        ''
        '' THE LENGTH ARGUMENT IS TAGGED and the tag is not guessable. Measured:
        ''   var-length   -1
        ''   literal      &h8000000000000000 or <character count>, NUL not counted
        ''   'ustring * N'  &h8000000000000000 or (N-1) -- capacity is N-1, as with
        ''                  'zstring * N'
        '' and the trailing int32 is -1 for a FIXED destination, 0 for a var-length one.
        RTL( RTL_USTR_INIT,          "fb_UStrInit",         "p",   "pzpzl" )
        RTL( RTL_USTR_ASSIGN,        "fb_UStrAssign",       "p",   "pzpzl" )
        RTL( RTL_USTR_CONCAT_ASSIGN, "fb_UStrConcatAssign", "p",   "pzpzl" )
        RTL( RTL_USTR_CONCAT,        "fb_UStrConcat",       "p",   "ppzpz" )
        RTL( RTL_USTR_COMPARE,       "fb_UStrCompare",      "l",   "pzpz"  )
        RTL( RTL_USTR_LEN,           "fb_UStrLen",          "z",   "pz"    )
        RTL( RTL_USTR_DELETE,        "fb_UStrDelete",       "v",   "p"     )
        RTL( RTL_PRINT_USTR,         "fb_PrintUStr",        "v",   "lpl"   )
        '' A USTRING NEVER CONVERTS BY COPYING -- it TRANSCODES, and every direction has
        '' its own entry point. Measured from what fbc emits:
        ''
        ''   u = narrow     fb_UStrAssignFromA( u, -1, src, srcLen, 0, FLAG )
        ''   u = wide       fb_WstrToUStr( src ) then the ordinary fb_UStrAssign
        ''   narrow = u     fb_UStrAssignToA( dst, -1, u, -1, 0, -1 )
        ''   wide = u       fb_UStrAssignToW( dst, dstLen, u, -1 )
        ''   u compared     the OTHER side becomes a ustring first, fb_StrToUStr for a
        ''                  narrow operand and fb_WstrToUStr for a wide one
        ''   u + narrow     fb_UStrConcatUA;  narrow + u is fb_UStrConcatAU
        ''
        '' The trailing int32 on the two AssignFrom/To entries is -1 at a DECLARATION and
        '' 0 at a later store -- the same distinction fb_StrInit and fb_StrAssign make by
        '' being different functions. Copying instead of transcoding lowered and verified
        '' and put UTF-8 bytes in a UTF-16 descriptor.
        RTL( RTL_USTR_FROM_A,        "fb_UStrAssignFromA",  "p",   "pzpzll" )
        RTL( RTL_USTR_TO_A,          "fb_UStrAssignToA",    "p",   "pzpzll" )
        RTL( RTL_USTR_TO_W,          "fb_UStrAssignToW",    "p",   "pzpz"   )
        RTL( RTL_STR_TO_USTR,        "fb_StrToUStr",        "p",   "pz"     )
        '' ...and back: a narrow TEMPORARY descriptor out of a ustring, for the entry points
        '' that only have a narrow form. Measured, 'val( u )' is fb_VAL( fb_UStrToStr( &U, -1 ) ).
        RTL( RTL_USTR_TO_STR,        "fb_UStrToStr",        "p",   "pz"     )
        RTL( RTL_WSTR_TO_USTR,       "fb_WstrToUStr",       "p",   "p"      )
        RTL( RTL_USTR_CONCAT_UA,     "fb_UStrConcatUA",     "p",   "ppzpz"  )
        RTL( RTL_USTR_CONCAT_AU,     "fb_UStrConcatAU",     "p",   "ppzpz"  )
        '' FILE GET AND PUT -- the BINARY forms, which are the ones the corpus writes.
        '' Measured: 'get( #f, pos, v )' is 'fb_FileGetLarge( f, pos, &v, sizeof( v ) )'
        '' and returns the error code, so it is an EXPRESSION as well as a statement.
        '' The position is int64 on both targets and the byte count uint64 -- NOT
        '' pointer-sized, which is what 'z' would have made them on win32.
        '' THE NAME ITSELF DIFFERS BY TARGET, which nothing else in this table does:
        '' win64 calls fb_FileGetLarge with a 64-bit position and count, win32 calls
        '' fb_FileGet with 32-bit ones. RtlSymbol answers per target -- see the
        '' override beside it -- and 'z' covers both widths.
        RTL( RTL_FILE_GET,           "fb_FileGetLarge",     "l",   "lzpz"  )
        RTL( RTL_FILE_PUT,           "fb_FilePutLarge",     "l",   "lzpz"  )
        '' ...AND THE REST OF THE FAMILY, each with the same win64/win32 name split:
        '' the position and the count follow the POINTER, so the 'Large' spelling is
        '' win64's and the plain one win32's. RtlSymbol carries the pairs.
        RTL( RTL_FILE_GET_ARRAY,     "fb_FileGetArrayLarge","l",   "lzp"   )
        RTL( RTL_FILE_PUT_ARRAY,     "fb_FilePutArrayLarge","l",   "lzp"   )
        RTL( RTL_FILE_GET_STR,       "fb_FileGetStrLarge",  "l",   "lzpz"  )
        RTL( RTL_FILE_PUT_STR,       "fb_FilePutStrLarge",  "l",   "lzpz"  )
        RTL( RTL_FILE_GET_WSTR,      "fb_FileGetWstrLarge", "l",   "lzpz"  )
        RTL( RTL_FILE_LOCK,          "fb_FileLockLarge",    "l",   "lzz"   )
        RTL( RTL_FILE_UNLOCK,        "fb_FileUnlockLarge",  "l",   "lzz"   )
        RTL( RTL_FILE_SEEK,          "fb_FileSeekLarge",    "l",   "lz"    )
        '' THE FIVE SPECIAL OPEN FORMS. Each is its own entry point and each takes the
        '' same seven arguments fb_FileOpenEncod does -- the trailing char* is the
        '' encoding, passed raw.
        RTL( RTL_FILE_OPEN_COM,      "fb_FileOpenCom",      "l",   "pllllLp" )
        RTL( RTL_FILE_OPEN_CONS,     "fb_FileOpenCons",     "l",   "pllllLp" )
        RTL( RTL_FILE_OPEN_ERR,      "fb_FileOpenErr",      "l",   "pllllLp" )
        RTL( RTL_FILE_OPEN_LPT,      "fb_FileOpenLpt",      "l",   "pllllLp" )
        RTL( RTL_FILE_OPEN_PIPE,     "fb_FileOpenPipe",     "l",   "pllllLp" )
        RTL( RTL_FILE_OPEN_SCRN,     "fb_FileOpenScrn",     "l",   "pllllLp" )
        '' SWAP of two strings. Six arguments, not four: each side is (ptr, length,
        '' flag) where the flag is 0 -- the same shape fb_StrAssign uses plus a trailing
        '' word per operand.
        RTL( RTL_STR_SWAP,          "fb_StrSwap",          "v",   "pzlpzl" )
        RTL( RTL_WSTR_SWAP,         "fb_WstrSwap",         "v",   "pzpz"  )
        '' USTRING, var-length or fixed: (ptr, size) per side, size -1 or the tagged N-1.
        RTL( RTL_USTR_SWAP,         "fb_UStrSwap",         "v",   "pzpz"  )
        '' WIDE STRINGS. A wstring VALUE is always a bare uint16* -- there is no
        '' descriptor type, and no var-length wstring exists at all ('dim as wstring w'
        '' is fbc error 28). So none of this needs a wide analogue of fb_StrInit or of
        '' scope cleanup; only the temporaries these return need fb_WstrDelete.
        ''
        '' The (dst, dstlen) pair takes the declared ELEMENT COUNT, not bytes. Where a
        '' NARROW operand appears it uses the ordinary (void*, len) convention: a
        '' literal passes its byte length INCLUDING the NUL, a descriptor passes -1.
        RTL( RTL_WSTR_ASSIGN,       "fb_WstrAssign",       "p",   "pzp"   )
        RTL( RTL_WSTR_ASSIGN_FROMA, "fb_WstrAssignFromA",  "p",   "pzpz"  )
        RTL( RTL_WSTR_ASSIGN_TOA,   "fb_WstrAssignToA",    "p",   "pzpl"  )
        RTL( RTL_WSTR_ASSIGN_TOA_UTF8, "fb_WstrAssignToAUtf8", "p", "pzpl"  )   '' a wide PATH, as UTF-8
        '' ...AND ITS DECLARATION FORM, which is a DIFFERENT FUNCTION rather than a flag:
        '' 'dim as string c = w & s' is fb_WstrAssignToA_Init from the wide temporary,
        '' the same distinction fb_StrInit and fb_StrAssign make. Without it the whole
        '' shape had nowhere to go and the initialiser was dropped -- 119 declines in
        '' string/concat.bas alone, which is the concatenation matrix.
        RTL( RTL_WSTR_TOA_INIT,     "fb_WstrAssignToA_Init", "p", "pzpz"  )
        RTL( RTL_WSTR_DELETE,       "fb_WstrDelete",       "v",   "p"     )
        RTL( RTL_WSTR_LEN,          "fb_WstrLen",          "z",   "p"     )
        '' A WIDE TEMPORARY, allocated to hold a given number of CHARACTERS. Its result
        '' is a bare uint16* the caller owns and must release with fb_WstrDelete -- the
        '' only wide entry point that allocates, and the reason a wide 'iif' needs a
        '' pointer local where the narrow one needs a descriptor.
        RTL( RTL_WSTR_ALLOC,        "fb_WstrAlloc",        "p",   "z"     )
        '' No lengths, unlike the narrow fb_StrCompare, and an int32 result that fbc
        '' widens before testing. One function covers all six operators.
        RTL( RTL_WSTR_COMPARE,      "fb_WstrCompare",      "l",   "pp"    )
        RTL( RTL_WSTR_CONCAT,       "fb_WstrConcat",       "p",   "pp"    )
        RTL( RTL_WSTR_CONCAT_WA,    "fb_WstrConcatWA",     "p",   "ppz"   )
        RTL( RTL_WSTR_CONCAT_AW,    "fb_WstrConcatAW",     "p",   "pzp"   )
        RTL( RTL_WSTR_CONCAT_ASSIGN,"fb_WstrConcatAssign", "p",   "pzp"   )
        RTL( RTL_PRINT_WSTR,        "fb_PrintWstr",        "v",   "lpl"   )
        '' byte/short widen to int32 and ubyte/ushort to uint32; there are no
        '' per-width entries.
        '' BOOLEAN HAS ITS OWN WIDE RENDERER, exactly as it has its own narrow one:
        '' 'wstr( b )' is 'fb_BoolToWstr( B$0 )' -- measured -- and fb_IntToWstr would
        '' write -1 and 0 where fbc writes "true" and "false".
        RTL( RTL_BOOL_TO_WSTR,      "fb_BoolToWstr",       "p",   "b"     )
        RTL( RTL_INT_TO_WSTR,       "fb_IntToWstr",        "p",   "l"     )
        RTL( RTL_UINT_TO_WSTR,      "fb_UIntToWstr",       "p",   "l"     )
        RTL( RTL_LONGINT_TO_WSTR,   "fb_LongintToWstr",    "p",   "q"     )
        RTL( RTL_ULONGINT_TO_WSTR,  "fb_ULongintToWstr",   "p",   "q"     )
        RTL( RTL_FLOAT_TO_WSTR,     "fb_FloatToWstr",      "p",   "f"     )
        RTL( RTL_DOUBLE_TO_WSTR,    "fb_DoubleToWstr",     "p",   "d"     )
        '' Takes a RAW char*, not a descriptor: fbc dereferences the descriptor's data
        '' field at the call site.
        RTL( RTL_STR_TO_WSTR,       "fb_StrToWstr",        "p",   "p"     )
        RTL( RTL_WSTR_TO_STR,       "fb_WstrToStr",        "p",   "p"     )
        '' The wide substring and trim families. Every one RETURNS A TEMPORARY that
        '' fbc releases with fb_WstrDelete; tiko-lang does not model that lifetime yet, so
        '' each call leaks one -- stated rather than hidden.
        ''
        '' Note the ARGUMENT ORDERS ARE NOT UNIFORM and were measured one by one:
        '' instr takes its start FIRST, instrrev takes it LAST, and 'mid' with no
        '' length passes -1 rather than 0.
        RTL( RTL_WSTR_TRIM,         "fb_WstrTrim",         "p",   "p"     )
        RTL( RTL_WSTR_TRIM_ANY,     "fb_WstrTrimAny",      "p",   "pp"    )
        RTL( RTL_WSTR_TRIM_EX,      "fb_WstrTrimEx",       "p",   "pp"    )
        RTL( RTL_WSTR_LTRIM,        "fb_WstrLTrim",        "p",   "p"     )
        RTL( RTL_WSTR_LTRIM_ANY,    "fb_WstrLTrimAny",     "p",   "pp"    )
        RTL( RTL_WSTR_LTRIM_EX,     "fb_WstrLTrimEx",      "p",   "pp"    )
        RTL( RTL_WSTR_RTRIM,        "fb_WstrRTrim",        "p",   "p"     )
        RTL( RTL_WSTR_RTRIM_ANY,    "fb_WstrRTrimAny",     "p",   "pp"    )
        RTL( RTL_WSTR_RTRIM_EX,     "fb_WstrRTrimEx",      "p",   "pp"    )
        RTL( RTL_WSTR_LEFT,         "fb_WstrLeft",         "p",   "pz"    )
        RTL( RTL_WSTR_RIGHT,        "fb_WstrRight",        "p",   "pz"    )
        RTL( RTL_WSTR_MID,          "fb_WstrMid",          "p",   "pzz"   )
        RTL( RTL_WSTR_UCASE,        "fb_WstrUcase2",       "p",   "pl"    )
        RTL( RTL_WSTR_LCASE,        "fb_WstrLcase2",       "p",   "pl"    )
        RTL( RTL_MEM_SWAP,          "fb_MemSwap",          "v",   "ppz"   )
        RTL( RTL_STR_LEN,           "fb_StrLen",           "z",   "pz"    )
        RTL( RTL_STR_MID,           "fb_StrMid",           "p",   "pzz"   )
        RTL( RTL_STR_LEFT,          "fb_LEFT",             "p",   "pz"    )
        '' The NARROW substring and trim family. Each returns an FBSTRING* the runtime
        '' owns and that fbc NEVER deletes -- unlike the wide family, there is no
        '' lifetime to model here at all.
        ''
        '' The spellings are NOT consistent and were read off fbc one by one: the four
        '' bare forms and LEFT/RIGHT are SHOUTED, while the Ex/Any variants, mid and
        '' the two case entries are mixed-case with a different prefix.
        RTL( RTL_STR_RIGHT,         "fb_RIGHT",            "p",   "pz"    )
        RTL( RTL_STR_TRIM,          "fb_TRIM",             "p",   "p"     )
        RTL( RTL_STR_TRIM_EX,       "fb_TrimEx",           "p",   "pp"    )
        RTL( RTL_STR_TRIM_ANY,      "fb_TrimAny",          "p",   "pp"    )
        RTL( RTL_STR_LTRIM,         "fb_LTRIM",            "p",   "p"     )
        RTL( RTL_STR_LTRIM_EX,      "fb_LTrimEx",          "p",   "pp"    )
        RTL( RTL_STR_LTRIM_ANY,     "fb_LTrimAny",         "p",   "pp"    )
        RTL( RTL_STR_RTRIM,         "fb_RTRIM",            "p",   "p"     )
        RTL( RTL_STR_RTRIM_EX,      "fb_RTrimEx",          "p",   "pp"    )
        RTL( RTL_STR_RTRIM_ANY,     "fb_RTrimAny",         "p",   "pp"    )
        RTL( RTL_STR_UCASE,         "fb_StrUcase2",        "p",   "pl"    )
        RTL( RTL_STR_LCASE,         "fb_StrLcase2",        "p",   "pl"    )

        '' DATA / READ / RESTORE. The DESTINATION TYPE alone picks the entry point;
        '' there is no mask and no channel. INTEGER and UINTEGER are target-dependent
        '' and the inventory cannot say so, so lowering picks between Int and Longint.
        RTL( RTL_DATA_RESTORE,      "fb_DataRestore",      "v",   "p"     )
        RTL( RTL_DATA_READ_STR,     "fb_DataReadStr",      "v",   "pzl"   )
        RTL( RTL_DATA_READ_WSTR,    "fb_DataReadWstr",     "v",   "pz"    )
        RTL( RTL_DATA_READ_BOOL,    "fb_DataReadBool",     "v",   "p"     )
        RTL( RTL_DATA_READ_BYTE,    "fb_DataReadByte",     "v",   "p"     )
        RTL( RTL_DATA_READ_UBYTE,   "fb_DataReadUByte",    "v",   "p"     )
        RTL( RTL_DATA_READ_SHORT,   "fb_DataReadShort",    "v",   "p"     )
        RTL( RTL_DATA_READ_USHORT,  "fb_DataReadUShort",   "v",   "p"     )
        RTL( RTL_DATA_READ_INT,     "fb_DataReadInt",      "v",   "p"     )
        RTL( RTL_DATA_READ_UINT,    "fb_DataReadUInt",     "v",   "p"     )
        RTL( RTL_DATA_READ_LONGINT, "fb_DataReadLongint",  "v",   "p"     )
        RTL( RTL_DATA_READ_ULONGINT,"fb_DataReadULongint", "v",   "p"     )
        RTL( RTL_DATA_READ_SINGLE,  "fb_DataReadSingle",   "v",   "p"     )
        RTL( RTL_DATA_READ_DOUBLE,  "fb_DataReadDouble",   "v",   "p"     )

        '' THE RADIX FAMILY -- hex, oct and bin -- and the two fill entries.
        ''
        '' FOUR WIDTHS EACH, picked by the SIZE of the argument and not by its name:
        '' _b _s _i _l over uint8 uint16 uint32 uint64. A signed argument is CAST to
        '' the unsigned of the same width first, which is why 'hex( -1 )' on a LONG is
        '' FFFFFFFF and not FFFFFFFFFFFFFFFF. INTEGER is 64-bit on win64 and 32-bit on
        '' win32, so the choice is target-dependent and lowering makes it.
        ''
        '' The digit-count form is a DIFFERENT ENTRY POINT, not a defaulted argument,
        '' and its name is mixed-case where the bare one is shouted: fb_HEX_i beside
        '' fb_HEXEx_i. Guessing either spelling from the other would have been wrong.
        RTL( RTL_HEX_B,           "fb_HEX_b",         "p",   "B"     )
        RTL( RTL_HEX_S,           "fb_HEX_s",         "p",   "S"     )
        RTL( RTL_HEX_I,           "fb_HEX_i",         "p",   "l"     )
        RTL( RTL_HEX_L,           "fb_HEX_l",         "p",   "q"     )
        RTL( RTL_HEXEX_B,         "fb_HEXEx_b",       "p",   "Bl"    )
        RTL( RTL_HEXEX_S,         "fb_HEXEx_s",       "p",   "Sl"    )
        RTL( RTL_HEXEX_I,         "fb_HEXEx_i",       "p",   "ll"    )
        RTL( RTL_HEXEX_L,         "fb_HEXEx_l",       "p",   "ql"    )
        RTL( RTL_OCT_B,           "fb_OCT_b",         "p",   "B"     )
        RTL( RTL_OCT_S,           "fb_OCT_s",         "p",   "S"     )
        RTL( RTL_OCT_I,           "fb_OCT_i",         "p",   "l"     )
        RTL( RTL_OCT_L,           "fb_OCT_l",         "p",   "q"     )
        RTL( RTL_OCTEX_B,         "fb_OCTEx_b",       "p",   "Bl"    )
        RTL( RTL_OCTEX_S,         "fb_OCTEx_s",       "p",   "Sl"    )
        RTL( RTL_OCTEX_I,         "fb_OCTEx_i",       "p",   "ll"    )
        RTL( RTL_OCTEX_L,         "fb_OCTEx_l",       "p",   "ql"    )
        RTL( RTL_BIN_B,           "fb_BIN_b",         "p",   "B"     )
        RTL( RTL_BIN_S,           "fb_BIN_s",         "p",   "S"     )
        RTL( RTL_BIN_I,           "fb_BIN_i",         "p",   "l"     )
        RTL( RTL_BIN_L,           "fb_BIN_l",         "p",   "q"     )
        RTL( RTL_BINEX_B,         "fb_BINEx_b",       "p",   "Bl"    )
        RTL( RTL_BINEX_S,         "fb_BINEx_s",       "p",   "Sl"    )
        RTL( RTL_BINEX_I,         "fb_BINEx_i",       "p",   "ll"    )
        RTL( RTL_BINEX_L,         "fb_BINEx_l",       "p",   "ql"    )
        '' AND A POINTER HAS ITS OWN SIX, which is not a width the table above can
        '' express: 'hex( p )' is fb_HEX_p taking the pointer itself, not a 64-bit
        '' integer that happens to be the same size. Measured.
        RTL( RTL_HEX_P,           "fb_HEX_p",         "p",   "p"     )
        RTL( RTL_HEXEX_P,         "fb_HEXEx_p",       "p",   "pl"    )
        RTL( RTL_OCT_P,           "fb_OCT_p",         "p",   "p"     )
        RTL( RTL_OCTEX_P,         "fb_OCTEx_p",       "p",   "pl"    )
        RTL( RTL_BIN_P,           "fb_BIN_p",         "p",   "p"     )
        RTL( RTL_BINEX_P,         "fb_BINEx_p",       "p",   "pl"    )
        '' AND THE WIDE HALF OF ALL THIRTY. 'whex( b )' is fb_WstrHex_b, which is not
        '' the narrow name with a letter changed: the family is spelled WstrHex, in
        '' mixed case, where the narrow one is shouted HEX. Guessing either from the
        '' other would have been wrong, as it was for fb_HEXEx.
        RTL( RTL_WHEX_B,       "fb_WstrHex_b",     "p",   "B"     )
        RTL( RTL_WHEX_S,       "fb_WstrHex_s",     "p",   "S"     )
        RTL( RTL_WHEX_I,       "fb_WstrHex_i",     "p",   "l"     )
        RTL( RTL_WHEX_L,       "fb_WstrHex_l",     "p",   "q"     )
        RTL( RTL_WHEX_P,       "fb_WstrHex_p",     "p",   "p"     )
        RTL( RTL_WHEXEX_B,     "fb_WstrHexEx_b",   "p",   "Bl"    )
        RTL( RTL_WHEXEX_S,     "fb_WstrHexEx_s",   "p",   "Sl"    )
        RTL( RTL_WHEXEX_I,     "fb_WstrHexEx_i",   "p",   "ll"    )
        RTL( RTL_WHEXEX_L,     "fb_WstrHexEx_l",   "p",   "ql"    )
        RTL( RTL_WHEXEX_P,     "fb_WstrHexEx_p",   "p",   "pl"    )
        RTL( RTL_WOCT_B,       "fb_WstrOct_b",     "p",   "B"     )
        RTL( RTL_WOCT_S,       "fb_WstrOct_s",     "p",   "S"     )
        RTL( RTL_WOCT_I,       "fb_WstrOct_i",     "p",   "l"     )
        RTL( RTL_WOCT_L,       "fb_WstrOct_l",     "p",   "q"     )
        RTL( RTL_WOCT_P,       "fb_WstrOct_p",     "p",   "p"     )
        RTL( RTL_WOCTEX_B,     "fb_WstrOctEx_b",   "p",   "Bl"    )
        RTL( RTL_WOCTEX_S,     "fb_WstrOctEx_s",   "p",   "Sl"    )
        RTL( RTL_WOCTEX_I,     "fb_WstrOctEx_i",   "p",   "ll"    )
        RTL( RTL_WOCTEX_L,     "fb_WstrOctEx_l",   "p",   "ql"    )
        RTL( RTL_WOCTEX_P,     "fb_WstrOctEx_p",   "p",   "pl"    )
        RTL( RTL_WBIN_B,       "fb_WstrBin_b",     "p",   "B"     )
        RTL( RTL_WBIN_S,       "fb_WstrBin_s",     "p",   "S"     )
        RTL( RTL_WBIN_I,       "fb_WstrBin_i",     "p",   "l"     )
        RTL( RTL_WBIN_L,       "fb_WstrBin_l",     "p",   "q"     )
        RTL( RTL_WBIN_P,       "fb_WstrBin_p",     "p",   "p"     )
        RTL( RTL_WBINEX_B,     "fb_WstrBinEx_b",   "p",   "Bl"    )
        RTL( RTL_WBINEX_S,     "fb_WstrBinEx_s",   "p",   "Sl"    )
        RTL( RTL_WBINEX_I,     "fb_WstrBinEx_i",   "p",   "ll"    )
        RTL( RTL_WBINEX_L,     "fb_WstrBinEx_l",   "p",   "ql"    )
        RTL( RTL_WBINEX_P,     "fb_WstrBinEx_p",   "p",   "pl"    )
        '' SPACE and STRING. fb_StrFill1 takes a CHARACTER CODE, fb_StrFill2 a
        '' descriptor -- 'string( 4, 65 )' and 'string( 4, "x" )' are two entry
        '' points, and the second wraps its literal in fb_StrAllocTempDescZEx first.
        '' STR -- a number rendered as a string. NARROW TYPES DO NOT GET THEIR OWN
        '' ENTRY POINT the way the radix family does: byte, short and long all widen to
        '' int32 and go through fb_IntToStr, and their unsigned counterparts through
        '' fb_UIntToStr. Only 64-bit, the two floats and BOOLEAN have their own.
        RTL( RTL_STR_BOOLTOSTR,     "fb_BoolToStr",        "p",   "b"     )
        RTL( RTL_STR_INTTOSTR,      "fb_IntToStr",         "p",   "l"     )
        RTL( RTL_STR_UINTTOSTR,     "fb_UIntToStr",        "p",   "l"     )
        RTL( RTL_STR_LONGTOSTR,     "fb_LongintToStr",     "p",   "q"     )
        RTL( RTL_STR_ULONGTOSTR,    "fb_ULongintToStr",    "p",   "q"     )
        RTL( RTL_STR_FLOATTOSTR,    "fb_FloatToStr",       "p",   "f"     )
        RTL( RTL_STR_DBLTOSTR,      "fb_DoubleToStr",      "p",   "d"     )
        '' CHR is VARIADIC and its first argument is the COUNT, not a character:
        '' 'chr( a, b )' is fb_CHR( 2, a, b ). Every character widens to int64.
        RTL( RTL_STR_CHR,           "fb_CHR",              "p",   "l."    )
        '' ...and its WIDE twin, same shape: a COUNT and then that many codes.
        RTL( RTL_WSTR_CHR,          "fb_WstrChr",          "p",   "l."    )
        '' ASC / INSTR / INSTRREV. The default start position is 1 and is passed
        '' EXPLICITLY -- there is no defaulted-argument entry point -- while INSTRREV's
        '' default is -1 and sits at the END of its list rather than the front.
        RTL( RTL_STR_ASC,           "fb_ASC",              "l",   "pz"    )
        RTL( RTL_STR_INSTR,         "fb_StrInstr",         "z",   "zpp"   )
        RTL( RTL_STR_INSTR_ANY,     "fb_StrInstrAny",      "z",   "zpp"   )
        '' INSTRREV'S START IS ITS THIRD ARGUMENT AND IS PASSED LAST -- the opposite of
        '' INSTR, whose start is the first and is passed first. That asymmetry is in
        '' the signatures below and it is measured, not inferred from the family.
        RTL( RTL_STR_INSTR_REV,     "fb_StrInstrRev",      "z",   "ppz"   )
        RTL( RTL_STR_INSTR_REV_ANY, "fb_StrInstrRevAny",   "z",   "ppz"   )
        '' The WIDE half. A wide string is a bare uint16*, so there is no descriptor
        '' anywhere in these -- and the argument ORDER is the narrow family's.
        RTL( RTL_WSTR_INSTR,        "fb_WstrInstr",        "z",   "zpp"   )
        RTL( RTL_WSTR_INSTR_ANY,    "fb_WstrInstrAny",     "z",   "zpp"   )
        RTL( RTL_WSTR_INSTR_REV,    "fb_WstrInstrRev",     "z",   "ppz"   )
        RTL( RTL_WSTR_INSTR_REV_ANY,"fb_WstrInstrRevAny",  "z",   "ppz"   )
        '' VAL and its four typed siblings. Plain VAL returns a DOUBLE whatever it is
        '' assigned to: 'dim as long n = val( s )' is fb_D2I( fb_VAL( &S ) ), and
        '' fb_D2I is a MACRO over __builtin_nearbyint, so the conversion ROUNDS TO
        '' NEAREST and does not truncate. M_NEARBYINT is what Coerce already emits for
        '' a float-to-integer narrowing, so that falls out.
        '' A GENUINE 'q', not a 'z': these four are 64-bit on BOTH targets, where
        '' fb_StrLen and the instr family follow the pointer. Using 'z' put a 32-bit
        '' argument on fb_LongintToStr on win32 -- '_fb_LongintToStr@4' where fbc
        '' decorates it @8 -- and a 32-bit return on fb_VALLNG, which would have
        '' truncated every value it was asked for.
        RTL( RTL_VAL,               "fb_VAL",              "d",   "p"     )
        RTL( RTL_VALLNG,            "fb_VALLNG",           "q",   "p"     )
        RTL( RTL_VALULNG,           "fb_VALULNG",          "q",   "p"     )
        RTL( RTL_VALUINT,           "fb_VALUINT",          "l",   "p"     )
        '' THE MATH INTRINSICS THAT ARE RUNTIME CALLS, and only those: sqrt, sin, cos
        '' and the rest are gcc BUILTINS to fbc and are opcodes here instead.
        ''
        '' The split is not symmetrical and not guessable. 'int( x )' looks like a third
        '' case -- 'fb_D2L( __builtin_floor( X ) )' -- but fb_D2L is a MACRO,
        '' '(int64)__builtin_nearbyint( value )', so it is a floor followed by the
        '' ORDINARY float-to-integer coercion this compiler already emits. 'fix( x )'
        '' beside it really is a runtime call, and 'atan2' is a plain libc call with no
        '' builtin prefix at all. Each was read off fbc's own C.
        ''
        '' SGN RETURNS int32 FROM ALL THREE, including the longint form -- a return
        '' width that does not follow its argument, which symmetry would get wrong.
        RTL( RTL_FIX_DOUBLE,        "fb_FIXDouble",        "d",   "d"     )
        RTL( RTL_FIX_SINGLE,        "fb_FIXSingle",        "f",   "f"     )
        RTL( RTL_FRAC_DOUBLE,       "fb_FRACd",            "d",   "d"     )
        RTL( RTL_FRAC_SINGLE,       "fb_FRACf",            "f",   "f"     )
        RTL( RTL_SGN_LONGINT,       "fb_SGNl",             "l",   "q"     )
        RTL( RTL_SGN_DOUBLE,        "fb_SGNDouble",        "l",   "d"     )
        RTL( RTL_SGN_SINGLE,        "fb_SGNSingle",        "l",   "f"     )
        RTL( RTL_ATAN2,             "atan2",               "d",   "dd"    )
        '' ...AND THE SINGLE ONE IS A DIFFERENT FUNCTION, not the double widened.
        '' Measured: 'atan2( f, f )' over two SINGLEs is 'float vr = atan2f( F, F )',
        '' and its result feeds fb_PrintSingle. Widening to atan2 and narrowing back
        '' rounds twice and is not what fbc computes.
        RTL( RTL_ATAN2F,            "atan2f",              "f",   "ff"    )
        '' '^'. Also a plain libc call, and BOTH OPERANDS BECOME DOUBLES whatever they
        '' were -- 'n ^ n' over two LONGs is 'pow( (double)(int64)N, (double)(int64)N )'.
        RTL( RTL_POW,               "pow",                 "d",   "dd"    )
        '' THE GRAPHICS FAMILY. Coordinates are SINGLES throughout -- fbc passes each
        '' one as a separate 'float', never a struct -- which is the fact a table of
        '' integer-looking arguments would get wrong on both targets at once.
        ''
        '' The measured shape of every call, and every omitted argument's value, is in
        '' docs/language/graphics-abi.md. What matters here is only the signature.
        RTL( RTL_GFX_LINE,          "fb_GfxLine",          "v",   "pffffllll" )
        '' SIX parameters, not five: the trailing one is PRESET-ness, and PRESET is the
        '' same function with -1 there instead of 0.
        RTL( RTL_GFX_PSET,          "fb_GfxPset",          "v",   "pfflll" )
        RTL( RTL_GFX_ELLIPSE,       "fb_GfxEllipse",       "v",   "pffflfffll" )
        RTL( RTL_GFX_PAINT,         "fb_GfxPaint",         "v",   "pffllpll" )
        RTL( RTL_GFX_GET,           "fb_GfxGet",           "l",   "pffffplp" )
        RTL( RTL_GFX_PUT,           "fb_GfxPut",           "l",   "pffpllllllplpp" )
        RTL( RTL_GFX_VIEW,          "fb_GfxView",          "v",   "lllllll" )
        RTL( RTL_GFX_WINDOW,        "fb_GfxWindow",        "v",   "ffffl" )
        RTL( RTL_GFX_DRAW,          "fb_GfxDraw",          "v",   "pp"    )
        RTL( RTL_GFX_PALETTE,       "fb_GfxPalette",       "v",   "llll"  )
        RTL( RTL_GFX_PALETTE_GET,   "fb_GfxPaletteGet",    "v",   "lppp"  )
        RTL( RTL_GFX_PALETTE_USING, "fb_GfxPaletteUsing",  "v",   "p"     )
        '' 'PALETTE GET USING' is its own entry point, not a flag on either half.
        RTL( RTL_GFX_PALETTE_GETUSING, "fb_GfxPaletteGetUsing", "v", "p"  )
        '' AND EACH OF THE THREE HAS A 64-BIT TWIN, chosen by the WIDTH of what it
        '' writes into -- an 'integer' output on win64 takes the 64 form. Measured;
        '' passing an int64* to the 32-bit entry point is what tiko-lang did before.
        RTL( RTL_GFX_PALETTE_GET64, "fb_GfxPaletteGet64",  "v",   "lppp"  )
        RTL( RTL_GFX_PALETTE_USING64, "fb_GfxPaletteUsing64", "v", "p"    )
        RTL( RTL_GFX_PALETTE_GETUSING64, "fb_GfxPaletteGetUsing64", "v", "p" )
        '' Named by the PRELUDE rather than by a lowering, and by PUT's default blender.
        '' Both are in the inventory so the gate compares their signatures like any
        '' other -- an entry point tiko-lang emits and does not check is the shape check-rtl
        '' exists to prevent.
        RTL( RTL_GFX_SCREENRES,     "fb_GfxScreenRes",     "l",   "llllll" )
        '' SCREEN, IMAGECREATE and POINT are KEYWORDS rather than declared
        '' procedures, so they cannot go in the prelude and take entries here.
        RTL( RTL_GFX_SCREEN,        "fb_GfxScreen",        "l",   "lllll" )
        RTL( RTL_GFX_IMAGECREATE,   "fb_GfxImageCreate",   "p",   "lllll" )
        RTL( RTL_GFX_POINT,         "fb_GfxPoint",         "l",   "pff"   )
        '' THE PUT BLENDERS. One per mode, all the same shape, and each one is the
        '' pointer fbc passes in the eleventh argument of fb_GfxPut. They are the only
        '' members of the graphics family that are CDECL on win32 -- see rtl.tiko.
        RTL( RTL_GFX_PUT_TRANS,     "fb_hPutTrans",        "v",   "pplllllpp" )
        RTL( RTL_GFX_PUT_PSET,      "fb_hPutPSet",         "v",   "pplllllpp" )
        RTL( RTL_GFX_PUT_PRESET,    "fb_hPutPReset",       "v",   "pplllllpp" )
        RTL( RTL_GFX_PUT_AND,       "fb_hPutAnd",          "v",   "pplllllpp" )
        RTL( RTL_GFX_PUT_OR,        "fb_hPutOr",           "v",   "pplllllpp" )
        RTL( RTL_GFX_PUT_XOR,       "fb_hPutXor",          "v",   "pplllllpp" )
        RTL( RTL_GFX_PUT_ALPHA,     "fb_hPutAlpha",        "v",   "pplllllpp" )
        RTL( RTL_GFX_PUT_BLEND,     "fb_hPutBlend",        "v",   "pplllllpp" )
        RTL( RTL_GFX_PUT_CUSTOM,    "fb_hPutCustom",       "v",   "pplllllpp" )
        RTL( RTL_STR_SPACE,         "fb_SPACE",            "p",   "z"     )
        RTL( RTL_STR_FILL1,         "fb_StrFill1",         "p",   "zl"    )
        RTL( RTL_STR_FILL2,         "fb_StrFill2",         "p",   "zp"    )
        '' ...and the WIDE half, which yields a bare uint16* rather than a descriptor.
        RTL( RTL_WSTR_FILL1,        "fb_WstrFill1",        "p",   "zl"    )
        RTL( RTL_WSTR_FILL2,        "fb_WstrFill2",        "p",   "zp"    )

        '' A FIXED-LENGTH string borrowed as a descriptor. Its own entry point, taking
        '' the TAGGED length -- 'fb_StrAllocTempDescF( A, -9223372036854775776ll )' --
        '' where a zstring uses the Z form and strlen's, and a var-length string needs
        '' no wrapper at all. Three flavours, three answers.
        RTL( RTL_STR_TEMPF,         "fb_StrAllocTempDescF", "p",   "pz"    )
        RTL( RTL_STR_TEMPZ,         "fb_StrAllocTempDescZEx", "p",  "pz"  )
        '' The same thing without a length: a NUL-terminated char* whose length the
        '' runtime works out. That is what a ZSTRING destination borrows for LSET.
        RTL( RTL_STR_TEMPZ_NOLEN,   "fb_StrAllocTempDescZ", "p",   "p"     )
        '' A STRING RESULT. fbc builds the value in a local descriptor and hands the
        '' runtime that descriptor on the way out; what the function actually returns
        '' is the POINTER this gives back, not the descriptor itself.
        RTL( RTL_STR_TEMP_RESULT,   "fb_StrAllocTempResult", "p",   "p"     )
        RTL( RTL_USTR_TEMP_RESULT,  "fb_UStrAllocTempResult", "p",  "p"     )
        '' THE USTRING INTRINSIC FAMILY. Each takes its descriptor as a
        '' (pointer, length) pair where the narrow twin takes a bare descriptor
        '' -- a ustring may be FIXED-LENGTH and the length is what says so.
        '' Signatures measured from what fbc emits, not transcribed.
        RTL( RTL_USTR_UCASE,        "fb_UStrUcase",        "p",   "pz"    )
        RTL( RTL_USTR_LCASE,        "fb_UStrLcase",        "p",   "pz"    )
        RTL( RTL_USTR_TRIM,         "fb_UStrTrim",         "p",   "pz"    )
        RTL( RTL_USTR_LTRIM,        "fb_UStrLTrim",        "p",   "pz"    )
        RTL( RTL_USTR_RTRIM,        "fb_UStrRTrim",        "p",   "pz"    )
        '' THE 'any' FORMS, which DO exist -- measured from fbc's C for 'trim( s, any !" \t" )':
        '' 'fb_UStrTrimAny( (void*)S$1, -1ll, L" \t", &h8000000000000002 )'. Declined instead,
        '' every 'trim( f[0], any " " )' in tracks' ticker loader left its field empty.
        RTL( RTL_USTR_TRIM_ANY,     "fb_UStrTrimAny",      "p",   "pzpz"  )
        RTL( RTL_USTR_LTRIM_ANY,    "fb_UStrLTrimAny",     "p",   "pzpz"  )
        RTL( RTL_USTR_RTRIM_ANY,    "fb_UStrRTrimAny",     "p",   "pzpz"  )
        '' ...AND THE PATTERN FORMS: a second argument WITHOUT 'any' strips that whole
        '' SUBSTRING. Measured, 'rtrim( u, chr( 32 ) )' is 'fb_UStrRTrimEx( (void*)&U$0,
        '' -1ll, L" ", &h8000000000000001 )'. fbx's fbxOpenFileDialog writes it.
        RTL( RTL_USTR_TRIM_EX,      "fb_UStrTrimEx",       "p",   "pzpz"  )
        RTL( RTL_USTR_LTRIM_EX,     "fb_UStrLTrimEx",      "p",   "pzpz"  )
        RTL( RTL_USTR_RTRIM_EX,     "fb_UStrRTrimEx",      "p",   "pzpz"  )
        RTL( RTL_USTR_MID,          "fb_UStrMid",          "p",   "pzzz"  )
        RTL( RTL_USTR_LEFT,         "fb_UStrLeftD",        "p",   "pz"    )
        RTL( RTL_USTR_RIGHT,        "fb_UStrRightD",       "p",   "pz"    )
        RTL( RTL_USTR_INSTR,        "fb_UStrInstr",        "z",   "zpzpz" )
        RTL( RTL_USTR_INSTR_REV,    "fb_UStrInstrRev",     "z",   "pzpzz" )
        '' THE 'any' FORMS, which DO exist -- measured, fbc emits 'fb_UStrInstrAny( 2, &U,
        '' -1, L"ab", <tag> )' for 'instr( 2, u, any "ab" )', and tiko-rt defines both in
        '' ustr/search.tiko. The lowering declined instead, believing there were none.
        RTL( RTL_USTR_INSTR_ANY,    "fb_UStrInstrAny",     "z",   "zpzpz" )
        RTL( RTL_USTR_INSTR_REV_ANY, "fb_UStrInstrRevAny", "z",   "pzpzz" )
        RTL( RTL_USTR_ASSIGN_MID,   "fb_UStrAssignMid",    "v",   "pzzzpz" )
        RTL( RTL_VALINT,            "fb_VALINT",           "l",   "p"     )
        '' THE WIDE HALF of the VAL family. Same five shapes, a bare uint16* instead of
        '' a descriptor, and the RESULT WIDTHS are the narrow family's -- fb_WstrValInt
        '' is int32 on both targets, like fb_VALINT.
        '' ASC over a wide operand, with its own entry point like the val family:
        '' 'fb_WstrAsc( (uint16*)W$0, 1ll )', measured.
        RTL( RTL_WSTR_ASC,          "fb_WstrAsc",          "l",   "pz"    )
        RTL( RTL_WSTR_VAL,          "fb_WstrVal",          "d",   "p"     )
        RTL( RTL_WSTR_VALINT,       "fb_WstrValInt",       "l",   "p"     )
        RTL( RTL_WSTR_VALUINT,      "fb_WstrValUInt",      "l",   "p"     )
        RTL( RTL_WSTR_VALLNG,       "fb_WstrValLng",       "q",   "p"     )
        RTL( RTL_WSTR_VALULNG,      "fb_WstrValULng",      "q",   "p"     )
        '' PRINT has NO generic entry point: every scalar type has its own, and the
        '' third argument is a SEPARATOR MASK -- 0 nothing, 1 newline, 2 tab --
        '' describing what follows that item. A POINTER has no entry of its own and
        '' goes through fb_PrintULongint.
        RTL( RTL_PRINT_STRING,      "fb_PrintString",      "v",   "lpl"   )
        RTL( RTL_PRINT_VOID,        "fb_PrintVoid",        "v",   "ll"    )
        RTL( RTL_PRINT_BYTE,        "fb_PrintByte",        "v",   "lbl"   )
        RTL( RTL_PRINT_UBYTE,       "fb_PrintUByte",       "v",   "lBl"   )
        RTL( RTL_PRINT_SHORT,       "fb_PrintShort",       "v",   "lsl"   )
        RTL( RTL_PRINT_USHORT,      "fb_PrintUShort",      "v",   "lSl"   )
        RTL( RTL_PRINT_INT,         "fb_PrintInt",         "v",   "lll"   )
        RTL( RTL_PRINT_UINT,        "fb_PrintUInt",        "v",   "lll"   )
        RTL( RTL_PRINT_LONGINT,     "fb_PrintLongint",     "v",   "lql"   )
        RTL( RTL_PRINT_ULONGINT,    "fb_PrintULongint",    "v",   "lql"   )
        RTL( RTL_PRINT_SINGLE,      "fb_PrintSingle",      "v",   "lfl"   )
        RTL( RTL_PRINT_DOUBLE,      "fb_PrintDouble",      "v",   "ldl"   )
        RTL( RTL_PRINT_BOOL,        "fb_PrintBool",        "v",   "lbl"   )

        '' WRITE is one-to-one with PRINT minus SPC, TAB and USING. Its only separator
        '' is ',' -- 'write s;' is fbc error 3 -- so its masks are only 2 and 1.
        RTL( RTL_WRITE_VOID,        "fb_WriteVoid",        "v",   "ll"    )
        RTL( RTL_WRITE_BOOL,        "fb_WriteBool",        "v",   "lbl"   )
        RTL( RTL_WRITE_BYTE,        "fb_WriteByte",        "v",   "lbl"   )
        RTL( RTL_WRITE_UBYTE,       "fb_WriteUByte",       "v",   "lBl"   )
        RTL( RTL_WRITE_SHORT,       "fb_WriteShort",       "v",   "lsl"   )
        RTL( RTL_WRITE_USHORT,      "fb_WriteUShort",      "v",   "lSl"   )
        RTL( RTL_WRITE_INT,         "fb_WriteInt",         "v",   "lll"   )
        RTL( RTL_WRITE_UINT,        "fb_WriteUInt",        "v",   "lll"   )
        RTL( RTL_WRITE_LONGINT,     "fb_WriteLongint",     "v",   "lql"   )
        RTL( RTL_WRITE_ULONGINT,    "fb_WriteULongint",    "v",   "lql"   )
        RTL( RTL_WRITE_SINGLE,      "fb_WriteSingle",      "v",   "lfl"   )
        RTL( RTL_WRITE_DOUBLE,      "fb_WriteDouble",      "v",   "ldl"   )
        RTL( RTL_WRITE_STRING,      "fb_WriteString",      "v",   "lpl"   )
        RTL( RTL_WRITE_WSTR,        "fb_WriteWstr",        "v",   "lpl"   )
        RTL( RTL_WRITE_USTR,        "fb_WriteUStr",        "v",   "lpl"   )

        '' LSET and RSET pad or truncate a string INTO a destination that already has
        '' storage. Both take DESCRIPTORS; a zstring destination borrows a temporary
        '' one and a wide destination has its own pair of entries.
        RTL( RTL_STR_LSET,          "fb_StrLset",          "v",   "pp"    )
        RTL( RTL_STR_RSET,          "fb_StrRset",          "v",   "pp"    )
        '' A 'string * N' DESTINATION takes its BYTES and its TAGGED length rather than
        '' a descriptor -- 'fb_StrLsetANA( F1, -9223372036854775800ll, S2 )' on win64
        '' and the same shape with an int32 length on win32.
        RTL( RTL_STR_LSET_ANA,      "fb_StrLsetANA",       "v",   "pzp"   )
        RTL( RTL_STR_RSET_ANA,      "fb_StrRsetANA",       "v",   "pzp"   )
        RTL( RTL_WSTR_LSET,         "fb_WstrLset",         "v",   "pp"    )
        RTL( RTL_WSTR_RSET,         "fb_WstrRset",         "v",   "pp"    )
        '' A USTRING DESTINATION takes FOUR arguments -- (bytes, tagged length, source
        '' descriptor, source length) -- and its source is always a freshly transcoded
        '' FBUSTRING with length -1, never the raw operand. Measured:
        '' 'fb_UStrLset( (void*)US1, -9223372036854775759ll, (void*)vr$0, -1ll )'.
        '' ASC OF A USTRING, measured from fbc's C: 'fb_UStrAsc( (void*)H$1, -1ll, 2ll )' --
        '' descriptor, length, position. The narrow fb_ASC read UTF-16 as bytes: 0 for 't'.
        RTL( RTL_USTR_ASC,          "fb_UStrAsc",          "l",   "pzz"   )
        RTL( RTL_USTR_LSET,         "fb_UStrLset",         "v",   "pzpz"  )
        RTL( RTL_USTR_RSET,         "fb_UStrRset",         "v",   "pzpz"  )
        '' ARRAY DESCRIPTOR routines. Only the ones a FIXED array needs are here; the
        '' four variadic Redim* entries wait until dynamic arrays are modelled, and
        '' they are the only array routines that are CDECL on win32.
        RTL( RTL_ARRAY_CLEAR,       "fb_ArrayClear",       "l",   "p"     )
        RTL( RTL_ARRAY_CLEAR_OBJ,   "fb_ArrayClearObj",    "l",   "ppp"   )
        RTL( RTL_ARRAY_DESTRUCT_STR,"fb_ArrayDestructStr", "v",   "p"     )
        RTL( RTL_ARRAY_DESTRUCT_USTR,"fb_ArrayDestructUStr","v",  "p"     )
        RTL( RTL_ARRAY_DESTRUCT_OBJ,"fb_ArrayDestructObj", "v",   "pp"    )
        RTL( RTL_ARRAY_ERASE_OBJ,   "fb_ArrayEraseObj",    "l",   "ppp"   )
        RTL( RTL_ARRAY_STR_ERASE,   "fb_ArrayStrErase",    "v",   "p"     )
        RTL( RTL_ARRAY_USTR_ERASE,  "fb_ArrayUStrErase",   "v",   "p"     )
        RTL( RTL_ARRAY_LBOUND,      "fb_ArrayLBound",      "z",   "pz"    )
        RTL( RTL_ARRAY_UBOUND,      "fb_ArrayUBound",      "z",   "pz"    )
        '' SPC and TAB take NO MASK, so 'print spc(n);' emits one call and nothing
        '' else -- no newline, no fb_PrintVoid. Note the argument widths: SPC's count
        '' is ssize (64-bit on win64, 32 on win32) and TAB's is int32 on BOTH. That
        '' asymmetry is measured, not a transcription slip.
        RTL( RTL_PRINT_SPC,         "fb_PrintSPC",         "v",   "lz"    )
        RTL( RTL_PRINT_TAB,         "fb_PrintTab",         "v",   "ll"    )

        '' PRINT USING. Init takes ONLY the format descriptor -- no channel -- while
        '' every item call and End take the channel first. Unlike PRINT there is no
        '' per-width entry point: every integral type widens to 64 bits.
        RTL( RTL_USING_INIT,        "fb_PrintUsingInit",   "l",   "p"     )
        RTL( RTL_USING_STR,         "fb_PrintUsingStr",    "l",   "lpl"   )
        RTL( RTL_USING_WSTR,        "fb_PrintUsingWstr",   "l",   "lpl"   )
        RTL( RTL_USING_USTR,        "fb_PrintUsingUStr",   "l",   "lpl"   )
        RTL( RTL_USING_SINGLE,      "fb_PrintUsingSingle", "l",   "lfl"   )
        RTL( RTL_USING_DOUBLE,      "fb_PrintUsingDouble", "l",   "ldl"   )
        RTL( RTL_USING_LONGINT,     "fb_PrintUsingLongint","l",   "lql"   )
        RTL( RTL_USING_ULONGINT,    "fb_PrintUsingULongint","l",  "lql"   )
        RTL( RTL_USING_BOOLEAN,     "fb_PrintUsingBoolean","l",   "lbl"   )
        RTL( RTL_USING_END,         "fb_PrintUsingEnd",    "l",   "l"     )
        RTL( RTL_ARRAY_ERASE,       "fb_ArrayErase",       "l",   "p"     )
        RTL( RTL_ARRAY_REDIM,       "fb_ArrayRedimEx",     "l",   "pzllz." )
        RTL( RTL_ARRAY_REDIM_PRESV, "fb_ArrayRedimPresvEx", "l",  "pzllz." )
        '' The Obj forms take a CONSTRUCTOR and a DESTRUCTOR pointer where the Ex
        '' forms take two integers. Which pair fbc uses is decided by whether the
        '' element type has either -- IMPLICIT ONES INCLUDED, so a POD UDT takes Ex
        '' and a UDT holding a string takes Obj.
        RTL( RTL_ARRAY_REDIM_OBJ,   "fb_ArrayRedimObj",    "l",   "pzppz." )
        RTL( RTL_ARRAY_REDIM_PRESV_OBJ, "fb_ArrayRedimPresvObj", "l", "pzppz." )
        RTL( RTL_FILE_OPEN,         "fb_FileOpen",         "l",   "pllllL" )
        '' The ENCODING form is a DIFFERENT ENTRY POINT, not an extra integer: the
        '' encoding is a char* passed through raw and unvalidated -- fbc compiles
        '' 'encoding "bogus"'.
        RTL( RTL_FILE_OPEN_ENCOD,   "fb_FileOpenEncod",    "l",   "pllllLp" )
        RTL( RTL_FILE_CLOSE,        "fb_FileClose",        "l",   "l"     )
        RTL( RTL_FILE_CLOSEALL,     "fb_FileCloseAll",     "l",   ""      )
        '' Returns the ADDRESS to jump to when a handler is installed, which is why its
        '' return type is a pointer and not void. tiko-lang installs none -- ON ERROR is not
        '' implemented -- so the call never returns and the block ends unreachable.
        RTL( RTL_ERROR_THROW,       "fb_ErrorThrowEx",     "p",   "llppp" )
        '' LIBC, not the FB runtime, and named exactly that: fbc emits a plain
        '' 'free( p )' for DELETE rather than routing it through fb_*. It is cdecl on
        '' every target, so RtlLinkName must not decorate it either.
        RTL( RTL_FREE,              "free",                "v",   "p"     )
        '' The rest of libc's allocator, reached through FreeBASIC's own built-in
        '' procedures: 'allocate' is malloc, 'callocate' calloc, 'reallocate' realloc.
        '' 'callocate( n )' with one argument passes an element size of 1.
        RTL( RTL_MALLOC,            "malloc",              "p",   "z"     )
        RTL( RTL_CALLOC,            "calloc",              "p",   "zz"    )
        RTL( RTL_REALLOC,           "realloc",             "p",   "pz"    )
        '' 'clear dst, value, bytes' is libc memset. Measured: fbc emits
        '' 'memset( (void*)A, 0, 16ull )' for the general form.
        RTL( RTL_MEMSET,            "memset",              "p",   "plz"   )
        '' A STATIC LOCAL OBJECT'S DESTRUCTOR is registered with libc's atexit, not with
        '' anything in libfb: fbc emits 'atexit( (void*)&LABEL$8 )' beside the guarded
        '' constructor call and defines the thunk itself. Measured -- 'int32 atexit(
        '' void* );' -- and cdecl on win32 like the rest of libc.
        RTL( RTL_ATEXIT,            "atexit",              "l",   "p"     )
        '' CVx / MKx -- a number's BYTES as a string and back. Every width has its own
        '' entry point and the pair is NOT symmetric: there is no fb_CVI at all, so
        '' 'cvi' is fb_CVLONGINT on win64 and fb_CVL on win32 -- it follows the
        '' INTEGER width -- while fb_MKI does exist on both and its parameter follows
        '' that same width, which is what 'z' says here.
        RTL( RTL_CVD,               "fb_CVD",              "d",   "p"     )
        RTL( RTL_CVS,               "fb_CVS",              "f",   "p"     )
        RTL( RTL_CVSHORT,           "fb_CVSHORT",          "s",   "p"     )
        RTL( RTL_CVL,               "fb_CVL",              "l",   "p"     )
        RTL( RTL_CVLONGINT,         "fb_CVLONGINT",        "q",   "p"     )
        RTL( RTL_MKD,               "fb_MKD",              "p",   "d"     )
        RTL( RTL_MKS,               "fb_MKS",              "p",   "f"     )
        RTL( RTL_MKSHORT,           "fb_MKSHORT",          "p",   "s"     )
        RTL( RTL_MKI,               "fb_MKI",              "p",   "z"     )
        RTL( RTL_MKL,               "fb_MKL",              "p",   "l"     )
        RTL( RTL_MKLONGINT,         "fb_MKLONGINT",        "p",   "q"     )
        '' Mutexes. All four are ordinary stdcall entries on win32.
        RTL( RTL_MUTEX_CREATE,      "fb_MutexCreate",      "p",   ""      )
        RTL( RTL_MUTEX_DESTROY,     "fb_MutexDestroy",     "v",   "p"     )
        RTL( RTL_MUTEX_LOCK,        "fb_MutexLock",        "v",   "p"     )
        RTL( RTL_MUTEX_UNLOCK,      "fb_MutexUnlock",      "v",   "p"     )
        '' THE CONSOLE, THE FILESYSTEM, THE CLOCK, THE ENVIRONMENT AND THE THREAD PAIR.
        '' None of these statements is lowered yet. The inventory is measured first
        '' because warnings/rtl-prototypes.bas takes the ADDRESS of each, and a name
        '' tiko does not know declines at the procptr whatever the statement does --
        '' 224 statements in that one file.
        ''
        '' Every signature below is from what fbc DECLARES for a probe that uses the
        '' statement, on both targets, and every name is present in libfb.a.
        '' 'z' rather than 'q' wherever the width follows the pointer: fb_StrAssignMid
        '' takes int64 on win64 and int32 on win32, while fb_FileTell returns int64 on
        '' BOTH and keeps its 'q'.
        RTL( RTL_BEEP,              "fb_Beep",             "v",   ""      )
        RTL( RTL_CLS,               "fb_Cls",              "v",   "l"     )
        RTL( RTL_LOCATE,            "fb_Locate",           "l",   "lllll" )
        RTL( RTL_COLOR,             "fb_Color",            "l",   "lll"   )
        RTL( RTL_WIDTH,             "fb_Width",            "l",   "ll"    )
        RTL( RTL_CONSOLE_VIEW,      "fb_ConsoleView",      "l",   "ll"    )
        '' THE NO-ARGUMENT SPELLINGS ARE DIFFERENT ENTRY POINTS. 'pos( 0 )' is
        '' fb_Pos and a bare 'pos' is fb_GetX; 'dir( pattern )' is fb_Dir and a bare
        '' 'dir( )' is fb_DirNext, which continues the walk the first one started.
        RTL( RTL_POS,               "fb_Pos",              "l",   "l"     )
        RTL( RTL_GETX,              "fb_GetX",             "l",   ""      )
        RTL( RTL_CSRLIN,            "fb_GetY",             "l",   ""      )
        RTL( RTL_CHDIR,             "fb_ChDir",            "l",   "p"     )
        RTL( RTL_MKDIR,             "fb_MkDir",            "l",   "p"     )
        RTL( RTL_RMDIR,             "fb_RmDir",            "l",   "p"     )
        RTL( RTL_KILL,              "fb_FileKill",         "l",   "p"     )
        RTL( RTL_CURDIR,            "fb_CurDir",           "p",   ""      )
        '' DIR's third argument is an OUT parameter -- the attribute of what it found.
        RTL( RTL_DIR,               "fb_Dir",              "p",   "plp"   )
        '' ...and its WIDTH picks the entry point: a 4-byte out target takes fb_Dir
        '' and an 8-byte one fb_Dir64, which are separate symbols in libfb and not a
        '' cast of the same one. Measured; 'integer' is 8 bytes on win64, so the plain
        '' spelling takes the 64 form there.
        RTL( RTL_DIR64,             "fb_Dir64",            "p",   "plp"   )
        RTL( RTL_DIR_NEXT,          "fb_DirNext",          "p",   "p"     )
        RTL( RTL_DIR_NEXT64,        "fb_DirNext64",        "p",   "p"     )
        RTL( RTL_WSTR_SPACE,        "fb_WstrSpace",        "p",   "z"     )
        RTL( RTL_FILE_EOF,          "fb_FileEof",          "l",   "l"     )
        RTL( RTL_FILE_FREE,         "fb_FileFree",         "l",   ""      )
        RTL( RTL_FILE_LOC,          "fb_FileLocation",     "q",   "l"     )
        RTL( RTL_FILE_LOF,          "fb_FileSize",         "q",   "l"     )
        RTL( RTL_FILE_TELL,         "fb_FileTell",         "q",   "l"     )
        RTL( RTL_FILE_RESET,        "fb_FileReset",        "v",   ""      )
        '' 'reset n' -- stdin (0) or stdout (1) back from a redirection. Measured.
        RTL( RTL_FILE_RESET_EX,     "fb_FileResetEx",      "v",   "l"     )
        RTL( RTL_DATE,              "fb_Date",             "p",   ""      )
        RTL( RTL_TIME,              "fb_Time",             "p",   ""      )
        RTL( RTL_TIMER,             "fb_Timer",            "d",   ""      )
        '' RANDOMIZE takes the seed as a DOUBLE and the algorithm as an int32.
        RTL( RTL_RANDOMIZE,         "fb_Randomize",        "v",   "dl"    )
        '' ...and RND takes a SINGLE, not a double, and returns a double.
        RTL( RTL_RND,               "fb_Rnd",              "d",   "f"     )
        RTL( RTL_SLEEP,             "fb_Sleep",            "v",   "l"     )
        RTL( RTL_ENVIRON,           "fb_GetEnviron",       "p",   "p"     )
        RTL( RTL_SETENVIRON,        "fb_SetEnviron",       "l",   "p"     )
        RTL( RTL_COMMAND,           "fb_Command",          "p",   "l"     )
        RTL( RTL_EXEPATH,           "fb_ExePath",          "p",   ""      )
        RTL( RTL_EXEC,              "fb_Exec",             "l",   "pp"    )
        RTL( RTL_SHELL,             "fb_Shell",            "l",   "p"     )
        '' ERR, ERL, ERMN and ERFN. The two NAME queries return a raw char*, not a
        '' descriptor, and 'err = n' is a SETTER that returns the previous value.
        RTL( RTL_ERR_GET,           "fb_ErrorGetNum",      "l",   ""      )
        RTL( RTL_ERR_SET,           "fb_ErrorSetNum",      "l",   "l"     )
        RTL( RTL_ERR_LINE,          "fb_ErrorGetLineNum",  "l",   ""      )
        RTL( RTL_ERR_MODNAME,       "fb_ErrorGetModName",  "p",   ""      )
        RTL( RTL_ERR_FUNCNAME,      "fb_ErrorGetFuncName", "p",   ""      )
        '' THREADS, and the condition-variable four beside the mutexes above.
        '' fb_ThreadCreate's first argument is the thread PROCEDURE, a function
        '' pointer, and its third is the stack size, which follows the pointer width.
        RTL( RTL_THREAD_CREATE,     "fb_ThreadCreate",     "p",   "ppz"   )
        RTL( RTL_THREAD_WAIT,       "fb_ThreadWait",       "v",   "p"     )
        RTL( RTL_COND_CREATE,       "fb_CondCreate",       "p",   ""      )
        RTL( RTL_COND_DESTROY,      "fb_CondDestroy",      "v",   "p"     )
        RTL( RTL_COND_SIGNAL,       "fb_CondSignal",       "v",   "p"     )
        RTL( RTL_COND_BROADCAST,    "fb_CondBroadcast",    "v",   "p"     )
        '' THE REST OF THE INTRINSIC KEYWORDS: the console keyboard and mouse, the
        '' ports, the dynamic loader, the graphics page and palette helpers, and the
        '' two process replacements. Measured on both targets like the rest.
        ''
        '' 'stop' and 'system' are not here: both are fb_End( 0 ), which is already
        '' the entry the module epilogue uses.
        RTL( RTL_INKEY,             "fb_Inkey",            "p",   ""      )
        RTL( RTL_GETKEY,            "fb_Getkey",           "l",   ""      )
        RTL( RTL_MULTIKEY,          "fb_Multikey",         "l",   "l"     )
        RTL( RTL_GETMOUSE,          "fb_GetMouse",         "l",   "ppppp" )
        RTL( RTL_SETMOUSE,          "fb_SetMouse",         "l",   "llll"  )
        '' The PORT pair take a 16-bit port number, and OUT an 8-bit datum.
        RTL( RTL_INP,               "fb_In",               "l",   "S"     )
        RTL( RTL_OUT,               "fb_Out",              "l",   "SB"    )
        RTL( RTL_SETDATE,           "fb_SetDate",          "l",   "p"     )
        RTL( RTL_SETTIME,           "fb_SetTime",          "l",   "p"     )
        RTL( RTL_WAIT,              "fb_Wait",             "l",   "Sll"   )
        RTL( RTL_RUN,               "fb_Run",              "l",   "pp"    )
        RTL( RTL_CHAIN,             "fb_Chain",            "l",   "p"     )
        RTL( RTL_DYLIB_LOAD,        "fb_DylibLoad",        "p",   "p"     )
        RTL( RTL_DYLIB_SYMBOL,      "fb_DylibSymbol",      "p",   "pp"    )
        RTL( RTL_DYLIB_FREE,        "fb_DylibFree",        "v",   "p"     )
        '' FRE follows the pointer -- uint64 on win64 and uint32 on win32.
        RTL( RTL_FRE,               "fb_GetMemAvail",      "z",   "l"     )
        '' THE GRAPHICS HELPERS THAT ARE NOT DRAWING. PMAP and POINTCOORD both return
        '' a SINGLE, which is not guessable from either name.
        RTL( RTL_BLOAD,             "fb_GfxBload",         "l",   "ppp"   )
        RTL( RTL_BSAVE,             "fb_GfxBsave",         "l",   "pplp"  )
        RTL( RTL_PCOPY,             "fb_PageCopy",         "l",   "ll"    )
        RTL( RTL_PMAP,              "fb_GfxPMap",          "f",   "fl"    )
        RTL( RTL_POINTCOORD,        "fb_GfxCursor",        "f",   "l"     )
        RTL( RTL_SCREENLIST,        "fb_GfxScreenList",    "l",   "l"     )
        '' 'mid( s, i, n ) = t' -- an ASSIGNMENT INTO a string, which is its own entry
        '' point in each width and is not the mid( ) that reads. The wide form takes
        '' one argument more: the destination's fixed LENGTH, which a uint16* does not
        '' carry.
        RTL( RTL_STR_ASSIGN_MID,    "fb_StrAssignMid",     "v",   "pzzp"  )
        RTL( RTL_WSTR_ASSIGN_MID,   "fb_WstrAssignMid",    "v",   "pzzzp" )
        '' fbc PREDECLARES this one -- a program may call it with no declaration in
        '' sight, which is how the COM tests reach it through their own assert_ macro.
        RTL( RTL_ASSERT,            "fb_Assert",           "v",   "pzpp"  )
        RTL( RTL_FILE_LINEINPUT,    "fb_FileLineInput",    "l",   "lpzl"  )
        '' A WIDE destination is a DIFFERENT entry point and one argument shorter --
        '' there is no 'add newline' flag on the file form of it.
        RTL( RTL_FILE_LINEINPUT_W,  "fb_FileLineInputWstr","l",   "lpz"   )
        '' INPUT. One "start" call, then one call per destination, each passed BY
        '' ADDRESS. The start is fb_ConsoleInput( promptDesc, addQuestion, echoNewline )
        '' -- the prompt is always passed, as a temp descriptor, empty when absent --
        '' or fb_FileInput( n ) for the '#n' form.
        ''
        '' LINE INPUT is different again: ONE call with the destination inside it.
        ''
        '' NOTE THE CASING. The runtime spells these Ubyte/Ushort/Uint/Ulongint with a
        '' lowercase second letter, where the fb_Print family above uses UByte and
        '' ULongint. Copying the Print casing produces a link error.
        RTL( RTL_CONSOLE_INPUT,     "fb_ConsoleInput",     "l",   "pll"   )
        RTL( RTL_FILE_INPUT,        "fb_FileInput",        "l",   "l"     )
        RTL( RTL_LINEINPUT,         "fb_LineInput",        "l",   "ppzlll" )
        RTL( RTL_LINEINPUT_W,       "fb_LineInputWstr",    "l",   "ppzll" )
        RTL( RTL_INPUT_BYTE,        "fb_InputByte",        "l",   "p"     )
        RTL( RTL_INPUT_UBYTE,       "fb_InputUbyte",       "l",   "p"     )
        RTL( RTL_INPUT_SHORT,       "fb_InputShort",       "l",   "p"     )
        RTL( RTL_INPUT_USHORT,      "fb_InputUshort",      "l",   "p"     )
        RTL( RTL_INPUT_INT,         "fb_InputInt",         "l",   "p"     )
        RTL( RTL_INPUT_UINT,        "fb_InputUint",        "l",   "p"     )
        RTL( RTL_INPUT_LONGINT,     "fb_InputLongint",     "l",   "p"     )
        RTL( RTL_INPUT_ULONGINT,    "fb_InputUlongint",    "l",   "p"     )
        RTL( RTL_INPUT_SINGLE,      "fb_InputSingle",      "l",   "p"     )
        RTL( RTL_INPUT_DOUBLE,      "fb_InputDouble",      "l",   "p"     )
        RTL( RTL_INPUT_STRING,      "fb_InputString",      "l",   "pzl"   )
        RTL( RTL_INPUT_WSTR,        "fb_InputWstr",        "l",   "pz"    )
        '' A USTRING DESTINATION has entry points of its own (T66): fbc-modern reads a
        '' text file's bytes into one through them, where the narrow ones above handed a
        '' byte string to a UTF-16 descriptor.
        RTL( RTL_INPUT_USTR,        "fb_InputUStr",        "l",   "p"     )
        RTL( RTL_FILE_LINEINPUT_U,  "fb_FileLineInputUStr","l",   "lp"    )

        '' THE ADDRESSABLE REST OF THE RUNTIME. warnings/rtl-prototypes.bas takes
        '' 'procptr( fb_Xxx )' of 554 entry points and asserts each is non-null; 84 of
        '' them named nothing in this table, so the expression had no value and the
        '' assignment declined -- every one of that file's declines, from ONE cause.
        ''
        '' Signatures MEASURED the usual way: a generated probe of 'chk = procptr( f )'
        '' lines through 'fbc -r -gen gcc' on BOTH targets, and the letter is 'z'
        '' wherever win64 declares int64 and win32 int32.
        ''
        '' TWELVE OF THEM ARE DECLARED UNDER A DIFFERENT NAME. 'fb_MemMove' is plain
        '' 'memmove', 'fb_Pow' is 'pow', 'fb___divdi3' is libgcc's own '__divdi3' and
        '' 'fb_LeftSelf' is 'fb_LEFTSELF' -- the FB spelling is what a program writes
        '' and the C name is what links, so RtlByName maps between them.
        ''
        '' NOT EVERY ONE IS STDCALL ON WIN32 either: fb_ErrorResume, fb_ErrorResumeNext,
        '' fb_ErrorThrowAt and fb_hPutAdd are cdecl, as is every aliased C name, and
        '' decorating those emits a symbol the linker cannot resolve.
        RTL( RTL_ARRAY_BOUND_CHK_EX,    "fb_ArrayBoundChkEx",      "p",   "zzzlpp"    )
        RTL( RTL_ARRAY_DIMENSION_CHK,   "fb_ArrayDimensionChk",    "p",   "zplpp"     )
        RTL( RTL_ARRAY_FILL,            "fb_ArrayFill",            "l",   "pl"        )
        RTL( RTL_ARRAY_REDIM_TO,        "fb_ArrayRedimTo",         "l",   "pplpp"     )
        RTL( RTL_ARRAY_SNG_BOUND_CHK_EX, "fb_ArraySngBoundChkEx",   "p",   "zzlpp"     )
        RTL( RTL_ASSERT_WARN,           "fb_AssertWarn",           "v",   "plpp"      )
        RTL( RTL_CVD_FROM_LONGINT,      "fb_CVDFROMLONGINT",       "d",   "q"         )
        RTL( RTL_CVL_FROM_S,            "fb_CVLFROMS",             "l",   "f"         )
        RTL( RTL_CVLONGINT_FROM_D,      "fb_CVLONGINTFROMD",       "q",   "d"         )
        RTL( RTL_CVS_FROM_L,            "fb_CVSFROML",             "f",   "l"         )
        RTL( RTL_ERROR_RESUME,          "fb_ErrorResume",          "p",   ""          )
        RTL( RTL_ERROR_RESUME_NEXT,     "fb_ErrorResumeNext",      "p",   ""          )
        RTL( RTL_ERROR_SET_FUNC_NAME,   "fb_ErrorSetFuncName",     "p",   "p"         )
        RTL( RTL_ERROR_SET_HANDLER,     "fb_ErrorSetHandler",      "p",   "p"         )
        '' THE THREE THE NON-LOCAL ERROR JUMP NEEDS. lib/rt/src/c/errjmp.c holds the
        '' buffer and the longjmp; '_setjmp' is the C library's own, called from the
        '' frame that installs the handler because that is the frame being captured.
        '' Two arguments: MSVC's _setjmp takes (env, frame) and a null frame is the
        '' non-unwinding jump FreeBASIC wants; glibc's takes (env) and ignores the
        '' second register.
        RTL( RTL_ERROR_JMPBUF,          "fb_ErrorJmpBuf",          "p",   ""          )
        RTL( RTL_ERROR_GET_HANDLER,     "fb_ErrorGetHandler",      "p",   ""          )
        RTL( RTL_SETJMP,                "_setjmp",                 "l",   "pp"        )
        '' THE SAME CALL UNDER THE NAME THE UCRT EXPORTS. tiko links ucrtbase, which
        '' has '__intrinsic_setjmp' and not '_setjmp' -- that one lives in msvcrt.lib,
        '' and linking msvcrt.lib beside tiko-rt collides on _fltused. LowerOnError_
        '' picks by target; glibc has _setjmp and no intrinsic spelling.
        RTL( RTL_SETJMP_MSVC,           "__intrinsic_setjmp",      "l",   "pp"        )
        RTL( RTL_ERROR_SET_MOD_NAME,    "fb_ErrorSetModName",      "p",   "p"         )
        RTL( RTL_ERROR_THROW_AT,        "fb_ErrorThrowAt",         "p",   "lppp"      )
        RTL( RTL_FILE_GET32,              "fb_FileGet",              "l",   "llpz"      )
        RTL( RTL_FILE_GET_ARRAY32,        "fb_FileGetArray",         "l",   "llp"       )
        RTL( RTL_FILE_GET_ARRAY_IOB,  "fb_FileGetArrayIOB",      "l",   "llpp"      )
        RTL( RTL_FILE_GET_ARRAY_LARGE_IOB, "fb_FileGetArrayLargeIOB", "l",   "lqpp"      )
        RTL( RTL_FILE_GET_IOB,        "fb_FileGetIOB",           "l",   "llpzp"     )
        RTL( RTL_FILE_GET_LARGE_IOB,  "fb_FileGetLargeIOB",      "l",   "lqpzp"     )
        RTL( RTL_FILE_GET_STR32,          "fb_FileGetStr",           "l",   "llpz"      )
        RTL( RTL_FILE_GET_STR_IOB,    "fb_FileGetStrIOB",        "l",   "llpzp"     )
        RTL( RTL_FILE_GET_STR_LARGE_IOB, "fb_FileGetStrLargeIOB",   "l",   "lqpzp"     )
        RTL( RTL_FILE_GET_WSTR32,         "fb_FileGetWstr",          "l",   "llpz"      )
        RTL( RTL_FILE_GET_WSTR_IOB,   "fb_FileGetWstrIOB",       "l",   "llpzp"     )
        RTL( RTL_FILE_GET_WSTR_LARGE_IOB, "fb_FileGetWstrLargeIOB",  "l",   "lqpzp"     )
