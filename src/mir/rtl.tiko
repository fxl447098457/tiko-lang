'' rtl.tiko -- the runtime inventory. See rtl.ti for why it is measured, not copied.

#import "std/containers"
#include once "mir/rtl.ti"
#include once "support/text.ti"

namespace Tko.Mir

function RtlSymbol( byval r as RtlId, byval is32 as boolean = false ) as string
    '' A HANDFUL OF ENTRIES ARE NAMED DIFFERENTLY ON WIN32, not merely decorated
    '' differently. Measured: the file GET and PUT that take a 64-bit position are
    '' fb_FileGetLarge and fb_FilePutLarge on win64 and plain fb_FileGet and fb_FilePut
    '' on win32, where the position and count are 32-bit. Every other row here has one
    '' name and only its DECORATION varies, which is RtlLinkName's business.
    if is32 then
        select case r
        case RTL_FILE_GET        : return "fb_FileGet"
        case RTL_FILE_PUT        : return "fb_FilePut"
        case RTL_FILE_GET_ARRAY  : return "fb_FileGetArray"
        case RTL_FILE_PUT_ARRAY  : return "fb_FilePutArray"
        case RTL_FILE_GET_STR    : return "fb_FileGetStr"
        case RTL_FILE_PUT_STR    : return "fb_FilePutStr"
        case RTL_FILE_GET_WSTR   : return "fb_FileGetWstr"
        case RTL_FILE_LOCK       : return "fb_FileLock"
        case RTL_FILE_UNLOCK     : return "fb_FileUnlock"
        case RTL_FILE_SEEK       : return "fb_FileSeek"
        end select
    end if
    select case r
    #define RTL( r_id, r_sym, r_ret, r_args ) case r_id : return r_sym
    TKO_RTL_LIST( RTL )
    #undef RTL
    end select
    return ""
end function

'' The MIR type one letter names. One alphabet for returns and parameters, so a
'' pointer-width value cannot be spelled one way in one column and another in the other.
function RtlTypeOfLetter _
    ( byref c as string, byval is32 as boolean ) as MirType

    select case c
    case "v" : return MT_VOID
    case "b", "B" : return MT_I8
    case "s", "S" : return MT_I16
    case "l" : return MT_I32
    case "L" : return MT_I32
    case "q" : return MT_I64
    case "z" : return iif( is32, MT_I32, MT_I64 )
    case "f" : return MT_F32
    case "d" : return MT_F64
    case "p" : return MT_PTR
    case "." : return MT_VOID      '' the variadic marker names no type
    end select
    return MT_VOID
end function

function RtlReturn( byval r as RtlId, byval is32 as boolean ) as MirType
    dim as string ret = ""
    select case r
    #define RTL( r_id, r_sym, r_ret, r_args ) case r_id : ret = r_ret
    TKO_RTL_LIST( RTL )
    #undef RTL
    end select
    return RtlTypeOfLetter( ret, is32 )
end function

'' The linker-visible name. On win32 every runtime symbol carries the leading
'' underscore, and everything but the VARIADIC entries carries a stdcall '@N' as well:
'' varargs need caller cleanup, so fb_ArrayRedimEx is '_fb_ArrayRedimEx' with no
'' suffix while fb_StrAssign is '_fb_StrAssign@20'. Both measured from libfb.a.
'' The inventory entry with this SYMBOL NAME, or RTL_NONE. Case-insensitive, because
'' FreeBASIC identifiers are: a program may write 'fb_arrayredimex'.
''
'' fbc PREDECLARES the whole runtime, so a program may name any of these with nothing
'' declaring it -- 'chk = procptr( fb_ArrayRedimEx )' is 510 statements in one corpus
'' file testing exactly that.
private function LowerName_( byref nm as string ) as string
    return Tko.Text.LowerAscii( nm )
end function

function RtlByName( byref nm as string ) as RtlId
    '' Compared through a helper rather than inline: the macro expands its body once
    '' per row, and a qualified call inside that expansion does not parse.
    dim as string want = LowerName_( nm )

    '' TWELVE ENTRY POINTS ARE DECLARED UNDER A DIFFERENT NAME than the one a program
    '' writes. 'procptr( fb_MemMove )' is legal FreeBASIC and what fbc emits for it is
    '' plain 'memmove'; the same goes for memcpy, pow, rename, atexit, __main, libgcc's
    '' four 64-bit division helpers, __fixunsdfdi, and fb_LeftSelf, whose runtime name
    '' is the SHOUTED fb_LEFTSELF. Measured from the C 'fbc -r' emits for each.
    ''
    '' Mapped here rather than by adding a second row per name: the table's symbol is
    '' what LINKS, and two rows for one function would be two entries in the inventory
    '' the gate counts.
    select case want
    case "fb_memmove"      : want = "memmove"
    case "fb_memcopy"      : want = "memcpy"
    case "fb_pow"          : want = "pow"
    case "fb_rename"       : want = "rename"
    case "fb_atexit"       : want = "atexit"
    case "fb___main"       : want = "__main"
    case "fb___divdi3"     : want = "__divdi3"
    case "fb___udivdi3"    : want = "__udivdi3"
    case "fb___moddi3"     : want = "__moddi3"
    case "fb___umoddi3"    : want = "__umoddi3"
    case "fb___fixunsdfdi" : want = "__fixunsdfdi"
    case "fb_leftself"     : want = "fb_leftself"
    end select
    '' THE LENGTH FIRST: lowercasing all ~540 symbols per ask was ~540 allocations per
    '' 'procptr( ident )' and per undeclared-name check. Lowercasing keeps the length.
    dim as int32 wantLen = len( want )
    #define RTL( r_id, r_sym, r_ret, r_args ) if (len( r_sym ) = wantLen) andalso (LowerName_( r_sym ) = want) then return r_id
    TKO_RTL_LIST( RTL )
    #undef RTL
    return RTL_NONE
end function

'' THE 'z' LETTER AS A TYPE: the pointer-width signed integer every RTL count,
'' index and length tag travels in -- i64 on the 64-bit targets, i32 on win32,
'' where RtlSignature's own letter says i32 and a caller spelling i64 signs a
'' call its own declare refuses.
function RtlWordType( byval is32 as boolean ) as MirType
    return iif( is32, MT_I32, MT_I64 )
end function

function RtlLinkName( byval r as RtlId, byval is32 as boolean ) as string
    dim as string nm = RtlSymbol( r, is32 )
    if is32 = false then return nm
    '' THE BARE NAME ON WIN32 TOO. This used to spell the DECORATED object symbol --
    '' '_fb_Init@12' -- because fbc's -gen gas pipeline left the decoration to the
    '' name. LLVM's i386 COFF backend applies BOTH decorations itself, from the
    '' call's convention: 'bar' assembles to '_bar', and an 'x86_stdcallcc' call to
    '' 'CloseHandle' assembles to '_CloseHandle@4' (measured, clang 21.1.3,
    '' i686-w64-windows-gnu). Decorating here as well doubled every one of them --
    '' '_Sleep@4@4' -- and nothing linked. The convention now travels beside the
    '' name, as RtlCallConv, and the IR carries the bare spelling.
    return nm
end function

'' THE CONVENTION AN RTL ENTRY IS CALLED WITH ON WIN32, which used to be folded
'' into the decorated name above and now rides on the IR. Everything is STDCALL --
'' the rtlib's FBCALL on win32 -- except the families measured cdecl, each with the
'' libfb.a object that proves it. The measurement comments are the old ones, kept.
function RtlCallConv( byval r as RtlId, byval is32 as boolean ) as uint8
    if is32 = false then return TKO_CC_CDECL
    dim as string ps = RtlParams( r )
    if instr( ps, "." ) > 0 then return TKO_CC_CDECL

    select case r
    case RTL_ERROR_THROW : return TKO_CC_CDECL
    case RTL_FREE, RTL_MALLOC, RTL_CALLOC, RTL_REALLOC, RTL_MEMSET, _
         RTL_POW, RTL_ATAN2, RTL_ATEXIT
        return TKO_CC_CDECL
    case RTL_MEM_MOVE, RTL_MEM_COPY, RTL_RENAME, RTL_C_MAIN, RTL_DIVDI3, _
         RTL_UDIVDI3, RTL_MODDI3, RTL_UMODDI3, RTL_FIXUNSDFDI
        return TKO_CC_CDECL
    case RTL_ERROR_RESUME, RTL_ERROR_RESUME_NEXT, RTL_ERROR_THROW_AT, RTL_H_PUT_ADD, RTL_PATH_RENAME
        return TKO_CC_CDECL
    case RTL_GFX_PUT_TRANS, RTL_GFX_PUT_PSET, RTL_GFX_PUT_PRESET, RTL_GFX_PUT_AND, _
         RTL_GFX_PUT_OR, RTL_GFX_PUT_XOR, RTL_GFX_PUT_ALPHA, RTL_GFX_PUT_BLEND, _
         RTL_GFX_PUT_CUSTOM
        return TKO_CC_CDECL
    end select
    return TKO_CC_STDCALL
end function

function RtlParams( byval r as RtlId ) as string
    select case r
    #define RTL( r_id, r_sym, r_ret, r_args ) case r_id : return r_args
    TKO_RTL_LIST( RTL )
    #undef RTL
    end select
    return ""
end function

function RtlArity( byval r as RtlId ) as int32
    return len( RtlParams( r ) )
end function

'' The MIR type a parameter letter names. Kept next to the table so the two cannot
'' drift apart.
'' A NARROW LETTER'S EXTENSION, TKO_PX_*: signext for b s (int8, int16, boolean),
'' zeroext for B S (uint8, uint16) -- the runtime's own parameter types.
private function RtlLetterExt_( byval ch as ubyte ) as uint8
    select case ch
    case asc( "b" ), asc( "s" ) : return TKO_PX_SIGN
    case asc( "B" ), asc( "S" ) : return TKO_PX_ZERO
    end select
    return TKO_PX_NONE
end function

'' NARROWEXT IS MACOS-ARM64. Apple's ABI leaves a narrow argument's upper bits to the
'' caller, and the runtime -- compiled by tiko, which writes 'i8 zeroext' on its
'' definitions there -- reads them as they arrive: without the attribute on the call,
'' 'print cast( uint8, 300 )' printed 300. Every other target leaves paramExt empty
'' here, so the ABI pass does not widen a runtime call and its IR is as before.
sub RtlSignature _
    ( byval f as MirFunction ptr, byval r as RtlId, byval is32 as boolean, _
      byval narrowExt as boolean )

    if f = nullptr then return
    if narrowExt then
        dim as string rl = ""
        select case r
        #define RTL( r_id, r_sym, r_ret, r_args ) case r_id : rl = r_ret
        TKO_RTL_LIST( RTL )
        #undef RTL
        end select
        if len( rl ) = 1 then f->retExt = RtlLetterExt_( rl[0] )
    end if
    '' THE '.' IS NOT A PARAMETER. RtlArity is the LENGTH of the parameter string and
    '' counts it, which is right for the fixed-prefix check it was written for and
    '' wrong here: it produced a fifth, void parameter on fb_ThreadCall, whose real
    '' signature is 'void* fb_ThreadCall( void*, int32, int64, int32, ... )'.
    dim as string ps = RtlParams( r )
    for i as int32 = 0 to len( ps ) - 1
        if ps[i] = asc( "." ) then exit for
        f->AddParam( RtlParamType( r, i, is32 ), 0, 0, 0, iif( narrowExt, RtlLetterExt_( ps[i] ), TKO_PX_NONE ) )
    next
    '' '.' marks a variadic tail -- a REDIM's bounds, PRINT's argument list -- and only
    '' the fixed prefix above is typed. LLVM needs to be TOLD, because a call to a
    '' variadic is a different call: on win64 a float in the tail goes in an XMM
    '' register AND its shadow GPR.
    f->isVariadic = (instr( RtlParams( r ), "." ) > 0)
end sub

function RtlParamType _
    ( byval r as RtlId, byval i as int32, byval is32 as boolean ) as MirType

    dim as string p = RtlParams( r )
    if (i < 0) orelse (i >= len( p )) then return MT_VOID
    return RtlTypeOfLetter( mid( p, i + 1, 1 ), is32 )
end function

function DumpRtl( byval is32 as boolean ) as string
    dim as string outp = ""
    for i as int32 = 1 to RTL_COUNT - 1
        dim as RtlId r = cast( RtlId, i )
        outp += RtlLinkName( r, is32 ) & " " & _
                TypeName( RtlReturn( r, is32 ) ) & " ("
        dim as string ps = RtlParams( r )
        for j as int32 = 0 to len( ps ) - 1
            if j > 0 then outp += ", "
            if mid( ps, j + 1, 1 ) = "." then
                outp += "..."
            else
                outp += TypeName( RtlParamType( r, j, is32 ) )
            end if
        next
        outp += ")" & chr( 10 )
    next
    outp += "rtl: " & str( RTL_COUNT - 1 ) & " entries" & chr( 10 )
    return outp
end function

end namespace
