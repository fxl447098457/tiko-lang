'' mir.tiko -- MIR construction and the opcode metadata tables.

#import "std/containers"
#include once "mir/mir.ti"

namespace Tko.Mir

constructor MirModule( )
end constructor

destructor MirModule( )
    for i as int32 = 0 to this.functions.Count - 1
        if this.functions[i] <> nullptr then delete this.functions[i]
    next
end destructor

function IdMap.Find( byval k as uint32 ) as int32
    dim as int32 cap = this.keys.Count
    if cap = 0 then return -1
    dim as int32 i = cast( int32, (k * 2654435761ul) and cast( uint32, cap - 1 ) )
    do
        dim as uint32 at = this.keys[i]
        if at = 0 then return -1
        if at = k then return this.vals[i]
        i = (i + 1) and (cap - 1)
    loop
end function

sub IdMap.Put( byval k as uint32, byval v as int32 )
    if (this.used + 1) * 2 > this.keys.Count then
        dim as containers.Array( of uint32 ) ok = this.keys
        dim as containers.Array( of int32 ) ov = this.vals
        dim as int32 ncap = iif( this.keys.Count = 0, 64, this.keys.Count * 2 )
        this.keys.Clear( ) : this.vals.Clear( )
        for j as int32 = 1 to ncap
            this.keys.Push( 0 ) : this.vals.Push( 0 )
        next
        this.used = 0
        for j as int32 = 0 to ok.Count - 1
            if ok[j] <> 0 then this.Put( ok[j], ov[j] )
        next
    end if
    dim as int32 cap = this.keys.Count
    dim as int32 i = cast( int32, (k * 2654435761ul) and cast( uint32, cap - 1 ) )
    do
        if this.keys[i] = 0 then
            this.keys[i] = k
            this.vals[i] = v
            this.used += 1
            return
        end if
        if this.keys[i] = k then
            this.vals[i] = v
            return
        end if
        i = (i + 1) and (cap - 1)
    loop
end sub

sub IdMap.Clear( )
    this.keys.Clear( )
    this.vals.Clear( )
    this.used = 0
end sub

sub MirFunction.AddParam _
    ( byval ty as MirType, byval aggSize as uint32, byval aggClass as uint32, _
      byval attr as uint8, byval ext as uint8 )

    this.paramTys.Push( cast( uint8, ty ) )
    this.paramAggs.Push( aggSize )
    this.paramClasses.Push( aggClass )
    this.paramAttrs.Push( attr )
    '' THE WIDENING TRAVELS WITH THE TYPE, through the one funnel every parameter
    '' already goes through -- so a signature cannot record an arity without saying
    '' whether that parameter widens. The ABI pass reads both.
    this.paramExt.Push( ext )
    this.paramNarrow.Push( cast( uint8, ty ) )
    this.paramCount = this.paramTys.Count
end sub

'' THE TWO NAME INDEXES, kept in step here so that no caller has to remember to.
'' Both hold index PLUS ONE, 0 for 'none', and both push the new entry to the FRONT of
'' its name's chain -- newest first, which is what a lookup for 'the definition' wants
'' to find without walking the declarations behind it.
private sub IndexName_ _
    ( byref idx as containers.Array( of int32 ), byval nm as InternId, byval at as int32, _
      byref nextOut as int32 )

    dim as int32 key = cast( int32, nm )
    while idx.Count <= key
        idx.Push( 0 )
    wend
    nextOut = idx[key]
    idx[key] = at + 1
end sub

'' The head of a name's chain, as an index, or -1 when the name has no entry.
private function HeadOf_ _
    ( byref idx as containers.Array( of int32 ), byval nm as InternId ) as int32

    dim as int32 key = cast( int32, nm )
    if (key < 0) orelse (key >= idx.Count) then return -1
    return idx[key] - 1
end function

function MirModule.AddFunction _
    ( byval nm as InternId, byval retTy as MirType ) as MirFunction ptr

    dim as MirFunction ptr f = new MirFunction
    f->name = nm
    f->retTy = cast( uint8, retTy )
    f->nextTemp = 1
    this.functions.Push( f )
    IndexName_( this.funcByName, nm, this.functions.Count - 1, f->nextSameName )
    dim as int32 key = cast( int32, nm )
    while this.funcOldestByName.Count <= key
        this.funcOldestByName.Push( 0 )
    wend
    if this.funcOldestByName[key] = 0 then this.funcOldestByName[key] = this.functions.Count
    return f
end function

function MirModule.FirstFunctionNamed( byval nm as InternId ) as int32
    return HeadOf_( this.funcByName, nm )
end function

function MirModule.OldestFunctionNamed( byval nm as InternId ) as int32
    return HeadOf_( this.funcOldestByName, nm )
end function

function MirModule.FindPtrTable( byval nm as InternId ) as int32
    dim as int32 at = HeadOf_( this.globalByName, nm )
    while at >= 0
        if this.globals[at].isPtrTable then return at
        at = this.globals[at].nextSameName - 1
    wend
    return -1
end function

function MirModule.FindVarGlobal( byval nm as InternId ) as int32
    dim as int32 at = HeadOf_( this.globalByName, nm )
    while at >= 0
        if this.globals[at].isVar then return at
        at = this.globals[at].nextSameName - 1
    wend
    return -1
end function

'' A WIDE string literal.
''
'' Measured: fbc folds 'wstr( "abc" )' at COMPILE TIME into L"abc" and emits no call
'' at all -- not fb_StrToWstr on the literal's bytes. Kept separate from the narrow
'' pool because a narrow and a wide literal of the same text are different objects.
'' A DATA block. Never shared: two identical blocks are still two blocks, because
'' the chain threads through their terminators and sharing one would make it a cycle.
function MirModule.AddDataBlock( byref names as Interner ) as int32
    dim as MirGlobal g
    g.isData = true
    g.dataFirst = this.dataTypes.Count
    g.dataCount = 0
    g.name = names.GetString( "$data" & str( this.globals.Count ) )
    this.globals.Push( g )
    dim as int32 at = this.globals.Count - 1
    IndexName_( this.globalByName, g.name, at, this.globals[at].nextSameName )
    return at
end function

sub MirModule.PushDataEntry _
    ( byval g as int32, byval ty as int32, byval ref as int32 )

    if (g < 0) orelse (g >= this.globals.Count) then return
    this.dataTypes.Push( ty )
    this.dataRefs.Push( ref )
    this.globals[g].dataCount += 1
end sub

'' A WIDE LITERAL FROM ITS DECODED CODE UNITS.
''
'' 'text' is the literal's SOURCE spelling and is what the dump prints; the UNITS
'' are the value. Widening the text one byte per unit -- which is what this used
'' to be -- cannot express a '\uXXXX' above 255, and the corpus's wide tests are
'' made of them: 'trim.bas' alone writes 186.
''
'' Two literals with the same TEXT have the same units, so the text is still the
'' merge key.
function MirModule.AddWideStringUnits _
    ( byref text as string, byref units as containers.Array( of uint32 ), _
      byref names as Interner ) as int32

    '' ...AND THE SAME UNITS. A UTF-8 source's '"Ω"' decodes to one unit where a
    '' byte-preserved file's same two bytes are two, so the text alone is not the key.
    for i as int32 = 0 to this.globals.Count - 1
        if this.globals[i].isString andalso this.globals[i].isWide andalso _
           (this.globals[i].bytes = text) then
            if this.globals[i].wcharCount <> units.Count then continue for
            dim as boolean same = true
            for u as int32 = 0 to units.Count - 1
                if this.wcharPool[this.globals[i].wcharFirst + u] <> units[u] then
                    same = false
                    exit for
                end if
            next
            if same then return i
        end if
    next
    dim as MirGlobal g
    g.bytes = text
    g.isString = true
    g.isWide = true
    g.wcharFirst = this.wcharPool.Count
    g.wcharCount = units.Count
    g.name = names.GetString( "$wstr" & str( this.globals.Count ) )
    this.globals.Push( g )
    dim as int32 at = this.globals.Count - 1
    IndexName_( this.globalByName, g.name, at, this.globals[at].nextSameName )
    for i as int32 = 0 to units.Count - 1
        this.wcharPool.Push( units[i] )
    next
    return at
end function

'' ...and from plain TEXT, one unit per byte. Every caller that has no escapes to
'' decode goes through here, and the units are filled in the same way so nothing
'' downstream has to know which entry point was used.
function MirModule.AddWideStringLiteral _
    ( byref text as string, byref names as Interner ) as int32

    dim as containers.Array( of uint32 ) units
    for i as int32 = 0 to len( text ) - 1
        units.Push( cast( uint32, text[i] ) )
    next
    return this.AddWideStringUnits( text, units, names )
end function

'' Identical literals share one global. See MirModule.strByText for why this is a
'' lookup and what the scan before it cost.
function MirModule.AddStringLiteral _
    ( byref text as string, byref names as Interner ) as int32

    dim as int32 key = cast( int32, names.GetString( text ) )
    while this.strByText.Count <= key
        this.strByText.Push( 0 )
    wend
    dim as int32 seen = this.strByText[key]
    if seen > 0 then return seen - 1

    dim as MirGlobal g
    g.bytes = text
    g.isString = true
    g.name = names.GetString( "$str" & str( this.globals.Count ) )
    this.globals.Push( g )
    dim as int32 idx = this.globals.Count - 1
    IndexName_( this.globalByName, g.name, idx, this.globals[idx].nextSameName )
    this.strByText[key] = idx + 1
    return idx
end function

function MirModule.AddPtrTable( byval nm as InternId ) as int32
    '' By NAME, so a type's table is found again rather than built twice: the base's
    '' RTTI is referenced by every type below it in the chain.
    dim as int32 found = this.FindPtrTable( nm )
    if found >= 0 then return found
    dim as MirGlobal g
    g.name = nm
    g.isPtrTable = true
    g.ptrFirst = this.ptrKinds.Count
    g.ptrCount = 0
    this.globals.Push( g )
    dim as int32 at = this.globals.Count - 1
    IndexName_( this.globalByName, nm, at, this.globals[at].nextSameName )
    return at
end function

'' The three entry kinds. Each APPENDS, so a table has to be filled before the next one
'' is opened -- the pool is shared and the runs are contiguous.
sub MirModule.PushPtrNull( byval g as int32, byval off as int32 = -1 )
    this.ptrKinds.Push( 0 )
    this.ptrRefs.Push( 0 )
    this.ptrOffs.Push( off )
    this.globals[g].ptrCount += 1
end sub

sub MirModule.PushPtrGlobal( byval g as int32, byval which as int32, byval off as int32 = -1 )
    this.ptrKinds.Push( 1 )
    this.ptrRefs.Push( cast( uint32, which ) )
    this.ptrOffs.Push( off )
    this.globals[g].ptrCount += 1
end sub

sub MirModule.PushPtrGlobalAt( byval g as int32, byval which as int32, byval bias as int32 )
    this.ptrKinds.Push( 3 )
    this.ptrRefs.Push( cast( uint32, which ) )
    this.ptrOffs.Push( bias )                  '' a table's, not a mixed global's: never ptrMixed
    this.globals[g].ptrCount += 1
end sub

sub MirModule.PushPtrFunc( byval g as int32, byval nm as InternId, byval off as int32 = -1 )
    this.ptrKinds.Push( 2 )
    this.ptrRefs.Push( cast( uint32, nm ) )
    this.ptrOffs.Push( off )
    this.globals[g].ptrCount += 1
end sub

function MirModule.AddVarGlobal _
    ( byval nm as InternId, byval ty as MirType, byval ft as Tko.TypeId, _
      byval sizeBytes as int32 ) as int32

    dim as int32 found = this.FindVarGlobal( nm )
    if found >= 0 then return found
    dim as MirGlobal g
    g.name = nm
    g.isVar = true
    '' -1 IS 'NO RELOCATION'. Zero is a valid global index, so a zero-initialised
    '' field would name the first global in the module as every static pointer's
    '' initial value.
    g.initReloc = -1
    g.ty = cast( uint8, ty )
    g.frontendType = ft
    g.size = sizeBytes
    this.globals.Push( g )
    dim as int32 at = this.globals.Count - 1
    IndexName_( this.globalByName, nm, at, this.globals[at].nextSameName )
    return at
end function

'' ------------------------------------------------------------------ metadata

function TypeName( byval t as MirType ) as string
    select case t
    case MT_VOID : return "void"
    case MT_I8   : return "i8"
    case MT_I16  : return "i16"
    case MT_I32  : return "i32"
    case MT_I64  : return "i64"
    case MT_F32  : return "f32"
    case MT_F64  : return "f64"
    case MT_PTR  : return "ptr"
    case MT_AGG  : return "agg"
    case MT_HFA_F32_1 : return "f32x1"
    case MT_HFA_F32_2 : return "f32x2"
    case MT_HFA_F32_3 : return "f32x3"
    case MT_HFA_F32_4 : return "f32x4"
    case MT_HFA_F64_1 : return "f64x1"
    case MT_HFA_F64_2 : return "f64x2"
    case MT_HFA_F64_3 : return "f64x3"
    case MT_HFA_F64_4 : return "f64x4"
    case MT_A2_I64    : return "i64x2"
    end select
    return "?"
end function

function OpName( byval o as MirOp ) as string
    select case o
    #define OP( o_id, o_name, o_args, o_res ) case o_id : return o_name
    TKO_MIR_LIST( OP )
    #undef OP
    end select
    return "?"
end function

function OpArity( byval o as MirOp ) as int32
    select case o
    #define OP( o_id, o_name, o_args, o_res ) case o_id : return o_args
    TKO_MIR_LIST( OP )
    #undef OP
    end select
    return 0
end function

function OpHasResult( byval o as MirOp ) as boolean
    select case o
    #define OP( o_id, o_name, o_args, o_res ) case o_id : return o_res
    TKO_MIR_LIST( OP )
    #undef OP
    end select
    return false
end function

'' ------------------------------------------------------------------- lowering

'' The MIR type of a frontend type. Note what collapses here: BOOLEAN becomes i8,
'' every pointer becomes MT_PTR whatever it points at, and STRING is NOT handled --
'' it is a 24-byte descriptor whose lowering needs the runtime, which this slice of
'' phase 6 does not have.
function LowerType _
    ( byval t as Tko.TypeId, byref types as Tko.TypeContext ) as MirType

    if t = Tko.TYPE_NONE then return MT_VOID

    select case types.Kind( t )
    case Tko.TK_POINTER, Tko.TK_REFERENCE, Tko.TK_PROC
        return MT_PTR
    case Tko.TK_ARRAY
        '' A fixed array is storage, addressed by arithmetic rather than loaded whole,
        '' so it is an aggregate however small it is. Falling through to the element's
        '' type would reserve ONE element -- four bytes where forty were needed.
        return MT_AGG
    case Tko.TK_UDT, Tko.TK_ENUM
        '' An ENUM is its underlying integer, which is INTEGER-wide -- 8 bytes on
        '' win64 and 4 on win32, measured -- and not a fixed 32 bits. A UDT is opaque.
        if types.Kind( t ) = Tko.TK_ENUM then
            if types.target.pointerBits = 32 then return MT_I32
            return MT_I64
        end if
        return MT_AGG
    case Tko.TK_BUILTIN
        select case types.BuiltinOf( t )
        case Tko.TY_VOID     : return MT_VOID
        case Tko.TY_BYTE, Tko.TY_UBYTE, Tko.TY_BOOLEAN : return MT_I8
        case Tko.TY_SHORT, Tko.TY_USHORT : return MT_I16
        case Tko.TY_LONG, Tko.TY_ULONG   : return MT_I32
        case Tko.TY_INTEGER, Tko.TY_UINTEGER
            '' INTEGER is pointer-sized, so its width comes from the target rather
            '' than from a constant: 8 bytes on the 64-bit targets, 4 on win32,
            '' where sizeof says so and the layout store agrees.
            if types.target.pointerBits = 32 then return MT_I32
            return MT_I64
        case Tko.TY_LONGINT, Tko.TY_ULONGINT
            '' FIXED 64 BITS ON EVERY TARGET. This used to sit in the INTEGER case
            '' above, where the pointer-width branch swallowed it -- the same 8 bytes
            '' on win64 hid the mistake, and win32's sizeof( longint ) = 8 against an
            '' i32 parameter exposed it (measured, 2026-11-08): a declare's own
            '' signature and its call site disagreed by four bytes.
            return MT_I64
        case Tko.TY_STRING, Tko.TY_USTRING
            '' A var-length string is a DESCRIPTOR -- 24 bytes on x86-64 -- not a
            '' pointer. Lowering it as MT_PTR would reserve 8 bytes and corrupt the
            '' neighbouring slot the moment the runtime wrote to it.
            return MT_AGG
        case Tko.TY_SINGLE   : return MT_F32
        case Tko.TY_DOUBLE   : return MT_F64
        '' AN AGGREGATE ON EVERY TARGET, even where it is pointer-sized. On Windows a
        '' cva_list is one pointer and MT_PTR would fit, but on Linux it is 24 bytes --
        '' and the four cva_* opcodes all take its ADDRESS, so nothing ever loads it
        '' whole. One shape everywhere means the lowering has no target case in it.
        case Tko.TY_CVA_LIST : return MT_AGG
        '' The ELEMENT of a 'ustring * N'; the array around it is the aggregate.
        case Tko.TY_FIXUSTR  : return MT_I16
        case Tko.TY_ANY      : return MT_VOID
        end select
    end select
    return MT_VOID
end function

'' A USTRING'S LITERAL IS UTF-16 ON EVERY TARGET. Lowering shares one wide-literal pool
'' between wstring and ustring consumers, and the emitter widened every entry to the
'' target's wchar -- right for fb_Wstr*, and on Linux, where wchar is 4 bytes, wrong
'' for fb_UStr*: 'dim as ustring u = "src/lexer.bas"' held one character, 's', and
'' tiko-lang's own source manager could not open an include file.
''
'' So each wide global passed to an fb_UStr* entry point is swapped for a UTF-16 twin,
'' made once per literal. The wchar original stays for any other use.
''
'' A UNIT ABOVE U+FFFF BECOMES A SURROGATE PAIR (T25), and the length the same call
'' passes beside the pointer is rewritten to the UTF-16 count. This used to leave such a
'' literal as it was, and the UTF-32 units then reached a UTF-16 entry point: on Linux
'' 'dim as ustring face = "a<U+1F600>b"' held "a" alone, len 1, where Windows held the
'' four units 97 55357 56832 98. When the length cannot be found -- no constant for it
'' in this call -- the literal is still left alone rather than half-converted.
''
'' The length is an M_CONST operand of the call: the count of the literal's units, or
'' that count with the top bit set, which is how lowering marks a literal's length.
private function FixUtf16Length_ _
    ( byval f as MirFunction ptr, byref argPool as containers.Array( of uint32 ), _
      byval ak as int32, byval oldCount as int32, byval newCount as int32 ) as boolean

    if (ak + 1) >= argPool.Count then return false
    if argPool[ak] <> cast( uint32, MV_TEMP ) then return false
    dim as uint32 tid = argPool[ak + 1]
    for bi as int32 = 0 to f->blocks.Count - 1
        for ii as int32 = 0 to f->blocks[bi].insts.Count - 1
            dim as MirInst ptr ci = @f->blocks[bi].insts[ii]
            if ci->result <> tid then continue for
            if cast( MirOp, ci->op ) <> M_CONST then return false
            dim as int64 flag = ci->imm and &h8000000000000000ll
            if (ci->imm and &h7FFFFFFFFFFFFFFFll) <> oldCount then return false
            ci->imm = flag or cast( int64, newCount )
            return true
        next
    next
    return false
end function

sub MirModule.SplitUtf16Literals( byref names as Interner )
    for fi as int32 = 0 to this.functions.Count - 1
        dim as MirFunction ptr f = this.functions[fi]
        if f = nullptr then continue for
        for bi as int32 = 0 to f->blocks.Count - 1
            for ii as int32 = 0 to f->blocks[bi].insts.Count - 1
                dim as MirInst ptr ins = @f->blocks[bi].insts[ii]
                if cast( MirOp, ins->op ) <> M_CALL_RTL then continue for
                dim as int32 ci = cast( int32, ins->callee )
                if (ci < 0) orelse (ci >= this.functions.Count) then continue for
                if this.functions[ci] = nullptr then continue for
                if left( names.Spelling( this.functions[ci]->name ), 7 ) <> "fb_UStr" then continue for
                for k as int32 = 0 to ins->count - 1
                    dim as int32 ak = (ins->first + k) * 2
                    if (ak + 1) >= this.argPool.Count then exit for
                    if this.argPool[ak] <> cast( uint32, MV_GLOBAL ) then continue for
                    dim as int32 gi = cast( int32, this.argPool[ak + 1] )
                    if (gi < 0) orelse (gi >= this.globals.Count) then continue for
                    if (this.globals[gi].isWide = false) orelse this.globals[gi].isUtf16 then continue for
                    '' The units, copied out first: pushing a pool element into its own
                    '' pool hands Push a reference the reallocation invalidates.
                    dim as containers.Array( of uint32 ) units
                    dim as boolean astral = false
                    for u as int32 = 0 to this.globals[gi].wcharCount - 1
                        dim as uint32 cu = this.wcharPool[this.globals[gi].wcharFirst + u]
                        if cu > &hFFFF then
                            astral = true
                            cu -= &h10000
                            units.Push( &hD800 + (cu shr 10) )
                            units.Push( &hDC00 + (cu and &h3FF) )
                        else
                            units.Push( cu )
                        end if
                    next
                    '' The longer text needs its length: the call's NEXT operand.
                    if astral then
                        if FixUtf16Length_( f, this.argPool, ak + 2, _
                                            this.globals[gi].wcharCount, units.Count ) = false then
                            continue for
                        end if
                    end if
                    dim as int32 twin = -1
                    for gj as int32 = 0 to this.globals.Count - 1
                        if this.globals[gj].isUtf16 = false then continue for
                        if this.globals[gj].wcharCount <> units.Count then continue for
                        dim as boolean same = true
                        for u as int32 = 0 to units.Count - 1
                            if this.wcharPool[this.globals[gj].wcharFirst + u] <> units[u] then
                                same = false
                                exit for
                            end if
                        next
                        if same then
                            twin = gj
                            exit for
                        end if
                    next
                    if twin < 0 then
                        dim as MirGlobal g
                        g.bytes = this.globals[gi].bytes
                        g.isString = true
                        g.isWide = true
                        g.isUtf16 = true
                        g.wcharFirst = this.wcharPool.Count
                        g.wcharCount = units.Count
                        g.name = names.GetString( "$ustr" & str( this.globals.Count ) )
                        for u as int32 = 0 to units.Count - 1
                            this.wcharPool.Push( units[u] )
                        next
                        this.globals.Push( g )
                        twin = this.globals.Count - 1
                        IndexName_( this.globalByName, g.name, twin, _
                                    this.globals[twin].nextSameName )
                    end if
                    this.argPool[ak + 1] = cast( uint32, twin )
                next
            next
        next
    next
end sub

end namespace
