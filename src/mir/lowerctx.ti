        ( byref c as Ctx, byval callee as Tko.SymbolId, byval idx as int32 ) as Tko.TypeId



    declare function ConstFloat _
        ( byref c as Ctx, byval v as float64, byval t as MirType ) as MirValue
    declare function IsFloatTy( byval t as MirType ) as boolean

