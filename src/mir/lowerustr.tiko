'' lowerustr.tiko -- the USTRING intrinsic family.
''
'' The narrow set lives in lowersub.tiko and the wide set in lowerwstr.tiko; this is the
'' third, and it exists because a ustring reaching either of the other two is a
'' MISCOMPILE rather than a decline. 'ucase( u )' over a ustring used to emit
''
''     fb_StrUcase2( &U$0, 0 )
''
'' -- the NARROW entry point handed an FBUSTRING, read as a byte string. Verifier
'' clean, "0 statements not lowered", and the answer was whatever the UTF-16 bytes
'' happened to spell. The same for trim, ltrim, rtrim, mid, left, right, instr and
'' instrrev: eight names, all silently wrong.
''
'' EVERY ARGUMENT IS A (POINTER, LENGTH) PAIR where the narrow twin passes a bare
'' descriptor, because a ustring may be fixed-length and the length is what says so.
'' PushStrArg pushes the pair with -1, which is 'as declared'.

#import "std/containers"
#include once "mir/lowerctx.ti"
#include once "mir/lowerstr.ti"
#include once "mir/lowerctl.ti"
#include once "mir/lowerexpr.ti"

namespace Tko.Mir

declare function StrSwapKind_ _
    ( byref c as Ctx, byval t as Tko.TypeId, byref n as int64 ) as int32

'' IS THIS FIRST ARGUMENT A USTRING, for choosing the USTRING twin of an intrinsic?
'' A CONCATENATION WITH A USTRING TERM COUNTS. Check types '&' as STRING, so 'trim( "  " &
'' u & "  " )' was sent to the narrow fb_TRIM over the USTRING temporary the chain builds.
'' fbc types it USTRING and calls fb_UStrTrim. ...AND SO DOES A UDT WHOSE STRING CONVERSION
'' IS A USTRING (T50): StrDescriptorOf_ hands back the cast's own UTF-16 descriptor, which
'' the narrow twin misread.
function UStrIntrinArgIsU_( byref c as Ctx, byval a0 as Tko.NodeId ) as boolean
    if a0 = Tko.NODE_NONE then return false
    if IsUStringType( c, c.info->TypeOf_( a0 ) ) then return true
    if c.ast->Kind( a0 ) = Tko.N_BINARY then
        dim as containers.Array( of uint32 ) a0t
        FlattenConcat( c, a0, a0t )
        if a0t.Count > 1 then
            if ConcatTermsAreU_( c, a0t ) then return true
        end if
    end if
    return UdtCastIsUStr_( c, a0 )
end function

'' DOES THIS CALL RETURN A USTRING -- one LowerUStrIntrinB_ below takes? Check computes no
'' type for an intrinsic call, so a chain classifying its terms cannot ask the type; the
'' name and the first argument are what decide. Nothing is emitted.
function IsUStrIntrinCall_( byref c as Ctx, byval id as Tko.NodeId ) as boolean
    if c.ast->Kind( id ) <> Tko.N_CALL then return false
    dim as Tko.ListPayload ptr cp = _
        c.ast->ListOf( id )
    if cp->target = Tko.NODE_NONE then return false
    if c.ast->Kind( cp->target ) <> Tko.N_IDENT then return false
    if cp->count < 1 then return false
    if c.info->RefOf( cp->target ) <> Tko.SYMBOL_NONE then
        if c.syms->SymbolAt( c.info->RefOf( cp->target ) )->kind = cast( uint8, Tko.SYM_PROC ) then return false
    end if
    dim as Tko.IdentPayload ptr ip = _
        c.ast->IdentOf( cp->target )
    select case LowerSpelling_( c.ix, *c.names, ip->name )
    case "trim", "ltrim", "rtrim", "left", "right", "mid", "ucase", "lcase"
    case else
        return false
    end select
    return UStrIntrinArgIsU_( c, cast( Tko.NodeId, c.ast->ChildSlot( cp->first ) ) )
end function

'' One 'ucase( u )' / 'mid( u, 2, 3 )' / 'instr( u, v )' and the rest, over a USTRING
'' first argument. Returns false for anything that is not one, so the narrow path keeps
'' every case it already had.
function LowerUStrIntrinB_ _
    ( byref c as Ctx, byval id as Tko.NodeId, byref outv as MirValue ) as boolean

    if c.ast->Kind( id ) <> Tko.N_CALL then return false
    dim as Tko.ListPayload ptr cp = _
        c.ast->ListOf( id )
    if cp->target = Tko.NODE_NONE then return false
    if c.ast->Kind( cp->target ) <> Tko.N_IDENT then return false
    if (cp->count < 1) orelse (cp->count > 3) then return false
    dim as Tko.IdentPayload ptr ip = _
        c.ast->IdentOf( cp->target )
    dim as string nm = LowerSpelling_( c.ix, *c.names, ip->name )

    '' THE FIRST ARGUMENT DECIDES, exactly as it does for the wide family.
    dim as Tko.NodeId a0 = cast( Tko.NodeId, c.ast->ChildSlot( cp->first ) )
    if UStrIntrinArgIsU_( c, a0 ) = false then return false

    dim as Tko.NodeId a1 = Tko.NODE_NONE
    if cp->count >= 2 then a1 = cast( Tko.NodeId, c.ast->ChildSlot( cp->first + 1 ) )

    '' WHICH ENTRY POINT, decided before anything is emitted: StrDescriptorOf_ may emit
    '' a call of its own, and a decline afterwards would leave it behind.
    dim as RtlId r = RTL_NONE
    '' THE THREE ARGUMENT SHAPES, and they are not one shape with options. Measured by
    '' reading what fbc emits for 'ucase( u )', 'left( u, 2 )' and 'mid( u, 2 )':
    ''
    ''   fb_UStrUcase( (void*)&U$0, -1ll )              ptr + LENGTH TAG
    ''   fb_UStrTrim ( (void*)&U$0, -1ll )              ptr + LENGTH TAG
    ''   fb_UStrMid  ( (void*)&U$0, -1ll, 2ll, -1ll )   ptr + LENGTH TAG + start + len
    ''   fb_UStrLeftD( (FBUSTRING*)&U$0, 2ll )          ptr + COUNT, no length tag
    ''
    '' left and right take the DESCRIPTOR and a count -- note fbc even spells the
    '' pointer 'FBUSTRING*' there and 'void*' everywhere else -- so passing them the
    '' (pointer, -1) pair every other entry point takes handed them -1 as the COUNT.
    dim as boolean takesLenTag = true
    select case nm
    '' THE 'any' FORM EXISTS. This said fbc had no fb_UStrTrimAny and declined the two-
    '' argument trim, so 'trim( f[0], any " " )' was DROPPED and tracks' ticker table
    '' loaded 27 rows with every field empty. Measured, fbc emits
    '' 'fb_UStrTrimAny( S, -1, L" \t", len-tag )' and the L and R twins. A second argument
    '' WITHOUT 'any' is fb_UStrTrimEx and its twins -- chosen below, once 'any' is known.
    case "trim"
        if cp->count > 2 then return false
        r = iif( cp->count = 2, RTL_USTR_TRIM_ANY, RTL_USTR_TRIM )
    case "ltrim"
        if cp->count > 2 then return false
        r = iif( cp->count = 2, RTL_USTR_LTRIM_ANY, RTL_USTR_LTRIM )
    case "rtrim"
        if cp->count > 2 then return false
        r = iif( cp->count = 2, RTL_USTR_RTRIM_ANY, RTL_USTR_RTRIM )
    case "left"
        if cp->count <> 2 then return false
        takesLenTag = false
        r = RTL_USTR_LEFT
    case "right"
        if cp->count <> 2 then return false
        takesLenTag = false
        r = RTL_USTR_RIGHT
    case "mid"
        if (cp->count < 2) orelse (cp->count > 3) then return false
        r = RTL_USTR_MID
    '' THERE IS NO CASE MODE HERE. The narrow twin takes one; the ustring entry point
    '' does not, and fbc DROPS the argument rather than passing it -- 'ucase( u, 1 )'
    '' and 'ucase( u )' both emit 'fb_UStrUcase( (void*)&U$0, -1ll )', where the -1 is
    '' the length tag every other entry point also takes and not a mode. Read as a
    '' mode it produced a third argument to a two-parameter function.
    case "ucase"
        if (cp->count < 1) orelse (cp->count > 2) then return false
        r = RTL_USTR_UCASE
    case "lcase"
        if (cp->count < 1) orelse (cp->count > 2) then return false
        r = RTL_USTR_LCASE
    case else
        return false
    end select

    '' THE 'any' OPERAND, unwrapped before anything is emitted so a trim whose second
    '' argument is not 'any' declines cleanly.
    dim as Tko.NodeId anyChars = Tko.NODE_NONE
    dim as boolean isAnyTrim = (r = RTL_USTR_TRIM_ANY) orelse (r = RTL_USTR_LTRIM_ANY) orelse _
                               (r = RTL_USTR_RTRIM_ANY)
    if isAnyTrim then
        dim as boolean anyForm = (c.ast->Kind( a1 ) = Tko.N_UNARY)
        if anyForm then
            dim as Tko.UnaryPayload ptr aup = _
                c.ast->UnaryOf( a1 )
            anyForm = (cast( Tko.TokenKind, aup->op ) = Tko.KW_ANY)
            if anyForm then anyChars = aup->operand
        end if
        '' ...AND WITHOUT 'any' IT IS A PATTERN, the whole substring stripped: fb_UStrTrimEx
        '' and its twins, the same four arguments. It declined, so fbx's fbxOpenFileDialog
        '' kept its 'ustrFile = RTRIM( ustrFile, CHR( 32 ) )' padding -- in silence.
        if anyForm = false then
            select case r
            case RTL_USTR_TRIM_ANY  : r = RTL_USTR_TRIM_EX
            case RTL_USTR_LTRIM_ANY : r = RTL_USTR_LTRIM_EX
            case RTL_USTR_RTRIM_ANY : r = RTL_USTR_RTRIM_EX
            end select
            anyChars = a1
        end if
    end if

    '' A 'ustring * N' HAS NO DESCRIPTOR, and asking for one declined the whole statement.
    '' Measured, fbc passes its BUFFER and TAGGED LENGTH where a length tag is taken --
    '' 'fb_UStrTrim( LF$0, &h8000000000000005 )' over a 'ustring * 6' -- which is the pair
    '' EmitStrTerm pushes for one; and where a DESCRIPTOR is taken, left and right, it
    '' copies into a temporary first: 'fb_UStrAssign( &TMP, -1, LF$0, <tag>, 0 );
    '' fb_UStrLeftD( &TMP, 3 )', deleted after. Every other operand is unchanged.
    dim as int64 fixTag
    dim as boolean a0Fixed = (StrSwapKind_( c, c.info->TypeOf_( a0 ), fixTag ) = 4)
    dim as int32 fixSlot = -1
    dim as MirValue s0
    dim as containers.Array( of uint32 ) args
    if a0Fixed andalso takesLenTag then
        if EmitStrTerm( c, args, a0, true ) = false then return false
    elseif a0Fixed then
        if UStrOutOperand_( c, a0, s0, fixSlot ) = false then return false
        args.Push( cast( uint32, s0.kind ) ) : args.Push( cast( uint32, s0.id ) )
    else
        if StrDescriptorOf_( c, a0, s0 ) = false then return false
        if takesLenTag then
            PushStrArg( args, s0 )
        else
            args.Push( cast( uint32, s0.kind ) ) : args.Push( cast( uint32, s0.id ) )
        end if
    end if
    '' ...and the characters as a USTRING pair: a literal as UTF-16, a narrow or wide
    '' string converted -- the same operand rule a ustring comparison follows.
    if isAnyTrim then
        if UStrCmpOperand_( c, args, anyChars ) = false then return false
    end if

    '' The COUNT for left and right, and the START for mid. ucase and lcase take
    '' nothing further, so a second written argument is dropped exactly as fbc drops
    '' it -- see the case labels above. The width is the RTL 'z' letter --
    '' pointer-width, i32 on win32 -- not an unconditional i64, which signed a call
    '' the signature refused.
    dim as MirType zw = RtlWordType( c.types->target.pointerBits = 32 )
    dim as boolean wantsSecond = _
        (r = RTL_USTR_LEFT) orelse (r = RTL_USTR_RIGHT) orelse (r = RTL_USTR_MID)
    if wantsSecond andalso (a1 <> Tko.NODE_NONE) then
        dim as MirValue n1 = LowerNumArg_( c, a1, zw )
        if n1.kind = cast( uint8, MV_NONE ) then return false
        args.Push( cast( uint32, n1.kind ) ) : args.Push( cast( uint32, n1.id ) )
    end if

    if r = RTL_USTR_MID then
        '' A 'mid' WITHOUT a length passes -1, not 0 -- 0 would silently produce an
        '' empty string instead of the rest of the source. Same rule as the narrow one.
        if cp->count = 3 then
            dim as Tko.NodeId a2 = cast( Tko.NodeId, c.ast->ChildSlot( cp->first + 2 ) )
            dim as MirValue n2 = LowerNumArg_( c, a2, zw )
            if n2.kind = cast( uint8, MV_NONE ) then return false
            args.Push( cast( uint32, n2.kind ) ) : args.Push( cast( uint32, n2.id ) )
        else
            args.Push( cast( uint32, MV_CONST_INT ) )
            args.Push( cast( uint32, cast( uint32, -1 ) ) )
        end if
    end if

    outv = EmitRtl( c, r, args )
    ReleaseUStrOut_( c, fixSlot )
    return (outv.kind <> cast( uint8, MV_NONE ))
end function
end namespace
