'' dllimplib.tiko -- a DLL's export table, as a .def. See dllimplib.ti.

#import "std/containers"
#include once "codegen/dllimplib.ti"

namespace Tko.Codegen

private function U16_( byref b as string, byval at_ as int64 ) as int64
    if (at_ < 0) orelse (at_ + 2 > len( b )) then return 0
    return b[at_] or (clngint( b[at_ + 1] ) shl 8)
end function

private function U32_( byref b as string, byval at_ as int64 ) as int64
    if (at_ < 0) orelse (at_ + 4 > len( b )) then return 0
    return b[at_] or (clngint( b[at_ + 1] ) shl 8) or _
           (clngint( b[at_ + 2] ) shl 16) or (clngint( b[at_ + 3] ) shl 24)
end function

private function U64_( byref b as string, byval at_ as int64 ) as int64
    if (at_ < 0) orelse (at_ + 8 > len( b )) then return 0
    return U32_( b, at_ ) or (U32_( b, at_ + 4 ) shl 32)
end function

'' The NUL-terminated text at file offset 'at_', or "" when it runs off the end.
private function CStr_( byref b as string, byval at_ as int64 ) as string
    if (at_ < 0) orelse (at_ >= len( b )) then return ""
    dim as int64 e = at_
    do while (e < len( b )) andalso (b[e] <> 0)
        e += 1
    loop
    if e >= len( b ) then return ""
    return mid( b, at_ + 1, e - at_ )
end function

'' The section table, read once: virtual address, extent, file offset, characteristics.
type PeSection_
    as int64 va, extent, raw, chars
end type

'' The section holding 'rva', or -1.
private function SectionOf_( byref secs as containers.Array( of PeSection_ ), byval rva as int64 ) as int32
    for i as int32 = 0 to secs.Count - 1
        if (rva >= secs[i].va) andalso (rva < secs[i].va + secs[i].extent) then return i
    next
    return -1
end function

private function OffsetOf_( byref secs as containers.Array( of PeSection_ ), byval rva as int64 ) as int64
    dim as int32 s = SectionOf_( secs, rva )
    if s < 0 then return -1
    return secs[s].raw + (rva - secs[s].va)
end function

private function BaseName_( byref p as string ) as string
    for i as int32 = len( p ) to 1 step -1
        dim as string ch = mid( p, i, 1 )
        if (ch = "/") orelse (ch = "\") then return mid( p, i + 1 )
    next
    return p
end function

function DllDefText( byref dll as string, byref why as string ) as string
    dim as string b
    dim as int32 fh = freefile
    if open( dll for binary access read as #fh ) <> 0 then
        why = "it cannot be opened"
        return ""
    end if
    if lof( fh ) > 0 then
        b = space( lof( fh ) )
        get #fh, , b
    end if
    close #fh

    if U16_( b, 0 ) <> &h5A4D then
        why = "it is not a Windows DLL (no 'MZ' header)"
        return ""
    end if
    dim as int64 pe = U32_( b, &h3C )
    if U32_( b, pe ) <> &h4550 then
        why = "it is not a Windows DLL (no 'PE' header)"
        return ""
    end if
    dim as int64 coff = pe + 4
    '' BOTH x86 WIDTHS: machine &h8664 is x86-64, &h14C is i386. The export table
    '' the rest of this reads is arch-independent; only the OPTIONAL header differs,
    '' and only in where its data directories start.
    dim as int64 machine = U16_( b, coff )
    if (machine <> &h8664) andalso (machine <> &h14C) then
        why = "it is not an x86 DLL (machine &h" & hex( machine, 4 ) & ")"
        return ""
    end if
    dim as int64 nsec = U16_( b, coff + 2 )
    dim as int64 optsz = U16_( b, coff + 16 )
    dim as int64 opt = coff + 20
    dim as int64 dirs = 0
    select case U16_( b, opt )
    case &h20B
        dirs = 112      '' PE32+, the 64-bit optional header
    case &h10B
        dirs = 96       '' PE32, the 32-bit one
    case else
        why = "it is neither a PE32 nor a PE32+ image"
        return ""
    end select
    if U32_( b, opt + dirs - 4 ) < 1 then
        why = "it has no export directory"
        return ""
    end if
    dim as int64 expRva = U32_( b, opt + dirs )
    dim as int64 expSize = U32_( b, opt + dirs + 4 )
    if expRva = 0 then
        why = "it exports nothing"
        return ""
    end if

    dim as containers.Array( of PeSection_ ) secs
    for i as int64 = 0 to nsec - 1
        dim as int64 h = opt + optsz + i * 40
        dim as PeSection_ s
        s.va = U32_( b, h + 12 )
        s.extent = U32_( b, h + 8 )
        if U32_( b, h + 16 ) > s.extent then s.extent = U32_( b, h + 16 )
        s.raw = U32_( b, h + 20 )
        s.chars = U32_( b, h + 36 )
        secs.Push( s )
    next

    dim as int64 ed = OffsetOf_( secs, expRva )
    if ed < 0 then
        why = "its export directory lies outside every section"
        return ""
    end if
    dim as string name_ = CStr_( b, OffsetOf_( secs, U32_( b, ed + 12 ) ) )
    if len( name_ ) = 0 then name_ = BaseName_( dll )
    dim as int64 nNames = U32_( b, ed + 24 )
    dim as int64 funcs = OffsetOf_( secs, U32_( b, ed + 28 ) )
    dim as int64 names = OffsetOf_( secs, U32_( b, ed + 32 ) )
    dim as int64 ords = OffsetOf_( secs, U32_( b, ed + 36 ) )
    if (nNames = 0) orelse (funcs < 0) orelse (names < 0) orelse (ords < 0) then
        why = "it exports nothing by name"
        return ""
    end if

    dim as string nl = chr( 10 )
    dim as string def_ = "LIBRARY """ & name_ & """" & nl & "EXPORTS" & nl
    for i as int64 = 0 to nNames - 1
        dim as string sym = CStr_( b, OffsetOf_( secs, U32_( b, names + i * 4 ) ) )
        if len( sym ) = 0 then continue for
        dim as int64 frva = U32_( b, funcs + U16_( b, ords + i * 2 ) * 4 )
        dim as boolean forwarder = (frva >= expRva) andalso (frva < expRva + expSize)
        dim as boolean isData = false
        if forwarder = false then
            dim as int32 s = SectionOf_( secs, frva )
            '' IMAGE_SCN_CNT_CODE or IMAGE_SCN_MEM_EXECUTE: code.
            if (s >= 0) andalso ((secs[s].chars and (&h20 or &h20000000)) = 0) then isData = true
        end if
        def_ &= "  " & sym & iif( isData, " DATA", "" ) & nl
    next
    return def_
end function

'' ELF64, little-endian. The DYNAMIC segment's entries give DT_SONAME, an offset into the string
'' table, and DT_STRTAB, that table's ADDRESS -- which the LOAD segment holding it turns into a
'' file offset.
function ElfSoname( byref so as string ) as string
    dim as string b
    dim as int32 fh = freefile
    if open( so for binary access read as #fh ) <> 0 then return ""
    if lof( fh ) > 0 then
        b = space( lof( fh ) )
        get #fh, , b
    end if
    close #fh
    if (len( b ) < 64) orelse (U32_( b, 0 ) <> &h464C457F) then return ""   '' 7F 'E' 'L' 'F'
    if (b[4] <> 2) orelse (b[5] <> 1) then return ""                        '' ELFCLASS64, little-endian
    dim as int64 phoff = U64_( b, &h20 )
    dim as int64 phentsize = U16_( b, &h36 )
    dim as int64 phnum = U16_( b, &h38 )
    dim as int64 dynOff = -1
    dim as int64 dynSize = 0
    for i as int64 = 0 to phnum - 1
        dim as int64 h = phoff + i * phentsize
        if U32_( b, h ) = 2 then                                             '' PT_DYNAMIC
            dynOff = U64_( b, h + 8 )
            dynSize = U64_( b, h + 32 )
        end if
    next
    if dynOff < 0 then return ""
    dim as int64 strtab = -1
    dim as int64 soname = -1
    dim as int64 e = dynOff
    do while e + 16 <= dynOff + dynSize
        dim as int64 tag = U64_( b, e )
        if tag = 0 then exit do                                              '' DT_NULL
        if tag = 5 then strtab = U64_( b, e + 8 )                            '' DT_STRTAB
        if tag = 14 then soname = U64_( b, e + 8 )                           '' DT_SONAME
        e += 16
    loop
    if (strtab < 0) orelse (soname < 0) then return ""
    for i as int64 = 0 to phnum - 1
        dim as int64 h = phoff + i * phentsize
        if U32_( b, h ) <> 1 then continue for                               '' PT_LOAD
        dim as int64 va = U64_( b, h + 16 )
        if (strtab >= va) andalso (strtab < va + U64_( b, h + 32 )) then
            return CStr_( b, U64_( b, h + 8 ) + (strtab - va) + soname )
        end if
    next
    return ""
end function

end namespace
