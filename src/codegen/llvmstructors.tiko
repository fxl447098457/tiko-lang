'' llvmstructors.tiko -- module constructors and destructors, in fbc's order.
''
'' Included from llvmemit.tiko, after GlobalName; split out at the 1500-line cap.
''
'' MODULE-LIFETIME STRUCTORS. gcc spells them an attribute and LLVM a list; the third
'' field of a list entry -- the data a structor is associated with -- is null because
'' these belong to the module rather than to any one object.
''
'' Measured, fbc emits 'void CHECK( void ) __attribute__(( destructor ));' and the
'' program prints '1  1'. tiko once emitted no destructor list at all and printed
'' nothing -- which only build/runscan.sh could see, because it compiles, it links, and
'' it is silent. tests/vendor/fbc-tests/scopes/dtor_eol_eof1.bas is the corpus file.
''
'' THE ORDER IS THE PLATFORM'S, and fbc gets it for nothing: gcc writes every structor
'' in declaration order -- an unnumbered one into .ctors or .init_array, a numbered one
'' ('constructor 101') into a section named for its number -- and each platform's
'' start-up walks those its own way. Measured with fbc-modern's default backend, three
'' constructors a1 b2 c3, three destructors d1 d2 d3, 'constructor 101' / '200' /
'' 'destructor 101', and modules linked M A B:
''
''                       constructors              destructors      modules (ctors)
''     win64 (mingw)     101 200  c3 b2 a1        d1 d2 d3  101    B A M
''     linux-x86_64      101 200  a1 b2 c3        d3 d2 d1  101    M A B
''
'' -- mingw walks .ctors backwards and .dtors forwards, ELF walks .init_array forwards
'' and .fini_array backwards, and a NUMBERED group of either walks the same way as the
'' unnumbered: fbc prints 'b a' for two 'constructor 150's written a, b on win64. A
'' written 65535 IS unnumbered -- gcc puts 'constructor( 65535 )' and 'destructor(
'' 65535 )' in plain .ctors / .dtors / .init_array, checked on both. tiko ran everything
'' forwards and ignored the number, so fbc's own concurrency/sched.bas -- whose first
'' test needs a later test's goroutines to have started the pool -- failed on tiko
'' alone.
''
'' SO THIS WRITES WHAT gcc WRITES. A NUMBERED structor goes out as a pointer in gcc's
'' own section for its number, kept by @llvm.used, in declaration order -- not through
'' LLVM's list priority, which REVERSES a .ctors list on win64 and has no spelling for
'' the .CRT$X layout below. The UNNUMBERED keep the LLVM list, in the order that makes
'' each target's walk come out as fbc's:
''
''   linux-x86_64   .init_array / .fini_array.NNNNN (the number): as declared.
''   win64          .ctors / .dtors.NNNNN (65535 minus the number). LLVM reverses the
''                  .ctors/.dtors list, so it is written reversed to cancel that.
''   windows-x86_64     .CRT$XCV / .CRT$XTY + (65535 minus the number) -- after the
''                  unnumbered .CRT$XCU / .CRT$XTX, which is where mingw's sorted
''                  .ctors.* sit relative to .ctors. tiko-rt's start-up walks .CRT$XC*
''                  backwards and .CRT$XT* forwards (lib/rt/src/c/msvccrt.c), as
''                  mingw walks .ctors and .dtors, so both lists go out as declared.
private function StructorSection_ _
    ( byref e as EmitCtx, byval isCtor as boolean, byval prio as int32 ) as string
    select case e.tgt->id
    case Tko.TARGET_LINUX_X86_64
        return iif( isCtor, ".init_array.", ".fini_array." ) & right( "0000" & str( prio ), 5 )
    case Tko.TARGET_WIN64
        return iif( isCtor, ".ctors.", ".dtors." ) & right( "0000" & str( 65535 - prio ), 5 )
    case Tko.TARGET_WINDOWS_X86_64
        return iif( isCtor, ".CRT$XCV", ".CRT$XTY" ) & right( "0000" & str( 65535 - prio ), 5 )
    case Tko.TARGET_WIN32
        '' THE MinGW SPELLING, like TARGET_WIN64: i686 COFF carries the same numbered
        '' .ctors./.dtors. sections, walked by the runtime's start-up the same way.
        return iif( isCtor, ".ctors.", ".dtors." ) & right( "0000" & str( 65535 - prio ), 5 )
    case Tko.TARGET_MACOS_ARM64
        '' NO SECTION BY NUMBER: on Mach-O a numbered structor is a record in
        '' __DATA,__tko_ctors / __tko_dtors (MachoRecord_), so nothing should ask for one.
    end select
    Tko.TargetIce( "StructorSection_", e.tgt->id )
    return ""
end function

'' MODULE INITIALISATION (ADR 0017; RFC-0006 §2-3), and why it sits where it does.
''
'' A MODULE UNIT REGISTERS NO UNNUMBERED STRUCTOR. Its '_GLOBAL__I', its top-level code
'' (fb_ctor__<name>) and its 'constructor' subs are called, in that order, from
'' '__tko_modinit$<chain>' -- external, guarded, and calling its imports' first -- and its
'' 'destructor' subs, reversed, then '_GLOBAL__D', from an internal '__tko_modfini$<chain>'
'' that the init pushes onto a finaliser stack once it has run.
''
'' EVERY ROOT of a build with modules registers two NUMBERED structors, both 65534: a
'' constructor that calls every module's init in BUILD ORDER -- so the order is the build
'' graph's on every target and for every link order, the guard making every call after the
'' first a no-op -- and a destructor that drains the stack, last in first out. Measured
'' 2026-09-27 on all three targets, tiko-built classic probes:
''
''     constructors    101, then 65534, then EVERY unnumbered one -- another root's
''                     fb_ctor__ and _GLOBAL__I included -- then main
''     destructors     every unnumbered one and _GLOBAL__D, then 65534, then 101
''
'' and a string made and printed at 65534 either way works, so tiko-rt is up by then and not
'' yet torn down. That is the slot RFC-0006 §3 asked to be measured: modules initialise
'' before any root's code and finalise after it, with no change to the runtime.
''
'' THE STACK AND ITS TWO PROCEDURES are linkonce_odr, one copy in the link: every unit that
'' uses them emits them. Mach-O has no COMDAT (see llvmemit.tiko); there linkonce_odr
'' alone is a weak definition.
private function ModStackIr_( byref e as EmitCtx ) as string
    dim as string nl = chr( 10 )
    dim as string q = chr( 34 )
    dim as string fs = "@" & q & "__tko_modfinis" & q
    dim as string fn = "@" & q & "__tko_modfinin" & q
    dim as boolean cd = (e.tgt->objFormat <> OBJ_MACHO)
    dim as string r
    if cd then r &= "$" & q & "__tko_modfinis" & q & " = comdat any" & nl
    r &= fs & " = linkonce_odr global [1024 x ptr] zeroinitializer" & iif( cd, ", comdat", "" ) & ", align 8" & nl
    if cd then r &= "$" & q & "__tko_modfinin" & q & " = comdat any" & nl
    r &= fn & " = linkonce_odr global i32 0" & iif( cd, ", comdat", "" ) & ", align 4" & nl
    if cd then r &= "$" & q & "__tko_modfini_push" & q & " = comdat any" & nl
    r &= "define linkonce_odr void @" & q & "__tko_modfini_push" & q & "(ptr %f) nounwind" & FrameAttr_( e ) & iif( cd, " comdat", "" ) & " {" & nl
    r &= "entry:" & nl
    r &= "  %n = load i32, ptr " & fn & nl
    r &= "  %full = icmp sge i32 %n, 1024" & nl
    r &= "  br i1 %full, label %out, label %put" & nl
    r &= "put:" & nl
    r &= "  %slot = getelementptr inbounds [1024 x ptr], ptr " & fs & ", i32 0, i32 %n" & nl
    r &= "  store ptr %f, ptr %slot" & nl
    r &= "  %n1 = add i32 %n, 1" & nl
    r &= "  store i32 %n1, ptr " & fn & nl
    r &= "  br label %out" & nl
    r &= "out:" & nl & "  ret void" & nl & "}" & nl
    if cd then r &= "$" & q & "__tko_modfini_drain" & q & " = comdat any" & nl
    r &= "define linkonce_odr void @" & q & "__tko_modfini_drain" & q & "()" & FrameAttr_( e ) & iif( cd, " comdat", "" ) & " {" & nl
    r &= "entry:" & nl & "  br label %loop" & nl
    r &= "loop:" & nl
    r &= "  %n = load i32, ptr " & fn & nl
    r &= "  %done = icmp sle i32 %n, 0" & nl
    r &= "  br i1 %done, label %out, label %pop" & nl
    r &= "pop:" & nl
    r &= "  %n1 = sub i32 %n, 1" & nl
    r &= "  store i32 %n1, ptr " & fn & nl
    r &= "  %slot = getelementptr inbounds [1024 x ptr], ptr " & fs & ", i32 0, i32 %n1" & nl
    r &= "  %f = load ptr, ptr %slot" & nl
    r &= "  call void %f()" & nl
    r &= "  br label %loop" & nl
    r &= "out:" & nl & "  ret void" & nl & "}" & nl
    return r
end function

private function ModSym_( byref prefix as string, byref chain as string ) as string
    return "@" & chr( 34 ) & prefix & chain & chr( 34 )
end function

'' The declarations of the other modules' inits this unit calls.
private function ModInitDecls_( byref m as MirModule ) as string
    dim as string r
    for each ch as string in m.modInits
        r &= "declare void " & ModSym_( "__tko_modinit$", ch ) & "()" & chr( 10 )
    next
    return r
end function

'' A MODULE UNIT's init and fini, over the unnumbered structors StructorLists_ set aside.
private function ModUnitIr_ _
    ( byref e as EmitCtx, byref m as MirModule, byref ctors as containers.Array( of int32 ), _
      byref dtors as containers.Array( of int32 ) ) as string
    dim as string nl = chr( 10 )
    dim as string done_ = ModSym_( "__tko_modinit_done$", m.modChain )
    dim as string fini = ModSym_( "__tko_modfini$", m.modChain )
    dim as string r = ModStackIr_( e ) & ModInitDecls_( m )
    r &= done_ & " = internal global i1 false" & nl
    r &= "define internal void " & fini & "()" & FrameAttr_( e ) & " {" & nl & "entry:" & nl
    for k as int32 = 0 to dtors.Count - 1
        r &= "  call void " & GlobalName( e, m.functions[dtors[k]]->name ) & "()" & nl
    next
    r &= "  ret void" & nl & "}" & nl
    r &= "define void " & ModSym_( "__tko_modinit$", m.modChain ) & "()" & FrameAttr_( e ) & " {" & nl & "entry:" & nl
    r &= "  %d = load i1, ptr " & done_ & nl
    r &= "  br i1 %d, label %out, label %run" & nl & "run:" & nl
    r &= "  store i1 true, ptr " & done_ & nl
    for each ch as string in m.modInits
        r &= "  call void " & ModSym_( "__tko_modinit$", ch ) & "()" & nl
    next
    for k as int32 = 0 to ctors.Count - 1
        r &= "  call void " & GlobalName( e, m.functions[ctors[k]]->name ) & "()" & nl
    next
    r &= "  call void " & ModSym_( "__tko_modfini_push", "" ) & "(ptr " & fini & ")" & nl
    r &= "  br label %out" & nl & "out:" & nl & "  ret void" & nl & "}" & nl
    return r
end function

'' A module unit's unnumbered structors, in the order its init and fini call them:
'' _GLOBAL__I, the top-level code, then the 'constructor' subs as declared; the
'' 'destructor' subs reversed, then _GLOBAL__D.
private sub ModUnitOrder_ _
    ( byref e as EmitCtx, byref m as MirModule, byref dflt as containers.Array( of int32 ), _
      byval isCtor as boolean, byref outv as containers.Array( of int32 ) )
    dim as string first_ = iif( isCtor, "_GLOBAL__I", "_GLOBAL__D" )
    if isCtor then
        for each fi as int32 in dflt
            if e.names->Spelling( m.functions[fi]->name ) = first_ then outv.Push( fi )
        next
        for each fi as int32 in dflt
            if left( e.names->Spelling( m.functions[fi]->name ), 9 ) = "fb_ctor__" then outv.Push( fi )
        next
        for each fi as int32 in dflt
            dim as string nm = e.names->Spelling( m.functions[fi]->name )
            dim as boolean other = (nm <> first_)
            if other then other = (left( nm, 9 ) <> "fb_ctor__")
            if other then outv.Push( fi )
        next
    else
        for k as int32 = dflt.Count - 1 to 0 step -1
            if e.names->Spelling( m.functions[dflt[k]]->name ) <> first_ then outv.Push( dflt[k] )
        next
        for each fi as int32 in dflt
            if e.names->Spelling( m.functions[fi]->name ) = first_ then outv.Push( fi )
        next
    end if
end sub

'' MACH-O: THE UNNUMBERED IN LLVM'S LISTS, THE NUMBERED AS RECORDS. Mach-O has a single
'' __mod_init_func section and no numbered ones, so gcc's sections have no spelling there.
'' What LLVM does with the lists, measured (clang 21, arm64-apple-macosx13.0):
'' __mod_init_func holds the constructors STABLE-SORTED by number, so the same numbers
'' keep their declared order; destructors become one 'call_dtors' per number that calls
'' its group REVERSED, registered with __cxa_atexit from the init slot of that number.
'' That orders ONE object. ACROSS objects ld64 keeps link order and ignores the number --
'' measured on the Mac (docs/tiko-macos FACTS "M2 on the Mac"): a 'constructor 101' in a
'' later module ran after an unnumbered one in an earlier module, where linux-x86_64 runs
'' it first, and tests/modules/init-diamond expects 'B:101' before everything.
''
'' So a NUMBERED structor -- the root's 65534 module init and drain included -- is not in
'' the lists at all but a { number, function } record in __DATA,__tko_ctors or
'' __DATA,__tko_dtors (MachoRecord_), kept through -dead_strip by @llvm.used. tiko-rt's
'' fbrt0.o, which LinkExe names FIRST so its constructor runs before every other one,
'' finds every object's records through ld64's section$start / section$end symbols,
'' stable-sorts them by number and runs the constructors in that order; it registers one
'' atexit handler, first of all, that runs the destructors in the reverse of that order
'' and then shuts the runtime down. That is linux-x86_64's order for any link order:
'' 101s, the 65534 module init, the unnumbered; at exit the unnumbered, the drain, the
'' 101s (lib/rt/src/c/fbrt0.c).
private sub ListPush_ _
    ( byref items as string, byref n as int32, byval prio as int32, byref fname as string )
    if n > 0 then items &= ", "
    items &= "{ i32, ptr, ptr } { i32 " & str( prio ) & ", ptr " & fname & ", ptr null }"
    n += 1
end sub

'' One Mach-O priority record: { i64 number, ptr function }, 16 bytes, the layout fbrt0.c's
'' 'struct tko_rec' reads.
private function MachoRecord_ _
    ( byref gn as string, byval isCtor as boolean, byval prio as int32, byref fname as string ) as string
    return gn & " = internal global { i64, ptr } { i64 " & str( prio ) & ", ptr " & fname & _
           " }, section ""__DATA," & iif( isCtor, "__tko_ctors", "__tko_dtors" ) & _
           """, align 8" & chr( 10 )
end function

private function StructorLists_( byref e as EmitCtx, byref m as MirModule ) as string
    dim as string r, used
    dim as int32 nused = 0
    dim as boolean modUnit = (len( m.modChain ) > 0)
    dim as boolean macho = (e.tgt->objFormat = OBJ_MACHO)
    dim as string mCtors, mDtors
    dim as int32 nmCtors = 0, nmDtors = 0
    dim as containers.Array( of int32 ) modCtors, modDtors
    for pass as int32 = 0 to 1
        dim as boolean isCtor = (pass = 0)
        dim as containers.Array( of int32 ) dflt
        for fi as int32 = 0 to m.functions.Count - 1
            dim as MirFunction ptr f = m.functions[fi]
            if f = nullptr then continue for
            dim as boolean want = iif( isCtor, f->isModuleCtor, f->isModuleDtor )
            if want = false then continue for
            dim as boolean unnumbered = (f->structorPrio = 0) orelse (f->structorPrio = 65535)
            if unnumbered then
                dflt.Push( fi )
                continue for
            end if
            if macho then
                dim as string rn = "@__tko_" & iif( isCtor, "ctor.", "dtor." ) & str( nused )
                r += MachoRecord_( rn, isCtor, f->structorPrio, GlobalName( e, f->name ) )
                if nused > 0 then used += ", "
                used += "ptr " & rn
                nused += 1
                continue for
            end if
            '' WRITABLE, except on windows-x86_64. The linker merges a section by name AND
            '' flags, and a read-only '.ctors.65434' did not join mingw's writable
            '' .ctors between __CTOR_LIST__ and __CTOR_END__, so it never ran; clang
            '' marks its own .ctors.NNNNN writable. The .CRT$X fragments are read-only,
            '' as tiko-rt's own brackets are.
            dim as string gn = "@__tko_" & iif( isCtor, "ctor.", "dtor." ) & str( nused )
            dim as string gk = iif( e.tgt->layout.isMsvc, "constant", "global" )
            r += gn & " = internal " & gk & " ptr " & GlobalName( e, f->name ) & _
                 ", section """ & StructorSection_( e, isCtor, f->structorPrio ) & _
                 """, align 8" & chr( 10 )
            if nused > 0 then used += ", "
            used += "ptr " & gn
            nused += 1
        next
        if dflt.Count = 0 then continue for
        if modUnit then
            if isCtor then
                ModUnitOrder_( e, m, dflt, true, modCtors )
            else
                ModUnitOrder_( e, m, dflt, false, modDtors )
            end if
            continue for
        end if
        '' A CLASSIC UNIT'S TOP-LEVEL CODE (fb_ctor__<name>, the code of a module that is not
        '' main) IS DECLARED FIRST, ahead of its 'constructor' subs: fbc-modern 1.20 runs a
        '' non-main module's 'constructor' sub before its top-level code on win64 and after
        '' it on Linux -- the walks above, over that order. tiko had it last, so each
        '' platform ran the two the other way round (T60).
        if isCtor then
            for k as int32 = 0 to dflt.Count - 1
                if left( e.names->Spelling( m.functions[dflt[k]]->name ), 9 ) <> "fb_ctor__" then continue for
                dim as int32 top_ = dflt[k]
                for j as int32 = k to 1 step -1
                    dflt[j] = dflt[j - 1]
                next
                dflt[0] = top_
                exit for
            next
        end if
        if macho then
            for k as int32 = 0 to dflt.Count - 1
                if isCtor then
                    ListPush_( mCtors, nmCtors, 65535, GlobalName( e, m.functions[dflt[k]]->name ) )
                else
                    ListPush_( mDtors, nmDtors, 65535, GlobalName( e, m.functions[dflt[k]]->name ) )
                end if
            next
            continue for
        end if
        dim as boolean rev = (e.tgt->layout.isWindows andalso (e.tgt->layout.isMsvc = false))
        dim as string items
        for k as int32 = 0 to dflt.Count - 1
            dim as int32 fi = dflt[iif( rev, dflt.Count - 1 - k, k )]
            if k > 0 then items += ", "
            items += "{ i32, ptr, ptr } { i32 65535, ptr " & _
                     GlobalName( e, m.functions[fi]->name ) & ", ptr null }"
        next
        r += "@llvm.global_" & iif( isCtor, "ctors", "dtors" ) & " = appending global [" & _
             str( dflt.Count ) & " x { i32, ptr, ptr }] [" & items & "]" & chr( 10 )
    next
    if modUnit then r += ModUnitIr_( e, m, modCtors, modDtors )
    '' A ROOT: every module's init at 65534, and the drain at 65534 (see above).
    if (modUnit = false) andalso (m.modInits.Count > 0) then
        dim as string nl = chr( 10 )
        r += ModStackIr_( e ) & ModInitDecls_( m )
        r += "define internal void " & ModSym_( "__tko_initall", "" ) & "()" & FrameAttr_( e ) & " {" & nl & "entry:" & nl
        for each ch as string in m.modInits
            r += "  call void " & ModSym_( "__tko_modinit$", ch ) & "()" & nl
        next
        r += "  ret void" & nl & "}" & nl
        if macho then
            r += MachoRecord_( "@__tko_ctor.modinit", true, 65534, ModSym_( "__tko_initall", "" ) )
            r += MachoRecord_( "@__tko_dtor.modfini", false, 65534, ModSym_( "__tko_modfini_drain", "" ) )
        else
            dim as string gk = iif( e.tgt->layout.isMsvc, "constant", "global" )
            r += "@__tko_ctor.modinit = internal " & gk & " ptr " & ModSym_( "__tko_initall", "" ) & _
                 ", section " & chr( 34 ) & StructorSection_( e, true, 65534 ) & chr( 34 ) & ", align 8" & nl
            r += "@__tko_dtor.modfini = internal " & gk & " ptr " & ModSym_( "__tko_modfini_drain", "" ) & _
                 ", section " & chr( 34 ) & StructorSection_( e, false, 65534 ) & chr( 34 ) & ", align 8" & nl
        end if
        if nused > 0 then used += ", "
        used += "ptr @__tko_ctor.modinit, ptr @__tko_dtor.modfini"
        nused += 2
    end if
    if nmCtors > 0 then
        r += "@llvm.global_ctors = appending global [" & str( nmCtors ) & " x { i32, ptr, ptr }] [" & _
             mCtors & "]" & chr( 10 )
    end if
    if nmDtors > 0 then
        r += "@llvm.global_dtors = appending global [" & str( nmDtors ) & " x { i32, ptr, ptr }] [" & _
             mDtors & "]" & chr( 10 )
    end if
    if nused > 0 then
        r += "@llvm.used = appending global [" & str( nused ) & " x ptr] [" & used & _
             "], section ""llvm.metadata""" & chr( 10 )
    end if
    return r
end function
