'' objinfo.tiko -- the '.fbctinf' section, written and read. See objinfo.ti.

#import "std/containers"
#include once "codegen/objinfo.ti"

namespace Tko.Codegen

'' Every byte that is not plainly printable is escaped, as CString in llvmemit.tiko does.
private function IrBytes_( byref b as string ) as string
    dim as string r = "c"""
    for i as int32 = 0 to len( b ) - 1
        dim as int32 ch = b[i]
        dim as boolean plain = (ch >= 32) andalso (ch <= 126)
        if (ch = 34) orelse (ch = 92) then plain = false
        if plain then
            r += chr( ch )
        else
            r += "\" & hex( ch, 2 )
        end if
    next
    return r & """"
end function

private sub AddEntries_( byref blob as string, byval flag as string, byref v as StrVec )
    for i as int32 = 0 to v.Count - 1
        blob += flag & chr( 0 ) & v[i] & chr( 0 )
    next
end sub

'' The directory part of a path, with its separator, and "" when there is none.
private function DirOf_( byref p as string ) as string
    for i as int32 = len( p ) to 1 step -1
        if (p[i - 1] = 47) orelse (p[i - 1] = 92) then return left( p, i )
    next
    return ""
end function

private function Exists_( byref p as string ) as boolean
    dim as int32 fh = freefile
    if open( p for binary access read as #fh ) <> 0 then return false
    close #fh
    return true
end function

'' fbc's shape: an internal constant in the section, kept alive by llvm.compiler.used so
'' the optimiser does not drop a global nothing references. A Mach-O section is named
'' 'segment,section' -- '__DATA,__fbctinf', the section name 16 bytes at most.
function ObjInfoIr _
    ( byref libs as StrVec, byref pragmaLibs as StrVec, _
      byref libPaths as StrVec, byref pragmaLibPaths as StrVec, _
      byref libFiles as StrVec, byval threadSafe as boolean, _
      byref modObjs as StrVec, byval fmt as ObjFormat ) as string

    dim as string blob
    '' A '#foreignlib' file as ':name' and its directory, ABSOLUTE: the object is
    '' linked later, from wherever the link runs. fbc writes the same.
    dim as StrVec fileDirs
    for i as int32 = 0 to libFiles.Count - 1
        dim as string d = DirOf_( libFiles[i] )
        blob += "-l" & chr( 0 ) & ":" & mid( libFiles[i], len( d ) + 1 ) & chr( 0 )
        dim as boolean absolute_ = (instr( d, ":" ) > 0) orelse (left( d, 1 ) = "/") _
                                   orelse (left( d, 1 ) = "\")
        if absolute_ = false then d = curdir( ) & "/" & d
        if (len( d ) > 1) andalso ((right( d, 1 ) = "/") orelse (right( d, 1 ) = "\")) then
            d = left( d, len( d ) - 1 )
        end if
        dim as boolean seen = false
        for k as int32 = 0 to fileDirs.Count - 1
            if fileDirs[k] = d then seen = true
        next
        if seen = false then fileDirs.Push( d )
    next
    AddEntries_( blob, "-l", libs )
    AddEntries_( blob, "-l", pragmaLibs )
    AddEntries_( blob, "-p", fileDirs )
    AddEntries_( blob, "-p", libPaths )
    AddEntries_( blob, "-p", pragmaLibPaths )
    if threadSafe then blob += "-mt" & chr( 0 )
    AddEntries_( blob, "-tkomod", modObjs )
    if len( blob ) = 0 then return ""
    dim as string sect = iif( fmt = OBJ_MACHO, "__DATA,__fbctinf", ".fbctinf" )
    return chr( 10 ) & "@__fbctinf = internal constant [" & str( len( blob ) ) & " x i8] " & _
           IrBytes_( blob ) & ", section " & chr( 34 ) & sect & chr( 34 ) & chr( 10 ) & _
           "@llvm.compiler.used = appending global [1 x ptr] [ptr @__fbctinf], " & _
           "section ""llvm.metadata""" & chr( 10 )
end function

private function U16_( byref b as string, byval at_ as int64 ) as int64
    if (at_ < 0) orelse (at_ + 2 > len( b )) then return 0
    return b[at_] or (clngint( b[at_ + 1] ) shl 8)
end function

private function U32_( byref b as string, byval at_ as int64 ) as int64
    if (at_ < 0) orelse (at_ + 4 > len( b )) then return 0
    return b[at_] or (clngint( b[at_ + 1] ) shl 8) or _
           (clngint( b[at_ + 2] ) shl 16) or (clngint( b[at_ + 3] ) shl 24)
end function

private function SliceOf_( byref b as string, byval off as int64, byval n as int64 ) as string
    if (off < 0) orelse (n <= 0) orelse (off + n > len( b )) then return ""
    return mid( b, off + 1, n )
end function

'' The section's bytes in a 64-bit Mach-O object. An MH_OBJECT's one LC_SEGMENT_64 (&h19,
'' 72-byte header, nsects at +64) holds every section_64 -- 80 bytes: sectname 16,
'' segname 16, addr 8, size 8, offset 4, ... -- and ours is '__fbctinf' in '__DATA'.
private function MachoSectionBytes_( byref b as string ) as string
    dim as int64 lc = 32
    for c as int64 = 1 to U32_( b, 16 )
        dim as int64 csz = U32_( b, lc + 4 )
        if csz < 8 then return ""
        if U32_( b, lc ) = &h19 then
            for i as int64 = 0 to U32_( b, lc + 64 ) - 1
                dim as int64 h = lc + 72 + i * 80
                dim as boolean hit = (SliceOf_( b, h, 10 ) = "__fbctinf" & chr( 0 ))
                if hit then hit = (SliceOf_( b, h + 16, 7 ) = "__DATA" & chr( 0 ))
                if hit then
                    return SliceOf_( b, U32_( b, h + 48 ), U32_( b, h + 40 ) or (U32_( b, h + 44 ) shl 32) )
                end if
            next
        end if
        lc += csz
    next
    return ""
end function

'' The section's bytes in an x86-64 ELF64, COFF or 64-bit Mach-O object, or "" when it has
'' none. The formats tiko targets; anything else answers "" rather than guessing.
private function SectionBytes_( byref b as string ) as string
    dim as int64 sz = len( b )
    if sz < 64 then return ""
    if (b[0] = &hCF) andalso (b[1] = &hFA) andalso (b[2] = &hED) andalso (b[3] = &hFE) then
        return MachoSectionBytes_( b )
    end if
    if (b[0] = &h7F) andalso (b[1] = &h45) andalso (b[2] = &h4C) andalso (b[3] = &h46) then
        if b[4] <> 2 then return ""
        dim as int64 shoff = U32_( b, &h28 ) or (U32_( b, &h2C ) shl 32)
        dim as int64 shnum = U16_( b, &h3C )
        dim as int64 strndx = U16_( b, &h3E )
        if (U16_( b, &h3A ) <> 64) orelse (strndx >= shnum) then return ""
        dim as int64 names_ = U32_( b, shoff + strndx * 64 + &h18 )
        for i as int64 = 1 to shnum - 1
            dim as int64 h = shoff + i * 64
            dim as int64 nm = names_ + U32_( b, h )
            if (nm + 9 <= sz) andalso (mid( b, nm + 1, 8 ) = ".fbctinf") andalso (b[nm + 8] = 0) then
                return SliceOf_( b, U32_( b, h + &h18 ), U32_( b, h + &h20 ) )
            end if
        next
        return ""
    end if
    '' COFF, EITHER x86 WIDTH: &h8664 machine is x86-64, &h014C is i386 (TARGET_WIN32).
    '' A .fbctinf section is arch-independent bytes, so both are read the same way.
    if (U16_( b, 0 ) <> &h8664) andalso (U16_( b, 0 ) <> &h14C) then return ""
    if U16_( b, 16 ) <> 0 then return ""
    for i as int64 = 0 to U16_( b, 2 ) - 1
        dim as int64 h = 20 + i * 40
        if mid( b, h + 1, 8 ) = ".fbctinf" then
            return SliceOf_( b, U32_( b, h + 20 ), U32_( b, h + 16 ) )
        end if
    next
    return ""
end function

sub ReadObjInfo _
    ( byref path as string, byref libs as StrVec, _
      byref libPaths as StrVec, byref libFiles as StrVec, _
      byref threadSafe as boolean, byref modObjs as StrVec )

    dim as int32 fh = freefile
    if open( path for binary access read as #fh ) <> 0 then return
    dim as string b
    if lof( fh ) > 0 then
        b = space( lof( fh ) )
        get #fh, , b
    end if
    close #fh

    '' A first byte of &h10 is the pre-0.25 format, which nothing tiko links can carry.
    dim as string s = SectionBytes_( b )
    if (len( s ) = 0) orelse (s[0] = &h10) then return
    dim as string pending
    dim as StrVec exact, dirs
    dim as int64 at_ = 1
    while at_ <= len( s )
        dim as int64 z = instr( at_, s, chr( 0 ) )
        if z = 0 then z = len( s ) + 1
        dim as string w = mid( s, at_, z - at_ )
        at_ = z + 1
        if pending = "-l" then
            if left( w, 1 ) = ":" then
                if len( w ) > 1 then exact.Push( mid( w, 2 ) )
            elseif len( w ) > 0 then
                libs.Push( w )
            end if
            pending = ""
        elseif pending = "-tkomod" then
            if len( w ) > 0 then modObjs.Push( w )
            pending = ""
        elseif pending = "-p" then
            if len( w ) > 0 then
                libPaths.Push( w )
                dirs.Push( w )
            end if
            pending = ""
        elseif (w = "-l") orelse (w = "-p") orelse (w = "-tkomod") then
            pending = w
        elseif w = "-mt" then
            threadSafe = true
        end if
    wend

    '' An EXACT file, looked for in the section's own directories in order. One found
    '' nowhere stays '-l:name', which GNU ld and ld.lld search -L for themselves.
    for i as int32 = 0 to exact.Count - 1
        dim as string hit = ""
        for k as int32 = 0 to dirs.Count - 1
            dim as string cand = dirs[k] & "/" & exact[i]
            if Exists_( cand ) then
                hit = cand
                exit for
            end if
        next
        if len( hit ) > 0 then
            libFiles.Push( hit )
        else
            libs.Push( ":" & exact[i] )
        end if
    next
end sub

'' WHAT CLANG ACTUALLY WROTE, for the driver's check that it is what the target makes
'' (driver.tiko, ObjectChecks_).
''
'' Four bytes settle it. ELF starts 7F 'E' 'L' 'F'; a COFF object starts with its
'' machine word, 0x8664 little-endian for x86-64, or FF FF for the bigobj header
'' clang emits when a module has more sections than the short form can count; a 64-bit
'' Mach-O object starts CF FA ED FE.
''
'' ONLY A DEFINITE MISMATCH IS AN ERROR. Anything unrecognised is left alone --
'' '-flto' would put LLVM bitcode here, which is neither of these and is not wrong.
function ObjectFormatOf( byref path_ as string, byref known as boolean ) as ObjFormat
    known = false
    dim as int32 fh = freefile
    if open( path_ for binary access read as #fh ) <> 0 then return OBJ_COFF
    dim as uint8 b(0 to 3)
    dim as int64 n = 4
    get #fh, 1, b(0), n
    close #fh
    if n < 4 then return OBJ_COFF
    known = true
    if (b(0) = &h7F) andalso (b(1) = asc( "E" )) andalso _
       (b(2) = asc( "L" )) andalso (b(3) = asc( "F" )) then return OBJ_ELF
    '' COFF machine types, little-endian: &h8664 is x86-64, &h014C is i386.
    if (b(0) = &h64) andalso (b(1) = &h86) then return OBJ_COFF
    if (b(0) = &h4C) andalso (b(1) = &h01) then return OBJ_COFF
    if (b(0) = &hFF) andalso (b(1) = &hFF) then return OBJ_COFF
    '' MH_MAGIC_64, 0xFEEDFACF, little-endian: a 64-bit Mach-O object.
    if (b(0) = &hCF) andalso (b(1) = &hFA) andalso (b(2) = &hED) andalso (b(3) = &hFE) then
        return OBJ_MACHO
    end if
    known = false
    return OBJ_COFF
end function

function ObjFormatName( byval f as ObjFormat ) as string
    select case f
    case OBJ_COFF  : return "COFF"
    case OBJ_ELF   : return "ELF"
    case OBJ_MACHO : return "Mach-O"
    end select
    Tko.TargetIce( "ObjFormatName", f )
    return ""
end function

end namespace
