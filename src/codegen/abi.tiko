'' abi.tiko -- see the header for the rule and where it was measured.

#import "std/containers"
#include once "codegen/abi.ti"

namespace Tko.Codegen

using Tko.Mir

function DirectIntType( byval sizeBytes as int32 ) as MirType
    select case sizeBytes
    case 1 : return MT_I8
    case 2 : return MT_I16
    case 4 : return MT_I32
    case 8 : return MT_I64
    end select
    return MT_VOID
end function

'' WIN64 OR SysV, AND NOTHING ELSE REACHES A CLASSIFIER. Every test in this file used to be
'' 'abi = ABI_WIN64', with SysV as whatever was left -- so a third ABI would have been
'' classified as SysV in eight places at once. ABI_AAPCS64_APPLE takes its own branch,
'' ahead of every call to this; reaching here with it is a compiler bug.
private function AbiIsAapcs_( byref target as TargetDescription ) as boolean
    return (target.abi = ABI_AAPCS64_APPLE)
end function

'' THE AAPCS64 HALF -- AapcsHfaType, AapcsArgType, AapcsRetType, AapcsSlotSize --
'' is the abiaapcs unit beside this one: this file passed the 1500-line lint cap,
'' and those four are the pieces only this unit's callers reach.

private function AbiIsWin64_( byref target as TargetDescription ) as boolean
    select case target.abi
    case ABI_WIN64      : return true
    case ABI_SYSV_AMD64 : return false
    end select
    Tko.TargetIce( "abi classifier", target.id )
    return false
end function

'' ABI_WIN32 TAKES ITS OWN BRANCH, ahead of every call to AbiIsWin64_, the way
'' AAPCS64 does: the size-only question it answers is not win64's.
private function AbiIsWin32_( byref target as TargetDescription ) as boolean
    return (target.abi = ABI_WIN32)
end function

function ClassifyAggregate _
    ( byval sizeBytes as int32, byref target as TargetDescription ) as AbiClassKind

    if AbiIsAapcs_( target ) then
        if sizeBytes > 16 then return ABIC_INDIRECT
        return ABIC_DIRECT_INT
    end if
    if AbiIsWin32_( target ) then
        '' EVERY AGGREGATE ON THE STACK, at every size: i386 cdecl has no register
        '' classes to coerce into, and the signature spells 'ptr byval'.
        return ABIC_INDIRECT
    end if
    if AbiIsWin64_( target ) then
        if DirectIntType( sizeBytes ) <> MT_VOID then return ABIC_DIRECT_INT
        return ABIC_INDIRECT
    end if
    '' SysV: over sixteen bytes is MEMORY, and the rest is decided by the EIGHTBYTE
    '' CLASSES, which a size cannot answer -- see SysvClass below. This entry point is
    '' kept for the size-only question the win64 path asks.
    if sizeBytes > 16 then return ABIC_INDIRECT
    return ABIC_DIRECT_INT
end function

'' The MIR type one SysV eightbyte travels in.
''
'' 'nbytes' is how much of the aggregate this eightbyte actually covers -- the last one
'' is often partial, and a twelve-byte aggregate's second eightbyte is four bytes, which
'' clang passes as i32 rather than i64.
''
'' AN SSE EIGHTBYTE BECOMES 'double' (or 'float' when partial) WHERE CLANG WRITES
'' '<2 x float>'. MIR has no vector type and adding one for this would be a large change
'' to every layer. The two are register-compatible -- both occupy the low bits of one
'' XMM and nothing else is passed there -- but that is an ARGUMENT, not a measurement,
'' and it is the reason tests/abi has to run a real cross-ABI call before this is
'' trusted. It is written down here so the assumption is findable rather than implicit.
function SysvEightbyteType _
    ( byval cls as uint32, byval nbytes as int32 ) as MirType

    if cls = TKO_EB_SSE then
        if nbytes <= 4 then return MT_F32
        return MT_F64
    end if
    select case nbytes
    case 1 : return MT_I8
    case 2 : return MT_I16
    case 3, 4 : return MT_I32
    end select
    return MT_I64
end function

'' A RETURN IN REGISTERS, AND WHICH ONES.
''
'' SysV returns an aggregate of sixteen bytes or fewer in registers, one per eightbyte,
'' and clang spells that as a literal struct -- '{ i64, i32 }' for a twelve-byte struct
'' of integers, '{ double, double }' for two doubles in XMM0 and XMM1. MirFunction
'' carries the second register in retTy2 and the emitter writes the pair.
''
'' ONLY THE SIZES ONE INTEGER FITS WERE MODELLED BEFORE, and every other one was
'' declined -- first measured as eight verifier failures on tests/mir/src/udt-return.bas,
'' then as 83 of the 85 modules of tiko-lang's own Linux bootstrap, every one of them
'' 'Array( of T ).GetIterator'. And a struct holding one double went back in RAX where
'' SysV says XMM0.
''
'' True, with the register types, when the return is direct. MEMORY, and anything over
'' sixteen bytes, is not: those take the hidden pointer. An aggregate with NO recorded
'' class keeps the size-only rule it always had -- a guessed class is a silent ABI
'' mismatch.
private function RetDirect_ _
    ( byval sz as int32, byval cls as uint32, byref target as TargetDescription, _
      byref t0 as MirType, byref t1 as MirType ) as boolean

    t1 = MT_VOID
    if AbiIsAapcs_( target ) then
        t0 = AapcsRetType( sz, cls )
        return (t0 <> MT_VOID)
    end if
    if AbiIsWin32_( target ) then
        '' ABI_WIN32, MEASURED, clang 21.1.3, 'i686-w64-windows-gnu', struct returns
        '' of every size from 1 to 24 bytes:
        ''
        ''     1, 2, 4 bytes      the integer of the size (i8, i16, i32) -- except a
        ''                        4-byte struct whose one field is float, which comes
        ''                        back in st0 as 'float', so the class decides at 4 too
        ''     3 bytes            sret (a hidden pointer), align 1
        ''     5, 6, 7, 8 bytes   i64, whatever the fields are: {int,int} as i64,
        ''                        {float,float} as i64, {float,int} as i64 -- packed
        ''                        into edx:eax -- except ONE eightbyte of SSE covering
        ''                        all eight bytes ({double}), which is 'double' in st0
        ''     over 8 bytes       sret, at the struct's own alignment (measured 4 and 8)
        ''
        '' The class is the frontend's eightbyte walk, which runs for this target as
        '' for SysV; with NO class recorded the size-only integer stands, as SysV's
        '' fallback does. retTy2 stays MT_VOID always: nothing on i386 returns a
        '' two-register PAIR that the i64 spelling does not cover.
        dim as uint32 e0 = TKO_EB0( cls )
        if sz > 8 then return false
        if sz <= 2 then return (DirectIntType( sz ) <> MT_VOID)
        if sz = 3 then return false
        if sz = 4 then
            if (e0 = TKO_EB_SSE) andalso (TKO_EB1( cls ) = TKO_EB_NONE) then
                t0 = MT_F32
            else
                t0 = MT_I32
            end if
            return true
        end if
        if (e0 = TKO_EB_SSE) andalso (TKO_EB1( cls ) = TKO_EB_NONE) then
            t0 = MT_F64
        else
            t0 = MT_I64
        end if
        return true
    end if
    t0 = DirectIntType( sz )
    if AbiIsWin64_( target ) then return (t0 <> MT_VOID)
    if (sz > 16) orelse (cls = TKO_EB_MEMORY) then return false
    if cls = 0 then return (t0 <> MT_VOID)
    dim as int32 n0 = sz
    if n0 > 8 then n0 = 8
    t0 = SysvEightbyteType( TKO_EB0( cls ), n0 )
    if sz > 8 then t1 = SysvEightbyteType( TKO_EB1( cls ), sz - 8 )
    return true
end function

'' ...and the one SysV shape left with no answer: no class recorded, and a size no
'' single integer fits. Declined, so the emitter says so.
private function SysvReturnUnmodelled_ _
    ( byval sz as int32, byval cls as uint32, byref target as TargetDescription ) as boolean

    '' AAPCS64 models every size.
    if AbiIsAapcs_( target ) then return false
    '' So does ABI_WIN32: at most eight bytes, and RetDirect_ answers every size.
    if AbiIsWin32_( target ) then return false
    if AbiIsWin64_( target ) then return false
    if (sz <= 0) orelse (sz > 16) then return false
    return (cls = 0) andalso (DirectIntType( sz ) = MT_VOID)
end function

'' A SysV register slot is WHOLE EIGHTBYTES: a register is loaded out of it and stored
'' into it at full width, and a thirteen-byte slot would take an i64 at offset 8.
private function RegSlotSize_( byval sz as int32, byref target as TargetDescription ) as int32
    if AbiIsAapcs_( target ) then return AapcsSlotSize( sz )
    if AbiIsWin32_( target ) then
        '' ABI_WIN32: a direct return travels in the register(s) its size picks, and the
        '' slot holds exactly the aggregate -- an i64 load of a 5-byte return reads the
        '' three bytes past it in edx:eax's other half, not in a slot.
        return sz
    end if
    if AbiIsWin64_( target ) then return sz
    return (sz + 7) and (not 7)
end function

'' THE BYTES A SysV ARGUMENT'S REGISTERS TOUCH in a slot holding SZ: each eightbyte is
'' loaded or stored at the width SysvEightbyteType gives it, which is wider than what is
'' left when the last one is 3, 5, 6 or 7 bytes -- 'i32' over 3, 'i64' over 5 to 7.
'' Every other size is exactly its registers. Win64 passes no aggregate in pieces.
private function ArgSlotSize_( byval sz as int32, byref target as TargetDescription ) as int32
    if AbiIsAapcs_( target ) then return AapcsSlotSize( sz )
    if AbiIsWin32_( target ) then
        '' ABI_WIN32: every aggregate argument is a byval copy, and the slot IS the copy.
        return sz
    end if
    if AbiIsWin64_( target ) then return sz
    dim as int32 tail_ = sz and 7
    select case tail_
    case 3 : return sz + 1
    case 5, 6, 7 : return sz - tail_ + 8
    end select
    return sz
end function

'' ---------------------------------------------------------------- helpers
''
'' The pass builds each block's instruction list ANEW rather than inserting into the
'' existing one. FB.Array has no insert, and more to the point a rewrite that walks
'' forwards while mutating in place is where off-by-one bugs live: this way the old
'' list is read-only and the new one is append-only.

type Rewriter
    as MirModule ptr    m
    as MirFunction ptr  f
    as MirInstVec       outp        '' the block being built
    as AbiStats ptr     st
    as TargetDescription ptr tgt
    '' THE NEW SLOTS' ALLOCAS, held aside and flushed into the entry block after every
    '' block has been rebuilt. Pushing them straight into block 0 does not work: block 0
    '' is itself rebuilt from 'outp', and the rebuild clears exactly what was pushed. The
    '' verifier did not catch it -- it has no rule that a slot must be allocated -- and
    '' clang did: "use of undefined value '%s10'".
    as MirInstVec       pendingAllocas
end type

'' A fresh aggregate slot, plus its alloca in the entry block. Every aggregate that
'' crosses a call boundary gets one: a DIRECT argument is loaded out of it as an
'' integer, an INDIRECT one is passed by its address. That is what clang emits too --
'' a fresh copy per call, never a reuse of the caller's own storage.
private function NewAggSlot _
    ( byref r as Rewriter, byval sizeBytes as int32, byref names as Tko.Interner ) as int32

    dim as MirLocal l
    l.name = names.GetString( "$abi" & str( r.f->locals.Count ) )
    l.ty = cast( uint8, MT_AGG )
    l.size = sizeBytes
    l.sym = 0
    r.f->locals.Push( l )
    dim as int32 slot = r.f->locals.Count - 1

    '' THE ALLOCA GOES IN THE ENTRY BLOCK, which is a verifier rule and also what lets
    '' LLVM's mem2reg promote the slot. Appended rather than inserted: an alloca may
    '' follow other allocas, and nothing in the entry block reads this slot before the
    '' point the value is stored into it.
    dim as MirInst a
    a.op = cast( uint16, M_ALLOCA )
    a.ty = cast( uint8, MT_PTR )
    a.imm = slot
    a.result = r.f->nextTemp
    r.f->nextTemp += 1
    r.pendingAllocas.Push( a )
    return slot
end function

private function LocalVal( byval slot as int32 ) as MirValue
    dim as MirValue v
    v.kind = cast( uint8, MV_LOCAL )
    v.ty = cast( uint8, MT_PTR )
    v.id = slot
    return v
end function

private function TempVal( byval id as uint32, byval ty as MirType ) as MirValue
    dim as MirValue v
    v.kind = cast( uint8, MV_TEMP )
    v.ty = cast( uint8, ty )
    v.id = id
    return v
end function

'' Store an aggregate VALUE into a slot, so that it has an address to be passed by or
'' loaded out of. MIR spells an aggregate copy as a load and a store of the aggregate
'' itself, which is what LLVM does with '[N x i8]' as well.
private sub StoreAggInto _
    ( byref r as Rewriter, byval slot as int32, byref v as MirValue, _
      byval sizeBytes as int32 )

    dim as MirInst s
    s.op = cast( uint16, M_STORE )
    s.ty = cast( uint8, MT_VOID )
    s.a = LocalVal( slot )
    s.b = v
    '' THE SIZE, WRITTEN DOWN. An aggregate copy through an address that is not a local
    '' slot cannot be sized by looking at the address, and the emitter would otherwise
    '' move zero bytes. This pass always knows the number.
    s.imm = sizeBytes
    r.outp.Push( s )
end sub

'' The address of a byte offset inside something. SysV's second eightbyte lives eight
'' bytes into the copy, and M_FIELD_ADDR is exactly a base plus a constant byte offset.
private function FieldAddr _
    ( byref r as Rewriter, byref base_ as MirValue, byval off as int32 ) as MirValue

    dim as MirInst g
    g.op = cast( uint16, M_FIELD_ADDR )
    g.ty = cast( uint8, MT_PTR )
    g.a = base_
    g.imm = off
    g.result = r.f->nextTemp
    r.f->nextTemp += 1
    r.outp.Push( g )
    return TempVal( g.result, MT_PTR )
end function

'' Load from an address at a given type, returning the new temp.
private function LoadAs _
    ( byref r as Rewriter, byref addr as MirValue, byval ty as MirType, _
      byval sizeBytes as int32 = 0 ) as MirValue

    dim as MirInst l
    l.op = cast( uint16, M_LOAD )
    l.ty = cast( uint8, ty )
    l.a = addr
    l.imm = sizeBytes
    l.result = r.f->nextTemp
    r.f->nextTemp += 1
    r.outp.Push( l )
    return TempVal( l.result, ty )
end function

'' EVERY AGGREGATE ARGUMENT IS MATERIALISED INTO A FRESH SLOT FIRST, whatever its
'' class. One rule instead of several, it needs no def-use analysis to find where the
'' value came from, and it is what clang emits: a per-call copy the callee owns. The
'' direct cases then load out of that slot, which looks wasteful and is not -- LLVM's
'' SROA removes the slot and leaves the loads.
''
'' THE ARGUMENT RUN IS REBUILT RATHER THAN PATCHED, because on SysV one aggregate can
'' become TWO arguments: a twelve-byte struct is passed as 'i64, i32'. An in-place
'' patch cannot express that, and the signature rewrite expands the same way from the
'' same original signature, so the two agree by construction.
'' Used by RewriteParamStore, which runs before this file defines it.
declare function NewParamIndex_ _
    ( byref r as Rewriter, byval oldIdx as int32 ) as int32

private sub RewriteCallArgs _
    ( byref r as Rewriter, byref ins as MirInst, byval callee as MirFunction ptr, _
      byref names as Tko.Interner )

    if callee = nullptr then return
    '' THE RUN IS REBUILT FOR A WIDENED ARGUMENT TOO, not only for an aggregate. This
    '' used to leave early unless some parameter was MT_AGG, so a call whose only ABI
    '' business was 'i8 -> i32 zeroext' kept its narrow argument and clang refused the
    '' module: "'%t16' defined with type 'i8' but expected 'i32'".
    dim as boolean anyAgg = false
    dim as boolean anyExt = false
    for i as int32 = 0 to ins.count - 1
        if i >= callee->paramTys.Count then exit for
        if cast( MirType, callee->paramTys[i] ) = MT_AGG then anyAgg = true
        if i < callee->paramExt.Count then
            if callee->paramExt[i] <> TKO_PX_NONE then anyExt = true
        end if
    next
    '' Apple arm64 passes it narrow, with an attribute -- see RewriteSignature.
    if AbiIsAapcs_( *r.tgt ) then anyExt = false
    if (anyAgg = false) andalso (anyExt = false) then return

    dim as int32 oldFirst = ins.first
    dim as int32 oldCount = ins.count
    '' The new run goes on the END of the pool. The old one is left where it is --
    '' nothing reclaims argument-pool space, and a run that is still referenced by an
    '' instruction this pass has not reached yet must not be disturbed.
    dim as int32 newFirst = r.m->argPool.Count \ 2
    dim as int32 newCount = 0

    for i as int32 = 0 to oldCount - 1
        dim as int32 k = (oldFirst + i) * 2
        if (k + 1) >= r.m->argPool.Count then exit for
        dim as MirValue av
        av.kind = cast( uint8, r.m->argPool[k] )
        av.id = r.m->argPool[k + 1]

        dim as MirType pt = MT_I64
        if i < callee->paramTys.Count then pt = cast( MirType, callee->paramTys[i] )
        if pt <> MT_AGG then
            '' A NARROW ARGUMENT IS WIDENED TO MATCH THE PARAMETER -- the call-site half
            '' of MirFunction.paramExt, and the reason it lives beside the signature
            '' rewrite: both expand from the SAME original signature, so a call and the
            '' callee cannot disagree about the register's upper bits. SEXT or ZEXT is
            '' the callee's business, not the argument's: the parameter's FB type is
            '' what fbc widens by.
            '' THE EXTENSION CLASS DECIDES, not the parameter's CURRENT type: this
            '' function's signature may already have been rewritten to i32 by the time
            '' one of its callers is walked, and asking "is the parameter still narrow"
            '' then answered no and left the argument at i8. paramExt survives the
            '' rewrite for exactly this reason.
            dim as uint8 ex = TKO_PX_NONE
            if i < callee->paramExt.Count then ex = callee->paramExt[i]
            '' NOT AN OPERAND THAT HAS NO VALUE. A declined argument reaches here with
            '' MV_NONE, and wrapping one in a sext produced an instruction whose operand
            '' had no kind: the emitter ICEd on 'sext %80' in the two
            '' generics/fail-container-nohash suites, which fbc rejects as well. It is
            '' passed through exactly as it was before the widening existed.
            if av.kind = cast( uint8, MV_NONE ) then ex = TKO_PX_NONE
            if AbiIsAapcs_( *r.tgt ) then ex = TKO_PX_NONE
            if ex <> TKO_PX_NONE then
                dim as MirInst xt
                if ex = TKO_PX_SIGN then
                    xt.op = cast( uint16, M_SEXT )
                else
                    xt.op = cast( uint16, M_ZEXT )
                end if
                xt.ty = cast( uint8, MT_I32 )
                xt.a = av
                xt.result = r.f->nextTemp
                r.f->nextTemp += 1
                r.outp.Push( xt )
                r.m->argPool.Push( cast( uint32, MV_TEMP ) )
                r.m->argPool.Push( xt.result )
                newCount += 1
                r.st->coercedParams += 1
                continue for
            end if
            r.m->argPool.Push( cast( uint32, av.kind ) )
            r.m->argPool.Push( av.id )
            newCount += 1
            continue for
        end if

        dim as int32 sz = cast( int32, callee->paramAggs[i] )
        if sz <= 0 then
            '' An aggregate whose size was never recorded. Passed through untouched so
            '' the emitter ICEs on it and says so; a guessed width would move a
            '' different number of bytes at each end of the call.
            r.st->declined += 1
            r.m->argPool.Push( cast( uint32, av.kind ) )
            r.m->argPool.Push( av.id )
            newCount += 1
            continue for
        end if

        '' The per-call copy -- as wide as its REGISTERS on SysV, because each one is
        '' loaded out of it at its full width: a 3-byte argument was 'load i32' from an
        '' '[3 x i8]' slot and a 5-byte one 'load i64', reading past the copy, and at -O1
        '' LLVM folded the out-of-bounds bytes to poison. See ArgSlotSize_.
        av.ty = cast( uint8, MT_AGG )
        dim as int32 slot = NewAggSlot( r, ArgSlotSize_( sz, *r.tgt ), names )
        if (av.kind = cast( uint8, MV_LOCAL )) orelse (av.kind = cast( uint8, MV_GLOBAL )) then
            dim as MirValue loaded = LoadAs( r, av, MT_AGG, sz )
            StoreAggInto( r, slot, loaded, sz )
        else
            StoreAggInto( r, slot, av, sz )
        end if

        '' ---- AAPCS64: ONE argument, whatever the shape -- the array, the integer, or the
        '' copy's address -- so the run never grows.
        if AbiIsAapcs_( *r.tgt ) then
            dim as uint32 acls = 0
            if i < callee->paramClasses.Count then acls = callee->paramClasses[i]
            dim as MirType at_ = AapcsArgType( sz, acls )
            if at_ = MT_PTR then
                r.m->argPool.Push( cast( uint32, MV_LOCAL ) )
                r.m->argPool.Push( cast( uint32, slot ) )
                r.st->indirectParams += 1
            else
                dim as MirValue av2 = LoadAs( r, LocalVal( slot ), at_ )
                r.m->argPool.Push( cast( uint32, av2.kind ) )
                r.m->argPool.Push( av2.id )
                r.st->coercedParams += 1
            end if
            newCount += 1
            continue for
        end if

        if AbiIsWin32_( *r.tgt ) then
            '' EVERY AGGREGATE ON THE STACK, at every size: the slot's address is the
            '' argument and the signature marks it byval. clang spells the small ones
            '' flattened -- 'i32, i32' for {int,int}, one 'i64' for {long long} --
            '' but on i386 cdecl a flattened argument and a byval copy put THE SAME
            '' BYTES at the same stack offsets, so the two spellings interoperate in
            '' both directions. Measured against clang 21.1.3 for aggregates of 1, 2,
            '' 3, 4, 5, 7, 8, 12, 16, 20 and 24 bytes, and for float and double
            '' fields of every shape it flattens.
            r.m->argPool.Push( cast( uint32, MV_LOCAL ) )
            r.m->argPool.Push( cast( uint32, slot ) )
            newCount += 1
            r.st->indirectParams += 1
            continue for
        end if

        if AbiIsWin64_( *r.tgt ) then
            if ClassifyAggregate( sz, *r.tgt ) = ABIC_DIRECT_INT then
                dim as MirValue iv = LoadAs( r, LocalVal( slot ), DirectIntType( sz ) )
                r.m->argPool.Push( cast( uint32, iv.kind ) )
                r.m->argPool.Push( iv.id )
                newCount += 1
                r.st->coercedParams += 1
            else
                r.m->argPool.Push( cast( uint32, MV_LOCAL ) )
                r.m->argPool.Push( cast( uint32, slot ) )
                newCount += 1
                r.st->indirectParams += 1
            end if
            continue for
        end if

        '' ---- SysV
        dim as uint32 packed = callee->paramClasses[i]
        if (sz > 16) orelse (packed = TKO_EB_MEMORY) orelse (packed = 0) then
            '' MEMORY: the slot's address, and the signature marks it byval so it
            '' travels on the stack rather than as a pointer in a register.
            r.m->argPool.Push( cast( uint32, MV_LOCAL ) )
            r.m->argPool.Push( cast( uint32, slot ) )
            newCount += 1
            r.st->indirectParams += 1
            continue for
        end if
        '' One register per eightbyte, loaded from the copy at its own offset.
        dim as int32 n0 = sz
        if n0 > 8 then n0 = 8
        dim as MirValue v0 = LoadAs( r, LocalVal( slot ), _
                                     SysvEightbyteType( TKO_EB0( packed ), n0 ) )
        r.m->argPool.Push( cast( uint32, v0.kind ) )
        r.m->argPool.Push( v0.id )
        newCount += 1
        r.st->coercedParams += 1
        if sz > 8 then
            dim as MirValue a1 = FieldAddr( r, LocalVal( slot ), 8 )
            dim as MirValue v1 = LoadAs( r, a1, _
                                         SysvEightbyteType( TKO_EB1( packed ), sz - 8 ) )
            r.m->argPool.Push( cast( uint32, v1.kind ) )
            r.m->argPool.Push( v1.id )
            newCount += 1
        end if
    next

    ins.first = newFirst
    ins.count = newCount
end sub

'' A call that RETURNS an aggregate. Direct: the call yields an integer and the value
'' is written into a slot the old result temp then loads from, so every existing
'' consumer keeps working unchanged. Indirect: the caller allocates the destination,
'' passes it as a hidden FIRST argument, and the call returns nothing.
private sub RewriteCallReturn _
    ( byref r as Rewriter, byref ins as MirInst, byval callee as MirFunction ptr, _
      byref names as Tko.Interner, byval discard as boolean = false )

    dim as int32 sz = 0
    if callee <> nullptr then sz = callee->retSize
    if sz <= 0 then
        r.st->declined += 1
        r.outp.Push( ins )
        return
    end if

    '' See SysvReturnUnmodelled_. The SIGNATURE declines the same size, so the two
    '' halves stay in step.
    if SysvReturnUnmodelled_( sz, callee->retClass, *r.tgt ) then
        r.st->declined += 1
        r.outp.Push( ins )
        return
    end if

    dim as MirType it, it2
    dim as boolean direct = RetDirect_( sz, callee->retClass, *r.tgt, it, it2 )
    dim as int32 slot = NewAggSlot( r, iif( direct, RegSlotSize_( sz, *r.tgt ), sz ), names )
    dim as uint32 oldResult = ins.result

    if direct then
        dim as MirInst c = ins
        c.ty = cast( uint8, it )
        c.result = r.f->nextTemp
        r.f->nextTemp += 1
        if it2 <> MT_VOID then
            '' TWO REGISTERS: the emitter writes both through 'b', which a direct call
            '' has no other use for.
            c.b = LocalVal( slot )
            r.outp.Push( c )
        else
            r.outp.Push( c )
            '' The integer goes into the slot, and the ORIGINAL result temp becomes a
            '' load of the aggregate back out of it -- so whatever consumed the
            '' aggregate before consumes the same thing now, at the same temp number.
            dim as MirInst s
            s.op = cast( uint16, M_STORE )
            s.ty = cast( uint8, MT_VOID )
            s.a = LocalVal( slot )
            s.b = TempVal( c.result, it )
            r.outp.Push( s )
        end if
        '' A DISCARDED RESULT HAS NO TEMP TO LOAD INTO. 'Conjugate( z )' as a
        '' statement is a call whose MIR type is VOID; reading the aggregate back out
        '' would name result temp zero, which belongs to something else.
        if discard = false then
            dim as MirInst l
            l.op = cast( uint16, M_LOAD )
            l.ty = cast( uint8, MT_AGG )
            l.a = LocalVal( slot )
            l.imm = sz
            l.result = oldResult
            r.outp.Push( l )
        end if
        r.st->coercedReturns += 1
        return
    end if

    '' INDIRECT: the hidden pointer is a real first argument and it shifts every other
    '' argument right -- including 'this'. The pool is rebuilt rather than patched,
    '' because the arguments are a contiguous run and one more does not fit in it.
    dim as int32 newFirst = r.m->argPool.Count \ 2
    r.m->argPool.Push( cast( uint32, MV_LOCAL ) )
    r.m->argPool.Push( cast( uint32, slot ) )
    for i as int32 = 0 to ins.count - 1
        dim as int32 k = (ins.first + i) * 2
        if (k + 1) >= r.m->argPool.Count then exit for
        '' COPIED TO LOCALS FIRST: pushing an element of a vector INTO ITSELF passes a
        '' reference into the vector, and the Push that reallocates leaves it dangling
        '' before the copy is made. The same shape in types/vtable.tiko put garbage in
        '' a vtable slot; here it would put garbage in an argument.
        dim as uint32 ak = r.m->argPool[k]
        dim as uint32 ak1 = r.m->argPool[k + 1]
        r.m->argPool.Push( ak )
        r.m->argPool.Push( ak1 )
    next
    dim as MirInst c2 = ins
    c2.ty = cast( uint8, MT_VOID )
    c2.result = 0
    c2.first = newFirst
    c2.count = ins.count + 1
    r.outp.Push( c2 )
    '' ...and the value is what landed in the slot -- unless nothing wanted it.
    if discard = false then
        dim as MirInst l2
        l2.op = cast( uint16, M_LOAD )
        l2.ty = cast( uint8, MT_AGG )
        l2.a = LocalVal( slot )
        l2.imm = sz
        l2.result = oldResult
        r.outp.Push( l2 )
    end if
    r.st->sretReturns += 1
end sub

'' THE PROLOGUE STORE, against the signature the pass has just produced.
''
'' The body still names parameters by their ORIGINAL index, and the pass may have moved
'' them: an sret pointer shifts everything right by one, and on SysV one aggregate
'' becomes two. paramOrig maps new to old, so the original index is found by searching
'' rather than assumed to be unchanged -- assuming it silently made '$1' the second
'' eightbyte of '$0'.
private sub RewriteParamStore _
    ( byref r as Rewriter, byref ins as MirInst, byref changed as boolean )

    changed = false
    if ins.b.kind <> cast( uint8, MV_PARAM ) then return
    dim as int32 oldIdx = cast( int32, ins.b.id )
    if oldIdx < 0 then return

    '' AND THE DESTINATION MUST REALLY BE AN AGGREGATE SLOT. A parameter that was
    '' ALWAYS a pointer -- a byval non-trivial UDT, a byval var-length string -- has a
    '' pointer-sized slot holding an address, and this rewrite would copy an object
    '' into it. The signature says 'ptr' in both cases and cannot tell them apart; the
    '' SLOT can, and it is the thing being written to.
    if ins.a.kind <> cast( uint8, MV_LOCAL ) then return
    dim as int32 dslot = cast( int32, ins.a.id )
    if (dslot < 0) orelse (dslot >= r.f->locals.Count) then return

    '' A WIDENED NARROW PARAMETER IS TRUNCATED INTO ITS SLOT. The signature now says
    '' i32 and the slot is still i8 or i16, so 'store i8 %p0' would be invalid IR --
    '' this is the prologue half of MirFunction.paramExt, and the only place the two
    '' widths meet.
    if cast( MirType, r.f->locals[dslot].ty ) <> MT_AGG then
        dim as int32 wj = NewParamIndex_( r, oldIdx )
        if wj < 0 then return
        if wj >= r.f->paramExt.Count then return
        if r.f->paramExt[wj] = TKO_PX_NONE then return
        dim as MirType narrow = cast( MirType, r.f->paramNarrow[wj] )
        '' NOT WIDENED (Apple arm64): the store of the narrow parameter is already right.
        if narrow = cast( MirType, r.f->paramTys[wj] ) then return
        dim as MirValue wp
        wp.kind = cast( uint8, MV_PARAM )
        wp.ty = r.f->paramTys[wj]
        wp.id = cast( uint32, wj )
        dim as MirInst tr
        tr.op = cast( uint16, M_TRUNC )
        tr.ty = cast( uint8, narrow )
        tr.a = wp
        tr.result = r.f->nextTemp
        r.f->nextTemp += 1
        r.outp.Push( tr )
        dim as MirInst st0
        st0.op = cast( uint16, M_STORE )
        st0.ty = cast( uint8, MT_VOID )
        st0.a = ins.a
        st0.b = TempVal( tr.result, narrow )
        r.outp.Push( st0 )
        changed = true
        return
    end if

    '' Every new parameter that came from this original one, in order.
    dim as containers.Array( of int32 ) parts
    for j as int32 = 0 to r.f->paramOrig.Count - 1
        if r.f->paramOrig[j] = oldIdx then parts.Push( j )
    next
    if parts.Count = 0 then return

    dim as int32 sz = cast( int32, r.f->paramAggs[parts[0]] )
    if sz <= 0 then return
    dim as MirType t0 = cast( MirType, r.f->paramTys[parts[0]] )

    '' INDIRECT: the parameter is the address of the caller's copy -- a win64 pointer
    '' or a SysV byval -- so the body's slot is filled by copying through it.
    if (parts.Count = 1) andalso (t0 = MT_PTR) then
        dim as MirValue pv
        pv.kind = cast( uint8, MV_PARAM )
        pv.ty = cast( uint8, MT_PTR )
        pv.id = cast( uint32, parts[0] )
        dim as MirValue loaded = LoadAs( r, pv, MT_AGG, sz )
        dim as MirInst st2
        st2.op = cast( uint16, M_STORE )
        st2.ty = cast( uint8, MT_VOID )
        st2.a = ins.a
        st2.b = loaded
        st2.imm = sz
        r.outp.Push( st2 )
        changed = true
        return
    end if

    '' DIRECT: one register per eightbyte, each written at its own offset in the slot.
    ''
    '' THE SLOT HOLDS WHAT THE REGISTERS WRITE. Each is stored at its full width, and a
    '' 5-byte parameter's 'store i64' into its '[5 x i8]' slot wrote three bytes into
    '' whatever the frame put next -- a neighbouring byte parameter read back changed. The
    '' body's slot grows to ArgSlotSize_; the bytes past 'sz' are padding nothing reads.
    dim as int32 wantSz = ArgSlotSize_( sz, *r.tgt )
    if r.f->locals[dslot].size < wantSz then r.f->locals[dslot].size = wantSz
    for k as int32 = 0 to parts.Count - 1
        dim as int32 j = parts[k]
        dim as MirValue pv
        pv.kind = cast( uint8, MV_PARAM )
        pv.ty = r.f->paramTys[j]
        pv.id = cast( uint32, j )
        dim as MirValue dst = ins.a
        if r.f->paramPart[j] > 0 then dst = FieldAddr( r, ins.a, r.f->paramPart[j] )
        dim as MirInst st3
        st3.op = cast( uint16, M_STORE )
        st3.ty = cast( uint8, MT_VOID )
        st3.a = dst
        st3.b = pv
        r.outp.Push( st3 )
    next
    changed = true
end sub

'' A DEFINITION that returns an aggregate. Direct: the value is put in a slot and the
'' integer loaded back out, so the 'ret' carries what the ABI expects. Indirect: the
'' caller's destination is parameter zero and the value is stored through it.
private sub RewriteReturn _
    ( byref r as Rewriter, byref b as MirBlock, byval sz as int32, _
      byval indirect as boolean, byref names as Tko.Interner )

    if b.term <> cast( uint8, MTERM_RET ) then return
    if b.cond.kind = cast( uint8, MV_NONE ) then return

    if indirect then
        dim as MirValue sretp
        sretp.kind = cast( uint8, MV_PARAM )
        sretp.ty = cast( uint8, MT_PTR )
        sretp.id = 0
        dim as MirInst s
        s.op = cast( uint16, M_STORE )
        s.ty = cast( uint8, MT_VOID )
        s.a = sretp
        s.b = b.cond
        '' Through a POINTER PARAMETER, which no slot sizes.
        s.imm = sz
        r.outp.Push( s )
        dim as MirValue none_
        b.cond = none_
        return
    end if

    '' Register by register, against the signature already rewritten.
    dim as int32 slot = NewAggSlot( r, RegSlotSize_( sz, *r.tgt ), names )
    StoreAggInto( r, slot, b.cond, sz )
    b.cond = LoadAs( r, LocalVal( slot ), cast( MirType, r.f->retTy ) )
    if cast( MirType, r.f->retTy2 ) <> MT_VOID then
        b.ret2 = LoadAs( r, FieldAddr( r, LocalVal( slot ), 8 ), cast( MirType, r.f->retTy2 ) )
    end if
end sub

'' Rewrite a function's SIGNATURE. Done for every function, defined here or not: a
'' declaration that disagrees with the call site is the same miscompile as a definition
'' that does.
private sub RewriteSignature _
    ( byval f as MirFunction ptr, byref target as TargetDescription, byref st as AbiStats )

    '' THE PARAMETER LIST IS REBUILT, because on SysV one aggregate can become TWO
    '' parameters and an in-place rewrite cannot say that. RewriteCallArgs expands the
    '' same way from the same original signature, and the two agree by construction --
    '' which is why the pass does every call site BEFORE any signature.
    dim as containers.Array( of uint8 ) ptys
    dim as containers.Array( of uint32 ) paggs
    dim as containers.Array( of uint32 ) pcls
    dim as containers.Array( of uint8 ) pattr
    dim as containers.Array( of int32 )  porig
    dim as containers.Array( of int32 )  ppart
    '' AND HOW EACH ONE WIDENS. A narrow integer parameter becomes i32 here -- the one
    '' place a parameter's ABI type is decided -- and paramNarrow keeps what it was so
    '' RewriteParamStore can truncate back into the slot. MirFunction.paramExt says why.
    dim as containers.Array( of uint8 ) pexts
    dim as containers.Array( of uint8 ) pnarr

    for i as int32 = 0 to f->paramTys.Count - 1
        dim as MirType pt = cast( MirType, f->paramTys[i] )
        dim as int32 sz = cast( int32, f->paramAggs[i] )
        dim as uint32 packed = 0
        if i < f->paramClasses.Count then packed = f->paramClasses[i]
        dim as uint8 at_ = TKO_PA_NONE
        if i < f->paramAttrs.Count then at_ = f->paramAttrs[i]

        if (pt <> MT_AGG) orelse (sz <= 0) then
            if (pt = MT_AGG) andalso (sz <= 0) then st.declined += 1
            '' THE WIDENING, and the only place it happens: fbc passes an i8 or an i16
            '' parameter as i32, signext or zeroext (lowerstore.tiko, ParamExtClass_).
            dim as uint8 ex = TKO_PX_NONE
            if i < f->paramExt.Count then ex = f->paramExt[i]
            dim as MirType wt = pt
            if ex <> TKO_PX_NONE then
                select case pt
                case MT_I8, MT_I16 : wt = MT_I32
                case else          : ex = TKO_PX_NONE
                end select
            end if
            '' EXCEPT ON APPLE ARM64, which packs a stack argument at its NATURAL size:
            '' with x0-x7 used up a bool goes at sp+0 and a following short at sp+2,
            '' where an i32 puts it at sp+4 and the callee reads 0. clang writes
            '' 'i8 zeroext' / 'i16 signext' there, and LLVM then extends the register and
            '' packs the stack by Darwin's rules; ExtAttr spells it. The parameter stays
            '' narrow, so neither half below widens nor truncates.
            if AbiIsAapcs_( target ) then wt = pt
            ptys.Push( cast( uint8, wt ) )
            paggs.Push( cast( uint32, sz ) )
            pcls.Push( packed )
            pattr.Push( at_ )
            pexts.Push( ex ) : pnarr.Push( cast( uint8, pt ) )
            porig.Push( i ) : ppart.Push( 0 )
            continue for
        end if

        '' ---- AAPCS64: one parameter, never byval -- over 16 bytes the callee is handed the
        '' address of the caller's copy in a register, which is Win64's shape, not SysV's.
        if AbiIsAapcs_( target ) then
            ptys.Push( cast( uint8, AapcsArgType( sz, packed ) ) )
            paggs.Push( cast( uint32, sz ) )
            pcls.Push( packed )
            pattr.Push( TKO_PA_NONE )
            pexts.Push( TKO_PX_NONE ) : pnarr.Push( ptys[ptys.Count - 1] )
            porig.Push( i ) : ppart.Push( 0 )
            continue for
        end if

        if AbiIsWin32_( target ) then
            '' BYVAL, the SysV MEMORY spelling, at every size -- see RewriteCallArgs
            '' for why the flattened spellings clang writes interoperate with it.
            ptys.Push( cast( uint8, MT_PTR ) )
            paggs.Push( cast( uint32, sz ) )
            pcls.Push( packed )
            pattr.Push( TKO_PA_BYVAL )
            pexts.Push( TKO_PX_NONE ) : pnarr.Push( ptys[ptys.Count - 1] )
            porig.Push( i ) : ppart.Push( 0 )
            continue for
        end if

        if AbiIsWin64_( target ) then
            '' THE SIZE IS KEPT EITHER WAY. The prologue rewrite reads it to know how
            '' many bytes the parameter stands for; zeroing it silently disabled that
            '' rewrite, and the store kept its '[8 x i8]' operand while the parameter
            '' had already become an i64.
            if ClassifyAggregate( sz, target ) = ABIC_DIRECT_INT then
                ptys.Push( cast( uint8, DirectIntType( sz ) ) )
            else
                ptys.Push( cast( uint8, MT_PTR ) )
            end if
            paggs.Push( cast( uint32, sz ) )
            pcls.Push( packed )
            pattr.Push( TKO_PA_NONE )
            '' An aggregate does not widen; its entry keeps the arrays in step.
            pexts.Push( TKO_PX_NONE ) : pnarr.Push( ptys[ptys.Count - 1] )
            porig.Push( i ) : ppart.Push( 0 )
            continue for
        end if

        '' ---- SysV
        if (sz > 16) orelse (packed = TKO_EB_MEMORY) orelse (packed = 0) then
            ptys.Push( cast( uint8, MT_PTR ) )
            paggs.Push( cast( uint32, sz ) )
            pcls.Push( packed )
            '' BYVAL: on the stack, by value. Without it this is a pointer in a
            '' register, which is a different ABI.
            pattr.Push( TKO_PA_BYVAL )
            '' An aggregate does not widen; its entry keeps the arrays in step.
            pexts.Push( TKO_PX_NONE ) : pnarr.Push( ptys[ptys.Count - 1] )
            porig.Push( i ) : ppart.Push( 0 )
            continue for
        end if
        dim as int32 n0 = sz
        if n0 > 8 then n0 = 8
        ptys.Push( cast( uint8, SysvEightbyteType( TKO_EB0( packed ), n0 ) ) )
        paggs.Push( cast( uint32, sz ) )
        pcls.Push( 0 )
        pattr.Push( TKO_PA_NONE )
        '' An aggregate does not widen; its entry keeps the arrays in step.
        pexts.Push( TKO_PX_NONE ) : pnarr.Push( ptys[ptys.Count - 1] )
        porig.Push( i ) : ppart.Push( 0 )
        if sz > 8 then
            ptys.Push( cast( uint8, SysvEightbyteType( TKO_EB1( packed ), sz - 8 ) ) )
            paggs.Push( cast( uint32, sz ) )
            pcls.Push( 0 )
            pattr.Push( TKO_PA_NONE )
            '' An aggregate does not widen; its entry keeps the arrays in step.
            pexts.Push( TKO_PX_NONE ) : pnarr.Push( ptys[ptys.Count - 1] )
            porig.Push( i ) : ppart.Push( 8 )
        end if
    next

    f->paramTys.Clear( ) : f->paramAggs.Clear( )
    f->paramClasses.Clear( ) : f->paramAttrs.Clear( )
    f->paramOrig.Clear( ) : f->paramPart.Clear( )
    f->paramExt.Clear( ) : f->paramNarrow.Clear( )
    for i as int32 = 0 to ptys.Count - 1
        f->paramTys.Push( ptys[i] )
        f->paramAggs.Push( paggs[i] )
        f->paramClasses.Push( pcls[i] )
        f->paramAttrs.Push( pattr[i] )
        f->paramExt.Push( pexts[i] )
        f->paramNarrow.Push( pnarr[i] )
        f->paramOrig.Push( porig[i] )
        f->paramPart.Push( ppart[i] )
    next
    f->paramCount = f->paramTys.Count

    if cast( MirType, f->retTy ) <> MT_AGG then return
    if f->retSize <= 0 then
        st.declined += 1
        return
    end if
    if SysvReturnUnmodelled_( f->retSize, f->retClass, target ) then
        '' ZEROED, because that is what "declined" means everywhere else in this pass:
        '' WalkBody skips the return rewrite on it and the emitter reports the
        '' untouched aggregate. Leaving the size in place rewrote the body against a
        '' signature the call sites had already declined.
        f->retSize = 0
        f->retClass = 0
        st.declined += 1
        return
    end if
    dim as MirType rt0, rt1
    if RetDirect_( f->retSize, f->retClass, target, rt0, rt1 ) then
        f->retTy = cast( uint8, rt0 )
        f->retTy2 = cast( uint8, rt1 )
        return
    end if
    '' INDIRECT: the hidden destination pointer becomes parameter ZERO and shifts every
    '' other parameter right. It is inserted rather than appended, because that is where
    '' the ABI puts it and because the call sites do the same.
    f->retTy = cast( uint8, MT_VOID )
    dim as containers.Array( of uint8 ) rtys
    dim as containers.Array( of uint32 ) raggs
    dim as containers.Array( of uint32 ) rcls
    dim as containers.Array( of uint8 ) rattr
    '' ...and the widening arrays, which move with the rest: see MirFunction.paramExt.
    dim as containers.Array( of uint8 ) rext
    dim as containers.Array( of uint8 ) rnarr
    rtys.Push( cast( uint8, MT_PTR ) )
    raggs.Push( cast( uint32, f->retSize ) )
    rcls.Push( 0 )
    '' SRET, and it is not decoration: the callee must also return this pointer, which
    '' LLVM does only when told. An fbc-compiled caller reads it -- fbc's own C is
    '' 'struct T* vr = F( &tmp )'.
    rattr.Push( TKO_PA_SRET )
    '' The sret pointer is a pointer: nothing to widen, nothing narrower behind it.
    rext.Push( TKO_PX_NONE ) : rnarr.Push( cast( uint8, MT_PTR ) )
    dim as containers.Array( of int32 ) rorig
    dim as containers.Array( of int32 ) rpart
    '' -1: the pass invented this parameter, so no original index maps onto it.
    rorig.Push( -1 ) : rpart.Push( 0 )
    '' ALL FOUR ARRAYS MOVE TOGETHER. They are parallel and indexed by parameter, so
    '' one that is shorter than the others is a silent misread of every parameter after
    '' the gap -- which is what inserting into two of them used to do.
    for i as int32 = 0 to f->paramTys.Count - 1
        rtys.Push( f->paramTys[i] )
        raggs.Push( f->paramAggs[i] )
        rcls.Push( iif( i < f->paramClasses.Count, f->paramClasses[i], 0ul ) )
        rattr.Push( iif( i < f->paramAttrs.Count, f->paramAttrs[i], TKO_PA_NONE ) )
        rext.Push( iif( i < f->paramExt.Count, f->paramExt[i], TKO_PX_NONE ) )
        rnarr.Push( iif( i < f->paramNarrow.Count, f->paramNarrow[i], f->paramTys[i] ) )
        rorig.Push( iif( i < f->paramOrig.Count, f->paramOrig[i], cast( int32, i ) ) )
        rpart.Push( iif( i < f->paramPart.Count, f->paramPart[i], 0l ) )
    next
    f->paramTys.Clear( ) : f->paramAggs.Clear( )
    f->paramClasses.Clear( ) : f->paramAttrs.Clear( )
    f->paramOrig.Clear( ) : f->paramPart.Clear( )
    f->paramExt.Clear( ) : f->paramNarrow.Clear( )
    for i as int32 = 0 to rtys.Count - 1
        f->paramTys.Push( rtys[i] )
        f->paramAggs.Push( raggs[i] )
        f->paramClasses.Push( rcls[i] )
        f->paramAttrs.Push( rattr[i] )
        f->paramExt.Push( rext[i] )
        f->paramNarrow.Push( rnarr[i] )
        f->paramOrig.Push( rorig[i] )
        f->paramPart.Push( rpart[i] )
    next
    f->paramCount = f->paramTys.Count
    f->hasSretParam = true
end sub

'' THE EXTENSION ATTRIBUTE OF A NARROW INTEGER, on macos-arm64 only: ' zeroext' or
'' ' signext' after an i8/i16 parameter (both the signature and the call) and before an
'' i8/i16 result, which is where clang writes them for 'arm64-apple-macosx'. Measured,
'' clang 23: '(ptr x 8, i1 zeroext, i16 zeroext, i8 signext, i16 signext)', and
'' 'define zeroext i16 @rus()'. Every other target widens to i32 instead and gets "".
private function ExtWord_ _
    ( byref target as TargetDescription, byval ty as uint8, byval ex as uint8 ) as string

    if AbiIsAapcs_( target ) = false then return ""
    select case cast( MirType, ty )
    case MT_I8, MT_I16
    case else
        return ""
    end select
    if ex = TKO_PX_SIGN then return " signext"
    if ex = TKO_PX_ZERO then return " zeroext"
    return ""
end function

function ExtAttr _
    ( byref target as TargetDescription, byval f as MirFunction ptr, byval i as int32 ) as string

    if f = nullptr then return ""
    if (i < 0) orelse (i >= f->paramTys.Count) orelse (i >= f->paramExt.Count) then return ""
    return ExtWord_( target, f->paramTys[i], f->paramExt[i] )
end function

'' ...and the result's, with its trailing space: 'define' & RetExtAttr & ' i8 @f'.
function RetExtAttr _
    ( byref target as TargetDescription, byval f as MirFunction ptr ) as string

    if f = nullptr then return ""
    if cast( MirType, f->retTy2 ) <> MT_VOID then return ""
    dim as string w = ExtWord_( target, f->retTy, f->retExt )
    if len( w ) = 0 then return ""
    return mid( w, 2 ) & " "
end function

'' PASCAL REVERSES ITS PARAMETERS, on x86-64 as anywhere else. Measured on fbc-modern
'' 1.20 -gen llvm, 2026-09-25:
''
''     function P pascal ( a, b )                     define i32 @P( i32 %B, i32 %A )
''     function T.M pascal ( a, b ), a member         ( i32 %B, i32 %A, ptr %THIS )
''     ... returning a 32-byte UDT                    ( ptr sret %res, i32 %B, i32 %A, ... )
''
'' So every parameter the SOURCE has is reversed -- 'this' too, as the first of them --
'' and the hidden result pointer stays in front. tiko wrote them in cdecl order: the same
'' program ran, but 'P' called through a cdecl pointer gave 12 where fbc gives 21, and a
'' pascal procedure compiled by one of the two and called by the other got its
'' arguments backwards.
''
'' Done HERE, on the written order, because the ABI pass can turn ONE parameter into
'' two (a SysV aggregate's eightbytes) and those stay in order: paramOrig says which
'' source parameter each came from. The body names parameters by index, so nothing in
'' it moves. A variadic procedure cannot be pascal; one that claims to is not reversed.
sub PascalParamOrder _
    ( byval f as MirFunction ptr, byval n as int32, byref order as containers.Array( of int32 ) )

    order.Clear( )
    dim as boolean rev = false
    if f <> nullptr then
        rev = (f->callConv = TKO_CC_PASCAL) andalso (f->isVariadic = false) _
              andalso (n = f->paramTys.Count)
    end if
    if rev = false then
        for i as int32 = 0 to n - 1
            order.Push( i )
        next
        return
    end if
    dim as int32 first_ = 0
    if f->hasSretParam andalso (n > 0) then
        order.Push( 0 )
        first_ = 1
    end if
    '' Stable, descending by source parameter: a split aggregate keeps its halves in order.
    dim as boolean haveOrig = (f->paramOrig.Count = n)
    dim as containers.Array( of int32 ) rest
    for i as int32 = first_ to n - 1
        dim as int32 oi = iif( haveOrig, f->paramOrig[i], i )
        dim as int32 at_ = rest.Count
        for k as int32 = 0 to rest.Count - 1
            dim as int32 ok = iif( haveOrig, f->paramOrig[rest[k]], rest[k] )
            if oi > ok then
                at_ = k
                exit for
            end if
        next
        rest.Insert( at_, i )
    next
    for k as int32 = 0 to rest.Count - 1
        order.Push( rest[k] )
    next
end sub

'' SYSV REGISTER EXHAUSTION. An aggregate goes in registers only if ALL its eightbytes
'' fit in what the parameters before it left -- six GPRs, eight SSE -- and otherwise goes
'' to MEMORY whole (psABI 3.2.3). tiko classified each aggregate on its own: gcc's
'' 'regx( 7 doubles, struct{ double, double }, double )' took the struct in xmm7 and
'' half of it on the stack, and printed 24301 where gcc's own caller prints 43201.
''
'' Decided ONCE per signature, before any call site or body is rewritten, and recorded
'' as the parameter's class -- so the call sites and the definition, which both read
'' it, cannot disagree. Counted in the order the arguments are WRITTEN: a hidden result
'' pointer first, then the parameters, reversed for pascal (PascalParamOrder).
private sub SysvRegisterBudget_ _
    ( byval f as MirFunction ptr, byref target as TargetDescription )

    if AbiIsWin64_( target ) then return
    dim as int32 gpr = 6, sse = 8
    if (cast( MirType, f->retTy ) = MT_AGG) andalso (f->retSize > 0) then
        dim as MirType t0, t1
        if (SysvReturnUnmodelled_( f->retSize, f->retClass, target ) = false) andalso _
           (RetDirect_( f->retSize, f->retClass, target, t0, t1 ) = false) then gpr -= 1
    end if
    dim as int32 n = f->paramTys.Count
    dim as boolean rev = (f->callConv = TKO_CC_PASCAL) andalso (f->isVariadic = false)
    for k as int32 = 0 to n - 1
        dim as int32 i = iif( rev, n - 1 - k, k )
        dim as MirType pt = cast( MirType, f->paramTys[i] )
        select case pt
        case MT_VOID
        case MT_F32, MT_F64
            if sse > 0 then sse -= 1
        case MT_AGG
            dim as int32 sz = cast( int32, f->paramAggs[i] )
            if (sz <= 0) orelse (sz > 16) orelse (i >= f->paramClasses.Count) then continue for
            dim as uint32 packed = f->paramClasses[i]
            if (packed = TKO_EB_MEMORY) orelse (packed = 0) then continue for
            dim as int32 ng = 0, ns = 0
            if TKO_EB0( packed ) = TKO_EB_SSE then ns += 1 else ng += 1
            if sz > 8 then
                if TKO_EB1( packed ) = TKO_EB_SSE then ns += 1 else ng += 1
            end if
            if (ng > gpr) orelse (ns > sse) then
                f->paramClasses[i] = TKO_EB_MEMORY
            else
                gpr -= ng
                sse -= ns
            end if
        case else
            if gpr > 0 then gpr -= 1
        end select
    next
end sub

'' ---------------------------------------------------------------- the pass
''
'' TWO WALKS OVER EACH BODY, and the order matters.
''
'' Call sites are rewritten FIRST, while every signature still says what the FRONTEND
'' meant -- 'agg' where an aggregate was passed. Signatures are rewritten second.
'' Parameter stores and returns are rewritten THIRD, because they need the signature's
'' NEW shape to know whether a parameter arrived as an integer or as a pointer.
''
'' Doing it in one walk was tried on paper and does not work: an indirect return inserts
'' a parameter at index zero, so after that rewrite a call site's argument index no
'' longer lines up with the callee's parameter index, and every aggregate after the
'' first is classified against the wrong parameter.
'' THE ALLOCAS GO IN FIRST, ahead of everything the entry block already held. Ahead
'' rather than behind, because a slot must be allocated before the first store into it
'' and the entry block is where the stores can begin.
private sub FlushAllocas( byref r as Rewriter )
    if r.pendingAllocas.Count = 0 then return
    dim as MirInstVec merged
    for i as int32 = 0 to r.pendingAllocas.Count - 1
        merged.Push( r.pendingAllocas[i] )
    next
    for i as int32 = 0 to r.f->blocks[0].insts.Count - 1
        merged.Push( r.f->blocks[0].insts[i] )
    next
    r.f->blocks[0].insts.Clear( )
    for i as int32 = 0 to merged.Count - 1
        r.f->blocks[0].insts.Push( merged[i] )
    next
    r.pendingAllocas.Clear( )
end sub

private sub WalkCalls _
    ( byref r as Rewriter, byref names as Tko.Interner )

    for bi as int32 = 0 to r.f->blocks.Count - 1
        dim as MirBlock ptr b = @r.f->blocks[bi]
        r.outp.Clear( )
        for i as int32 = 0 to b->insts.Count - 1
            dim as MirInst ins = b->insts[i]
            dim as MirOp op = cast( MirOp, ins.op )
            if (op <> M_CALL) andalso (op <> M_CALL_RTL) then
                '' A CALL THROUGH A POINTER MAY STILL CARRY ITS SIGNATURE. A VIRTUAL
                '' call reaches its target through the vptr, and the DECLARATION it
                '' was mangled from is known at the call site: lowering records that
                '' function's index in 'callee', PLUS ONE, because zero is function 0
                '' and an indirect call that carries nothing has to be
                '' distinguishable from one that names it.
                ''
                '' Without it there was nothing to classify against, and a 16-byte
                '' argument went in a register where the definition takes a pointer:
                '' 'call void %t16(ptr %t12, [16 x i8] %t13)' against 'define void
                '' @TAKE(ptr %p0, ptr %p1)'. The callee then read its parameter as an
                '' address and the program crashed.
                if op = M_CALL_IND then
                    dim as int32 si = cast( int32, ins.callee ) - 1
                    if (si >= 0) andalso (si < r.m->functions.Count) then
                        RewriteCallArgs( r, ins, r.m->functions[si], names )
                        r.st->callsRewritten += 1
                        '' ...AND ITS AGGREGATE RESULT, as a direct call's. A call through a procedure
                        '' POINTER carries a signature now too (PtrCallSigIndex_), and a struct left
                        '' in registers where the callee writes through a hidden pointer read garbage.
                        if cast( MirType, ins.ty ) = MT_AGG then
                            RewriteCallReturn( r, ins, r.m->functions[si], names )
                            continue for
                        end if
                    elseif cast( MirType, ins.ty ) = MT_AGG then
                        '' The signature is on the pointee's type, which MIR does not
                        '' carry here, so it is declined rather than approximated.
                        r.st->declined += 1
                    end if
                end if
                r.outp.Push( ins )
                continue for
            end if
            dim as int32 ci = cast( int32, ins.callee )
            dim as MirFunction ptr callee = nullptr
            if (ci >= 0) andalso (ci < r.m->functions.Count) then
                callee = r.m->functions[ci]
            end if
            RewriteCallArgs( r, ins, callee, names )
            '' A CALL WHOSE RESULT IS DISCARDED STILL HAS THE CALLEE'S CONVENTION.
            '' 'Conjugate( z )' written as a statement is 'call void CONJUGATE(@z)'
            '' over a definition that returns an aggregate: the hidden destination
            '' pointer is still a parameter, and passing nothing for it hands the
            '' callee the FIRST REAL ARGUMENT to write its result through.
            '' math/vector.bas is that call, and DeclineInconsistentReturns used to
            '' read the VOID as the disagreement it is not.
            dim as boolean discardAgg = false
            if cast( MirType, ins.ty ) = MT_VOID then
                if callee <> nullptr then
                    if cast( MirType, callee->retTy ) = MT_AGG then
                        discardAgg = (callee->retSize > 0)
                    end if
                end if
            end if
            if cast( MirType, ins.ty ) = MT_AGG then
                RewriteCallReturn( r, ins, callee, names )
            elseif discardAgg then
                RewriteCallReturn( r, ins, callee, names, true )
            else
                r.outp.Push( ins )
            end if
            r.st->callsRewritten += 1
        next
        b->insts.Clear( )
        for i as int32 = 0 to r.outp.Count - 1
            b->insts.Push( r.outp[i] )
        next
    next
    FlushAllocas( r )
end sub

'' THE BODY STILL NAMES PARAMETERS BY THEIR OLD INDEX. Inserting the hidden result
'' pointer at position ZERO shifts every other parameter right, and RewriteParamStore
'' only rewrites the stores whose DESTINATION IS AN AGGREGATE SLOT -- so a plain BYREF
'' parameter kept its old number and silently became the sret pointer:
''
''     func void _ZptR3UDT(ptr $0, ptr $1)
''       store @l, $0          '' l is now the caller's destination, not the argument
''
'' Measured on tests/mir/src/arrow-field-deref.bas: fbc prints 123/123/-1 and the
'' unremapped body segfaulted. paramOrig maps each NEW parameter back to the original
'' it came from, so the inverse of it is the renumbering.
private function NewParamIndex_ _
    ( byref r as Rewriter, byval oldIdx as int32 ) as int32

    for j as int32 = 0 to r.f->paramOrig.Count - 1
        if r.f->paramOrig[j] = oldIdx then
            if r.f->paramPart[j] = 0 then return j
        end if
    next
    return oldIdx
end function

private sub RemapParamVal_( byref r as Rewriter, byref v as MirValue )
    if v.kind <> cast( uint8, MV_PARAM ) then return
    v.id = cast( uint32, NewParamIndex_( r, cast( int32, v.id ) ) )
end sub

private sub RemapParamsIn_( byref r as Rewriter, byref ins as MirInst )
    RemapParamVal_( r, ins.a )
    RemapParamVal_( r, ins.b )
    dim as MirOp op = cast( MirOp, ins.op )
    if (op <> M_CALL) andalso (op <> M_CALL_RTL) andalso (op <> M_CALL_IND) then return
    dim as int32 base_ = cast( int32, ins.first ) * 2
    for k as int32 = 0 to cast( int32, ins.count ) - 1
        dim as int32 ki = base_ + k * 2
        if (ki + 1) >= r.m->argPool.Count then exit for
        if r.m->argPool[ki] = cast( uint32, MV_PARAM ) then
            r.m->argPool[ki + 1] = _
                cast( uint32, NewParamIndex_( r, cast( int32, r.m->argPool[ki + 1] ) ) )
        end if
    next
end sub

private sub WalkBody _
    ( byref r as Rewriter, byref names as Tko.Interner )

    dim as boolean indirectRet = r.f->hasSretParam
    dim as int32 retSz = r.f->retSize
    '' Only when the numbering actually moved -- otherwise the map is the identity and
    '' walking it per operand is work for nothing.
    dim as boolean renumbered = false
    for j as int32 = 0 to r.f->paramOrig.Count - 1
        if r.f->paramOrig[j] <> j then renumbered = true
    next
    for bi as int32 = 0 to r.f->blocks.Count - 1
        dim as MirBlock ptr b = @r.f->blocks[bi]
        r.outp.Clear( )
        for i as int32 = 0 to b->insts.Count - 1
            dim as MirInst ins = b->insts[i]
            if cast( MirOp, ins.op ) = M_STORE then
                dim as boolean changed = false
                RewriteParamStore( r, ins, changed )
                if changed then continue for
            end if
            '' AFTER RewriteParamStore, which reads the OLD index by design.
            if renumbered then RemapParamsIn_( r, ins )
            r.outp.Push( ins )
        next
        '' The terminator's value, if this function returns an aggregate at all.
        if retSz > 0 then
            RewriteReturn( r, *b, retSz, indirectRet, names )
        end if
        b->insts.Clear( )
        for i as int32 = 0 to r.outp.Count - 1
            b->insts.Push( r.outp[i] )
        next
    next
    FlushAllocas( r )
end sub

'' A RETURN THIS PASS MUST NOT TOUCH.
''
'' The signature rewrite reads the CALLEE's declared return; the call rewrite reads what
'' the CALL recorded as its result type. Those are normally the same fact. Where they
'' are NOT -- and MIR does contain such functions, 'operator ->' among them, whose
'' definition says it returns an aggregate while every call site reads a pointer -- a
'' pass that believes each half in turn rewrites the signature and leaves the calls
'' alone. The result was a definition carrying a hidden result pointer that nothing
'' passed: 'func void _ZptR3UDT(ptr, ptr)' called as 'call ptr _ZptR3UDT(@x)'.
''
'' So the disagreement is DETECTED FIRST and the return is left exactly as it was.
'' retSize 0 is already what both halves read as "decline", so clearing it is the whole
'' fix -- and the emitter then ICEs on the untouched aggregate, which says so, rather
'' than a call whose two halves move different numbers of bytes.
private sub DeclineInconsistentReturns _
    ( byref m as MirModule, byref st as AbiStats )

    for fi as int32 = 0 to m.functions.Count - 1
        dim as MirFunction ptr f = m.functions[fi]
        if f = nullptr then continue for
        if f->isDefinition = false then continue for
        for bi as int32 = 0 to f->blocks.Count - 1
            for ii as int32 = 0 to f->blocks[bi].insts.Count - 1
                dim as MirInst ptr ins = @f->blocks[bi].insts[ii]
                dim as MirOp op = cast( MirOp, ins->op )
                if (op <> M_CALL) andalso (op <> M_CALL_RTL) then continue for
                dim as int32 ci = cast( int32, ins->callee )
                if (ci < 0) orelse (ci >= m.functions.Count) then continue for
                dim as MirFunction ptr callee = m.functions[ci]
                if callee = nullptr then continue for
                if cast( MirType, callee->retTy ) <> MT_AGG then continue for
                if cast( MirType, ins->ty ) = MT_AGG then continue for
                '' ...AND A VOID CALL IS NOT A DISAGREEMENT. It is a result nobody
                '' wanted, and WalkCalls rewrites it against the callee's real
                '' convention like any other. Reading it as one declined every
                '' aggregate-returning function called as a statement.
                if cast( MirType, ins->ty ) = MT_VOID then continue for
                if callee->retSize <> 0 then
                    callee->retSize = 0
                    '' ...and its classification with it. Declining means "leave this
                    '' return exactly as it was", and a size of zero beside a live
                    '' eightbyte class describes nothing that exists.
                    callee->retClass = 0
                    st.declined += 1
                end if
            next
        next
    next
end sub

sub LowerModule _
    ( byref m as MirModule, byref names as Tko.Interner, _
      byref target as TargetDescription, byref st as AbiStats )

    select case target.abi
    case ABI_WIN64, ABI_SYSV_AMD64, ABI_AAPCS64_APPLE, ABI_WIN32
    case else
        Tko.TargetIce( "abi LowerModule", target.id )
    end select

    DeclineInconsistentReturns( m, st )

    '' WHICH AGGREGATES STILL FIT IN REGISTERS, every signature, before anything reads it.
    '' SysV's question alone: AAPCS64's arrays leave register exhaustion to the backend.
    if target.abi = ABI_SYSV_AMD64 then
        for fi as int32 = 0 to m.functions.Count - 1
            if m.functions[fi] <> nullptr then SysvRegisterBudget_( m.functions[fi], target )
        next
    end if

    '' CALL SITES, against the signatures the frontend produced.
    for fi as int32 = 0 to m.functions.Count - 1
        dim as MirFunction ptr f = m.functions[fi]
        if f = nullptr then continue for
        if f->isDefinition = false then continue for
        dim as Rewriter r
        r.m = @m
        r.f = f
        r.st = @st
        r.tgt = @target
        WalkCalls( r, names )
    next

    '' SIGNATURES, every function, defined here or not.
    for fi as int32 = 0 to m.functions.Count - 1
        dim as MirFunction ptr f = m.functions[fi]
        if f = nullptr then continue for
        dim as boolean touched = false
        if cast( MirType, f->retTy ) = MT_AGG then touched = true
        for i as int32 = 0 to f->paramTys.Count - 1
            if cast( MirType, f->paramTys[i] ) = MT_AGG then touched = true
        next
        RewriteSignature( f, target, st )
        if touched then st.functionsRewritten += 1
    next

    '' PARAMETER STORES AND RETURNS, against the new shapes.
    for fi as int32 = 0 to m.functions.Count - 1
        dim as MirFunction ptr f = m.functions[fi]
        if f = nullptr then continue for
        if f->isDefinition = false then continue for
        dim as Rewriter r
        r.m = @m
        r.f = f
        r.st = @st
        r.tgt = @target
        WalkBody( r, names )
    next
    m.abiLowered = true
end sub

end namespace
