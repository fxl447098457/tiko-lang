'' tko.ti -- common definitions shared by every tiko-lang module.
''
'' This is the only header every translation unit includes. Keep it small: version
'' identity, exit codes, and the handful of scalar typedefs the whole compiler agrees on.
'' Anything with behaviour belongs in its own subsystem header.

#ifndef __TKO_BI__
#define __TKO_BI__

#include once "crt.bi"

'' fb/array.bi, NOT containers.bi -- because Array is all tiko-lang uses, and no
'' longer because it had to be. containers.bi pulls in fb/hash.bi, whose HashOf
'' overloads were not PRIVATE, and including it from more than one module of a
'' multi-module program then produced duplicate symbols at link time. FIXED UPSTREAM
'' (fbc-modern ada30911) and re-measured 2026-09-20: four modules sharing one
'' containers.bi header, using Map, Set, OrderedMap and OrderedSet, link and run. So a
'' Map may be introduced where one is worth having -- on a measurement, not on
'' principle. docs/internals/known-toolchain-issues.md section 1 has the probe.

namespace Tko

    '' ---------------------------------------------------------------- identity

    const TKO_VERSION_MAJOR  as int32 = 0
    const TKO_VERSION_MINOR  as int32 = 1
    const TKO_VERSION_PATCH  as int32 = 4
    const TKO_VERSION_SUFFIX as string = ""

    '' The fbc release whose language and runtime ABI tiko-lang targets. Reported as
    '' __FB_VERSION__ so existing '#if __FB_VERSION__ >= ...' guards keep working;
    '' tiko-lang's own identity is __TIKO_VERSION__. See docs/plan/03 section 6.3.
    const TKO_FBC_COMPAT as string = "1.20.0"

    '' --------------------------------------------------------------- exit codes
    '' docs/plan/12 section 3. Code 4 is reserved for internal compiler errors so
    '' CI can treat an ICE as a P0 regardless of test outcome.

    enum ExitCode
        EXIT_OK          = 0
        EXIT_USER_ERROR  = 1
        EXIT_CMDLINE     = 2
        EXIT_NO_TOOLCHAIN= 3
        EXIT_ICE         = 4
        EXIT_TOOL_FAILED = 5
        '' A 'tiko build' child compiling one root died (TKO0167); tiko-build RFC-0001 §4.2.
        EXIT_CHILD_CRASHED = 6
    end enum

    '' ------------------------------------------------------------ target facts
    '' THE OPERATING SYSTEM AND THE INSTRUCTION SET of a target, as two facts rather than
    '' as booleans that each assume the other half. Here, not in types/type.ti, because
    '' the preprocessor seeds its predefines from them and may not depend on the type
    '' model. A select over either has a 'case else' that is an internal compiler error,
    '' never a default: an unknown target that quietly became Windows is how a third one
    '' would have shipped half-built.

    enum TargetOsKind
        OS_WINDOWS = 0
        OS_LINUX
        OS_DARWIN
    end enum

    enum TargetArchKind
        ARCH_X86_64 = 0
        ARCH_ARM64
        '' The 32-bit width of x86, and so far only under Windows: TARGET_WIN32. It
        '' exists so that a select over architectures keeps its 'case else' meaning
        '' -- an unknown arch that quietly became x86-64 is how a wrong width would
        '' have shipped half-built.
        ARCH_X86_32
    end enum

    '' A select over targets, OSes or architectures that met a value it does not know. AN
    '' INTERNAL COMPILER ERROR: says where on stderr and ends with EXIT_ICE; never returns.
    '' Defined in types/type.tiko.
    declare sub TargetIce( byref where as string, byval t as int32 )

    '' -------------------------------------------------------------- scalar ids
    '' Handles, not pointers. 0 always means "none" so a zeroed record is empty.

    type InternId as uint32
    type FileId   as uint32

    const INTERN_NONE as InternId = 0
    const FILE_NONE   as FileId   = 0

    '' Byte buffers are the substrate for source text, emitted output and arena
    '' storage. Aliased because of the HOST compiler, not because of the language:
    '' fbc-modern instantiates a generic in 'dim as FB.Array( of ubyte ) buf' but not
    '' in the name-first field spelling these headers use -- there it adds the field
    '' under whatever name re-parsing the generic's body left in hFieldId's static
    '' buffer. tiko-lang takes both spellings; see
    '' docs/internals/phase-7-generic-type-field.md.
    type ByteBuf as containers.Array( of uint8 )

    '' Lives here rather than in driver/options.ti because the preprocessor needs it
    '' and may not depend on the driver.
    type StrVec as containers.Array( of string )

    '' FileIds, as a list: a module unit's files (ADR 0017), which are not contiguous once
    '' a program's roots are loaded ahead of them.
    type FileIdVec as containers.Array( of uint32 )

end namespace

#endif
