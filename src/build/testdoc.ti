'' testdoc.ti -- 'tiko test' and 'tiko doc' (docs/tiko-test-doc RFC-0001).
''
'' 'tiko test [dirs | x_test.tiko ...] [--profile p] [--timeout s] [--filter text] [--no-run] [-- args]'
'' finds the project's tests, builds them into ONE program and runs it (testcmd.tiko), each test
'' isolated by the runner: one that ends the program, or runs past --timeout, is reported and the
'' program started again after it (testrun.tiko).
''
'' 'tiko doc [dirs] [-o dir]' writes the API documentation of the project's modules: Markdown and
'' HTML per module, an index and doc.json (doccmd.tiko; the model is driver/docmodel.tiko).

#pragma once

#include once "tko.ti"
#include once "build/plan.ti"
#include once "build/events.ti"
#include once "driver/manifest.ti"

namespace Tko.Build

    '' 'tiko build' and 'tiko check' over these plans -- subcmd.tiko; 'tiko test' builds its
    '' program with it.
    declare function Build_ _
        ( byref a as BuildArgs, byref m as Tko.Modules.Manifest, byref mdir as string, _
          byref plans as Tko.StrVec, byref ctx as Tko.CompilerContext, byref obs as Observer, _
          byval checkOnly as boolean = false ) as int32

    '' The subcommands. 'mdir' is the manifest's directory, "" with none (hasM false).
    declare function TestCommand _
        ( byref a as BuildArgs, byval hasM as boolean, byref m as Tko.Modules.Manifest, _
          byref mdir as string, byref ctx as Tko.CompilerContext, byref obs as Observer ) as int32
    declare function DocCommand _
        ( byref a as BuildArgs, byval hasM as boolean, byref m as Tko.Modules.Manifest, _
          byref mdir as string, byref ctx as Tko.CompilerContext, byref obs as Observer ) as int32

    '' Runs the built test program 'exe' and reports each test -- testrun.tiko. 'work' is a
    '' directory for its report files.
    declare function RunTests _
        ( byref a as BuildArgs, byref exe as string, byref work as string, _
          byref ctx as Tko.CompilerContext, byref obs as Observer ) as int32

    '' The directories under 'root', root first, then depth-first in name order: not out/, not a
    '' hidden one, not one holding its own tiko.toml (another package).
    declare sub ProjectDirs( byref root as string, byref outv as Tko.StrVec )
    '' The first line of the file that is not blank and not a comment begins '#module'.
    declare function IsModuleFile( byref path_ as string ) as boolean
    '' A directory holding a '.tiko' or '.bas' file that IsModuleFile.
    declare function IsModuleDir( byref dir_ as string ) as boolean
    '' Whole file, or "" when it cannot be read.
    declare function ReadText( byref path_ as string ) as string
    '' Writes the file unless it already holds exactly 'text'. False when it cannot be written.
    declare function WriteTextIfChanged( byref path_ as string, byref text as string ) as boolean
    '' 'toPath' spelled from the directory 'fromDir', '/'-separated: "../../src/util".
    declare function RelPathFrom( byref fromDir as string, byref toPath as string ) as string

end namespace
