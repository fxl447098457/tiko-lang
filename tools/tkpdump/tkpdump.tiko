'' tkpdump.tiko -- a HOST for parser.dll: it loads the DLL the way an editor does, by
'' DYLIBLOAD and the export names in src/api/tikoparser.ti, and checks what only an
'' in-process host can see.
''
''   tkpdump <dll> <file> dump        print the records, as '--dump-scan' would
''   tkpdump <dll> <file> text        scan the file, then scan its bytes through
''                                    scan_text: both results must be byte-identical
''   tkpdump <dll> <file> loop <n>    scan n times: every result identical to the first,
''                                    and the heap's busy bytes must not grow
''
'' TKP_INCDIR, if set, is passed as the one include path; TKP_PKGDIR as the package tree. Exit 0 = every check held.
''
'' Built and run by build/apitest.sh.

#include once "api/tikoparser.ti"
#include once "windows.bi"
#include once "win/psapi.bi"

dim shared as TKP_VERSION_FN   pVer
dim shared as TKP_SCAN_FN      pScan
dim shared as TKP_SCAN_TEXT_FN pText
dim shared as TKP_FREE_FN      pFree

private function PoolStr_( byval r as TKP_RESULT ptr, byval off as int32 ) as string
    if off < 0 then return ""
    dim as string o = ""
    dim as uint16 ptr p = cast( uint16 ptr, r->stringPool ) + off
    while *p <> 0
        o &= iif( *p < 128, chr( *p ), "?" )
        p += 1
    wend
    return o
end function

'' A result's content, flattened -- equal results give equal strings.
private function Fingerprint_( byval r as TKP_RESULT ptr ) as string
    dim as string o = "v" & r->version & " s" & r->symbolCount & " f" & r->fileCount & _
                      " d" & r->diagCount & " p" & r->poolChars & "|"
    if r->symbolCount > 0 then
        o &= space( r->symbolCount * sizeof( TKP_SYMBOL ) )
        memcpy( strptr( o ) + len( o ) - r->symbolCount * sizeof( TKP_SYMBOL ), _
                r->symbols, r->symbolCount * sizeof( TKP_SYMBOL ) )
    end if
    if r->poolChars > 0 then
        dim as int32 nb = r->poolChars * 2
        o &= space( nb )
        memcpy( strptr( o ) + len( o ) - nb, r->stringPool, nb )
    end if
    return o
end function

private sub Dump_( byval r as TKP_RESULT ptr )
    print "files: " & r->fileCount
    for i as int32 = 0 to r->fileCount - 1
        print "  [" & i & "] " & PoolStr_( r, r->fileOffsets[i] )
    next
    print "symbols: " & r->symbolCount
    for i as int32 = 0 to r->symbolCount - 1
        with r->symbols[i]
            dim as string t = PoolStr_( r, .typeOffset )
            print "  [" & i & "] k" & .kind & " " & PoolStr_( r, .nameOffset ) & _
                  iif( len( t ), " as " & t, "" ) & "  @" & .fileIndex & ":" & .lineNum & _
                  ":" & .colNum & "  parent=" & .parentIndex & "  body=" & .bodyLine & _
                  ".." & .bodyEndLine & "  flags=&h" & hex( .flags, 3 ) & _
                  "  refs=" & .readCount & "r" & .writeCount & "w" & _
                  iif( .refFileIndex >= 0, "  ref=" & .refFileIndex & ":" & .refLine, "" )
        end with
    next
    print "diags: " & r->diagCount
end sub

private function WorkingSetKb_( ) as int32
    dim as PROCESS_MEMORY_COUNTERS pmc
    pmc.cb = sizeof( pmc )
    GetProcessMemoryInfo( GetCurrentProcess( ), @pmc, sizeof( pmc ) )
    return cast( int32, pmc.WorkingSetSize \ 1024 )
end function

'' Bytes every heap in the process holds in BUSY blocks -- what is allocated and not
'' freed, with none of the working set's page-level noise. EVERY heap: msvcrt's malloc
'' has a private one of its own, not the process heap.
private function HeapBusyKb_( ) as int32
    dim as HANDLE hs( 0 to 63 )
    dim as int32 nh = GetProcessHeaps( 64, @hs( 0 ) )
    if nh > 64 then nh = 64
    dim as int64 total = 0
    for i as int32 = 0 to nh - 1
        dim as PROCESS_HEAP_ENTRY e
        HeapLock( hs( i ) )
        while HeapWalk( hs( i ), @e )
            if (e.wFlags and PROCESS_HEAP_ENTRY_BUSY) <> 0 then total += e.cbData
        wend
        HeapUnlock( hs( i ) )
    next
    return cast( int32, total \ 1024 )
end function

dim as string dllPath = command( 1 )
dim as string file = command( 2 )
dim as string mode = lcase( command( 3 ) )
if (len( dllPath ) = 0) orelse (len( file ) = 0) then
    print "usage: tkpdump <dll> <file> dump|text|loop <n>"
    end 2
end if

dim as any ptr lib_ = dylibload( dllPath )
if lib_ = nullptr then
    print "tkpdump: cannot load " & dllPath
    end 2
end if
pVer = dylibsymbol( lib_, "TIKOPARSER_VERSION" )
pScan = dylibsymbol( lib_, "TIKOPARSER_SCAN" )
pText = dylibsymbol( lib_, "TIKOPARSER_SCAN_TEXT" )
pFree = dylibsymbol( lib_, "TIKOPARSER_FREE" )
if (pVer = nullptr) orelse (pScan = nullptr) orelse (pText = nullptr) orelse (pFree = nullptr) then
    print "tkpdump: an export is missing"
    end 2
end if
if pVer( ) <> TKP_VERSION then
    print "tkpdump: DLL contract " & pVer( ) & ", this host " & TKP_VERSION
    end 2
end if

dim as TKP_OPTIONS opts
opts.version = TKP_VERSION
dim as wstring * 1024 incW = environ( "TKP_INCDIR" )
dim as wstring ptr incs( 0 )
incs( 0 ) = @incW
if len( environ( "TKP_INCDIR" ) ) > 0 then
    opts.includeCount = 1
    opts.includePaths = @incs( 0 )
end if

dim as wstring * 1024 pkgW = environ( "TKP_PKGDIR" )
if len( environ( "TKP_PKGDIR" ) ) > 0 then opts.pkgDir = @pkgW

'' TKP_OVERLAY = "<source>=<text file>": that file's unsaved text. Asks for the module root too.
dim as wstring * 1024 ovW
dim as wstring ptr ovPaths( 0 )
dim as zstring ptr ovTexts( 0 )
dim as string ovText
if len( environ( "TKP_OVERLAY" ) ) > 0 then
    dim as string ov = environ( "TKP_OVERLAY" )
    dim as long eq = instr( ov, "=" )
    ovW = left( ov, eq - 1 )
    dim as long ff = freefile
    open mid( ov, eq + 1 ) for binary as #ff
    ovText = space( lof( ff ) )
    get #ff, , ovText
    close #ff
    ovPaths( 0 ) = @ovW
    ovTexts( 0 ) = strptr( ovText )
    opts.overlayCount = 1
    opts.overlayPaths = @ovPaths( 0 )
    opts.overlayTexts = @ovTexts( 0 )
    opts.flags = TKP_FLAG_MODULE_ROOT
end if

dim as wstring * 1024 fileW = file
dim as TKP_RESULT ptr r = nullptr
dim as int32 rc = pScan( @fileW, @opts, @r )
if (rc <> TKP_OK) orelse (r = nullptr) then
    print "tkpdump: scan returned " & rc
    end 1
end if

dim as int32 failures = 0
select case mode
case "text"
    dim as string bytes = ""
    dim as int32 f = freefile
    if open( file for binary access read as #f ) = 0 then
        bytes = space( lof( f ) )
        if len( bytes ) > 0 then get #f, 1, bytes
        close #f
    end if
    dim as TKP_RESULT ptr r2 = nullptr
    dim as int32 rc2 = pText( strptr( bytes ), @fileW, @opts, @r2 )
    if (rc2 <> TKP_OK) orelse (r2 = nullptr) then
        print "TEXT: scan_text returned " & rc2
        failures += 1
    elseif Fingerprint_( r ) <> Fingerprint_( r2 ) then
        print "TEXT: MISMATCH -- scan " & r->symbolCount & " symbols, scan_text " & r2->symbolCount
        failures += 1
    else
        print "TEXT OK: scan_text is byte-identical to scan (" & r->symbolCount & " symbols)"
    end if
    if r2 then pFree( r2 )
case "loop"
    dim as int32 n = valint( command( 4 ) )
    if n < 2 then n = 2
    dim as string want = Fingerprint_( r )
    '' The first scan fills the heap and the runtime's caches; growth is measured after it.
    dim as int32 ws0 = WorkingSetKb_( )
    dim as int32 hb0 = HeapBusyKb_( )
    for i as int32 = 2 to n
        dim as TKP_RESULT ptr ri = nullptr
        pScan( @fileW, @opts, @ri )
        if Fingerprint_( ri ) <> want then
            print "LOOP: scan " & i & " differs from scan 1"
            failures += 1
        end if
        pFree( ri )
    next
    dim as int32 ws1 = WorkingSetKb_( )
    dim as int32 hb1 = HeapBusyKb_( )
    print "LOOP: heap in use " & hb0 & " -> " & hb1 & " KB (" & str( fix( (hb1 - hb0) / (n - 1) * 10 ) / 10 ) & " KB/scan)"
    dim as float64 perScan = (ws1 - ws0) / (n - 1)
    print "LOOP: " & n & " scans, all identical = " & iif( failures = 0, "yes", "NO" ) & _
          ", working set " & ws0 & " -> " & ws1 & " KB (" & str( fix( perScan * 10 ) / 10 ) & " KB/scan)"
    '' THE HEAP, NOT THE WORKING SET: a leak is a busy block nobody frees, and the heap walk
    '' counts exactly those. The working set also moves with fragmentation -- tracks.bas,
    '' 176,162 symbols, grows it ~2.7 MB a scan over 20 scans with the busy bytes unchanged
    '' to the KB -- so it is printed, never judged. A few KB of slack covers the runtime.
    if hb1 - hb0 > 16 then
        print "LOOP: heap blocks are leaking"
        failures += 1
    end if
case else
    Dump_( r )
end select

pFree( r )
dylibfree( lib_ )
if failures <> 0 then end 1
end 0
