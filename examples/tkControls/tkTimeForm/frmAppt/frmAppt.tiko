' The appointment form's handler: what a designed form's author writes beside the generated part.
#module "frmAppt"

#import "vendor/tkControls/tkTimePicker"
using tkTimePicker
using tkTimePanel

public partial type Form
    StartChanges as long
end type

sub Form.OnStartChanged( byval pTime as TKTIME ptr, byval bHasTime as boolean )
    StartChanges += 1
end sub
