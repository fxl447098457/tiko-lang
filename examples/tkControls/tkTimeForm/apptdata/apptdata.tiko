' The record frmAppt binds (Form Designer DataType apptdata.Appt): a start time, and an appointment's
' date and time in one DateTime, which a DatePicker and a TimePicker share, and its end in a
' second DateTime, which one DateTimePicker holds.
#module "apptdata"

#import "std/chrono"
using chrono

public type Appt
    Start as LocalTime
    Stamp as DateTime
    Ends  as DateTime
end type
