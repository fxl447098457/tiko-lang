' tkTimeForm self-test (time picker phase T4): frmAppt was written as a .tkform and generated by
' tkEdit --generate-forms. One check per behaviour: the designer's props reach a TimePicker, its
' event is wired, LoadFrom fills a TimePicker from a LocalTime and a DatePicker + TimePicker pair
' from one DateTime, and SaveTo writes the pair in ONE call -- so a NEW record (its DateTime
' Invalid) gets both halves, although the time control comes first in the form. A DateTimePicker
' holds a second DateTime whole.
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkTimePicker"
#import "vendor/tkControls/tkDatePicker"
#import "vendor/tkControls/tkDateTimePicker"
#import "vendor/tkControls/tkForms"
#import "std/chrono"
#import "./frmAppt"
#import "./apptdata"
using tkApp
using tkTimePicker
using tkTimePanel
using tkDatePicker
using tkDateTimePicker
using tkCalendar
using tkForms
using tkHost
using tkTest
using chrono

function DtStr( byref d as DateTime ) as ustring
    if d.IsValid = false then return "(invalid)"
    return d.ToString( )
end function

sub Appt( byval owner as TK_FORM ptr )
    tkTest_Begin( "a designed form with time pickers" )
    dim as frmAppt.Form f
    f.Build( owner )
    dim as TK_HOST ptr h = tkForm_Host( f.Handle )
    f.Show( )
    tkTest_PumpFor( h, 80 )
    tkTest_Check( "props: Format h:mm tt, Step 900", tkTimePicker_GetFormat( f.tpStart.Handle ) = "h:mm tt" _
                  andalso tkTimePicker_GetStep( f.tpStart.Handle ) = 900 )

    dim as apptdata.Appt r
    r.Start = chrono.LocalTime( 9, 30, 0, 0 )
    r.Stamp = DateTime( 2026, 11, 23, 14, 5, 0, 0 )
    r.Ends = DateTime( 2026, 11, 23, 15, 35, 0, 0 )
    f.LoadFrom( r )
    tkTest_Check( "LoadFrom: the DateTimePicker shows the second DateTime", tkDateTimePicker_GetText( f.dtpEnd.Handle ) = "2026-11-23 15:35", _
                  tkDateTimePicker_GetText( f.dtpEnd.Handle ) )
    dim as TKDATE d = tkDatePicker_GetDateValue( f.dpDay.Handle )
    tkTest_Check( "LoadFrom: 9:30 AM; the DateTime's date and time in their pickers, silently", _
                  tkTimePicker_GetText( f.tpStart.Handle ) = "9:30 AM" andalso d.wDay = 23 _
                  andalso tkTimePicker_GetText( f.tpAt.Handle ) = "14:05" andalso f.StartChanges = 0, _
                  tkTimePicker_GetText( f.tpStart.Handle ) & " " & tkTimePicker_GetText( f.tpAt.Handle ) )

    ' a user step reaches the form's handler: Up on the minutes, by the step (15)
    tkHost_SetFocus( h, f.tpStart.Handle )
    tkTimePicker_SetFocusedSegment( f.tpStart.Handle, 2 )
    tkTest_PushKey( h, SDLK_UP )
    tkTest_Check( "TimeChanged reached OnStartChanged (9:45 AM)", f.StartChanges = 1 _
                  andalso tkTimePicker_GetText( f.tpStart.Handle ) = "9:45 AM", tkTimePicker_GetText( f.tpStart.Handle ) )

    dim as apptdata.Appt fresh
    f.SaveTo( fresh )
    tkTest_Check( "SaveTo into a NEW record: Start 09:45, Stamp 2026-11-23 14:05 (the pair in one call)", _
                  fresh.Start.IsValid andalso fresh.Start.Hour = 9 andalso fresh.Start.Minute = 45 _
                  andalso fresh.Stamp.IsValid andalso fresh.Stamp.Day = 23 andalso fresh.Stamp.Hour = 14 andalso fresh.Stamp.Minute = 5, _
                  DtStr( fresh.Stamp ) )
    tkTest_Check( "SaveTo: Ends 2026-11-23 15:35", fresh.Ends.IsValid andalso fresh.Ends.Hour = 15 andalso fresh.Ends.Minute = 35, DtStr( fresh.Ends ) )
    f.Close( )
    tkTest_PumpFor( h, 40 )
end sub

dim as TKAPP_OPTIONS opts
if tkApp_Init( opts ) = false then
    print "tkApp_Init failed"
    end 98
end if
dim as TK_FORM ptr mainForm = tkApp_NewForm( "owner", 200, 120, 0, 1.0 )
tkForm_Show( mainForm )
tkTest_PumpFor( tkForm_Host( mainForm ), 50 )
Appt( mainForm )
dim as long nFail = tkTest_Report( "tkTimeForm" )
tkApp_Shutdown( )
end nFail
