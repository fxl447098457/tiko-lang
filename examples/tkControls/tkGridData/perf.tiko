' tkGridData perf (tkDataGrid G6): tkDataGridSqlite over an in-memory table of 1,000,000 rows.
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkDataGrid"
#import "vendor/tkControls/tkDataGridSqlite"
#import "vendor/sqlite3"
using tkApp
using tkDataGrid
using tkDataGridSqlite
using tkHost
using tkTest

const N = 1000000

function Ms( byval t0 as double ) as string
    return str( cint( (timer( ) - t0) * 10000 ) / 10 ) & " ms"
end function

if tkTest_Init() = false then end 99
dim as TKAPP_OPTIONS opts
if tkApp_Init( opts ) = false then end 98
dim as TK_FORM ptr f = tkApp_NewForm( "perf", 800, 600, 0, 1.0 )
tkForm_Show( f )
dim as TK_HOST ptr h = tkForm_Host( f )
tkTest_PumpFor( h, 50 )
dim as sqlite3 ptr db
sqlite3_open( ":memory:", @db )
sqlite3_exec( db, "create table t( id integer primary key, name text, qty int, price real )", nullptr, nullptr, nullptr )
dim as double t0 = timer( )
sqlite3_exec( db, "with recursive c( x ) as ( select 1 union all select x + 1 from c where x < " & N & " ) " _
    & "insert into t( name, qty, price ) select 'name' || x, x % 1000, x * 0.5 from c", nullptr, nullptr, nullptr )
print "insert " & N & " rows: " & Ms( t0 )
dim as TK_WIDGET ptr g = tkDataGrid_Create( tkForm_Widget( f ), 1 )
tkWidget_SetPos( g, 0, 0, 800, 600 )
t0 = timer( )
dim as TKDGSQL ptr q = tkDataGridSqlite_Open( g, db, "select id, name, qty, price from t" )
print "Open (columns + count(*)): " & Ms( t0 )
t0 = timer( )
dim as string s = tkDataGrid_GetCellText( g, 5, 1 )
print "first block (offset 0): " & Ms( t0 )
t0 = timer( )
s = tkDataGrid_GetCellText( g, N \ 2, 1 )
print "block at offset " & (N \ 2) & ": " & Ms( t0 )
t0 = timer( )
s = tkDataGrid_GetCellText( g, N - 5, 1 )
print "block at offset " & (N - 100) & ": " & Ms( t0 )
dim as TKDG_SORTKEY keys(0)
keys(0).col = 2 : keys(0).bDescending = true
t0 = timer( )
tkDataGrid_SetSortKeys( g, keys() )
s = tkDataGrid_GetCellText( g, 0, 1 )
print "sort by qty desc + first block: " & Ms( t0 )
tkDataGridSqlite_Close( q )
sqlite3_close( db )
tkApp_Shutdown( )
