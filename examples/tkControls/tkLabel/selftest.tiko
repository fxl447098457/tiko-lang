' tkLabel self-test. Real windows, real SDL events; scale pinned at 1.0 and 1.75.
#import "vendor/tkControls/tkLabel"
#import "vendor/tkControls/tkTest"
using tkLabel
using tkTheme
using tkTest
using tkHost
using tkPaint

dim shared as long gClicks, gLastId

sub OnClick( byval h as TK_WIDGET ptr, byval id as long )
    gClicks += 1
    gLastId = id
end sub

sub RunPass( byval fScale as single )
    tkTest_Begin( "scale " & fScale )
    dim as TK_HOST ptr h = tkHost_Create( "tkLabel selftest", 640, 480, tkHost_FontDir() & TK_FONT_UI, fScale )
    h->clrBack = &hFF102030ul
    dim as TK_WIDGET ptr root_ = tkHost_Root( h )
    dim as TK_WIDGET ptr L = tkLabel_Create( root_, 7 )
    tkHost_Show( h )
    tkTest_PumpFor( h, 50 )

    tkTest_Check( "not a tab stop", L->isFocusable = false )
    tkTest_Check( "text starts empty", len( tkLabel_GetText( L ) ) = 0 )
    tkLabel_SetText( L, "Hello there" )
    tkTest_Check( "text reads back", tkLabel_GetText( L ) = "Hello there", tkLabel_GetText( L ) )

    dim as long iw, ih
    tkLabel_GetIdealSize( L, iw, ih )
    tkTest_Check( "ideal size before placing", (iw > 0) andalso (ih > 0), iw & "x" & ih )
    tkTest_Check( "ideal width is the text's", iw = tkText_Width( h->pDefaultFont, "Hello there" ), str( iw ) )

    tkWidget_SetPos( L, 20, 20, 300, 40 )
    tkHost_RenderTo( h, false )
    dim as ulong c0
    tkTest_Check( "text draws", tkTest_TonesIn( h, 20, 20, 300, 40, c0 ) > 1 )
    tkTest_Check( "transparent by default: the window shows through", (tkTest_PixelAt( h, 318, 22 ) and &hFFFFFFul) = &h102030ul, hex( tkTest_PixelAt( h, 318, 22 ) ) )

    tkLabel_SetBackColor( L, &hFFAA0000ul )
    tkHost_RenderTo( h, false )
    tkTest_Check( "SetBackColor turns the background on", (tkTest_PixelAt( h, 318, 22 ) and &hFFFFFFul) = &hAA0000ul, hex( tkTest_PixelAt( h, 318, 22 ) ) )
    tkLabel_SetTransparent( L, true )

    tkLabel_SetAlign( L, LBL_ALIGN_RIGHT )
    tkTest_Check( "align reads back", tkLabel_GetAlign( L ) = LBL_ALIGN_RIGHT )
    tkLabel_SetAlign( L, 99 )
    tkTest_Check( "a bad align is refused", tkLabel_GetAlign( L ) = LBL_ALIGN_RIGHT )
    tkHost_RenderTo( h, false )
    tkTest_Check( "right-aligned text reaches the right side", tkTest_TonesIn( h, 20 + 300 - iw \ 2, 20, iw \ 2, 40, c0 ) > 1 )
    tkTest_Check( "...and leaves the left side empty", tkTest_TonesIn( h, 20, 20, 300 - iw - 4, 40, c0 ) = 1 )
    tkLabel_SetAlign( L, LBL_ALIGN_LEFT )

    tkLabel_SetVAlign( L, LBL_VALIGN_TOP )
    tkTest_Check( "valign reads back", tkLabel_GetVAlign( L ) = LBL_VALIGN_TOP )
    tkLabel_SetVAlign( L, LBL_VALIGN_CENTER )

    ' Wrapping: the height of the block, at the control's own width.
    tkWidget_SetPos( L, 20, 20, 90, 200 )
    tkLabel_SetText( L, "one two three four five six seven eight nine" )
    tkLabel_SetWordWrap( L, true )
    tkLabel_GetIdealSize( L, iw, ih )
    tkTest_Check( "wrapped ideal width is the control's", iw = 90, str( iw ) )
    tkTest_Check( "wrapped ideal height is several lines", ih > TTF_GetFontHeight( h->pDefaultFont ) * 2, str( ih ) )
    tkLabel_SetWordWrap( L, false )

    ' AutoSize follows the text.
    tkWidget_SetPos( L, 20, 20, 10, 10 )
    tkLabel_SetAutoSize( L, true )
    tkLabel_SetText( L, "Sized" )
    tkTest_Check( "autosize width", L->cw = tkText_Width( h->pDefaultFont, "Sized" ), str( L->cw ) )
    tkTest_Check( "autosize height", L->ch = TTF_GetFontHeight( h->pDefaultFont ), str( L->ch ) )
    tkTest_Check( "autosize keeps the position", (L->x = 20) andalso (L->y = 20) )
    tkLabel_SetAutoSize( L, false )
    tkWidget_SetPos( L, 20, 20, 200, 40 )

    ' Clicks only when someone wants them, and only a click that ends inside.
    gClicks = 0
    tkTest_Click( h, tkTest_CX( L ), tkTest_CY( L ) )
    tkTest_PumpFor( h, 20 )
    tkTest_Check( "no callback: no click", gClicks = 0 )
    tkLabel_SetClickCallback( L, @OnClick )
    tkTest_Click( h, tkTest_CX( L ), tkTest_CY( L ) )
    tkTest_PumpFor( h, 20 )
    tkTest_Check( "click notifies with the id", (gClicks = 1) andalso (gLastId = 7), gClicks & " id " & gLastId )
    tkTest_PushButton( h, true, tkTest_CX( L ), tkTest_CY( L ) )
    tkTest_PumpFor( h, 20 )
    tkTest_PushMotion( h, 600, 400 )
    tkTest_PushButton( h, false, 600, 400 )
    tkTest_PumpFor( h, 20 )
    tkTest_Check( "a press released outside is not a click", gClicks = 1, str( gClicks ) )
    tkTest_Check( "capture released", tkHost_GetCapture( h ) = 0 )

    tkWidget_Enable( L, false )
    tkLabel_SetTextColor( L, &hFFFFFFFFul )
    tkTest_Check( "text colour reads back", tkLabel_GetTextColor( L ) = &hFFFFFFFFul )
    tkLabel_UnpinColors( L )
    tkTest_Check( "unpin returns to the theme", tkLabel_GetTextColor( L ) = tkTheme_Get().Text )

    tkHost_Destroy( h )
end sub

if tkTest_Init() = false then end 99
RunPass( 1.0 )
RunPass( 1.75 )
dim as long nFail = tkTest_Report( "tkLabel" )
tkTest_Quit()
end nFail
