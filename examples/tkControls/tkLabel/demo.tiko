' tkLabel demo: alignment (both axes), word wrap, ellipsis, auto-size with its own font and colours,
' a disabled label, and a clickable one (its clicks are printed).
'
'   demo                     run it
'   demo --shot out.bmp      render once, save the window, exit
'   demo --scale 1.75        pin the scale
#import "vendor/tkControls/tkLabel"
using tkLabel
using tkTheme
using tkHost
using tkPaint

dim shared as TK_HOST ptr gHost
dim shared as TTF_Font ptr gFont, gBold
dim shared as long gClicks

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

private function HasArg( byref name_ as string ) as boolean
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return true
    next
    return false
end function

private sub Label_Click( byval hLabel as TK_WIDGET ptr, byval id as long )
    gClicks += 1
    tkLabel_SetText( hLabel, "Clicked " & gClicks & " time" & iif( gClicks = 1, "", "s" ) & " - click again" )
    print "LabelClick " & id & ": " & gClicks
end sub

' The row captions on the left, painted by the form itself.
private sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    dim as ustring caps(0 to 6) = { "Align: left, center, right", "VAlign: top, center, bottom", _
        "Word wrap + auto-size", "Ellipsis (one line)", "Auto-size, own font + colours", "Disabled", "Click callback" }
    dim as long ys(0 to 6) = { 20, 64, 150, 222, 266, 310, 354 }
    dim as long hs(0 to 6) = { 28, 28, 18, 28, 28, 28, 28 }
    b->SetFont( gFont )
    b->SetForeColor( tkTheme_Of( tkHost_Root( h ) ).TextDim )
    for i as long = 0 to 6
        dim as TKRECT rc
        tkRect_Set( rc, tkHost_Scale( h, 20 ), tkHost_Scale( h, ys(i) ), tkHost_Scale( h, 220 ), tkHost_Scale( h, ys(i) + hs(i) ) )
        b->PaintText( caps(i), @rc, TK_DT_LEFT or TK_DT_VCENTER )
    next
end sub

private function NewLabel( byval id as long, byref s as ustring, byval x as long, byval y as long, byval w as long, byval hgt as long ) as TK_WIDGET ptr
    dim as TK_WIDGET ptr L = tkLabel_Create( tkHost_Root( gHost ), id )
    tkWidget_SetPos( L, tkHost_Scale( gHost, x ), tkHost_Scale( gHost, y ), tkHost_Scale( gHost, w ), tkHost_Scale( gHost, hgt ) )
    tkLabel_SetText( L, s )
    return L
end function

private sub SaveShot( byval h as TK_HOST ptr, byref path as string )
    tkHost_Render( h )
    tkHost_RenderTo( h, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( h->renderer, 0 )
    if s then
        SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & h->fScale
        SDL_DestroySurface( s )
    end if
end sub

if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
gHost = tkHost_Create( "tkLabel on SDL3", 720, 400, tkHost_FontDir() & TK_FONT_UI, val( ArgValue( "--scale" ) ) )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
dim as TKTHEME_COLORS t = tkTheme_Of( tkHost_Root( gHost ) )
gHost->clrBack = t.Window
gFont = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 10 )
gBold = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI_BOLD, 14 )

' Horizontal alignment: a Surface background shows each label's box.
dim as ustring hNames(0 to 2) = { "Left", "Center", "Right" }
for i as long = 0 to 2
    dim as TK_WIDGET ptr L = NewLabel( 100 + i, hNames(i), 230 + i * 160, 20, 150, 28 )
    tkLabel_SetBackColor( L, t.Surface )
    tkLabel_SetAlign( L, LBL_ALIGN_LEFT + i )
next

' Vertical alignment in taller boxes, centred across.
dim as ustring vNames(0 to 2) = { "Top", "Center", "Bottom" }
for i as long = 0 to 2
    dim as TK_WIDGET ptr L = NewLabel( 110 + i, vNames(i), 230 + i * 160, 64, 150, 70 )
    tkLabel_SetBackColor( L, t.Surface )
    tkLabel_SetAlign( L, LBL_ALIGN_CENTER )
    tkLabel_SetVAlign( L, LBL_VALIGN_TOP + i )
next

' Word wrap: the width is set, auto-size gives the height its text needs.
dim as TK_WIDGET ptr lWrap = NewLabel( 120, "A wrapped label keeps its width and breaks at word boundaries. " _
    & "With auto-size on, its height follows the text, so however many lines it takes, " _
    & "this paragraph never clips.", 230, 150, 470, 28 )
tkLabel_SetVAlign( lWrap, LBL_VALIGN_TOP )
tkLabel_SetBackColor( lWrap, t.Surface )
tkLabel_SetWordWrap( lWrap, true )
tkLabel_SetAutoSize( lWrap, true )

' Ellipsis: one line, cut where it stops fitting.
dim as TK_WIDGET ptr lEll = NewLabel( 130, "This sentence is far too long for its box, so it ends in an ellipsis", 230, 222, 300, 28 )
tkLabel_SetBackColor( lEll, t.Surface )
tkLabel_SetEllipsis( lEll, true )

' Auto-size with a bold font and pinned colours: the box hugs the text.
dim as TK_WIDGET ptr lBig = NewLabel( 140, "Bold, 14 pt, accent", 230, 266, 10, 10 )
tkLabel_SetFont( lBig, gBold )
tkLabel_SetTextColor( lBig, t.TextStrong )
tkLabel_SetBackColor( lBig, t.Accent )
tkLabel_SetAutoSize( lBig, true )

dim as TK_WIDGET ptr lOff = NewLabel( 150, "This label is disabled", 230, 310, 300, 28 )
tkWidget_Enable( lOff, false )

dim as TK_WIDGET ptr lClick = NewLabel( 160, "Click this label", 230, 354, 300, 28 )
tkLabel_SetTextColor( lClick, t.Accent )
tkLabel_SetClickCallback( lClick, @Label_Click )

gHost->OnPaint = @Form_Paint
tkHost_Show( gHost )

dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )
    SaveShot( gHost, shot )
else
    tkHost_Run( gHost )
end if
tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
