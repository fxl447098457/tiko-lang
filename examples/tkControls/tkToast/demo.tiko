' tkToast demo (notifications N2 + N3): post toasts and watch the stack, the queue, the holds. Hover
' a card and its time stops; switch to another window and every card's time stops. Cards slide and
' fade in and out; drag one sideways to swipe it away. F6 moves the keyboard to the cards (this
' demo's choice of chord -- tkToast has none): Tab / Shift+Tab, Up / Down, Enter, Esc / Delete,
' Shift+Esc for all. Export posts a loading toast that counts to 100 % and finishes as a result.
' The status line says what the callbacks heard.
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkToast"
#import "vendor/tkControls/tkButton"
#import "vendor/tkControls/tkLabel"
using tkApp
using tkToast
using tkNotify
using tkButton
using tkLabel
using tkTheme
using tkHost
using tkPaint

dim shared as TK_WIDGET ptr gRoot, gLog
dim shared as long gPos = TST_POS_BOTTOM_RIGHT, gN, gExportId, gExportPct

sub Log_( byref s as const ustring )
    tkLabel_SetText( gLog, s )
end sub

sub OnAction( byval hT as TK_WIDGET ptr, byval id as long, byval nAction as long, byval pCtx as any ptr )
    Log_( "Toast " & id & ": action " & nAction )
end sub

sub OnDismissed( byval hT as TK_WIDGET ptr, byval id as long, byval reason as long, byval pCtx as any ptr )
    dim as string why
    select case reason
    case TKN_CLOSE_BUTTON  : why = "the close button"
    case TKN_CLOSE_ACTION  : why = "an action"
    case TKN_CLOSE_TIMEOUT : why = "its timeout"
    case else              : why = "reason " & reason
    end select
    Log_( "Toast " & id & " dismissed by " & why )
end sub

sub OnInfo( byval h as TK_WIDGET ptr, byval id as long )
    gN += 1
    tkToast_ShowText( gRoot, "Information number " & gN & ". It goes in 5 seconds unless you hover it." )
end sub

sub OnSuccess( byval h as TK_WIDGET ptr, byval id as long )
    dim as TK_TOAST t
    t.severity = TKN_SUCCESS : t.title = "Saved" : t.message = "orders.csv, 12,408 rows"
    tkToast_Show( gRoot, t )
end sub

sub OnUndo( byval h as TK_WIDGET ptr, byval id as long )
    dim as TK_TOAST t
    t.severity = TKN_WARNING : t.title = "3 files deleted"
    t.message = "A toast with an action stays until you act or close it."
    t.action1 = "Undo" : t.action2 = "Details"
    tkToast_Show( gRoot, t )
end sub

sub OnHigh( byval h as TK_WIDGET ptr, byval id as long )
    dim as TK_TOAST t
    t.severity = TKN_ERROR : t.title = "Connection lost" : t.message = "HIGH priority: shows at once."
    t.priority = TST_PRIO_HIGH
    tkToast_Show( gRoot, t )
end sub

sub OnRepeat( byval h as TK_WIDGET ptr, byval id as long )
    tkToast_ShowText( gRoot, "Retrying...", TKN_WARNING )      ' the same text again counts up
end sub

sub OnSameKey( byval h as TK_WIDGET ptr, byval id as long )
    static as long nStep
    nStep = (nStep mod 3) + 1
    dim as TK_TOAST t
    t.key = "sync" : t.title = "Syncing" : t.message = "Step " & nStep & " of 3 (same key: one card)"
    tkToast_Show( gRoot, t )
end sub

sub OnPosition( byval h as TK_WIDGET ptr, byval id as long )
    gPos = (gPos + 1) mod 6
    tkToast_SetPosition( gRoot, gPos )
    Log_( "Position " & gPos )
end sub

sub OnClear( byval h as TK_WIDGET ptr, byval id as long )
    tkToast_DismissAll( gRoot )
end sub

sub OnMotion( byval h as TK_WIDGET ptr, byval id as long )
    tkToast_SetAnimate( gRoot, tkToast_GetAnimate( gRoot ) = false )
    Log_( iif( tkToast_GetAnimate( gRoot ), "Motion on", "Motion off" ) )
end sub

sub OnExportTick( byval timerId as long, byval payload as any ptr )
    gExportPct += 10
    if gExportPct < 100 then
        tkToast_SetProgress( gRoot, gExportId, gExportPct )
    else
        tkApp_KillTimer( timerId )
        tkToast_Finish( gRoot, gExportId, TKN_SUCCESS, "Exported 12,408 rows to orders.csv" )
    end if
end sub

sub OnExport( byval h as TK_WIDGET ptr, byval id as long )
    gExportId = tkToast_Begin( gRoot, "Exporting 12,408 rows...", "export" )
    gExportPct = 0
    tkApp_SetTimer( 300, @OnExportTick )
end sub

function OnKey( byval f as TK_FORM ptr, byval key as long, byval mods as long ) as boolean
    if key <> SDLK_F6 then return false
    if tkToast_FocusToasts( gRoot ) = false then Log_( "No toasts to focus" )
    return true
end function

dim as TKAPP_OPTIONS opts
if tkApp_Init( opts ) = false then end 98
dim as TK_FORM ptr f = tkApp_NewForm( "tkToast demo", 900, 560 )
gRoot = tkForm_Widget( f )

dim as string caps(0 to 9) = { "Info", "Success", "Action (sticky)", "Error HIGH", "Repeat", "Same key", "Position", "Dismiss all", "Motion on/off", "Export (loading)" }
dim as BTN_ClickCallbackSub cbs(0 to 9) = { @OnInfo, @OnSuccess, @OnUndo, @OnHigh, @OnRepeat, @OnSameKey, @OnPosition, @OnClear, @OnMotion, @OnExport }
for i as long = 0 to 9
    dim as TK_WIDGET ptr b = tkButton_Create( gRoot, 10 + i )
    tkButton_SetText( b, caps(i) )
    tkButton_SetClickCallback( b, cbs(i) )
    tkWidget_SetPos( b, tkForm_Scale( f, 16 ), tkForm_Scale( f, 16 + i * 40 ), tkForm_Scale( f, 160 ), tkForm_Scale( f, 32 ) )
next
gLog = tkLabel_Create( gRoot, 30 )
tkWidget_SetPos( gLog, tkForm_Scale( f, 200 ), tkForm_Scale( f, 16 ), tkForm_Scale( f, 680 ), tkForm_Scale( f, 24 ) )
Log_( "Post some toasts." )

tkToast_ApplyFonts( gRoot, tkForm_Font( f, TKFONT_UI ), tkForm_Font( f, TKFONT_UI_BOLD ), tkForm_Font( f, TKFONT_GLYPH ) )
tkToast_SetActionCallback( gRoot, @OnAction )
tkToast_SetDismissedCallback( gRoot, @OnDismissed )
tkForm_OnKeyDown( f, @OnKey )

end tkApp_Run( f )
