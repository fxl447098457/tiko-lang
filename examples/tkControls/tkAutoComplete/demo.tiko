' tkAutoComplete demo: five boxes. Cities matched anywhere, with the country as a dimmed detail and
' the matched letters in bold; a country lookup (limit to list, a drop button, NotInList keeps the
' text with the error border); a search box with a delayed Search event; inline completion of
' commands; and a staff directory whose rows the host filters (ItemsNeeded).
'
'   demo                          interactive (type; Down / Up; Enter / Tab commit; Escape)
'   demo --shot out.bmp           render once, save the window, exit
'   demo --shot out.bmp --open    the same with the first box's list open on "an" (also out.bmp.pop.bmp)
'   demo --scale 1.75             pin the scale
#import "vendor/tkControls/tkAutoComplete"
using tkAutoComplete
using tkTheme
using tkHost
using tkPaint

dim shared as TK_HOST ptr gHost
dim shared as TK_WIDGET ptr gAC(0 to 4)
dim shared as ustring gLabel(0 to 4)
dim shared as TTF_Font ptr gFont, gBold
dim shared as ustring gStaff(0 to 9)          ' "name|team", filled at startup

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

private function HasArg( byref name_ as string ) as boolean
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return true
    next
    return false
end function

private sub Demo_Selected( byval h as TK_WIDGET ptr, byval index as long, byval id as longint )
    print "ItemSelected " & tkAutoComplete_GetID( h ) & ": index " & index & ", id " & id & ", text """ & tkAutoComplete_GetText( h ) & """"
end sub

private sub Demo_TextChanged( byval h as TK_WIDGET ptr, byval bFromList as boolean )
    print "TextChanged " & tkAutoComplete_GetID( h ) & ": """ & tkAutoComplete_GetText( h ) & """" & iif( bFromList, " (from the list)", "" )
end sub

private sub Demo_Submit( byval h as TK_WIDGET ptr, byref text as const ustring, byval index as long )
    print "Submit " & tkAutoComplete_GetID( h ) & ": """ & text & """ index " & index
end sub

private sub Demo_Search( byval h as TK_WIDGET ptr, byref text as const ustring )
    print "Search " & tkAutoComplete_GetID( h ) & ": """ & text & """"
end sub

private sub Demo_DropDown( byval h as TK_WIDGET ptr, byval isOpen as boolean )
    print "DropDown " & tkAutoComplete_GetID( h ) & ": " & iif( isOpen, "open", "closed" )
end sub

private sub Demo_NotInList( byval h as TK_WIDGET ptr, byref text as const ustring, byref action as long )
    print "NotInList " & tkAutoComplete_GetID( h ) & ": """ & text & """ (kept, flagged)"
    action = AC_KEEP
end sub

' The host filters: every staff member whose name or team contains the query.
private sub Demo_ItemsNeeded( byval h as TK_WIDGET ptr, byref query as const ustring )
    tkAutoComplete_ClearResults( h )
    for i as long = 0 to ubound( gStaff )
        dim as long bar = instr( gStaff(i), "|" )
        if instr( lcase( gStaff(i) ), lcase( query ) ) then
            tkAutoComplete_AddResult( h, left( gStaff(i), bar - 1 ), 7000 + i, mid( gStaff(i), bar + 1 ) )
        end if
    next
end sub

private sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    b->SetFont( gFont )
    b->SetForeColor( tkTheme_Of( tkHost_Root( h ) ).TextDim )
    for i as long = 0 to 4
        dim as TKRECT rc
        tkRect_Set( rc, tkHost_Scale( h, 20 ), tkHost_Scale( h, 20 + i * 50 ), tkHost_Scale( h, 230 ), tkHost_Scale( h, 20 + i * 50 + 32 ) )
        b->PaintText( gLabel(i), @rc, TK_DT_LEFT or TK_DT_VCENTER )
    next
end sub

private sub Form_Size( byval h as TK_HOST ptr )
    for i as long = 0 to 4
        tkWidget_SetPos( gAC(i), tkHost_Scale( h, 240 ), tkHost_Scale( h, 20 + i * 50 ), tkHost_Scale( h, 280 ), tkHost_Scale( h, 32 ) )
    next
end sub

private sub SaveShot( byval h as TK_HOST ptr, byref path as string )
    tkHost_Render( h )
    tkHost_RenderTo( h, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( h->renderer, 0 )
    if s then
        SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & h->fScale
        SDL_DestroySurface( s )
    end if
end sub

if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
gHost = tkHost_Create( "tkAutoComplete on SDL3", 540, 272, tkHost_FontDir() & TK_FONT_UI, val( ArgValue( "--scale" ) ) )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
gHost->clrBack = tkTheme_Of( tkHost_Root( gHost ) ).Window
gFont = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 10 )
gBold = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI_BOLD, 10 )

gLabel(0) = "city: contains, details, bold"
gLabel(1) = "country lookup, drop button"
gLabel(2) = "search, delayed Search event"
gLabel(3) = "command: inline completion"
gLabel(4) = "staff: rows from the host"
for i as long = 0 to 4
    gAC(i) = tkAutoComplete_Create( tkHost_Root( gHost ), 1000 + i )
    tkAutoComplete_SetFont( gAC(i), gFont )
    tkAutoComplete_SetItemSelectedCallback( gAC(i), @Demo_Selected )
    tkAutoComplete_SetTextChangedCallback( gAC(i), @Demo_TextChanged )
    tkAutoComplete_SetDropDownCallback( gAC(i), @Demo_DropDown )
next

dim as ustring cities(0 to 11) = { "Amsterdam|Netherlands", "Athens|Greece", "Auckland|New Zealand", "Bangkok|Thailand", _
    "Buenos Aires|Argentina", "Cape Town|South Africa", "Copenhagen|Denmark", "Dublin|Ireland", "Montreal|Canada", _
    "Santiago|Chile", "Vancouver|Canada", "Wellington|New Zealand" }
for k as long = 0 to 11
    dim as TKAUTOCOMPLETE_ITEM it
    dim as long bar = instr( cities(k), "|" )
    it.text = left( cities(k), bar - 1 ) : it.detail = mid( cities(k), bar + 1 ) : it.id = 100 + k
    tkAutoComplete_AddItemEx( gAC(0), it )
next
tkAutoComplete_SetFilterMode( gAC(0), TKAC_FILTER_CONTAINS )
tkAutoComplete_SetRankPrefixFirst( gAC(0), true )
tkAutoComplete_SetMatchBold( gAC(0), true, gBold )
tkAutoComplete_SetEmptyText( gAC(0), "No such city" )
tkAutoComplete_SetPlaceholderText( gAC(0), "City" )

dim as ustring countries(0 to 7) = { "Argentina", "Canada", "Chile", "Denmark", "Greece", "Ireland", "Netherlands", "New Zealand" }
dim as long isoNum(0 to 7) = { 32, 124, 152, 208, 300, 372, 528, 554 }
for k as long = 0 to 7
    tkAutoComplete_AddItem( gAC(1), countries(k), isoNum(k) )
next
tkAutoComplete_SetValuePolicy( gAC(1), TKAC_VALUE_LIMITTOLIST )
tkAutoComplete_SetDropButton( gAC(1), true )
tkAutoComplete_SetSelectedId( gAC(1), 152 )                        ' silent: "Chile"
tkAutoComplete_SetNotInListCallback( gAC(1), @Demo_NotInList )

tkAutoComplete_SetStyle( gAC(2), TKAC_STYLE_SEARCH )
tkAutoComplete_SetSearchDelay( gAC(2), 300 )
tkAutoComplete_SetPlaceholderText( gAC(2), "Search invoices" )
tkAutoComplete_SetText( gAC(2), "overdue" )                         ' shows the clear button
tkAutoComplete_SetSearchCallback( gAC(2), @Demo_Search )

dim as ustring cmds(0 to 7) = { "build", "build --release", "clean", "format", "install", "publish", "run", "test" }
tkAutoComplete_SetItems( gAC(3), cmds() )
tkAutoComplete_SetMode( gAC(3), TKAC_MODE_SUGGESTAPPEND )
tkAutoComplete_SetPlaceholderText( gAC(3), "Command" )
tkAutoComplete_SetSubmitCallback( gAC(3), @Demo_Submit )

dim as ustring staff(0 to 9) = { "Abbott, Lena|Finance", "Baker, Tom|Sales", "Chen, Wei|Engineering", _
    "Diaz, Maria|Support", "Evans, Owen|Engineering", "Fischer, Anna|Legal", "Garcia, Luis|Sales", _
    "Hughes, Nora|Marketing", "Ivanova, Olga|Engineering", "Jensen, Mads|Finance" }
for k as long = 0 to 9
    gStaff(k) = staff(k)
next
tkAutoComplete_SetItemsNeededCallback( gAC(4), @Demo_ItemsNeeded )
tkAutoComplete_SetDelay( gAC(4), 100 )
tkAutoComplete_SetListWidth( gAC(4), -1 )                           ' the widest row
tkAutoComplete_SetPlaceholderText( gAC(4), "Name or team" )

gHost->OnPaint = @Form_Paint
gHost->OnSize = @Form_Size
Form_Size( gHost )
tkHost_SetFocus( gHost, gAC(0) )
tkHost_Show( gHost )

dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )
    if HasArg( "--open" ) then
        tkAutoComplete_SetText( gAC(0), "an" )
        tkAutoComplete_DropDown( gAC(0) )
        for k as long = 1 to 10
            tkHost_Pump( gHost )
            SDL_Delay( 15 )
        next
        dim as TK_HOST ptr pop = tkAutoComplete_GetListHandle( gAC(0) )
        if pop then SaveShot( pop, shot & ".pop.bmp" )
    end if
    SaveShot( gHost, shot )
else
    tkHost_Run( gHost )
end if
tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
