' tkChipGroup demo (phases C1 - C3): a filter row (multi, counts), a single choice, a removable
' tag list with avatars that can be reordered (removing "Admin" is vetoed), and one row with a "+N".
'
'   demo                     interactive (Tab to a group; arrows, Space, Delete; in People, drag
'                            a chip or Shift+Left / Right to reorder)
'   demo --shot out.bmp      render once, save the window, exit
'   demo --scale 1.75        pin the scale instead of asking the display
#import "vendor/tkControls/tkChipGroup"
using tkChipGroup
using tkChip
using tkBadge
using tkTheme
using tkHost
using tkPaint

dim shared as TK_HOST ptr gHost
dim shared as TTF_Font ptr gFont

sub OnSel( byval hGroup as TK_WIDGET ptr, byval idx as long, byval isSelected as boolean )
    print "selection: " & tkChipGroup_GetSelectedKeys( hGroup )
end sub

function OnRemoving( byval hGroup as TK_WIDGET ptr, byval idx as long ) as boolean
    if tkChipGroup_GetItemKey( hGroup, idx ) = "Admin" then print "Admin cannot be removed" : return false
    return true
end function

sub OnRemoved( byval hGroup as TK_WIDGET ptr, byval Key as ustring )
    print "removed " & Key & "; left: " & tkChipGroup_GetItemsText( hGroup )
end sub

sub OnMoved( byval hGroup as TK_WIDGET ptr, byval nFrom as long, byval nTo as long )
    print "moved " & nFrom & " -> " & nTo & ": " & tkChipGroup_GetItemsText( hGroup )
end sub

sub OnOverflow( byval hGroup as TK_WIDGET ptr )
    print "+N clicked: " & tkChipGroup_GetTipText( hGroup, TKCHIPGRP_OVERFLOW )
end sub

sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    dim as TKTHEME_COLORS t = tkTheme_Of( tkHost_Root( h ) )
    dim as ustring heads(0 to 3) = { "Filters (multi, counts)", "Size (single choice)", "People (removable, reorderable; Admin is vetoed)", "One row (+N)" }
    b->SetFont( gFont )
    b->SetColors( t.TextDim, t.Window )
    for i as long = 0 to 3
        dim as TKRECT rc
        dim as long y = 8 + i * 84 + iif( i = 3, 40, 0 )        ' the people wrap to two rows
        tkRect_Set( rc, tkHost_Scale( h, 20 ), tkHost_Scale( h, y ), tkHost_Scale( h, 600 ), tkHost_Scale( h, y + 18 ) )
        b->PaintText( heads(i), @rc, TK_DT_LEFT or TK_DT_VCENTER )
    next
end sub

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

private sub SaveShot( byref path as string )
    tkHost_Render( gHost )
    tkHost_RenderTo( gHost, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( gHost->renderer, 0 )
    if s then
        SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & gHost->fScale
        SDL_DestroySurface( s )
    end if
end sub

private function NewGroup( byval y as long, byref items as ustring ) as TK_WIDGET ptr
    dim as TK_WIDGET ptr g = tkChipGroup_Create( tkHost_Root( gHost ), 0 )
    tkChipGroup_ApplyFonts( g, gFont, 0 )
    tkChipGroup_SetItemsText( g, items )
    tkChipGroup_SetSelChangeCallback( g, @OnSel )
    tkChipGroup_SetItemRemovingCallback( g, @OnRemoving )
    tkChipGroup_SetItemRemovedCallback( g, @OnRemoved )
    tkChipGroup_SetOverflowClickCallback( g, @OnOverflow )
    tkWidget_SetPos( g, tkHost_Scale( gHost, 14 ), tkHost_Scale( gHost, y ), tkHost_Scale( gHost, 560 ), tkHost_Scale( gHost, 40 ) )
    return g
end function

private sub Fit( byval g as TK_WIDGET ptr )
    tkWidget_SetSize( g, g->cw, tkChipGroup_GetIdealHeight( g, g->cw ) )
end sub

' ---- main --------------------------------------------------------------------------------
if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
gHost = tkHost_Create( "tkChipGroup on SDL3", 600, 390, tkHost_FontDir() & TK_FONT_UI, val( ArgValue( "--scale" ) ) )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
gHost->clrBack = tkTheme_Of( tkHost_Root( gHost ) ).Window
gFont = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 9 )

dim as TK_WIDGET ptr g
g = NewGroup( 28, "Unread;Flagged;Attachments;From me;This week" )
tkChipGroup_SetSelectionMode( g, TKCHIPGRP_MULTI )
tkChipGroup_SetItemCountBadge( g, 0, 12 ) : tkChipGroup_SetItemCountBadge( g, 1, 3 )
tkChipGroup_SetSelectedKeys( g, "Unread;Attachments" )
Fit( g )

g = NewGroup( 112, "XS;S;M;L;XL;XXL" )
tkChipGroup_SetSelectionMode( g, TKCHIPGRP_SINGLE )
tkChipGroup_SetSelectedKeys( g, "M" )
Fit( g )

g = NewGroup( 196, "Ada Lovelace;Grace Hopper;Admin;Alan Turing;Ken Thompson" )
tkChipGroup_SetRemovable( g, true )
tkChipGroup_SetAllowReorder( g, true )
tkChipGroup_SetItemMovedCallback( g, @OnMoved )
for i as long = 0 to 4
    if i <> 2 then tkChipGroup_SetItemLeadingAvatar( g, i )
next
tkChipGroup_SetItemStatus( g, 2, TKBADGE_WARNING )
Fit( g )

g = NewGroup( 320, "Rust;Go;Zig;tiko;FreeBASIC;C;Odin;Nim;Haskell;OCaml" )
tkChipGroup_SetWrap( g, false )
tkChipGroup_SetSize( g, TKCHIP_SMALL )
Fit( g )

gHost->OnPaint = @Form_Paint
tkHost_Show( gHost )
dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )
    SaveShot( shot )
else
    tkHost_Run( gHost )
end if
tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
