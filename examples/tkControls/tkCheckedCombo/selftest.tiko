' tkCheckedCombo (and tkItemPopup) self-test. Real windows, real SDL event queue: every input claim
' is made by PUSHING the SDL event a user would have produced and pumping the host. Two passes, scale
' pinned at 1.0 and at 1.75. The design: C:\dev\docs\tkControls\CHECKED-LISTS.md §6-§7 (phase C3).
'
'   selftest            exit code = number of failures
#import "vendor/tkControls/tkCheckedCombo"
#import "vendor/tkControls/tkTest"
using tkCheckedCombo
using tkItemPopup
using tkComboBox
using tkListTree
using tkTheme
using tkTest
using tkHost
using tkPaint

dim shared as long gCheck, gChanged, gDropOpen, gDropClose, gLastIdx = -9
dim shared as boolean gLastNew, gVeto
dim shared as TK_WIDGET ptr gFrom

function OnItemCheck( byval h as TK_WIDGET ptr, byval idx as long, byval bNew as boolean ) as boolean
    gCheck += 1 : gLastIdx = idx : gLastNew = bNew
    return gVeto = false
end function
sub OnChanged( byval h as TK_WIDGET ptr )
    gChanged += 1 : gFrom = h
end sub
sub OnDrop( byval h as TK_WIDGET ptr, byval isOpen as boolean )
    if isOpen then gDropOpen += 1 else gDropClose += 1
end sub
sub ResetCounts()
    gCheck = 0 : gChanged = 0 : gDropOpen = 0 : gDropClose = 0 : gLastIdx = -9 : gVeto = false : gFrom = 0
end sub

' The window pixel centre of the combo.
sub ComboXY( byval cc as TK_WIDGET ptr, byref x as single, byref y as single )
    dim as TKRECT a
    tkWidget_AbsRect( cc, a )
    x = (a.left + a.right) \ 2 : y = (a.top + a.bottom) \ 2
end sub

' Clicks list row r in the popup (x: surface-local, -1 = the middle).
sub ClickRow( byval cc as TK_WIDGET ptr, byval r as long, byval lx as long = -1 )
    dim as TK_WIDGET ptr L = tkCheckedCombo_GetListTree( cc )
    dim as TK_WIDGET ptr s = tkListTree_GetSurface( L )
    dim as TKRECT a
    tkWidget_AbsRect( s, a )
    dim as long ih = tkListTree_GetItemHeightPx( L )
    tkTest_Click( tkCheckedCombo_GetListHost( cc ), a.left + iif( lx >= 0, lx, s->cw \ 2 ), a.top + r * ih + ih \ 2 )
end sub

sub ClickWidget( byval hHost as TK_HOST ptr, byval w as TK_WIDGET ptr )
    dim as TKRECT a
    tkWidget_AbsRect( w, a )
    tkTest_Click( hHost, (a.left + a.right) \ 2, (a.top + a.bottom) \ 2 )
end sub

' The box centre's surface x of list row r.
function BoxX( byval cc as TK_WIDGET ptr, byval r as long ) as long
    dim as TKRECT rc
    tkListTree_GetCheckRect( tkCheckedCombo_GetListTree( cc ), r, rc )
    return (rc.left + rc.right) \ 2
end function

sub OpenByClick( byval h as TK_HOST ptr, byval cc as TK_WIDGET ptr )
    dim as single x, y
    ComboXY( cc, x, y )
    tkTest_Click( h, x, y )
end sub

sub RunPass( byval fScale as single )
    tkTest_Begin( "scale " & fScale )
    dim as TK_HOST ptr h = tkHost_Create( "tkCheckedCombo selftest", 480, 420, tkHost_FontDir() & TK_FONT_UI, fScale )
    if h = 0 then tkTest_Check( "host", false, *SDL_GetError() ) : exit sub
    dim as TTF_Font ptr f10 = tkHost_OpenFont( h, tkHost_FontDir() & TK_FONT_UI, 10 )
    tkHost_Show( h )
    tkTest_PumpFor( h, 300 )

    dim as TK_WIDGET ptr cc = tkCheckedCombo_Create( tkHost_Root( h ), 800 )
    dim as TK_WIDGET ptr other = tkCheckedCombo_Create( tkHost_Root( h ), 900 )      ' the next tab stop
    tkCheckedCombo_SetFont( cc, f10 )
    tkCheckedCombo_SetItemCheckCallback( cc, @OnItemCheck )
    tkCheckedCombo_SetCheckedChangedCallback( cc, @OnChanged )
    tkCheckedCombo_SetDropDownCallback( cc, @OnDrop )
    tkWidget_SetPos( cc, tkHost_Scale( h, 20 ), tkHost_Scale( h, 20 ), tkHost_Scale( h, 240 ), tkHost_Scale( h, 30 ) )
    tkWidget_SetPos( other, tkHost_Scale( h, 20 ), tkHost_Scale( h, 340 ), tkHost_Scale( h, 120 ), tkHost_Scale( h, 30 ) )
    tkCheckedCombo_AddItem( other, "x" )
    tkCheckedCombo_AddItem( cc, "Red", "red" )         ' 0
    tkCheckedCombo_AddItem( cc, "Green" )              ' 1
    tkCheckedCombo_AddItem( cc, "Blue", "blue", 7 )    ' 2
    tkCheckedCombo_AddItem( cc, "Gray", "gray" )       ' 3
    tkCheckedCombo_AddItem( cc, "Amber", "amber" )     ' 4
    tkCheckedCombo_SetItemEnabled( cc, 4, false )
    tkTest_PumpFor( h, 30 )
    tkTest_Check( "items", (tkCheckedCombo_GetCount( cc ) = 5) andalso (tkCheckedCombo_GetItemKey( cc, 1 ) = "Green") _
        andalso (tkCheckedCombo_GetItemID( cc, 2 ) = 7) andalso (tkCheckedCombo_FindItemByKey( cc, "gray" ) = 3) )

    ' ---- the summary and the value (silent) ---------------------------------------------------
    ResetCounts()
    tkCheckedCombo_SetPlaceholderText( cc, "Pick colours" )
    tkTest_Check( "none checked: the placeholder", tkCheckedCombo_GetDisplayText( cc ) = "Pick colours" )
    tkCheckedCombo_SetCheckedText( cc, "blue; red" )
    tkTest_Check( "JOIN: names in item order", tkCheckedCombo_GetDisplayText( cc ) = "Red, Blue", tkCheckedCombo_GetDisplayText( cc ) )
    tkTest_Check( "the value: keys in item order", tkCheckedCombo_GetCheckedText( cc ) = "red;blue" )
    tkCheckedCombo_SetSummaryMode( cc, CCB_SUMMARY_COUNT )
    tkTest_Check( "COUNT", tkCheckedCombo_GetDisplayText( cc ) = "2 selected" )
    tkCheckedCombo_SetCountFormat( cc, "{n} of {total}" )
    ' FIT: size the text rect to fit "Red +1" but not "Red, Blue"
    tkCheckedCombo_SetSummaryMode( cc, CCB_SUMMARY_FIT )
    dim as TKRECT rt
    tkCheckedCombo_GetTextRect( cc, rt )
    dim as long w0 = rt.right - rt.left, wFit = tkText_Width( f10, "Red +1" ) + 2
    tkWidget_SetSize( cc, cc->cw - w0 + wFit, cc->ch )
    tkTest_PumpFor( h, 20 )
    tkTest_Check( "FIT: what fits, then +k", tkCheckedCombo_GetDisplayText( cc ) = "Red +1", tkCheckedCombo_GetDisplayText( cc ) )
    tkWidget_SetSize( cc, tkHost_Scale( h, 240 ), cc->ch )
    tkCheckedCombo_SetSummaryMode( cc, CCB_SUMMARY_JOIN )
    tkCheckedCombo_SetAllText( cc, "All" )
    tkCheckedCombo_CheckAll( cc, true )
    tkTest_Check( "AllText when every item is checked", tkCheckedCombo_GetDisplayText( cc ) = "All" )
    tkCheckedCombo_SetAllText( cc, "" )
    tkCheckedCombo_SetCheckedText( cc, "" )
    tkTest_Check( "the setters are silent", (gCheck = 0) andalso (gChanged = 0) )
    tkCheckedCombo_SetCheckedText( cc, "red;blue" )
    tkHost_RenderTo( h, false )
    dim as TKRECT ac
    tkWidget_AbsRect( cc, ac )
    tkCheckedCombo_GetTextRect( cc, rt )
    tkTest_Check( "the button paints the summary", tkTest_TonesIn( h, ac.left + rt.left, ac.top + rt.top, rt.right - rt.left, rt.bottom - rt.top, &hFF000000ul ) > 2 )

    ' ---- open by a click; the popup ---------------------------------------------------------------
    ResetCounts()
    OpenByClick( h, cc )
    dim as TK_HOST ptr ph = tkCheckedCombo_GetListHost( cc )
    dim as TK_WIDGET ptr L = tkCheckedCombo_GetListTree( cc )
    tkTest_Check( "a click opens the list; DropDown( true ) once", tkCheckedCombo_IsDroppedDown( cc ) andalso (ph <> 0) andalso (L <> 0) andalso (gDropOpen = 1) )
    tkTest_Check( "the popup never takes the OS focus (NOT_FOCUSABLE)", (SDL_GetWindowFlags( ph->win ) and SDL_WINDOW_NOT_FOCUSABLE) <> 0 )
    tkTest_Check( "a row per item, the checks copied in", (tkListTree_GetCount( L ) = 5) andalso (tkListTree_GetCheck( L, 0 ) = LT_CHECK_CHECKED) _
        andalso (tkListTree_GetCheck( L, 1 ) = LT_CHECK_UNCHECKED) andalso (tkListTree_GetCheck( L, 2 ) = LT_CHECK_CHECKED) )
    tkTest_Check( "the list is at least as wide as the combo", L->cw >= cc->cw - 2 * tkHost_Scale( h, 1 ) )
    ' keys reach the popup though the main window has the focus
    tkTest_PushKey( h, SDLK_DOWN )
    tkTest_Check( "Down moves the current row", tkListTree_GetCurSel( L ) = 1 )
    tkTest_PushKey( h, SDLK_SPACE )
    tkTest_Check( "Space checks it: ItemCheck( 1, true ) then CheckedChanged, live", tkCheckedCombo_GetChecked( cc, 1 ) _
        andalso (gCheck = 1) andalso (gLastIdx = 1) andalso gLastNew andalso (gChanged = 1) andalso (gFrom = cc) )
    ClickRow( cc, 3 )
    tkTest_Check( "a row click toggles (check on click)", tkCheckedCombo_GetChecked( cc, 3 ) andalso (gChanged = 2) )
    tkTest_Check( "after a click the key widget has the popup's focus back", ph->pFocus <> tkListTree_GetSurface( L ) )
    ClickRow( cc, 4, BoxX( cc, 4 ) )
    tkTest_Check( "a disabled item cannot be checked", (tkCheckedCombo_GetChecked( cc, 4 ) = false) andalso (gChanged = 2) )
    gVeto = true
    ClickRow( cc, 0, BoxX( cc, 0 ) )
    tkTest_Check( "ItemCheck vetoes", tkCheckedCombo_GetChecked( cc, 0 ) andalso (gChanged = 2) )
    gVeto = false
    tkTest_PushKey( h, SDLK_ESCAPE )
    tkTest_Check( "Escape closes; immediate changes stay; DropDown( false )", (tkCheckedCombo_IsDroppedDown( cc ) = false) _
        andalso (gDropClose = 1) andalso (tkCheckedCombo_GetCheckedText( cc ) = "red;Green;blue;gray") )

    ' ---- the closed keys --------------------------------------------------------------------------
    tkHost_SetFocus( h, cc )
    tkTest_PushKey( h, SDLK_DOWN )
    ResetCounts()
    tkTest_PushKey( h, SDLK_DELETE )
    tkTest_Check( "Delete clears every check, one CheckedChanged", (tkCheckedCombo_GetCheckedCount( cc ) = 0) andalso (gChanged = 1) )
    tkTest_PushKey( h, SDLK_F4 )
    tkTest_PushKey( h, SDLK_A, TK_KMOD_PRIMARY )
    tkTest_Check( "Ctrl+A checks every enabled item", (tkCheckedCombo_GetCheckedCount( cc ) = 4) andalso (tkCheckedCombo_GetChecked( cc, 4 ) = false) _
        andalso (gLastIdx = -1) )
    tkTest_PushKey( h, SDLK_A, TK_KMOD_PRIMARY )
    tkTest_PushKey( h, SDLK_TAB )
    tkTest_Check( "Tab closes and moves the focus on", (tkCheckedCombo_IsDroppedDown( cc ) = false) andalso (h->pFocus = other) )

    ' ---- select-all ------------------------------------------------------------------------------
    tkCheckedCombo_SetShowSelectAll( cc, true )
    tkCheckedCombo_SetCheckedText( cc, "red" )
    ResetCounts()
    tkHost_SetFocus( h, cc )
    tkTest_PushKey( h, SDLK_F4 )
    L = tkCheckedCombo_GetListTree( cc )
    tkTest_Check( "select-all is row 0, mixed when some are checked", (tkListTree_GetCount( L ) = 6) andalso (tkListTree_GetText( L, 0 ) = "(Select all)") _
        andalso (tkListTree_GetCheck( L, 0 ) = LT_CHECK_MIXED) andalso (tkCheckedCombo_GetListRow( cc, 0 ) = 1) )
    ClickRow( cc, 0, BoxX( cc, 0 ) )
    tkTest_Check( "select-all checks every enabled item (Amber stays), ItemCheck( -1 ), one CheckedChanged", _
        (tkCheckedCombo_GetCheckedCount( cc ) = 4) andalso (tkCheckedCombo_GetChecked( cc, 4 ) = false) andalso (gLastIdx = -1) andalso (gChanged = 1) )
    tkTest_Check( "the disabled row's box was put back", tkListTree_GetCheck( L, 5 ) = LT_CHECK_UNCHECKED )
    tkTest_Check( "select-all is now checked (the disabled item is left out)", tkListTree_GetCheck( L, 0 ) = LT_CHECK_CHECKED )
    ClickRow( cc, 2, BoxX( cc, 2 ) )
    tkTest_PushKey( h, SDLK_ESCAPE )
    tkCheckedCombo_SetShowSelectAll( cc, false )

    ' ---- MaxChecked ------------------------------------------------------------------------------
    tkCheckedCombo_SetMaxChecked( cc, 2 )
    tkCheckedCombo_SetCheckedText( cc, "red;blue" )
    ResetCounts()
    tkTest_PushKey( h, SDLK_F4 )
    L = tkCheckedCombo_GetListTree( cc )
    tkListTree_SetCurSel( L, 1 )
    tkTest_PushKey( h, SDLK_SPACE )
    tkTest_Check( "at MaxChecked a further check is refused (before ItemCheck)", (tkCheckedCombo_GetChecked( cc, 1 ) = false) andalso (gCheck = 0) )
    tkListTree_SetCurSel( L, 0 )
    tkTest_PushKey( h, SDLK_SPACE )
    tkTest_PushKey( h, SDLK_ESCAPE )
    tkCheckedCombo_SetMaxChecked( cc, 0 )

    ' ---- ShowButtons: deferred commit -----------------------------------------------------------
    tkCheckedCombo_SetShowButtons( cc, true )
    tkCheckedCombo_SetCheckedText( cc, "red" )
    ResetCounts()
    tkTest_PushKey( h, SDLK_F4 )
    L = tkCheckedCombo_GetListTree( cc )
    tkListTree_SetCurSel( L, 1 )
    tkTest_PushKey( h, SDLK_SPACE )
    tkTest_Check( "deferred: a toggle leaves the value alone, no CheckedChanged", (tkCheckedCombo_GetChecked( cc, 1 ) = false) andalso (gChanged = 0) _
        andalso (tkListTree_GetCheck( L, 1 ) = LT_CHECK_CHECKED) andalso (gCheck = 1) )
    tkTest_PushKey( h, SDLK_ESCAPE )
    tkTest_Check( "Escape throws the working copy away", (tkCheckedCombo_GetCheckedText( cc ) = "red") andalso (gChanged = 0) )
    tkTest_PushKey( h, SDLK_F4 )
    L = tkCheckedCombo_GetListTree( cc )
    tkListTree_SetCurSel( L, 1 )
    tkTest_PushKey( h, SDLK_SPACE )
    tkTest_PushKey( h, SDLK_RETURN )
    tkTest_Check( "Enter commits it: one CheckedChanged", (tkCheckedCombo_GetCheckedText( cc ) = "red;Green") andalso (gChanged = 1), _
        "[" & tkCheckedCombo_GetCheckedText( cc ) & "] changed " & gChanged & " open " & tkCheckedCombo_IsDroppedDown( cc ) )
    tkTest_PushKey( h, SDLK_F4 )
    dim as TK_WIDGET ptr bCancel = tkCheckedCombo_GetListButton( cc, false )
    L = tkCheckedCombo_GetListTree( cc )
    tkListTree_SetCurSel( L, 2 )
    tkTest_PushKey( h, SDLK_SPACE )
    ClickWidget( tkCheckedCombo_GetListHost( cc ), bCancel )
    tkTest_PushKey( h, SDLK_F4 )
    L = tkCheckedCombo_GetListTree( cc )
    tkListTree_SetCurSel( L, 2 )
    tkTest_PushKey( h, SDLK_SPACE )
    ClickWidget( tkCheckedCombo_GetListHost( cc ), tkCheckedCombo_GetListButton( cc, true ) )
    tkTest_Check( "OK commits", (tkCheckedCombo_IsDroppedDown( cc ) = false) andalso (tkCheckedCombo_GetCheckedText( cc ) = "red;Green;blue") andalso (gChanged = 2) )
    tkCheckedCombo_SetShowButtons( cc, false )

    ' ---- the filter --------------------------------------------------------------------------------
    tkCheckedCombo_SetShowFilter( cc, true )
    tkHost_SetFocus( h, cc )
    tkTest_Check( "ShowFilter: the combo wants text input", cc->bWantsText )
    tkTest_PushText( h, "g" )
    L = tkCheckedCombo_GetListTree( cc )
    tkTest_Check( "a character on the closed combo opens the list filtered by it", tkCheckedCombo_IsDroppedDown( cc ) _
        andalso (tkCheckedCombo_GetFilterText( cc ) = "g") andalso (tkListTree_GetCount( L ) = 2) andalso (tkCheckedCombo_GetListRow( cc, 0 ) = -1) _
        andalso (tkCheckedCombo_GetListRow( cc, 3 ) = 1), "rows " & tkListTree_GetCount( L ) )
    tkTest_PushText( h, "R" )
    tkTest_Check( "typing narrows (case ignored)", (tkCheckedCombo_GetFilterText( cc ) = "gR") andalso (tkListTree_GetCount( L ) = 2) )
    tkTest_PushText( h, "e" )
    tkTest_PushKey( h, SDLK_BACKSPACE )
    tkTest_Check( "Backspace widens", (tkCheckedCombo_GetFilterText( cc ) = "gR") andalso (tkListTree_GetCount( L ) = 2) )
    ResetCounts()
    tkTest_PushKey( h, SDLK_SPACE )
    tkTest_PushText( h, " " )
    tkTest_Check( "with a filter, Space toggles the row and types nothing", (tkCheckedCombo_GetFilterText( cc ) = "gR") andalso (gChanged = 1) )
    tkTest_Check( "a filtered-out item keeps its check", tkCheckedCombo_GetChecked( cc, 0 ) )
    tkTest_PushKey( h, SDLK_ESCAPE )
    tkTest_Check( "Escape with a filter clears the filter, the list stays", tkCheckedCombo_IsDroppedDown( cc ) andalso (tkCheckedCombo_GetFilterText( cc ) = "") _
        andalso (tkListTree_GetCount( L ) = 5) )
    tkTest_PushKey( h, SDLK_ESCAPE )
    tkCheckedCombo_SetShowFilter( cc, false )

    ' ---- theme ------------------------------------------------------------------------------------
    dim as TKCHECKEDCOMBO_COLORS c1, c2
    tkCheckedCombo_GetColors( cc, @c1 )
    c2 = c1 : c2.BackColor = &hFF102030ul
    tkCheckedCombo_SetColors( cc, @c2 )
    tkCheckedCombo_ApplyTheme( cc, tkTheme_Light() )
    tkCheckedCombo_GetColors( cc, @c1 )
    tkTest_Check( "SetColors pins", c1.BackColor = &hFF102030ul )
    tkCheckedCombo_UnpinColors( cc )

    ' ---- destroyed while open --------------------------------------------------------------------
    tkHost_SetFocus( h, cc )
    tkTest_PushKey( h, SDLK_F4 )
    tkTest_Check( "open at the end", tkCheckedCombo_IsDroppedDown( cc ) )
    tkHost_Destroy( h )
    tkTest_Check( "destroying the window with the list open is clean", true )
end sub

if tkTest_Init() = false then end 99
RunPass( 1.0 )
RunPass( 1.75 )
dim as long nFail = tkTest_Report( "tkCheckedCombo" )
tkTest_Quit()
end nFail
