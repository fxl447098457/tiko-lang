' tkCheckedCombo demo: four multi-select combos. Languages with a filter line, a select-all row and
' the fit summary ("A, B +k"); colours joined, with an OK / Cancel footer; regions counted, with an
' all-checked text; seats with at most two checked, one sold out, and a placeholder.
'
'   demo                          interactive (click / F4 / Space opens; Space or a click toggles; Delete clears)
'   demo --shot out.bmp           render once, save the window, exit
'   demo --shot out.bmp --open    the same with the first combo's list open (also out.bmp.pop.bmp)
'   demo --scale 1.75             pin the scale
#import "vendor/tkControls/tkCheckedCombo"
using tkCheckedCombo
using tkTheme
using tkHost
using tkPaint

dim shared as TK_HOST ptr gHost
dim shared as TK_WIDGET ptr gCbo(0 to 3)
dim shared as ustring gLabel(0 to 3)
dim shared as TTF_Font ptr gFont

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

private function HasArg( byref name_ as string ) as boolean
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return true
    next
    return false
end function

' ItemCheck: before a user's toggle (idx -1 = select-all or Ctrl+A). Vetoes nothing here.
private function Demo_ItemCheck( byval h as TK_WIDGET ptr, byval idx as long, byval bNewChecked as boolean ) as boolean
    dim as ustring what = "(all shown)"
    if idx >= 0 then what = tkCheckedCombo_GetItemText( h, idx )
    print "ItemCheck " & tkCheckedCombo_GetID( h ) & ": " & what & " -> " & iif( bNewChecked, "on", "off" )
    return true
end function

private sub Demo_Changed( byval h as TK_WIDGET ptr )
    print "CheckedChanged " & tkCheckedCombo_GetID( h ) & ": value """ & tkCheckedCombo_GetCheckedText( h ) _
        & """, shows """ & tkCheckedCombo_GetDisplayText( h ) & """"
end sub

private sub Demo_DropDown( byval h as TK_WIDGET ptr, byval isOpen as boolean )
    print "DropDown " & tkCheckedCombo_GetID( h ) & ": " & iif( isOpen, "open", "closed" )
end sub

private sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    b->SetFont( gFont )
    b->SetForeColor( tkTheme_Of( tkHost_Root( h ) ).TextDim )
    for i as long = 0 to 3
        dim as TKRECT rc
        tkRect_Set( rc, tkHost_Scale( h, 20 ), tkHost_Scale( h, 20 + i * 50 ), tkHost_Scale( h, 250 ), tkHost_Scale( h, 20 + i * 50 + 30 ) )
        b->PaintText( gLabel(i), @rc, TK_DT_LEFT or TK_DT_VCENTER )
    next
end sub

private sub Form_Size( byval h as TK_HOST ptr )
    for i as long = 0 to 3
        tkWidget_SetPos( gCbo(i), tkHost_Scale( h, 260 ), tkHost_Scale( h, 20 + i * 50 ), tkHost_Scale( h, 250 ), tkHost_Scale( h, 30 ) )
    next
end sub

private sub SaveShot( byval h as TK_HOST ptr, byref path as string )
    tkHost_Render( h )
    tkHost_RenderTo( h, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( h->renderer, 0 )
    if s then
        SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & h->fScale
        SDL_DestroySurface( s )
    end if
end sub

if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
gHost = tkHost_Create( "tkCheckedCombo on SDL3", 540, 240, tkHost_FontDir() & TK_FONT_UI, val( ArgValue( "--scale" ) ) )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
gHost->clrBack = tkTheme_Of( tkHost_Root( gHost ) ).Window
gFont = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 10 )

gLabel(0) = "filter, select all, fit summary"
gLabel(1) = "joined, OK / Cancel footer"
gLabel(2) = "count summary, all-checked text"
gLabel(3) = "at most two, one sold out"
for i as long = 0 to 3
    gCbo(i) = tkCheckedCombo_Create( tkHost_Root( gHost ), 1000 + i )
    tkCheckedCombo_SetFont( gCbo(i), gFont )
next

dim as ustring langs(0 to 11) = { "English", "French", "German", "Spanish", "Italian", "Portuguese", "Dutch", _
                                  "Polish", "Swedish", "Japanese", "Korean", "Chinese" }
dim as ustring codes(0 to 11) = { "en", "fr", "de", "es", "it", "pt", "nl", "pl", "sv", "ja", "ko", "zh" }
for k as long = 0 to 11
    tkCheckedCombo_AddItem( gCbo(0), langs(k), codes(k) )
next
tkCheckedCombo_SetSummaryMode( gCbo(0), CCB_SUMMARY_FIT )
tkCheckedCombo_SetShowFilter( gCbo(0), true )
tkCheckedCombo_SetShowSelectAll( gCbo(0), true )
tkCheckedCombo_SetSelectAllText( gCbo(0), "All languages" )
tkCheckedCombo_SetListMaxRows( gCbo(0), 8 )
tkCheckedCombo_SetCheckedText( gCbo(0), "en;fr;de;ja;ko" )

tkCheckedCombo_AddItem( gCbo(1), "Red", "red" )
tkCheckedCombo_AddItem( gCbo(1), "Orange", "orange" )
tkCheckedCombo_AddItem( gCbo(1), "Green", "green" )
tkCheckedCombo_AddItem( gCbo(1), "Blue", "blue" )
tkCheckedCombo_AddItem( gCbo(1), "Violet", "violet" )
tkCheckedCombo_SetShowButtons( gCbo(1), true )
tkCheckedCombo_SetButtonTexts( gCbo(1), "Apply", "Cancel" )
tkCheckedCombo_SetCheckedText( gCbo(1), "red;blue" )

dim as ustring regions(0 to 4) = { "North America", "South America", "Europe", "Africa", "Asia-Pacific" }
for k as long = 0 to 4
    tkCheckedCombo_AddItem( gCbo(2), regions(k), "", 10 + k )      ' no key: the text is the key
next
tkCheckedCombo_SetSummaryMode( gCbo(2), CCB_SUMMARY_COUNT )
tkCheckedCombo_SetCountFormat( gCbo(2), "{n} of {total} regions" )
tkCheckedCombo_SetAllText( gCbo(2), "Worldwide" )
tkCheckedCombo_SetCheckedText( gCbo(2), "Europe;Africa;Asia-Pacific" )

dim as ustring seats(0 to 5) = { "12A window", "12B middle", "12C aisle", "14A window", "14B middle", "14C aisle" }
for k as long = 0 to 5
    tkCheckedCombo_AddItem( gCbo(3), seats(k), left( seats(k), 3 ) )
next
tkCheckedCombo_SetItemEnabled( gCbo(3), 3, false )                 ' 14A is sold out
tkCheckedCombo_SetMaxChecked( gCbo(3), 2 )
tkCheckedCombo_SetPlaceholderText( gCbo(3), "Pick up to two seats" )
tkCheckedCombo_SetTooltipText( gCbo(3), "Two seats per booking" )

for i as long = 0 to 3
    tkCheckedCombo_SetItemCheckCallback( gCbo(i), @Demo_ItemCheck )
    tkCheckedCombo_SetCheckedChangedCallback( gCbo(i), @Demo_Changed )
    tkCheckedCombo_SetDropDownCallback( gCbo(i), @Demo_DropDown )
next

gHost->OnPaint = @Form_Paint
gHost->OnSize = @Form_Size
Form_Size( gHost )
tkHost_SetFocus( gHost, gCbo(0) )
tkHost_Show( gHost )

dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )
    if HasArg( "--open" ) then
        tkCheckedCombo_DropDown( gCbo(0) )
        for k as long = 1 to 10
            tkHost_Pump( gHost )
            SDL_Delay( 15 )
        next
        dim as TK_HOST ptr pop = tkCheckedCombo_GetListHost( gCbo(0) )
        if pop then SaveShot( pop, shot & ".pop.bmp" )
    end if
    SaveShot( gHost, shot )
else
    tkHost_Run( gHost )
end if
tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
