' tkGroupBox demo: theme colours, a bold caption with pinned colours, a caption cut with an ellipsis,
' a box nested in a box, and one with no caption. Children are placed inside
' tkGroupBox_GetClientRect. The button disables and re-enables the first box (printed).
'
'   demo                     run it
'   demo --shot out.bmp      render once, save the window, exit
'   demo --shot out.bmp --off      the same with the Options box disabled
'   demo --scale 1.75        pin the scale
#import "vendor/tkControls/tkGroupBox"
#import "vendor/tkControls/tkLabel"
#import "vendor/tkControls/tkButton"
using tkGroupBox
using tkLabel
using tkButton
using tkTheme
using tkHost
using tkPaint

dim shared as TK_HOST ptr gHost
dim shared as TK_WIDGET ptr gFirst
dim shared as TTF_Font ptr gBold

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

private function HasArg( byref name_ as string ) as boolean
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return true
    next
    return false
end function

private sub Toggle_Click( byval hButton as TK_WIDGET ptr, byval id as long )
    dim as boolean bOn = (tkWidget_IsEnabled( gFirst ) = false)
    tkWidget_Enable( gFirst, bOn )
    tkButton_SetText( hButton, iif( bOn, "Disable Options", "Enable Options" ) )
    print "Options box " & iif( bOn, "enabled", "disabled" )
end sub

private function NewBox( byval hParent as TK_WIDGET ptr, byval id as long, byref cap as ustring, byval x as long, byval y as long, byval w as long, byval hgt as long ) as TK_WIDGET ptr
    dim as TK_WIDGET ptr G = tkGroupBox_Create( hParent, id )
    tkWidget_SetPos( G, tkHost_Scale( gHost, x ), tkHost_Scale( gHost, y ), tkHost_Scale( gHost, w ), tkHost_Scale( gHost, hgt ) )
    tkGroupBox_SetText( G, cap )
    return G
end function

' A one-line label on row nRow of the box's client area.
private function AddLine( byval G as TK_WIDGET ptr, byval nRow as long, byref s as ustring ) as TK_WIDGET ptr
    dim as TKRECT rc
    tkGroupBox_GetClientRect( G, rc )
    dim as TK_WIDGET ptr L = tkLabel_Create( G, 0 )
    tkWidget_SetPos( L, rc.left, rc.top + nRow * tkHost_Scale( gHost, 24 ), rc.right - rc.left, tkHost_Scale( gHost, 22 ) )
    tkLabel_SetText( L, s )
    tkLabel_SetEllipsis( L, true )
    return L
end function

private sub SaveShot( byval h as TK_HOST ptr, byref path as string )
    tkHost_Render( h )
    tkHost_RenderTo( h, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( h->renderer, 0 )
    if s then
        SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & h->fScale
        SDL_DestroySurface( s )
    end if
end sub

if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
gHost = tkHost_Create( "tkGroupBox on SDL3", 720, 420, tkHost_FontDir() & TK_FONT_UI, val( ArgValue( "--scale" ) ) )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
dim as TKTHEME_COLORS t = tkTheme_Of( tkHost_Root( gHost ) )
gHost->clrBack = t.Window
gBold = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI_BOLD, 11 )
dim as TK_WIDGET ptr root = tkHost_Root( gHost )

' theme colours
gFirst = NewBox( root, 1, "Options", 20, 20, 220, 150 )
AddLine( gFirst, 0, "Theme colours" )
AddLine( gFirst, 1, "Caption in TextDim" )
AddLine( gFirst, 2, "Children inside the client rect" )

' a bold caption and pinned colours
dim as TK_WIDGET ptr g2 = NewBox( root, 2, "Bold caption", 255, 20, 220, 150 )
tkGroupBox_SetFont( g2, gBold )
dim as TKGROUPBOX_COLORS c
c.BackColor = t.Window : c.BorderColor = t.Accent : c.TextColor = t.Accent : c.TextColorDisabled = t.TextDisabled
tkGroupBox_SetColors( g2, c )
AddLine( g2, 0, "SetFont: 11 pt bold" )
AddLine( g2, 1, "SetColors: pinned" )
AddLine( g2, 2, "Client rect clears the taller caption" )

' a caption too long for the box
dim as TK_WIDGET ptr g3 = NewBox( root, 3, "A caption far too long for this box is cut short", 490, 20, 210, 150 )
dim as TK_WIDGET ptr lw = AddLine( g3, 0, "" )
dim as TKRECT rc3
tkGroupBox_GetClientRect( g3, rc3 )
tkWidget_SetPos( lw, rc3.left, rc3.top, rc3.right - rc3.left, rc3.bottom - rc3.top )
tkLabel_SetEllipsis( lw, false )
tkLabel_SetWordWrap( lw, true )
tkLabel_SetVAlign( lw, LBL_VALIGN_TOP )
tkLabel_SetText( lw, "The caption keeps an indent at both ends and ends in an ellipsis; the frame line stops either side of it." )

' a box nested inside a box
dim as TK_WIDGET ptr g4 = NewBox( root, 4, "Outer", 20, 190, 455, 210 )
dim as TKRECT rc4
tkGroupBox_GetClientRect( g4, rc4 )
dim as TK_WIDGET ptr g5 = tkGroupBox_Create( g4, 5 )
tkWidget_SetPos( g5, rc4.left, rc4.top, tkHost_Scale( gHost, 220 ), rc4.bottom - rc4.top )
tkGroupBox_SetText( g5, "Nested" )
AddLine( g5, 0, "A box inside a box" )
AddLine( g5, 1, "Placed at Outer's client rect" )
dim as TK_WIDGET ptr lo = tkLabel_Create( g4, 0 )
tkWidget_SetPos( lo, rc4.left + tkHost_Scale( gHost, 236 ), rc4.top + tkHost_Scale( gHost, 10 ), rc4.right - rc4.left - tkHost_Scale( gHost, 236 ), tkHost_Scale( gHost, 22 ) )
tkLabel_SetText( lo, "Outer's own child" )

' no caption: the frame runs unbroken
dim as TK_WIDGET ptr g6 = NewBox( root, 6, "", 490, 190, 210, 210 )
AddLine( g6, 0, "No caption" )
AddLine( g6, 1, "The frame runs unbroken" )
dim as TKRECT rc6
tkGroupBox_GetClientRect( g6, rc6 )
dim as TK_WIDGET ptr btn = tkButton_Create( g6, 100 )
tkButton_SetText( btn, "Disable Options" )
tkButton_SetClickCallback( btn, @Toggle_Click )
tkWidget_SetPos( btn, rc6.left, rc6.bottom - tkHost_Scale( gHost, 32 ), rc6.right - rc6.left, tkHost_Scale( gHost, 32 ) )

if HasArg( "--off" ) then Toggle_Click( btn, 100 )
tkHost_Show( gHost )

dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )
    SaveShot( gHost, shot )
else
    tkHost_Run( gHost )
end if
tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
