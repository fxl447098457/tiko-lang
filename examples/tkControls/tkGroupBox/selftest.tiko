' tkGroupBox self-test. Real windows; scale pinned at 1.0 and 1.75.
#import "vendor/tkControls/tkGroupBox"
#import "vendor/tkControls/tkTest"
using tkGroupBox
using tkTheme
using tkTest
using tkHost
using tkPaint

sub RunPass( byval fScale as single )
    tkTest_Begin( "scale " & fScale )
    dim as TK_HOST ptr h = tkHost_Create( "tkGroupBox selftest", 640, 480, tkHost_FontDir() & TK_FONT_UI, fScale )
    dim as TK_WIDGET ptr G = tkGroupBox_Create( tkHost_Root( h ), 1 )
    tkHost_Show( h )
    tkWidget_SetPos( G, 40, 40, 300, 200 )
    tkTest_PumpFor( h, 50 )

    tkTest_Check( "not a tab stop", G->isFocusable = false )
    tkGroupBox_SetText( G, "Options" )
    tkTest_Check( "caption reads back", tkGroupBox_GetText( G ) = "Options" )

    dim as TKRECT rc
    tkTest_Check( "client rect answered", tkGroupBox_GetClientRect( G, rc ) )
    dim as long pad = cint( TKGROUPBOX_PADDING * fScale ), capH = TTF_GetFontHeight( h->pDefaultFont )
    tkTest_Check( "client left", rc.left = pad, str( rc.left ) )
    tkTest_Check( "client top clears the caption", rc.top = capH + pad, str( rc.top ) )
    tkTest_Check( "client right", rc.right = 300 - pad, str( rc.right ) )
    tkTest_Check( "client bottom", rc.bottom = 200 - pad, str( rc.bottom ) )

    tkWidget_SetPos( G, 40, 40, 4, 4 )
    tkGroupBox_GetClientRect( G, rc )
    tkTest_Check( "a tiny box gives an empty client, never inverted", (rc.right >= rc.left) andalso (rc.bottom >= rc.top), rc.left & "," & rc.top & "," & rc.right & "," & rc.bottom )
    tkWidget_SetPos( G, 40, 40, 300, 200 )

    dim as TKGROUPBOX_COLORS c
    c.BackColor = &hFF102030ul : c.BorderColor = &hFF00FF00ul : c.TextColor = &hFFFFFFFFul : c.TextColorDisabled = &hFF808080ul
    tkGroupBox_SetColors( G, c )
    tkTest_Check( "colours read back", tkGroupBox_GetColors( G ).BorderColor = &hFF00FF00ul )
    tkHost_RenderTo( h, false )
    tkTest_Check( "the frame's left line draws", (tkTest_PixelAt( h, 40, 40 + 100 ) and &hFFFFFFul) = &h00FF00ul, hex( tkTest_PixelAt( h, 40, 140 ) ) )
    tkTest_Check( "the frame's bottom line draws", (tkTest_PixelAt( h, 40 + 150, 40 + 199 ) and &hFFFFFFul) = &h00FF00ul, hex( tkTest_PixelAt( h, 190, 239 ) ) )
    tkTest_Check( "the inside is the back colour", (tkTest_PixelAt( h, 40 + 150, 40 + 100 ) and &hFFFFFFul) = &h102030ul )
    ' The line breaks around the caption.
    dim as long indent = cint( TKGROUPBOX_CAPTION_INDENT * fScale )
    tkTest_Check( "the frame's top line stops at the caption", (tkTest_PixelAt( h, 40 + indent + 2, 40 + capH \ 2 ) and &hFFFFFFul) <> &h00FF00ul )
    tkTest_Check( "...and runs on past it", (tkTest_PixelAt( h, 40 + 290, 40 + capH \ 2 ) and &hFFFFFFul) = &h00FF00ul )
    dim as ulong c0
    tkTest_Check( "the caption draws", tkTest_TonesIn( h, 40 + indent, 40, tkText_Width( h->pDefaultFont, "Options" ), capH, c0 ) > 1 )

    tkGroupBox_UnpinColors( G )
    tkTest_Check( "unpin returns to the theme", tkGroupBox_GetColors( G ).BorderColor = tkTheme_Get().Border )
    tkHost_Destroy( h )
end sub

if tkTest_Init() = false then end 99
RunPass( 1.0 )
RunPass( 1.75 )
dim as long nFail = tkTest_Report( "tkGroupBox" )
tkTest_Quit()
end nFail
