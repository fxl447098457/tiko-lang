' tkMeta self-test. Every control in the table is created through its thunk, every property applied
' from text and read back where it can be, at scale 1.0 and 1.75.
#import "vendor/tkControls/tkMeta"
#import "vendor/tkControls/tkTest"
using tkMeta
using tkTheme
using tkTest
using tkHost
using tkPaint

' Entry i of "Shown=CONST,...": the shown name. "" past the end.
function EnumShown( byref e as const ustring, byval i as long ) as ustring
    dim as long at = 1, n = 0
    do
        dim as long comma = instr( at, e, "," )
        dim as ustring item = iif( comma > 0, mid( e, at, comma - at ), mid( e, at ) )
        if n = i then return left( item, instr( item, "=" ) - 1 )
        if comma = 0 then return ""
        at = comma + 1
        n += 1
    loop
end function

' These answer -1 or 0 until the control holds columns, panels or a range.
function NeedsContent( byref who as const ustring ) as boolean
    select case who
    case "ListTree.FillColumn", "ColumnHeader.FillColumn", "StatusBar.ExpandPanel", "VScrollBar.Position", "HScrollBar.Position"
        return true
    end select
    return false
end function

' An int the control keeps as given (MonthCount is 1 or 2).
function IntValue( byref who as const ustring ) as ustring
    if who = "DatePicker.MonthCount" then return "2"
    return "3"
end function

' A value for a "list" property: one per slot, of the slot's kind.
function ListValue( byref pairs as const ustring ) as ustring
    dim as ustring o
    for i as long = 0 to tkMeta_ListCount( pairs ) - 1
        if i then o &= ","
        select case tkMeta_ListSlot( pairs, i )
        case "int", "float" : o &= "1"
        case "color"        : o &= "&hFF112233"
        case "bool"         : o &= "true"
        case else           : o &= "a"
        end select
    next
    return o
end function

' The colour struct, read before any property pins it: every slot is the theme's, through both thunks.
sub CheckColors( byval c as TKMETA_CONTROL ptr, byval w as TK_WIDGET ptr )
    if c->NumColorSlots = 0 then exit sub
    tkTest_Check( c->Name & " has colour thunks", (c->GetColors <> 0) andalso (c->ThemeColors <> 0) andalso (len( c->ColorStruct ) > 0) )
    dim as ulong got( 0 to c->NumColorSlots - 1 ), want( 0 to c->NumColorSlots - 1 )
    c->GetColors( w, @got( 0 ) )
    c->ThemeColors( tkTheme_Of( w ), @want( 0 ) )
    dim as long d = -1
    for i as long = 0 to c->NumColorSlots - 1
        if got( i ) <> want( i ) then d = i : exit for
    next
    tkTest_Check( c->Name & ": GetColors = ThemeColors at create, slot for slot", d = -1, "slot " & d )
end sub

sub TryValue( byval c as TKMETA_CONTROL ptr, byval p as TKMETA_PROP ptr, byval w as TK_WIDGET ptr, byref v as const ustring )
    p->Apply( w, v )
    if (p->Read_ = 0) orelse NeedsContent( c->Name & "." & p->Name ) then exit sub
    dim as ustring got = p->Read_( w )
    tkTest_Check( c->Name & "." & p->Name & " = " & v, got = v, "read back '" & got & "'" )
end sub

sub CheckControl( byval c as TKMETA_CONTROL ptr, byval h as TK_HOST ptr, byval parent as TK_WIDGET ptr, byval id as long )
    dim as ustring arg = c->CreateArgDflt
    dim as TK_WIDGET ptr w = c->Create( parent, id, arg )
    tkTest_Check( c->Name & " created", w <> 0 )
    if w = 0 then exit sub
    tkWidget_SetPos( w, 10, 10, cint( c->Width_ * h->fScale ), cint( c->Height_ * h->fScale ) )
    CheckColors( c, w )

    for i as long = 0 to c->NumProps - 1
        dim as TKMETA_PROP ptr p = @c->Props( i )
        select case p->Kind
        case "font"
            tkTest_Check( c->Name & "." & p->Name & " has a font thunk", p->ApplyFont <> 0 )
            p->ApplyFont( w, h->pDefaultFont )
        case "text"
            TryValue( c, p, w, "abc" )
        case "glyph"
            p->Apply( w, "A" )
        case "file"
            TryValue( c, p, w, "no-such-file.png" )
        case "int"
            TryValue( c, p, w, IntValue( c->Name & "." & p->Name ) )
        case "bool"
            TryValue( c, p, w, "true" )
            TryValue( c, p, w, "false" )
        case "float"
            TryValue( c, p, w, "2" )
        case "color"
            TryValue( c, p, w, "&hFF112233" )
        case "enum"
            dim as long e = 0
            do
                dim as ustring shown = EnumShown( p->EnumPairs, e )
                if len( shown ) = 0 then exit do
                TryValue( c, p, w, shown )
                e += 1
            loop
        case "list"
            dim as ustring v = ListValue( p->EnumPairs )
            tkTest_Check( c->Name & "." & p->Name & " list value fits", len( tkMeta_ListFault( v, p->EnumPairs ) ) = 0, v )
            p->Apply( w, v )
        case else
            tkTest_Check( c->Name & "." & p->Name & " has a known kind", false, p->Kind )
        end select
    next
    for i as long = 0 to c->NumProps - 1
        dim as TKMETA_PROP ptr p = @c->Props( i )
        if len( p->DefaultValue ) andalso (p->Read_ <> 0) then TryValue( c, p, w, p->DefaultValue )
    next
    if len( c->DefaultEvent ) then
        tkTest_Check( c->Name & " default event exists", tkMeta_FindEvent( c, c->DefaultEvent ) <> 0, c->DefaultEvent )
    end if
    tkHost_Pump( h )
    tkHost_RenderTo( h, false )
    tkWidget_Destroy( w )
end sub

sub RunPass( byval fScale as single )
    tkTest_Begin( "scale " & fScale )
    dim as TK_HOST ptr h = tkHost_Create( "tkMeta selftest", 900, 700, tkHost_FontDir() & TK_FONT_UI, fScale )
    tkHost_Show( h )
    tkTest_PumpFor( h, 50 )
    dim as TK_WIDGET ptr root_ = tkHost_Root( h )
    tkTest_Check( "the table is populated", tkMeta_Count( ) = 30, str( tkMeta_Count( ) ) )
    tkTest_Check( "find by name", tkMeta_Find( "Button" ) <> 0 )
    tkTest_Check( "find misses", tkMeta_Find( "NoSuchControl" ) = 0 )
    tkTest_Check( "find a property", tkMeta_FindProp( tkMeta_Find( "Button" ), "Text" ) <> 0 )
    tkTest_Check( "find an event", tkMeta_FindEvent( tkMeta_Find( "Button" ), "Click" ) <> 0 )
    tkTest_Check( "a click handler takes nothing", len( tkMeta_FindEvent( tkMeta_Find( "Button" ), "Click" )->Params ) = 0 )
    ' Themes (THEMES.md, TH3): which controls have a colour struct, which properties a theme's shape
    ' supplies, which colour properties the inspector leaves to the Colors dialog.
    dim as long nColors = 0, nSlots = 0, nShape = 0, nHidden = 0
    for i as long = 0 to tkMeta_Count( ) - 1
        dim as TKMETA_CONTROL ptr c = tkMeta_At( i )
        if c->NumColorSlots then nColors += 1 : nSlots += c->NumColorSlots
        for k as long = 0 to c->NumProps - 1
            if len( c->Props( k ).ThemeShape ) then nShape += 1
            if c->Props( k ).bInspector = false then nHidden += 1
        next
    next
    tkTest_Check( "23 controls describe a colour struct, 292 fields", (nColors = 23) andalso (nSlots = 292), nColors & " / " & nSlots )
    tkTest_Check( "12 shape properties, 14 hidden colour properties", (nShape = 12) andalso (nHidden = 14), nShape & " / " & nHidden )
    dim as TKMETA_CONTROL ptr btn = tkMeta_Find( "Button" )
    tkTest_Check( "Button: slot by name, cell by part and state", (tkMeta_ColorSlot( btn, "FocusRingColor" ) = 16) _
        andalso (tkMeta_ColorCell( btn, "", "Back", "Hot" ) = 4) andalso (tkMeta_ColorCell( btn, "", "Back", "Open" ) = -1) )
    dim as TKMETA_PROP ptr cc = tkMeta_FindProp( btn, "CornerCurvature" )
    tkTest_Check( "Button.CornerCurvature is the theme's CornerRadius x 2", (cc->ThemeShape = "CornerRadius") andalso (cc->ShapeScale = 2) )
    dim as TKMETA_CONTROL ptr chk = tkMeta_Find( "CheckBox" )
    dim as long sl = tkMeta_ColorCell( chk, "Checked", "Box", "Pressed" )
    tkTest_Check( "CheckBox: the Checked grid", (sl >= 0) andalso (chk->Colors( sl ).Name = "BoxColorCheckedPressed") )
    tkTest_Check( "ink parts are marked", chk->Colors( tkMeta_ColorSlot( chk, "ForeColor" ) ).bInk andalso (chk->Colors( tkMeta_ColorSlot( chk, "BackColor" ) ).bInk = false) )
    tkTest_Check( "a hidden colour property", tkMeta_FindProp( tkMeta_Find( "Label" ), "TextColor" )->bInspector = false _
        andalso tkMeta_FindProp( tkMeta_Find( "ListTree" ), "BackColor" )->bInspector )
    for i as long = 0 to tkMeta_Count( ) - 1
        CheckControl( tkMeta_At( i ), h, root_, 100 + i )
    next
    ' A choice made at creation: every value makes a control.
    dim as TKMETA_CONTROL ptr chart = tkMeta_Find( "Chart" )
    dim as long e = 0
    do
        dim as ustring shown = EnumShown( chart->CreateArgEnum, e )
        if len( shown ) = 0 then exit do
        dim as TK_WIDGET ptr w = chart->Create( root_, 900 + e, shown )
        tkTest_Check( "Chart created as " & shown, w <> 0 )
        if w then tkWidget_Destroy( w )
        e += 1
    loop
    tkHost_Destroy( h )
end sub

if tkTest_Init() = false then end 99
RunPass( 1.0 )
RunPass( 1.75 )
dim as long nFail = tkTest_Report( "tkMeta" )
tkTest_Quit()
end nFail
