format = 1

[report]
title = "Mixed"

[report.events]
PaintItem = "OnPaint"

[[parameter]]
name = "Note"
default = "\"n\""

[[parameter]]
name = "Min"
type = "int"
default = "2"

[[parameter]]
name = "Rate"
type = "float"
default = "1.5"

[[parameter]]
name = "Paid"
type = "bool"
default = "true"

[[parameter]]
name = "From"
type = "date"
default = "#2026-01-01#"

[[parameter]]
name = "At"
type = "time"
default = "#09:30#"

[[source]]
name = "Items"
kind = "sqlite"
sql = "select name, qty from items where qty >= :Min order by qty"
params = { Min = "@Min" }

  [[source.field]]
  name = "name"

  [[source.field]]
  name = "qty"
  kind = "int"

[[source]]
name = "Stock"
kind = "grid"

[[source]]
name = "Extra"

[[band]]
id = "d"
kind = "detail"
source = "Items"

[[item]]
id = "line"
band = "d"
rect = [0, 0, 300, 14]
text = "{[name]} {[qty] * @Rate} {iif(@Paid, @Note, \"x\")} {Format(@From, \"yyyy\")} {Format(@At, \"hh:nn\")}"

[[item]]
id = "mark"
band = "d"
kind = "custom"
rect = [300, 0, 10, 14]
tag = 7
