' The program's half of the mixed report: its PaintItem handler (a custom item), counting the calls.
#module "rptMixed"
#import "vendor/tkControls/tkReport"
#import "vendor/tkControls/tkBind"
#import "vendor/tkControls/tkPrint"
using tkReport
using tkBind
using tkPrint

public partial type Report
    Painted as int32
end type

sub Report.OnPaint( byval item as TKREPORT_ITEM ptr, byval pg as TK_PAGE ptr, byref rc as TKRECTF, byval row as TK_VALUE ptr )
    if item->tag = 7 then Painted += 1
end sub
