' The program's half of the designed report: what tkEdit's generator leaves to the program -- here
' its BeforePrint handler ([report.events] in rptOrders.tkreport), a member of `partial type Report`.
#module "rptOrders"
#import "vendor/tkControls/tkReport"
#import "vendor/tkControls/tkBind"
using tkReport
using tkBind

public partial type Report
    Details as int32          ' detail bands the handler saw
    HideBlake as boolean      ' leave Blake's orders out
end type

function Report.OnBeforePrint( byval band as TK_RBAND ptr, byval row as TK_VALUE ptr ) as boolean
    if band->kind = TKRB_DETAIL then Details += 1
    if HideBlake andalso (band->kind = TKRB_GROUP_HEADER) andalso (band->level = 1) andalso (row[1].s = "Blake") then return false
    return true
end function
