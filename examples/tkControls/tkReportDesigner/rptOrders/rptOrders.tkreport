format = 1

[report]
title = "Orders by customer"
margins = [56.69, 56.69, 65.2, 56.69]
data_module = "../orderdb"

[report.events]
BeforePrint = "OnBeforePrint"

[[parameter]]
name = "MinQty"
type = "int"
default = "0"
prompt = "Lines of at least"

[[parameter]]
name = "Heading"
default = "\"Orders\""
prompt = "Heading"

[[source]]
name = "Orders"
kind = "array"
item_type = "orderdb.Order"
items_source = "orderdb.Orders( )"
sort = "[Customer], [Id]"

  [[source.field]]
  name = "Id"
  kind = "int"

  [[source.field]]
  name = "Customer"

  [[source.field]]
  name = "OrderDate"
  kind = "date"

[[source]]
name = "Lines"
kind = "array"
parent = "Orders"
relation = "Lines"
item_type = "orderdb.OrderLine"
sort = "[Product]"
filter = "[Qty] >= @MinQty"

  [[source.field]]
  name = "Product"

  [[source.field]]
  name = "Qty"
  kind = "int"

  [[source.field]]
  name = "Price"
  kind = "float"

[[calc]]
source = "Lines"
name = "LineTotal"
expr = "[Qty] * [Price]"

[[band]]
id = "title"
kind = "report_header"
height = 25.51

[[band]]
id = "g1h"
kind = "group_header"
group = "[Customer]"
height = 65.2

[[band]]
id = "d"
kind = "detail"
source = "Orders"
height = 16

[[band]]
id = "lines"
kind = "detail_report"
parent = "d"
source = "Lines"

[[band]]
id = "ld"
kind = "detail"
parent = "lines"
height = 53.86

[[band]]
id = "lf"
kind = "report_footer"
parent = "lines"
height = 73.7

[[band]]
id = "g1f"
kind = "group_footer"
height = 93.54

[[band]]
id = "rf"
kind = "report_footer"
height = 164.41

[[item]]
id = "titleText"
band = "title"
rect = [0, 0, 400, 18]
text = "{@Heading} (lines of {@MinQty} or more)"

[[item]]
id = "custName"
band = "g1h"
rect = [0, 2, 200, 14]
text = "{[Customer]}"

[[item]]
id = "orderLine"
band = "d"
rect = [10, 1, 300, 14]
text = "Order {[Id]} of {Format([OrderDate], \"dd/mm/yyyy\")}"

[[item]]
id = "product"
band = "ld"
rect = [20, 0, 150, 14]
text = "{[Product]} x{[Qty]}"

[[item]]
id = "lineTotal"
band = "ld"
kind = "field"
rect = [300, 0, 100, 14]
expr = "[LineTotal]"
format = "0.00"
align = "right"

[[item]]
id = "orderTotal"
band = "lf"
kind = "field"
rect = [300, 1, 100, 14]
expr = "Sum([LineTotal])"
format = "0.00"
align = "right"

[[item]]
id = "custTotal"
band = "g1f"
rect = [0, 2, 150, 14]
text = "Customer {Count()} orders"
incr = "master"

[[item]]
id = "custSum"
band = "g1f"
rect = [150, 2, 250, 14]
text = "{Format(Sum([Lines.LineTotal]), \"0.00\")}"

[[item]]
id = "allTotal"
band = "rf"
rect = [0, 2, 400, 14]
text = "All {Format(Sum([Lines.LineTotal]), \"0.00\")}"
