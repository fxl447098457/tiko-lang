' The data of the designed-report sample: orders, each with its lines (an Array field: the relation
' a .tkreport's child source names).
#module "orderdb"
#import "std/containers"
#import "vendor/tkControls/tkCalendar"
using containers
using tkCalendar

public type OrderLine
    Product as ustring
    Qty     as int32
    Price   as float64
end type

public type Order
    Id        as int32
    Customer  as ustring
    OrderDate as TKDATE
    Lines     as Array( of OrderLine )
end type

private sub AddLine( byref o as Order, byref p as const ustring, byval q as int32, byval price as float64 )
    dim as OrderLine l
    l.Product = p : l.Qty = q : l.Price = price
    o.Lines.Push( l )
end sub

private function MakeOrder( byval id as int32, byref c as const ustring, byval y as int32, byval m as int32, byval d as int32 ) as Order
    dim as Order o
    o.Id = id : o.Customer = c
    o.OrderDate.wYear = y : o.OrderDate.wMonth = m : o.OrderDate.wDay = d
    return o
end function

' The rows the report shows when the program gives it none (its items_source).
public function Orders( ) as Array( of Order )
    dim as Array( of Order ) a
    dim as Order o = MakeOrder( 1004, "Avery", 2026, 3, 1 )
    AddLine( o, "Washer", 100, 0.1 )
    a.Push( o )
    o = MakeOrder( 1002, "Avery", 2026, 1, 5 )
    AddLine( o, "Nut", 10, 0.25 )
    AddLine( o, "Bolt", 2, 3.5 )
    a.Push( o )
    o = MakeOrder( 1003, "Blake", 2026, 2, 1 )
    a.Push( o )
    o = MakeOrder( 1005, "Casey", 2026, 3, 2 )
    AddLine( o, "Gear", 3, 12 )
    a.Push( o )
    return a
end function
