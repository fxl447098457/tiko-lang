' tkReportDesigner self-test (Report Designer phase RD4): a report designed in a .tkreport, its
' rptOrders.design.tiko GENERATED by tkEdit (--generate-forms; --check-forms finds it current), and
' this program using it. One check per behaviour: the parameters start at their defaults; the rows
' come from items_source when the program gives none; Array( of T ) masters with an Array child
' (sorted, filtered by a parameter); typed parameters set as fields; the program's own rows;
' the BeforePrint handler the program wrote; ShowIn (a viewer with the parameter strip); ExportPdf.
'
'   selftest            exit code = number of failures
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkReportViewer"
#import "std/containers"
#import "std/fs"
#import "./orderdb"
#import "./rptOrders"
#import "./rptMixed"
#import "./frmView"
#import "vendor/sqlite3"
using tkTest
using tkReportViewer
using tkReport
using tkBind
using tkPrint
using tkHost
using tkPaint
using containers

function Runs( byval doc as TK_PRINTDOC ptr ) as string
    dim as string s
    if doc = 0 then return s
    tkPrintDoc_Generate( doc )
    dim as long np = tkPrintDoc_GetPageCount( doc )
    for pg as long = 0 to np - 1
        for i as long = 0 to tkPrintDoc_GetOpCount( doc, pg ) - 1
            dim as TKPRINT_OPINFO oi
            tkPrintDoc_GetOp( doc, pg, i, oi )
            if oi.op = TKREC_TEXT then s &= oi.text & "|"
            if oi.op = TKPRINT_OP_LATE then s &= PrLateText( oi.text, pg, np, doc ) & "|"
        next
    next
    return s
end function

sub RunPass( )
    tkTest_Begin( "a generated report" )
    dim as rptOrders.Report r
    tkTest_Check( "the parameters start at their defaults", (r.MinQty = 0) andalso (r.Heading = "Orders"), r.MinQty & " " & r.Heading )
    dim as ustring errs
    dim as TK_PRINTDOC ptr doc = r.CreateDoc( errs )
    dim as string s = Runs( doc )
    tkTest_Check( "rows from items_source, sorted; children from the relation, sorted; totals", _
        s = "Orders (lines of 0 or more)|Avery|Order 1002 of 05/01/2026|Bolt x2|7.00|Nut x10|2.50|9.50|Order 1004 of 01/03/2026|Washer x100|10.00|10.00|" & _
            "Customer 2 orders|19.50|Blake|Order 1003 of 01/02/2026|Customer 1 orders|0.00|Casey|Order 1005 of 02/03/2026|Gear x3|36.00|36.00|" & _
            "Customer 1 orders|36.00|All 55.50|", s & " " & errs )
    tkTest_Check( "the program's BeforePrint handler is called", r.Details = 4, str( r.Details ) )
    tkPrintDoc_Destroy( doc )

    r.MinQty = 5
    r.Heading = "Big lines"
    r.HideBlake = true
    doc = r.CreateDoc( errs )
    s = Runs( doc )
    tkTest_Check( "typed parameters reach the child's filter and the text", (instr( s, "Big lines (lines of 5 or more)|" ) = 1) _
        andalso (instr( s, "Bolt" ) = 0) andalso (instr( s, "Gear" ) = 0) andalso (instr( s, "|Nut x10|2.50|2.50|" ) > 0) andalso (instr( s, "|All 12.50|" ) > 0), s )
    tkTest_Check( "the handler's answer hides a band", (instr( s, "Order 1003" ) = 0) andalso (instr( s, "|Blake|" ) > 0), s )
    tkPrintDoc_Destroy( doc )

    ' the program's own rows: items_source is not used
    dim as Array( of orderdb.Order ) mine
    dim as orderdb.Order o
    o.Id = 7 : o.Customer = "Zed" : o.OrderDate.wYear = 2026 : o.OrderDate.wMonth = 11 : o.OrderDate.wDay = 25
    dim as orderdb.OrderLine l
    l.Product = "Cog" : l.Qty = 6 : l.Price = 2
    o.Lines.Push( l )
    mine.Push( o )
    r.SetOrders( mine )
    doc = r.CreateDoc( errs )
    s = Runs( doc )
    tkTest_Check( "SetOrders: the program's own rows", s = "Big lines (lines of 5 or more)|Zed|Order 7 of 25/11/2026|Cog x6|12.00|12.00|Customer 1 orders|12.00|All 12.00|", s )
    tkPrintDoc_Destroy( doc )

    ' a viewer: the parameter strip from the report's parameters, the report shown
    dim as TK_HOST ptr h = tkHost_Create( "RD4", 800, 500, tkHost_FontDir() & TK_FONT_UI, 1.0 )
    dim as TK_WIDGET ptr v = tkReportViewer_Create( tkHost_Root( h ), 1 )
    tkWidget_SetPos( v, 0, 0, 800, 500 )
    dim as boolean shown = r.ShowIn( v )
    tkTest_PumpFor( h, 30 )
    tkTest_Check( "ShowIn: a viewer with a control per parameter and the document", shown andalso (tkReportViewer_GetParamControl( v, 1 ) <> 0) _
        andalso (tkReportViewer_GetDocument( v ) <> 0) andalso (instr( Runs( tkReportViewer_GetDocument( v ) ), "|Zed|" ) > 0) )
    tkReportViewer_SetReportDef( v, 0 )
    tkHost_Destroy( h )

    ' a PDF
    dim as ustring pdf = fs.PathJoin( fs.CreateTempDir( "rd4" ).ValueOr( "." ), "orders.pdf" )
    tkTest_Check( "ExportPdf writes the report", r.ExportPdf( pdf, errs ) andalso fs.IsFile( pdf ), pdf & " " & errs )
end sub

' A second generated report: an SQLite master with a named parameter, a grid and a host source
' (their setters), parameters of all six kinds, a PaintItem handler.
sub MixedPass( )
    tkTest_Begin( "a generated report over SQLite" )
    dim as sqlite3 ptr db
    sqlite3_open( ":memory:", @db )
    sqlite3_exec( db, "create table items( name text, qty integer ); insert into items values( 'a', 1 ), ( 'b', 2 ), ( 'c', 3 );", 0, 0, 0 )
    dim as rptMixed.Report r
    tkTest_Check( "six parameter kinds start at their defaults", (r.Note = "n") andalso (r.Min = 2) andalso (r.Rate = 1.5) andalso r.Paid _
                  andalso (r.From.wYear = 2026) andalso (r.At.wHour = 9) andalso (r.At.wMinute = 30) )
    r.SetDatabase( db )
    dim as ustring errs
    dim as TK_PRINTDOC ptr doc = r.CreateDoc( errs )
    dim as string s = Runs( doc )
    tkTest_Check( "the SQLite source with its parameter by name; every parameter in the text", s = "b 3 n 2026 09:30|c 4.5 n 2026 09:30|", s & " " & errs )
    tkTest_Check( "the PaintItem handler draws the custom items", r.Painted = 2, str( r.Painted ) )
    tkPrintDoc_Destroy( doc )
    r.Min = 3 : r.Paid = false
    doc = r.CreateDoc( errs )
    s = Runs( doc )
    tkTest_Check( "parameters set as fields reach the SQL and the text", s = "c 4.5 x 2026 09:30|", s )
    tkPrintDoc_Destroy( doc )
    sqlite3_close( db )
end sub

' A form's ReportViewer with a report (frmView.tkform: report = "../rptOrders"): the generated
' member is the report's own type, used like any other.
sub FormPass( )
    tkTest_Begin( "a form's designed report" )
    dim as frmView.Form f
    f.rvOrdersReport.MinQty = 5
    dim as ustring errs
    dim as TK_PRINTDOC ptr doc = f.rvOrdersReport.CreateDoc( errs )
    dim as string s = Runs( doc )
    tkTest_Check( "rvOrdersReport: a rptOrders.Report member, its parameter set", instr( s, "Orders (lines of 5 or more)|" ) = 1, s & " " & errs )
    tkPrintDoc_Destroy( doc )
end sub

if tkTest_Init() = false then end 1
RunPass( )
MixedPass( )
FormPass( )
dim as long nFail = tkTest_Report( "tkReportDesigner" )
tkTest_Quit()
end nFail
