' tkCheckedList demo: three checked lists. Weekdays with a locked Sunday (ItemCheck vetoes it),
' pizza toppings with CheckOnClick and at most three checked, and permissions with extended
' selection, a disabled item and a "|" value separator. Each list's value is painted under it.
'
'   demo                     interactive (the box, Space, + / -, a row click with CheckOnClick)
'   demo --shot out.bmp      render once, save the window, exit
'   demo --scale 1.75        pin the scale
#import "vendor/tkControls/tkCheckedList"
using tkCheckedList
using tkListTree
using tkTheme
using tkHost
using tkPaint

dim shared as TK_HOST ptr gHost
dim shared as TK_WIDGET ptr gList(0 to 2)
dim shared as ustring gLabel(0 to 2)
dim shared as TTF_Font ptr gFont

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

private function HasArg( byref name_ as string ) as boolean
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return true
    next
    return false
end function

' ItemCheck: before a user's toggle. Sunday (weekdays) stays as it is; toppings stop at three.
private function Demo_ItemCheck( byval h as TK_WIDGET ptr, byval idx as long, byref bNewChecked as boolean ) as boolean
    dim as long id = tkCheckedList_GetID( h )
    print "ItemCheck " & id & ": " & tkCheckedList_GetItemText( h, idx ) & " -> " & iif( bNewChecked, "on", "off" );
    if (id = 1000) andalso (idx = 6) then print "  (vetoed: Sunday is locked)" : return false
    if (id = 1001) andalso bNewChecked andalso (tkCheckedList_GetCheckedCount( h ) >= 3) then print "  (vetoed: three toppings at most)" : return false
    print
    return true
end function

private sub Demo_Changed( byval h as TK_WIDGET ptr )
    print "CheckedChanged " & tkCheckedList_GetID( h ) & ": " & tkCheckedList_GetCheckedText( h ) & "  (" & tkCheckedList_GetCheckedCount( h ) & " checked)"
    tkHost_Invalidate( gHost )
end sub

private sub Demo_SelChange( byval h as TK_WIDGET ptr, byval idx as long )
    print "SelChange " & tkCheckedList_GetID( h ) & ": " & idx & " " & tkCheckedList_GetItemText( h, idx )
end sub

private sub Demo_Activate( byval h as TK_WIDGET ptr, byval idx as long )
    print "Activate " & tkCheckedList_GetID( h ) & ": " & tkCheckedList_GetItemText( h, idx ) & " (key " & tkCheckedList_GetItemKey( h, idx ) & ")"
end sub

private sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    dim as TKTHEME_COLORS t = tkTheme_Of( tkHost_Root( h ) )
    b->SetFont( gFont )
    for i as long = 0 to 2
        dim as long x = 20 + i * 230
        dim as TKRECT rc
        b->SetForeColor( t.TextDim )
        tkRect_Set( rc, tkHost_Scale( h, x ), tkHost_Scale( h, 12 ), tkHost_Scale( h, x + 210 ), tkHost_Scale( h, 34 ) )
        b->PaintText( gLabel(i), @rc, TK_DT_LEFT or TK_DT_VCENTER )
        b->SetForeColor( t.Text )
        tkRect_Set( rc, tkHost_Scale( h, x ), tkHost_Scale( h, 250 ), tkHost_Scale( h, x + 210 ), tkHost_Scale( h, 272 ) )
        b->PaintText( "value: " & tkCheckedList_GetCheckedText( gList(i) ), @rc, TK_DT_LEFT or TK_DT_VCENTER )
    next
end sub

private sub Form_Size( byval h as TK_HOST ptr )
    for i as long = 0 to 2
        tkWidget_SetPos( gList(i), tkHost_Scale( h, 20 + i * 230 ), tkHost_Scale( h, 38 ), tkHost_Scale( h, 210 ), tkHost_Scale( h, 206 ) )
    next
end sub

private sub SaveShot( byval h as TK_HOST ptr, byref path as string )
    tkHost_Render( h )
    tkHost_RenderTo( h, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( h->renderer, 0 )
    if s then
        SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & h->fScale
        SDL_DestroySurface( s )
    end if
end sub

if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
gHost = tkHost_Create( "tkCheckedList on SDL3", 710, 290, tkHost_FontDir() & TK_FONT_UI, val( ArgValue( "--scale" ) ) )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
gHost->clrBack = tkTheme_Of( tkHost_Root( gHost ) ).Window
gFont = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 10 )

gLabel(0) = "Weekdays (Sunday locked)"
gLabel(1) = "Toppings, CheckOnClick, max 3"
gLabel(2) = "Permissions, extended, '|' value"
for i as long = 0 to 2
    gList(i) = tkCheckedList_Create( tkHost_Root( gHost ), 1000 + i )
    tkCheckedList_SetFont( gList(i), gFont )
next

dim as ustring days(0 to 6) = { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" }
for d as long = 0 to 6
    tkCheckedList_AddItem( gList(0), days(d), lcase( left( days(d), 3 ) ) )
next
tkCheckedList_SetCheckedText( gList(0), "mon;wed;fri" )

dim as ustring tops(0 to 7) = { "Mozzarella", "Mushrooms", "Olives", "Pepperoni", "Red onion", "Basil", "Anchovies", "Pineapple" }
for k as long = 0 to 7
    tkCheckedList_AddItem( gList(1), tops(k), "", 100 + k )        ' no key: the text is the key
next
tkCheckedList_SetCheckOnClick( gList(1), true )
tkCheckedList_SetCheckedText( gList(1), "Mozzarella;Basil" )

tkCheckedList_AddItem( gList(2), "Read files", "read" )
tkCheckedList_AddItem( gList(2), "Write files", "write" )
tkCheckedList_AddItem( gList(2), "Delete files", "delete" )
tkCheckedList_AddItem( gList(2), "Share links", "share" )
tkCheckedList_AddItem( gList(2), "Manage users", "admin" )
tkCheckedList_AddItem( gList(2), "Billing (owner only)", "billing" )
tkCheckedList_SetExtendedSelect( gList(2), true )
tkCheckedList_SetValueSeparator( gList(2), "|" )
tkCheckedList_SetCheckedText( gList(2), "read|write|billing" )
tkCheckedList_SetItemEnabled( gList(2), 5, false )                 ' kept checked, but no gesture reaches it

for i as long = 0 to 2
    tkCheckedList_SetItemCheckCallback( gList(i), @Demo_ItemCheck )
    tkCheckedList_SetCheckedChangedCallback( gList(i), @Demo_Changed )
    tkCheckedList_SetSelChangeCallback( gList(i), @Demo_SelChange )
    tkCheckedList_SetActivateCallback( gList(i), @Demo_Activate )
next
tkCheckedList_SetCurSel( gList(0), 2 )

gHost->OnPaint = @Form_Paint
gHost->OnSize = @Form_Size
Form_Size( gHost )
tkHost_SetFocus( gHost, gList(0) )
tkHost_Show( gHost )

dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )
    SaveShot( gHost, shot )
else
    tkHost_Run( gHost )
end if
tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
