format = 1

[form]
caption = "People"
width = 480
height = 300
data_type = "peopledata.Person"
data_module = "../peopledata"

[[control]]
name = "lstPeople"
type = "ListTree"
parent = ""
x = 16
y = 16
w = 200
h = 220
items_source = "People"
item_type = "peopledata.Person"

[control.props]
ShowHeader = true

[[control.items]]
text = "Name"
width = 140
field = "Name"

[[control.items]]
text = "Age"
width = 50
field = "Age"

[[control]]
name = "txtName"
type = "TextBox"
parent = ""
x = 232
y = 16
w = 220
h = 28
bind = "Name"
required = true

[[control]]
name = "txtAge"
type = "TextBox"
parent = ""
x = 232
y = 56
w = 80
h = 28
bind = "Age"
minimum = "0"
maximum = "150"

[[control]]
name = "chkVip"
type = "CheckBox"
parent = ""
x = 232
y = 96
w = 120
h = 24
bind = "Vip"

[[control]]
name = "navPeople"
type = "Navigator"
parent = ""
x = 16
y = 250
w = 300
h = 30
items_source = "People"
follows = "lstPeople"

[control.events]
Navigate = "navPeople_Navigate"
