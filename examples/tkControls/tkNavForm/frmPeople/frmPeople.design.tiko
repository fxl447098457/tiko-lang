end function

function Form.SaveTo( byref r as peopledata.Person ) as boolean
    dim as TKBIND_ERRORS bindErrors_
    tkBind_Check( bindErrors_, txtName.Handle, "Name", r.Name, tkTextBox_GetText( txtName.Handle ), tkBind_Rule( true, "", "", 0, "" ) )
    tkBind_Check( bindErrors_, txtAge.Handle, "Age", r.Age, tkTextBox_GetText( txtAge.Handle ), tkBind_Rule( false, "0", "150", 0, "" ) )
    tkBind_Range( bindErrors_, txtAge.Handle, "Age", r.Age, tkTextBox_GetText( txtAge.Handle ), tkBind_Rule( false, "0", "150", 0, "" ) )
    tkTextBox_SetError( txtName.Handle, bindErrors_.Has( txtName.Handle ) )
    tkTextBox_SetError( txtAge.Handle, bindErrors_.Has( txtAge.Handle ) )
    if bindErrors_.Count then
        dim as boolean bindHandled_ = false
        if bindHandled_ = false then tkBind_ShowErrors( Handle, bindErrors_, false )
        return false
    end if
    tkBind_Put( r.Name, tkTextBox_GetText( txtName.Handle ) )
    tkBind_Put( r.Age, tkTextBox_GetText( txtAge.Handle ) )
    tkBind_Put( r.Vip, tkCheckBox_GetChecked( chkVip.Handle ) )
    return true
end function

