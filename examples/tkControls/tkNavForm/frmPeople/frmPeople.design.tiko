        return true
    case TKNAV_DELETE
        if (cur < 0) orelse (cur >= a_.Count( )) then return false
        a_.Remove( cur )
        tkNavigator_SetCount( navPeople.Handle, a_.Count( ) )
        navPeople_Refresh( )
        return true
    end select
    return navPeople_MoveTo( target )
end function

