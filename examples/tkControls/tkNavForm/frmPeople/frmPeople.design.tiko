function Form.navPeople_Go_( byval action as int32, byval target as int32 ) as boolean
    dim byref as Array( of peopledata.Person ) a_ = People
    dim as int32 cur = tkNavigator_GetPosition( navPeople.Handle )
    select case action
    case TKNAV_NEW
        if (cur >= 0) andalso (cur < a_.Count( )) then
            if IsDirty( a_[cur] ) then
                if SaveTo( a_[cur] ) = false then return false
            end if
