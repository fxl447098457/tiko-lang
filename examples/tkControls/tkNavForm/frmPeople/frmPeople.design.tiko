            dim as integer row_ = tkListTree_AddString( lstPeople.Handle, tkBind_Text( a_[i_].Name ) )
            tkListTree_SetCellText( lstPeople.Handle, row_, 1, tkBind_Text( a_[i_].Age ) )
            tkListTree_SetItemData( lstPeople.Handle, row_, i_ )
        next
        tkListTree_EndUpdate( lstPeople.Handle )
    end scope
end sub

