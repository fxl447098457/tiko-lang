' frmPeople's own code: the records its navigator steps through (People), and a Navigate handler
' that can refuse a delete, as a confirmation would.
#module "frmPeople"

#import "../peopledata"
#import "std/containers"
#import "vendor/tkControls/tkNavigator"
using containers
using tkNavigator

public partial type Form
    People as Array( of peopledata.Person )
    VetoDelete as boolean
    Navigates as long
end type

sub Form.navPeople_Navigate( byval action as int32, byval target as int32, byref Allow as boolean )
    Navigates += 1
    if (action = TKNAV_DELETE) andalso VetoDelete then Allow = false
end sub
