' tkNavForm self-test (Form Designer B4). frmPeople was written as a .tkform and generated by tkEdit
' --generate-forms; this drives its navigator the way a user does (pushed clicks on its buttons and on
' the list) and checks the records, the boxes and the list after each step. A presenter stands in for
' B2's message box.
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkForms"
#import "vendor/tkControls/tkBind"
#import "vendor/tkControls/tkListTree"
#import "vendor/tkControls/tkTextBox"
#import "vendor/tkControls/tkCheckBox"
#import "vendor/tkControls/tkNavigator"
#import "std/containers"
#import "./frmPeople"
#import "./peopledata"
using tkApp
using tkForms
using tkBind
using tkListTree
using tkTextBox
using tkCheckBox
using tkNavigator
using tkHost
using tkPaint
using tkTest
using containers

dim shared as long gShown
dim shared as ustring gShownText

sub Presenter( byval f as TK_FORM ptr, byref e as TKBIND_ERRORS, byval bLoading as boolean )
    gShown += 1
    gShownText = e.Text( )
end sub

function NewPerson( byref name_ as const ustring, byval age as long, byval vip as boolean ) as peopledata.Person
    dim as peopledata.Person p
    p.Name = name_ : p.Age = age : p.Vip = vip
    return p
end function

sub ClickPart( byval h as TK_HOST ptr, byval nav as TK_WIDGET ptr, byval part as long )
    dim as TKRECT rc, a
    tkNavigator_GetPartRect( nav, part, rc )
    tkWidget_AbsRect( nav, a )
    dim as single x = a.left + (rc.left + rc.right) / 2, y = a.top + (rc.top + rc.bottom) / 2
    tkTest_PushMotion( h, x, y )
    tkTest_Click( h, x, y )
    tkTest_PumpFor( h, 20 )
end sub

sub ClickRow( byval h as TK_HOST ptr, byval lst as TK_WIDGET ptr, byval row as long )
    ' the row's centre on the list's surface, below its header (tkListTree's selftest does the same)
    dim as TK_WIDGET ptr sf = tkListTree_GetSurface( lst )
    dim as TKRECT a
    tkWidget_AbsRect( sf, a )
    dim as long ih = tkListTree_GetItemHeightPx( lst )
    dim as single x = a.left + sf->cw \ 2, y = a.top + row * ih + ih \ 2
    tkTest_PushMotion( h, x, y )
    tkTest_Click( h, x, y )
    tkTest_PumpFor( h, 20 )
end sub

sub People( byval owner as TK_FORM ptr )
    tkTest_Begin( "a designed form with a navigator" )
    tkBind_SetErrorPresenter( @Presenter )
    dim as frmPeople.Form f
    f.Build( owner )
    dim as TK_HOST ptr h = tkForm_Host( f.Handle )
    f.Show( )
    tkTest_PumpFor( h, 60 )
    dim as TK_WIDGET ptr nav = f.navPeople.Handle, lst = f.lstPeople.Handle

    ' Refresh: the list fills, the first record loads
    f.People.Push( NewPerson( "Ada", 36, true ) ) : f.People.Push( NewPerson( "Bob", 41, false ) ) : f.People.Push( NewPerson( "Cy", 29, false ) )
    f.navPeople_Refresh( )
    tkTest_Check( "Refresh: 3 records, at the first, '1 of 3'", (tkNavigator_GetCount( nav ) = 3) andalso (f.navPeople_Current( ) = 0) _
        andalso (tkNavigator_GetText( nav ) = "1 of 3"), tkNavigator_GetText( nav ) )
    tkTest_Check( "  ... the list filled and on row 0, the boxes show Ada", (tkListTree_GetCount( lst ) = 3) andalso (tkListTree_GetCurSel( lst ) = 0) _
        andalso (tkTextBox_GetText( f.txtName.Handle ) = "Ada") andalso tkCheckBox_GetChecked( f.chkVip.Handle ) )
    tkTest_Check( "IsDirty: not after a load", f.IsDirty( f.People[0] ) = false )

    ' Next and Last load
    ClickPart( h, nav, TKNAV_NEXT )
    tkTest_Check( "Next: Bob, the list follows", (f.navPeople_Current( ) = 1) andalso (tkTextBox_GetText( f.txtName.Handle ) = "Bob") _
        andalso (tkListTree_GetCurSel( lst ) = 1) andalso (f.Navigates = 1) )
    ClickPart( h, nav, TKNAV_LAST )
    tkTest_Check( "Last: Cy", (f.navPeople_Current( ) = 2) andalso (tkTextBox_GetText( f.txtName.Handle ) = "Cy") )

    ' a change is saved before the move, and its row shows it
    tkTextBox_SetText( f.txtName.Handle, "Cyrus" )
    tkTest_Check( "IsDirty: after an edit", f.IsDirty( f.People[2] ) )
    ClickPart( h, nav, TKNAV_FIRST )
    tkTest_Check( "First after an edit: saved, then Ada", (f.People[2].Name = "Cyrus") andalso (f.navPeople_Current( ) = 0) _
        andalso (tkTextBox_GetText( f.txtName.Handle ) = "Ada"), f.People[2].Name )
    tkTest_Check( "  ... the saved row's text follows", tkListTree_GetCellText( lst, 2, 0 ) = "Cyrus", tkListTree_GetCellText( lst, 2, 0 ) )

    ' a value B2 refuses stops the move; the form and the record stay
    tkTextBox_SetText( f.txtAge.Handle, "200" )
    dim as long nShown = gShown
    ClickPart( h, nav, TKNAV_NEXT )
    tkTest_Check( "Next with Age 200: refused, still at Ada", (f.navPeople_Current( ) = 0) andalso (tkTextBox_GetText( f.txtAge.Handle ) = "200") _
        andalso (f.People[0].Age = 36) andalso (gShown = nShown + 1) andalso (gShownText = "Age: 200 is above the maximum, 150"), gShownText )
    tkTextBox_SetText( f.txtAge.Handle, "37" )

    ' a click on the list moves (and saves first)
    ClickRow( h, lst, 1 )
    tkTest_Check( "a list click: saved Ada's 37, now at Bob", (f.People[0].Age = 37) andalso (f.navPeople_Current( ) = 1) _
        andalso (tkTextBox_GetText( f.txtName.Handle ) = "Bob"), f.People[0].Age & " " & f.navPeople_Current( ) )
    tkTextBox_SetText( f.txtName.Handle, "" )
    ClickRow( h, lst, 2 )
    tkTest_Check( "a list click refused (Name required): back on Bob's row", (f.navPeople_Current( ) = 1) andalso (tkListTree_GetCurSel( lst ) = 1) _
        andalso (gShownText = "Name: is required"), tkListTree_GetCurSel( lst ) & " " & gShownText )
    tkTextBox_SetText( f.txtName.Handle, "Bob" )

    ' New: a blank record, loaded and listed
    ClickPart( h, nav, TKNAV_NEW )
    tkTest_Check( "New: 4 records, at the new one, its boxes blank, a fourth row", (f.People.Count( ) = 4) andalso (f.navPeople_Current( ) = 3) _
        andalso (len( tkTextBox_GetText( f.txtName.Handle ) ) = 0) andalso (tkListTree_GetCount( lst ) = 4) andalso (tkNavigator_GetText( nav ) = "4 of 4") )
    tkTextBox_SetText( f.txtName.Handle, "Dee" )
    tkTextBox_SetText( f.txtAge.Handle, "50" )

    ' Delete: the handler may say no
    f.VetoDelete = true
    ClickPart( h, nav, TKNAV_DELETE )
    tkTest_Check( "Delete vetoed by the handler: nothing removed", (f.People.Count( ) = 4) andalso (f.navPeople_Current( ) = 3) )
    f.VetoDelete = false
    ClickPart( h, nav, TKNAV_PREV )
    tkTest_Check( "Prev from the new record saves it", (f.People[3].Name = "Dee") andalso (f.People[3].Age = 50) andalso (f.navPeople_Current( ) = 2) )
    ClickPart( h, nav, TKNAV_DELETE )
    tkTest_Check( "Delete: Cyrus gone, now at Dee in his place", (f.People.Count( ) = 3) andalso (f.navPeople_Current( ) = 2) _
        andalso (tkTextBox_GetText( f.txtName.Handle ) = "Dee") andalso (tkListTree_GetCount( lst ) = 3) andalso (tkNavigator_GetText( nav ) = "3 of 3") )
    ClickPart( h, nav, TKNAV_DELETE )
    ClickPart( h, nav, TKNAV_DELETE )
    ClickPart( h, nav, TKNAV_DELETE )
    tkTest_Check( "Delete them all: none left, position -1, the boxes blank", (f.People.Count( ) = 0) andalso (f.navPeople_Current( ) = -1) _
        andalso (len( tkTextBox_GetText( f.txtName.Handle ) ) = 0) andalso (tkNavigator_GetText( nav ) = "- of 0"), tkNavigator_GetText( nav ) )

    tkBind_SetErrorPresenter( 0 )
    f.Close( )
    tkTest_PumpFor( h, 40 )
end sub

if tkTest_Init() = false then end 99
dim as TKAPP_OPTIONS opts
if tkApp_Init( opts ) = false then
    print "tkApp_Init failed"
    end 98
end if
dim as TK_FORM ptr mainForm = tkApp_NewForm( "owner", 200, 120, 0, 1.0 )
tkForm_Show( mainForm )
tkTest_PumpFor( tkForm_Host( mainForm ), 50 )
People( mainForm )
dim as long nFail = tkTest_Report( "tkNavForm" )
tkApp_Shutdown( )
end nFail
