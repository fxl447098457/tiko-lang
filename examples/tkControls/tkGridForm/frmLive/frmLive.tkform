format = 1

[form]
caption = "Order lines, live"
width = 560
height = 420
data_type = "griddata.Order"
data_module = "../griddata"

[[control]]
name = "grdLines"
type = "DataGrid"
parent = ""
x = 16
y = 16
w = 520
h = 220
items_field = "Lines"
item_type = "griddata.Line"
items_live = true

[control.props]
AllowAddRows = true

[[control.items]]
text = "Item"
width = 140
field = "Item"

[[control.items]]
text = "Qty"
width = 60
kind = "number"
field = "Qty"

[[control.items]]
text = "Due"
width = 100
kind = "date"
field = "Due"

[[control.items]]
text = "Total"
width = 80
kind = "number"
field = "Total( )"

[[control]]
name = "grdStock"
type = "DataGrid"
parent = ""
x = 16
y = 250
w = 520
h = 150
items_source = "Stock"
item_type = "griddata.Line"
items_live = true

[[control.items]]
text = "Item"
width = 140
field = "Item"

[[control.items]]
text = "In stock"
width = 80
kind = "number"
field = "Qty"
