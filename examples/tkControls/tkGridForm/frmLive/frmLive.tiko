' frmLive's own code: the stock its grdStock shows in place (ItemsSource "Stock", ItemsLive). The
' program fills it, then calls the generated grdStock_Fill( ), which binds rather than copies.
#module "frmLive"

#import "../griddata"
#import "std/containers"
using containers

public partial type Form
    Stock as Array( of griddata.Line )
end type
