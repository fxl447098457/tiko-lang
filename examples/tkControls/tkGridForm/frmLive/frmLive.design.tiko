        dim byref as Array( of griddata.Line ) a_ = r.Lines
        if tkDataGrid_GetSourceContext( grdLines.Handle ) <> cptr( any ptr, @a_ ) then
            dim as int32 n_ = tkDataGrid_GetRowCount( grdLines.Handle )
            if a_.Count( ) > n_ then a_.SetCount( n_ )
            while a_.Count( ) < n_
                dim as griddata.Line new_
                a_.Push( new_ )
            wend
            for i_ as int32 = 0 to n_ - 1
                tkBind_Put( a_[i_].Item, tkDataGrid_GetCellText( grdLines.Handle, i_, 0 ) )
                tkBind_Put( a_[i_].Qty, tkDataGrid_GetCellFloat( grdLines.Handle, i_, 1 ) )
                tkBind_Put( a_[i_].Due, tkDataGrid_GetCellDate( grdLines.Handle, i_, 2 ) )
            next
        end if
