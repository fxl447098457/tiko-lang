sub Form.Build( byval owner as TK_FORM ptr = nullptr )
    OpenWindow( "Order lines, live", 560, 420, owner )
    if Handle = 0 then exit sub
    tkLayout_AddContainer( Layout, tkForm_Widget( Handle ), 560, 420 )
    grdLines.Create( tkForm_Widget( Handle ), 1 )
    tkLayout_Add( Layout, grdLines.Handle, 16, 16, 520, 220 )
    tkDataGrid_AddColumnEx( grdLines.Handle, "Item", TKDG_COL_TEXT, 140 )
    tkDataGrid_AddColumnEx( grdLines.Handle, "Qty", TKDG_COL_NUMBER, 60 )
    tkDataGrid_AddColumnEx( grdLines.Handle, "Due", TKDG_COL_DATE, 100 )
    tkDataGrid_AddColumnEx( grdLines.Handle, "Total", TKDG_COL_NUMBER, 80 )
    tkDataGrid_SetColumnReadOnly( grdLines.Handle, 3, true )
    grdLines.AllowAddRows = true
    grdStock.Create( tkForm_Widget( Handle ), 2 )
    tkLayout_Add( Layout, grdStock.Handle, 16, 250, 520, 150 )
    tkDataGrid_AddColumnEx( grdStock.Handle, "Item", TKDG_COL_TEXT, 140 )
    tkDataGrid_AddColumnEx( grdStock.Handle, "In stock", TKDG_COL_NUMBER, 80 )
    tkLayout_Apply( Layout )
end sub

