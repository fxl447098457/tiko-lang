format = 1

[form]
caption = "Order lines"
width = 560
height = 300
data_type = "griddata.Order"
data_module = "../griddata"

[[control]]
name = "grdLines"
type = "DataGrid"
parent = ""
x = 16
y = 16
w = 520
h = 220
items_field = "Lines"
item_type = "griddata.Line"

[control.props]
AllowAddRows = true

[[control.items]]
text = "Item"
width = 140
field = "Item"

[[control.items]]
text = "Qty"
width = 60
kind = "number"
field = "Qty"

[[control.items]]
text = "Price"
width = 80
kind = "number"
field = "Price"

[[control.items]]
text = "Paid"
width = 50
kind = "check"
field = "Paid"

[[control.items]]
text = "Due"
width = 100
kind = "date"
field = "Due"

[[control.items]]
text = "Total"
width = 80
kind = "number"
field = "Total( )"
