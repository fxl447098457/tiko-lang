' frmNav's own code: the orders its navigator steps through (Orders), listed by grdOrders, which the
' navigator follows; each order's lines are grdLines' (ItemsField), so IsDirty and SaveTo cover them.
#module "frmNav"

#import "../griddata"
#import "std/containers"
using containers

public partial type Form
    Orders as Array( of griddata.Order )
end type
