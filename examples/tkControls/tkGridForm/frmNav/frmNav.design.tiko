    LoadFrom( a_[i] )
    scope
        dim as integer r_, c_
        tkDataGrid_GetCurrentCell( grdOrders.Handle, r_, c_ )
        tkDataGrid_SetCurrentCell( grdOrders.Handle, i, iif( c_ < 0, 0, c_ ) )
    end scope
    return true
end function

sub Form.navOrders_Refresh( )
    dim byref as Array( of griddata.Order ) a_ = Orders
    grdOrders_Fill( )
    tkNavigator_SetCount( navOrders.Handle, a_.Count( ) )
    if a_.Count( ) = 0 then
        tkNavigator_SetPosition( navOrders.Handle, -1 )
        dim as griddata.Order blank_
        LoadFrom( blank_ )
        exit sub
    end if
    dim as int32 cur = tkNavigator_GetPosition( navOrders.Handle )
    if cur < 0 then cur = 0
    tkNavigator_SetPosition( navOrders.Handle, cur )
    LoadFrom( a_[cur] )
    scope
        dim as integer r_, c_
        tkDataGrid_GetCurrentCell( grdOrders.Handle, r_, c_ )
        tkDataGrid_SetCurrentCell( grdOrders.Handle, cur, iif( c_ < 0, 0, c_ ) )
    end scope
end sub

