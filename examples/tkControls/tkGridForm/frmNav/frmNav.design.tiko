function Form.IsDirty( byref r as griddata.Order ) as boolean
    if tkBind_Differs( r.Customer, tkTextBox_GetText( txtCustomer.Handle ), "" ) then return true
    if tkDataGrid_IsEditing( grdLines.Handle ) then return true
    scope
        dim byref as Array( of griddata.Line ) a_ = r.Lines
        if tkDataGrid_GetRowCount( grdLines.Handle ) <> a_.Count( ) then return true
        for i_ as int32 = 0 to a_.Count( ) - 1
            if tkBind_Differs( a_[i_].Item, tkDataGrid_GetCellText( grdLines.Handle, i_, 0 ), "" ) then return true
            if tkBind_Differs( a_[i_].Qty, tkDataGrid_GetCellFloat( grdLines.Handle, i_, 1 ) ) then return true
        next
    end scope
    return false
end function

function Form.navOrders_MoveTo( byval i as int32 ) as boolean
    dim byref as Array( of griddata.Order ) a_ = Orders
    if (i < 0) orelse (i >= a_.Count( )) then return false
    dim as int32 cur = tkNavigator_GetPosition( navOrders.Handle )
    if (cur >= 0) andalso (cur < a_.Count( )) then
        if cur = i then return true
