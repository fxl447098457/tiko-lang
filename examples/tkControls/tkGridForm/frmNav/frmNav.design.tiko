function Form.LoadFrom( byref r as griddata.Order ) as boolean
    dim as TKBIND_ERRORS bindErrors_
    tkTextBox_SetText( txtCustomer.Handle, tkBind_Text( r.Customer ) )
    tkTextBox_SetError( txtCustomer.Handle, false )
    scope
        dim byref as Array( of griddata.Line ) a_ = r.Lines
        tkDataGrid_BeginUpdate( grdLines.Handle )
        tkDataGrid_SetRowCount( grdLines.Handle, 0 )
        tkDataGrid_SetRowCount( grdLines.Handle, a_.Count( ) )
        for i_ as int32 = 0 to a_.Count( ) - 1
            tkDataGrid_SetCellText( grdLines.Handle, i_, 0, tkBind_Text( a_[i_].Item ) )
            tkDataGrid_SetCellFloat( grdLines.Handle, i_, 1, tkBind_Float( a_[i_].Qty ) )
        next
        tkDataGrid_EndUpdate( grdLines.Handle )
    end scope
    if bindErrors_.Count then
        dim as boolean bindHandled_ = false
        if bindHandled_ = false then tkBind_ShowErrors( Handle, bindErrors_, true )
        return false
    end if
    return true
end function

function Form.SaveTo( byref r as griddata.Order ) as boolean
    dim as TKBIND_ERRORS bindErrors_
    if tkDataGrid_EndEdit( grdLines.Handle, true ) = false then return false
    tkBind_Check( bindErrors_, txtCustomer.Handle, "Customer", r.Customer, tkTextBox_GetText( txtCustomer.Handle ), tkBind_Rule( false, "", "", 0, "" ) )
    tkTextBox_SetError( txtCustomer.Handle, bindErrors_.Has( txtCustomer.Handle ) )
    if bindErrors_.Count then
        dim as boolean bindHandled_ = false
        if bindHandled_ = false then tkBind_ShowErrors( Handle, bindErrors_, false )
        return false
    end if
    tkBind_Put( r.Customer, tkTextBox_GetText( txtCustomer.Handle ) )
    scope
        dim byref as Array( of griddata.Line ) a_ = r.Lines
        dim as int32 n_ = tkDataGrid_GetRowCount( grdLines.Handle )
        if a_.Count( ) > n_ then a_.SetCount( n_ )
        while a_.Count( ) < n_
            dim as griddata.Line new_
            a_.Push( new_ )
        wend
        for i_ as int32 = 0 to n_ - 1
            tkBind_Put( a_[i_].Item, tkDataGrid_GetCellText( grdLines.Handle, i_, 0 ) )
            tkBind_Put( a_[i_].Qty, tkDataGrid_GetCellFloat( grdLines.Handle, i_, 1 ) )
        next
    end scope
    return true
end function

