function Form.navOrders_Go_( byval action as int32, byval target as int32 ) as boolean
    dim byref as Array( of griddata.Order ) a_ = Orders
    dim as int32 cur = tkNavigator_GetPosition( navOrders.Handle )
    select case action
    case TKNAV_NEW
        if (cur >= 0) andalso (cur < a_.Count( )) then
            if IsDirty( a_[cur] ) then
                if SaveTo( a_[cur] ) = false then return false
            end if
        end if
        dim as griddata.Order blank_
        a_.Push( blank_ )
        tkNavigator_SetCount( navOrders.Handle, a_.Count( ) )
        tkNavigator_SetPosition( navOrders.Handle, a_.Count( ) - 1 )
        navOrders_Refresh( )
        return true
    case TKNAV_DELETE
        if (cur < 0) orelse (cur >= a_.Count( )) then return false
        a_.Remove( cur )
        tkNavigator_SetCount( navOrders.Handle, a_.Count( ) )
        navOrders_Refresh( )
        return true
    end select
    return navOrders_MoveTo( target )
end function

sub Form.navOrders_FromList_( )
    dim as int32 i = grdOrders_Item( )
    dim as int32 cur = tkNavigator_GetPosition( navOrders.Handle )
    if (i < 0) orelse (i = cur) then exit sub
    if navOrders_MoveTo( i ) = false then
        scope
            dim as integer r_, c_
            tkDataGrid_GetCurrentCell( grdOrders.Handle, r_, c_ )
            tkDataGrid_SetCurrentCell( grdOrders.Handle, cur, iif( c_ < 0, 0, c_ ) )
        end scope
    end if
end sub

sub Form.navOrders_ListRow_( byval i as int32 )
    dim byref as Array( of griddata.Order ) a_ = Orders
    if (i < 0) orelse (i >= a_.Count( )) then exit sub
    tkDataGrid_SetCellText( grdOrders.Handle, i, 0, tkBind_Text( a_[i].Customer ) )
