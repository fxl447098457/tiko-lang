' tkTimePicker demo: four pickers and two embedded panels.
'
'   demo                          run it
'   demo --shot out.bmp           render once, save the window, exit
'   demo --shot out.bmp --open    the same with the first picker's dropdown open (also out.bmp.pop.bmp)
'   demo --scale 1.75             pin the scale
#import "vendor/tkControls/tkTimePicker"
using tkTimePicker
using tkTimePanel
using tkTheme
using tkHost
using tkPaint

dim shared as TK_HOST ptr gHost
dim shared as TK_WIDGET ptr gPk(0 to 3), gPanel(0 to 1)
dim shared as ustring gLabel(0 to 3)
dim shared as TTF_Font ptr gFont

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

private function HasArg( byref name_ as string ) as boolean
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return true
    next
    return false
end function

private sub Demo_Changed( byval hCtrl as TK_WIDGET ptr, byval pTime as TKTIME ptr, byval bHasTime as boolean )
    dim as string sTime = "(none)"
    if bHasTime then sTime = tkTimePanel_FormatIso( *pTime, true, true )
    print "TimeChanged " & tkTimePicker_GetID( hCtrl ) & ": " & sTime
end sub

private sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    b->SetFont( gFont )
    b->SetForeColor( tkTheme_Of( tkHost_Root( h ) ).TextDim )
    for i as long = 0 to 3
        dim as TKRECT rc
        tkRect_Set( rc, tkHost_Scale( h, 20 ), tkHost_Scale( h, 20 + i * 50 ), tkHost_Scale( h, 250 ), tkHost_Scale( h, 20 + i * 50 + 30 ) )
        b->PaintText( gLabel(i), @rc, TK_DT_LEFT )
    next
end sub

private sub Form_Size( byval h as TK_HOST ptr )
    for i as long = 0 to 3
        dim as long iw, ih
        tkTimePicker_GetIdealSize( gPk(i), iw, ih )
        tkWidget_SetPos( gPk(i), tkHost_Scale( h, 260 ), tkHost_Scale( h, 20 + i * 50 ), iw + tkHost_Scale( h, 20 ), ih )
    next
    dim as long x = tkHost_Scale( h, 20 )
    for i as long = 0 to 1
        dim as long iw, ih
        tkTimePanel_GetIdealSize( gPanel(i), iw, ih )
        tkWidget_SetPos( gPanel(i), x, tkHost_Scale( h, 230 ), iw, ih )
        x += iw + tkHost_Scale( h, 20 )
    next
end sub

private sub SaveShot( byval h as TK_HOST ptr, byref path as string )
    tkHost_Render( h )
    tkHost_RenderTo( h, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( h->renderer, 0 )
    if s then
        SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & h->fScale
        SDL_DestroySurface( s )
    end if
end sub

' ---- main --------------------------------------------------------------------------------
if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1

dim as single forced = val( ArgValue( "--scale" ) )
gHost = tkHost_Create( "tkTimePicker on SDL3", 640, 520, tkHost_FontDir() & TK_FONT_UI, forced )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
gHost->clrBack = tkTheme_Of( tkHost_Root( gHost ) ).Window
gFont = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 10 )
if gFont = 0 then print "fonts: " & *SDL_GetError() : end 1

gLabel(0) = "24-hour, dropdown (Now / OK)"
gLabel(1) = "12-hour, spin buttons, 15 min"
gLabel(2) = "Seconds, no button, 09:00-17:00"
gLabel(3) = "Empty, placeholder, list dropdown"
for i as long = 0 to 3
    gPk(i) = tkTimePicker_Create( tkHost_Root( gHost ), 1000 + i )
    tkTimePicker_SetTimeChangedCallback( gPk(i), @Demo_Changed )
next
tkTimePicker_SetTime( gPk(0), tkTimePanel_MakeTime( 14, 30 ) )
tkTimePicker_SetShowNow( gPk(0), true )
tkTimePicker_SetShowOK( gPk(0), true )
tkTimePicker_SetFormat( gPk(1), "h:mm tt" )
tkTimePicker_SetButtonStyle( gPk(1), TKTP_BUTTON_SPIN )
tkTimePicker_SetStep( gPk(1), 900 )
tkTimePicker_SetTime( gPk(1), tkTimePanel_MakeTime( 9, 15 ) )
tkTimePicker_SetFormat( gPk(2), "HH:mm:ss" )
tkTimePicker_SetButtonStyle( gPk(2), TKTP_BUTTON_NONE )
tkTimePicker_SetRange( gPk(2), tkTimePanel_MakeTime( 9, 0 ), tkTimePanel_MakeTime( 17, 0 ) )
tkTimePicker_SetTime( gPk(2), tkTimePanel_MakeTime( 12, 34, 56 ) )
tkTimePicker_SetPlaceholderText( gPk(3), "Pick a time" )
tkTimePicker_SetPanelMode( gPk(3), TKTP_PANEL_LIST )
tkTimePicker_SetListRange( gPk(3), tkTimePanel_MakeTime( 8, 0 ), tkTimePanel_MakeTime( 18, 0 ), 1800 )

gPanel(0) = tkTimePanel_Create( tkHost_Root( gHost ), 1100 )
tkTimePanel_SetFormat( gPanel(0), "h:mm tt" )
tkTimePanel_SetStep( gPanel(0), 300 )
tkTimePanel_SetRange( gPanel(0), tkTimePanel_MakeTime( 8, 0 ), tkTimePanel_MakeTime( 18, 0 ) )
tkTimePanel_SetTime( gPanel(0), tkTimePanel_MakeTime( 10, 25 ) )
gPanel(1) = tkTimePanel_Create( tkHost_Root( gHost ), 1101 )
tkTimePanel_SetMode( gPanel(1), TKTP_PANEL_LIST )
tkTimePanel_SetListRange( gPanel(1), tkTimePanel_MakeTime( 8, 0 ), tkTimePanel_MakeTime( 18, 0 ), 1800 )
tkTimePanel_SetTime( gPanel(1), tkTimePanel_MakeTime( 9, 30 ) )

gHost->OnPaint = @Form_Paint
gHost->OnSize = @Form_Size
Form_Size( gHost )
tkHost_SetFocus( gHost, gPk(0) )
tkHost_Show( gHost )

dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )
    if HasArg( "--open" ) then
        tkTimePicker_SetFocusedSegment( gPk(0), 2 )
        tkTimePicker_DropDown( gPk(0) )
        for k as long = 1 to 10
            tkHost_Pump( gHost )
            SDL_Delay( 15 )
        next
        dim as TK_HOST ptr pop = tkTimePicker_GetPopup( gPk(0) )
        if pop then SaveShot( pop, shot & ".pop.bmp" )
    end if
    SaveShot( gHost, shot )
else
    tkHost_Run( gHost )
end if

tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
