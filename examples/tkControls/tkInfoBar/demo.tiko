' tkInfoBar demo: an info bar docked above the content. The buttons change its severity, its
' message (short = one line, long = stacked), its actions, and open / close it. Resize the window
' to watch AUTO switch between one line and stacked; Tab into the bar and use Enter / Esc.
' Open / close animates (the content below follows it); Progress cycles none, 40 %, moving.
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkLayout"
#import "vendor/tkControls/tkInfoBar"
#import "vendor/tkControls/tkLabel"
#import "vendor/tkControls/tkPanel"
#import "vendor/tkControls/tkButton"
using tkApp
using tkLayout
using tkInfoBar
using tkNotify
using tkLabel
using tkPanel
using tkButton
using tkTheme
using tkHost
using tkPaint

dim shared as TK_LAYOUT ptr gLayout
dim shared as TK_WIDGET ptr gBar, gLog
dim shared as long gSev, gLong, gActs, gProg

sub Relayout( )
    tkLayout_Apply( gLayout )
end sub

sub OnSize( byval f as TK_FORM ptr, byval cx as long, byval cy as long )
    Relayout( )
end sub

sub OnScale( byval f as TK_FORM ptr, byval fOld as single, byval fNew as single )
    Relayout( )
end sub

sub Log_( byref s as const ustring )
    tkLabel_SetText( gLog, s )
end sub

sub OnHeight( byval h as TK_WIDGET ptr, byval cyDesign as long )
    Relayout( )
end sub

sub OnAction( byval h as TK_WIDGET ptr, byval id as long )
    Log_( "Action " & id & ": " & tkInfoBar_GetActionText( h, id ) )
end sub

sub OnClosed( byval h as TK_WIDGET ptr, byval reason as long )
    Log_( "Closed by the user (reason " & reason & ")" )
end sub

sub ShowMessage( )
    dim as ustring title, msg
    select case gSev
    case TKN_INFO    : title = "Update available"
    case TKN_SUCCESS : title = "Saved"
    case TKN_WARNING : title = "Unsaved changes"
    case TKN_ERROR   : title = "Can't connect"
    end select
    if gLong then
        msg = "This is a longer message, so at this width the bar stacks: the title on the first row, " & _
              "the message wrapped below it, and the buttons on a row of their own."
    else
        msg = "A short message."
    end if
    tkInfoBar_SetSeverity( gBar, gSev )
    tkInfoBar_SetTitle( gBar, title )
    tkInfoBar_SetMessage( gBar, msg )
end sub

sub OnSeverity( byval h as TK_WIDGET ptr, byval id as long )
    gSev = (gSev + 1) mod 4
    ShowMessage( )
end sub

sub OnLength( byval h as TK_WIDGET ptr, byval id as long )
    gLong = 1 - gLong
    ShowMessage( )
end sub

sub OnActions( byval h as TK_WIDGET ptr, byval id as long )
    gActs = (gActs + 1) mod 3
    tkInfoBar_ClearActions( gBar )
    if gActs >= 1 then tkInfoBar_AddAction( gBar, "Retry" )
    if gActs >= 2 then tkInfoBar_AddAction( gBar, "Details" )
end sub

sub OnToggle( byval h as TK_WIDGET ptr, byval id as long )
    tkInfoBar_SetOpen( gBar, tkInfoBar_IsOpen( gBar ) = false )
end sub

sub OnProgress( byval h as TK_WIDGET ptr, byval id as long )
    gProg = (gProg + 1) mod 3
    select case gProg
    case 0 : tkInfoBar_SetProgress( gBar, TKN_PROGRESS_NONE )
    case 1 : tkInfoBar_SetProgress( gBar, 40 )
    case 2 : tkInfoBar_SetProgress( gBar, TKN_PROGRESS_INDETERMINATE )
    end select
end sub

dim as TKAPP_OPTIONS opts
if tkApp_Init( opts ) = false then end 98
dim as TK_FORM ptr f = tkApp_NewForm( "tkInfoBar demo", 720, 420 )
dim as TK_WIDGET ptr root_ = tkForm_Widget( f )

gBar = tkInfoBar_Create( root_, 1 )
tkInfoBar_ApplyFonts( gBar, tkForm_Font( f, TKFONT_UI ), tkForm_Font( f, TKFONT_UI_BOLD ), tkForm_Font( f, TKFONT_GLYPH ) )
tkInfoBar_SetActionCallback( gBar, @OnAction )
tkInfoBar_SetClosedCallback( gBar, @OnClosed )
tkInfoBar_SetHeightChangedCallback( gBar, @OnHeight )

dim as TK_WIDGET ptr content = tkPanel_Create( root_, 2 )
tkPanel_SetBorderStyle( content, PNL_BORDER_LINE )
dim as TK_WIDGET ptr bSev = tkButton_Create( content, 10 )
tkButton_SetText( bSev, "Severity" )
tkButton_SetClickCallback( bSev, @OnSeverity )
dim as TK_WIDGET ptr bLen = tkButton_Create( content, 11 )
tkButton_SetText( bLen, "Short / long" )
tkButton_SetClickCallback( bLen, @OnLength )
dim as TK_WIDGET ptr bAct = tkButton_Create( content, 12 )
tkButton_SetText( bAct, "Actions 0/1/2" )
tkButton_SetClickCallback( bAct, @OnActions )
dim as TK_WIDGET ptr bTog = tkButton_Create( content, 13 )
tkButton_SetText( bTog, "Open / close" )
tkButton_SetClickCallback( bTog, @OnToggle )
dim as TK_WIDGET ptr bPrg = tkButton_Create( content, 15 )
tkButton_SetText( bPrg, "Progress" )
tkButton_SetClickCallback( bPrg, @OnProgress )
gLog = tkLabel_Create( content, 14 )

gLayout = tkLayout_Create( )
tkLayout_AddContainer( gLayout, root_, 720, 420 )
tkLayout_Add( gLayout, gBar, 0, 0, 0, 44, TK_ANCHOR_NONE, TK_DOCK_TOP )
tkLayout_SetHeightFunc( gLayout, gBar, @tkInfoBar_GetPreferredHeight )
tkLayout_Add( gLayout, content, 0, 0, 0, 0, TK_ANCHOR_NONE, TK_DOCK_FILL )
tkLayout_AddContainer( gLayout, content, 720, 376 )
tkLayout_Add( gLayout, bSev, 16, 16, 120, 32 )
tkLayout_Add( gLayout, bLen, 146, 16, 120, 32 )
tkLayout_Add( gLayout, bAct, 276, 16, 120, 32 )
tkLayout_Add( gLayout, bTog, 406, 16, 120, 32 )
tkLayout_Add( gLayout, bPrg, 536, 16, 120, 32 )
tkLayout_Add( gLayout, gLog, 16, 64, 688, 24, TK_ANCHOR_LEFT or TK_ANCHOR_RIGHT or TK_ANCHOR_TOP )

gActs = 1
tkInfoBar_AddAction( gBar, "Retry" )
ShowMessage( )
tkInfoBar_SetOpen( gBar, true )

tkForm_OnSize( f, @OnSize )
tkForm_OnScaleChanged( f, @OnScale )
dim as long code = tkApp_Run( f )
tkLayout_Destroy( gLayout )
end code
