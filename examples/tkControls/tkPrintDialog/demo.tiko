' tkPrintDialog demo (printing phase R3): the Page Setup dialog, then the Print dialog for a
' three-page document; what was chosen is printed to the console. Nothing is sent to a printer
' unless --print is given.
'
'   demo                         the two dialogs, modal
'   demo --print                 ... and print the job the Print dialog returns
'   demo --shot ../out/pd        save both dialogs as ../out/pd-print.png and ../out/pd-setup.png
#import "vendor/tkControls/tkPrintDialog"
using tkPrintDialog
using tkPrinter
using tkPdf
using tkPrint
using tkHost
using tkPaint

private function HasArg( byref name_ as string ) as boolean
    for i as long = 1 to 32
        if command( i ) = "" then exit for
        if command( i ) = name_ then return true
    next
    return false
end function

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 32
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

function Page( byval doc as TK_PRINTDOC ptr, byval pg as TK_PAGE ptr, byval i as long ) as boolean
    dim as TKRECTF r
    tkRectF_Set( r, 72, 72, 500, 110 )
    dim as TKFONTSPEC fs
    fs.pt = 28
    tkPage_SetFont( pg, fs )
    tkPage_Text( pg, "Page " & (i + 1) & " of the tkPrintDialog demo", r, TK_DT_LEFT )
    return i < 2
end function

sub SaveShot( byval dlg as TK_HOST ptr, byref path as string )
    tkHost_Show( dlg )
    tkHost_Pump( dlg )
    tkHost_RenderTo( dlg, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( dlg->renderer, 0 )
    if s then IMG_SavePNG( s, strptr( path ) ) : SDL_DestroySurface( s )
end sub

if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
dim as TK_HOST ptr h = tkHost_Create( "tkPrintDialog demo", 400, 200, tkHost_FontDir() & TK_FONT_UI )
tkHost_Show( h )
dim as TK_PRINTDOC ptr doc = tkPrintDoc_Create( "tkPrintDialog demo" )
tkPrintDoc_SetPrintPageCallback( doc, @Page )
tkPrintDoc_Generate( doc )
dim as TKPAGESETUP ps = tkPrintDoc_GetPageSetup( doc )
dim as TKPRINTJOB job
dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    dim as TK_HOST ptr d1 = tkPrintDialog_Create( h, doc, job, 0 )
    SaveShot( d1, shot & "-print.png" )
    tkHost_Destroy( d1 )
    dim as TK_HOST ptr d2 = tkPageSetupDialog_Create( h, ps )
    SaveShot( d2, shot & "-setup.png" )
    tkHost_Destroy( d2 )
    print "shots: " & shot & "-print.png, " & shot & "-setup.png"
else
    if tkPageSetupDialog_Show( h, ps ) then
        print "page setup: paper " & ps.paper & " landscape " & ps.landscape & " margins " & ps.marginL & " " & ps.marginT & " " & ps.marginR & " " & ps.marginB
        tkPrintDoc_SetPageSetup( doc, ps )
        tkPrintDoc_Generate( doc )
    end if
    if tkPrintDialog_Show( h, doc, job, 0 ) then
        print "print: '" & job.printer & "' copies " & job.copies & " collate " & job.collate & " pages [" & job.pageSet & "] duplex " & job.duplex & " colour " & job.color
        if HasArg( "--print" ) then print "printed: " & tkPrintDoc_Print( doc, job ) & " " & tkPrinter_LastError( )
    else
        print "print: cancelled"
    end if
end if
tkPrintDoc_Destroy( doc )
tkHost_Destroy( h )
TTF_Quit()
SDL_Quit()
