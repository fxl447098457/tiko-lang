' Every tkControls control that keeps a colour struct, themed the TH2 way (docs/tkDesigner/THEMES.md):
'   * created inside a theme scope, it wears the scope's theme, not the app's;
'   * a recipe (slot 0 fixed, slot 1 one colour per variant) lies over its theme colours, and stays
'     through a Dark <-> Light switch of the scope; clearing it gives the plain theme back;
'   * a style's role remap reaches its colours;
'   * the app's theme changing does not touch it;
' and every control with a corner or border setting takes the theme's shape, follows a change of
' it, and keeps its own once its setter has run.
'
'   selftest            exit code = number of failures
#import "vendor/tkControls/tkButton"
#import "vendor/tkControls/tkCalendar"
#import "vendor/tkControls/tkChart"
#import "vendor/tkControls/tkCheckBox"
#import "vendor/tkControls/tkColorPicker"
#import "vendor/tkControls/tkColumnHeader"
#import "vendor/tkControls/tkComboBox"
#import "vendor/tkControls/tkDatePicker"
#import "vendor/tkControls/tkGroupBox"
#import "vendor/tkControls/tkIconPanel"
#import "vendor/tkControls/tkLabel"
#import "vendor/tkControls/tkListTree"
#import "vendor/tkControls/tkMenuBar"
#import "vendor/tkControls/tkNumericUpDown"
#import "vendor/tkControls/tkOptionButton"
#import "vendor/tkControls/tkPanel"
#import "vendor/tkControls/tkProgressBar"
#import "vendor/tkControls/tkSelectBar"
#import "vendor/tkControls/tkSplitter"
#import "vendor/tkControls/tkStatusBar"
#import "vendor/tkControls/tkTabBar"
#import "vendor/tkControls/tkTextBox"
#import "vendor/tkControls/tkToggle"
#import "vendor/tkControls/tkToolbar"
#import "vendor/tkControls/tkTest"
using tkButton
using tkCalendar
using tkChart
using tkCheckBox
using tkColorPicker
using tkColumnHeader
using tkComboBox
using tkDatePicker
using tkGroupBox
using tkIconPanel
using tkLabel
using tkListTree
using tkMenuBar
using tkNumericUpDown
using tkOptionButton
using tkPanel
using tkProgressBar
using tkSelectBar
using tkSplitter
using tkStatusBar
using tkTabBar
using tkTextBox
using tkToggle
using tkToolbar
using tkTooltip
using tkTheme
using tkTest
using tkHost
using tkPaint

dim shared as TK_WIDGET ptr gRoot
dim shared as TKTHEME_COLORS gDark, gLight
dim shared as TKTHEME_SHAPE gShape1, gShape2
dim shared as TKCOLOR_SRC gRecipe(0 to 1)
dim shared as TKTHEME_STYLE gStyle
dim shared as TKCOLOR_SRC gTypeSrc(0 to 1)
dim shared as TKTHEME_TYPERECIPE gTypes(0 to 1)

' -1 when the two structs match, else the first ulong slot that differs.
function FirstDiff( byval a as any ptr, byval b as any ptr, byval nBytes as long ) as long
    dim as ulong ptr pa = a, pb = b
    for i as long = 0 to (nBytes \ 4) - 1
        if pa[i] <> pb[i] then return i
    next
    return -1
end function

sub GroupBoxGet( byval h as TK_WIDGET ptr, byval p as TKGROUPBOX_COLORS ptr )
    *p = tkGroupBox_GetColors( h )
end sub

' The scope over every control: t and sh, always with the style table.
sub Rescope( byref t as TKTHEME_COLORS, byval sh as TKTHEME_SHAPE ptr )
    tkTheme_ApplyTo( gRoot, t, sh, @gStyle, 1 )
end sub

' What the recipe should leave: the theme's colours with slot 0 fixed and slot 1 per variant.
sub WithRecipe( byval p as any ptr, byval isDark as boolean )
    dim as ulong ptr u = p
    u[0] = &hFF123456ul
    u[1] = iif( isDark, &hFF010101ul, &hFF020202ul )
end sub

#macro COLORCASE( LABEL, MAKE, STRUCT, GETC, THEMEC )
scope
    dim as TK_WIDGET ptr c = MAKE
    dim as STRUCT got, want
    dim as long d
    GETC( c, @got )
    want = THEMEC( gDark )
    d = FirstDiff( @got, @want, sizeof( STRUCT ) )
    tkTest_Check( LABEL & ": created in a scope, wears the scope's theme", d = -1, "slot " & d )

    tkTheme_SetRecipe( c, 0, @gRecipe(0), 2 )
    GETC( c, @got )
    want = THEMEC( gDark )
    WithRecipe( @want, true )
    d = FirstDiff( @got, @want, sizeof( STRUCT ) )
    tkTest_Check( LABEL & ": a recipe lies over the theme (dark)", d = -1, "slot " & d )

    Rescope( gLight, @gShape1 )
    GETC( c, @got )
    want = THEMEC( gLight )
    WithRecipe( @want, false )
    d = FirstDiff( @got, @want, sizeof( STRUCT ) )
    tkTest_Check( LABEL & ": and stays through a switch to light", d = -1, "slot " & d )

    Rescope( gDark, @gShape1 )
    tkTheme_SetRecipe( c, 1, 0, 0 )
    GETC( c, @got )
    want = THEMEC( tkTheme_Remap( gDark, gStyle ) )
    d = FirstDiff( @got, @want, sizeof( STRUCT ) )
    tkTest_Check( LABEL & ": a style's remap reaches it", d = -1, "slot " & d )

    tkTheme_ClearRecipe( c )
    tkTheme_Apply( tkTheme_Dark() )
    tkTheme_Apply( tkTheme_Light() )
    GETC( c, @got )
    want = THEMEC( gDark )
    d = FirstDiff( @got, @want, sizeof( STRUCT ) )
    tkTest_Check( LABEL & ": cleared, and the app's theme changes pass it by", d = -1, "slot " & d )
    tkWidget_Destroy( c )
end scope
#endmacro

#macro SHAPECASE( LABEL, MAKE, GETTER, SETTER, EXPECT1, EXPECT2 )
scope
    dim as TK_WIDGET ptr c = MAKE
    tkTest_Check( LABEL & ": the theme's shape at create", GETTER( c ) = EXPECT1, "got " & GETTER( c ) )
    Rescope( gDark, @gShape2 )
    tkTest_Check( LABEL & ": follows a change of it", GETTER( c ) = EXPECT2, "got " & GETTER( c ) )
    SETTER( c, 7 )
    Rescope( gDark, @gShape1 )
    tkTest_Check( LABEL & ": its own setter pins it", GETTER( c ) = 7, "got " & GETTER( c ) )
    tkWidget_Destroy( c )
end scope
#endmacro

if tkTest_Init() = false then end 99
tkTheme_Apply( tkTheme_Light() )                   ' the app's theme: never the answer below
gDark = tkTheme_Derive( tkTheme_Dark(), tkRGB( 220, 60, 60 ) )
gDark.Surface = tkRGB( 50, 20, 20 )
gLight = tkTheme_Derive( tkTheme_Light(), tkRGB( 220, 60, 60 ) )
gLight.Surface = tkRGB( 250, 235, 235 )
gShape1.CornerRadius = 5 : gShape1.BorderWidth = 3
gShape2.CornerRadius = 6 : gShape2.BorderWidth = 2
gRecipe(0) = tkTheme_SrcFixed( 0, &hFF123456ul )
gRecipe(1) = tkTheme_SrcFixed2( 1, &hFF010101ul, &hFF020202ul )
' the style moves every role a control is likely to read
gStyle.remap(TKROLE_WINDOW) = tkTheme_SrcFixed( 0, &hFF0A0B0Cul )
gStyle.remap(TKROLE_SURFACE) = tkTheme_SrcRole( 0, TKROLE_ACCENT )
gStyle.remap(TKROLE_SURFACEHOT) = tkTheme_SrcRole( 0, TKROLE_ACCENTHOT )
gStyle.remap(TKROLE_TEXT) = tkTheme_SrcRole( 0, TKROLE_SELECTEDTEXT )
gStyle.remap(TKROLE_BORDER) = tkTheme_SrcFixed( 0, &hFF0D0E0Ful )
gStyle.remap(TKROLE_ACCENT) = tkTheme_SrcRole( 0, TKROLE_ERROR )
gStyle.remap(TKROLE_POPUP) = tkTheme_SrcFixed( 0, &hFF111213ul )

dim as TK_HOST ptr h = tkHost_Create( "tkThemeControls selftest", 640, 480, tkHost_FontDir() & TK_FONT_UI, 1 )
gRoot = tkWidget_Create( h, 1, 0, 0 )
tkWidget_SetPos( gRoot, 0, 0, 640, 480 )
Rescope( gDark, @gShape1 )
tkHost_Show( h )
tkTest_PumpFor( h, 100 )

tkTest_Begin( "colours" )
COLORCASE( "Button", tkButton_Create( gRoot, 10 ), TKBUTTON_COLORS, tkButton_GetColors, tkButton_ThemeColors )
COLORCASE( "Calendar", tkCalendar_Create( gRoot, 11 ), TKCALENDAR_COLORS, tkCalendar_GetColors, tkCalendar_ThemeColors )
COLORCASE( "Chart", tkChart_Create( gRoot, 12 ), TKCHART_COLORS, tkChart_GetColors, tkChart_ThemeColors )
COLORCASE( "CheckBox", tkCheckBox_Create( gRoot, 13 ), TKCHECKBOX_COLORS, tkCheckBox_GetColors, tkCheckBox_ThemeColors )
COLORCASE( "ColorPicker", tkColorPicker_Create( gRoot, 14 ), TKCOLORPICKER_COLORS, tkColorPicker_GetColors, tkColorPicker_ThemeColors )
COLORCASE( "ColumnHeader", tkColumnHeader_Create( gRoot, 15 ), TKCOLUMNHEADER_COLORS, tkColumnHeader_GetColors, tkColumnHeader_ThemeColors )
COLORCASE( "ComboBox", tkComboBox_Create( gRoot, 16 ), TKCOMBOBOX_COLORS, tkComboBox_GetColors, tkComboBox_ThemeColors )
COLORCASE( "DatePicker", tkDatePicker_Create( gRoot, 17 ), TKDATEPICKER_COLORS, tkDatePicker_GetColors, tkDatePicker_ThemeColors )
COLORCASE( "GroupBox", tkGroupBox_Create( gRoot, 18 ), TKGROUPBOX_COLORS, GroupBoxGet, tkGroupBox_ThemeColors )
COLORCASE( "IconPanel", tkIconPanel_Create( gRoot, 19 ), TKICONPANEL_COLORS, tkIconPanel_GetColors, tkIconPanel_ThemeColors )
COLORCASE( "Label", tkLabel_Create( gRoot, 20 ), TKLABEL_COLORS, tkLabel_GetColors, tkLabel_ThemeColors )
COLORCASE( "MenuBar", tkMenuBar_Create( gRoot, 21 ), TKMENUBAR_COLORS, tkMenuBar_GetColors, tkMenuBar_ThemeColors )
COLORCASE( "NumericUpDown", tkNumericUpDown_Create( gRoot, 22 ), TKNUMERICUPDOWN_COLORS, tkNumericUpDown_GetColors, tkNumericUpDown_ThemeColors )
COLORCASE( "OptionButton", tkOptionButton_Create( gRoot, 23 ), TKOPTIONBUTTON_COLORS, tkOptionButton_GetColors, tkOptionButton_ThemeColors )
COLORCASE( "Panel", tkPanel_Create( gRoot, 24 ), TKPANEL_COLORS, tkPanel_GetColors, tkPanel_ThemeColors )
COLORCASE( "ProgressBar", tkProgressBar_Create( gRoot, 25 ), TKPROGRESSBAR_COLORS, tkProgressBar_GetColors, tkProgressBar_ThemeColors )
COLORCASE( "SelectBar", tkSelectBar_Create( gRoot, 26 ), TKSELECTBAR_COLORS, tkSelectBar_GetColors, tkSelectBar_ThemeColors )
COLORCASE( "Splitter", tkSplitter_Create( gRoot, 27 ), TKSPLITTER_COLORS, tkSplitter_GetColors, tkSplitter_ThemeColors )
COLORCASE( "StatusBar", tkStatusBar_Create( gRoot, 28 ), TKSTATUSBAR_COLORS, tkStatusBar_GetColors, tkStatusBar_ThemeColors )
COLORCASE( "TabBar", tkTabBar_Create( gRoot, 29 ), TKTABBAR_COLORS, tkTabBar_GetColors, tkTabBar_ThemeColors )
COLORCASE( "TextBox", tkTextBox_Create( gRoot, 30 ), TKTEXTBOX_COLORS, tkTextBox_GetColors, tkTextBox_ThemeColors )
COLORCASE( "Toggle", tkToggle_Create( gRoot, 31 ), TKTOGGLE_COLORS, tkToggle_GetColors, tkToggle_ThemeColors )
COLORCASE( "Toolbar", tkToolbar_Create( gRoot, 32 ), TKTOOLBAR_COLORS, tkToolbar_GetColors, tkToolbar_ThemeColors )

' Shape: shape 1 is radius 5 / border 3, shape 2 radius 6 / border 2. A "curvature" is a diameter;
' scale is 1, so design units are pixels. TextBox's border is a pen width (never scaled).
tkTest_Begin( "shape" )
SHAPECASE( "Button", tkButton_Create( gRoot, 40 ), tkButton_GetCornerCurvature, tkButton_SetCornerCurvature, 10, 12 )
SHAPECASE( "ComboBox", tkComboBox_Create( gRoot, 41 ), tkComboBox_GetCornerCurvature, tkComboBox_SetCornerCurvature, 10, 12 )
SHAPECASE( "Toolbar", tkToolbar_Create( gRoot, 42 ), tkToolbar_GetCornerCurvature, tkToolbar_SetCornerCurvature, 10, 12 )
SHAPECASE( "ProgressBar", tkProgressBar_Create( gRoot, 43 ), tkProgressBar_GetCurvature, tkProgressBar_SetCurvature, 10, 12 )
SHAPECASE( "CheckBox", tkCheckBox_Create( gRoot, 44 ), tkCheckBox_GetFocusCurvature, tkCheckBox_SetFocusCurvature, 10, 12 )
SHAPECASE( "OptionButton", tkOptionButton_Create( gRoot, 45 ), tkOptionButton_GetFocusCurvature, tkOptionButton_SetFocusCurvature, 10, 12 )
SHAPECASE( "TextBox radius", tkTextBox_Create( gRoot, 46 ), tkTextBox_GetCornerRadius, tkTextBox_SetCornerRadius, 5, 6 )
SHAPECASE( "TextBox border", tkTextBox_Create( gRoot, 47 ), tkTextBox_GetBorderWidth, tkTextBox_SetBorderWidth, 3, 2 )
SHAPECASE( "NumericUpDown", tkNumericUpDown_Create( gRoot, 48 ), tkNumericUpDown_GetCornerRadius, tkNumericUpDown_SetCornerRadius, 5, 6 )
SHAPECASE( "DatePicker", tkDatePicker_Create( gRoot, 49 ), tkDatePicker_GetCornerRadius, tkDatePicker_SetCornerRadius, 5, 6 )
SHAPECASE( "ListTree", tkListTree_Create( gRoot, 50 ), tkListTree_GetBorderWidth, tkListTree_SetBorderWidth, 3, 2 )
SHAPECASE( "TabBar", tkTabBar_Create( gRoot, 51 ), tkTabBar_GetBorderWidth, tkTabBar_SetBorderWidth, 3, 2 )

' A shape of -1 hands a control back its own default.
scope
    dim as TKTHEME_SHAPE none
    Rescope( gDark, @none )
    dim as TK_WIDGET ptr b = tkButton_Create( gRoot, 60 )
    tkTest_Check( "no theme shape: Button keeps its default curvature", tkButton_GetCornerCurvature( b ) = TKBUTTON_DEFAULT_CURVATURE )
    Rescope( gDark, @gShape1 )
    Rescope( gDark, @none )
    tkTest_Check( "and returns to it when the theme's shape goes", tkButton_GetCornerCurvature( b ) = TKBUTTON_DEFAULT_CURVATURE )
    tkWidget_Destroy( b )
end scope

' Per-type recipes and named styles (TH4): a theme's [controls.Button] reaches every Button,
' [styles.Danger.Button] the ones wearing Danger, and a control's own recipe beats both.
tkTest_Begin( "types" )
scope
    gStyle.Name = "Danger"
    gTypeSrc(0) = tkTheme_SrcFixed( 2, &hFF0C0C0Cul )          ' Button.BorderColor, every Button
    gTypeSrc(1) = tkTheme_SrcFixed( 0, &hFF0D0D0Dul )          ' Button.BackColor, Danger Buttons
    gTypes(0).TypeName = "Button" : gTypes(0).pSrc = @gTypeSrc(0) : gTypes(0).n = 1
    gTypes(1).TypeName = "Button" : gTypes(1).StyleName = "Danger" : gTypes(1).pSrc = @gTypeSrc(1) : gTypes(1).n = 1
    tkTheme_ApplyTo( gRoot, gDark, @gShape1, @gStyle, 1, @gTypes(0), 2 )
    dim as TK_WIDGET ptr b = tkButton_Create( gRoot, 70 )
    dim as TKBUTTON_COLORS got, want
    tkButton_GetColors( b, @got )
    want = tkButton_ThemeColors( gDark )
    want.BorderColor = &hFF0C0C0Cul
    dim as long d = FirstDiff( @got, @want, sizeof( TKBUTTON_COLORS ) )
    tkTest_Check( "the type's defaults reach a Button with no recipe", d = -1, "slot " & d )

    tkTheme_SetRecipeNamed( b, "Danger", 0, 0 )
    tkButton_GetColors( b, @got )
    want = tkButton_ThemeColors( tkTheme_Remap( gDark, gStyle ) )
    want.BorderColor = &hFF0C0C0Cul
    want.BackColor = &hFF0D0D0Dul
    d = FirstDiff( @got, @want, sizeof( TKBUTTON_COLORS ) )
    tkTest_Check( "a style named, and the type's exception inside it", d = -1, "slot " & d )
    tkTest_Check( "StyleNameOf", tkTheme_StyleNameOf( b ) = "Danger" )

    dim as TKCOLOR_SRC own = tkTheme_SrcFixed( 2, &hFF0E0E0Eul )
    tkTheme_SetRecipeNamed( b, "Danger", @own, 1 )
    tkButton_GetColors( b, @got )
    tkTest_Check( "the control's own entry beats the type's", got.BorderColor = &hFF0E0E0Eul andalso got.BackColor = &hFF0D0D0Dul )

    tkTheme_SetRecipeNamed( b, "NoSuchStyle", 0, 0 )
    tkButton_GetColors( b, @got )
    tkTest_Check( "an unknown style name is no style", got.BackColor = tkButton_ThemeColors( gDark ).BackColor _
        andalso got.BorderColor = &hFF0C0C0Cul andalso len( tkTheme_StyleNameOf( b ) ) = 0 )

    dim as TK_WIDGET ptr lb = tkLabel_Create( gRoot, 71 )
    dim as TKLABEL_COLORS lgot, lwant
    tkLabel_GetColors( lb, @lgot )
    lwant = tkLabel_ThemeColors( gDark )
    tkTest_Check( "another type is untouched", FirstDiff( @lgot, @lwant, sizeof( TKLABEL_COLORS ) ) = -1 )

    ' app-wide: a Button outside every scope
    dim as TK_WIDGET ptr b2 = tkButton_Create( tkHost_Root( h ), 72 )
    tkTheme_SetTypeRecipes( @gTypes(0), 2 )
    tkButton_GetColors( b2, @got )
    tkTest_Check( "the app's type recipes reach an unscoped Button", got.BorderColor = &hFF0C0C0Cul _
        andalso got.BackColor = tkButton_ThemeColors( tkTheme_Light() ).BackColor )
    tkTheme_SetTypeRecipes( 0, 0 )
    tkButton_GetColors( b2, @got )
    tkTest_Check( "and leave when the app drops them", got.BorderColor = tkButton_ThemeColors( tkTheme_Light() ).BorderColor )
    tkWidget_Destroy( b ) : tkWidget_Destroy( lb ) : tkWidget_Destroy( b2 )
end scope

tkHost_Destroy( h )
dim as long nFail = tkTest_Report( "tkThemeControls" )
tkTest_Quit()
end nFail
