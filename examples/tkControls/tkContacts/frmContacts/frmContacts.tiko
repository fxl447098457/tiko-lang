' The half of the form you write. The rest is frmContacts.design.tiko, generated from
' frmContacts.tkform: don't edit that one.
#module "frmContacts"

#import "vendor/tkControls/tkListTree"
using tkListTree

public partial type Form
    Count as long
end type

sub Form.btnAdd_Click( )
    if len( txtName.Text ) = 0 then exit sub
    tkListTree_AddString( lstPeople.Handle, txtName.Text )
    txtName.Text = ""
    Count += 1
end sub

sub Form.Clear_Click( )
    tkListTree_Clear( lstPeople.Handle )
    Count = 0
end sub

sub Form.Exit_Click( )
    this.Close( )
end sub
