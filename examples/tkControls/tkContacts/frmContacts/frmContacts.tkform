format = 1

[form]
caption = "Contacts"
width = 520
height = 360

[[control]]
name = "mnuMain"
type = "MenuBar"
parent = ""
x = 0
y = 0
w = 520
h = 28
dock = "top"

[[control.items]]
text = "File"

[[control.items]]
text = "Clear"
level = 1
key = "Primary+L"
handler = "Clear_Click"

[[control.items]]
text = "-"
level = 1

[[control.items]]
text = "Exit"
level = 1
handler = "Exit_Click"

[[control]]
name = "sbMain"
type = "StatusBar"
parent = ""
x = 0
y = 0
w = 520
h = 26
dock = "bottom"

[[control.items]]
text = "Type a name and press Add"

[[control]]
name = "txtName"
type = "TextBox"
parent = ""
x = 16
y = 44
w = 392
h = 28
anchor = "left top right"

[[control]]
name = "btnAdd"
type = "Button"
parent = ""
x = 416
y = 44
w = 88
h = 28
anchor = "top right"

[control.props]
Text = "Add"

[control.events]
Click = "btnAdd_Click"

[[control]]
name = "lstPeople"
type = "ListTree"
parent = ""
x = 16
y = 84
w = 488
h = 236
anchor = "left top right bottom"

[[control.items]]
text = "Name"
width = 300
