format = 1

[form]
caption = "Contact"
width = 480
height = 420
start_position = "CenterOwner"
icon = "res:contacts"
data_type = "contactdb.Contact"
data_module = "../contactdb"

[[control]]
name = "tabDetails"
type = "TabControl"
parent = ""
x = 12
y = 12
w = 456
h = 344
pages = ["Name", "Address", "Phone & Email", "Photo"]
page_glyphs = ["Fluent:F5BD", "Fluent:F4F8", "Fluent:E270", "Fluent:F488"]

[[control]]
name = "lblFirstName"
type = "Label"
parent = "tabDetails"
page = 0
x = 16
y = 20
w = 110
h = 24

[control.props]
Text = "First name"

[[control]]
name = "txtFirstName"
type = "TextBox"
parent = "tabDetails"
page = 0
x = 132
y = 18
w = 300
h = 28
bind = "FirstName"

