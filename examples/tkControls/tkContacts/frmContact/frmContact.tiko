' The half of the form you write. The rest is frmContact.design.tiko, generated from
' frmContact.tkform: don't edit that one.
'
' The data entry dialog. The main form calls Edit( contact ), shows it with ShowModal, and when
' that returns 1 (OK) reads Person, PhotoFile and PhotoChanged.
#module "frmContact"

#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkPicture"
#import "vendor/tkControls/tkMessageBox"
#import "vendor/tkControls/tkFileDialog"
#import "../askbox"
#import "../contactdb"
using tkApp
using tkPicture
using tkMessageBox
using tkFileDialog

public partial type Form
    Person as contactdb.Contact      ' what the dialog shows; after OK, what was typed
    PhotoFile as ustring             ' the photo shown: a file's path, or "" for none
    PhotoChanged as boolean          ' a photo was chosen or removed
    declare sub Edit( byref c as contactdb.Contact )
    declare function Collect( ) as boolean
    declare sub ShowPhoto( )
end type

' Fill the dialog from c, on its first page.
sub Form.Edit( byref c as contactdb.Contact )
    Person = c
    txtFirstName.Text = c.FirstName
    txtLastName.Text = c.LastName
    txtCompany.Text = c.Company
    txtStreet.Text = c.Street
    txtCity.Text = c.City
    txtRegion.Text = c.Region
    txtPostalCode.Text = c.PostalCode
    txtCountry.Text = c.Country
    txtPhone.Text = c.Phone
    txtMobile.Text = c.Mobile
    txtEmail.Text = c.Email
    txtNotes.Text = c.Notes
    PhotoFile = contactdb.PhotoPath( c )
    PhotoChanged = false
    ShowPhoto( )
    tabDetails.SelectedIndex = 0
end sub

' The boxes into Person. False when there is no name to file it under.
function Form.Collect( ) as boolean
    Person.FirstName = trim( txtFirstName.Text )
    Person.LastName = trim( txtLastName.Text )
    Person.Company = trim( txtCompany.Text )
    Person.Street = trim( txtStreet.Text )
    Person.City = trim( txtCity.Text )
    Person.Region = trim( txtRegion.Text )
    Person.PostalCode = trim( txtPostalCode.Text )
    Person.Country = trim( txtCountry.Text )
    Person.Phone = trim( txtPhone.Text )
    Person.Mobile = trim( txtMobile.Text )
    Person.Email = trim( txtEmail.Text )
    Person.Notes = txtNotes.Text
    return len( Person.FullName( ) ) > 0
end function

' PhotoFile in the picture, or the project's "no photo" image (a Resource Center name) without one.
sub Form.ShowPhoto( )
    if (len( PhotoFile ) = 0) orelse (tkPicture_SetFile( picPhoto.Handle, PhotoFile ) = false) then
        picPhoto.File = "res:nophoto"
    end if
end sub

sub Form.btnChoosePhoto_Click( )
    dim as ustring path = tkFileDialog_OpenFile( tkForm_Host( Handle ), "Images|*.png;*.jpg;*.jpeg;*.bmp|All files|*.*" )
    if len( path ) = 0 then exit sub
    PhotoFile = path
    PhotoChanged = true
    ShowPhoto( )
end sub

sub Form.btnClearPhoto_Click( )
    PhotoFile = ""
    PhotoChanged = true
    ShowPhoto( )
end sub

sub Form.btnOK_Click( )
    if Collect( ) then
        EndModal( 1 )
    else
        tabDetails.SelectedIndex = 0
        askbox.Ask( Handle, "Type a first or a last name.", "Contact", MBX_ICON_INFO, MBX_BTN_OK )
    end if
end sub

sub Form.btnCancel_Click( )
    EndModal( 0 )
end sub
