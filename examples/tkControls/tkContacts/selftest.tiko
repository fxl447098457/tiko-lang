' tkContacts self-test: the sample program, driven through real events.
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkListTree"
#import "vendor/tkControls/tkTextBox"
#import "./frmContacts"
using tkApp
using tkListTree
using tkTextBox
using tkHost
using tkTest

sub ClickOn( byval h as TK_HOST ptr, byval w as TK_WIDGET ptr )
    tkTest_PushMotion( h, tkTest_CX( w ), tkTest_CY( w ) )
    tkTest_PumpFor( h, 20 )
    tkTest_Click( h, tkTest_CX( w ), tkTest_CY( w ) )
    tkTest_PumpFor( h, 40 )
end sub

dim as TKAPP_OPTIONS opts
if tkApp_Init( opts ) = false then
    print "tkApp_Init failed"
    end 98
end if
dim as TK_FORM ptr owner = tkApp_NewForm( "owner", 200, 120, 0, 1.0 )
tkForm_Show( owner )
tkTest_PumpFor( tkForm_Host( owner ), 50 )

tkTest_Begin( "contacts" )
scope
    dim as frmContacts.Form f
    f.Build( owner )
    dim as TK_HOST ptr h = tkForm_Host( f.Wnd )
    f.Show( )
    tkTest_PumpFor( h, 100 )
    tkTest_Check( "starts empty", tkListTree_GetCount( f.lstPeople.Handle ) = 0 )
    ClickOn( h, f.btnAdd.Handle )
    tkTest_Check( "nothing typed, nothing added", tkListTree_GetCount( f.lstPeople.Handle ) = 0 )
    ClickOn( h, f.txtName.Handle )
    dim as ustring who = "Ada"
    tkTest_PushText( h, who )
    tkTest_PumpFor( h, 30 )
    ClickOn( h, f.btnAdd.Handle )
    tkTest_Check( "a click adds the name", tkListTree_GetCount( f.lstPeople.Handle ) = 1, str( tkListTree_GetCount( f.lstPeople.Handle ) ) )
    tkTest_Check( "the name is the row", tkListTree_GetText( f.lstPeople.Handle, 0 ) = "Ada" )
    tkTest_Check( "the box is emptied", f.txtName.Text = "" )
    tkTest_Check( "the title counts", f.Count = 1 )
    f.Clear_Click( )
    tkTest_Check( "Clear empties the list", tkListTree_GetCount( f.lstPeople.Handle ) = 0 )
end scope
dim as long nFail = tkTest_Report( "tkContacts" )
tkApp_Shutdown( )
end nFail
