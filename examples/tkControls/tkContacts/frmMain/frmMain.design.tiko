sub Form.lstContacts_Fill( )
    scope
        dim byref as Array( of contactdb.Contact ) a_ = People
        tkListTree_BeginUpdate( lstContacts.Handle )
        tkListTree_Clear( lstContacts.Handle )
        for i_ as int32 = 0 to a_.Count( ) - 1
            dim as integer row_ = tkListTree_AddString( lstContacts.Handle, tkBind_Text( a_[i_].FullName( ) ) )
            tkListTree_SetCellText( lstContacts.Handle, row_, 1, tkBind_Text( a_[i_].Phone ) )
            tkListTree_SetCellText( lstContacts.Handle, row_, 2, tkBind_Text( a_[i_].Email ) )
            tkListTree_SetItemData( lstContacts.Handle, row_, i_ )
        next
        tkListTree_EndUpdate( lstContacts.Handle )
    end scope
end sub

function Form.lstContacts_Item( ) as int32
    dim as int32 row_ = tkListTree_GetCurSel( lstContacts.Handle )
    if row_ < 0 then return -1
    return tkListTree_GetItemData( lstContacts.Handle, row_ )
end function
