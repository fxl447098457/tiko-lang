format = 1

[form]
caption = "Contacts"
width = 760
height = 500
start_position = "CenterScreen"
min_width = 560
min_height = 380
icon = "res:contacts"
data_module = "../contactdb"

[form.events]
Load = "Form_Load"
Destroy = "Form_Destroy"

[[control]]
name = "mnuMain"
type = "MenuBar"
parent = ""
x = 0
y = 0
w = 760
h = 28
dock = "top"

[[control.items]]
text = "File"

[[control.items]]
text = "New Contact..."
level = 1
key = "Primary+N"
handler = "AddContact"

[[control.items]]
text = "Edit Contact..."
level = 1
key = "Primary+E"
handler = "EditContact"

[[control.items]]
text = "Delete Contact"
level = 1
handler = "DeleteContact"

[[control.items]]
text = "-"
level = 1

[[control.items]]
text = "Export to CSV..."
level = 1
key = "Primary+Shift+E"
handler = "ExportCsv"

[[control.items]]
text = "-"
level = 1

[[control.items]]
text = "Exit"
level = 1
handler = "mnuMain_File_Exit"

[[control.items]]
text = "Help"

[[control.items]]
text = "About Contacts"
level = 1
handler = "mnuMain_Help_AboutContacts"

[[control]]
name = "tbMain"
type = "Toolbar"
parent = ""
x = 0
y = 28
w = 760
h = 34
dock = "top"

[[control.items]]
text = "Add"
kind = "command"
glyph = "Fluent:F5C2"
handler = "AddContact"

[[control.items]]
text = "Edit"
kind = "command"
glyph = "Fluent:E92E"
handler = "EditContact"

[[control.items]]
text = "Delete"
kind = "command"
glyph = "Fluent:E92D"
handler = "DeleteContact"

[[control.items]]
text = ""
kind = "separator"

[[control.items]]
text = "Export"
kind = "command"
glyph = "Fluent:E0C7"
handler = "ExportCsv"

[[control]]
name = "sbMain"
type = "StatusBar"
parent = ""
x = 0
y = 474
w = 760
h = 26
dock = "bottom"

[[control.items]]
text = "0 contacts"
width = 140

[[control.items]]
text = "Ready"
stretch = true

[[control]]
name = "lstContacts"
type = "ListTree"
parent = ""
x = 12
y = 74
w = 480
h = 388
anchor = "left top right bottom"
context_menu = "mnuContext"
items_source = "People"
item_type = "contactdb.Contact"

[control.props]
ShowHeader = true

[control.events]
Activate = "lstContacts_Activate"
SelChange = "lstContacts_SelChange"
Message = "lstContacts_Message"
Tooltip = "lstContacts_Tooltip"

[[control.items]]
text = "Name"
width = 190
field = "FullName( )"

[[control.items]]
text = "Phone"
width = 120
field = "Phone"

[[control.items]]
text = "Email"
width = 180
field = "Email"

[[control]]
name = "picPhoto"
type = "Picture"
parent = ""
x = 504
y = 74
w = 244
h = 224
anchor = "top right"

[control.props]
File = "res:nophoto"

[[control]]
name = "lblName"
type = "Label"
parent = ""
x = 504
y = 306
w = 244
h = 24
anchor = "top right"

[control.props]
Text = ""
Font = "UI_BOLD"

[[control]]
name = "lblDetails"
type = "Label"
parent = ""
x = 504
y = 332
w = 244
h = 84
anchor = "top right"

[control.props]
Text = ""
WordWrap = true

[[control]]
name = "btnAdd"
type = "Button"
parent = ""
x = 504
y = 430
w = 118
h = 32
anchor = "right bottom"

[control.props]
Text = "Add"
GlyphLeft = "Fluent:F5C2"
GlyphFont = "16"

[control.events]
Click = "AddContact"

[[control]]
name = "btnRemove"
type = "Button"
parent = ""
x = 630
y = 430
w = 118
h = 32
anchor = "right bottom"

[control.props]
Text = "Remove"
GlyphLeft = "Fluent:E92D"
GlyphFont = "16"

[control.colors]
style = "Danger"

[control.events]
Click = "DeleteContact"

[[control]]
name = "mnuContext"
type = "PopupMenu"
parent = ""
x = 12
y = 440
w = 72
h = 24

[[control.items]]
text = "New Contact..."
handler = "AddContact"

[[control.items]]
text = "Edit Contact..."
handler = "EditContact"

[[control.items]]
text = "Delete Contact"
handler = "DeleteContact"

[[control.items]]
text = "-"

[[control.items]]
text = "Export to CSV..."
handler = "ExportCsv"
