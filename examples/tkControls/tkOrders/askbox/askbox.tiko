' askbox -- a message box over a form, in the form's fonts.
'
' tkMessageBox_Show sets no fonts: its icon and close X are glyph codes, which the text font draws
' as empty boxes. Ask gives the box the form's text font, its glyph font for the close X, and the
' glyph font at ICON_PT for the icon (opened once per window and kept, scaled with it).
#module "askbox"

#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkMessageBox"
using tkApp
using tkMessageBox
using tkHost

const as int32 ICON_PT = 32

dim shared as TK_HOST ptr gHosts( any )
dim shared as TTF_Font ptr gIcons( any )

' The icon font for a window, opened the first time.
function IconFont( byval h as TK_HOST ptr ) as TTF_Font ptr
    for i as int32 = 0 to ubound( gHosts )
        if gHosts( i ) = h then return gIcons( i )
    next
    dim as int32 n = ubound( gHosts ) + 1
    redim preserve gHosts( 0 to n )
    redim preserve gIcons( 0 to n )
    gHosts( n ) = h
    gIcons( n ) = tkHost_OpenFont( h, tkApp_GlyphFace( ), ICON_PT )
    return gIcons( n )
end function

' A message box over form f, not shown yet: text, a caption, an icon (MBX_ICON_*) and buttons
' (MBX_BTN_*). tkMessageBox_DoModal shows it and frees it.
public function NewBox( byval f as TK_FORM ptr, byref text as const ustring, byref caption as const ustring, _
                        byval icon as int32, byval buttons as int32 ) as TK_WIDGET ptr
    dim as TK_WIDGET ptr box = tkMessageBox_Create( tkForm_Widget( f ) )
    if box = 0 then return 0
    dim as TTF_Font ptr fIcon = IconFont( tkForm_Host( f ) )
    if fIcon then
        dim as int32 fh = TTF_GetFontHeight( fIcon )
        tkMessageBox_SetIconSize( box, fh, fh )
    end if
    tkMessageBox_ApplyFonts( box, tkForm_Font( f, TKFONT_UI ), fIcon )
    tkMessageBox_SetCloseGlyphFont( box, tkForm_Font( f, TKFONT_GLYPH ) )
    tkMessageBox_SetCaption( box, caption )
    tkMessageBox_SetText( box, text )
    tkMessageBox_SetIconKind( box, icon )
    tkMessageBox_AddPreset( box, buttons )
    return box
end function

' Show it and wait: the button pressed (MBX_IDOK, MBX_IDYES, ...).
public function Ask( byval f as TK_FORM ptr, byref text as const ustring, byref caption as const ustring, _
                     byval icon as int32, byval buttons as int32 ) as int32
    dim as TK_WIDGET ptr box = NewBox( f, text, caption, icon, buttons )
    if box = 0 then return 0
    return tkMessageBox_DoModal( box )
end function
