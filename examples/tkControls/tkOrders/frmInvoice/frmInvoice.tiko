' The half of the form you write. The rest is frmInvoice.design.tiko, generated from
' frmInvoice.tkform: don't edit that one.
'
' One order printed as an invoice. The form is a single ReportViewer whose Report property is
' ../rptInvoice, so the generated half gives the form a member rvInvoiceReport of type
' rptInvoice.Report. That report's data is an array source, Orders, with a child source, Lines
' (the relation is Order.Lines): the generated SetOrders( ) hands it an Array( of orderdb.Order ).
' Here that array holds one order, the one on the order dialog.
#module "frmInvoice"

#import "std/containers"
#import "../orderdb"
using containers

public partial type Form
    Orders as Array( of orderdb.Order )      ' the report's rows: it reads them, it doesn't copy them
    declare sub ShowOrder( byref o as orderdb.Order )
end type

' Show o as an invoice. Call it after Build and before ShowModal.
sub Form.ShowOrder( byref o as orderdb.Order )
    Orders.Clear( )
    Orders.Push( o )
    rvInvoiceReport.SetOrders( Orders )      ' generated from the .tkreport's [[source]] Orders
    rvInvoiceReport.ShowIn( rvInvoice.Handle )
end sub
