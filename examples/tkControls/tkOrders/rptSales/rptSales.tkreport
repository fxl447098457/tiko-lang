format = 1

[report]
title = "Sales by customer"
paper = "A4"

[[parameter]]
name = "FromDate"
type = "date"
default = "#2025-01-01#"
prompt = "From"

[[parameter]]
name = "ToDate"
type = "date"
default = "#2025-12-31#"
prompt = "To"

[[source]]
name = "Sales"
kind = "sqlite"
sql = "select c.company as Company, c.country as Country, o.id as OrderId, o.order_date as OrderDate, o.status as Status, o.total as Total from orders o join customer c on c.id = o.customer_id where o.order_date between :FromDate and :ToDate and o.status <> 'Cancelled' order by c.company, o.order_date, o.id"
params = { FromDate = "@FromDate", ToDate = "@ToDate" }

  [[source.field]]
  name = "Company"

  [[source.field]]
  name = "Country"

  [[source.field]]
  name = "OrderId"
  kind = "int"

  [[source.field]]
  name = "OrderDate"
  kind = "date"

  [[source.field]]
  name = "Status"

  [[source.field]]
  name = "Total"
  kind = "float"

[[band]]
id = "rh"
kind = "report_header"
height = 66

[[band]]
id = "ph"
kind = "page_header"
height = 22
print_on_first_page = false

[[band]]
id = "g1h"
kind = "group_header"
group = "[Company]"
height = 22

[[band]]
id = "d"
kind = "detail"
source = "Sales"
height = 16

[[band]]
id = "g1f"
kind = "group_footer"
height = 26

[[band]]
id = "rf"
kind = "report_footer"
height = 30

[[band]]
id = "nd"
kind = "no_data"

[[band]]
id = "pf"
kind = "page_footer"

[[item]]
id = "title"
band = "rh"
rect = [0, 0, 482, 22]
text = "Sales by customer"
font = { size = 16, bold = true }

[[item]]
id = "period"
band = "rh"
rect = [0, 24, 482, 14]
text = "Orders from {Format(@FromDate, \"dd/mm/yyyy\")} to {Format(@ToDate, \"dd/mm/yyyy\")}; cancelled orders are left out"
fore = "#666666"

[[item]]
id = "orderCap"
band = "ph"
rect = [20, 4, 70, 16]
text = "Order"
font = { bold = true }
border = "bottom"

[[item]]
id = "dateCap"
band = "ph"
rect = [90, 4, 90, 16]
text = "Date"
font = { bold = true }
border = "bottom"

[[item]]
id = "statusCap"
band = "ph"
rect = [180, 4, 202, 16]
text = "Status"
font = { bold = true }
border = "bottom"

[[item]]
id = "totalCap"
band = "ph"
rect = [382, 4, 100, 16]
text = "Total"
align = "right"
font = { bold = true }
border = "bottom"

[[item]]
id = "company"
band = "g1h"
kind = "field"
rect = [0, 6, 300, 16]
expr = "[Company]"
font = { size = 11, bold = true }
fore = "#1F4E79"

[[item]]
id = "country"
band = "g1h"
kind = "field"
rect = [300, 6, 182, 16]
expr = "[Country]"
align = "right"
fore = "#666666"

[[item]]
id = "orderId"
band = "d"
kind = "field"
rect = [20, 1, 70, 14]
expr = "[OrderId]"

[[item]]
id = "orderDate"
band = "d"
kind = "field"
rect = [90, 1, 90, 14]
expr = "[OrderDate]"
format = "dd/mm/yyyy"

[[item]]
id = "status"
band = "d"
kind = "field"
rect = [180, 1, 202, 14]
expr = "[Status]"

  [[item.rule]]
  when = "[Status] = \"Open\""
  fore = "#B45309"
  bold = true

[[item]]
id = "total"
band = "d"
kind = "field"
rect = [382, 1, 100, 14]
expr = "[Total]"
format = "#,##0.00"
align = "right"

[[item]]
id = "custCount"
band = "g1f"
rect = [20, 4, 300, 14]
text = "{Count()} orders"
font = { italic = true }
fore = "#666666"

[[item]]
id = "custTotal"
band = "g1f"
kind = "field"
rect = [382, 4, 100, 16]
expr = "Sum([Total])"
format = "#,##0.00"
align = "right"
font = { bold = true }
border = "top"

[[item]]
id = "allCap"
band = "rf"
rect = [0, 8, 380, 16]
text = "All customers: {Count()} orders"
font = { bold = true }

[[item]]
id = "allTotal"
band = "rf"
kind = "field"
rect = [382, 8, 100, 16]
expr = "Sum([Total])"
format = "#,##0.00"
align = "right"
font = { size = 11, bold = true }
border = "top bottom"

[[item]]
id = "noData"
band = "nd"
rect = [0, 2, 482, 14]
text = "No orders between these dates."
font = { italic = true }

[[item]]
id = "pageNo"
band = "pf"
rect = [282, 4, 200, 14]
text = "Page {PageNumber} of {PageCount}"
align = "right"
font = { size = 8 }
fore = "#666666"

[[item]]
id = "firstOrderCap"
band = "rh"
rect = [20, 48, 70, 16]
text = "Order"
font = { bold = true }
border = "bottom"

[[item]]
id = "firstDateCap"
band = "rh"
rect = [90, 48, 90, 16]
text = "Date"
font = { bold = true }
border = "bottom"

[[item]]
id = "firstStatusCap"
band = "rh"
rect = [180, 48, 202, 16]
text = "Status"
font = { bold = true }
border = "bottom"

[[item]]
id = "firstTotalCap"
band = "rh"
rect = [382, 48, 100, 16]
text = "Total"
align = "right"
font = { bold = true }
border = "bottom"
