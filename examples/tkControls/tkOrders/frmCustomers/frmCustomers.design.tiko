function Form.LoadFrom( byref r as orderdb.Customer ) as boolean
    dim as TKBIND_ERRORS bindErrors_
    tkTextBox_SetText( txtCompany.Handle, tkBind_Text( r.Company ) )
    tkTextBox_SetError( txtCompany.Handle, false )
    tkTextBox_SetText( txtContact.Handle, tkBind_Text( r.Contact ) )
    tkTextBox_SetError( txtContact.Handle, false )
    tkTextBox_SetText( txtEmail.Handle, tkBind_Text( r.Email ) )
    tkTextBox_SetError( txtEmail.Handle, false )
    tkTextBox_SetText( txtPhone.Handle, tkBind_Text( r.Phone ) )
    tkTextBox_SetError( txtPhone.Handle, false )
    tkTextBox_SetText( txtCity.Handle, tkBind_Text( r.City ) )
    tkTextBox_SetError( txtCity.Handle, false )
    tkTextBox_SetText( txtCountry.Handle, tkBind_Text( r.Country ) )
    tkTextBox_SetError( txtCountry.Handle, false )
    tkComboBox_SetCurSel( cboTier.Handle, tkBind_IndexOf( cboTier_Values_, tkBind_Text( r.Tier ) ) )
    tkBind_LoadedPick( bindErrors_, cboTier.Handle, "Tier", tkBind_Text( r.Tier ), tkComboBox_GetCurSel( cboTier.Handle ) )
    tkDatePicker_SetDateValue( dtpSince.Handle, tkBind_Date( r.Since ) )
    tkBind_Loaded( bindErrors_, dtpSince.Handle, "Since", r.Since, tkDatePicker_GetDateValue( dtpSince.Handle ) )
    tkNumericUpDown_SetValue( nudCredit.Handle, tkBind_Float( r.CreditLimit ) )
    tkBind_Loaded( bindErrors_, nudCredit.Handle, "CreditLimit", r.CreditLimit, cdbl( tkNumericUpDown_GetValue( nudCredit.Handle ) ) )
    tkRating_SetValue( rtgRating.Handle, tkBind_Float( r.Rating ) )
    tkBind_Loaded( bindErrors_, rtgRating.Handle, "Rating", r.Rating, cdbl( tkRating_GetValue( rtgRating.Handle ) ) )
    tkCheckBox_SetChecked( chkActive.Handle, tkBind_Bool( r.Active ) )
    tkTextBox_SetText( txtNotes.Handle, tkBind_Text( r.Notes ) )
    tkTextBox_SetError( txtNotes.Handle, false )
    scope
        dim byref as Array( of orderdb.Order ) a_ = r.Orders
        tkDataGrid_BeginUpdate( grdOrders.Handle )
        tkDataGrid_SetRowCount( grdOrders.Handle, 0 )
        tkDataGrid_SetRowCount( grdOrders.Handle, a_.Count( ) )
        for i_ as int32 = 0 to a_.Count( ) - 1
            tkDataGrid_SetCellFloat( grdOrders.Handle, i_, 0, tkBind_Float( a_[i_].Id ) )
            tkDataGrid_SetCellDate( grdOrders.Handle, i_, 1, tkBind_Date( a_[i_].OrderDate ) )
            tkDataGrid_SetCellText( grdOrders.Handle, i_, 2, tkBind_Text( a_[i_].Status ) )
            tkDataGrid_SetCellBool( grdOrders.Handle, i_, 3, tkBind_Bool( a_[i_].Shipped ) )
            tkDataGrid_SetCellFloat( grdOrders.Handle, i_, 4, tkBind_Float( a_[i_].Amount ) )
            tkDataGrid_SetCellText( grdOrders.Handle, i_, 5, tkBind_Text( a_[i_].Notes ) )
        next
        tkDataGrid_EndUpdate( grdOrders.Handle )
    end scope
    if bindErrors_.Count then
        dim as boolean bindHandled_ = false
        if bindHandled_ = false then tkBind_ShowErrors( Handle, bindErrors_, true )
        return false
    end if
    return true
end function

function Form.SaveTo( byref r as orderdb.Customer ) as boolean
    dim as TKBIND_ERRORS bindErrors_
    if tkDataGrid_EndEdit( grdOrders.Handle, true ) = false then return false
    tkBind_Check( bindErrors_, txtCompany.Handle, "Company", r.Company, tkTextBox_GetText( txtCompany.Handle ), tkBind_Rule( true, "", "", 0, "" ) )
    tkBind_Check( bindErrors_, txtContact.Handle, "Contact", r.Contact, tkTextBox_GetText( txtContact.Handle ), tkBind_Rule( false, "", "", 0, "" ) )
    tkBind_Check( bindErrors_, txtEmail.Handle, "Email", r.Email, tkTextBox_GetText( txtEmail.Handle ), tkBind_Rule( false, "", "", 0, "" ) )
    tkBind_Check( bindErrors_, txtPhone.Handle, "Phone", r.Phone, tkTextBox_GetText( txtPhone.Handle ), tkBind_Rule( false, "", "", 0, "" ) )
    tkBind_Check( bindErrors_, txtCity.Handle, "City", r.City, tkTextBox_GetText( txtCity.Handle ), tkBind_Rule( false, "", "", 0, "" ) )
    tkBind_Check( bindErrors_, txtCountry.Handle, "Country", r.Country, tkTextBox_GetText( txtCountry.Handle ), tkBind_Rule( false, "", "", 0, "" ) )
    tkBind_CheckPick( bindErrors_, cboTier.Handle, "Tier", r.Tier, cboTier_Values_, tkComboBox_GetCurSel( cboTier.Handle ), tkBind_Rule( true, "", "", 0, "", true, -1 ) )
    tkBind_Check( bindErrors_, dtpSince.Handle, "Since", r.Since, tkDatePicker_GetDateValue( dtpSince.Handle ), tkBind_Rule( false, "", "", 0, "" ) )
    tkBind_Check( bindErrors_, nudCredit.Handle, "CreditLimit", r.CreditLimit, cdbl( tkNumericUpDown_GetValue( nudCredit.Handle ) ), tkBind_Rule( false, "", "", 0, "" ) )
    tkBind_Check( bindErrors_, rtgRating.Handle, "Rating", r.Rating, cdbl( tkRating_GetValue( rtgRating.Handle ) ), tkBind_Rule( false, "", "", 0, "" ) )
    tkBind_Check( bindErrors_, txtNotes.Handle, "Notes", r.Notes, tkTextBox_GetText( txtNotes.Handle ), tkBind_Rule( false, "", "", 0, "" ) )
    tkTextBox_SetError( txtCompany.Handle, bindErrors_.Has( txtCompany.Handle ) )
    tkTextBox_SetError( txtContact.Handle, bindErrors_.Has( txtContact.Handle ) )
    tkTextBox_SetError( txtEmail.Handle, bindErrors_.Has( txtEmail.Handle ) )
    tkTextBox_SetError( txtPhone.Handle, bindErrors_.Has( txtPhone.Handle ) )
    tkTextBox_SetError( txtCity.Handle, bindErrors_.Has( txtCity.Handle ) )
    tkTextBox_SetError( txtCountry.Handle, bindErrors_.Has( txtCountry.Handle ) )
    tkTextBox_SetError( txtNotes.Handle, bindErrors_.Has( txtNotes.Handle ) )
    if bindErrors_.Count then
        dim as boolean bindHandled_ = false
        if bindHandled_ = false then tkBind_ShowErrors( Handle, bindErrors_, false )
        return false
    end if
    tkBind_Put( r.Company, tkTextBox_GetText( txtCompany.Handle ) )
    tkBind_Put( r.Contact, tkTextBox_GetText( txtContact.Handle ) )
    tkBind_Put( r.Email, tkTextBox_GetText( txtEmail.Handle ) )
    tkBind_Put( r.Phone, tkTextBox_GetText( txtPhone.Handle ) )
    tkBind_Put( r.City, tkTextBox_GetText( txtCity.Handle ) )
    tkBind_Put( r.Country, tkTextBox_GetText( txtCountry.Handle ) )
    tkBind_PutPick( r.Tier, cboTier_Values_, tkComboBox_GetCurSel( cboTier.Handle ) )
    tkBind_Put( r.Since, tkDatePicker_GetDateValue( dtpSince.Handle ) )
    tkBind_Put( r.CreditLimit, cdbl( tkNumericUpDown_GetValue( nudCredit.Handle ) ) )
    tkBind_Put( r.Rating, cdbl( tkRating_GetValue( rtgRating.Handle ) ) )
    tkBind_Put( r.Active, tkCheckBox_GetChecked( chkActive.Handle ) )
    tkBind_Put( r.Notes, tkTextBox_GetText( txtNotes.Handle ) )
    scope
        dim byref as Array( of orderdb.Order ) a_ = r.Orders
        dim as int32 n_ = tkDataGrid_GetRowCount( grdOrders.Handle )
        if a_.Count( ) > n_ then a_.SetCount( n_ )
        while a_.Count( ) < n_
            dim as orderdb.Order new_
            a_.Push( new_ )
        wend
        for i_ as int32 = 0 to n_ - 1
            tkBind_Put( a_[i_].Id, tkDataGrid_GetCellFloat( grdOrders.Handle, i_, 0 ) )
            tkBind_Put( a_[i_].OrderDate, tkDataGrid_GetCellDate( grdOrders.Handle, i_, 1 ) )
            tkBind_Put( a_[i_].Status, tkDataGrid_GetCellText( grdOrders.Handle, i_, 2 ) )
            tkBind_Put( a_[i_].Shipped, tkDataGrid_GetCellBool( grdOrders.Handle, i_, 3 ) )
            tkBind_Put( a_[i_].Amount, tkDataGrid_GetCellFloat( grdOrders.Handle, i_, 4 ) )
            tkBind_Put( a_[i_].Notes, tkDataGrid_GetCellText( grdOrders.Handle, i_, 5 ) )
        next
    end scope
    return true
end function

sub Form.grdCustomers_Fill( )
    scope
        dim byref as Array( of orderdb.Customer ) a_ = Customers
        tkDataGrid_BeginUpdate( grdCustomers.Handle )
        tkDataGrid_SetRowCount( grdCustomers.Handle, 0 )
        tkDataGrid_SetRowCount( grdCustomers.Handle, a_.Count( ) )
        for i_ as int32 = 0 to a_.Count( ) - 1
            tkDataGrid_SetCellText( grdCustomers.Handle, i_, 0, tkBind_Text( a_[i_].Company ) )
            tkDataGrid_SetCellText( grdCustomers.Handle, i_, 1, tkBind_Text( a_[i_].Country ) )
        next
        tkDataGrid_EndUpdate( grdCustomers.Handle )
    end scope
end sub

function Form.grdCustomers_Item( ) as int32
    dim as integer r_, c_
    if tkDataGrid_GetCurrentCell( grdCustomers.Handle, r_, c_ ) = false then return -1
    if r_ >= tkDataGrid_GetRowCount( grdCustomers.Handle ) then return -1
    return r_
end function

sub Form.cboTier_Fill( )
    scope
        dim as Array( of orderdb.Choice ) a_ = orderdb.Tiers( )
        tkComboBox_Clear( cboTier.Handle )
        cboTier_Values_.Clear( )
        for i_ as int32 = 0 to a_.Count( ) - 1
            tkComboBox_AddItem( cboTier.Handle, tkBind_Text( a_[i_].Name ) )
            cboTier_Values_.Push( tkBind_Text( a_[i_].Name ) )
        next
    end scope
end sub

function Form.grdOrders_Item( ) as int32
    dim as integer r_, c_
    if tkDataGrid_GetCurrentCell( grdOrders.Handle, r_, c_ ) = false then return -1
    if r_ >= tkDataGrid_GetRowCount( grdOrders.Handle ) then return -1
    return r_
end function

function Form.IsDirty( byref r as orderdb.Customer ) as boolean
    if tkBind_Differs( r.Company, tkTextBox_GetText( txtCompany.Handle ), "" ) then return true
    if tkBind_Differs( r.Contact, tkTextBox_GetText( txtContact.Handle ), "" ) then return true
    if tkBind_Differs( r.Email, tkTextBox_GetText( txtEmail.Handle ), "" ) then return true
    if tkBind_Differs( r.Phone, tkTextBox_GetText( txtPhone.Handle ), "" ) then return true
    if tkBind_Differs( r.City, tkTextBox_GetText( txtCity.Handle ), "" ) then return true
    if tkBind_Differs( r.Country, tkTextBox_GetText( txtCountry.Handle ), "" ) then return true
    if tkBind_DiffersPick( r.Tier, cboTier_Values_, tkComboBox_GetCurSel( cboTier.Handle ) ) then return true
    if tkBind_Differs( r.Since, tkDatePicker_GetDateValue( dtpSince.Handle ) ) then return true
    if tkBind_Differs( r.CreditLimit, cdbl( tkNumericUpDown_GetValue( nudCredit.Handle ) ) ) then return true
    if tkBind_Differs( r.Rating, cdbl( tkRating_GetValue( rtgRating.Handle ) ) ) then return true
    if tkBind_Differs( r.Active, tkCheckBox_GetChecked( chkActive.Handle ) ) then return true
    if tkBind_Differs( r.Notes, tkTextBox_GetText( txtNotes.Handle ), "" ) then return true
    if tkDataGrid_IsEditing( grdOrders.Handle ) then return true
    scope
        dim byref as Array( of orderdb.Order ) a_ = r.Orders
        if tkDataGrid_GetRowCount( grdOrders.Handle ) <> a_.Count( ) then return true
        for i_ as int32 = 0 to a_.Count( ) - 1
            if tkBind_Differs( a_[i_].Id, tkDataGrid_GetCellFloat( grdOrders.Handle, i_, 0 ) ) then return true
            if tkBind_Differs( a_[i_].OrderDate, tkDataGrid_GetCellDate( grdOrders.Handle, i_, 1 ) ) then return true
            if tkBind_Differs( a_[i_].Status, tkDataGrid_GetCellText( grdOrders.Handle, i_, 2 ), "" ) then return true
            if tkBind_Differs( a_[i_].Shipped, tkDataGrid_GetCellBool( grdOrders.Handle, i_, 3 ) ) then return true
            if tkBind_Differs( a_[i_].Amount, tkDataGrid_GetCellFloat( grdOrders.Handle, i_, 4 ) ) then return true
            if tkBind_Differs( a_[i_].Notes, tkDataGrid_GetCellText( grdOrders.Handle, i_, 5 ), "" ) then return true
        next
    end scope
    return false
end function

function Form.navCustomers_MoveTo( byval i as int32 ) as boolean
    dim byref as Array( of orderdb.Customer ) a_ = Customers
    if (i < 0) orelse (i >= a_.Count( )) then return false
    dim as int32 cur = tkNavigator_GetPosition( navCustomers.Handle )
    if (cur >= 0) andalso (cur < a_.Count( )) then
        if cur = i then return true
        if IsDirty( a_[cur] ) then
            if SaveTo( a_[cur] ) = false then return false
            navCustomers_ListRow_( cur )
        end if
    end if
    tkNavigator_SetCount( navCustomers.Handle, a_.Count( ) )
    tkNavigator_SetPosition( navCustomers.Handle, i )
    LoadFrom( a_[i] )
    scope
        dim as integer r_, c_
        tkDataGrid_GetCurrentCell( grdCustomers.Handle, r_, c_ )
        tkDataGrid_SetCurrentCell( grdCustomers.Handle, i, iif( c_ < 0, 0, c_ ) )
    end scope
    return true
end function

sub Form.navCustomers_Refresh( )
    dim byref as Array( of orderdb.Customer ) a_ = Customers
    grdCustomers_Fill( )
    tkNavigator_SetCount( navCustomers.Handle, a_.Count( ) )
    if a_.Count( ) = 0 then
        tkNavigator_SetPosition( navCustomers.Handle, -1 )
        dim as orderdb.Customer blank_
        LoadFrom( blank_ )
        exit sub
    end if
    dim as int32 cur = tkNavigator_GetPosition( navCustomers.Handle )
    if cur < 0 then cur = 0
    tkNavigator_SetPosition( navCustomers.Handle, cur )
    LoadFrom( a_[cur] )
    scope
        dim as integer r_, c_
        tkDataGrid_GetCurrentCell( grdCustomers.Handle, r_, c_ )
        tkDataGrid_SetCurrentCell( grdCustomers.Handle, cur, iif( c_ < 0, 0, c_ ) )
    end scope
end sub

function Form.navCustomers_Current( ) as int32
    return tkNavigator_GetPosition( navCustomers.Handle )
end function

function Form.navCustomers_Go_( byval action as int32, byval target as int32 ) as boolean
    dim byref as Array( of orderdb.Customer ) a_ = Customers
    dim as int32 cur = tkNavigator_GetPosition( navCustomers.Handle )
    select case action
    case TKNAV_NEW
        if (cur >= 0) andalso (cur < a_.Count( )) then
            if IsDirty( a_[cur] ) then
                if SaveTo( a_[cur] ) = false then return false
            end if
        end if
        dim as orderdb.Customer blank_
        a_.Push( blank_ )
        tkNavigator_SetCount( navCustomers.Handle, a_.Count( ) )
        tkNavigator_SetPosition( navCustomers.Handle, a_.Count( ) - 1 )
        navCustomers_Refresh( )
        return true
    case TKNAV_DELETE
        if (cur < 0) orelse (cur >= a_.Count( )) then return false
        a_.Remove( cur )
        tkNavigator_SetCount( navCustomers.Handle, a_.Count( ) )
        navCustomers_Refresh( )
        return true
    end select
    return navCustomers_MoveTo( target )
end function

sub Form.navCustomers_FromList_( )
    dim as int32 i = grdCustomers_Item( )
    dim as int32 cur = tkNavigator_GetPosition( navCustomers.Handle )
    if (i < 0) orelse (i = cur) then exit sub
    if navCustomers_MoveTo( i ) = false then
        scope
            dim as integer r_, c_
            tkDataGrid_GetCurrentCell( grdCustomers.Handle, r_, c_ )
            tkDataGrid_SetCurrentCell( grdCustomers.Handle, cur, iif( c_ < 0, 0, c_ ) )
        end scope
    end if
end sub

sub Form.navCustomers_ListRow_( byval i as int32 )
    dim byref as Array( of orderdb.Customer ) a_ = Customers
    if (i < 0) orelse (i >= a_.Count( )) then exit sub
    tkDataGrid_SetCellText( grdCustomers.Handle, i, 0, tkBind_Text( a_[i].Company ) )
    tkDataGrid_SetCellText( grdCustomers.Handle, i, 1, tkBind_Text( a_[i].Country ) )
end sub
