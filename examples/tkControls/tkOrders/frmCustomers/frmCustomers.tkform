format = 1

[form]
caption = "Customers and Orders"
width = 980
height = 604
start_position = "CenterScreen"
min_width = 900
min_height = 520
data_type = "orderdb.Customer"
data_module = "../orderdb"

[form.events]
Load = "Form_Load"
Close = "Form_Close"
Destroy = "Form_Destroy"

[[control]]
name = "lblCustomers"
type = "Label"
parent = ""
x = 12
y = 12
w = 200
h = 28

[control.props]
Text = "Customers"

[[control]]
name = "grdCustomers"
type = "DataGrid"
parent = ""
x = 12
y = 44
w = 300
h = 482
anchor = "left top bottom"
items_source = "Customers"
item_type = "orderdb.Customer"

[control.props]
ReadOnly = true
AlternateRows = true
SelectionUnit = "Row"
AllowDeleteRows = false

[control.events]
CurrentCellChanged = "grdCustomers_CurrentCellChanged"

[[control.items]]
text = "Company"
width = 180
field = "Company"

[[control.items]]
text = "Country"
width = 100
field = "Country"

[[control]]
name = "navCustomers"
type = "Navigator"
parent = ""
x = 12
y = 534
w = 300
h = 32
anchor = "left bottom"
items_source = "Customers"
follows = "grdCustomers"

[control.props]
PositionText = "Customer {1} of {2}"

[control.events]
Navigate = "navCustomers_Navigate"

[[control]]
name = "lblCompany"
type = "Label"
parent = ""
x = 332
y = 16
w = 96
h = 28

[control.props]
Text = "Company *"

[[control]]
name = "txtCompany"
type = "TextBox"
parent = ""
x = 432
y = 16
w = 220
h = 28
bind = "Company"
required = true

[[control]]
name = "lblContact"
type = "Label"
parent = ""
x = 668
y = 16
w = 96
h = 28

[control.props]
Text = "Contact"

[[control]]
name = "txtContact"
type = "TextBox"
parent = ""
x = 768
y = 16
w = 200
h = 28
anchor = "left top right"
bind = "Contact"

[[control]]
name = "lblEmail"
type = "Label"
parent = ""
x = 332
y = 52
w = 96
h = 28

[control.props]
Text = "Email"

[[control]]
name = "txtEmail"
type = "TextBox"
parent = ""
x = 432
y = 52
w = 220
h = 28
bind = "Email"

[[control]]
name = "lblPhone"
type = "Label"
parent = ""
x = 668
y = 52
w = 96
h = 28

[control.props]
Text = "Phone"

[[control]]
name = "txtPhone"
type = "TextBox"
parent = ""
x = 768
y = 52
w = 200
h = 28
anchor = "left top right"
bind = "Phone"

[[control]]
name = "lblCity"
type = "Label"
parent = ""
x = 332
y = 88
w = 96
h = 28

[control.props]
Text = "City"

[[control]]
name = "txtCity"
type = "TextBox"
parent = ""
x = 432
y = 88
w = 220
h = 28
bind = "City"

[[control]]
name = "lblCountry"
type = "Label"
parent = ""
x = 668
y = 88
w = 96
h = 28

[control.props]
Text = "Country"

[[control]]
name = "txtCountry"
type = "TextBox"
parent = ""
x = 768
y = 88
w = 200
h = 28
anchor = "left top right"
bind = "Country"

[[control]]
name = "lblTier"
type = "Label"
parent = ""
x = 332
y = 124
w = 96
h = 28

[control.props]
Text = "Tier"

[[control]]
name = "cboTier"
type = "ComboBox"
parent = ""
x = 432
y = 124
w = 220
h = 28
bind = "Tier"
required = true
items_source = "orderdb.Tiers( )"
item_type = "orderdb.Choice"
display_field = "Name"
value_field = "Name"

[[control]]
name = "lblSince"
type = "Label"
parent = ""
x = 668
y = 124
w = 96
h = 28

[control.props]
Text = "Customer since"

[[control]]
name = "dtpSince"
type = "DatePicker"
parent = ""
x = 768
y = 124
w = 200
h = 28
bind = "Since"

[control.props]
AllowEmpty = true

[[control]]
name = "lblCredit"
type = "Label"
parent = ""
x = 332
y = 160
w = 96
h = 28

[control.props]
Text = "Credit limit"

[[control]]
name = "nudCredit"
type = "NumericUpDown"
parent = ""
x = 432
y = 160
w = 220
h = 28
bind = "CreditLimit"

[control.props]
Range = "0,100000"
Increment = 500.0
DecimalPlaces = 0

[[control]]
name = "lblRating"
type = "Label"
parent = ""
x = 668
y = 160
w = 96
h = 28

[control.props]
Text = "Rating"

[[control]]
name = "rtgRating"
type = "Rating"
parent = ""
x = 768
y = 160
w = 160
h = 28
bind = "Rating"

[control.props]
ItemCount = 5
AllowClear = true

[[control]]
name = "chkActive"
type = "CheckBox"
parent = ""
x = 432
y = 196
w = 220
h = 28
bind = "Active"

[control.props]
Text = "Active customer"

[[control]]
name = "lblNotes"
type = "Label"
parent = ""
x = 332
y = 232
w = 96
h = 28

[control.props]
Text = "Notes"

[[control]]
name = "txtNotes"
type = "TextBox"
parent = ""
x = 432
y = 232
w = 536
h = 28
anchor = "left top right"
bind = "Notes"

[[control]]
name = "btnSave"
type = "Button"
parent = ""
x = 432
y = 276
w = 110
h = 32

[control.props]
Text = "Save"
Default = true

[control.events]
Click = "btnSave_Click"

[[control]]
name = "btnRevert"
type = "Button"
parent = ""
x = 550
y = 276
w = 110
h = 32

[control.props]
Text = "Revert"

[control.events]
Click = "btnRevert_Click"

[[control]]
name = "lblOrders"
type = "Label"
parent = ""
x = 332
y = 324
w = 300
h = 28

[control.props]
Text = "Orders of this customer (double-click one to open it)"

[[control]]
name = "grdOrders"
type = "DataGrid"
parent = ""
x = 332
y = 356
w = 636
h = 170
anchor = "left top right bottom"
items_field = "Orders"
item_type = "orderdb.Order"

[control.props]
ReadOnly = true
AlternateRows = true
SelectionUnit = "Row"
ShowFooter = true
AllowDeleteRows = false

[control.events]
CellActivate = "grdOrders_CellActivate"
CellFormatting = "grdOrders_CellFormatting"
SummaryFormatting = "grdOrders_SummaryFormatting"

[[control.items]]
text = "Order"
width = 70
kind = "number"
field = "Id"
summary = "count"

[[control.items]]
text = "Date"
width = 100
kind = "date"
field = "OrderDate"

[[control.items]]
text = "Status"
width = 100
field = "Status"

[[control.items]]
text = "Shipped"
width = 70
kind = "check"
field = "Shipped"

[[control.items]]
text = "Total"
width = 100
kind = "number"
field = "Amount"
summary = "sum"

[[control.items]]
text = "Notes"
width = 170
field = "Notes"

[[control]]
name = "btnNewOrder"
type = "Button"
parent = ""
x = 332
y = 534
w = 120
h = 32
anchor = "left bottom"

[control.props]
Text = "New order"

[control.events]
Click = "btnNewOrder_Click"

[[control]]
name = "btnOpenOrder"
type = "Button"
parent = ""
x = 460
y = 534
w = 120
h = 32
anchor = "left bottom"

[control.props]
Text = "Open order"

[control.events]
Click = "btnOpenOrder_Click"

[[control]]
name = "btnSalesReport"
type = "Button"
parent = ""
x = 660
y = 534
w = 150
h = 32
anchor = "right bottom"

[control.props]
Text = "Sales report..."

[control.events]
Click = "btnSalesReport_Click"

[[control]]
name = "btnAllOrders"
type = "Button"
parent = ""
x = 818
y = 534
w = 150
h = 32
anchor = "right bottom"

[control.props]
Text = "All orders..."

[control.events]
Click = "btnAllOrders_Click"

[[control]]
name = "sbMain"
type = "StatusBar"
parent = ""
x = 0
y = 578
w = 980
h = 26
dock = "bottom"

[[control.items]]
text = "0 customers"
width = 160

[[control.items]]
text = "Ready"
stretch = true
