format = 1

[report]
title = "Invoice"
paper = "A4"
data_module = "../orderdb"

[[source]]
name = "Orders"
kind = "array"
item_type = "orderdb.Order"

  [[source.field]]
  name = "Id"
  kind = "int"

  [[source.field]]
  name = "Customer"

  [[source.field]]
  name = "OrderDate"
  kind = "date"

  [[source.field]]
  name = "Status"

  [[source.field]]
  name = "Shipped"
  kind = "bool"

  [[source.field]]
  name = "Notes"

[[source]]
name = "Lines"
kind = "array"
parent = "Orders"
relation = "Lines"
item_type = "orderdb.OrderLine"
sort = "[Product]"

  [[source.field]]
  name = "Product"

  [[source.field]]
  name = "Qty"
  kind = "int"

  [[source.field]]
  name = "UnitPrice"
  kind = "float"

[[calc]]
source = "Lines"
name = "LineTotal"
expr = "[Qty] * [UnitPrice]"

[[band]]
id = "rh"
kind = "report_header"
height = 62

[[band]]
id = "d"
kind = "detail"
source = "Orders"
height = 96

[[band]]
id = "lines"
kind = "detail_report"
parent = "d"
source = "Lines"

[[band]]
id = "lh"
kind = "report_header"
parent = "lines"
height = 22

[[band]]
id = "ld"
kind = "detail"
parent = "lines"
height = 18

[[band]]
id = "lf"
kind = "report_footer"
parent = "lines"
height = 30

[[band]]
id = "pf"
kind = "page_footer"

[[item]]
id = "company"
band = "rh"
rect = [0, 0, 300, 22]
text = "Harbour & Hill Wholesale"
font = { size = 16, bold = true }

[[item]]
id = "address"
band = "rh"
rect = [0, 24, 300, 14]
text = "12 Quay Street, Portside"
font = { size = 9 }
fore = "#666666"

[[item]]
id = "invoiceWord"
band = "rh"
rect = [300, 0, 182, 26]
text = "INVOICE"
align = "right"
font = { size = 20, bold = true }
fore = "#1F4E79"

[[item]]
id = "billToCap"
band = "d"
rect = [0, 0, 200, 12]
text = "BILL TO"
font = { size = 8, bold = true }
fore = "#666666"

[[item]]
id = "customer"
band = "d"
kind = "field"
rect = [0, 14, 280, 18]
expr = "[Customer]"
font = { size = 12, bold = true }

[[item]]
id = "invoiceNoCap"
band = "d"
rect = [300, 0, 90, 14]
text = "Invoice no."
fore = "#666666"

[[item]]
id = "invoiceNo"
band = "d"
kind = "field"
rect = [390, 0, 92, 14]
expr = "[Id]"
align = "right"

[[item]]
id = "dateCap"
band = "d"
rect = [300, 16, 90, 14]
text = "Date"
fore = "#666666"

[[item]]
id = "orderDate"
band = "d"
kind = "field"
rect = [390, 16, 92, 14]
expr = "[OrderDate]"
format = "dd/mm/yyyy"
align = "right"

[[item]]
id = "statusCap"
band = "d"
rect = [300, 32, 90, 14]
text = "Status"
fore = "#666666"

[[item]]
id = "status"
band = "d"
kind = "field"
rect = [390, 32, 92, 14]
expr = "[Status] & iif([Shipped], \", shipped\", \"\")"
align = "right"

  [[item.rule]]
  when = "[Status] = \"Cancelled\""
  fore = "#C00000"
  bold = true

[[item]]
id = "notes"
band = "d"
rect = [0, 54, 482, 14]
text = "Notes: {[Notes]}"
wrap = true
can_grow = true
font = { italic = true }
visible = "[Notes] <> \"\""

[[item]]
id = "productCap"
band = "lh"
rect = [0, 4, 240, 16]
text = "Product"
font = { bold = true }
border = "bottom"

[[item]]
id = "qtyCap"
band = "lh"
rect = [240, 4, 60, 16]
text = "Qty"
align = "right"
font = { bold = true }
border = "bottom"

[[item]]
id = "priceCap"
band = "lh"
rect = [300, 4, 90, 16]
text = "Unit price"
align = "right"
font = { bold = true }
border = "bottom"

[[item]]
id = "amountCap"
band = "lh"
rect = [390, 4, 92, 16]
text = "Amount"
align = "right"
font = { bold = true }
border = "bottom"

[[item]]
id = "product"
band = "ld"
kind = "field"
rect = [0, 2, 240, 14]
expr = "[Product]"

[[item]]
id = "qty"
band = "ld"
kind = "field"
rect = [240, 2, 60, 14]
expr = "[Qty]"
align = "right"

[[item]]
id = "price"
band = "ld"
kind = "field"
rect = [300, 2, 90, 14]
expr = "[UnitPrice]"
format = "#,##0.00"
align = "right"

[[item]]
id = "amount"
band = "ld"
kind = "field"
rect = [390, 2, 92, 14]
expr = "[LineTotal]"
format = "#,##0.00"
align = "right"

[[item]]
id = "totalCap"
band = "lf"
rect = [300, 6, 90, 16]
text = "Total"
align = "right"
font = { bold = true }

[[item]]
id = "total"
band = "lf"
kind = "field"
rect = [390, 6, 92, 16]
expr = "Sum([LineTotal])"
format = "#,##0.00"
align = "right"
font = { bold = true }
border = "top"

[[item]]
id = "printed"
band = "pf"
rect = [0, 4, 240, 14]
text = "Printed {Format(PrintDate, \"dd/mm/yyyy\")}"
font = { size = 8 }
fore = "#666666"

[[item]]
id = "pageNo"
band = "pf"
rect = [282, 4, 200, 14]
text = "Page {PageNumber} of {PageCount}"
align = "right"
font = { size = 8 }
fore = "#666666"
