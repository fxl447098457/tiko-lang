format = 1

[report]
title = "Order list"
paper = "A4"
landscape = true

[[parameter]]
name = "Filters"
default = "\"\""
prompt = "Filters"

[[source]]
name = "Orders"
kind = "grid"
grid = "frmOrders.grdAll"

  [[source.field]]
  name = "Order"
  kind = "float"

  [[source.field]]
  name = "Date"
  kind = "date"

  [[source.field]]
  name = "Customer"

  [[source.field]]
  name = "Country"

  [[source.field]]
  name = "Status"

  [[source.field]]
  name = "Shipped"
  kind = "bool"

  [[source.field]]
  name = "Total"
  kind = "float"

[[band]]
id = "rh"
kind = "report_header"
height = 66

[[band]]
id = "ph"
kind = "page_header"
height = 22
print_on_first_page = false

[[band]]
id = "d"
kind = "detail"
source = "Orders"
height = 16

[[band]]
id = "rf"
kind = "report_footer"
height = 30

[[band]]
id = "pf"
kind = "page_footer"

[[item]]
id = "title"
band = "rh"
rect = [0, 0, 400, 22]
text = "Orders"
font = { size = 16, bold = true }

[[item]]
id = "filters"
band = "rh"
rect = [0, 24, 728, 14]
text = "Filtered: {@Filters}"
fore = "#666666"
visible = "@Filters <> \"\""

[[item]]
id = "orderCap"
band = "ph"
rect = [0, 4, 60, 16]
text = "Order"
font = { bold = true }
border = "bottom"

[[item]]
id = "dateCap"
band = "ph"
rect = [60, 4, 80, 16]
text = "Date"
font = { bold = true }
border = "bottom"

[[item]]
id = "customerCap"
band = "ph"
rect = [140, 4, 230, 16]
text = "Customer"
font = { bold = true }
border = "bottom"

[[item]]
id = "countryCap"
band = "ph"
rect = [370, 4, 110, 16]
text = "Country"
font = { bold = true }
border = "bottom"

[[item]]
id = "statusCap"
band = "ph"
rect = [480, 4, 90, 16]
text = "Status"
font = { bold = true }
border = "bottom"

[[item]]
id = "shippedCap"
band = "ph"
rect = [570, 4, 60, 16]
text = "Shipped"
align = "center"
font = { bold = true }
border = "bottom"

[[item]]
id = "totalCap"
band = "ph"
rect = [630, 4, 98, 16]
text = "Total"
align = "right"
font = { bold = true }
border = "bottom"

[[item]]
id = "order"
band = "d"
kind = "field"
rect = [0, 1, 60, 14]
expr = "[Order]"
format = "0"

[[item]]
id = "date"
band = "d"
kind = "field"
rect = [60, 1, 80, 14]
expr = "[Date]"
format = "dd/mm/yyyy"

[[item]]
id = "customer"
band = "d"
kind = "field"
rect = [140, 1, 230, 14]
expr = "[Customer]"

[[item]]
id = "country"
band = "d"
kind = "field"
rect = [370, 1, 110, 14]
expr = "[Country]"

[[item]]
id = "status"
band = "d"
kind = "field"
rect = [480, 1, 90, 14]
expr = "[Status]"

[[item]]
id = "shipped"
band = "d"
kind = "check"
rect = [594, 2, 12, 12]
expr = "[Shipped]"

[[item]]
id = "total"
band = "d"
kind = "field"
rect = [630, 1, 98, 14]
expr = "[Total]"
format = "#,##0.00"
align = "right"

[[item]]
id = "count"
band = "rf"
rect = [0, 8, 400, 16]
text = "{Count()} orders"
font = { bold = true }

[[item]]
id = "sum"
band = "rf"
kind = "field"
rect = [630, 8, 98, 16]
expr = "Sum([Total])"
format = "#,##0.00"
align = "right"
font = { bold = true }
border = "top bottom"

[[item]]
id = "pageNo"
band = "pf"
rect = [528, 4, 200, 14]
text = "Page {PageNumber} of {PageCount}"
align = "right"
font = { size = 8 }
fore = "#666666"

[[item]]
id = "firstOrderCap"
band = "rh"
rect = [0, 48, 60, 16]
text = "Order"
font = { bold = true }
border = "bottom"

[[item]]
id = "firstDateCap"
band = "rh"
rect = [60, 48, 80, 16]
text = "Date"
font = { bold = true }
border = "bottom"

[[item]]
id = "firstCustomerCap"
band = "rh"
rect = [140, 48, 230, 16]
text = "Customer"
font = { bold = true }
border = "bottom"

[[item]]
id = "firstCountryCap"
band = "rh"
rect = [370, 48, 110, 16]
text = "Country"
font = { bold = true }
border = "bottom"

[[item]]
id = "firstStatusCap"
band = "rh"
rect = [480, 48, 90, 16]
text = "Status"
font = { bold = true }
border = "bottom"

[[item]]
id = "firstShippedCap"
band = "rh"
rect = [570, 48, 60, 16]
text = "Shipped"
align = "center"
font = { bold = true }
border = "bottom"

[[item]]
id = "firstTotalCap"
band = "rh"
rect = [630, 48, 98, 16]
text = "Total"
align = "right"
font = { bold = true }
border = "bottom"
