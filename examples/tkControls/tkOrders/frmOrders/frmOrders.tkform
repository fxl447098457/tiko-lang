format = 1

[form]
caption = "All orders"
width = 880
height = 538
start_position = "CenterOwner"
min_width = 640
min_height = 360

[form.events]
Load = "Form_Load"
Destroy = "Form_Destroy"

[[control]]
name = "lblHint"
type = "Label"
parent = ""
x = 12
y = 8
w = 860
h = 28
anchor = "left top right"

[control.props]
Text = "Read from SQLite as you scroll. Filter row: abc, >100, 2025-01-01..2025-06-30. Click a header to sort."

[[control]]
name = "grdAll"
type = "DataGrid"
parent = ""
x = 12
y = 44
w = 856
h = 440
anchor = "left top right bottom"

[control.props]
ReadOnly = true
AlternateRows = true
SelectionUnit = "Row"
ShowFooter = true
ShowFilterRow = true
AllowDeleteRows = false

[control.events]
CellActivate = "grdAll_CellActivate"
FilterChanged = "grdAll_FilterChanged"
CellFormatting = "grdAll_CellFormatting"
SummaryFormatting = "grdAll_SummaryFormatting"

[[control.items]]
text = "Order"
width = 70
kind = "number"
summary = "count"

[[control.items]]
text = "Date"
width = 100
kind = "date"

[[control.items]]
text = "Customer"
width = 220

[[control.items]]
text = "Country"
width = 110

[[control.items]]
text = "Status"
width = 100

[[control.items]]
text = "Shipped"
width = 70
kind = "check"

[[control.items]]
text = "Total"
width = 110
kind = "number"
summary = "sum"

[[control]]
name = "btnOpen"
type = "Button"
parent = ""
x = 12
y = 494
w = 120
h = 32
anchor = "left bottom"

[control.props]
Text = "Open order"

[control.events]
Click = "btnOpen_Click"

[[control]]
name = "btnClearFilters"
type = "Button"
parent = ""
x = 140
y = 494
w = 130
h = 32
anchor = "left bottom"

[control.props]
Text = "Clear filters"

[control.events]
Click = "btnClearFilters_Click"

[[control]]
name = "lblCount"
type = "Label"
parent = ""
x = 280
y = 496
w = 330
h = 28
anchor = "left bottom"

[control.props]
Text = ""

[[control]]
name = "btnPrintList"
type = "Button"
parent = ""
x = 620
y = 494
w = 120
h = 32
anchor = "right bottom"

[control.props]
Text = "Print list..."

[control.events]
Click = "btnPrintList_Click"

[[control]]
name = "btnClose"
type = "Button"
parent = ""
x = 748
y = 494
w = 120
h = 32
anchor = "right bottom"

[control.props]
Text = "Close"

[control.events]
Click = "btnClose_Click"
