format = 1

[form]
caption = "Order"
width = 644
height = 484
start_position = "CenterOwner"
min_width = 560
min_height = 420
data_type = "orderdb.Order"
data_module = "../orderdb"

[[control]]
name = "lblCustomerCap"
type = "Label"
parent = ""
x = 12
y = 12
w = 96
h = 28

[control.props]
Text = "Customer"

[[control]]
name = "lblCustomer"
type = "Label"
parent = ""
x = 112
y = 12
w = 520
h = 28
bind = "Customer"

[control.props]
Text = ""

[[control]]
name = "lblDate"
type = "Label"
parent = ""
x = 12
y = 48
w = 96
h = 28

[control.props]
Text = "Order date"

[[control]]
name = "dtpDate"
type = "DatePicker"
parent = ""
x = 112
y = 48
w = 200
h = 28
bind = "OrderDate"

[[control]]
name = "lblStatus"
type = "Label"
parent = ""
x = 344
y = 48
w = 80
h = 28

[control.props]
Text = "Status"

[[control]]
name = "cboStatus"
type = "ComboBox"
parent = ""
x = 432
y = 48
w = 200
h = 28
bind = "Status"
required = true
items_source = "orderdb.Statuses( )"
item_type = "orderdb.Choice"
display_field = "Name"
value_field = "Name"

[[control]]
name = "chkShipped"
type = "CheckBox"
parent = ""
x = 112
y = 84
w = 200
h = 28
bind = "Shipped"

[control.props]
Text = "Shipped"

[[control]]
name = "lblNotes"
type = "Label"
parent = ""
x = 12
y = 120
w = 96
h = 28

[control.props]
Text = "Notes"

[[control]]
name = "txtNotes"
type = "TextBox"
parent = ""
x = 112
y = 120
w = 520
h = 28
anchor = "left top right"
bind = "Notes"

[[control]]
name = "grdLines"
type = "DataGrid"
parent = ""
x = 12
y = 160
w = 620
h = 220
anchor = "left top right bottom"
items_field = "Lines"
item_type = "orderdb.OrderLine"
items_live = true

[control.props]
AlternateRows = true
ShowFooter = true
AllowAddRows = false
AllowDeleteRows = true

[control.events]
CellFormatting = "grdLines_CellFormatting"
SummaryFormatting = "grdLines_SummaryFormatting"

[[control.items]]
text = "Product"
width = 250
field = "Product"
read_only = true

[[control.items]]
text = "Qty"
width = 70
kind = "number"
field = "Qty"
summary = "sum"

[[control.items]]
text = "Unit price"
width = 100
kind = "number"
field = "UnitPrice"

[[control.items]]
text = "Total"
width = 110
kind = "number"
field = "Total( )"
summary = "sum"

[[control]]
name = "lblAdd"
type = "Label"
parent = ""
x = 12
y = 392
w = 96
h = 28
anchor = "left bottom"

[control.props]
Text = "Add"

[[control]]
name = "cboProduct"
type = "ComboBox"
parent = ""
x = 112
y = 392
w = 260
h = 28
anchor = "left bottom"
items_source = "Products"
item_type = "orderdb.Product"
display_field = "Name"
value_field = "Id"

[control.props]
PlaceholderText = "Pick a product"

[[control]]
name = "nudQty"
type = "NumericUpDown"
parent = ""
x = 380
y = 392
w = 90
h = 28
anchor = "left bottom"

[control.props]
Range = "1,999"
Value = 1.0
DecimalPlaces = 0

[[control]]
name = "btnAddLine"
type = "Button"
parent = ""
x = 478
y = 390
w = 110
h = 32
anchor = "left bottom"

[control.props]
Text = "Add line"

[control.events]
Click = "btnAddLine_Click"

[[control]]
name = "btnPrint"
type = "Button"
parent = ""
x = 12
y = 440
w = 110
h = 32
anchor = "left bottom"

[control.props]
Text = "Invoice..."

[control.events]
Click = "btnPrint_Click"

[[control]]
name = "btnOK"
type = "Button"
parent = ""
x = 392
y = 440
w = 110
h = 32
anchor = "right bottom"

[control.props]
Text = "OK"
Default = true

[control.events]
Click = "btnOK_Click"

[[control]]
name = "btnCancel"
type = "Button"
parent = ""
x = 522
y = 440
w = 110
h = 32
anchor = "right bottom"

[control.props]
Text = "Cancel"

[control.events]
Click = "btnCancel_Click"
