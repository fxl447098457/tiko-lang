function Form.LoadFrom( byref r as orderdb.Order ) as boolean
    dim as TKBIND_ERRORS bindErrors_
    tkLabel_SetText( lblCustomer.Handle, tkBind_Text( r.Customer ) )
    tkDatePicker_SetDateValue( dtpDate.Handle, tkBind_Date( r.OrderDate ) )
    tkBind_Loaded( bindErrors_, dtpDate.Handle, "OrderDate", r.OrderDate, tkDatePicker_GetDateValue( dtpDate.Handle ) )
    tkComboBox_SetCurSel( cboStatus.Handle, tkBind_IndexOf( cboStatus_Values_, tkBind_Text( r.Status ) ) )
    tkBind_LoadedPick( bindErrors_, cboStatus.Handle, "Status", tkBind_Text( r.Status ), tkComboBox_GetCurSel( cboStatus.Handle ) )
    tkCheckBox_SetChecked( chkShipped.Handle, tkBind_Bool( r.Shipped ) )
    tkTextBox_SetText( txtNotes.Handle, tkBind_Text( r.Notes ) )
    tkTextBox_SetError( txtNotes.Handle, false )
    scope
        dim byref as Array( of orderdb.OrderLine ) a_ = r.Lines
        dim as TKDATAGRID_SOURCE src_
        src_.pCtx = @a_
        src_.RowCount = @Live_grdLines_Count
        src_.GetCell = @Live_grdLines_Get
        src_.SetCell = @Live_grdLines_Set
        src_.InsertRows = @Live_grdLines_Insert
        src_.DeleteRows = @Live_grdLines_Delete
        tkDataGrid_SetSource( grdLines.Handle, @src_ )
    end scope
    if bindErrors_.Count then
        dim as boolean bindHandled_ = false
        if bindHandled_ = false then tkBind_ShowErrors( Handle, bindErrors_, true )
        return false
    end if
    return true
end function

function Form.SaveTo( byref r as orderdb.Order ) as boolean
    dim as TKBIND_ERRORS bindErrors_
    if tkDataGrid_EndEdit( grdLines.Handle, true ) = false then return false
    tkBind_Check( bindErrors_, dtpDate.Handle, "OrderDate", r.OrderDate, tkDatePicker_GetDateValue( dtpDate.Handle ), tkBind_Rule( false, "", "", 0, "" ) )
    tkBind_CheckPick( bindErrors_, cboStatus.Handle, "Status", r.Status, cboStatus_Values_, tkComboBox_GetCurSel( cboStatus.Handle ), tkBind_Rule( true, "", "", 0, "", true, -1 ) )
    tkBind_Check( bindErrors_, txtNotes.Handle, "Notes", r.Notes, tkTextBox_GetText( txtNotes.Handle ), tkBind_Rule( false, "", "", 0, "" ) )
    tkTextBox_SetError( txtNotes.Handle, bindErrors_.Has( txtNotes.Handle ) )
    if bindErrors_.Count then
        dim as boolean bindHandled_ = false
        if bindHandled_ = false then tkBind_ShowErrors( Handle, bindErrors_, false )
        return false
    end if
    tkBind_Put( r.OrderDate, tkDatePicker_GetDateValue( dtpDate.Handle ) )
    tkBind_PutPick( r.Status, cboStatus_Values_, tkComboBox_GetCurSel( cboStatus.Handle ) )
    tkBind_Put( r.Shipped, tkCheckBox_GetChecked( chkShipped.Handle ) )
    tkBind_Put( r.Notes, tkTextBox_GetText( txtNotes.Handle ) )
    scope
        dim byref as Array( of orderdb.OrderLine ) a_ = r.Lines
        if tkDataGrid_GetSourceContext( grdLines.Handle ) <> cptr( any ptr, @a_ ) then
            dim as int32 n_ = tkDataGrid_GetRowCount( grdLines.Handle )
            if a_.Count( ) > n_ then a_.SetCount( n_ )
            while a_.Count( ) < n_
                dim as orderdb.OrderLine new_
                a_.Push( new_ )
            wend
            for i_ as int32 = 0 to n_ - 1
                tkBind_Put( a_[i_].Product, tkDataGrid_GetCellText( grdLines.Handle, i_, 0 ) )
                tkBind_Put( a_[i_].Qty, tkDataGrid_GetCellFloat( grdLines.Handle, i_, 1 ) )
                tkBind_Put( a_[i_].UnitPrice, tkDataGrid_GetCellFloat( grdLines.Handle, i_, 2 ) )
            next
        end if
    end scope
    return true
end function

sub Form.cboStatus_Fill( )
    scope
        dim as Array( of orderdb.Choice ) a_ = orderdb.Statuses( )
        tkComboBox_Clear( cboStatus.Handle )
        cboStatus_Values_.Clear( )
        for i_ as int32 = 0 to a_.Count( ) - 1
            tkComboBox_AddItem( cboStatus.Handle, tkBind_Text( a_[i_].Name ) )
            cboStatus_Values_.Push( tkBind_Text( a_[i_].Name ) )
        next
    end scope
end sub

function Form.grdLines_Item( ) as int32
    dim as integer r_, c_
    if tkDataGrid_GetCurrentCell( grdLines.Handle, r_, c_ ) = false then return -1
    if r_ >= tkDataGrid_GetRowCount( grdLines.Handle ) then return -1
    return r_
end function

sub Form.cboProduct_Fill( )
    scope
        dim byref as Array( of orderdb.Product ) a_ = Products
        tkComboBox_Clear( cboProduct.Handle )
        cboProduct_Values_.Clear( )
        for i_ as int32 = 0 to a_.Count( ) - 1
            tkComboBox_AddItem( cboProduct.Handle, tkBind_Text( a_[i_].Name ) )
            cboProduct_Values_.Push( tkBind_Text( a_[i_].Id ) )
        next
    end scope
end sub
