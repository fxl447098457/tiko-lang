private function Live_grdLines_Count( byval p_ as any ptr ) as integer
    return cptr( Array( of orderdb.OrderLine ) ptr, p_ )->Count( )
end function

private sub Live_grdLines_Get( byval p_ as any ptr, byval row_ as integer, byval col_ as integer, byref v_ as TKDG_VALUE )
    dim byref as Array( of orderdb.OrderLine ) a_ = *cptr( Array( of orderdb.OrderLine ) ptr, p_ )
    select case col_
    case 0 : v_.SetText( tkBind_Text( a_[row_].Product ) )
    case 1 : v_.SetFloat( tkBind_Float( a_[row_].Qty ) )
    case 2 : v_.SetFloat( tkBind_Float( a_[row_].UnitPrice ) )
    case 3 : v_.SetFloat( tkBind_Float( a_[row_].Total( ) ) )
    end select
end sub

private function Live_grdLines_Set( byval p_ as any ptr, byval row_ as integer, byval col_ as integer, byref v_ as TKDG_VALUE ) as boolean
    dim byref as Array( of orderdb.OrderLine ) a_ = *cptr( Array( of orderdb.OrderLine ) ptr, p_ )
    select case col_
    case 0 : tkBind_Put( a_[row_].Product, v_.s )
    case 1 : tkBind_Put( a_[row_].Qty, v_.f )
    case 2 : tkBind_Put( a_[row_].UnitPrice, v_.f )
    case else : return false
    end select
    return true
end function

private function Live_grdLines_Insert( byval p_ as any ptr, byval row_ as integer, byval n_ as integer ) as boolean
    dim byref as Array( of orderdb.OrderLine ) a_ = *cptr( Array( of orderdb.OrderLine ) ptr, p_ )
    for j_ as integer = 1 to n_
        dim as orderdb.OrderLine new_
        a_.Insert( row_, new_ )
    next
    return true
end function

private function Live_grdLines_Delete( byval p_ as any ptr, byval row_ as integer, byval n_ as integer ) as boolean
    dim byref as Array( of orderdb.OrderLine ) a_ = *cptr( Array( of orderdb.OrderLine ) ptr, p_ )
    for j_ as integer = 1 to n_
        a_.Remove( row_ )
    next
    return true
end function

