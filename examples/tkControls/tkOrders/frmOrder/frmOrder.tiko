' The half of the form you write. The rest is frmOrder.design.tiko, generated from
' frmOrder.tkform: don't edit that one.
'
' One order (DataType orderdb.Order). Its lines are a LIVE grid (ItemsField Lines, ItemsLive): the
' grid reads and writes Ord.Lines itself, so a Qty or price typed in a cell is in the array at once,
' a deleted row (Delete key) is gone from it, and the Total( ) column -- a method of OrderLine, not a
' field -- and the footer's sums follow. The header boxes are bound as usual: LoadFrom / SaveTo.
'
' The caller calls Edit( order ), shows it with ShowModal, and when that returns 1 (OK) saves Ord.
' Invoice... shows the order as it is on screen, printed by the designed report rptInvoice.
#module "frmOrder"

#import "std/containers"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkMessageBox"
#import "vendor/tkControls/tkDataGrid"
#import "../askbox"
#import "../orderdb"
#import "../frmInvoice"
using containers
using tkApp
using tkMessageBox
using tkDataGrid

public partial type Form
    Ord as orderdb.Order                         ' what the dialog shows; after OK, what was typed
    Products as Array( of orderdb.Product )      ' cboProduct's items (its ItemsSource)
    declare sub Edit( byref o as orderdb.Order )
    declare function Collect( ) as boolean
    declare function AddProduct( byval i as int32, byval qty as int32 ) as boolean
end type

' Fill the dialog from o.
sub Form.Edit( byref o as orderdb.Order )
    if Products.Count( ) = 0 then orderdb.LoadProducts( Products )
    cboStatus_Fill( )                            ' generated: from orderdb.Statuses( )
    cboProduct_Fill( )                           ' generated: from Products, the value each one's Id
    Ord = o
    LoadFrom( Ord )                              ' the live grid binds Ord.Lines itself
    cboProduct.SelectedIndex = -1
    nudQty.Value = 1
end sub

' The header boxes into Ord (the lines are there already). False when a box can't be saved (SaveTo
' has said why) or there are no lines.
function Form.Collect( ) as boolean
    if SaveTo( Ord ) = false then return false
    if Ord.Lines.Count( ) = 0 then
        askbox.Ask( Handle, "An order needs at least one line: pick a product and press Add line.", "Order", MBX_ICON_INFO, MBX_BTN_OK )
        return false
    end if
    return true
end function

' Products[i], qty more of it: a new line, or more on the line that has it already.
function Form.AddProduct( byval i as int32, byval qty as int32 ) as boolean
    if (i < 0) orelse (i >= Products.Count( )) orelse (qty <= 0) then return false
    if SaveTo( Ord ) = false then return false   ' what was typed in the boxes, kept through the LoadFrom below
    dim byref as orderdb.Product p = Products[i]
    dim as boolean found = false
    for k as int32 = 0 to Ord.Lines.Count( ) - 1
        if Ord.Lines[k].ProductId = p.Id then
            Ord.Lines[k].Qty += qty
            found = true
            exit for
        end if
    next
    if found = false then
        dim as orderdb.OrderLine l
        l.ProductId = p.Id
        l.Product = p.Name
        l.Qty = qty
        l.UnitPrice = p.Price
        Ord.Lines.Push( l )
    end if
    LoadFrom( Ord )
    return true
end function

sub Form.btnAddLine_Click( )
    dim as int32 i = cboProduct.SelectedIndex
    if i < 0 then
        askbox.Ask( Handle, "Pick a product to add.", "Order", MBX_ICON_INFO, MBX_BTN_OK )
        exit sub
    end if
    AddProduct( i, clng( nudQty.Value ) )
end sub

sub Form.btnOK_Click( )
    if Collect( ) then EndModal( 1 )
end sub

' The order as the dialog shows it -- the boxes saved into a copy, the lines as they are -- in the
' invoice window (frmInvoice, a ReportViewer showing rptInvoice). Nothing is saved to the database.
sub Form.btnPrint_Click( )
    dim as orderdb.Order o = Ord
    if SaveTo( o ) = false then exit sub
    dim as frmInvoice.Form f
    f.Build( Handle )
    f.ShowOrder( o )
    f.ShowModal( Handle )
end sub

sub Form.btnCancel_Click( )
    EndModal( 0 )
end sub

' Amounts with two decimals: the grid shows a float64 as it is (147.4), this makes it 147.40.
sub Form.grdLines_CellFormatting( byval p as TKDATAGRID_FORMATINFO ptr )
    if ((p->col = 2) orelse (p->col = 3)) andalso (p->value->kind = TKDG_FLOAT) then p->text = orderdb.Money( p->value->f )
end sub

' The footer's sums likewise.
sub Form.grdLines_SummaryFormatting( byval col as integer, byval kind as int32, byref v as TKDG_VALUE, byref text as ustring )
    if ((col = 2) orelse (col = 3)) andalso (v.kind = TKDG_FLOAT) then text = orderdb.Money( v.f )
end sub
