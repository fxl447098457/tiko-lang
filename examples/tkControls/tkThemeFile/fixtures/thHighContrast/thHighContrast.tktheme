format = 1
name = "High Contrast"

[dark]
Window = "#000000"
Surface = "#000000"
SurfaceHot = "#303030"
SurfaceDisabled = "#000000"
Text = "#FFFFFF"
TextHot = "#FFFFFF"
TextStrong = "#FFFFFF"
TextDim = "#E6E6E6"
TextDisabled = "#A0A0A0"
Accent = "#FFD400"
AccentHot = "#FFE866"
FocusRing = "#FFD400"
Border = "#FFFFFF"
BorderDisabled = "#808080"
Divider = "#FFFFFF"
Selected = "#1AEBFF"
SelectedText = "#000000"
Popup = "#000000"
PopupText = "#FFFFFF"
Track = "#404040"
Success = "#3FF23F"
Warning = "#FFD400"
Error = "#FF6B6B"

[dark.editor]
bg = "#000000"
fg = "#ffffff"
caret = "#ffffff"
caret_line = "#1a1a1a"
selection = "#264f78"
gutter = "#000000"
gutter_fg = "#ffffff"
fold = "#000000"
indent_guide = "#808080"
brace = "#4a4a00"
find_match = "#7a5c00"
error = "#ff6b6b"
warning = "#ffd400"
bookmark = "#1aebff"
breakpoint = "#ff3030"
exec_line = "#ffd400"
exec_line_bg = "#4a4a00"

[dark.syntax]
default = "#ffffff"
comment = { fg = "#7cfc00", italic = true }
number = "#ffd400"
keyword = "#1aebff"
keyword2 = "#ff8cff"
keyword3 = "#ffe866"
keyword4 = "#9cdcfe"
string = "#ff9e64"
preprocessor = "#ff8cff"
operator = "#ffffff"
identifier = "#ffffff"

[light]
Window = "#FFFFFF"
Surface = "#FFFFFF"
SurfaceHot = "#E0E0E0"
SurfaceDisabled = "#FFFFFF"
Text = "#000000"
TextHot = "#000000"
TextStrong = "#000000"
TextDim = "#1A1A1A"
TextDisabled = "#6B6B6B"
Accent = "#0000C0"
AccentHot = "#000080"
FocusRing = "#0000C0"
Border = "#000000"
BorderDisabled = "#808080"
Divider = "#000000"
Selected = "#0000C0"
SelectedText = "#FFFFFF"
Popup = "#FFFFFF"
PopupText = "#000000"
Track = "#C0C0C0"
Success = "#006400"
Warning = "#8A5A00"
Error = "#B00000"

[light.editor]
bg = "#ffffff"
fg = "#000000"
caret = "#000000"
caret_line = "#e8e8e8"
selection = "#9ec9ff"
gutter = "#ffffff"
gutter_fg = "#000000"
fold = "#ffffff"
indent_guide = "#808080"
brace = "#ffe066"
find_match = "#ffc966"
error = "#b00000"
warning = "#8a5a00"
bookmark = "#0000c0"
breakpoint = "#b00000"
exec_line = "#8a5a00"
exec_line_bg = "#ffe066"

[light.syntax]
default = "#000000"
comment = { fg = "#006400", italic = true }
number = "#8a0000"
keyword = "#0000c0"
keyword2 = "#005a5a"
keyword3 = "#5a3c00"
keyword4 = "#00007a"
string = "#a00000"
preprocessor = "#7a007a"
operator = "#000000"
identifier = "#000000"

[shape]
BorderWidth = 2

[controls.Button]
BorderColor = "@Border"
