format = 1
name = "Mixed"
accent = "#8E24AA"

[dark]
accent = "#BA68C8"
Window = "#101418"
Text = "#F0F0F0"

[light]
Surface = "#FAFAFAF0"

[shape]
BorderWidth = 2

[controls.Label]
TextColor = { dark = "#E0E0E0", light = "#202020" }
BackColor = "#00000000"

[controls.Button]
ForeColor = "@Accent"
BackColorHot = "#3949AB"

[controls.CheckBox]
BoxColorChecked = "@Accent"

[styles.Ghost]
Surface = "@Window"
Border = "@Accent"
Accent = { dark = "#FF8A80", light = "#C62828" }

[styles.Ghost.Label]
TextColor = "@Accent"
