format = 1
name = "Ocean"
accent = "#1E88E5"

[dark]
Surface = "#2A2F3A"

[dark.editor]
caret = "#AEAFAD"

[dark.syntax]
comment = { fg = "#6A9955", italic = true }

[light]
accent = "#1565C0"

[fonts]
ui = { file = "Inter-Regular.ttf", bold = "Inter-Bold.ttf", size = 10 }
glyph = { file = "FluentSystemIcons-Regular.ttf" }
mono = { file = "CascadiaMono-Regular.ttf" }

[shape]
CornerRadius = 4
BorderWidth = 1

[controls.Button]
BorderColor = "@Border"

[styles.Primary]
Surface = "@Accent"
Text = "@SelectedText"

[styles.Danger]
Surface = "@Error"
Text = "@SelectedText"
Accent = "@Error"

[styles.Danger.Button]
BorderColor = "#B71C1C"
