format = 1
name = "Default"

[dark]

[dark.editor]
bg = "#1e1e1e"
fg = "#d4d4d4"
caret = "#aeafad"
caret_line = "#2a2d2e"
selection = "#264f78"
gutter = "#1e1e1e"
gutter_fg = "#858585"
fold = "#1e1e1e"
indent_guide = "#404040"
brace = "#515c6a"
find_match = "#623315"
error = "#f14c4c"
warning = "#cca700"
bookmark = "#0e639c"
breakpoint = "#e51400"
exec_line = "#ffcc00"
exec_line_bg = "#4b4b18"

[dark.syntax]
default = "#d4d4d4"
comment = { fg = "#6a9955", italic = true }
number = "#b5cea8"
keyword = "#569cd6"
keyword2 = "#4ec9b0"
keyword3 = "#dcdcaa"
keyword4 = "#9cdcfe"
string = "#ce9178"
preprocessor = "#c586c0"
operator = "#d4d4d4"
identifier = "#d4d4d4"

[light]

[light.editor]
bg = "#ffffff"
fg = "#1f1f1f"
caret = "#000000"
caret_line = "#f2f6fa"
selection = "#add6ff"
gutter = "#ffffff"
gutter_fg = "#6e7681"
fold = "#ffffff"
indent_guide = "#d3d3d3"
brace = "#b9d7f0"
find_match = "#f8c9a0"
error = "#e51400"
warning = "#bf8803"
bookmark = "#005fb8"
breakpoint = "#e51400"
exec_line = "#be9b00"
exec_line_bg = "#fff4bf"

[light.syntax]
default = "#1f1f1f"
comment = { fg = "#008000", italic = true }
number = "#098658"
keyword = "#0000ff"
keyword2 = "#267f99"
keyword3 = "#795e26"
keyword4 = "#001080"
string = "#a31515"
preprocessor = "#af00db"
operator = "#1f1f1f"
identifier = "#1f1f1f"
