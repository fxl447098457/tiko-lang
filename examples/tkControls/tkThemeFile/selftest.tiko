' tkThemeFile self-test (docs/tkDesigner/THEMES.md, TH8): tkTheme_Load of a .tktheme installs what
' the module the Form Designer generates from the same file installs -- both variants, the shape,
' the styles, the per-type recipes and the fonts -- for every theme tkEdit ships, the designer's
' golden, the sample's and a Mixed one (pairs, alpha, ink parts, a grouped field, a style with a pair
' and a type block). fixtures/ holds each theme and its generated module; tkEdit's designall keeps
' them current (designall --accept rewrites them). Then: a loaded theme reaches a control, a bad
' file leaves the theme alone and says why, and a value the reader can't use is skipped and noted.
'
'   selftest            exit code = number of failures
#import "std/fs"
#import "vendor/tkControls/tkThemeFile"
#import "vendor/tkControls/tkButton"
#import "vendor/tkControls/tkTest"
#import "./fixtures/thDefault"
#import "./fixtures/thHighContrast"
#import "./fixtures/thOcean"
#import "./fixtures/thForest"
#import "./fixtures/thEmber"
#import "./fixtures/thViolet"
#import "./fixtures/thGolden"
#import "./fixtures/thSample"
#import "./fixtures/thMixed"
using tkThemeFile
using tkApp
using tkButton
using tkTheme
using tkTest
using tkHost
using tkPaint

' What a theme leaves installed: copies, since the tables are borrowed.
type Installed
    Dark as TKTHEME_COLORS
    Light as TKTHEME_COLORS
    Shape as TKTHEME_SHAPE
    Styles( any ) as TKTHEME_STYLE
    nStyles as long
    Types( any ) as TKTHEME_TYPERECIPE
    Src( any ) as TKCOLOR_SRC              ' each type's entries, one run after another
    nTypes as long
    nSrc as long
    Opt as TKAPP_OPTIONS
end type

sub Snapshot( byref s as Installed )
    s.Dark = tkApp_ThemeDark( )
    s.Light = tkApp_ThemeLight( )
    s.Shape = tkTheme_GetShape( )
    dim as TKTHEME_STYLE ptr ps = tkTheme_GetStyles( s.nStyles )
    erase s.Styles
    if s.nStyles then
        redim s.Styles( 0 to s.nStyles - 1 )
        for i as long = 0 to s.nStyles - 1
            s.Styles( i ) = ps[i]
        next
    end if
    dim as TKTHEME_TYPERECIPE ptr pt = tkTheme_GetTypeRecipes( s.nTypes )
    erase s.Types, s.Src
    s.nSrc = 0
    if s.nTypes then
        redim s.Types( 0 to s.nTypes - 1 )
        for i as long = 0 to s.nTypes - 1
            s.Types( i ) = pt[i]
            for j as long = 0 to pt[i].n - 1
                redim preserve s.Src( 0 to s.nSrc )
                s.Src( s.nSrc ) = pt[i].pSrc[j]
                s.nSrc += 1
            next
        next
    end if
end sub

function SameSrc( byref a as TKCOLOR_SRC, byref b as TKCOLOR_SRC ) as boolean
    return (a.slot = b.slot) andalso (a.kind = b.kind) andalso (a.arg = b.arg) andalso (a.value = b.value) andalso (a.value2 = b.value2)
end function

' "" when they match, else what differs first.
function SameColors( byref a as TKTHEME_COLORS, byref b as TKTHEME_COLORS ) as string
    if a.IsDark <> b.IsDark then return "IsDark"
    for r as long = 0 to TKROLE_COUNT - 1
        if tkTheme_Role( a, r ) <> tkTheme_Role( b, r ) then
            return tkTheme_RoleName( r ) & " " & hex( tkTheme_Role( a, r ), 8 ) & " vs " & hex( tkTheme_Role( b, r ), 8 )
        end if
    next
    return ""
end function

function Diff( byref a as Installed, byref b as Installed ) as string
    dim as string d = SameColors( a.Dark, b.Dark )
    if len( d ) then return "dark: " & d
    d = SameColors( a.Light, b.Light )
    if len( d ) then return "light: " & d
    if (a.Shape.CornerRadius <> b.Shape.CornerRadius) orelse (a.Shape.BorderWidth <> b.Shape.BorderWidth) then return "shape"
    if a.nStyles <> b.nStyles then return "styles: " & a.nStyles & " vs " & b.nStyles
    for i as long = 0 to a.nStyles - 1
        if a.Styles( i ).Name <> b.Styles( i ).Name then return "style " & i & " name"
        for r as long = 0 to TKROLE_COUNT - 1
            if SameSrc( a.Styles( i ).remap( r ), b.Styles( i ).remap( r ) ) = false then return "style " & a.Styles( i ).Name & " remap " & tkTheme_RoleName( r )
        next
    next
    if a.nTypes <> b.nTypes then return "type recipes: " & a.nTypes & " vs " & b.nTypes
    for i as long = 0 to a.nTypes - 1
        if (a.Types( i ).TypeName <> b.Types( i ).TypeName) orelse (a.Types( i ).StyleName <> b.Types( i ).StyleName) _
           orelse (a.Types( i ).n <> b.Types( i ).n) then return "type recipe " & i & " (" & a.Types( i ).TypeName & ")"
    next
    if a.nSrc <> b.nSrc then return "entries: " & a.nSrc & " vs " & b.nSrc
    for i as long = 0 to a.nSrc - 1
        if SameSrc( a.Src( i ), b.Src( i ) ) = false then return "entry " & i
    next
    if (a.Opt.FontUIFile <> b.Opt.FontUIFile) orelse (a.Opt.FontUIBoldFile <> b.Opt.FontUIBoldFile) orelse (a.Opt.FontUISize <> b.Opt.FontUISize) _
       orelse (a.Opt.GlyphFontFile <> b.Opt.GlyphFontFile) orelse (a.Opt.FontMonoFile <> b.Opt.FontMonoFile) then return "fonts"
    return ""
end function

' Nothing installed: the presets, no shape, styles or type recipes.
sub ResetTheme( )
    tkApp_SetThemePair( tkTheme_Dark( ), tkTheme_Light( ) )
    dim as TKTHEME_SHAPE none
    tkTheme_SetShape( none )
    tkTheme_SetStyles( 0, 0 )
    tkTheme_SetTypeRecipes( 0, 0 )
end sub

#macro AGAINST( NAME_, MODULE_ )
scope
    dim as Installed gen, ld
    ResetTheme( )
    MODULE_.Install( )
    Snapshot( gen )
    MODULE_.ApplyOptions( gen.Opt )
    ResetTheme( )
    dim as boolean ok = tkTheme_Load( "fixtures/" & NAME_ & "/" & NAME_ & ".tktheme" )
    tkTest_Check( NAME_ & ": tkTheme_Load reads it", ok, tkTheme_LoadError( ) )
    if ok then
        Snapshot( ld )
        tkThemeFile_ApplyOptions( *tkTheme_Loaded( ), ld.Opt )
        dim as string d = Diff( gen, ld )
        tkTest_Check( NAME_ & ": installs what its generated module does", len( d ) = 0, d )
        dim as string p0
        if tkTheme_Loaded( )->nProblems then p0 = tkTheme_Loaded( )->Problems( 0 )
        tkTest_Check( NAME_ & ": and skips nothing", tkTheme_Loaded( )->nProblems = 0, p0 )
    end if
end scope
#endmacro

if tkTest_Init() = false then end 99
dim as TK_HOST ptr h = tkHost_Create( "tkThemeFile selftest", 480, 320, tkHost_FontDir() & TK_FONT_UI, 1 )

AGAINST( "thDefault", thDefault )
AGAINST( "thHighContrast", thHighContrast )
AGAINST( "thOcean", thOcean )
AGAINST( "thForest", thForest )
AGAINST( "thEmber", thEmber )
AGAINST( "thViolet", thViolet )
AGAINST( "thGolden", thGolden )
AGAINST( "thSample", thSample )
AGAINST( "thMixed", thMixed )

' the fixtures cover what the comparison is meant to: each kind of entry, styles, fonts
scope
    tkTest_Check( "Mixed has a pair, a fixed colour, a role and a derived entry, and a style", _
        tkTheme_Load( "fixtures/thMixed/thMixed.tktheme" ) andalso (tkTheme_Loaded( )->nStyles = 1) andalso (tkTheme_Loaded( )->nTypes = 4) )
    dim as long kinds( 0 to 7 )
    for i as long = 0 to tkTheme_Loaded( )->nSrc - 1
        kinds( tkTheme_Loaded( )->Src( i ).kind ) += 1
    next
    tkTest_Check( "every kind of entry is compared", (kinds( TKSRC_ROLE ) > 0) andalso (kinds( TKSRC_FIXED ) > 0) _
        andalso (kinds( TKSRC_FIXED2 ) > 0) andalso (kinds( TKSRC_DERIVE ) > 0) )
    tkTest_Check( "Golden has fonts", tkTheme_Load( "fixtures/thGolden/thGolden.tktheme" ) andalso (tkTheme_Loaded( )->FontUIFile = "Inter-Regular.ttf") _
        andalso (tkTheme_Loaded( )->FontUISize = 10) )
end scope

' a loaded theme reaches the controls: the variant the mode picks, a type recipe, a style
scope
    ResetTheme( )
    tkTest_Check( "Sample loads", tkTheme_Load( "fixtures/thSample/thSample.tktheme" ) )
    tkApp_SetThemeMode( TKAPP_THEME_LIGHT )
    dim as TK_WIDGET ptr b = tkButton_Create( h->root, 1 )
    dim as TK_WIDGET ptr bd = tkButton_Create( h->root, 2 )
    tkTheme_SetRecipeNamed( bd, "Danger", 0, 0 )
    dim as TKBUTTON_COLORS got
    tkButton_GetColors( b, @got )
    dim as TKTHEME_COLORS lt = tkTheme_Loaded( )->Light
    tkTest_Check( "light mode: the app wears the file's light variant", tkTheme_Equal( tkApp_Theme( ), lt ) )
    tkTest_Check( "a Button wears [controls.Button]: BorderColor = @Border", got.BorderColor = lt.Border, hex( got.BorderColor ) )
    tkButton_GetColors( bd, @got )
    tkTest_Check( "a Button wearing Danger: its face is the Error role", got.BackColor = lt.Error, hex( got.BackColor ) )
    tkApp_SetThemeMode( TKAPP_THEME_DARK )
    tkButton_GetColors( b, @got )
    tkTest_Check( "dark mode: the file's dark variant", tkTheme_Equal( tkApp_Theme( ), tkTheme_Loaded( )->Dark ) _
        andalso (got.BorderColor = tkTheme_Loaded( )->Dark.Border) )
    tkWidget_Destroy( b ) : tkWidget_Destroy( bd )
end scope

' a file that can't be used leaves the theme as it was, and says why
scope
    dim as TKTHEME_FILE ptr before = tkTheme_Loaded( )
    dim as TKTHEME_COLORS was = tkApp_Theme( )
    tkTest_Check( "a missing file fails", tkTheme_Load( "fixtures/nope.tktheme" ) = false andalso (len( tkTheme_LoadError( ) ) > 0), tkTheme_LoadError( ) )
    dim as string tmp = "out/bad.tktheme"
    fs.CreateDirAll( "out" )
    fs.WriteAllText( tmp, "format = 2" & chr( 10 ) & "name = ""x""" & chr( 10 ) )
    tkTest_Check( "format 2 fails", (tkTheme_Load( tmp ) = false) andalso (instr( tkTheme_LoadError( ), "format 2" ) > 0), tkTheme_LoadError( ) )
    fs.WriteAllText( tmp, "format = 1" & chr( 10 ) & "[dark" & chr( 10 ) )
    tkTest_Check( "not TOML fails", tkTheme_Load( tmp ) = false )
    tkTest_Check( "and the theme stays", tkTheme_Equal( tkApp_Theme( ), was ) andalso (tkTheme_Loaded( ) = before) )
    ' lenient: what it can't use is skipped and noted, the rest loads
    fs.WriteAllText( tmp, "format = 1" & chr( 10 ) & "name = ""x""" & chr( 10 ) & "[dark]" & chr( 10 ) & "Surface = ""blue""" & chr( 10 ) _
        & "Text = ""#FF0000""" & chr( 10 ) & "Surfce = ""#000000""" & chr( 10 ) & "[controls.Buttn]" & chr( 10 ) & "BackColor = ""#000000""" & chr( 10 ) )
    dim as boolean ok = tkTheme_Load( tmp )
    dim as TKTHEME_FILE ptr t = tkTheme_Loaded( )
    tkTest_Check( "a bad value is skipped, the rest loads", ok andalso (t->Dark.Text = &hFFFF0000ul) andalso (t->Dark.Surface = tkTheme_Dark( ).Surface) )
    dim as string all_
    for i as long = 0 to t->nProblems - 1
        all_ &= " [" & t->Problems( i ) & "]"
    next
    tkTest_Check( "and each is noted", (t->nProblems = 3) andalso (instr( all_, "dark.Surface: not a colour" ) > 0) _
        andalso (instr( all_, "'Surfce' is not a theme role" ) > 0) andalso (instr( all_, "'Buttn' is not a control" ) > 0), all_ )
    fs.RemoveFile( tmp )
end scope

ResetTheme( )
tkHost_Destroy( h )
dim as long nFail = tkTest_Report( "tkThemeFile" )
tkTest_Quit()
end nFail
