' tkPrintPreview demo (printing phase R1): a 24-page document, generated by the preview while it
' shows the first pages, with a contents page whose lines link to their pages.
'
'   demo                     PgUp / PgDn, Home / End, arrows, wheel, Ctrl+wheel or +/- to zoom,
'                            Ctrl+0 fit width, C one / two columns, S continuous / single view
'   demo --scale 1.75        pin the scale instead of asking the display
'   demo --shot x.png [--cols 2] [--zoom 0.6]   render once (all pages generated), save, exit
#import "vendor/tkControls/tkPrintPreview"
using tkPrintPreview
using tkPrint
using tkHost
using tkPaint

dim shared as TK_HOST ptr gHost
dim shared as TK_WIDGET ptr gPv
dim shared as TK_PRINTDOC ptr gDoc

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 32
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

function DemoPage( byval doc as TK_PRINTDOC ptr, byval pg as TK_PAGE ptr, byval i as long ) as boolean
    dim as TKRECTF m, r
    tkPage_GetMarginRect( pg, m )
    dim as TKFONTSPEC fs
    if i = 0 then
        fs.pt = 22 : fs.bold = true
        tkPage_SetFont( pg, fs )
        tkRectF_Set( r, m.left, m.top, m.right, m.top + 32 )
        tkPage_Text( pg, "Contents", r, TK_DT_LEFT )
        fs.pt = 11 : fs.bold = false
        tkPage_SetFont( pg, fs )
        tkPage_SetTextColor( pg, tkRGB( 30, 80, 170 ) )
        for k as long = 1 to 23
            dim as single y = m.top + 40 + (k - 1) * 18
            tkRectF_Set( r, m.left, y, m.left + 300, y + 16 )
            tkPage_Text( pg, "Chapter " & k, r, TK_DT_LEFT )
            tkPage_LinkToPage( pg, r, k )
        next
        tkPage_SetTextColor( pg, tkRGB( 0, 0, 0 ) )
    else
        fs.pt = 18 : fs.bold = true
        tkPage_SetFont( pg, fs )
        tkRectF_Set( r, m.left, m.top, m.right, m.top + 28 )
        tkPage_Text( pg, "Chapter " & i, r, TK_DT_LEFT )
        fs.pt = 10 : fs.bold = false
        tkPage_SetFont( pg, fs )
        tkRectF_Set( r, m.left, m.top + 40, m.right, m.bottom - 30 )
        dim as ustring body
        for k as long = 1 to 12
            body &= "Paragraph " & k & " of chapter " & i & ": the page is recorded once and replayed at the zoom " & _
                    "in force, from a texture until the zoom changes. " & chr( 10 )
        next
        tkPage_Text( pg, body, r, TK_DT_WORDBREAK )
    end if
    fs.pt = 8 : fs.bold = false
    tkPage_SetFont( pg, fs )
    tkRectF_Set( r, m.left, m.bottom - 14, m.right, m.bottom )
    tkPage_LateText( pg, r, "Page {p} of {n}", TK_DT_RIGHT )
    return i < 23
end function

sub Form_Size( byval h as TK_HOST ptr )
    dim as long pw, ph
    tkHost_PixelSize( h, pw, ph )
    tkWidget_SetPos( gPv, 0, 0, pw, ph )
end sub

function Form_Key( byval h as TK_HOST ptr, byval m as TK_MSG ptr ) as boolean
    select case m->key
    case SDLK_C : tkPrintPreview_SetColumns( gPv, 3 - tkPrintPreview_GetColumns( gPv ) )
    case SDLK_S : tkPrintPreview_SetViewMode( gPv, 1 - tkPrintPreview_GetViewMode( gPv ) )
    case else : return false
    end select
    return true
end function

if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
gHost = tkHost_Create( "tkPrintPreview R1 demo", 900, 1000, tkHost_FontDir() & TK_FONT_UI, val( ArgValue( "--scale" ) ) )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
gDoc = tkPrintDoc_Create( "demo" )
tkPrintDoc_SetPrintPageCallback( gDoc, @DemoPage )
tkPrintDoc_BeginGenerate( gDoc )                ' the preview makes the pages
gPv = tkPrintPreview_Create( tkHost_Root( gHost ), 1 )
tkPrintPreview_SetDocument( gPv, gDoc )
gHost->OnSize = @Form_Size
gHost->OnPreKey = @Form_Key
Form_Size( gHost )
tkHost_SetFocus( gHost, gPv )
tkHost_Show( gHost )
dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    if val( ArgValue( "--cols" ) ) > 0 then tkPrintPreview_SetColumns( gPv, val( ArgValue( "--cols" ) ) )
    if val( ArgValue( "--zoom" ) ) > 0 then tkPrintPreview_SetZoom( gPv, val( ArgValue( "--zoom" ) ) )
    dim as Uint64 t0 = SDL_GetTicks()
    while (tkPrintDoc_IsComplete( gDoc ) = false) andalso (SDL_GetTicks() - t0 < 10000)
        tkHost_Pump( gHost )
        SDL_Delay( 5 )
    wend
    tkHost_RenderTo( gHost, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( gHost->renderer, 0 )
    if s then IMG_SavePNG( s, strptr( shot ) ) : SDL_DestroySurface( s )
    print "pages " & tkPrintPreview_GetPageCount( gPv ) & "  zoom " & tkPrintPreview_GetZoom( gPv )
else
    tkHost_Run( gHost )
end if
tkHost_Destroy( gHost )
tkPrintDoc_Destroy( gDoc )
TTF_Quit()
SDL_Quit()
