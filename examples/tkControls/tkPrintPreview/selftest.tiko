' tkPrintPreview self-test (printing phase R1). One check per behaviour: fit-width geometry, columns,
' the single view, scrolling and PageChanged, zoom about the pointer, scroll bars, the page cache
' (identical to replaying), links, keys, and a document generated by the preview itself.
' Geometry and the cache run at scale 1.0 and 1.75; the rest once.
'
'   selftest            exit code = number of failures
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkPrintPreview"
using tkTest
using tkPrintPreview
using tkPrint
using tkVScrollBar
using tkScrollBar
using tkHost
using tkPaint

dim shared as long gPageEvents, gLastPage, gZoomEvents

sub OnPage( byval h as TK_WIDGET ptr, byval n as long )
    gPageEvents += 1 : gLastPage = n
end sub

sub OnZoom( byval h as TK_WIDGET ptr, byval z as single )
    gZoomEvents += 1
end sub

' Six A5 pages: a number, a box, and on page 1 a link to page 5.
function SixPages( byval doc as TK_PRINTDOC ptr, byval pg as TK_PAGE ptr, byval i as long ) as boolean
    dim as TKRECTF r
    tkRectF_Set( r, 40, 40, 200, 120 )
    tkPage_SetFillColor( pg, tkRGB( 40 + i * 30, 90, 160 ) )
    tkPage_FillRect( pg, r )
    dim as TKFONTSPEC fs
    fs.pt = 24
    tkPage_SetFont( pg, fs )
    tkRectF_Set( r, 40, 140, 380, 180 )
    tkPage_Text( pg, "Page " & (i + 1), r, TK_DT_LEFT )
    if i = 0 then
        tkRectF_Set( r, 40, 200, 300, 240 )
        tkPage_Text( pg, "Go to page 5", r, TK_DT_LEFT )
        tkPage_LinkToPage( pg, r, 4 )
    end if
    return i < 5
end function

function Grab( byval h as TK_HOST ptr, byval w as TK_WIDGET ptr ) as SDL_Surface ptr
    dim as TKRECT a
    tkWidget_AbsRect( w, a )
    dim as SDL_Rect r
    r.x = a.left : r.y = a.top : r.w = w->cw : r.h = w->ch
    dim as SDL_Surface ptr s0 = SDL_RenderReadPixels( h->renderer, @r )
    if s0 = 0 then return 0
    dim as SDL_Surface ptr s = SDL_ConvertSurface( s0, SDL_PIXELFORMAT_ARGB8888 )
    SDL_DestroySurface( s0 )
    return s
end function

function SameSurf( byval a as SDL_Surface ptr, byval b as SDL_Surface ptr ) as long
    if (a = 0) orelse (b = 0) orelse (a->w <> b->w) orelse (a->h <> b->h) then return -1
    dim as long n = 0
    for y as long = 0 to a->h - 1
        dim as ulong ptr ra = cast( ulong ptr, cast( ubyte ptr, a->pixels ) + y * a->pitch )
        dim as ulong ptr rb = cast( ulong ptr, cast( ubyte ptr, b->pixels ) + y * b->pitch )
        for x as long = 0 to a->w - 1
            if (ra[x] and &hFFFFFFul) <> (rb[x] and &hFFFFFFul) then n += 1
        next
    next
    return n
end function

sub RunPass( byval fScale as single )
    tkTest_Begin( "scale " & fScale )
    dim as boolean once = (fScale = 1.0)
    dim as TK_HOST ptr h = tkHost_Create( "tkPrintPreview selftest", 640, 480, tkHost_FontDir() & TK_FONT_UI, fScale )
    if h = 0 then tkTest_Check( "host", false, *SDL_GetError() ) : exit sub
    tkHost_Show( h )
    dim as TK_PRINTDOC ptr doc = tkPrintDoc_Create( "six" )
    dim as TKPAGESETUP ps
    ps.paper = TK_PAPER_A5
    tkPrintDoc_SetPageSetup( doc, ps )
    tkPrintDoc_SetPrintPageCallback( doc, @SixPages )
    tkPrintDoc_Generate( doc )
    dim as TK_WIDGET ptr pv = tkPrintPreview_Create( tkHost_Root( h ), 10 )
    tkWidget_SetPos( pv, 0, 0, tkHost_Scale( h, 600 ), tkHost_Scale( h, 440 ) )
    tkPrintPreview_SetDocument( pv, doc )
    tkPrintPreview_SetPageChangedCallback( pv, @OnPage )
    tkPrintPreview_SetZoomChangedCallback( pv, @OnZoom )
    tkHost_RenderTo( h, false )

    ' ---- fit width: one column fills the view less the gaps; a vertical bar, no horizontal one ----
    dim as long gap = tkHost_Scale( h, TKPV_DEFAULT_GAP ), sb = tkHost_Scale( h, TKSCROLL_DEFAULT_THICKNESS )
    dim as TKRECT r0, r1
    tkPrintPreview_GetPageRect( pv, 0, r0 )
    dim as long want = pv->cw - sb - 2 * gap
    tkTest_Check( "fit width: page 1 = view less bar and gaps, A5 proportions", _
                  (abs( tkRect_Width( r0 ) - want ) <= 1) andalso (r0.left = gap) _
                  andalso (abs( tkRect_Height( r0 ) - tkRect_Width( r0 ) * 595.276 / 419.528 ) <= 1.5), _
                  tkRect_Str( r0 ) & " want w " & want )
    tkTest_Check( "scroll bars: vertical shown, horizontal hidden", _
                  tkWidget_IsVisible( tkPrintPreview_GetVScrollBar( pv ) ) andalso (tkWidget_IsVisible( tkPrintPreview_GetHScrollBar( pv ) ) = false) )

    ' ---- the cache draws exactly what replaying draws ---------------------------------------------
    tkHost_RenderTo( h, false )
    dim as SDL_Surface ptr sC = Grab( h, pv )
    tkPrintPreview_SetCacheSize( pv, 0 )
    tkHost_RenderTo( h, false )
    dim as SDL_Surface ptr sR = Grab( h, pv )
    dim as long nd = SameSurf( sC, sR )
    tkTest_Check( "cached pages = replayed pages, pixel for pixel", nd = 0, nd & " px differ" )
    if sC then SDL_DestroySurface( sC )
    if sR then SDL_DestroySurface( sR )
    tkPrintPreview_SetCacheSize( pv, TKPV_DEFAULT_CACHE )

    ' ---- two columns: pages 1 and 2 side by side ---------------------------------------------------
    tkPrintPreview_SetColumns( pv, 2 )
    tkPrintPreview_GetPageRect( pv, 0, r0 )
    tkPrintPreview_GetPageRect( pv, 1, r1 )
    tkTest_Check( "columns 2: one row, a gap apart", (r1.top = r0.top) andalso (r1.left = r0.right + gap), tkRect_Str( r0 ) & " " & tkRect_Str( r1 ) )
    tkPrintPreview_SetColumns( pv, 1 )

    if once then
        tkHost_SetFocus( h, pv )
        ' ---- scrolling by key moves the current page; SetPage is silent ---------------------------
        gPageEvents = 0
        tkPrintPreview_SetPage( pv, 2 )
        tkTest_Check( "SetPage: page 3 at the top, no PageChanged", (tkPrintPreview_GetPage( pv ) = 2) andalso (gPageEvents = 0) _
                      andalso tkPrintPreview_GetPageRect( pv, 2, r0 ) andalso (r0.top = gap), tkRect_Str( r0 ) )
        ' a page is taller than the view: the first PgDn stays on page 3, the second reaches page 4
        tkTest_PushKey( h, SDLK_PAGEDOWN )
        tkTest_PushKey( h, SDLK_PAGEDOWN )
        tkTest_Check( "PgDn scrolls a view at a time; the current page follows, with one PageChanged", _
                      (gPageEvents = 1) andalso (gLastPage = 3), "events " & gPageEvents & " page " & gLastPage )

        ' ---- the single view: one row, PgDn turns it ----------------------------------------------
        tkPrintPreview_SetViewMode( pv, TKPV_VIEW_SINGLE )
        tkPrintPreview_SetPage( pv, 0 )
        gPageEvents = 0
        tkTest_PushKey( h, SDLK_PAGEDOWN )
        tkTest_Check( "single view: PgDn shows page 2 alone", (tkPrintPreview_GetPage( pv ) = 1) andalso (gPageEvents = 1) _
                      andalso tkPrintPreview_GetPageRect( pv, 1, r1 ) andalso (tkPrintPreview_GetPageRect( pv, 0, r0 ) = false) )
        tkPrintPreview_SetViewMode( pv, TKPV_VIEW_CONTINUOUS )

        ' ---- Ctrl+wheel zooms about the pointer ----------------------------------------------------
        tkPrintPreview_SetPage( pv, 0 )
        tkHost_RenderTo( h, false )
        tkPrintPreview_GetPageRect( pv, 0, r0 )
        dim as single z0 = tkPrintPreview_GetZoom( pv )
        dim as TKRECT a
        tkWidget_AbsRect( pv, a )
        dim as single mx = r0.left + tkRect_Width( r0 ) * 0.25, my = r0.top + tkRect_Height( r0 ) * 0.25
        dim as single fx = (mx - r0.left) / tkRect_Width( r0 ), fy = (my - r0.top) / tkRect_Height( r0 )
        gZoomEvents = 0
        SDL_SetModState( SDL_KMOD_CTRL )
        tkTest_PushWheel( h, a.left + mx, a.top + my, 0, 1 )
        SDL_SetModState( SDL_KMOD_NONE )
        tkPrintPreview_GetPageRect( pv, 0, r1 )
        dim as single fx2 = (mx - r1.left) / tkRect_Width( r1 ), fy2 = (my - r1.top) / tkRect_Height( r1 )
        tkTest_Check( "Ctrl+wheel: zoom x1.25 about the pointer, custom mode, ZoomChanged", _
                      (abs( tkPrintPreview_GetZoom( pv ) - z0 * 1.25 ) < 0.001) andalso (tkPrintPreview_GetZoomMode( pv ) = TKPV_ZOOM_CUSTOM) _
                      andalso (abs( fx2 - fx ) < 0.01) andalso (abs( fy2 - fy ) < 0.01) andalso (gZoomEvents = 1), _
                      "z " & tkPrintPreview_GetZoom( pv ) & " / " & z0 & " at " & fx2 & "," & fy2 & " was " & fx & "," & fy )

        ' ---- '-' zooms out from the keyboard -------------------------------------------------------
        dim as single z1 = tkPrintPreview_GetZoom( pv )
        tkTest_PushKey( h, SDLK_MINUS )
        tkTest_Check( "'-' zooms out by 1.25", abs( tkPrintPreview_GetZoom( pv ) - z1 / 1.25 ) < 0.001 )
        tkPrintPreview_SetZoomMode( pv, TKPV_ZOOM_FITWIDTH )

        ' ---- a page link: click it, page 5 comes to the top ---------------------------------------
        tkPrintPreview_SetPage( pv, 0 )
        tkHost_RenderTo( h, false )
        tkPrintPreview_GetPageRect( pv, 0, r0 )
        dim as single s = tkRect_Width( r0 ) / 419.528
        tkTest_Click( h, a.left + r0.left + 60 * s, a.top + r0.top + 220 * s )
        tkTest_Check( "a page link goes to its page", tkPrintPreview_GetPage( pv ) = 4 andalso tkPrintPreview_GetPageRect( pv, 4, r1 ) _
                      andalso (r1.top = gap), "page " & tkPrintPreview_GetPage( pv ) )

        ' ---- a document begun but not generated: the preview finishes it on its timer ----------------
        dim as TK_PRINTDOC ptr d2 = tkPrintDoc_Create( "async" )
        tkPrintDoc_SetPrintPageCallback( d2, @SixPages )
        tkPrintDoc_BeginGenerate( d2 )
        tkPrintPreview_SetDocument( pv, d2 )
        tkTest_PumpFor( h, 300 )
        tkTest_Check( "generation on the preview's timer: six pages, complete", _
                      (tkPrintPreview_GetPageCount( pv ) = 6) andalso tkPrintDoc_IsComplete( d2 ), "" & tkPrintPreview_GetPageCount( pv ) )
        tkPrintPreview_SetDocument( pv, doc )
        tkPrintDoc_Destroy( d2 )
    end if

    tkWidget_Destroy( pv )
    tkPrintDoc_Destroy( doc )
    tkHost_Destroy( h )
end sub

if tkTest_Init() = false then end 1
RunPass( 1.0 )
RunPass( 1.75 )
dim as long nFail = tkTest_Report( "tkPrintPreview" )
tkTest_Quit()
end nFail
