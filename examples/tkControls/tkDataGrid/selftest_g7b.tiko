' tkDataGrid self-test, phase G7b: the band geometry, frozen rows, the footer's totals. Included by
' selftest.tiko. Geometry is checked against arithmetic of its own (hdrH, rowH, the surface's
' height), never against the grid's own answers; totals against sums taken here.

dim shared as integer g7bFmtN, g7bHostN
dim shared as boolean g7bHostGive
dim shared as integer g7bAggN, g7bGetN

sub G7bSumFmt( byval hg as TK_WIDGET ptr, byval col as integer, byval kind as long, byref v as TKDG_VALUE, byref text as ustring )
    g7bFmtN += 1
    if g7bHostGive andalso (v.kind = TKDG_EMPTY) then
        g7bHostN += 1
        v.SetInt( 123 )
        text = "123"
    end if
end sub

sub G7bNeed( byval hg as TK_WIDGET ptr, byval row as integer, byval col as integer, byref v as TKDG_VALUE )
    v.SetInt( row )
end sub

function G7bSrcCount( byval ctx as any ptr ) as integer
    return 50
end function
sub G7bSrcGet( byval ctx as any ptr, byval row as integer, byval col as integer, byref v as TKDG_VALUE )
    g7bGetN += 1
    v.SetInt( row )
end sub
function G7bSrcAgg( byval ctx as any ptr, byval col as integer, byval kind as long, byref v as TKDG_VALUE ) as boolean
    g7bAggN += 1
    v.SetInt( 999 )
    return true
end function

' The cell's top on the surface (or -9999 when it does not show).
function G7bTop( byval g as TK_WIDGET ptr, byval row as integer, byval col as integer ) as integer
    dim as TKRECT rc
    if tkDataGrid_GetCellRect( g, row, col, rc ) = false then return -9999
    return rc.top
end function

function G7bSumInt( byval g as TK_WIDGET ptr, byval col as integer ) as longint
    dim as TKDG_VALUE v
    if tkDataGrid_GetSummary( g, col, v ) = false then return -77777
    if v.kind = TKDG_INT then return v.i
    if v.kind = TKDG_FLOAT then return clngint( v.f * 1000 )
    return -88888
end function

' 200 rows: N = row (int), T = text, F = row / 2 (float, every 5th row EMPTY), D = a date.
function G7bGrid( byval h as TK_HOST ptr, byval f10 as TTF_Font ptr, byval id as long ) as TK_WIDGET ptr
    dim as TK_WIDGET ptr g = tkDataGrid_Create( tkHost_Root( h ), id )
    tkDataGrid_SetFont( g, f10 )
    tkDataGrid_SetBorderWidth( g, 0 )
    tkWidget_SetPos( g, tkHost_Scale( h, 10 ), tkHost_Scale( h, 10 ), tkHost_Scale( h, 420 ), tkHost_Scale( h, 300 ) )
    tkDataGrid_ShowRowHeaders( g, true )
    tkDataGrid_AddColumnEx( g, "N", TKDG_COL_NUMBER, 60, TKDG_INT )
    tkDataGrid_AddColumnEx( g, "T", TKDG_COL_TEXT, 90 )
    tkDataGrid_AddColumnEx( g, "F", TKDG_COL_NUMBER, 80, TKDG_FLOAT )
    tkDataGrid_AddColumnEx( g, "D", TKDG_COL_DATE, 120, TKDG_DATE )
    tkDataGrid_AddColumnEx( g, "X", TKDG_COL_TEXT, 200 )
    tkDataGrid_SetFrozenColumns( g, 1 )
    tkDataGrid_BeginUpdate( g )
    tkDataGrid_SetRowCount( g, 200 )
    dim as string words(0 to 3) = { "cherry", "Apple", "banana", "Date" }
    for r as integer = 0 to 199
        tkDataGrid_SetCellInt( g, r, 0, r )
        if (r mod 7) <> 3 then tkDataGrid_SetCellText( g, r, 1, words( r mod 4 ) & r )
        if (r mod 5) <> 0 then tkDataGrid_SetCellFloat( g, r, 2, r / 2 )
        dim as TKDATE d
        d.wYear = 2026 : d.wMonth = 1 + (r mod 12) : d.wDay = 1 + (r mod 28)
        tkDataGrid_SetCellDate( g, r, 3, d )
    next
    tkDataGrid_EndUpdate( g )
    return g
end function

sub RunG7b( byval fScale as single )
    tkTest_Begin( "G7b scale " & fScale )
    dim as TK_HOST ptr h = tkHost_Create( "tkDataGrid selftest G7b", 760, 560, tkHost_FontDir() & TK_FONT_UI, fScale )
    if h = 0 then tkTest_Check( "host", false, *SDL_GetError() ) : exit sub
    dim as TTF_Font ptr f10 = tkHost_OpenFont( h, tkHost_FontDir() & TK_FONT_UI, 10 )
    tkHost_Show( h )
    tkTest_PumpFor( h, 300 )
    dim as TK_WIDGET ptr g = G7bGrid( h, f10, 900 )
    dim as TK_WIDGET ptr s = tkDataGrid_GetSurface( g )
    tkTest_PumpFor( h, 60 )
    dim as integer rowH = tkDataGrid_GetRowHeightPx( g ), hdrH = tkDataGrid_GetHeaderHeightPx( g )
    dim as integer t2 = tkHost_Scale( h, 2 )

    ' ---- frozen rows: geometry --------------------------------------------------------------
    tkDataGrid_SetFrozenRows( g, 2 )
    tkTest_PumpFor( h, 30 )
    dim as integer bodyTop = hdrH + 2 * rowH, bodyH = s->ch - bodyTop
    tkTest_Check( "SetFrozenRows( 2 ): Get, and the band is two rows high", (tkDataGrid_GetFrozenRows( g ) = 2) _
                  andalso (tkDataGrid_GetFrozenRowsHeightPx( g ) = 2 * rowH) )
    tkTest_Check( "frozen rows sit under the header; the first scrolling row under them", (G7bTop( g, 0, 1 ) = hdrH) _
                  andalso (G7bTop( g, 1, 1 ) = hdrH + rowH) andalso (G7bTop( g, 2, 1 ) = bodyTop) andalso (G7bTop( g, 5, 0 ) = bodyTop + 3 * rowH) )
    dim as integer sy = 7 * rowH + 3
    tkDataGrid_SetScrollY( g, sy )
    tkTest_PumpFor( h, 30 )
    tkTest_Check( "scrolled: the frozen rows do not move; a scrolling row moves by the scroll", (G7bTop( g, 0, 1 ) = hdrH) _
                  andalso (G7bTop( g, 1, 0 ) = hdrH + rowH) andalso (G7bTop( g, 12, 1 ) = bodyTop + 10 * rowH - sy), _
                  G7bTop( g, 0, 1 ) & " " & G7bTop( g, 12, 1 ) & " want " & (bodyTop + 10 * rowH - sy) )
    tkTest_Check( "a scrolling row wholly under the frozen band does not show (GetCellRect FALSE)", (G7bTop( g, 8, 1 ) = -9999) _
                  andalso (G7bTop( g, 9, 1 ) = bodyTop + 7 * rowH - sy), "row 9 " & G7bTop( g, 9, 1 ) )
    tkDataGrid_SetScrollY( g, 1000000 )
    dim as integer wantMax = 198 * rowH - bodyH
    tkTest_Check( "scroll range: the scrolling rows only, (rows - frozen) x rowH - body", tkDataGrid_GetScrollY( g ) = wantMax, _
                  tkDataGrid_GetScrollY( g ) & " want " & wantMax )
    tkDataGrid_SetScrollY( g, sy )
    dim as TKDG_HITTEST ht
    tkDataGrid_HitTest( g, tkDataGrid_GetRowHeaderWidthPx( g ) + 5, hdrH + rowH + 2, ht )
    dim as boolean htFrozen = (ht.area = TKDG_HT_CELL) andalso (ht.row = 1)
    tkDataGrid_HitTest( g, tkDataGrid_GetRowHeaderWidthPx( g ) + 5, bodyTop + 1, ht )
    tkTest_Check( "HitTest: the frozen band gives a frozen row; just under it the first scrolling row on screen", _
                  htFrozen andalso (ht.area = TKDG_HT_CELL) andalso (ht.row = 2 + sy \ rowH), "row " & ht.row )
    tkTest_Check( "GetTopRow: the first scrolling row on screen", tkDataGrid_GetTopRow( g ) = 2 + sy \ rowH, "" & tkDataGrid_GetTopRow( g ) )
    tkDataGrid_SetTopRow( g, 50 )
    dim as boolean top50 = (tkDataGrid_GetScrollY( g ) = 48 * rowH)
    tkDataGrid_SetTopRow( g, 1 )
    tkTest_Check( "SetTopRow: a scrolling row scrolls to bodyTop; a frozen one scrolls back to the start", top50 _
                  andalso (tkDataGrid_GetScrollY( g ) = 0) )
    tkDataGrid_SetScrollY( g, sy )
    tkDataGrid_EnsureVisible( g, 0 )
    dim as boolean ens0 = (tkDataGrid_GetScrollY( g ) = sy)
    tkDataGrid_EnsureVisible( g, 150 )
    dim as TKRECT rc150
    dim as boolean vis150 = tkDataGrid_GetCellRect( g, 150, 1, rc150 )
    tkTest_Check( "EnsureVisible: a frozen row needs no scroll; row 150 comes fully into the body", ens0 andalso vis150 _
                  andalso (rc150.top >= bodyTop) andalso (rc150.bottom <= s->ch), rc150.top & ".." & rc150.bottom )
    ' paint: the frozen rows are painted whatever the scroll, and the line under them
    ResetPaintCounts( )
    tkDataGrid_SetCellPaintCallback( g, @OnCellPaint )
    tkHost_RenderTo( h, false )
    tkDataGrid_SetCellPaintCallback( g, 0 )
    tkTest_Check( "paint while scrolled: frozen rows 0 and 1 are painted too", (gMinRow = 0) andalso (gMaxRow >= 150), gMinRow & ".." & gMaxRow )
    dim as TKDATAGRID_COLORS c0
    tkDataGrid_GetColors( g, @c0 )
    dim as ulong lineC = c0.FrozenLineColor
    tkTest_Check( "the line under the frozen rows is FrozenLineColor", Px( h, g, tkHost_Scale( h, 200 ), bodyTop - t2 \ 2 ) = (lineC and &hFFFFFFul), _
                  hex( Px( h, g, tkHost_Scale( h, 200 ), bodyTop - t2 \ 2 ) ) )
    ' keys: PgDn moves a page of the body; Ctrl+End shows the last row whole
    tkDataGrid_SetScrollY( g, 0 )
    tkDataGrid_SetCurrentCell( g, 0, 1 )
    tkHost_SetFocus( h, s )
    tkTest_PushKey( h, SDLK_PAGEDOWN )
    tkTest_PumpFor( h, 30 )
    dim as integer pageRows = bodyH \ rowH
    tkTest_Check( "PgDn from row 0 moves a page of the scrolling body", CurIs( g, pageRows, 1 ), CurStr( g ) & " page " & pageRows )
    tkTest_PushKey( h, SDLK_END, SDL_KMOD_CTRL )
    tkTest_PumpFor( h, 30 )
    dim as TKRECT rcEnd
    tkDataGrid_GetCellRect( g, 199, 4, rcEnd )
    tkTest_Check( "Ctrl+End: the last row, wholly above the bottom", CurIs( g, 199, 4 ) andalso (rcEnd.bottom <= s->ch) andalso (rcEnd.top >= bodyTop), _
                  CurStr( g ) & " " & rcEnd.top & ".." & rcEnd.bottom )
    ' the editor: over a frozen row it stays put while the rows scroll; on a scrolling row that goes
    ' under the frozen band the edit ends (committed)
    tkDataGrid_SetScrollY( g, sy )
    tkDataGrid_SetScrollX( g, 0 )
    tkTest_PumpFor( h, 30 )
    tkDataGrid_BeginEdit( g, 1, 1 )
    tkTest_PumpFor( h, 30 )
    dim as boolean edOk = tkDataGrid_IsEditing( g ) andalso EdRectIs( g, 1, 1 )
    tkDataGrid_SetScrollY( g, sy + 5 * rowH )
    tkTest_PumpFor( h, 30 )
    tkTest_Check( "the editor on a frozen row: on its cell, and still there after a scroll", edOk andalso tkDataGrid_IsEditing( g ) _
                  andalso EdRectIs( g, 1, 1 ) andalso (tkDataGrid_GetEditor( g )->y = hdrH + rowH) )
    tkDataGrid_EndEdit( g, false )
    dim as integer er = 2 + (sy + 5 * rowH) \ rowH + 1
    tkDataGrid_BeginEdit( g, er, 1 )
    tkTest_PumpFor( h, 30 )
    dim as boolean edOn = tkDataGrid_IsEditing( g )
    tkDataGrid_SetScrollY( g, tkDataGrid_GetScrollY( g ) + 3 * rowH )
    tkTest_PumpFor( h, 30 )
    tkTest_Check( "the editor on a scrolling row that goes under the frozen rows: the edit ends", edOn andalso (tkDataGrid_IsEditing( g ) = false) )
    ' a drag from the body up into the frozen band scrolls the rows up
    tkDataGrid_SetScrollY( g, 20 * rowH )
    tkTest_PumpFor( h, 30 )
    dim as single dx, dy
    CellXY( g, 30, 1, dx, dy )
    tkTest_PushButton( h, true, dx, dy )
    dim as single fx, fy
    SurfXY( g, tkHost_Scale( h, 150 ), hdrH + rowH \ 2, fx, fy )
    tkTest_PushMotion( h, fx, fy )
    tkTest_PumpFor( h, 400 )
    dim as integer syAfter = tkDataGrid_GetScrollY( g )
    tkTest_PushButton( h, false, fx, fy )
    tkTest_PumpFor( h, 30 )
    tkTest_Check( "drag-select into the frozen band while scrolled: autoscroll upward", syAfter < 20 * rowH, "scrollY " & syAfter )
    ' a sort changes which rows are frozen (they are view positions)
    tkDataGrid_SetScrollY( g, 0 )
    G4Keys1( g, 0, true )
    tkTest_PumpFor( h, 30 )
    tkTest_Check( "sorted descending: model row 199 is the first frozen row", (G7bTop( g, 199, 1 ) = hdrH) andalso (G7bTop( g, 0, 1 ) = -9999) )
    tkDataGrid_ClearSort( g )
    ' the layout keeps the count
    tkDataGrid_SetFrozenRows( g, 3 )
    dim as ustring lay = tkDataGrid_GetLayout( g )
    tkDataGrid_SetFrozenRows( g, 0 )
    dim as boolean okL = tkDataGrid_SetLayout( g, lay )
    dim as integer frAfter = tkDataGrid_GetFrozenRows( g )
    tkDataGrid_SetLayout( g, "tkdg1;frozen=1;sort=;cols=" )
    tkTest_Check( "layout: frows= saved and put back; a layout without it leaves the count", (instr( lay, ";frows=3;" ) > 0) andalso okL _
                  andalso (frAfter = 3) andalso (tkDataGrid_GetFrozenRows( g ) = 3), lay )
    tkDataGrid_SetFrozenRows( g, 2 )
    tkDataGrid_SetFrozenColumns( g, 1 )

    ' ---- the footer ---------------------------------------------------------------------------
    tkDataGrid_SetSummaryFormattingCallback( g, @G7bSumFmt )
    tkDataGrid_SetColumnSummary( g, 0, TKDG_SUM_SUM )
    tkDataGrid_SetColumnSummary( g, 1, TKDG_SUM_COUNT )
    tkDataGrid_SetColumnSummary( g, 2, TKDG_SUM_AVG )
    tkDataGrid_SetColumnSummary( g, 3, TKDG_SUM_MAX )
    tkDataGrid_ShowFooter( g, true )
    tkTest_PumpFor( h, 30 )
    tkTest_Check( "ShowFooter: one row high", tkDataGrid_IsFooterVisible( g ) andalso (tkDataGrid_GetFooterHeightPx( g ) = rowH) )
    dim as integer bodyH2 = s->ch - bodyTop - rowH
    tkDataGrid_SetScrollY( g, 1000000 )
    tkTest_Check( "with the footer the scroll range ends a row earlier", tkDataGrid_GetScrollY( g ) = 198 * rowH - bodyH2, _
                  tkDataGrid_GetScrollY( g ) & " want " & (198 * rowH - bodyH2) )
    tkDataGrid_SetScrollY( g, 0 )
    tkDataGrid_HitTest( g, tkDataGrid_GetRowHeaderWidthPx( g ) + 5, s->ch - rowH \ 2, ht )
    tkTest_Check( "HitTest in the footer: TKDG_HT_FOOTER and the column", (ht.area = TKDG_HT_FOOTER) andalso (ht.col = 0) )
    ' brute force: N sums 0..199; T counts the non-empty; F averages the non-empty
    dim as longint sumN = 0, cntT = 0, nF = 0
    dim as double sumF = 0
    for r as integer = 0 to 199
        sumN += r
        if (r mod 7) <> 3 then cntT += 1
        if (r mod 5) <> 0 then sumF += r / 2 : nF += 1
    next
    dim as TKDG_VALUE sv
    tkDataGrid_GetSummary( g, 0, sv )
    dim as boolean sumIsInt = (sv.kind = TKDG_INT)
    tkTest_Check( "SUM of an int column: an int, = the sum taken here", sumIsInt andalso (sv.i = sumN), sv.kind & " " & sv.i )
    tkTest_Check( "COUNT: the non-empty cells", G7bSumInt( g, 1 ) = cntT, G7bSumInt( g, 1 ) & " want " & cntT )
    tkDataGrid_GetSummary( g, 2, sv )
    tkTest_Check( "AVG: a float over the non-empty cells", (sv.kind = TKDG_FLOAT) andalso (abs( sv.f - sumF / nF ) < 1e-9), str( sv.f ) )
    tkDataGrid_GetSummary( g, 3, sv )
    tkTest_Check( "MAX of a date column: the latest date", (sv.kind = TKDG_DATE) andalso (sv.d.wMonth = 12) andalso (sv.d.wDay = 28), _
                  sv.d.wYear & "-" & sv.d.wMonth & "-" & sv.d.wDay )
    tkDataGrid_SetColumnSummary( g, 1, TKDG_SUM_MIN )
    dim as ustring tmin = tkDataGrid_GetSummaryText( g, 1 )
    tkDataGrid_SetColumnSummary( g, 1, TKDG_SUM_MAX )
    dim as ustring tmax = tkDataGrid_GetSummaryText( g, 1 )
    tkTest_Check( "MIN / MAX of text: without case (Apple1 < banana2; Date99 is the last)", (tmin = "Apple1") andalso (tmax = "Date99"), tmin & " / " & tmax )
    tkDataGrid_SetColumnSummary( g, 1, TKDG_SUM_COUNT )
    tkTest_Check( "GetSummaryText: the value's text", tkDataGrid_GetSummaryText( g, 0 ) = str( sumN ), tkDataGrid_GetSummaryText( g, 0 ) )
    ' counting: worked out once per change, not per paint
    tkDataGrid_SetCellInt( g, 0, 0, 1000 )
    g7bFmtN = 0
    for k as integer = 1 to 5
        tkHost_RenderTo( h, false )
    next
    dim as integer n5 = g7bFmtN
    tkTest_Check( "after a change: one working-out (4 summary columns) over five paints", n5 = 4, "SummaryFormatting " & n5 )
    tkTest_Check( "a write is in the total", G7bSumInt( g, 0 ) = sumN + 1000, "" & G7bSumInt( g, 0 ) )
    tkDataGrid_SetCellInt( g, 0, 0, 0 )
    tkDataGrid_DeleteRows( g, 199, 1 )
    tkTest_Check( "a deleted row leaves the total", G7bSumInt( g, 0 ) = sumN - 199, "" & G7bSumInt( g, 0 ) )
    ' the view: filtered-out rows do not count; a sort changes nothing
    tkDataGrid_SetQuickFilter( g, "banana" )      ' rows r mod 4 = 2 (and T not empty)
    dim as longint sumBan = 0
    for r as integer = 0 to 198
        if ((r mod 4) = 2) andalso ((r mod 7) <> 3) then sumBan += r
    next
    tkTest_Check( "a filtered view: the rows shown only", G7bSumInt( g, 0 ) = sumBan, G7bSumInt( g, 0 ) & " want " & sumBan )
    tkDataGrid_SetQuickFilter( g, "zzz-none" )
    tkDataGrid_GetSummary( g, 2, sv )
    tkTest_Check( "nothing shown: SUM 0, AVG EMPTY", (G7bSumInt( g, 0 ) = 0) andalso (sv.kind = TKDG_EMPTY) )
    tkDataGrid_SetQuickFilter( g, "" )
    G4Keys1( g, 1, false )
    tkTest_Check( "sorted: the same total", G7bSumInt( g, 0 ) = sumN - 199 )
    tkDataGrid_ClearSort( g )
    ' the selection scope
    tkDataGrid_SetSummaryScope( g, TKDG_SUMSCOPE_SELECTION )
    tkDataGrid_SelectRange( g, 10, 0, 19, 0 )
    dim as longint s1 = G7bSumInt( g, 0 )
    tkDataGrid_SelectRange( g, 10, 2, 19, 2 )
    dim as longint s0 = G7bSumInt( g, 0 )
    tkDataGrid_SelectRows( g, 0, 1 )
    dim as longint s2 = G7bSumInt( g, 0 )
    dim as single cx, cy
    CellXY( g, 5, 0, cx, cy )
    tkTest_Click( h, cx, cy )
    tkTest_PumpFor( h, 30 )
    tkTest_Check( "selection scope: a rectangle, whole rows, then a click (the footer follows the selection)", (s1 = 145) andalso (s2 = 1) _
                  andalso (G7bSumInt( g, 0 ) = 5), s1 & " " & s2 & " " & G7bSumInt( g, 0 ) )
    tkTest_Check( "selection scope: cells selected only in another column add nothing to this one", s0 = 0, "" & s0 )
    tkDataGrid_SetSummaryScope( g, TKDG_SUMSCOPE_VIEW )
    tkDataGrid_ClearSelection( g )
    ' paint: the footer's back, and a column under ScrollX keeps its total under it
    tkHost_RenderTo( h, false )
    dim as TKDATAGRID_COLORS colr
    tkDataGrid_GetColors( g, @colr )
    dim as TKRECT xr
    tkDataGrid_GetColumnRect( g, 4, xr )
    tkTest_Check( "the footer's back is FooterBackColor (column X, no summary)", Px( h, g, xr.left + 3, s->ch - 2 ) = (colr.FooterBackColor and &hFFFFFFul), _
                  hex( Px( h, g, xr.left + 3, s->ch - 2 ) ) )
    tkDataGrid_SetScrollX( g, tkHost_Scale( h, 40 ) )
    tkTest_PumpFor( h, 30 )
    dim as TKRECT fr
    tkDataGrid_GetColumnRect( g, 2, fr )
    tkDataGrid_HitTest( g, fr.left + 3, s->ch - 2, ht )
    tkTest_Check( "scrolled sideways: the footer's column under x is the header's", (ht.area = TKDG_HT_FOOTER) andalso (ht.col = 2), "col " & ht.col )
    tkDataGrid_SetScrollX( g, 0 )
    ' HOST mode: the grid does not read 10^6 rows; SummaryFormatting may give the value
    dim as TK_WIDGET ptr gv = tkDataGrid_Create( tkHost_Root( h ), 920 )
    tkWidget_SetPos( gv, tkHost_Scale( h, 440 ), tkHost_Scale( h, 10 ), tkHost_Scale( h, 300 ), tkHost_Scale( h, 200 ) )
    tkDataGrid_AddColumnEx( gv, "N", TKDG_COL_NUMBER, 60, TKDG_INT )
    tkDataGrid_SetCellValueNeededCallback( gv, @G7bNeed )
    tkDataGrid_SetVirtual( gv, true )
    tkDataGrid_SetRowCount( gv, 1000000 )
    tkDataGrid_SetColumnSummary( gv, 0, TKDG_SUM_SUM )
    tkDataGrid_ShowFooter( gv, true )
    tkDataGrid_GetSummary( gv, 0, sv )
    dim as boolean hostEmpty = (sv.kind = TKDG_EMPTY)
    tkDataGrid_SetSummaryFormattingCallback( gv, @G7bSumFmt )
    g7bHostGive = true
    tkTest_Check( "HOST mode: no total of its own; SummaryFormatting gives one", hostEmpty andalso (G7bSumInt( gv, 0 ) = 123) _
                  andalso (tkDataGrid_GetSummaryText( gv, 0 ) = "123") )
    g7bHostGive = false
    tkWidget_Destroy( gv )
    ' a source's Aggregate is asked; while the grid filters, the grid adds up itself
    dim as TK_WIDGET ptr gs = tkDataGrid_Create( tkHost_Root( h ), 930 )
    tkWidget_SetPos( gs, tkHost_Scale( h, 440 ), tkHost_Scale( h, 10 ), tkHost_Scale( h, 300 ), tkHost_Scale( h, 200 ) )
    tkDataGrid_AddColumnEx( gs, "N", TKDG_COL_NUMBER, 60, TKDG_INT )
    dim as TKDATAGRID_SOURCE src
    src.RowCount = @G7bSrcCount : src.GetCell = @G7bSrcGet : src.Aggregate = @G7bSrcAgg
    tkDataGrid_SetSource( gs, @src )
    tkDataGrid_SetColumnSummary( gs, 0, TKDG_SUM_SUM )
    g7bAggN = 0 : g7bGetN = 0
    dim as longint sa = G7bSumInt( gs, 0 )
    tkTest_Check( "a source's Aggregate gives the total (no row read)", (sa = 999) andalso (g7bAggN = 1) andalso (g7bGetN = 0), sa & " agg " & g7bAggN & " get " & g7bGetN )
    tkDataGrid_SetQuickFilter( gs, "1" )
    dim as longint sf = G7bSumInt( gs, 0 )
    dim as longint want1 = 0
    for r as integer = 0 to 49
        if instr( str( r ), "1" ) > 0 then want1 += r
    next
    tkTest_Check( "the grid filters: it adds the shown rows itself, Aggregate not asked", (sf = want1) andalso (g7bAggN = 1), sf & " want " & want1 )
    tkWidget_Destroy( gs )
    tkHost_Destroy( h )
end sub
