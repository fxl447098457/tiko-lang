' tkDataGrid self-test, phase G7a: CSV export, the column chooser, the context menu and the layout
' string. Included by selftest.tiko (one program, one exit code); kept apart to hold each file
' under 1500 lines. Every gesture is a pushed SDL event, as in the other phases.

dim shared as integer g7Need, g7VisN, g7VisCol, g7ResN, g7ResCol, g7ResW, g7CurN
dim shared as boolean g7VisOn, g7ResLive, g7EatRight, g7CmKey
dim shared as integer g7CmN, g7CmRow, g7CmCol
dim shared as long g7CmX, g7CmY

sub G7Fmt( byval f as TKDATAGRID_FORMATINFO ptr )
    if (f->col = 2) andalso (f->value->kind = TKDG_FLOAT) then f->text = "$" & f->text
end sub

sub G7Vis( byval hg as TK_WIDGET ptr, byval col as integer, byval bVisible as boolean )
    g7VisN += 1 : g7VisCol = col : g7VisOn = bVisible
end sub

sub G7Res( byval hg as TK_WIDGET ptr, byval col as integer, byval nWidth as integer, byval bLive as boolean )
    g7ResN += 1 : g7ResCol = col : g7ResW = nWidth : g7ResLive = bLive
end sub

sub G7Cur( byval hg as TK_WIDGET ptr, byval row as integer, byval col as integer )
    g7CurN += 1
end sub

sub G7Cm( byval hg as TK_WIDGET ptr, byval row as integer, byval col as integer, byval x as long, byval y as long, byval bKeyboard as boolean )
    g7CmN += 1 : g7CmRow = row : g7CmCol = col : g7CmX = x : g7CmY = y : g7CmKey = bKeyboard
end sub

function G7Msg( byval m as TKDATAGRID_MESSAGEINFO ptr ) as boolean
    return g7EatRight andalso (m->msg = TKM_RBUTTONUP)
end function

sub G7NeedCell( byval hg as TK_WIDGET ptr, byval row as integer, byval col as integer, byref v as TKDG_VALUE )
    g7Need += 1
    select case col
    case 0 : v.SetInt( row )
    case 1 : v.SetText( "r" & row )
    case 2 : v.SetFloat( row / 4 )
    end select
end sub

function G7Hex( byref s as const ustring ) as string
    dim as string o
    for k as integer = 0 to len( s ) - 1
        if s[k] = 13 then
            o &= "\r"
        elseif s[k] = 10 then
            o &= "\n"
        else
            o &= mid( s, k + 1, 1 )
        end if
    next
    return o
end function

' Right-click at the middle of col's header (col -1: the header band past the last column).
sub G7RightHeader( byval h as TK_HOST ptr, byval g as TK_WIDGET ptr, byval col as integer )
    dim as TKRECT hc
    dim as single x, y
    if col >= 0 then
        tkDataGrid_GetColumnRect( g, col, hc )
        SurfXY( g, (hc.left + hc.right) \ 2, (hc.top + hc.bottom) \ 2, x, y )
    else
        ' the header band past the last column: no column under it
        SurfXY( g, tkDataGrid_GetSurface( g )->cw - 5, 3, x, y )
    end if
    tkTest_Click( h, x, y, SDL_BUTTON_RIGHT )
    tkTest_PumpFor( h, 60 )
end sub

' Clicks menu item idx (0-based, separators counted) of the open chooser.
sub G7ClickItem( byval h as TK_HOST ptr, byval m as TK_MENU ptr, byval idx as long )
    dim as TKRECT rc
    tkPopupMenu_GetItemRect( m, idx, rc )
    if tkPopupMenu_Surface( m ) then tkTest_Click( tkPopupMenu_Surface( m ), (rc.left + rc.right) / 2, (rc.top + rc.bottom) / 2 )
    tkTest_PumpFor( h, 80 )
end sub

function G7ColX( byval g as TK_WIDGET ptr, byval col as integer ) as integer
    dim as TKRECT rc
    if tkDataGrid_GetColumnRect( g, col, rc ) = false then return -9999
    return rc.left
end function

' Six columns: Name text, Qty int, Price float, Done check, Due date, Notes text (hidden).
function G7Grid( byval h as TK_HOST ptr, byval f10 as TTF_Font ptr, byval id as long ) as TK_WIDGET ptr
    dim as TK_WIDGET ptr g = tkDataGrid_Create( tkHost_Root( h ), id )
    tkDataGrid_SetFont( g, f10 )
    tkDataGrid_SetBorderWidth( g, 0 )
    tkWidget_SetPos( g, tkHost_Scale( h, 10 ), tkHost_Scale( h, 10 ), tkHost_Scale( h, 640 ), tkHost_Scale( h, 300 ) )
    tkDataGrid_SetSortMode( g, TKDG_SORT_NONE )
    tkDataGrid_AddColumnEx( g, "Name", TKDG_COL_TEXT, 110 )
    tkDataGrid_AddColumnEx( g, "Qty", TKDG_COL_NUMBER, 60, TKDG_INT )
    tkDataGrid_AddColumnEx( g, "Price", TKDG_COL_NUMBER, 70, TKDG_FLOAT )
    tkDataGrid_AddColumnEx( g, "Done", TKDG_COL_CHECK, 50, TKDG_BOOL )
    tkDataGrid_AddColumnEx( g, "Due", TKDG_COL_DATE, 90, TKDG_DATE )
    tkDataGrid_AddColumnEx( g, "Notes", TKDG_COL_TEXT, 120 )
    tkDataGrid_SetColumnVisible( g, 5, false )
    return g
end function

sub G7Fill( byval g as TK_WIDGET ptr )
    tkDataGrid_SetRowCount( g, 5 )
    tkDataGrid_SetCellText( g, 0, 0, "plain" )   : tkDataGrid_SetCellInt( g, 0, 1, 3 )  : tkDataGrid_SetCellFloat( g, 0, 2, 1.5 )
    tkDataGrid_SetCellText( g, 1, 0, "a, b" )    : tkDataGrid_SetCellInt( g, 1, 1, -5 ) : tkDataGrid_SetCellFloat( g, 1, 2, 2.25 )
    tkDataGrid_SetCellText( g, 2, 0, !"say \"hi\"" ) : tkDataGrid_SetCellInt( g, 2, 1, 7 )
    tkDataGrid_SetCellText( g, 3, 0, !"two\nlines" ) : tkDataGrid_SetCellInt( g, 3, 1, 1 )
    tkDataGrid_SetCellText( g, 4, 0, "=SUM(A1)" ) : tkDataGrid_SetCellInt( g, 4, 1, 9 )
    tkDataGrid_SetCellBool( g, 0, 3, true ) : tkDataGrid_SetCellBool( g, 1, 3, false )
    dim as TKDATE d
    d.wYear = 2026 : d.wMonth = 11 : d.wDay = 23
    tkDataGrid_SetCellDate( g, 0, 4, d )
    tkDataGrid_SetCellText( g, 0, 5, "x;y" ) : tkDataGrid_SetCellText( g, 2, 5, "-5" )
end sub

sub RunG7a( byval fScale as single )
    tkTest_Begin( "G7a scale " & fScale )
    dim as TK_HOST ptr h = tkHost_Create( "tkDataGrid selftest G7a", 760, 520, tkHost_FontDir() & TK_FONT_UI, fScale )
    if h = 0 then tkTest_Check( "host", false, *SDL_GetError() ) : exit sub
    dim as TTF_Font ptr f10 = tkHost_OpenFont( h, tkHost_FontDir() & TK_FONT_UI, 10 )
    tkHost_Show( h )
    tkTest_PumpFor( h, 300 )
    dim as TK_WIDGET ptr g = G7Grid( h, f10, 700 )
    G7Fill( g )
    tkTest_PumpFor( h, 60 )
    dim as string NL = chr(13) & chr(10)

    ' ---- CSV: GetCsvText ------------------------------------------------------------------
    dim as TKDG_CSVOPTIONS o
    dim as ustring got = tkDataGrid_GetCsvText( g, o )
    dim as ustring want = "Name,Qty,Price,Done,Due" & NL & _
        "plain,3,1.5,true,2026-11-23" & NL & _
        """a, b"",-5,2.25,false," & NL & _
        """say """"hi"""""",7,,," & NL & _
        """two" & chr(10) & "lines"",1,,," & NL & _
        "=SUM(A1),9,,," & NL
    tkTest_Check( "CSV: visible columns in display order, header, RFC 4180 quoting, EMPTY as nothing, CRLF", got = want, G7Hex( got ) )
    o.bCrLf = false : o.bHeaders = false
    got = tkDataGrid_GetCsvText( g, o )
    tkTest_Check( "CSV: LF record ends, no header", left( got, 28 ) = "plain,3,1.5,true,2026-11-23" & chr(10), G7Hex( left( got, 40 ) ) )
    o.bCrLf = true : o.bHeaders = true
    ' formatted (CellFormatting) vs invariant
    tkDataGrid_SetCellFormattingCallback( g, @G7Fmt )
    got = tkDataGrid_GetCsvText( g, o )
    tkTest_Check( "CSV formatted: CellFormatting's text", instr( got, "plain,3,$1.5," ) > 0, G7Hex( left( got, 60 ) ) )
    o.bFormatted = false
    got = tkDataGrid_GetCsvText( g, o )
    tkTest_Check( "CSV invariant: the value, not the formatting", instr( got, "plain,3,1.5," ) > 0, G7Hex( left( got, 60 ) ) )
    o.bFormatted = true
    tkDataGrid_SetCellFormattingCallback( g, 0 )
    ' all columns, separator
    o.bAllColumns = true : o.sep = ";"
    got = tkDataGrid_GetCsvText( g, o )
    tkTest_Check( "CSV bAllColumns + ';': the hidden column too; a field with ';' quoted, one with ',' not", _
                  left( got, len( "Name;Qty;Price;Done;Due;Notes" ) ) = "Name;Qty;Price;Done;Due;Notes" _
                  andalso (instr( got, "plain;3;1.5;true;2026-11-23;""x;y""" ) > 0) andalso (instr( got, NL & "a, b;-5;" ) > 0), G7Hex( left( got, 120 ) ) )
    o.bAllColumns = false : o.sep = ""
    got = tkDataGrid_GetCsvText( g, o )
    tkTest_Check( "CSV: an empty separator is ','", left( got, 9 ) = "Name,Qty,", G7Hex( left( got, 20 ) ) )
    ' display order follows a reorder
    tkDataGrid_SetDisplayIndex( g, 1, 0 )
    got = tkDataGrid_GetCsvText( g, o )
    tkTest_Check( "CSV: display order after a reorder", left( got, 15 ) = "Qty,Name,Price,", G7Hex( left( got, 20 ) ) )
    tkDataGrid_SetDisplayIndex( g, 1, 1 )
    ' the view: sorted and filtered
    tkDataGrid_SetSortMode( g, TKDG_SORT_INTERNAL )
    G4Keys1( g, 1, true )                              ' Qty descending: 9 7 3 1 -5
    tkDataGrid_SetQuickFilter( g, "a" )                ' keeps plain, "a, b", "say ""hi""" (no: lines? "two lines" has no a), =SUM(A1)
    o.bHeaders = false
    got = tkDataGrid_GetCsvText( g, o )
    dim as integer nRec = 0
    for k as integer = 0 to len( got ) - 1
        if got[k] = 10 then nRec += 1
    next
    tkTest_Check( "CSV: the view's rows in view order (sort + quick filter)", _
                  (left( got, 8 ) = "=SUM(A1)") andalso (instr( got, NL & """say" ) > instr( got, "=SUM" )) _
                  andalso (instr( got, NL & "plain" ) > instr( got, NL & """say" )) andalso (instr( got, NL & """a, b""" ) > instr( got, NL & "plain" )) _
                  andalso (nRec = tkDataGrid_GetViewCount( g )), G7Hex( got ) )
    tkDataGrid_SetQuickFilter( g, "" )
    tkDataGrid_ClearSort( g )
    tkDataGrid_SetSortMode( g, TKDG_SORT_NONE )
    ' the selection
    tkDataGrid_SelectRange( g, 1, 1, 2, 2 )
    o.bSelectedOnly = true : o.bHeaders = true
    got = tkDataGrid_GetCsvText( g, o )
    tkTest_Check( "CSV bSelectedOnly (a cell rectangle): its rows and columns", got = "Qty,Price" & NL & "-5,2.25" & NL & "7," & NL, G7Hex( got ) )
    tkDataGrid_SelectRange( g, 0, 0, 0, 0 )
    tkDataGrid_SelectRange( g, 2, 1, 2, 1, true )
    got = tkDataGrid_GetCsvText( g, o )
    tkTest_Check( "CSV bSelectedOnly (two rectangles): a cell outside them is an empty field", _
                  got = "Name,Qty" & NL & "plain," & NL & ",7" & NL, G7Hex( got ) )
    tkDataGrid_SelectRows( g, 3, 3 )
    got = tkDataGrid_GetCsvText( g, o )
    tkTest_Check( "CSV bSelectedOnly (a whole row): every visible column", got = "Name,Qty,Price,Done,Due" & NL & """two" & chr(10) & "lines"",1,,," & NL, G7Hex( got ) )
    o.bSelectedOnly = false
    tkDataGrid_ClearSelection( g )
    ' the formula guard: TEXT values only
    o.bGuardFormulas = true : o.bAllColumns = true : o.bHeaders = false
    got = tkDataGrid_GetCsvText( g, o )
    tkTest_Check( "CSV bGuardFormulas: ' before a text =..., and a text -5; the INT -5 stays", _
                  (instr( got, NL & "'=SUM(A1),9," ) > 0) andalso (instr( got, ",7,,,,'-5" & NL ) > 0) andalso (instr( got, ",-5,2.25," ) > 0), G7Hex( got ) )
    o.bGuardFormulas = false : o.bAllColumns = false : o.bHeaders = true
    ' the new row is not exported
    tkDataGrid_SetAllowAddRows( g, true )
    got = tkDataGrid_GetCsvText( g, o )
    tkTest_Check( "CSV: the placeholder new row is not a record", got = want, G7Hex( right( got, 40 ) ) )
    tkDataGrid_SetAllowAddRows( g, false )

    ' ---- CSV: ExportCsv -------------------------------------------------------------------
    dim as ustring tmpDir = fs.TempDir( ).Value( )
    dim as ustring path = tmpDir & "/tkdg_g7a.csv"
    tkDataGrid_SetCellText( g, 0, 0, "caf" & wchr( &hE9 ) )
    want = tkDataGrid_GetCsvText( g, o )
    dim as boolean okExp = tkDataGrid_ExportCsv( g, path, o )
    dim as containers.Array( of ubyte ) bytes
    dim as longint nb = 0
    if okExp then nb = fs.ReadAllBytes( path, bytes ).Value( )
    tkTest_Check( "ExportCsv: TRUE; the file starts with the UTF-8 BOM", okExp andalso (nb > 3) andalso (bytes[0] = &hEF) andalso (bytes[1] = &hBB) andalso (bytes[2] = &hBF), _
                  "ok=" & okExp & " n=" & nb & " " & tkDataGrid_GetExportError( g ) )
    ' after the BOM: UTF-8 of exactly GetCsvText (cafe with an e-acute: 63 61 66 C3 A9)
    dim as boolean sameBytes = false
    if nb > 3 then
        dim as ustring body = fs.ReadAllText( path ).Value( )
        if (len( body ) > 0) andalso (body[0] = &hFEFF) then body = mid( body, 2 )
        sameBytes = (body = want) andalso (nb >= 3 + 5 + 23)
        dim as integer at = 3 + len( "Name,Qty,Price,Done,Due" ) + 2
        sameBytes = sameBytes andalso (bytes[at] = &h63) andalso (bytes[at + 3] = &hC3) andalso (bytes[at + 4] = &hA9)
    end if
    tkTest_Check( "ExportCsv: the same records as GetCsvText, as UTF-8", sameBytes, "n=" & nb )
    o.bBom = false
    okExp = tkDataGrid_ExportCsv( g, path, o )
    nb = 0
    if okExp then nb = fs.ReadAllBytes( path, bytes ).Value( )
    tkTest_Check( "ExportCsv bBom FALSE: no BOM", okExp andalso (nb > 0) andalso (bytes[0] = asc( "N" )), "n=" & nb )
    o.bBom = true
    fs.RemoveFile( path )
    okExp = tkDataGrid_ExportCsv( g, tmpDir & "/no_such_dir_tkdg/x.csv", o )
    tkTest_Check( "ExportCsv to a folder that does not exist: FALSE, GetExportError says why", (okExp = false) andalso (len( tkDataGrid_GetExportError( g ) ) > 0), _
                  tkDataGrid_GetExportError( g ) )
    ' a million virtual rows: each cell read once, streamed
    dim as TK_WIDGET ptr gv = tkDataGrid_Create( tkHost_Root( h ), 710 )
    tkWidget_SetPos( gv, tkHost_Scale( h, 10 ), tkHost_Scale( h, 320 ), tkHost_Scale( h, 300 ), tkHost_Scale( h, 150 ) )
    tkDataGrid_AddColumnEx( gv, "N", TKDG_COL_NUMBER, 60, TKDG_INT )
    tkDataGrid_AddColumnEx( gv, "T", TKDG_COL_TEXT, 60 )
    tkDataGrid_AddColumnEx( gv, "F", TKDG_COL_NUMBER, 60, TKDG_FLOAT )
    tkDataGrid_SetCellValueNeededCallback( gv, @G7NeedCell )
    tkDataGrid_SetVirtual( gv, true )
    tkDataGrid_SetRowCount( gv, 1000000 )
    tkTest_PumpFor( h, 60 )
    g7Need = 0
    dim as double t0 = timer
    okExp = tkDataGrid_ExportCsv( gv, path, o )
    dim as double tExp = timer - t0
    dim as boolean lastOk = false
    dim as longint nLines = 0
    if okExp then
        nb = fs.ReadAllBytes( path, bytes ).Value( )
        for k as longint = 0 to nb - 1
            if bytes[k] = 10 then nLines += 1
        next
        dim as ustring tail_ = right( fs.ReadAllText( path ).Value( ), 30 )
        lastOk = right( tail_, len( "999999,r999999,249999.75" ) + 2 ) = "999999,r999999,249999.75" & NL
    end if
    tkTest_Check( "ExportCsv, 1M virtual rows: header + 1M records; CellValueNeeded once per cell (3M)", _
                  okExp andalso (nLines = 1000001) andalso (g7Need = 3000000) andalso lastOk, _
                  "lines=" & nLines & " needs=" & g7Need & " " & tkDataGrid_GetExportError( gv ) )
    print "  (G7a) 1M-row x 3-col ExportCsv: " & cint( tExp * 1000 ) & " ms, " & nb & " bytes"
    fs.RemoveFile( path )
    tkWidget_Destroy( gv )
    tkDataGrid_SetCellText( g, 0, 0, "plain" )

    ' ---- the column chooser ---------------------------------------------------------------
    tkDataGrid_SetColumnVisibilityChangedCallback( g, @G7Vis )
    tkDataGrid_SetColumnResizeCallback( g, @G7Res )
    tkDataGrid_SetCurrentCellChangedCallback( g, @G7Cur )
    tkDataGrid_SetContextMenuCallback( g, @G7Cm )
    g7CmN = 0
    G7RightHeader( h, g, 1 )
    tkTest_Check( "chooser off: a header right-click fires ContextMenu( -1, col ), no menu", (g7CmN = 1) andalso (g7CmRow = -1) andalso (g7CmCol = 1) _
                  andalso (g7CmKey = false) andalso (tkDataGrid_GetChooserMenu( g ) = 0), "n=" & g7CmN & " row=" & g7CmRow & " col=" & g7CmCol )
    tkDataGrid_SetColumnChooser( g, true )
    g7CmN = 0
    G7RightHeader( h, g, 1 )
    dim as TK_MENU ptr cm = tkDataGrid_GetChooserMenu( g )
    tkTest_Check( "chooser on: a header right-click opens it; no ContextMenu", (cm <> 0) andalso tkPopupMenu_IsOpen( cm ) andalso (g7CmN = 0) )
    ' six columns, separator, three actions; checks = shown
    dim as boolean itemsOk = (cm <> 0) andalso (tkPopupMenu_GetItemCount( cm ) = 10)
    if itemsOk then
        itemsOk = (cm->items(0).wszCaption = "Name") andalso cm->items(0).isChecked andalso (cm->items(5).wszCaption = "Notes") _
                  andalso (cm->items(5).isChecked = false) andalso cm->items(6).isSeparator andalso (cm->items(7).wszCaption = "Best fit") _
                  andalso (cm->items(7).isDisabled = false) andalso (cm->items(9).isDisabled = false)
    end if
    tkTest_Check( "chooser: a checked item per column in display order, then Best fit / Best fit (all) / Show all", itemsOk, _
                  iif( cm <> 0, "" & tkPopupMenu_GetItemCount( cm ), "no menu" ) )
    ' Escape: closed, nothing changed
    g7VisN = 0
    tkTest_PushKey( h, SDLK_ESCAPE )
    tkTest_PumpFor( h, 60 )
    tkTest_Check( "chooser: Escape closes it, nothing changes", (tkPopupMenu_IsOpen( cm ) = false) andalso (g7VisN = 0) andalso tkDataGrid_GetColumnVisible( g, 1 ) )
    ' hide Qty from the menu: Price moves left by Qty's width
    tkDataGrid_SetCurrentCell( g, 2, 1 )
    tkTest_PumpFor( h, 30 )
    dim as integer xQty = G7ColX( g, 1 ), xPrice = G7ColX( g, 2 ), wQty = tkHost_Scale( h, 60 )
    g7VisN = 0 : g7CurN = 0
    G7RightHeader( h, g, 1 )
    G7ClickItem( h, cm, 1 )
    tkTest_Check( "chooser: hiding Qty fires ColumnVisibilityChanged( 1, FALSE ) once", (g7VisN = 1) andalso (g7VisCol = 1) andalso (g7VisOn = false) _
                  andalso (tkDataGrid_GetColumnVisible( g, 1 ) = false) andalso (tkPopupMenu_IsOpen( cm ) = false), "n=" & g7VisN )
    tkTest_Check( "chooser: Price now starts where Qty did (geometry)", (G7ColX( g, 2 ) = xQty) andalso (xPrice - xQty = wQty), _
                  "Qty was " & xQty & ", Price " & xPrice & " -> " & G7ColX( g, 2 ) )
    tkTest_Check( "chooser: the current cell leaves the hidden column for the next shown one (CurrentCellChanged)", _
                  CurIs( g, 2, 2 ) andalso (g7CurN = 1), CurStr( g ) & " events=" & g7CurN )
    ' the CSV follows
    o.bHeaders = true
    got = tkDataGrid_GetCsvText( g, o )
    tkTest_Check( "chooser + CSV: a column hidden by the user is not exported", left( got, 21 ) = "Name,Price,Done,Due" & NL, G7Hex( left( got, 30 ) ) )
    ' the last shown column cannot be hidden
    tkDataGrid_SetColumnVisible( g, 2, false ) : tkDataGrid_SetColumnVisible( g, 3, false ) : tkDataGrid_SetColumnVisible( g, 4, false )
    tkTest_PumpFor( h, 30 )
    G7RightHeader( h, g, 0 )
    tkTest_Check( "chooser: the last shown column's item is disabled", tkPopupMenu_IsOpen( cm ) andalso cm->items(0).isChecked andalso cm->items(0).isDisabled )
    g7VisN = 0
    G7ClickItem( h, cm, 0 )
    tkTest_Check( "chooser: clicking it hides nothing", (g7VisN = 0) andalso tkDataGrid_GetColumnVisible( g, 0 ), "n=" & g7VisN )
    if tkPopupMenu_IsOpen( cm ) then tkPopupMenu_CloseChain( cm ) : tkTest_PumpFor( h, 30 )
    ' Show all columns: one event per column it showed
    G7RightHeader( h, g, 0 )
    g7VisN = 0
    G7ClickItem( h, cm, 9 )
    tkTest_Check( "chooser: Show all columns shows the five hidden ones, one event each", (g7VisN = 5) andalso tkDataGrid_GetColumnVisible( g, 1 ) _
                  andalso tkDataGrid_GetColumnVisible( g, 5 ), "n=" & g7VisN )
    tkDataGrid_SetColumnVisible( g, 5, false )
    tkTest_PumpFor( h, 30 )
    ' Best fit the column right-clicked
    tkDataGrid_SetColumnWidth( g, 0, 30 )
    tkTest_PumpFor( h, 30 )
    g7ResN = 0
    G7RightHeader( h, g, 0 )
    G7ClickItem( h, cm, 7 )
    dim as integer wFit = tkDataGrid_GetColumnWidth( g, 0 )
    tkTest_Check( "chooser: Best fit widens Name and fires ColumnResize( 0, w, FALSE )", (wFit > 30) andalso (g7ResN = 1) andalso (g7ResCol = 0) _
                  andalso (g7ResW = wFit) andalso (g7ResLive = false), "w=" & wFit & " n=" & g7ResN )
    tkTest_Check( "chooser: Best fit = what AutoSizeColumn gives", tkDataGrid_AutoSizeColumn( g, 0 ) = wFit )
    ' Best fit (all columns): one ColumnResize per shown column
    g7ResN = 0
    G7RightHeader( h, g, 2 )
    G7ClickItem( h, cm, 8 )
    tkTest_Check( "chooser: Best fit (all columns) fires ColumnResize for each of the 5 shown columns", g7ResN = 5, "n=" & g7ResN )
    ' past the last column: Best fit has no column
    G7RightHeader( h, g, -1 )
    tkTest_Check( "chooser from past the last column: Best fit disabled", tkPopupMenu_IsOpen( cm ) andalso cm->items(7).isDisabled )
    tkPopupMenu_CloseChain( cm ) : tkTest_PumpFor( h, 30 )
    ' localized texts
    tkDataGrid_SetChooserTexts( g, "Ajuster", "", "Tout afficher" )
    G7RightHeader( h, g, 0 )
    tkTest_Check( "SetChooserTexts: given texts replace, '' keeps", (cm->items(7).wszCaption = "Ajuster") _
                  andalso (cm->items(8).wszCaption = "Best fit (all columns)") andalso (cm->items(9).wszCaption = "Tout afficher") )
    tkPopupMenu_CloseChain( cm ) : tkTest_PumpFor( h, 30 )
    ' the MessageCallback takes the right-click first
    tkDataGrid_SetMessageCallback( g, @G7Msg )
    g7EatRight = true
    G7RightHeader( h, g, 0 )
    tkTest_Check( "a MessageCallback that returns TRUE on the release keeps the chooser shut", tkPopupMenu_IsOpen( cm ) = false )
    g7EatRight = false
    tkDataGrid_SetMessageCallback( g, 0 )
    tkDataGrid_SetColumnChooser( g, false )

    ' ---- the context menu -----------------------------------------------------------------
    g7CmN = 0
    dim as single cx, cy
    CellXY( g, 3, 2, cx, cy )
    tkTest_Click( h, cx, cy, SDL_BUTTON_RIGHT )
    tkTest_PumpFor( h, 30 )
    tkTest_Check( "a cell right-click fires ContextMenu( row, col ) at the click, in window pixels", (g7CmN = 1) andalso (g7CmRow = 3) andalso (g7CmCol = 2) _
                  andalso (abs( g7CmX - cx ) <= 1) andalso (abs( g7CmY - cy ) <= 1) andalso (g7CmKey = false), _
                  g7CmN & " (" & g7CmRow & "," & g7CmCol & ") at " & g7CmX & "," & g7CmY & " want " & cx & "," & cy )
    tkDataGrid_SetCurrentCell( g, 1, 4 )
    tkHost_SetFocus( h, tkDataGrid_GetSurface( g ) )
    tkTest_PumpFor( h, 30 )
    dim as TKRECT rcCur
    tkDataGrid_GetCellRect( g, 1, 4, rcCur )
    dim as single kx, ky
    SurfXY( g, rcCur.left, rcCur.bottom, kx, ky )
    g7CmN = 0
    tkTest_PushKey( h, SDLK_APPLICATION )
    tkTest_PumpFor( h, 30 )
    tkTest_Check( "the Menu key: ContextMenu( current row, col, its bottom-left, keyboard )", (g7CmN = 1) andalso (g7CmRow = 1) andalso (g7CmCol = 4) _
                  andalso (g7CmX = clng( kx )) andalso (g7CmY = clng( ky )) andalso g7CmKey, _
                  g7CmN & " (" & g7CmRow & "," & g7CmCol & ") at " & g7CmX & "," & g7CmY & " want " & kx & "," & ky )
    g7CmN = 0
    tkTest_PushKey( h, SDLK_F10, SDL_KMOD_SHIFT )
    tkTest_PumpFor( h, 30 )
    tkTest_Check( "Shift+F10 does the same", (g7CmN = 1) andalso g7CmKey, "n=" & g7CmN )

    ' ---- the layout string ----------------------------------------------------------------
    tkDataGrid_SetDisplayIndex( g, 4, 0 )              ' Due first
    tkDataGrid_SetColumnWidth( g, 2, 95 )
    tkDataGrid_SetColumnVisible( g, 3, false )
    tkDataGrid_SetFrozenColumns( g, 2 )
    tkDataGrid_SetSortMode( g, TKDG_SORT_INTERNAL )
    dim as TKDG_SORTKEY sk(0 to 1)
    sk(0).col = 1 : sk(0).bDescending = true : sk(1).col = 0 : sk(1).bDescending = false
    tkDataGrid_SetSortKeys( g, sk() )
    tkTest_PumpFor( h, 30 )
    dim as integer w0 = tkDataGrid_GetColumnWidth( g, 0 ), w1 = tkDataGrid_GetColumnWidth( g, 1 ), w3 = tkDataGrid_GetColumnWidth( g, 3 )
    dim as integer w4 = tkDataGrid_GetColumnWidth( g, 4 )
    dim as ustring lay = tkDataGrid_GetLayout( g )
    dim as ustring layWant = "tkdg1;frozen=2;frows=0;sort=Qty:d,Name:a;cols=Due:" & w4 & ":1,Name:" & w0 & ":1,Qty:" & w1 & ":1,Price:95:1,Done:" & w3 & ":0,Notes:120:0"
    tkTest_Check( "GetLayout: frozen, sort keys, then each column in display order (key:width:shown)", lay = layWant, lay )
    ' a second grid, columns added in another order, gets the same layout
    dim as TK_WIDGET ptr g2 = tkDataGrid_Create( tkHost_Root( h ), 720 )
    tkDataGrid_SetFont( g2, f10 )
    tkDataGrid_SetBorderWidth( g2, 0 )
    tkWidget_SetPos( g2, tkHost_Scale( h, 10 ), tkHost_Scale( h, 320 ), tkHost_Scale( h, 640 ), tkHost_Scale( h, 180 ) )
    tkDataGrid_AddColumnEx( g2, "Notes", TKDG_COL_TEXT, 10 )
    tkDataGrid_AddColumnEx( g2, "Price", TKDG_COL_NUMBER, 10, TKDG_FLOAT )
    tkDataGrid_AddColumnEx( g2, "Name", TKDG_COL_TEXT, 10 )
    tkDataGrid_AddColumnEx( g2, "Qty", TKDG_COL_NUMBER, 10, TKDG_INT )
    tkDataGrid_AddColumnEx( g2, "Due", TKDG_COL_DATE, 10, TKDG_DATE )
    tkDataGrid_AddColumnEx( g2, "Done", TKDG_COL_CHECK, 10, TKDG_BOOL )
    tkDataGrid_SetSortMode( g2, TKDG_SORT_INTERNAL )
    dim as boolean okSet = tkDataGrid_SetLayout( g2, lay )
    tkTest_PumpFor( h, 30 )
    dim as ustring lay2 = tkDataGrid_GetLayout( g2 )
    tkTest_Check( "SetLayout on a grid whose columns were added in another order: GetLayout gives it back", okSet andalso (lay2 = lay), lay2 )
    ' geometry: each column's offset from the grid's left edge is the same in both grids
    dim as boolean geomOk = true
    dim as string geomDet
    dim as string names_(0 to 4) = { "Due", "Name", "Qty", "Price", "Done" }
    for k as integer = 0 to 4
        dim as integer c1 = tkDataGrid_FindColumn( g, names_(k) ), c2 = tkDataGrid_FindColumn( g2, names_(k) )
        dim as integer x1 = G7ColX( g, c1 ), x2 = G7ColX( g2, c2 )
        if x1 <> x2 then geomOk = false : geomDet &= names_(k) & " " & x1 & "/" & x2 & " "
    next
    tkTest_Check( "SetLayout: the same column x positions (frozen 2, Done hidden)", geomOk andalso (tkDataGrid_GetFrozenColumns( g2 ) = 2) _
                  andalso (tkDataGrid_GetFrozenWidthPx( g2 ) = tkDataGrid_GetFrozenWidthPx( g )), geomDet )
    dim as TKDG_SORTKEY sk2( any )
    dim as integer nk = tkDataGrid_GetSortKeys( g2, sk2() )
    tkTest_Check( "SetLayout: the sort keys, by key", (nk = 2) andalso (sk2(0).col = tkDataGrid_FindColumn( g2, "Qty" )) andalso sk2(0).bDescending _
                  andalso (sk2(1).col = tkDataGrid_FindColumn( g2, "Name" )) andalso (sk2(1).bDescending = false), "n=" & nk )
    ' tolerant reading: unknown names skipped, unnamed columns keep their place after the named
    okSet = tkDataGrid_SetLayout( g2, "tkdg1;cols=Gone:50:1,Qty:66:1;frozen=0;sort=" )
    tkTest_Check( "SetLayout: an unknown column is skipped; the rest follow the named one in their order", okSet _
                  andalso (tkDataGrid_ColumnAtDisplay( g2, 0 ) = tkDataGrid_FindColumn( g2, "Qty" )) andalso (tkDataGrid_GetColumnWidth( g2, tkDataGrid_FindColumn( g2, "Qty" ) ) = 66) _
                  andalso (tkDataGrid_ColumnAtDisplay( g2, 1 ) = tkDataGrid_FindColumn( g2, "Due" )) andalso (tkDataGrid_GetSortKeys( g2, sk2() ) = 0) _
                  andalso (tkDataGrid_GetFrozenColumns( g2 ) = 0), tkDataGrid_GetLayout( g2 ) )
    lay2 = tkDataGrid_GetLayout( g2 )
    tkTest_Check( "SetLayout refuses a string that is not a layout, and changes nothing", (tkDataGrid_SetLayout( g2, "cols=Qty:1:0" ) = false) _
                  andalso (tkDataGrid_SetLayout( g2, "" ) = false) andalso (tkDataGrid_GetLayout( g2 ) = lay2) )
    tkDataGrid_SetLayout( g2, "tkdg1;cols=Notes:10:0,Price:10:0,Name:10:0,Qty:10:0,Due:10:0,Done:10:0" )
    tkTest_Check( "SetLayout that hides every column shows the first", (tkDataGrid_GetColumnVisible( g2, 0 ) = true) _
                  andalso (tkDataGrid_GetColumnVisible( g2, 1 ) = false), tkDataGrid_GetLayout( g2 ) )
    ' keys with the separators in them, and a column with no key
    dim as TK_WIDGET ptr g3 = tkDataGrid_Create( tkHost_Root( h ), 730 )
    dim as TKDATAGRID_COLUMN c3
    c3.key = "a;b:c,d=%#" : c3.caption = "odd" : c3.width = 40
    tkDataGrid_AddColumn( g3, c3 )
    c3.key = "" : c3.caption = "nokey" : c3.width = 50
    tkDataGrid_AddColumn( g3, c3 )
    dim as ustring lay3 = tkDataGrid_GetLayout( g3 )
    tkTest_Check( "GetLayout: a key's separators are %XX; a column with no key is #index", _
                  lay3 = "tkdg1;frozen=0;frows=0;sort=;cols=a%3Bb%3Ac%2Cd%3D%25%23:40:1,#1:50:1", lay3 )
    tkDataGrid_SetDisplayIndex( g3, 1, 0 ) : tkDataGrid_SetColumnWidth( g3, 0, 41 )
    okSet = tkDataGrid_SetLayout( g3, lay3 )
    tkTest_Check( "SetLayout decodes them back", okSet andalso (tkDataGrid_GetLayout( g3 ) = lay3), tkDataGrid_GetLayout( g3 ) )
    ' silent: no events from SetLayout
    tkDataGrid_SetColumnVisibilityChangedCallback( g2, @G7Vis )
    tkDataGrid_SetColumnResizeCallback( g2, @G7Res )
    g7VisN = 0 : g7ResN = 0
    tkDataGrid_SetLayout( g2, lay )
    tkTest_Check( "SetLayout is silent", (g7VisN = 0) andalso (g7ResN = 0) )
    tkHost_Destroy( h )
end sub
