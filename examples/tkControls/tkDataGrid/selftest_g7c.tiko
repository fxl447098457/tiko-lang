' tkDataGrid self-test, phase G7c: column filters and the filter row. Included by selftest.tiko.

dim shared as integer g7cChanged, g7cSrcFilterN, g7cSrcCols, g7cSrcRows
dim shared as boolean g7cSrcCleared

sub G7cOnChanged( byval hg as TK_WIDGET ptr )
    g7cChanged += 1
end sub

function G7cSrcCount( byval ctx as any ptr ) as integer
    return g7cSrcRows
end function
sub G7cSrcGet( byval ctx as any ptr, byval row as integer, byval col as integer, byref v as TKDG_VALUE )
    v.SetInt( row )
end sub
function G7cSrcFilter( byval ctx as any ptr, byval filters as TKDG_COLFILTER ptr, byval nCols as integer ) as boolean
    g7cSrcFilterN += 1
    g7cSrcCols = nCols
    if (filters = 0) orelse (nCols = 0) then
        g7cSrcCleared = true
        g7cSrcRows = 40
    else
        g7cSrcRows = 7                       ' "the database" kept 7 rows
    end if
    return true
end function

function G7cParse( byval g as TK_WIDGET ptr, byval col as integer, byref t as const ustring, byval op as long ) as boolean
    dim as TKDG_COLFILTER f
    if tkDataGrid_ParseFilterText( g, col, t, f ) = false then return false
    return f.op = op
end function

function G7cBad( byval g as TK_WIDGET ptr, byval col as integer, byref t as const ustring ) as boolean
    dim as TKDG_COLFILTER f
    return tkDataGrid_ParseFilterText( g, col, t, f ) = false
end function

' 60 rows: N = row (int), T = text, F = row / 4 (every 5th EMPTY), D = 2026-mm-dd, B = check.
function G7cGrid( byval h as TK_HOST ptr, byval f10 as TTF_Font ptr, byval id as long ) as TK_WIDGET ptr
    dim as TK_WIDGET ptr g = tkDataGrid_Create( tkHost_Root( h ), id )
    tkDataGrid_SetFont( g, f10 )
    tkDataGrid_SetBorderWidth( g, 0 )
    tkWidget_SetPos( g, tkHost_Scale( h, 10 ), tkHost_Scale( h, 10 ), tkHost_Scale( h, 420 ), tkHost_Scale( h, 300 ) )
    tkDataGrid_AddColumnEx( g, "N", TKDG_COL_NUMBER, 60, TKDG_INT )
    tkDataGrid_AddColumnEx( g, "T", TKDG_COL_TEXT, 90 )
    tkDataGrid_AddColumnEx( g, "F", TKDG_COL_NUMBER, 70, TKDG_FLOAT )
    tkDataGrid_AddColumnEx( g, "D", TKDG_COL_DATE, 110, TKDG_DATE )
    tkDataGrid_AddColumnEx( g, "B", TKDG_COL_CHECK, 50, TKDG_BOOL )
    tkDataGrid_AddColumnEx( g, "X", TKDG_COL_TEXT, 200 )
    tkDataGrid_SetSortMode( g, TKDG_SORT_INTERNAL )
    tkDataGrid_BeginUpdate( g )
    tkDataGrid_SetRowCount( g, 60 )
    dim as string words(0 to 3) = { "Apple", "apricot", "banana", "Cherry" }
    for r as integer = 0 to 59
        tkDataGrid_SetCellInt( g, r, 0, r )
        tkDataGrid_SetCellText( g, r, 1, words( r mod 4 ) )
        if (r mod 5) <> 0 then tkDataGrid_SetCellFloat( g, r, 2, r / 4 )
        dim as TKDATE d
        d.wYear = 2026 : d.wMonth = 1 + (r mod 12) : d.wDay = 1 + (r mod 28)
        tkDataGrid_SetCellDate( g, r, 3, d )
        tkDataGrid_SetCellBool( g, r, 4, (r mod 3) = 0 )
    next
    tkDataGrid_EndUpdate( g )
    return g
end function

sub RunG7c( byval fScale as single )
    tkTest_Begin( "G7c scale " & fScale )
    dim as TK_HOST ptr h = tkHost_Create( "tkDataGrid selftest G7c", 760, 560, tkHost_FontDir() & TK_FONT_UI, fScale )
    if h = 0 then tkTest_Check( "host", false, *SDL_GetError() ) : exit sub
    dim as TTF_Font ptr f10 = tkHost_OpenFont( h, tkHost_FontDir() & TK_FONT_UI, 10 )
    tkHost_Show( h )
    tkTest_PumpFor( h, 300 )
    dim as TK_WIDGET ptr g = G7cGrid( h, f10, 1000 )
    dim as TK_WIDGET ptr s = tkDataGrid_GetSurface( g )
    tkTest_PumpFor( h, 60 )
    dim as integer rowH = tkDataGrid_GetRowHeightPx( g ), hdrH = tkDataGrid_GetHeaderHeightPx( g )

    ' ---- the syntax ------------------------------------------------------------------------------
    dim as TKDG_COLFILTER f
    tkTest_Check( "syntax, text column: abc contains, =abc equals, ^ab starts, <>x and !=x not equal", G7cParse( g, 1, "app", TKDG_FLT_CONTAINS ) _
                  andalso G7cParse( g, 1, "=apple", TKDG_FLT_EQ ) andalso G7cParse( g, 1, "^ap", TKDG_FLT_STARTS ) _
                  andalso G7cParse( g, 1, "<>x", TKDG_FLT_NE ) andalso G7cParse( g, 1, "!=x", TKDG_FLT_NE ) )
    tkTest_Check( "syntax: two quotes = empty, ! and two quotes = not empty, nothing = no filter", G7cParse( g, 1, """""", TKDG_FLT_EMPTY ) _
                  andalso G7cParse( g, 2, "!""""", TKDG_FLT_NOTEMPTY ) andalso G7cParse( g, 0, "  ", TKDG_FLT_NONE ) )
    tkDataGrid_ParseFilterText( g, 0, ">100", f )
    dim as boolean gtInt = (f.op = TKDG_FLT_GT) andalso (f.v1.kind = TKDG_INT) andalso (f.v1.i = 100)
    tkTest_Check( "syntax, number column: a bare value equals; > >= < <= read the number as the column's kind", gtInt _
                  andalso G7cParse( g, 0, "5", TKDG_FLT_EQ ) andalso G7cParse( g, 0, ">=1", TKDG_FLT_GE ) _
                  andalso G7cParse( g, 0, "<0", TKDG_FLT_LT ) andalso G7cParse( g, 0, "<= 3", TKDG_FLT_LE ) )
    tkDataGrid_ParseFilterText( g, 0, "3..7", f )
    tkTest_Check( "syntax: a..b between", (f.op = TKDG_FLT_BETWEEN) andalso (f.v1.i = 3) andalso (f.v2.i = 7) )
    tkDataGrid_ParseFilterText( g, 3, ">2026-03-01", f )
    dim as boolean dOk = (f.op = TKDG_FLT_GT) andalso (f.v1.kind = TKDG_DATE) andalso (f.v1.d.wMonth = 3)
    tkDataGrid_ParseFilterText( g, 4, "yes", f )
    tkTest_Check( "syntax: dates as ISO dates, a check column as true / yes / no", dOk andalso (f.op = TKDG_FLT_EQ) andalso (f.v1.kind = TKDG_BOOL) andalso f.v1.b _
                  andalso G7cParse( g, 2, "1.5", TKDG_FLT_EQ ) )
    tkTest_Check( "syntax: what does not read for the column is refused", G7cBad( g, 0, ">abc" ) andalso G7cBad( g, 0, ">" ) _
                  andalso G7cBad( g, 0, "3..x" ) andalso G7cBad( g, 3, "2026-13-01" ) andalso G7cBad( g, 4, "maybe" ) andalso G7cBad( g, 2, "1,5" ) )

    ' ---- applying ------------------------------------------------------------------------------
    tkDataGrid_SetFilterChangedCallback( g, @G7cOnChanged )
    g7cChanged = 0
    dim as boolean okSet = tkDataGrid_SetColumnFilterText( g, 0, ">=50" )
    tkTest_Check( "SetColumnFilterText( N, >=50 ): rows 50..59 shown; the text kept; silent", okSet andalso (tkDataGrid_GetViewCount( g ) = 10) _
                  andalso (tkDataGrid_ViewToModel( g, 0 ) = 50) andalso (tkDataGrid_GetColumnFilterText( g, 0 ) = ">=50") andalso (g7cChanged = 0) )
    tkDataGrid_SetColumnFilterText( g, 1, "=APPLE" )
    tkTest_Check( "two columns AND; text equals without case", tkDataGrid_GetViewCount( g ) = 2, "" & tkDataGrid_GetViewCount( g ) )   ' 52 56 ... -> r mod 4 = 0: 52 56
    tkDataGrid_SetColumnFilterText( g, 1, "^ap" )
    dim as integer nAp = 0
    for r as integer = 50 to 59
        if (r mod 4) <= 1 then nAp += 1
    next
    tkTest_Check( "starts with: Apple and apricot", tkDataGrid_GetViewCount( g ) = nAp, tkDataGrid_GetViewCount( g ) & " want " & nAp )
    tkDataGrid_SetQuickFilter( g, "apricot" )
    tkTest_Check( "and the quick filter too", tkDataGrid_GetViewCount( g ) = 2, "" & tkDataGrid_GetViewCount( g ) )   ' 53 57
    tkDataGrid_SetQuickFilter( g, "" )
    tkDataGrid_ClearColumnFilters( g )
    tkTest_Check( "ClearColumnFilters: every row", (tkDataGrid_GetViewCount( g ) = 60) andalso (tkDataGrid_GetColumnFilterText( g, 0 ) = "") )
    tkDataGrid_SetColumnFilterText( g, 2, """""" )
    tkTest_Check( "empty: the 12 EMPTY cells of F", tkDataGrid_GetViewCount( g ) = 12, "" & tkDataGrid_GetViewCount( g ) )
    tkDataGrid_SetColumnFilterText( g, 2, "" )
    tkDataGrid_SetColumnFilterText( g, 3, "2026-02-01..2026-03-31" )
    dim as integer nD = 0
    for r as integer = 0 to 59
        if ((r mod 12) = 1) orelse ((r mod 12) = 2) then nD += 1
    next
    tkTest_Check( "between two dates", tkDataGrid_GetViewCount( g ) = nD, tkDataGrid_GetViewCount( g ) & " want " & nD )
    tkDataGrid_SetColumnFilterText( g, 3, "" )
    tkDataGrid_SetColumnFilterText( g, 4, "true" )
    tkTest_Check( "a check column: = true", tkDataGrid_GetViewCount( g ) = 20, "" & tkDataGrid_GetViewCount( g ) )
    tkDataGrid_ClearColumnFilters( g )
    ' a text that does not read: kept, filters nothing
    dim as boolean bad = tkDataGrid_SetColumnFilterText( g, 0, ">abc" )
    tkTest_Check( "a filter that does not read: FALSE, kept as text, nothing filtered", (bad = false) andalso (tkDataGrid_GetColumnFilterText( g, 0 ) = ">abc") _
                  andalso (tkDataGrid_GetViewCount( g ) = 60) andalso (tkDataGrid_GetColumnFilter( g, 0, f ) = false) )
    ' SetColumnFilter: the struct, shown as text
    dim as TKDG_COLFILTER cf
    cf.op = TKDG_FLT_LT : cf.v1.SetText( "5" )
    dim as boolean okCf = tkDataGrid_SetColumnFilter( g, 0, cf )
    tkDataGrid_GetColumnFilter( g, 0, f )
    tkTest_Check( "SetColumnFilter: the value converted to the column's kind, the text from it", okCf andalso (f.op = TKDG_FLT_LT) andalso (f.v1.kind = TKDG_INT) _
                  andalso (tkDataGrid_GetColumnFilterText( g, 0 ) = "<5") andalso (tkDataGrid_GetViewCount( g ) = 5) )
    ' sorted and filtered; selection rules (D-6)
    G4Keys1( g, 0, true )
    tkTest_Check( "filter then sort: 4 3 2 1 0", (tkDataGrid_ViewToModel( g, 0 ) = 4) andalso (tkDataGrid_ViewToModel( g, 4 ) = 0) )
    tkDataGrid_ClearSort( g )
    tkDataGrid_SelectRows( g, 2, 3 )
    tkDataGrid_SelectRange( g, 0, 1, 1, 1, true )
    tkDataGrid_SetColumnFilterText( g, 0, "<4" )
    dim as TKDG_RANGE rg( any )
    tkTest_Check( "a filter change keeps whole-row selections and drops cell rectangles (D-6)", tkDataGrid_IsRowSelected( g, 2 ) _
                  andalso (tkDataGrid_GetSelectedRanges( g, rg() ) = 0) )
    tkDataGrid_ClearColumnFilters( g )
    tkDataGrid_ClearSelection( g )

    ' ---- HOST mode and a source ----------------------------------------------------------------------
    dim as TK_WIDGET ptr gv = tkDataGrid_Create( tkHost_Root( h ), 1010 )
    tkWidget_SetPos( gv, tkHost_Scale( h, 440 ), tkHost_Scale( h, 10 ), tkHost_Scale( h, 300 ), tkHost_Scale( h, 200 ) )
    tkDataGrid_AddColumnEx( gv, "N", TKDG_COL_NUMBER, 60, TKDG_INT )
    tkDataGrid_SetCellValueNeededCallback( gv, @G7bNeed )
    tkDataGrid_SetVirtual( gv, true )
    tkDataGrid_SetRowCount( gv, 1000000 )
    tkDataGrid_SetColumnFilterText( gv, 0, ">10" )
    tkTest_Check( "HOST mode: the filter is kept, the grid filters nothing (the host re-queries)", (tkDataGrid_GetViewCount( gv ) = 1000000) _
                  andalso (tkDataGrid_GetColumnFilterText( gv, 0 ) = ">10") )
    tkWidget_Destroy( gv )
    dim as TK_WIDGET ptr gs = tkDataGrid_Create( tkHost_Root( h ), 1020 )
    tkWidget_SetPos( gs, tkHost_Scale( h, 440 ), tkHost_Scale( h, 10 ), tkHost_Scale( h, 300 ), tkHost_Scale( h, 200 ) )
    tkDataGrid_AddColumnEx( gs, "N", TKDG_COL_NUMBER, 60, TKDG_INT )
    tkDataGrid_AddColumnEx( gs, "M", TKDG_COL_NUMBER, 60, TKDG_INT )
    g7cSrcRows = 40 : g7cSrcFilterN = 0 : g7cSrcCleared = false
    dim as TKDATAGRID_SOURCE src
    src.RowCount = @G7cSrcCount : src.GetCell = @G7cSrcGet : src.Filter = @G7cSrcFilter
    tkDataGrid_SetSource( gs, @src )
    tkDataGrid_SetColumnFilterText( gs, 1, "<3" )
    tkTest_Check( "a source's Filter takes the filters (all columns' entries) and its count is asked again; the grid filters nothing itself", _
                  (g7cSrcFilterN = 1) andalso (g7cSrcCols = 2) andalso (tkDataGrid_GetRowCount( gs ) = 7) andalso (tkDataGrid_GetViewCount( gs ) = 7), _
                  g7cSrcFilterN & " " & g7cSrcCols & " " & tkDataGrid_GetRowCount( gs ) )
    tkDataGrid_SetQuickFilter( gs, "" )
    tkTest_Check( "an unrelated view rebuild does not ask the source again", g7cSrcFilterN = 1 )
    tkDataGrid_ClearColumnFilters( gs )
    tkTest_Check( "cleared: the source is told (no filters) and the rows come back", g7cSrcCleared andalso (tkDataGrid_GetRowCount( gs ) = 40) )
    tkWidget_Destroy( gs )

    ' ---- the filter row ----------------------------------------------------------------------------
    tkDataGrid_ShowFilterRow( g, true )
    tkTest_PumpFor( h, 30 )
    dim as TKRECT rc0
    tkDataGrid_GetCellRect( g, 0, 1, rc0 )
    tkTest_Check( "ShowFilterRow: a row-high band; the first row starts under it", tkDataGrid_IsFilterRowVisible( g ) _
                  andalso (tkDataGrid_GetFilterRowHeightPx( g ) = rowH) andalso (rc0.top = hdrH + rowH), "top " & rc0.top )
    dim as TKDG_HITTEST ht
    dim as TKRECT hcT
    tkDataGrid_GetColumnRect( g, 1, hcT )
    tkDataGrid_HitTest( g, hcT.left + 4, hdrH + rowH \ 2, ht )
    tkTest_Check( "HitTest in the band: TKDG_HT_FILTER and the column", (ht.area = TKDG_HT_FILTER) andalso (ht.col = 1) )
    tkDataGrid_SetScrollY( g, 1000000 )
    tkTest_Check( "the scroll range leaves room for the band", tkDataGrid_GetScrollY( g ) = 60 * rowH - (s->ch - hdrH - rowH), "" & tkDataGrid_GetScrollY( g ) )
    tkDataGrid_SetScrollY( g, 0 )
    ' a click opens the editor over the cell, with the focus
    dim as single fx, fy
    SurfXY( g, (hcT.left + hcT.right) \ 2, hdrH + rowH \ 2, fx, fy )
    tkTest_Click( h, fx, fy )
    tkTest_PumpFor( h, 50 )
    dim as TK_WIDGET ptr fe = tkDataGrid_GetFilterEditor( g )
    tkTest_Check( "a click on the band opens the editor on that column, over its cell, focused", (tkDataGrid_GetFilterEditColumn( g ) = 1) _
                  andalso (fe <> 0) andalso (fe->x = hcT.left) andalso (fe->y = hdrH) andalso (fe->cw = hcT.right - hcT.left) andalso (fe->ch = rowH) _
                  andalso (h->pFocus = fe) )
    ' typing applies after the idle wait, once
    g7cChanged = 0
    tkTest_PushText( h, "cher" )
    tkTest_PumpFor( h, 80 )
    dim as integer nEarly = tkDataGrid_GetViewCount( g )
    tkTest_PumpFor( h, 500 )
    tkTest_Check( "typing applies after the idle wait (not at once), FilterChanged once", (nEarly = 60) andalso (tkDataGrid_GetViewCount( g ) = 15) _
                  andalso (g7cChanged = 1), nEarly & " -> " & tkDataGrid_GetViewCount( g ) & ", events " & g7cChanged )
    ' Esc: the text it opened with, editor closed, the grid focused
    tkTest_PushText( h, "zzz" )
    tkTest_PushKey( h, SDLK_ESCAPE )
    tkTest_PumpFor( h, 50 )
    tkTest_Check( "Esc puts back the text the editor opened with, and closes it", (tkDataGrid_GetColumnFilterText( g, 1 ) = "") _
                  andalso (tkDataGrid_GetViewCount( g ) = 60) andalso (tkDataGrid_GetFilterEditColumn( g ) = -1) andalso (h->pFocus = s), _
                  "'" & tkDataGrid_GetColumnFilterText( g, 1 ) & "' " & tkDataGrid_GetViewCount( g ) )
    ' Enter applies at once; Tab moves along the row (no tab character typed)
    tkDataGrid_EditColumnFilter( g, 0 )
    tkTest_PumpFor( h, 30 )
    tkTest_PushText( h, "<10" )
    tkTest_PushKey( h, SDLK_RETURN )
    tkTest_PumpFor( h, 30 )
    dim as integer nEnter = tkDataGrid_GetViewCount( g )
    tkTest_PushKey( h, SDLK_TAB )
    tkTest_PumpFor( h, 50 )
    tkTest_Check( "Enter applies at once; Tab goes to the next column's filter", (nEnter = 10) andalso (tkDataGrid_GetFilterEditColumn( g ) = 1) _
                  andalso (tkTextBox_GetText( fe ) = ""), nEnter & " col " & tkDataGrid_GetFilterEditColumn( g ) & " '" & tkTextBox_GetText( fe ) & "'" )
    tkTest_PushKey( h, SDLK_TAB, SDL_KMOD_SHIFT )
    tkTest_PumpFor( h, 50 )
    tkTest_Check( "Shift+Tab goes back, its text loaded", (tkDataGrid_GetFilterEditColumn( g ) = 0) andalso (tkTextBox_GetText( fe ) = "<10") )
    ' Down: to the first row; Up from the first row: back to the filter
    tkTest_PushKey( h, SDLK_DOWN )
    tkTest_PumpFor( h, 50 )
    tkTest_Check( "Down closes the editor and puts the current cell on the first row", (tkDataGrid_GetFilterEditColumn( g ) = -1) _
                  andalso CurIs( g, 0, 0 ) andalso (h->pFocus = s), CurStr( g ) )
    tkTest_PushKey( h, SDLK_UP )
    tkTest_PumpFor( h, 50 )
    tkTest_Check( "Up on the first row opens that column's filter", (tkDataGrid_GetFilterEditColumn( g ) = 0) andalso (h->pFocus = fe) )
    ' a click in the rows applies what was typed and closes the editor
    tkTest_PushText( h, "0" )                    ' "<100"
    dim as single cx, cy
    CellXY( g, 2, 1, cx, cy )
    tkTest_Click( h, cx, cy )
    tkTest_PumpFor( h, 50 )
    tkTest_Check( "a click in the rows applies the typed text and closes the editor", (tkDataGrid_GetFilterEditColumn( g ) = -1) _
                  andalso (tkDataGrid_GetColumnFilterText( g, 0 ) = "<100") andalso (tkDataGrid_GetViewCount( g ) = 60) )
    ' the editor follows a sideways scroll
    tkDataGrid_EditColumnFilter( g, 5 )
    tkTest_PumpFor( h, 30 )
    tkDataGrid_SetScrollX( g, tkHost_Scale( h, 30 ) )
    tkTest_PumpFor( h, 30 )
    dim as TKRECT hcX
    tkDataGrid_GetColumnRect( g, 5, hcX )
    tkTest_Check( "the editor stays over its column when the columns scroll", (fe->x = hcX.left) andalso (tkDataGrid_GetFilterEditColumn( g ) = 5), _
                  fe->x & " vs " & hcX.left )
    tkTest_PushKey( h, SDLK_ESCAPE )
    tkTest_PumpFor( h, 30 )
    ' paint: the band's back, and a text that does not read in the error colour
    tkDataGrid_SetScrollX( g, 0 )
    tkDataGrid_SetColumnFilterText( g, 0, "" )
    tkHost_RenderTo( h, false )
    dim as TKDATAGRID_COLORS colr
    tkDataGrid_GetColors( g, @colr )
    dim as TKRECT hcB
    tkDataGrid_GetColumnRect( g, 4, hcB )
    tkTest_Check( "the band's back is FilterBackColor", Px( h, g, hcB.left + 3, hdrH + 2 ) = (colr.FilterBackColor and &hFFFFFFul), _
                  hex( Px( h, g, hcB.left + 3, hdrH + 2 ) ) )
    tkHost_Destroy( h )
end sub
