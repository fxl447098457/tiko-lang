' tkDataGrid demo (phases G0 - G2): an order list of 100,000 stored rows in every column kind,
' with alternate rows, a fill column, conditional formatting, hover, both scroll bars, row
' headers, a frozen first column, cell / row selection, the keyboard, column resize / autosize /
' drag-reorder, Ctrl+C / Ctrl+V, tooltips for cut-off text, and editing: F2 or typing, a combo and
' a date editor, check toggles, the dirty row (Esc cancels it), a placeholder row to add one,
' Delete on cells or whole rows.
'
'   demo                     interactive
'   demo --shot out.bmp      render once, save the window, exit
'   demo --scale 1.75        pin the scale instead of asking the display
'   demo --edit 3            open the editor on row 3 of column 3 (with --shot, to see one)
#import "vendor/tkControls/tkDataGrid"
using tkDataGrid
using tkCalendar
using tkTheme
using tkHost
using tkPaint

const as long MARGIN = 12, LABELH = 22
const as long NROWS = 100000

dim shared as TK_HOST ptr gHost
dim shared as TK_WIDGET ptr gGrid
dim shared as ustring gStatus
dim shared as TTF_Font ptr gFont10, gFontBold10
dim shared as integer gColQty, gColTotal

' Totals over 1000 in the warning colour: CellFormatting runs only for the cells on screen.
sub OnFormat( byval f as TKDATAGRID_FORMATINFO ptr )
    if (f->col = gColTotal) andalso (f->value->kind = TKDG_FLOAT) then
        f->text = "$ " & str( cint( f->value->f * 100 ) / 100 )
        if f->value->f > 1000 then f->foreColor = tkTheme_Get().Warning
    end if
end sub

private function Q( byref s as const ustring ) as ustring
    return chr(34) & s & chr(34)
end function

sub OnCurrent( byval hg as TK_WIDGET ptr, byval row as integer, byval col as integer )
    gStatus = "current  row " & row & ", " & Q( tkDataGrid_GetColumnCaption( hg, col ) ) & " = " & tkDataGrid_GetCellText( hg, row, col ) _
              & "     whole rows selected: " & tkDataGrid_GetSelectedRowCount( hg ) & iif( tkDataGrid_IsAllSelected( hg ), "  (all)", "" )
    tkHost_Invalidate( gHost )
end sub

sub OnSelChange( byval hg as TK_WIDGET ptr )
    dim as integer r, c
    tkDataGrid_GetCurrentCell( hg, r, c )
    if r >= 0 then OnCurrent( hg, r, c )
end sub

sub OnColumnClick( byval hg as TK_WIDGET ptr, byval col as integer )
    gStatus = "header click: " & Q( tkDataGrid_GetColumnCaption( hg, col ) ) & " (sorting is G4)"
    tkHost_Invalidate( gHost )
end sub

sub OnReordered( byval hg as TK_WIDGET ptr, byval col as integer, byval dispPos as integer )
    gStatus = Q( tkDataGrid_GetColumnCaption( hg, col ) ) & " moved to position " & dispPos
    tkHost_Invalidate( gHost )
end sub

sub OnResized( byval hg as TK_WIDGET ptr, byval col as integer, byval nWidth as integer, byval bLive as boolean )
    if bLive then exit sub
    gStatus = Q( tkDataGrid_GetColumnCaption( hg, col ) ) & " is " & nWidth & " units wide"
    tkHost_Invalidate( gHost )
end sub

sub OnValueChanged( byval hg as TK_WIDGET ptr, byval row as integer, byval col as integer )
    gStatus = "changed  row " & row & ", " & Q( tkDataGrid_GetColumnCaption( hg, col ) ) & " = " & tkDataGrid_GetCellText( hg, row, col ) _
              & "   (row " & tkDataGrid_GetDirtyRow( hg ) & " is dirty: leave it to commit, Esc to cancel)"
    tkHost_Invalidate( gHost )
end sub

sub OnRowCommitted( byval hg as TK_WIDGET ptr, byval row as integer )
    gStatus = "row " & row & " committed"
    tkHost_Invalidate( gHost )
end sub

sub OnRowCancelled( byval hg as TK_WIDGET ptr, byval row as integer )
    gStatus = "row " & row & " cancelled: its old values are back"
    tkHost_Invalidate( gHost )
end sub

sub OnButton( byval hg as TK_WIDGET ptr, byval row as integer, byval col as integer )
    gStatus = Q( tkDataGrid_GetColumnCaption( hg, col ) ) & " clicked on row " & row
    tkHost_Invalidate( gHost )
end sub

sub OnActivate( byval hg as TK_WIDGET ptr, byval row as integer, byval col as integer )
    gStatus = "activate  row " & row & " (double click)"
    tkHost_Invalidate( gHost )
end sub

sub Form_Size( byval h as TK_HOST ptr )
    dim as long pw, ph
    tkHost_PixelSize( h, pw, ph )
    dim as long sm = tkHost_Scale( h, MARGIN ), lh = tkHost_Scale( h, LABELH )
    tkWidget_SetPos( gGrid, sm, sm + lh, pw - 2 * sm, ph - 2 * sm - 2 * lh )
end sub

sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    dim as TKTHEME_COLORS t = tkTheme_Get()
    dim as long lh = tkHost_Scale( h, LABELH )
    dim as TKRECT r
    b->SetFont( gFontBold10 )
    b->SetForeColor( t.TextHot )
    tkRect_Set( r, gGrid->x, gGrid->y - lh, gGrid->x + gGrid->cw, gGrid->y )
    b->PaintText( "tkDataGrid G0-G2 -- " & NROWS & " rows: F2 or type to edit, Enter / Tab / Esc, Space on Paid, Ctrl+C / Ctrl+V, Delete; the last row adds one", @r, TK_DT_LEFT or TK_DT_ELLIPSIS )
    tkRect_Set( r, gGrid->x, gGrid->y + gGrid->ch, gGrid->x + gGrid->cw, gGrid->y + gGrid->ch + lh )
    b->SetFont( gFont10 )
    b->SetForeColor( t.Accent )
    b->PaintText( gStatus, @r, TK_DT_LEFT or TK_DT_ELLIPSIS )
end sub

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

private sub SaveShot( byref path as string )
    tkHost_Render( gHost )
    tkHost_RenderTo( gHost, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( gHost->renderer, 0 )
    if s then
        SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & gHost->fScale
        SDL_DestroySurface( s )
    end if
end sub

' ---- main --------------------------------------------------------------------------------
if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
dim as single forced = val( ArgValue( "--scale" ) )
gHost = tkHost_Create( "tkDataGrid on SDL3", 900, 560, tkHost_FontDir() & TK_FONT_UI, forced )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
gHost->clrBack = tkTheme_Get().Window
gFont10 = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 10 )
gFontBold10 = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI_BOLD, 10 )

gGrid = tkDataGrid_Create( tkHost_Root( gHost ), 1000 )
tkDataGrid_ApplyFonts( gGrid, gFont10, 0 )
tkDataGrid_SetAlternateRows( gGrid, true )
tkDataGrid_ShowRowHeaders( gGrid, true )
tkDataGrid_SetFrozenColumns( gGrid, 1 )
tkDataGrid_SetCellFormattingCallback( gGrid, @OnFormat )
tkDataGrid_SetCurrentCellChangedCallback( gGrid, @OnCurrent )
tkDataGrid_SetSelChangeCallback( gGrid, @OnSelChange )
tkDataGrid_SetColumnClickCallback( gGrid, @OnColumnClick )
tkDataGrid_SetColumnReorderedCallback( gGrid, @OnReordered )
tkDataGrid_SetColumnResizeCallback( gGrid, @OnResized )
tkDataGrid_SetCellActivateCallback( gGrid, @OnActivate )
tkDataGrid_SetCellValueChangedCallback( gGrid, @OnValueChanged )
tkDataGrid_SetRowCommittedCallback( gGrid, @OnRowCommitted )
tkDataGrid_SetCancelRowEditCallback( gGrid, @OnRowCancelled )
tkDataGrid_SetButtonClickCallback( gGrid, @OnButton )
tkDataGrid_SetAllowAddRows( gGrid, true )

dim as integer cId = tkDataGrid_AddColumnEx( gGrid, "Order", TKDG_COL_TEXT, 80, TKDG_INT )
dim as TKDATAGRID_COLUMN cc
cc.key = "Customer" : cc.caption = "Customer" : cc.width = 180 : cc.fillWeight = 1
dim as integer cCust = tkDataGrid_AddColumn( gGrid, cc )
dim as integer cDate = tkDataGrid_AddColumnEx( gGrid, "Date", TKDG_COL_DATE, 110 )
dim as integer cStatus = tkDataGrid_AddColumnEx( gGrid, "Status", TKDG_COL_COMBO, 90, TKDG_INT )
dim as ustring statuses(0 to 2) = { "New", "Paid", "Shipped" }
tkDataGrid_SetColumnItems( gGrid, cStatus, statuses() )
gColQty = tkDataGrid_AddColumnEx( gGrid, "Qty", TKDG_COL_NUMBER, 60, TKDG_INT )
dim as integer cPrice = tkDataGrid_AddColumnEx( gGrid, "Price", TKDG_COL_NUMBER, 80 )
gColTotal = tkDataGrid_AddColumnEx( gGrid, "Total", TKDG_COL_NUMBER, 100 )
dim as integer cPaid = tkDataGrid_AddColumnEx( gGrid, "Paid", TKDG_COL_CHECK, 50 )
dim as integer cShip = tkDataGrid_AddColumnEx( gGrid, "Shipped", TKDG_COL_PROGRESS, 110 )
dim as integer cLink = tkDataGrid_AddColumnEx( gGrid, "Invoice", TKDG_COL_LINK, 90 )
dim as integer cBtn = tkDataGrid_AddColumnEx( gGrid, "Action", TKDG_COL_BUTTON, 90 )

dim as string names_(0 to 7) = { "Acme Corp", "Globex", "Initech", "Umbrella", "Hooli", "Stark Industries", "Wayne Enterprises", "Wonka" }
tkDataGrid_BeginUpdate( gGrid )
tkDataGrid_SetRowCount( gGrid, NROWS )
for r as integer = 0 to NROWS - 1
    dim as long qn = 1 + (r * 7) mod 23
    dim as double pr = 5 + ((r * 13) mod 997) / 10
    tkDataGrid_SetCellInt( gGrid, r, cId, 100000 + r )
    tkDataGrid_SetCellText( gGrid, r, cCust, names_( r mod 8 ) )
    tkDataGrid_SetCellDate( gGrid, r, cDate, tkCalendar_MakeDate( 2026, 1 + (r mod 12), 1 + (r mod 28) ) )
    tkDataGrid_SetCellInt( gGrid, r, cStatus, r mod 3 )
    tkDataGrid_SetCellInt( gGrid, r, gColQty, qn )
    tkDataGrid_SetCellFloat( gGrid, r, cPrice, pr )
    tkDataGrid_SetCellFloat( gGrid, r, gColTotal, qn * pr )
    tkDataGrid_SetCellBool( gGrid, r, cPaid, (r mod 3) <> 0 )
    tkDataGrid_SetCellFloat( gGrid, r, cShip, (r * 17) mod 101 )
    tkDataGrid_SetCellText( gGrid, r, cLink, "INV-" & (100000 + r) )
    tkDataGrid_SetCellText( gGrid, r, cBtn, "Details" )
next
tkDataGrid_EndUpdate( gGrid )

gStatus = "F2 or type on a cell to edit it; Space toggles Paid; Ctrl+End goes to the new row."
gHost->OnPaint = @Form_Paint
gHost->OnSize = @Form_Size
Form_Size( gHost )
tkHost_Show( gHost )
tkHost_SetFocus( gHost, gGrid )
tkDataGrid_SetCurrentCell( gGrid, 2, cCust )
tkDataGrid_SelectRange( gGrid, 2, cCust, 5, gColQty )
tkDataGrid_SelectRows( gGrid, 8, 9, true )

' --edit <column>: an editor open on row 3 of that column, for a shot
dim as string editCol = ArgValue( "--edit" )
if len( editCol ) then tkDataGrid_BeginEdit( gGrid, 3, valint( editCol ), false )

dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )
    SaveShot( shot )
else
    tkHost_Run( gHost )
end if
tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
