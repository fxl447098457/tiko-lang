' tkTabControl demo: two tab controls. "Settings" has glyphs on its tabs, a taller strip and
' controls on every page; "Documents" is closable, and its X hides a page (the button brings the
' hidden ones back). "Next page" moves the Settings selection by code, which is silent.
'
'   demo                          run it
'   demo --shot out.bmp           render once, save the window, exit
'   demo --scale 1.75             pin the scale
#import "vendor/tkControls/tkTabControl"
#import "vendor/tkControls/tkLabel"
#import "vendor/tkControls/tkCheckBox"
#import "vendor/tkControls/tkButton"
using tkTabControl
using tkTabBar
using tkLabel
using tkCheckBox
using tkButton
using tkTheme
using tkHost
using tkPaint

dim shared as TK_HOST ptr gHost
dim shared as TK_WIDGET ptr gSet, gDoc, gNext, gShowAll
dim shared as TK_WIDGET ptr gChk(0 to 5), gNote(0 to 2), gDocText(0 to 3)
dim shared as TTF_Font ptr gFont, gGlyph

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

private function HasArg( byref name_ as string ) as boolean
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return true
    next
    return false
end function

private function TabName( byval h as TK_WIDGET ptr ) as string
    return iif( h = gSet, "Settings", "Documents" )
end function

private sub Tabs_SelChange( byval h as TK_WIDGET ptr, byval idxOld as long, byval idxNew as long )
    print TabName( h ) & " SelChange " & idxOld & " -> " & idxNew & " (" & tkTabControl_GetPageText( h, idxNew ) & ")"
end sub

private sub Docs_Close( byval h as TK_WIDGET ptr, byval idx as long )
    print "Documents Close " & idx & " (" & tkTabControl_GetPageText( h, idx ) & ") -> hidden"
    tkTabControl_SetPageVisible( h, idx, false )
end sub

private sub Chk_Changed( byval h as TK_WIDGET ptr, byval isChecked as boolean )
    print "CheckChanged " & tkCheckBox_GetText( h ) & ": " & isChecked
end sub

private sub Btn_Click( byval h as TK_WIDGET ptr, byval id as long )
    if h = gNext then
        dim as long n = (tkTabControl_GetCurSel( gSet ) + 1) mod tkTabControl_GetPageCount( gSet )
        tkTabControl_SetCurSel( gSet, n )
        print "Next page: SetCurSel " & n & " (silent, no SelChange)"
    else
        for i as long = 0 to tkTabControl_GetPageCount( gDoc ) - 1
            tkTabControl_SetPageVisible( gDoc, i, true )
        next
        print "Show all: every Documents page visible again"
    end if
end sub

private sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    dim as ustring heads(0 to 1) = { "Settings: glyphs, 36-unit strip", "Documents: closable, X hides the page" }
    b->SetFont( gFont )
    b->SetForeColor( tkTheme_Of( tkHost_Root( h ) ).TextDim )
    for i as long = 0 to 1
        dim as TKRECT rc
        tkRect_Set( rc, tkHost_Scale( h, 20 + i * 380 ), tkHost_Scale( h, 10 ), tkHost_Scale( h, 380 + i * 460 ), tkHost_Scale( h, 34 ) )
        b->PaintText( heads(i), @rc, TK_DT_LEFT or TK_DT_VCENTER )
    next
end sub

private sub Form_Size( byval h as TK_HOST ptr )
    tkWidget_SetPos( gSet, tkHost_Scale( h, 20 ), tkHost_Scale( h, 40 ), tkHost_Scale( h, 360 ), tkHost_Scale( h, 200 ) )
    tkWidget_SetPos( gDoc, tkHost_Scale( h, 400 ), tkHost_Scale( h, 40 ), tkHost_Scale( h, 440 ), tkHost_Scale( h, 200 ) )
    tkWidget_SetPos( gNext, tkHost_Scale( h, 20 ), tkHost_Scale( h, 256 ), tkHost_Scale( h, 120 ), tkHost_Scale( h, 30 ) )
    tkWidget_SetPos( gShowAll, tkHost_Scale( h, 400 ), tkHost_Scale( h, 256 ), tkHost_Scale( h, 150 ), tkHost_Scale( h, 30 ) )
    ' page children are placed relative to their page
    for i as long = 0 to 5
        tkWidget_SetPos( gChk(i), tkHost_Scale( h, 16 ), tkHost_Scale( h, 16 + (i mod 2) * 34 ), tkHost_Scale( h, 300 ), tkHost_Scale( h, 26 ) )
    next
    for i as long = 0 to 2
        tkWidget_SetPos( gNote(i), tkHost_Scale( h, 16 ), tkHost_Scale( h, 96 ), tkHost_Scale( h, 320 ), tkHost_Scale( h, 60 ) )
    next
    for i as long = 0 to 3
        tkWidget_SetPos( gDocText(i), tkHost_Scale( h, 16 ), tkHost_Scale( h, 16 ), tkHost_Scale( h, 400 ), tkHost_Scale( h, 120 ) )
    next
end sub

private sub SaveShot( byval h as TK_HOST ptr, byref path as string )
    tkHost_Render( h )
    tkHost_RenderTo( h, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( h->renderer, 0 )
    if s then
        SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & h->fScale
        SDL_DestroySurface( s )
    end if
end sub

if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
dim as single forced = val( ArgValue( "--scale" ) )
gHost = tkHost_Create( "tkTabControl on SDL3", 860, 306, tkHost_FontDir() & TK_FONT_UI, forced )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
gHost->clrBack = tkTheme_Of( tkHost_Root( gHost ) ).Window
gFont = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 10 )
gGlyph = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_ICONS, 10 )

' Settings: three pages with glyphs, two checkboxes and a note on each
gSet = tkTabControl_Create( tkHost_Root( gHost ), 1000 )
tkTabControl_SetGlyphFont( gSet, gGlyph )
tkTabControl_SetTabHeight( gSet, 36 )
dim as ustring pages(0 to 2) = { "General", "Editor", "Advanced" }
dim as ulong glyphs(0 to 2) = { TK_ICON_SETTINGS, TK_ICON_DOCUMENT, TK_ICON_WRENCH }
dim as ustring opts(0 to 5) = { "Open the last project", "Check for updates", "Show line numbers", _
                                "Wrap long lines", "Verbose build log", "Keep the module cache" }
dim as ustring notes(0 to 2) = { "Each page is a tkPanel; these controls are its children.", _
                                 "Only the selected page is visible.", "Keyboard is on (the bar's opt-in): Tab to the strip, then the arrows." }
for i as long = 0 to 2
    tkTabControl_AddPage( gSet, pages(i) )
    tkTabControl_SetPageGlyph( gSet, i, wchr( glyphs(i) ) )
    dim as TK_WIDGET ptr pg = tkTabControl_GetPage( gSet, i )
    for k as long = 0 to 1
        dim as long j = i * 2 + k
        gChk(j) = tkCheckBox_Create( pg, 10 + j )
        tkCheckBox_SetText( gChk(j), opts(j) )
        tkCheckBox_SetChecked( gChk(j), (j mod 3) = 0 )
        tkCheckBox_SetCheckChangedCallback( gChk(j), @Chk_Changed )
    next
    gNote(i) = tkLabel_Create( pg, 20 + i )
    tkLabel_SetText( gNote(i), notes(i) )
    tkLabel_SetWordWrap( gNote(i), true )
    tkLabel_SetTextColor( gNote(i), tkTheme_Of( pg ).TextDim )
next
tkTabControl_SetSelChangeCallback( gSet, @Tabs_SelChange )
tkTabBar_SetKeyboard( tkTabControl_GetTabBar( gSet ), true )

' Documents: closable tabs, default strip
gDoc = tkTabControl_Create( tkHost_Root( gHost ), 2000 )
tkTabControl_SetClosable( gDoc, true )
dim as ustring docs(0 to 3) = { "main.tiko", "notes.txt", "todo.md", "a.bi" }
for i as long = 0 to 3
    tkTabControl_AddPage( gDoc, docs(i) )
    gDocText(i) = tkLabel_Create( tkTabControl_GetPage( gDoc, i ), 30 + i )
    tkLabel_SetText( gDocText(i), "This is the page of " & docs(i) & "." & chr( 10 ) & "Close its tab and it is only hidden: Show all brings it back in its place." )
    tkLabel_SetWordWrap( gDocText(i), true )
    tkLabel_SetVAlign( gDocText(i), LBL_VALIGN_TOP )
next
tkTabControl_SetCurSel( gDoc, 1 )
tkTabControl_SetSelChangeCallback( gDoc, @Tabs_SelChange )
tkTabControl_SetCloseCallback( gDoc, @Docs_Close )

gNext = tkButton_Create( tkHost_Root( gHost ), 3001 )
tkButton_SetText( gNext, "Next page" )
gShowAll = tkButton_Create( tkHost_Root( gHost ), 3002 )
tkButton_SetText( gShowAll, "Show all tabs" )
tkButton_SetClickCallback( gNext, @Btn_Click )
tkButton_SetClickCallback( gShowAll, @Btn_Click )

gHost->OnPaint = @Form_Paint
gHost->OnSize = @Form_Size
Form_Size( gHost )
tkHost_SetFocus( gHost, tkTabControl_GetTabBar( gSet ) )
tkHost_Show( gHost )

dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )
    SaveShot( gHost, shot )
else
    tkHost_Run( gHost )
end if
tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
