' tkTabControl self-test. Real windows, real clicks on the tabs; scale pinned at 1.0 and 1.75.
#import "vendor/tkControls/tkTabControl"
#import "vendor/tkControls/tkTest"
using tkTabControl
using tkTabBar
using tkPanel
using tkTheme
using tkTest
using tkHost
using tkPaint

dim shared as long gChanges, gOld, gNew

sub OnChange( byval h as TK_WIDGET ptr, byval idxOld as long, byval idxNew as long )
    gChanges += 1
    gOld = idxOld
    gNew = idxNew
end sub

sub RunPass( byval fScale as single )
    tkTest_Begin( "scale " & fScale )
    dim as TK_HOST ptr h = tkHost_Create( "tkTabControl selftest", 640, 480, tkHost_FontDir() & TK_FONT_UI, fScale )
    dim as TK_WIDGET ptr T = tkTabControl_Create( tkHost_Root( h ), 1 )
    tkHost_Show( h )
    tkWidget_SetPos( T, 20, 20, 500, 300 )
    tkTest_PumpFor( h, 50 )

    tkTest_Check( "no pages yet", (tkTabControl_GetPageCount( T ) = 0) andalso (tkTabControl_GetCurSel( T ) = -1) )
    tkTest_Check( "no such page", tkTabControl_GetPage( T, 0 ) = 0 )
    tkTest_Check( "add returns the index", tkTabControl_AddPage( T, "One" ) = 0 )
    tkTest_Check( "the first page is selected", tkTabControl_GetCurSel( T ) = 0, str( tkTabControl_GetCurSel( T ) ) )
    tkTest_Check( "second", tkTabControl_AddPage( T, "Two" ) = 1 )
    tkTest_Check( "third", tkTabControl_AddPage( T, "Three" ) = 2 )
    tkTest_Check( "adding leaves the selection", tkTabControl_GetCurSel( T ) = 0 )

    dim as TK_WIDGET ptr p0 = tkTabControl_GetPage( T, 0 ), p1 = tkTabControl_GetPage( T, 1 ), p2 = tkTabControl_GetPage( T, 2 )
    dim as long barH = cint( TKTABCONTROL_DEFAULT_TABHEIGHT * fScale )
    tkTest_Check( "bar across the top", tkTabControl_GetTabBar( T )->ch = barH, str( tkTabControl_GetTabBar( T )->ch ) )
    tkTest_Check( "page under the bar", (p0->x = 0) andalso (p0->y = barH) andalso (p0->cw = 500) andalso (p0->ch = 300 - barH), p0->y & " " & p0->cw & "x" & p0->ch )
    tkTest_Check( "every page has the same rect", (p2->y = barH) andalso (p2->cw = 500) )
    tkTest_Check( "only the current page shows", tkWidget_IsVisible( p0 ) andalso (tkWidget_IsVisible( p1 ) = false) andalso (tkWidget_IsVisible( p2 ) = false) )

    tkTest_Check( "page text", tkTabControl_GetPageText( T, 1 ) = "Two", tkTabControl_GetPageText( T, 1 ) )
    tkTest_Check( "rename", tkTabControl_SetPageText( T, 1, "Deux" ) andalso (tkTabControl_GetPageText( T, 1 ) = "Deux") )

    ' A control on a hidden page cannot be hit; on the current page it can.
    dim as TK_WIDGET ptr onOne = tkPanel_Create( p1, 50 )
    tkWidget_SetPos( onOne, 10, 10, 60, 60 )
    dim as TK_WIDGET ptr onZero = tkPanel_Create( p0, 51 )
    tkWidget_SetPos( onZero, 10, 10, 60, 60 )
    dim as single hx = 20 + 30, hy = 20 + barH + 30
    tkTest_Check( "the current page's control is hit", tkHost_HitTest( h, hx, hy ) = onZero )

    ' A real click on the second tab.
    dim as TKRECT rcTab
    tkTest_Check( "tab rect", tkTabBar_GetTabRect( tkTabControl_GetTabBar( T ), 1, rcTab ) )
    gChanges = 0
    tkTabControl_SetSelChangeCallback( T, @OnChange )
    dim as single tx = 20 + (rcTab.left + rcTab.right) / 2, ty = 20 + (rcTab.top + rcTab.bottom) / 2
    tkTest_PushMotion( h, tx, ty )
    tkTest_PumpFor( h, 20 )
    tkTest_Click( h, tx, ty )
    tkTest_PumpFor( h, 30 )
    tkTest_Check( "a click selects the tab", tkTabControl_GetCurSel( T ) = 1, str( tkTabControl_GetCurSel( T ) ) )
    tkTest_Check( "the user's change notifies", (gChanges = 1) andalso (gOld = 0) andalso (gNew = 1), gChanges & " " & gOld & "->" & gNew )
    tkTest_Check( "its page shows", tkWidget_IsVisible( p1 ) andalso (tkWidget_IsVisible( p0 ) = false) )
    tkTest_Check( "the other page's control is gone", tkHost_HitTest( h, hx, hy ) = onOne )

    gChanges = 0
    tkTest_Check( "SetCurSel", tkTabControl_SetCurSel( T, 2 ) )
    tkTest_Check( "...is silent", gChanges = 0, str( gChanges ) )
    tkTest_Check( "...and shows the page", tkWidget_IsVisible( p2 ) andalso (tkWidget_IsVisible( p1 ) = false) )
    tkTest_Check( "a bad index is refused", tkTabControl_SetCurSel( T, 9 ) = false )

    tkWidget_SetPos( T, 20, 20, 400, 250 )
    tkTest_Check( "resize follows", (p2->cw = 400) andalso (p2->ch = 250 - barH), p2->cw & "x" & p2->ch )
    tkTabControl_SetTabHeight( T, 40 )
    dim as long barH2 = cint( 40 * fScale )
    tkTest_Check( "tab height moves the pages", (p2->y = barH2) andalso (tkTabControl_GetTabBar( T )->ch = barH2), str( p2->y ) )

    tkTest_Check( "insert in front", tkTabControl_InsertPage( T, 0, "Zero" ) = 0 )
    tkTest_Check( "...keeps the same page selected", tkTabControl_GetPage( T, tkTabControl_GetCurSel( T ) ) = p2, str( tkTabControl_GetCurSel( T ) ) )
    tkTest_Check( "pages moved along", tkTabControl_GetPage( T, 1 ) = p0 )

    tkTest_Check( "delete", tkTabControl_DeletePage( T, 0 ) )
    tkTest_Check( "count", tkTabControl_GetPageCount( T ) = 3 )
    tkTest_Check( "delete a bad index", tkTabControl_DeletePage( T, 7 ) = false )
    tkTest_Check( "a page's controls go with it", tkTabControl_DeletePage( T, 1 ) andalso (tkTabControl_GetPage( T, 1 ) = p2) )

    tkHost_Destroy( h )
end sub

if tkTest_Init() = false then end 99
RunPass( 1.0 )
RunPass( 1.75 )
dim as long nFail = tkTest_Report( "tkTabControl" )
tkTest_Quit()
end nFail
