' tkListForm self-test (Form Designer B3). frmShop was written as a .tkform and generated by
' tkEdit --generate-forms; this drives its generated list code: LoadFrom filling a ListTree from the
' record's array, <name>_Item( ) mapping a row to its element, two ComboBoxes filled by <name>_Fill( )
' and bound by value. A presenter stands in for B2's message box.
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkForms"
#import "vendor/tkControls/tkBind"
#import "vendor/tkControls/tkListTree"
#import "vendor/tkControls/tkComboBox"
#import "./frmShop"
#import "./shopdata"
#import "std/containers"
using tkApp
using tkForms
using tkBind
using tkListTree
using tkComboBox
using tkHost
using tkTest
using containers

dim shared as long gShown
dim shared as ustring gShownText

sub Presenter( byval f as TK_FORM ptr, byref e as TKBIND_ERRORS, byval bLoading as boolean )
    gShown += 1
    gShownText = e.Text( )
end sub

function NewLine( byref item as const ustring, byval qty as long, byval price as double, byval packed as boolean ) as shopdata.Line
    dim as shopdata.Line l
    l.Item = item : l.Qty = qty : l.Price = price : l.Packed = packed
    return l
end function

function NewCarrier( byval id_ as long, byref name_ as const ustring ) as shopdata.Carrier
    dim as shopdata.Carrier c
    c.Id = id_ : c.Name = name_
    return c
end function

sub Shop( byval owner as TK_FORM ptr )
    tkTest_Begin( "a designed form with lists" )
    tkBind_SetErrorPresenter( @Presenter )
    dim as frmShop.Form f
    f.Build( owner )
    tkTest_Check( "Build opened the window", f.IsOpen( ) )
    dim as TK_HOST ptr h = tkForm_Host( f.Handle )
    f.Show( )
    tkTest_PumpFor( h, 60 )

    ' ItemsSource lists: filled when the program says so
    tkTest_Check( "nothing listed before Fill", (tkComboBox_GetCount( f.cboCountry.Handle ) = 0) andalso (tkComboBox_GetCount( f.cboCarrier.Handle ) = 0) )
    f.Carriers.Push( NewCarrier( 10, "Post" ) ) : f.Carriers.Push( NewCarrier( 20, "Courier" ) ) : f.Carriers.Push( NewCarrier( 30, "Freight" ) )
    f.cboCountry_Fill( )
    f.cboCarrier_Fill( )
    tkTest_Check( "a function's list: its DisplayField shown", (tkComboBox_GetCount( f.cboCountry.Handle ) = 3) _
        andalso (tkComboBox_GetItemText( f.cboCountry.Handle, 1 ) = "Australia"), tkComboBox_GetItemText( f.cboCountry.Handle, 1 ) )
    tkTest_Check( "a member's list", (tkComboBox_GetCount( f.cboCarrier.Handle ) = 3) andalso (tkComboBox_GetItemText( f.cboCarrier.Handle, 2 ) = "Freight") )

    ' LoadFrom: the record's lines fill the ListTree; the combos select by value
    dim as shopdata.Order r
    r.Lines.Push( NewLine( "Tea", 2, 4.5, true ) ) : r.Lines.Push( NewLine( "Cups", 6, 1.25, false ) ) : r.Lines.Push( NewLine( "Pot", 1, 30, true ) )
    r.Country = "AU" : r.CarrierId = 20
    tkTest_Check( "LoadFrom: true", f.LoadFrom( r ) andalso (gShown = 0), gShownText )
    dim as TK_WIDGET ptr lst = f.lstLines.Handle
    tkTest_Check( "a row per line", tkListTree_GetCount( lst ) = 3, str( tkListTree_GetCount( lst ) ) )
    tkTest_Check( "a column per field", (tkListTree_GetCellText( lst, 1, 0 ) = "Cups") andalso (tkListTree_GetCellText( lst, 1, 1 ) = "6") _
        andalso (tkListTree_GetCellText( lst, 1, 2 ) = "1.25"), tkListTree_GetCellText( lst, 1, 0 ) & "|" & tkListTree_GetCellText( lst, 1, 1 ) & "|" & tkListTree_GetCellText( lst, 1, 2 ) )
    tkTest_Check( "checks from the bool field", (tkListTree_GetCheck( lst, 0 ) <> 0) andalso (tkListTree_GetCheck( lst, 1 ) = 0) andalso (tkListTree_GetCheck( lst, 2 ) <> 0) )
    tkTest_Check( "the code AU selects Australia, the id 20 Courier", (tkComboBox_GetCurSel( f.cboCountry.Handle ) = 1) _
        andalso (tkComboBox_GetCurSel( f.cboCarrier.Handle ) = 1) )
    tkTest_Check( "no row chosen: _Item( ) is -1", f.lstLines_Item( ) = -1 )
    tkListTree_SetCurSel( lst, 2 )
    tkTest_Check( "a row chosen: _Item( ) is its element", (f.lstLines_Item( ) = 2) andalso (r.Lines[f.lstLines_Item( )].Item = "Pot") )

    ' SaveTo: the chosen items' values go back
    tkComboBox_SetCurSel( f.cboCarrier.Handle, 2 )
    tkComboBox_SetCurSel( f.cboCountry.Handle, 2 )
    dim as shopdata.Order r2
    tkTest_Check( "SaveTo: the code and the id", f.SaveTo( r2 ) andalso (r2.Country = "CA") andalso (r2.CarrierId = 30), r2.Country & " " & r2.CarrierId )
    tkComboBox_SetCurSel( f.cboCountry.Handle, -1 )
    tkComboBox_SetCurSel( f.cboCarrier.Handle, -1 )
    dim as shopdata.Order r3
    r3.CarrierId = 99
    tkTest_Check( "SaveTo: no country chosen is Required", (f.SaveTo( r3 ) = false) andalso (gShownText = "Country: is required") _
        andalso (r3.CarrierId = 99), gShownText )

    ' LoadFrom: a value no item has is reported; 0 is no value
    dim as long nShown = gShown
    r.Country = "FR" : r.CarrierId = 0
    tkTest_Check( "LoadFrom: a code not in the list", (f.LoadFrom( r ) = false) andalso (gShown = nShown + 1) _
        andalso (gShownText = "Country: 'FR' is not in the list"), gShownText )
    tkTest_Check( "  ... nothing selected for it, nor for carrier 0", (tkComboBox_GetCurSel( f.cboCountry.Handle ) = -1) _
        andalso (tkComboBox_GetCurSel( f.cboCarrier.Handle ) = -1) )
    r.Lines.Remove( 0 )
    r.Country = "NZ"
    tkTest_Check( "LoadFrom again: the list follows the record", f.LoadFrom( r ) andalso (tkListTree_GetCount( lst ) = 2) _
        andalso (tkListTree_GetCellText( lst, 0, 0 ) = "Cups") )

    tkBind_SetErrorPresenter( 0 )
    f.Close( )
    tkTest_PumpFor( h, 40 )
end sub

if tkTest_Init() = false then end 99
dim as TKAPP_OPTIONS opts
if tkApp_Init( opts ) = false then
    print "tkApp_Init failed"
    end 98
end if
dim as TK_FORM ptr mainForm = tkApp_NewForm( "owner", 200, 120, 0, 1.0 )
tkForm_Show( mainForm )
tkTest_PumpFor( tkForm_Host( mainForm ), 50 )
Shop( mainForm )
dim as long nFail = tkTest_Report( "tkListForm" )
tkApp_Shutdown( )
end nFail
