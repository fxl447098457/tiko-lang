' The records frmShop binds (Form Designer B3): an order whose lines fill a ListTree (ItemsField),
' a country list a function hands back (ItemsSource, bound by its text Code), and carriers the form
' keeps itself (ItemsSource, bound by an int Id).
#module "shopdata"

#import "std/containers" public
using containers

public type Line
    Item as ustring
    Qty as long
    Price as double
    Packed as boolean
end type

public type Country
    Code as ustring
    Name as ustring
end type

public type Carrier
    Id as long
    Name as ustring
end type

public type Order
    Lines as Array( of Line )
    Country as ustring          ' a Country's Code
    CarrierId as long           ' a Carrier's Id; 0 = none
end type

private function NewCountry( byref code as const ustring, byref name_ as const ustring ) as Country
    dim as Country c
    c.Code = code : c.Name = name_
    return c
end function

' Every country the shop ships to, in the order the list shows them.
public function Countries( ) as Array( of Country )
    dim as Array( of Country ) a
    a.Push( NewCountry( "NZ", "New Zealand" ) )
    a.Push( NewCountry( "AU", "Australia" ) )
    a.Push( NewCountry( "CA", "Canada" ) )
    return a
end function
