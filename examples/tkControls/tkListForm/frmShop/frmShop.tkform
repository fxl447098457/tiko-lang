format = 1

[form]
caption = "Order"
width = 460
height = 320
data_type = "shopdata.Order"
data_module = "../shopdata"

[[control]]
name = "lstLines"
type = "ListTree"
parent = ""
x = 16
y = 16
w = 420
h = 160
items_field = "Lines"
item_type = "shopdata.Line"
check_field = "Packed"

[control.props]
ShowHeader = true

[[control.items]]
text = "Item"
width = 200
field = "Item"

[[control.items]]
text = "Qty"
width = 80
field = "Qty"

[[control.items]]
text = "Price"
width = 100
field = "Price"

[[control]]
name = "cboCountry"
type = "ComboBox"
parent = ""
x = 16
y = 190
w = 200
h = 28
bind = "Country"
required = true
items_source = "shopdata.Countries( )"
item_type = "shopdata.Country"
display_field = "Name"
value_field = "Code"

[[control]]
name = "cboCarrier"
type = "ComboBox"
parent = ""
x = 236
y = 190
w = 200
h = 28
bind = "CarrierId"
items_source = "Carriers"
item_type = "shopdata.Carrier"
display_field = "Name"
value_field = "Id"
