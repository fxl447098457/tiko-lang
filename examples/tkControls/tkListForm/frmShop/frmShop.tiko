' frmShop's own code: the carriers it offers, a form member its cboCarrier lists (ItemsSource
' "Carriers"). The program fills it, then calls the generated cboCarrier_Fill( ).
#module "frmShop"

#import "../shopdata"
#import "std/containers"
using containers

public partial type Form
    Carriers as Array( of shopdata.Carrier )
end type
