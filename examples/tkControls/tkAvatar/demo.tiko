' tkAvatar demo (phases A0 + A1): names in their palette colours, a photo, presence, active and
' inactive, shapes, sizes, the person and group fallbacks, and avatars drawn with no widget.
'
'   demo                     interactive (click an avatar: its name is printed)
'   demo --shot out.bmp      render once, save the window, exit
'   demo --scale 1.75        pin the scale instead of asking the display
#import "vendor/tkControls/tkAvatar"
using tkAvatar
using tkBadge
using tkImage
using tkTheme
using tkHost
using tkPaint

dim shared as TK_HOST ptr gHost
dim shared as TTF_Font ptr gFont, gWidgetless
dim shared as ulong gPhoto(0 to 64 * 64 - 1)

sub OnClick( byval hAvatar as TK_WIDGET ptr )
    print "clicked: " & tkAvatar_GetDisplayName( hAvatar )
end sub

sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    dim as TKTHEME_COLORS t = tkTheme_Of( tkHost_Root( h ) )
    dim as TKRECT rc
    b->SetFont( gFont )
    b->SetColors( t.TextDim, t.Window )
    dim as ustring heads(0 to 3) = { "Names (colour from the name)", "Photo, presence, active / inactive", _
                                     "Shapes, sizes, fallbacks", "Drawn with no widget (PaintInto)" }
    for i as long = 0 to 3
        tkRect_Set( rc, tkHost_Scale( h, 20 ), tkHost_Scale( h, 8 + i * 90 ), tkHost_Scale( h, 600 ), tkHost_Scale( h, 26 + i * 90 ) )
        b->PaintText( heads(i), @rc, TK_DT_LEFT or TK_DT_VCENTER )
    next
    dim as ustring names(0 to 5) = { "Ada Lovelace", "Grace Hopper", "Alan Turing", "Edsger Dijkstra", "Barbara Liskov", "Ken Thompson" }
    for i as long = 0 to 5
        dim as TKAVATAR_SPEC s
        s.wszName = names(i)
        s.fText = gWidgetless
        s.fScale = h->fScale
        if i = 1 then s.nPresence = TKBADGE_PRESENCE_AWAY
        tkRect_Set( rc, tkHost_Scale( h, 30 + i * 52 ), tkHost_Scale( h, 300 ), tkHost_Scale( h, 30 + i * 52 + 40 ), tkHost_Scale( h, 340 ) )
        tkAvatar_PaintInto( b, rc, s )
    next
end sub

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

private sub SaveShot( byref path as string )
    tkHost_Render( gHost )
    tkHost_RenderTo( gHost, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( gHost->renderer, 0 )
    if s then
        SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & gHost->fScale
        SDL_DestroySurface( s )
    end if
end sub

private function Add( byval x as long, byval y as long, byval sizeDu as long, byref name_ as ustring ) as TK_WIDGET ptr
    dim as TK_WIDGET ptr a = tkAvatar_Create( tkHost_Root( gHost ), 0 )
    tkAvatar_SetSize( a, sizeDu )
    tkAvatar_SetDisplayName( a, name_ )
    tkAvatar_SetClickCallback( a, @OnClick )
    tkAvatar_SetClickable( a, true )
    dim as long iw, ih
    tkAvatar_GetIdealSize( a, iw, ih )
    tkWidget_SetPos( a, tkHost_Scale( gHost, x ), tkHost_Scale( gHost, y ), iw, ih )
    return a
end function

' ---- main --------------------------------------------------------------------------------
if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
gHost = tkHost_Create( "tkAvatar on SDL3", 640, 360, tkHost_FontDir() & TK_FONT_UI, val( ArgValue( "--scale" ) ) )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
gHost->clrBack = tkTheme_Of( tkHost_Root( gHost ) ).Window
gFont = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 9 )
gWidgetless = tkHost_OpenFontFace( tkHost_FontDir() & TK_FONT_UI_BOLD, 12, 0 )

' a "photo": a soft two-colour gradient with a lighter disc (no image file needed)
for y as long = 0 to 63
    for x as long = 0 to 63
        dim as long r = 40 + x * 2, g = 90 + y, bl = 160
        if (x - 32) ^ 2 + (y - 26) ^ 2 < 144 then r = 230 : g = 190 : bl = 150
        gPhoto(y * 64 + x) = tkRGB( r, g, bl )
    next
next

dim as ustring names(0 to 7) = { "Ada Lovelace", "Grace Hopper", "Alan Turing", "Edsger Dijkstra", _
                                 "Barbara Liskov", "Ken Thompson", "Margaret Hamilton", "Niklaus Wirth" }
for i as long = 0 to 7
    Add( 20 + i * 52, 30, 40, names(i) )
next

dim as TK_WIDGET ptr a
a = Add( 20, 120, 48, "Photo Person" ) : tkAvatar_SetImagePixels( a, 64, 64, @gPhoto(0) ) : tkAvatar_SetPresence( a, TKBADGE_PRESENCE_AVAILABLE )
a = Add( 80, 120, 48, "Grace Hopper" ) : tkAvatar_SetPresence( a, TKBADGE_PRESENCE_BUSY )
a = Add( 140, 120, 48, "Alan Turing" ) : tkAvatar_SetPresence( a, TKBADGE_PRESENCE_DND )
a = Add( 200, 120, 48, "Ken Thompson" ) : tkAvatar_SetPresence( a, TKBADGE_PRESENCE_OFFLINE )
a = Add( 270, 120, 48, "Ada Lovelace" ) : tkAvatar_SetActive( a, TKAVATAR_ACTIVE_ACTIVE )
a = Add( 340, 120, 48, "Niklaus Wirth" ) : tkAvatar_SetActive( a, TKAVATAR_ACTIVE_INACTIVE )

a = Add( 20, 214, 24, "Barbara Liskov" )
a = Add( 56, 210, 32, "Barbara Liskov" ) : tkAvatar_SetShape( a, TKAVATAR_ROUNDED )
a = Add( 100, 206, 40, "Barbara Liskov" ) : tkAvatar_SetShape( a, TKAVATAR_SQUARE )
a = Add( 154, 200, 56, "" )
a = Add( 222, 200, 56, "" ) : tkAvatar_SetIsGroup( a, true )
a = Add( 290, 200, 56, "+1 555 0100" )
a = Add( 358, 200, 56, "Margaret Hamilton" ) : tkAvatar_SetColorMode( a, TKAVATAR_ACCENT )

gHost->OnPaint = @Form_Paint
tkHost_Show( gHost )
dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )
    SaveShot( shot )
else
    tkHost_Run( gHost )
end if
TTF_CloseFont( gWidgetless )
tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
