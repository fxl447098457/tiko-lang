' tkBind self-test: every field type through every kind, both ways, with the B1 rules at their
' edges (text that is no number, rounding, no date); then the lines a designed form's LoadFrom /
' SaveTo are made of, spelled as codegen spells them, against real controls of every bindable kind.
' And tkBind_ToValue (printing R5): a field into a TK_VALUE by its own type.
#import "vendor/tkControls/tkBind"
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkTextBox"
#import "vendor/tkControls/tkLabel"
#import "vendor/tkControls/tkCheckBox"
#import "vendor/tkControls/tkOptionButton"
#import "vendor/tkControls/tkToggle"
#import "vendor/tkControls/tkNumericUpDown"
#import "vendor/tkControls/tkComboBox"
#import "vendor/tkControls/tkColorPicker"
#import "vendor/tkControls/tkDatePicker"
#import "std/chrono"
#import "std/containers"
using tkBind
using tkCalendar
using tkTimePanel
using tkTest
using tkHost
using tkTextBox
using tkLabel
using tkCheckBox
using tkOptionButton
using tkToggle
using tkNumericUpDown
using tkComboBox
using tkColorPicker
using tkDatePicker
using chrono
using containers

type Rec
    b as boolean
    i8 as byte
    u8 as ubyte
    i16 as short
    u16 as ushort
    i32 as int32
    u32 as ulong
    i64 as int64
    u64 as ulongint
    n as integer
    un as uinteger
    f32 as single
    f64 as double
    s as ustring
    z as string
    dt as TKDATE
    ld as LocalDate
end type

sub Text_( )
    dim as Rec r
    tkBind_Put( r.s, "hello" )      : tkTest_Check( "text -> ustring", r.s = "hello" )
    tkBind_Put( r.z, "zed" )        : tkTest_Check( "text -> string", r.z = "zed" )
    tkBind_Put( r.i32, " 42 " )     : tkTest_Check( "text -> int32, trimmed", r.i32 = 42 )
    tkBind_Put( r.i32, "abc" )      : tkTest_Check( "text that is no number -> 0", r.i32 = 0 )
    tkBind_Put( r.i64, "-9000000000" ) : tkTest_Check( "text -> int64, past 32 bits", r.i64 = -9000000000ll )
    tkBind_Put( r.u8, "200" )       : tkTest_Check( "text -> ubyte", r.u8 = 200 )
    tkBind_Put( r.i8, "-5" )        : tkTest_Check( "text -> byte", r.i8 = -5 )
    tkBind_Put( r.i16, "-300" )     : tkTest_Check( "text -> short", r.i16 = -300 )
    tkBind_Put( r.u16, "60000" )    : tkTest_Check( "text -> ushort", r.u16 = 60000 )
    tkBind_Put( r.u32, "4000000000" ) : tkTest_Check( "text -> ulong", r.u32 = 4000000000ul )
    tkBind_Put( r.u64, "7" )        : tkTest_Check( "text -> ulongint", r.u64 = 7 )
    tkBind_Put( r.n, "11" )         : tkTest_Check( "text -> integer", r.n = 11 )
    tkBind_Put( r.un, "12" )        : tkTest_Check( "text -> uinteger", r.un = 12 )
    tkBind_Put( r.f64, "2.5" )      : tkTest_Check( "text -> double", r.f64 = 2.5 )
    tkBind_Put( r.f32, "0.25" )     : tkTest_Check( "text -> single", r.f32 = 0.25 )
    tkBind_Put( r.b, " YES " )      : tkTest_Check( "text yes -> true", r.b = true )
    tkBind_Put( r.b, "nope" )       : tkTest_Check( "other text -> false", r.b = false )
    tkBind_Put( r.dt, "2026-11-22" )
    tkTest_Check( "ISO text -> TKDATE", (r.dt.wYear = 2026) andalso (r.dt.wMonth = 11) andalso (r.dt.wDay = 22) andalso (r.dt.wDayOfWeek = 0), "dow " & r.dt.wDayOfWeek )
    tkBind_Put( r.dt, "22/11/2026" ) : tkTest_Check( "text that is no date -> no date", r.dt.wYear = 0 )
    tkBind_Put( r.ld, "2024-02-29" ) : tkTest_Check( "ISO text -> LocalDate", r.ld.IsValid andalso (r.ld.Month = 2) andalso (r.ld.Day = 29) )
    tkBind_Put( r.ld, "" )          : tkTest_Check( "empty text -> an Invalid LocalDate", r.ld.IsValid = false )

    r.i32 = -7 : tkTest_Check( "int32 -> text", tkBind_Text( r.i32 ) = "-7" )
    r.u32 = 4000000000ul : tkTest_Check( "ulong -> text, no sign", tkBind_Text( r.u32 ) = "4000000000" )
    r.u64 = 18000000000000000000ull : tkTest_Check( "ulongint -> text", tkBind_Text( r.u64 ) = "18000000000000000000" )
    r.f64 = 2.5 : tkTest_Check( "double -> text", tkBind_Text( r.f64 ) = "2.5" )
    r.b = true : tkTest_Check( "bool -> text", tkBind_Text( r.b ) = "true" )
    r.z = "z" : tkTest_Check( "string -> text", tkBind_Text( r.z ) = "z" )
    r.dt = tkCalendar_MakeDate( 2026, 1, 5 ) : tkTest_Check( "TKDATE -> ISO text", tkBind_Text( r.dt ) = "2026-01-05" )
    dim as TKDATE none_
    tkTest_Check( "no date -> empty text", tkBind_Text( none_ ) = "" )
    r.ld = LocalDate( 999, 3, 4 ) : tkTest_Check( "LocalDate -> ISO text, 4-digit year", tkBind_Text( r.ld ) = "0999-03-04", tkBind_Text( r.ld ) )
end sub

sub Bool_( )
    dim as Rec r
    tkBind_Put( r.i32, true )  : tkTest_Check( "bool -> int32", r.i32 = 1 )
    tkBind_Put( r.f64, true )  : tkTest_Check( "bool -> double", r.f64 = 1 )
    tkBind_Put( r.s, false )   : tkTest_Check( "bool -> ustring", r.s = "false" )
    tkBind_Put( r.b, true )    : tkTest_Check( "bool -> bool", r.b )
    r.i32 = 5 : tkTest_Check( "int32 nonzero -> true", tkBind_Bool( r.i32 ) )
    r.f64 = 0 : tkTest_Check( "double zero -> false", tkBind_Bool( r.f64 ) = false )
    r.s = "On" : tkTest_Check( "ustring On -> true", tkBind_Bool( r.s ) )
    r.z = "0" : tkTest_Check( "string 0 -> false", tkBind_Bool( r.z ) = false )
end sub

sub Int_( )
    dim as Rec r
    tkBind_Put( r.i32, 123ll )        : tkTest_Check( "int -> int32", r.i32 = 123 )
    tkBind_Put( r.u8, 300ll )         : tkTest_Check( "int -> ubyte wraps as assignment does", r.u8 = 44, str( r.u8 ) )
    tkBind_Put( r.f32, 3ll )          : tkTest_Check( "int -> single", r.f32 = 3 )
    tkBind_Put( r.s, -4ll )           : tkTest_Check( "int -> ustring", r.s = "-4" )
    tkBind_Put( r.b, 0ll )            : tkTest_Check( "int 0 -> false", r.b = false )
    tkBind_Put( r.u32, clngint( &hFF112233ul ) ) : tkTest_Check( "a colour through int -> ulong", r.u32 = &hFF112233ul )
    r.f64 = 2.5 : tkTest_Check( "double -> int rounds to even", tkBind_Int( r.f64 ) = 2 )
    r.f64 = 3.5 : tkTest_Check( "...and 3.5 to 4", tkBind_Int( r.f64 ) = 4 )
    r.s = "17" : tkTest_Check( "ustring -> int", tkBind_Int( r.s ) = 17 )
    r.b = true : tkTest_Check( "true -> 1", tkBind_Int( r.b ) = 1 )
    r.u64 = 5 : tkTest_Check( "ulongint -> int", tkBind_Int( r.u64 ) = 5 )
end sub

sub Float_( )
    dim as Rec r
    tkBind_Put( r.i32, 2.5 )   : tkTest_Check( "float 2.5 -> int32 rounds to even", r.i32 = 2 )
    tkBind_Put( r.i64, -1.5 )  : tkTest_Check( "float -1.5 -> int64", r.i64 = -2 )
    tkBind_Put( r.f64, 0.125 ) : tkTest_Check( "float -> double", r.f64 = 0.125 )
    tkBind_Put( r.s, 0.5 )     : tkTest_Check( "float -> ustring", r.s = "0.5", r.s )
    tkBind_Put( r.b, 0.0 )     : tkTest_Check( "float 0 -> false", r.b = false )
    r.i32 = 9 : tkTest_Check( "int32 -> float", tkBind_Float( r.i32 ) = 9 )
    r.s = " 1.25 " : tkTest_Check( "ustring -> float, trimmed", tkBind_Float( r.s ) = 1.25 )
    r.z = "x" : tkTest_Check( "string no number -> 0", tkBind_Float( r.z ) = 0 )
end sub

sub Date_( )
    dim as Rec r
    dim as TKDATE d = tkCalendar_MakeDate( 2026, 11, 22 )
    tkBind_Put( r.dt, d ) : tkTest_Check( "date -> TKDATE", (r.dt.wYear = 2026) andalso (r.dt.wDay = 22) )
    tkBind_Put( r.ld, d ) : tkTest_Check( "date -> LocalDate", r.ld.IsValid andalso (r.ld.Year = 2026) andalso (r.ld.Month = 11) )
    tkBind_Put( r.s, d )  : tkTest_Check( "date -> ustring", r.s = "2026-11-22" )
    tkBind_Put( r.z, d )  : tkTest_Check( "date -> string", r.z = "2026-11-22" )
    dim as TKDATE none_
    tkBind_Put( r.ld, none_ ) : tkTest_Check( "no date -> an Invalid LocalDate", r.ld.IsValid = false )
    tkBind_Put( r.s, none_ )  : tkTest_Check( "no date -> empty text", r.s = "" )
    r.ld = LocalDate( 2025, 7, 1 )
    dim as TKDATE e = tkBind_Date( r.ld )
    tkTest_Check( "LocalDate -> date, day of week filled", (e.wYear = 2025) andalso (e.wMonth = 7) andalso (e.wDay = 1) andalso (e.wDayOfWeek = 2), "dow " & e.wDayOfWeek )
    dim as LocalDate unset_
    tkTest_Check( "a default LocalDate -> no date", tkBind_Date( unset_ ).wYear = 0 )
    r.s = "2026-02-30" : tkTest_Check( "an impossible ISO date -> no date", tkBind_Date( r.s ).wYear = 0 )
    r.z = "2026-03-01" : tkTest_Check( "string -> date", tkBind_Date( r.z ).wMonth = 3 )
    tkTest_Check( "TKDATE -> date", tkBind_Date( d ).wDay = 22 )
end sub

type Person
    Name as ustring
    Title as ustring
    Vip as boolean
    Pick as long
    Night as ustring
    Age as int32
    Kind as int32
    Tint as ulong
    Born as LocalDate
    Since as ustring
end type

' What codegen writes for a form binding each kind (designall checks the spelling, this that it builds
' and moves the values): load, a person's edits, save.
sub Controls_( )
    tkTest_Begin( "controls" )
    dim as TK_HOST ptr h = tkHost_Create( "tkBind selftest", 400, 300, tkHost_FontDir() & TK_FONT_UI, 1.0 )
    dim as TK_WIDGET ptr root_ = tkHost_Root( h )
    dim as TK_WIDGET ptr txt = tkTextBox_Create( root_, 1 ), lbl = tkLabel_Create( root_, 2 )
    dim as TK_WIDGET ptr chk = tkCheckBox_Create( root_, 3 ), opt = tkOptionButton_Create( root_, 4 )
    dim as TK_WIDGET ptr tgl = tkToggle_Create( root_, 5 ), nud = tkNumericUpDown_Create( root_, 6 )
    dim as TK_WIDGET ptr cbo = tkComboBox_Create( root_, 7 ), clr = tkColorPicker_Create( root_, 8 )
    dim as TK_WIDGET ptr dtp = tkDatePicker_Create( root_, 9 ), dt2 = tkDatePicker_Create( root_, 10 )
    tkNumericUpDown_SetRange( nud, 0, 150 )
    tkComboBox_AddItem( cbo, "Home" ) : tkComboBox_AddItem( cbo, "Work" ) : tkComboBox_AddItem( cbo, "Other" )

    dim as Person r
    r.Name = "Ada" : r.Title = "Countess" : r.Vip = true : r.Pick = 0 : r.Night = "yes"
    r.Age = 36 : r.Kind = 2 : r.Tint = &hFF336699ul : r.Born = LocalDate( 1815, 12, 10 ) : r.Since = ""
    ' LoadFrom
    tkTextBox_SetText( txt, tkBind_Text( r.Name ) )
    tkLabel_SetText( lbl, tkBind_Text( r.Title ) )
    tkCheckBox_SetChecked( chk, tkBind_Bool( r.Vip ) )
    tkOptionButton_SetChecked( opt, tkBind_Bool( r.Pick ) )
    tkToggle_SetChecked( tgl, tkBind_Bool( r.Night ) )
    tkNumericUpDown_SetValue( nud, tkBind_Float( r.Age ) )
    tkComboBox_SetCurSel( cbo, tkBind_Int( r.Kind ) )
    tkColorPicker_SetColor( clr, tkBind_Int( r.Tint ) )
    tkDatePicker_SetDateValue( dtp, tkBind_Date( r.Born ) )
    tkDatePicker_SetDateValue( dt2, tkBind_Date( r.Since ) )
    tkTest_Check( "load: text, label", (tkTextBox_GetText( txt ) = "Ada") andalso (tkLabel_GetText( lbl ) = "Countess") )
    tkTest_Check( "load: bool from boolean, long and text", tkCheckBox_GetChecked( chk ) andalso (tkOptionButton_GetChecked( opt ) = false) andalso tkToggle_GetChecked( tgl ) )
    tkTest_Check( "load: a number, an index, a colour", (tkNumericUpDown_GetValue( nud ) = 36) andalso (tkComboBox_GetCurSel( cbo ) = 2) _
        andalso (tkColorPicker_GetColor( clr ) = &hFF336699ul), hex( tkColorPicker_GetColor( clr ) ) )
    dim as TKDATE b = tkDatePicker_GetDateValue( dtp )
    tkTest_Check( "load: a LocalDate into a picker", (b.wYear = 1815) andalso (b.wMonth = 12) andalso (b.wDay = 10) )
    tkTest_Check( "load: no date leaves a picker empty", tkDatePicker_HasDate( dt2 ) = false )

    ' the person's edits
    tkTextBox_SetText( txt, "Ada L." )
    tkCheckBox_SetChecked( chk, false ) : tkOptionButton_SetChecked( opt, true ) : tkToggle_SetChecked( tgl, false )
    tkNumericUpDown_SetValue( nud, 37 ) : tkComboBox_SetCurSel( cbo, 0 )
    tkColorPicker_SetColor( clr, &hFF112233ul )
    tkDatePicker_SetDate( dt2, tkCalendar_MakeDate( 1833, 6, 5 ) )
    ' SaveTo (a Label is load only: not saved)
    tkBind_Put( r.Name, tkTextBox_GetText( txt ) )
    tkBind_Put( r.Vip, tkCheckBox_GetChecked( chk ) )
    tkBind_Put( r.Pick, tkOptionButton_GetChecked( opt ) )
    tkBind_Put( r.Night, tkToggle_GetChecked( tgl ) )
    tkBind_Put( r.Age, cdbl( tkNumericUpDown_GetValue( nud ) ) )
    tkBind_Put( r.Kind, clngint( tkComboBox_GetCurSel( cbo ) ) )
    tkBind_Put( r.Tint, clngint( tkColorPicker_GetColor( clr ) ) )
    tkBind_Put( r.Born, tkDatePicker_GetDateValue( dtp ) )
    tkBind_Put( r.Since, tkDatePicker_GetDateValue( dt2 ) )
    tkTest_Check( "save: text", r.Name = "Ada L." )
    tkTest_Check( "save: bools into boolean, long and text", (r.Vip = false) andalso (r.Pick = 1) andalso (r.Night = "false"), r.Night )
    tkTest_Check( "save: a number, an index, a colour", (r.Age = 37) andalso (r.Kind = 0) andalso (r.Tint = &hFF112233ul) )
    tkTest_Check( "save: dates into a LocalDate and ISO text", r.Born.IsValid andalso (r.Born.Year = 1815) andalso (r.Since = "1833-06-05"), r.Since )
    tkHost_Destroy( h )
end sub

' ---- B2: strict checks, ranges, LoadFrom's report, Format -------------------------------------

' The codes a check left, comma-separated; "" for none.
function Codes( byref e as TKBIND_ERRORS ) as ustring
    dim as ustring o
    for i as long = 0 to e.Count - 1
        if i then o &= ","
        o &= e.Items( i ).Code
    next
    return o
end function

' One check from empty.
#define CHK( fld, v, ru ) e.Clear( ) : tkBind_Check( e, 0, "F", fld, v, ru )
#define RNG( fld, v, ru ) e.Clear( ) : tkBind_Range( e, 0, "F", fld, v, ru )
#define LDD( fld, shown ) e.Clear( ) : tkBind_Loaded( e, 0, "F", fld, shown )

sub Strict_( )
    tkTest_Begin( "strict (B2)" )
    dim as TKBIND_ERRORS e
    dim as TKBIND_RULE no = tkBind_Rule( ), req = tkBind_Rule( true )
    dim as ubyte ub
    dim as byte sb
    dim as long l
    dim as ulong ul
    dim as longint ll
    dim as ulongint ull
    dim as single sg
    dim as double db
    dim as boolean bo
    dim as ustring us
    dim as TKDATE dt
    dim as LocalDate ld
    dim as ustring OK_ = "", NUM = str( TKBIND_ERR_NOTNUMBER ), WHOLE = str( TKBIND_ERR_NOTWHOLE ), RANGE_ = str( TKBIND_ERR_OUTOFRANGE )
    dim as ustring NDATE = str( TKBIND_ERR_NOTDATE ), NBOOL = str( TKBIND_ERR_NOTBOOL ), REQ_ = str( TKBIND_ERR_REQUIRED ), LONG_ = str( TKBIND_ERR_TOOLONG )
    dim as ustring BELOW = str( TKBIND_ERR_BELOWMIN ), ABOVE = str( TKBIND_ERR_ABOVEMAX ), CLAMP = str( TKBIND_ERR_CLAMPED )

    ' whole numbers, by the field's own width
    CHK( ub, "255", no ) : tkTest_Check( "ubyte takes 255", Codes( e ) = OK_, e.Text( ) )
    CHK( ub, "256", no ) : tkTest_Check( "ubyte refuses 256", Codes( e ) = RANGE_, e.Text( ) )
    CHK( ub, "-1", no ) : tkTest_Check( "ubyte refuses -1", Codes( e ) = RANGE_, e.Text( ) )
    CHK( sb, "-128", no ) : tkTest_Check( "byte takes -128", Codes( e ) = OK_, e.Text( ) )
    CHK( sb, "128", no ) : tkTest_Check( "byte refuses 128", Codes( e ) = RANGE_, e.Text( ) )
    CHK( l, "2147483647", no ) : tkTest_Check( "long takes its max", Codes( e ) = OK_, e.Text( ) )
    CHK( l, "-2147483649", no ) : tkTest_Check( "long refuses one past its min", Codes( e ) = RANGE_, e.Text( ) )
    CHK( ll, "-9223372036854775808", no ) : tkTest_Check( "longint takes its min", Codes( e ) = OK_, e.Text( ) )
    CHK( ull, "18446744073709551615", no ) : tkTest_Check( "ulongint takes its max", Codes( e ) = OK_, e.Text( ) )
    CHK( ull, "18446744073709551616", no ) : tkTest_Check( "ulongint: one past is out of range", Codes( e ) = RANGE_, e.Text( ) )
    CHK( l, " +7 ", no ) : tkTest_Check( "a sign and spaces", Codes( e ) = OK_, e.Text( ) )
    CHK( l, "abc", no ) : tkTest_Check( "text is no number", Codes( e ) = NUM, e.Text( ) )
    CHK( l, "2.5", no ) : tkTest_Check( "a fraction is no whole number", Codes( e ) = WHOLE, e.Text( ) )
    CHK( l, "12abc", no ) : tkTest_Check( "no trailing junk (VALLNG would take 12)", Codes( e ) = NUM, e.Text( ) )
    CHK( l, "", no ) : tkTest_Check( "empty is 0 when not Required", Codes( e ) = OK_, e.Text( ) )
    CHK( l, "  ", req ) : tkTest_Check( "empty and Required", Codes( e ) = REQ_, e.Text( ) )
    ' real numbers
    CHK( db, "+1.5e-3", no ) : tkTest_Check( "an exponent", Codes( e ) = OK_, e.Text( ) )
    CHK( db, ".5", no ) : tkTest_Check( ".5", Codes( e ) = OK_, e.Text( ) )
    CHK( db, "1.2.3", no ) : tkTest_Check( "1.2.3 is no number", Codes( e ) = NUM, e.Text( ) )
    CHK( db, "e5", no ) : tkTest_Check( "e5 is no number", Codes( e ) = NUM, e.Text( ) )
    CHK( sg, "1e39", no ) : tkTest_Check( "a single refuses 1e39", Codes( e ) = RANGE_, e.Text( ) )
    CHK( db, "1e39", no ) : tkTest_Check( "a double takes 1e39", Codes( e ) = OK_, e.Text( ) )
    ' boolean, text, dates
    CHK( bo, "Yes", no ) : tkTest_Check( "Yes is a boolean", Codes( e ) = OK_, e.Text( ) )
    CHK( bo, "maybe", no ) : tkTest_Check( "maybe is not", Codes( e ) = NBOOL, e.Text( ) )
    CHK( us, "abcd", tkBind_Rule( false, "", "", 3 ) ) : tkTest_Check( "MaxLength 3", Codes( e ) = LONG_, e.Text( ) )
    CHK( dt, "2026-02-30", no ) : tkTest_Check( "30 February is no date", Codes( e ) = NDATE, e.Text( ) )
    CHK( ld, "2026-02-28", no ) : tkTest_Check( "an ISO date", Codes( e ) = OK_, e.Text( ) )
    CHK( dt, "05/03/2026", tkBind_Rule( false, "", "", 0, "dd/MM/yyyy" ) ) : tkTest_Check( "a date in the Format", Codes( e ) = OK_, e.Text( ) )
    CHK( dt, "35/03/2026", tkBind_Rule( false, "", "", 0, "dd/MM/yyyy" ) ) : tkTest_Check( "35/03 is no date", Codes( e ) = NDATE, e.Text( ) )
    ' a number or date control's value
    CHK( l, 2.5, no ) : tkTest_Check( "2.5 from a number control into a long", Codes( e ) = WHOLE, e.Text( ) )
    CHK( ub, 300.0, no ) : tkTest_Check( "300 into a ubyte", Codes( e ) = RANGE_, e.Text( ) )
    CHK( ul, -1.0, no ) : tkTest_Check( "-1 into a ulong", Codes( e ) = RANGE_, e.Text( ) )
    CHK( ub, clngint( 300 ), no ) : tkTest_Check( "an int control's 300 into a ubyte", Codes( e ) = RANGE_, e.Text( ) )
    CHK( l, clngint( -1 ), tkBind_Rule( true, "", "", 0, "", true, -1 ) ) : tkTest_Check( "no selection and Required", Codes( e ) = REQ_, e.Text( ) )
    CHK( l, clngint( -1 ), tkBind_Rule( false, "", "", 0, "", true, -1 ) ) : tkTest_Check( "no selection, not Required", Codes( e ) = OK_, e.Text( ) )
    dim as TKDATE none_
    CHK( dt, none_, req ) : tkTest_Check( "no date and Required", Codes( e ) = REQ_, e.Text( ) )

    ' Minimum / Maximum
    dim as TKBIND_RULE r10 = tkBind_Rule( false, "10", "120" )
    RNG( l, "5", r10 ) : tkTest_Check( "below the minimum", Codes( e ) = BELOW, e.Text( ) )
    RNG( l, "200", r10 ) : tkTest_Check( "above the maximum", Codes( e ) = ABOVE, e.Text( ) )
    RNG( l, "abc", r10 ) : tkTest_Check( "text that didn't convert is Check's to report", Codes( e ) = OK_, e.Text( ) )
    RNG( db, 5.0, r10 ) : tkTest_Check( "a number control's value below", Codes( e ) = BELOW, e.Text( ) )
    RNG( dt, tkCalendar_MakeDate( 2026, 1, 1 ), tkBind_Rule( false, "2026-06-01" ) ) : tkTest_Check( "a date before the minimum", Codes( e ) = BELOW, e.Text( ) )

    ' LoadFrom's report
    db = 130 : LDD( db, 100.0 ) : tkTest_Check( "130 shown as 100", Codes( e ) = CLAMP, e.Text( ) )
    db = 1 / 3 : LDD( db, 1 / 3 ) : tkTest_Check( "shown as held", Codes( e ) = OK_, e.Text( ) )
    us = "abc" : LDD( us, 0.0 ) : tkTest_Check( "text that is no number, into a number control", Codes( e ) = NUM, e.Text( ) )
    l = 7 : LDD( l, clngint( -1 ) ) : tkTest_Check( "an index the list hasn't", Codes( e ) = CLAMP, e.Text( ) )
    LDD( none_, tkCalendar_MakeDate( 2026, 11, 23 ) )
    tkTest_Check( "no date shown as one", (Codes( e ) = CLAMP) andalso (instr( e.Text( ), "no date is shown as 2026-11-23" ) > 0), e.Text( ) )

    ' a DateTime field (Time picker T4's pair): its date part, read back and checked
    dim as DateTime stamp = DateTime( 2026, 1, 2 )
    LDD( stamp, tkCalendar_MakeDate( 2026, 1, 2 ) ) : tkTest_Check( "a DateTime shown as its date", Codes( e ) = OK_, e.Text( ) )
    LDD( stamp, tkCalendar_MakeDate( 2026, 1, 3 ) ) : tkTest_Check( "a DateTime shown as another date", Codes( e ) = CLAMP, e.Text( ) )
    CHK( stamp, none_, req ) : tkTest_Check( "a DateTime with no date and Required", Codes( e ) = REQ_, e.Text( ) )

    ' Format
    tkTest_Check( "Format .2f", tkBind_Text( 3.14159, ".2f" ) = "3.14", tkBind_Text( 3.14159, ".2f" ) )
    l = 42
    tkTest_Check( "Format 08d", tkBind_Text( l, "08d" ) = "00000042", tkBind_Text( l, "08d" ) )
    tkTest_Check( "Format .1f on a whole number", tkBind_Text( l, ".1f" ) = "42.0", tkBind_Text( l, ".1f" ) )
    dt = tkCalendar_MakeDate( 2026, 3, 5 )
    tkTest_Check( "Format dd/MM/yyyy", tkBind_Text( dt, "dd/MM/yyyy" ) = "05/03/2026", tkBind_Text( dt, "dd/MM/yyyy" ) )
    tkTest_Check( "a number spec on a date is ISO", tkBind_Text( dt, ".2f" ) = "2026-03-05", tkBind_Text( dt, ".2f" ) )
    tkBind_Put( dt, "17/08/2025", "dd/MM/yyyy" )
    tkTest_Check( "save in the Format", (dt.wYear = 2025) andalso (dt.wMonth = 8) andalso (dt.wDay = 17) )
    tkTest_Check( "IsFormat", tkBind_IsFormat( ".2f" ) andalso tkBind_IsFormat( "dd/MM/yyyy" ) andalso (tkBind_IsFormat( "abc" ) = false) andalso (tkBind_IsFormat( "" ) = false) )

    ' the list
    e.Clear( )
    dim as TK_WIDGET ptr fake = cast( TK_WIDGET ptr, 16 )
    tkBind_Check( e, fake, "Age", l, "x", no )
    tkBind_Check( e, 0, "Name", us, "", req )
    tkTest_Check( "two errors, one line each", (e.Count = 2) andalso (e.Text( ) = "Age: 'x' is not a number" & !"\n" & "Name: is required"), e.Text( ) )
    tkTest_Check( "Has finds the control", e.Has( fake ) andalso (e.Has( cast( TK_WIDGET ptr, 32 ) ) = false) )
end sub

' ---- B3: a ComboBox bound by its items' ValueField ----------------------------------------------
sub Pick_( )
    tkTest_Begin( "pick (B3)" )
    dim as Array( of ustring ) vals
    vals.Push( "NZ" ) : vals.Push( "AU" ) : vals.Push( "2026-01-02" ) : vals.Push( "300" )
    tkTest_Check( "IndexOf finds", (tkBind_IndexOf( vals, "AU" ) = 1) andalso (tkBind_IndexOf( vals, "FR" ) = -1) )
    dim as TKBIND_ERRORS e
    dim as ustring code
    dim as long id_
    dim as ubyte ub
    dim as TKDATE dt
    tkBind_CheckPick( e, 0, "Country", code, vals, 1, tkBind_Rule( true ) )
    tkTest_Check( "a choice meets Required", e.Count = 0, e.Text( ) )
    tkBind_CheckPick( e, 0, "Country", code, vals, -1, tkBind_Rule( true ) )
    tkTest_Check( "no choice and Required", (e.Count = 1) andalso (e.Items( 0 ).Code = TKBIND_ERR_REQUIRED), e.Text( ) )
    e.Clear( )
    tkBind_CheckPick( e, 0, "Country", code, vals, -1, tkBind_Rule( ) )
    tkTest_Check( "no choice, not Required", e.Count = 0, e.Text( ) )
    tkBind_CheckPick( e, 0, "Id", id_, vals, 0, tkBind_Rule( ) )
    tkTest_Check( "a value that is no number, into a long", (e.Count = 1) andalso (e.Items( 0 ).Code = TKBIND_ERR_NOTNUMBER), e.Text( ) )
    e.Clear( )
    tkBind_CheckPick( e, 0, "Small", ub, vals, 3, tkBind_Rule( ) )
    tkTest_Check( "300 into a ubyte", (e.Count = 1) andalso (e.Items( 0 ).Code = TKBIND_ERR_OUTOFRANGE), e.Text( ) )
    e.Clear( )
    tkBind_PutPick( code, vals, 1 )
    tkTest_Check( "PutPick: the code", code = "AU", code )
    tkBind_PutPick( code, vals, -1 )
    tkTest_Check( "PutPick: no choice is empty", len( code ) = 0 )
    tkBind_PutPick( dt, vals, 2 )
    tkTest_Check( "PutPick: a date value", (dt.wYear = 2026) andalso (dt.wMonth = 1) andalso (dt.wDay = 2) )
    id_ = 7
    tkBind_PutPick( id_, vals, -1 )
    tkTest_Check( "PutPick: no choice into a long is 0", id_ = 0 )
    tkBind_LoadedPick( e, 0, "Country", "FR", -1 )
    tkTest_Check( "LoadedPick: a value not in the list", (e.Count = 1) andalso (e.Items( 0 ).Code = TKBIND_ERR_NOTINLIST) _
        andalso (e.Text( ) = "Country: 'FR' is not in the list"), e.Text( ) )
    e.Clear( )
    tkBind_LoadedPick( e, 0, "Country", "", -1 )
    tkBind_LoadedPick( e, 0, "Id", "0", -1 )
    tkBind_LoadedPick( e, 0, "Country", "AU", 1 )
    tkTest_Check( "LoadedPick: empty, 0 and a found value are fine", e.Count = 0, e.Text( ) )
end sub

' ---- B4: tkBind_Differs, what IsDirty asks per bound value --------------------------------------
sub Differs_( )
    tkTest_Begin( "differs (B4)" )
    dim as long l = 42
    dim as ubyte ub = 7
    dim as double db = 2.5
    dim as boolean bo = true
    dim as ustring us = "Ada"
    dim as TKDATE dt = tkCalendar_MakeDate( 2026, 3, 5 )
    dim as LocalDate ld = LocalDate( 2026, 3, 5 )
    dim as DateTime stamp = DateTime( 2026, 3, 5 )
    tkTest_Check( "text: the same number, spaced", tkBind_Differs( l, " 42 ", "" ) = false )
    tkTest_Check( "text: another number", tkBind_Differs( l, "43", "" ) )
    tkTest_Check( "text: no number differs", tkBind_Differs( l, "abc", "" ) )
    tkTest_Check( "text: 2.50 is 2.5", tkBind_Differs( db, "2.50", "" ) = false )
    dim as ubyte ub0 = 0
    tkTest_Check( "text: empty is 0", tkBind_Differs( ub, "", "" ) andalso (tkBind_Differs( ub0, "", "" ) = false) )
    tkTest_Check( "text: yes is true", (tkBind_Differs( bo, "Yes", "" ) = false) andalso tkBind_Differs( bo, "no", "" ) )
    tkTest_Check( "text: a text field compares as typed", (tkBind_Differs( us, "Ada", "" ) = false) andalso tkBind_Differs( us, "Ada ", "" ) )
    tkTest_Check( "text: a date in the Format", (tkBind_Differs( dt, "05/03/2026", "dd/MM/yyyy" ) = false) andalso tkBind_Differs( ld, "06/03/2026", "dd/MM/yyyy" ) )
    tkTest_Check( "text: no date differs from a date", tkBind_Differs( dt, "", "" ) )
    tkTest_Check( "bool kind", (tkBind_Differs( bo, true ) = false) andalso tkBind_Differs( l, false ) andalso (tkBind_Differs( l, true ) = false) )
    tkTest_Check( "int kind", (tkBind_Differs( l, clngint( 42 ) ) = false) andalso tkBind_Differs( ub, clngint( 8 ) ) )
    tkTest_Check( "float kind, a tolerance", (tkBind_Differs( db, 2.5 + 1e-12 ) = false) andalso tkBind_Differs( db, 2.6 ) )
    dim as ustring s15 = "1.5"
    tkTest_Check( "float kind into a text field", (tkBind_Differs( us, 1.0 ) = true) andalso (tkBind_Differs( s15, 1.5 ) = false) )
    tkTest_Check( "date kind", (tkBind_Differs( dt, tkCalendar_MakeDate( 2026, 3, 5 ) ) = false) andalso tkBind_Differs( ld, tkCalendar_MakeDate( 2026, 3, 6 ) ) )
    tkTest_Check( "date kind on a DateTime", (tkBind_Differs( stamp, tkCalendar_MakeDate( 2026, 3, 5 ) ) = false) andalso tkBind_Differs( stamp, tkCalendar_MakeDate( 2027, 1, 1 ) ) )
    dim as Array( of ustring ) vals
    vals.Push( "NZ" ) : vals.Push( "AU" )
    dim as ustring code = "AU"
    dim as long id_ = 0
    tkTest_Check( "pick: the chosen value", (tkBind_DiffersPick( code, vals, 1 ) = false) andalso tkBind_DiffersPick( code, vals, 0 ) )
    tkTest_Check( "pick: no choice and 0 / empty are the same", (tkBind_DiffersPick( id_, vals, -1 ) = false) andalso tkBind_DiffersPick( code, vals, -1 ) )
end sub

' printing R5: what a designed ReportViewer's fill does with each field
sub ToValue_( )
    dim as TK_VALUE v(0 to 9)
    dim as byte b8 = -5
    dim as ushort u16 = 65000
    dim as ulongint u64 = 1234567890123ull
    dim as single f = 1.5
    dim as string z = "zed"
    dim as TKDATE d = tkCalendar_MakeDate( 2026, 3, 5 )
    dim as LocalDate ld = LocalDate( 2026, 4, 6 )
    dim as DateTime dtm = DateTime( 2026, 5, 7 )
    dim as TKTIME t = tkTimePanel_MakeTime( 9, 30, 15, 0 )
    dim as chrono.LocalTime lt = chrono.LocalTime( 14, 5, 0, 0 )
    tkBind_ToValue( b8, @v(0) ) : tkBind_ToValue( u16, @v(1) ) : tkBind_ToValue( u64, @v(2) )
    tkBind_ToValue( f, @v(3) ) : tkBind_ToValue( z, @v(4) ) : tkBind_ToValue( d, @v(5) )
    tkBind_ToValue( ld, @v(6) ) : tkBind_ToValue( dtm, @v(7) ) : tkBind_ToValue( t, @v(8) ) : tkBind_ToValue( lt, @v(9) )
    dim as string got
    for i as long = 0 to 9 : got &= v(i).kind & " " : next
    tkTest_Check( "ToValue: the kind is the field's type's (narrow and wide ints, float, string, the dates, the times)", _
                  (got = TKV_INT & " " & TKV_INT & " " & TKV_INT & " " & TKV_FLOAT & " " & TKV_TEXT & " " & TKV_DATE & " " _
                         & TKV_DATE & " " & TKV_DATE & " " & TKV_TIME & " " & TKV_TIME & " ") _
                  andalso (v(0).i = -5) andalso (v(1).i = 65000) andalso (v(2).i = 1234567890123ll) andalso (v(3).f = 1.5) andalso (v(4).s = "zed") _
                  andalso (v(6).d.wDay = 6) andalso (v(7).d.wMonth = 5) andalso (v(8).t.wMinute = 30) andalso (v(9).t.wHour = 14), got )
    dim as TKDATE noDate
    dim as LocalDate noLocal
    dim as TK_VALUE e(0 to 2)
    tkBind_ToValue( noDate, @e(0) ) : tkBind_ToValue( noLocal, @e(1) ) : tkBind_ToValue( chrono.LocalTime.Invalid( ), @e(2) )
    tkBind_ToValue( 1, cast( TK_VALUE ptr, 0 ) )              ' no cell: nothing
    tkTest_Check( "ToValue: no date and no time are EMPTY", (e(0).kind = TKV_EMPTY) andalso (e(1).kind = TKV_EMPTY) andalso (e(2).kind = TKV_EMPTY), _
                  e(0).kind & " " & e(1).kind & " " & e(2).kind )
end sub

if tkTest_Init() = false then end 99
tkTest_Begin( "conversions" )
Text_( )
Bool_( )
Int_( )
Float_( )
Date_( )
Strict_( )
Pick_( )
Differs_( )
Controls_( )
ToValue_( )
dim as long nFail = tkTest_Report( "tkBind" )
tkTest_Quit()
end nFail
