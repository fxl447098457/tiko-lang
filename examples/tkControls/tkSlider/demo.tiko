' tkSlider demo (phases S0 - S2): seven rows, each a label, a slider and its value, and two vertical
' sliders on the right.
'
'   demo                     interactive; ValueChanged / ValueCommitted are printed
'   demo --shot out.bmp      render once (row 0 focused), save the window, exit
'   demo --scale 1.75        pin the scale instead of asking the display
#import "vendor/tkControls/tkSlider"
using tkSlider
using tkTheme
using tkHost
using tkPaint

const as long ROWS = 7
const as long ROW_HEIGHT = 64, ROW_TOP = 14, MARGIN = 22, LABEL_W = 230, VALUE_W = 70, VERT_W = 150
const as long IDC_FIRST = 1000

dim shared as TK_HOST ptr gHost
dim shared as TK_WIDGET ptr gSl(0 to ROWS - 1), gV(0 to 1)
dim shared as ustring gLabel(0 to ROWS - 1)
dim shared as long gPlaces(0 to ROWS + 2)
dim shared as TTF_Font ptr gFont

private function RowTop( byval i as long ) as long
    return tkHost_Scale( gHost, ROW_TOP ) + i * tkHost_Scale( gHost, ROW_HEIGHT )
end function

private function RowOf( byval w as TK_WIDGET ptr ) as long
    for i as long = 0 to ROWS - 1
        if w = gSl(i) then return i
    next
    if w = gV(0) then return 7
    if w = gV(1) then return 8
    return -1
end function

' v with n decimals (tiko has no format()).
private function Fmt( byval v as double, byval n as long ) as string
    dim as double k = 10 ^ n
    dim as longint q = clngint( abs( v ) * k )
    dim as string d = str( q )
    if n > 0 then
        while len( d ) <= n
            d = "0" & d
        wend
        d = left( d, len( d ) - n ) & "." & right( d, n )
    end if
    if (v < 0) andalso (q <> 0) then d = "-" & d
    return d
end function

sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    dim as long pw, ph
    tkHost_PixelSize( h, pw, ph )
    dim as long m = tkHost_Scale( h, MARGIN ), rh = tkHost_Scale( h, ROW_HEIGHT )
    dim as TKTHEME_COLORS t = tkTheme_Of( tkHost_Root( h ) )
    b->SetFont( gFont )
    for i as long = 0 to ROWS - 1
        dim as long y = RowTop( i )
        dim as TKRECT rc
        tkRect_Set( rc, m, y, m + tkHost_Scale( h, LABEL_W ), y + rh )
        b->SetColors( t.Text, t.Window )
        b->PaintText( gLabel(i), @rc, TK_DT_LEFT or TK_DT_VCENTER )
        dim as long vr = pw - m - tkHost_Scale( h, VERT_W )
        tkRect_Set( rc, vr - tkHost_Scale( h, VALUE_W ), y, vr, y + rh )
        b->SetColors( t.TextStrong, t.Window )
        dim as string txt = Fmt( tkSlider_GetValue( gSl(i) ), gPlaces(i) )
        if tkSlider_GetMode( gSl(i) ) = TKSL_MODE_RANGE then txt &= " - " & Fmt( tkSlider_GetUpperValue( gSl(i) ), gPlaces(i) )
        b->PaintText( txt, @rc, TK_DT_RIGHT or TK_DT_VCENTER )
        tkRect_Set( rc, m, y + rh - 1, vr, y + rh )
        b->SetBackColor( t.Divider )
        b->PaintRect( @rc )
    next
end sub

sub Form_Size( byval h as TK_HOST ptr )
    dim as long pw, ph
    tkHost_PixelSize( h, pw, ph )
    dim as long m = tkHost_Scale( h, MARGIN ), rh = tkHost_Scale( h, ROW_HEIGHT )
    dim as long vr = pw - m - tkHost_Scale( h, VERT_W )
    dim as long l = m + tkHost_Scale( h, LABEL_W ), r = vr - tkHost_Scale( h, VALUE_W ) - tkHost_Scale( h, 8 )
    for i as long = 0 to ROWS - 1
        dim as long iw, ih
        tkSlider_GetIdealSize( gSl(i), iw, ih )
        tkWidget_SetPos( gSl(i), l, RowTop( i ) + (rh - ih) \ 2, r - l, ih )
    next
    ' the two verticals: their ideal width, the rows' full height
    dim as long colW = tkHost_Scale( h, VERT_W ) \ 2
    for i as long = 0 to 1
        dim as long iw, ih
        tkSlider_GetIdealSize( gV(i), iw, ih )
        tkWidget_SetPos( gV(i), vr + i * colW + (colW - iw) \ 2, RowTop( 0 ), iw, ROWS * rh )
    next
end sub

function PercentText( byval hSlider as TK_WIDGET ptr, byval nValue as double, byval nWhere as long ) as ustring
    return str( cint( nValue * 100 ) ) & "%"
end function

sub Demo_Changed( byval hSlider as TK_WIDGET ptr, byval nThumb as long, byval nValue as double )
    dim as long i = RowOf( hSlider )
    print "changed    row=" & i & "  thumb=" & nThumb & "  value=" & Fmt( nValue, gPlaces(i) ) & iif( tkSlider_IsDragging( hSlider ), "  (dragging)", "" )
    tkHost_Invalidate( gHost )                    ' the value column
end sub

sub Demo_Committed( byval hSlider as TK_WIDGET ptr, byval nThumb as long, byval nValue as double )
    dim as long i = RowOf( hSlider )
    print "committed  row=" & i & "  thumb=" & nThumb & "  value=" & Fmt( nValue, gPlaces(i) )
    tkHost_Invalidate( gHost )
end sub

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

private sub SaveShot( byref path as string )
    tkHost_Render( gHost )
    tkHost_RenderTo( gHost, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( gHost->renderer, 0 )
    if s then
        SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & gHost->fScale
        SDL_DestroySurface( s )
    end if
end sub

' ---- main --------------------------------------------------------------------------------
if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1

dim as single forced = val( ArgValue( "--scale" ) )
gHost = tkHost_Create( "tkSlider on SDL3", 860, 484, tkHost_FontDir() & TK_FONT_UI, forced )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
gHost->clrBack = tkTheme_Of( tkHost_Root( gHost ) ).Window
gFont = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 10 )
if gFont = 0 then print "fonts: " & *SDL_GetError() : end 1

gLabel(0) = "Volume   (ticks + labels every 20)"
gLabel(1) = "Opacity   (0..1, %, tip on focus)"
gLabel(2) = "Gain   (±12 dB, fill from 0)"
gLabel(3) = "Quality   (snap to 0 3 6 9 10)"
gLabel(4) = "Pages   (click pages, rect thumb)"
gLabel(5) = "Disabled   (custom colours)"
gLabel(6) = "Price   (range, drag the band)"

for i as long = 0 to ROWS - 1
    gSl(i) = tkSlider_Create( tkHost_Root( gHost ), IDC_FIRST + i )
    tkSlider_SetValueChangedCallback( gSl(i), @Demo_Changed )
    tkSlider_SetValueCommittedCallback( gSl(i), @Demo_Committed )
next

tkSlider_SetValue( gSl(0), 40 )
tkSlider_SetTickFrequency( gSl(0), 10 )
tkSlider_SetTickPlacement( gSl(0), TKSL_TICKS_BOTTOMRIGHT )
tkSlider_SetShowTickLabels( gSl(0), true )
tkSlider_SetLabelEvery( gSl(0), 2 )

tkSlider_SetRange( gSl(1), 0, 1 )
tkSlider_SetStep( gSl(1), 0.05 )
tkSlider_SetSmallChange( gSl(1), 0.05 )
tkSlider_SetLargeChange( gSl(1), 0.25 )
tkSlider_SetDecimalPlaces( gSl(1), 2 )
tkSlider_SetValue( gSl(1), 0.75 )
tkSlider_SetFormatValueCallback( gSl(1), @PercentText )
tkSlider_SetShowValueTip( gSl(1), TKSL_TIP_FOCUSED )
gPlaces(1) = 2

tkSlider_SetRange( gSl(2), -12, 12 )
tkSlider_SetStep( gSl(2), 0 )
tkSlider_SetDecimalPlaces( gSl(2), 2 )
tkSlider_SetSmallChange( gSl(2), 0.5 )
tkSlider_SetLargeChange( gSl(2), 3 )
tkSlider_SetWheelMode( gSl(2), TKSL_WHEEL_HOVER )
tkSlider_SetFillMode( gSl(2), TKSL_FILL_ORIGIN )
tkSlider_SetFillOrigin( gSl(2), 0 )
tkSlider_SetTickFrequency( gSl(2), 3 )
tkSlider_SetTickPlacement( gSl(2), TKSL_TICKS_BOTH )
tkSlider_SetValue( gSl(2), 4.5 )
gPlaces(2) = 2

tkSlider_SetRange( gSl(3), 0, 10 )
tkSlider_SetStep( gSl(3), 3 )
tkSlider_SetTickFrequency( gSl(3), 3 )
tkSlider_SetTickPlacement( gSl(3), TKSL_TICKS_TOPLEFT )
tkSlider_SetShowTickLabels( gSl(3), true )
tkSlider_SetSnapToTicks( gSl(3), true )
tkSlider_SetValue( gSl(3), 6 )

tkSlider_SetValue( gSl(4), 65 )
tkSlider_SetTrackClick( gSl(4), TKSL_CLICK_PAGE )
tkSlider_SetThumbShape( gSl(4), TKSL_THUMB_RECT )
tkSlider_SetThumbSize( gSl(4), tkHost_Scale( gHost, 10 ), tkHost_Scale( gHost, 20 ) )

dim as TKSLIDER_COLORS c
tkSlider_GetColors( gSl(5), @c )
c.FillColor = tkRGB( 62, 140, 90 ) : c.FillColorHot = tkRGB( 78, 168, 110 ) : c.FillColorDisabled = tkRGB( 50, 90, 64 )
c.ThumbBorderColor = c.FillColor : c.ThumbBorderColorHot = c.FillColorHot : c.ThumbBorderColorDisabled = c.FillColorDisabled
tkSlider_SetColors( gSl(5), @c )
tkSlider_SetValue( gSl(5), 30 )
tkSlider_SetEnabled( gSl(5), false )

tkSlider_SetMode( gSl(6), TKSL_MODE_RANGE )
tkSlider_SetRange( gSl(6), 0, 500 )
tkSlider_SetStep( gSl(6), 5 )
tkSlider_SetSmallChange( gSl(6), 5 )
tkSlider_SetLargeChange( gSl(6), 50 )
tkSlider_SetMinDistance( gSl(6), 10 )
tkSlider_SetAllowRangeDrag( gSl(6), true )
tkSlider_SetTickFrequency( gSl(6), 100 )
tkSlider_SetTickPlacement( gSl(6), TKSL_TICKS_BOTTOMRIGHT )
tkSlider_SetShowTickLabels( gSl(6), true )
tkSlider_SetValues( gSl(6), 120, 340 )

' the verticals: Min at the bottom with labels; reversed (Min at the top), no labels
for i as long = 0 to 1
    gV(i) = tkSlider_Create( tkHost_Root( gHost ), IDC_FIRST + 10 + i )
    tkSlider_SetOrientation( gV(i), TKSL_VERTICAL )
    tkSlider_SetValueChangedCallback( gV(i), @Demo_Changed )
    tkSlider_SetValueCommittedCallback( gV(i), @Demo_Committed )
    tkSlider_SetTickFrequency( gV(i), 25 )
    tkSlider_SetTickPlacement( gV(i), iif( i = 0, TKSL_TICKS_BOTTOMRIGHT, TKSL_TICKS_BOTH ) )
next
tkSlider_SetShowTickLabels( gV(0), true )
tkSlider_SetValue( gV(0), 70 )
tkSlider_SetReversed( gV(1), true )
tkSlider_SetValue( gV(1), 30 )

gHost->OnPaint = @Form_Paint
gHost->OnSize = @Form_Size
Form_Size( gHost )
tkHost_SetFocus( gHost, gSl(0) )
tkHost_Show( gHost )

dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )
    SaveShot( shot )
else
    tkHost_Run( gHost )
end if

tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
