' The sliders' handlers: what a designed form's author writes beside the generated part.
#module "frmSliders"

#import "vendor/tkControls/tkSlider"
using tkSlider

public partial type Form
    VolChanges as long
    LastVol as double
    PriceCommits as long
    LastPriceThumb as long
    LastPrice as double
end type

sub Form.OnVolChanged( byval nThumb as int32, byval nValue as float64 )
    VolChanges += 1
    LastVol = nValue
end sub

' The labels in millilitres; the tip keeps the default text.
sub Form.OnVolFormat( byval nValue as float64, byval nWhere as int32, byref Text as ustring )
    if nWhere = TKSL_FMT_TICK then Text = str( cint( nValue ) ) & " ml"
end sub

sub Form.OnPriceCommitted( byval nThumb as int32, byval nValue as float64 )
    PriceCommits += 1
    LastPriceThumb = nThumb
    LastPrice = nValue
end sub
