format = 1

[form]
caption = "Sliders"
width = 420
height = 260
data_type = "sliderdata.Prefs"
data_module = "../sliderdata"

[[control]]
name = "sldVol"
type = "Slider"
parent = ""
x = 16
y = 16
w = 300
h = 48
bind = "Volume"

[control.props]
Range = "0,1000"
Step = 5
TickFrequency = 250
Value = 500
TickPlacement = "BottomRight"
ShowTickLabels = true

[control.events]
ValueChanged = "OnVolChanged"
FormatValue = "OnVolFormat"

[[control]]
name = "sldPrice"
type = "Slider"
parent = ""
x = 16
y = 80
w = 300
h = 32
bind = "PriceLo"
bind2 = "PriceHi"

[control.props]
Range = "0,500"
Step = 5
Mode = "Range"
Value = 120
UpperValue = 340
MinDistance = 10
AllowRangeDrag = true

[control.events]
ValueCommitted = "OnPriceCommitted"

[[control]]
name = "sldV"
type = "Slider"
parent = ""
x = 340
y = 16
w = 40
h = 200

[control.props]
Orientation = "Vertical"
Reversed = true
Value = 30
