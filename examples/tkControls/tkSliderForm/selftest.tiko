' tkSliderForm self-test (slider phase S3): frmSliders was written as a .tkform and generated by
' tkEdit --generate-forms. It checks that the designer's props reach the sliders in an order that
' survives the setters' clamps (Range before Value), that enum props carry their constants, and
' that the events a .tkform names are wired: ValueChanged, ValueCommitted and FormatValue (a
' callback that answers a ustring); and the bindings: Bind on both sliders, BindUpper on the range one.
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkSlider"
#import "vendor/tkControls/tkForms"
#import "./frmSliders"
#import "./sliderdata"
using tkApp
using tkSlider
using tkForms
using tkTheme
using tkHost
using tkTest

sub Sliders( byval owner as TK_FORM ptr )
    tkTest_Begin( "a designed form with sliders" )
    dim as frmSliders.Form f
    f.Build( owner )
    tkTest_Check( "Build opened the window", f.IsOpen( ) )
    dim as TK_HOST ptr h = tkForm_Host( f.Handle )
    f.Show( )
    tkTest_PumpFor( h, 80 )

    ' the props, in the table's order: Range 0..1000 reached the slider before Value 500
    dim as double mn, mx
    tkSlider_GetRange( f.sldVol.Handle, mn, mx )
    tkTest_Check( "Range 0..1000, then Value 500 (not clamped to the default 100)", mn = 0 andalso mx = 1000 _
                  andalso tkSlider_GetValue( f.sldVol.Handle ) = 500, str( tkSlider_GetValue( f.sldVol.Handle ) ) )
    tkTest_Check( "the wrapper's Value property reads it", f.sldVol.Value = 500 )
    tkTest_Check( "Step 5, ticks every 250, below, labelled", tkSlider_GetStep( f.sldVol.Handle ) = 5 _
                  andalso tkSlider_GetTickCount( f.sldVol.Handle ) = 5 _
                  andalso tkSlider_GetTickPlacement( f.sldVol.Handle ) = TKSL_TICKS_BOTTOMRIGHT _
                  andalso tkSlider_GetShowTickLabels( f.sldVol.Handle ) )
    tkTest_Check( "FormatValue's handler wrote the labels", tkSlider_GetLabelText( f.sldVol.Handle, 2 ) = "500 ml", _
                  tkSlider_GetLabelText( f.sldVol.Handle, 2 ) )
    tkTest_Check( "  ... an untouched Text keeps the default (the tip)", tkSlider_FormatValue( f.sldVol.Handle, 500, TKSL_FMT_TIP ) = "500" )

    tkTest_Check( "Mode = Range, (120, 340), MinDistance 10, range drag on", tkSlider_GetMode( f.sldPrice.Handle ) = TKSL_MODE_RANGE _
                  andalso tkSlider_GetValue( f.sldPrice.Handle ) = 120 andalso tkSlider_GetUpperValue( f.sldPrice.Handle ) = 340 _
                  andalso tkSlider_GetMinDistance( f.sldPrice.Handle ) = 10 andalso tkSlider_GetAllowRangeDrag( f.sldPrice.Handle ), _
                  tkSlider_GetValue( f.sldPrice.Handle ) & "," & tkSlider_GetUpperValue( f.sldPrice.Handle ) )
    tkTest_Check( "Orientation = Vertical, Reversed", tkSlider_GetOrientation( f.sldV.Handle ) = TKSL_VERTICAL _
                  andalso tkSlider_GetReversed( f.sldV.Handle ) andalso tkSlider_GetValue( f.sldV.Handle ) = 30 )
    tkTest_Check( "defaults where the form says nothing", tkSlider_GetShowValueTip( f.sldVol.Handle ) = TKSL_TIP_DRAG _
                  andalso tkSlider_GetWheelMode( f.sldV.Handle ) = TKSL_WHEEL_FOCUSED )

    ' events: user input reaches the form's handlers
    tkHost_SetFocus( h, f.sldVol.Handle )
    tkTest_PushKey( h, SDLK_RIGHT )
    tkTest_Check( "ValueChanged reached OnVolChanged", f.VolChanges = 1 andalso f.LastVol = 505, f.VolChanges & " " & f.LastVol )
    tkHost_SetFocus( h, f.sldPrice.Handle )
    tkTest_PushKey( h, SDLK_TAB )
    tkTest_PushKey( h, SDLK_LEFT )
    tkTest_Check( "ValueCommitted reached OnPriceCommitted with thumb 1", f.PriceCommits = 1 andalso f.LastPriceThumb = 1 _
                  andalso f.LastPrice = 335, f.PriceCommits & " " & f.LastPriceThumb & " " & f.LastPrice )
    tkSlider_SetValue( f.sldVol.Handle, 700 )
    tkTest_Check( "a setter stays silent through the form", f.VolChanges = 1 )

    ' binding: the range loads lower then upper, so a pair above the old one still lands (the lower
    ' pushes the upper first); SaveTo reads both thumbs and the volume back
    dim as sliderdata.Prefs r
    r.Volume = 250 : r.PriceLo = 400 : r.PriceHi = 450
    f.LoadFrom( r )
    tkTest_Check( "LoadFrom: volume 250, price (400, 450) from (120, 335)", tkSlider_GetValue( f.sldVol.Handle ) = 250 _
                  andalso tkSlider_GetValue( f.sldPrice.Handle ) = 400 andalso tkSlider_GetUpperValue( f.sldPrice.Handle ) = 450, _
                  tkSlider_GetValue( f.sldVol.Handle ) & " " & tkSlider_GetValue( f.sldPrice.Handle ) & "," & tkSlider_GetUpperValue( f.sldPrice.Handle ) )
    tkHost_SetFocus( h, f.sldVol.Handle )
    tkTest_PushKey( h, SDLK_RIGHT )
    dim as sliderdata.Prefs r2
    f.SaveTo( r2 )
    tkTest_Check( "SaveTo after a user step: 255, 400, 450", r2.Volume = 255 andalso r2.PriceLo = 400 andalso r2.PriceHi = 450, _
                  r2.Volume & " " & r2.PriceLo & " " & r2.PriceHi )
    f.Close( )
    tkTest_PumpFor( h, 40 )
end sub

dim as TKAPP_OPTIONS opts
if tkApp_Init( opts ) = false then
    print "tkApp_Init failed"
    end 98
end if
dim as TK_FORM ptr mainForm = tkApp_NewForm( "owner", 200, 120, 0, 1.0 )
tkForm_Show( mainForm )
tkTest_PumpFor( tkForm_Host( mainForm ), 50 )
Sliders( mainForm )
dim as long nFail = tkTest_Report( "tkSliderForm" )
tkApp_Shutdown( )
end nFail
