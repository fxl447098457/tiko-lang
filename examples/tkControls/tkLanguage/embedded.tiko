' A program whose catalog is built in: catalogs/es.toml is inside embedded.exe (#embed), so it runs
' with no lang/ folder beside it -- copy embedded.exe (and SDL's libraries) anywhere and it still
' answers in Spanish. This is what the Form Designer's generated appLanguages.design.tiko does.
'
'   embedded            prints the caption; exit code 0 = Spanish, 1 = not
#import "std/fs"
#import "vendor/tkControls/tkLanguage"
#import "vendor/tkControls/tkForms"
using tkLanguage
using tkForms

#embed gLang0_ "catalogs/es.toml"

tkLanguage_AddData( "es", "Espa" & wchr( &hF1 ) & "ol", @gLang0_(0), ubound( gLang0_ ) + 1 )
dim as boolean ok = tkLanguage_Use( "es" )
dim as ustring s = tkForms_Tr( "frmMain.btnOK.Text", "OK" )
print "lang/ beside me: " & fs.IsDir( fs.PathJoin( exepath( ), "lang" ) )
print "frmMain.btnOK.Text = " & s
if ok andalso (s = "Aceptar") then end 0
end 1
