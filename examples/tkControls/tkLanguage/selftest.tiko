' tkLanguage self-test: catalogs registered the way the Form Designer's generated
' appLanguages.design.tiko registers them -- built in with #embed (tkLanguage_AddData), or loose
' (tkLanguage_AddFile) -- and answered through tkForms_Tr. No window: the module only installs a
' translator. catalogs/ holds the built-in ones, fixtures/ the loose ones (found beside the program).
'
'   selftest            exit code = number of failures
#import "std/fs"
#import "vendor/tkControls/tkLanguage"
#import "vendor/tkControls/tkForms"
#import "vendor/tkControls/tkTest"
using tkLanguage
using tkForms
using tkTest

#embed gLang0_ "catalogs/fr.toml"
#embed gLang1_ "catalogs/pt-BR.toml"
#embed gLang2_ "catalogs/de.toml"

function Fixture( byref f as const ustring ) as ustring
    return fs.PathJoin( exepath( ), "fixtures", f )
end function

function Has( byref w as const ustring, byref what as const ustring ) as boolean
    return instr( w, what ) > 0
end function

sub Registering( )
    tkTest_Begin( "registering" )
    tkTest_Check( "nothing registered", tkLanguage_Count( ) = 0 )
    tkTest_Check( "no language in use", tkLanguage_Current( ) = "" )
    tkTest_Check( "with none, the designed text", tkForms_Tr( "frmMain.btnOK.Text", "OK" ) = "OK" )
    tkLanguage_AddData( "fr", "Français", @gLang0_(0), ubound( gLang0_ ) + 1 )
    tkLanguage_AddData( "pt_BR", "Português (Brasil)", @gLang1_(0), ubound( gLang1_ ) + 1 )
    tkLanguage_AddData( "", "nameless", @gLang1_(0), ubound( gLang1_ ) + 1 )
    tkTest_Check( "two registered (an empty code is not)", tkLanguage_Count( ) = 2, str( tkLanguage_Count( ) ) )
    tkTest_Check( "code 0", tkLanguage_Code( 0 ) = "fr" )
    tkTest_Check( "name 0, not ASCII", tkLanguage_Name( 0 ) = "Fran" & wchr( &hE7 ) & "ais" )
    tkTest_Check( "code 1", tkLanguage_Code( 1 ) = "pt_BR" )
    tkTest_Check( "out of range", (tkLanguage_Code( 2 ) = "") andalso (tkLanguage_Name( -1 ) = "") )
end sub

sub Using_( )
    tkTest_Begin( "using a built-in catalog" )
    tkTest_Check( "Use fr", tkLanguage_Use( "fr" ), tkLanguage_Warnings( ) )
    tkTest_Check( "fr in use", tkLanguage_Current( ) = "fr" )
    tkTest_Check( "a caption", tkForms_Tr( "frmMain.btnOK.Text", "OK" ) = "Valider", tkForms_Tr( "frmMain.btnOK.Text", "OK" ) )
    tkTest_Check( "a second property", tkForms_Tr( "frmMain.btnOK.ToolTip", "Closes" ) = "Ferme la fen" & wchr( &hEA ) & "tre" )
    tkTest_Check( "the form's own (a table and its subtable)", _
                  tkForms_Tr( "frmMain.Text", "Main" ) = "Fen" & wchr( &hEA ) & "tre principale" )
    tkTest_Check( "a numeric key", tkForms_Tr( "frmItems.mnuMain.3", "Open" ) = "Ouvrir" )
    tkTest_Check( "numeric key 0", tkForms_Tr( "frmItems.mnuMain.0", "File" ) = "Fichier" )
    tkTest_Check( "a missing key falls back", tkForms_Tr( "frmMain.btnCancel.Text", "Cancel" ) = "Cancel" )
    tkTest_Check( "a missing index falls back", tkForms_Tr( "frmItems.mnuMain.4", "Save" ) = "Save" )
    tkTest_Check( "[_source] is skipped", tkForms_Tr( "_source.frmMain.btnOK.Text", "x" ) = "x" )
    tkTest_Check( "a non-string is noted", Has( tkLanguage_Warnings( ), "frmItems.lstItems.Count" ), tkLanguage_Warnings( ) )
    tkTest_Check( "and skipped", tkForms_Tr( "frmItems.lstItems.Count", "n" ) = "n" )
    tkTest_Check( "codes match without case, - for _", tkLanguage_Use( "PT-br" ), tkLanguage_Warnings( ) )
    tkTest_Check( "pt_BR in use, as registered", tkLanguage_Current( ) = "pt_BR", tkLanguage_Current( ) )
    tkTest_Check( "pt_BR's caption", tkForms_Tr( "frmMain.btnOK.Text", "OK" ) = "Confirmar" )
    tkTest_Check( "a key only fr has falls back", tkForms_Tr( "frmItems.mnuMain.3", "Open" ) = "Open" )
end sub

sub Failing( )
    tkTest_Begin( "what fails" )
    tkLanguage_Use( "fr" )
    tkTest_Check( "an unknown code is false", tkLanguage_Use( "xx" ) = false )
    tkTest_Check( "and says so", Has( tkLanguage_Warnings( ), "xx" ), tkLanguage_Warnings( ) )
    tkTest_Check( "and leaves fr", (tkLanguage_Current( ) = "fr") andalso (tkForms_Tr( "frmMain.btnOK.Text", "OK" ) = "Valider") )
    tkLanguage_AddFile( "de", "Deutsch", Fixture( "no-such-file.toml" ) )
    tkTest_Check( "an unreadable file is false", tkLanguage_Use( "de" ) = false )
    tkTest_Check( "and names it", Has( tkLanguage_Warnings( ), "no-such-file.toml" ), tkLanguage_Warnings( ) )
    tkTest_Check( "and leaves fr", (tkLanguage_Current( ) = "fr") andalso (tkForms_Tr( "frmMain.btnOK.Text", "OK" ) = "Valider") )
    tkLanguage_AddFile( "it", "Italiano", Fixture( "bad.toml" ) )
    tkTest_Check( "text that isn't TOML is false", tkLanguage_Use( "it" ) = false )
    tkTest_Check( "and says why", len( tkLanguage_Warnings( ) ) > 0 )
    tkTest_Check( "and leaves fr", (tkLanguage_Current( ) = "fr") andalso (tkForms_Tr( "frmMain.btnOK.Text", "OK" ) = "Valider") )
    tkLanguage_AddFile( "nl", "Nederlands", Fixture( "v2.toml" ) )
    tkTest_Check( "another format is read anyway", tkLanguage_Use( "nl" ), tkLanguage_Warnings( ) )
    tkTest_Check( "noted", Has( tkLanguage_Warnings( ), "format" ) andalso Has( tkLanguage_Warnings( ), "frmMain.x" ), tkLanguage_Warnings( ) )
    tkTest_Check( "its text", tkForms_Tr( "frmMain.Text", "Main" ) = "Deux" )
    tkTest_Check( "Use "" removes the translator", tkLanguage_Use( "" ) )
    tkTest_Check( "none in use", tkLanguage_Current( ) = "" )
    tkTest_Check( "the designed text again", tkForms_Tr( "frmMain.btnOK.Text", "OK" ) = "OK" )
end sub

sub Overriding( )
    tkTest_Begin( "a loose catalog overrides the built-in one" )
    dim as long n = tkLanguage_Count( )
    tkLanguage_AddFile( "FR", "Fran" & wchr( &hE7 ) & "ais (fichier)", Fixture( "fr.toml" ) )
    tkTest_Check( "the same code replaces, not adds", tkLanguage_Count( ) = n, str( tkLanguage_Count( ) ) )
    tkTest_Check( "in its place", Has( tkLanguage_Name( 0 ), "fichier" ), tkLanguage_Name( 0 ) )
    tkTest_Check( "Use fr", tkLanguage_Use( "fr" ), tkLanguage_Warnings( ) )
    tkTest_Check( "the file's text", tkForms_Tr( "frmMain.btnOK.Text", "OK" ) = "D'accord", tkForms_Tr( "frmMain.btnOK.Text", "OK" ) )
    tkTest_Check( "nothing of the built-in one", tkForms_Tr( "frmItems.mnuMain.3", "Open" ) = "Open" )
    tkLanguage_AddData( "fr", "Fran" & wchr( &hE7 ) & "ais", @gLang0_(0), ubound( gLang0_ ) + 1 )
    tkTest_Check( "registering again does not reload", tkForms_Tr( "frmMain.btnOK.Text", "OK" ) = "D'accord" )
    tkTest_Check( "Use does", tkLanguage_Use( "fr" ) andalso (tkForms_Tr( "frmMain.btnOK.Text", "OK" ) = "Valider") )
end sub

sub Locales( )
    tkTest_Begin( "the user's locale" )
    tkTest_Check( "ll_CC matches", tkLanguage_UseLocales( "pt_BR" ) andalso (tkLanguage_Current( ) = "pt_BR"), tkLanguage_Current( ) )
    tkTest_Check( "ll when ll_CC is not registered", tkLanguage_UseLocales( "fr_CA" ) andalso (tkLanguage_Current( ) = "fr"), tkLanguage_Current( ) )
    tkTest_Check( "the first registered wins", tkLanguage_UseLocales( "ja_JP,fr_BE,pt_BR" ) andalso (tkLanguage_Current( ) = "fr"), tkLanguage_Current( ) )
    tkTest_Check( "ll_CC before the next entry's", tkLanguage_UseLocales( "pt-BR,fr" ) andalso (tkLanguage_Current( ) = "pt_BR"), tkLanguage_Current( ) )
    tkTest_Check( "a POSIX locale's suffix is dropped", tkLanguage_UseLocales( "fr_FR.UTF-8" ) andalso (tkLanguage_Current( ) = "fr"), tkLanguage_Current( ) )
    tkTest_Check( "an unreadable match is passed over", tkLanguage_UseLocales( "it_IT, fr" ) andalso (tkLanguage_Current( ) = "fr"), _
                  tkLanguage_Current( ) & " / " & tkLanguage_Warnings( ) )
    tkTest_Check( "pt does not reach pt_BR", tkLanguage_UseLocales( "pt" ) = false )
    tkTest_Check( "none registered: false", tkLanguage_UseLocales( "en_US,ja" ) = false )
    tkTest_Check( "and the designed text", (tkLanguage_Current( ) = "") andalso (tkForms_Tr( "frmMain.btnOK.Text", "OK" ) = "OK") )
    tkTest_Check( "an empty list: none", (tkLanguage_UseLocales( "" ) = false) andalso (tkLanguage_Current( ) = "") )
    dim as ustring sys = tkLanguage_SystemLocales( )
    print "system locales: " & sys
    tkTest_Check( "the system has a preferred locale", len( sys ) > 0 )
    dim as boolean b = tkLanguage_UseSystem( )
    tkTest_Check( "UseSystem is UseLocales of the system's", b = tkLanguage_UseLocales( sys ), tkLanguage_Current( ) )
    tkTest_Check( "and in use exactly when it says so", b = (len( tkLanguage_Current( ) ) > 0) )
end sub

sub DesignerShape( )
    tkTest_Begin( "the designer's catalog shape" )
    tkLanguage_AddData( "de_DE", "Deutsch", @gLang2_(0), ubound( gLang2_ ) + 1 )
    tkTest_Check( "Use de_DE", tkLanguage_Use( "de_DE" ), tkLanguage_Warnings( ) )
    tkTest_Check( "no warnings", tkLanguage_Warnings( ) = "", tkLanguage_Warnings( ) )
    tkTest_Check( "a form property", tkForms_Tr( "frmMain.Caption", "Main" ) = "Hauptfenster" )
    tkTest_Check( "a quoted dotted key", tkForms_Tr( "frmMain.btnOK.Text", "OK" ) = wchr( &hDC ) & "bernehmen", tkForms_Tr( "frmMain.btnOK.Text", "OK" ) )
    tkTest_Check( "a quoted numeric key", tkForms_Tr( "frmMain.mnuMain.3", "Open" ) = wchr( &hD6 ) & "ffnen" )
    tkTest_Check( "[_source.frmMain] is skipped", tkForms_Tr( "_source.frmMain.btnOK.Text", "x" ) = "x" )
end sub

sub BaseLanguage( )
    tkTest_Begin( "the base language" )
    tkLanguage_Use( "fr" )
    dim as long n = tkLanguage_Count( )
    tkLanguage_SetBase( "en", "English" )
    tkTest_Check( "base code and name", (tkLanguage_BaseCode( ) = "en") andalso (tkLanguage_BaseName( ) = "English") )
    tkTest_Check( "not counted as a catalog", tkLanguage_Count( ) = n )
    tkTest_Check( "setting it leaves fr in use", (tkLanguage_Current( ) = "fr") andalso (tkForms_Tr( "frmMain.btnOK.Text", "OK" ) = "Valider") )
    tkTest_Check( "Use the base", tkLanguage_Use( "EN" ) )
    tkTest_Check( "the base is current", tkLanguage_Current( ) = "en", tkLanguage_Current( ) )
    tkTest_Check( "and the designed text shows", tkForms_Tr( "frmMain.btnOK.Text", "OK" ) = "OK" )
    tkLanguage_Use( "fr" )
    tkTest_Check( "Use "" is the base too", tkLanguage_Use( "" ) andalso (tkLanguage_Current( ) = "en") )
    tkTest_Check( "the base stops the walk", tkLanguage_UseLocales( "en_GB,fr" ) andalso (tkLanguage_Current( ) = "en"), tkLanguage_Current( ) )
    tkTest_Check( "a registered ll_CC first is used", tkLanguage_UseLocales( "de_DE,en" ) andalso (tkLanguage_Current( ) = "de_DE"), tkLanguage_Current( ) )
    tkTest_Check( "after an unregistered one", tkLanguage_UseLocales( "ja,fr_CA,en" ) andalso (tkLanguage_Current( ) = "fr"), tkLanguage_Current( ) )
    tkTest_Check( "none: false, the base", (tkLanguage_UseLocales( "ja,ko" ) = false) andalso (tkLanguage_Current( ) = "en"), tkLanguage_Current( ) )
    dim as boolean b = tkLanguage_UseSystem( )
    tkTest_Check( "UseSystem with a base", b = tkLanguage_UseLocales( tkLanguage_SystemLocales( ) ), tkLanguage_Current( ) )
end sub

Registering( )
Using_( )
Failing( )
Overriding( )
Locales( )
DesignerShape( )
BaseLanguage( )
end tkTest_Report( "tkLanguage" )
