' tkSpinner demo: the six styles side by side; four settings (a slow twelve-dot ring, a thick
' opaque ring, a disabled spinner, a paint callback that writes the phase in the middle); and a
' Save button whose spinner shows only while a pretend save (a two-second tkTimer) runs.
'
'   demo                     interactive (Stop all / Start all, Save)
'   demo --shot out.bmp      render once, save the window, exit
'   demo --scale 1.75        pin the scale instead of asking the display
#import "vendor/tkControls/tkSpinner"
#import "vendor/tkControls/tkButton"
#import "vendor/tkControls/tkTimer"
using tkSpinner
using tkButton
using tkTimer
using tkTheme
using tkHost
using tkPaint

const as long NSPIN = 10                                     ' 0..5 the styles, 6..9 the settings
dim shared as TK_HOST ptr gHost
dim shared as TTF_Font ptr gFont, gFontSmall
dim shared as TK_WIDGET ptr gSpin(0 to NSPIN - 1), gSave, gBtnAll, gBtnSave, gSaveTimer
dim shared as ustring gCap(0 to NSPIN - 1), gStatus

' Spinner 9's frame: the stock ring, then the phase as a percentage in the middle.
sub Phase_Paint( byval p as TKSPINNER_PAINTINFO ptr )
    tkSpinner_PaintDefault( p )
    p->b->SetFont( gFontSmall )
    p->b->SetForeColor( tkTheme_Of( p->hSpinner ).Text )
    dim as TKRECT rc = p->rc
    p->b->PaintText( int( p->fPhase * 100 ) & "%", @rc, TK_DT_CENTER or TK_DT_VCENTER )
end sub

sub SaveDone( byval hTimer as TK_WIDGET ptr )
    tkTimer_SetInterval( hTimer, 0 )                        ' one shot
    tkSpinner_Stop( gSave )                                 ' HideWhenStopped: it disappears
    tkButton_SetEnabled( gBtnSave, true )
    gStatus = "Saved invoice INV-2026-0417"
    print "save: done"
    tkHost_Invalidate( gHost )
end sub

sub Button_Click( byval hButton as TK_WIDGET ptr, byval id as long )
    if hButton = gBtnAll then
        dim as boolean bRun = not tkSpinner_IsRunning( gSpin(0) )
        for i as long = 0 to NSPIN - 1
            tkSpinner_SetRunning( gSpin(i), bRun )
        next
        tkButton_SetText( hButton, iif( bRun, "Stop all", "Start all" ) )
        print "spinners " & iif( bRun, "started", "stopped" ) & ", phase of the first " & tkSpinner_GetPhase( gSpin(0) )
    else
        tkSpinner_Start( gSave )
        tkButton_SetEnabled( gBtnSave, false )
        tkTimer_SetInterval( gSaveTimer, 2000 )
        gStatus = "Saving invoice INV-2026-0417..."
        print "save: started, running=" & tkSpinner_IsRunning( gSave )
        tkHost_Invalidate( gHost )
    end if
end sub

private sub CellRect( byval h as TK_HOST ptr, byval i as long, byref rc as TKRECT )
    dim as long col = iif( i < 6, i, i - 6 ), y = iif( i < 6, 40, 160 )
    tkRect_Set( rc, tkHost_Scale( h, 20 + col * 104 ), tkHost_Scale( h, y ), tkHost_Scale( h, 20 + col * 104 + 100 ), tkHost_Scale( h, y + 80 ) )
end sub

private sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    dim as TKTHEME_COLORS t = tkTheme_Of( tkHost_Root( h ) )
    dim as TKRECT rc
    b->SetFont( gFont )
    b->SetColors( t.TextStrong, t.Window )
    tkRect_Set( rc, tkHost_Scale( h, 20 ), tkHost_Scale( h, 10 ), tkHost_Scale( h, 640 ), tkHost_Scale( h, 32 ) )
    b->PaintText( "The six styles", @rc, TK_DT_LEFT or TK_DT_VCENTER )
    tkRect_Set( rc, tkHost_Scale( h, 20 ), tkHost_Scale( h, 130 ), tkHost_Scale( h, 640 ), tkHost_Scale( h, 152 ) )
    b->PaintText( "Settings", @rc, TK_DT_LEFT or TK_DT_VCENTER )
    b->SetColors( t.TextDim, t.Window )
    for i as long = 0 to NSPIN - 1
        CellRect( h, i, rc )
        rc.top = rc.bottom - tkHost_Scale( h, 22 )
        b->PaintText( gCap(i), @rc, TK_DT_CENTER or TK_DT_VCENTER )
    next
    tkRect_Set( rc, tkHost_Scale( h, 284 ), tkHost_Scale( h, 262 ), tkHost_Scale( h, 640 ), tkHost_Scale( h, 292 ) )
    b->SetColors( t.Text, t.Window )
    b->PaintText( gStatus, @rc, TK_DT_LEFT or TK_DT_VCENTER )
end sub

private sub Form_Size( byval h as TK_HOST ptr )
    for i as long = 0 to NSPIN - 1
        dim as TKRECT rc
        CellRect( h, i, rc )
        dim as long sz = tkHost_Scale( h, 48 )
        tkWidget_SetPos( gSpin(i), (rc.left + rc.right - sz) \ 2, rc.top + tkHost_Scale( h, 4 ), sz, sz )
    next
    tkWidget_SetPos( gBtnAll,  tkHost_Scale( h, 20 ),  tkHost_Scale( h, 262 ), tkHost_Scale( h, 100 ), tkHost_Scale( h, 30 ) )
    tkWidget_SetPos( gBtnSave, tkHost_Scale( h, 132 ), tkHost_Scale( h, 262 ), tkHost_Scale( h, 100 ), tkHost_Scale( h, 30 ) )
    tkWidget_SetPos( gSave,    tkHost_Scale( h, 244 ), tkHost_Scale( h, 265 ), tkHost_Scale( h, 24 ),  tkHost_Scale( h, 24 ) )
end sub

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

private function HasArg( byref name_ as string ) as boolean
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return true
    next
    return false
end function

private sub SaveShot( byval h as TK_HOST ptr, byref path as string )
    tkHost_Render( h )
    tkHost_RenderTo( h, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( h->renderer, 0 )
    if s then
        SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & h->fScale
        SDL_DestroySurface( s )
    end if
end sub

if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
dim as single forced = val( ArgValue( "--scale" ) )
gHost = tkHost_Create( "tkSpinner on SDL3", 660, 310, tkHost_FontDir() & TK_FONT_UI, forced )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
gHost->clrBack = tkTheme_Of( tkHost_Root( gHost ) ).Window
gFont = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 10 )
gFontSmall = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 8 )

dim as TK_WIDGET ptr root = tkHost_Root( gHost )
gStatus = "Ready"
dim as ustring styleCap(0 to 5) = { "Ring", "Arc", "Dots", "Spokes", "Pulse", "Bounce" }
for i as long = 0 to 5
    gSpin(i) = tkSpinner_Create( root, 100 + i, SPN_STYLE_RING + i )
    gCap(i) = styleCap(i)
next
gSpin(6) = tkSpinner_Create( root, 106, SPN_STYLE_DOTS ) : gCap(6) = "12 dots, 2.5 s"
tkSpinner_SetCount( gSpin(6), 12 )
tkSpinner_SetPeriod( gSpin(6), 2500 )
gSpin(7) = tkSpinner_Create( root, 107 ) : gCap(7) = "thick, opaque"
tkSpinner_SetThickness( gSpin(7), 8 )
tkSpinner_SetTransparent( gSpin(7), false )
dim as TKSPINNER_COLORS sc
tkSpinner_GetColors( gSpin(7), @sc )
sc.BackColor = tkTheme_Of( root ).Surface                    ' opaque: a back of its own (pinned)
tkSpinner_SetColors( gSpin(7), @sc )
gSpin(8) = tkSpinner_Create( root, 108, SPN_STYLE_SPOKES ) : gCap(8) = "disabled"
tkWidget_Enable( gSpin(8), false )
gSpin(9) = tkSpinner_Create( root, 109 ) : gCap(9) = "paint callback"
tkSpinner_SetPaintCallback( gSpin(9), @Phase_Paint )
for i as long = 0 to NSPIN - 1
    tkSpinner_SetPhase( gSpin(i), 0.3 )                      ' a frame that shows each shape well
    tkSpinner_Start( gSpin(i) )
next

gBtnAll = tkButton_Create( root, 200 )
tkButton_SetText( gBtnAll, "Stop all" )
tkButton_SetClickCallback( gBtnAll, @Button_Click )
gBtnSave = tkButton_Create( root, 201 )
tkButton_SetText( gBtnSave, "Save" )
tkButton_SetClickCallback( gBtnSave, @Button_Click )
gSave = tkSpinner_Create( root, 110, SPN_STYLE_ARC )
tkSpinner_SetHideWhenStopped( gSave, true )                  ' shows only while a save runs
gSaveTimer = tkTimer_Create( root, 300 )
tkTimer_SetTickCallback( gSaveTimer, @SaveDone )

gHost->OnPaint = @Form_Paint
gHost->OnSize = @Form_Size
Form_Size( gHost )
tkHost_Show( gHost )

dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )
    SaveShot( gHost, shot )
else
    tkHost_Run( gHost )
end if
tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
