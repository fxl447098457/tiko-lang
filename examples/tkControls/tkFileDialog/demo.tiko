' tkFileDialog demo: the system's own Open, Open multiple, Save and Folder dialogs, with filters.
' Open, Open multiple and Folder use the callback form (tkFileDialog_Show returns at once and the
' answer comes back on the UI thread); Save uses the waiting form (tkFileDialog_Wait). What comes
' back -- the paths, the filter chosen, a cancel or an error -- is printed and shown in the box.
'
'   demo                          run it
'   demo --shot out.bmp           render once, save the window, exit (opens no dialog)
'   demo --scale 1.75             pin the scale
#import "std/containers"
#import "vendor/tkControls/tkFileDialog"
#import "vendor/tkControls/tkButton"
#import "vendor/tkControls/tkTextBox"
using containers
using tkFileDialog
using tkButton
using tkTextBox
using tkTheme
using tkHost
using tkPaint

const FILTER_OPEN = "tiko source|*.tiko;*.bi|Text|*.txt;*.md|All files|*.*"
const FILTER_MANY = "Images|*.png;*.jpg;*.bmp|All files|*.*"
const FILTER_SAVE = "Text|*.txt|Markdown|*.md"

dim shared as TK_HOST ptr gHost
dim shared as TK_WIDGET ptr gBtn(0 to 3), gOut
dim shared as TTF_Font ptr gFont
dim shared as ustring gWhat(0 to 3)

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

' print the answer and show it in the box
private sub Report( byref what as ustring, byref paths as Array( of ustring ), byval filterIndex as long, byval bError as boolean )
    dim as ustring s = what & ": "
    if bError then
        s &= "error -- " & tkFileDialog_LastError()
    elseif paths.Count() = 0 then
        s &= "cancelled"
    else
        s &= paths.Count() & " path(s), filter " & filterIndex
        for i as long = 0 to paths.Count() - 1
            s &= chr( 10 ) & "  " & paths.At( i )
        next
    end if
    print s
    tkTextBox_SetText( gOut, s )
end sub

' the callback form: runs on the UI thread when the user answers; user carries the button's index
private sub OnAnswer( byval owner as TK_HOST ptr, byref paths as Array( of ustring ), _
                      byval filterIndex as long, byval bError as boolean, byval user as any ptr )
    Report( gWhat( cint( cast( integer, user ) ) ), paths, filterIndex, bError )
end sub

private sub Btn_Click( byval h as TK_WIDGET ptr, byval id as long )
    dim as ustring here = curdir()
    select case id
    case 1000 : tkFileDialog_Show( TKFD_OPEN, gHost, FILTER_OPEN, here, false, @OnAnswer, cast( any ptr, 0 ) )
    case 1001 : tkFileDialog_Show( TKFD_OPEN, gHost, FILTER_MANY, here, true, @OnAnswer, cast( any ptr, 1 ) )
    case 1002
        ' the waiting form: the loop keeps running until the user answers
        dim as Array( of ustring ) paths
        dim as boolean ok = tkFileDialog_Wait( TKFD_SAVE, gHost, FILTER_SAVE, here & iif( instr( here, "/" ) > 0, "/", "\" ) & "untitled.txt", false, paths )
        Report( gWhat(2), paths, -1, (ok = false) andalso (len( tkFileDialog_LastError() ) > 0) )
    case 1003 : tkFileDialog_Show( TKFD_FOLDER, gHost, "", here, false, @OnAnswer, cast( any ptr, 3 ) )
    end select
end sub

private sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    dim as ustring heads(0 to 1) = { "The system's dialogs (callback form; Save waits)", "What came back" }
    b->SetFont( gFont )
    b->SetForeColor( tkTheme_Of( tkHost_Root( h ) ).TextDim )
    for i as long = 0 to 1
        dim as TKRECT rc
        tkRect_Set( rc, tkHost_Scale( h, 20 ), tkHost_Scale( h, 10 + i * 76 ), tkHost_Scale( h, 680 ), tkHost_Scale( h, 34 + i * 76 ) )
        b->PaintText( heads(i), @rc, TK_DT_LEFT or TK_DT_VCENTER )
    next
end sub

private sub Form_Size( byval h as TK_HOST ptr )
    for i as long = 0 to 3
        tkWidget_SetPos( gBtn(i), tkHost_Scale( h, 20 + i * 168 ), tkHost_Scale( h, 40 ), tkHost_Scale( h, 156 ), tkHost_Scale( h, 32 ) )
    next
    tkWidget_SetPos( gOut, tkHost_Scale( h, 20 ), tkHost_Scale( h, 116 ), tkHost_Scale( h, 660 ), tkHost_Scale( h, 130 ) )
end sub

private sub SaveShot( byval h as TK_HOST ptr, byref path as string )
    tkHost_Render( h )
    tkHost_RenderTo( h, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( h->renderer, 0 )
    if s then
        SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & h->fScale
        SDL_DestroySurface( s )
    end if
end sub

if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
dim as single forced = val( ArgValue( "--scale" ) )
gHost = tkHost_Create( "tkFileDialog on SDL3", 700, 266, tkHost_FontDir() & TK_FONT_UI, forced )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
gHost->clrBack = tkTheme_Of( tkHost_Root( gHost ) ).Window
gFont = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 10 )

gWhat(0) = "Open" : gWhat(1) = "Open multiple" : gWhat(2) = "Save" : gWhat(3) = "Folder"
dim as ustring caps(0 to 3) = { "Open...", "Open multiple...", "Save as...", "Folder..." }
dim as ustring tips(0 to 3) = { FILTER_OPEN, FILTER_MANY, FILTER_SAVE & "  (waits)", "a folder, starting here" }
for i as long = 0 to 3
    gBtn(i) = tkButton_Create( tkHost_Root( gHost ), 1000 + i )
    tkButton_SetText( gBtn(i), caps(i) )
    tkButton_SetTooltipText( gBtn(i), tips(i) )
    tkButton_SetClickCallback( gBtn(i), @Btn_Click )
next
gOut = tkTextBox_Create( tkHost_Root( gHost ), 1100, true )
tkTextBox_SetReadOnly( gOut, true )
tkTextBox_SetText( gOut, "Nothing chosen yet. Starting folder: " & curdir() )

gHost->OnPaint = @Form_Paint
gHost->OnSize = @Form_Size
Form_Size( gHost )
tkHost_SetFocus( gHost, gBtn(0) )
tkHost_Show( gHost )

dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )                           ' no dialog is ever opened in shot mode
    SaveShot( gHost, shot )
else
    tkHost_Run( gHost )
end if
tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
