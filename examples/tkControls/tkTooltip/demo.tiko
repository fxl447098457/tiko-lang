' tkTooltip demo: tips on widgets of our own. Four cards -- plain text; a title and an icon; a
' balloon with a stem; text from a callback, with the show callback printing each show and hide --
' a colour strip with one tip per cell (the mouse-move watcher sets the tool index), and a
' tkButton whose own tip is reached through tkButton_GetTooltipHandle. Rest the mouse on one.
'
'   demo                          run it
'   demo --shot out.bmp           render once, save the window, exit
'   demo --shot out.bmp --open    the same, also showing two tips by code (ShowForRect) and saving
'                                 them: out.bmp.tip.bmp (title + icon), out.bmp.balloon.bmp
'   demo --scale 1.75             pin the scale
#import "vendor/tkControls/tkTooltip"
#import "vendor/tkControls/tkPanel"
#import "vendor/tkControls/tkLabel"
#import "vendor/tkControls/tkButton"
using tkTooltip
using tkPanel
using tkLabel
using tkButton
using tkTheme
using tkHost
using tkPaint

dim shared as TK_HOST ptr gHost
dim shared as TK_WIDGET ptr gCard(0 to 3), gCap(0 to 3), gStrip, gButton
dim shared as TK_TIP ptr gTip(0 to 3), gStripTip
dim shared as TTF_Font ptr gFont, gTipText, gTipTitle, gTipGlyph
dim shared as long gShows
dim shared as ustring gCellName(0 to 4)
dim shared as ulong gCellClr(0 to 4) = { &hFFC0504Dul, &hFFE0A030ul, &hFF5BA85Bul, &hFF3A9C9Cul, &hFF8A63B8ul }

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

private function HasArg( byref name_ as string ) as boolean
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return true
    next
    return false
end function

' card 3's text is worked out each time it is about to show
private function Dynamic_Text( byval hTooltip as TK_TIP ptr, byval hAttached as TK_WIDGET ptr, byval idx as long ) as ustring
    return "Shown " & gShows & " time(s) before." & chr( 10 ) & "The time now is " & time & "."
end function

private function Dynamic_Show( byval hTooltip as TK_TIP ptr, byval hAttached as TK_WIDGET ptr, byval idx as long, byval bShowing as boolean ) as boolean
    print "Show callback: " & iif( bShowing, "showing", "hiding" )
    if bShowing then gShows += 1
    return true
end function

' the strip's text depends on the hovered cell, which the tool index carries
private function Strip_Text( byval hTooltip as TK_TIP ptr, byval hAttached as TK_WIDGET ptr, byval idx as long ) as ustring
    if (idx < 0) orelse (idx > 4) then return ""
    return "Cell " & idx & ": " & gCellName(idx) & " (&h" & hex( gCellClr(idx) and &hFFFFFF, 6 ) & ")"
end function

private sub Strip_MouseMove( byval w as TK_WIDGET ptr, byval x as long, byval y as long, byval buttons as long, byval mods as long )
    dim as long idx = x * 5 \ iif( w->cw > 0, w->cw, 1 )
    if idx > 4 then idx = 4
    if tkTooltip_GetToolIndex( gStripTip ) <> idx then print "Strip tool index " & idx
    tkTooltip_SetToolIndex( gStripTip, idx )      ' a set to the current value costs nothing
end sub

private sub Strip_Paint( byval p as TKPANEL_PAINTINFO ptr )
    dim as long cw = p->rcClient.right - p->rcClient.left
    for i as long = 0 to 4
        dim as TKRECT rc
        tkRect_Set( rc, p->rcClient.left + cw * i \ 5, p->rcClient.top, p->rcClient.left + cw * (i + 1) \ 5, p->rcClient.bottom )
        p->b->SetColors( &hFFFFFFFFul, gCellClr(i) )
        p->b->PaintRect( @rc )
        p->b->SetFont( gFont )
        p->b->PaintText( gCellName(i), @rc, TK_DT_CENTER or TK_DT_VCENTER )
    next
end sub

private sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    dim as ustring heads(0 to 1) = { "Rest the mouse on a card", "A tip per cell (tool index), and a tkButton's own tip" }
    b->SetFont( gFont )
    b->SetForeColor( tkTheme_Of( tkHost_Root( h ) ).TextDim )
    for i as long = 0 to 1
        dim as TKRECT rc
        tkRect_Set( rc, tkHost_Scale( h, 20 ), tkHost_Scale( h, 10 + i * 130 ), tkHost_Scale( h, 740 ), tkHost_Scale( h, 34 + i * 130 ) )
        b->PaintText( heads(i), @rc, TK_DT_LEFT or TK_DT_VCENTER )
    next
end sub

private sub Form_Size( byval h as TK_HOST ptr )
    for i as long = 0 to 3
        tkWidget_SetPos( gCard(i), tkHost_Scale( h, 20 + i * 180 ), tkHost_Scale( h, 40 ), tkHost_Scale( h, 160 ), tkHost_Scale( h, 80 ) )
        tkWidget_SetPos( gCap(i), tkHost_Scale( h, 8 ), tkHost_Scale( h, 8 ), tkHost_Scale( h, 144 ), tkHost_Scale( h, 64 ) )
    next
    tkWidget_SetPos( gStrip, tkHost_Scale( h, 20 ), tkHost_Scale( h, 170 ), tkHost_Scale( h, 440 ), tkHost_Scale( h, 44 ) )
    tkWidget_SetPos( gButton, tkHost_Scale( h, 480 ), tkHost_Scale( h, 177 ), tkHost_Scale( h, 160 ), tkHost_Scale( h, 30 ) )
end sub

private sub SaveShot( byval h as TK_HOST ptr, byref path as string )
    tkHost_Render( h )
    tkHost_RenderTo( h, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( h->renderer, 0 )
    if s then
        SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & h->fScale
        SDL_DestroySurface( s )
    end if
end sub

' Show a card's tip by code under the card and save it (the clock would hide it on its next tick,
' the cursor not being on the card, so it is shot at once).
private sub ShootTip( byval i as long, byref path as string )
    dim as TKRECT rc
    tkRect_Set( rc, 0, 0, gCard(i)->cw, gCard(i)->ch )
    if tkTooltip_ShowForRect( gTip(i), rc, TIP_ALIGN_BELOW ) andalso (tkTooltip_Surface( gTip(i) ) <> 0) then
        SaveShot( tkTooltip_Surface( gTip(i) ), path )
    end if
    tkTooltip_Hide( gTip(i) )
end sub

if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
dim as single forced = val( ArgValue( "--scale" ) )
gHost = tkHost_Create( "tkTooltip on SDL3", 760, 234, tkHost_FontDir() & TK_FONT_UI, forced )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
gHost->clrBack = tkTheme_Of( tkHost_Root( gHost ) ).Window
gFont = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 10 )
gTipText = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 9 )
gTipTitle = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI_BOLD, 9 )
gTipGlyph = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_ICONS, 12 )
' every tip created from here on, the button's own included, takes these fonts
tkTooltip_SetDefaultFonts( gTipText, gTipTitle, gTipGlyph )
gCellName(0) = "Red" : gCellName(1) = "Amber" : gCellName(2) = "Green" : gCellName(3) = "Teal" : gCellName(4) = "Violet"

dim as ustring caps(0 to 3) = { "Plain text", "Title and icon", "Balloon with a stem", "Text from a callback" }
for i as long = 0 to 3
    gCard(i) = tkPanel_Create( tkHost_Root( gHost ), 1000 + i )
    tkPanel_SetBorderStyle( gCard(i), PNL_BORDER_LINE )
    gCap(i) = tkLabel_Create( gCard(i), 1 )
    tkLabel_SetText( gCap(i), caps(i) )
    tkLabel_SetAlign( gCap(i), LBL_ALIGN_CENTER )
    tkLabel_SetWordWrap( gCap(i), true )
    tkLabel_SetTransparent( gCap(i), true )
    gTip(i) = tkTooltip_Create( gCard(i) )            ' created AND attached
next
tkTooltip_SetText( gTip(0), "A plain rounded tip: text only." )

tkTooltip_SetTitle( gTip(1), "Information" )
tkTooltip_SetGlyph( gTip(1), wchr( TK_ICON_INFO ) )
tkTooltip_SetText( gTip(1), "A title and an icon over a message that wraps at the tip's maximum width, which is set here to 220 units." )
tkTooltip_SetMaxWidth( gTip(1), tkHost_Scale( gHost, 220 ) )

tkTooltip_SetStyle( gTip(2), TIP_STYLE_BALLOON )
tkTooltip_SetTitle( gTip(2), "Careful" )
tkTooltip_SetGlyph( gTip(2), wchr( TK_ICON_WARNING ) )
tkTooltip_SetText( gTip(2), "A balloon: its stem points at the card." )
tkTooltip_SetInitialDelay( gTip(2), 200 )

tkTooltip_SetTooltipCallback( gTip(3), @Dynamic_Text )
tkTooltip_SetShowCallback( gTip(3), @Dynamic_Show )
tkTooltip_SetAutoPopDelay( gTip(3), 0 )                ' stays until the mouse leaves

gStrip = tkPanel_Create( tkHost_Root( gHost ), 1100 )
tkPanel_SetPaintCallback( gStrip, @Strip_Paint )
tkWidget_SetMouseMoveCallback( gStrip, @Strip_MouseMove )
gStripTip = tkTooltip_Create( gStrip )
tkTooltip_SetTooltipCallback( gStripTip, @Strip_Text )
tkTooltip_SetToolIndex( gStripTip, -1 )

gButton = tkButton_Create( tkHost_Root( gHost ), 1200 )
tkButton_SetText( gButton, "Button's own tip" )
tkButton_SetTooltipText( gButton, "Set with tkButton_SetTooltipText, styled through its handle." )
tkTooltip_SetStyle( tkButton_GetTooltipHandle( gButton ), TIP_STYLE_BALLOON )

gHost->OnPaint = @Form_Paint
gHost->OnSize = @Form_Size
Form_Size( gHost )
tkHost_Show( gHost )

dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )
    if HasArg( "--open" ) then
        ShootTip( 1, shot & ".tip.bmp" )
        ShootTip( 2, shot & ".balloon.bmp" )
    end if
    SaveShot( gHost, shot )
else
    tkHost_Run( gHost )
end if
for i as long = 0 to 3
    tkTooltip_Destroy( gTip(i) )                      ' you own a tip you created
next
tkTooltip_Destroy( gStripTip )
tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
