' tkBadge demo (phases B0 + B1): badges attached to real buttons (click one: its count goes up,
' and the click lands on the button even through the badge), and standalone status badges.
'
'   demo                     interactive
'   demo --shot out.bmp      render once, save the window, exit
'   demo --scale 1.75        pin the scale instead of asking the display
#import "vendor/tkControls/tkBadge"
#import "vendor/tkControls/tkButton"
using tkBadge
using tkButton
using tkTheme
using tkHost
using tkPaint

dim shared as TK_HOST ptr gHost
dim shared as TK_WIDGET ptr gBtn(0 to 2), gOnBtn(0 to 2), gStat(0 to 7)
dim shared as long gCounts(0 to 2) = { 3, 120, 0 }
dim shared as TTF_Font ptr gFont

sub Btn_Click( byval hButton as TK_WIDGET ptr, byval id as long )
    dim as long i = id - 100
    gCounts(i) += 1
    tkBadge_SetCount( gOnBtn(i), gCounts(i) )
    print "button " & i & " clicked: count " & gCounts(i)
end sub

sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    dim as TKTHEME_COLORS t = tkTheme_Of( tkHost_Root( h ) )
    dim as TKRECT rc
    b->SetFont( gFont )
    b->SetColors( t.TextDim, t.Window )
    tkRect_Set( rc, tkHost_Scale( h, 20 ), tkHost_Scale( h, 8 ), tkHost_Scale( h, 600 ), tkHost_Scale( h, 30 ) )
    b->PaintText( "Attached to buttons (click them)", @rc, TK_DT_LEFT or TK_DT_VCENTER )
    tkRect_Set( rc, tkHost_Scale( h, 20 ), tkHost_Scale( h, 100 ), tkHost_Scale( h, 600 ), tkHost_Scale( h, 122 ) )
    b->PaintText( "Standalone", @rc, TK_DT_LEFT or TK_DT_VCENTER )
    ' widgetless: a count drawn straight into the form
    tkRect_Set( rc, tkHost_Scale( h, 20 ), tkHost_Scale( h, 290 ), tkHost_Scale( h, 300 ), tkHost_Scale( h, 320 ) )
    b->PaintText( "PaintInto (no widget):", @rc, TK_DT_LEFT or TK_DT_VCENTER )
    dim as TKBADGE_SPEC s
    s.nKind = TKBADGE_KIND_TEXT : s.wszText = "NEW" : s.nStatus = TKBADGE_SUCCESS : s.nShape = TKBADGE_ROUNDED
    s.fText = gFont : s.fScale = h->fScale
    tkRect_Set( rc, tkHost_Scale( h, 180 ), tkHost_Scale( h, 290 ), tkHost_Scale( h, 240 ), tkHost_Scale( h, 320 ) )
    tkBadge_PaintInto( b, rc, s )
end sub

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

private sub SaveShot( byref path as string )
    tkHost_Render( gHost )
    tkHost_RenderTo( gHost, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( gHost->renderer, 0 )
    if s then
        SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & gHost->fScale
        SDL_DestroySurface( s )
    end if
end sub

private sub Place( byval w as TK_WIDGET ptr, byval x as long, byval y as long )
    dim as long iw, ih
    tkBadge_GetIdealSize( w, iw, ih )
    tkWidget_SetPos( w, tkHost_Scale( gHost, x ), tkHost_Scale( gHost, y ), iw, ih )
end sub

' ---- main --------------------------------------------------------------------------------
if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
gHost = tkHost_Create( "tkBadge on SDL3", 640, 340, tkHost_FontDir() & TK_FONT_UI, val( ArgValue( "--scale" ) ) )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
gHost->clrBack = tkTheme_Of( tkHost_Root( gHost ) ).Window
gFont = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 9 )
dim as TK_WIDGET ptr root = tkHost_Root( gHost )

' three buttons, each with an attached badge: a count, a capped count, a dot
dim as ustring caps(0 to 2) = { "Inbox", "Updates", "Chat" }
for i as long = 0 to 2
    gBtn(i) = tkButton_Create( root, 100 + i )
    tkButton_SetText( gBtn(i), caps(i) )
    tkButton_SetClickCallback( gBtn(i), @Btn_Click )
    tkWidget_SetPos( gBtn(i), tkHost_Scale( gHost, 30 + i * 150 ), tkHost_Scale( gHost, 44 ), tkHost_Scale( gHost, 110 ), tkHost_Scale( gHost, 32 ) )
    gOnBtn(i) = tkBadge_Create( root, 200 + i )
    tkBadge_Attach( gOnBtn(i), gBtn(i) )
next
tkBadge_SetCount( gOnBtn(0), gCounts(0) )
tkBadge_SetCount( gOnBtn(1), gCounts(1) )
tkBadge_SetStatus( gOnBtn(1), TKBADGE_ERROR )
tkBadge_SetDot( gOnBtn(2) )
tkBadge_SetStatus( gOnBtn(2), TKBADGE_SUCCESS )

' standalone: status badges with labels, appearances, shapes, presence
dim as ustring labels(0 to 7) = { "Active", "Warning", "Failed", "Draft", "", "", "", "Busy" }
for i as long = 0 to 7
    gStat(i) = tkBadge_Create( root, 300 + i )
    tkBadge_SetLabel( gStat(i), labels(i) )
next
tkBadge_SetStatus( gStat(0), TKBADGE_SUCCESS )
tkBadge_SetStatus( gStat(1), TKBADGE_WARNING )
tkBadge_SetStatus( gStat(2), TKBADGE_ERROR )
tkBadge_SetStatus( gStat(3), TKBADGE_NEUTRAL )
tkBadge_SetText( gStat(4), "Beta" ) : tkBadge_SetAppearance( gStat(4), TKBADGE_OUTLINE )
tkBadge_SetText( gStat(5), "v2.1" ) : tkBadge_SetAppearance( gStat(5), TKBADGE_TINT ) : tkBadge_SetShape( gStat(5), TKBADGE_ROUNDED )
tkBadge_SetCount( gStat(6), 7 ) : tkBadge_SetSize( gStat(6), TKBADGE_LARGE ) : tkBadge_SetShape( gStat(6), TKBADGE_SQUARE )
tkBadge_SetPresence( gStat(7), TKBADGE_PRESENCE_BUSY ) : tkBadge_SetSize( gStat(7), TKBADGE_LARGE )
for i as long = 0 to 3
    Place( gStat(i), 30 + i * 120, 136 )
next
Place( gStat(4), 30, 190 ) : Place( gStat(5), 120, 190 ) : Place( gStat(6), 210, 186 ) : Place( gStat(7), 290, 186 )

' every presence, in a row
for pr as long = TKBADGE_PRESENCE_AVAILABLE to TKBADGE_PRESENCE_UNKNOWN
    dim as TK_WIDGET ptr w = tkBadge_Create( root, 400 + pr )
    tkBadge_SetPresence( w, pr )
    tkBadge_SetSize( w, TKBADGE_LARGE )
    Place( w, 30 + pr * 30, 240 )
next

gHost->OnPaint = @Form_Paint
tkHost_Show( gHost )
dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )
    SaveShot( shot )
else
    tkHost_Run( gHost )
end if
tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
