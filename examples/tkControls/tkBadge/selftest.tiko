' tkBadge self-test (phases B0 + B1), one check per distinct behaviour. Real windows; two passes,
' scale pinned at 1.0 and 1.75. Sizes against RATING-BADGE-AVATAR-CHIP.md §5's formulas, the look
' by pixels, attachment through tkHost's adornments.
'
'   selftest            exit code = number of failures
#import "vendor/tkControls/tkBadge"
#import "vendor/tkControls/tkTest"
using tkBadge
using tkTheme
using tkTest
using tkHost
using tkPaint

dim shared as TKRECT gPiRc
dim shared as TKBADGE_SPEC gPiSpec

' A plain target that paints itself green.
function TargetProc( byval w as TK_WIDGET ptr, byval m as TK_MSG ptr ) as boolean
    if m->msg <> TKM_PAINT then return false
    dim as TKRECT rc
    tkRect_Set( rc, 0, 0, w->cw, w->ch )
    m->pPaint->SetBackColor( &hFF00A000ul )
    m->pPaint->PaintRect( @rc )
    return true
end function

' A canvas painting a widgetless badge into gPiRc.
function CanvasProc( byval w as TK_WIDGET ptr, byval m as TK_MSG ptr ) as boolean
    if m->msg <> TKM_PAINT then return false
    dim as TKRECT rc
    tkRect_Set( rc, 0, 0, w->cw, w->ch )
    m->pPaint->SetBackColor( tkTheme_Get().Window )
    m->pPaint->PaintRect( @rc )
    tkBadge_PaintInto( m->pPaint, gPiRc, gPiSpec )
    return true
end function

sub PaintStock( byval p as TKBADGE_PAINTINFO ptr )
    tkBadge_PaintDefault( p )
end sub

function Px( byval h as TK_HOST ptr, byval w as TK_WIDGET ptr, byval x as long, byval y as long ) as ulong
    dim as TKRECT a
    tkWidget_AbsRect( w, a )
    return tkTest_PixelAt( h, a.left + x, a.top + y )
end function

function HashW( byval h as TK_HOST ptr, byval w as TK_WIDGET ptr ) as ulongint
    dim as TKRECT a
    tkWidget_AbsRect( w, a )
    return tkTest_HashRect( h, a.left, a.top, w->cw, w->ch )
end function

' Size the badge to its ideal and render.
sub Fit( byval h as TK_HOST ptr, byval b as TK_WIDGET ptr )
    dim as long iw, ih
    tkBadge_GetIdealSize( b, iw, ih )
    tkWidget_SetPos( b, b->x, b->y, iw, ih )
    tkHost_RenderTo( h, false )
end sub

' The centre of a widget's window rect, doubled (no rounding).
sub Centre2( byval w as TK_WIDGET ptr, byref x2 as long, byref y2 as long )
    dim as TKRECT a
    tkWidget_AbsRect( w, a )
    x2 = a.left + a.right : y2 = a.top + a.bottom
end sub

' ==========================================================================================
sub RunPass( byval fScale as single )
    tkTest_Begin( "scale " & fScale )
    dim as TK_HOST ptr h = tkHost_Create( "tkBadge selftest", 640, 400, tkHost_FontDir() & TK_FONT_UI, fScale )
    if h = 0 then tkTest_Check( "host created", false, *SDL_GetError() ) : exit sub
    dim as TK_WIDGET ptr root = tkHost_Root( h )
    dim as TTF_Font ptr fIcons = tkHost_OpenFont( h, tkHost_FontDir() & TK_FONT_ICONS, 10 )
    tkHost_Show( h )
    tkTest_PumpFor( h, 50 )

    ' ---- content model -------------------------------------------------------------------------
    tkTest_Check( "FormatCount: negative / 0 hidden, ShowZero, plain, the cap, no cap", tkBadge_FormatCount( -3 ) = "" _
                  andalso tkBadge_FormatCount( 0 ) = "" andalso tkBadge_FormatCount( 0, 99, true ) = "0" andalso tkBadge_FormatCount( 99 ) = "99" _
                  andalso tkBadge_FormatCount( 100 ) = "99+" andalso tkBadge_FormatCount( 12345, 0 ) = "12345" )
    dim as TK_WIDGET ptr b = tkBadge_Create( root, 1 )
    tkWidget_SetPos( b, tkHost_Scale( h, 20 ), tkHost_Scale( h, 20 ), 0, 0 )
    tkTest_Check( "default: a dot, showing", tkBadge_GetKind( b ) = TKBADGE_KIND_DOT andalso tkBadge_IsShowing( b ) )
    tkBadge_SetCount( b, 0 )
    dim as boolean zeroHidden = (tkBadge_IsShowing( b ) = false)
    tkBadge_SetShowZero( b, true )
    tkTest_Check( "a count of 0 hides unless ShowZero", zeroHidden andalso tkBadge_IsShowing( b ) andalso tkBadge_GetKind( b ) = TKBADGE_KIND_COUNT )
    tkBadge_SetInvisible( b, true )
    tkTest_Check( "Invisible hides any content", tkBadge_IsShowing( b ) = false )
    tkBadge_SetInvisible( b, false )
    tkBadge_SetText( b, "" )
    tkTest_Check( "a setter switches the Kind; empty text shows nothing", tkBadge_GetKind( b ) = TKBADGE_KIND_TEXT andalso tkBadge_IsShowing( b ) = false )

    ' ---- sizes ----------------------------------------------------------------------------------
    dim as long iw, ih
    tkBadge_SetCount( b, 7 )
    tkBadge_GetIdealSize( b, iw, ih )
    dim as long hM = tkHost_Scale( h, 20 )
    tkTest_Check( "one character: a circle of the Size's height (MEDIUM 20)", iw = hM andalso ih = hM, iw & "x" & ih )
    tkBadge_SetCount( b, 1234 )
    tkBadge_SetMaxCount( b, 0 )
    tkBadge_GetIdealSize( b, iw, ih )
    tkTest_Check( "wider text: text width + 2 PadX", iw = tkText_Width( h->pDefaultFont, "1234" ) + 2 * tkHost_Scale( h, 5 ), "" & iw )
    tkBadge_SetSize( b, TKBADGE_LARGE )
    tkBadge_GetIdealSize( b, iw, ih )
    tkTest_Check( "Size LARGE: height 24", ih = tkHost_Scale( h, 24 ) )
    tkBadge_SetSize( b, TKBADGE_MEDIUM )
    tkBadge_SetDot( b )
    tkBadge_GetIdealSize( b, iw, ih )
    tkTest_Check( "a dot: 8 across (MEDIUM)", iw = tkHost_Scale( h, 8 ) andalso ih = iw )
    tkBadge_SetGlyph( b, wchr( TK_ICON_SETTINGS ) )
    tkBadge_GetIdealSize( b, iw, ih )
    dim as boolean glyphDot = (iw = tkHost_Scale( h, 8 ))
    tkBadge_ApplyFonts( b, 0, fIcons )
    tkBadge_GetIdealSize( b, iw, ih )
    tkTest_Check( "GLYPH: a dot without a glyph font, a pill with one", glyphDot andalso ih = hM )

    ' ---- the look, by pixels ----------------------------------------------------------------------
    dim as TKBADGE_COLORS cc
    tkBadge_GetColors( b, @cc )
    tkBadge_SetCount( b, 1234 )
    tkBadge_SetShape( b, TKBADGE_SQUARE )
    Fit( h, b )
    dim as long bw = b->cw, bh = b->ch
    tkTest_Check( "FILLED: the status fill", Px( h, b, 1, 1 ) = cc.FillAccent, hex( Px( h, b, 1, 1 ) ) )
    tkBadge_SetStatus( b, TKBADGE_ERROR )
    tkHost_RenderTo( h, false )
    tkTest_Check( "Status ERROR: the error fill", Px( h, b, 1, 1 ) = cc.FillError )
    tkBadge_SetAppearance( b, TKBADGE_OUTLINE )
    tkHost_RenderTo( h, false )
    tkTest_Check( "OUTLINE: a status border round the background", Px( h, b, bw \ 2, 0 ) = cc.FillError andalso Px( h, b, 2, bh \ 2 ) = cc.BackColor, _
                  hex( Px( h, b, bw \ 2, 0 ) ) & " " & hex( Px( h, b, 2, bh \ 2 ) ) )
    tkBadge_SetAppearance( b, TKBADGE_TINT )
    tkHost_RenderTo( h, false )
    tkTest_Check( "TINT: the status at 20 % over the background", Px( h, b, 1, 1 ) = tkColor_Lerp( cc.BackColor, cc.FillError, 0.2 ) )
    tkBadge_SetAppearance( b, TKBADGE_FILLED )
    tkBadge_SetShape( b, TKBADGE_PILL )
    tkHost_RenderTo( h, false )
    tkTest_Check( "PILL: the corners are round (background)", Px( h, b, 0, 0 ) = cc.BackColor andalso Px( h, b, bw \ 2, 1 ) = cc.FillError )
    tkBadge_SetCustomColors( b, tkRGB( 10, 20, 200 ), tkRGB( 255, 255, 255 ) )
    tkHost_RenderTo( h, false )
    tkTest_Check( "SetCustomColors overrides the status", Px( h, b, bw \ 2, 1 ) = tkRGB( 10, 20, 200 ) )
    tkBadge_SetStatus( b, TKBADGE_ACCENT )
    tkBadge_SetEnabled( b, false )
    tkHost_RenderTo( h, false )
    tkTest_Check( "disabled: the disabled fill", Px( h, b, bw \ 2, 1 ) = cc.FillDisabled )
    tkBadge_SetEnabled( b, true )
    ' the inks: each status's ink is the theme ink with the best contrast on its fill
    dim as boolean bInk = true
    for th as long = 0 to 1
        dim as TKTHEME_COLORS t = iif( th = 0, tkTheme_Dark(), tkTheme_Light() )
        dim as TKBADGE_COLORS c = tkBadge_ThemeColors( t )
        dim as ulong cand(0 to 3) = { t.SelectedText, t.TextStrong, t.Window, t.Text }
        for st as long = TKBADGE_ACCENT to TKBADGE_NEUTRAL
            dim as ulong f = tkBadge_StatusFill( c, st ), k = tkBadge_StatusInk( c, st )
            for i as long = 0 to 3
                if tkBadge_Contrast( cand(i), f ) > tkBadge_Contrast( k, f ) + 1e-9 then bInk = false
            next
        next
    next
    tkTest_Check( "each ink reads best on its fill (WCAG), both stock themes", bInk )

    ' ---- the standalone label ----------------------------------------------------------------
    tkBadge_SetDot( b )
    tkBadge_SetLabel( b, "Active" )
    tkBadge_GetIdealSize( b, iw, ih )
    tkTest_Check( "label: ideal width = dot + gap + label", iw = tkHost_Scale( h, 8 ) + tkHost_Scale( h, 6 ) + tkText_Width( h->pDefaultFont, "Active" ), "" & iw )
    tkWidget_SetPos( b, b->x, b->y, iw + tkHost_Scale( h, 40 ), ih )
    tkBadge_SetJustify( b, TKBADGE_JUSTIFY_RIGHT )
    dim as TKRECT rb
    tkTest_Check( "Justify RIGHT: badge + label end at the right edge", tkBadge_GetBadgeRect( b, rb ) andalso rb.left = tkHost_Scale( h, 40 ), tkRect_Str( rb ) )
    tkBadge_SetLabel( b, "" )
    tkBadge_SetJustify( b, TKBADGE_JUSTIFY_LEFT )

    ' ---- attached (B1) ------------------------------------------------------------------------
    dim as TK_WIDGET ptr home = tkWidget_Parent( b )
    dim as TK_WIDGET ptr tgt = tkWidget_CreateChild( root, 2, @TargetProc, 0 )
    tkWidget_SetPos( tgt, tkHost_Scale( h, 200 ), tkHost_Scale( h, 100 ), tkHost_Scale( h, 80 ), tkHost_Scale( h, 40 ) )
    tkBadge_SetCount( b, 5 )
    tkBadge_Attach( b, tgt )
    tkHost_RenderTo( h, false )
    tkTest_Check( "Attach: an adornment of the target, ring 2", tkWidget_IsAdorner( b ) andalso tkWidget_Parent( b ) = tgt _
                  andalso tkBadge_GetTarget( b ) = tgt andalso tkBadge_GetRing( b ) = 2 )
    ' centred on the anchor for every corner and both overlaps (doubled coordinates: no rounding)
    dim as long bad = 0
    dim as TKRECT ta
    tkWidget_AbsRect( tgt, ta )
    for ov as long = TKBADGE_OVERLAP_RECT to TKBADGE_OVERLAP_CIRCLE
        dim as double k = iif( ov = TKBADGE_OVERLAP_CIRCLE, (tkHost_Scale( h, 40 ) / 2) * (1 - 1 / sqr( 2 )), 0.0 )
        for cn as long = TKBADGE_TOP_RIGHT to TKBADGE_BOTTOM_LEFT
            tkBadge_Attach( b, tgt, cn, 0, 0, ov )
            tkHost_RenderTo( h, false )
            dim as double ax = iif( (cn = TKBADGE_TOP_RIGHT) orelse (cn = TKBADGE_BOTTOM_RIGHT), ta.right - k, ta.left + k )
            dim as double ay = iif( (cn = TKBADGE_TOP_RIGHT) orelse (cn = TKBADGE_TOP_LEFT), ta.top + k, ta.bottom - k )
            dim as long x2, y2
            Centre2( b, x2, y2 )
            if (abs( x2 / 2 - ax ) > 1) orelse (abs( y2 / 2 - ay ) > 1) then bad += 1
        next
    next
    tkTest_Check( "centred on the corner / the 45 degree point, all four corners", bad = 0, bad & " off" )
    tkBadge_Attach( b, tgt, TKBADGE_TOP_RIGHT, 4, -2 )
    tkHost_RenderTo( h, false )
    dim as long x2, y2
    Centre2( b, x2, y2 )
    tkTest_Check( "the offset moves it, scaled", abs( x2 / 2 - (ta.right + tkHost_Scale( h, 4 )) ) <= 1 andalso abs( y2 / 2 - (ta.top - tkHost_Scale( h, 2 )) ) <= 1 )
    tkBadge_Attach( b, tgt )
    tkHost_RenderTo( h, false )
    tkTest_Check( "it overhangs the target and a click there reaches the target", _
                  tkTest_PixelAt( h, ta.right + 2, ta.top - 2 ) <> tkTheme_Get().Window _
                  andalso tkHost_HitTest( h, ta.right - 2, ta.top + 2 ) = tgt )
    tkWidget_SetSize( tgt, tkHost_Scale( h, 120 ), tkHost_Scale( h, 40 ) )
    tkHost_RenderTo( h, false )
    tkWidget_AbsRect( tgt, ta )
    Centre2( b, x2, y2 )
    tkTest_Check( "it follows a resized target", abs( x2 / 2 - ta.right ) <= 1 )
    tkBadge_SetShowZero( b, false )
    tkBadge_SetCount( b, 0 )
    tkHost_RenderTo( h, false )
    tkTest_Check( "nothing to show: the adornment is 0 x 0", b->cw = 0 andalso b->ch = 0 )
    tkBadge_SetCount( b, 5 )
    tkBadge_Detach( b )
    tkTest_Check( "Detach: back home, a plain widget, no ring", tkWidget_Parent( b ) = home andalso tkWidget_IsAdorner( b ) = false _
                  andalso tkBadge_GetRing( b ) = 0 andalso tkBadge_GetTarget( b ) = 0 )
    tkWidget_SetPos( b, tkHost_Scale( h, 20 ), tkHost_Scale( h, 20 ), 0, 0 )

    ' ---- presence -----------------------------------------------------------------------------
    tkBadge_SetSize( b, TKBADGE_LARGE )
    dim as ulongint hs(0 to 7)
    for pr as long = TKBADGE_PRESENCE_AVAILABLE to TKBADGE_PRESENCE_UNKNOWN
        tkBadge_SetPresence( b, pr )
        Fit( h, b )
        hs(pr) = HashW( h, b )
        if pr = TKBADGE_PRESENCE_AVAILABLE then
            tkTest_Check( "AVAILABLE: a success-coloured disc", Px( h, b, b->cw \ 2, b->ch \ 4 ) = cc.FillSuccess, hex( Px( h, b, b->cw \ 2, b->ch \ 4 ) ) )
        elseif pr = TKBADGE_PRESENCE_OFFLINE then
            tkTest_Check( "OFFLINE: a ring only", Px( h, b, b->cw \ 2, b->ch \ 2 ) = cc.BackColor )
        end if
    next
    dim as long same = 0
    for i as long = 0 to 7
        for j as long = i + 1 to 7
            if hs(i) = hs(j) then same += 1
        next
    next
    tkTest_Check( "the eight presences all look different", same = 0, same & " pairs alike" )
    tkBadge_SetSize( b, TKBADGE_MEDIUM )

    ' ---- theme, pinning, PaintDefault, rescale ---------------------------------------------------
    tkTheme_Apply( tkTheme_Light() )
    tkBadge_GetColors( b, @cc )
    tkTest_Check( "a theme change re-colours", cc.FillAccent = tkTheme_Light().Accent andalso cc.BackColor = tkTheme_Light().Window )
    dim as TKBADGE_COLORS pin = cc
    pin.FillAccent = tkRGB( 1, 2, 3 )
    tkBadge_SetColors( b, @pin )
    tkTheme_Apply( tkTheme_Dark() )
    tkBadge_GetColors( b, @cc )
    tkTest_Check( "a pinned badge ignores the theme", cc.FillAccent = tkRGB( 1, 2, 3 ) )
    tkBadge_UnpinColors( b )
    tkBadge_GetColors( b, @cc )
    tkBadge_SetCount( b, 7 )
    tkBadge_SetPaintCallback( b, @PaintStock )
    Fit( h, b )
    tkTest_Check( "PaintDefault from a Paint callback draws the stock badge", Px( h, b, b->cw \ 2, 1 ) = cc.FillAccent )
    tkBadge_SetPaintCallback( b, 0 )
    h->fScaleForced = fScale * 2
    tkTest_PushWindowEvent( h, SDL_EVENT_WINDOW_DISPLAY_SCALE_CHANGED )
    tkBadge_GetIdealSize( b, iw, ih )
    tkTest_Check( "rescale: the height follows the scale", ih = cint( 20 * fScale * 2 ), "" & ih )
    h->fScaleForced = fScale
    tkTest_PushWindowEvent( h, SDL_EVENT_WINDOW_DISPLAY_SCALE_CHANGED )

    ' ---- widgetless ---------------------------------------------------------------------------
    dim as TK_WIDGET ptr cv = tkWidget_CreateChild( root, 3, @CanvasProc, 0 )
    tkWidget_SetPos( cv, tkHost_Scale( h, 20 ), tkHost_Scale( h, 300 ), tkHost_Scale( h, 100 ), tkHost_Scale( h, 40 ) )
    dim as TKBADGE_SPEC s0
    gPiSpec = s0
    gPiSpec.nKind = TKBADGE_KIND_COUNT : gPiSpec.nCount = 3 : gPiSpec.fScale = h->fScale : gPiSpec.nStatus = TKBADGE_SUCCESS
    tkRect_Set( gPiRc, 0, 0, tkHost_Scale( h, 100 ), tkHost_Scale( h, 40 ) )
    tkHost_RenderTo( h, false )
    dim as TKBADGE_COLORS ct = tkBadge_ThemeColors( tkTheme_Get() )
    tkTest_Check( "PaintInto: centred in its rect, in the theme's colours", Px( h, cv, tkHost_Scale( h, 50 ), tkHost_Scale( h, 20 ) - hM \ 2 + 2 ) = ct.FillSuccess, _
                  hex( Px( h, cv, tkHost_Scale( h, 50 ), tkHost_Scale( h, 20 ) - hM \ 2 + 2 ) ) )
    gPiSpec.nCount = 0
    tkHost_RenderTo( h, false )
    tkTest_Check( "PaintInto: a hidden count draws nothing", Px( h, cv, tkHost_Scale( h, 50 ), tkHost_Scale( h, 20 ) - hM \ 2 + 2 ) = tkTheme_Get().Window )

    tkHost_Destroy( h )
end sub

' ==========================================================================================
if tkTest_Init() = false then end 99
RunPass( 1.0 )
RunPass( 1.75 )
dim as long nFail = tkTest_Report( "tkBadge" )
tkTest_Quit()
end nFail
