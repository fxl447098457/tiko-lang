' tkRExpr perf: RD0 spike S1's 20 expressions over 100,000 rows, through the module. The target
' (docs/tkReportDesigner/SPEC.md RD1): under 1 s, Release, Windows. Exit code 1 when it is missed.
#import "vendor/tkControls/tkRExpr"
using tkRExpr
using tkBind

const NROWS = 100000

function FirstName( byval i as int32 ) as ustring
    select case i
    case 0 : return "Ann"
    case 1 : return "Bob"
    case 2 : return "Cara"
    case 3 : return "Dmitri"
    end select
    return "Eve"
end function

function LastName( byval i as int32 ) as ustring
    select case i
    case 0 : return "Smith"
    case 1 : return "Jones"
    case 2 : return "Okafor"
    case 3 : return "Nguyen"
    end select
    return "Lopez"
end function

dim as TKREXPR_SCHEMA sch
sch.AddField( "Id", TKV_INT )
sch.AddField( "Qty", TKV_INT )
sch.AddField( "Price", TKV_FLOAT )
sch.AddField( "Disc", TKV_FLOAT )
sch.AddField( "First", TKV_TEXT )
sch.AddField( "Last", TKV_TEXT )
dim as string ex(0 to 19) = { _
    "[Qty] * [Price]", _
    "[Qty] * [Price] * (1 - [Disc])", _
    "iif([Qty] > 10, ""bulk"", ""single"")", _
    "[First] & "" "" & [Last]", _
    "UCase(Left([Last], 3))", _
    "Format([Price] * [Qty], ""#,##0.00"")", _
    "[Price] > 100 and [Qty] < 5", _
    "Len([Last]) + Len([First])", _
    "Round([Price] * 1.2, 2)", _
    "iif([Disc] > 0, [Price] * (1 - [Disc]), [Price])", _
    "not ([Qty] mod 2 = 0)", _
    "[Qty] + 1", _
    "([Price] - 10) / 3", _
    """Order "" & Str([Id])", _
    "iif([Last] = ""Smith"", 1, 0)", _
    "[Qty] * [Qty] - [Qty]", _
    "Format([Disc], ""0.0%"")", _
    "[Price] >= 50 or [Disc] > 0.1", _
    "Mid([First], 2, 2) & ""-"" & Str([Qty])", _
    "Round(([Qty] * [Price]) / 7, 1)" }
dim as TK_REXPR ptr code(0 to 19)
for e as int32 = 0 to 19
    dim as TKREXPR_ERROR er
    code(e) = tkRExpr_Compile( ex(e), sch, er )
    if code(e) = 0 then
        print "compile "; e; ": "; er.msg
        end 2
    end if
next
dim as TK_VALUE rows(any)
redim rows( 0 to NROWS * 6 - 1 )
for k as int32 = 0 to NROWS - 1
    dim as TK_VALUE ptr r = @rows(k * 6)
    r[0].SetInt( 1000 + k )
    r[1].SetInt( (k mod 23) + 1 )
    r[2].SetFloat( 5 + (k mod 97) * 1.25 )
    r[3].SetFloat( (k mod 4) * 0.05 )
    r[4].SetText( FirstName( k mod 5 ) )
    r[5].SetText( LastName( (k \ 5) mod 5 ) )
next
dim as TKREXPR_CTX ctx
dim as TK_VALUE v
dim as int64 nKinds
dim as double t0 = timer( )
for k as int32 = 0 to NROWS - 1
    ctx.row = @rows(k * 6)
    for e as int32 = 0 to 19
        tkRExpr_Eval( code(e), ctx, v )
        nKinds += v.kind
    next
next
dim as double t = timer( ) - t0
print "tkRExpr perf: "; NROWS; " rows x 20 expressions: "; int( t * 1000 ); " ms ("; int( t * 1e9 / (NROWS * 20) ); " ns an evaluation, into a TK_VALUE); check "; nKinds
for e as int32 = 0 to 19
    tkRExpr_Destroy( code(e) )
next
end iif( t < 1.0, 0, 1 )
