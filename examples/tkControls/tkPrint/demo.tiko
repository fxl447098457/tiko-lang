' tkPrint demo (phase R0): a two-page document -- a title, a tkChart printed through its own paint
' code, a paragraph, a table drawn with the page API, "Page X of Y" footers -- shown in a window by
' replaying the pages, and exported as PNG.
'
'   demo                     the window: PgUp / PgDn change page, +/- zoom, P writes PNGs to ../out/
'   demo --png ../out/p{p}.png  write every page at 150 dpi and exit
'   demo --pdf ../out/demo.pdf  write the document as a PDF and exit
'   demo --scale 1.75        pin the scale instead of asking the display
#import "vendor/tkControls/tkChart"
#import "vendor/tkControls/tkPrint"
#import "vendor/tkControls/tkPdf"
using tkChart
using tkPdf
using tkHost
using tkPaint
using tkPrint

dim shared as TK_HOST ptr gHost
dim shared as TK_WIDGET ptr gChart
dim shared as TK_PRINTDOC ptr gDoc
dim shared as TK_PRINTREPLAY ptr gReplay
dim shared as long gPage
dim shared as single gZoom = 1

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 32
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

' Page 1: title, the chart, a paragraph. Page 2: a table. Both: a footer.
function DemoPage( byval doc as TK_PRINTDOC ptr, byval pg as TK_PAGE ptr, byval i as long ) as boolean
    dim as TKRECTF m
    tkPage_GetMarginRect( pg, m )
    dim as TKFONTSPEC fs
    dim as TKRECTF r
    if i = 0 then
        fs.pt = 20 : fs.bold = true
        tkPage_SetFont( pg, fs )
        tkRectF_Set( r, m.left, m.top, m.right, m.top + 30 )
        tkPage_Text( pg, "Quarterly fruit report", r, TK_DT_LEFT )
        tkPage_SetLineColor( pg, tkRGB( 40, 90, 160 ) )
        tkPage_SetPen( pg, 1 )
        tkPage_Line( pg, m.left, m.top + 34, m.right, m.top + 34 )
        tkRectF_Set( r, m.left, m.top + 50, m.right, m.top + 330 )
        tkPrint_PaintWidget( pg, gChart, r )
        fs.pt = 10 : fs.bold = false
        tkPage_SetFont( pg, fs )
        tkRectF_Set( r, m.left, m.top + 350, m.right, m.bottom - 30 )
        tkPage_Text( pg, "The chart above is the window's tkChart, recorded through its own paint code and " & _
                     "scaled into the page as vector shapes and text runs. This paragraph is the page API: " & _
                     "tkPage_Text with TK_DT_WORDBREAK, laid out at 720 dpi by tkPaint's own word wrap. " & _
                     "The footer's page count is filled in when the page is drawn, so it needs no second pass.", _
                     r, TK_DT_WORDBREAK )
    else
        fs.pt = 14 : fs.bold = true
        tkPage_SetFont( pg, fs )
        tkRectF_Set( r, m.left, m.top, m.right, m.top + 24 )
        tkPage_Text( pg, "Detail", r, TK_DT_LEFT )
        dim as ustring fruit(0 to 5) = { "Apples", "Pears", "Plums", "Cherries", "Grapes", "Figs" }
        dim as single cx(0 to 3) = { 0, 140, 240, 340 }      ' each number column 100 pt wide: 440 in all
        dim as single y = m.top + 40
        fs.pt = 10
        for row as long = -1 to 5
            if row = -1 then
                fs.bold = true
                tkPage_SetFillColor( pg, tkRGB( 220, 230, 245 ) )
                tkRectF_Set( r, m.left, y, m.left + 440, y + 18 )
                tkPage_FillRect( pg, r )
            else
                fs.bold = false
            end if
            tkPage_SetFont( pg, fs )
            for c as long = 0 to 3
                dim as ustring s
                if row = -1 then
                    dim as ustring hd(0 to 3) = { "Fruit", "Q1", "Q2", "Q3" }
                    s = hd(c)
                elseif c = 0 then
                    s = fruit(row)
                else
                    s = str( ((row + 3) * (c + 2) * 37) mod 500 + 100 )
                end if
                tkRectF_Set( r, m.left + cx(c) + 4, y, m.left + cx(c) + iif( c = 0, 136, 96 ), y + 18 )
                tkPage_Text( pg, s, r, iif( c = 0, TK_DT_LEFT, TK_DT_RIGHT ) )
            next
            y += 18
            tkPage_SetLineColor( pg, tkRGB( 180, 180, 180 ) )
            tkPage_SetPen( pg, 0.5 )
            tkPage_Line( pg, m.left, y, m.left + 440, y )
        next
    end if
    fs.pt = 8 : fs.bold = false
    tkPage_SetFont( pg, fs )
    tkPage_SetTextColor( pg, tkRGB( 90, 90, 90 ) )
    tkRectF_Set( r, m.left, m.bottom - 14, m.right, m.bottom )
    tkPage_LateText( pg, r, "Page {p} of {n}", TK_DT_RIGHT )
    tkPage_SetTextColor( pg, tkRGB( 0, 0, 0 ) )
    return i < 1
end function

' The window: the current page as paper on grey, replayed at the zoom.
sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    if gDoc = 0 then exit sub
    dim as single wPt, hPt
    tkPrintDoc_GetPageSize( gDoc, gPage, wPt, hPt )
    dim as long pw, ph
    tkHost_PixelSize( h, pw, ph )
    dim as single s = (ph - 40) / hPt * gZoom
    dim as single x = (pw - wPt * s) / 2, y = 20
    dim as TKRECT rc
    tkRect_Set( rc, clng( x ), clng( y ), clng( x + wPt * s ), clng( y + hPt * s ) )
    b->SetBackColor( tkRGB( 255, 255, 255 ) )
    b->PaintRect( @rc )
    if gReplay = 0 then gReplay = tkPrintReplay_Create( h->renderer, h->engine )
    tkPrintReplay_Page( gReplay, gDoc, gPage, x, y, s )
end sub

function Form_Key( byval h as TK_HOST ptr, byval m as TK_MSG ptr ) as boolean
    select case m->key
    case SDLK_PAGEDOWN : if gPage < tkPrintDoc_GetPageCount( gDoc ) - 1 then gPage += 1
    case SDLK_PAGEUP : if gPage > 0 then gPage -= 1
    case SDLK_EQUALS, SDLK_KP_PLUS : gZoom *= 1.25
    case SDLK_MINUS, SDLK_KP_MINUS : gZoom /= 1.25
    case SDLK_P : print "png: " & tkPrintDoc_ExportPng( gDoc, "../out/tkprint-demo-p{p}.png", 150 )
    case else : return false
    end select
    tkHost_Invalidate( h )
    return true
end function


' ---- main --------------------------------------------------------------------------------
if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1

dim as single forced = val( ArgValue( "--scale" ) )
gHost = tkHost_Create( "tkPrint R0 demo", 900, 1000, tkHost_FontDir() & TK_FONT_UI, forced )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
gHost->clrBack = tkRGB( 128, 128, 128 )

' the chart lives on the window (hidden behind nothing: it just is not shown) -- any widget prints
dim as TTF_Font ptr f9 = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 9 )
gChart = tkChart_Create( tkHost_Root( gHost ), 100, TKCHART_TYPE_COLUMN )
tkChart_SetFont( gChart, f9 )
tkChart_SetTitle( gChart, "Fruit sold, by quarter" )
tkChart_BeginUpdate( gChart )
dim as ustring cats(0 to 3) = { "Q1", "Q2", "Q3", "Q4" }
dim as ustring names(0 to 2) = { "Apples", "Pears", "Plums" }
for si as long = 0 to 2
    dim as long s = tkChart_AddSeries( gChart, names(si) )
    for j as long = 0 to 3
        tkChart_AddPoint( gChart, s, cats(j), ((si + 2) * (j + 3) * 7) mod 13 + 2 )
    next
next
tkChart_EndUpdate( gChart )
tkChart_SetLegendVisible( gChart, true )
tkWidget_SetPos( gChart, 0, 0, tkHost_Scale( gHost, 600 ), tkHost_Scale( gHost, 340 ) )
tkWidget_Show( gChart, false )

gDoc = tkPrintDoc_Create( "tkPrint demo" )
tkPrintDoc_SetPrintPageCallback( gDoc, @DemoPage )
' a hidden widget does not paint on screen, but tkPrint_PaintWidget prints it all the same
tkWidget_Show( gChart, true )
tkPrintDoc_Generate( gDoc )
tkWidget_Show( gChart, false )
if len( tkPrintDoc_Warnings( gDoc ) ) then print "warnings: " & tkPrintDoc_Warnings( gDoc )

dim as string png = ArgValue( "--png" ), pdf = ArgValue( "--pdf" )
if len( pdf ) then
    print "pdf: " & tkPrintDoc_ExportPdf( gDoc, pdf ) & "  " & tkPrintDoc_Warnings( gDoc )
elseif len( png ) then
    dim as boolean ok = tkPrintDoc_ExportPng( gDoc, png, 150 )
    print "png: " & ok & "  pages " & tkPrintDoc_GetPageCount( gDoc )
else
    gHost->OnPaint = @Form_Paint
    gHost->OnPreKey = @Form_Key
    tkHost_Show( gHost )
    tkHost_Run( gHost )
end if

tkPrintReplay_Destroy( gReplay )
tkPrintDoc_Destroy( gDoc )
tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
