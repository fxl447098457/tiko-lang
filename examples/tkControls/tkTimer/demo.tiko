' tkTimer demo: three timers, each driving something visible. A clock (1000 ms) with Stop / Start,
' a stopwatch (100 ms) with Start / Stop and Reset, and a lamp (500 ms) whose interval Faster and
' Slower change. The line at the bottom asks each timer tkTimer_IsRunning.
'
'   demo                     interactive (the buttons; the clock prints each tick)
'   demo --shot out.bmp      render once, save the window, exit
'   demo --scale 1.75        pin the scale instead of asking the display
#import "vendor/tkControls/tkTimer"
#import "vendor/tkControls/tkLabel"
#import "vendor/tkControls/tkButton"
using tkTimer
using tkLabel
using tkButton
using tkTheme
using tkHost
using tkPaint

enum
    IDT_CLOCK = 2200, IDT_WATCH, IDT_LAMP
    IDB_CLOCK = 3000, IDB_WATCH, IDB_RESET, IDB_FASTER, IDB_SLOWER
end enum

dim shared as TK_HOST ptr gHost
dim shared as TTF_Font ptr gFont, gFontBig
dim shared as TK_WIDGET ptr gClock, gWatch, gLamp                   ' the timers
dim shared as TK_WIDGET ptr gClockLbl, gWatchLbl, gLampLbl           ' what they drive
dim shared as TK_WIDGET ptr gBtn(0 to 4)
dim shared as ulongint gWatchMs, gWatchFrom                         ' elapsed before the run, the run's start
dim shared as boolean gLampOn = true

private sub ShowClock( )
    dim as ustring s = time
    tkLabel_SetText( gClockLbl, s )
end sub

private sub ShowWatch( byval ms as ulongint )
    dim as long t = ms \ 100
    dim as ustring s = (t \ 600) & ":" & right( "0" & ((t \ 10) mod 60), 2 ) & "." & (t mod 10)
    tkLabel_SetText( gWatchLbl, s )
end sub

private sub ShowLamp( )
    dim as ustring s = tkTimer_GetInterval( gLamp ) & " ms"
    tkLabel_SetText( gLampLbl, s )
    tkHost_Invalidate( gHost )
end sub

sub Clock_Tick( byval hTimer as TK_WIDGET ptr )
    ShowClock( )
    print "tick " & hTimer->ctrlId & ": " & time
end sub

sub Watch_Tick( byval hTimer as TK_WIDGET ptr )
    ShowWatch( gWatchMs + SDL_GetTicks( ) - gWatchFrom )
end sub

sub Lamp_Tick( byval hTimer as TK_WIDGET ptr )
    gLampOn = not gLampOn
    tkHost_Invalidate( gHost )
end sub

sub Button_Click( byval hButton as TK_WIDGET ptr, byval id as long )
    select case id
    case IDB_CLOCK
        dim as boolean bRun = not tkTimer_IsRunning( gClock )
        tkWidget_Enable( gClock, bRun )
        tkButton_SetText( hButton, iif( bRun, "Stop clock", "Start clock" ) )
        print "clock " & iif( bRun, "started", "stopped" )
    case IDB_WATCH
        if tkTimer_IsRunning( gWatch ) then
            gWatchMs += SDL_GetTicks( ) - gWatchFrom
            tkWidget_Enable( gWatch, false )
            ShowWatch( gWatchMs )
            tkButton_SetText( hButton, "Start" )
            print "stopwatch stopped at " & tkLabel_GetText( gWatchLbl )
        else
            gWatchFrom = SDL_GetTicks( )
            tkWidget_Enable( gWatch, true )
            tkButton_SetText( hButton, "Stop" )
            print "stopwatch started"
        end if
    case IDB_RESET
        gWatchMs = 0 : gWatchFrom = SDL_GetTicks( )
        ShowWatch( 0 )
        print "stopwatch reset"
    case IDB_FASTER, IDB_SLOWER
        dim as long ms = tkTimer_GetInterval( gLamp )
        ms = iif( id = IDB_FASTER, ms \ 2, ms * 2 )
        if ms < 125 then ms = 125
        if ms > 2000 then ms = 2000
        tkTimer_SetInterval( gLamp, ms )               ' setting it again restarts the wait
        ShowLamp( )
        print "lamp interval " & ms & " ms"
    end select
    tkHost_Invalidate( gHost )
end sub

private sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    dim as TKTHEME_COLORS t = tkTheme_Of( tkHost_Root( h ) )
    dim as ustring caps(0 to 2) = { "clock, every 1000 ms", "stopwatch, every 100 ms", "lamp (Faster / Slower)" }
    b->SetFont( gFont )
    b->SetColors( t.TextDim, t.Window )
    for i as long = 0 to 2
        dim as TKRECT rc
        tkRect_Set( rc, tkHost_Scale( h, 20 ), tkHost_Scale( h, 20 + i * 60 ), tkHost_Scale( h, 220 ), tkHost_Scale( h, 56 + i * 60 ) )
        b->PaintText( caps(i), @rc, TK_DT_LEFT or TK_DT_VCENTER )
    next
    dim as TKRECT lamp
    tkRect_Set( lamp, tkHost_Scale( h, 230 ), tkHost_Scale( h, 146 ), tkHost_Scale( h, 254 ), tkHost_Scale( h, 170 ) )
    b->SetBackColor( iif( gLampOn, t.Accent, t.Track ) )
    b->PaintRoundRect( @lamp, lamp.right - lamp.left )
    dim as TKRECT rs
    tkRect_Set( rs, tkHost_Scale( h, 20 ), tkHost_Scale( h, 206 ), tkHost_Scale( h, 640 ), tkHost_Scale( h, 230 ) )
    b->SetColors( t.TextDim, t.Window )
    b->PaintText( "running:  clock " & tkTimer_IsRunning( gClock ) & "   stopwatch " & tkTimer_IsRunning( gWatch ) & _
                  "   lamp " & tkTimer_IsRunning( gLamp ), @rs, TK_DT_LEFT or TK_DT_VCENTER )
end sub

private sub Form_Size( byval h as TK_HOST ptr )
    tkWidget_SetPos( gClockLbl, tkHost_Scale( h, 230 ), tkHost_Scale( h, 20 ), tkHost_Scale( h, 180 ), tkHost_Scale( h, 36 ) )
    tkWidget_SetPos( gWatchLbl, tkHost_Scale( h, 230 ), tkHost_Scale( h, 80 ), tkHost_Scale( h, 180 ), tkHost_Scale( h, 36 ) )
    tkWidget_SetPos( gLampLbl,  tkHost_Scale( h, 266 ), tkHost_Scale( h, 140 ), tkHost_Scale( h, 144 ), tkHost_Scale( h, 36 ) )
    dim as long xs(0 to 4) = { 430, 430, 530, 430, 530 }, ys(0 to 4) = { 23, 83, 83, 143, 143 }
    for i as long = 0 to 4
        tkWidget_SetPos( gBtn(i), tkHost_Scale( h, xs(i) ), tkHost_Scale( h, ys(i) ), tkHost_Scale( h, iif( i = 0, 190, 90 ) ), tkHost_Scale( h, 30 ) )
    next
end sub

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

private function HasArg( byref name_ as string ) as boolean
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return true
    next
    return false
end function

private sub SaveShot( byval h as TK_HOST ptr, byref path as string )
    tkHost_Render( h )
    tkHost_RenderTo( h, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( h->renderer, 0 )
    if s then
        SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & h->fScale
        SDL_DestroySurface( s )
    end if
end sub

if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
dim as single forced = val( ArgValue( "--scale" ) )
gHost = tkHost_Create( "tkTimer on SDL3", 660, 250, tkHost_FontDir() & TK_FONT_UI, forced )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
gHost->clrBack = tkTheme_Of( tkHost_Root( gHost ) ).Window
gFont = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 10 )
gFontBig = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI_BOLD, 18 )

dim as TK_WIDGET ptr root = tkHost_Root( gHost )
gClockLbl = tkLabel_Create( root, 100 )
gWatchLbl = tkLabel_Create( root, 101 )
gLampLbl  = tkLabel_Create( root, 102 )
tkLabel_SetFont( gClockLbl, gFontBig )
tkLabel_SetFont( gWatchLbl, gFontBig )
tkLabel_SetFont( gLampLbl, gFont )
dim as ustring caps(0 to 4) = { "Stop clock", "Start", "Reset", "Faster", "Slower" }
for i as long = 0 to 4
    gBtn(i) = tkButton_Create( root, IDB_CLOCK + i )
    tkButton_SetText( gBtn(i), caps(i) )
    tkButton_SetClickCallback( gBtn(i), @Button_Click )
next

gClock = tkTimer_Create( root, IDT_CLOCK )                 ' running from the start
tkTimer_SetTickCallback( gClock, @Clock_Tick )
tkTimer_SetInterval( gClock, 1000 )
gWatch = tkTimer_Create( root, IDT_WATCH )                 ' has an interval, waits for Start
tkTimer_SetTickCallback( gWatch, @Watch_Tick )
tkWidget_Enable( gWatch, false )
tkTimer_SetInterval( gWatch, 100 )
gLamp = tkTimer_Create( root, IDT_LAMP )
tkTimer_SetTickCallback( gLamp, @Lamp_Tick )
tkTimer_SetInterval( gLamp, 500 )
ShowClock( ) : ShowWatch( 0 ) : ShowLamp( )

gHost->OnPaint = @Form_Paint
gHost->OnSize = @Form_Size
Form_Size( gHost )
tkHost_Show( gHost )

dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )
    SaveShot( gHost, shot )
else
    tkHost_Run( gHost )
end if
tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
