' tkLayout self-test. The rule itself is table-driven through tkLayout_Compute with no window, each
' table at scale 1.0 and 1.75, endpoints asserted. Then real widgets, a real splitter drag, a resize.
'
'   selftest            exit code = number of failures
#import "vendor/tkControls/tkLayout"
#import "vendor/tkControls/tkPanel"
#import "vendor/tkControls/tkTest"
using tkLayout
using tkPanel
using tkTheme
using tkTest
using tkHost
using tkPaint
using tkSplitter

function R_( byref rc as TKRECT ) as string
    return rc.left & "," & rc.top & "," & rc.right & "," & rc.bottom
end function

function Sc( byval v as long, byval s as single ) as long
    return cint( v * s )
end function

sub CheckRect( byref what as string, byref got as TKRECT, byval l as long, byval t as long, byval r as long, byval b as long )
    tkTest_Check( what, (got.left = l) andalso (got.top = t) andalso (got.right = r) andalso (got.bottom = b), _
                  "got " & R_( got ) & " want " & l & "," & t & "," & r & "," & b )
end sub

sub ComputeTables( byval s as single )
    tkTest_Begin( "compute, scale " & s )
    const DW = 400, DH = 300
    dim as long cw = Sc( DW, s ) + 137, ch = Sc( DH, s ) + 61     ' the parent has grown
    dim as long dx = 137, dy = 61
    dim as TKRECT dockArea, out_( 0 to 7 )
    tkRect_Set( dockArea, 0, 0, cw, ch )

    dim as TKLAYOUT_ITEM a( 0 to 5 )
    a(0).x = 10 : a(0).y = 20 : a(0).cx = 100 : a(0).cy = 30                       ' default: left + top
    a(1) = a(0) : a(1).anchor = TK_ANCHOR_RIGHT or TK_ANCHOR_BOTTOM
    a(2) = a(0) : a(2).anchor = TK_ANCHOR_LEFT or TK_ANCHOR_RIGHT or TK_ANCHOR_TOP
    a(3) = a(0) : a(3).anchor = TK_ANCHOR_LEFT or TK_ANCHOR_TOP or TK_ANCHOR_BOTTOM
    a(4) = a(0) : a(4).anchor = TK_ANCHOR_NONE
    a(5) = a(0) : a(5).x = 0 : a(5).y = 0 : a(5).cx = DW : a(5).cy = DH : a(5).anchor = TK_ANCHOR_LEFT or TK_ANCHOR_TOP or TK_ANCHOR_RIGHT or TK_ANCHOR_BOTTOM
    tkLayout_Compute( @a(0), 6, DW, DH, cw, ch, dockArea, s, @out_(0) )
    dim as long l = Sc( 10, s ), t = Sc( 20, s ), r = Sc( 110, s ), b = Sc( 50, s )
    CheckRect( "left+top stays put", out_(0), l, t, r, b )
    CheckRect( "right+bottom moves by the growth", out_(1), l + dx, t + dy, r + dx, b + dy )
    CheckRect( "left+right stretches the width", out_(2), l, t, r + dx, b )
    CheckRect( "top+bottom stretches the height", out_(3), l, t, r, b + dy )
    CheckRect( "no anchors stays centred", out_(4), l + dx \ 2, t + dy \ 2, r + dx \ 2, b + dy \ 2 )
    CheckRect( "all four track the parent's corners", out_(5), 0, 0, cw, ch )

    ' At the design size nothing moves, whatever the anchors.
    tkLayout_Compute( @a(0), 6, DW, DH, Sc( DW, s ), Sc( DH, s ), dockArea, s, @out_(0) )
    for i as long = 0 to 4
        CheckRect( "design size: anchor set " & i & " unchanged", out_(i), l, t, r, b )
    next

    ' The parent shrinks below the design: a stretched control stops at empty, never inverted.
    dim as TKLAYOUT_ITEM tiny( 0 )
    tiny(0).x = 10 : tiny(0).y = 10 : tiny(0).cx = 100 : tiny(0).cy = 100
    tiny(0).anchor = TK_ANCHOR_LEFT or TK_ANCHOR_RIGHT or TK_ANCHOR_TOP or TK_ANCHOR_BOTTOM
    tkLayout_Compute( @tiny(0), 1, DW, DH, 0, 0, dockArea, s, @out_(0) )
    tkTest_Check( "a shrunken stretch is empty, not inverted", (out_(0).right >= out_(0).left) andalso (out_(0).bottom >= out_(0).top), R_( out_(0) ) )

    ' Docks, in order; FILL takes what is left wherever it sits in the list.
    dim as TKLAYOUT_ITEM d( 0 to 4 )
    d(0).dock = TK_DOCK_FILL
    d(1).dock = TK_DOCK_TOP    : d(1).cy = 40
    d(2).dock = TK_DOCK_BOTTOM : d(2).cy = 20
    d(3).dock = TK_DOCK_LEFT   : d(3).cx = 80
    d(4).dock = TK_DOCK_RIGHT  : d(4).cx = 60
    tkLayout_Compute( @d(0), 5, DW, DH, cw, ch, dockArea, s, @out_(0) )
    dim as long tH = Sc( 40, s ), bH = Sc( 20, s ), lW = Sc( 80, s ), rW = Sc( 60, s )
    CheckRect( "dock top", out_(1), 0, 0, cw, tH )
    CheckRect( "dock bottom", out_(2), 0, ch - bH, cw, ch )
    CheckRect( "dock left, between top and bottom", out_(3), 0, tH, lW, ch - bH )
    CheckRect( "dock right, between top and bottom", out_(4), cw - rW, tH, cw, ch - bH )
    CheckRect( "fill takes the rest", out_(0), lW, tH, cw - rW, ch - bH )
    tkTest_Check( "docks abut: top to left", out_(1).bottom = out_(3).top )
    tkTest_Check( "docks abut: left to fill", out_(3).right = out_(0).left )
    tkTest_Check( "docks abut: fill to right", out_(0).right = out_(4).left )
    tkTest_Check( "docks abut: left to bottom", out_(3).bottom = out_(2).top )

    ' Docks stay inside a reduced client area, a group box's for instance.
    dim as TKRECT inset
    tkRect_Set( inset, 7, 19, cw - 7, ch - 5 )
    dim as TKLAYOUT_ITEM g( 0 to 1 )
    g(0).dock = TK_DOCK_TOP : g(0).cy = 30
    g(1).dock = TK_DOCK_FILL
    tkLayout_Compute( @g(0), 2, DW, DH, cw, ch, inset, s, @out_(0) )
    CheckRect( "dock top inside the client area", out_(0), 7, 19, cw - 7, 19 + Sc( 30, s ) )
    CheckRect( "fill inside the client area", out_(1), 7, 19 + Sc( 30, s ), cw - 7, ch - 5 )

    ' Docks larger than the area clamp: nothing overflows, FILL is empty.
    dim as TKLAYOUT_ITEM big( 0 to 1 )
    big(0).dock = TK_DOCK_LEFT : big(0).cx = 100000
    big(1).dock = TK_DOCK_FILL
    tkLayout_Compute( @big(0), 2, DW, DH, cw, ch, dockArea, s, @out_(0) )
    tkTest_Check( "an oversized dock stops at the edge", out_(0).right = cw, R_( out_(0) ) )
    tkTest_Check( "fill after it is empty", out_(1).right - out_(1).left = 0, R_( out_(1) ) )
end sub

sub WindowPass( byval fScale as single )
    tkTest_Begin( "window, scale " & fScale )
    dim as TK_HOST ptr h = tkHost_Create( "tkLayout selftest", 640, 480, tkHost_FontDir() & TK_FONT_UI, fScale )
    dim as TK_WIDGET ptr root_ = tkHost_Root( h )
    dim as TK_WIDGET ptr pnlTop = tkPanel_Create( root_, 1 )
    dim as TK_WIDGET ptr pnlLeft = tkPanel_Create( root_, 2 )
    dim as TK_WIDGET ptr bar = tkSplitter_Create( root_, 3, TKSPLITTER_VERTICAL )
    dim as TK_WIDGET ptr pnlMain = tkPanel_Create( root_, 4 )
    dim as TK_WIDGET ptr btn = tkPanel_Create( pnlMain, 5 )
    tkHost_Show( h )
    tkTest_PumpFor( h, 50 )

    const DW = 640, DH = 480
    dim as TK_LAYOUT ptr l = tkLayout_Create( )
    tkLayout_AddContainer( l, root_, DW, DH )
    tkLayout_Add( l, pnlTop, 0, 0, 0, 40, TK_ANCHOR_NONE, TK_DOCK_TOP )
    tkLayout_Add( l, pnlLeft, 0, 0, 120, 0, TK_ANCHOR_NONE, TK_DOCK_LEFT )
    tkLayout_Add( l, bar, 0, 0, 4, 0, TK_ANCHOR_NONE, TK_DOCK_LEFT )
    tkLayout_Add( l, pnlMain, 0, 0, 0, 0, TK_ANCHOR_NONE, TK_DOCK_FILL )
    tkLayout_AddContainer( l, pnlMain, 516, 440 )
    tkLayout_Add( l, btn, 416, 400, 90, 30, TK_ANCHOR_RIGHT or TK_ANCHOR_BOTTOM )
    tkLayout_BindSplitter( l, bar, pnlLeft )
    tkLayout_Apply( l )

    dim as long sw = root_->cw, sh = root_->ch
    dim as long topH = Sc( 40, fScale ), leftW = Sc( 120, fScale ), barW = Sc( 4, fScale )
    tkTest_Check( "top dock spans the window", (pnlTop->x = 0) andalso (pnlTop->y = 0) andalso (pnlTop->cw = sw) andalso (pnlTop->ch = topH), pnlTop->cw & "x" & pnlTop->ch )
    tkTest_Check( "left dock under it", (pnlLeft->x = 0) andalso (pnlLeft->y = topH) andalso (pnlLeft->cw = leftW) andalso (pnlLeft->ch = sh - topH), pnlLeft->cw & "x" & pnlLeft->ch )
    tkTest_Check( "splitter after the pane", (bar->x = leftW) andalso (bar->cw = barW), bar->x & " w " & bar->cw )
    tkTest_Check( "fill takes the rest", (pnlMain->x = leftW + barW) andalso (pnlMain->cw = sw - leftW - barW), pnlMain->x & " w " & pnlMain->cw )

    dim as long gapR = pnlMain->cw - (btn->x + btn->cw), gapB = pnlMain->ch - (btn->y + btn->ch)

    ' A real drag on the bar: the pane grows, FILL shrinks, the bar follows.
    dim as single gx = tkTest_CX( bar ), gy = tkTest_CY( bar )
    tkTest_PushMotion( h, gx, gy )
    tkTest_PumpFor( h, 20 )
    tkTest_PushButton( h, true, gx, gy )
    tkTest_PumpFor( h, 20 )
    dim as long dragBy = Sc( 50, fScale )
    tkTest_PushMotion( h, gx + dragBy, gy )
    tkTest_PumpFor( h, 20 )
    tkTest_PushButton( h, false, gx + dragBy, gy )
    tkTest_PumpFor( h, 20 )
    tkTest_Check( "drag grew the pane", abs( pnlLeft->cw - (leftW + dragBy) ) <= 1, pnlLeft->cw & " want " & (leftW + dragBy) )
    tkTest_Check( "the bar follows the pane", bar->x = pnlLeft->cw, bar->x & " vs " & pnlLeft->cw )
    tkTest_Check( "fill abuts the bar", pnlMain->x = bar->x + bar->cw, pnlMain->x & "" )
    tkTest_Check( "fill still reaches the window edge", pnlMain->x + pnlMain->cw = sw, (pnlMain->x + pnlMain->cw) & " vs " & sw )
    tkLayout_Apply( l )
    tkTest_Check( "a later apply keeps the dragged size", abs( pnlLeft->cw - (leftW + dragBy) ) <= 1, pnlLeft->cw & "" )

    ' The right+bottom button keeps its corner distance as its parent changes.
    tkTest_Check( "nested anchor kept its right gap", pnlMain->cw - (btn->x + btn->cw) = gapR, (pnlMain->cw - (btn->x + btn->cw)) & " vs " & gapR )
    tkTest_Check( "nested anchor kept its bottom gap", pnlMain->ch - (btn->y + btn->ch) = gapB, (pnlMain->ch - (btn->y + btn->ch)) & " vs " & gapB )

    tkLayout_SetDock( l, pnlTop, TK_DOCK_BOTTOM )
    tkTest_Check( "dock reads back", tkLayout_GetDock( l, pnlTop ) = TK_DOCK_BOTTOM )
    tkLayout_Apply( l )
    tkTest_Check( "changing a dock moves it", pnlTop->y = sh - topH, pnlTop->y & "" )
    tkLayout_SetAnchor( l, btn, TK_ANCHOR_LEFT or TK_ANCHOR_TOP )
    tkTest_Check( "anchor reads back", tkLayout_GetAnchor( l, btn ) = (TK_ANCHOR_LEFT or TK_ANCHOR_TOP) )
    tkLayout_Apply( l )
    tkTest_Check( "changing an anchor pins it to the design spot", (btn->x = Sc( 416, fScale )) andalso (btn->y = Sc( 400, fScale )), btn->x & "," & btn->y )
    tkLayout_Remove( l, btn )
    tkTest_Check( "removed", tkLayout_GetAnchor( l, btn ) = TK_ANCHOR_NONE )

    tkLayout_Destroy( l )
    tkHost_Destroy( h )
end sub

ComputeTables( 1.0 )
ComputeTables( 1.75 )
if tkTest_Init() = false then end 99
WindowPass( 1.0 )
WindowPass( 1.75 )
dim as long nFail = tkTest_Report( "tkLayout" )
tkTest_Quit()
end nFail
