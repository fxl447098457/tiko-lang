' tkLayout demo: resize the window, and drag the bar between the panes. Everything here is placed by
' tkLayout: nothing hand-computes a position.
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkLayout"
#import "vendor/tkControls/tkLabel"
#import "vendor/tkControls/tkPanel"
#import "vendor/tkControls/tkGroupBox"
#import "vendor/tkControls/tkTabControl"
#import "vendor/tkControls/tkButton"
using tkApp
using tkLayout
using tkLabel
using tkPanel
using tkGroupBox
using tkTabControl
using tkButton
using tkTheme
using tkHost
using tkPaint
using tkSplitter

dim shared as TK_LAYOUT ptr gLayout

sub OnSize( byval f as TK_FORM ptr, byval cx as long, byval cy as long )
    tkLayout_Apply( gLayout )
end sub

sub OnScale( byval f as TK_FORM ptr, byval fOld as single, byval fNew as single )
    tkLayout_Apply( gLayout )
end sub

dim as TKAPP_OPTIONS opts
if tkApp_Init( opts ) = false then end 98
dim as TK_FORM ptr f = tkApp_NewForm( "tkLayout demo", 720, 480 )
dim as TK_WIDGET ptr root_ = tkForm_Widget( f )

dim as TK_WIDGET ptr pnlTop = tkPanel_Create( root_, 1 )
tkPanel_SetBorderStyle( pnlTop, PNL_BORDER_LINE )
dim as TK_WIDGET ptr lblTop = tkLabel_Create( pnlTop, 2 )
tkLabel_SetText( lblTop, "Docked top: resize the window, drag the bar" )
dim as TK_WIDGET ptr pnlLeft = tkPanel_Create( root_, 3 )
tkPanel_SetBorderStyle( pnlLeft, PNL_BORDER_LINE )
dim as TK_WIDGET ptr bar = tkSplitter_Create( root_, 4, TKSPLITTER_VERTICAL )
dim as TK_WIDGET ptr tabs = tkTabControl_Create( root_, 5 )
tkTabControl_AddPage( tabs, "Anchors" )
tkTabControl_AddPage( tabs, "Group box" )
dim as TK_WIDGET ptr page0 = tkTabControl_GetPage( tabs, 0 ), page1 = tkTabControl_GetPage( tabs, 1 )

dim as TK_WIDGET ptr stretch = tkPanel_Create( page0, 10 )
tkPanel_SetBorderStyle( stretch, PNL_BORDER_LINE )
dim as TK_WIDGET ptr lblStretch = tkLabel_Create( stretch, 11 )
tkLabel_SetText( lblStretch, "Anchored on all four sides" )
tkLabel_SetAlign( lblStretch, LBL_ALIGN_CENTER )
dim as TK_WIDGET ptr btnOK = tkButton_Create( page0, 12 )
tkButton_SetText( btnOK, "Right + bottom" )
dim as TK_WIDGET ptr group = tkGroupBox_Create( page1, 20 )
tkGroupBox_SetText( group, "Docks inside a group box" )
dim as TK_WIDGET ptr g1 = tkPanel_Create( group, 21 )
tkPanel_SetBorderStyle( g1, PNL_BORDER_LINE )
dim as TK_WIDGET ptr g2 = tkPanel_Create( group, 22 )
tkPanel_SetBorderStyle( g2, PNL_BORDER_LINE )

gLayout = tkLayout_Create( )
tkLayout_AddContainer( gLayout, root_, 720, 480 )
tkLayout_AddContainer( gLayout, pnlTop, 720, 36 )
tkLayout_Add( gLayout, pnlTop, 0, 0, 0, 36, TK_ANCHOR_NONE, TK_DOCK_TOP )
tkLayout_Add( gLayout, lblTop, 10, 0, 700, 36, TK_ANCHOR_LEFT or TK_ANCHOR_RIGHT or TK_ANCHOR_TOP or TK_ANCHOR_BOTTOM )
tkLayout_Add( gLayout, pnlLeft, 0, 0, 160, 0, TK_ANCHOR_NONE, TK_DOCK_LEFT )
tkLayout_Add( gLayout, bar, 0, 0, 5, 0, TK_ANCHOR_NONE, TK_DOCK_LEFT )
tkLayout_Add( gLayout, tabs, 0, 0, 0, 0, TK_ANCHOR_NONE, TK_DOCK_FILL )
tkLayout_AddContainer( gLayout, page0, 555, 414 )
tkLayout_Add( gLayout, stretch, 16, 16, 523, 330, TK_ANCHOR_LEFT or TK_ANCHOR_RIGHT or TK_ANCHOR_TOP or TK_ANCHOR_BOTTOM )
tkLayout_AddContainer( gLayout, stretch, 523, 330 )
tkLayout_Add( gLayout, lblStretch, 0, 0, 0, 0, TK_ANCHOR_NONE, TK_DOCK_FILL )
tkLayout_Add( gLayout, btnOK, 409, 362, 130, 32, TK_ANCHOR_RIGHT or TK_ANCHOR_BOTTOM )
tkLayout_AddContainer( gLayout, page1, 555, 414 )
tkLayout_Add( gLayout, group, 16, 16, 523, 382, TK_ANCHOR_LEFT or TK_ANCHOR_RIGHT or TK_ANCHOR_TOP or TK_ANCHOR_BOTTOM )
tkLayout_AddContainer( gLayout, group, 523, 382, @tkGroupBox_GetClientRect )
tkLayout_Add( gLayout, g1, 0, 0, 0, 60, TK_ANCHOR_NONE, TK_DOCK_TOP )
tkLayout_Add( gLayout, g2, 0, 0, 0, 0, TK_ANCHOR_NONE, TK_DOCK_FILL )
tkLayout_BindSplitter( gLayout, bar, pnlLeft )

tkForm_OnSize( f, @OnSize )
tkForm_OnScaleChanged( f, @OnScale )
dim as long code = tkApp_Run( f )
tkLayout_Destroy( gLayout )
end code
