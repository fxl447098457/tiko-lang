format = 1

[form]
caption = "Products"
width = 520
height = 300
data_type = "productdata.Product"
data_module = "../productdata"

[[control]]
name = "txtName"
type = "TextBox"
parent = ""
x = 16
y = 16
w = 240
h = 28
bind = "Name"

[[control]]
name = "bcSku"
type = "Barcode"
parent = ""
x = 16
y = 56
w = 240
h = 120
bind = "Sku"

[control.props]
Symbology = "EAN13"
FitMode = "Fit"

[[control]]
name = "bcId"
type = "Barcode"
parent = ""
x = 280
y = 56
w = 120
h = 120
bind = "Id"

[control.props]
Symbology = "QR"
ModuleWidth = 3
TextMode = "None"

[[control]]
name = "navProducts"
type = "Navigator"
parent = ""
x = 16
y = 250
w = 300
h = 30
items_source = "Products"
