' The record frmProducts steps through (BARCODE.md BC3): DataType productdata.Product, the form's
' Products an Array of them.
#module "productdata"

public type Product
    Name as ustring         ' txtName
    Sku as ustring          ' bcSku: an EAN-13, as text (leading zeros survive)
    Id as int64             ' bcId: a QR code of the number, through tkBind's text conversion
end type
