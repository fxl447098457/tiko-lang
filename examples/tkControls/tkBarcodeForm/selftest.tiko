' tkBarcodeForm self-test (BARCODE.md BC3). frmProducts was written as a .tkform and generated by
' tkEdit --generate-forms; this steps its navigator the way a user does (pushed clicks on its buttons)
' and checks what each record's barcodes show: B1's load-only Bind through LoadFrom, B4's navigator,
' an int64 field through tkBind's text conversion, and a record the symbology refuses.
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkForms"
#import "vendor/tkControls/tkBind"
#import "vendor/tkControls/tkTextBox"
#import "vendor/tkControls/tkNavigator"
#import "vendor/tkControls/tkBarcode"
#import "std/containers"
#import "./frmProducts"
#import "./productdata"
using tkApp
using tkForms
using tkBind
using tkTextBox
using tkNavigator
using tkBarcode
using tkHost
using tkPaint
using tkTest
using containers

function NewProduct( byref name_ as const ustring, byref sku as const ustring, byval id as int64 ) as productdata.Product
    dim as productdata.Product p
    p.Name = name_ : p.Sku = sku : p.Id = id
    return p
end function

sub ClickPart( byval h as TK_HOST ptr, byval nav as TK_WIDGET ptr, byval part as long )
    dim as TKRECT rc, a
    tkNavigator_GetPartRect( nav, part, rc )
    tkWidget_AbsRect( nav, a )
    dim as single x = a.left + (rc.left + rc.right) / 2, y = a.top + (rc.top + rc.bottom) / 2
    tkTest_PushMotion( h, x, y )
    tkTest_Click( h, x, y )
    tkTest_PumpFor( h, 20 )
end sub

' The module matrix of a barcode as a string of 0s and 1s (row-major): two records' symbols differ.
function Matrix( byval hb as TK_WIDGET ptr ) as string
    dim as TKBARCODE_SYMBOL s
    tkBarcode_GetSymbol( hb, s )
    dim as string m = ""
    for r as int32 = 0 to s.nRows - 1
        for c as int32 = 0 to s.nCols - 1
            m &= iif( tkBarcode_SymbolModule( s, r, c ), "1", "0" )
        next
    next
    return m
end function

sub Products( byval owner as TK_FORM ptr )
    tkTest_Begin( "a designed form with barcodes" )
    dim as frmProducts.Form f
    f.Build( owner )
    dim as TK_HOST ptr h = tkForm_Host( f.Handle )
    f.Show( )
    tkTest_PumpFor( h, 60 )
    dim as TK_WIDGET ptr nav = f.navProducts.Handle, sku = f.bcSku.Handle, qr = f.bcId.Handle

    tkTest_Check( "the generated form made its barcodes with their symbologies", _
                  tkBarcode_GetSymbology( sku ) = TKBC_EAN13 andalso tkBarcode_GetSymbology( qr ) = TKBC_QR _
                  andalso tkBarcode_GetFitMode( sku ) = TKBC_FIT_FIT andalso tkBarcode_GetModuleWidth( qr ) = 3 )

    f.Products.Push( NewProduct( "Widget", "5901234123457", 1001 ) )
    f.Products.Push( NewProduct( "Gadget", "0012345678905", 1002 ) )
    f.Products.Push( NewProduct( "Broken", "5901234123458", 1003 ) )     ' a wrong check digit
    f.navProducts_Refresh( )
    dim as string m1 = Matrix( sku ), q1 = Matrix( qr )
    tkTest_Check( "Refresh: the first record's SKU and id are drawn", tkBarcode_GetData( sku ) = "5901234123457" _
                  andalso tkBarcode_IsValid( sku ) andalso tkBarcode_GetData( qr ) = "1001" andalso tkBarcode_IsValid( qr ), _
                  tkBarcode_GetData( sku ) & " / " & tkBarcode_GetData( qr ) )

    ClickPart( h, nav, TKNAV_NEXT )
    tkTest_Check( "Next: the second record's symbols, a leading-zero SKU intact", (f.navProducts_Current( ) = 1) _
                  andalso tkBarcode_GetData( sku ) = "0012345678905" andalso tkBarcode_IsValid( sku ) _
                  andalso Matrix( sku ) <> m1 andalso Matrix( qr ) <> q1 andalso tkBarcode_GetData( qr ) = "1002", tkBarcode_GetData( sku ) )

    ClickPart( h, nav, TKNAV_NEXT )
    tkTest_Check( "a record the symbology refuses: the error state, and navigation goes on", (f.navProducts_Current( ) = 2) _
                  andalso tkBarcode_IsValid( sku ) = false andalso tkBarcode_GetStatus( sku ) = TKBC_ERR_INVALID_CHECK _
                  andalso tkTextBox_GetText( f.txtName.Handle ) = "Broken" andalso tkBarcode_IsValid( qr ), str( tkBarcode_GetStatus( sku ) ) )

    ' the user edits the name and moves on: SaveTo writes the name, and never the barcodes' load-only fields
    tkTextBox_SetText( f.txtName.Handle, "Fixed" )
    f.Products[2].Sku = "5901234123457"
    tkBarcode_SetData( sku, "1" )                 ' a barcode's data is not a field it saves
    dim as productdata.Product rec = f.Products[2]
    dim as boolean saved = f.SaveTo( rec )
    tkTest_Check( "SaveTo: the name saved, the SKU and id untouched (load only)", saved andalso rec.Name = "Fixed" _
                  andalso rec.Sku = "5901234123457" andalso rec.Id = 1003, rec.Name & " " & rec.Sku & " " & rec.Id )

    ClickPart( h, nav, TKNAV_FIRST )
    tkTest_Check( "First: back to the first record's symbol", Matrix( sku ) = m1 andalso Matrix( qr ) = q1 )
    f.Close( )
    tkTest_PumpFor( h, 40 )
end sub

if tkTest_Init() = false then end 99
dim as TKAPP_OPTIONS opts
if tkApp_Init( opts ) = false then
    print "tkApp_Init failed"
    end 98
end if
dim as TK_FORM ptr mainForm = tkApp_NewForm( "owner", 200, 120, 0, 1.0 )
tkForm_Show( mainForm )
tkTest_PumpFor( tkForm_Host( mainForm ), 50 )
Products( mainForm )
dim as long nFail = tkTest_Report( "tkBarcodeForm" )
tkApp_Shutdown( )
end nFail
