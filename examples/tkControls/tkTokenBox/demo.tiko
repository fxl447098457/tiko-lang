' tkTokenBox demo: four token boxes. Recipients picked from a list only, growing to three lines,
' with a "You" chip that cannot be removed; free-text tags, at most five, lowercased on the way in,
' one flagged invalid; files matched fuzzily, with chips ellipsised at 110 pixels; a disabled box.
'
'   demo                          interactive (type, then "," ";" or Enter; Down lists the items;
'                                 Backspace / Left walk the chips; a click on a chip's x removes it)
'   demo --shot out.bmp           render once, save the window, exit
'   demo --shot out.bmp --open    the same with the first box's suggestions open (also out.bmp.pop.bmp)
'   demo --scale 1.75             pin the scale
#import "vendor/tkControls/tkTokenBox"
using tkTokenBox
using tkMatch
using tkTheme
using tkHost
using tkPaint

dim shared as TK_HOST ptr gHost
dim shared as TK_WIDGET ptr gBox(0 to 3)
dim shared as ustring gLabel(0 to 3)
dim shared as long gRowY(0 to 3) = { 20, 124, 174, 224 }
dim shared as TTF_Font ptr gFont

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

private function HasArg( byref name_ as string ) as boolean
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return true
    next
    return false
end function

' TokenAdding: before a user's token. The tags box lowercases free text (and refuses a lone "-").
private function Demo_Adding( byval h as TK_WIDGET ptr, byref Text as ustring, byref Key as ustring ) as boolean
    if tkTokenBox_GetID( h ) = 1001 then
        if trim( Text ) = "-" then print "TokenAdding 1001: refused """ & Text & """" : return false
        Text = lcase( Text ) : Key = lcase( Key )
    end if
    print "TokenAdding " & tkTokenBox_GetID( h ) & ": """ & Text & """ key """ & Key & """"
    return true
end function

' TokenRemoving: before a user removes a chip. The sender ("You") stays.
private function Demo_Removing( byval h as TK_WIDGET ptr, byval idx as long ) as boolean
    dim as boolean ok = (tkTokenBox_GetTokenKey( h, idx ) <> "me")
    print "TokenRemoving " & tkTokenBox_GetID( h ) & ": " & tkTokenBox_GetTokenText( h, idx ) & iif( ok, "", "  (vetoed)" )
    return ok
end function

private sub Demo_Changed( byval h as TK_WIDGET ptr )
    print "TokensChanged " & tkTokenBox_GetID( h ) & ": " & tkTokenBox_GetTokensText( h )
end sub

private sub Demo_ChipClick( byval h as TK_WIDGET ptr, byval idx as long )
    print "ChipClick " & tkTokenBox_GetID( h ) & ": " & tkTokenBox_GetTokenText( h, idx ) _
        & iif( tkTokenBox_IsTokenFree( h, idx ), " (free)", " (item id " & tkTokenBox_GetTokenID( h, idx ) & ")" )
end sub

private sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    b->SetFont( gFont )
    b->SetForeColor( tkTheme_Of( tkHost_Root( h ) ).TextDim )
    for i as long = 0 to 3
        dim as TKRECT rc
        tkRect_Set( rc, tkHost_Scale( h, 20 ), tkHost_Scale( h, gRowY(i) ), tkHost_Scale( h, 190 ), tkHost_Scale( h, gRowY(i) + 32 ) )
        b->PaintText( gLabel(i), @rc, TK_DT_LEFT or TK_DT_VCENTER )
    next
end sub

private sub Form_Size( byval h as TK_HOST ptr )
    for i as long = 0 to 3
        ' the first box sizes itself (AutoHeight); the rows below leave it room for three lines
        tkWidget_SetPos( gBox(i), tkHost_Scale( h, 200 ), tkHost_Scale( h, gRowY(i) ), tkHost_Scale( h, 340 ), tkHost_Scale( h, 32 ) )
    next
end sub

private sub SaveShot( byval h as TK_HOST ptr, byref path as string )
    tkHost_Render( h )
    tkHost_RenderTo( h, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( h->renderer, 0 )
    if s then
        SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & h->fScale
        SDL_DestroySurface( s )
    end if
end sub

if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
gHost = tkHost_Create( "tkTokenBox on SDL3", 560, 276, tkHost_FontDir() & TK_FONT_UI, val( ArgValue( "--scale" ) ) )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
gHost->clrBack = tkTheme_Of( tkHost_Root( gHost ) ).Window
gFont = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 10 )

gLabel(0) = "To: items only, 3 lines"
gLabel(1) = "Tags: free, max 5"
gLabel(2) = "Files: fuzzy, narrow chips"
gLabel(3) = "disabled"
for i as long = 0 to 3
    gBox(i) = tkTokenBox_Create( tkHost_Root( gHost ), 1000 + i )
    tkTokenBox_SetFont( gBox(i), gFont )
next

dim as ustring people(0 to 7) = { "You", "Ann Smith", "Bob Jones", "Carol White", "Dan Brown", "Eve Adams", "Frank Moore", "Grace Lee" }
dim as ustring keys(0 to 7) = { "me", "ann", "bob", "carol", "dan", "eve", "frank", "grace" }
for k as long = 0 to 7
    tkTokenBox_AddItem( gBox(0), people(k), keys(k), 500 + k )
next
tkTokenBox_SetEntryMode( gBox(0), TKTB_ENTRY_ITEMS )
tkTokenBox_SetPlaceholderText( gBox(0), "Add people" )
tkTokenBox_SetTokensText( gBox(0), "me;ann;bob;carol" )
tkTokenBox_SetAutoHeight( gBox(0), true, 3 )

tkTokenBox_AddItem( gBox(1), "design" )
tkTokenBox_AddItem( gBox(1), "backend" )
tkTokenBox_AddItem( gBox(1), "urgent" )
tkTokenBox_SetMaxTokens( gBox(1), 5 )
tkTokenBox_SetTokenSeparators( gBox(1), ",; " )
tkTokenBox_SetTokensText( gBox(1), "urgent;design;wip" )
tkTokenBox_SetTokenInvalid( gBox(1), 2, true )                      ' a host's validation result

dim as ustring files(0 to 5) = { "quarterly-report-2026-Q3.xlsx", "board-minutes-october.docx", "logo-final-v7.png", _
                                 "contract-signed.pdf", "roadmap.md", "invoice-2026-0412.pdf" }
for k as long = 0 to 5
    tkTokenBox_AddItem( gBox(2), files(k) )
next
tkTokenBox_SetMatchMode( gBox(2), TKMATCH_FUZZY )
tkTokenBox_SetMaxChipWidth( gBox(2), 110 )
tkTokenBox_SetTokensText( gBox(2), "quarterly-report-2026-Q3.xlsx;roadmap.md" )

tkTokenBox_SetTokensText( gBox(3), "read-only;archived" )
tkTokenBox_SetEnabled( gBox(3), false )

for i as long = 0 to 3
    tkTokenBox_SetTokenAddingCallback( gBox(i), @Demo_Adding )
    tkTokenBox_SetTokenRemovingCallback( gBox(i), @Demo_Removing )
    tkTokenBox_SetTokensChangedCallback( gBox(i), @Demo_Changed )
    tkTokenBox_SetChipClickCallback( gBox(i), @Demo_ChipClick )
next

gHost->OnPaint = @Form_Paint
gHost->OnSize = @Form_Size
Form_Size( gHost )
tkHost_SetFocus( gHost, gBox(0) )
tkHost_Show( gHost )

dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )
    if HasArg( "--open" ) then
        ' Down on the empty input lists every item not yet a token: push the key a user would press
        dim as SDL_Event e
        e.type = SDL_EVENT_KEY_DOWN
        e.key.windowID = gHost->winId
        e.key.key = SDLK_DOWN
        e.key.down = true
        SDL_PushEvent( @e )
        for k as long = 1 to 10
            tkHost_Pump( gHost )
            SDL_Delay( 15 )
        next
        dim as TK_HOST ptr pop = tkTokenBox_GetSuggestHost( gBox(0) )
        if pop then SaveShot( pop, shot & ".pop.bmp" )
    end if
    SaveShot( gHost, shot )
else
    tkHost_Run( gHost )
end if
tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
