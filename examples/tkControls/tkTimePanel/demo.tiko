' tkTimePanel demo: four panels. 24-hour with seconds; 12-hour in 15-minute steps kept to office
' hours (9:00 to 17:00, the rest dimmed); a list of half-hour slots with lunch refused by a
' callback; and a panel in 5-minute steps, five rows tall, whose item paint callback marks the
' office hours. Each panel's value is shown under it; every callback prints.
'
'   demo                     interactive (click, arrows, digits, a / p, Enter, Esc, the wheel)
'   demo --shot out.bmp      render once, save the window, exit
'   demo --scale 1.75        pin the scale instead of asking the display
#import "vendor/tkControls/tkTimePanel"
using tkTimePanel
using tkTheme
using tkHost
using tkPaint

const as long NPANEL = 4, CELLW = 160
dim shared as TK_HOST ptr gHost
dim shared as TK_WIDGET ptr gPanel(0 to NPANEL - 1)
dim shared as ustring gCap(0 to NPANEL - 1)
dim shared as TTF_Font ptr gFont
dim shared as long gReadY                                    ' where the values are written (pixels)

private function ShowTime( byval hPanel as TK_WIDGET ptr, byval pTime as TKTIME ptr ) as string
    if (pTime = 0) orelse (tkTimePanel_IsTime( *pTime ) = false) then return "(none)"
    return tkTimePanel_FormatPattern( *pTime, tkTimePanel_GetFormat( hPanel ) ) & "  [" & tkTimePanel_FormatIso( *pTime ) & "]"
end function

sub Panel_SelChange( byval hPanel as TK_WIDGET ptr, byval pTime as TKTIME ptr )
    print "SelChange " & tkTimePanel_GetID( hPanel ) & ": " & ShowTime( hPanel, pTime )
    tkHost_Invalidate( gHost )
end sub

sub Panel_Accept( byval hPanel as TK_WIDGET ptr, byval pTime as TKTIME ptr )
    print "Accept    " & tkTimePanel_GetID( hPanel ) & ": " & ShowTime( hPanel, pTime )
end sub

sub Panel_Dismiss( byval hPanel as TK_WIDGET ptr )
    print "Dismiss   " & tkTimePanel_GetID( hPanel )
end sub

' The slot list: 12:00 and 12:30 are lunch.
function Slots_Disabled( byval hPanel as TK_WIDGET ptr, byval nKind as long, byval nValue as long ) as boolean
    return (nKind = TKTP_ITEM_TIME) andalso (nValue >= 12 * 3600) andalso (nValue < 13 * 3600)
end function

' The fourth panel: the stock item, then an accent bar beside the office hours.
sub Hours_Paint( byval p as TKTIMEPANEL_ITEMPAINTINFO ptr )
    tkTimePanel_PaintItemDefault( p )
    if (p->nKind = TKTP_SEG_HOUR24) andalso (p->nValue >= 9) andalso (p->nValue < 17) then
        dim as TKRECT rc = p->rcItem
        rc.left += tkHost_Scale( gHost, 3 ) : rc.right = rc.left + tkHost_Scale( gHost, 3 )
        rc.top += tkHost_Scale( gHost, 6 ) : rc.bottom -= tkHost_Scale( gHost, 6 )
        p->b->SetBackColor( tkTheme_Of( p->hPanel ).Accent )
        p->b->PaintRect( @rc )
    end if
end sub

private sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    dim as TKTHEME_COLORS t = tkTheme_Of( tkHost_Root( h ) )
    b->SetFont( gFont )
    for i as long = 0 to NPANEL - 1
        dim as TKRECT rc
        dim as long x = tkHost_Scale( h, 20 + i * CELLW )
        tkRect_Set( rc, x, tkHost_Scale( h, 14 ), x + tkHost_Scale( h, CELLW - 10 ), tkHost_Scale( h, 40 ) )
        b->SetColors( t.TextDim, t.Window )
        b->PaintText( gCap(i), @rc, TK_DT_LEFT or TK_DT_VCENTER or TK_DT_ELLIPSIS )
        dim as TKTIME tv
        dim as ustring s = "(none)"
        if tkTimePanel_GetTime( gPanel(i), tv ) then s = tkTimePanel_FormatPattern( tv, tkTimePanel_GetFormat( gPanel(i) ) )
        tkRect_Set( rc, x, gReadY, x + tkHost_Scale( h, CELLW - 10 ), gReadY + tkHost_Scale( h, 26 ) )
        b->SetColors( t.Text, t.Window )
        b->PaintText( s, @rc, TK_DT_LEFT or TK_DT_VCENTER )
    next
end sub

private sub Form_Size( byval h as TK_HOST ptr )
    dim as long bottom = 0
    for i as long = 0 to NPANEL - 1
        dim as long iw, ih
        tkTimePanel_GetIdealSize( gPanel(i), iw, ih )
        tkWidget_SetPos( gPanel(i), tkHost_Scale( h, 20 + i * CELLW ), tkHost_Scale( h, 44 ), iw, ih )
        if tkHost_Scale( h, 44 ) + ih > bottom then bottom = tkHost_Scale( h, 44 ) + ih
    next
    gReadY = bottom + tkHost_Scale( h, 8 )
end sub

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

private function HasArg( byref name_ as string ) as boolean
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return true
    next
    return false
end function

private sub SaveShot( byval h as TK_HOST ptr, byref path as string )
    tkHost_Render( h )
    tkHost_RenderTo( h, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( h->renderer, 0 )
    if s then
        SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & h->fScale
        SDL_DestroySurface( s )
    end if
end sub

if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
dim as single forced = val( ArgValue( "--scale" ) )
gHost = tkHost_Create( "tkTimePanel on SDL3", 680, 300, tkHost_FontDir() & TK_FONT_UI, forced )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
gHost->clrBack = tkTheme_Of( tkHost_Root( gHost ) ).Window
gFont = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 10 )

gCap(0) = "24-hour, seconds"
gCap(1) = "12-hour, 15 min, 9-17"
gCap(2) = "slots, lunch refused"
gCap(3) = "5 min, 5 rows, painted"
for i as long = 0 to NPANEL - 1
    gPanel(i) = tkTimePanel_Create( tkHost_Root( gHost ), 200 + i )
    tkTimePanel_SetSelChangeCallback( gPanel(i), @Panel_SelChange )
    tkTimePanel_SetAcceptCallback( gPanel(i), @Panel_Accept )
    tkTimePanel_SetDismissCallback( gPanel(i), @Panel_Dismiss )
next
tkTimePanel_SetFormat( gPanel(0), "HH:mm:ss" )
tkTimePanel_SetStep( gPanel(0), 1 )
tkTimePanel_SetTimeValue( gPanel(0), tkTimePanel_MakeTime( 14, 30, 5 ) )

tkTimePanel_SetFormat( gPanel(1), "h:mm tt" )
tkTimePanel_SetStep( gPanel(1), 900 )
tkTimePanel_SetRange( gPanel(1), tkTimePanel_MakeTime( 9, 0 ), tkTimePanel_MakeTime( 17, 0 ) )
tkTimePanel_SetTimeValue( gPanel(1), tkTimePanel_MakeTime( 10, 45 ) )

tkTimePanel_SetMode( gPanel(2), TKTP_PANEL_LIST )
tkTimePanel_SetFormat( gPanel(2), "h:mm tt" )
tkTimePanel_SetListRange( gPanel(2), tkTimePanel_MakeTime( 8, 0 ), tkTimePanel_MakeTime( 18, 0 ), 1800 )
tkTimePanel_SetItemDisabledCallback( gPanel(2), @Slots_Disabled )
tkTimePanel_SetTimeValue( gPanel(2), tkTimePanel_MakeTime( 11, 0 ) )

tkTimePanel_SetFormat( gPanel(3), "HH:mm" )
tkTimePanel_SetStep( gPanel(3), 300 )
tkTimePanel_SetVisibleRows( gPanel(3), 5 )
tkTimePanel_SetItemPaintCallback( gPanel(3), @Hours_Paint )
tkTimePanel_SetTimeValue( gPanel(3), tkTimePanel_MakeTime( 8, 55 ) )

gHost->OnPaint = @Form_Paint
gHost->OnSize = @Form_Size
Form_Size( gHost )
tkHost_SetFocus( gHost, gPanel(0) )
tkHost_Show( gHost )

dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )
    SaveShot( gHost, shot )
else
    tkHost_Run( gHost )
end if
tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
