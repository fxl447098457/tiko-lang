' tkTimePanel self-test (phases T0 + T1 of claude-docs docs/tkControls/TIMEPICKER.md). First the
' time core as table tests (no window), then the panel in real windows with the real SDL event
' queue: every input claim is made by PUSHING the event a user would have produced and pumping.
' Two panel passes, scale pinned at 1.0 and 1.75; geometry asserted against the layout formulas.
'
'   selftest            exit code = number of failures
#import "vendor/tkControls/tkTimePanel"
#import "vendor/tkControls/tkTest"
using tkTimePanel
using tkTheme
using tkTest
using tkHost
using tkPaint

dim shared as long gSel, gAcc, gDis, gParentKeys, gParentWheels
dim shared as TKTIME gLastSel, gLastAcc
dim shared as boolean gDestroyInSel
dim shared as long gNoonOff

sub OnSel( byval hPanel as TK_WIDGET ptr, byval pTime as TKTIME ptr )
    gSel += 1
    gLastSel = *pTime
    if gDestroyInSel then tkWidget_Destroy( hPanel )
end sub

' Never dereferences hPanel: OnSel may have destroyed it.
sub OnAcc( byval hPanel as TK_WIDGET ptr, byval pTime as TKTIME ptr )
    gAcc += 1
    gLastAcc = *pTime
end sub

sub OnDis( byval hPanel as TK_WIDGET ptr )
    gDis += 1
end sub

' Lunch is off: hour 12 is refused when gNoonOff is set.
function OnItemDisabled( byval hPanel as TK_WIDGET ptr, byval nKind as long, byval nValue as long ) as boolean
    return (gNoonOff <> 0) andalso (nKind = TKTP_SEG_HOUR24) andalso (nValue = 12)
end function

sub ResetCounts( )
    gSel = 0 : gAcc = 0 : gDis = 0 : gParentKeys = 0 : gParentWheels = 0
end sub

' The panels' parent: counts the keys and wheels they refuse. Keys are only counted (returned
' FALSE), so the host's Tab walk still runs.
function ParentProc( byval w as TK_WIDGET ptr, byval m as TK_MSG ptr ) as boolean
    select case m->msg
    case TKM_KEYDOWN : gParentKeys += 1 : return false
    case TKM_MOUSEWHEEL : gParentWheels += 1 : return true
    end select
    return false
end function

function Tm( byval hh as long, byval mi as long, byval ss as long = 0, byval ms as long = 0 ) as TKTIME
    return tkTimePanel_MakeTime( hh, mi, ss, ms )
end function

function Iso( byref t as const TKTIME ) as string
    if tkTimePanel_IsTime( t ) = false then return "(none)"
    return tkTimePanel_FormatIso( t, true, true )
end function

function GetT( byval p as TK_WIDGET ptr ) as TKTIME
    dim as TKTIME t
    tkTimePanel_GetTime( p, t )
    return t
end function

function IsT( byval p as TK_WIDGET ptr, byval hh as long, byval mi as long, byval ss as long = 0, byval ms as long = 0 ) as boolean
    return tkTimePanel_SameTime( GetT( p ), Tm( hh, mi, ss, ms ) )
end function

function WX( byval w as TK_WIDGET ptr, byval x as long ) as long
    dim as TKRECT a
    tkWidget_AbsRect( w, a )
    return a.left + x
end function

function WY( byval w as TK_WIDGET ptr, byval y as long ) as long
    dim as TKRECT a
    tkWidget_AbsRect( w, a )
    return a.top + y
end function

' Click the centre of item (c, i), window coordinates.
sub ClickItem( byval h as TK_HOST ptr, byval p as TK_WIDGET ptr, byval c as long, byval i as long )
    dim as TKRECT r
    tkTimePanel_GetItemRect( p, c, i, r )
    tkTest_Click( h, WX( p, (r.left + r.right) \ 2 ), WY( p, (r.top + r.bottom) \ 2 ) )
end sub

function PixW( byval h as TK_HOST ptr, byval w as TK_WIDGET ptr, byval x as long, byval y as long ) as ulong
    return tkTest_PixelAt( h, WX( w, x ), WY( w, y ) )
end function

sub RenderQuiet( byval h as TK_HOST ptr )
    tkTest_PushMotion( h, 1, 1 )
    tkTest_PushWindowEvent( h, SDL_EVENT_WINDOW_MOUSE_LEAVE )
    tkHost_RenderTo( h, false )
end sub

function MaxW( byval f as TTF_Font ptr, byval nFrom as long, byval nTo as long ) as long
    dim as long w = 0
    for i as long = nFrom to nTo
        dim as string sx = iif( i < 10, "0" & str( i ), str( i ) )
        dim as long tw = tkText_Width( f, sx )
        if tw > w then w = tw
    next
    return w
end function

' ==========================================================================================
' T0: the time core
' ==========================================================================================
sub ParseOk( byref txt as const string, byval hh as long, byval mi as long, byval ss as long = 0, byval ms as long = 0, _
             byref sAm as const string = "AM", byref sPm as const string = "PM" )
    dim as TKTIME t
    dim as boolean ok = tkTimePanel_ParseLoose( txt, t, sAm, sPm )
    tkTest_Check( "loose accepts '" & txt & "'", ok andalso tkTimePanel_SameTime( t, Tm( hh, mi, ss, ms ) ), Iso( t ) )
end sub

sub ParseBad( byref txt as const string )
    dim as TKTIME t = Tm( 7, 7 )
    dim as boolean ok = tkTimePanel_ParseLoose( txt, t )
    tkTest_Check( "loose refuses '" & txt & "' and leaves t", (ok = false) andalso tkTimePanel_SameTime( t, Tm( 7, 7 ) ), Iso( t ) )
end sub

sub IsoOk( byref txt as const string, byval hh as long, byval mi as long, byval ss as long = 0, byval ms as long = 0 )
    dim as TKTIME t
    dim as boolean ok = tkTimePanel_ParseIso( txt, t )
    tkTest_Check( "ISO accepts '" & txt & "'", ok andalso tkTimePanel_SameTime( t, Tm( hh, mi, ss, ms ) ), Iso( t ) )
end sub

sub IsoBad( byref txt as const string )
    dim as TKTIME t
    dim as boolean ok = tkTimePanel_ParseIso( txt, t )
    tkTest_Check( "ISO refuses '" & txt & "'", ok = false andalso tkTimePanel_IsTime( t ) = false, Iso( t ) )
end sub

sub FmtIs( byref t as const TKTIME, byref pat as const string, byref want as const ustring, _
           byref sAm as const string = "AM", byref sPm as const string = "PM" )
    dim as ustring got = tkTimePanel_FormatPattern( t, pat, sAm, sPm )
    tkTest_Check( "format " & Iso( t ) & " '" & pat & "' = '" & want & "'", got = want, got )
end sub

function SegsStr( byref pat as const string ) as string
    dim as TKTIME_SEGMENT segs( any )
    dim as long n = tkTimePanel_ParsePattern( pat, segs() )
    dim as string r
    for i as long = 0 to n - 1
        if i then r &= "|"
        if segs( i ).kind = TKTP_SEG_LITERAL then
            r &= "L'" & segs( i ).text & "'"
        else
            r &= str( segs( i ).kind ) & "/" & str( segs( i ).nLen )
        end if
    next
    return r
end function

sub RunCore( )
    tkTest_Begin( "core" )
    dim as TKTIME e
    tkTest_Check( "a fresh TKTIME is empty (wHour -1)", e.wHour = -1 andalso tkTimePanel_IsTime( e ) = false )
    tkTest_Check( "midnight is a time", tkTimePanel_IsTime( Tm( 0, 0 ) ) andalso Tm( 0, 0 ).wHour = 0 )
    tkTest_Check( "MakeTime refuses 24:00, 12:60, 12:00:60, ms 1000, -1:00", _
                  tkTimePanel_IsTime( Tm( 24, 0 ) ) = false andalso tkTimePanel_IsTime( Tm( 12, 60 ) ) = false _
                  andalso tkTimePanel_IsTime( Tm( 12, 0, 60 ) ) = false andalso tkTimePanel_IsTime( Tm( 12, 0, 0, 1000 ) ) = false _
                  andalso tkTimePanel_IsTime( Tm( -1, 0 ) ) = false )
    tkTest_Check( "TimeToMs: 23:59:59.999 = 86399999, empty = -1", tkTimePanel_TimeToMs( Tm( 23, 59, 59, 999 ) ) = 86399999 _
                  andalso tkTimePanel_TimeToMs( e ) = -1 )
    dim as long bad = 0
    for ms as long = 0 to 86399999 step 7777
        if tkTimePanel_TimeToMs( tkTimePanel_MsToTime( ms ) ) <> ms then bad += 1
    next
    tkTest_Check( "MsToTime / TimeToMs round trip over the day", bad = 0, str( bad ) )
    tkTest_Check( "MsToTime: 86400000 and -1 are no time", tkTimePanel_IsTime( tkTimePanel_MsToTime( 86400000 ) ) = false _
                  andalso tkTimePanel_IsTime( tkTimePanel_MsToTime( -1 ) ) = false )
    tkTest_Check( "Compare: empty < 00:00 < 00:00:00.001; equal is 0", tkTimePanel_CompareTime( e, Tm( 0, 0 ) ) = -1 _
                  andalso tkTimePanel_CompareTime( Tm( 0, 0, 0, 1 ), Tm( 0, 0 ) ) = 1 andalso tkTimePanel_CompareTime( Tm( 9, 5 ), Tm( 9, 5 ) ) = 0 )
    tkTest_Check( "LocalNow is a time", tkTimePanel_IsTime( tkTimePanel_LocalNow() ) )

    ' ISO
    dim as TKTIME t = Tm( 9, 5, 7, 42 )
    tkTest_Check( "FormatIso default HH:mm:ss", tkTimePanel_FormatIso( t ) = "09:05:07", tkTimePanel_FormatIso( t ) )
    tkTest_Check( "FormatIso no seconds / with ms", tkTimePanel_FormatIso( t, false ) = "09:05" _
                  andalso tkTimePanel_FormatIso( t, false, true ) = "09:05:07.042" )
    tkTest_Check( "FormatIso of no time is empty", tkTimePanel_FormatIso( e ) = "" )
    IsoOk( "14:30", 14, 30 )
    IsoOk( "14:30:05", 14, 30, 5 )
    IsoOk( "14:30:05.25", 14, 30, 5, 250 )
    IsoOk( "14:30:05.123456", 14, 30, 5, 123 )
    IsoOk( " 00:00 ", 0, 0 )
    IsoBad( "24:00" )
    IsoBad( "1430" )
    IsoBad( "14:3" )
    IsoBad( "14:30:60" )
    IsoBad( "" )
    IsoBad( "aa:bb" )
    IsoBad( "14:30:05." )
    IsoBad( "14-30" )

    ' lenient
    ParseOk( "14:30", 14, 30 )
    ParseOk( "14:30:05", 14, 30, 5 )
    ParseOk( "14:30:05.250", 14, 30, 5, 250 )
    ParseOk( "14.30", 14, 30 )
    ParseOk( "1430", 14, 30 )
    ParseOk( "930", 9, 30 )
    ParseOk( "9", 9, 0 )
    ParseOk( "143005", 14, 30, 5 )
    ParseOk( "2:30 pm", 14, 30 )
    ParseOk( "2:30PM", 14, 30 )
    ParseOk( "2pm", 14, 0 )
    ParseOk( "2 p", 14, 0 )
    ParseOk( "12 am", 0, 0 )
    ParseOk( "12 pm", 12, 0 )
    ParseOk( "12:15 a.m.", 0, 15 )
    ParseOk( "11:59 PM", 23, 59 )
    ParseOk( "  7:05 a ", 7, 5 )
    ParseOk( "3 nachm.", 15, 0, 0, 0, "vorm.", "nachm." )
    ParseOk( "9:00 vorm.", 9, 0, 0, 0, "vorm.", "nachm." )
    ParseBad( "25:00" )
    ParseBad( "12:60" )
    ParseBad( "13 pm" )
    ParseBad( "0 am" )
    ParseBad( "" )
    ParseBad( "abc" )
    ParseBad( "14:5" )
    ParseBad( "12345" )
    ParseBad( "2:30 xm" )
    ParseBad( "pm" )

    ' patterns
    tkTest_Check( "segments HH:mm", SegsStr( "HH:mm" ) = "1/2|L':'|3/2", SegsStr( "HH:mm" ) )
    tkTest_Check( "segments h:mm:ss tt", SegsStr( "h:mm:ss tt" ) = "2/1|L':'|3/2|L':'|4/2|L' '|6/2", SegsStr( "h:mm:ss tt" ) )
    tkTest_Check( "segments with a quoted literal", SegsStr( "HH'h'mm" ) = "1/2|L'h'|3/2", SegsStr( "HH'h'mm" ) )
    tkTest_Check( "segments: '' is a quote", SegsStr( "H''m" ) = "1/1|L'''|3/1", SegsStr( "H''m" ) )
    tkTest_Check( "segments: runs past the longest token split", SegsStr( "HHH" ) = "1/2|1/1" andalso SegsStr( "fffff" ) = "5/3|5/2", _
                  SegsStr( "HHH" ) & " " & SegsStr( "fffff" ) )
    tkTest_Check( "segments: other letters are literals, merged", SegsStr( "Hxym" ) = "1/1|L'xy'|3/1", SegsStr( "Hxym" ) )
    FmtIs( Tm( 0, 5 ), "h:mm tt", "12:05 AM" )
    FmtIs( Tm( 12, 0 ), "h:mm tt", "12:00 PM" )
    FmtIs( Tm( 23, 9 ), "hh:mm t", "11:09 P" )
    FmtIs( Tm( 13, 7, 9, 42 ), "HH:mm:ss.fff", "13:07:09.042" )
    FmtIs( Tm( 13, 7, 9, 42 ), "H:m:s", "13:7:9" )
    FmtIs( Tm( 13, 7, 9, 42 ), "ff|f", "04|0" )
    FmtIs( Tm( 8, 30 ), "HH'h'mm", "08h30" )
    FmtIs( Tm( 15, 0 ), "h tt", "3 nachm.", "vorm.", "nachm." )
    FmtIs( e, "HH:mm", "" )

    ' date and time together (tkDateTimePicker), one check per behaviour
    tkTest_Check( "MakeDateTime: 2024-02-29 is a date, 2023-02-29 is not; the weekday is filled", _
                  tkTimePanel_IsDateTime( tkTimePanel_MakeDateTime( 2024, 2, 29 ) ) _
                  andalso tkTimePanel_IsDateTime( tkTimePanel_MakeDateTime( 2023, 2, 29 ) ) = false _
                  andalso tkTimePanel_MakeDateTime( 2026, 11, 23 ).wDayOfWeek = 1 )
    dim as TKDATETIME dtA = tkTimePanel_MakeDateTime( 2026, 11, 23, 14, 30, 5, 250 )
    tkTest_Check( "serial round trip, and no value sorts first", tkTimePanel_SameDateTime( _
                  tkTimePanel_SerialToDateTime( tkTimePanel_DateTimeToSerial( dtA ) ), dtA ) _
                  andalso tkTimePanel_CompareDateTime( tkTimePanel_EmptyDateTime( ), dtA ) = -1 _
                  andalso tkTimePanel_CompareDateTime( tkTimePanel_MakeDateTime( 2026, 11, 24 ), dtA ) = 1 )
    tkTest_Check( "ISO out", tkTimePanel_FormatIsoDateTime( dtA, true, true ) = "2026-11-23T14:30:05.250", tkTimePanel_FormatIsoDateTime( dtA, true, true ) )
    dim as TKDATETIME dtB
    dim as boolean okB = tkTimePanel_ParseIsoDateTime( "2026-11-23 14:30", dtB )
    tkTest_Check( "ISO in: a space for T; a date alone is midnight; 2026-02-30 refused", okB _
                  andalso tkTimePanel_SameDateTime( dtB, tkTimePanel_MakeDateTime( 2026, 11, 23, 14, 30 ) ) _
                  andalso tkTimePanel_ParseIsoDateTime( "2026-11-23", dtB ) andalso dtB.wHour = 0 _
                  andalso tkTimePanel_ParseIsoDateTime( "2026-02-30T10:00", dtB ) = false )
    okB = tkTimePanel_ParseLooseDateTime( "2026-11-23  2:30 pm", dtB )
    tkTest_Check( "lenient: an ISO date and ParseLoose's time", okB andalso dtB.wHour = 14 andalso dtB.wMinute = 30 )
    tkTest_Check( "date tokens only with the flag: yyyy-MM-dd is literal without it", SegsStr( "yyyy-MM-dd" ) = "L'yyyy-MM-dd'", SegsStr( "yyyy-MM-dd" ) )
    dim as TKTIME_SEGMENT sg( any )
    dim as long nSg = tkTimePanel_ParsePattern( "dddd d MMMM yy", sg(), true )
    tkTest_Check( "with the flag: weekday, day, month name, year", nSg = 7 andalso sg( 0 ).kind = TKTP_SEG_WEEKDAY _
                  andalso sg( 2 ).kind = TKTP_SEG_DAY andalso sg( 4 ).kind = TKTP_SEG_MONTHNAME andalso sg( 6 ).kind = TKTP_SEG_YEAR andalso sg( 6 ).nLen = 2 )
    dim as ustring fdt = tkTimePanel_FormatPatternDT( dtA, "ddd d MMM yyyy h:mm tt" )
    tkTest_Check( "FormatPatternDT", fdt = "Mon 23 Nov 2026 2:30 PM", fdt )
end sub

' ==========================================================================================
' T1: the panel
' ==========================================================================================
sub RunPass( byval fScale as single )
    tkTest_Begin( "scale " & fScale )
    dim as TK_HOST ptr h = tkHost_Create( "tkTimePanel selftest", 760, 560, tkHost_FontDir() & TK_FONT_UI, fScale )
    if h = 0 then tkTest_Check( "host created", false, *SDL_GetError() ) : exit sub
    tkTest_Check( "scale pinned", h->fScale = fScale, "" & h->fScale )
    dim as TK_WIDGET ptr root = tkHost_Root( h )
    dim as TK_WIDGET ptr par = tkWidget_CreateChild( root, 1, @ParentProc, 0 )
    tkWidget_SetPos( par, 0, 0, tkHost_Scale( h, 760 ), tkHost_Scale( h, 560 ) )

    ' ---- A: defaults, ideal size, geometry ------------------------------------------------------
    dim as TK_WIDGET ptr p = tkTimePanel_Create( par, 900 )
    tkTest_Check( "defaults: HH:mm, step 60, columns mode, 7 rows, no time", tkTimePanel_GetFormat( p ) = "HH:mm" _
                  andalso tkTimePanel_GetStep( p ) = 60 andalso tkTimePanel_GetMode( p ) = TKTP_PANEL_COLUMNS _
                  andalso tkTimePanel_GetVisibleRows( p ) = 7 andalso tkTimePanel_HasTime( p ) = false )
    tkTest_Check( "HH:mm gives two columns: hours (24), minutes (60)", tkTimePanel_GetColumnCount( p ) = 2 _
                  andalso tkTimePanel_GetColumnKind( p, 0 ) = TKTP_SEG_HOUR24 andalso tkTimePanel_GetItemCount( p, 0 ) = 24 _
                  andalso tkTimePanel_GetColumnKind( p, 1 ) = TKTP_SEG_MINUTE andalso tkTimePanel_GetItemCount( p, 1 ) = 60 )
    tkTest_Check( "item texts are two digits", tkTimePanel_GetItemText( p, 0, 7 ) = "07" andalso tkTimePanel_GetItemText( p, 1, 59 ) = "59" )
    dim as TKTIMEPANEL_COLORS cc
    tkTimePanel_GetColors( p, @cc )
    tkTest_Check( "created with the current theme (dark)", cc.BackColor = tkTheme_Dark().Window andalso cc.ItemBackColorSelected = tkTheme_Dark().Selected _
                  andalso cc.ItemColor = tkTheme_Dark().Text )
    dim as TTF_Font ptr f = h->pDefaultFont
    dim as long itemH = tkHost_Scale( h, 28 )
    if itemH < tkText_Height( f ) + tkHost_Scale( h, 8 ) then itemH = tkText_Height( f ) + tkHost_Scale( h, 8 )
    dim as long bt = tkTimePanel_GetBorderThickness( p )
    dim as long inset = bt + tkHost_Scale( h, 4 )
    dim as long padX = tkHost_Scale( h, 10 ), minW = tkHost_Scale( h, 40 )
    dim as long w0 = MaxW( f, 0, 23 ) + 2 * padX, w1 = MaxW( f, 0, 59 ) + 2 * padX
    if w0 < minW then w0 = minW
    if w1 < minW then w1 = minW
    dim as long iw, ih
    tkTimePanel_GetIdealSize( p, iw, ih )
    tkTest_Check( "border follows the theme's BorderWidth (1, unscaled)", bt = 1, str( bt ) )
    tkTest_Check( "item height = max( 28 scaled, text + 8 scaled )", tkTimePanel_GetItemHeight( p ) = itemH, tkTimePanel_GetItemHeight( p ) & " vs " & itemH )
    tkTest_Check( "ideal size before sizing = formula", iw = 2 * inset + w0 + w1 + 1 andalso ih = 2 * inset + 7 * itemH, _
                  iw & "x" & ih & " vs " & (2 * inset + w0 + w1 + 1) & "x" & (2 * inset + 7 * itemH) )
    dim as long px0 = tkHost_Scale( h, 20 ), py0 = tkHost_Scale( h, 20 )
    tkWidget_SetPos( p, px0, py0, iw, ih )
    dim as TKRECT r0, r1, ri
    tkTimePanel_GetColumnRect( p, 0, r0 )
    tkTimePanel_GetColumnRect( p, 1, r1 )
    tkTest_Check( "column 0 = inset .. inset + w0, body = 7 items", r0.left = inset andalso r0.right = inset + w0 andalso r0.top = inset _
                  andalso r0.bottom = inset + 7 * itemH, tkRect_Str( r0 ) )
    tkTest_Check( "column 1 starts past a hairline divider", r1.left = inset + w0 + 1 andalso r1.right = r1.left + w1 andalso r1.right = iw - inset, tkRect_Str( r1 ) )
    dim as boolean bVis = tkTimePanel_GetItemRect( p, 0, 3, ri )
    tkTest_Check( "item 3 of column 0: y = inset + 3 * itemH, visible", bVis andalso ri.top = inset + 3 * itemH andalso ri.bottom = ri.top + itemH _
                  andalso ri.left = r0.left andalso ri.right = r0.right, tkRect_Str( ri ) )
    bVis = tkTimePanel_GetItemRect( p, 0, 7, ri )
    tkTest_Check( "item 7 is below the body: not visible", bVis = false )

    ' ---- B: SetTime is silent and scrolls each selection to its column's top ----------------------
    ResetCounts( )
    tkTimePanel_SetSelChangeCallback( p, @OnSel )
    tkTimePanel_SetAcceptCallback( p, @OnAcc )
    tkTimePanel_SetDismissCallback( p, @OnDis )
    tkTimePanel_SetTime( p, Tm( 14, 30 ) )
    tkTest_Check( "SetTime: value, selected 14 and 30", IsT( p, 14, 30 ) andalso tkTimePanel_GetSelectedIndex( p, 0 ) = 14 _
                  andalso tkTimePanel_GetSelectedIndex( p, 1 ) = 30 )
    tkTest_Check( "SetTime scrolls: hours 14 rows, minutes 30 rows", tkTimePanel_GetScrollPos( p, 0 ) = 14 * itemH _
                  andalso tkTimePanel_GetScrollPos( p, 1 ) = 30 * itemH, tkTimePanel_GetScrollPos( p, 0 ) & " " & tkTimePanel_GetScrollPos( p, 1 ) )
    tkTimePanel_SetTime( p, Tm( 23, 58 ) )
    tkTest_Check( "near the end the scroll stops at the last page", tkTimePanel_GetScrollPos( p, 0 ) = (24 - 7) * itemH _
                  andalso tkTimePanel_GetScrollPos( p, 1 ) = (60 - 7) * itemH, tkTimePanel_GetScrollPos( p, 0 ) & " " & tkTimePanel_GetScrollPos( p, 1 ) )
    tkTimePanel_GetItemRect( p, 0, 23, ri )
    tkTest_Check( "...and 23 sits on the bottom row", ri.bottom = inset + 7 * itemH, tkRect_Str( ri ) )
    tkTimePanel_ClearTime( p )
    tkTest_Check( "ClearTime: no time, nothing selected", tkTimePanel_HasTime( p ) = false andalso tkTimePanel_GetSelectedIndex( p, 0 ) = -1 )
    tkTimePanel_SetTime( p, Tm( 14, 30 ) )
    tkTest_Check( "every setter above was SILENT", gSel = 0 andalso gAcc = 0 andalso gDis = 0, gSel & "/" & gAcc & "/" & gDis )

    ' ---- C: clicks ------------------------------------------------------------------------------
    tkHost_RenderTo( h, false )
    ClickItem( h, p, 0, 16 )
    tkTest_Check( "click hour 16: 16:30, focus, one SelChange, no Accept (not the last column)", IsT( p, 16, 30 ) _
                  andalso tkTimePanel_GetFocused( p ) andalso gSel = 1 andalso gAcc = 0 andalso tkTimePanel_GetFocusedColumn( p ) = 0, Iso( GetT( p ) ) & " " & gSel & "/" & gAcc )
    tkTest_Check( "inside SelChange the value was already new", tkTimePanel_SameTime( gLastSel, Tm( 16, 30 ) ), Iso( gLastSel ) )
    tkTest_Check( "the click scrolled hour 16 to the top", tkTimePanel_GetScrollPos( p, 0 ) = 16 * itemH, str( tkTimePanel_GetScrollPos( p, 0 ) ) )
    ResetCounts( )
    ClickItem( h, p, 1, 33 )
    tkTest_Check( "click minute 33 (the last column): 16:33, SelChange + Accept", IsT( p, 16, 33 ) andalso gSel = 1 andalso gAcc = 1 _
                  andalso tkTimePanel_SameTime( gLastAcc, Tm( 16, 33 ) ) andalso tkTimePanel_GetFocusedColumn( p ) = 1, gSel & "/" & gAcc )
    ResetCounts( )
    ClickItem( h, p, 1, 33 )
    tkTest_Check( "click the selected minute again: no SelChange, still Accept", gSel = 0 andalso gAcc = 1, gSel & "/" & gAcc )
    ' hidden parts: kept by a setter, zeroed by a user edit (D-4)
    tkTimePanel_SetTime( p, Tm( 16, 33, 15, 500 ) )
    tkTest_Check( "a setter keeps the hidden seconds", IsT( p, 16, 33, 15, 500 ) )
    ResetCounts( )
    ClickItem( h, p, 0, 17 )
    tkTest_Check( "a user edit zeroes what HH:mm does not show", IsT( p, 17, 33 ), Iso( GetT( p ) ) )

    ' ---- D: keys --------------------------------------------------------------------------------
    tkTimePanel_SetTime( p, Tm( 10, 0 ) )
    tkTimePanel_SetFocusedColumn( p, 0 )
    tkHost_SetFocus( h, p )
    ResetCounts( )
    tkTest_PushKey( h, SDLK_DOWN )
    tkTest_Check( "Down: 11:00, one SelChange", IsT( p, 11, 0 ) andalso gSel = 1 andalso gAcc = 0 )
    tkTest_PushKey( h, SDLK_UP )
    tkTest_PushKey( h, SDLK_UP )
    tkTest_Check( "Up, Up: 09:00", IsT( p, 9, 0 ) andalso gSel = 3 )
    tkTest_PushKey( h, SDLK_PAGEDOWN )
    tkTest_Check( "PgDn: a page of 7 rows, 16:00", IsT( p, 16, 0 ), Iso( GetT( p ) ) )
    tkTest_PushKey( h, SDLK_HOME )
    tkTest_Check( "Home: 00:00", IsT( p, 0, 0 ) )
    ResetCounts( )
    tkTest_PushKey( h, SDLK_UP )
    tkTest_Check( "Up at the first item: claimed, nothing moves, no event", IsT( p, 0, 0 ) andalso gSel = 0 andalso gParentKeys = 0 )
    tkTest_PushKey( h, SDLK_END )
    tkTest_Check( "End: 23:00", IsT( p, 23, 0 ) )
    tkTest_PushKey( h, SDLK_RIGHT )
    tkTest_PushKey( h, SDLK_DOWN )
    tkTest_Check( "Right moves to minutes; Down: 23:01", tkTimePanel_GetFocusedColumn( p ) = 1 andalso IsT( p, 23, 1 ) )
    tkTest_PushKey( h, SDLK_RIGHT )
    tkTest_Check( "Right at the last column stays (claimed)", tkTimePanel_GetFocusedColumn( p ) = 1 andalso gParentKeys = 0 )
    tkTest_PushKey( h, SDLK_LEFT )
    tkTest_Check( "Left: back to hours", tkTimePanel_GetFocusedColumn( p ) = 0 )
    ResetCounts( )
    tkTest_PushKey( h, SDLK_RETURN )
    tkTest_Check( "Enter: Accept with the value, no SelChange", gAcc = 1 andalso gSel = 0 andalso tkTimePanel_SameTime( gLastAcc, Tm( 23, 1 ) ) )
    tkTest_PushKey( h, SDLK_ESCAPE )
    tkTest_Check( "Esc: Dismiss", gDis = 1 andalso gParentKeys = 0 )
    tkTest_PushKey( h, SDLK_DOWN, SDL_KMOD_LALT )
    tkTest_PushKey( h, SDLK_F4 )
    tkTest_Check( "Alt+Down and F4: Dismiss too", gDis = 3 )
    ' with no Accept / Dismiss callbacks, Enter and Esc are the form's
    tkTimePanel_SetAcceptCallback( p, 0 )
    tkTimePanel_SetDismissCallback( p, 0 )
    ResetCounts( )
    tkTest_PushKey( h, SDLK_RETURN )
    tkTest_PushKey( h, SDLK_ESCAPE )
    tkTest_Check( "no callbacks: Enter and Esc bubble to the parent", gParentKeys = 2 andalso gAcc = 0 andalso gDis = 0, str( gParentKeys ) )
    tkTimePanel_SetAcceptCallback( p, @OnAcc )
    tkTimePanel_SetDismissCallback( p, @OnDis )
    ' Tab walks the columns, then leaves
    dim as TK_WIDGET ptr p2 = tkTimePanel_Create( par, 901 )
    tkWidget_SetPos( p2, px0 + iw + tkHost_Scale( h, 20 ), py0, iw, ih )
    tkTimePanel_SetFocusedColumn( p, 0 )
    tkHost_SetFocus( h, p )
    tkTest_PushKey( h, SDLK_TAB )
    tkTest_Check( "Tab: to the minutes column, focus stays", tkTimePanel_GetFocusedColumn( p ) = 1 andalso tkHost_GetFocus( h ) = p )
    tkTest_PushKey( h, SDLK_TAB )
    tkTest_Check( "Tab at the last column: the focus walk takes it", tkHost_GetFocus( h ) = p2, "focus " & iif( tkHost_GetFocus( h ) = p, "p", "other" ) )
    tkHost_SetFocus( h, p )
    tkTest_PushKey( h, SDLK_TAB, SDL_KMOD_LSHIFT )
    tkTest_Check( "Shift+Tab: back to hours", tkTimePanel_GetFocusedColumn( p ) = 0 andalso tkHost_GetFocus( h ) = p )
    ' type-ahead
    tkTimePanel_SetTime( p, Tm( 23, 1 ) )
    ResetCounts( )
    tkTest_PushKey( h, SDLK_0 )
    tkTest_PushKey( h, SDLK_9 )
    tkTest_Check( "type 0 9: hour 09", IsT( p, 9, 1 ), Iso( GetT( p ) ) )
    tkTest_PumpFor( h, TKTP_TYPE_TIMEOUT + 150 )
    tkTest_PushKey( h, SDLK_2 )
    tkTest_PushKey( h, SDLK_3 )
    tkTest_Check( "after the timeout, 2 3: hour 23", IsT( p, 23, 1 ), Iso( GetT( p ) ) )
    tkTest_PumpFor( h, TKTP_TYPE_TIMEOUT + 150 )
    tkTest_PushKey( h, SDLK_7 )
    tkTest_PushKey( h, SDLK_KP_8 )
    tkTest_Check( "7 then keypad 8: 78 is no hour, so 8 starts over: hour 08", IsT( p, 8, 1 ), Iso( GetT( p ) ) )
    tkTest_PumpFor( h, TKTP_TYPE_TIMEOUT + 150 )
    tkTest_PushKey( h, SDLK_AMPERSAND, 0, true, SDL_SCANCODE_1 )
    tkTest_PushKey( h, SDLK_KP_5 )
    tkTest_Check( "AZERTY's & (scancode 1) types 1: 1 then keypad 5 is hour 15", IsT( p, 15, 1 ), Iso( GetT( p ) ) )
    tkTimePanel_SetTime( p, Tm( 8, 1 ) )
    ResetCounts( )
    tkTest_PushKey( h, SDLK_P )
    tkTest_Check( "p with no AM/PM column: not claimed", gParentKeys = 1 andalso IsT( p, 8, 1 ) )

    ' ---- E: range -------------------------------------------------------------------------------
    tkTimePanel_SetRange( p, Tm( 17, 0 ), Tm( 9, 30 ) )
    dim as TKTIME tMin, tMax
    dim as boolean hasMin, hasMax
    tkTimePanel_GetRange( p, tMin, tMax, hasMin, hasMax )
    tkTest_Check( "inverted range swapped: 09:30 .. 17:00", hasMin andalso hasMax andalso tkTimePanel_SameTime( tMin, Tm( 9, 30 ) ) _
                  andalso tkTimePanel_SameTime( tMax, Tm( 17, 0 ) ) )
    tkTest_Check( "SetRange clamped the value (08:01 -> 09:30), silently", IsT( p, 9, 30 ) andalso gSel = 0, Iso( GetT( p ) ) )
    tkTest_Check( "hours: 8 and 18 disabled, 9 and 17 enabled", tkTimePanel_IsItemDisabled( p, 0, 8 ) andalso tkTimePanel_IsItemDisabled( p, 0, 18 ) _
                  andalso tkTimePanel_IsItemDisabled( p, 0, 9 ) = false andalso tkTimePanel_IsItemDisabled( p, 0, 17 ) = false )
    tkTest_Check( "minutes at 9 o'clock: 29 disabled, 30 enabled", tkTimePanel_IsItemDisabled( p, 1, 29 ) andalso tkTimePanel_IsItemDisabled( p, 1, 30 ) = false )
    tkTimePanel_SetTime( p, Tm( 9, 45 ) )
    tkTimePanel_SetFocusedColumn( p, 0 )
    tkHost_SetFocus( h, p )
    ResetCounts( )
    tkTest_PushKey( h, SDLK_END )
    tkTest_Check( "End: hour 17, minutes clamped to the max: 17:00", IsT( p, 17, 0 ) andalso gSel = 1, Iso( GetT( p ) ) )
    tkTest_PushKey( h, SDLK_HOME )
    tkTest_Check( "Home: the first enabled hour, 9; 09:00 clamps to 09:30", IsT( p, 9, 30 ), Iso( GetT( p ) ) )
    ResetCounts( )
    tkTimePanel_SetTime( p, Tm( 12, 0 ) )
    tkHost_RenderTo( h, false )
    tkTimePanel_SetFocusedColumn( p, 0 )
    ClickItem( h, p, 0, 18 )
    tkTest_Check( "a click on a disabled item does nothing", IsT( p, 12, 0 ) andalso gSel = 0 andalso gAcc = 0 )
    tkTimePanel_SetRange( p, Tm( 0, 0 ), Tm( 0, 0 ), false, false )
    tkTimePanel_GetRange( p, tMin, tMax, hasMin, hasMax )
    tkTest_Check( "range cleared", hasMin = false andalso hasMax = false andalso tkTimePanel_IsItemDisabled( p, 0, 23 ) = false )

    ' ---- F: the ItemDisabled callback -------------------------------------------------------------
    gNoonOff = 1
    tkTimePanel_SetItemDisabledCallback( p, @OnItemDisabled )
    tkTimePanel_SetTime( p, Tm( 11, 0 ) )
    tkHost_SetFocus( h, p )
    tkTimePanel_SetFocusedColumn( p, 0 )
    tkTest_Check( "callback: hour 12 disabled", tkTimePanel_IsItemDisabled( p, 0, 12 ) andalso tkTimePanel_IsItemDisabled( p, 0, 13 ) = false )
    tkTest_PushKey( h, SDLK_DOWN )
    tkTest_Check( "Down from 11 skips the disabled 12: 13:00", IsT( p, 13, 0 ), Iso( GetT( p ) ) )
    gNoonOff = 0
    tkTimePanel_SetItemDisabledCallback( p, 0 )

    ' ---- G: step ------------------------------------------------------------------------------------
    tkTimePanel_SetStep( p, 900 )
    tkTest_Check( "step 900: minutes 00 15 30 45", tkTimePanel_GetItemCount( p, 1 ) = 4 andalso tkTimePanel_GetItemValue( p, 1, 3 ) = 45 _
                  andalso tkTimePanel_GetItemCount( p, 0 ) = 24 )
    tkTimePanel_SetTime( p, Tm( 13, 7 ) )
    tkTest_Check( "an off-step minute selects nothing in its column", tkTimePanel_GetSelectedIndex( p, 1 ) = -1 andalso tkTimePanel_GetSelectedIndex( p, 0 ) = 13 )
    tkTimePanel_SetFocusedColumn( p, 1 )
    ResetCounts( )
    tkTest_PushKey( h, SDLK_DOWN )
    tkTest_Check( "Down in a column with no selection starts at its first item: 13:00", IsT( p, 13, 0 ) andalso gSel = 1, Iso( GetT( p ) ) )
    tkTimePanel_SetFormat( p, "HH:mm:ss" )
    tkTimePanel_SetStep( p, 15 )
    tkTest_Check( "HH:mm:ss, step 15: three columns; minutes 60, seconds 00 15 30 45", tkTimePanel_GetColumnCount( p ) = 3 _
                  andalso tkTimePanel_GetItemCount( p, 1 ) = 60 andalso tkTimePanel_GetItemCount( p, 2 ) = 4 _
                  andalso tkTimePanel_GetColumnKind( p, 2 ) = TKTP_SEG_SECOND )
    tkTimePanel_SetStep( p, 0 )
    tkTest_Check( "step clamps to 1 .. 3600", tkTimePanel_GetStep( p ) = 1 )
    tkTimePanel_SetStep( p, 99999 )
    tkTest_Check( "...3600: the minutes column is just 00", tkTimePanel_GetStep( p ) = 3600 andalso tkTimePanel_GetItemCount( p, 1 ) = 1 )
    tkTimePanel_SetStep( p, 60 )

    ' ---- H: 12-hour -----------------------------------------------------------------------------------
    tkTimePanel_SetFormat( p, "h:mm tt" )
    tkTest_Check( "h:mm tt: hours(12), minutes, AM/PM", tkTimePanel_GetColumnCount( p ) = 3 andalso tkTimePanel_GetColumnKind( p, 0 ) = TKTP_SEG_HOUR12 _
                  andalso tkTimePanel_GetItemCount( p, 0 ) = 12 andalso tkTimePanel_GetColumnKind( p, 2 ) = TKTP_SEG_AMPM _
                  andalso tkTimePanel_GetItemCount( p, 2 ) = 2 )
    tkTest_Check( "12-hour labels: 12, 01 .. 11; AM, PM", tkTimePanel_GetItemText( p, 0, 0 ) = "12" andalso tkTimePanel_GetItemText( p, 0, 1 ) = "01" _
                  andalso tkTimePanel_GetItemText( p, 2, 0 ) = "AM" andalso tkTimePanel_GetItemText( p, 2, 1 ) = "PM" )
    tkTimePanel_GetIdealSize( p, iw, ih )
    tkWidget_SetPos( p, px0, py0, iw, ih )
    tkTimePanel_SetTime( p, Tm( 0, 5 ) )
    tkTest_Check( "00:05: hour item 0 (12), AM", tkTimePanel_GetSelectedIndex( p, 0 ) = 0 andalso tkTimePanel_GetSelectedIndex( p, 2 ) = 0 _
                  andalso tkTimePanel_GetItemValue( p, 0, 3 ) = 3 )
    tkHost_RenderTo( h, false )
    ResetCounts( )
    ClickItem( h, p, 2, 1 )
    tkTest_Check( "click PM (the last column): 12:05, SelChange + Accept", IsT( p, 12, 5 ) andalso gSel = 1 andalso gAcc = 1, Iso( GetT( p ) ) )
    tkTest_Check( "an hour item now stands for the PM hour (3 -> 15)", tkTimePanel_GetItemValue( p, 0, 3 ) = 15 )
    tkHost_SetFocus( h, p )
    tkTimePanel_SetFocusedColumn( p, 0 )
    tkTest_PushKey( h, SDLK_A )
    tkTest_Check( "a: AM, from any column: 00:05", IsT( p, 0, 5 ), Iso( GetT( p ) ) )
    tkTest_PushKey( h, SDLK_1 )
    tkTest_PushKey( h, SDLK_2 )
    tkTest_Check( "type 1 2 in a 12-hour column: the 12 item (00:05 stays AM)", IsT( p, 0, 5 ), Iso( GetT( p ) ) )
    tkTest_PumpFor( h, TKTP_TYPE_TIMEOUT + 150 )
    tkTest_PushKey( h, SDLK_3 )
    tkTest_Check( "type 3: 03:05", IsT( p, 3, 5 ), Iso( GetT( p ) ) )
    tkTimePanel_SetAmPmText( p, "vorm.", "nachm." )
    tkTest_PushKey( h, SDLK_N )
    tkTest_Check( "the host's designators: labels, and n picks nachm.: 15:05", tkTimePanel_GetItemText( p, 2, 1 ) = "nachm." andalso IsT( p, 15, 5 ), Iso( GetT( p ) ) )
    tkTimePanel_SetAmPmText( p, "", "" )
    tkTest_Check( "empty designators fall back to AM / PM", tkTimePanel_GetAmText( p ) = "AM" andalso tkTimePanel_GetPmText( p ) = "PM" )

    ' ---- I: list mode ---------------------------------------------------------------------------------
    tkTimePanel_SetFormat( p, "HH:mm" )
    tkTimePanel_SetMode( p, TKTP_PANEL_LIST )
    tkTimePanel_SetListRange( p, Tm( 8, 0 ), Tm( 18, 0 ), 1800 )
    tkTest_Check( "list 08:00 .. 18:00 by 30 min: 21 items, one column", tkTimePanel_GetColumnCount( p ) = 1 _
                  andalso tkTimePanel_GetItemCount( p, 0 ) = 21 andalso tkTimePanel_GetColumnKind( p, 0 ) = TKTP_ITEM_TIME _
                  andalso tkTimePanel_GetItemText( p, 0, 0 ) = "08:00" andalso tkTimePanel_GetItemValue( p, 0, 20 ) = 18 * 3600 )
    dim as long lw, lh
    tkTimePanel_GetIdealSize( p, lw, lh )
    dim as long wl = 0
    for i as long = 0 to 20
        dim as long tw = tkText_Width( f, tkTimePanel_GetItemText( p, 0, i ) )
        if tw > wl then wl = tw
    next
    wl += 2 * padX
    if wl < minW then wl = minW
    tkTest_Check( "list ideal size = the widest label + padding", lw = 2 * inset + wl andalso lh = 2 * inset + 7 * itemH, lw & "x" & lh )
    tkWidget_SetPos( p, px0, py0, lw, lh )
    tkTimePanel_SetTime( p, Tm( 9, 10 ) )
    tkTest_Check( "09:10 is no item: nothing selected; 09:00 (item 2) scrolled to the top", tkTimePanel_GetSelectedIndex( p, 0 ) = -1 _
                  andalso tkTimePanel_GetScrollPos( p, 0 ) = 2 * itemH, str( tkTimePanel_GetScrollPos( p, 0 ) ) )
    tkHost_SetFocus( h, p )
    ResetCounts( )
    tkTest_PushKey( h, SDLK_DOWN )
    tkTest_Check( "Down from the 09:00 cursor: 09:30", IsT( p, 9, 30 ) andalso gSel = 1 )
    tkHost_RenderTo( h, false )
    ResetCounts( )
    ClickItem( h, p, 0, 5 )
    tkTest_Check( "a click picks and Accepts: 10:30", IsT( p, 10, 30 ) andalso gSel = 1 andalso gAcc = 1, Iso( GetT( p ) ) )
    tkTest_PushKey( h, SDLK_1 )
    tkTest_PushKey( h, SDLK_3 )
    tkTest_Check( "type-ahead 1 3 over the labels: 13:00", IsT( p, 13, 0 ), Iso( GetT( p ) ) )
    tkTimePanel_SetRange( p, Tm( 9, 0 ), Tm( 12, 0 ) )
    tkTest_Check( "range in the list: 08:30 disabled, 12:00 enabled, 12:30 disabled", tkTimePanel_IsItemDisabled( p, 0, 1 ) _
                  andalso tkTimePanel_IsItemDisabled( p, 0, 8 ) = false andalso tkTimePanel_IsItemDisabled( p, 0, 9 ) )
    tkTimePanel_SetRange( p, Tm( 0, 0 ), Tm( 0, 0 ), false, false )

    ' ---- J: wheel ------------------------------------------------------------------------------------
    tkTimePanel_SetTime( p, Tm( 8, 0 ) )
    dim as long s0 = tkTimePanel_GetScrollPos( p, 0 )
    tkTimePanel_GetColumnRect( p, 0, r0 )
    ResetCounts( )
    tkTest_PushWheel( h, WX( p, (r0.left + r0.right) \ 2 ), WY( p, r0.top + itemH ), 0, -1 )
    tkTest_Check( "wheel down one notch: two rows, value unchanged, no event", tkTimePanel_GetScrollPos( p, 0 ) = s0 + 2 * itemH _
                  andalso IsT( p, 8, 0 ) andalso gSel = 0 andalso gParentWheels = 0, s0 & " -> " & tkTimePanel_GetScrollPos( p, 0 ) )
    tkTimePanel_SetMode( p, TKTP_PANEL_COLUMNS )
    tkTimePanel_SetFormat( p, "h:mm tt" )
    tkTimePanel_GetIdealSize( p, iw, ih )
    tkWidget_SetPos( p, px0, py0, iw, ih )
    dim as TKRECT r2
    tkTimePanel_GetColumnRect( p, 2, r2 )
    tkTest_PushWheel( h, WX( p, (r2.left + r2.right) \ 2 ), WY( p, r2.top + 2 ), 0, -1 )
    tkTest_Check( "wheel over the AM/PM column (nothing to scroll): bubbles", gParentWheels = 1, str( gParentWheels ) )

    ' ---- K: pixels -----------------------------------------------------------------------------------
    tkTimePanel_SetFormat( p, "HH:mm" )
    tkTimePanel_GetIdealSize( p, iw, ih )
    tkWidget_SetPos( p, px0, py0, iw, ih )
    tkTimePanel_SetTime( p, Tm( 10, 20 ) )
    tkTimePanel_GetColors( p, @cc )
    tkHost_SetFocus( h, 0 )
    RenderQuiet( h )
    tkTimePanel_GetItemRect( p, 0, 10, ri )
    dim as long gx = tkHost_Scale( h, 3 ) + tkHost_Scale( h, 4 ), ym = (ri.top + ri.bottom) \ 2
    tkTest_Check( "the selected item is filled with ItemBackColorSelected", PixW( h, p, ri.left + gx, ym ) = cc.ItemBackColorSelected, hex( PixW( h, p, ri.left + gx, ym ) ) )
    tkTimePanel_GetItemRect( p, 0, 11, ri )
    ym = (ri.top + ri.bottom) \ 2
    tkTest_Check( "an unselected item shows the back colour", PixW( h, p, ri.left + gx, ym ) = cc.BackColor, hex( PixW( h, p, ri.left + gx, ym ) ) )
    tkTest_Check( "the border is BorderColor", PixW( h, p, 0, ih \ 2 ) = cc.BorderColor, hex( PixW( h, p, 0, ih \ 2 ) ) )
    tkTimePanel_GetColumnRect( p, 0, r0 )
    tkTest_Check( "the divider is ColumnDividerColor", PixW( h, p, r0.right, ym ) = cc.ColumnDividerColor, hex( PixW( h, p, r0.right, ym ) ) )
    ' hot
    tkTest_PushMotion( h, WX( p, ri.left + gx ), WY( p, ym ) )
    tkHost_RenderTo( h, false )
    tkTest_Check( "hover paints ItemBackColorHot", PixW( h, p, ri.left + gx, ym ) = cc.ItemBackColorHot, hex( PixW( h, p, ri.left + gx, ym ) ) )

    ' ---- L: theme --------------------------------------------------------------------------------------
    dim as TKTIMEPANEL_COLORS pin = cc
    pin.BackColor = &hFF102030ul
    tkTimePanel_SetColors( p, @pin )
    tkTimePanel_ApplyTheme( p, tkTheme_Light() )
    tkTimePanel_GetColors( p, @cc )
    tkTest_Check( "pinned colours survive a theme", cc.BackColor = &hFF102030ul )
    tkTimePanel_UnpinColors( p )
    tkTimePanel_GetColors( p, @cc )
    tkTest_Check( "UnpinColors: the theme again", cc.BackColor = tkTheme_Dark().Window, hex( cc.BackColor ) )
    tkTimePanel_SetBorderThickness( p, 0 )
    tkTimePanel_GetIdealSize( p, iw, ih )
    tkTest_Check( "border 0 shrinks the ideal size by 2", ih = 2 * tkHost_Scale( h, 4 ) + 7 * itemH, str( ih ) )

    ' ---- M: rescale ----------------------------------------------------------------------------------------
    tkTimePanel_SetTime( p, Tm( 10, 20 ) )
    dim as long sc0 = tkTimePanel_GetScrollPos( p, 0 )
    h->fScaleForced = fScale * 2
    tkTest_PushWindowEvent( h, SDL_EVENT_WINDOW_DISPLAY_SCALE_CHANGED )
    dim as long sc1 = tkTimePanel_GetScrollPos( p, 0 ), ih2 = tkTimePanel_GetItemHeight( p )
    tkTest_Check( "rescale x2: scroll x2, item height about x2", abs( sc1 - 2 * sc0 ) <= 1 andalso ih2 >= itemH * 2 - 2, sc0 & "->" & sc1 & " " & itemH & "->" & ih2 )
    h->fScaleForced = fScale
    tkTest_PushWindowEvent( h, SDL_EVENT_WINDOW_DISPLAY_SCALE_CHANGED )
    tkTest_Check( "rescale back", abs( tkTimePanel_GetScrollPos( p, 0 ) - sc0 ) <= 1 andalso tkTimePanel_GetItemHeight( p ) = itemH, _
                  tkTimePanel_GetScrollPos( p, 0 ) & " " & tkTimePanel_GetItemHeight( p ) )

    ' ---- N: disabled ----------------------------------------------------------------------------------------
    tkTimePanel_GetIdealSize( p, iw, ih )
    tkWidget_SetPos( p, px0, py0, iw, ih )
    tkTimePanel_SetTime( p, Tm( 10, 20 ) )
    tkHost_RenderTo( h, false )
    tkTimePanel_SetEnabled( p, false )
    ResetCounts( )
    ClickItem( h, p, 0, 11 )
    tkTest_Check( "disabled: a click does nothing", IsT( p, 10, 20 ) andalso gSel = 0 andalso tkTimePanel_GetEnabled( p ) = false )
    tkTimePanel_SetEnabled( p, true )

    ' ---- O: a SelChange that destroys the panel -------------------------------------------------------------
    tkHost_SetFocus( h, p )
    tkTimePanel_SetFocusedColumn( p, 1 )
    tkHost_RenderTo( h, false )
    ResetCounts( )
    gDestroyInSel = true
    ClickItem( h, p, 1, 21 )
    gDestroyInSel = false
    tkTest_Check( "SelChange destroyed the panel: Accept still came, nothing crashed", gSel = 1 andalso gAcc = 1 _
                  andalso tkTimePanel_SameTime( gLastAcc, Tm( 10, 21 ) ), gSel & "/" & gAcc )

    tkHost_Destroy( h )
end sub


' ==========================================================================================
if tkTest_Init() = false then end 99
RunCore( )
RunPass( 1.0 )
RunPass( 1.75 )
dim as long nFail = tkTest_Report( "tkTimePanel" )
tkTest_Quit()
end nFail
