' tkChip demo (phase C0): action chips, filter (toggle) chips, input chips with avatars that the
' host removes when asked, a count, a status, outlined and small chips, and chips with no widget.
'
'   demo                     interactive (click, Space / Enter, Delete on an input chip)
'   demo --shot out.bmp      render once, save the window, exit
'   demo --scale 1.75        pin the scale instead of asking the display
#import "vendor/tkControls/tkChip"
using tkChip
using tkBadge
using tkTheme
using tkHost
using tkPaint

dim shared as TK_HOST ptr gHost
dim shared as TTF_Font ptr gFont
dim shared as TK_WIDGET ptr gPeople(0 to 3)

sub OnClick( byval hChip as TK_WIDGET ptr )
    print "click: " & tkChip_GetText( hChip )
end sub

sub OnSel( byval hChip as TK_WIDGET ptr, byval isSelected as boolean )
    print "filter " & tkChip_GetText( hChip ) & ": " & iif( isSelected, "on", "off" )
end sub

' Lay a row of chips out left to right from (x, y), skipping destroyed ones.
private sub Row( chips() as TK_WIDGET ptr, byval x as long, byval y as long )
    for i as long = 0 to ubound( chips )
        if chips(i) = 0 then continue for
        dim as long iw, ih
        tkChip_GetIdealSize( chips(i), iw, ih )
        tkWidget_SetPos( chips(i), tkHost_Scale( gHost, x ), tkHost_Scale( gHost, y ), iw, ih )
        x += cint( iw / gHost->fScale ) + 4
    next
end sub

sub OnRemove( byval hChip as TK_WIDGET ptr )
    print "remove: " & tkChip_GetText( hChip )
    for i as long = 0 to 3
        if gPeople(i) = hChip then gPeople(i) = 0
    next
    tkWidget_Destroy( hChip )                    ' the host removes the chip
    Row( gPeople(), 20, 170 )
end sub

sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    dim as TKTHEME_COLORS t = tkTheme_Of( tkHost_Root( h ) )
    dim as ustring heads(0 to 4) = { "Action", "Filter (toggle)", "Input (Delete or the x removes)", "Count, status, outlined, small", "No widget (PaintInto)" }
    b->SetFont( gFont )
    b->SetColors( t.TextDim, t.Window )
    for i as long = 0 to 4
        dim as TKRECT rc
        tkRect_Set( rc, tkHost_Scale( h, 20 ), tkHost_Scale( h, 8 + i * 70 ), tkHost_Scale( h, 600 ), tkHost_Scale( h, 26 + i * 70 ) )
        b->PaintText( heads(i), @rc, TK_DT_LEFT or TK_DT_VCENTER )
    next
    dim as TKCHIP_SPEC s
    s.wszText = "drawn" : s.fText = gFont : s.fScale = h->fScale : s.nSize = TKCHIP_SMALL
    dim as TKRECT rc
    tkRect_Set( rc, tkHost_Scale( h, 20 ), tkHost_Scale( h, 312 ), tkHost_Scale( h, 200 ), tkHost_Scale( h, 340 ) )
    tkChip_PaintInto( b, rc, s )
    s.wszText = "selected" : s.bSelected = true
    tkRect_Set( rc, tkHost_Scale( h, 100 ), tkHost_Scale( h, 312 ), tkHost_Scale( h, 300 ), tkHost_Scale( h, 340 ) )
    tkChip_PaintInto( b, rc, s )
end sub

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

private sub SaveShot( byref path as string )
    tkHost_Render( gHost )
    tkHost_RenderTo( gHost, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( gHost->renderer, 0 )
    if s then
        SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & gHost->fScale
        SDL_DestroySurface( s )
    end if
end sub

private function NewChip( byref text as ustring, byval nKind as long ) as TK_WIDGET ptr
    dim as TK_WIDGET ptr c = tkChip_Create( tkHost_Root( gHost ), 0 )
    tkChip_SetText( c, text )
    tkChip_SetKind( c, nKind )
    tkChip_ApplyFonts( c, gFont, 0 )
    tkChip_SetClickCallback( c, @OnClick )
    tkChip_SetSelectedChangedCallback( c, @OnSel )
    tkChip_SetRemoveRequestedCallback( c, @OnRemove )
    return c
end function

' ---- main --------------------------------------------------------------------------------
if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
gHost = tkHost_Create( "tkChip on SDL3", 620, 350, tkHost_FontDir() & TK_FONT_UI, val( ArgValue( "--scale" ) ) )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
gHost->clrBack = tkTheme_Of( tkHost_Root( gHost ) ).Window
gFont = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 9 )

dim as TK_WIDGET ptr actions(0 to 2) = { NewChip( "Reply", TKCHIP_ACTION ), NewChip( "Forward", TKCHIP_ACTION ), NewChip( "Archive", TKCHIP_ACTION ) }
Row( actions(), 20, 30 )
dim as TK_WIDGET ptr filters(0 to 3) = { NewChip( "Unread", TKCHIP_TOGGLE ), NewChip( "Flagged", TKCHIP_TOGGLE ), _
                                         NewChip( "Attachments", TKCHIP_TOGGLE ), NewChip( "From me", TKCHIP_TOGGLE ) }
tkChip_SetSelected( filters(0), true ) : tkChip_SetSelected( filters(2), true )
Row( filters(), 20, 100 )
dim as ustring who(0 to 3) = { "Ada Lovelace", "Grace Hopper", "Alan Turing", "Ken Thompson" }
for i as long = 0 to 3
    gPeople(i) = NewChip( who(i), TKCHIP_INPUT )
    tkChip_SetLeadingAvatar( gPeople(i), who(i) )
next
Row( gPeople(), 20, 170 )
dim as TK_WIDGET ptr misc(0 to 3) = { NewChip( "Inbox", TKCHIP_ACTION ), NewChip( "Failing", TKCHIP_ACTION ), _
                                      NewChip( "Outlined", TKCHIP_TOGGLE ), NewChip( "Small", TKCHIP_TOGGLE ) }
tkChip_SetCount( misc(0), 12 )
tkChip_SetStatus( misc(1), TKBADGE_ERROR )
tkChip_SetAppearance( misc(2), TKCHIP_OUTLINED )
tkChip_SetSize( misc(3), TKCHIP_SMALL ) : tkChip_SetSelected( misc(3), true )
Row( misc(), 20, 240 )

gHost->OnPaint = @Form_Paint
tkHost_Show( gHost )
dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )
    SaveShot( shot )
else
    tkHost_Run( gHost )
end if
tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
