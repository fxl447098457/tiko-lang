' tkChip self-test (phase C0), one check per distinct behaviour. Real windows; two passes, scale
' pinned at 1.0 and 1.75. The anatomy against §7.1's formulas, the look by pixels, input through the
' real dispatch with events counted.
'
'   selftest            exit code = number of failures
#import "vendor/tkControls/tkChip"
#import "vendor/tkControls/tkTest"
using tkChip
using tkBadge
using tkTheme
using tkTest
using tkHost
using tkPaint

dim shared as long gClicks, gSel, gRemoves
dim shared as boolean gLastSel, gClaimUp
dim shared as TKRECT gPiRc
dim shared as TKCHIP_SPEC gPiSpec

function OnMsg( byval mi as TKCHIP_MESSAGEINFO ptr ) as boolean
    return gClaimUp andalso (mi->msg = TKM_LBUTTONUP)
end function
sub OnClick( byval hChip as TK_WIDGET ptr )
    gClicks += 1
end sub
sub OnSel( byval hChip as TK_WIDGET ptr, byval isSelected as boolean )
    gSel += 1 : gLastSel = isSelected
end sub
sub OnRemove( byval hChip as TK_WIDGET ptr )
    gRemoves += 1
end sub
sub Reset_( )
    gClicks = 0 : gSel = 0 : gRemoves = 0
end sub

function CanvasProc( byval w as TK_WIDGET ptr, byval m as TK_MSG ptr ) as boolean
    if m->msg <> TKM_PAINT then return false
    dim as TKRECT rc
    tkRect_Set( rc, 0, 0, w->cw, w->ch )
    m->pPaint->SetBackColor( tkTheme_Get().Window )
    m->pPaint->PaintRect( @rc )
    tkChip_PaintInto( m->pPaint, gPiRc, gPiSpec )
    return true
end function

function Px( byval h as TK_HOST ptr, byval w as TK_WIDGET ptr, byval x as long, byval y as long ) as ulong
    dim as TKRECT a
    tkWidget_AbsRect( w, a )
    return tkTest_PixelAt( h, a.left + x, a.top + y )
end function

function WX( byval w as TK_WIDGET ptr, byval x as long ) as long
    dim as TKRECT a
    tkWidget_AbsRect( w, a )
    return a.left + x
end function

function WY( byval w as TK_WIDGET ptr, byval y as long ) as long
    dim as TKRECT a
    tkWidget_AbsRect( w, a )
    return a.top + y
end function

sub Fit( byval c as TK_WIDGET ptr )
    dim as long iw, ih
    tkChip_GetIdealSize( c, iw, ih )
    tkWidget_SetSize( c, iw, ih )
end sub

sub RenderQuiet( byval h as TK_HOST ptr )
    tkHost_SetFocus( h, 0 )
    tkTest_PushMotion( h, 1, 1 )
    tkTest_PushWindowEvent( h, SDL_EVENT_WINDOW_MOUSE_LEAVE )
    tkHost_RenderTo( h, false )
end sub

' ==========================================================================================
sub RunPass( byval fScale as single )
    tkTest_Begin( "scale " & fScale )
    dim as TK_HOST ptr h = tkHost_Create( "tkChip selftest", 640, 400, tkHost_FontDir() & TK_FONT_UI, fScale )
    if h = 0 then tkTest_Check( "host created", false, *SDL_GetError() ) : exit sub
    dim as TK_WIDGET ptr root = tkHost_Root( h )
    tkHost_Show( h )
    tkTest_PumpFor( h, 50 )
    dim as TTF_Font ptr f = h->pDefaultFont
    dim as long rp = tkHost_Scale( h, 2 ) + 1

    ' ---- anatomy -------------------------------------------------------------------------------
    dim as TK_WIDGET ptr c = tkChip_Create( root, 1 )
    tkWidget_SetPos( c, tkHost_Scale( h, 20 ), tkHost_Scale( h, 20 ), 0, 0 )
    tkChip_SetText( c, "Design" )
    Fit( c )
    dim as TKCHIP_PARTS pt
    tkChip_GetParts( c, pt )
    dim as long tw = tkText_Width( f, "Design" ), hM = tkHost_Scale( h, 32 )
    tkTest_Check( "plain: 12 + label + 12, MEDIUM 32 high, the focus band round it", (pt.rcChip.right - pt.rcChip.left) = 2 * tkHost_Scale( h, 12 ) + tw _
                  andalso (pt.rcChip.bottom - pt.rcChip.top) = hM andalso c->cw = pt.rcChip.right - pt.rcChip.left + 2 * rp, tkRect_Str( pt.rcChip ) )
    tkChip_SetSize( c, TKCHIP_SMALL )
    tkChip_GetParts( c, pt )
    tkTest_Check( "SMALL: 24 high", (pt.rcChip.bottom - pt.rcChip.top) = tkHost_Scale( h, 24 ) )
    tkChip_SetSize( c, TKCHIP_MEDIUM )
    tkChip_SetLeadingAvatar( c, "Ann Lee" )
    Fit( c )
    tkChip_GetParts( c, pt )
    dim as long lead = hM - 2 * tkHost_Scale( h, 4 )
    tkTest_Check( "leading avatar: h - 8 square at 4 in, the label after a gap of 4", (pt.rcLeading.right - pt.rcLeading.left) = lead _
                  andalso pt.rcLeading.left = pt.rcChip.left + tkHost_Scale( h, 4 ) andalso pt.rcLabel.left = pt.rcLeading.right + tkHost_Scale( h, 4 ) )
    tkChip_ClearLeading( c )
    tkChip_SetKind( c, TKCHIP_INPUT )
    Fit( c )
    tkChip_GetParts( c, pt )
    dim as long mt = tkHost_Scale( h, 24 )
    tkTest_Check( "INPUT: removable; the remove target >= 24 across (or the chip's height), inside the chip", tkChip_GetRemovable( c ) _
                  andalso (pt.rcRemoveTarget.right - pt.rcRemoveTarget.left) >= mt andalso pt.rcRemoveTarget.top >= pt.rcChip.top _
                  andalso pt.rcRemoveTarget.right <= pt.rcChip.right, tkRect_Str( pt.rcRemoveTarget ) )
    tkChip_SetKind( c, TKCHIP_TOGGLE )
    tkChip_SetRemovable( c, false )
    Fit( c )
    dim as long w0 = c->cw
    tkChip_SetSelected( c, true )
    Fit( c )
    tkChip_GetParts( c, pt )
    tkTest_Check( "selected, no leading part: the check is inserted (the chip widens)", c->cw = w0 + lead + tkHost_Scale( h, 4 ) - tkHost_Scale( h, 8 ) _
                  andalso tkRect_IsEmpty( pt.rcCheck ) = false, c->cw & " vs " & w0 )
    tkChip_SetReserveCheck( c, true )
    tkChip_SetSelected( c, false )
    Fit( c )
    dim as long wR = c->cw
    tkChip_SetSelected( c, true )
    Fit( c )
    tkTest_Check( "ReserveCheck: the same width selected or not", c->cw = wR )
    tkChip_SetReserveCheck( c, false )
    tkChip_SetSelected( c, false )
    tkChip_SetText( c, "A rather long label that goes on well past the chip's maximum label width" )
    Fit( c )
    tkChip_GetParts( c, pt )
    tkTest_Check( "a long label is cut at MaxLabelWidth (200) and the tip shows it whole", pt.bLabelCut _
                  andalso (pt.rcLabel.right - pt.rcLabel.left) = tkHost_Scale( h, 200 ) andalso tkChip_GetTipText( c ) = tkChip_GetText( c ) )
    tkChip_SetText( c, "Design" )
    tkChip_SetCount( c, 12 )
    Fit( c )
    tkChip_GetParts( c, pt )
    tkTest_Check( "a count: a badge after the label", tkRect_IsEmpty( pt.rcCount ) = false andalso pt.rcCount.left >= pt.rcLabel.right )
    tkChip_SetCount( c, 0 )
    Fit( c )

    ' ---- the look, by pixels ----------------------------------------------------------------------
    dim as TKCHIP_COLORS cc
    tkChip_GetColors( c, @cc )
    tkChip_GetParts( c, pt )
    dim as long sx = pt.rcLabel.left - 2, sy = pt.rcChip.top + 3      ' inside the fill, clear of the text and border
    RenderQuiet( h )
    tkTest_Check( "FILLED: the fill", Px( h, c, sx, sy ) = cc.FillColor, hex( Px( h, c, sx, sy ) ) )
    tkChip_SetSelected( c, true )
    Fit( c )
    tkChip_GetParts( c, pt )
    RenderQuiet( h )
    tkTest_Check( "selected: the selected fill and the check", Px( h, c, pt.rcLabel.left - 2, sy ) = cc.FillColorSelected )
    tkChip_SetSelected( c, false )
    Fit( c )
    tkChip_GetParts( c, pt )
    tkChip_SetAppearance( c, TKCHIP_OUTLINED )
    RenderQuiet( h )
    tkTest_Check( "OUTLINED: the background inside a border", Px( h, c, sx, sy ) = cc.BackColor _
                  andalso Px( h, c, (pt.rcChip.left + pt.rcChip.right) \ 2, pt.rcChip.top ) = cc.BorderColor, _
                  hex( Px( h, c, sx, sy ) ) & " " & hex( Px( h, c, (pt.rcChip.left + pt.rcChip.right) \ 2, pt.rcChip.top ) ) )
    tkChip_SetAppearance( c, TKCHIP_FILLED )
    tkChip_SetStatus( c, TKBADGE_SUCCESS )
    RenderQuiet( h )
    dim as TKBADGE_COLORS bc = tkBadge_ThemeColors( tkTheme_Get() )
    tkTest_Check( "a status tints the fill (20 % of the status)", Px( h, c, sx, sy ) = tkColor_Lerp( cc.BackColor, bc.FillSuccess, 0.2 ) )
    tkChip_SetStatus( c, TKBADGE_NEUTRAL )
    tkHost_SetFocus( h, c )
    tkHost_RenderTo( h, false )
    tkTest_Check( "focused: a ring round the chip", Px( h, c, (pt.rcChip.left + pt.rcChip.right) \ 2, pt.rcChip.top - rp ) = cc.FocusRingColor )

    ' ---- input --------------------------------------------------------------------------------------
    tkChip_SetClickCallback( c, @OnClick )
    tkChip_SetSelectedChangedCallback( c, @OnSel )
    tkChip_SetRemoveRequestedCallback( c, @OnRemove )
    dim as long bx = (pt.rcLabel.left + pt.rcLabel.right) \ 2, by = (pt.rcChip.top + pt.rcChip.bottom) \ 2
    Reset_( )
    tkChip_SetSelected( c, true )
    tkChip_SetSelected( c, false )
    tkTest_Check( "setters are silent", gSel = 0 )
    tkTest_Click( h, WX( c, bx ), WY( c, by ) )
    tkTest_Check( "TOGGLE: a click selects, one SelectedChanged( true )", tkChip_GetSelected( c ) andalso gSel = 1 andalso gLastSel andalso gClicks = 0 )
    tkTest_PushButton( h, true, WX( c, bx ), WY( c, by ) )
    tkTest_PushMotion( h, WX( c, bx ), WY( c, by + tkHost_Scale( h, 60 ) ) )
    tkTest_PushButton( h, false, WX( c, bx ), WY( c, by + tkHost_Scale( h, 60 ) ) )
    tkTest_Check( "a press that slides off is cancelled, the capture freed", gSel = 1 andalso tkHost_GetCapture( h ) = 0 )
    tkHost_SetFocus( h, c )
    tkTest_PushKey( h, SDLK_SPACE )
    tkTest_Check( "Space toggles", tkChip_GetSelected( c ) = false andalso gSel = 2 )
    tkChip_SetKind( c, TKCHIP_ACTION )
    Reset_( )
    tkTest_Click( h, WX( c, bx ), WY( c, by ) )
    tkTest_PushKey( h, SDLK_RETURN )
    tkTest_Check( "ACTION: a click and Enter each fire Click", gClicks = 2 andalso gSel = 0 )
    tkTest_PushKey( h, SDLK_DELETE )
    tkTest_Check( "not removable: Delete does nothing", gRemoves = 0 )
    tkChip_SetKind( c, TKCHIP_INPUT )
    Fit( c )
    tkChip_GetParts( c, pt )
    Reset_( )
    tkTest_Click( h, WX( c, (pt.rcRemove.left + pt.rcRemove.right) \ 2 ), WY( c, (pt.rcRemove.top + pt.rcRemove.bottom) \ 2 ) )
    tkTest_Check( "a click on the remove button: RemoveRequested, not Click", gRemoves = 1 andalso gClicks = 0 )
    tkHost_SetFocus( h, c )
    tkTest_PushKey( h, SDLK_BACKSPACE )
    tkTest_Check( "Backspace on a removable chip: RemoveRequested", gRemoves = 2 )
    tkTest_Click( h, WX( c, bx ), WY( c, by ) )
    tkTest_Check( "INPUT body click: Click", gClicks = 1 )
    tkChip_SetEnabled( c, false )
    Reset_( )
    tkTest_Click( h, WX( c, bx ), WY( c, by ) )
    tkTest_Check( "disabled: no events", gClicks = 0 andalso gRemoves = 0 )
    tkChip_SetEnabled( c, true )
    tkChip_SetMessageCallback( c, @OnMsg )
    gClaimUp = true
    tkTest_Click( h, WX( c, bx ), WY( c, by ) )
    gClaimUp = false
    tkHost_SetFocus( h, c )
    tkTest_PushKey( h, SDLK_RETURN, SDL_KMOD_CTRL )
    tkTest_Check( "a claimed button-up is no click; Ctrl+Enter is not the chip's", gClicks = 0 )

    ' ---- theme, widgetless ---------------------------------------------------------------------
    tkTheme_Apply( tkTheme_Light() )
    tkChip_GetColors( c, @cc )
    tkTest_Check( "a theme change re-colours", cc.FillColor = tkTheme_Light().Surface )
    tkTheme_Apply( tkTheme_Dark() )
    dim as TK_WIDGET ptr cv = tkWidget_CreateChild( root, 3, @CanvasProc, 0 )
    tkWidget_SetPos( cv, tkHost_Scale( h, 20 ), tkHost_Scale( h, 200 ), tkHost_Scale( h, 300 ), tkHost_Scale( h, 40 ) )
    dim as TKCHIP_SPEC s0
    gPiSpec = s0
    gPiSpec.wszText = "Tag" : gPiSpec.fText = f : gPiSpec.fScale = h->fScale : gPiSpec.bSelected = true
    tkRect_Set( gPiRc, 0, 0, tkHost_Scale( h, 300 ), tkHost_Scale( h, 40 ) )
    tkHost_RenderTo( h, false )
    dim as TKCHIP_COLORS ct = tkChip_ThemeColors( tkTheme_Get() )
    dim as long pw, ph
    tkChip_MeasureSpec( gPiSpec, pw, ph )
    ' in the right padding (fill only), on the centre row
    dim as long qx = pw - tkHost_Scale( h, 6 ), qy = tkHost_Scale( h, 20 )
    tkTest_Check( "PaintInto: a selected chip in the theme's colours", Px( h, cv, qx, qy ) = ct.FillColorSelected, hex( Px( h, cv, qx, qy ) ) )

    tkHost_Destroy( h )
end sub

' ==========================================================================================
if tkTest_Init() = false then end 99
RunPass( 1.0 )
RunPass( 1.75 )
dim as long nFail = tkTest_Report( "tkChip" )
tkTest_Quit()
end nFail
