' tkRating demo (phases R0 + R1): seven rows, each a label, a rating and its value, and an eighth
' drawn with no widget at all (tkRating_PaintInto).
'
'   demo                     interactive; ValueChanged / HoverChanged are printed
'   demo --shot out.bmp      render once (row 0 focused), save the window, exit
'   demo --scale 1.75        pin the scale instead of asking the display
#import "vendor/tkControls/tkRating"
using tkRating
using tkTheme
using tkHost
using tkPaint

const as long ROWS = 7
const as long ROW_HEIGHT = 44, ROW_TOP = 14, MARGIN = 22, LABEL_W = 250, VALUE_W = 70, CAPTION_W = 110
const as long IDC_FIRST = 1000

dim shared as TK_HOST ptr gHost
dim shared as TK_WIDGET ptr gRt(0 to ROWS - 1)
dim shared as ustring gLabel(0 to ROWS - 1)
dim shared as TTF_Font ptr gFont

private function RowTop( byval i as long ) as long
    return tkHost_Scale( gHost, ROW_TOP ) + i * tkHost_Scale( gHost, ROW_HEIGHT )
end function

private function RowOf( byval w as TK_WIDGET ptr ) as long
    for i as long = 0 to ROWS - 1
        if w = gRt(i) then return i
    next
    return -1
end function

' v with one decimal when it has one (tiko has no format()).
private function Fmt( byval v as double ) as string
    if v < 0 then return "-"
    dim as long q = clng( v * 100 )
    if q mod 100 = 0 then return str( q \ 100 )
    if q mod 10 = 0 then return str( q \ 100 ) & "." & str( (q mod 100) \ 10 )
    return str( q \ 100 ) & "." & right( "0" & str( q mod 100 ), 2 )
end function

sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    dim as long pw, ph
    tkHost_PixelSize( h, pw, ph )
    dim as long m = tkHost_Scale( h, MARGIN ), rh = tkHost_Scale( h, ROW_HEIGHT )
    dim as TKTHEME_COLORS t = tkTheme_Of( tkHost_Root( h ) )
    b->SetFont( gFont )
    for i as long = 0 to ROWS - 1
        dim as long y = RowTop( i )
        dim as TKRECT rc
        tkRect_Set( rc, m, y, m + tkHost_Scale( h, LABEL_W ), y + rh )
        b->SetColors( t.Text, t.Window )
        b->PaintText( gLabel(i), @rc, TK_DT_LEFT or TK_DT_VCENTER )
        tkRect_Set( rc, pw - m - tkHost_Scale( h, VALUE_W ), y, pw - m, y + rh )
        dim as double hv = tkRating_GetHoverValue( gRt(i) )
        b->SetColors( iif( hv >= 0, t.TextDim, t.TextStrong ), t.Window )
        b->PaintText( Fmt( iif( hv >= 0, hv, tkRating_GetValue( gRt(i) ) ) ), @rc, TK_DT_RIGHT or TK_DT_VCENTER )
        tkRect_Set( rc, m, y + rh - 1, pw - m, y + rh )
        b->SetBackColor( t.Divider )
        b->PaintRect( @rc )
    next
    ' the eighth row: a rating with no widget, as a grid cell would draw it
    dim as long y = RowTop( ROWS )
    dim as TKRECT rc
    tkRect_Set( rc, m, y, m + tkHost_Scale( h, LABEL_W ), y + rh )
    b->SetColors( t.Text, t.Window )
    b->PaintText( "No widget   (tkRating_PaintInto, 2.6)", @rc, TK_DT_LEFT or TK_DT_VCENTER )
    dim as TKRATING_DRAWSPEC spec
    spec.nItemSize = tkHost_Scale( h, 16 )
    spec.nSpacing = tkHost_Scale( h, 3 )
    dim as long l = m + tkHost_Scale( h, LABEL_W ) + tkHost_Scale( h, 3 )
    tkRect_Set( rc, l, y, l + tkHost_Scale( h, 120 ), y + rh )
    tkRating_PaintInto( b, rc, 2.6, 5, @spec )
end sub

sub Form_Size( byval h as TK_HOST ptr )
    dim as long m = tkHost_Scale( h, MARGIN ), rh = tkHost_Scale( h, ROW_HEIGHT )
    dim as long l = m + tkHost_Scale( h, LABEL_W )
    for i as long = 0 to ROWS - 1
        dim as long iw, ih
        tkRating_GetIdealSize( gRt(i), iw, ih )
        ' room for the longest caption, so it does not change the width as it changes
        if (len( tkRating_GetCaptionText( gRt(i) ) ) > 0) orelse (i = 0) then iw += tkHost_Scale( h, CAPTION_W )
        tkWidget_SetPos( gRt(i), l, RowTop( i ) + (rh - ih) \ 2, iw, ih )
    next
end sub

' Row 0's caption: a word for the value, or for the preview while there is one.
function Words( byval hRating as TK_WIDGET ptr, byval nValue as double, byval nHover as double ) as ustring
    dim as double v = iif( nHover >= 0, nHover, nValue )
    select case cint( v )
    case 1 : return "Poor"
    case 2 : return "Fair"
    case 3 : return "Good"
    case 4 : return "Very good"
    case 5 : return "Excellent"
    end select
    return "Not rated"
end function

sub Demo_Changed( byval hRating as TK_WIDGET ptr, byval nValue as double )
    print "changed  row=" & RowOf( hRating ) & "  value=" & Fmt( nValue )
    tkHost_Invalidate( gHost )                    ' the value column
end sub

sub Demo_Hover( byval hRating as TK_WIDGET ptr, byval nHover as double )
    print "hover    row=" & RowOf( hRating ) & "  preview=" & Fmt( nHover )
    tkHost_Invalidate( gHost )
end sub

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

private sub SaveShot( byref path as string )
    tkHost_Render( gHost )
    tkHost_RenderTo( gHost, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( gHost->renderer, 0 )
    if s then
        SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & gHost->fScale
        SDL_DestroySurface( s )
    end if
end sub

' ---- main --------------------------------------------------------------------------------
if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1

dim as single forced = val( ArgValue( "--scale" ) )
gHost = tkHost_Create( "tkRating on SDL3", 720, 380, tkHost_FontDir() & TK_FONT_UI, forced )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
gHost->clrBack = tkTheme_Of( tkHost_Root( gHost ) ).Window
gFont = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 10 )
if gFont = 0 then print "fonts: " & *SDL_GetError() : end 1

gLabel(0) = "Service   (whole, hover words)"
gLabel(1) = "Food   (half stars)"
gLabel(2) = "Average   (read-only, 4.27)"
gLabel(3) = "Score   (ten items, no clearing)"
gLabel(4) = "Favourite   (hearts, large)"
gLabel(5) = "Yours   (unrated; others 3.6)"
gLabel(6) = "Disabled   (custom colours)"

for i as long = 0 to ROWS - 1
    gRt(i) = tkRating_Create( tkHost_Root( gHost ), IDC_FIRST + i )
    tkRating_SetValueChangedCallback( gRt(i), @Demo_Changed )
    tkRating_SetHoverChangedCallback( gRt(i), @Demo_Hover )
next

tkRating_SetValue( gRt(0), 4 )
tkRating_SetFormatCaptionCallback( gRt(0), @Words )
for k as long = 0 to 4
    tkRating_SetItemTooltip( gRt(0), k, Words( 0, k + 1, -1 ) )
next

tkRating_SetPrecision( gRt(1), TKRATING_HALF )
tkRating_SetValue( gRt(1), 3.5 )

tkRating_SetPrecision( gRt(2), TKRATING_TENTH )
tkRating_SetValue( gRt(2), 4.27 )
tkRating_SetReadOnly( gRt(2), true )
tkRating_SetCaption( gRt(2), "(1,234 reviews)" )

tkRating_SetItemCount( gRt(3), 10 )
tkRating_SetItemSize( gRt(3), tkHost_Scale( gHost, 16 ) )
tkRating_SetItemSpacing( gRt(3), tkHost_Scale( gHost, 2 ) )
tkRating_SetAllowClear( gRt(3), false )
tkRating_SetValue( gRt(3), 7 )

tkRating_SetShape( gRt(4), TKRATING_HEART )
tkRating_SetSize( gRt(4), TKRATING_SIZE_LARGE )
tkRating_SetValue( gRt(4), 3 )

tkRating_SetPlaceholderValue( gRt(5), 3.6 )
tkRating_SetPrecision( gRt(5), TKRATING_HALF )

dim as TKRATING_COLORS c
tkRating_GetColors( gRt(6), @c )
c.FillColor = tkRGB( 224, 108, 117 ) : c.FillColorHot = tkRGB( 236, 140, 148 ) : c.FillColorDisabled = tkRGB( 120, 70, 76 )
tkRating_SetColors( gRt(6), @c )
tkRating_SetShape( gRt(6), TKRATING_DIAMOND )
tkRating_SetValue( gRt(6), 2 )
tkRating_SetEnabled( gRt(6), false )

gHost->OnPaint = @Form_Paint
gHost->OnSize = @Form_Size
Form_Size( gHost )
tkHost_SetFocus( gHost, gRt(0) )
tkHost_Show( gHost )

dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )
    SaveShot( shot )
else
    tkHost_Run( gHost )
end if

tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
