format = 1

[form]
caption = "Designed \"Form\""
width = 480
height = 320

[form.events]
Load = "Form_Load"
Close = "Form_Close"

[[control]]
name = "pnlTop"
type = "Panel"
parent = ""
x = 0
y = 0
w = 480
h = 40
dock = "top"

[[control]]
name = "lblTitle"
type = "Label"
parent = "pnlTop"
x = 8
y = 8
w = 200
h = 24

[control.props]
Text = "Title"
Font = "UI_BOLD"

[[control]]
name = "btnAdd"
type = "Button"
parent = "pnlTop"
x = 384
y = 6
w = 88
h = 28
anchor = "top right"

[control.props]
Text = "Add"
TextAlign = "Center"

[control.events]
Click = "btnAdd_Click"

[[control]]
name = "pnlLeft"
type = "Panel"
parent = ""
x = 0
y = 0
w = 120
h = 200
dock = "left"

[[control]]
name = "chkOn"
type = "CheckBox"
parent = "pnlLeft"
x = 8
y = 8
w = 104
h = 24

[control.props]
Text = "On"

[control.events]
CheckChanged = "chkOn_CheckChanged"

[[control]]
name = "tabMain"
type = "TabControl"
parent = ""
x = 0
y = 0
w = 200
h = 200
dock = "fill"
pages = ["Alpha", "Beta"]

[[control]]
name = "txtName"
type = "TextBox"
parent = "tabMain"
page = 0
x = 8
y = 8
w = 340
h = 28
anchor = "left top right"

[control.props]
Multiline = false
Text = "Ada"

[[control]]
name = "scpList"
type = "ScrollPanel"
parent = "tabMain"
page = 0
x = 8
y = 44
w = 340
h = 200
anchor = "left top right bottom"

[[control]]
name = "lblInScroll"
type = "Label"
parent = "scpList"
x = 8
y = 8
w = 100
h = 24

[control.props]
Text = "scrolled"

[[control]]
name = "grpBox"
type = "GroupBox"
parent = "tabMain"
page = 1
x = 8
y = 8
w = 340
h = 240
anchor = "left top right bottom"

[control.props]
Text = "Group"

[[control]]
name = "btnInner"
type = "Button"
parent = "grpBox"
x = 240
y = 200
w = 88
h = 28
anchor = "right bottom"

[control.props]
Enabled = false
Text = "Inner"
