' The half of the form you write. The other half is frmSample.design.tiko, generated from the
' .tkform; both are the one module, and the partial type joins them.
#module "frmSample"

public partial type Form
    Clicks as long
    Loaded as boolean
    LastChecked as boolean
    RefuseClose as boolean
    CloseAsked as long
end type

sub Form.Form_Load( )
    Loaded = true
    lblTitle.Text = "Loaded"
end sub

sub Form.Form_Close( byref Cancel as boolean )
    CloseAsked += 1
    Cancel = RefuseClose
end sub

sub Form.btnAdd_Click( )
    Clicks += 1
    lblTitle.Text = txtName.Text & " " & Clicks
end sub

sub Form.chkOn_CheckChanged( byval isChecked as boolean )
    LastChecked = isChecked
end sub
