' Menus, a toolbar, a status bar, list columns and combo items, as the designer's editor writes them.
#module "frmItems"

public partial type Form
    Opened as long
    Went as long
    Recent as long
end type

sub Form.OnOpen( )
    Opened += 1
end sub

sub Form.OnRecent( )
    Recent += 1
end sub

sub Form.OnGo( )
    Went += 1
end sub
