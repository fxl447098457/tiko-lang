' tkDesigned self-test: the Milestone A check. frmSample was written as a .tkform and generated by
' tkEdit --generate-forms; this drives it through real events and asserts where things land.
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkButton"
#import "vendor/tkControls/tkTabControl"
#import "vendor/tkControls/tkScrollPanel"
#import "vendor/tkControls/tkMenuBar"
#import "vendor/tkControls/tkToolbar"
#import "vendor/tkControls/tkStatusBar"
#import "vendor/tkControls/tkListTree"
#import "vendor/tkControls/tkComboBox"
#import "vendor/tkControls/tkPopupMenu"
#import "vendor/tkControls/tkForms"
#import "./appTheme"
#import "./frmSample"
#import "./frmItems"
using tkApp
using tkButton
using tkTabControl
using tkScrollPanel
using tkMenuBar
using tkToolbar
using tkStatusBar
using tkListTree
using tkComboBox
using tkPopupMenu
using tkForms
using tkTheme
using tkHost
using tkPaint
using tkTest

sub ClickOn( byval h as TK_HOST ptr, byval w as TK_WIDGET ptr )
    tkTest_PushMotion( h, tkTest_CX( w ), tkTest_CY( w ) )
    tkTest_PumpFor( h, 20 )
    tkTest_Click( h, tkTest_CX( w ), tkTest_CY( w ) )
    tkTest_PumpFor( h, 40 )
end sub

sub Designed( byval owner as TK_FORM ptr )
    tkTest_Begin( "a generated form" )
    dim as frmSample.Form f
    f.Build( owner )
    tkTest_Check( "Build opened the window", f.IsOpen( ) )
    tkTest_Check( "Load ran at the end of Build", f.Loaded )
    tkTest_Check( "Load's handler used a control", f.lblTitle.Text = "Loaded", f.lblTitle.Text )
    dim as TK_HOST ptr h = tkForm_Host( f.Wnd )
    f.Show( )
    tkTest_PumpFor( h, 80 )

    tkTest_Check( "the caption's quotes survived", *SDL_GetWindowTitle( h->win ) = "Designed ""Form""", *SDL_GetWindowTitle( h->win ) )
    tkTest_Check( "text property", f.btnAdd.Text = "Add", f.btnAdd.Text )
    tkTest_Check( "enum property", tkButton_GetTextAlign( f.btnAdd.Handle ) = BTN_ALIGN_CENTER )
    tkTest_Check( "common property", f.btnInner.Enabled = false )
    tkTest_Check( "font property", f.lblTitle.Font = tkForm_Font( f.Wnd, TKFONT_UI_BOLD ) )
    tkTest_Check( "tab pages", tkTabControl_GetPageCount( f.tabMain.Handle ) = 2 )
    tkTest_Check( "ids follow the list", f.tabMain.Handle->ctrlId = 6, str( f.tabMain.Handle->ctrlId ) )

    ' Docks: top strip across, left strip below it, the tabs fill the rest.
    dim as long cw = h->root->cw, ch = h->root->ch
    tkTest_Check( "dock top spans the window", (f.pnlTop.Handle->cw = cw) andalso (f.pnlTop.Handle->ch = tkForm_Scale( f.Wnd, 40 )), f.pnlTop.Handle->cw & "," & f.pnlTop.Handle->ch )
    tkTest_Check( "dock left starts below it", f.pnlLeft.Handle->y = tkForm_Scale( f.Wnd, 40 ), str( f.pnlLeft.Handle->y ) )
    tkTest_Check( "dock fill takes the rest", f.tabMain.Handle->cw = cw - tkForm_Scale( f.Wnd, 120 ), str( f.tabMain.Handle->cw ) )
    ' 480 wide less 120 is 360 of tab control; the file's 340 box starts at 8, so the gap is 12.
    dim as long gapBox = tkForm_Scale( f.Wnd, 12 )
    dim as TK_WIDGET ptr page0 = tkTabControl_GetPage( f.tabMain.Handle, 0 )
    tkTest_Check( "a page child starts as designed", page0->cw - (f.txtName.Handle->x + f.txtName.Handle->cw) = gapBox, f.txtName.Handle->cw & " of " & page0->cw )

    ' Grow the window: anchors at every depth follow.
    dim as long gapList = page0->ch - (f.scpList.Handle->y + f.scpList.Handle->ch), page0Was = page0->ch
    dim as long grow = tkForm_Scale( f.Wnd, 100 )
    SDL_SetWindowSize( h->win, cw + grow, ch + grow )
    SDL_SyncWindow( h->win )
    tkTest_PumpFor( h, 200 )
    cw = h->root->cw : ch = h->root->ch
    tkTest_Check( "dock top follows", f.pnlTop.Handle->cw = cw, str( f.pnlTop.Handle->cw ) )
    tkTest_Check( "right-anchored in a docked panel", f.pnlTop.Handle->cw - (f.btnAdd.Handle->x + f.btnAdd.Handle->cw) = tkForm_Scale( f.Wnd, 8 ), str( f.btnAdd.Handle->x ) )
    tkTest_Check( "fill grew", f.tabMain.Handle->cw = cw - tkForm_Scale( f.Wnd, 120 ), str( f.tabMain.Handle->cw ) )
    tkTest_Check( "a text box on a page stretched", page0->cw - (f.txtName.Handle->x + f.txtName.Handle->cw) = gapBox, f.txtName.Handle->cw & " of " & page0->cw )
    tkTest_Check( "a scroll panel stretched both ways", (f.scpList.Handle->cw = f.txtName.Handle->cw) andalso (page0->ch - (f.scpList.Handle->y + f.scpList.Handle->ch) = gapList) andalso (page0->ch > page0Was), f.scpList.Handle->cw & "," & f.scpList.Handle->ch & " page " & page0->ch )

    ' The other page: a group box stretches and its child keeps the corner.
    tkTabControl_SetCurSel( f.tabMain.Handle, 1 )
    tkTest_PumpFor( h, 60 )
    dim as TK_WIDGET ptr page1 = tkTabControl_GetPage( f.tabMain.Handle, 1 )
    tkTest_Check( "a group box on the second page stretched", page1->cw - (f.grpBox.Handle->x + f.grpBox.Handle->cw) = gapBox, f.grpBox.Handle->cw & " of " & page1->cw )
    tkTest_Check( "a child in the group box keeps its corner", f.grpBox.Handle->cw - (f.btnInner.Handle->x + f.btnInner.Handle->cw) = tkForm_Scale( f.Wnd, 12 ), f.btnInner.Handle->x & " in " & f.grpBox.Handle->cw )
    tkTabControl_SetCurSel( f.tabMain.Handle, 0 )
    tkTest_PumpFor( h, 60 )

    ' Events reach the handlers in the user's half of the form.
    ClickOn( h, f.btnAdd.Handle )
    tkTest_Check( "the click ran the user's handler", f.Clicks = 1, str( f.Clicks ) )
    tkTest_Check( "the handler read and wrote wrappers", f.lblTitle.Text = "Ada 1", f.lblTitle.Text )
    ClickOn( h, f.chkOn.Handle )
    tkTest_Check( "a handler gets the event's values", f.LastChecked )

    ' The close button asks Form_Close, which can refuse.
    f.RefuseClose = true
    tkTest_PushWindowEvent( h, SDL_EVENT_WINDOW_CLOSE_REQUESTED )
    tkTest_PumpFor( h, 40 )
    tkApp_Pump( )
    tkTest_Check( "Close was asked", f.CloseAsked = 1, str( f.CloseAsked ) )
    tkTest_Check( "Cancel kept it open", f.IsOpen( ) )
    f.RefuseClose = false
    tkTest_PushWindowEvent( h, SDL_EVENT_WINDOW_CLOSE_REQUESTED )
    tkTest_PumpFor( h, 40 )
    tkApp_Pump( )
    tkTest_Check( "no Cancel and it closes", f.IsOpen( ) = false )
end sub

' Milestone D (docs/tkDesigner/THEMES.md): the project's appTheme, installed by main as a new project's
' main does, and frmSample's [control.colors] on btnAdd -- style Danger, a white ForeColor in dark,
' a pink one in light. appTheme gives every Button BorderColor = @Border and a corner radius of 3.
sub Themed( byval owner as TK_FORM ptr )
    tkTest_Begin( "the project theme" )
    dim as frmSample.Form f
    f.Build( owner )
    f.Show( )
    dim as TK_HOST ptr h = tkForm_Host( f.Wnd )
    tkTest_PumpFor( h, 60 )
    dim as TKBUTTON_COLORS c

    tkApp_SetThemeMode( TKAPP_THEME_DARK )
    tkTest_Check( "the theme's accent is derived into the dark variant", (tkApp_Theme( ).Accent = appTheme.Dark( ).Accent) _
        andalso (appTheme.Dark( ).Accent <> tkTheme_Dark( ).Accent) )
    tkButton_GetColors( f.btnAdd.Handle, @c )
    tkTest_Check( "dark: btnAdd wears Danger -- its face is the theme's Error", c.BackColor = tkTheme_Dark( ).Error, hex( c.BackColor ) )
    tkTest_Check( "dark: its ForeColor is the dark one", c.ForeColor = &hFFFFFFFFul, hex( c.ForeColor ) )
    ' Danger's hot face shades its face toward Danger's own Text (SelectedText), as a style's derived roles do
    dim as TKTHEME_COLORS styled = appTheme.Dark( )
    styled.Text = styled.SelectedText
    tkTest_Check( "dark: its hot face follows Danger's face", c.BackColorHot = tkTheme_DeriveColor( TKDERIVE_HOT, tkTheme_Dark( ).Error, styled ), hex( c.BackColorHot ) )
    tkButton_GetColors( f.btnInner.Handle, @c )
    tkTest_Check( "dark: every Button's border is the theme's Border", c.BorderColor = appTheme.Dark( ).Border, hex( c.BorderColor ) )
    tkTest_Check( "the theme's corner radius: 3, a curvature of 6 design units", _
        tkButton_GetCornerCurvature( f.btnInner.Handle ) = tkForm_Scale( f.Wnd, 6 ), str( tkButton_GetCornerCurvature( f.btnInner.Handle ) ) )

    tkApp_SetThemeMode( TKAPP_THEME_LIGHT )
    tkTest_PumpFor( h, 30 )
    tkButton_GetColors( f.btnAdd.Handle, @c )
    tkTest_Check( "light: the same button, the light Error", c.BackColor = tkTheme_Light( ).Error, hex( c.BackColor ) )
    tkTest_Check( "light: its ForeColor is the light one", c.ForeColor = &hFFFFF0F0ul, hex( c.ForeColor ) )
    tkButton_GetColors( f.btnInner.Handle, @c )
    tkTest_Check( "light: the light Border", c.BorderColor = appTheme.Light( ).Border, hex( c.BorderColor ) )
    ' what reaches the screen: a point of btnAdd's face, inside its rounded corner, clear of the text
    tkHost_RenderTo( h, false )
    dim as TK_WIDGET ptr b = f.btnAdd.Handle
    dim as TKRECT a
    tkWidget_AbsRect( b, a )
    dim as ulong px = tkTest_PixelAt( h, a.left + tkForm_Scale( f.Wnd, 8 ), a.top + b->ch \ 2 )
    tkTest_Check( "light: the face drawn is the light Error", (px and &hFFFFFFul) = (tkTheme_Light( ).Error and &hFFFFFFul), hex( px ) )

    tkApp_SetThemeMode( TKAPP_THEME_SYSTEM )
    dim as TKTHEME_COLORS want = iif( tkTheme_SystemIsDark( ), appTheme.Dark( ), appTheme.Light( ) )
    tkTest_Check( "SYSTEM picks the variant the OS asks for", tkTheme_Equal( tkApp_Theme( ), want ) )

    tkTest_PushWindowEvent( h, SDL_EVENT_WINDOW_CLOSE_REQUESTED )
    tkTest_PumpFor( h, 40 )
    tkApp_Pump( )
end sub

function Tagged( byref key as const ustring, byref text as const ustring ) as ustring
    return "[" & key & "]" & text
end function

sub ClickMenuRow( byval m as TK_MENU ptr, byval idx as long )
    dim as TKRECT rc
    tkPopupMenu_GetItemRect( m, idx, rc )
    tkTest_Click( tkPopupMenu_Surface( m ), (rc.left + rc.right) / 2, (rc.top + rc.bottom) / 2 )
end sub

sub Items( byval owner as TK_FORM ptr )
    tkTest_Begin( "menus, toolbar, status bar, columns, combo items" )
    dim as frmItems.Form f
    tkForms_SetTranslator( @Tagged )
    f.Build( owner )
    tkForms_SetTranslator( 0 )
    dim as TK_HOST ptr h = tkForm_Host( f.Wnd )
    f.Show( )
    tkTest_PumpFor( h, 100 )

    tkTest_Check( "a translated caption", tkMenuBar_GetItemText( f.mnuMain.Handle, 0 ) = "[frmItems.mnuMain.0]File", tkMenuBar_GetItemText( f.mnuMain.Handle, 0 ) )
    tkTest_Check( "two menus on the bar", tkMenuBar_GetItemCount( f.mnuMain.Handle ) = 2, str( tkMenuBar_GetItemCount( f.mnuMain.Handle ) ) )
    dim as TK_MENU ptr mFile = tkMenuBar_GetDropDown( f.mnuMain.Handle, 0 )
    tkTest_Check( "File has its drop-down", mFile <> 0 )
    tkTest_Check( "Help has none", tkMenuBar_GetDropDown( f.mnuMain.Handle, 1 ) = 0 )
    tkTest_Check( "three rows, the separator too", tkPopupMenu_GetItemCount( mFile ) = 3, str( tkPopupMenu_GetItemCount( mFile ) ) )
    tkTest_Check( "a submenu", tkPopupMenu_GetItemSubMenu( mFile, 1003 ) <> 0 )
    tkTest_Check( "three toolbar items", tkToolbar_GetCount( f.tbMain.Handle ) = 3 )
    tkTest_Check( "two status panels", tkStatusBar_GetCount( f.sbMain.Handle ) = 2 )
    tkTest_Check( "two columns", tkListTree_GetColumnCount( f.lstMain.Handle ) = 2 )
    tkTest_Check( "three combo items", tkComboBox_GetCount( f.cboMain.Handle ) = 3 )
    tkTest_Check( "the menu bar docked top", f.mnuMain.Handle->y = 0 )
    tkTest_Check( "the toolbar below it", f.tbMain.Handle->y = f.mnuMain.Handle->ch, str( f.tbMain.Handle->y ) )
    tkTest_Check( "the status bar at the bottom", f.sbMain.Handle->y + f.sbMain.Handle->ch = h->root->ch )

    ' a toolbar button, clicked
    dim as TKRECT rc
    tkToolbar_GetItemRect( f.tbMain.Handle, 0, rc )
    dim as single x = f.tbMain.Handle->x + (rc.left + rc.right) / 2, y = f.tbMain.Handle->y + (rc.top + rc.bottom) / 2
    tkTest_PushMotion( h, x, y )
    tkTest_PumpFor( h, 30 )
    tkTest_Click( h, x, y )
    tkTest_PumpFor( h, 40 )
    tkTest_Check( "a toolbar button reaches its handler", f.Went = 1, str( f.Went ) )

    ' the menu, opened and clicked
    dim as TKRECT mr
    tkMenuBar_GetItemRect( f.mnuMain.Handle, 0, mr )
    tkTest_Click( h, f.mnuMain.Handle->x + (mr.left + mr.right) / 2, f.mnuMain.Handle->y + f.mnuMain.Handle->ch / 2 )
    tkTest_PumpFor( h, 150 )
    tkTest_Check( "the menu opens", tkPopupMenu_IsOpen( mFile ) )
    if tkPopupMenu_IsOpen( mFile ) then
        ClickMenuRow( mFile, 0 )
        tkTest_PumpFor( h, 100 )
    end if
    tkTest_Check( "a menu item reaches its handler", f.Opened = 1, str( f.Opened ) )

    ' its shortcut, through the real key path
    tkTest_PushKey( h, SDLK_O, TK_KMOD_PRIMARY, true, SDL_SCANCODE_O )
    tkTest_PushKey( h, SDLK_O, TK_KMOD_PRIMARY, false, SDL_SCANCODE_O )
    tkTest_PumpFor( h, 40 )
    tkTest_Check( "its shortcut does too", f.Opened = 2, str( f.Opened ) )
end sub

dim as TKAPP_OPTIONS opts
appTheme.ApplyOptions( opts )
if tkApp_Init( opts ) = false then
    print "tkApp_Init failed"
    end 98
end if
appTheme.Install( )
dim as TK_FORM ptr mainForm = tkApp_NewForm( "owner", 200, 120, 0, 1.0 )
tkForm_Show( mainForm )
tkTest_PumpFor( tkForm_Host( mainForm ), 50 )
Designed( mainForm )
Items( mainForm )
Themed( mainForm )
dim as long nFail = tkTest_Report( "tkDesigned" )
tkApp_Shutdown( )
end nFail
