' tkReportViewer demo (printing phase R3): a 12-page document in the viewer -- Print, Page setup and
' PDF on the toolbar, page navigation, zoom, the status bar. The pages are made while shown.
'
'   demo                     interactive
'   demo --shot x.png        render once (all pages made) and save
'   demo --scale 1.75        pin the scale
#import "vendor/tkControls/tkReportViewer"
using tkReportViewer
using tkPrintPreview
using tkPrint
using tkHost
using tkPaint

dim shared as TK_HOST ptr gHost
dim shared as TK_WIDGET ptr gRv

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 32
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

function DemoPage( byval doc as TK_PRINTDOC ptr, byval pg as TK_PAGE ptr, byval i as long ) as boolean
    dim as TKRECTF m, r
    tkPage_GetMarginRect( pg, m )
    dim as TKFONTSPEC fs
    fs.pt = 18 : fs.bold = true
    tkPage_SetFont( pg, fs )
    tkRectF_Set( r, m.left, m.top, m.right, m.top + 28 )
    tkPage_Text( pg, "Section " & (i + 1), r, TK_DT_LEFT )
    fs.pt = 10 : fs.bold = false
    tkPage_SetFont( pg, fs )
    for k as long = 0 to 19
        tkPage_SetFillColor( pg, iif( k mod 2, tkRGB( 245, 247, 250 ), tkRGB( 255, 255, 255 ) ) )
        tkRectF_Set( r, m.left, m.top + 40 + k * 18, m.right, m.top + 58 + k * 18 )
        tkPage_FillRect( pg, r )
        tkRectF_Set( r, m.left + 4, m.top + 40 + k * 18, m.right - 4, m.top + 58 + k * 18 )
        tkPage_Text( pg, "Row " & (k + 1) & " of section " & (i + 1), r, TK_DT_LEFT )
        tkPage_Text( pg, str( (i * 20 + k) * 37 mod 1000 ), r, TK_DT_RIGHT )
    next
    fs.pt = 8
    tkPage_SetFont( pg, fs )
    tkRectF_Set( r, m.left, m.bottom - 14, m.right, m.bottom )
    tkPage_LateText( pg, r, "Page {p} of {n}", TK_DT_RIGHT )
    return i < 11
end function

sub Form_Size( byval h as TK_HOST ptr )
    dim as long pw, ph
    tkHost_PixelSize( h, pw, ph )
    tkWidget_SetPos( gRv, 0, 0, pw, ph )
end sub

if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
gHost = tkHost_Create( "tkReportViewer R3 demo", 1000, 900, tkHost_FontDir() & TK_FONT_UI, val( ArgValue( "--scale" ) ) )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
dim as TK_PRINTDOC ptr doc = tkPrintDoc_Create( "Report viewer demo" )
tkPrintDoc_SetPrintPageCallback( doc, @DemoPage )
tkPrintDoc_BeginGenerate( doc )
gRv = tkReportViewer_Create( tkHost_Root( gHost ), 1 )
tkReportViewer_SetDocument( gRv, doc )
gHost->OnSize = @Form_Size
Form_Size( gHost )
tkHost_Show( gHost )
dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    dim as Uint64 t0 = SDL_GetTicks()
    while (tkPrintDoc_IsComplete( doc ) = false) andalso (SDL_GetTicks() - t0 < 10000)
        tkHost_Pump( gHost )
        SDL_Delay( 5 )
    wend
    tkReportViewer_Refresh( gRv )
    tkHost_RenderTo( gHost, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( gHost->renderer, 0 )
    if s then IMG_SavePNG( s, strptr( shot ) ) : SDL_DestroySurface( s )
else
    tkHost_Run( gHost )
end if
tkHost_Destroy( gHost )
tkPrintDoc_Destroy( doc )
TTF_Quit()
SDL_Quit()
