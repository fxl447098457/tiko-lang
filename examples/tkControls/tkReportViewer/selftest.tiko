' tkReportViewer self-test (printing phases R3, R5). One check per behaviour: the layout (toolbar, preview,
' status bar), the status and page box from the document, Next, the page box's Enter, zoom in, hiding
' the toolbar, PDF export with Exported, and (Windows) a print with no dialog to "Microsoft Print to
' PDF" with AfterPrint. R5, its own report: the made table (captions, values by their field's kind,
' inside the margins), RefreshReport after new rows, and BuildReport in place of the made table. A
' document the preview generates on its timer: the status follows it with no page move.
' And a designed form (frmOrders, generated by the Form Designer): its <name>_Fill( ) from an Array,
' and its BuildReport handler. One pass.
'
'   selftest            exit code = number of failures
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkReportViewer"
#import "vendor/tkControls/tkToolbar"
#import "vendor/tkControls/tkStatusBar"
#import "vendor/tkControls/tkTextBox"
#import "vendor/tkControls/tkApp"
#import "./frmOrders"
using tkTest
using tkReportViewer
using tkToolbar
using tkStatusBar
using tkTextBox
using tkApp
using tkPrintPreview
using tkPrintDialog
using tkPrinter
using tkPdf
using tkReport
using tkBind
using tkPrint
using tkHost
using tkPaint

dim shared as long gExported, gAfter
dim shared as boolean gAfterOk

sub OnExported( byval h as TK_WIDGET ptr, byref path as ustring, byval bOk as boolean )
    gExported += 1
end sub

sub OnAfter( byval h as TK_WIDGET ptr, byval bOk as boolean )
    gAfter += 1 : gAfterOk = bOk
end sub

function ThreePages( byval doc as TK_PRINTDOC ptr, byval pg as TK_PAGE ptr, byval i as long ) as boolean
    dim as TKRECTF r
    tkRectF_Set( r, 72, 72, 400, 110 )
    dim as TKFONTSPEC fs
    fs.pt = 20
    tkPage_SetFont( pg, fs )
    tkPage_Text( pg, "Viewer page " & (i + 1), r, TK_DT_LEFT )
    return i < 2
end function

' What a designed form's fill does: an element's fields through tkBind_ToValue, by their own types.
type FRUIT
    name  as ustring
    qty   as long
    price as double
    paid  as boolean
end type

dim shared as long gBuilt

sub BuildFruit( byval h as TK_WIDGET ptr, byval rpt as TK_REPORT ptr )
    gBuilt += 1
    dim as TKRECTF rc
    tkRectF_Set( rc, 0, 0, 300, 16 )
    tkRBand_AddField( tkReport_GetBand( rpt, TKRB_DETAIL ), rc, tkReport_FindField( rpt, "Qty" ), "0 kg" )
end sub

sub FillFruit( byval rv as TK_WIDGET ptr, a() as FRUIT )
    tkReportViewer_ClearRows( rv )
    for i as long = lbound( a ) to ubound( a )
        dim as integer r = tkReportViewer_AddRow( rv )
        tkBind_ToValue( a(i).name, tkReportViewer_Cell( rv, r, 0 ) )
        tkBind_ToValue( a(i).qty, tkReportViewer_Cell( rv, r, 1 ) )
        tkBind_ToValue( a(i).price, tkReportViewer_Cell( rv, r, 2 ) )
        tkBind_ToValue( a(i).paid, tkReportViewer_Cell( rv, r, 3 ) )
    next
    tkReportViewer_RefreshReport( rv )
end sub

' Page 1's text runs, "|" after each; maxRight = the right edge of the rightmost.
function Page1Text( byval rv as TK_WIDGET ptr, byref maxRight as single ) as string
    dim as TK_PRINTDOC ptr d = tkReportViewer_GetDocument( rv )
    tkPrintDoc_Generate( d )
    dim as string s
    maxRight = 0
    for i as long = 0 to tkPrintDoc_GetOpCount( d, 0 ) - 1
        dim as TKPRINT_OPINFO oi
        tkPrintDoc_GetOp( d, 0, i, oi )
        if oi.op = TKREC_TEXT then
            s &= oi.text & "|"
            if oi.x + oi.tw > maxRight then maxRight = oi.x + oi.tw
        end if
    next
    return s
end function

function ItemOf( byval bar as TK_WIDGET ptr, byval id as long ) as long
    return tkToolbar_FindItemByID( bar, id )
end function

sub RunPass( )
    tkTest_Begin( "viewer" )
    dim as TK_HOST ptr h = tkHost_Create( "tkReportViewer selftest", 800, 600, tkHost_FontDir() & TK_FONT_UI, 1.0 )
    if h = 0 then tkTest_Check( "host", false, *SDL_GetError() ) : exit sub
    tkHost_Show( h )
    dim as TK_PRINTDOC ptr doc = tkPrintDoc_Create( "viewer" )
    tkPrintDoc_SetPrintPageCallback( doc, @ThreePages )
    tkPrintDoc_Generate( doc )
    dim as TK_WIDGET ptr rv = tkReportViewer_Create( tkHost_Root( h ), 5 )
    tkWidget_SetPos( rv, 0, 0, 800, 600 )
    tkReportViewer_SetDocument( rv, doc )
    tkReportViewer_SetExportedCallback( rv, @OnExported )
    tkReportViewer_SetAfterPrintCallback( rv, @OnAfter )
    tkHost_RenderTo( h, false )
    dim as TK_WIDGET ptr bar = tkReportViewer_GetToolbar( rv ), pv = tkReportViewer_GetPreview( rv ), sb = tkReportViewer_GetStatusBar( rv )

    tkTest_Check( "layout: toolbar on top, status at the bottom, the preview between", (bar->y = 0) andalso (pv->y = bar->ch) _
                  andalso (sb->y + sb->ch = 600) andalso (pv->y + pv->ch = sb->y) andalso (pv->cw = 800), _
                  "bar " & bar->ch & " pv " & pv->y & "+" & pv->ch & " sb " & sb->y )
    tkTest_Check( "status and page box from the document", (tkStatusBar_GetText( sb, 0 ) = "Page 1 of 3") _
                  andalso (tkTextBox_GetText( tkReportViewer_GetPageBox( rv ) ) = "1"), tkStatusBar_GetText( sb, 0 ) )
    tkToolbar_Click( bar, ItemOf( bar, TKRV_CMD_NEXT ) )
    tkTest_Check( "Next: page 2", (tkPrintPreview_GetPage( pv ) = 1) andalso (tkStatusBar_GetText( sb, 0 ) = "Page 2 of 3"), tkStatusBar_GetText( sb, 0 ) )
    dim as TK_WIDGET ptr box = tkReportViewer_GetPageBox( rv )
    tkTextBox_SetText( box, "3" )
    tkHost_SetFocus( h, box )
    tkTest_PushKey( h, SDLK_RETURN )
    tkTest_Check( "the page box: 3 + Enter shows page 3", tkPrintPreview_GetPage( pv ) = 2, "page " & tkPrintPreview_GetPage( pv ) )
    dim as single z0 = tkPrintPreview_GetZoom( pv )
    tkToolbar_Click( bar, ItemOf( bar, TKRV_CMD_ZOOMIN ) )
    tkTest_Check( "zoom in: x1.25, the status shows it", (abs( tkPrintPreview_GetZoom( pv ) - z0 * 1.25 ) < 0.001) _
                  andalso (tkStatusBar_GetText( sb, 1 ) = clng( z0 * 125 ) & "%"), tkStatusBar_GetText( sb, 1 ) )
    tkReportViewer_SetShowToolbar( rv, false )
    tkTest_Check( "no toolbar: the preview takes its place", (pv->y = 0) andalso (tkWidget_IsVisible( bar ) = false) )
    tkReportViewer_SetShowToolbar( rv, true )

    SDL_CreateDirectory( "../out" )
    dim as ustring pdf = "../out/tkreportviewer.pdf"
    tkTest_Check( "Export PDF: written, Exported told", tkReportViewer_ExportPdf( rv, pdf ) andalso (gExported = 1) )
#ifdef __FB_WIN32__
    dim as TKPRINTERINFO list()
    dim as long n = tkPrinter_Enumerate( list() ), have = 0
    for i as long = 0 to n - 1
        if list(i).name = "Microsoft Print to PDF" then have = 1
    next
    if have then
        dim as TKPRINTJOB job
        job.printer = "Microsoft Print to PDF"
        job.outputFile = *SDL_GetBasePath( ) & "..\out\tkreportviewer-print.pdf"
        tkReportViewer_SetJob( rv, job )
        dim as boolean ok = tkReportViewer_Print( rv, false )
        tkTest_Check( "Print with no dialog: the job runs, AfterPrint told", ok andalso (gAfter = 1) andalso gAfterOk, tkPrinter_LastError( ) )
    end if
#endif

    ' ---- R5: its own report ----------------------------------------------------------------------
    dim as FRUIT fr(any)
    redim fr(0 to 2)
    fr(0).name = "Apple" : fr(0).qty = 3 : fr(0).price = 1234.5 : fr(0).paid = true
    fr(1).name = "Pear" : fr(1).qty = 12 : fr(1).price = 0.25
    fr(2).name = "Plum" : fr(2).qty = 7 : fr(2).price = 99
    dim as TK_WIDGET ptr rv2 = tkReportViewer_Create( tkHost_Root( h ), 6 )
    tkWidget_SetPos( rv2, 0, 0, 800, 600 )
    tkReportViewer_SetTitle( rv2, "Fruit" )
    ' 1000 px (750 pt) of columns: wider than any page, so scaled down to it
    tkReportViewer_AddField( rv2, "Name", 400 ) : tkReportViewer_AddField( rv2, "Qty", 200 )
    tkReportViewer_AddField( rv2, "Price", 250 ) : tkReportViewer_AddField( rv2, "Paid", 150 )
    FillFruit( rv2, fr() )
    dim as single maxR
    dim as string t = Page1Text( rv2, maxR )
    dim as TKPAGESETUP ps = tkPrintDoc_GetPageSetup( tkReportViewer_GetDocument( rv2 ) )
    dim as single pw, ph
    tkPageSetup_PageSize( ps, pw, ph )
    tkTest_Check( "its own report: title, captions, a line per row by kind, inside the margins", _
                  (instr( t, "Name|Qty|Price|Paid|Fruit|Apple|3|1,234.50|Pear|12|0.25|Plum|7|99.00|" ) > 0) _
                  andalso (maxR <= pw - ps.marginR + 0.5), t & " right " & maxR & " of " & (pw - ps.marginR) )
    redim preserve fr(0 to 0)
    fr(0).name = "Quince"
    FillFruit( rv2, fr() )
    t = Page1Text( rv2, maxR )
    tkTest_Check( "RefreshReport after new rows: the pages show them", (instr( t, "Quince" ) > 0) andalso (instr( t, "Apple" ) = 0), t )
    dim as TK_WIDGET ptr rv3 = tkReportViewer_Create( tkHost_Root( h ), 7 )
    tkReportViewer_SetBuildReportCallback( rv3, @BuildFruit )
    tkReportViewer_AddField( rv3, "Name" ) : tkReportViewer_AddField( rv3, "Qty" )
    tkReportViewer_AddField( rv3, "Price" ) : tkReportViewer_AddField( rv3, "Paid" )
    FillFruit( rv3, fr() )
    FillFruit( rv3, fr() )
    t = Page1Text( rv3, maxR )
    tkTest_Check( "BuildReport makes the bands, once, in place of the made table", (gBuilt = 1) andalso (t = "3 kg|"), gBuilt & " " & t )
    ' a document the preview generates itself: the status follows once it has pages, no page move needed
    dim as TK_PRINTDOC ptr lazy = tkPrintDoc_Create( "lazy" )
    tkPrintDoc_SetPrintPageCallback( lazy, @ThreePages )
    tkPrintDoc_BeginGenerate( lazy )
    dim as TK_WIDGET ptr rv4 = tkReportViewer_Create( tkHost_Root( h ), 8 )
    tkWidget_SetPos( rv4, 0, 0, 800, 600 )
    tkReportViewer_SetDocument( rv4, lazy )
    tkTest_PumpFor( h, 200 )
    tkHost_RenderTo( h, false )
    dim as TK_WIDGET ptr sb4 = tkReportViewer_GetStatusBar( rv4 )
    tkTest_Check( "a lazily generated document: the status shows its pages without a page move", _
                  tkStatusBar_GetText( sb4, 0 ) = "Page 1 of 3", tkStatusBar_GetText( sb4, 0 ) )
    tkWidget_Destroy( rv4 )
    tkPrintDoc_Destroy( lazy )

    tkPrintDoc_Destroy( doc )
    tkHost_Destroy( h )
end sub

' The designed form: generated Fill and BuildReport, through tkForms.
sub Designed( )
    tkTest_Begin( "designed" )
    dim as TKAPP_OPTIONS opts
    if tkApp_Init( opts ) = false then tkTest_Check( "tkApp_Init", false ) : exit sub
    dim as frmOrders.Form f
    f.Build( )
    f.rvTable_Fill( )
    dim as single maxR
    dim as string t = Page1Text( f.rvTable.Handle, maxR )
    tkTest_Check( "designed: Fill fills the table from the array, a column with no Field empty", _
                  instr( t, "Customer|Note|Qty|Amount|Paid|All orders|Avery|3|120.50|Blake|1|80.00|Casey|7|1,000.00|" ) > 0, t )
    f.rvRegions_Fill( )
    t = Page1Text( f.rvRegions.Handle, maxR )
    tkTest_Check( "designed: BuildReport's handler lays its report out (a total per region)", (f.Built = 1) andalso (t = "East|200.50|West|1,000.00|"), f.Built & " " & t )
    f.Close( )
    tkApp_Shutdown( )
end sub

if tkTest_Init() = false then end 1
RunPass( )
Designed( )
dim as long nFail = tkTest_Report( "tkReportViewer" )
tkTest_Quit()
end nFail
