' The rows the designed form frmOrders prints: an Array( of ORDER ), sorted by region.
#module "orderdata"
#import "std/containers"
using containers

public type ORDER
    Region   as ustring
    Customer as ustring
    Qty      as long
    Amount   as double
    Paid     as boolean
end type

private function MakeOrder( byref region as const ustring, byref customer as const ustring, byval qty as long, _
                            byval amount as double, byval paid as boolean ) as ORDER
    dim as ORDER o
    o.Region = region : o.Customer = customer : o.Qty = qty : o.Amount = amount : o.Paid = paid
    return o
end function

public function Orders( ) as Array( of ORDER )
    dim as Array( of ORDER ) a
    a.Push( MakeOrder( "East", "Avery", 3, 120.5, true ) )
    a.Push( MakeOrder( "East", "Blake", 1, 80, false ) )
    a.Push( MakeOrder( "West", "Casey", 7, 1000, true ) )
    return a
end function
