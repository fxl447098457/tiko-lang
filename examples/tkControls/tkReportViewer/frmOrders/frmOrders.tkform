format = 1

[form]
caption = "Orders"
width = 900
height = 600
data_module = "../orderdata"

[[control]]
name = "rvTable"
type = "ReportViewer"
parent = ""
x = 0
y = 0
w = 450
h = 600
items_source = "orderdata.Orders( )"
item_type = "orderdata.ORDER"

[control.props]
Title = "All orders"
ShowStatus = false

[[control.items]]
text = "Customer"
width = 160
field = "Customer"

[[control.items]]
text = "Note"
width = 100

[[control.items]]
text = "Qty"
width = 60
field = "Qty"

[[control.items]]
text = "Amount"
width = 100
field = "Amount"

[[control.items]]
text = "Paid"
width = 50
field = "Paid"

[[control]]
name = "rvRegions"
type = "ReportViewer"
parent = ""
x = 450
y = 0
w = 450
h = 600
items_source = "orderdata.Orders( )"
item_type = "orderdata.ORDER"

[control.events]
BuildReport = "rvRegions_BuildReport"

[[control.items]]
text = "Region"
field = "Region"

[[control.items]]
text = "Amount"
field = "Amount"
