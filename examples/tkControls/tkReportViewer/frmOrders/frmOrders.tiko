' The half of the form you write (printing R5). rvTable shows the table its fields make; rvRegions
' lays its own report out in BuildReport: a line per region with the region's total.
#module "frmOrders"
#import "vendor/tkControls/tkReport"
using tkReport
using tkPrint

public partial type Form
    Built as long
end type

sub Form.rvRegions_BuildReport( byval rpt as TK_REPORT ptr )
    Built += 1
    dim as long fRegion = tkReport_FindField( rpt, "Region" ), fAmount = tkReport_FindField( rpt, "Amount" )
    tkReport_AddGroup( rpt, fRegion )
    tkReport_GetBand( rpt, TKRB_DETAIL )->visible = false     ' a line per region, none per order
    dim as TK_RBAND ptr b = tkReport_GetBand( rpt, TKRB_GROUP_FOOTER, 0 )
    dim as TKRECTF rc
    tkRectF_Set( rc, 0, 0, 200, 18 ) : tkRBand_AddField( b, rc, fRegion )
    tkRectF_Set( rc, 200, 0, 320, 18 ) : tkRBand_AddSummary( b, rc, fAmount, TKRS_SUM, 0, "#,##0.00" )
end sub
