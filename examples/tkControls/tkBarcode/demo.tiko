' tkBarcode demo (phase BC1): the twenty curated symbologies with their sample data, a symbol in
' its error state, and a QR code drawn widgetless. Hover the red one for zint's message.
'
'   demo                     interactive
'   demo --shot out.png      render once, save the window (.png or .bmp), exit
'   demo --scale 1.75        pin the scale instead of asking the display
'   demo --export <dir>      write every symbol as PDF, PNG (300 dpi) and SVG into dir, exit
#import "vendor/tkControls/tkBarcode"
using tkBarcode
using tkTheme
using tkHost
using tkPaint

dim shared as TK_HOST ptr gHost
dim shared as TTF_Font ptr gFont
dim shared as TK_WIDGET ptr gCodes(0 to TKBC_SYMBOLOGY_COUNT)

const as int32 CELL_W = 220, CELL_H = 150, COLS = 6

sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    dim as TKTHEME_COLORS t = tkTheme_Of( tkHost_Root( h ) )
    dim as TKRECT rc
    b->SetFont( gFont )
    b->SetColors( t.TextDim, t.Window )
    for i as int32 = 0 to TKBC_SYMBOLOGY_COUNT
        dim as int32 cx = 10 + ( i mod COLS ) * CELL_W, cy = 10 + ( i \ COLS ) * CELL_H
        tkRect_Set( rc, tkHost_Scale( h, cx ), tkHost_Scale( h, cy ), tkHost_Scale( h, cx + CELL_W - 10 ), tkHost_Scale( h, cy + 18 ) )
        dim as ustring cap = "EAN-13, wrong check digit"
        if i < TKBC_SYMBOLOGY_COUNT then cap = tkBarcode_SymbologyName( i )
        b->PaintText( cap, @rc, TK_DT_LEFT or TK_DT_VCENTER )
    next
    ' widgetless: a QR code painted straight into the form
    dim as TKBARCODE_SPEC s
    s.nSymbology = TKBC_QR
    dim as TKBARCODE_SYMBOL sym
    tkBarcode_Encode( s, "tkBarcode_PaintInto", sym )
    dim as TKBARCODE_LOOK lk
    lk.nModulePx = tkHost_Scale( h, 2 )
    lk.pFont = gFont
    dim as int32 cx = 10 + ( ( TKBC_SYMBOLOGY_COUNT + 1 ) mod COLS ) * CELL_W, cy = 10 + ( ( TKBC_SYMBOLOGY_COUNT + 1 ) \ COLS ) * CELL_H
    tkRect_Set( rc, tkHost_Scale( h, cx ), tkHost_Scale( h, cy ), tkHost_Scale( h, cx + CELL_W - 10 ), tkHost_Scale( h, cy + 18 ) )
    b->SetColors( t.TextDim, t.Window )
    b->PaintText( "PaintInto (no widget)", @rc, TK_DT_LEFT or TK_DT_VCENTER )
    tkRect_Set( rc, tkHost_Scale( h, cx ), tkHost_Scale( h, cy + 22 ), tkHost_Scale( h, cx + CELL_W - 10 ), tkHost_Scale( h, cy + CELL_H - 10 ) )
    tkBarcode_PaintInto( b, rc, sym, s, lk )
end sub

private function ArgValue( byref name_ as string ) as string
    for i as int32 = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

private sub SaveShot( byref path as string )
    tkHost_Render( gHost )
    tkHost_RenderTo( gHost, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( gHost->renderer, 0 )
    if s then
        if lcase( right( path, 4 ) ) = ".png" then IMG_SavePNG( s, strptr( path ) ) else SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & gHost->fScale
        SDL_DestroySurface( s )
    end if
end sub

' ---- main --------------------------------------------------------------------------------
if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
gHost = tkHost_Create( "tkBarcode on SDL3", COLS * CELL_W + 10, 4 * CELL_H + 10, tkHost_FontDir() & TK_FONT_UI, val( ArgValue( "--scale" ) ) )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
gHost->clrBack = tkTheme_Of( tkHost_Root( gHost ) ).Window
gFont = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 9 )
dim as TK_WIDGET ptr root = tkHost_Root( gHost )

for i as int32 = 0 to TKBC_SYMBOLOGY_COUNT
    dim as int32 nSym = iif( i < TKBC_SYMBOLOGY_COUNT, i, TKBC_EAN13 )
    gCodes(i) = tkBarcode_Create( root, 100 + i, nSym )
    dim as ustring sData = "5901234123458"
    if i < TKBC_SYMBOLOGY_COUNT then sData = tkBarcode_SampleData( i )
    tkBarcode_SetData( gCodes(i), sData )
    tkBarcode_SetFitMode( gCodes(i), TKBC_FIT_FIT )
    dim as int32 cx = 10 + ( i mod COLS ) * CELL_W, cy = 10 + ( i \ COLS ) * CELL_H
    tkWidget_SetPos( gCodes(i), tkHost_Scale( gHost, cx ), tkHost_Scale( gHost, cy + 22 ), tkHost_Scale( gHost, CELL_W - 10 ), tkHost_Scale( gHost, CELL_H - 32 ) )
next

gHost->OnPaint = @Form_Paint
tkHost_Show( gHost )
dim as string exportDir = ArgValue( "--export" )
if len( exportDir ) then
    for i as int32 = 0 to TKBC_SYMBOLOGY_COUNT - 1
        dim as string nm = exportDir & "/" & right( "0" & i, 2 )
        dim as boolean a = tkBarcode_ExportPdf( gCodes(i), nm & ".pdf" )
        dim as boolean b = tkBarcode_ExportPng( gCodes(i), nm & ".png", 300 )
        dim as boolean c = tkBarcode_ExportSvg( gCodes(i), nm & ".svg" )
        print tkBarcode_SymbologyName( i ) & ": pdf " & a & ", png " & b & ", svg " & c
    next
    tkHost_Destroy( gHost )
    TTF_Quit( )
    SDL_Quit( )
    end 0
end if
dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )
    SaveShot( shot )
else
    tkHost_Run( gHost )
end if
tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
