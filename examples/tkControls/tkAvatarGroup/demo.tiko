' tkAvatarGroup demo (phase A2): stacked and spread groups, the "+N" overflow (click it: the hidden
' names in a menu), a Total larger than the items held, square shapes and a photo.
'
'   demo                     interactive (Tab to the groups, arrows, Enter)
'   demo --shot out.bmp      render once, save the window, exit
'   demo --scale 1.75        pin the scale instead of asking the display
#import "vendor/tkControls/tkAvatarGroup"
using tkAvatarGroup
using tkAvatar
using tkBadge
using tkTheme
using tkHost
using tkPaint

dim shared as TK_HOST ptr gHost
dim shared as TTF_Font ptr gFont
dim shared as ulong gPhoto(0 to 32 * 32 - 1)

sub OnItem( byval hGroup as TK_WIDGET ptr, byval idx as long )
    print "item " & idx & ": " & tkAvatarGroup_GetItemName( hGroup, idx )
end sub

sub OnOverflow( byval hGroup as TK_WIDGET ptr )
    tkAvatarGroup_ShowOverflowMenu( hGroup )
end sub

sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    dim as TKTHEME_COLORS t = tkTheme_Of( tkHost_Root( h ) )
    dim as ustring heads(0 to 3) = { "Stacked, MaxVisible 5 (click +4 for the rest)", "Spread", _
                                     "Total 42 (4 loaded)", "Square, 40, a photo" }
    b->SetFont( gFont )
    b->SetColors( t.TextDim, t.Window )
    for i as long = 0 to 3
        dim as TKRECT rc
        tkRect_Set( rc, tkHost_Scale( h, 20 ), tkHost_Scale( h, 8 + i * 74 ), tkHost_Scale( h, 600 ), tkHost_Scale( h, 26 + i * 74 ) )
        b->PaintText( heads(i), @rc, TK_DT_LEFT or TK_DT_VCENTER )
    next
end sub

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

private sub SaveShot( byref path as string )
    tkHost_Render( gHost )
    tkHost_RenderTo( gHost, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( gHost->renderer, 0 )
    if s then
        SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & gHost->fScale
        SDL_DestroySurface( s )
    end if
end sub

private function NewGroup( byval y as long, byval n as long ) as TK_WIDGET ptr
    dim as ustring names(0 to 7) = { "Ada Lovelace", "Grace Hopper", "Alan Turing", "Edsger Dijkstra", _
                                     "Barbara Liskov", "Ken Thompson", "Margaret Hamilton", "Niklaus Wirth" }
    dim as TK_WIDGET ptr g = tkAvatarGroup_Create( tkHost_Root( gHost ), 0 )
    for i as long = 0 to n - 1 : tkAvatarGroup_AddItem( g, names(i) ) : next
    tkAvatarGroup_SetInteractive( g, true )
    tkAvatarGroup_SetItemClickCallback( g, @OnItem )
    tkAvatarGroup_SetOverflowClickCallback( g, @OnOverflow )
    tkWidget_SetPos( g, tkHost_Scale( gHost, 20 ), tkHost_Scale( gHost, y ), 1, 1 )
    return g
end function

private sub Fit( byval g as TK_WIDGET ptr )
    dim as long iw, ih
    tkAvatarGroup_GetIdealSize( g, iw, ih )
    tkWidget_SetSize( g, iw, ih )
end sub

' ---- main --------------------------------------------------------------------------------
if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
gHost = tkHost_Create( "tkAvatarGroup on SDL3", 560, 310, tkHost_FontDir() & TK_FONT_UI, val( ArgValue( "--scale" ) ) )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
gHost->clrBack = tkTheme_Of( tkHost_Root( gHost ) ).Window
gFont = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 9 )
for i as long = 0 to ubound( gPhoto )
    gPhoto(i) = tkRGB( 60 + (i mod 32) * 4, 120, 200 - (i \ 32) * 3 )
next

dim as TK_WIDGET ptr g
g = NewGroup( 30, 8 ) : tkAvatarGroup_SetItemPresence( g, 0, TKBADGE_PRESENCE_AVAILABLE ) : Fit( g )
g = NewGroup( 104, 5 ) : tkAvatarGroup_SetLayout( g, TKAVGROUP_SPREAD ) : Fit( g )
g = NewGroup( 178, 4 ) : tkAvatarGroup_SetTotal( g, 42 ) : Fit( g )
g = NewGroup( 252, 4 ) : tkAvatarGroup_SetShape( g, TKAVATAR_SQUARE ) : tkAvatarGroup_SetSize( g, 40 )
tkAvatarGroup_SetItemImagePixels( g, 1, 32, 32, @gPhoto(0) ) : Fit( g )

gHost->OnPaint = @Form_Paint
tkHost_Show( gHost )
dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )
    SaveShot( shot )
else
    tkHost_Run( gHost )
end if
tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
