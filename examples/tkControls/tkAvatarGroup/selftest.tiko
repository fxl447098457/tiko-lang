' tkAvatarGroup self-test (phase A2), one check per distinct behaviour. Real windows; two passes,
' scale pinned at 1.0 and 1.75. The overflow rule and the geometry against §6.7's formulas, the
' stacking order by pixels, input through the real dispatch.
'
'   selftest            exit code = number of failures
#import "vendor/tkControls/tkAvatarGroup"
#import "vendor/tkControls/tkTest"
using tkAvatarGroup
using tkAvatar
using tkPopupMenu
using tkTheme
using tkTest
using tkHost
using tkPaint

dim shared as long gItemClicks, gLastItem, gOverflowClicks

sub OnItem( byval hGroup as TK_WIDGET ptr, byval idx as long )
    gItemClicks += 1 : gLastItem = idx
end sub

sub OnOverflow( byval hGroup as TK_WIDGET ptr )
    gOverflowClicks += 1
end sub

sub Reset_( )
    gItemClicks = 0 : gLastItem = -99 : gOverflowClicks = 0
end sub

function Px( byval h as TK_HOST ptr, byval w as TK_WIDGET ptr, byval x as long, byval y as long ) as ulong
    dim as TKRECT a
    tkWidget_AbsRect( w, a )
    return tkTest_PixelAt( h, a.left + x, a.top + y )
end function

function WX( byval w as TK_WIDGET ptr, byval x as long ) as long
    dim as TKRECT a
    tkWidget_AbsRect( w, a )
    return a.left + x
end function

function WY( byval w as TK_WIDGET ptr, byval y as long ) as long
    dim as TKRECT a
    tkWidget_AbsRect( w, a )
    return a.top + y
end function

' ==========================================================================================
sub RunPass( byval fScale as single )
    tkTest_Begin( "scale " & fScale )
    dim as TK_HOST ptr h = tkHost_Create( "tkAvatarGroup selftest", 640, 400, tkHost_FontDir() & TK_FONT_UI, fScale )
    if h = 0 then tkTest_Check( "host created", false, *SDL_GetError() ) : exit sub
    dim as TK_WIDGET ptr root = tkHost_Root( h )
    tkHost_Show( h )
    tkTest_PumpFor( h, 50 )

    ' ---- the overflow rule ---------------------------------------------------------------------
    dim as TK_WIDGET ptr g = tkAvatarGroup_Create( root, 1 )
    dim as ustring names(0 to 6) = { "Ada Lovelace", "Grace Hopper", "Alan Turing", "Edsger Dijkstra", _
                                     "Barbara Liskov", "Ken Thompson", "Niklaus Wirth" }
    for i as long = 0 to 6 : tkAvatarGroup_AddItem( g, names(i) ) : next
    dim as string bad
    if (tkAvatarGroup_GetShownCount( g ) <> 4) orelse (tkAvatarGroup_GetOverflowCount( g ) <> 3) then bad &= " 7of5"
    tkAvatarGroup_SetMaxVisible( g, 7 )
    if (tkAvatarGroup_GetShownCount( g ) <> 7) orelse (tkAvatarGroup_GetOverflowCount( g ) <> 0) then bad &= " 7of7"
    tkAvatarGroup_SetTotal( g, 42 )
    tkAvatarGroup_SetMaxVisible( g, 3 )
    if (tkAvatarGroup_GetShownCount( g ) <> 2) orelse (tkAvatarGroup_GetOverflowCount( g ) <> 40) then bad &= " total42max3"
    tkAvatarGroup_SetMaxVisible( g, 50 )
    if (tkAvatarGroup_GetShownCount( g ) <> 7) orelse (tkAvatarGroup_GetOverflowCount( g ) <> 35) then bad &= " total-beyond-held"
    tkAvatarGroup_SetTotal( g, -1 )
    tkAvatarGroup_SetMaxVisible( g, 5 )
    tkTest_Check( "overflow: the first MaxVisible - 1 and +N; Total counts the rest", len( bad ) = 0, bad )

    ' ---- geometry ----------------------------------------------------------------------------------
    dim as long d = tkHost_Scale( h, 32 ), m = 2 + tkHost_Scale( h, 2 ) + 1
    dim as long stepS = d - cint( d * 20 / 100 )
    dim as long iw, ih
    tkAvatarGroup_GetIdealSize( g, iw, ih )
    tkTest_Check( "STACK ideal size: 2m + 4 steps + d (4 shown + the overflow)", iw = 2 * m + 4 * stepS + d andalso ih = d + 2 * m, iw & "x" & ih )
    tkWidget_SetPos( g, tkHost_Scale( h, 20 ), tkHost_Scale( h, 20 ), iw, ih )
    dim as TKRECT r0, r1, ro
    tkAvatarGroup_GetItemRect( g, 0, r0 ) : tkAvatarGroup_GetItemRect( g, 1, r1 ) : tkAvatarGroup_GetOverflowRect( g, ro )
    tkTest_Check( "item k at m + k step, the overflow last", r0.left = m andalso r1.left = m + stepS andalso ro.left = m + 4 * stepS _
                  andalso tkAvatarGroup_GetItemRect( g, 4, r1 ) = false, tkRect_Str( r0 ) & " " & tkRect_Str( ro ) )
    tkAvatarGroup_GetItemRect( g, 1, r1 )
    tkAvatarGroup_SetLayout( g, TKAVGROUP_SPREAD )
    tkAvatarGroup_GetIdealSize( g, iw, ih )
    dim as long stepP = d + 4 + tkHost_Scale( h, 4 )
    tkTest_Check( "SPREAD ideal size: steps of d + the rings + Spacing", iw = 2 * m + 4 * stepP + d, "" & iw )
    tkAvatarGroup_SetLayout( g, TKAVGROUP_STACK )
    tkAvatarGroup_GetIdealSize( g, iw, ih )

    ' ---- the stack, by pixels ------------------------------------------------------------------------
    tkHost_RenderTo( h, false )
    dim as ulong b0, k0, b1, k1
    tkAvatar_PaletteColors( true, tkAvatar_PaletteIndex( names(0) ), b0, k0 )
    tkAvatar_PaletteColors( true, tkAvatar_PaletteIndex( names(1) ), b1, k1 )
    ' the overlap of items 0 and 1, away from the text: item 0 is on top
    dim as long ox = r1.left + (r0.right - r1.left) \ 2, oy = (r0.top + r0.bottom) \ 2
    tkTest_Check( "STACK: the first item is on top in the overlap", Px( h, g, ox, oy ) = b0 andalso b0 <> b1, hex( Px( h, g, ox, oy ) ) )
    tkTest_Check( "...and a hit there goes to it", tkAvatarGroup_HitTest( g, ox, oy ) = 0 )
    dim as TKAVGROUP_COLORS cc
    tkAvatarGroup_GetColors( g, @cc )
    tkTest_Check( "the overflow disc: +N in the overflow colours, its hit", Px( h, g, ro.right - d \ 6, (ro.top + ro.bottom) \ 2 ) = cc.OverflowBack _
                  andalso tkAvatarGroup_HitTest( g, (ro.left + ro.right) \ 2 + d \ 4, (ro.top + ro.bottom) \ 2 ) = TKAVGROUP_OVERFLOW )
    tkTest_Check( "between the items' rings: the background, no hit", tkAvatarGroup_HitTest( g, ro.right + 3, 1 ) = TKAVGROUP_HIT_NONE )

    ' ---- input --------------------------------------------------------------------------------------
    tkAvatarGroup_SetItemClickCallback( g, @OnItem )
    tkAvatarGroup_SetOverflowClickCallback( g, @OnOverflow )
    Reset_( )
    tkTest_Click( h, WX( g, (r1.left + r1.right) \ 2 + d \ 4 ), WY( g, (r1.top + r1.bottom) \ 2 ) )
    tkTest_Click( h, WX( g, (ro.left + ro.right) \ 2 + d \ 4 ), WY( g, (ro.top + ro.bottom) \ 2 ) )
    tkTest_Check( "a click: ItemClick( 1 ), OverflowClick on +N", gItemClicks = 1 andalso gLastItem = 1 andalso gOverflowClicks = 1 )
    tkTest_Check( "not Interactive: not a tab stop", g->isFocusable = false andalso tkHost_GetFocus( h ) <> g )
    tkAvatarGroup_SetInteractive( g, true )
    tkHost_SetFocus( h, g )
    Reset_( )
    tkTest_PushKey( h, SDLK_RIGHT ) : tkTest_PushKey( h, SDLK_RIGHT )
    tkTest_PushKey( h, SDLK_RETURN )
    tkTest_Check( "Interactive: Right moves the focus item, Enter clicks it", tkAvatarGroup_GetFocusItem( g ) = 2 andalso gItemClicks = 1 andalso gLastItem = 2 )
    tkTest_PushKey( h, SDLK_END ) : tkTest_PushKey( h, SDLK_RIGHT ) : tkTest_PushKey( h, SDLK_SPACE )
    tkTest_Check( "End is the overflow (no wrap past it); Space there is OverflowClick", tkAvatarGroup_GetFocusItem( g ) = 4 andalso gOverflowClicks = 1 )
    tkTest_PushKey( h, SDLK_HOME ) : tkTest_PushKey( h, SDLK_LEFT )
    tkTest_Check( "Home, and Left at the first stays", tkAvatarGroup_GetFocusItem( g ) = 0 )
    tkTest_Check( "tips: an item's name; the overflow's hidden names", tkAvatarGroup_GetTipText( g, 1 ) = names(1) _
                  andalso tkAvatarGroup_GetTipText( g, TKAVGROUP_OVERFLOW ) = names(4) & chr( 10 ) & names(5) & chr( 10 ) & names(6) )
    ' the overflow menu: the hidden names; a pick fires ItemClick with its index
    tkAvatarGroup_ShowOverflowMenu( g )
    dim as TK_MENU ptr mnu = tkAvatarGroup_GetOverflowMenu( g )
    tkTest_Check( "ShowOverflowMenu lists the three hidden names", (mnu <> 0) andalso tkPopupMenu_IsOpen( mnu ) andalso tkPopupMenu_GetItemCount( mnu ) = 3 )
    Reset_( )
    tkTest_PushKey( h, SDLK_DOWN ) : tkTest_PushKey( h, SDLK_RETURN )
    tkTest_PumpFor( h, 30 )
    tkTest_Check( "picking one fires ItemClick with its index", gItemClicks = 1 andalso gLastItem = 4, gItemClicks & " " & gLastItem )
    if tkPopupMenu_IsOpen( mnu ) then tkPopupMenu_CloseChain( mnu )

    ' ---- items: images, insert, remove, find --------------------------------------------------------
    dim as ulong pix(0 to 15)
    for i as long = 0 to 15 : pix(i) = &hFF10C040ul : next
    tkAvatarGroup_SetItemImagePixels( g, 0, 4, 4, @pix(0) )
    tkHost_RenderTo( h, false )
    tkTest_Check( "an item's picture", Px( h, g, (r0.left + r0.right) \ 2 - d \ 6, (r0.top + r0.bottom) \ 2 ) = &hFF10C040ul )
    tkAvatarGroup_InsertItem( g, 0, "Zed First", "zed" )
    tkTest_Check( "InsertItem( 0 ) shifts the rest; FindItemByKey by key or name", tkAvatarGroup_GetCount( g ) = 8 _
                  andalso tkAvatarGroup_GetItemName( g, 1 ) = names(0) andalso tkAvatarGroup_FindItemByKey( g, "zed" ) = 0 _
                  andalso tkAvatarGroup_FindItemByKey( g, names(2) ) = 3 )
    tkAvatarGroup_RemoveItem( g, 0 )
    tkAvatarGroup_RemoveItem( g, 0 )
    tkTest_Check( "RemoveItem, including one with an owned picture", tkAvatarGroup_GetCount( g ) = 6 andalso tkAvatarGroup_GetItemName( g, 0 ) = names(1) )
    ' the focus slot after the slots shrink: no "+N" to answer
    tkAvatarGroup_SetTotal( g, 0 )
    tkAvatarGroup_SetMaxVisible( g, 50 )
    tkHost_SetFocus( h, g )
    tkTest_PushKey( h, SDLK_END )
    tkAvatarGroup_RemoveItem( g, 5 )
    Reset_( )
    tkTest_PushKey( h, SDLK_RETURN )
    tkTest_Check( "RemoveItem under the focus slot: it stays on a shown item; Enter clicks that, no OverflowClick", _
                  tkAvatarGroup_GetFocusItem( g ) = 4 andalso gOverflowClicks = 0 andalso gLastItem = 4 )
    tkTest_PushKey( h, SDLK_LEFT, SDL_KMOD_CTRL )
    tkTest_Check( "Ctrl+Left is not the group's", tkAvatarGroup_GetFocusItem( g ) = 4 )

    ' ---- theme ----------------------------------------------------------------------------------------
    tkTheme_Apply( tkTheme_Light() )
    tkAvatarGroup_GetColors( g, @cc )
    tkTest_Check( "a theme change re-colours", cc.BackColor = tkTheme_Light().Window )
    tkTheme_Apply( tkTheme_Dark() )

    tkHost_Destroy( h )
end sub

' ==========================================================================================
if tkTest_Init() = false then end 99
RunPass( 1.0 )
RunPass( 1.75 )
dim as long nFail = tkTest_Report( "tkAvatarGroup" )
tkTest_Quit()
end nFail
