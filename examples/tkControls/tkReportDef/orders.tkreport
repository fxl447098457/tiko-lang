format = 1

[report]
title = "Orders by customer"
paper = "A4"
margins = [42.52, 42.52, 42.52, 42.52]

[[parameter]]
name = "From"
type = "date"
default = "#2026-01-01#"
prompt = "Orders from"

[[source]]
name = "Orders"
kind = "sqlite"
sql = "select Id, Customer, OrderDate from orders where OrderDate >= :From"
params = { From = "@From" }
sort = "[Customer], [Id]"

  [[source.field]]
  name = "Id"
  kind = "int"

  [[source.field]]
  name = "Customer"

  [[source.field]]
  name = "OrderDate"
  kind = "date"

[[source]]
name = "Lines"
kind = "sqlite"
parent = "Orders"
sql = "select Product, Qty, Price from lines where OrderId = :OrderId"
params = { OrderId = "[Orders.Id]" }
sort = "[Product]"

  [[source.field]]
  name = "Product"

  [[source.field]]
  name = "Qty"
  kind = "int"

  [[source.field]]
  name = "Price"
  kind = "float"

[[calc]]
source = "Lines"
name = "LineTotal"
expr = "[Qty] * [Price]"

[[band]]
id = "title"
kind = "report_header"
height = 24

[[band]]
id = "g1h"
kind = "group_header"
group = "[Customer]"
height = 18
repeat = true

[[band]]
id = "d"
kind = "detail"
source = "Orders"
height = 16

[[band]]
id = "lines"
kind = "detail_report"
parent = "d"
source = "Lines"

[[band]]
id = "lh"
kind = "report_header"
parent = "lines"
height = 14

[[band]]
id = "ld"
kind = "detail"
parent = "lines"
height = 14

[[band]]
id = "lf"
kind = "report_footer"
parent = "lines"
height = 16

[[band]]
id = "g1f"
kind = "group_footer"
height = 18

[[band]]
id = "rf"
kind = "report_footer"
print_at_bottom = true

[[band]]
id = "pf"
kind = "page_footer"
height = 16

[[band]]
id = "nodata"
kind = "no_data"

[[item]]
id = "titleText"
band = "title"
rect = [0, 0, 400, 22]
text = "Orders from {Format(@From, \"dd/mm/yyyy\")}"
font = { size = 14, bold = true }

[[item]]
id = "custName"
band = "g1h"
rect = [0, 2, 200, 14]
text = "{[Customer]}"
font = { bold = true }

[[item]]
id = "custTotalHead"
band = "g1h"
kind = "field"
rect = [300, 2, 100, 14]
expr = "Sum([Lines.LineTotal])"
format = "#,##0.00"
align = "right"

[[item]]
id = "orderLine"
band = "d"
rect = [10, 1, 300, 14]
text = "Order {[Id]} of {Format([OrderDate], \"dd/mm/yyyy\")}"

[[item]]
id = "linesHead"
band = "lh"
rect = [20, 0, 100, 14]
text = "Lines"
font = { italic = true }

[[item]]
id = "product"
band = "ld"
rect = [20, 0, 150, 14]
text = "{[Product]}"

[[item]]
id = "qty"
band = "ld"
kind = "field"
rect = [170, 0, 50, 14]
expr = "[Qty]"
align = "right"

[[item]]
id = "lineTotal"
band = "ld"
kind = "field"
rect = [300, 0, 100, 14]
expr = "[LineTotal]"
format = "#,##0.00"
align = "right"

  [[item.rule]]
  when = "[LineTotal] > 20"
  fore = "#C00000"
  bold = true

[[item]]
id = "orderTotal"
band = "lf"
kind = "field"
rect = [300, 1, 100, 14]
expr = "Sum([LineTotal])"
format = "#,##0.00"
align = "right"
border = "top"

[[item]]
id = "custTotalLabel"
band = "g1f"
rect = [0, 2, 150, 14]
text = "Customer total"

[[item]]
id = "custTotal"
band = "g1f"
kind = "field"
rect = [300, 2, 100, 14]
expr = "Sum([Lines.LineTotal])"
format = "#,##0.00"
align = "right"

[[item]]
id = "custOrders"
band = "g1f"
rect = [150, 2, 100, 14]
text = "{Count()} orders"
incr = "master"

[[item]]
id = "allOrders"
band = "rf"
rect = [0, 2, 200, 16]
text = "All {Count()} orders"
incr = "master"

[[item]]
id = "allTotal"
band = "rf"
kind = "field"
rect = [300, 2, 100, 16]
expr = "Sum([Lines.LineTotal])"
format = "#,##0.00"
align = "right"
font = { bold = true }

[[item]]
id = "pageNo"
band = "pf"
rect = [0, 0, 400, 14]
text = "Page {PageNumber} of {PageCount}"
align = "right"

[[item]]
id = "noOrders"
band = "nodata"
rect = [0, 0, 200, 14]
text = "No orders"
