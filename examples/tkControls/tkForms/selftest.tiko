' tkForms self-test: a form written the way the designer will generate one -- a partial type over
' FormBase, controls as typed wrappers, events reaching member handlers through a thunk.
#import "vendor/tkControls/tkForms"
#import "vendor/tkControls/tkButton"
#import "vendor/tkControls/tkTextBox"
#import "vendor/tkControls/tkLabel"
#import "vendor/tkControls/tkCheckBox"
#import "vendor/tkControls/tkTest"
using tkForms
using tkApp
using tkLayout
using tkButton
using tkTextBox
using tkLabel
using tkCheckBox
using tkTheme
using tkTest
using tkHost
using tkPaint

' ---- what the designer generates ------------------------------------------------------------
partial type Form extends FormBase
    btnOK as Button
    txtName as TextBox
    lblInfo as Label
    chkOn as CheckBox
    declare sub Build( byval owner as TK_FORM ptr = nullptr )
    declare sub btnOK_Click( )
    declare sub chkOn_CheckChanged( byval isChecked as boolean )
end type

private sub Thunk_btnOK_Click( byval h as TK_WIDGET ptr, byval id as long )
    dim as Form ptr f = tkForms_ObjectOf( h )
    if f then f->btnOK_Click( )
end sub

private sub Thunk_chkOn_CheckChanged( byval h as TK_WIDGET ptr, byval isChecked as boolean )
    dim as Form ptr f = tkForms_ObjectOf( h )
    if f then f->chkOn_CheckChanged( isChecked )
end sub

sub Form.Build( byval owner as TK_FORM ptr = nullptr )
    OpenWindow( "Form", 400, 300, owner )
    dim as TK_WIDGET ptr root_ = tkForm_Widget( Wnd )
    tkLayout_AddContainer( Layout, root_, 400, 300 )
    btnOK.Create( root_, 1 )
    btnOK.Text = "OK"
    tkButton_SetClickCallback( btnOK.Handle, @Thunk_btnOK_Click )
    tkLayout_Add( Layout, btnOK.Handle, 300, 260, 88, 30, TK_ANCHOR_RIGHT or TK_ANCHOR_BOTTOM )
    txtName.Create( root_, 2 )
    txtName.Text = "Ada"
    tkLayout_Add( Layout, txtName.Handle, 12, 12, 376, 28, TK_ANCHOR_LEFT or TK_ANCHOR_RIGHT or TK_ANCHOR_TOP )
    lblInfo.Create( root_, 3 )
    tkLayout_Add( Layout, lblInfo.Handle, 12, 50, 300, 24 )
    chkOn.Create( root_, 4 )
    chkOn.Text = "On"
    tkCheckBox_SetCheckChangedCallback( chkOn.Handle, @Thunk_chkOn_CheckChanged )
    tkLayout_Add( Layout, chkOn.Handle, 12, 80, 120, 24 )
end sub

' ---- what you write --------------------------------------------------------------------------
partial type Form
    Clicks as long
    LastChecked as boolean
end type

sub Form.btnOK_Click( )
    Clicks += 1
    lblInfo.Text = txtName.Text & " " & Clicks
end sub

sub Form.chkOn_CheckChanged( byval isChecked as boolean )
    LastChecked = isChecked
end sub

' ------------------------------------------------------------------------------------------------
function Upper_( byref key as const ustring, byref text as const ustring ) as ustring
    return key & ":" & text
end function

sub EndModal7( byval p as any ptr )
    cast( Form ptr, p )->EndModal( 7 )
end sub

sub Basics( byval gOwner as TK_FORM ptr )
    tkTest_Begin( "a designed form" )
    dim as Form f
    tkTest_Check( "no window until it is built", f.IsOpen( ) = false )
    f.Build( )
    tkTest_Check( "the window exists", f.IsOpen( ) andalso (f.Wnd <> 0) )
    tkTest_Check( "the form's address is in the window's Tag", f.Wnd->Tag = @f )
    dim as TK_HOST ptr h = tkForm_Host( f.Wnd )
    f.Show( )
    tkTest_PumpFor( h, 60 )

    tkTest_Check( "wrapper text reads back", f.txtName.Text = "Ada" )
    tkTest_Check( "wrapper is its handle", f.btnOK.Handle->ctrlId = 1 )
    tkTest_Check( "enabled by default", f.btnOK.Enabled )
    f.btnOK.Enabled = false
    tkTest_Check( "Enabled writes through", tkWidget_IsEnabled( f.btnOK.Handle ) = false )
    f.btnOK.Enabled = true
    f.lblInfo.Visible = false
    tkTest_Check( "Visible writes through", f.lblInfo.Handle->isVisible = false )
    f.lblInfo.Visible = true

    ' Layout runs on the window's size, and the right+bottom button holds its corner.
    dim as long sc1 = tkForm_Scale( f.Wnd, 300 )
    tkTest_Check( "layout placed the button", f.btnOK.Handle->x = sc1, str( f.btnOK.Handle->x ) )
    dim as long growW = tkForm_Scale( f.Wnd, 100 )
    SDL_SetWindowSize( h->win, h->root->cw + growW, h->root->ch )
    SDL_SyncWindow( h->win )
    tkTest_PumpFor( h, 200 )
    tkTest_Check( "the button keeps its right gap", h->root->cw - (f.btnOK.Handle->x + f.btnOK.Handle->cw) = tkForm_Scale( f.Wnd, 400 - 388 ), _
                  (h->root->cw - (f.btnOK.Handle->x + f.btnOK.Handle->cw)) & " of " & h->root->cw )
    tkTest_Check( "the box stretched", f.txtName.Handle->cw = h->root->cw - tkForm_Scale( f.Wnd, 24 ), str( f.txtName.Handle->cw ) )

    ' A real click reaches the member handler, with the form's own state.
    tkTest_PushMotion( h, tkTest_CX( f.btnOK.Handle ), tkTest_CY( f.btnOK.Handle ) )
    tkTest_PumpFor( h, 20 )
    tkTest_Click( h, tkTest_CX( f.btnOK.Handle ), tkTest_CY( f.btnOK.Handle ) )
    tkTest_PumpFor( h, 30 )
    tkTest_Check( "the click ran the handler", f.Clicks = 1, str( f.Clicks ) )
    tkTest_Check( "the handler used the wrappers", f.lblInfo.Text = "Ada 1", f.lblInfo.Text )
    tkTest_Click( h, tkTest_CX( f.chkOn.Handle ), tkTest_CY( f.chkOn.Handle ) )
    tkTest_PumpFor( h, 30 )
    tkTest_Check( "a handler receives the event's values", f.LastChecked )
    tkTest_Check( "the wrapper agrees", f.chkOn.Checked )
end sub

sub Lifetime( byval owner as TK_FORM ptr )
    tkTest_Begin( "lifetime" )
    dim as long n0 = tkApp_FormCount( )
    scope
        dim as Form f
        f.Build( owner )
        tkTest_Check( "one more window", tkApp_FormCount( ) = n0 + 1 )
        f.txtName.Text = "typed"
        tkApp_RunOnUI( @EndModal7, @f )
        tkTest_Check( "ShowModal returns the code", f.ShowModal( ) = 7 )
        tkTest_Check( "controls are still readable after it", f.txtName.Text = "typed", f.txtName.Text )
        tkTest_Check( "the window still exists", f.IsOpen( ) )
    end scope
    tkTest_Check( "going out of scope destroys the window", tkApp_FormCount( ) = n0, str( tkApp_FormCount( ) ) )

    ' The user closes a modeless form while the object lives on.
    dim as Form g
    g.Build( owner )
    g.Show( )
    tkTest_PumpFor( tkForm_Host( g.Wnd ), 30 )
    tkTest_PushWindowEvent( tkForm_Host( g.Wnd ), SDL_EVENT_WINDOW_CLOSE_REQUESTED )
    tkApp_Pump( )
    tkTest_Check( "the close button destroys the window", tkApp_FormCount( ) = n0, str( tkApp_FormCount( ) ) )
    tkTest_Check( "the object knows", g.IsOpen( ) = false )
    tkTest_Check( "and its layout is gone", g.Layout = 0 )
    g.Show( )
    g.Close( )
    tkTest_Check( "using a closed form is harmless", true )
end sub

sub Translation( )
    tkTest_Begin( "captions" )
    tkTest_Check( "with no translator the text is unchanged", tkForms_Tr( "k", "Hello" ) = "Hello" )
    tkForms_SetTranslator( @Upper_ )
    tkTest_Check( "a translator is asked", tkForms_Tr( "k", "Hello" ) = "k:Hello", tkForms_Tr( "k", "Hello" ) )
    tkForms_SetTranslator( 0 )
    tkTest_Check( "an orphan widget has no form", tkForms_ObjectOf( 0 ) = 0 )
end sub

dim as TKAPP_OPTIONS opts
if tkApp_Init( opts ) = false then
    print "tkApp_Init failed"
    end 98
end if
dim as TK_FORM ptr mainForm = tkApp_NewForm( "owner", 200, 120, 0, 1.0 )
tkForm_Show( mainForm )
tkTest_PumpFor( tkForm_Host( mainForm ), 50 )
Translation( )
Basics( mainForm )
Lifetime( mainForm )
dim as long nFail = tkTest_Report( "tkForms" )
tkApp_Shutdown( )
end nFail
