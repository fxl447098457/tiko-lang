' tkPanel demo: a line border with theme colours, pinned back and border colours, a transparent
' panel over the form's own painting, a paint callback, and panels nested three deep (children sit
' relative to their parent). Each panel's first paint-callback call is printed.
'
'   demo                     run it
'   demo --shot out.bmp      render once, save the window, exit
'   demo --scale 1.75        pin the scale
#import "vendor/tkControls/tkPanel"
using tkPanel
using tkTheme
using tkHost
using tkPaint

dim shared as TK_HOST ptr gHost
dim shared as TTF_Font ptr gFont
dim shared as boolean gSeen(0 to 20)

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

private function HasArg( byref name_ as string ) as boolean
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return true
    next
    return false
end function

private sub DrawLine( byval b as TK_PAINT ptr, byref s as ustring, byval l as long, byval t as long, byval r as long, byval btm as long, byval clr as ulong )
    dim as TKRECT rc
    tkRect_Set( rc, l, t, r, btm )
    b->SetFont( gFont )
    b->SetForeColor( clr )
    b->PaintText( s, @rc, TK_DT_LEFT or TK_DT_VCENTER )
end sub

' Draws over each panel's background and border, under its children.
private sub Panel_Paint( byval p as TKPANEL_PAINTINFO ptr )
    dim as TK_WIDGET ptr w = p->hPanel
    dim as TKTHEME_COLORS t = tkTheme_Of( w )
    dim as TK_HOST ptr h = w->pHost
    if gSeen(w->ctrlId) = false then
        gSeen(w->ctrlId) = true
        print "PaintCallback " & w->ctrlId & ": " & w->cw & "x" & w->ch
    end if
    if w->ctrlId = 4 then
        ' a small bar chart
        dim as long vals(0 to 4) = { 40, 75, 55, 95, 65 }
        for i as long = 0 to 4
            dim as TKRECT rc
            dim as long x = p->rcClient.left + tkHost_Scale( h, 14 + i * 27 )
            tkRect_Set( rc, x, p->rcClient.bottom - tkHost_Scale( h, 14 + vals(i) ), x + tkHost_Scale( h, 18 ), p->rcClient.bottom - tkHost_Scale( h, 14 ) )
            p->b->PaintGradientRect( @rc, t.AccentHot, t.Accent )
        next
    elseif w->ctrlId = 3 then
        DrawLine( p->b, "see-through", tkHost_Scale( h, 8 ), tkHost_Scale( h, 4 ), w->cw, tkHost_Scale( h, 26 ), t.TextStrong )
    else
        dim as ustring names(10 to 13) = { "outer (Surface, border)", "inner (Window, border)", "innermost (Accent)", "sibling (Selected, no border)" }
        DrawLine( p->b, names(w->ctrlId), tkHost_Scale( h, 8 ), tkHost_Scale( h, 4 ), w->cw - tkHost_Scale( h, 4 ), tkHost_Scale( h, 26 ), iif( w->ctrlId = 12, t.TextStrong, t.Text ) )
    end if
end sub

private sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    dim as TKTHEME_COLORS t = tkTheme_Of( tkHost_Root( h ) )
    dim as ustring caps(0 to 3) = { "Line border, theme", "Pinned back + border", "Transparent, border", "Paint callback" }
    for i as long = 0 to 3
        DrawLine( b, caps(i), tkHost_Scale( h, 20 + i * 175 ), tkHost_Scale( h, 12 ), tkHost_Scale( h, 180 + i * 175 ), tkHost_Scale( h, 36 ), t.TextDim )
    next
    DrawLine( b, "Nested: each child is placed relative to its parent panel", tkHost_Scale( h, 20 ), tkHost_Scale( h, 186 ), tkHost_Scale( h, 700 ), tkHost_Scale( h, 210 ), t.TextDim )
    ' stripes painted by the form, seen through the transparent panel
    b->SetBackColor( t.Divider )
    for x as long = 370 to 524 step 12
        dim as TKRECT rc
        tkRect_Set( rc, tkHost_Scale( h, x ), tkHost_Scale( h, 40 ), tkHost_Scale( h, x + 6 ), tkHost_Scale( h, 170 ) )
        b->PaintRect( @rc )
    next
end sub

private function NewPanel( byval hParent as TK_WIDGET ptr, byval id as long, byval x as long, byval y as long, byval w as long, byval hgt as long ) as TK_WIDGET ptr
    dim as TK_WIDGET ptr P = tkPanel_Create( hParent, id )
    tkWidget_SetPos( P, tkHost_Scale( gHost, x ), tkHost_Scale( gHost, y ), tkHost_Scale( gHost, w ), tkHost_Scale( gHost, hgt ) )
    return P
end function

private sub SaveShot( byval h as TK_HOST ptr, byref path as string )
    tkHost_Render( h )
    tkHost_RenderTo( h, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( h->renderer, 0 )
    if s then
        SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & h->fScale
        SDL_DestroySurface( s )
    end if
end sub

if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
gHost = tkHost_Create( "tkPanel on SDL3", 720, 420, tkHost_FontDir() & TK_FONT_UI, val( ArgValue( "--scale" ) ) )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
dim as TKTHEME_COLORS t = tkTheme_Of( tkHost_Root( gHost ) )
gHost->clrBack = t.Window
gFont = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 10 )
dim as TK_WIDGET ptr root = tkHost_Root( gHost )

dim as TK_WIDGET ptr p1 = NewPanel( root, 1, 20, 40, 160, 130 )
tkPanel_SetBorderStyle( p1, PNL_BORDER_LINE )

dim as TK_WIDGET ptr p2 = NewPanel( root, 2, 195, 40, 160, 130 )
tkPanel_SetBackColor( p2, t.Surface )
tkPanel_SetBorderColor( p2, t.Accent )
tkPanel_SetBorderStyle( p2, PNL_BORDER_LINE )

dim as TK_WIDGET ptr p3 = NewPanel( root, 3, 370, 40, 160, 130 )
tkPanel_SetTransparent( p3, true )
tkPanel_SetBorderStyle( p3, PNL_BORDER_LINE )      ' the frame alone: the stripes show inside
tkPanel_SetPaintCallback( p3, @Panel_Paint )

dim as TK_WIDGET ptr p4 = NewPanel( root, 4, 545, 40, 160, 130 )
tkPanel_SetBackColor( p4, t.Surface )
tkPanel_SetPaintCallback( p4, @Panel_Paint )

' three deep, plus a sibling: every position is relative to the parent panel
dim as TK_WIDGET ptr outer = NewPanel( root, 10, 20, 214, 685, 190 )
tkPanel_SetBackColor( outer, t.Surface )
tkPanel_SetBorderStyle( outer, PNL_BORDER_LINE )
dim as TK_WIDGET ptr inner = NewPanel( outer, 11, 16, 34, 320, 140 )
tkPanel_SetBorderStyle( inner, PNL_BORDER_LINE )
dim as TK_WIDGET ptr innermost = NewPanel( inner, 12, 16, 34, 200, 90 )
tkPanel_SetBackColor( innermost, t.Accent )
dim as TK_WIDGET ptr sibling = NewPanel( outer, 13, 350, 34, 318, 140 )
tkPanel_SetBackColor( sibling, t.Selected )
tkPanel_SetPaintCallback( outer, @Panel_Paint )
tkPanel_SetPaintCallback( inner, @Panel_Paint )
tkPanel_SetPaintCallback( innermost, @Panel_Paint )
tkPanel_SetPaintCallback( sibling, @Panel_Paint )

gHost->OnPaint = @Form_Paint
tkHost_Show( gHost )

dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )
    SaveShot( gHost, shot )
else
    tkHost_Run( gHost )
end if
tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
