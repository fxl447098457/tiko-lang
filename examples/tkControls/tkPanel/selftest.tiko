' tkPanel self-test. Real windows; scale pinned at 1.0 and 1.75.
#import "vendor/tkControls/tkPanel"
#import "vendor/tkControls/tkTest"
using tkPanel
using tkTheme
using tkTest
using tkHost
using tkPaint

dim shared as long gPaints

sub OnPaint( byval p as TKPANEL_PAINTINFO ptr )
    gPaints += 1
    p->b->SetBackColor( &hFF00FF00ul )
    dim as TKRECT rc
    tkRect_Set( rc, 0, 0, 5, 5 )
    p->b->PaintRect( @rc )
end sub

sub RunPass( byval fScale as single )
    tkTest_Begin( "scale " & fScale )
    dim as TK_HOST ptr h = tkHost_Create( "tkPanel selftest", 640, 480, tkHost_FontDir() & TK_FONT_UI, fScale )
    h->clrBack = &hFF102030ul
    dim as TK_WIDGET ptr P = tkPanel_Create( tkHost_Root( h ), 1 )
    dim as TK_WIDGET ptr child = tkPanel_Create( P, 2 )
    tkHost_Show( h )
    tkWidget_SetPos( P, 40, 40, 200, 100 )
    tkWidget_SetPos( child, 10, 10, 50, 50 )
    tkTest_PumpFor( h, 50 )

    tkTest_Check( "not a tab stop", P->isFocusable = false )
    tkTest_Check( "children are relative to it", tkHost_HitTest( h, 40 + 15, 40 + 15 ) = child )
    tkPanel_SetBackColor( P, &hFFAA0000ul )
    tkPanel_SetBackColor( child, &hFF0000AAul )
    tkHost_RenderTo( h, false )
    tkTest_Check( "back colour paints", (tkTest_PixelAt( h, 200, 120 ) and &hFFFFFFul) = &hAA0000ul, hex( tkTest_PixelAt( h, 200, 120 ) ) )
    tkTest_Check( "the child paints over it", (tkTest_PixelAt( h, 60, 60 ) and &hFFFFFFul) = &h0000AAul, hex( tkTest_PixelAt( h, 60, 60 ) ) )
    tkTest_Check( "back colour reads back", tkPanel_GetBackColor( P ) = &hFFAA0000ul )

    tkPanel_SetBorderColor( P, &hFF00FF00ul )
    tkPanel_SetBorderStyle( P, PNL_BORDER_LINE )
    tkTest_Check( "border style reads back", tkPanel_GetBorderStyle( P ) = PNL_BORDER_LINE )
    tkHost_RenderTo( h, false )
    tkTest_Check( "the border draws on the edge", (tkTest_PixelAt( h, 140, 40 ) and &hFFFFFFul) = &h00FF00ul, hex( tkTest_PixelAt( h, 140, 40 ) ) )
    tkPanel_SetBorderStyle( P, 42 )
    tkTest_Check( "an unknown style means none", tkPanel_GetBorderStyle( P ) = PNL_BORDER_NONE )

    tkPanel_SetTransparent( P, true )
    tkHost_RenderTo( h, false )
    tkTest_Check( "transparent shows the window", (tkTest_PixelAt( h, 200, 120 ) and &hFFFFFFul) = &h102030ul, hex( tkTest_PixelAt( h, 200, 120 ) ) )
    tkPanel_SetTransparent( P, false )

    gPaints = 0
    tkPanel_SetPaintCallback( P, @OnPaint )
    tkHost_RenderTo( h, false )
    tkTest_Check( "paint callback runs", gPaints > 0 )
    tkTest_Check( "it draws in the panel's coordinates", (tkTest_PixelAt( h, 42, 42 ) and &hFFFFFFul) = &h00FF00ul, hex( tkTest_PixelAt( h, 42, 42 ) ) )

    tkPanel_UnpinColors( P )
    tkTest_Check( "unpin returns to the theme", tkPanel_GetBackColor( P ) = tkTheme_Get().Window )
    tkHost_Destroy( h )
end sub

if tkTest_Init() = false then end 99
RunPass( 1.0 )
RunPass( 1.75 )
dim as long nFail = tkTest_Report( "tkPanel" )
tkTest_Quit()
end nFail
