' tkPicture self-test. Real windows; scale pinned at 1.0 and 1.75. The image is built from pixels.
#import "vendor/tkControls/tkPicture"
#import "vendor/tkControls/tkTest"
using tkPicture
using tkImage
using tkTheme
using tkTest
using tkHost
using tkPaint

dim shared as long gClicks

sub OnClick( byval h as TK_WIDGET ptr, byval id as long )
    gClicks += 1
end sub

sub RunPass( byval fScale as single )
    tkTest_Begin( "scale " & fScale )
    dim as TK_HOST ptr h = tkHost_Create( "tkPicture selftest", 640, 480, tkHost_FontDir() & TK_FONT_UI, fScale )
    h->clrBack = &hFF102030ul
    dim as TK_WIDGET ptr P = tkPicture_Create( tkHost_Root( h ), 1 )
    tkHost_Show( h )
    tkWidget_SetPos( P, 40, 40, 200, 100 )
    tkTest_PumpFor( h, 50 )
    tkTest_Check( "not a tab stop", P->isFocusable = false )
    tkTest_Check( "starts empty", tkPicture_HasImage( P ) = false )

    dim as long nw, nh
    tkPicture_GetNaturalSize( P, nw, nh )
    tkTest_Check( "an empty picture has no size", (nw = 0) andalso (nh = 0) )
    tkTest_Check( "a missing file is refused", tkPicture_SetFile( P, "no-such-image.png" ) = false )
    tkTest_Check( "...and leaves it empty", tkPicture_HasImage( P ) = false )

    ' 20 x 20, solid red.
    dim as ulong px( 0 to 399 )
    for i as long = 0 to 399
        px(i) = &hFFFF0000ul
    next
    dim as tkImageFile img
    tkTest_Check( "image built", img.LoadFromPixels( 20, 20, @px(0) ) <> 0 )
    tkPicture_SetImage( P, @img )
    tkTest_Check( "has an image", tkPicture_HasImage( P ) )
    tkPicture_GetNaturalSize( P, nw, nh )
    tkTest_Check( "natural size", (nw = 20) andalso (nh = 20), nw & "x" & nh )

    tkPicture_SetFit( P, TK_IMGFIT_STRETCH )
    tkTest_Check( "fit reads back", tkPicture_GetFit( P ) = TK_IMGFIT_STRETCH )
    tkHost_RenderTo( h, false )
    tkTest_Check( "stretch reaches the left", (tkTest_PixelAt( h, 44, 90 ) and &hFFFFFFul) = &hFF0000ul, hex( tkTest_PixelAt( h, 44, 90 ) ) )
    tkTest_Check( "stretch reaches the right", (tkTest_PixelAt( h, 236, 90 ) and &hFFFFFFul) = &hFF0000ul, hex( tkTest_PixelAt( h, 236, 90 ) ) )

    tkPicture_SetFit( P, TK_IMGFIT_ASPECT )
    tkHost_RenderTo( h, false )
    tkTest_Check( "aspect paints the middle", (tkTest_PixelAt( h, 140, 90 ) and &hFFFFFFul) = &hFF0000ul, hex( tkTest_PixelAt( h, 140, 90 ) ) )
    tkTest_Check( "aspect leaves the sides", (tkTest_PixelAt( h, 44, 90 ) and &hFFFFFFul) = &h102030ul, hex( tkTest_PixelAt( h, 44, 90 ) ) )

    tkPicture_SetFit( P, TK_IMGFIT_CENTER )
    tkHost_RenderTo( h, false )
    tkTest_Check( "center paints the middle", (tkTest_PixelAt( h, 140, 90 ) and &hFFFFFFul) = &hFF0000ul, hex( tkTest_PixelAt( h, 140, 90 ) ) )
    tkTest_Check( "center leaves above it", (tkTest_PixelAt( h, 140, 45 ) and &hFFFFFFul) = &h102030ul, hex( tkTest_PixelAt( h, 140, 45 ) ) )
    tkPicture_SetFit( P, 99 )
    tkTest_Check( "a bad fit is refused", tkPicture_GetFit( P ) = TK_IMGFIT_CENTER )

    tkPicture_SetBackColor( P, &hFF00AA00ul )
    tkHost_RenderTo( h, false )
    tkTest_Check( "back colour shows around the image", (tkTest_PixelAt( h, 140, 45 ) and &hFFFFFFul) = &h00AA00ul, hex( tkTest_PixelAt( h, 140, 45 ) ) )

    gClicks = 0
    tkTest_Click( h, tkTest_CX( P ), tkTest_CY( P ) )
    tkTest_PumpFor( h, 20 )
    tkTest_Check( "no callback: no click", gClicks = 0 )
    tkPicture_SetClickCallback( P, @OnClick )
    tkTest_Click( h, tkTest_CX( P ), tkTest_CY( P ) )
    tkTest_PumpFor( h, 20 )
    tkTest_Check( "click notifies", gClicks = 1, str( gClicks ) )

    tkPicture_SetImage( P, 0 )
    tkTest_Check( "emptied", tkPicture_HasImage( P ) = false )
    tkHost_Destroy( h )
end sub

if tkTest_Init() = false then end 99
RunPass( 1.0 )
RunPass( 1.75 )
dim as long nFail = tkTest_Report( "tkPicture" )
tkTest_Quit()
end nFail
