' tkPicture demo: one image built from pixels in each fit (aspect, stretch, center), an image with
' alpha on a transparent picture and on a back colour, and an empty picture. Click a picture: its
' fit cycles, and the click is printed.
'
'   demo                     run it
'   demo --shot out.bmp      render once, save the window, exit
'   demo --scale 1.75        pin the scale
#import "vendor/tkControls/tkPicture"
using tkPicture
using tkImage
using tkTheme
using tkHost
using tkPaint

dim shared as TK_HOST ptr gHost
dim shared as TTF_Font ptr gFont
dim shared as tkImageFile gPhoto, gDot      ' borrowed by the pictures: they outlive them

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

private function HasArg( byref name_ as string ) as boolean
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return true
    next
    return false
end function

' 96 x 40: a wide colour ramp with a white frame and diagonal, so the fits are easy to tell apart.
private sub BuildPhoto( )
    dim as ulong px( 0 to 96 * 40 - 1 )
    for y as long = 0 to 39
        for x as long = 0 to 95
            dim as ulong c = tkRGB( x * 255 \ 95, y * 255 \ 39, 170 )
            if (x < 2) orelse (x > 93) orelse (y < 2) orelse (y > 37) orelse (abs( x * 40 \ 96 - y ) < 1) then c = tkRGB( 255, 255, 255 )
            px(y * 96 + x) = c
        next
    next
    gPhoto.LoadFromPixels( 96, 40, @px(0) )
end sub

' 96 x 96: an orange disc whose outside is fully transparent and whose edge is anti-aliased.
private sub BuildDot( )
    dim as ulong px( 0 to 96 * 96 - 1 )
    for y as long = 0 to 95
        for x as long = 0 to 95
            dim as single d = sqr( (x - 47.5) ^ 2 + (y - 47.5) ^ 2 )
            dim as long a = cint( (46 - d) * 255 )
            if a < 0 then a = 0
            if a > 255 then a = 255
            px(y * 96 + x) = tkRGBA( 245, 140, 40, a )
        next
    next
    gDot.LoadFromPixels( 96, 96, @px(0) )
end sub

private sub Picture_Click( byval hPicture as TK_WIDGET ptr, byval id as long )
    dim as long nFit = (tkPicture_GetFit( hPicture ) + 1) mod 3      ' ASPECT, STRETCH, CENTER
    tkPicture_SetFit( hPicture, nFit )
    dim as long nw, nh
    tkPicture_GetNaturalSize( hPicture, nw, nh )
    print "PictureClick " & id & ": fit " & nFit & ", natural " & nw & "x" & nh & ", has image " & tkPicture_HasImage( hPicture )
end sub

private sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    dim as ustring caps(0 to 5) = { "ASPECT (the default)", "STRETCH", "CENTER (natural size)", _
        "Alpha, transparent picture", "Alpha on a back colour", "Empty: back colour only" }
    b->SetFont( gFont )
    b->SetForeColor( tkTheme_Of( tkHost_Root( h ) ).TextDim )
    for i as long = 0 to 5
        dim as TKRECT rc
        dim as long x = 20 + (i mod 3) * 235, y = 12 + (i \ 3) * 190
        tkRect_Set( rc, tkHost_Scale( h, x ), tkHost_Scale( h, y ), tkHost_Scale( h, x + 220 ), tkHost_Scale( h, y + 24 ) )
        b->PaintText( caps(i), @rc, TK_DT_LEFT or TK_DT_VCENTER )
    next
    ' stripes painted by the form, seen around the disc on the transparent picture
    b->SetBackColor( tkTheme_Of( tkHost_Root( h ) ).Divider )
    for x as long = 20 to 224 step 12
        dim as TKRECT rc
        tkRect_Set( rc, tkHost_Scale( h, x ), tkHost_Scale( h, 230 ), tkHost_Scale( h, x + 6 ), tkHost_Scale( h, 370 ) )
        b->PaintRect( @rc )
    next
end sub

private sub SaveShot( byval h as TK_HOST ptr, byref path as string )
    tkHost_Render( h )
    tkHost_RenderTo( h, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( h->renderer, 0 )
    if s then
        SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & h->fScale
        SDL_DestroySurface( s )
    end if
end sub

if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
gHost = tkHost_Create( "tkPicture on SDL3", 720, 390, tkHost_FontDir() & TK_FONT_UI, val( ArgValue( "--scale" ) ) )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
dim as TKTHEME_COLORS t = tkTheme_Of( tkHost_Root( gHost ) )
gHost->clrBack = t.Window
gFont = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 10 )
BuildPhoto( )
BuildDot( )

dim as TK_WIDGET ptr pic(0 to 5)
for i as long = 0 to 5
    pic(i) = tkPicture_Create( tkHost_Root( gHost ), 1 + i )
    tkWidget_SetPos( pic(i), tkHost_Scale( gHost, 20 + (i mod 3) * 235 ), tkHost_Scale( gHost, 40 + (i \ 3) * 190 ), _
                     tkHost_Scale( gHost, 210 ), tkHost_Scale( gHost, 140 ) )
    tkPicture_SetClickCallback( pic(i), @Picture_Click )
next
for i as long = 0 to 2
    tkPicture_SetImage( pic(i), @gPhoto )
    tkPicture_SetBackColor( pic(i), t.Surface )      ' shows where the image does not reach
next
tkPicture_SetFit( pic(1), TK_IMGFIT_STRETCH )
tkPicture_SetFit( pic(2), TK_IMGFIT_CENTER )
tkPicture_SetImage( pic(3), @gDot )                  ' transparent by default: the form shows through
tkPicture_SetImage( pic(4), @gDot )
tkPicture_SetFit( pic(4), TK_IMGFIT_CENTER )
tkPicture_SetBackColor( pic(4), t.Accent )
tkPicture_SetBackColor( pic(5), t.Surface )          ' no image at all

gHost->OnPaint = @Form_Paint
tkHost_Show( gHost )

dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )
    SaveShot( gHost, shot )
else
    tkHost_Run( gHost )
end if
tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
