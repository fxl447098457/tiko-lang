' tkContextMenu demo: two right-click menus. One is attached to a text box and replaces the box's
' own menu (Clear is enabled only when there is text, Read only is a check, Insert is a submenu);
' the other is attached to a panel, so the label inside the panel opens it too, and a button
' opens it from code. The Menu key or Shift+F10 opens the focused widget's menu.
'
'   demo                          run it
'   demo --shot out.bmp           render once, save the window, exit
'   demo --shot out.bmp --open    the same with the text box's menu and its Insert submenu open
'                                 (also out.bmp.pop.bmp and out.bmp.sub.bmp)
'   demo --scale 1.75             pin the scale
#import "vendor/tkControls/tkContextMenu"
#import "vendor/tkControls/tkTextBox"
#import "vendor/tkControls/tkPanel"
#import "vendor/tkControls/tkLabel"
#import "vendor/tkControls/tkButton"
using tkContextMenu
using tkPopupMenu
using tkTextBox
using tkPanel
using tkLabel
using tkButton
using tkTheme
using tkHost
using tkPaint

enum
    IDM_CLEAR = 300, IDM_UPPER, IDM_LOWER, IDM_INSERT, IDM_DATE, IDM_SIGN, IDM_READONLY
    IDM_RED = 400, IDM_GREEN, IDM_BLUE, IDM_BORDER
end enum

dim shared as TK_HOST ptr gHost
dim shared as TK_WIDGET ptr gText, gPanel, gInner, gButton, gCtxText, gCtxPanel
dim shared as TTF_Font ptr gFont
dim shared as long gColour = IDM_BLUE

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

private function HasArg( byref name_ as string ) as boolean
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return true
    next
    return false
end function

private function WidgetName( byval w as TK_WIDGET ptr ) as string
    select case w
    case gText   : return "text box"
    case gPanel  : return "panel"
    case gInner  : return "label"
    case gButton : return "button"
    end select
    return "(none)"
end function

private sub Text_Popup( byval hCtx as TK_WIDGET ptr, byval hSource as TK_WIDGET ptr )
    dim as TK_MENU ptr m = tkContextMenu_GetMenu( hCtx )
    tkPopupMenu_SetItemEnabled( m, IDM_CLEAR, tkTextBox_GetTextLength( gText ) > 0 )
    tkPopupMenu_SetItemChecked( m, IDM_READONLY, tkTextBox_GetReadOnly( gText ) )
    print "Popup (text menu) for " & WidgetName( hSource )
end sub

private sub Text_Command( byval hCtx as TK_WIDGET ptr, byval id as long )
    print "Command " & id & " (text menu)"
    select case id
    case IDM_CLEAR    : tkTextBox_SetText( gText, "" )
    case IDM_UPPER    : tkTextBox_SetText( gText, ucase( tkTextBox_GetText( gText ) ) )
    case IDM_LOWER    : tkTextBox_SetText( gText, lcase( tkTextBox_GetText( gText ) ) )
    case IDM_DATE     : tkTextBox_SetText( gText, tkTextBox_GetText( gText ) & " " & date )
    case IDM_SIGN     : tkTextBox_SetText( gText, tkTextBox_GetText( gText ) & " -- tiko" )
    case IDM_READONLY : tkTextBox_SetReadOnly( gText, tkTextBox_GetReadOnly( gText ) = false )
    end select
end sub

private sub Panel_Popup( byval hCtx as TK_WIDGET ptr, byval hSource as TK_WIDGET ptr )
    dim as TK_MENU ptr m = tkContextMenu_GetMenu( hCtx )
    for id as long = IDM_RED to IDM_BLUE
        tkPopupMenu_SetItemChecked( m, id, id = gColour )
    next
    tkPopupMenu_SetItemChecked( m, IDM_BORDER, tkPanel_GetBorderStyle( gPanel ) = PNL_BORDER_LINE )
    print "Popup (panel menu) for " & WidgetName( hSource )
end sub

private sub ApplyColour()
    select case gColour
    case IDM_RED   : tkPanel_SetBackColor( gPanel, &hFF6A2E2Eul )
    case IDM_GREEN : tkPanel_SetBackColor( gPanel, &hFF2E5A36ul )
    case IDM_BLUE  : tkPanel_SetBackColor( gPanel, &hFF2E4468ul )
    end select
end sub

private sub Panel_Command( byval hCtx as TK_WIDGET ptr, byval id as long )
    print "Command " & id & " (panel menu, opened for " & WidgetName( tkContextMenu_GetSource( hCtx ) ) & ")"
    select case id
    case IDM_RED to IDM_BLUE : gColour = id : ApplyColour()
    case IDM_BORDER : tkPanel_SetBorderStyle( gPanel, iif( tkPanel_GetBorderStyle( gPanel ) = PNL_BORDER_LINE, PNL_BORDER_NONE, PNL_BORDER_LINE ) )
    end select
end sub

private sub Button_Click( byval h as TK_WIDGET ptr, byval id as long )
    tkContextMenu_ShowFor( gCtxPanel, gButton )
end sub

private sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    dim as ustring heads(0 to 2) = { "Text box: this menu replaces its own", "Panel: the label inside opens it too", _
                                     "Right-click, or focus the text box and press the Menu key or Shift+F10." }
    b->SetFont( gFont )
    b->SetForeColor( tkTheme_Of( tkHost_Root( h ) ).TextDim )
    for i as long = 0 to 2
        dim as TKRECT rc
        dim as long x = iif( i = 1, 370, 20 ), y = iif( i = 2, 236, 10 )
        tkRect_Set( rc, tkHost_Scale( h, x ), tkHost_Scale( h, y ), tkHost_Scale( h, x + 680 ), tkHost_Scale( h, y + 24 ) )
        b->PaintText( heads(i), @rc, TK_DT_LEFT or TK_DT_VCENTER )
    next
end sub

private sub Form_Size( byval h as TK_HOST ptr )
    tkWidget_SetPos( gText, tkHost_Scale( h, 20 ), tkHost_Scale( h, 36 ), tkHost_Scale( h, 330 ), tkHost_Scale( h, 140 ) )
    tkWidget_SetPos( gPanel, tkHost_Scale( h, 370 ), tkHost_Scale( h, 36 ), tkHost_Scale( h, 330 ), tkHost_Scale( h, 140 ) )
    tkWidget_SetPos( gInner, tkHost_Scale( h, 16 ), tkHost_Scale( h, 16 ), tkHost_Scale( h, 298 ), tkHost_Scale( h, 108 ) )
    tkWidget_SetPos( gButton, tkHost_Scale( h, 370 ), tkHost_Scale( h, 190 ), tkHost_Scale( h, 180 ), tkHost_Scale( h, 30 ) )
end sub

private sub SaveShot( byval h as TK_HOST ptr, byref path as string )
    tkHost_Render( h )
    tkHost_RenderTo( h, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( h->renderer, 0 )
    if s then
        SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & h->fScale
        SDL_DestroySurface( s )
    end if
end sub

if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
dim as single forced = val( ArgValue( "--scale" ) )
gHost = tkHost_Create( "tkContextMenu on SDL3", 720, 270, tkHost_FontDir() & TK_FONT_UI, forced )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
gHost->clrBack = tkTheme_Of( tkHost_Root( gHost ) ).Window
gFont = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 10 )

gText = tkTextBox_Create( tkHost_Root( gHost ), 1001, true )
tkTextBox_SetText( gText, "Right-click me: Clear, Upper case, Insert > Date ..." )

gPanel = tkPanel_Create( tkHost_Root( gHost ), 1002 )
tkPanel_SetBorderStyle( gPanel, PNL_BORDER_LINE )
ApplyColour()
gInner = tkLabel_Create( gPanel, 1003 )
tkLabel_SetText( gInner, "A label on the panel, with no menu of its own: right-clicking it opens the panel's." )
tkLabel_SetWordWrap( gInner, true )
tkLabel_SetTransparent( gInner, true )

gButton = tkButton_Create( tkHost_Root( gHost ), 1004 )
tkButton_SetText( gButton, "Open the panel menu" )
tkButton_SetClickCallback( gButton, @Button_Click )

' the text box's menu, with an Insert submenu
gCtxText = tkContextMenu_Create( tkHost_Root( gHost ), 2001 )
dim as TK_MENU ptr m = tkContextMenu_GetMenu( gCtxText )
tkPopupMenu_AddItem( m, IDM_CLEAR, "Clear" )
tkPopupMenu_AddItem( m, IDM_UPPER, "Upper case" )
tkPopupMenu_AddItem( m, IDM_LOWER, "Lower case" )
tkPopupMenu_AddSeparator( m )
tkPopupMenu_AddItem( m, IDM_INSERT, "Insert" )
dim as TK_MENU ptr sm = tkPopupMenu_Create( gHost )
tkPopupMenu_AddItem( sm, IDM_DATE, "Today's date" )
tkPopupMenu_AddItem( sm, IDM_SIGN, "Signature" )
tkPopupMenu_SetItemSubMenu( m, IDM_INSERT, sm )
tkPopupMenu_AddSeparator( m )
tkPopupMenu_AddItem( m, IDM_READONLY, "Read only" )
tkContextMenu_SetPopupCallback( gCtxText, @Text_Popup )
tkContextMenu_SetCommandCallback( gCtxText, @Text_Command )
tkContextMenu_Attach( gCtxText, gText )

' the panel's menu: a colour choice and a check
gCtxPanel = tkContextMenu_Create( tkHost_Root( gHost ), 2002 )
m = tkContextMenu_GetMenu( gCtxPanel )
tkPopupMenu_AddItem( m, IDM_RED, "Red" )
tkPopupMenu_AddItem( m, IDM_GREEN, "Green" )
tkPopupMenu_AddItem( m, IDM_BLUE, "Blue" )
tkPopupMenu_AddSeparator( m )
tkPopupMenu_AddItem( m, IDM_BORDER, "Border" )
tkContextMenu_SetPopupCallback( gCtxPanel, @Panel_Popup )
tkContextMenu_SetCommandCallback( gCtxPanel, @Panel_Command )
tkContextMenu_Attach( gCtxPanel, gPanel )

gHost->OnPaint = @Form_Paint
gHost->OnSize = @Form_Size
Form_Size( gHost )
tkHost_SetFocus( gHost, gText )
tkHost_Show( gHost )

dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )
    if HasArg( "--open" ) then
        tkContextMenu_Show( gCtxText, gText->x + tkHost_Scale( gHost, 60 ), gText->y + tkHost_Scale( gHost, 40 ), gText )
        for k as long = 1 to 5
            tkHost_Pump( gHost )
            SDL_Delay( 15 )
        next
        dim as TK_MENU ptr root = tkContextMenu_GetMenu( gCtxText )
        tkPopupMenu_OpenSubMenu( root, 4, true )      ' row 4 is Insert
        for k as long = 1 to 10
            tkHost_Pump( gHost )
            SDL_Delay( 15 )
        next
        if tkPopupMenu_Surface( root ) then SaveShot( tkPopupMenu_Surface( root ), shot & ".pop.bmp" )
        if tkPopupMenu_Surface( sm ) then SaveShot( tkPopupMenu_Surface( sm ), shot & ".sub.bmp" )
    end if
    SaveShot( gHost, shot )
else
    tkHost_Run( gHost )
end if
tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
