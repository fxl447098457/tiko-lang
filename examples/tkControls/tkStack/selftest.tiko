' tkStack self-test. The arithmetic first, with no window (a stack with no parent works in pixels):
' fixed, hidden, FILL by weight, alignment, a horizontal stack, a nested card, a measured item; every
' rectangle asserted. Then real widgets in a host at scale 1 and 1.75: design units scaled, a hidden
' item giving its space back, ApplyToParent growing a scroll panel's panel.
'
'   selftest            exit code = number of failures
#import "vendor/tkControls/tkStack"
#import "vendor/tkControls/tkPanel"
#import "vendor/tkControls/tkTest"
using tkStack
using tkPanel
using tkTest
using tkHost
using tkPaint

sub CheckRect( byref what as string, byref got as TKRECT, byval l as long, byval t as long, byval r as long, byval b as long )
    tkTest_Check( what, (got.left = l) andalso (got.top = t) andalso (got.right = r) andalso (got.bottom = b), _
                  "got " & tkRect_Str( got ) & " want " & l & "," & t & "," & r & "," & b )
end sub

' A measured item: half its cross extent, as a wrapped label's height depends on its width.
function HalfOf( byval w as TK_WIDGET ptr, byval crossPx as long ) as long
    return crossPx \ 2
end function

' A widget with no host: tkStack_Layout reads only isVisible, and moves nothing.
function W_( ) as TK_WIDGET ptr
    return new TK_WIDGET
end function

sub Arithmetic( )
    tkTest_Begin( "arithmetic" )
    dim as TKRECT rc, o( 0 to 7 )
    tkRect_Set( rc, 0, 0, 200, 300 )
    ' a column: padding 10/8, gap 4; 30, 40, a hidden 50, a FILL (min 10), 20
    dim as TK_STACK ptr s = tkStack_Create( 0 )
    tkStack_SetPadding( s, 10, 8, 10, 8 ) : tkStack_SetGap( s, 4 )
    dim as TK_WIDGET ptr a = W_( ), b = W_( ), hid = W_( ), f = W_( ), z = W_( )
    hid->isVisible = false
    tkStack_Add( s, a, 30 ) : tkStack_Add( s, b, 40 ) : tkStack_Add( s, hid, 50 )
    tkStack_AddFill( s, f, 1, 10 ) : tkStack_Add( s, z, 20 )
    tkStack_Layout( s, rc, @o(0) )
    CheckRect( "first item under the top padding", o(0), 10, 8, 190, 38 )
    CheckRect( "second after the gap", o(1), 10, 42, 190, 82 )
    CheckRect( "a hidden item: empty, no space, no gap", o(2), 0, 0, 0, 0 )
    ' room 284; fixed 30 + 40 + 20, gaps 3 * 4, the fill's minimum 10 = 112; spare 172 -> fill 182
    CheckRect( "FILL takes the rest (plus its minimum)", o(3), 10, 86, 190, 268 )
    CheckRect( "the last item ends on the bottom padding", o(4), 10, 272, 190, 292 )
    tkTest_Check( "Measure: padding, gaps, FILL at its minimum, no hidden item", _
                  tkStack_Measure( s, 200 ) = 8 + 30 + 4 + 40 + 4 + 10 + 4 + 20 + 8, "" & tkStack_Measure( s, 200 ) )
    tkStack_SetSpaceBefore( s, 6 )
    tkStack_Layout( s, rc, @o(0) )
    CheckRect( "SpaceBefore: the last item still ends on the padding", o(4), 10, 272, 190, 292 )
    tkTest_Check( "... the FILL gives the 6 back", o(3).bottom = 262, tkRect_Str( o(3) ) )
    tkStack_Destroy( s )

    ' two FILLs by weight 1 : 2 over 100 -- the last takes the remainder, so the shares add up
    s = tkStack_Create( 0 )
    dim as TK_WIDGET ptr f1 = W_( ), f2 = W_( )
    tkStack_AddFill( s, f1, 1 ) : tkStack_AddFill( s, f2, 2 )
    tkRect_Set( rc, 0, 0, 50, 100 )
    tkStack_Layout( s, rc, @o(0) )
    CheckRect( "weight 1 of 3: 33", o(0), 0, 0, 50, 33 )
    CheckRect( "weight 2 of 3: the remainder, 67", o(1), 0, 33, 50, 100 )
    tkStack_Destroy( s )

    ' alignment across, with a cross size; a measured item
    s = tkStack_Create( 0 )
    dim as TK_WIDGET ptr c1 = W_( ), c2 = W_( ), c3 = W_( ), m = W_( )
    tkStack_Add( s, c1, 10 ) : tkStack_SetAlign( s, TK_STACK_CENTER, 60 )
    tkStack_Add( s, c2, 10 ) : tkStack_SetAlign( s, TK_STACK_END, 60 )
    tkStack_Add( s, c3, 10 ) : tkStack_SetAlign( s, TK_STACK_START, 500 )
    tkStack_AddFunc( s, m, @HalfOf )
    tkRect_Set( rc, 0, 0, 200, 300 )
    tkStack_Layout( s, rc, @o(0) )
    CheckRect( "CENTER", o(0), 70, 0, 130, 10 )
    CheckRect( "END", o(1), 140, 10, 200, 20 )
    CheckRect( "a cross size over the stack's is the stack's", o(2), 0, 20, 200, 30 )
    CheckRect( "a measured item gets its own extent for the width", o(3), 0, 30, 200, 130 )
    tkStack_Destroy( s )

    ' a row
    s = tkStack_Create( 0, TK_STACK_HORIZONTAL )
    tkStack_SetPadding( s, 2, 3, 4, 5 ) : tkStack_SetGap( s, 6 )
    dim as TK_WIDGET ptr h1 = W_( ), h2 = W_( )
    tkStack_Add( s, h1, 40 ) : tkStack_AddFill( s, h2 )
    tkRect_Set( rc, 0, 0, 200, 50 )
    tkStack_Layout( s, rc, @o(0) )
    CheckRect( "a row: across the padding", o(0), 2, 3, 42, 45 )
    CheckRect( "a row: FILL to the right padding", o(1), 48, 3, 196, 45 )
    tkTest_Check( "a row measures its width", tkStack_Measure( s, 50 ) = 2 + 40 + 6 + 0 + 4, "" & tkStack_Measure( s, 50 ) )
    tkStack_Destroy( s )

    ' a card: a container whose own stack decides its height
    s = tkStack_Create( 0 )
    tkStack_SetGap( s, 10 )
    dim as TK_WIDGET ptr card = W_( ), x1 = W_( ), x2 = W_( ), after_ = W_( )
    dim as TK_STACK ptr inner = tkStack_Create( 0 )
    tkStack_SetPadding( inner, 16, 16, 16, 16 ) : tkStack_SetGap( inner, 8 )
    tkStack_Add( inner, x1, 48 ) : tkStack_AddFunc( inner, x2, @HalfOf )
    tkStack_AddStack( s, card, inner ) : tkStack_Add( s, after_, 20 )
    tkRect_Set( rc, 0, 0, 300, 1000 )
    tkStack_Layout( s, rc, @o(0) )
    ' the inner cross is 300 - 32 = 268: 16 + 48 + 8 + 134 + 16 = 222
    CheckRect( "a card is as tall as its stack", o(0), 0, 0, 300, 222 )
    CheckRect( "the next item after it", o(1), 0, 232, 300, 252 )
    tkStack_Destroy( s )

    ' a row in a column: the row's height is the size given; its items are laid out across it
    s = tkStack_Create( 0 )
    dim as TK_WIDGET ptr rowW = W_( ), r1 = W_( ), r2 = W_( ), below = W_( )
    dim as TK_STACK ptr row = tkStack_Create( 0, TK_STACK_HORIZONTAL )
    tkStack_SetGap( row, 8 )
    tkStack_AddFill( row, r1 ) : tkStack_Add( row, r2, 96 )
    tkStack_AddStack( s, rowW, row, 48 ) : tkStack_Add( s, below, 18 )
    tkRect_Set( rc, 0, 0, 300, 1000 )
    tkStack_Layout( s, rc, @o(0) )
    CheckRect( "a row in a column: the size given", o(0), 0, 0, 300, 48 )
    CheckRect( "... and the next item under it", o(1), 0, 48, 300, 66 )
    tkTest_Check( "... Measure counts the row's size", tkStack_Measure( s, 300 ) = 66, "" & tkStack_Measure( s, 300 ) )
    ' Remove, then add again: the item moves to the end
    tkStack_Remove( s, rowW )
    tkStack_Add( s, rowW, 10 )
    tkStack_Layout( s, rc, @o(0) )
    CheckRect( "Remove: the next item moves up", o(0), 0, 0, 300, 18 )
    CheckRect( "... and the one added again is last", o(1), 0, 18, 300, 28 )
    tkStack_Destroy( s )
end sub

sub WindowPass( byval fScale as single )
    tkTest_Begin( "window, scale " & fScale )
    dim as TK_HOST ptr h = tkHost_Create( "tkStack selftest", 400, 700, tkHost_FontDir() & TK_FONT_UI, fScale )
    dim as TK_WIDGET ptr pg = tkPanel_Create( tkHost_Root( h ), 1 )
    tkWidget_SetPos( pg, 0, 0, tkHost_Scale( h, 360 ), tkHost_Scale( h, 200 ) )
    dim as TK_STACK ptr s = tkStack_Create( pg )
    tkStack_SetPadding( s, 16, 16, 16, 16 ) : tkStack_SetGap( s, 12 )
    dim as TK_WIDGET ptr p1 = tkPanel_Create( pg, 2 ), p2 = tkPanel_Create( pg, 3 ), p3 = tkPanel_Create( pg, 4 )
    tkStack_Add( s, p1, 48 ) : tkStack_Add( s, p2, 100 ) : tkStack_Add( s, p3, 48 )
    dim as long S16 = tkHost_Scale( h, 16 ), S12 = tkHost_Scale( h, 12 ), S48 = tkHost_Scale( h, 48 ), S100 = tkHost_Scale( h, 100 )
    dim as long ext = tkStack_ApplyToParent( s, true )
    tkTest_Check( "design units scaled: the first item", (p1->x = S16) andalso (p1->y = S16) andalso (p1->ch = S48) andalso (p1->cw = pg->cw - 2 * S16), _
                  p1->x & "," & p1->y & " " & p1->cw & "x" & p1->ch )
    tkTest_Check( "the third below the second and two gaps", p3->y = S16 + S48 + S12 + S100 + S12, "" & p3->y )
    tkTest_Check( "the extent", ext = S16 + S48 + S12 + S100 + S12 + S48 + S16, "" & ext )
    tkWidget_Show( p2, false )
    ext = tkStack_ApplyToParent( s, true )
    tkTest_Check( "hidden: its space and a gap given back", (p3->y = S16 + S48 + S12) andalso (ext = S16 + S48 + S12 + S48 + S16), p3->y & " " & ext )
    tkStack_Destroy( s )
    tkHost_Destroy( h )
end sub

Arithmetic( )
if tkTest_Init() = false then end 99
WindowPass( 1.0 )
WindowPass( 1.75 )
dim as long nFail = tkTest_Report( "tkStack" )
tkTest_Quit()
end nFail
