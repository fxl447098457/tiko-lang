' tkReportBarcode demo (BC4): a product list from SQLite -- name, price, an EAN-13 of the SKU and a QR
' code of a URL built from the id -- as a report, written to PDF and, for a scan check, as page images.
'
'   demo <out.pdf> [<pngdir> <dpi>]
#import "vendor/tkControls/tkReportBarcode"
#import "vendor/tkControls/tkReportSqlite"
#import "vendor/tkControls/tkPdf"
#import "vendor/sqlite3"
using tkReportBarcode
using tkReportSqlite
using tkReport
using tkBarcode
using tkBind
using tkPrint
using tkPdf
using tkHost
using tkPaint

function RF( byval l as single, byval t as single, byval r as single, byval b as single ) as TKRECTF
    dim as TKRECTF rc
    tkRectF_Set( rc, l, t, r, b )
    return rc
end function

if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
dim as string pdfPath = command( 1 ), pngDir = command( 2 )
dim as single dpi = val( command( 3 ) )
if pdfPath = "" then print "usage: demo <out.pdf> [<pngdir> <dpi>]" : end 2

dim as sqlite3 ptr db3
sqlite3_open( ":memory:", @db3 )
sqlite3_exec( db3, "create table p( id integer, name text, price real, sku text );" & _
    "insert into p values (1, 'Widget', 4.5, '5901234123457'), (2, 'Gadget', 12.0, '0012345678905'), " & _
    "(3, 'Sprocket', 0.75, '4006381333931'), (4, 'Flange', 3.2, '9780201379624'), (5, 'Gizmo', 99.0, '4012345678901');", 0, 0, 0 )
tkReportBarcode_Install( )
dim as TK_REPORT ptr r = tkReport_Create( "Products" )
tkReportSqlite_Open( r, db3, "select id, name, price, sku, 'https://tiko-lang.net/p/' || id as url from p order by id" )
dim as TK_RBAND ptr ph = tkReport_GetBand( r, TKRB_PAGE_HEADER )
tkRBand_SetHeight( ph, 24 )
tkRBand_AddLabel( ph, RF( 0, 0, 300, 18 ), "Products" )
tkRBand_AddPageInfo( ph, RF( 300, 0, 480, 18 ) )
dim as TK_RBAND ptr d = tkReport_GetBand( r, TKRB_DETAIL )
tkRBand_SetHeight( d, 92 )
tkRBand_AddField( d, RF( 0, 8, 110, 22 ), tkReport_FindField( r, "name" ) )
tkRBand_AddField( d, RF( 0, 26, 110, 40 ), tkReport_FindField( r, "price" ), "#,##0.00" )
dim as TKBARCODE_SPEC ean
ean.nSymbology = TKBC_EAN13
dim as TKBARCODE_PAGELOOK pl
pl.nAlign = TKBC_ALIGN_LEFT
tkRBand_AddBarcode( d, RF( 120, 4, 330, 88 ), tkReport_FindField( r, "sku" ), ean, @pl )
dim as TKBARCODE_SPEC qr
qr.nSymbology = TKBC_QR
dim as TKBARCODE_PAGELOOK plq
plq.fXdimMm = 0.5
tkRBand_AddBarcode( d, RF( 360, 4, 480, 88 ), tkReport_FindField( r, "url" ), qr, @plq )
dim as TK_PRINTDOC ptr doc = tkReport_Run( r )
print "pages: " & tkPrintDoc_GetPageCount( doc ) & "  pdf: " & tkPrintDoc_ExportPdf( doc, pdfPath )
if (len( pngDir ) > 0) andalso (dpi > 0) then
    for pgi as long = 0 to tkPrintDoc_GetPageCount( doc ) - 1
        dim as SDL_Surface ptr s = tkPrintDoc_RenderSurface( doc, pgi, dpi )
        dim as SDL_Surface ptr x = SDL_ConvertSurface( s, SDL_PIXELFORMAT_XRGB8888 )
        dim as string path = pngDir & "/page" & ( pgi + 1 ) & "_" & dpi & "dpi.bmp"
        SDL_SaveBMP( x, strptr( path ) )
        dim as string pngPath = left( path, len( path ) - 4 ) & ".png"
        IMG_SavePNG( x, strptr( pngPath ) )
        SDL_DestroySurface( x ) : SDL_DestroySurface( s )
        print "page image: " & path
    next
end if
tkPrintDoc_Destroy( doc )
tkReportSqlite_Close( r )
tkReport_Destroy( r )
sqlite3_close( db3 )
TTF_Quit( )
SDL_Quit( )
