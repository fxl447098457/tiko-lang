' tkDateTimePicker self-test (claude-docs docs/tkControls/DATETIMEPICKER-RESULTS.md). Real windows,
' real SDL event queue: input is PUSHED and pumped. Two passes, scale pinned at 1.0 and 1.75.
' Budget: one check per distinct behaviour; what tkTimePicker's suite already proves of the
' shared engine (time entry, the timer, Tab, the spin buttons, the theme) is not repeated here.
'
'   selftest            exit code = number of failures
#import "vendor/tkControls/tkDateTimePicker"
#import "vendor/tkControls/tkDatePicker"
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkBind"
#import "std/chrono"
using tkDateTimePicker
using tkDatePicker
using tkCalendar
using tkTimePanel
using tkTooltip
using tkTheme
using tkTest
using tkBind
using chrono
using tkHost
using tkPaint

dim shared as long gChanged, gDropOpen, gDropClose
dim shared as TKDATETIME gLast
dim shared as boolean gLastHas

sub OnChanged( byval hCtrl as TK_WIDGET ptr, byval pDT as TKDATETIME ptr, byval bHas as boolean )
    gChanged += 1
    gLast = *pDT
    gLastHas = bHas
end sub

sub OnDrop( byval hCtrl as TK_WIDGET ptr, byval isOpen as boolean )
    if isOpen then gDropOpen += 1 else gDropClose += 1
end sub

sub ResetCounts( )
    gChanged = 0 : gDropOpen = 0 : gDropClose = 0
end sub

function DT( byval y as long, byval mo as long, byval d as long, byval hh as long = 0, byval mi as long = 0 ) as TKDATETIME
    return tkTimePanel_MakeDateTime( y, mo, d, hh, mi )
end function

function Iso( byref t as const TKDATETIME ) as string
    if tkTimePanel_IsDateTime( t ) = false then return "(none)"
    return tkTimePanel_FormatIsoDateTime( t, true, false )
end function

function GetDT( byval c as TK_WIDGET ptr ) as TKDATETIME
    dim as TKDATETIME t
    tkDateTimePicker_GetDateTime( c, t )
    return t
end function

function IsDT( byval c as TK_WIDGET ptr, byval y as long, byval mo as long, byval d as long, byval hh as long = 0, byval mi as long = 0 ) as boolean
    return tkTimePanel_SameDateTime( GetDT( c ), DT( y, mo, d, hh, mi ) )
end function

function WX( byval w as TK_WIDGET ptr, byval x as long ) as long
    dim as TKRECT a
    tkWidget_AbsRect( w, a )
    return a.left + x
end function

function WY( byval w as TK_WIDGET ptr, byval y as long ) as long
    dim as TKRECT a
    tkWidget_AbsRect( w, a )
    return a.top + y
end function

sub Keys( byval h as TK_HOST ptr, byref s as const string )
    for i as long = 1 to len( s )
        tkTest_PushKey( h, asc( s, i ) )
    next
end sub

sub Open_( byval h as TK_HOST ptr )
    tkTest_PushKey( h, SDLK_F4 )
    tkTest_PumpFor( h, 150 )
end sub

' The day cell showing d of the displayed month, clicked in the POPUP window.
sub ClickDay( byval c as TK_WIDGET ptr, byval d as long, byval bDouble as boolean = false )
    dim as TK_WIDGET ptr cal = tkDateTimePicker_GetCalendarHandle( c )
    dim as TK_HOST ptr pop = tkDateTimePicker_GetPopup( c )
    if (cal = 0) orelse (pop = 0) then exit sub
    tkHost_RenderTo( pop, false )
    dim as TKDATE sel, st
    tkCalendar_GetSelDate( cal, sel )
    for k as long = 0 to 41
        tkCalendar_GetCellDate( cal, 0, k, st )
        if (st.wDay = d) andalso (st.wMonth = sel.wMonth) then
            dim as TKRECT rc
            tkCalendar_GetDayCellRect( cal, 0, k, rc )
            tkTest_Click( pop, WX( cal, (rc.left + rc.right) \ 2 ), WY( cal, (rc.top + rc.bottom) \ 2 ) )
            if bDouble then tkTest_Click( pop, WX( cal, (rc.left + rc.right) \ 2 ), WY( cal, (rc.top + rc.bottom) \ 2 ), SDL_BUTTON_LEFT, 2 )
            exit sub
        end if
    next
end sub

sub ClickPanelItem( byval c as TK_WIDGET ptr, byval col as long, byval i as long )
    dim as TK_HOST ptr pop = tkDateTimePicker_GetPopup( c )
    dim as TK_WIDGET ptr pnl = tkDateTimePicker_GetPanelHandle( c )
    if (pop = 0) orelse (pnl = 0) then exit sub
    tkHost_RenderTo( pop, false )
    dim as TKRECT r
    tkTimePanel_GetItemRect( pnl, col, i, r )
    tkTest_Click( pop, WX( pnl, (r.left + r.right) \ 2 ), WY( pnl, (r.top + r.bottom) \ 2 ) )
end sub

sub ClickFooter( byval c as TK_WIDGET ptr, byval bOK as boolean )
    dim as TK_WIDGET ptr ft = tkDateTimePicker_GetFooterHandle( c )
    dim as TK_HOST ptr pop = tkDateTimePicker_GetPopup( c )
    if (ft = 0) orelse (pop = 0) then exit sub
    dim as TKRECT rNow, rOK
    tkDateTimePicker_GetFooterButtonRects( c, rNow, rOK )
    if bOK then rNow = rOK
    tkHost_RenderTo( pop, false )
    tkTest_Click( pop, WX( ft, (rNow.left + rNow.right) \ 2 ), WY( ft, (rNow.top + rNow.bottom) \ 2 ) )
end sub

' ==========================================================================================
sub RunPass( byval fScale as single )
    tkTest_Begin( "scale " & fScale )
    dim as TK_HOST ptr h = tkHost_Create( "tkDateTimePicker selftest", 760, 560, tkHost_FontDir() & TK_FONT_UI, fScale )
    if h = 0 then tkTest_Check( "host created", false, *SDL_GetError() ) : exit sub
    tkTest_Check( "scale pinned", h->fScale = fScale, "" & h->fScale )
    tkHost_Show( h )
    dim as TK_WIDGET ptr root = tkHost_Root( h )

    ' ---- A: defaults, the sibling layout ---------------------------------------------------------
    dim as TK_WIDGET ptr c = tkDateTimePicker_Create( root, 900 )
    tkTest_Check( "defaults: yyyy-MM-dd HH:mm, AllowEmpty, no value", tkDateTimePicker_GetFormat( c ) = "yyyy-MM-dd HH:mm" _
                  andalso tkDateTimePicker_GetAllowEmpty( c ) andalso tkDateTimePicker_HasDateTime( c ) = false andalso tkDateTimePicker_GetText( c ) = "" )
    tkTest_Check( "segments: year - month - day hour : minute", tkDateTimePicker_GetSegmentCount( c ) = 9 _
                  andalso tkDateTimePicker_GetSegmentKind( c, 0 ) = TKTP_SEG_YEAR andalso tkDateTimePicker_GetSegmentKind( c, 2 ) = TKTP_SEG_MONTH _
                  andalso tkDateTimePicker_GetSegmentKind( c, 4 ) = TKTP_SEG_DAY andalso tkDateTimePicker_GetSegmentKind( c, 6 ) = TKTP_SEG_HOUR24 _
                  andalso tkDateTimePicker_GetSegmentKind( c, 8 ) = TKTP_SEG_MINUTE )
    dim as long iw, ih
    tkDateTimePicker_GetIdealSize( c, iw, ih )
    dim as long cx0 = tkHost_Scale( h, 20 ), cy0 = tkHost_Scale( h, 20 ), cw = iw + tkHost_Scale( h, 20 )
    tkWidget_SetPos( c, cx0, cy0, cw, ih )
    dim as TK_WIDGET ptr dp = tkDatePicker_Create( root, 950 )
    tkWidget_SetPos( dp, cx0, cy0 + tkHost_Scale( h, 400 ), cw, ih )
    dim as TKRECT rIcon, rField, dIcon, dField
    tkDateTimePicker_GetIconRect( c, rIcon )
    tkDateTimePicker_GetFieldRect( c, rField )
    tkDatePicker_GetIconRect( dp, dIcon )
    tkDatePicker_GetFieldRect( dp, dField )
    dim as long dw, dh
    tkDatePicker_GetIdealSize( dp, dw, dh )
    tkTest_Check( "sibling: a DatePicker's height, icon and field rects", ih = dh andalso dIcon.left = rIcon.left andalso dIcon.right = rIcon.right _
                  andalso dField.left = rField.left andalso dField.right = rField.right andalso dField.top = rField.top andalso dField.bottom = rField.bottom, _
                  ih & "/" & dh & " " & tkRect_Str( rField ) & " vs " & tkRect_Str( dField ) )
    dim as TKDATETIMEPICKER_COLORS cc
    dim as TKDATEPICKER_COLORS dc
    tkDateTimePicker_GetColors( c, @cc )
    tkDatePicker_GetColors( dp, @dc )
    tkTest_Check( "sibling: frame and calendar colours equal the DatePicker's", cc.BackColor = dc.BackColor andalso cc.BorderColor = dc.BorderColor _
                  andalso cc.FieldForeColor = dc.FieldForeColor andalso cc.FocusBorderColor = dc.FocusBorderColor _
                  andalso cc.TitleColor = dc.TitleColor andalso cc.DayBackColorSelected = dc.DayBackColorSelected andalso cc.TodayRingColor = dc.TodayRingColor )

    ' ---- B: setters are silent; date entry ---------------------------------------------------------
    tkDateTimePicker_SetDateTimeChangedCallback( c, @OnChanged )
    tkDateTimePicker_SetDropDownCallback( c, @OnDrop )
    tkDateTimePicker_SetNow( c, DT( 2026, 11, 23, 9, 41 ) )
    ResetCounts( )
    tkDateTimePicker_SetDateTime( c, DT( 2026, 11, 23, 14, 30 ) )
    tkTest_Check( "SetDateTime: text, silent", tkDateTimePicker_GetText( c ) = "2026-11-23 14:30" andalso gChanged = 0, tkDateTimePicker_GetText( c ) )
    tkHost_SetFocus( h, c )
    tkDateTimePicker_SetFocusedSegment( c, 0 )
    Keys( h, "2027" )
    tkTest_Check( "a year takes four digits, then the month has the focus", IsDT( c, 2027, 11, 23, 14, 30 ) andalso gChanged = 1 _
                  andalso tkDateTimePicker_GetFocusedSegment( c ) = 2, Iso( GetDT( c ) ) )
    Keys( h, "3" )
    tkTest_Check( "month 3 completes at once (no month 3x)", IsDT( c, 2027, 3, 23, 14, 30 ) andalso tkDateTimePicker_GetFocusedSegment( c ) = 4 )
    Keys( h, "5" )
    tkTest_Check( "day 5 completes at once (no day 5x)", IsDT( c, 2027, 3, 5, 14, 30 ) andalso tkDateTimePicker_GetFocusedSegment( c ) = 6 )
    tkDateTimePicker_SetFocusedSegment( c, 2 )
    Keys( h, "15" )
    tkTest_Check( "1 5: no month 15, so 5 starts over: May", IsDT( c, 2027, 5, 5, 14, 30 ), Iso( GetDT( c ) ) )
    tkDateTimePicker_SetFocusedSegment( c, 0 )
    tkTest_PushKey( h, SDLK_SLASH )
    tkTest_Check( "'/' is a separator: it moves on", tkDateTimePicker_GetFocusedSegment( c ) = 2 )

    ' ---- C: stepping: wrap with no carry, the day clamped to its month ------------------------------
    tkDateTimePicker_SetDateTime( c, DT( 2026, 1, 31, 8, 0 ) )
    tkDateTimePicker_SetFocusedSegment( c, 4 )
    tkTest_PushKey( h, SDLK_UP )
    tkTest_Check( "Up at day 31: day 1, the month untouched", IsDT( c, 2026, 1, 1, 8, 0 ), Iso( GetDT( c ) ) )
    tkDateTimePicker_SetDateTime( c, DT( 2026, 1, 31, 8, 0 ) )
    tkDateTimePicker_SetFocusedSegment( c, 2 )
    tkTest_PushKey( h, SDLK_UP )
    tkTest_Check( "Up on the month from 31 Jan: 28 Feb", IsDT( c, 2026, 2, 28, 8, 0 ), Iso( GetDT( c ) ) )

    ' ---- D: names: month-name type-ahead, the weekday shown, not edited --------------------------------
    tkDateTimePicker_SetFormat( c, "ddd d MMM yyyy" )
    tkDateTimePicker_GetIdealSize( c, iw, ih )
    tkWidget_SetPos( c, cx0, cy0, iw + tkHost_Scale( h, 20 ), ih )
    tkDateTimePicker_SetDateTime( c, DT( 2026, 11, 23 ) )
    tkTest_Check( "names: Mon 23 Nov 2026", tkDateTimePicker_GetText( c ) = "Mon 23 Nov 2026", tkDateTimePicker_GetText( c ) )
    tkDateTimePicker_SetFocusedSegment( c, 0 )
    tkTest_Check( "the weekday cannot take the focus", tkDateTimePicker_GetFocusedSegment( c ) <> 0, str( tkDateTimePicker_GetFocusedSegment( c ) ) )
    tkDateTimePicker_SetFocusedSegment( c, 4 )
    Keys( h, "jul" )
    tkTest_Check( "j u l on the month name: July", IsDT( c, 2026, 7, 23 ), Iso( GetDT( c ) ) )
    tkDateTimePicker_SetMonthNames( c, "Januar,Februar,März,April,Mai,Juni,Juli,August,September,Oktober,November,Dezember|Jan,Feb,Mär,Apr,Mai,Jun,Jul,Aug,Sep,Okt,Nov,Dez" )
    tkDateTimePicker_SetDateTime( c, DT( 2026, 10, 3 ) )
    tkTest_Check( "SetMonthNames: 3 Okt", instr( tkDateTimePicker_GetText( c ), "3 Okt 2026" ) > 0, tkDateTimePicker_GetText( c ) )
    tkDateTimePicker_SetFormat( c, "yyyy-MM-dd HH:mm" )
    tkWidget_SetPos( c, cx0, cy0, cw, ih )

    ' ---- E: the range spans both halves; empty and clear ---------------------------------------------
    tkDateTimePicker_SetRange( c, DT( 2026, 1, 10, 9, 0 ), DT( 2026, 1, 20, 17, 0 ) )
    tkDateTimePicker_SetDateTime( c, DT( 2026, 1, 5, 12, 0 ) )
    tkTest_Check( "a date before the min clamps to the min's date AND time", IsDT( c, 2026, 1, 10, 9, 0 ), Iso( GetDT( c ) ) )
    tkDateTimePicker_SetDateTime( c, DT( 2026, 1, 20, 16, 0 ) )
    tkDateTimePicker_SetFocusedSegment( c, 6 )
    tkTest_PushKey( h, SDLK_UP )
    tkTest_PushKey( h, SDLK_UP )
    tkTest_Check( "the max day's hours stop at the max time: 17:00", IsDT( c, 2026, 1, 20, 17, 0 ), Iso( GetDT( c ) ) )
    tkDateTimePicker_SetRange( c, DT( 0, 0, 0 ), DT( 0, 0, 0 ), false, false )
    ResetCounts( )
    tkTest_PushKey( h, SDLK_BACKSPACE )
    tkTest_Check( "Backspace clears: one event, no value", tkDateTimePicker_HasDateTime( c ) = false andalso gChanged = 1 andalso gLastHas = false )
    tkTest_PushKey( h, SDLK_UP )
    tkTest_Check( "Up on an empty field: today (the pinned now) 00:00", IsDT( c, 2026, 11, 23, 0, 0 ) andalso gChanged = 2, Iso( GetDT( c ) ) )
    tkHost_SetClipboardText( "2026-12-24 6:30 pm" )
    tkTest_PushKey( h, SDLK_V, SDL_KMOD_LCTRL )
    tkTest_Check( "Ctrl+V pastes a date and a lenient time", IsDT( c, 2026, 12, 24, 18, 30 ) andalso gChanged = 3, Iso( GetDT( c ) ) )

    ' ---- F: the dropdown: picks are pending until OK, Enter or Now ---------------------------------------
    tkDateTimePicker_SetDateTime( c, DT( 2026, 11, 23, 14, 30 ) )
    tkDateTimePicker_SetFocusedSegment( c, 4 )
    ResetCounts( )
    Open_( h )
    dim as TK_HOST ptr pop = tkDateTimePicker_GetPopup( c )
    dim as TK_WIDGET ptr cal = tkDateTimePicker_GetCalendarHandle( c )
    dim as TK_WIDGET ptr pnl = tkDateTimePicker_GetPanelHandle( c )
    tkTest_Check( "F4 opens a calendar and a panel; the day segment focuses the calendar", tkDateTimePicker_IsDroppedDown( c ) andalso gDropOpen = 1 _
                  andalso (cal <> 0) andalso (pnl <> 0) andalso (pop <> 0) andalso tkHost_GetFocus( pop ) = cal )
    if (cal <> 0) andalso (pnl <> 0) then
        dim as TKRECT a1, a2
        tkWidget_AbsRect( cal, a1 )
        tkWidget_AbsRect( pnl, a2 )
        tkTest_Check( "the panel sits right of the calendar, as tall", a2.left > a1.right andalso (a2.bottom - a2.top) = (a1.bottom - a1.top), _
                      tkRect_Str( a1 ) & " " & tkRect_Str( a2 ) )
    end if
    ClickDay( c, 25 )
    ClickPanelItem( c, 0, 16 )
    tkTest_PumpFor( h, 30 )
    tkTest_Check( "a day and an hour picked are PENDING: field unchanged, no event, still open", tkDateTimePicker_IsDroppedDown( c ) _
                  andalso IsDT( c, 2026, 11, 23, 14, 30 ) andalso gChanged = 0 _
                  andalso tkTimePanel_SameDateTime( tkDateTimePicker_GetPendingDateTime( c ), DT( 2026, 11, 25, 16, 30 ) ), _
                  Iso( tkDateTimePicker_GetPendingDateTime( c ) ) )
    tkTest_PushKey( h, SDLK_ESCAPE )
    tkTest_PumpFor( h, 50 )
    tkTest_Check( "Esc dismisses: closed once, value unchanged", tkDateTimePicker_IsDroppedDown( c ) = false andalso gDropClose = 1 _
                  andalso IsDT( c, 2026, 11, 23, 14, 30 ) andalso gChanged = 0 )
    Open_( h )
    ClickDay( c, 25 )
    ClickPanelItem( c, 0, 16 )
    ClickFooter( c, true )
    tkTest_PumpFor( h, 50 )
    tkTest_Check( "OK accepts the pending day and time: closed, one event", tkDateTimePicker_IsDroppedDown( c ) = false _
                  andalso IsDT( c, 2026, 11, 25, 16, 30 ) andalso gChanged = 1 andalso tkTimePanel_SameDateTime( gLast, DT( 2026, 11, 25, 16, 30 ) ), Iso( GetDT( c ) ) )
    Open_( h )
    pop = tkDateTimePicker_GetPopup( c )
    tkTest_PushKey( h, SDLK_RIGHT ) : tkTest_PushKey( h, SDLK_RETURN )
    tkTest_PumpFor( h, 50 )
    tkTest_Check( "Right + Enter in the calendar accepts: the 26th", tkDateTimePicker_IsDroppedDown( c ) = false andalso IsDT( c, 2026, 11, 26, 16, 30 ) _
                  andalso gChanged = 2, Iso( GetDT( c ) ) )
    tkDateTimePicker_SetShowNow( c, true )
    Open_( h )
    ClickFooter( c, false )
    tkTest_PumpFor( h, 50 )
    tkTest_Check( "Now accepts the (pinned) now", tkDateTimePicker_IsDroppedDown( c ) = false andalso IsDT( c, 2026, 11, 23, 9, 41 ) andalso gChanged = 3, Iso( GetDT( c ) ) )
    tkDateTimePicker_SetShowNow( c, false )
    ' the min's time limits reach the panel only on the min's day
    tkDateTimePicker_SetRange( c, DT( 2026, 11, 10, 9, 0 ), DT( 2026, 12, 31, 23, 59 ) )
    tkDateTimePicker_SetDateTime( c, DT( 2026, 11, 10, 12, 0 ) )
    Open_( h )
    pnl = tkDateTimePicker_GetPanelHandle( c )
    tkTest_Check( "on the min's day hour 8 is disabled, 9 is not", (pnl <> 0) andalso tkTimePanel_IsItemDisabled( pnl, 0, 8 ) _
                  andalso tkTimePanel_IsItemDisabled( pnl, 0, 9 ) = false )
    ClickDay( c, 11 )
    tkTest_PumpFor( h, 30 )
    pnl = tkDateTimePicker_GetPanelHandle( c )
    tkTest_Check( "picking the next day frees hour 8", (pnl <> 0) andalso tkTimePanel_IsItemDisabled( pnl, 0, 8 ) = false )
    tkDateTimePicker_CloseUp( c )
    tkTest_PumpFor( h, 30 )
    tkDateTimePicker_SetRange( c, DT( 0, 0, 0 ), DT( 0, 0, 0 ), false, false )

    tkHost_Destroy( h )
end sub

' ==========================================================================================
' the datetime bind kind (scale-independent: one pass)
type WhenRec
    dtm as DateTime
    t   as TKDATETIME
    s   as ustring
end type

sub RunBinding( )
    tkTest_Begin( "binding" )
    dim as WhenRec r
    tkTest_Check( "an Invalid DateTime loads as no value", tkTimePanel_IsDateTime( tkBind_DateTime( r.dtm ) ) = false )
    tkBind_Put( r.dtm, DT( 2027, 1, 2, 9, 15 ) )
    tkTest_Check( "a new record: TKDATETIME -> DateTime -> TKDATETIME", r.dtm.IsValid andalso tkTimePanel_SameDateTime( tkBind_DateTime( r.dtm ), DT( 2027, 1, 2, 9, 15 ) ) )
    r.dtm = DateTime( 2026, 11, 23, 14, 5, 0, 0 ).WithOffset( -210 )
    tkBind_Put( r.dtm, DT( 2027, 1, 2, 9, 15 ) )
    tkTest_Check( "save keeps the offset", r.dtm.HasOffset andalso r.dtm.OffsetMinutes = -210 andalso r.dtm.Hour = 9 andalso r.dtm.Day = 2 )
    tkBind_Put( r.dtm, tkTimePanel_EmptyDateTime( ) )
    tkTest_Check( "no value saves as DateTime.Invalid", r.dtm.IsValid = false )
    tkBind_Put( r.s, DT( 2026, 3, 4, 6, 7 ) )
    dim as ustring sLoose = "2026-03-04 2:30 pm"
    tkTest_Check( "out to text is ISO; in, lenient text", r.s = "2026-03-04T06:07:00" _
                  andalso tkTimePanel_SameDateTime( tkBind_DateTime( sLoose ), DT( 2026, 3, 4, 14, 30 ) ), r.s )
    ' codegen's line shapes against a real control
    dim as TK_HOST ptr h = tkHost_Create( "tkDateTimePicker binding", 300, 200, tkHost_FontDir() & TK_FONT_UI, 1.0 )
    dim as TK_WIDGET ptr c = tkDateTimePicker_Create( tkHost_Root( h ), 1 )
    gChanged = 0
    tkDateTimePicker_SetDateTimeChangedCallback( c, @OnChanged )
    r.dtm = DateTime( 2026, 11, 23, 17, 45, 0, 0 )
    tkDateTimePicker_SetDateTimeValue( c, tkBind_DateTime( r.dtm ) )
    dim as boolean bLoaded = IsDT( c, 2026, 11, 23, 17, 45 )
    tkDateTimePicker_SetDateTime( c, DT( 2026, 12, 1, 18, 0 ) )
    tkBind_Put( r.dtm, tkDateTimePicker_GetDateTimeValue( c ) )
    tkTest_Check( "LoadFrom / SaveTo lines: loads silently, saves 1 Dec 18:00", bLoaded andalso gChanged = 0 _
                  andalso r.dtm.Month = 12 andalso r.dtm.Day = 1 andalso r.dtm.Hour = 18 )
    tkHost_Destroy( h )
end sub

' ==========================================================================================
' The rest, one check each (scale-independent: one pass): the callbacks this control forwards or
' owns, the dismissals and accepts the main pass does not drive, yy and SetDayNames.
dim shared as long gTipPart, gTipSeg, gTipDay, gNoonOff

sub OnFmt( byval hCtrl as TK_WIDGET ptr, byval pDT as TKDATETIME ptr, byref sOut as ustring )
    sOut = "due " & sOut
end sub

function OnTip( byval t as TKDATETIMEPICKER_TOOLTIPINFO ptr ) as boolean
    gTipPart = t->nPart
    gTipSeg = t->nSegment
    gTipDay = iif( t->hasValue, t->dt.wDay, -1 )
    t->outText = "segment " & t->nSegment
    return t->nPart = TKDTM_HIT_FIELD
end function

function OnItemDisabled( byval hCtrl as TK_WIDGET ptr, byval nKind as long, byval nValue as long ) as boolean
    return (gNoonOff <> 0) andalso (nKind = TKTP_SEG_HOUR24) andalso (nValue = 12)
end function

sub RunExtras( )
    tkTest_Begin( "callbacks, dismissals, names" )
    dim as TK_HOST ptr h = tkHost_Create( "tkDateTimePicker extras", 760, 560, tkHost_FontDir() & TK_FONT_UI, 1.0 )
    tkHost_Show( h )
    dim as TK_WIDGET ptr c = tkDateTimePicker_Create( tkHost_Root( h ), 1 )
    dim as long iw, ih
    tkDateTimePicker_GetIdealSize( c, iw, ih )
    tkWidget_SetPos( c, 20, 20, iw + 60, ih )
    tkDateTimePicker_SetDateTimeChangedCallback( c, @OnChanged )
    tkDateTimePicker_SetDateTime( c, DT( 2026, 11, 23, 14, 30 ) )

    ' Format: the text at rest
    tkDateTimePicker_SetFormatCallback( c, @OnFmt )
    tkTest_Check( "FormatDateTime replaces the text at rest", tkDateTimePicker_GetText( c ) = "due 2026-11-23 14:30", tkDateTimePicker_GetText( c ) )
    tkDateTimePicker_SetFormatCallback( c, 0 )

    ' Tooltip: the value, the part and the segment under the pointer
    tkDateTimePicker_SetTooltipCallback( c, @OnTip )
    dim as TK_TIP ptr tip = tkDateTimePicker_GetTooltipHandle( c )
    dim as TKRECT rs
    tkDateTimePicker_GetSegmentRect( c, 4, rs )
    tkHost_SetFocus( h, 0 )
    tkHost_RenderTo( h, false )
    tkTest_PushMotion( h, WX( c, (rs.left + rs.right) \ 2 ), WY( c, (rs.top + rs.bottom) \ 2 ) )
    if tip then tkTooltip_Show( tip )
    tkTest_Check( "Tooltip over the day: the field, segment 4, the value, shown", (tip <> 0) andalso tkTooltip_IsVisible( tip ) _
                  andalso gTipPart = TKDTM_HIT_FIELD andalso gTipSeg = 4 andalso gTipDay = 23, gTipPart & " " & gTipSeg & " " & gTipDay )
    if tip then tkTooltip_Hide( tip )
    tkTest_PushMotion( h, 700, 500 )

    ' ItemDisabled reaches the dropdown's panel
    gNoonOff = 1
    tkDateTimePicker_SetItemDisabledCallback( c, @OnItemDisabled )
    tkHost_SetFocus( h, c )
    ResetCounts( )
    Open_( h )
    dim as TK_WIDGET ptr pnl = tkDateTimePicker_GetPanelHandle( c )
    tkTest_Check( "ItemDisabled is forwarded to the panel (hour 12 off, 11 on)", (pnl <> 0) andalso tkTimePanel_IsItemDisabled( pnl, 0, 12 ) _
                  andalso tkTimePanel_IsItemDisabled( pnl, 0, 11 ) = false )
    gNoonOff = 0
    tkDateTimePicker_SetItemDisabledCallback( c, 0 )

    ' a press outside dismisses: closed, nothing written
    ClickDay( c, 25 )
    tkTest_Click( h, 700, 500 )
    tkTest_PumpFor( h, 50 )
    tkTest_Check( "a press outside dismisses: closed, value unchanged, no event", tkDateTimePicker_IsDroppedDown( c ) = false _
                  andalso IsDT( c, 2026, 11, 23, 14, 30 ) andalso gChanged = 0, Iso( GetDT( c ) ) )

    ' a double click on a day accepts it
    tkHost_SetFocus( h, c )
    Open_( h )
    ClickDay( c, 27, true )
    tkTest_PumpFor( h, 50 )
    tkTest_Check( "a double click on a day accepts it: closed, the 27th, one event", tkDateTimePicker_IsDroppedDown( c ) = false _
                  andalso IsDT( c, 2026, 11, 27, 14, 30 ) andalso gChanged = 1, Iso( GetDT( c ) ) )

    ' yy: two digits, read as 20xx
    tkDateTimePicker_SetFormat( c, "yy-MM-dd HH:mm" )
    tkHost_SetFocus( h, c )
    tkDateTimePicker_SetFocusedSegment( c, 0 )
    Keys( h, "31" )
    tkTest_Check( "yy: 3 1 is 2031, then the month has the focus", IsDT( c, 2031, 11, 27, 14, 30 ) andalso tkDateTimePicker_GetFocusedSegment( c ) = 2, _
                  Iso( GetDT( c ) ) )

    ' SetDayNames: full and short
    tkDateTimePicker_SetDayNames( c, "Sonntag,Montag,Dienstag,Mittwoch,Donnerstag,Freitag,Samstag|So,Mo,Di,Mi,Do,Fr,Sa" )
    tkDateTimePicker_SetFormat( c, "dddd / ddd d" )
    tkDateTimePicker_SetDateTime( c, DT( 2026, 11, 23 ) )
    tkTest_Check( "SetDayNames: full and short weekdays", tkDateTimePicker_GetText( c ) = "Montag / Mo 23", tkDateTimePicker_GetText( c ) )
    tkHost_Destroy( h )
end sub

' ==========================================================================================
if tkTest_Init() = false then end 99
RunBinding( )
RunExtras( )
RunPass( 1.0 )
RunPass( 1.75 )
dim as long nFail = tkTest_Report( "tkDateTimePicker" )
tkTest_Quit()
end nFail
