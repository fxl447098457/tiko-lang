' tkDateTimePicker demo: three pickers.
'
'   demo                          run it
'   demo --shot out.bmp           render once, save the window, exit
'   demo --shot out.bmp --open    the same with the first picker's dropdown open (also out.bmp.pop.bmp)
'   demo --scale 1.75             pin the scale
#import "vendor/tkControls/tkDateTimePicker"
using tkDateTimePicker
using tkTimePanel
using tkCalendar
using tkTheme
using tkHost
using tkPaint

dim shared as TK_HOST ptr gHost
dim shared as TK_WIDGET ptr gPk(0 to 2)
dim shared as ustring gLabel(0 to 2)
dim shared as TTF_Font ptr gFont

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

private function HasArg( byref name_ as string ) as boolean
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return true
    next
    return false
end function

private sub Demo_Changed( byval hCtrl as TK_WIDGET ptr, byval pDT as TKDATETIME ptr, byval bHasValue as boolean )
    dim as string s = "(none)"
    if bHasValue then s = tkTimePanel_FormatIsoDateTime( *pDT )
    print "DateTimeChanged " & tkDateTimePicker_GetID( hCtrl ) & ": " & s
end sub

private sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    b->SetFont( gFont )
    b->SetForeColor( tkTheme_Of( tkHost_Root( h ) ).TextDim )
    for i as long = 0 to 2
        dim as TKRECT rc
        tkRect_Set( rc, tkHost_Scale( h, 20 ), tkHost_Scale( h, 20 + i * 50 ), tkHost_Scale( h, 250 ), tkHost_Scale( h, 20 + i * 50 + 30 ) )
        b->PaintText( gLabel(i), @rc, TK_DT_LEFT )
    next
end sub

private sub Form_Size( byval h as TK_HOST ptr )
    for i as long = 0 to 2
        dim as long iw, ih
        tkDateTimePicker_GetIdealSize( gPk(i), iw, ih )
        tkWidget_SetPos( gPk(i), tkHost_Scale( h, 260 ), tkHost_Scale( h, 20 + i * 50 ), iw + tkHost_Scale( h, 10 ), ih )
    next
end sub

private sub SaveShot( byval h as TK_HOST ptr, byref path as string )
    tkHost_Render( h )
    tkHost_RenderTo( h, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( h->renderer, 0 )
    if s then
        SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & h->fScale
        SDL_DestroySurface( s )
    end if
end sub

if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
dim as single forced = val( ArgValue( "--scale" ) )
gHost = tkHost_Create( "tkDateTimePicker on SDL3", 700, 520, tkHost_FontDir() & TK_FONT_UI, forced )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
gHost->clrBack = tkTheme_Of( tkHost_Root( gHost ) ).Window
gFont = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 10 )

gLabel(0) = "ISO, dropdown with Now and OK"
gLabel(1) = "names, 12-hour, Monday first"
gLabel(2) = "empty, spin buttons, a range"
for i as long = 0 to 2
    gPk(i) = tkDateTimePicker_Create( tkHost_Root( gHost ), 1000 + i )
    tkDateTimePicker_SetDateTimeChangedCallback( gPk(i), @Demo_Changed )
next
tkDateTimePicker_SetNow( gPk(0), tkTimePanel_MakeDateTime( 2026, 11, 23, 9, 41 ) )
tkDateTimePicker_SetDateTime( gPk(0), tkTimePanel_MakeDateTime( 2026, 11, 23, 14, 30 ) )
tkDateTimePicker_SetShowNow( gPk(0), true )
tkDateTimePicker_SetFormat( gPk(1), "ddd d MMM yyyy h:mm tt" )
tkDateTimePicker_SetWeekStart( gPk(1), CAL_MONDAY )
tkDateTimePicker_SetDateTime( gPk(1), tkTimePanel_MakeDateTime( 2026, 12, 24, 18, 0 ) )
tkDateTimePicker_SetButtonStyle( gPk(2), TKDTM_BUTTON_SPIN )
tkDateTimePicker_SetRange( gPk(2), tkTimePanel_MakeDateTime( 2026, 1, 1 ), tkTimePanel_MakeDateTime( 2026, 12, 31, 23, 59 ) )
tkDateTimePicker_SetPlaceholderText( gPk(2), "When?" )

gHost->OnPaint = @Form_Paint
gHost->OnSize = @Form_Size
Form_Size( gHost )
tkHost_SetFocus( gHost, gPk(0) )
tkHost_Show( gHost )

dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )
    if HasArg( "--open" ) then
        tkDateTimePicker_DropDown( gPk(0) )
        for k as long = 1 to 10
            tkHost_Pump( gHost )
            SDL_Delay( 15 )
        next
        dim as TK_HOST ptr pop = tkDateTimePicker_GetPopup( gPk(0) )
        if pop then SaveShot( pop, shot & ".pop.bmp" )
    end if
    SaveShot( gHost, shot )
else
    tkHost_Run( gHost )
end if
tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
