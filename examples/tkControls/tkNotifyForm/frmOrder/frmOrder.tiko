' The order form's handlers: what a designed form's author writes beside the generated part.
#module "frmOrder"

#import "vendor/tkControls/tkInfoBar"
#import "vendor/tkControls/tkToast"
using tkInfoBar
using tkToast

public partial type Form
    Actions as long
    LastAction as long
    Closings as long
    AllowClose as boolean = true
    Dismissals as long
    LastReason as long
end type

sub Form.OnBarAction( byval id as int32 )
    Actions += 1
    LastAction = id
end sub

sub Form.OnBarClosing( byval reason as int32, byref Allow as boolean )
    Closings += 1
    Allow = AllowClose
end sub

sub Form.OnToastDismissed( byval id as int32, byval reason as int32 )
    Dismissals += 1
    LastReason = reason
end sub
