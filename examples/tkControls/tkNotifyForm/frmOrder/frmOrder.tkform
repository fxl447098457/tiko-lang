format = 1

[form]
caption = "Order"
width = 480
height = 300
data_type = "orders.Order"
data_module = "../orders"

[[control]]
name = "bar"
type = "InfoBar"
parent = ""
x = 0
y = 0
w = 480
h = 44
dock = "top"
bind = "Notice"

[control.props]
Severity = "Warning"
Title = "Notice"
Message = "Payment overdue"
Actions = "Remind|Dismiss"
Animate = false

[control.events]
Action = "OnBarAction"
Closing = "OnBarClosing"

[[control]]
name = "lblBody"
type = "Label"
parent = ""
x = 0
y = 44
w = 480
h = 256
dock = "fill"

[control.props]
Text = "Order details"

[[control]]
name = "tst"
type = "Toaster"
parent = ""
x = 400
y = 260
w = 72
h = 24

[control.props]
Position = "TopRight"
Animate = false

[control.events]
Dismissed = "OnToastDismissed"
