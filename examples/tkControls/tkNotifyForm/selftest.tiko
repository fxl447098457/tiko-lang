' tkNotifyForm self-test (notifications N5): frmOrder was written as a .tkform and generated by
' tkEdit --generate-forms. One check per behaviour: the designed bar is created open with its
' props and docked at its own height (the layout hook); its binding opens and closes it and the
' layout follows; its events reach the form (Action; Closing's Allow can veto); the Toaster
' component carries its props and its Dismissed event.
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkInfoBar"
#import "vendor/tkControls/tkToast"
#import "vendor/tkControls/tkForms"
#import "./frmOrder"
#import "./orders"
using tkApp
using tkInfoBar
using tkToast
using tkNotify
using tkForms
using tkTheme
using tkHost
using tkPaint
using tkTest

sub Order( byval owner as TK_FORM ptr )
    tkTest_Begin( "a designed form with an info bar and a toaster" )
    dim as frmOrder.Form f
    f.Build( owner )
    dim as TK_HOST ptr h = tkForm_Host( f.Handle )
    f.Show( )
    tkTest_PumpFor( h, 80 )
    dim as TK_WIDGET ptr bar = f.bar.Handle, body = f.lblBody.Handle

    tkTest_Check( "the bar is created open, with its props", tkInfoBar_IsOpen( bar ) andalso (tkInfoBar_GetSeverity( bar ) = TKN_WARNING) _
                  andalso (tkInfoBar_GetActionList( bar ) = "Remind|Dismiss") andalso (tkInfoBar_GetAnimate( bar ) = false) )
    dim as long want = tkInfoBar_GetPreferredHeight( bar, bar->cw )
    tkTest_Check( "docked at its own height (the layout hook), the body below it", (bar->y = 0) andalso (bar->ch = want) andalso (body->y = want), _
                  bar->ch & " vs " & want & ", body " & body->y )

    ' binding: an empty notice closes the bar and gives its strip back; a notice opens it again
    dim as orders.Order r
    r.Notice = ""
    f.LoadFrom( r )
    dim as boolean bClosedUp = (tkInfoBar_IsOpen( bar ) = false) andalso (body->y = 0)
    r.Notice = "Payment overdue since 3 November"
    f.LoadFrom( r )
    tkTest_Check( "LoadFrom closes the bar on no notice and opens it on one; the layout follows", bClosedUp andalso tkInfoBar_IsOpen( bar ) _
                  andalso (tkInfoBar_GetMessage( bar ) = r.Notice) andalso (body->y = bar->ch), body->y & " / " & bar->ch )

    ' events: an action, then a close the form refuses, then one it allows
    dim as TKRECT rc
    tkInfoBar_GetPartRect( bar, TKN_PART_ACTION1 + 1, rc )
    tkTest_Click( h, bar->x + (rc.left + rc.right) \ 2, bar->y + (rc.top + rc.bottom) \ 2 )
    tkTest_Check( "Action reaches the form with its id", (f.Actions = 1) andalso (f.LastAction = 2), f.Actions & " " & f.LastAction )
    tkInfoBar_GetPartRect( bar, TKN_PART_CLOSE, rc )
    f.AllowClose = false
    tkTest_Click( h, bar->x + (rc.left + rc.right) \ 2, bar->y + (rc.top + rc.bottom) \ 2 )
    dim as boolean bRefused = tkInfoBar_IsOpen( bar ) andalso (f.Closings = 1)
    f.AllowClose = true
    tkTest_Click( h, bar->x + (rc.left + rc.right) \ 2, bar->y + (rc.top + rc.bottom) \ 2 )
    tkTest_Check( "Closing's Allow vetoes, then allows", bRefused andalso (tkInfoBar_IsOpen( bar ) = false) andalso (f.Closings = 2), str( f.Closings ) )

    ' the Toaster component: its props, and its Dismissed event reaching the form
    tkTest_Check( "the Toaster is this window's toaster, top right, motion off", (f.tst.Handle = tkToast_GetToaster( body )) _
                  andalso (tkToast_GetPosition( body ) = TST_POS_TOP_RIGHT) andalso (tkToast_GetAnimate( body ) = false) )
    dim as long id = tkToast_ShowText( body, "Saved" )
    dim as TKRECT rcCard, rcX
    tkToast_GetCardRect( body, id, rcCard )
    tkToast_GetPartRect( body, id, TKN_PART_CLOSE, rcX )
    tkTest_Click( h, rcCard.left + (rcX.left + rcX.right) \ 2, rcCard.top + (rcX.top + rcX.bottom) \ 2 )
    tkTest_Check( "Dismissed reaches the form", (f.Dismissals = 1) andalso (f.LastReason = TKN_CLOSE_BUTTON), f.Dismissals & " r " & f.LastReason )
    f.Close( )
    tkTest_PumpFor( h, 40 )
end sub

dim as TKAPP_OPTIONS opts
if tkApp_Init( opts ) = false then
    print "tkApp_Init failed"
    end 98
end if
dim as TK_FORM ptr mainForm = tkApp_NewForm( "owner", 200, 120, 0, 1.0 )
tkForm_Show( mainForm )
tkTest_PumpFor( tkForm_Host( mainForm ), 50 )
Order( mainForm )
dim as long nFail = tkTest_Report( "tkNotifyForm" )
tkApp_Shutdown( )
end nFail
