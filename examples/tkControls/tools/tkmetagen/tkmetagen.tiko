' tkmetagen -- turns pkg/vendor/tkControls/tkMeta/controls.toml into source, for the maintainer of
' tkControls. Run it after editing the table and commit what it writes:
'
'   <module>/<module>.forms.tiko   the typed wrapper for that control: Text, Checked, ...
'   tkMeta/tkMeta.gen.tiko         the table a form designer reads: names, kinds, apply thunks
'
'   tkmetagen <path to pkg/vendor/tkControls>
'
' Each wrapper lives in its control's own module, so a program links only the controls it imports.
#import "std/config"
#import "std/fs"
using config

const NL = !"\n"
const GENERATED = "' GENERATED by examples/tkControls/tools/tkmetagen from tkMeta/controls.toml. Do not edit."

function Str_( byref t as TomlValue, byref k as const ustring, byref dflt as const ustring = "" ) as ustring
    dim as TomlValue ptr p = t.Find( k )
    if p = 0 then return dflt
    dim as ustring d = dflt
    return p->AsString( ).ValueOr( d )
end function

function Int_( byref t as TomlValue, byref k as const ustring ) as long
    dim as TomlValue ptr p = t.Find( k )
    if p = 0 then return 0
    return p->AsInt( ).ValueOr( 0 )
end function

function Flag_( byref t as TomlValue, byref k as const ustring, byval dflt as boolean ) as boolean
    dim as TomlValue ptr p = t.Find( k )
    if p = 0 then return dflt
    return p->AsBool( ).ValueOr( dflt )
end function

' "Left=A,Right=B" entry i: shown name and constant. FALSE past the end.
function EnumAt_( byref e as const ustring, byval i as long, byref shown as ustring, byref konst as ustring ) as boolean
    dim as long at = 1, n = 0
    do
        dim as long comma = instr( at, e, "," )
        dim as ustring item = iif( comma > 0, mid( e, at, comma - at ), mid( e, at ) )
        if n = i then
            dim as long eq = instr( item, "=" )
            if eq = 0 then return false
            shown = left( item, eq - 1 )
            konst = mid( item, eq + 1 )
            return true
        end if
        if comma = 0 then return false
        at = comma + 1
        n += 1
    loop
end function

function KonstOf_( byref e as const ustring, byref shown as const ustring ) as ustring
    dim as long i = 0
    dim as ustring s, k
    do while EnumAt_( e, i, s, k )
        if s = shown then return k
        i += 1
    loop
    return ""
end function

function TypeOf_( byref kind as const ustring ) as ustring
    select case kind
    case "text", "glyph", "file" : return "ustring"
    case "int", "enum"           : return "long"
    case "bool"                  : return "boolean"
    case "float"                 : return "double"
    case "color"                 : return "ulong"
    case "font"                  : return "TTF_Font ptr"
    end select
    return ""
end function

function Quote_( byref s as const ustring ) as ustring
    dim as ustring o = """"
    for i as long = 1 to len( s )
        dim as ustring c = mid( s, i, 1 )
        if c = """" then o &= """"""  else o &= c
    next
    return o & """"
end function

' A "list" property's slots: "Left:int,Top:int" entry i's name and kind. FALSE past the end.
function SlotAt_( byref e as const ustring, byval i as long, byref kind as ustring ) as boolean
    dim as long at = 1, n = 0
    do
        dim as long comma = instr( at, e, "," )
        dim as ustring item = iif( comma > 0, mid( e, at, comma - at ), mid( e, at ) )
        if n = i then
            kind = mid( item, instr( item, ":" ) + 1 )
            return true
        end if
        if comma = 0 then return false
        at = comma + 1
        n += 1
    loop
end function

' "byval a0 as long, byref a1 as const ustring"
function ListParams_( byref e as const ustring ) as ustring
    dim as ustring o, k
    dim as long i = 0
    do while SlotAt_( e, i, k )
        if i then o &= ", "
        if TypeOf_( k ) = "ustring" then
            o &= "byref a" & i & " as const ustring"
        else
            o &= "byval a" & i & " as " & TypeOf_( k )
        end if
        i += 1
    loop
    return o
end function

' "a0, a1"
function ListArgs_( byref e as const ustring ) as ustring
    dim as ustring o, k
    dim as long i = 0
    do while SlotAt_( e, i, k )
        if i then o &= ", "
        o &= "a" & i
        i += 1
    loop
    return o
end function

' The setter's arguments, each read from the text v.
function ListConverted_( byref e as const ustring ) as ustring
    dim as ustring o, k
    dim as long i = 0
    do while SlotAt_( e, i, k )
        if i then o &= ", "
        dim as ustring item = "tkMeta_ListItem( v, " & i & " )"
        select case k
        case "int"   : o &= "clng( val( " & item & " ) )"
        case "float" : o &= "val( " & item & " )"
        case "color" : o &= "cast( ulong, valulng( " & item & " ) )"
        case "bool"  : o &= "cbool( " & item & " = ""true"" )"
        case else    : o &= item
        end select
        i += 1
    loop
    return o
end function

function SetterParam_( byref kind as const ustring ) as ustring
    if TypeOf_( kind ) = "ustring" then return "byref v as const ustring"
    return "byval v as " & TypeOf_( kind )
end function

sub Save_( byref path as const ustring, byref text as const ustring )
    if fs.WriteAllText( path, text ).IsOk( ) = false then
        print "cannot write " & path
        end 1
    end if
end sub

' ---- one control's wrapper ----------------------------------------------------------------
sub GenWrapper( byref ctl as TomlValue, byref root as const ustring )
    dim as ustring name_ = Str_( ctl, "name" ), mod_ = Str_( ctl, "module" )
    dim as ustring argName = Str_( ctl, "create_arg" ), argKind = Str_( ctl, "create_arg_kind" )
    dim as ustring argDflt = Str_( ctl, "create_arg_default" ), argEnum = Str_( ctl, "create_arg_enum" )
    dim as ustring argParam, argCall
    if len( argName ) then
        dim as ustring dv = argDflt
        if argKind = "enum" then dv = KonstOf_( argEnum, argDflt )
        argParam = ", byval " & argName & " as " & TypeOf_( argKind ) & " = " & dv
        argCall = ", " & argName
    end if

    dim as ustring o = GENERATED & NL & "#module " & Quote_( mod_ ) & NL & NL
    o &= "#import ""../tkHost""" & NL & "using tkHost" & NL & "using tkPaint" & NL & NL
    o &= "' The " & name_ & " control as a typed value. Handle reaches the whole " & mod_ & " API." & NL
    o &= "public type " & name_ & NL
    o &= "    Handle as TK_WIDGET ptr" & NL
    o &= "    declare sub Create( byval hParent as TK_WIDGET ptr, byval id as long" & argParam & " )" & NL
    o &= "    declare property Enabled( ) as boolean" & NL & "    declare property Enabled( byval v as boolean )" & NL
    o &= "    declare property Visible( ) as boolean" & NL & "    declare property Visible( byval v as boolean )" & NL
    o &= "    declare sub SetFocus( )" & NL
    dim as TomlValue ptr props = ctl.Find( "props" )
    for i as long = 0 to props->Count( ) - 1
        dim as TomlValue ptr p = @props->Item( i )
        dim as ustring pn = Str_( *p, "name" ), kind = Str_( *p, "kind" )
        if kind = "list" then
            o &= "    declare sub " & pn & "( " & ListParams_( Str_( *p, "enum" ) ) & " )" & NL
            continue for
        end if
        if len( Str_( *p, "get" ) ) then o &= "    declare property " & pn & "( ) as " & TypeOf_( kind ) & NL
        o &= "    declare property " & pn & "( " & SetterParam_( kind ) & " )" & NL
    next
    o &= "end type" & NL & NL

    o &= "sub " & name_ & ".Create( byval hParent as TK_WIDGET ptr, byval id as long" & argParam & " )" & NL
    o &= "    Handle = " & mod_ & "_Create( hParent, id" & argCall & " )" & NL & "end sub" & NL & NL
    o &= "property " & name_ & ".Enabled( ) as boolean" & NL & "    return tkWidget_IsEnabled( Handle )" & NL & "end property" & NL & NL
    o &= "property " & name_ & ".Enabled( byval v as boolean )" & NL & "    tkWidget_Enable( Handle, v )" & NL & "end property" & NL & NL
    o &= "property " & name_ & ".Visible( ) as boolean" & NL & "    return Handle->isVisible" & NL & "end property" & NL & NL
    o &= "property " & name_ & ".Visible( byval v as boolean )" & NL & "    tkWidget_Show( Handle, v )" & NL & "end property" & NL & NL
    o &= "sub " & name_ & ".SetFocus( )" & NL & "    tkHost_SetFocus( Handle->pHost, Handle )" & NL & "end sub" & NL
    for i as long = 0 to props->Count( ) - 1
        dim as TomlValue ptr p = @props->Item( i )
        dim as ustring pn = Str_( *p, "name" ), kind = Str_( *p, "kind" ), g = Str_( *p, "get" )
        if kind = "list" then
            o &= NL & "sub " & name_ & "." & pn & "( " & ListParams_( Str_( *p, "enum" ) ) & " )" & NL
            o &= "    " & Str_( *p, "set" ) & "( Handle, " & ListArgs_( Str_( *p, "enum" ) ) & " )" & NL & "end sub" & NL
            continue for
        end if
        if len( g ) then
            o &= NL & "property " & name_ & "." & pn & "( ) as " & TypeOf_( kind ) & NL
            o &= "    return " & g & "( Handle )" & NL & "end property" & NL
        end if
        o &= NL & "property " & name_ & "." & pn & "( " & SetterParam_( kind ) & " )" & NL
        o &= "    " & Str_( *p, "set" ) & "( Handle, v )" & NL & "end property" & NL
    next
    Save_( root & "/" & mod_ & "/" & mod_ & ".forms.tiko", o )
end sub

' ---- the designer's table --------------------------------------------------------------------
function ApplyBody_( byref p as TomlValue, byref setter as const ustring, byref arg as const ustring, byref kind as const ustring ) as ustring
    select case kind
    case "text", "glyph", "file" : return "    " & setter & "( w, " & arg & " )" & NL
    case "int"                   : return "    " & setter & "( w, clng( val( " & arg & " ) ) )" & NL
    case "bool"                  : return "    " & setter & "( w, cbool( " & arg & " = ""true"" ) )" & NL
    case "float"                 : return "    " & setter & "( w, val( " & arg & " ) )" & NL
    case "color"                 : return "    " & setter & "( w, cast( ulong, valulng( " & arg & " ) ) )" & NL
    end select
    return ""
end function

function ReadBody_( byref getter as const ustring, byref kind as const ustring ) as ustring
    select case kind
    case "text", "glyph", "file" : return "    return " & getter & "( w )" & NL
    case "int"                   : return "    return str( " & getter & "( w ) )" & NL
    case "bool"                  : return "    if " & getter & "( w ) then return ""true"" else return ""false""" & NL
    case "float"                 : return "    return str( " & getter & "( w ) )" & NL
    case "color"                 : return "    return ""&h"" & hex( " & getter & "( w ), 8 )" & NL
    end select
    return ""
end function

sub GenMeta( byref root_ as TomlValue, byref root as const ustring )
    dim as TomlValue ptr ctls = root_.Find( "control" )
    dim as ustring imports, usings, thunks, fill
    dim as ustring o = GENERATED & NL & "#module ""tkMeta""" & NL & NL
    for c as long = 0 to ctls->Count( ) - 1
        dim as TomlValue ptr ctl = @ctls->Item( c )
        dim as ustring name_ = Str_( *ctl, "name" ), mod_ = Str_( *ctl, "module" )
        imports &= "#import ""../" & mod_ & """" & NL
        usings &= "using " & mod_ & NL

        dim as ustring argKind = Str_( *ctl, "create_arg_kind" ), argEnum = Str_( *ctl, "create_arg_enum" )
        thunks &= "private function C_" & name_ & "( byval hParent as TK_WIDGET ptr, byval id as long, byref arg as const ustring ) as TK_WIDGET ptr" & NL
        select case argKind
        case ""
            thunks &= "    return " & mod_ & "_Create( hParent, id )" & NL
        case "bool"
            thunks &= "    return " & mod_ & "_Create( hParent, id, cbool( arg = ""true"" ) )" & NL
        case "enum"
            dim as long i = 0
            dim as ustring sh, ko
            thunks &= "    select case arg" & NL
            do while EnumAt_( argEnum, i, sh, ko )
                thunks &= "    case " & Quote_( sh ) & " : return " & mod_ & "_Create( hParent, id, " & ko & " )" & NL
                i += 1
            loop
            thunks &= "    end select" & NL & "    return " & mod_ & "_Create( hParent, id )" & NL
        end select
        thunks &= "end function" & NL & NL

        fill &= "    Add_( " & Quote_( name_ ) & ", " & Quote_( mod_ ) & ", " & Quote_( Str_( *ctl, "category" ) ) & ", " & Int_( *ctl, "width" ) & ", " & Int_( *ctl, "height" ) & ", " _
                & Quote_( Str_( *ctl, "default_event" ) ) & ", " & Quote_( Str_( *ctl, "container" ) ) & ", @C_" & name_ & ", " _
                & Quote_( Str_( *ctl, "create_arg" ) ) & ", " & Quote_( argKind ) & ", " & Quote_( argEnum ) & ", " & Quote_( Str_( *ctl, "create_arg_default" ) ) & " )" & NL

        dim as TomlValue ptr props = ctl->Find( "props" )
        for i as long = 0 to props->Count( ) - 1
            dim as TomlValue ptr p = @props->Item( i )
            dim as ustring pn = Str_( *p, "name" ), kind = Str_( *p, "kind" ), s_ = Str_( *p, "set" ), g = Str_( *p, "get" )
            dim as ustring en = Str_( *p, "enum" ), id_ = name_ & "_" & pn
            dim as ustring applyRef = "0", readRef = "0", fontRef = "0"
            if kind = "font" then
                thunks &= "private sub F_" & id_ & "( byval w as TK_WIDGET ptr, byval f as TTF_Font ptr )" & NL & "    " & s_ & "( w, f )" & NL & "end sub" & NL & NL
                fontRef = "@F_" & id_
            elseif kind = "list" then
                thunks &= "private sub A_" & id_ & "( byval w as TK_WIDGET ptr, byref v as const ustring )" & NL & "    " & s_ & "( w, " & ListConverted_( en ) & " )" & NL & "end sub" & NL & NL
                applyRef = "@A_" & id_
            elseif kind = "enum" then
                thunks &= "private sub A_" & id_ & "( byval w as TK_WIDGET ptr, byref v as const ustring )" & NL & "    select case v" & NL
                dim as long e = 0
                dim as ustring sh, ko
                do while EnumAt_( en, e, sh, ko )
                    thunks &= "    case " & Quote_( sh ) & " : " & s_ & "( w, " & ko & " )" & NL
                    e += 1
                loop
                thunks &= "    end select" & NL & "end sub" & NL & NL
                applyRef = "@A_" & id_
                if len( g ) then
                    thunks &= "private function R_" & id_ & "( byval w as TK_WIDGET ptr ) as ustring" & NL & "    select case " & g & "( w )" & NL
                    e = 0
                    do while EnumAt_( en, e, sh, ko )
                        thunks &= "    case " & ko & " : return " & Quote_( sh ) & NL
                        e += 1
                    loop
                    thunks &= "    end select" & NL & "    return """"" & NL & "end function" & NL & NL
                    readRef = "@R_" & id_
                end if
            else
                thunks &= "private sub A_" & id_ & "( byval w as TK_WIDGET ptr, byref v as const ustring )" & NL & ApplyBody_( *p, s_, "v", kind ) & "end sub" & NL & NL
                applyRef = "@A_" & id_
                if len( g ) then
                    thunks &= "private function R_" & id_ & "( byval w as TK_WIDGET ptr ) as ustring" & NL & ReadBody_( g, kind ) & "end function" & NL & NL
                    readRef = "@R_" & id_
                end if
            end if
            fill &= "    Prop_( " & Quote_( pn ) & ", " & Quote_( kind ) & ", " & Quote_( Str_( *p, "default" ) ) & ", " & Quote_( en ) & ", " _
                    & Quote_( s_ ) & ", " & Quote_( g ) & ", " & applyRef & ", " & readRef & ", " & fontRef & ", " _
                    & iif( Flag_( *p, "design", true ), "true", "false" ) & " )" & NL
        next

        dim as TomlValue ptr evs = ctl->Find( "events" )
        for i as long = 0 to evs->Count( ) - 1
            dim as TomlValue ptr e = @evs->Item( i )
            fill &= "    Event_( " & Quote_( Str_( *e, "name" ) ) & ", " & Quote_( Str_( *e, "set" ) ) & ", " & Quote_( Str_( *e, "type" ) ) & ", " _
                    & Quote_( Str_( *e, "sig" ) ) & ", " & Quote_( Str_( *e, "params" ) ) & ", " & Quote_( Str_( *e, "args" ) ) & " )" & NL
        next
    next
    o &= "#import ""../tkHost""" & NL & imports & "using tkHost" & NL & "using tkPaint" & NL & usings & NL & thunks
    o &= "sub Fill_( )" & NL & fill & "end sub" & NL
    Save_( root & "/tkMeta/tkMeta.gen.tiko", o )
end sub

dim as ustring root = command( 1 )
if len( root ) = 0 then
    print "usage: tkmetagen <path to pkg/vendor/tkControls>"
    end 2
end if
dim as ConfigResultToml r = LoadToml( root & "/tkMeta/controls.toml" )
if r.IsOk( ) = false then
    print r.Failure( ).Message( )
    end 1
end if
dim as TomlValue doc = r.Value( )
dim as TomlValue ptr ctls = doc.Find( "control" )
for c as long = 0 to ctls->Count( ) - 1
    GenWrapper( ctls->Item( c ), root )
next
GenMeta( doc, root )
print "tkmetagen: " & ctls->Count( ) & " controls"
