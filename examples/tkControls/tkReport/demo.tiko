' tkReport demo (printing phase R4): an orders report -- grouped by region, a line per order, group and
' report totals, "Page {p} of {n}" -- in a tkReportViewer; or written out.
'
'   demo                     the viewer
'   demo --png ../out/rp     pages as ../out/rp-p1.png ... at 110 dpi, and exit
'   demo --pdf ../out/rp.pdf the PDF, and exit
#import "vendor/tkControls/tkReport"
#import "vendor/tkControls/tkReportViewer"
#import "vendor/tkControls/tkPdf"
using tkReport
using tkReportViewer
using tkPdf
using tkBind
using tkCalendar
using tkPrint
using tkHost
using tkPaint

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 32
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function


sub GetOrder( byval rpt as TK_REPORT ptr, byval row as integer, byval f as long, byref v as TK_VALUE )
    dim as long reg = row \ 18
    select case f
    case 0
        select case reg
        case 0 : v.SetText( "East" )
        case 1 : v.SetText( "North" )
        case 2 : v.SetText( "South" )
        case else : v.SetText( "West" )
        end select
    case 1 : v.SetInt( 10001 + row )
    case 2 : v.SetText( "Customer " & chr( 65 + (row * 7) mod 26 ) & chr( 97 + (row * 3) mod 26 ) & "son" )
    case 3
        dim as TKDATE d : d.wYear = 2026 : d.wMonth = 1 + row mod 12 : d.wDay = 1 + (row * 5) mod 28
        v.SetDate( d )
    case 4 : v.SetFloat( ((row * 37) mod 900) + 99.95 )
    case 5 : v.SetBool( (row mod 4) <> 0 )
    end select
end sub

function RF( byval l as single, byval t as single, byval rr as single, byval b as single ) as TKRECTF
    dim as TKRECTF rc
    tkRectF_Set( rc, l, t, rr, b )
    return rc
end function

function OrdersReport( ) as TK_REPORT ptr
    dim as TK_REPORT ptr rpt = tkReport_Create( "Orders by region" )
    dim as ustring names(0 to 5) = { "Region", "Order", "Customer", "Date", "Amount", "Paid" }
    dim as long kinds(0 to 5) = { TKV_TEXT, TKV_INT, TKV_TEXT, TKV_DATE, TKV_FLOAT, TKV_BOOL }
    tkReport_SetFields( rpt, names(), kinds() )
    tkReport_SetRowCount( rpt, 72 )
    tkReport_SetGetValueCallback( rpt, @GetOrder )
    tkReport_AddGroup( rpt, 0 )
    dim as TKFONTSPEC bold
    bold.bold = true
    dim as TK_RBAND ptr b = tkReport_GetBand( rpt, TKRB_REPORT_HEADER )
    tkRBand_SetHeight( b, 44 )
    dim as TKREPORT_ITEM ptr it = tkRBand_AddLabel( b, RF( 0, 0, 480, 30 ), "Orders by region" )
    it->font.pt = 20 : it->font.bold = true
    tkRBand_AddPageInfo( b, RF( 0, 26, 480, 40 ), "Printed {date}", TK_DT_LEFT )
    b = tkReport_GetBand( rpt, TKRB_PAGE_HEADER )
    tkRBand_SetHeight( b, 20 ) : b->backColor = tkRGB( 228, 234, 242 )
    it = tkRBand_AddLabel( b, RF( 4, 0, 70, 20 ), "Order" ) : it->font = bold
    it = tkRBand_AddLabel( b, RF( 76, 0, 250, 20 ), "Customer" ) : it->font = bold
    it = tkRBand_AddLabel( b, RF( 256, 0, 340, 20 ), "Date" ) : it->font = bold
    it = tkRBand_AddLabel( b, RF( 346, 0, 440, 20 ), "Amount", TK_DT_RIGHT ) : it->font = bold
    it = tkRBand_AddLabel( b, RF( 446, 0, 480, 20 ), "Paid" ) : it->font = bold
    b = tkReport_GetBand( rpt, TKRB_GROUP_HEADER, 0 )
    tkRBand_SetHeight( b, 26 ) : b->repeatOnEveryPage = true
    it = tkRBand_AddField( b, RF( 0, 6, 300, 26 ), 0 ) : it->font.pt = 12 : it->font.bold = true : it->fore = tkRGB( 30, 80, 160 )
    b = tkReport_GetBand( rpt, TKRB_DETAIL )
    tkRBand_SetHeight( b, 16 )
    tkRBand_AddField( b, RF( 4, 0, 70, 16 ), 1 )
    tkRBand_AddField( b, RF( 76, 0, 250, 16 ), 2 )
    tkRBand_AddField( b, RF( 256, 0, 340, 16 ), 3, "dd/mm/yyyy" )
    tkRBand_AddField( b, RF( 346, 0, 440, 16 ), 4, "$#,##0.00", TK_DT_RIGHT )
    tkRBand_AddCheckBox( b, RF( 456, 0, 476, 16 ), 5 )
    b = tkReport_GetBand( rpt, TKRB_GROUP_FOOTER, 0 )
    tkRBand_SetHeight( b, 26 )
    tkRBand_AddLine( b, RF( 300, 2, 440, 2 ) )
    it = tkRBand_AddLabel( b, RF( 76, 4, 250, 22 ), "" )
    it = tkRBand_AddField( b, RF( 76, 4, 250, 22 ), 0 ) : it->font = bold
    tkRBand_AddSummary( b, RF( 256, 4, 340, 22 ), 1, TKRS_COUNT, 0, "0 orders", TK_DT_LEFT )
    it = tkRBand_AddSummary( b, RF( 346, 4, 440, 22 ), 4, TKRS_SUM, 0, "$#,##0.00" ) : it->font = bold
    b = tkReport_GetBand( rpt, TKRB_REPORT_FOOTER )
    tkRBand_SetHeight( b, 30 )
    tkRBand_AddLine( b, RF( 0, 4, 480, 4 ), 1 )
    it = tkRBand_AddLabel( b, RF( 76, 8, 250, 28 ), "All regions" ) : it->font = bold
    tkRBand_AddSummary( b, RF( 256, 8, 340, 28 ), 1, TKRS_COUNT, TKRS_SCOPE_REPORT, "0 orders", TK_DT_LEFT )
    it = tkRBand_AddSummary( b, RF( 346, 8, 440, 28 ), 4, TKRS_SUM, TKRS_SCOPE_REPORT, "$#,##0.00" ) : it->font = bold
    b = tkReport_GetBand( rpt, TKRB_PAGE_FOOTER )
    tkRBand_SetHeight( b, 18 )
    tkRBand_AddPageInfo( b, RF( 0, 2, 480, 18 ), "{title}  -  page {p} of {n}" )->font.pt = 8
    return rpt
end function

if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
dim as TK_REPORT ptr rpt = OrdersReport( )
dim as TK_PRINTDOC ptr doc = tkReport_CreateDoc( rpt )
dim as string png = ArgValue( "--png" ), pdf = ArgValue( "--pdf" )
if len( png ) orelse len( pdf ) then
    tkPrintDoc_Generate( doc )
    if len( png ) then print "png: " & tkPrintDoc_ExportPng( doc, png & "-p{p}.png", 110 ) & " pages " & tkPrintDoc_GetPageCount( doc )
    if len( pdf ) then print "pdf: " & tkPrintDoc_ExportPdf( doc, pdf )
else
    dim as TK_HOST ptr h = tkHost_Create( "tkReport R4 demo", 1000, 900, tkHost_FontDir() & TK_FONT_UI )
    dim as TK_WIDGET ptr rv = tkReportViewer_Create( tkHost_Root( h ), 1 )
    tkWidget_SetPos( rv, 0, 0, tkHost_Scale( h, 1000 ), tkHost_Scale( h, 900 ) )
    tkPrintDoc_BeginGenerate( doc )
    tkReportViewer_SetDocument( rv, doc )
    tkHost_Show( h )
    tkHost_Run( h )
    tkHost_Destroy( h )
end if
tkPrintDoc_Destroy( doc )
tkReport_Destroy( rpt )
TTF_Quit()
SDL_Quit()
