' The record frmOrder binds (Form Designer DataType validdata.Order): one field per kind of check
' B2 makes -- a whole number with a range, a date in a text box's Format, a byte a number control can
' overflow, a required date, a required choice, a value a slider clamps.
#module "validdata"

#import "std/chrono"
using chrono

public type Order
    Qty as long             ' txtQty: Required, 1 to 999
    Shipped as LocalDate    ' txtShipped: Format dd/MM/yyyy
    Weight as ubyte         ' nudWeight: its range is 0..1000, the field's 0..255
    Due as LocalDate        ' dtDue: Required (AllowEmpty, so it can be empty)
    Kind as long            ' cboKind: Required (-1 = nothing chosen)
    Volume as double        ' sldVol: 0..100
end type
