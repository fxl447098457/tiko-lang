' tkValidateForm self-test (Form Designer B2). frmOrder was written as a .tkform with rules and a
' ValidationError handler and generated by tkEdit --generate-forms; this drives the generated code.
' A presenter stands in for the default message box (which would wait for a click).
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkForms"
#import "vendor/tkControls/tkBind"
#import "vendor/tkControls/tkTextBox"
#import "vendor/tkControls/tkNumericUpDown"
#import "vendor/tkControls/tkDatePicker"
#import "vendor/tkControls/tkComboBox"
#import "vendor/tkControls/tkSlider"
#import "std/chrono"
#import "./frmOrder"
#import "./validdata"
using tkApp
using tkForms
using tkBind
using tkTextBox
using tkNumericUpDown
using tkDatePicker
using tkComboBox
using tkSlider
using tkHost
using tkCalendar
using tkTest

dim shared as long gShown
dim shared as ustring gShownText
dim shared as boolean gShownLoading

sub Presenter( byval f as TK_FORM ptr, byref e as TKBIND_ERRORS, byval bLoading as boolean )
    gShown += 1
    gShownText = e.Text( )
    gShownLoading = bLoading
end sub

' A record whose every field says it was not written.
function Untouched( ) as validdata.Order
    dim as validdata.Order r
    r.Qty = -7 : r.Weight = 77 : r.Kind = -9 : r.Volume = -1
    return r
end function

sub Order( byval owner as TK_FORM ptr )
    tkTest_Begin( "a designed form with rules" )
    tkBind_SetErrorPresenter( @Presenter )
    dim as frmOrder.Form f
    f.Build( owner )
    tkTest_Check( "Build opened the window", f.IsOpen( ) )
    dim as TK_HOST ptr h = tkForm_Host( f.Handle )
    f.Show( )
    tkTest_PumpFor( h, 60 )

    ' a clean load: every control shows its field, nothing reported
    dim as validdata.Order r
    r.Qty = 5 : r.Shipped = chrono.LocalDate( 2026, 3, 5 ) : r.Weight = 20
    r.Due = chrono.LocalDate( 2026, 12, 1 ) : r.Kind = 1 : r.Volume = 40
    tkTest_Check( "LoadFrom: true, nothing reported", f.LoadFrom( r ) andalso (f.Invalids = 0) andalso (gShown = 0), f.LastErrors )
    tkTest_Check( "LoadFrom: the Format shapes the date", tkTextBox_GetText( f.txtShipped.Handle ) = "05/03/2026", tkTextBox_GetText( f.txtShipped.Handle ) )
    tkTest_Check( "LoadFrom: a number, a choice, a slider", (tkTextBox_GetText( f.txtQty.Handle ) = "5") andalso (tkComboBox_GetCurSel( f.cboKind.Handle ) = 1) _
        andalso (tkSlider_GetValue( f.sldVol.Handle ) = 40) )

    ' text that is no number: SaveTo writes nothing, the handler hears, then the presenter
    tkTextBox_SetText( f.txtQty.Handle, "abc" )
    dim as validdata.Order r2 = Untouched( )
    tkTest_Check( "SaveTo: false on 'abc'", f.SaveTo( r2 ) = false )
    tkTest_Check( "  ... and nothing written (all or nothing)", (r2.Qty = -7) andalso (r2.Weight = 77) andalso (r2.Kind = -9) andalso (r2.Volume = -1) )
    tkTest_Check( "  ... the handler first, told it was a save", (f.Invalids = 1) andalso (f.LastLoading = false) _
        andalso (f.LastErrors = "Qty: 'abc' is not a number"), f.LastErrors )
    tkTest_Check( "  ... then the presenter, the handler having left Handled", (gShown = 1) andalso (gShownText = f.LastErrors) )
    tkTest_Check( "  ... the text box marked, the others not", tkTextBox_GetError( f.txtQty.Handle ) andalso (tkTextBox_GetError( f.txtShipped.Handle ) = false) )
    f.HandleIt = true
    tkTest_Check( "Handled: SaveTo still false", f.SaveTo( r2 ) = false )
    tkTest_Check( "  ... the presenter not called", (f.Invalids = 2) andalso (gShown = 1) )
    f.HandleIt = false

    ' fixed: everything is written, the mark goes
    tkTextBox_SetText( f.txtQty.Handle, " 12 " )
    tkTest_Check( "SaveTo: true once it is a number", f.SaveTo( r2 ) andalso (f.Invalids = 2) )
    tkTest_Check( "  ... every field written", (r2.Qty = 12) andalso (r2.Weight = 20) andalso (r2.Kind = 1) andalso (r2.Volume = 40) _
        andalso r2.Shipped.IsValid andalso (r2.Shipped.Day = 5) andalso (r2.Shipped.Month = 3) andalso r2.Due.IsValid, _
        r2.Qty & " " & r2.Weight & " " & r2.Kind & " " & r2.Volume )
    tkTest_Check( "  ... the mark cleared", tkTextBox_GetError( f.txtQty.Handle ) = false )

    ' the rules and the field types, one at a time
    tkTextBox_SetText( f.txtQty.Handle, "1000" )
    tkTest_Check( "Maximum 999", (f.SaveTo( r2 ) = false) andalso (f.LastErrors = "Qty: 1000 is above the maximum, 999"), f.LastErrors )
    tkTextBox_SetText( f.txtQty.Handle, "" )
    tkTest_Check( "Required", (f.SaveTo( r2 ) = false) andalso (f.LastErrors = "Qty: is required"), f.LastErrors )
    tkTextBox_SetText( f.txtQty.Handle, "12" )
    tkNumericUpDown_SetValue( f.nudWeight.Handle, 300 )
    tkTest_Check( "300 into a ubyte", (f.SaveTo( r2 ) = false) andalso (f.LastErrors = "Weight: 300 is outside 0 to 255"), f.LastErrors )
    tkNumericUpDown_SetValue( f.nudWeight.Handle, 20 )
    tkTextBox_SetText( f.txtShipped.Handle, "35/03/2026" )
    tkTest_Check( "a date not in the Format", (f.SaveTo( r2 ) = false) andalso (f.LastErrors = "Shipped: '35/03/2026' is not a date (dd/MM/yyyy)"), f.LastErrors )
    tkTextBox_SetText( f.txtShipped.Handle, "17/08/2025" )
    tkComboBox_SetCurSel( f.cboKind.Handle, -1 )
    tkDatePicker_ClearDate( f.dtDue.Handle )
    tkTest_Check( "no choice and no date, both Required, in form order", (f.SaveTo( r2 ) = false) _
        andalso (f.LastErrors = "Due: is required" & !"\n" & "Kind: is required"), f.LastErrors )
    tkComboBox_SetCurSel( f.cboKind.Handle, 2 )
    tkDatePicker_SetDateValue( f.dtDue.Handle, tkCalendar_MakeDate( 2027, 1, 31 ) )
    tkTest_Check( "all fixed: saved, the Format read back", f.SaveTo( r2 ) andalso (r2.Shipped.Year = 2025) andalso (r2.Shipped.Month = 8) _
        andalso (r2.Kind = 2) andalso (r2.Due.Year = 2027) )

    ' LoadFrom: a value the control can't show as it is
    r.Volume = 130 : r.Kind = 7
    dim as long nShown = gShown
    tkTest_Check( "LoadFrom: false on a clamp", f.LoadFrom( r ) = false )
    ' an index past the list leaves the combo's old choice (2): B1 would have saved that back silently
    tkTest_Check( "  ... told it was a load: the list's missing entry, the slider's clamp", f.LastLoading andalso gShownLoading _
        andalso (f.LastErrors = "Kind: 7 is shown as 2" & !"\n" & "Volume: 130 is shown as 100") andalso (gShown = nShown + 1), f.LastErrors )
    tkTest_Check( "  ... it still loaded, clamped", tkSlider_GetValue( f.sldVol.Handle ) = 100 )

    tkBind_SetErrorPresenter( 0 )
    f.Close( )
    tkTest_PumpFor( h, 40 )
end sub

if tkTest_Init() = false then end 99
dim as TKAPP_OPTIONS opts
if tkApp_Init( opts ) = false then
    print "tkApp_Init failed"
    end 98
end if
dim as TK_FORM ptr mainForm = tkApp_NewForm( "owner", 200, 120, 0, 1.0 )
tkForm_Show( mainForm )
tkTest_PumpFor( tkForm_Host( mainForm ), 50 )
Order( mainForm )
dim as long nFail = tkTest_Report( "tkValidateForm" )
tkApp_Shutdown( )
end nFail
