' frmOrder's own code: its ValidationError handler, which the generated SaveTo / LoadFrom call
' before tkBind's default report. It counts the calls and keeps what it was told; Handled = HandleIt.
#module "frmOrder"

#import "vendor/tkControls/tkBind"
using tkBind

public partial type Form
    Invalids as long
    LastErrors as ustring
    LastLoading as boolean
    HandleIt as boolean
end type

sub Form.OnInvalid( byref Errors as TKBIND_ERRORS, byval Loading as boolean, byref Handled as boolean )
    Invalids += 1
    LastErrors = Errors.Text( )
    LastLoading = Loading
    Handled = HandleIt
end sub
