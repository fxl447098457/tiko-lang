format = 1

[form]
caption = "Order"
width = 420
height = 320
data_type = "validdata.Order"
data_module = "../validdata"

[form.events]
ValidationError = "OnInvalid"

[[control]]
name = "txtQty"
type = "TextBox"
parent = ""
x = 16
y = 16
w = 160
h = 28
bind = "Qty"
required = true
minimum = "1"
maximum = "999"

[[control]]
name = "txtShipped"
type = "TextBox"
parent = ""
x = 16
y = 56
w = 160
h = 28
bind = "Shipped"
format = "dd/MM/yyyy"

[[control]]
name = "nudWeight"
type = "NumericUpDown"
parent = ""
x = 16
y = 96
w = 120
h = 28
bind = "Weight"

[control.props]
Range = "0,1000"

[[control]]
name = "dtDue"
type = "DatePicker"
parent = ""
x = 16
y = 136
w = 160
h = 28
bind = "Due"
required = true

[control.props]
AllowEmpty = true

[[control]]
name = "cboKind"
type = "ComboBox"
parent = ""
x = 16
y = 176
w = 160
h = 28
bind = "Kind"
required = true

[[control.items]]
text = "Box"

[[control.items]]
text = "Pallet"

[[control.items]]
text = "Crate"

[[control]]
name = "sldVol"
type = "Slider"
parent = ""
x = 16
y = 216
w = 300
h = 32
bind = "Volume"

[control.props]
Range = "0,100"
