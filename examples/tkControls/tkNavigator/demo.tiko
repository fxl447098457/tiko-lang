' tkNavigator demo: three navigators. The first steps through a small contact list shown on a
' card below it (New appends a contact, Delete removes the one on show and is refused for a locked
' one); the second is a read-only 120-row pager with its own position text; the third is empty.
'
'   demo                     interactive (click the buttons; hover for the tooltips)
'   demo --shot out.bmp      render once, save the window, exit
'   demo --scale 1.75        pin the scale instead of asking the display
#import "vendor/tkControls/tkNavigator"
using tkNavigator
using tkTheme
using tkHost
using tkPaint

type CONTACT
    sName  as ustring
    sCity  as ustring
    sPhone as ustring
    sEmail as ustring
    bLocked as boolean
end type

const as long MAX_CONTACTS = 40
dim shared as CONTACT gRec(0 to MAX_CONTACTS - 1)
dim shared as long gCount, gNewSeq
dim shared as TK_HOST ptr gHost
dim shared as TK_WIDGET ptr gNav(0 to 2)
dim shared as ustring gLabel(0 to 2)
dim shared as TTF_Font ptr gFont, gFontBold

private sub AddContact( byref n as ustring, byref c as ustring, byref p as ustring, byref e as ustring, byval bLocked as boolean = false )
    if gCount >= MAX_CONTACTS then exit sub
    gRec(gCount).sName = n : gRec(gCount).sCity = c : gRec(gCount).sPhone = p
    gRec(gCount).sEmail = e : gRec(gCount).bLocked = bLocked
    gCount += 1
end sub

' The contact list's navigator: the program owns the array, the navigator owns the position.
function Contacts_Navigate( byval hNav as TK_WIDGET ptr, byval action as int32, byval target as int32 ) as boolean
    select case action
    case TKNAV_NEW
        if gCount >= MAX_CONTACTS then print "new: refused, the list is full" : return false
        gNewSeq += 1
        AddContact( "New contact " & gNewSeq, "", "", "" )
        print "new: contact " & target & " added (" & gCount & " now)"
    case TKNAV_DELETE
        if gRec(target).bLocked then print "delete " & target & ": refused, " & gRec(target).sName & " is locked" : return false
        print "delete " & target & ": " & gRec(target).sName
        for i as long = target to gCount - 2
            gRec(i) = gRec(i + 1)
        next
        gCount -= 1
    case else
        print "go to contact " & target & ": " & gRec(target).sName
    end select
    tkHost_Invalidate( gHost )                     ' the card shows the new record
    return true                                    ' allow: the navigator moves itself
end function

function Pager_Navigate( byval hNav as TK_WIDGET ptr, byval action as int32, byval target as int32 ) as boolean
    print "pager " & hNav->ctrlId & ": action " & action & " -> row " & target
    return true
end function

private sub PaintField( byval b as TK_PAINT ptr, byref cap as ustring, byref v as ustring, byval x as long, byval y as long, byval w as long, byref t as TKTHEME_COLORS )
    dim as TKRECT rc
    tkRect_Set( rc, x, y, x + tkHost_Scale( gHost, 70 ), y + tkHost_Scale( gHost, 22 ) )
    b->SetForeColor( t.TextDim )
    b->PaintText( cap, @rc, TK_DT_LEFT or TK_DT_VCENTER )
    tkRect_Set( rc, x + tkHost_Scale( gHost, 70 ), y, x + w, y + tkHost_Scale( gHost, 22 ) )
    dim as ustring sv = v
    if len( sv ) = 0 then sv = "-"
    b->SetForeColor( t.Text )
    b->PaintText( sv, @rc, TK_DT_LEFT or TK_DT_VCENTER or TK_DT_ELLIPSIS )
end sub

private sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    dim as TKTHEME_COLORS t = tkTheme_Of( tkHost_Root( h ) )
    b->SetFont( gFont )
    b->SetColors( t.TextDim, t.Window )
    dim as long ys(0 to 2) = { 20, 206, 256 }
    for i as long = 0 to 2
        dim as TKRECT rc
        tkRect_Set( rc, tkHost_Scale( h, 20 ), tkHost_Scale( h, ys(i) ), tkHost_Scale( h, 240 ), tkHost_Scale( h, ys(i) + 30 ) )
        b->PaintText( gLabel(i), @rc, TK_DT_LEFT or TK_DT_VCENTER )
    next
    ' the card: the contact on show
    dim as TKRECT card
    tkRect_Set( card, tkHost_Scale( h, 250 ), tkHost_Scale( h, 60 ), tkHost_Scale( h, 620 ), tkHost_Scale( h, 186 ) )
    b->SetBackColor( t.Surface )
    b->PaintRoundRect( @card, tkHost_Scale( h, 8 ) )
    b->SetPenColor( t.Border )
    b->PaintRoundOutline( @card, tkHost_Scale( h, 8 ), 1 )
    dim as long x = card.left + tkHost_Scale( h, 14 ), w = card.right - card.left - tkHost_Scale( h, 28 )
    dim as long y = card.top + tkHost_Scale( h, 10 )
    dim as long p = tkNavigator_GetPosition( gNav(0) )
    dim as TKRECT rc
    tkRect_Set( rc, x, y, x + w, y + tkHost_Scale( h, 26 ) )
    b->SetFont( gFontBold )
    b->SetColors( t.TextStrong, t.Surface )
    if p < 0 then
        b->PaintText( "No contact", @rc, TK_DT_LEFT or TK_DT_VCENTER )
        exit sub
    end if
    b->PaintText( gRec(p).sName & iif( gRec(p).bLocked, "  (locked)", "" ), @rc, TK_DT_LEFT or TK_DT_VCENTER or TK_DT_ELLIPSIS )
    b->SetFont( gFont )
    y += tkHost_Scale( h, 32 )
    PaintField( b, "City",  gRec(p).sCity,  x, y, w, t ) : y += tkHost_Scale( h, 24 )
    PaintField( b, "Phone", gRec(p).sPhone, x, y, w, t ) : y += tkHost_Scale( h, 24 )
    PaintField( b, "Email", gRec(p).sEmail, x, y, w, t )
end sub

private sub Form_Size( byval h as TK_HOST ptr )
    dim as long ys(0 to 2) = { 20, 206, 256 }
    for i as long = 0 to 2
        tkWidget_SetPos( gNav(i), tkHost_Scale( h, 250 ), tkHost_Scale( h, ys(i) ), tkNavigator_GetIdealWidth( gNav(i) ), tkHost_Scale( h, 30 ) )
    next
end sub

private function ArgValue( byref name_ as string ) as string
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

private function HasArg( byref name_ as string ) as boolean
    for i as long = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return true
    next
    return false
end function

private sub SaveShot( byval h as TK_HOST ptr, byref path as string )
    tkHost_Render( h )
    tkHost_RenderTo( h, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( h->renderer, 0 )
    if s then
        SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & h->fScale
        SDL_DestroySurface( s )
    end if
end sub

if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
dim as single forced = val( ArgValue( "--scale" ) )
gHost = tkHost_Create( "tkNavigator on SDL3", 660, 310, tkHost_FontDir() & TK_FONT_UI, forced )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
gHost->clrBack = tkTheme_Of( tkHost_Root( gHost ) ).Window
gFont = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 10 )
gFontBold = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI_BOLD, 12 )

AddContact( "Ada Lovelace",     "London",    "+44 20 7946 0012", "ada@analytical.example", true )
AddContact( "Grace Hopper",     "Arlington", "+1 703 555 0147",  "grace@cobol.example" )
AddContact( "Edsger Dijkstra",  "Austin",    "+1 512 555 0190",  "ewd@shortest.example" )
AddContact( "Barbara Liskov",   "Cambridge", "+1 617 555 0133",  "liskov@clu.example" )
AddContact( "Niklaus Wirth",    "Zurich",    "+41 44 555 0108",  "wirth@pascal.example" )
AddContact( "Margaret Hamilton","Boston",    "+1 617 555 0169",  "mh@apollo.example" )
AddContact( "Dennis Ritchie",   "Murray Hill","+1 908 555 0121", "dmr@unix.example" )
AddContact( "Frances Allen",    "Yorktown",  "+1 914 555 0155",  "fran@ptran.example" )

gLabel(0) = "contacts (Ada is locked)"
gLabel(1) = "120-row pager, no New / Delete"
gLabel(2) = "empty: only New is enabled"
for i as long = 0 to 2
    gNav(i) = tkNavigator_Create( tkHost_Root( gHost ), 100 + i )
next
tkNavigator_SetCount( gNav(0), gCount )
tkNavigator_SetPosition( gNav(0), 2 )                   ' "3 of 8"
tkNavigator_SetButtonTip( gNav(0), TKNAV_NEW, "Add a contact" )
tkNavigator_SetButtonTip( gNav(0), TKNAV_DELETE, "Delete this contact" )
tkNavigator_SetNavigateCallback( gNav(0), @Contacts_Navigate )
tkNavigator_SetCount( gNav(1), 120 )
tkNavigator_SetPosition( gNav(1), 41 )
tkNavigator_SetPositionText( gNav(1), "Row {1} / {2}" )
tkNavigator_SetShowNew( gNav(1), false )
tkNavigator_SetShowDelete( gNav(1), false )
tkNavigator_SetNavigateCallback( gNav(1), @Pager_Navigate )
tkNavigator_SetNavigateCallback( gNav(2), @Pager_Navigate )

gHost->OnPaint = @Form_Paint
gHost->OnSize = @Form_Size
Form_Size( gHost )
tkHost_Show( gHost )

dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )
    SaveShot( gHost, shot )
else
    tkHost_Run( gHost )
end if
tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
