' tkNavigator self-test (Form Designer B4). Real windows, real SDL events: a click is the pushed
' press and release a user makes. Two passes, scale 1.0 and 1.75; geometry is asserted.
'
'   selftest            exit code = number of failures
#import "vendor/tkControls/tkNavigator"
#import "vendor/tkControls/tkTest"
using tkNavigator
using tkTheme
using tkTest
using tkHost
using tkPaint

dim shared as long gCalls, gAction, gTarget
dim shared as boolean gAllow = true

function OnNavigate( byval hNav as TK_WIDGET ptr, byval action as int32, byval target as int32 ) as boolean
    gCalls += 1
    gAction = action : gTarget = target
    return gAllow
end function

' The window point at the centre of a part.
sub PartXY( byval nav as TK_WIDGET ptr, byval part as long, byref x as single, byref y as single )
    dim as TKRECT rc, a
    tkNavigator_GetPartRect( nav, part, rc )
    tkWidget_AbsRect( nav, a )
    x = a.left + (rc.left + rc.right) / 2
    y = a.top + (rc.top + rc.bottom) / 2
end sub

sub ClickPart( byval h as TK_HOST ptr, byval nav as TK_WIDGET ptr, byval part as long )
    dim as single x, y
    PartXY( nav, part, x, y )
    tkTest_PushMotion( h, x, y )
    tkTest_Click( h, x, y )
    tkTest_PumpFor( h, 20 )
end sub

sub RunPass( byval fScale as single )
    tkTest_Begin( "scale " & fScale )
    dim as TK_HOST ptr h = tkHost_Create( "tkNavigator selftest", 520, 200, tkHost_FontDir() & TK_FONT_UI, fScale )
    tkHost_Show( h )
    tkTest_PumpFor( h, 50 )
    dim as TK_WIDGET ptr nav = tkNavigator_Create( tkHost_Root( h ), 101 )
    dim as long navH = tkHost_Scale( h, 30 )
    tkWidget_SetPos( nav, tkHost_Scale( h, 10 ), tkHost_Scale( h, 10 ), tkHost_Scale( h, 400 ), navH )
    tkNavigator_SetNavigateCallback( nav, @OnNavigate )
    gCalls = 0 : gAllow = true

    ' ---- empty: no position, only New does anything
    tkTest_Check( "empty: count 0, position -1, '- of 0'", (tkNavigator_GetCount( nav ) = 0) andalso (tkNavigator_GetPosition( nav ) = -1) _
        andalso (tkNavigator_GetText( nav ) = "- of 0"), tkNavigator_GetText( nav ) )
    tkTest_Check( "empty: only New enabled", tkNavigator_GetPartEnabled( nav, TKNAV_NEW ) andalso (tkNavigator_GetPartEnabled( nav, TKNAV_FIRST ) = false) _
        andalso (tkNavigator_GetPartEnabled( nav, TKNAV_NEXT ) = false) andalso (tkNavigator_GetPartEnabled( nav, TKNAV_DELETE ) = false) )

    ' ---- geometry: buttons left to right, the text between Prev and Next, scaled
    tkNavigator_SetCount( nav, 120 )
    tkNavigator_SetPosition( nav, 2 )
    tkTest_PumpFor( h, 20 )
    dim as TKRECT r( 0 to TKNAVIGATOR_PARTS - 1 )
    for part as long = 0 to TKNAVIGATOR_PARTS - 1
        tkNavigator_GetPartRect( nav, part, r( part ) )
    next
    dim as long bw = tkHost_Scale( h, TKNAVIGATOR_DEFAULT_BUTTONW )
    tkTest_Check( "buttons are ButtonW wide and full height", (r( TKNAV_FIRST ).right - r( TKNAV_FIRST ).left = bw) _
        andalso (r( TKNAV_NEXT ).right - r( TKNAV_NEXT ).left = bw) andalso (r( TKNAV_FIRST ).bottom - r( TKNAV_FIRST ).top = navH), _
        (r( TKNAV_FIRST ).right - r( TKNAV_FIRST ).left) & " vs " & bw )
    tkTest_Check( "order: First Prev Text Next Last New Delete, touching", (r( TKNAV_FIRST ).left = 0) andalso (r( TKNAV_PREV ).left = r( TKNAV_FIRST ).right) _
        andalso (r( TKNAV_TEXT ).left = r( TKNAV_PREV ).right) andalso (r( TKNAV_NEXT ).left = r( TKNAV_TEXT ).right) _
        andalso (r( TKNAV_LAST ).left = r( TKNAV_NEXT ).right) andalso (r( TKNAV_NEW ).left = r( TKNAV_LAST ).right) _
        andalso (r( TKNAV_DELETE ).left = r( TKNAV_NEW ).right) )
    tkTest_Check( "the text is at least TextMinW", r( TKNAV_TEXT ).right - r( TKNAV_TEXT ).left >= tkHost_Scale( h, TKNAVIGATOR_DEFAULT_TEXTMINW ) )
    tkTest_Check( "ideal width = the last part's right", tkNavigator_GetIdealWidth( nav ) = r( TKNAV_DELETE ).right )
    tkTest_Check( "'3 of 120'", tkNavigator_GetText( nav ) = "3 of 120", tkNavigator_GetText( nav ) )

    ' ---- clicks: each button asks, then moves
    ClickPart( h, nav, TKNAV_NEXT )
    tkTest_Check( "Next: asked (NEXT, 3), moved to 3", (gCalls = 1) andalso (gAction = TKNAV_NEXT) andalso (gTarget = 3) _
        andalso (tkNavigator_GetPosition( nav ) = 3), gCalls & " " & gAction & " " & gTarget )
    ClickPart( h, nav, TKNAV_LAST )
    tkTest_Check( "Last: to 119", (gAction = TKNAV_LAST) andalso (tkNavigator_GetPosition( nav ) = 119) )
    tkTest_Check( "at the end: Next and Last disabled, Prev and First not", (tkNavigator_GetPartEnabled( nav, TKNAV_NEXT ) = false) _
        andalso (tkNavigator_GetPartEnabled( nav, TKNAV_LAST ) = false) andalso tkNavigator_GetPartEnabled( nav, TKNAV_PREV ) _
        andalso tkNavigator_GetPartEnabled( nav, TKNAV_FIRST ) )
    dim as long n0 = gCalls
    ClickPart( h, nav, TKNAV_NEXT )
    tkTest_Check( "a disabled button: no call, no move", (gCalls = n0) andalso (tkNavigator_GetPosition( nav ) = 119) )
    ClickPart( h, nav, TKNAV_PREV )
    tkTest_Check( "Prev: to 118", (gAction = TKNAV_PREV) andalso (gTarget = 118) andalso (tkNavigator_GetPosition( nav ) = 118) )
    ClickPart( h, nav, TKNAV_FIRST )
    tkTest_Check( "First: to 0; First and Prev now disabled", (tkNavigator_GetPosition( nav ) = 0) _
        andalso (tkNavigator_GetPartEnabled( nav, TKNAV_FIRST ) = false) andalso (tkNavigator_GetPartEnabled( nav, TKNAV_PREV ) = false) )
    ClickPart( h, nav, TKNAV_NEW )
    tkTest_Check( "New: asked (NEW, 120), now 121, at the new one", (gAction = TKNAV_NEW) andalso (gTarget = 120) _
        andalso (tkNavigator_GetCount( nav ) = 121) andalso (tkNavigator_GetPosition( nav ) = 120) )
    ClickPart( h, nav, TKNAV_DELETE )
    tkTest_Check( "Delete of the last: asked (DELETE, 120), 120 left, at the new last", (gAction = TKNAV_DELETE) andalso (gTarget = 120) _
        andalso (tkNavigator_GetCount( nav ) = 120) andalso (tkNavigator_GetPosition( nav ) = 119) )
    tkNavigator_SetPosition( nav, 5 )
    ClickPart( h, nav, TKNAV_DELETE )
    tkTest_Check( "Delete in the middle stays at 5", (tkNavigator_GetCount( nav ) = 119) andalso (tkNavigator_GetPosition( nav ) = 5) )

    ' ---- a refusal holds everything
    gAllow = false
    ClickPart( h, nav, TKNAV_NEXT )
    ClickPart( h, nav, TKNAV_NEW )
    tkTest_Check( "Allow false: asked, nothing moves", (gAction = TKNAV_NEW) andalso (tkNavigator_GetPosition( nav ) = 5) andalso (tkNavigator_GetCount( nav ) = 119) )
    gAllow = true

    ' ---- the setters are silent
    n0 = gCalls
    tkNavigator_SetCount( nav, 3 )
    tkTest_Check( "SetCount clamps the position, silently", (tkNavigator_GetPosition( nav ) = 2) andalso (gCalls = n0) )
    tkNavigator_SetPosition( nav, 99 )
    tkTest_Check( "SetPosition clamps", tkNavigator_GetPosition( nav ) = 2 )
    tkNavigator_SetCount( nav, 1 )
    ClickPart( h, nav, TKNAV_DELETE )
    tkTest_Check( "Delete of the only one: none left, position -1", (tkNavigator_GetCount( nav ) = 0) andalso (tkNavigator_GetPosition( nav ) = -1) )

    ' ---- hidden parts, the text pattern
    tkNavigator_SetCount( nav, 4 ) : tkNavigator_SetPosition( nav, 1 )
    tkNavigator_SetShowNew( nav, false )
    tkNavigator_SetShowDelete( nav, false )
    dim as TKRECT rn
    tkTest_Check( "New and Delete hidden: no rect, not enabled", (tkNavigator_GetPartRect( nav, TKNAV_NEW, rn ) = false) _
        andalso (tkNavigator_GetPartEnabled( nav, TKNAV_DELETE ) = false) )
    tkNavigator_GetPartRect( nav, TKNAV_LAST, rn )
    tkTest_Check( "the ideal width ends at Last", tkNavigator_GetIdealWidth( nav ) = rn.right )
    tkNavigator_SetPositionText( nav, "Record {1} / {2}" )
    tkTest_Check( "a position pattern", tkNavigator_GetText( nav ) = "Record 2 / 4", tkNavigator_GetText( nav ) )
    tkNavigator_SetShowNew( nav, true ) : tkNavigator_SetShowDelete( nav, true )
    tkNavigator_SetPositionText( nav, "{1} of {2}" )

    ' ---- painting: hot, disabled glyphs, the colours by pixel
    dim as TKNAVIGATOR_COLORS c
    tkNavigator_GetColors( nav, @c )
    c.BackColor = &hFF102030ul : c.ButtonBackHot = &hFF00FF00ul : c.GlyphColorDisabled = &hFF0000FFul : c.GlyphColor = &hFFFFFF00ul
    tkNavigator_SetColors( nav, @c )
    tkNavigator_SetPosition( nav, 0 )
    dim as single hx, hy
    PartXY( nav, TKNAV_NEXT, hx, hy )
    tkTest_PushMotion( h, hx, hy )
    tkTest_PumpFor( h, 20 )
    tkHost_RenderTo( h, false )
    dim as TKRECT a, rnx, rfirst
    tkWidget_AbsRect( nav, a )
    tkNavigator_GetPartRect( nav, TKNAV_NEXT, rnx )
    tkNavigator_GetPartRect( nav, TKNAV_FIRST, rfirst )
    tkTest_Check( "hot: Next's corner in ButtonBackHot", (tkNavigator_GetHot( nav ) = TKNAV_NEXT) _
        andalso (tkTest_PixelAt( h, a.left + rnx.left + 2, a.top + rnx.top + 2 ) = &hFF00FF00ul), hex( tkTest_PixelAt( h, a.left + rnx.left + 2, a.top + rnx.top + 2 ) ) )
    tkTest_Check( "idle: First's corner in BackColor", tkTest_PixelAt( h, a.left + rfirst.left + 2, a.top + rfirst.top + 2 ) = &hFF102030ul )
    dim as long fcx = a.left + (rfirst.left + rfirst.right) \ 2, fcy = a.top + (rfirst.top + rfirst.bottom) \ 2
    dim as boolean blue = false, yellow = false
    for yy as long = fcy - tkHost_Scale( h, 6 ) to fcy + tkHost_Scale( h, 6 )
        for xx as long = fcx - tkHost_Scale( h, 8 ) to fcx + tkHost_Scale( h, 8 )
            if tkTest_PixelAt( h, xx, yy ) = &hFF0000FFul then blue = true
        next
    next
    dim as long ncx = a.left + (rnx.left + rnx.right) \ 2, ncy = a.top + (rnx.top + rnx.bottom) \ 2
    for yy as long = ncy - tkHost_Scale( h, 6 ) to ncy + tkHost_Scale( h, 6 )
        for xx as long = ncx - tkHost_Scale( h, 8 ) to ncx + tkHost_Scale( h, 8 )
            if tkTest_PixelAt( h, xx, yy ) = &hFFFFFF00ul then yellow = true
        next
    next
    tkTest_Check( "First at the start draws its glyph disabled, Next enabled", blue andalso yellow, blue & " " & yellow )
    tkTest_PushMotion( h, 1, 1 )
    tkTest_PumpFor( h, 20 )
    tkTest_Check( "leaving: no hot part", tkNavigator_GetHot( nav ) = -1 )

    ' ---- the theme: pinned colours stay; unpinned they follow
    tkNavigator_UnpinColors( nav )
    tkNavigator_GetColors( nav, @c )
    dim as TKTHEME_COLORS th = tkTheme_Of( nav )
    tkTest_Check( "unpinned: the theme's", (c.BackColor = th.Window) andalso (c.GlyphColor = th.Text) andalso (c.GlyphColorDisabled = th.TextDisabled) )

    ' ---- a disabled navigator does nothing
    tkWidget_Enable( nav, false )
    n0 = gCalls
    ClickPart( h, nav, TKNAV_NEXT )
    tkTest_Check( "disabled: no part enabled, no call", (tkNavigator_GetPartEnabled( nav, TKNAV_NEXT ) = false) andalso (gCalls = n0) )
    tkWidget_Enable( nav, true )
    tkTest_Check( "not a focus stop", nav->isFocusable = false )

    tkWidget_Destroy( nav )
    tkHost_Destroy( h )
end sub

if tkTest_Init() = false then end 99
RunPass( 1.0 )
RunPass( 1.75 )
dim as long nFail = tkTest_Report( "tkNavigator" )
tkTest_Quit()
end nFail
