'' named -- named groups: (?<name>...) in the pattern, then the group read back by name, by
'' number, as a copy PCRE2 allocates, and as the whole list; what the pattern says about itself.
''
'' Build it with 'tiko named.tiko'.
''
'' PCRE2 is BSD-licensed (pkg/vendor/pcre2/LICENSE); so is this.

#import "vendor/pcre2" link dynamic

function Compile( byref pattern as const string, byval options as uint32 = 0 ) as pcre2_code ptr
    dim as int32 errorCode
    dim as PCRE2_SIZE errorOffset
    dim as pcre2_code ptr re = pcre2_compile( strptr( pattern ), len( pattern ), options, _
                                              @errorCode, @errorOffset, nullptr )
    if re = nullptr then
        dim as zstring * 256 message
        pcre2_get_error_message( errorCode, cast( PCRE2_UCHAR ptr, @message ), sizeof( message ) )
        print "pattern error at offset "; errorOffset; ": "; message
        end 1
    end if
    return re
end function

'' A group by name, copied out of the match into a string. pcre2_substring_get_byname allocates
'' the copy; it is PCRE2's to free, with pcre2_substring_free. An unset group is an error code.
function ByName( byval md as pcre2_match_data ptr, byref name_ as const string ) as string
    dim as PCRE2_UCHAR ptr text
    dim as PCRE2_SIZE length
    dim as int32 rc = pcre2_substring_get_byname( md, strptr( name_ ), @text, @length )
    if rc = PCRE2_ERROR_UNSET then return "(unset)"
    if rc < 0 then return "(error " & rc & ")"
    dim as string result = left( *cast( zstring ptr, text ), length )
    pcre2_substring_free( text )
    return result
end function

dim as string pattern = "(?<year>\d{4})-(?<month>\d\d)-(?<day>\d\d)(?:T(?<time>\d\d:\d\d))?"
dim as pcre2_code ptr re = Compile( pattern )

'' What the compiled pattern says about itself.
dim as uint32 captures, names
pcre2_pattern_info( re, PCRE2_INFO_CAPTURECOUNT, @captures )
pcre2_pattern_info( re, PCRE2_INFO_NAMECOUNT, @names )
print "groups: "; captures; ", named: "; names
dim as string groupNames( ... ) = { "year", "month", "day", "time" }
for each n as string in groupNames
    print "  "; n; " is group"; pcre2_substring_number_from_name( re, strptr( n ) )
next

dim as pcre2_match_data ptr md = pcre2_match_data_create_from_pattern( re, nullptr )
dim as string dates( ... ) = { "Released 2026-09-28T14:05.", "Due 2026-12-01.", "No date." }
for each subject as string in dates
    print
    print subject
    dim as int32 rc = pcre2_match( re, strptr( subject ), len( subject ), 0, 0, md, nullptr )
    if rc = PCRE2_ERROR_NOMATCH then
        print "  no match"
        continue for
    end if
    print "  year "; ByName( md, "year" ); ", month "; ByName( md, "month" ); _
          ", day "; ByName( md, "day" ); ", time "; ByName( md, "time" )

    '' Into a buffer of your own, by number: no allocation, and the length comes back.
    dim as zstring * 8 buffer
    dim as PCRE2_SIZE size = sizeof( buffer )
    dim as int32 got = pcre2_substring_copy_bynumber( md, 1, cast( PCRE2_UCHAR ptr, @buffer ), @size )
    print "  group 1 copied:"; got; " -> "; buffer; " ("; size; " bytes)"

    '' Every group at once, as an array of pointers PCRE2 allocates in one block.
    dim as PCRE2_UCHAR ptr ptr list
    dim as PCRE2_SIZE ptr lengths
    pcre2_substring_list_get( md, @list, @lengths )
    for g as int32 = 0 to rc - 1
        print "  [" & g & "] "; left( *cast( zstring ptr, list[g] ), lengths[g] )
    next
    pcre2_substring_list_free( list )
next

pcre2_match_data_free( md )
pcre2_code_free( re )
