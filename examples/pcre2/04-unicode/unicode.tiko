'' unicode -- text that is not ASCII. vendor/pcre2 is PCRE2's 8-bit library, so text goes in as
'' UTF-8: a ustring assigned to a string. PCRE2_UTF reads the pattern and the subject as UTF-8,
'' PCRE2_UCP makes \w, \d, \b and the POSIX classes Unicode's, and every offset that comes back
'' counts bytes, not characters. Last, a subject that is not valid UTF-8.
''
'' Build it with 'tiko unicode.tiko'.
''
'' PCRE2 is BSD-licensed (pkg/vendor/pcre2/LICENSE); so is this.

#import "vendor/pcre2" link dynamic

function Compile( byref pattern as const string, byval options as uint32 = 0 ) as pcre2_code ptr
    dim as int32 errorCode
    dim as PCRE2_SIZE errorOffset
    dim as pcre2_code ptr re = pcre2_compile( strptr( pattern ), len( pattern ), options, _
                                              @errorCode, @errorOffset, nullptr )
    if re = nullptr then
        dim as zstring * 256 message
        pcre2_get_error_message( errorCode, cast( PCRE2_UCHAR ptr, @message ), sizeof( message ) )
        print "pattern error at offset "; errorOffset; ": "; message
        end 1
    end if
    return re
end function

function Message( byval rc as int32 ) as string
    dim as zstring * 256 text
    pcre2_get_error_message( rc, cast( PCRE2_UCHAR ptr, @text ), sizeof( text ) )
    return text
end function

'' Every match of pattern in subject, each with where it starts: in bytes, which is what PCRE2
'' says, and in characters, counted by converting the bytes before it back to a ustring.
sub ShowMatches( byref pattern as const string, byval options as uint32, byref subject as const string )
    dim as pcre2_code ptr re = Compile( pattern, options )
    dim as pcre2_match_data ptr md = pcre2_match_data_create_from_pattern( re, nullptr )
    dim as PCRE2_SIZE start = 0
    dim as uint32 more = 0
    print "  ";
    do
        dim as int32 rc = pcre2_match( re, strptr( subject ), len( subject ), start, more, md, nullptr )
        if rc = PCRE2_ERROR_NOMATCH then exit do
        if rc < 0 then print "error "; rc; ": "; Message( rc ) : exit do
        dim as PCRE2_SIZE ptr ov = pcre2_get_ovector_pointer( md )
        dim as ustring found = mid( subject, ov[0] + 1, ov[1] - ov[0] )
        dim as ustring before = left( subject, ov[0] )
        print found & " (" & ov[0] & "/" & len( before ) & ")  ";
        if pcre2_next_match( md, @start, @more ) = 0 then exit do
    loop
    print
    pcre2_match_data_free( md )
    pcre2_code_free( re )
end sub

dim as ustring text = "Zoë met Ægir and Łukasz in Malmö."
dim as string bytes = text       '' UTF-8: ë, Æ, Ł and ö are two bytes each
print "characters"; len( text ); ", UTF-8 bytes"; len( bytes )

print "words starting with a capital, (byte offset/character offset):"
print "without PCRE2_UTF, bytes:"
ShowMatches( "\b[A-Z]\w*", 0, bytes )
print "PCRE2_UTF alone: \w and \b are still ASCII -- Zoë stops at the ë, and no word"
print "boundary comes before Æ or Ł:"
ShowMatches( "\b\p{Lu}\w*", PCRE2_UTF, bytes )
print "PCRE2_UTF and PCRE2_UCP: \w is every letter, \b every word's edge:"
ShowMatches( "\b\p{Lu}\w*", PCRE2_UTF or PCRE2_UCP, bytes )

'' Case folding beyond ASCII needs PCRE2_UTF too.
dim as ustring city = "MALMÖ"
dim as string cityBytes = city
print "malmö against MALMÖ, caseless:"
ShowMatches( "malmö", PCRE2_CASELESS, cityBytes )
ShowMatches( "malmö", PCRE2_CASELESS or PCRE2_UTF, cityBytes )

'' Bytes that are not UTF-8 (E9 is é in Latin-1). With PCRE2_UTF the match stops with an error;
'' PCRE2_MATCH_INVALID_UTF makes the invalid bytes match nothing and lets the rest match.
dim as string latin1 = "caf" & chr( &hE9 ) & " au lait"
print "a subject that is not UTF-8:"
ShowMatches( "\w+", PCRE2_UTF, latin1 )
ShowMatches( "\w+", PCRE2_UTF or PCRE2_MATCH_INVALID_UTF, latin1 )
