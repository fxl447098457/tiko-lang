'' replace -- search and replace with pcre2_substitute: the first match or every match, group
'' references by number and by name, the extended syntax's case changes and conditionals, a
'' result larger than its first buffer, and an error in the replacement.
''
'' Build it with 'tiko replace.tiko'.
''
'' PCRE2 is BSD-licensed (pkg/vendor/pcre2/LICENSE); so is this.

#import "vendor/pcre2" link dynamic

function Compile( byref pattern as const string, byval options as uint32 = 0 ) as pcre2_code ptr
    dim as int32 errorCode
    dim as PCRE2_SIZE errorOffset
    dim as pcre2_code ptr re = pcre2_compile( strptr( pattern ), len( pattern ), options, _
                                              @errorCode, @errorOffset, nullptr )
    if re = nullptr then
        dim as zstring * 256 message
        pcre2_get_error_message( errorCode, cast( PCRE2_UCHAR ptr, @message ), sizeof( message ) )
        print "pattern error at offset "; errorOffset; ": "; message
        end 1
    end if
    return re
end function

'' subject with re's matches replaced. pcre2_substitute writes into a buffer the caller owns: a
'' string of spaces stands in for it. With PCRE2_SUBSTITUTE_OVERFLOW_LENGTH, a buffer too small
'' gives PCRE2_ERROR_NOMEMORY and 'size' says how large it must be (its terminating zero
'' included), so the second call fits. On success 'size' is the result's length.
function Replace( byval re as pcre2_code ptr, byref subject as const string, _
                  byref replacement as const string, _
                  byval options as uint32 = PCRE2_SUBSTITUTE_GLOBAL ) as string
    dim as string result = space( len( subject ) + 8 )
    for attempt as int32 = 1 to 2
        dim as PCRE2_SIZE size = len( result )
        dim as int32 rc = pcre2_substitute( re, strptr( subject ), len( subject ), 0, _
            options or PCRE2_SUBSTITUTE_OVERFLOW_LENGTH, nullptr, nullptr, _
            strptr( replacement ), len( replacement ), _
            cast( PCRE2_UCHAR ptr, strptr( result ) ), @size )
        if rc >= 0 then return left( result, size )
        if rc <> PCRE2_ERROR_NOMEMORY then
            dim as zstring * 256 message
            pcre2_get_error_message( rc, cast( PCRE2_UCHAR ptr, @message ), sizeof( message ) )
            return "(" & message & ")"
        end if
        print "  (" & len( result ) & " bytes were not enough: " & size & " are)"
        result = space( size )
    next
    return "(the buffer was still too small)"
end function

dim as string text = "alice@home.example, bob@work.example; carol@home.example"
dim as pcre2_code ptr re = Compile( "(?<user>\w+)@(?<site>\w+)\.example" )

print "every match, by number:"
print "  "; Replace( re, text, "$2:$1" )
print "the first match only:"
print "  "; Replace( re, text, "$2:$1", 0 )
print "by name:"
print "  "; Replace( re, text, "${user} at ${site}" )

'' PCRE2_SUBSTITUTE_EXTENDED: \U and \E change case, ${n:+yes:no} chooses on whether group n
'' was set.
dim as pcre2_code ptr title = Compile( "\b(\w)(\w*)(!)?" )
print "extended:"
print "  "; Replace( title, "hello wide world!", "\U$1\E$2${3:+ (loud)}", _
                     PCRE2_SUBSTITUTE_GLOBAL or PCRE2_SUBSTITUTE_EXTENDED )

'' A result longer than the guess: every digit becomes [digit].
dim as pcre2_code ptr digit = Compile( "\d" )
print "growing:"
dim as string grown = Replace( digit, "2026-11-19", "[$0]" )
print "  "; grown

'' $3 names a group the pattern does not have.
print "an error in the replacement:"
print "  "; Replace( re, text, "$3" )

pcre2_code_free( digit )
pcre2_code_free( title )
pcre2_code_free( re )
