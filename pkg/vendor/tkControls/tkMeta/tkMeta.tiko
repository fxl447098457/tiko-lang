'
' tkMeta -- what a form designer knows about each control: its properties and events, with thunks
' that create a control and set or read a property from its text form. For tools only: importing it
' links every control, so an ordinary program never should. The table itself is tkMeta.gen.tiko,
' generated from controls.toml.
#module "tkMeta"

#import "../tkHost" public
using tkHost
using tkPaint

public enum TKMETA_CONTAINER_KIND
    TKMETA_NOT_CONTAINER = 0
    TKMETA_CONTAINER_SELF          ' children go directly on the control
    TKMETA_CONTAINER_GROUPBOX      ' on the control, with a client rectangle for docks
    TKMETA_CONTAINER_PAGES         ' on tkTabControl_GetPage
    TKMETA_CONTAINER_SCROLLPANEL   ' on tkScrollPanel_GetPanel
end enum

public type TKMETA_ApplyProc as sub( byval w as TK_WIDGET ptr, byref v as const ustring )
public type TKMETA_ReadFunc as function( byval w as TK_WIDGET ptr ) as ustring
public type TKMETA_FontProc as sub( byval w as TK_WIDGET ptr, byval f as TTF_Font ptr )
public type TKMETA_CreateFunc as function( byval hParent as TK_WIDGET ptr, byval id as long, byref arg as const ustring ) as TK_WIDGET ptr

public type TKMETA_PROP
    Name         as ustring
    Kind         as ustring        ' text glyph file int bool float color enum font
    DefaultValue as ustring
    EnumPairs    as ustring        ' "Shown=CONSTANT,..."
    SetName      as ustring
    GetName      as ustring        ' empty: write-only
    Apply        as TKMETA_ApplyProc  ' 0 for a font
    Read_        as TKMETA_ReadFunc   ' 0 when write-only, or a font
    ApplyFont    as TKMETA_FontProc   ' fonts only
    bDesign      as boolean        ' false: not applied on the design canvas
end type

public type TKMETA_EVENT
    Name     as ustring
    SetName  as ustring        ' the tk procedure that installs the callback
    TypeName as ustring        ' its callback type
    Sig      as ustring        ' the callback's whole parameter list
    Params   as ustring        ' the parameters a handler receives
    Args     as ustring        ' the same, as an argument list
end type

public type TKMETA_CONTROL
    Name          as ustring
    Module_       as ustring
    Category      as ustring
    Width_        as long
    Height_       as long
    DefaultEvent  as ustring
    ContainerKind as long
    Create        as TKMETA_CreateFunc
    ' A choice that only exists at creation, such as a chart's type. Changing it means recreating.
    CreateArg     as ustring
    CreateArgKind as ustring
    CreateArgEnum as ustring
    CreateArgDflt as ustring
    Props( any )  as TKMETA_PROP
    NumProps      as long
    Events( any ) as TKMETA_EVENT
    NumEvents     as long
end type

dim shared as TKMETA_CONTROL gControls( any )
dim shared as long gnControls
dim shared as boolean gFilled

private sub Add_( byref name_ as const ustring, byref mod_ as const ustring, byref cat as const ustring, _
                  byval w as long, byval h as long, byref dev as const ustring, byref cont as const ustring, _
                  byval create as TKMETA_CreateFunc, byref argName as const ustring, byref argKind as const ustring, _
                  byref argEnum as const ustring, byref argDflt as const ustring )
    redim preserve gControls( 0 to gnControls )
    with gControls( gnControls )
        .Name = name_ : .Module_ = mod_ : .Category = cat : .Width_ = w : .Height_ = h
        .DefaultEvent = dev : .Create = create
        select case cont
        case "self"        : .ContainerKind = TKMETA_CONTAINER_SELF
        case "groupbox"    : .ContainerKind = TKMETA_CONTAINER_GROUPBOX
        case "pages"       : .ContainerKind = TKMETA_CONTAINER_PAGES
        case "scrollpanel" : .ContainerKind = TKMETA_CONTAINER_SCROLLPANEL
        end select
        .CreateArg = argName : .CreateArgKind = argKind : .CreateArgEnum = argEnum : .CreateArgDflt = argDflt
    end with
    gnControls += 1
end sub

private sub Prop_( byref name_ as const ustring, byref kind as const ustring, byref dflt as const ustring, _
                   byref en as const ustring, byref s_ as const ustring, byref g as const ustring, _
                   byval a as TKMETA_ApplyProc, byval r as TKMETA_ReadFunc, byval f as TKMETA_FontProc, byval bDesign as boolean )
    with gControls( gnControls - 1 )
        redim preserve .Props( 0 to .NumProps )
        .Props( .NumProps ).Name = name_ : .Props( .NumProps ).Kind = kind : .Props( .NumProps ).DefaultValue = dflt
        .Props( .NumProps ).EnumPairs = en : .Props( .NumProps ).SetName = s_ : .Props( .NumProps ).GetName = g
        .Props( .NumProps ).Apply = a : .Props( .NumProps ).Read_ = r : .Props( .NumProps ).ApplyFont = f
        .Props( .NumProps ).bDesign = bDesign
        .NumProps += 1
    end with
end sub

private sub Event_( byref name_ as const ustring, byref s_ as const ustring, byref t as const ustring, _
                    byref sig as const ustring, byref params as const ustring, byref args as const ustring )
    with gControls( gnControls - 1 )
        redim preserve .Events( 0 to .NumEvents )
        .Events( .NumEvents ).Name = name_ : .Events( .NumEvents ).SetName = s_ : .Events( .NumEvents ).TypeName = t
        .Events( .NumEvents ).Sig = sig : .Events( .NumEvents ).Params = params : .Events( .NumEvents ).Args = args
        .NumEvents += 1
    end with
end sub

private sub Ensure_( )
    if gFilled then exit sub
    gFilled = true
    Fill_( )
end sub

public function tkMeta_Count( ) as long
    Ensure_( )
    return gnControls
end function

public function tkMeta_At( byval i as long ) as TKMETA_CONTROL ptr
    Ensure_( )
    if (i < 0) orelse (i >= gnControls) then return 0
    return @gControls( i )
end function

public function tkMeta_Find( byref name_ as const ustring ) as TKMETA_CONTROL ptr
    Ensure_( )
    for i as long = 0 to gnControls - 1
        if gControls( i ).Name = name_ then return @gControls( i )
    next
    return 0
end function

' ---- a "list" property: several values in one, "1,2,3"; EnumPairs names them, "Left:int,Top:int" ----

public function tkMeta_ListCount( byref v as const ustring ) as long
    if len( trim( v ) ) = 0 then return 0
    dim as long n = 1
    for i as long = 1 to len( v )
        if mid( v, i, 1 ) = "," then n += 1
    next
    return n
end function

' Item i of "a,b,c", trimmed; "" past the end.
public function tkMeta_ListItem( byref v as const ustring, byval i as long ) as ustring
    dim as long at = 1, n = 0
    do
        dim as long comma = instr( at, v, "," )
        if n = i then
            if comma > 0 then return trim( mid( v, at, comma - at ) )
            return trim( mid( v, at ) )
        end if
        if comma = 0 then return ""
        at = comma + 1
        n += 1
    loop
end function

' "Left, Top, Right, Bottom": what the row asks for.
public function tkMeta_ListCue( byref pairs as const ustring ) as ustring
    dim as ustring o
    for i as long = 0 to tkMeta_ListCount( pairs ) - 1
        dim as ustring s = tkMeta_ListItem( pairs, i )
        if i then o &= ", "
        o &= left( s, instr( s, ":" ) - 1 )
    next
    return o
end function

' The kind of slot i: int float color bool text.
public function tkMeta_ListSlot( byref pairs as const ustring, byval i as long ) as ustring
    dim as ustring s = tkMeta_ListItem( pairs, i )
    return mid( s, instr( s, ":" ) + 1 )
end function

private function IsDigits_( byref s as const ustring ) as boolean
    if len( s ) = 0 then return false
    for i as long = 1 to len( s )
        dim as long c = asc( mid( s, i, 1 ) )
        if (c < 48) orelse (c > 57) then return false
    next
    return true
end function

private function SlotFits_( byref v as const ustring, byref kind as const ustring ) as boolean
    dim as ustring t = v
    select case kind
    case "int"
        if left( t, 1 ) = "-" then t = mid( t, 2 )
        return IsDigits_( t )
    case "float"
        if left( t, 1 ) = "-" then t = mid( t, 2 )
        dim as long dot = instr( t, "." )
        if dot = 0 then return IsDigits_( t )
        return IsDigits_( left( t, dot - 1 ) & mid( t, dot + 1 ) )
    case "color"
        if lcase( left( t, 2 ) ) <> "&h" then return false
        if (len( t ) < 3) orelse (len( t ) > 10) then return false
        for i as long = 3 to len( t )
            if instr( "0123456789abcdefABCDEF", mid( t, i, 1 ) ) = 0 then return false
        next
        return true
    case "bool"
        return (t = "true") orelse (t = "false")
    end select
    return true
end function

' "" when text suits the list, or what's wrong with it.
public function tkMeta_ListFault( byref text as const ustring, byref pairs as const ustring ) as ustring
    dim as long n = tkMeta_ListCount( pairs )
    if tkMeta_ListCount( text ) <> n then return "needs " & n & " values: " & tkMeta_ListCue( pairs )
    for i as long = 0 to n - 1
        if SlotFits_( tkMeta_ListItem( text, i ), tkMeta_ListSlot( pairs, i ) ) = false then
            return "needs " & tkMeta_ListSlot( pairs, i ) & " for " & left( tkMeta_ListItem( pairs, i ), instr( tkMeta_ListItem( pairs, i ), ":" ) - 1 )
        end if
    next
    return ""
end function

' "1, 2 ,3" as "1,2,3".
public function tkMeta_ListTidy( byref text as const ustring ) as ustring
    dim as ustring o
    for i as long = 0 to tkMeta_ListCount( text ) - 1
        if i then o &= ","
        o &= tkMeta_ListItem( text, i )
    next
    return o
end function

public function tkMeta_FindProp( byval c as TKMETA_CONTROL ptr, byref name_ as const ustring ) as TKMETA_PROP ptr
    if c = 0 then return 0
    for i as long = 0 to c->NumProps - 1
        if c->Props( i ).Name = name_ then return @c->Props( i )
    next
    return 0
end function

public function tkMeta_FindEvent( byval c as TKMETA_CONTROL ptr, byref name_ as const ustring ) as TKMETA_EVENT ptr
    if c = 0 then return 0
    for i as long = 0 to c->NumEvents - 1
        if c->Events( i ).Name = name_ then return @c->Events( i )
    next
    return 0
end function
