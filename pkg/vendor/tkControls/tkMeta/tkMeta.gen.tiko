private sub A_Chart_PieLabelMode( byval w as TK_WIDGET ptr, byref v as const ustring )
    select case v
    case "None" : tkChart_SetPieLabelMode( w, CHT_PIELABEL_NONE )
    case "Value" : tkChart_SetPieLabelMode( w, CHT_PIELABEL_VALUE )
    case "Percent" : tkChart_SetPieLabelMode( w, CHT_PIELABEL_PERCENT )
    case "Name" : tkChart_SetPieLabelMode( w, CHT_PIELABEL_NAME )
