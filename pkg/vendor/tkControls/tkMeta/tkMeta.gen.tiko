private sub A_IconPanel_Justify( byval w as TK_WIDGET ptr, byref v as const ustring )
    select case v
    case "Left" : tkIconPanel_SetJustify( w, IP_JUSTIFY_LEFT )
    case "Center" : tkIconPanel_SetJustify( w, IP_JUSTIFY_CENTER )
    case "Right" : tkIconPanel_SetJustify( w, IP_JUSTIFY_RIGHT )
    end select
end sub

private function R_IconPanel_Justify( byval w as TK_WIDGET ptr ) as ustring
    select case tkIconPanel_GetJustify( w )
    case IP_JUSTIFY_LEFT : return "Left"
    case IP_JUSTIFY_CENTER : return "Center"
    case IP_JUSTIFY_RIGHT : return "Right"
    end select
    return ""
end function

