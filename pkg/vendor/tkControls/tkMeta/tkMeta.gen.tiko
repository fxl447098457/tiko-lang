private function C_Barcode( byval hParent as TK_WIDGET ptr, byval id as int32, byref arg as const ustring ) as TK_WIDGET ptr
    select case arg
    case "EAN13" : return tkBarcode_Create( hParent, id, TKBC_EAN13 )
    case "EAN8" : return tkBarcode_Create( hParent, id, TKBC_EAN8 )
    case "UPCA" : return tkBarcode_Create( hParent, id, TKBC_UPCA )
    case "UPCE" : return tkBarcode_Create( hParent, id, TKBC_UPCE )
    case "ISBN" : return tkBarcode_Create( hParent, id, TKBC_ISBN )
    case "Code128" : return tkBarcode_Create( hParent, id, TKBC_CODE128 )
    case "GS1_128" : return tkBarcode_Create( hParent, id, TKBC_GS1_128 )
    case "Code39" : return tkBarcode_Create( hParent, id, TKBC_CODE39 )
    case "Code39Ext" : return tkBarcode_Create( hParent, id, TKBC_CODE39_EXT )
    case "Code93" : return tkBarcode_Create( hParent, id, TKBC_CODE93 )
    case "ITF" : return tkBarcode_Create( hParent, id, TKBC_ITF )
    case "ITF14" : return tkBarcode_Create( hParent, id, TKBC_ITF14 )
    case "Codabar" : return tkBarcode_Create( hParent, id, TKBC_CODABAR )
    case "QR" : return tkBarcode_Create( hParent, id, TKBC_QR )
    case "MicroQR" : return tkBarcode_Create( hParent, id, TKBC_MICRO_QR )
    case "DataMatrix" : return tkBarcode_Create( hParent, id, TKBC_DATAMATRIX )
    case "GS1DataMatrix" : return tkBarcode_Create( hParent, id, TKBC_GS1_DATAMATRIX )
    case "PDF417" : return tkBarcode_Create( hParent, id, TKBC_PDF417 )
    case "PDF417Compact" : return tkBarcode_Create( hParent, id, TKBC_PDF417_COMPACT )
    case "Aztec" : return tkBarcode_Create( hParent, id, TKBC_AZTEC )
    end select
    return tkBarcode_Create( hParent, id )
end function

