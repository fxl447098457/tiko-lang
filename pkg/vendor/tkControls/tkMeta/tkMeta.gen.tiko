sub Fill_( )
    Add_( "Label", "tkLabel", "Common", 100, 24, "Click", "", @C_Label, "", "", "", "" )
    Bind_( "text", "", "tkLabel_SetText", true )
    Colors_( "TKLABEL_COLORS", "tkLabel_GetColors", "tkLabel_ThemeColors", @G_Label, @T_Label )
    Color_( "TextColor", "Text", "Normal", "", true )
    Color_( "TextColorDisabled", "Text", "Disabled", "", true )
    Color_( "BackColor", "Back", "Normal", "", false )
    Prop_( "Text", "text", "Label", "", "tkLabel_SetText", "tkLabel_GetText", @A_Label_Text, @R_Label_Text, 0, true, true, "", 0 )
    Prop_( "Align", "enum", "Left", "Left=LBL_ALIGN_LEFT,Center=LBL_ALIGN_CENTER,Right=LBL_ALIGN_RIGHT", "tkLabel_SetAlign", "tkLabel_GetAlign", @A_Label_Align, @R_Label_Align, 0, true, true, "", 0 )
    Prop_( "VAlign", "enum", "Center", "Top=LBL_VALIGN_TOP,Center=LBL_VALIGN_CENTER,Bottom=LBL_VALIGN_BOTTOM", "tkLabel_SetVAlign", "tkLabel_GetVAlign", @A_Label_VAlign, @R_Label_VAlign, 0, true, true, "", 0 )
    Prop_( "WordWrap", "bool", "false", "", "tkLabel_SetWordWrap", "tkLabel_GetWordWrap", @A_Label_WordWrap, @R_Label_WordWrap, 0, true, true, "", 0 )
    Prop_( "Ellipsis", "bool", "false", "", "tkLabel_SetEllipsis", "tkLabel_GetEllipsis", @A_Label_Ellipsis, @R_Label_Ellipsis, 0, true, true, "", 0 )
    Prop_( "AutoSize", "bool", "false", "", "tkLabel_SetAutoSize", "tkLabel_GetAutoSize", @A_Label_AutoSize, @R_Label_AutoSize, 0, true, true, "", 0 )
    Prop_( "TextColor", "color", "", "", "tkLabel_SetTextColor", "tkLabel_GetTextColor", @A_Label_TextColor, @R_Label_TextColor, 0, true, false, "", 0 )
    Prop_( "BackColor", "color", "", "", "tkLabel_SetBackColor", "tkLabel_GetBackColor", @A_Label_BackColor, @R_Label_BackColor, 0, true, false, "", 0 )
    Prop_( "Transparent", "bool", "true", "", "tkLabel_SetTransparent", "tkLabel_GetTransparent", @A_Label_Transparent, @R_Label_Transparent, 0, true, true, "", 0 )
    Prop_( "Font", "font", "", "", "tkLabel_SetFont", "tkLabel_GetFont", 0, 0, @F_Label_Font, true, true, "", 0 )
    Event_( "Click", "tkLabel_SetClickCallback", "LBL_ClickCallbackSub", "byval hLabel as TK_WIDGET ptr, byval id as int32", "", "" )
    Event_( "MouseMove", "tkWidget_SetMouseMoveCallback", "TK_MouseMoveSub", "byval hWidget as TK_WIDGET ptr, byval x as int32, byval y as int32, byval buttons as int32, byval mods as int32", "byval x as int32, byval y as int32, byval buttons as int32, byval mods as int32", "x, y, buttons, mods" )
    Add_( "Button", "tkButton", "Common", 88, 30, "Click", "", @C_Button, "", "", "", "" )
    Colors_( "TKBUTTON_COLORS", "tkButton_GetColors", "tkButton_ThemeColors", @G_Button, @T_Button )
    Color_( "BackColor", "Back", "Normal", "", false )
    Color_( "ForeColor", "Fore", "Normal", "", true )
    Color_( "BorderColor", "Border", "Normal", "", false )
    Color_( "IconColor", "Icon", "Normal", "", true )
    Color_( "BackColorHot", "Back", "Hot", "", false )
    Color_( "ForeColorHot", "Fore", "Hot", "", true )
    Color_( "BorderColorHot", "Border", "Hot", "", false )
    Color_( "IconColorHot", "Icon", "Hot", "", true )
    Color_( "BackColorPressed", "Back", "Pressed", "", false )
    Color_( "ForeColorPressed", "Fore", "Pressed", "", true )
    Color_( "BorderColorPressed", "Border", "Pressed", "", false )
    Color_( "IconColorPressed", "Icon", "Pressed", "", true )
    Color_( "BackColorDisabled", "Back", "Disabled", "", false )
    Color_( "ForeColorDisabled", "Fore", "Disabled", "", true )
    Color_( "BorderColorDisabled", "Border", "Disabled", "", false )
    Color_( "IconColorDisabled", "Icon", "Disabled", "", true )
    Color_( "FocusRingColor", "", "", "", false )
    Color_( "DefaultBorderColor", "", "", "", false )
    Prop_( "Text", "text", "Button", "", "tkButton_SetText", "tkButton_GetText", @A_Button_Text, @R_Button_Text, 0, true, true, "", 0 )
