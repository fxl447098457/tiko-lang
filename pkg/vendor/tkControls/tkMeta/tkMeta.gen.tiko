private function C_Spinner( byval hParent as TK_WIDGET ptr, byval id as int32, byref arg as const ustring ) as TK_WIDGET ptr
    select case arg
    case "Ring" : return tkSpinner_Create( hParent, id, SPN_STYLE_RING )
    case "Arc" : return tkSpinner_Create( hParent, id, SPN_STYLE_ARC )
    case "Dots" : return tkSpinner_Create( hParent, id, SPN_STYLE_DOTS )
    case "Spokes" : return tkSpinner_Create( hParent, id, SPN_STYLE_SPOKES )
    case "Pulse" : return tkSpinner_Create( hParent, id, SPN_STYLE_PULSE )
    case "Bounce" : return tkSpinner_Create( hParent, id, SPN_STYLE_BOUNCE )
    end select
    return tkSpinner_Create( hParent, id )
end function

