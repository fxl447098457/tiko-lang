private function C_Chart( byval hParent as TK_WIDGET ptr, byval id as long, byref arg as const ustring ) as TK_WIDGET ptr
    select case arg
    case "Line" : return tkChart_Create( hParent, id, TKCHART_TYPE_LINE )
    case "Column" : return tkChart_Create( hParent, id, TKCHART_TYPE_COLUMN )
    case "Hloc" : return tkChart_Create( hParent, id, TKCHART_TYPE_HLOC )
    case "Pie" : return tkChart_Create( hParent, id, TKCHART_TYPE_PIE )
    end select
    return tkChart_Create( hParent, id )
end function

private sub A_Chart_Title( byval w as TK_WIDGET ptr, byref v as const ustring )
    tkChart_SetTitle( w, v )
end sub

private function R_Chart_Title( byval w as TK_WIDGET ptr ) as ustring
    return tkChart_GetTitle( w )
end function

private sub A_Chart_Subtitle( byval w as TK_WIDGET ptr, byref v as const ustring )
    tkChart_SetSubtitle( w, v )
end sub

private function R_Chart_Subtitle( byval w as TK_WIDGET ptr ) as ustring
    return tkChart_GetSubtitle( w )
end function

private sub A_Chart_LegendVisible( byval w as TK_WIDGET ptr, byref v as const ustring )
    tkChart_SetLegendVisible( w, cbool( v = "true" ) )
end sub

private sub A_Chart_LegendPosition( byval w as TK_WIDGET ptr, byref v as const ustring )
    select case v
    case "Bottom" : tkChart_SetLegendPosition( w, CHT_LEGEND_BOTTOM )
    case "Top" : tkChart_SetLegendPosition( w, CHT_LEGEND_TOP )
    case "Left" : tkChart_SetLegendPosition( w, CHT_LEGEND_LEFT )
    case "Right" : tkChart_SetLegendPosition( w, CHT_LEGEND_RIGHT )
    end select
end sub

private sub A_Chart_ColumnMode( byval w as TK_WIDGET ptr, byref v as const ustring )
    select case v
    case "Grouped" : tkChart_SetColumnMode( w, CHT_COL_GROUPED )
    case "Stacked" : tkChart_SetColumnMode( w, CHT_COL_STACKED )
    end select
end sub

private function R_Chart_ColumnMode( byval w as TK_WIDGET ptr ) as ustring
    select case tkChart_GetColumnMode( w )
    case CHT_COL_GROUPED : return "Grouped"
    case CHT_COL_STACKED : return "Stacked"
    end select
    return ""
end function

private sub A_Chart_AutoScale( byval w as TK_WIDGET ptr, byref v as const ustring )
    tkChart_SetAutoScale( w, cbool( v = "true" ) )
end sub

private function R_Chart_AutoScale( byval w as TK_WIDGET ptr ) as ustring
    if tkChart_GetAutoScale( w ) then return "true" else return "false"
end function

