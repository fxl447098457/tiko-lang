'
' tkBind -- the conversions a designed form's LoadFrom / SaveTo go through (Form Designer B1). The
' designer knows a control's kind but not a record field's type, so every call names the field and
' the compiler picks the overload:
'
'     tkTextBox_SetText( txtAge.Handle, tkBind_Text( r.Age ) )        ' load: field -> the kind
'     tkBind_Put( r.Age, tkTextBox_GetText( txtAge.Handle ) )         ' save: the kind -> field
'
' KINDS and the value each carries: text = ustring, bool = boolean, int = longint, float = float64,
' date = TKDATE, time = TKTIME, datetime = TKDATETIME (both tkTimePanel). FIELDS: boolean, byte .. ulongint, integer, uinteger,
' single, double, ustring, string, TKDATE, TKTIME, chrono.LocalDate, chrono.LocalTime and
' chrono.DateTime (date and time halves). A date or a time binds only to a text field or one of its
' own; a pairing with no overload is a compile error, which is the point.
'
' THE RULES (B1: lenient; strict parsing and error reporting are B2):
'   text -> number     trimmed, then VALLNG / VAL: text that is not a number is 0
'   float -> integer   rounds as CLNGINT does (to even); a narrower field wraps as an assignment does
'   text -> bool       true, 1, -1, yes, on (any case, trimmed); anything else is false
'   bool -> text       "true" / "false"
'   number -> text     STR
'   date <-> text      ISO yyyy-mm-dd; "" and text that is not a date are no date
'   time <-> text      ISO HH:mm:ss (.fff when there are milliseconds); in, ISO first, then
'                      tkTimePanel_ParseLoose (2:30 pm); text that is no time is no time
'   no date            an all-zero TKDATE (wYear = 0), an Invalid LocalDate (its default), ""
'   no time            an empty TKTIME (wHour = -1), LocalTime.Invalid() -- NOT a default LocalTime,
'                      which is midnight -- and ""
'   DateTime           its date and time load into a DatePicker and a TimePicker. Saving: one call
'                      for the pair, Put( f, date, time ), which codegen emits when both bind the
'                      field (half-saves would drop the time on a new record, whose DateTime is
'                      Invalid); no date clears the field, no time is midnight. The lone halves,
'                      for a form that binds one control to it, keep the other half and the offset.
' chrono.LocalTime is always written qualified: the SDL imports bring crt's localtime, and names
' are case-blind (TKO0919).
' Nothing here notifies: LoadFrom calls the controls' silent setters.
#module "tkBind"

#import "std/chrono"
#import "../tkCalendar" public
#import "../tkTimePanel" public
using chrono
using tkCalendar
using tkTimePanel

' ---- TK_VALUE: one typed value, as tkDataGrid and tkReport read cells and fields ---------------
' (claude-docs docs/tkControls/PRINTING.md decision P-16.) The kinds are numbered as tkDataGrid's
' TKDG_* so the two can be one type; TKV_TIME is new. The setters keep kind right; an all-zero date
' is no date, so SetDate of one makes the value EMPTY.
public enum
    TKV_EMPTY = 0           ' no value: a database NULL, a field not filled
    TKV_TEXT
    TKV_INT
    TKV_FLOAT
    TKV_BOOL
    TKV_DATE
    TKV_TIME
end enum

public type TK_VALUE
    kind as long = TKV_EMPTY
    s    as ustring          ' TKV_TEXT
    i    as longint          ' TKV_INT
    f    as float64          ' TKV_FLOAT
    b    as boolean          ' TKV_BOOL
    d    as TKDATE           ' TKV_DATE
    t    as TKTIME           ' TKV_TIME
    declare sub SetText( byref v as const ustring )
    declare sub SetInt( byval v as longint )
    declare sub SetFloat( byval v as float64 )
    declare sub SetBool( byval v as boolean )
    declare sub SetDate( byref v as const TKDATE )
    declare sub SetTime( byref v as const TKTIME )
    declare sub Clear( )
    declare function AsFloat( ) as float64       ' INT / FLOAT / BOOL as a number, else 0
    declare function IsNumber( ) as boolean
end type

sub TK_VALUE.Clear( )
    dim as TKDATE nd
    dim as TKTIME nt
    this.kind = TKV_EMPTY : this.s = "" : this.i = 0 : this.f = 0 : this.b = false : this.d = nd : this.t = nt
end sub
sub TK_VALUE.SetText( byref v as const ustring )
    this.Clear( ) : this.kind = TKV_TEXT : this.s = v
end sub
sub TK_VALUE.SetInt( byval v as longint )
    this.Clear( ) : this.kind = TKV_INT : this.i = v
end sub
sub TK_VALUE.SetFloat( byval v as float64 )
    this.Clear( ) : this.kind = TKV_FLOAT : this.f = v
end sub
sub TK_VALUE.SetBool( byval v as boolean )
    this.Clear( ) : this.kind = TKV_BOOL : this.b = v
end sub
sub TK_VALUE.SetDate( byref v as const TKDATE )
    this.Clear( )
    if v.wYear = 0 then exit sub
    this.kind = TKV_DATE : this.d = v
end sub
sub TK_VALUE.SetTime( byref v as const TKTIME )
    this.Clear( )
    if v.wHour < 0 then exit sub                  ' -1 = no time: EMPTY
    this.kind = TKV_TIME : this.t = v
end sub
function TK_VALUE.AsFloat( ) as float64
    select case this.kind
    case TKV_INT : return this.i
    case TKV_FLOAT : return this.f
    case TKV_BOOL : return iif( this.b, 1, 0 )
    end select
    return 0
end function
function TK_VALUE.IsNumber( ) as boolean
    return (this.kind = TKV_INT) orelse (this.kind = TKV_FLOAT)
end function

' ---- the text rules -------------------------------------------------------------------------

private function TextBool_( byref s as const ustring ) as boolean
    select case lcase( trim( s ) )
    case "true", "1", "-1", "yes", "on" : return true
    end select
    return false
end function

private function TextInt_( byref s as const ustring ) as longint
    return vallng( trim( s ) )
end function

private function TextFloat_( byref s as const ustring ) as float64
    return val( trim( s ) )
end function

private function Pad_( byval n as long, byval w as long ) as ustring
    dim as ustring s = str( n )
    if len( s ) < w then s = string( w - len( s ), "0" ) & s
    return s
end function

private function IsoOf_( byref d as const TKDATE ) as ustring
    if d.wYear = 0 then return ""
    return Pad_( d.wYear, 4 ) & "-" & Pad_( d.wMonth, 2 ) & "-" & Pad_( d.wDay, 2 )
end function

private function DateOfLocal_( byref ld as LocalDate ) as TKDATE
    dim as TKDATE none_
    if ld.IsValid = false then return none_
    return tkCalendar_MakeDate( ld.Year, ld.Month, ld.Day )
end function

private function LocalOfDate_( byref d as const TKDATE ) as LocalDate
    dim as LocalDate none_                  ' Invalid
    if d.wYear = 0 then return none_
    return LocalDate( d.wYear, d.wMonth, d.wDay )
end function

private function DateOfText_( byref s as const ustring ) as TKDATE
    dim as LocalDate ld
    dim as ustring t = trim( s )
    if LocalDate.TryParseIso( t, ld ) = false then
        dim as TKDATE none_
        return none_
    end if
    return DateOfLocal_( ld )
end function

private function LocalText_( byref ld as LocalDate ) as ustring
    if ld.IsValid = false then return ""
    return ld.ToIsoString( )
end function

' ---- load: a field's value as the control's kind ---------------------------------------------

public function tkBind_Text overload( byval v as boolean ) as ustring : return iif( v, "true", "false" ) : end function
public function tkBind_Text( byval v as byte ) as ustring : return str( v ) : end function
public function tkBind_Text( byval v as ubyte ) as ustring : return str( v ) : end function
