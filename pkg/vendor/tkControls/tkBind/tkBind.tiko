' ---- the time kind (TIMEPICKER.md §10) ----------------------------------------------------------

private function TimeOfLocal_( byref lt as chrono.LocalTime ) as TKTIME
    if lt.IsValid = false then return tkTimePanel_EmptyTime( )
    return tkTimePanel_MakeTime( lt.Hour, lt.Minute, lt.Second, lt.Millisecond )
end function

private function LocalOfTime_( byref t as const TKTIME ) as chrono.LocalTime
    if tkTimePanel_IsTime( t ) = false then return chrono.LocalTime.Invalid( )
    return chrono.LocalTime( t.wHour, t.wMinute, t.wSecond, t.wMilliseconds )
end function

private function TimeOfText_( byref s as const ustring ) as TKTIME
    dim as TKTIME t
    if tkTimePanel_ParseIso( s, t ) then return t
    if tkTimePanel_ParseLoose( s, t ) then return t
    return tkTimePanel_EmptyTime( )
end function

private function TimeText_( byref t as const TKTIME ) as ustring
    return tkTimePanel_FormatIso( t, true, t.wMilliseconds <> 0 )
end function

' load
public function tkBind_Time overload( byref v as const TKTIME ) as TKTIME : return v : end function
public function tkBind_Time( byref v as chrono.LocalTime ) as TKTIME : return TimeOfLocal_( v ) : end function
public function tkBind_Time( byref v as DateTime ) as TKTIME
    if v.IsValid = false then return tkTimePanel_EmptyTime( )
    return tkTimePanel_MakeTime( v.Hour, v.Minute, v.Second, v.Millisecond )
end function
public function tkBind_Time( byref v as const ustring ) as TKTIME : return TimeOfText_( v ) : end function
public function tkBind_Time( byref v as const string ) as TKTIME : return TimeOfText_( v ) : end function
public function tkBind_Text( byref v as const TKTIME ) as ustring : return TimeText_( v ) : end function
public function tkBind_Text( byref v as chrono.LocalTime ) as ustring : return TimeText_( TimeOfLocal_( v ) ) : end function
public function tkBind_Date( byref v as DateTime ) as TKDATE
    dim as TKDATE none_
    if v.IsValid = false then return none_
    return tkCalendar_MakeDate( v.Year, v.Month, v.Day )
end function

' save
public sub tkBind_Put( byref f as TKTIME, byval v as TKTIME ) : f = v : end sub
public sub tkBind_Put( byref f as chrono.LocalTime, byval v as TKTIME ) : f = LocalOfTime_( v ) : end sub
public sub tkBind_Put( byref f as ustring, byval v as TKTIME ) : f = TimeText_( v ) : end sub
public sub tkBind_Put( byref f as string, byval v as TKTIME ) : f = TimeText_( v ) : end sub
public sub tkBind_Put( byref f as TKTIME, byref v as const ustring ) : f = TimeOfText_( v ) : end sub
public sub tkBind_Put( byref f as chrono.LocalTime, byref v as const ustring ) : f = LocalOfTime_( TimeOfText_( v ) ) : end sub

' DateTime: the pair in one call (what codegen emits when a date and a time control bind the field)
public sub tkBind_Put( byref f as DateTime, byref d as const TKDATE, byval t as TKTIME )
    dim as LocalDate ld = LocalOfDate_( d )
    if ld.IsValid = false then f = DateTime.Invalid( ) : exit sub
    dim as chrono.LocalTime lt = LocalOfTime_( t )
    if lt.IsValid = false then lt = chrono.LocalTime.Midnight( )
    dim as DateTime r = DateTime.FromDateTime( ld, lt )
    if f.IsValid andalso f.HasOffset then r = r.WithOffset( f.OffsetMinutes )
    f = r
end sub

' DateTime: one half, the other half and the offset kept (a form binding one control to it)
public sub tkBind_Put( byref f as DateTime, byref v as const TKDATE )
    dim as LocalDate ld = LocalOfDate_( v )
    if ld.IsValid = false then f = DateTime.Invalid( ) : exit sub
    dim as chrono.LocalTime lt = chrono.LocalTime.Midnight( )
    if f.IsValid then lt = f.GetTimeOfDay( )
    dim as DateTime r = DateTime.FromDateTime( ld, lt )
    if f.IsValid andalso f.HasOffset then r = r.WithOffset( f.OffsetMinutes )
    f = r
end sub

public sub tkBind_Put( byref f as DateTime, byval v as TKTIME )
    if f.IsValid = false then exit sub                  ' no date to put a time on
    dim as chrono.LocalTime lt = LocalOfTime_( v )
    if lt.IsValid = false then lt = chrono.LocalTime.Midnight( )
    dim as LocalDate ld = f.GetDate( )
    dim as DateTime r = DateTime.FromDateTime( ld, lt )
    if f.HasOffset then r = r.WithOffset( f.OffsetMinutes )
    f = r
end sub

' ---- the datetime kind (tkDateTimePicker) -------------------------------------------------------
' TKDATETIME (tkTimePanel) <-> chrono.DateTime, TKDATETIME and text. No value is wYear = 0,
' DateTime.Invalid() and "". Text out is ISO yyyy-mm-ddTHH:mm:ss (.fff when there are
' milliseconds); in, ISO first, then tkTimePanel_ParseLooseDateTime. A DateTime's offset is
' ignored on load and kept on save.

private function DtOfDateTime_( byref v as DateTime ) as TKDATETIME
    if v.IsValid = false then return tkTimePanel_EmptyDateTime( )
    return tkTimePanel_MakeDateTime( v.Year, v.Month, v.Day, v.Hour, v.Minute, v.Second, v.Millisecond )
end function

private function DtOfText_( byref s as const ustring ) as TKDATETIME
    dim as TKDATETIME t
    if tkTimePanel_ParseIsoDateTime( s, t ) then return t
    if tkTimePanel_ParseLooseDateTime( s, t ) then return t
    return tkTimePanel_EmptyDateTime( )
end function

private function DtText_( byref t as const TKDATETIME ) as ustring
    return tkTimePanel_FormatIsoDateTime( t, true, t.wMilliseconds <> 0 )
end function

private sub PutDateTime_( byref f as DateTime, byref t as const TKDATETIME )
    if tkTimePanel_IsDateTime( t ) = false then f = DateTime.Invalid( ) : exit sub
    dim as LocalDate ld = LocalOfDate_( tkCalendar_MakeDate( t.wYear, t.wMonth, t.wDay ) )
    dim as chrono.LocalTime lt = chrono.LocalTime( t.wHour, t.wMinute, t.wSecond, t.wMilliseconds )
    dim as DateTime r = DateTime.FromDateTime( ld, lt )
    if f.IsValid andalso f.HasOffset then r = r.WithOffset( f.OffsetMinutes )
    f = r
end sub

' load
public function tkBind_DateTime overload( byref v as const TKDATETIME ) as TKDATETIME : return v : end function
public function tkBind_DateTime( byref v as DateTime ) as TKDATETIME : return DtOfDateTime_( v ) : end function
public function tkBind_DateTime( byref v as const ustring ) as TKDATETIME : return DtOfText_( v ) : end function
public function tkBind_DateTime( byref v as const string ) as TKDATETIME : return DtOfText_( v ) : end function
public function tkBind_Text( byref v as const TKDATETIME ) as ustring : return DtText_( v ) : end function

' save
public sub tkBind_Put( byref f as TKDATETIME, byval v as TKDATETIME ) : f = v : end sub
public sub tkBind_Put( byref f as DateTime, byval v as TKDATETIME ) : PutDateTime_( f, v ) : end sub
public sub tkBind_Put( byref f as ustring, byval v as TKDATETIME ) : f = DtText_( v ) : end sub
public sub tkBind_Put( byref f as string, byval v as TKDATETIME ) : f = DtText_( v ) : end sub
public sub tkBind_Put( byref f as TKDATETIME, byref v as const ustring ) : f = DtOfText_( v ) : end sub

' ---- a field as a TK_VALUE (printing R5: what a designed ReportViewer's fill goes through) ----
' The field's own kind: integers INT, single / double FLOAT, text TEXT, dates DATE, times TIME. A
' DateTime gives its date. No date / no time is EMPTY, as TK_VALUE's setters make it. v = 0: nothing.
public sub tkBind_ToValue overload( byval x as boolean, byval v as TK_VALUE ptr )
    if v then v->SetBool( x )
end sub
public sub tkBind_ToValue( byval x as byte, byval v as TK_VALUE ptr )
    if v then v->SetInt( x )
end sub
public sub tkBind_ToValue( byval x as ubyte, byval v as TK_VALUE ptr )
    if v then v->SetInt( x )
end sub
public sub tkBind_ToValue( byval x as short, byval v as TK_VALUE ptr )
    if v then v->SetInt( x )
end sub
public sub tkBind_ToValue( byval x as ushort, byval v as TK_VALUE ptr )
    if v then v->SetInt( x )
end sub
public sub tkBind_ToValue( byval x as long, byval v as TK_VALUE ptr )
    if v then v->SetInt( x )
end sub
public sub tkBind_ToValue( byval x as ulong, byval v as TK_VALUE ptr )
    if v then v->SetInt( x )
end sub
public sub tkBind_ToValue( byval x as longint, byval v as TK_VALUE ptr )
    if v then v->SetInt( x )
end sub
public sub tkBind_ToValue( byval x as ulongint, byval v as TK_VALUE ptr )
    if v then v->SetInt( x )
end sub
public sub tkBind_ToValue( byval x as integer, byval v as TK_VALUE ptr )
    if v then v->SetInt( x )
end sub
public sub tkBind_ToValue( byval x as uinteger, byval v as TK_VALUE ptr )
    if v then v->SetInt( x )
end sub
public sub tkBind_ToValue( byval x as single, byval v as TK_VALUE ptr )
    if v then v->SetFloat( x )
end sub
public sub tkBind_ToValue( byval x as double, byval v as TK_VALUE ptr )
    if v then v->SetFloat( x )
end sub
public sub tkBind_ToValue( byref x as const ustring, byval v as TK_VALUE ptr )
    if v then v->SetText( x )
end sub
public sub tkBind_ToValue( byref x as const string, byval v as TK_VALUE ptr )
    if v then v->SetText( x )
end sub
public sub tkBind_ToValue( byref x as const TKDATE, byval v as TK_VALUE ptr )
    if v then v->SetDate( x )
end sub
public sub tkBind_ToValue( byref x as LocalDate, byval v as TK_VALUE ptr )
    if v then v->SetDate( DateOfLocal_( x ) )
end sub
public sub tkBind_ToValue( byref x as DateTime, byval v as TK_VALUE ptr )
    if v then v->SetDate( tkBind_Date( x ) )
end sub
public sub tkBind_ToValue( byref x as const TKTIME, byval v as TK_VALUE ptr )
    if v then v->SetTime( x )
end sub
public sub tkBind_ToValue( byref x as chrono.LocalTime, byval v as TK_VALUE ptr )
    if v then v->SetTime( TimeOfLocal_( x ) )
end sub
