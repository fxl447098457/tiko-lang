public sub tkBind_Put( byref f as LocalDate, byref v as const ustring, byref fmt as const ustring ) : f = LocalOfDateB2_( DateOfTextFmt_( v, fmt ) ) : end sub

' ---- B3: list binding helpers -----------------------------------------------------------------

' Where text is in values (a ComboBox's ValueField texts), or -1.
public function tkBind_IndexOf( byref values as Array( of ustring ), byref text as const ustring ) as long
    for i as long = 0 to values.Count( ) - 1
        if values[i] = text then return i
    next
    return -1
end function

' The chosen item's value text; "" for no choice (into a field: 0, false, no date, "").
private function PickText_( byref values as Array( of ustring ), byval sel as long ) as ustring
    if (sel < 0) orelse (sel >= values.Count( )) then return ""
    return values[sel]
end function

' No choice: Required says so, and there is nothing else to check. True when handled.
private function PickNone_( byref e as TKBIND_ERRORS, byval w as TK_WIDGET ptr, byref fld as const ustring, _
                            byref values as Array( of ustring ), byval sel as long, byref ru as const TKBIND_RULE ) as boolean
    if (sel >= 0) andalso (sel < values.Count( )) then return false
    if ru.Required then e.Add( w, fld, TKBIND_ERR_REQUIRED, "", "is required" )
    return true
end function

' The rule for the chosen value itself: Required was the choice's to meet.
private function NoRequired_( byref ru as const TKBIND_RULE ) as TKBIND_RULE
    dim as TKBIND_RULE r = ru
    r.Required = false
    return r
end function

' LoadFrom: the field's value (as tkBind_Text gives it) found no item. "" and "0" are no value.
public sub tkBind_LoadedPick( byref e as TKBIND_ERRORS, byval w as TK_WIDGET ptr, byref fld as const ustring, _
                              byref held as const ustring, byval sel as long )
    if sel >= 0 then exit sub
    dim as ustring t = trim( held )
    if (len( t ) = 0) orelse (t = "0") then exit sub
    e.Add( w, fld, TKBIND_ERR_NOTINLIST, t, "'" & t & "' is not in the list" )
end sub

' ---- B3: a ComboBox that binds its items' ValueField ------------------------------------------
' The values are kept as text (tkBind_Text of each item's ValueField, in a generated member); the
' chosen one goes back through tkBind_Check / tkBind_Put, so an id, a code or a date all bind.

public sub tkBind_CheckPick overload( byref e as TKBIND_ERRORS, byval w as TK_WIDGET ptr, byref fld as const ustring, byref f as boolean, byref values as Array( of ustring ), byval sel as long, byref ru as const TKBIND_RULE )
    if PickNone_( e, w, fld, values, sel, ru ) then exit sub
    tkBind_Check( e, w, fld, f, values[sel], NoRequired_( ru ) )
end sub
public sub tkBind_CheckPick( byref e as TKBIND_ERRORS, byval w as TK_WIDGET ptr, byref fld as const ustring, byref f as byte, byref values as Array( of ustring ), byval sel as long, byref ru as const TKBIND_RULE )
    if PickNone_( e, w, fld, values, sel, ru ) then exit sub
    tkBind_Check( e, w, fld, f, values[sel], NoRequired_( ru ) )
end sub
public sub tkBind_CheckPick( byref e as TKBIND_ERRORS, byval w as TK_WIDGET ptr, byref fld as const ustring, byref f as ubyte, byref values as Array( of ustring ), byval sel as long, byref ru as const TKBIND_RULE )
    if PickNone_( e, w, fld, values, sel, ru ) then exit sub
    tkBind_Check( e, w, fld, f, values[sel], NoRequired_( ru ) )
end sub
