' ---- Format: a field as text in a pattern (load), text in that pattern back into it (save) --------

public function tkBind_Text overload( byval v as boolean, byref fmt as const ustring ) as ustring : return iif( v, "true", "false" ) : end function
public function tkBind_Text( byval v as byte, byref fmt as const ustring ) as ustring : return FmtI_( v, fmt ) : end function
public function tkBind_Text( byval v as ubyte, byref fmt as const ustring ) as ustring : return FmtI_( v, fmt ) : end function
public function tkBind_Text( byval v as short, byref fmt as const ustring ) as ustring : return FmtI_( v, fmt ) : end function
public function tkBind_Text( byval v as ushort, byref fmt as const ustring ) as ustring : return FmtI_( v, fmt ) : end function
public function tkBind_Text( byval v as long, byref fmt as const ustring ) as ustring : return FmtI_( v, fmt ) : end function
public function tkBind_Text( byval v as ulong, byref fmt as const ustring ) as ustring : return FmtI_( v, fmt ) : end function
public function tkBind_Text( byval v as longint, byref fmt as const ustring ) as ustring : return FmtI_( v, fmt ) : end function
public function tkBind_Text( byval v as ulongint, byref fmt as const ustring ) as ustring : return FmtU_( v, fmt ) : end function
public function tkBind_Text( byval v as integer, byref fmt as const ustring ) as ustring : return FmtI_( v, fmt ) : end function
public function tkBind_Text( byval v as uinteger, byref fmt as const ustring ) as ustring : return FmtU_( v, fmt ) : end function
public function tkBind_Text( byval v as single, byref fmt as const ustring ) as ustring : return FmtF_( v, fmt ) : end function
public function tkBind_Text( byval v as double, byref fmt as const ustring ) as ustring : return FmtF_( v, fmt ) : end function
public function tkBind_Text( byref v as const ustring, byref fmt as const ustring ) as ustring : return v : end function
public function tkBind_Text( byref v as const string, byref fmt as const ustring ) as ustring : return v : end function
public function tkBind_Text( byref v as const TKDATE, byref fmt as const ustring ) as ustring : return FmtDate_( v, fmt ) : end function
public function tkBind_Text( byref v as LocalDate, byref fmt as const ustring ) as ustring : return FmtDate_( DateOfLocalB2_( v ), fmt ) : end function
public sub tkBind_Put overload( byref f as boolean, byref v as const ustring, byref fmt as const ustring ) : tkBind_Put( f, v ) : end sub
public sub tkBind_Put( byref f as byte, byref v as const ustring, byref fmt as const ustring ) : tkBind_Put( f, v ) : end sub
public sub tkBind_Put( byref f as ubyte, byref v as const ustring, byref fmt as const ustring ) : tkBind_Put( f, v ) : end sub
public sub tkBind_Put( byref f as short, byref v as const ustring, byref fmt as const ustring ) : tkBind_Put( f, v ) : end sub
public sub tkBind_Put( byref f as ushort, byref v as const ustring, byref fmt as const ustring ) : tkBind_Put( f, v ) : end sub
public sub tkBind_Put( byref f as long, byref v as const ustring, byref fmt as const ustring ) : tkBind_Put( f, v ) : end sub
