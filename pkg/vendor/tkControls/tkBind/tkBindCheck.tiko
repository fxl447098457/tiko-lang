' ---- B4: comparing for IsDirty ----------------------------------------------------------------

private function DiffReal_( byval held as float64, byval shown as float64 ) as boolean
    dim as float64 scale_ = abs( held )
    if scale_ < 1 then scale_ = 1
    return abs( held - shown ) > 1e-9 * scale_
end function

' A number field against text: empty text is 0; text that is no number differs.
private function DiffNum_( byval held as float64, byref v as const ustring ) as boolean
    dim as float64 x
    if len( trim( v ) ) = 0 then return DiffReal_( held, 0 )
    if ParseReal_( v, x ) = false then return true
    return DiffReal_( held, x )
end function

private function DiffBool_( byval held as boolean, byref v as const ustring ) as boolean
    dim as boolean b
    if len( trim( v ) ) = 0 then return held
    if ParseBool_( v, b ) = false then return true
    return b <> held
end function

' A date field against text in fmt (or ISO): empty text is no date; text that is no date differs.
private function DiffDate_( byref held as const TKDATE, byref v as const ustring, byref fmt as const ustring ) as boolean
    dim as TKDATE d
    if ParseDate_( v, fmt, d ) = false then return true
    return IsoB2_( d ) <> IsoB2_( held )
end function

' Two value texts the same, "" and "0" both standing for no value.
private function SamePick_( byref a as const ustring, byref b as const ustring ) as boolean
    dim as ustring x = trim( a ), y = trim( b )
    if (x = "0") then x = ""
    if (y = "0") then y = ""
    return x = y
end function

' ---- B4: does the control show something else than the field holds? (IsDirty, per value) -----
' Text is read strictly (text that is no number differs from any number); numbers within a float
' tolerance; dates by day. A by-value ComboBox: its chosen value's text against the field's, with
' "" and "0" both no value. Nothing here writes.

public function tkBind_Differs overload( byref f as boolean, byref v as const ustring, byref fmt as const ustring ) as boolean : return DiffBool_( f, v ) : end function
