    if (p = 0) orelse p->bLayoutDirty then return false
    rc = p->rcIcon
    return true
end function

' 1 inside the icon cell, 0 anywhere else (the field is a child and hits nothing here).
public function tkDatePicker_HitTest( byval hCtrl as TK_WIDGET ptr, byval pt as TKPOINT ) as long
    dim as TKDATEPICKER_STATE ptr p = DtpReady( hCtrl )
    if (p = 0) orelse p->bLayoutDirty then return 0
    return iif( tkRect_Contains( p->rcIcon, pt.x, pt.y ), 1, 0 )
end function

