' No callback, no tooltip machinery: the calendar builds its tip lazily, and only with one set.
public sub tkDatePicker_SetTooltipCallback( byval hCtrl as TK_WIDGET ptr, byval userfunc as DTP_TooltipCallbackFunc )
    dim as TKDATEPICKER_STATE ptr p = GetDatePickerPointer( hCtrl )
    if p = 0 then exit sub
    p->TooltipCallback = userfunc
    if p->wCal then
        if userfunc then tkCalendar_SetTooltipCallback( p->wCal, @DtpCalTooltip ) else tkCalendar_SetTooltipCallback( p->wCal, 0 )
    end if
end sub

' The calendar's tkTooltip, under vendor's rule: 0 unless the calendar is open AND a day cell
' has asked for a tip.
public function tkDatePicker_GetTooltipHandle( byval hCtrl as TK_WIDGET ptr ) as TK_TIP ptr
    dim as TKDATEPICKER_STATE ptr p = GetDatePickerPointer( hCtrl )
    if (p = 0) orelse (p->wCal = 0) then return 0
    return tkCalendar_GetTooltipHandle( p->wCal )
end function

' ---- render probes (vendor's, on the open calendar) ---------------------------------------
' Distinct colours over the whole calendar, capped at 256.
public function tkDatePicker_TestCalendarTones( byval hCtrl as TK_WIDGET ptr ) as long
    dim as TKDATEPICKER_STATE ptr p = GetDatePickerPointer( hCtrl )
    if (p = 0) orelse (p->wCal = 0) then return 0
    return tkCalendar_TestPartTones( p->wCal, CAL_PART_CLIENT )
end function

' Brightest pixel in a part: 0 = prev chevron, 1 = next chevron, 100 + k = day cell k of panel
' 0. -1 when the calendar is not open.
public function tkDatePicker_TestPartBrightness( byval hCtrl as TK_WIDGET ptr, byval nPart as long ) as long
    dim as TKDATEPICKER_STATE ptr p = GetDatePickerPointer( hCtrl )
    if (p = 0) orelse (p->wCal = 0) then return -1
    dim as long calPart
    select case nPart
    case 0 : calPart = CAL_PART_PREV
    case 1 : calPart = CAL_PART_NEXT
    case 100 to 141 : calPart = CAL_PART_DAYCELL_BASE + (nPart - 100)
    case else : return -1
    end select
    return tkCalendar_TestPartBrightness( p->wCal, calPart )
end function

' Distinct colours inside the Today band; 0 when the band is off or the calendar is closed.
public function tkDatePicker_TestFooterTones( byval hCtrl as TK_WIDGET ptr ) as long
    dim as TKDATEPICKER_STATE ptr p = GetDatePickerPointer( hCtrl )
    if (p = 0) orelse (p->wFooter = 0) then return 0
    dim as TK_HOST ptr pop = p->pPop
    tkHost_RenderTo( pop, false )
    dim as TKRECT a
    tkWidget_AbsRect( p->wFooter, a )
    dim as SDL_Rect r
    r.x = a.left : r.y = a.top : r.w = a.right - a.left : r.h = a.bottom - a.top
    dim as SDL_Surface ptr s0 = SDL_RenderReadPixels( pop->renderer, @r )
    pop->bDirty = true
    if s0 = 0 then return 0
    dim as SDL_Surface ptr s = SDL_ConvertSurface( s0, SDL_PIXELFORMAT_ARGB8888 )
    SDL_DestroySurface( s0 )
    if s = 0 then return 0
    dim seen(0 to 255) as ulong
    dim as long nSeen = 0
    for y as long = 0 to s->h - 1
        dim as ulong ptr row = cast( ulong ptr, cast( ubyte ptr, s->pixels ) + y * s->pitch )
        for x as long = 0 to s->w - 1
            dim as ulong c = row[x] and &h00FFFFFFul
            dim as boolean bNew = true
            for i as long = 0 to nSeen - 1
                if seen(i) = c then bNew = false : exit for
            next
            if bNew andalso (nSeen < 256) then seen(nSeen) = c : nSeen += 1
        next
    next
    SDL_DestroySurface( s )
    return nSeen
end function

' The theme's shape (tkTheme_ShapeOf, design units) unless the host set this control's own --
' its setter pins it. -1 in the theme gives the control's default. Only a change calls the setter.
private sub ApplyThemeShape( byval w as TK_WIDGET ptr )
    dim as TKDATEPICKER_STATE ptr p = GetDatePickerPointer( w )
    if (p = 0) orelse p->bShapePinned then exit sub
    dim as TKTHEME_SHAPE sh = tkTheme_ShapeOf( w )
    dim as long v
    v = iif( sh.CornerRadius >= 0, tkHost_Scale( w->pHost, sh.CornerRadius ), tkHost_Scale( w->pHost, CDTP_DEFAULT_CORNERRADIUS ) )
    if p->nCornerRadius <> v then tkDatePicker_SetCornerRadius( w, v )
    p->bShapePinned = false
end sub
