' ---- colours ------------------------------------------------------------------------------
public sub tkDatePicker_GetColors( byval hCtrl as TK_WIDGET ptr, byval pColors as TKDATEPICKER_COLORS ptr )
    dim as TKDATEPICKER_STATE ptr p = GetDatePickerPointer( hCtrl )
    if (p = 0) orelse (pColors = 0) then exit sub
    *pColors = p->colors
end sub

' Copies them in (and PINS them), pushes the field colours into the text box, and repaints the
' control and any open calendar.
public sub tkDatePicker_SetColors( byval hCtrl as TK_WIDGET ptr, byval pColors as TKDATEPICKER_COLORS ptr )
    dim as TKDATEPICKER_STATE ptr p = GetDatePickerPointer( hCtrl )
    if (p = 0) orelse (pColors = 0) then exit sub
    p->colors = *pColors
    p->bColorsPinned = true
    DtpApplyFieldColors( p )
    tkWidget_Invalidate( hCtrl )
    if p->wCal then
        dim as TKCALENDAR_COLORS cc = DtpCalColors( p )
        tkCalendar_SetColors( p->wCal, @cc )
    end if
    if p->pPop then
        p->pPop->clrBack = p->colors.CalBackColor
        tkHost_Invalidate( p->pPop )
    end if
end sub

public function tkDatePicker_ThemeColors( byref t as TKTHEME_COLORS ) as TKDATEPICKER_COLORS
    dim as TKDATEPICKER_COLORS c
    c.BackColor                = t.Window
    c.BorderColor              = t.Border
    c.FocusBorderColor         = t.FocusRing
    c.BorderColorDisabled      = t.BorderDisabled
    c.DividerColor             = t.Divider
    c.DividerColorDisabled     = t.BorderDisabled
    c.FieldBackColor           = t.Surface
    c.FieldForeColor           = t.Text
    c.FieldBackColorDisabled   = t.SurfaceDisabled
    c.FieldForeColorDisabled   = t.TextDisabled
    c.IconColor                = t.Surface
    c.IconGlyphColor           = t.Text
    c.IconGlyphColorHot        = t.TextHot
    c.IconBackColorHot         = t.SurfaceHot
    c.IconGlyphColorDisabled   = t.TextDisabled
    c.CalBackColor             = t.Popup
    c.CalBorderColor           = t.Border
    c.TitleColor               = t.TextHot
    c.TitleColorHot            = t.TextStrong
    c.NavGlyphColor            = t.Text
    c.NavGlyphColorHot         = t.TextHot
    c.NavGlyphColorDisabled    = t.TextDisabled
    c.WeekdayColor             = t.TextDim
    c.DayColor                 = t.PopupText
    c.DayColorWeekend          = t.AccentHot
    c.DayColorAdjacent         = t.TextDim
    c.DayColorDisabled         = t.TextDisabled
    c.DayBackColorHot          = t.SurfaceHot
    c.DayForeColorHot          = t.TextHot
    c.DayBackColorSelected     = t.Selected
    c.DayForeColorSelected     = t.SelectedText
    c.TodayRingColor           = t.Accent
    c.TodayFooterColor         = t.TextDim
    c.TodayFooterColorHot      = t.TextHot
    c.TodayFooterColorDisabled = t.TextDisabled
    return c
end function

public sub tkDatePicker_ApplyTheme( byval hCtrl as TK_WIDGET ptr, byref t as TKTHEME_COLORS )
    dim as TKDATEPICKER_STATE ptr p = GetDatePickerPointer( hCtrl )
    if p = 0 then exit sub
    ApplyThemeShape( hCtrl )
    if p->bColorsPinned then exit sub
    dim as TKTHEME_COLORS tr = tkTheme_Styled( hCtrl, t )
    dim as TKDATEPICKER_COLORS c = tkDatePicker_ThemeColors( tr )
    tkTheme_ResolveInto( hCtrl, tr, cast( ulong ptr, @c ), sizeof( TKDATEPICKER_COLORS ) \ 4, "DatePicker" )
    tkDatePicker_SetColors( hCtrl, @c )
    p->bColorsPinned = false
end sub

public sub tkDatePicker_UnpinColors( byval hCtrl as TK_WIDGET ptr )
    dim as TKDATEPICKER_STATE ptr p = GetDatePickerPointer( hCtrl )
    if p = 0 then exit sub
    p->bColorsPinned = false
    tkDatePicker_ApplyTheme( hCtrl, tkTheme_Of( hCtrl ) )
end sub

public sub tkDatePicker_ApplyFonts( byval hCtrl as TK_WIDGET ptr, byval fText as TTF_Font ptr, byval fGlyph as TTF_Font ptr )
    if fText then tkDatePicker_SetFont( hCtrl, fText )
    if fGlyph then tkDatePicker_SetIconFont( hCtrl, fGlyph )
end sub

