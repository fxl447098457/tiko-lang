    if p = 0 then exit sub
    p->nBorderThick = iif( nThickness < 0, 0, nThickness )
    DtpRefresh( p )
end sub

' vendor's formula: the field text (or "Wednesday, September 30, 2222" when it is empty) plus
' both paddings, the corner inset, the divider and the icon; one text line plus the vertical
' padding and the border. Valid before the control has ever been sized.
public sub tkDatePicker_GetIdealSize( byval hCtrl as TK_WIDGET ptr, byref nWidth as long, byref nHeight as long )
    dim as TKDATEPICKER_STATE ptr p = GetDatePickerPointer( hCtrl )
    nWidth = 0 : nHeight = 0
    if p = 0 then exit sub
    dim as TTF_Font ptr f = DtpFont( p )
    dim as ustring sMeasure
    if p->wText then sMeasure = tkTextBox_GetText( p->wText )
    if len( trim( sMeasure ) ) = 0 then sMeasure = "Wednesday, September 30, 2222"
    dim as long textW = tkText_Width( f, sMeasure )
    nWidth = p->nCornerRadius + p->nFieldPadLeft + textW + p->nFieldPadRight + p->nDividerThick + p->nIconWidth
    nHeight = tkText_Height( f ) + 2 * p->nVertPadding + 2 * p->nBorderThick
end sub

public function tkDatePicker_GetEnabled( byval hCtrl as TK_WIDGET ptr ) as boolean
    dim as TKDATEPICKER_STATE ptr p = GetDatePickerPointer( hCtrl )
    if p = 0 then return false
    return p->isEnabled
end function

' The container AND the field, so the disable is enforced rather than cosmetic.
public sub tkDatePicker_SetEnabled( byval hCtrl as TK_WIDGET ptr, byval isEnabled as boolean )
    dim as TKDATEPICKER_STATE ptr p = GetDatePickerPointer( hCtrl )
    if p = 0 then exit sub
    tkWidget_Enable( hCtrl, isEnabled )
    if p->wText then tkWidget_Enable( p->wText, isEnabled )
end sub

