' tkReport -- expressions in a report (Report Designer RD2; claude-docs docs/tkReportDesigner/SPEC.md,
' "Engine changes"). Everything here is text compiled by tkRExpr against the report's schema: the
' source's fields, then the calculated fields, then the parameters.
'
'   calculated fields   a virtual field per row: tkReport_AddCalcField( rpt, "LineTotal", "[Qty] * [Price]" )
'   group expressions   tkReport_AddGroupExpr( rpt, "Year([Date])" )      (rows arrive in its order)
'   a filter            tkReport_SetFilter( rpt, "[Paid] and [Amount] > 0" ): rows it is false for are skipped
'   items               TKRI_EXPR (a value, formatted by fmt) and TKRI_TEXT ("Total: {Sum([Amount])}"), and
'                       any item's visibleExpr and rules (conditional styles); a band's visibleExpr
'   parameters          tkReport_AddParam / SetParam: @From in any expression
'
' TOTALS in an expression (Sum( ) ...) each get an accumulator here (RP_XACC), with
'   reset  where it restarts: the item's 'reset', or by its band (a group's -> that group, the page
'          header / footer -> each page, else the whole report);
'   incr   which rows feed it: every row, or (incrLevel = L) once per group L -- a master's rows when
'          master and detail arrive flattened, one row per detail row.
' Group and report totals are fed as rows are read; page totals as their rows are drawn, so a row
' read ahead for the next page never counts on this one.
'
' LATE VALUES: an item whose value is not known where it prints -- PageCount anywhere, a group's
' totals in its own header, the report's in the report header, the page's in the page header --
' prints into a slot of the document (tkPrintDoc_NewSlot) that is filled when the scope closes. It
' is one line, fixed in its rect, and every page that shows it is drawn again when it fills.
#module "tkReport"

#import "../tkPrint"
#import "../tkBind"
#import "../tkRExpr"
using tkPrint
using tkBind
using tkRExpr
using tkHost
using tkPaint

' ---- building --------------------------------------------------------------------------------
' A field computed per row from the others (and the calculated fields before it). No totals. Its
' field index is the source's field count + its order among the calculated fields.
public function tkReport_AddCalcField( byval rpt as TK_REPORT ptr, byref name_ as const ustring, _
                                       byref expr as const ustring, byref defaultSource as const ustring = "" ) as long
    if rpt = 0 then return -1
    dim as long c = rpt->nCalcUser
    redim preserve rpt->calcName( 0 to c )
    redim preserve rpt->calcSrc( 0 to c )
    redim preserve rpt->calcDef( 0 to c )
    rpt->calcName(c) = name_
    rpt->calcSrc(c) = expr
    rpt->calcDef(c) = defaultSource
    rpt->nCalcUser += 1
    rpt->nCalc = rpt->nCalcUser
    rpt->prepared = false
    return c
end function

' Rows for which expr is not true are left out (before groups, totals and RowNumber). "" = none.
public sub tkReport_SetFilter( byval rpt as TK_REPORT ptr, byref expr as const ustring, byref defaultSource as const ustring = "" )
    if rpt = 0 then exit sub
    rpt->filterSrc = expr
    rpt->filterDef = defaultSource
    rpt->prepared = false
end sub

' Rows the filter left out in the last layout.
public function tkReport_GetFilteredCount( byval rpt as TK_REPORT ptr ) as integer
    if rpt = 0 then return 0
    return rpt->nFiltered
end function

' A parameter (@name in expressions) of a kind (TKV_*); its index. Set it with SetParam.
public function tkReport_AddParam( byval rpt as TK_REPORT ptr, byref name_ as const ustring, byval kind as long ) as long
    if rpt = 0 then return -1
    dim as long i = rpt->nPar
    redim preserve rpt->pName( 0 to i )
    redim preserve rpt->pKind( 0 to i )
    redim preserve rpt->pVal( 0 to i )
    rpt->pName(i) = name_
    rpt->pKind(i) = kind
    rpt->nPar += 1
    rpt->prepared = false
    return i
end function

public sub tkReport_SetParam( byval rpt as TK_REPORT ptr, byval i as long, byref v as TK_VALUE )
    if (rpt = 0) orelse (i < 0) orelse (i >= rpt->nPar) then exit sub
    rpt->pVal(i) = v
end sub

public function tkReport_FindParam( byval rpt as TK_REPORT ptr, byref name_ as const ustring ) as long
    if rpt = 0 then return -1
    for i as long = 0 to rpt->nPar - 1
        if lcase( rpt->pName(i) ) = lcase( name_ ) then return i
    next
    return -1
end function

' The source is asked to order its rows by field, ascending or descending (most significant first).
' The report never sorts (P-13); a source that can't is warned about when laid out.
public sub tkReport_AddSortKey( byval rpt as TK_REPORT ptr, byval nField as long, byval bDesc as boolean = false )
    if rpt = 0 then exit sub
    redim preserve rpt->sortK( 0 to rpt->nSortK )
    rpt->sortK(rpt->nSortK).field = nField
    rpt->sortK(rpt->nSortK).desc = bDesc
    rpt->nSortK += 1
    rpt->sortDone = false
end sub

public sub tkReport_ClearSortKeys( byval rpt as TK_REPORT ptr )
    if rpt = 0 then exit sub
    erase rpt->sortK
    rpt->nSortK = 0
    rpt->sortDone = false
end sub

' An item showing an expression's value, formatted by fmt (tkReport_FormatValue's masks).
public function tkRBand_AddExpr( byval band as TK_RBAND ptr, byref rc as TKRECTF, byref expr as const ustring, _
                                 byref fmt as ustring = "", byval flags as long = TK_DT_LEFT ) as TKREPORT_ITEM ptr
    dim as TKREPORT_ITEM it
    it.kind = TKRI_EXPR : it.rc = rc : it.expr = expr : it.fmt = fmt : it.flags = flags
    return tkRBand_AddItem( band, it )
end function

' Text with {expression} parts ({{ is a "{"): "Total for {[Customer]}: {Format(Sum([Amount]), "#,##0.00")}".
public function tkRBand_AddText( byval band as TK_RBAND ptr, byref rc as TKRECTF, byref template_ as const ustring, _
                                 byval flags as long = TK_DT_LEFT ) as TKREPORT_ITEM ptr
    dim as TKREPORT_ITEM it
    it.kind = TKRI_TEXT : it.rc = rc : it.expr = template_ : it.flags = flags
    return tkRBand_AddItem( band, it )
end function

' A conditional style for an item (tested in order; the first true one applies).
public sub tkRItem_AddRule( byval item as TKREPORT_ITEM ptr, byref rule as TKREPORT_RULE )
    if item = 0 then exit sub
    redim preserve item->rules( 0 to item->nRules )
    item->rules(item->nRules) = rule
    item->rules(item->nRules).px = 0
    item->rules(item->nRules).aggBase = -1
    item->nRules += 1
end sub

' ---- compiling -------------------------------------------------------------------------------
' "Total: {Sum([X])}" -> "Total: " & (Sum([X])). FALSE when a { is not closed.
function RpTemplateToExpr( byref t as const ustring, byref e as ustring ) as boolean
    dim as ustring lit
    e = ""
    dim as long i = 1, n = len( t )
    while i <= n
        dim as ustring c = mid( t, i, 1 )
        if (c = "{") andalso (mid( t, i + 1, 1 ) = "{") then
            lit &= "{"
            i += 2
            continue while
        end if
        if (c = "}") andalso (mid( t, i + 1, 1 ) = "}") then
            lit &= "}"
            i += 2
            continue while
        end if
        if c = "{" then
            dim as long j = instr( i + 1, t, "}" )
            if j = 0 then return false
            dim as ustring part = trim( mid( t, i + 1, j - i - 1 ) )
            ' the printing R4 tokens
            select case lcase( part )
            case "p" : part = "PageNumber"
            case "n" : part = "PageCount"
            case "title" : part = "ReportTitle"
            case "date" : part = "PrintDate"
            case "time" : part = "Format(PrintTime, ""hh:nn"")"
            end select
            if len( lit ) then
                if len( e ) then e &= " & "
                e &= """" & RpQuote( lit ) & """"
                lit = ""
            end if
            if len( e ) then e &= " & "
            e &= "(" & part & ")"
            i = j + 1
            continue while
        end if
        lit &= c
        i += 1
    wend
    if len( lit ) orelse (len( e ) = 0) then
        if len( e ) then e &= " & "
        e &= """" & RpQuote( lit ) & """"
    end if
    return true
end function

function RpQuote( byref s as const ustring ) as ustring
    dim as ustring r
    for i as long = 1 to len( s )
        dim as ustring c = mid( s, i, 1 )
        if c = """" then r &= """""" else r &= c
    next
    return r
end function

private function BandName( byval b as TKREPORT_BAND ptr ) as ustring
    select case b->kind
    case TKRB_REPORT_HEADER : return "report header"
    case TKRB_PAGE_HEADER : return "page header"
    case TKRB_GROUP_HEADER : return "group " & b->level & " header"
    case TKRB_DETAIL : return "detail"
    case TKRB_GROUP_FOOTER : return "group " & b->level & " footer"
    case TKRB_REPORT_FOOTER : return "report footer"
    case TKRB_PAGE_FOOTER : return "page footer"
    case TKRB_NO_DATA : return "no-data band"
    end select
    return "band"
end function

sub RpFreeCompiled( byval r as TK_REPORT ptr )
    for c as long = 0 to ubound( r->calcX )
        tkRExpr_Destroy( r->calcX(c) )
        r->calcX(c) = 0
    next
    tkRExpr_Destroy( r->filterX )
    r->filterX = 0
    for b as long = 0 to r->nBands - 1
        dim as TKREPORT_BAND ptr bd = r->bands(b)
        tkRExpr_Destroy( bd->pvis )
        bd->pvis = 0 : bd->visBase = -1
        for i as long = 0 to bd->nItems - 1
            dim byref as TKREPORT_ITEM it = bd->items(i)
            tkRExpr_Destroy( it.px )
            tkRExpr_Destroy( it.pvis )
            it.px = 0 : it.pvis = 0 : it.aggBase = -1 : it.visBase = -1 : it.late = 0
            for k as long = 0 to it.nRules - 1
                tkRExpr_Destroy( it.rules(k).px )
                it.rules(k).px = 0 : it.rules(k).aggBase = -1
            next
        next
    next
    erase r->xa
    r->nXa = 0
    r->prepared = false
end sub

' Compiles src against the schema; records an error with where it was. 0 on error.
private function CompileOne( byval r as TK_REPORT ptr, byref src as const ustring, byref where as const ustring, _
                             byref errors as ustring ) as TK_REXPR ptr
    if len( trim( src ) ) = 0 then return 0
    dim as TKREXPR_ERROR e
    dim as TK_REXPR ptr x = tkRExpr_Compile( src, r->sch, e )
    if x = 0 then
        if len( errors ) then errors &= chr( 10 )
        errors &= where & ": " & e.msg & " (column " & e.col & " of " & src & ")"
    end if
    return x
end function

private function ResetOf( byval reset as long, byval b as TKREPORT_BAND ptr ) as long
    if reset <> TKRS_RESET_AUTO then return reset
    select case b->kind
    case TKRB_GROUP_HEADER, TKRB_GROUP_FOOTER : return b->level
    case TKRB_PAGE_HEADER, TKRB_PAGE_FOOTER : return TKRS_SCOPE_PAGE
    end select
    return TKRS_SCOPE_REPORT
end function

' x's totals as accumulators; the index of the first (-1 when x has none).
private function Register( byval r as TK_REPORT ptr, byval x as TK_REXPR ptr, byval reset as long, byval incr as long ) as long
    dim as long n = tkRExpr_AggCount( x )
    if n = 0 then return -1
    dim as long base_ = r->nXa
    redim preserve r->xa( 0 to r->nXa + n - 1 )
    for k as long = 0 to n - 1
        dim byref as RP_XACC a = r->xa(base_ + k)
        a.x = x : a.k = k : a.reset = reset : a.incr = incr
        tkRExpr_AccInit( a.acc, x, k )
        ' GroupCount( ) counts the rows of the innermost group, wherever it is
        if tkRExpr_AggFn( x, k ) = TKRX_AGG_GROUPCOUNT then a.reset = iif( r->nGroups > 0, r->nGroups - 1, TKRS_SCOPE_REPORT )
    next
    r->nXa += n
    return base_
end function

' Compile every expression of the report. FALSE with errors (one line each, saying where) when any
' does not compile; what did compile still works, what did not prints nothing. Laying out a report
' prepares it first when it has to; a host that wants the errors calls this itself.
public function tkReport_Prepare( byval rpt as TK_REPORT ptr, byref errors as ustring ) as boolean
    errors = ""
    if rpt = 0 then return false
    RpFreeCompiled( rpt )
    dim byref as TK_REPORT r = *rpt
    ' the schema: the source's fields, the calculated ones, the parameters
    r.sch.Clear( )
    r.nSrcF = 0
    if r.bSrc then r.nSrcF = r.src.FieldCount( r.src.pCtx )
    for f as long = 0 to r.nSrcF - 1
        dim as long k = r.src.FieldKind( r.src.pCtx, f )
        if (k < TKV_TEXT) orelse (k > TKV_TIME) then k = TKV_TEXT
        r.sch.AddField( r.src.FieldName( r.src.pCtx, f ), k )
    next
    for i as long = 0 to r.nPar - 1
        r.sch.AddParam( r.pName(i), r.pKind(i) )
    next
    ' calculated fields, then the group expressions as hidden ones
    r.nCalc = r.nCalcUser
    redim preserve r.calcX( 0 to iif( r.nCalc > 0, r.nCalc - 1, 0 ) )
    r.sch.noAggregates = true
    for c as long = 0 to r.nCalcUser - 1
        r.sch.defaultSource = r.calcDef(c)
        r.calcX(c) = CompileOne( rpt, r.calcSrc(c), "calculated field '" & r.calcName(c) & "'", errors )
        r.sch.AddField( r.calcName(c), iif( r.calcX(c), tkRExpr_Kind( r.calcX(c) ), TKV_TEXT ) )
    next
    for L as long = 0 to r.nGroups - 1
        if len( r.groupExpr(L) ) = 0 then continue for
        dim as long c = r.nCalc
        redim preserve r.calcName( 0 to c )
        redim preserve r.calcSrc( 0 to c )
        redim preserve r.calcX( 0 to c )
        r.calcName(c) = "__group" & L
        r.calcSrc(c) = r.groupExpr(L)
        r.sch.defaultSource = r.groupDef(L)
        r.calcX(c) = CompileOne( rpt, r.groupExpr(L), "group " & L & "'s expression", errors )
        r.sch.AddField( r.calcName(c), iif( r.calcX(c), tkRExpr_Kind( r.calcX(c) ), TKV_TEXT ) )
        r.groupKey(L) = r.nSrcF + c
        r.nCalc += 1
    next
    r.sch.defaultSource = r.filterDef
    r.filterX = CompileOne( rpt, r.filterSrc, "the filter", errors )
    r.sch.defaultSource = ""
    if (r.filterX <> 0) andalso (tkRExpr_Kind( r.filterX ) <> TKV_BOOL) then
        if len( errors ) then errors &= chr( 10 )
        errors &= "the filter: it must be true / false"
        tkRExpr_Destroy( r.filterX )
        r.filterX = 0
    end if
    r.sch.noAggregates = false
    ' the bands' and items' expressions
    for b as long = 0 to r.nBands - 1
        dim as TKREPORT_BAND ptr bd = r.bands(b)
        r.sch.defaultSource = bd->defaultSource
        dim as ustring bn = BandName( bd )
        bd->pvis = CompileOne( rpt, bd->visibleExpr, bn & " (visible)", errors )
        if bd->pvis then bd->visBase = Register( rpt, bd->pvis, ResetOf( TKRS_RESET_AUTO, bd ), -1 )
        for i as long = 0 to bd->nItems - 1
            dim byref as TKREPORT_ITEM it = bd->items(i)
            dim as ustring where = bn & " item " & (i + 1)
            if len( it.name_ ) then where = bn & " item '" & it.name_ & "'"
            dim as long reset = ResetOf( it.reset, bd )
            dim as ustring src = it.expr
            if it.kind = TKRI_TEXT then
                if RpTemplateToExpr( it.expr, src ) = false then
                    if len( errors ) then errors &= chr( 10 )
                    errors &= where & ": a { is not closed in " & it.expr
                    src = ""
                end if
            end if
            if len( src ) then
                it.px = CompileOne( rpt, src, where, errors )
                if it.px then
                    it.aggBase = Register( rpt, it.px, reset, it.incrLevel )
                    ' late: known only later than where it prints
                    if tkRExpr_UsesValue( it.px, TKRX_B_PAGECOUNT ) then it.late or= RP_LATE_DOC
                    if (it.aggBase >= 0) andalso (it.running = false) then
                        select case bd->kind
                        case TKRB_GROUP_HEADER : if reset >= 0 then it.late or= RP_LATE_GROUP
                        case TKRB_REPORT_HEADER : it.late or= RP_LATE_REPORT
                        case TKRB_PAGE_HEADER : if reset = TKRS_SCOPE_PAGE then it.late or= RP_LATE_PAGE
                        end select
                    end if
                end if
            end if
            it.pvis = CompileOne( rpt, it.visibleExpr, where & " (visible)", errors )
            if it.pvis then it.visBase = Register( rpt, it.pvis, reset, it.incrLevel )
            for k as long = 0 to it.nRules - 1
                it.rules(k).px = CompileOne( rpt, it.rules(k).when_, where & " (rule " & (k + 1) & ")", errors )
                if it.rules(k).px then it.rules(k).aggBase = Register( rpt, it.rules(k).px, reset, it.incrLevel )
            next
        next
    next
    r.sch.defaultSource = ""
    r.prepErrors = errors
    r.prepared = true
    return len( errors ) = 0
end function

' ---- per row ---------------------------------------------------------------------------------
' After the source's values are read into cur: the calculated fields.
sub RpCalcRow( byval r as TK_REPORT ptr )
    if r->nCalc = 0 then exit sub
    r->ctx.row = @r->cur(0)
    r->ctx.params = iif( r->nPar > 0, @r->pVal(0), cast( TK_VALUE ptr, 0 ) )
    r->ctx.aggs = 0
    for c as long = 0 to r->nCalc - 1
        dim as long f = r->nSrcF + c
        if f > ubound( r->cur ) then exit for
        if r->calcX(c) then tkRExpr_Eval( r->calcX(c), r->ctx, r->cur(f) ) else r->cur(f).Clear( )
    next
end sub

' TRUE when the row in cur passes the filter (or there is none).
function RpPasses( byval r as TK_REPORT ptr ) as boolean
    if r->filterX = 0 then return true
    r->ctx.row = @r->cur(0)
    r->ctx.params = iif( r->nPar > 0, @r->pVal(0), cast( TK_VALUE ptr, 0 ) )
    r->ctx.aggs = 0
    r->ctx.rowNumber = r->nRead + 1
    return tkRExpr_EvalBool( r->filterX, r->ctx )
end function

' The context an expression of queued band q reads: its values, its totals from 'base_' on.
sub RpCtxFor( byval r as TK_REPORT ptr, byref q as RP_QITEM, byval base_ as long )
    r->ctx.row = @q.vals(0)
    r->ctx.aggs = 0
    if (base_ >= 0) andalso (base_ <= ubound( q.xv )) then r->ctx.aggs = @q.xv(base_)
    r->ctx.params = iif( r->nPar > 0, @r->pVal(0), cast( TK_VALUE ptr, 0 ) )
    r->ctx.pageNumber = r->curPage + 1
    r->ctx.rowNumber = q.rowNo
    r->ctx.groupRowNumber = q.grpRowNo
    r->ctx.reportTitle = r->title
end sub

' ---- totals ----------------------------------------------------------------------------------
sub RpXaResetAll( byval r as TK_REPORT ptr )
    for i as long = 0 to r->nXa - 1
        r->xa(i).acc.Reset( )
    next
end sub

' Group totals of levels >= fromLevel restart (their groups just closed).
sub RpXaReset( byval r as TK_REPORT ptr, byval fromLevel as long )
    for i as long = 0 to r->nXa - 1
        if (r->xa(i).reset >= 0) andalso (r->xa(i).reset >= fromLevel) then r->xa(i).acc.Reset( )
    next
end sub

sub RpXaPageReset( byval r as TK_REPORT ptr )
    for i as long = 0 to r->nXa - 1
        if r->xa(i).reset = TKRS_SCOPE_PAGE then r->xa(i).acc.Reset( )
    next
end sub

' The row just read (in cur) into the group and report totals. k: the outermost group level this
' row opened (r->nGroups = none, 0 for the first row).
sub RpXaAddRow( byval r as TK_REPORT ptr, byval k as long )
    if r->nXa = 0 then exit sub
    r->ctx.row = @r->cur(0)
    r->ctx.params = iif( r->nPar > 0, @r->pVal(0), cast( TK_VALUE ptr, 0 ) )
    r->ctx.aggs = 0
    r->ctx.pageNumber = r->curPage + 1
    r->ctx.rowNumber = r->nRead
    r->ctx.groupRowNumber = r->grpRow
    for i as long = 0 to r->nXa - 1
        dim byref as RP_XACC a = r->xa(i)
        if a.reset = TKRS_SCOPE_PAGE then continue for
        if (a.incr >= 0) andalso (k > a.incr) then continue for
        tkRExpr_AccAdd( a.acc, a.x, a.k, r->ctx )
    next
end sub

' A queued band leaving the queue on this page: its row into the page totals (a Detail for every-row
' totals, a group header L for once-per-group-L ones).
sub RpXaPageAdd( byval r as TK_REPORT ptr, byref q as RP_QITEM )
    if r->nXa = 0 then exit sub
    dim as long kind = q.band->kind
    if (kind <> TKRB_DETAIL) andalso (kind <> TKRB_GROUP_HEADER) then exit sub
    RpCtxFor( r, q, -1 )
    for i as long = 0 to r->nXa - 1
        dim byref as RP_XACC a = r->xa(i)
        if a.reset <> TKRS_SCOPE_PAGE then continue for
        if kind = TKRB_DETAIL then
            if a.incr <> -1 then continue for
        elseif a.incr <> q.band->level then
            continue for
        end if
        tkRExpr_AccAdd( a.acc, a.x, a.k, r->ctx )
    next
end sub

sub RpXaSnapshot( byval r as TK_REPORT ptr, xv() as TK_VALUE )
    redim xv( 0 to iif( r->nXa > 0, r->nXa - 1, 0 ) )
    for i as long = 0 to r->nXa - 1
        r->xa(i).acc.Result( xv(i) )
    next
end sub

' ---- late values -----------------------------------------------------------------------------
private sub ResolveLate( byval r as TK_REPORT ptr, byref p as RP_LATE )
    dim as RP_QITEM q
    redim q.vals( 0 to ubound( p.vals ) )
    for f as long = 0 to ubound( p.vals ) : q.vals(f) = p.vals(f) : next
    redim q.xv( 0 to ubound( p.xv ) )
    for i as long = 0 to ubound( p.xv ) : q.xv(i) = p.xv(i) : next
    q.rowNo = p.rowNo : q.grpRowNo = p.grpRowNo
    dim as long keepPage = r->curPage
    r->curPage = p.page
    RpCtxFor( r, q, p.item->aggBase )
    r->curPage = keepPage
    dim as string s = tkRExpr_EvalText( p.item->px, r->ctx, p.item->fmt )
    tkPrintDoc_SetSlot( r->doc, p.slot, s )
    p.need = 0
end sub

private sub DropResolved( byval r as TK_REPORT ptr )
    dim as long o = 0
    for i as long = 0 to r->nLate - 1
        if r->late(i).need <> 0 then
            if o <> i then r->late(o) = r->late(i)
            o += 1
        end if
    next
    r->nLate = o
end sub

' Item it of queued band q is late: a slot in its place, its value when its scope closes.
sub RpLateItem( byval r as TK_REPORT ptr, byval pg as TK_PAGE ptr, byref it as TKREPORT_ITEM, byref q as RP_QITEM, _
                byref rc as TKRECTF, byval flags as long )
    dim as long slot = tkPrintDoc_NewSlot( r->doc )
    tkPage_LateText( pg, rc, "{s:" & slot & "}", flags and (TK_DT_LEFT or TK_DT_CENTER or TK_DT_RIGHT or TK_DT_TOP or TK_DT_BOTTOM) )
    if r->nLate > ubound( r->late ) then redim preserve r->late( 0 to r->nLate * 2 + 7 )
    dim byref as RP_LATE p = r->late(r->nLate)
    p.slot = slot
    p.item = @it
    p.level = q.band->level
    p.page = r->curPage
    p.need = it.late
    redim p.vals( 0 to ubound( q.vals ) )
    for f as long = 0 to ubound( q.vals ) : p.vals(f) = q.vals(f) : next
    redim p.xv( 0 to ubound( q.xv ) )
    for i as long = 0 to ubound( q.xv ) : p.xv(i) = q.xv(i) : next
    p.rowNo = q.rowNo : p.grpRowNo = q.grpRowNo
    r->nLate += 1
    ' a scope that is already over (the report's, with no rows left) is known now
    if r->eof then p.need and= not (RP_LATE_REPORT or RP_LATE_GROUP)
    if p.need = 0 then
        RpXaSnapshot( r, p.xv )
        ResolveLate( r, p )
        DropResolved( r )
    end if
end sub

' A scope closed: the late values waiting for it take the totals as they stand now. what: an
' RP_LATE_* bit; level: for groups, the outermost level that closed; page: for pages.
sub RpLateClose( byval r as TK_REPORT ptr, byval what as long, byval level as long = 0, byval page as long = -1 )
    if r->nLate = 0 then exit sub
    dim as boolean any_
    for i as long = 0 to r->nLate - 1
        dim byref as RP_LATE p = r->late(i)
        if (p.need and what) = 0 then continue for
        if (what = RP_LATE_GROUP) andalso (p.level < level) then continue for
        if (what = RP_LATE_PAGE) andalso (p.page <> page) then continue for
        RpXaSnapshot( r, p.xv )
        p.need and= not what
        if p.need = 0 then
            ResolveLate( r, p )
            any_ = true
        end if
    next
    if any_ then DropResolved( r )
end sub

' The document is complete: PageCount is known, and everything still waiting is filled in.
sub RpLateFinish( byval r as TK_REPORT ptr, byval pageCount as long )
    r->ctx.pageCount = pageCount
    for i as long = 0 to r->nLate - 1
        if r->late(i).need and (RP_LATE_GROUP or RP_LATE_REPORT or RP_LATE_PAGE) then RpXaSnapshot( r, r->late(i).xv )
        ResolveLate( r, r->late(i) )
    next
    r->nLate = 0
end sub
