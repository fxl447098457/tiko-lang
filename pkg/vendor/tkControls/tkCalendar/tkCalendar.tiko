'
' tkCalendar -- PsCalendar on SDL3 + SDL_ttf, a port of pkg/vendor/PsControls/PsCalendar onto
' tkHost. An owner-drawn month calendar that lives INSIDE its parent: one month or a grid of up
' to twelve, a shared nav band, a single selectable day, an optional min/max range, and a
' MonthCal-style drill-down from days to months to years.
'
' WHAT IS UNCHANGED, by design: the date math (Hinnant serials), LayoutCalendar (pure
' arithmetic, so the ideal size is valid before sizing), the selection / anchor / today split,
' the keyboard model (arrows move the SELECTION and fire SelChange; Enter / Space / double-click
' activate; Ctrl+PgUp / PgDn a year; Ctrl+Home today; Esc zooms out ONLY while drilled down),
' the nav step and its chevron-disable rule, the colour precedence, the five callbacks, the
' single-copy selection rule across panels, silent setters with SelectDate / Activate as the two
' notifying actions, and the three render probes.
'
' WHAT IS GONE, because the HWND is gone: WM_GETDLGCODE (a key the control does not claim
' returns FALSE and bubbles, so Esc in DAYS view still reaches a dialog), the WM_CHAR swallow
' (SDL never beeps), the 100 ms hot poll (the host guarantees the leave), CS_DBLCLKS (SDL
' counts clicks), the comctl32 tooltip backend and PsRegistry. See PORT.md.
'
' ADDED from PsPlatform's PsCalendar: tkCalendar_SetToday (a host-supplied today, which also
' makes the control testable on any date) and a ViewChange callback for user navigation.
#module "tkCalendar"

#import "../tkHost" public
#import "../tkTheme" public
#import "../tkTooltip" public
using tkHost
using tkPaint
using tkTheme
using tkTooltip

' ---- defaults: SIZE values are scaled ONCE at create; setters take raw pixels -------------
public const CCAL_PAD = 8
public const CCAL_NAVBANDH = 34
public const CCAL_NAVGAP = 4
public const CCAL_CHEVW = 28
public const CCAL_GUTTERX = 12
public const CCAL_GUTTERY = 10
public const CCAL_CAPTIONH = 24
public const CCAL_WEEKDAYH = 22
public const CCAL_CELLMINW = 34
public const CCAL_CELLMINH = 30

' Never scaled (PORTING.md): the chevron stroke is grown with the scale at paint time instead,
' as vendor's PaintLine did.
public const CCAL_DEFAULT_BORDERTHICK = 0
public const CCAL_DEFAULT_CHEVTHICK = 2
public const CCAL_DEFAULT_FOCUSTHICK = 1

public const CCAL_MY_COLS = 3
public const CCAL_MY_ROWS = 4
public const CCAL_MIN_YEAR = 1
public const CCAL_MAX_YEAR = 9999
public const CCAL_MAX_PANELS = 12

public enum
    CAL_SUNDAY = 0
    CAL_MONDAY = 1
end enum

public enum
    CAL_VIEW_DAYS = 0
    CAL_VIEW_MONTHS
    CAL_VIEW_YEARS
end enum

public enum
    CAL_HIT_NONE = 0
    CAL_HIT_PREV
    CAL_HIT_NEXT
    CAL_HIT_TITLE
    CAL_HIT_DAYCELL
    CAL_HIT_MONTHCELL
    CAL_HIT_YEARCELL
end enum

public enum
    CAL_PART_CLIENT  = 0
    CAL_PART_NAVBAND = 1
    CAL_PART_PREV    = 2
    CAL_PART_NEXT    = 3
    CAL_PART_TITLE   = 4
    CAL_PART_GRID    = 5
end enum
public const CAL_PART_MYCELL_BASE = 100
public const CAL_PART_DAYCELL_BASE = 1000

' SYSTEMTIME's date half, field for field, so a vendor caller ports by renaming the type.
public type TKDATE
    wYear      as long
    wMonth     as long
    wDayOfWeek as long
    wDay       as long
end type

public type CAL_HITRESULT
    part   as long = CAL_HIT_NONE
    panel  as long = -1
    index  as long = -1
end type

' Vendor's dark defaults, value for value (BGR(r,g,b) -> tkRGB(r,g,b)).
public type TKCALENDAR_COLORS
    BackColor              as ulong = &hFF21252Bul
    BorderColor            as ulong = &hFF464C58ul
    FocusRingColor         as ulong = &hFF569CD6ul
    TitleColor             as ulong = &hFFE1E4EAul
    TitleColorHot          as ulong = &hFFFFFFFFul
    CaptionColor           as ulong = &hFFC8CDD5ul
    NavGlyphColor          as ulong = &hFFBEC4CEul
    NavGlyphColorHot       as ulong = &hFFFFFFFFul
    NavGlyphColorDisabled  as ulong = &hFF464A52ul
    WeekdayColor           as ulong = &hFF8C929Cul
    DayColor               as ulong = &hFFD2D6DCul
    DayColorWeekend        as ulong = &hFF96AFCDul
    DayColorAdjacent       as ulong = &hFF7C838Eul     ' still clickable: keep it far from Disabled
    DayColorDisabled       as ulong = &hFF383C44ul     ' out of range, inert
    DayBackColorHot        as ulong = &hFF343A44ul
    DayForeColorHot        as ulong = &hFFFFFFFFul
    DayBackColorSelected   as ulong = &hFF0078D7ul
    DayForeColorSelected   as ulong = &hFFFFFFFFul
    TodayRingColor         as ulong = &hFF569CD6ul
end type

