' The calendar's tkTooltip, or 0 until a day cell has actually wanted a tip (the tip is lazy).
public function tkCalendar_GetTooltipHandle( byval hCtrl as TK_WIDGET ptr ) as TK_TIP ptr
    dim as TKCALENDAR_STATE ptr pCal = GetCalendarPointer( hCtrl )
    if pCal = 0 then return 0
    return tkTipHost_Tip( @pCal->tip )
end function


' ========================================================================================
' Render probes: the full composition rendered into the back buffer at the widget's place,
' read back before any present. nPart is CAL_PART_*, CAL_PART_MYCELL_BASE + k or
' CAL_PART_DAYCELL_BASE + panel*100 + k.
' ========================================================================================
private function CAL_PartRect( byval pCal as TKCALENDAR_STATE ptr, byval nPart as long, byref rc as TKRECT ) as boolean
    if pCal = 0 then return false
    if nPart >= CAL_PART_DAYCELL_BASE then
        dim as long v = nPart - CAL_PART_DAYCELL_BASE
        dim as long p = v \ 100
        dim as long k = v mod 100
        if (p < 0) orelse (p >= pCal->PanelCount()) then return false
        if (k < 0) orelse (k > 41) then return false
        rc = pCal->rcDayCell(p, k)
        return true
    end if
    if nPart >= CAL_PART_MYCELL_BASE then
        dim as long k = nPart - CAL_PART_MYCELL_BASE
        if (k < 0) orelse (k > 11) then return false
        rc = pCal->rcMyCell(k)
        return true
    end if
    select case nPart
    case CAL_PART_CLIENT  : rc = pCal->rcClient  : return true
    case CAL_PART_NAVBAND : rc = pCal->rcNavBand : return true
    case CAL_PART_PREV    : rc = pCal->rcPrev    : return true
    case CAL_PART_NEXT    : rc = pCal->rcNext    : return true
    case CAL_PART_TITLE   : rc = pCal->rcTitle   : return true
    case CAL_PART_GRID    : rc = pCal->rcGrid    : return true
    end select
    return false
end function

private function CAL_ProbeSurface( byval hCtrl as TK_WIDGET ptr, byval nPart as long ) as SDL_Surface ptr
    dim as TKCALENDAR_STATE ptr pCal = CAL_Ready( hCtrl )
    if pCal = 0 then return 0
    dim as TKRECT rcPart
    if CAL_PartRect( pCal, nPart, rcPart ) = false then return 0
    if tkRect_IsEmpty( rcPart ) then return 0
    dim as TK_HOST ptr h = hCtrl->pHost
    dim as TKRECT a
    tkWidget_AbsRect( hCtrl, a )
    dim as TK_PAINT wp
    wp.renderer = h->renderer
    wp.engine = h->engine
    wp.pFont = h->pDefaultFont
    wp.fScale = h->fScale
    wp.Begin( a.left, a.top, hCtrl->cw, hCtrl->ch )
    CAL_RenderFull( pCal, @wp )
    SDL_SetRenderClipRect( h->renderer, 0 )
    dim as SDL_Rect r
    r.x = a.left + rcPart.left : r.y = a.top + rcPart.top
    r.w = rcPart.right - rcPart.left : r.h = rcPart.bottom - rcPart.top
    dim as SDL_Surface ptr s0 = SDL_RenderReadPixels( h->renderer, @r )
    h->bDirty = true                 ' the probe drew into the back buffer; repaint honestly
    if s0 = 0 then return 0
    dim as SDL_Surface ptr s = SDL_ConvertSurface( s0, SDL_PIXELFORMAT_ARGB8888 )
    SDL_DestroySurface( s0 )
    return s
end function

' Distinct colours in a part, capped at 256. A flooded part reports 1 or 2.
public function tkCalendar_TestPartTones( byval hCtrl as TK_WIDGET ptr, byval nPart as long ) as long
    dim as SDL_Surface ptr s = CAL_ProbeSurface( hCtrl, nPart )
    if s = 0 then return 0
    dim seen(0 to 255) as ulong
    dim as long nSeen = 0
    for y as long = 0 to s->h - 1
        dim as ulong ptr row = cast( ulong ptr, cast( ubyte ptr, s->pixels ) + y * s->pitch )
        for x as long = 0 to s->w - 1
            dim as ulong c = row[x] and &h00FFFFFFul
            dim as boolean bNew = true
            for i as long = 0 to nSeen - 1
                if seen(i) = c then bNew = false : exit for
            next
            if bNew andalso (nSeen < 256) then seen(nSeen) = c : nSeen += 1
        next
    next
    SDL_DestroySurface( s )
    return nSeen
end function

' Brightest pixel, 0..255 (mean of R, G, B). Compare two parts as a RATIO.
public function tkCalendar_TestPartBrightness( byval hCtrl as TK_WIDGET ptr, byval nPart as long ) as long
    dim as SDL_Surface ptr s = CAL_ProbeSurface( hCtrl, nPart )
    if s = 0 then return 0
    dim as long nMax = 0
    for y as long = 0 to s->h - 1
        dim as ulong ptr row = cast( ulong ptr, cast( ubyte ptr, s->pixels ) + y * s->pitch )
        for x as long = 0 to s->w - 1
            dim as ulong c = row[x]
            dim as long lum = (cast( long, c and &hFF ) + cast( long, (c shr 8) and &hFF ) + cast( long, (c shr 16) and &hFF )) \ 3
            if lum > nMax then nMax = lum
        next
    next
    SDL_DestroySurface( s )
    return nMax
end function

' FNV-1a over a part's RGB. A changed hash proves only that SOMETHING moved: pair it with tones.
public function tkCalendar_TestHashPart( byval hCtrl as TK_WIDGET ptr, byval nPart as long ) as ulongint
    dim as SDL_Surface ptr s = CAL_ProbeSurface( hCtrl, nPart )
    if s = 0 then return 0
    dim as ulongint hv = 14695981039346656037ull
    for y as long = 0 to s->h - 1
        dim as ulong ptr row = cast( ulong ptr, cast( ubyte ptr, s->pixels ) + y * s->pitch )
        for x as long = 0 to s->w - 1
            dim as ulong c = row[x]
            for byteIdx as long = 0 to 2
                hv = hv xor ((c shr (byteIdx * 8)) and &hFF)
                hv = hv * 1099511628211ull
            next
        next
    next
    SDL_DestroySurface( s )
    return hv
end function
