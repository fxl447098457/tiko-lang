    dim as TKCALENDAR_STATE ptr pCal = GetCalendarPointer( hCtrl )
    if pCal = 0 then exit sub
    if nThickness < 0 then nThickness = 0
    if nThickness = pCal->nBorderThick then exit sub
    pCal->nBorderThick = nThickness
    CAL_Relayout( pCal )
end sub

public function tkCalendar_GetChevronThickness( byval hCtrl as TK_WIDGET ptr ) as long
    dim as TKCALENDAR_STATE ptr pCal = GetCalendarPointer( hCtrl )
    if pCal = 0 then return 0
    return pCal->nChevThick
end function

public sub tkCalendar_SetChevronThickness( byval hCtrl as TK_WIDGET ptr, byval nThickness as long )
    dim as TKCALENDAR_STATE ptr pCal = GetCalendarPointer( hCtrl )
    if pCal = 0 then exit sub
    if nThickness < 1 then nThickness = 1
    pCal->nChevThick = nThickness
    tkWidget_Invalidate( hCtrl )
end sub

public function tkCalendar_GetPadding( byval hCtrl as TK_WIDGET ptr ) as long
    dim as TKCALENDAR_STATE ptr pCal = GetCalendarPointer( hCtrl )
    if pCal = 0 then return 0
    return pCal->nPad
end function

public sub tkCalendar_SetPadding( byval hCtrl as TK_WIDGET ptr, byval nPad as long )
    dim as TKCALENDAR_STATE ptr pCal = GetCalendarPointer( hCtrl )
    if pCal = 0 then exit sub
    if nPad < 0 then nPad = 0
    pCal->nPad = nPad
    CAL_Relayout( pCal )
end sub

public sub tkCalendar_GetGutters( byval hCtrl as TK_WIDGET ptr, byref nGutterX as long, byref nGutterY as long )
    dim as TKCALENDAR_STATE ptr pCal = GetCalendarPointer( hCtrl )
    nGutterX = 0 : nGutterY = 0
    if pCal = 0 then exit sub
    nGutterX = pCal->nGutterX : nGutterY = pCal->nGutterY
end sub

public sub tkCalendar_SetGutters( byval hCtrl as TK_WIDGET ptr, byval nGutterX as long, byval nGutterY as long )
    dim as TKCALENDAR_STATE ptr pCal = GetCalendarPointer( hCtrl )
    if pCal = 0 then exit sub
    if nGutterX < 0 then nGutterX = 0
    if nGutterY < 0 then nGutterY = 0
    pCal->nGutterX = nGutterX
    pCal->nGutterY = nGutterY
    CAL_Relayout( pCal )
end sub

public sub tkCalendar_GetCellMinSize( byval hCtrl as TK_WIDGET ptr, byref nW as long, byref nH as long )
    dim as TKCALENDAR_STATE ptr pCal = GetCalendarPointer( hCtrl )
    nW = 0 : nH = 0
    if pCal = 0 then exit sub
    nW = pCal->nCellMinW : nH = pCal->nCellMinH
end sub

' Feeds GetIdealSize ONLY: cells stretch to the control's actual size.
public sub tkCalendar_SetCellMinSize( byval hCtrl as TK_WIDGET ptr, byval nW as long, byval nH as long )
    dim as TKCALENDAR_STATE ptr pCal = GetCalendarPointer( hCtrl )
    if pCal = 0 then exit sub
    if nW < 1 then nW = 1
    if nH < 1 then nH = 1
    pCal->nCellMinW = nW
    pCal->nCellMinH = nH
    CAL_Relayout( pCal )
end sub

' Pure arithmetic, valid before the control is ever sized.
public sub tkCalendar_GetIdealSize( byval hCtrl as TK_WIDGET ptr, byref nWidth as long, byref nHeight as long )
    dim as TKCALENDAR_STATE ptr pCal = GetCalendarPointer( hCtrl )
    nWidth = 0 : nHeight = 0
    if pCal = 0 then exit sub
    pCal->LayoutCalendar()
    nWidth = pCal->nIdealW
    nHeight = pCal->nIdealH
end sub

public function tkCalendar_GetEnabled( byval hCtrl as TK_WIDGET ptr ) as boolean
    dim as TKCALENDAR_STATE ptr pCal = GetCalendarPointer( hCtrl )
    if pCal = 0 then return false
    return pCal->isEnabled
end function

' Through tkWidget_Enable, so the host enforces it (no input, skipped by Tab).
public sub tkCalendar_SetEnabled( byval hCtrl as TK_WIDGET ptr, byval isEnabled as boolean )
    if hCtrl then tkWidget_Enable( hCtrl, isEnabled )
end sub

public function tkCalendar_HasFocus( byval hCtrl as TK_WIDGET ptr ) as boolean
    dim as TKCALENDAR_STATE ptr pCal = GetCalendarPointer( hCtrl )
    if pCal = 0 then return false
    return pCal->isFocused
end function

' Re-reads today from the system clock and repaints.
public sub tkCalendar_Refresh( byval hCtrl as TK_WIDGET ptr )
    dim as TKCALENDAR_STATE ptr pCal = GetCalendarPointer( hCtrl )
    if pCal = 0 then exit sub
    pCal->stToday = tkCalendar_LocalToday()
    CAL_Relayout( pCal )
end sub

' --- geometry: each forces a pending layout; FALSE for a bad handle or index -----------------
private function CAL_Ready( byval hCtrl as TK_WIDGET ptr ) as TKCALENDAR_STATE ptr
    dim as TKCALENDAR_STATE ptr pCal = GetCalendarPointer( hCtrl )
    if pCal = 0 then return 0
    if pCal->bLayoutDirty then pCal->LayoutCalendar()
    return pCal
end function

public function tkCalendar_HitTest( byval hCtrl as TK_WIDGET ptr, byval pt as TKPOINT ) as CAL_HITRESULT
    dim as CAL_HITRESULT hr
    dim as TKCALENDAR_STATE ptr pCal = CAL_Ready( hCtrl )
    if pCal = 0 then return hr
    return CAL_HitTestPt( pCal, pt.x, pt.y )
end function

public function tkCalendar_GetInnerRect( byval hCtrl as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    dim as TKCALENDAR_STATE ptr pCal = CAL_Ready( hCtrl )
    if pCal = 0 then return false
    rc = pCal->rcInner : return true
end function

public function tkCalendar_GetNavBandRect( byval hCtrl as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    dim as TKCALENDAR_STATE ptr pCal = CAL_Ready( hCtrl )
    if pCal = 0 then return false
    rc = pCal->rcNavBand : return true
end function

public function tkCalendar_GetPrevRect( byval hCtrl as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    dim as TKCALENDAR_STATE ptr pCal = CAL_Ready( hCtrl )
    if pCal = 0 then return false
    rc = pCal->rcPrev : return true
end function

public function tkCalendar_GetNextRect( byval hCtrl as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    dim as TKCALENDAR_STATE ptr pCal = CAL_Ready( hCtrl )
    if pCal = 0 then return false
    rc = pCal->rcNext : return true
end function

public function tkCalendar_GetTitleRect( byval hCtrl as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    dim as TKCALENDAR_STATE ptr pCal = CAL_Ready( hCtrl )
    if pCal = 0 then return false
    rc = pCal->rcTitle : return true
end function

public function tkCalendar_GetGridRect( byval hCtrl as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    dim as TKCALENDAR_STATE ptr pCal = CAL_Ready( hCtrl )
    if pCal = 0 then return false
    rc = pCal->rcGrid : return true
end function

public function tkCalendar_GetPanelRect( byval hCtrl as TK_WIDGET ptr, byval panel as long, byref rc as TKRECT ) as boolean
    dim as TKCALENDAR_STATE ptr pCal = CAL_Ready( hCtrl )
    if pCal = 0 then return false
    if (panel < 0) orelse (panel >= pCal->PanelCount()) then return false
    rc = pCal->rcPanel(panel) : return true
end function

public function tkCalendar_GetCaptionRect( byval hCtrl as TK_WIDGET ptr, byval panel as long, byref rc as TKRECT ) as boolean
    dim as TKCALENDAR_STATE ptr pCal = CAL_Ready( hCtrl )
    if pCal = 0 then return false
    if (panel < 0) orelse (panel >= pCal->PanelCount()) then return false
    rc = pCal->rcCaption(panel) : return true
end function

public function tkCalendar_GetWeekdayRect( byval hCtrl as TK_WIDGET ptr, byval panel as long, byval i as long, byref rc as TKRECT ) as boolean
    dim as TKCALENDAR_STATE ptr pCal = CAL_Ready( hCtrl )
    if pCal = 0 then return false
    if (panel < 0) orelse (panel >= pCal->PanelCount()) then return false
    if (i < 0) orelse (i > 6) then return false
    rc = pCal->rcWeekday(panel, i) : return true
end function

public function tkCalendar_GetDayCellRect( byval hCtrl as TK_WIDGET ptr, byval panel as long, byval k as long, byref rc as TKRECT ) as boolean
    dim as TKCALENDAR_STATE ptr pCal = CAL_Ready( hCtrl )
    if pCal = 0 then return false
    if (panel < 0) orelse (panel >= pCal->PanelCount()) then return false
    if (k < 0) orelse (k > 41) then return false
    rc = pCal->rcDayCell(panel, k) : return true
end function

public function tkCalendar_GetMyCellRect( byval hCtrl as TK_WIDGET ptr, byval k as long, byref rc as TKRECT ) as boolean
    dim as TKCALENDAR_STATE ptr pCal = CAL_Ready( hCtrl )
    if pCal = 0 then return false
    if (k < 0) orelse (k > 11) then return false
    rc = pCal->rcMyCell(k) : return true
end function

public function tkCalendar_GetCellDate( byval hCtrl as TK_WIDGET ptr, byval panel as long, byval k as long, byref st as TKDATE ) as boolean
    dim as TKCALENDAR_STATE ptr pCal = CAL_Ready( hCtrl )
    if pCal = 0 then return false
    if (panel < 0) orelse (panel >= pCal->PanelCount()) then return false
    if (k < 0) orelse (k > 41) then return false
    st = pCal->CellDate( panel, k )
    return true
end function

public function tkCalendar_GetPanelMonth( byval hCtrl as TK_WIDGET ptr, byval panel as long, byref nYear as long, byref nMonth as long ) as boolean
    dim as TKCALENDAR_STATE ptr pCal = CAL_Ready( hCtrl )
    nYear = 0 : nMonth = 0
    if pCal = 0 then return false
    if (panel < 0) orelse (panel >= pCal->PanelCount()) then return false
    nYear = pCal->panelYear(panel)
    nMonth = pCal->panelMonth(panel)
    return true
end function

public function tkCalendar_GetFocusCell( byval hCtrl as TK_WIDGET ptr, byref panel as long, byref index as long ) as boolean
    dim as TKCALENDAR_STATE ptr pCal = CAL_Ready( hCtrl )
    panel = -1 : index = -1
    if pCal = 0 then return false
    return CAL_FocusCell( pCal, panel, index )
end function

' The drill-down cursor (0..11), for a host or a test; meaningless in DAYS view.
public function tkCalendar_GetMyFocus( byval hCtrl as TK_WIDGET ptr ) as long
    dim as TKCALENDAR_STATE ptr pCal = GetCalendarPointer( hCtrl )
    if pCal = 0 then return -1
    return pCal->nMyFocus
end function

' The hot part under the cursor, as the renderer sees it.
public function tkCalendar_GetHot( byval hCtrl as TK_WIDGET ptr ) as CAL_HITRESULT
    dim as CAL_HITRESULT hr
    dim as TKCALENDAR_STATE ptr pCal = GetCalendarPointer( hCtrl )
    if pCal = 0 then return hr
    hr.part = pCal->hotPart : hr.panel = pCal->hotPanel : hr.index = pCal->hotIndex
    return hr
end function

' --- colours and theme ----------------------------------------------------------------------
public sub tkCalendar_GetColors( byval hCtrl as TK_WIDGET ptr, byval pColors as TKCALENDAR_COLORS ptr )
    dim as TKCALENDAR_STATE ptr pCal = GetCalendarPointer( hCtrl )
    if (pCal = 0) orelse (pColors = 0) then exit sub
    *pColors = pCal->colors
end sub

' Copies and PINS: a theme change leaves this calendar alone until UnpinColors.
public sub tkCalendar_SetColors( byval hCtrl as TK_WIDGET ptr, byval pColors as TKCALENDAR_COLORS ptr )
    dim as TKCALENDAR_STATE ptr pCal = GetCalendarPointer( hCtrl )
    if (pCal = 0) orelse (pColors = 0) then exit sub
    pCal->colors = *pColors
    pCal->bColorsPinned = true
    tkWidget_Invalidate( hCtrl )
end sub

' Vendor PsCalendar_ThemeColors, role for role.
public function tkCalendar_ThemeColors( byref t as TKTHEME_COLORS ) as TKCALENDAR_COLORS
    dim as TKCALENDAR_COLORS c
    c.BackColor = t.Window
    c.BorderColor = t.Border
    c.FocusRingColor = t.FocusRing
    c.TitleColor = t.TextHot
    c.TitleColorHot = t.TextStrong
    c.CaptionColor = t.Text
    c.NavGlyphColor = t.Text
    c.NavGlyphColorHot = t.TextHot
    c.NavGlyphColorDisabled = t.TextDisabled
    c.WeekdayColor = t.TextDim
    c.DayColor = t.Text
    c.DayColorWeekend = t.AccentHot
    c.DayColorAdjacent = t.TextDim
    c.DayColorDisabled = t.TextDisabled
    c.DayBackColorHot = t.SurfaceHot
    c.DayForeColorHot = t.TextHot
    c.DayBackColorSelected = t.Selected
    c.DayForeColorSelected = t.SelectedText
    c.TodayRingColor = t.Accent
    return c
end function

public sub tkCalendar_ApplyTheme( byval hCtrl as TK_WIDGET ptr, byref t as TKTHEME_COLORS )
    dim as TKCALENDAR_STATE ptr pCal = GetCalendarPointer( hCtrl )
    if (pCal = 0) orelse pCal->bColorsPinned then exit sub
    dim as TKTHEME_COLORS tr = tkTheme_Styled( hCtrl, t )
    pCal->colors = tkCalendar_ThemeColors( tr )
    tkTheme_ResolveInto( hCtrl, tr, cast( ulong ptr, @pCal->colors ), sizeof( TKCALENDAR_COLORS ) \ 4, "Calendar" )
    tkWidget_Invalidate( hCtrl )
end sub

public sub tkCalendar_UnpinColors( byval hCtrl as TK_WIDGET ptr )
    dim as TKCALENDAR_STATE ptr pCal = GetCalendarPointer( hCtrl )
    if pCal = 0 then exit sub
    pCal->bColorsPinned = false
    tkCalendar_ApplyTheme( hCtrl, tkTheme_Of( hCtrl ) )
end sub

