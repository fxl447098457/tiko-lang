    dim as TKTIMEPICKER_STATE ptr p = TPK( hCtrl )
    if p then p->DropDownCallback = usersub
end sub

public sub tkTimePicker_SetPaintCallback( byval hCtrl as TK_WIDGET ptr, byval usersub as TPK_PaintCallbackSub )
    dim as TKTIMEPICKER_STATE ptr p = TPK( hCtrl )
    if p = 0 then exit sub
    p->PaintCallback = usersub
    tkWidget_Invalidate( hCtrl )
end sub

' Forwarded to the dropdown's panel (hCtrl is the PICKER): disables chooser items.
public sub tkTimePicker_SetItemDisabledCallback( byval hCtrl as TK_WIDGET ptr, byval userfunc as TPK_ItemDisabledCallbackFunc )
    dim as TKTIMEPICKER_STATE ptr p = TPK( hCtrl )
    if p then p->ItemDisabledCallback = userfunc
end sub

public sub tkTimePicker_SetMessageCallback( byval hCtrl as TK_WIDGET ptr, byval userfunc as TPK_MessageCallbackFunc )
    dim as TKTIMEPICKER_STATE ptr p = TPK( hCtrl )
    if p then p->MessageCallback = userfunc
end sub

' FormatTime: the text shown at rest (unfocused, a time, nothing being typed), GetText, and the
' dropdown's list labels. Focus brings the segments back: editing works on the pattern.
public sub tkTimePicker_SetFormatCallback( byval hCtrl as TK_WIDGET ptr, byval usersub as TPK_FormatCallbackSub )
    dim as TKTIMEPICKER_STATE ptr p = TPK( hCtrl )
    if p = 0 then exit sub
    p->FormatCallback = usersub
    TpkRefresh( p )
end sub

' The tip over the picker: TRUE with outText shows it. The tip is made when this is first set.
public sub tkTimePicker_SetTooltipCallback( byval hCtrl as TK_WIDGET ptr, byval userfunc as TPK_TooltipCallbackFunc )
    dim as TKTIMEPICKER_STATE ptr p = TPK( hCtrl )
    if p = 0 then exit sub
    p->TooltipCallback = userfunc
    if userfunc then tkTipHost_Ensure( @p->tip, hCtrl, @TpkTipText )
end sub

' The tip (0 until a Tooltip callback is set): its delays, or tkTooltip_Show in a test.
public function tkTimePicker_GetTooltipHandle( byval hCtrl as TK_WIDGET ptr ) as TK_TIP ptr
    dim as TKTIMEPICKER_STATE ptr p = TPK( hCtrl )
    if p = 0 then return 0
    return tkTipHost_Tip( @p->tip )
end function

' The segment under (x, y), -1 for a literal, the button cell or outside.
function TpkSegUnder( byval p as TKTIMEPICKER_STATE ptr, byval x as long, byval y as long ) as long
    if TpkHit( p, x, y ) <> TKTPK_HIT_FIELD then return -1
    for i as long = 0 to p->nSegs - 1
        if TpkIsEditable( p, i ) andalso (x >= p->segX( i )) andalso (x < p->segX( i ) + p->segW( i )) then return i
    next
    return -1
end function

' One tool per part and segment, so moving between segments brings a fresh tip.
function TpkTipIndex( byval p as TKTIMEPICKER_STATE ptr ) as long
    return TpkHit( p, p->nMouseX, p->nMouseY ) * 100 + TpkSegUnder( p, p->nMouseX, p->nMouseY ) + 1
end function

function TpkTipText( byval t as TK_TIP ptr, byval a as TK_WIDGET ptr, byval idx as long ) as ustring
    dim as TKTIMEPICKER_STATE ptr p = TPK( a )
    if (p = 0) orelse (p->TooltipCallback = 0) then return ""
    dim as TKTIMEPICKER_TOOLTIPINFO ti
    ti.hCtrl = p->hWin
    ti.tm = p->tm
    ti.hasTime = tkTimePanel_IsTime( p->tm )
    ti.nPart = TpkHit( p, p->nMouseX, p->nMouseY )
    ti.nSegment = TpkSegUnder( p, p->nMouseX, p->nMouseY )
    if p->TooltipCallback( @ti ) = false then return ""
    return ti.outText
end function

' The theme's shape until a shape setter ran: its CornerRadius and BorderWidth.
sub TpkApplyThemeShape( byval w as TK_WIDGET ptr )
    dim as TKTIMEPICKER_STATE ptr p = TPK( w )
    if (p = 0) orelse p->bShapePinned then exit sub
    dim as TKTHEME_SHAPE sh = tkTheme_ShapeOf( w )
    p->nCornerRadius = iif( sh.CornerRadius >= 0, tkHost_Scale( w->pHost, sh.CornerRadius ), tkHost_Scale( w->pHost, CTP_DEFAULT_CORNERRADIUS ) )
    p->nBorderThick = iif( sh.BorderWidth >= 0, sh.BorderWidth, CTP_DEFAULT_BORDERTHICK )
    TpkRefresh( p )
end sub
