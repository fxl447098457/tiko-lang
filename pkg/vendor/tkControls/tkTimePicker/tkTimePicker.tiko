    if p = 0 then return TKTPK_HIT_NONE
    return p->nHotPart
end function

public sub tkTimePicker_GetRepeat( byval hCtrl as TK_WIDGET ptr, byref nDelayMs as long, byref nIntervalMs as long )
    dim as TKTIMEPICKER_STATE ptr p = TPK( hCtrl )
    if p = 0 then exit sub
    nDelayMs = p->nRepeatDelay : nIntervalMs = p->nRepeatInterval
end sub

' The spin pair's auto-repeat; 0 for either turns it off.
public sub tkTimePicker_SetRepeat( byval hCtrl as TK_WIDGET ptr, byval nDelayMs as long, byval nIntervalMs as long )
    dim as TKTIMEPICKER_STATE ptr p = TPK( hCtrl )
    if p = 0 then exit sub
    p->nRepeatDelay = iif( nDelayMs < 0, 0, nDelayMs )
    p->nRepeatInterval = iif( nIntervalMs < 0, 0, nIntervalMs )
end sub

public sub tkTimePicker_GetColors( byval hCtrl as TK_WIDGET ptr, byval pColors as TKTIMEPICKER_COLORS ptr )
    dim as TKTIMEPICKER_STATE ptr p = TPK( hCtrl )
    if (p = 0) orelse (pColors = 0) then exit sub
    *pColors = p->colors
end sub

' Copies the struct and PINS it: a theme change leaves this picker alone until UnpinColors.
public sub tkTimePicker_SetColors( byval hCtrl as TK_WIDGET ptr, byval pColors as TKTIMEPICKER_COLORS ptr )
    dim as TKTIMEPICKER_STATE ptr p = TPK( hCtrl )
    if (p = 0) orelse (pColors = 0) then exit sub
    p->colors = *pColors
    p->bColorsPinned = true
    tkWidget_Invalidate( hCtrl )
end sub

' The frame block maps exactly as tkDatePicker_ThemeColors; the dropdown as its calendar.
public function tkTimePicker_ThemeColors( byref t as TKTHEME_COLORS ) as TKTIMEPICKER_COLORS
    dim as TKTIMEPICKER_COLORS c
    c.BackColor               = t.Window
    c.BorderColor             = t.Border
    c.FocusBorderColor        = t.FocusRing
    c.BorderColorDisabled     = t.BorderDisabled
    c.DividerColor            = t.Divider
    c.DividerColorDisabled    = t.BorderDisabled
    c.FieldBackColor          = t.Surface
    c.FieldForeColor          = t.Text
    c.FieldBackColorDisabled  = t.SurfaceDisabled
    c.FieldForeColorDisabled  = t.TextDisabled
    c.IconColor               = t.Surface
    c.IconGlyphColor          = t.Text
    c.IconGlyphColorHot       = t.TextHot
    c.IconBackColorHot        = t.SurfaceHot
    c.IconGlyphColorDisabled  = t.TextDisabled
    c.SegmentBackColorFocused = t.Selected
    c.SegmentForeColorFocused = t.SelectedText
    c.PlaceholderColor        = t.TextDim
    c.PanelBackColor          = t.Popup
    c.PanelBorderColor        = t.Border
    c.ItemColor               = t.PopupText
    c.ItemColorDisabled       = t.TextDisabled
    c.ItemBackColorHot        = t.SurfaceHot
    c.ItemForeColorHot        = t.TextHot
    c.ItemBackColorSelected   = t.Selected
    c.ItemForeColorSelected   = t.SelectedText
    c.ColumnDividerColor      = t.Divider
    c.FooterColor             = t.TextDim
    c.FooterColorHot          = t.TextHot
    c.FooterColorDisabled     = t.TextDisabled
    return c
end function

public sub tkTimePicker_ApplyTheme( byval hCtrl as TK_WIDGET ptr, byref t as TKTHEME_COLORS )
    dim as TKTIMEPICKER_STATE ptr p = TPK( hCtrl )
    if p = 0 then exit sub
    TpkApplyThemeShape( hCtrl )
    if p->bColorsPinned then exit sub
    dim as TKTHEME_COLORS tr = tkTheme_Styled( hCtrl, t )
    p->colors = tkTimePicker_ThemeColors( tr )
    tkTheme_ResolveInto( hCtrl, tr, cast( ulong ptr, @p->colors ), sizeof( TKTIMEPICKER_COLORS ) \ 4, "TimePicker" )
    tkWidget_Invalidate( hCtrl )
end sub

public sub tkTimePicker_UnpinColors( byval hCtrl as TK_WIDGET ptr )
    dim as TKTIMEPICKER_STATE ptr p = TPK( hCtrl )
    if p = 0 then exit sub
    p->bColorsPinned = false
    tkTimePicker_ApplyTheme( hCtrl, tkTheme_Of( hCtrl ) )
end sub

public sub tkTimePicker_ApplyFonts( byval hCtrl as TK_WIDGET ptr, byval fText as TTF_Font ptr, byval fGlyph as TTF_Font ptr )
    if fText then tkTimePicker_SetFont( hCtrl, fText )
    if fGlyph then tkTimePicker_SetIconFont( hCtrl, fGlyph )
end sub

' ---- callbacks -------------------------------------------------------------------------------------
' A paint callback's way to draw the picker as it would have been drawn, then add to it.
public sub tkTimePicker_PaintDefault( byval pi as TKTIMEPICKER_PAINTINFO ptr )
    if pi = 0 then exit sub
    dim as TKTIMEPICKER_STATE ptr p = TPK( pi->hCtrl )
    if p then TpkRenderDefault( p, pi )
end sub

