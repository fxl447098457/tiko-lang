' tkDatePicker's formula, measured on the widest time the pattern can show. Valid before sizing.
public sub tkTimePicker_GetIdealSize( byval hCtrl as TK_WIDGET ptr, byref nWidth as long, byref nHeight as long )
    dim as TKTIMEPICKER_STATE ptr p = TPK( hCtrl )
    nWidth = 0 : nHeight = 0
    if p = 0 then exit sub
    dim as TTF_Font ptr f = TpkFont( p )
    dim as long textW = 0
    for k as long = 0 to 1
        dim as TKTIME t = tkTimePanel_MakeTime( 10 + k * 12, 58, 58, 888 )
        dim as long tw = tkText_Width( f, TpkFormatOf( p, t ) )
        if tw > textW then textW = tw
        tw = tkText_Width( f, tkTimePanel_FormatPattern( t, p->sPattern, p->sAm, p->sPm ) )
        if tw > textW then textW = tw
    next
    if len( p->sPlaceholder ) then
        dim as long pw = tkText_Width( f, p->sPlaceholder )
        if pw > textW then textW = pw
    end if
    dim as long cell = 0
    if p->nButtonStyle <> TKTP_BUTTON_NONE then cell = p->nDividerThick + p->nIconWidth
    nWidth = p->nCornerRadius + p->nFieldPad + textW + p->nFieldPad + cell
    if p->nButtonStyle = TKTP_BUTTON_NONE then nWidth += p->nBorderThick
    nHeight = tkText_Height( f ) + 2 * p->nVertPadding + 2 * p->nBorderThick
end sub

public function tkTimePicker_GetFrameRect( byval hCtrl as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    dim as TKTIMEPICKER_STATE ptr p = TPK( hCtrl )
    tkRect_Set( rc, 0, 0, 0, 0 )
    if p = 0 then return false
    TpkEnsureLayout( p )
    rc = p->rcFrame
    return (rc.right > rc.left) andalso (rc.bottom > rc.top)
end function

public function tkTimePicker_GetFieldRect( byval hCtrl as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    dim as TKTIMEPICKER_STATE ptr p = TPK( hCtrl )
    tkRect_Set( rc, 0, 0, 0, 0 )
    if p = 0 then return false
    TpkEnsureLayout( p )
    rc = p->rcField
    return (rc.right > rc.left) andalso (rc.bottom > rc.top)
end function

' The button cell (dropdown or spin pair); FALSE with TKTP_BUTTON_NONE.
public function tkTimePicker_GetIconRect( byval hCtrl as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    dim as TKTIMEPICKER_STATE ptr p = TPK( hCtrl )
    tkRect_Set( rc, 0, 0, 0, 0 )
    if p = 0 then return false
    TpkEnsureLayout( p )
    rc = p->rcIcon
    return (rc.right > rc.left) andalso (rc.bottom > rc.top)
end function

' One spin half (bUp: the upper); FALSE unless TKTP_BUTTON_SPIN.
public function tkTimePicker_GetSpinRect( byval hCtrl as TK_WIDGET ptr, byval bUp as boolean, byref rc as TKRECT ) as boolean
    dim as TKTIMEPICKER_STATE ptr p = TPK( hCtrl )
    tkRect_Set( rc, 0, 0, 0, 0 )
    if p = 0 then return false
    TpkEnsureLayout( p )
    if bUp then rc = p->rcUp else rc = p->rcDown
    return (rc.right > rc.left) andalso (rc.bottom > rc.top)
end function

public function tkTimePicker_HitTest( byval hCtrl as TK_WIDGET ptr, byval x as long, byval y as long ) as long
    dim as TKTIMEPICKER_STATE ptr p = TPK( hCtrl )
    if p = 0 then return TKTPK_HIT_NONE
    return TpkHit( p, x, y )
end function

