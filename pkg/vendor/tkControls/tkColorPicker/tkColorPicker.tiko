' ========================================================================================
' Pure colour functions (vendor's, in tkRGB's &hAARRGGBB with alpha forced opaque)
' ========================================================================================
private function CLR_HueChannel( byval p as double, byval q as double, byval t as double ) as double
    if t < 0.0 then t += 1.0
    if t > 1.0 then t -= 1.0
    if t < (1.0 / 6.0) then return p + (q - p) * 6.0 * t
    if t < (1.0 / 2.0) then return q
    if t < (2.0 / 3.0) then return p + (q - p) * ((2.0 / 3.0) - t) * 6.0
    return p
end function

' h, s, lum all 0..1 and CLAMPED (a hue of 1.4 does not wrap). Double precision and int(x+0.5)
' rounding, vendor's pair of fixes for the pure primaries.
public function tkColorPicker_HSLtoRGB( byval h as double, byval s as double, byval lum as double ) as ulong
    if h < 0.0 then h = 0.0
    if h > 1.0 then h = 1.0
    if s < 0.0 then s = 0.0
    if s > 1.0 then s = 1.0
    if lum < 0.0 then lum = 0.0
    if lum > 1.0 then lum = 1.0
    dim as double fRed, fGrn, fBlu
    if s = 0.0 then
        fRed = lum : fGrn = lum : fBlu = lum
    else
        dim as double q
        if lum < 0.5 then q = lum * (1.0 + s) else q = lum + s - (lum * s)
        dim as double p = (2.0 * lum) - q
        fRed = CLR_HueChannel( p, q, h + (1.0 / 3.0) )
        fGrn = CLR_HueChannel( p, q, h )
        fBlu = CLR_HueChannel( p, q, h - (1.0 / 3.0) )
    end if
    dim as long nR = clng( int( (fRed * 255.0) + 0.5 ) )
    dim as long nG = clng( int( (fGrn * 255.0) + 0.5 ) )
    dim as long nB = clng( int( (fBlu * 255.0) + 0.5 ) )
    if nR < 0 then nR = 0
    if nR > 255 then nR = 255
    if nG < 0 then nG = 0
    if nG > 255 then nG = 255
    if nB < 0 then nB = 0
    if nB > 255 then nB = 255
    return tkRGB( nR, nG, nB )
end function

' Column = hue, row = lightness, LAST column = greyscale: l = 1 - (row + 0.5) / rows.
public function tkColorPicker_MatrixColorAt( byval nCol as long, byval nRow as long, byval nCols as long, byval nRows as long ) as ulong
    if nCols < 2 then nCols = 2
    if nRows < 1 then nRows = 1
    if nCol < 0 then nCol = 0
    if nCol > (nCols - 1) then nCol = nCols - 1
    if nRow < 0 then nRow = 0
    if nRow > (nRows - 1) then nRow = nRows - 1
    dim as double lum = 1.0 - ((cdbl( nRow ) + 0.5) / cdbl( nRows ))
    if nCol = (nCols - 1) then return tkColorPicker_HSLtoRGB( 0.0, 0.0, lum )
    return tkColorPicker_HSLtoRGB( cdbl( nCol ) / cdbl( nCols - 1 ), 1.0, lum )
end function

' The cell index (row * cols + col) holding clr, or -1.
public function tkColorPicker_MatrixIndexOf( byval clr as ulong, byval nCols as long, byval nRows as long ) as long
    clr or= &hFF000000ul
    for rr as long = 0 to nRows - 1
        for cc as long = 0 to nCols - 1
            if tkColorPicker_MatrixColorAt( cc, rr, nCols, nRows ) = clr then return rr * nCols + cc
        next
    next
    return -1
end function

' Half-open containment, the convention the cell arithmetic uses.
public function tkColorPicker_PtIn( byref rc as TKRECT, byval x as long, byval y as long ) as boolean
    return ((x >= rc.left) andalso (x < rc.right) andalso (y >= rc.top) andalso (y < rc.bottom))
end function

public function tkColorPicker_CellFromPoint( byref rc as TKRECT, byval nCellW as long, byval nCellH as long, _
                                             byval nCols as long, byval nRows as long, byval x as long, byval y as long, _
                                             byref nCol as long, byref nRow as long ) as boolean
    nCol = -1 : nRow = -1
    if (nCellW <= 0) orelse (nCellH <= 0) then return false
    if (nCols <= 0) orelse (nRows <= 0) then return false
    if (x < rc.left) orelse (y < rc.top) then return false
    dim as long cc = (x - rc.left) \ nCellW
    dim as long rr = (y - rc.top) \ nCellH
    if (cc < 0) orelse (cc > (nCols - 1)) then return false
    if (rr < 0) orelse (rr > (nRows - 1)) then return false
    nCol = cc : nRow = rr
    return true
end function

' #RRGGBB, upper case.
public function tkColorPicker_FormatHex( byval clr as ulong ) as ustring
    dim as string sHex = "#" & right( "0" & hex( (clr shr 16) and &hFF ), 2 ) & _
                         right( "0" & hex( (clr shr 8) and &hFF ), 2 ) & right( "0" & hex( clr and &hFF ), 2 )
    dim as ustring wszOut = ucase( sHex )
    return wszOut
end function

' #RRGGBB with or without the '#', either case. FALSE -- clr untouched -- on anything else.
public function tkColorPicker_ParseHex( byval wszText as ustring, byref clr as ulong ) as boolean
    dim as string s = ucase( trim( wszText ) )
    if left( s, 1 ) = "#" then s = mid( s, 2 )
    if len( s ) <> 6 then return false
    dim as long nVal(0 to 2)
    for i as long = 0 to 2
        dim as long v = 0
        for j as long = 0 to 1
            dim as long ch = asc( mid( s, (i * 2) + j + 1, 1 ) )
            dim as long dg
            select case ch
            case asc( "0" ) to asc( "9" ) : dg = ch - asc( "0" )
            case asc( "A" ) to asc( "F" ) : dg = (ch - asc( "A" )) + 10
            case else : return false
            end select
            v = (v * 16) + dg
        next
        nVal(i) = v
    next
    clr = tkRGB( nVal(0), nVal(1), nVal(2) )
    return true
end function

' Black or white, whichever is legible ON clr (BT.601 luma, threshold 140).
public function tkColorPicker_ContrastColor( byval clr as ulong ) as ulong
    dim as long nR = (clr shr 16) and &hFF, nG = (clr shr 8) and &hFF, nB = clr and &hFF
    dim as long nLuma = ((299 * nR) + (587 * nG) + (114 * nB)) \ 1000
    if nLuma >= 140 then return tkRGB( 0, 0, 0 )
    return tkRGB( 255, 255, 255 )
end function

' Digits only; nPos never matters (kept for vendor's signature).
public function tkColorPicker_FieldAccepts( byval nField as long, byval ch as long, byval nPos as long ) as boolean
    if (nField < 0) orelse (nField >= CLR_FIELD_COUNT) then return false
    return ((ch >= asc( "0" )) andalso (ch <= asc( "9" )))
end function

public function tkColorPicker_FieldMaxLen( byval nField as long ) as long
    return 3
end function

public function tkColorPicker_TabName( byval idx as long ) as ustring
    dim as ustring wszOut
    select case idx
    case CLR_TAB_WEB    : wszOut = "Web"
    case CLR_TAB_SYSTEM : wszOut = "System"
    case CLR_TAB_CUSTOM : wszOut = "Custom"
    end select
    return wszOut
end function


' ========================================================================================
' The two tables. Web: vendor's 137 named colours in the editors' order. System: PsPlatform's
' FROZEN table -- the values GetSysColor returned on Windows 11's default light scheme -- because
' there is no cross-platform GetSysColor; a host wanting live colours sets them per entry.
' ========================================================================================
const TKCLR_WEB_COUNT = 137
const TKCLR_SYS_COUNT = 30
dim shared as zstring * 21 gClrWebName(0 to TKCLR_WEB_COUNT - 1) = { _
    "Black"               , "DimGray"             , "Gray"                , "DarkGray", _
    "Silver"              , "LightGray"           , "Gainsboro"           , "WhiteSmoke", _
