' Run the BUILT-IN painter into the buffer a paint callback was handed: decorate, not replace.
public sub tkColorPicker_RenderInfo( byval p as any ptr )
    if p = 0 then exit sub
    dim as TKCOLORPICKER_PAINTINFO ptr pinf = cast( TKCOLORPICKER_PAINTINFO ptr, p )
    if pinf->b = 0 then exit sub
    dim as TKCOLORPICKER_STATE ptr pClr = GetColorPickerPointer( pinf->hColorPicker )
    if pClr = 0 then exit sub
    CLR_RenderDefault( pClr, pinf->b )
end sub


' ========================================================================================
' Probes: the real paint path rendered into a back buffer -- the popup's while it is open, the
' owner's (at its top-left) otherwise -- with focus and the caret forced ON, then read back.
' ========================================================================================
private function CLR_ProbePart( byval hCtrl as TK_WIDGET ptr, byval nPart as long, byref nTones as long, byref nHash as ulong ) as boolean
    nTones = 0 : nHash = 0
    dim as TKCOLORPICKER_STATE ptr pClr = GetColorPickerPointer( hCtrl )
    if pClr = 0 then return false
    CLR_Ready( pClr )
    dim as TKRECT rcPart = CLR_PartRect( pClr, nPart )
    if tkRect_IsEmpty( rcPart ) then return false
    dim as TK_HOST ptr h = iif( pClr->pSurf <> 0, pClr->pSurf, hCtrl->pHost )
    dim as long pw, ph
    tkHost_PixelSize( h, pw, ph )
    rcPart = tkRect_Intersect( rcPart, pClr->rcClient )
    if rcPart.right > pw then rcPart.right = pw
    if rcPart.bottom > ph then rcPart.bottom = ph
    if tkRect_IsEmpty( rcPart ) then return false

    dim as boolean bSavedFocus = pClr->isFocused, bSavedCaret = pClr->bCaretOn
    pClr->isFocused = true
    pClr->bCaretOn = true
    dim as TK_PAINT wp
    wp.renderer = h->renderer
    wp.engine = h->engine
    wp.pFont = h->pDefaultFont
    wp.fScale = h->fScale
    wp.Begin( 0, 0, tkRect_Width( pClr->rcClient ), tkRect_Height( pClr->rcClient ) )
    CLR_RenderAll( pClr, @wp )
    pClr->isFocused = bSavedFocus
    pClr->bCaretOn = bSavedCaret
    SDL_SetRenderClipRect( h->renderer, 0 )
    h->bDirty = true
    dim as SDL_Rect sr
    sr.x = rcPart.left : sr.y = rcPart.top : sr.w = tkRect_Width( rcPart ) : sr.h = tkRect_Height( rcPart )
    dim as SDL_Surface ptr s0 = SDL_RenderReadPixels( h->renderer, @sr )
    if s0 = 0 then return false
    dim as SDL_Surface ptr s = SDL_ConvertSurface( s0, SDL_PIXELFORMAT_ARGB8888 )
    SDL_DestroySurface( s0 )
    if s = 0 then return false
    dim tones(0 to 63) as ulong
    dim as long nSeen = 0
    dim as ulong hv = &h811C9DC5ul
    for y as long = 0 to s->h - 1
        dim as ulong ptr row = cast( ulong ptr, cast( ubyte ptr, s->pixels ) + y * s->pitch )
        for x as long = 0 to s->w - 1
            dim as ulong c = row[x] and &h00FFFFFFul
            dim as boolean bFound = false
            for t as long = 0 to nSeen - 1
                if tones(t) = c then bFound = true : exit for
            next
            if (bFound = false) andalso (nSeen < 64) then tones(nSeen) = c : nSeen += 1
            hv = (hv xor (c and &hFF)) * &h01000193ul
            hv = (hv xor ((c shr 8) and &hFF)) * &h01000193ul
            hv = (hv xor ((c shr 16) and &hFF)) * &h01000193ul
        next
    next
    SDL_DestroySurface( s )
    nTones = nSeen
    nHash = hv
    return true
end function

' Distinct colours in a part, capped at 64. A part wiped by a flood is ONE tone.
public function tkColorPicker_CountRenderedTones( byval hCtrl as TK_WIDGET ptr, byval nPart as long ) as long
    dim as long nTones
    dim as ulong nHash
    if CLR_ProbePart( hCtrl, nPart, nTones, nHash ) = false then return 0
    return nTones
end function

' FNV-1a of a part: equal hashes across two states mean the change never reached the pixels.
public function tkColorPicker_HashRenderedPart( byval hCtrl as TK_WIDGET ptr, byval nPart as long ) as ulong
    dim as long nTones
    dim as ulong nHash
    if CLR_ProbePart( hCtrl, nPart, nTones, nHash ) = false then return 0
    return nHash
end function
