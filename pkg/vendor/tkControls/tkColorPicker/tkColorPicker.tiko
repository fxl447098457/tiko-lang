    "LavenderBlush"       , "PaleVioletRed"       , "Crimson"             , "Pink", _
    "LightPink" }
dim shared as ulong gClrWebRgb(0 to TKCLR_WEB_COUNT - 1) = { _
    &h000000, &h696969, &h808080, &hA9A9A9, &hC0C0C0, &hD3D3D3, &hDCDCDC, &hF5F5F5, _
