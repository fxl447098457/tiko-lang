' ---- render probes ----------------------------------------------------------------------------
' Render the control into the back buffer with focus forced on and its current painter, read one
' OPT_PART_* rect back, and return its distinct tones (capped at 64) and an FNV-1a hash. Like
' tkCheckBox's this draws into the WINDOW's back buffer, then marks it dirty.
private function ProbePart( byval hOptionButton as TK_WIDGET ptr, byval nPart as long, byref nTones as long, byref nHash as ulong ) as boolean
    nTones = 0 : nHash = 0
    dim as TKOPTIONBUTTON_STATE ptr pOpt = GetOptionButtonPointer( hOptionButton )
    if pOpt = 0 then return false
    dim as TKRECT rc
    dim as long nWhich = 0
    if nPart = OPT_PART_BOX then nWhich = 1
    if nPart = OPT_PART_TEXT then nWhich = 4
    if GetRectCommon( hOptionButton, rc, nWhich ) = false then return false
    if rc.left < 0 then rc.left = 0
    if rc.top < 0 then rc.top = 0
    if rc.right > hOptionButton->cw then rc.right = hOptionButton->cw
    if rc.bottom > hOptionButton->ch then rc.bottom = hOptionButton->ch
    if tkRect_IsEmpty( rc ) then return false

    dim as TK_HOST ptr h = hOptionButton->pHost
    dim as boolean bSaved = pOpt->isFocused
    pOpt->isFocused = true
    dim as TKRECT a
    tkWidget_AbsRect( hOptionButton, a )
    dim as TK_PAINT wp
    wp.renderer = h->renderer
    wp.engine = h->engine
    wp.Begin( a.left, a.top, hOptionButton->cw, hOptionButton->ch )
    tkOptionButton_OnPaint( pOpt, @wp )
    pOpt->isFocused = bSaved
    SDL_SetRenderClipRect( h->renderer, 0 )

    dim as SDL_Rect sr
    sr.x = a.left + rc.left : sr.y = a.top + rc.top
    sr.w = rc.right - rc.left : sr.h = rc.bottom - rc.top
    dim as SDL_Surface ptr s0 = SDL_RenderReadPixels( h->renderer, @sr )
    if s0 = 0 then return false
    dim as SDL_Surface ptr s = SDL_ConvertSurface( s0, SDL_PIXELFORMAT_ARGB8888 )
    SDL_DestroySurface( s0 )
    if s = 0 then return false
    h->bDirty = true                 ' the probe drew into the back buffer; repaint honestly

    dim tones(0 to 63) as ulong
    dim as ulong hv = &h811C9DC5ul
    for y as long = 0 to s->h - 1
        dim as ulong ptr row = cast( ulong ptr, cast( ubyte ptr, s->pixels ) + y * s->pitch )
        for x as long = 0 to s->w - 1
            dim as ulong c = row[x] and &h00FFFFFFul
            dim as boolean bFound = false
            for t as long = 0 to nTones - 1
                if tones(t) = c then bFound = true : exit for
            next
            if (bFound = false) andalso (nTones < 64) then tones(nTones) = c : nTones += 1
            for k as long = 0 to 2
                hv = (hv xor ((c shr (k * 8)) and &hFFul)) * &h01000193ul
            next
        next
    next
    SDL_DestroySurface( s )
    nHash = hv
    return true
end function

public function tkOptionButton_CountRenderedTones( byval hOptionButton as TK_WIDGET ptr, byval nPart as long ) as long
    dim as long nTones
    dim as ulong nHash
    if ProbePart( hOptionButton, nPart, nTones, nHash ) = false then return 0
    return nTones
end function

public function tkOptionButton_HashRenderedPart( byval hOptionButton as TK_WIDGET ptr, byval nPart as long ) as ulong
    dim as long nTones
    dim as ulong nHash
    if ProbePart( hOptionButton, nPart, nTones, nHash ) = false then return 0
    return nHash
end function

' The theme's shape (tkTheme_ShapeOf, design units) unless the host set this control's own --
' its setter pins it. -1 in the theme gives the control's default. Only a change calls the setter.
private sub ApplyThemeShape( byval w as TK_WIDGET ptr )
    dim as TKOPTIONBUTTON_STATE ptr pOpt = GetOptionButtonPointer( w )
    if (pOpt = 0) orelse pOpt->bShapePinned then exit sub
    dim as TKTHEME_SHAPE sh = tkTheme_ShapeOf( w )
    dim as long v
    v = iif( sh.CornerRadius >= 0, tkHost_Scale( w->pHost, sh.CornerRadius * 2 ), tkHost_Scale( w->pHost, TKOPTIONBUTTON_DEFAULT_FOCUSCURV ) )
    if pOpt->nFocusCurvature <> v then tkOptionButton_SetFocusCurvature( w, v )
    pOpt->bShapePinned = false
end sub
