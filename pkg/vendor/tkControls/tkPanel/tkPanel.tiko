' tkPanel -- a plain container: a background, an optional one-line border, and its children. Never a
' tab stop. Children are parented to the panel itself and positioned relative to it.
#module "tkPanel"

#import "../tkHost" public
#import "../tkTheme" public
using tkHost
using tkPaint
using tkTheme

public enum
    PNL_BORDER_NONE = 0
    PNL_BORDER_LINE
end enum

public type TKPANEL_COLORS
    BackColor   as ulong
    BorderColor as ulong
end type

public type TKPANEL_PAINTINFO
    hPanel   as TK_WIDGET ptr
    b        as TK_PAINT ptr
    rcClient as TKRECT
end type

' Draws over the background and border, under the children.
public type PNL_PaintCallbackSub as sub( byval p as TKPANEL_PAINTINFO ptr )

public type TKPANEL_STATE
    hWin          as TK_WIDGET ptr
    colors        as TKPANEL_COLORS
    bColorsPinned as boolean
    bTransparent  as boolean
    nBorderStyle  as long = PNL_BORDER_NONE
    PaintCallback as PNL_PaintCallbackSub
end type

public declare function tkPanel_ThemeColors( byref t as TKTHEME_COLORS ) as TKPANEL_COLORS
public declare sub tkPanel_ApplyTheme( byval hPanel as TK_WIDGET ptr, byref t as TKTHEME_COLORS )

private function GetPanelPointer( byval h as TK_WIDGET ptr ) as TKPANEL_STATE ptr
    if h = 0 then return 0
    return cast( TKPANEL_STATE ptr, h->pData )
end function

private function tkPanel_Proc( byval w as TK_WIDGET ptr, byval m as TK_MSG ptr ) as boolean
    dim as TKPANEL_STATE ptr p = GetPanelPointer( w )
    if p = 0 then return false
    select case m->msg
    case TKM_PAINT
        dim as TK_PAINT ptr b = m->pPaint
        dim as TKRECT rc
        tkRect_Set( rc, 0, 0, w->cw, w->ch )
        if p->bTransparent = false then
            b->SetBackColor( p->colors.BackColor )
            b->PaintRect( @rc )
        end if
        if p->nBorderStyle = PNL_BORDER_LINE then
            b->SetPenColor( p->colors.BorderColor )
            b->PaintBorderRect( @rc )
        end if
        if p->PaintCallback then
            dim as TKPANEL_PAINTINFO pi
            pi.hPanel = w
            pi.b = b
            pi.rcClient = rc
            p->PaintCallback( @pi )
        end if
        return true
    case TKM_THEMECHANGED
        tkPanel_ApplyTheme( w, tkTheme_Get() )
        return true
    case TKM_DESTROY
        delete p
        w->pData = 0
        return true
    end select
    return false
end function

public function tkPanel_Create( byval hParent as TK_WIDGET ptr, byval ctrlId as long ) as TK_WIDGET ptr
    if hParent = 0 then return 0
    dim as TKPANEL_STATE ptr p = new TKPANEL_STATE
    dim as TK_WIDGET ptr w = tkWidget_CreateChild( hParent, ctrlId, @tkPanel_Proc, p )
    p->hWin = w
    p->colors = tkPanel_ThemeColors( tkTheme_Get() )
    return w
end function

public function tkPanel_GetBackColor( byval h as TK_WIDGET ptr ) as ulong
    dim as TKPANEL_STATE ptr p = GetPanelPointer( h )
    return iif( p <> 0, p->colors.BackColor, 0ul )
end function

' A host-chosen colour survives a theme change; tkPanel_UnpinColors hands it back.
public sub tkPanel_SetBackColor( byval h as TK_WIDGET ptr, byval clr as ulong )
    dim as TKPANEL_STATE ptr p = GetPanelPointer( h )
    if p = 0 then exit sub
    p->colors.BackColor = clr
    p->bColorsPinned = true
    tkWidget_Invalidate( h )
end sub

public function tkPanel_GetBorderColor( byval h as TK_WIDGET ptr ) as ulong
    dim as TKPANEL_STATE ptr p = GetPanelPointer( h )
    return iif( p <> 0, p->colors.BorderColor, 0ul )
end function

public sub tkPanel_SetBorderColor( byval h as TK_WIDGET ptr, byval clr as ulong )
    dim as TKPANEL_STATE ptr p = GetPanelPointer( h )
    if p = 0 then exit sub
    p->colors.BorderColor = clr
    p->bColorsPinned = true
    tkWidget_Invalidate( h )
end sub

public function tkPanel_GetBorderStyle( byval h as TK_WIDGET ptr ) as long
    dim as TKPANEL_STATE ptr p = GetPanelPointer( h )
    return iif( p <> 0, p->nBorderStyle, PNL_BORDER_NONE )
end function

public sub tkPanel_SetBorderStyle( byval h as TK_WIDGET ptr, byval nStyle as long )
    dim as TKPANEL_STATE ptr p = GetPanelPointer( h )
    if p = 0 then exit sub
    p->nBorderStyle = iif( nStyle = PNL_BORDER_LINE, PNL_BORDER_LINE, PNL_BORDER_NONE )
    tkWidget_Invalidate( h )
end sub

public function tkPanel_GetTransparent( byval h as TK_WIDGET ptr ) as boolean
    dim as TKPANEL_STATE ptr p = GetPanelPointer( h )
    return iif( p <> 0, p->bTransparent, false )
end function

public sub tkPanel_SetTransparent( byval h as TK_WIDGET ptr, byval bTransparent as boolean )
    dim as TKPANEL_STATE ptr p = GetPanelPointer( h )
    if p = 0 then exit sub
    p->bTransparent = bTransparent
    tkWidget_Invalidate( h )
end sub

public sub tkPanel_SetPaintCallback( byval h as TK_WIDGET ptr, byval usersub as PNL_PaintCallbackSub )
    dim as TKPANEL_STATE ptr p = GetPanelPointer( h )
    if p = 0 then exit sub
    p->PaintCallback = usersub
    tkWidget_Invalidate( h )
end sub

public function tkPanel_ThemeColors( byref t as TKTHEME_COLORS ) as TKPANEL_COLORS
    dim as TKPANEL_COLORS c
    c.BackColor = t.Window
    c.BorderColor = t.Border
    return c
end function

public sub tkPanel_ApplyTheme( byval h as TK_WIDGET ptr, byref t as TKTHEME_COLORS )
    dim as TKPANEL_STATE ptr p = GetPanelPointer( h )
    if (p = 0) orelse p->bColorsPinned then exit sub
    p->colors = tkPanel_ThemeColors( t )
    tkWidget_Invalidate( h )
end sub

public sub tkPanel_UnpinColors( byval h as TK_WIDGET ptr )
    dim as TKPANEL_STATE ptr p = GetPanelPointer( h )
    if p = 0 then exit sub
    p->bColorsPinned = false
    tkPanel_ApplyTheme( h, tkTheme_Get() )
end sub
