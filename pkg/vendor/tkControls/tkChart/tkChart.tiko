' Pie only, always series 0; raw px, clamped at 0.
public function tkChart_SetPointExplode( byval hChart as TK_WIDGET ptr, byval iPoint as long, byval nOffset as long ) as boolean
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return false
    dim as TKCHART_POINT ptr p = pChart->GetPoint( 0, iPoint )
    if p = 0 then return false
    p->nExplode = iif( nOffset < 0, 0, nOffset )
    pChart->Refresh()
    return true
end function

public function tkChart_ClearPoints( byval hChart as TK_WIDGET ptr, byval iSeries as long ) as boolean
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return false
    dim as TKCHART_SERIES ptr s = pChart->GetSeries( iSeries )
    if s = 0 then return false
    for j as long = 0 to s->pointCount - 1
        s->points(j).Text = ""
    next
    s->pointCount = 0
    if pChart->nHotSeries = iSeries then pChart->nHotSeries = -1 : pChart->nHotPoint = -1
    pChart->Refresh()
    return true
end function

public sub tkChart_Clear( byval hChart as TK_WIDGET ptr )
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart then pChart->ClearAll()
end sub

' NESTS: only the outermost EndUpdate repaints; extra EndUpdates are ignored.
public sub tkChart_BeginUpdate( byval hChart as TK_WIDGET ptr )
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart then pChart->updateDepth += 1
end sub

public sub tkChart_EndUpdate( byval hChart as TK_WIDGET ptr )
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if (pChart = 0) orelse (pChart->updateDepth <= 0) then exit sub
    pChart->updateDepth -= 1
    if pChart->updateDepth = 0 then pChart->Refresh()
end sub

public function tkChart_GetUpdateDepth( byval hChart as TK_WIDGET ptr ) as long
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return 0
    return pChart->updateDepth
end function

