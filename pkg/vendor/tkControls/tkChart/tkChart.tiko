' Pie: slice iPoint's geometry (degrees) and whether its label went outside / was dropped.
public function tkChart_GetSliceInfo( byval hChart as TK_WIDGET ptr, byval iPoint as long, byref fStart as single, byref fSweep as single, _
                                      byref bLabelOut as boolean, byref bLabelHid as boolean ) as boolean
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return false
    CHT_EnsureLayout( pChart )
    dim as TKCHART_POINT ptr p = pChart->GetPoint( 0, iPoint )
    if p = 0 then return false
    fStart = p->fStart : fSweep = p->fSweep : bLabelOut = p->bLabelOut : bLabelHid = p->bLabelHid
    return true
end function

