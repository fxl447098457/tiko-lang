' Storage only: no repaint.
public function tkChart_SetPointItemData( byval hChart as TK_WIDGET ptr, byval iSeries as long, byval iPoint as long, byval nData as integer ) as boolean
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return false
    dim as TKCHART_POINT ptr p = pChart->GetPoint( iSeries, iPoint )
    if p = 0 then return false
    p->ItemData = nData
    return true
