' Turns autoscaling OFF as a side effect.
public sub tkChart_SetValueRange( byval hChart as TK_WIDGET ptr, byval fLo as double, byval fHi as double )
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then exit sub
    pChart->fUserMin = fLo
    pChart->fUserMax = fHi
    pChart->bAutoScale = false
    pChart->Refresh()
end sub

' The RESOLVED range; forces a pending layout.
public sub tkChart_GetValueRange( byval hChart as TK_WIDGET ptr, byref fLo as double, byref fHi as double )
    fLo = 0.0 : fHi = 0.0
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then exit sub
    CHT_EnsureLayout( pChart )
    fLo = pChart->fMin : fHi = pChart->fMax
end sub

