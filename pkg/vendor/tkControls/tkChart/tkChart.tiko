' ========================================================================================
' Probes: CHT_Render into the back buffer at the widget's place, read back before any present.
' ========================================================================================
private function CHT_RenderRead( byval hChart as TK_WIDGET ptr ) as SDL_Surface ptr
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if (pChart = 0) orelse (hChart->cw <= 0) orelse (hChart->ch <= 0) then return 0
    dim as TK_HOST ptr h = hChart->pHost
    dim as TKRECT a
    tkWidget_AbsRect( hChart, a )
    dim as TK_PAINT wp
    wp.renderer = h->renderer
    wp.engine = h->engine
    wp.pFont = h->pDefaultFont
    wp.fScale = h->fScale
    wp.Begin( a.left, a.top, hChart->cw, hChart->ch )
    CHT_Render( pChart, @wp )
    SDL_SetRenderClipRect( h->renderer, 0 )
    h->bDirty = true
    dim as SDL_Rect sr
    sr.x = a.left : sr.y = a.top : sr.w = hChart->cw : sr.h = hChart->ch
    dim as SDL_Surface ptr s0 = SDL_RenderReadPixels( h->renderer, @sr )
    if s0 = 0 then return 0
    dim as SDL_Surface ptr s = SDL_ConvertSurface( s0, SDL_PIXELFORMAT_ARGB8888 )
    SDL_DestroySurface( s0 )
    return s
end function

private function CHT_Px( byval s as SDL_Surface ptr, byval x as long, byval y as long ) as ulong
    return *cast( ulong ptr, cast( ubyte ptr, s->pixels ) + y * s->pitch + x * 4 ) or &hFF000000ul
end function

' Distinct colours on a fixed 32x32 sample grid over the client, capped at 64.
public function tkChart_CountRenderedTones( byval hChart as TK_WIDGET ptr ) as long
    dim as SDL_Surface ptr s = CHT_RenderRead( hChart )
    if s = 0 then return 0
    dim tones(0 to 63) as ulong
    dim as long n = 0
    for gy as long = 0 to 31
        for gx as long = 0 to 31
            dim as ulong c = CHT_Px( s, (gx * (s->w - 1)) \ 31, (gy * (s->h - 1)) \ 31 )
            dim as boolean f = false
            for t as long = 0 to n - 1
                if tones(t) = c then f = true : exit for
            next
            if (f = false) andalso (n < 64) then tones(n) = c : n += 1
        next
    next
    SDL_DestroySurface( s )
    return n
end function

' FNV-1a over the same sample.
public function tkChart_HashRenderedPart( byval hChart as TK_WIDGET ptr ) as ulong
    dim as SDL_Surface ptr s = CHT_RenderRead( hChart )
    if s = 0 then return 0
    dim as ulong hv = &h811C9DC5ul
    for gy as long = 0 to 31
        for gx as long = 0 to 31
            dim as ulong c = CHT_Px( s, (gx * (s->w - 1)) \ 31, (gy * (s->h - 1)) \ 31 )
            hv = (hv xor (c and &hFF)) * &h01000193ul
            hv = (hv xor ((c shr 8) and &hFF)) * &h01000193ul
            hv = (hv xor ((c shr 16) and &hFF)) * &h01000193ul
        next
    next
    SDL_DestroySurface( s )
    return hv
end function

' One rendered pixel (client coordinates), opaque; 0 outside the client.
public function tkChart_GetRenderedPixel( byval hChart as TK_WIDGET ptr, byval x as long, byval y as long ) as ulong
    if (hChart = 0) orelse (x < 0) orelse (y < 0) orelse (x >= hChart->cw) orelse (y >= hChart->ch) then return 0
    dim as SDL_Surface ptr s = CHT_RenderRead( hChart )
    if s = 0 then return 0
    dim as ulong c = CHT_Px( s, x, y )
    SDL_DestroySurface( s )
    return c
end function

' Every pixel of the plot rect that is NOT clrBack: the series' ink. A test probe.
public function tkChart_CountPlotInkPixels( byval hChart as TK_WIDGET ptr, byval clrBack as ulong ) as long
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return 0
    CHT_EnsureLayout( pChart )
    dim as TKRECT rp = pChart->rcPlot
    dim as SDL_Surface ptr s = CHT_RenderRead( hChart )
    if s = 0 then return 0
    clrBack or= &hFF000000ul
    dim as long n = 0
    for y as long = rp.top to rp.bottom - 1
        if (y < 0) orelse (y >= s->h) then continue for
        for x as long = rp.left to rp.right - 1
            if (x < 0) orelse (x >= s->w) then continue for
            if CHT_Px( s, x, y ) <> clrBack then n += 1
        next
    next
    SDL_DestroySurface( s )
    return n
end function
