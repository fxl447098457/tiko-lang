public function tkChart_SetSeriesName( byval hChart as TK_WIDGET ptr, byval iSeries as long, byval wszName as ustring ) as boolean
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return false
    dim as TKCHART_SERIES ptr s = pChart->GetSeries( iSeries )
    if s = 0 then return false
    s->SeriesName = wszName
    pChart->Refresh()
    return true
end function

public function tkChart_GetSeriesName( byval hChart as TK_WIDGET ptr, byval iSeries as long ) as ustring
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return ""
    dim as TKCHART_SERIES ptr s = pChart->GetSeries( iSeries )
    if s = 0 then return ""
