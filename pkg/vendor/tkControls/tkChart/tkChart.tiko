'
' tkChart -- PsChart on SDL3 + SDL_ttf, a port of pkg/vendor/PsControls/PsChart onto tkHost.
' One display control, four charts fixed at create: LINE (smoothing, symbols, dash styles, area
' fills, bands between two series), COLUMN (grouped or stacked), HLOC, and PIE / doughnut with
' exploded slices and inside / outside / auto label placement on leader lines. Autoscaled
' 1-2-5 ticks, a legend, title and subtitle, hit testing, a hot point, value-label and tooltip
' callbacks, BeginUpdate / EndUpdate.
'
' WHAT IS UNCHANGED, by design: ResolveRange (column forces zero, line / HLOC do not, HLOC reads
' low / high, stacked scales to separate positive and negative totals), CHT_NiceRange,
' CHT_AutoDecimals, CHT_FormatNumber, LayoutChart / LayoutPoints / LayoutStackedColumns /
' LayoutPieSlices, the one set of rects the renderer AND the hit test read, the render order
' (bands, fills, lines, markers; wedges, then leaders, then labels), the palette, silent setters
' with the hot point as the only notification, and the probes.
'
' WHAT IS GONE: the hot poll and TrackMouseEvent (the host guarantees the leave), WM_SETFONT /
' GETFONT, WM_GETDLGCODE (the chart is not focusable), TTN_GETDISPINFOW and the comctl32 tip
' backend, PsRegistry. See PORT.md.
#module "tkChart"

#import "../tkHost" public
#import "../tkTheme" public
#import "../tkTooltip" public
using tkHost
using tkPaint
using tkTheme
using tkTooltip

public const TKCHART_DEFAULT_PADDING = 10
public const TKCHART_DEFAULT_CHROMEGAP = 6
public const TKCHART_DEFAULT_TICKLEN = 4
public const TKCHART_DEFAULT_BARGAP = 1
public const TKCHART_DEFAULT_GROUPGAPPCT = 25
public const TKCHART_DEFAULT_HLOCTICK = 3
public const TKCHART_DEFAULT_LINEWIDTH = 2
public const TKCHART_DEFAULT_SYMBOLSIZE = 6
public const TKCHART_DEFAULT_PIEGAP = 1          ' a hairline: never scaled
public const TKCHART_DEFAULT_TICKHINT = 5
public const TKCHART_DEFAULT_LABELGAP = 8
public const TKCHART_DEFAULT_HITRADIUS = 8
public const TKCHART_PALETTE_COUNT = 10
public const TKCHART_DECIMALS_AUTO = -1
public const TKCHART_SKIP_AUTO = 0

public enum
    TKCHART_TYPE_LINE = 0
    TKCHART_TYPE_COLUMN
    TKCHART_TYPE_HLOC
    TKCHART_TYPE_PIE
end enum

public enum
