    CHT_SYM_CIRCLE
    CHT_SYM_SQUARE
    CHT_SYM_DIAMOND
    CHT_SYM_TRIANGLE
end enum

public enum
    CHT_COL_GROUPED = 0
    CHT_COL_STACKED
end enum

public enum
    CHT_LINE_SOLID = 0
    CHT_LINE_DASH
    CHT_LINE_DOT
    CHT_LINE_DASHDOT
end enum

public enum
    CHT_LEGEND_BOTTOM = 0
    CHT_LEGEND_TOP
    CHT_LEGEND_LEFT
    CHT_LEGEND_RIGHT
end enum

public enum
    CHT_PIELABEL_NONE = 0
    CHT_PIELABEL_VALUE
    CHT_PIELABEL_PERCENT
    CHT_PIELABEL_NAME
    CHT_PIELABEL_NAME_PERCENT
end enum

public enum
    CHT_PIEPLACE_INSIDE = 0
    CHT_PIEPLACE_OUTSIDE
    CHT_PIEPLACE_AUTO
end enum

public enum
    CHT_FMT_AXIS = 0
    CHT_FMT_PIELABEL
    CHT_FMT_TOOLTIP
end enum

' Vendor's dark defaults (BGR(r,g,b) -> tkRGB(r,g,b)). Read-modify-write, no per-field setters.
public type TKCHART_COLORS
    BackColor          as ulong = &hFF21252Bul
    PlotBackColor      as ulong = &hFF21252Bul
    GridColor          as ulong = &hFF3E444Eul
    AxisColor          as ulong = &hFF5A616Cul
    LabelColor         as ulong = &hFF969CA6ul
    TitleColor         as ulong = &hFFD7DAE0ul
    SubtitleColor      as ulong = &hFF969CA6ul
    LegendTextColor    as ulong = &hFFBEC4CEul
    SliceLabelColor    as ulong = &hFFFFFFFFul
    SliceLabelOutColor as ulong = &hFFBEC4CEul
    LeaderColor        as ulong = &hFF787E88ul
    SliceGapColor      as ulong = &hFF21252Bul
    UpColor            as ulong = &hFF48970Dul
    DownColor          as ulong = &hFFD05050ul
    ForeColorDisabled  as ulong = &hFF6E737Dul
end type

public type TKCHART_POINT
    Text       as ustring      ' only series 0's labels drive the X axis
    Value      as double       ' line / column / pie; the close for HLOC
    OpenVal    as double
    HighVal    as double
    LowVal     as double
    CloseVal   as double
    ItemData   as integer
    bHasColor  as boolean
    PointColor as ulong
    nExplode   as long         ' pie only: raw px along the bisector
    ' --- DERIVED by layout ---
    rc         as TKRECT       ' column: the bar. HLOC: the column band. line: the hit box. pie: the label box.
    ptPlot     as TKPOINT      ' line: the vertex. pie: the wedge's outer midpoint.
    fStart     as single       ' pie: degrees, 0 = 3 o'clock, + = clockwise
    fSweep     as single
    bLabelOut  as boolean
    bLabelHid  as boolean
end type

public type TKCHART_SERIES
    SeriesName  as ustring
    bHasColor   as boolean
    SeriesColor as ulong
    nLineWidth  as long = TKCHART_DEFAULT_LINEWIDTH
    nLineStyle  as long = CHT_LINE_SOLID
    nSymbol     as long = CHT_SYM_NONE
    nSymbolSize as long = TKCHART_DEFAULT_SYMBOLSIZE
    bSmooth     as boolean
    bHasFill    as boolean
    FillColor   as ulong
    nFillAlpha  as long = 255
    bVisible    as boolean = true
    points(any) as TKCHART_POINT
    pointCount  as long
    declare sub EnsurePoints( byval n as long )
end type

sub TKCHART_SERIES.EnsurePoints( byval n as long )
    if n <= 0 then exit sub
    if ubound( this.points ) < n - 1 then
        dim as long newcap = 16
        do while newcap < n
            newcap *= 2
        loop
        redim preserve this.points( 0 to newcap - 1 )
    end if
end sub

public type TKCHART_BAND
    iLo    as long = -1
    iHi    as long = -1
    clr    as ulong
    nAlpha as long = 255
end type

' Every sentinel resolved. The callback is ALL-OR-NOTHING: the renderer does not run.
public type TKCHART_PAINTINFO
    hChart        as TK_WIDGET ptr
    b             as TK_PAINT ptr
    rcClient      as TKRECT
    rcPlot        as TKRECT
    rcTitle       as TKRECT
    rcSubtitle    as TKRECT
    rcLegend      as TKRECT
    rcAxisX       as TKRECT
    rcAxisY       as TKRECT
    rcPie         as TKRECT
    nChartType    as long
    fMin          as double
    fMax          as double
    fStep         as double
    nDecimals     as long
    nOriginY      as long
    nCatCount     as long
    nLabelStride  as long
    nHotSeries    as long
    nHotPoint     as long
    isEnabled     as boolean
    wszTitle      as ustring
    wszSubtitle   as ustring
end type

public type TKCHART_MESSAGEINFO
    hChart   as TK_WIDGET ptr
    msg      as long             ' TKM_*
    x        as single
    y        as single
    key      as long
    mods     as long
    clicks   as long
    iSeries  as long             ' the hot point, -1 when none
    iPoint   as long
end type

public type CHT_PaintCallbackSub as sub( byval p as TKCHART_PAINTINFO ptr )
' Offered every message but TKM_DESTROY; the result is IGNORED for TKM_LBUTTONUP.
public type CHT_MessageCallbackFunc as function( byval m as TKCHART_MESSAGEINFO ptr ) as boolean
public type CHT_TooltipCallbackFunc as function( byval hChart as TK_WIDGET ptr ) as ustring
public type CHT_ValueLabelCallbackFunc as function( byval hChart as TK_WIDGET ptr, byval fValue as double, byval nContext as long ) as ustring
public type CHT_HotChangeCallbackSub as sub( byval hChart as TK_WIDGET ptr, byval iSeries as long, byval iPoint as long )


public type TKCHART_STATE
    hWin           as TK_WIDGET ptr
    bColorsPinned  as boolean
    nChartType     as long = TKCHART_TYPE_LINE
    pLabelFont     as TTF_Font ptr        ' borrowed, all three
    pTitleFont     as TTF_Font ptr
    pSubtitleFont  as TTF_Font ptr
    colors         as TKCHART_COLORS
    palette(0 to TKCHART_PALETTE_COUNT - 1) as ulong
    series(any)    as TKCHART_SERIES
    seriesCount    as long
    bands(any)     as TKCHART_BAND
    bandCount      as long
    updateDepth    as long
    bLayoutDirty   as boolean = true
    bEnabled       as boolean = true

    wszTitle       as ustring
    wszSubtitle    as ustring
    bLegendVisible as boolean
    nLegendPos     as long = CHT_LEGEND_BOTTOM
    nPadding       as long
    nChromeGap     as long

    bAutoScale     as boolean = true
    fUserMin       as double
    fUserMax       as double
    nTickHint      as long = TKCHART_DEFAULT_TICKHINT
    bGridHorz      as boolean = true
    bGridVert      as boolean
    nDecimals      as long = TKCHART_DECIMALS_AUTO
    bThousands     as boolean = true
    nLabelSkip     as long = TKCHART_SKIP_AUTO
    nAxisThick     as long = 1               ' never scaled
    nGridThick     as long = 1               ' never scaled
    nTickLen       as long

    nBarGap        as long
    nGroupGapPct   as long = TKCHART_DEFAULT_GROUPGAPPCT
    nColumnMode    as long = CHT_COL_GROUPED
    nHlocTick      as long
    bHlocUpDown    as boolean
    fDoughnutRatio as single
    nPieLabelMode  as long = CHT_PIELABEL_VALUE
    nPieLabelPlace as long = CHT_PIEPLACE_AUTO
    fPieStartAngle as single = -90.0
    nPieSliceGap   as long = TKCHART_DEFAULT_PIEGAP

    rcClient       as TKRECT
    rcPlot         as TKRECT
    rcTitle        as TKRECT
    rcSubtitle     as TKRECT
    rcLegend       as TKRECT
    rcAxisX        as TKRECT
    rcAxisY        as TKRECT
    rcPie          as TKRECT
    fMin           as double
    fMax           as double
    fStep          as double
    nResDecimals   as long
    nOriginY       as long
    nCatCount      as long
    fSlotWidth     as single
    nLabelStride   as long = 1
    nLabelH        as long

    nHotSeries     as long = -1
    nHotPoint      as long = -1
    nHitRadius     as long
    tip            as TKTIPHOST_STATE
