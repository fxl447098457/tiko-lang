    PaintCallback      as CHT_PaintCallbackSub
    MessageCallback    as CHT_MessageCallbackFunc
    TooltipCallback    as CHT_TooltipCallbackFunc
    ValueLabelCallback as CHT_ValueLabelCallbackFunc
