public sub tkChart_GetColors( byval hChart as TK_WIDGET ptr, byval pColors as TKCHART_COLORS ptr )
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if (pChart = 0) orelse (pColors = 0) then exit sub
    *pColors = pChart->colors
end sub

' Copies and PINS.
public sub tkChart_SetColors( byval hChart as TK_WIDGET ptr, byval pColors as TKCHART_COLORS ptr )
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if (pChart = 0) orelse (pColors = 0) then exit sub
    pChart->colors = *pColors
    pChart->bColorsPinned = true
    tkWidget_Invalidate( hChart )
end sub

' Vendor PsChart_ThemeColors, role for role. The palette and series colours are data, never themed.
public function tkChart_ThemeColors( byref t as TKTHEME_COLORS ) as TKCHART_COLORS
    dim as TKCHART_COLORS c
    c.BackColor = t.Window
    c.PlotBackColor = t.Window
    c.GridColor = t.Divider
    c.AxisColor = t.Border
    c.LabelColor = t.TextDim
    c.TitleColor = t.Text
    c.SubtitleColor = t.TextDim
    c.LegendTextColor = t.Text
    c.SliceLabelColor = t.SelectedText
    c.SliceLabelOutColor = t.Text
    c.LeaderColor = t.TextDim
    c.SliceGapColor = t.Window
    c.UpColor = t.Success
    c.DownColor = t.Error
    c.ForeColorDisabled = t.TextDisabled
    return c
end function

public sub tkChart_ApplyTheme( byval hChart as TK_WIDGET ptr, byref t as TKTHEME_COLORS )
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if (pChart = 0) orelse pChart->bColorsPinned then exit sub
    dim as TKTHEME_COLORS tr = tkTheme_Styled( hChart, t )
    pChart->colors = tkChart_ThemeColors( tr )
    tkTheme_ResolveInto( hChart, tr, cast( ulong ptr, @pChart->colors ), sizeof( TKCHART_COLORS ) \ 4, "Chart" )
    tkWidget_Invalidate( hChart )
end sub

public sub tkChart_UnpinColors( byval hChart as TK_WIDGET ptr )
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then exit sub
    pChart->bColorsPinned = false
    tkChart_ApplyTheme( hChart, tkTheme_Of( hChart ) )
end sub

public sub tkChart_SetPaletteColor( byval hChart as TK_WIDGET ptr, byval idx as long, byval clr as ulong )
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if (pChart = 0) orelse (idx < 0) orelse (idx >= TKCHART_PALETTE_COUNT) then exit sub
    pChart->palette(idx) = clr
    tkWidget_Invalidate( hChart )
end sub

public function tkChart_GetPaletteColor( byval hChart as TK_WIDGET ptr, byval idx as long ) as ulong
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if (pChart = 0) orelse (idx < 0) orelse (idx >= TKCHART_PALETTE_COUNT) then return 0
    return pChart->palette(idx)
end function

' --- query -----------------------------------------------------------------------------------------
public function tkChart_HitTest( byval hChart as TK_WIDGET ptr, byval x as long, byval y as long, byref iSeries as long, byref iPoint as long ) as boolean
    iSeries = -1 : iPoint = -1
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return false
    CHT_EnsureLayout( pChart )
    return CHT_HitTest( pChart, x, y, iSeries, iPoint )
end function

private function CHT_Rect( byval hChart as TK_WIDGET ptr, byval nWhich as long, byref rc as TKRECT ) as boolean
    tkRect_SetEmpty( rc )
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return false
    CHT_EnsureLayout( pChart )
    select case nWhich
    case 0 : rc = pChart->rcPlot
    case 1 : rc = pChart->rcLegend
    case 2 : rc = pChart->rcTitle
    case 3 : rc = pChart->rcAxisY
    case 4 : rc = pChart->rcAxisX
    case 5 : rc = pChart->rcPie
    case 6 : rc = pChart->rcSubtitle
    end select
    return true
end function

public function tkChart_GetPlotRect( byval hChart as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return CHT_Rect( hChart, 0, rc )
end function
public function tkChart_GetLegendRect( byval hChart as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return CHT_Rect( hChart, 1, rc )
end function
public function tkChart_GetTitleRect( byval hChart as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return CHT_Rect( hChart, 2, rc )
end function
public function tkChart_GetSubtitleRect( byval hChart as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return CHT_Rect( hChart, 6, rc )
end function
public function tkChart_GetAxisYRect( byval hChart as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return CHT_Rect( hChart, 3, rc )
end function
public function tkChart_GetAxisXRect( byval hChart as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return CHT_Rect( hChart, 4, rc )
end function
public function tkChart_GetPieRect( byval hChart as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return CHT_Rect( hChart, 5, rc )
end function

' The bar / HLOC band / line hit box / pie label box. Empty for a hidden series.
public function tkChart_GetPointRect( byval hChart as TK_WIDGET ptr, byval iSeries as long, byval iPoint as long, byref rc as TKRECT ) as boolean
    tkRect_SetEmpty( rc )
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return false
    CHT_EnsureLayout( pChart )
    dim as TKCHART_POINT ptr p = pChart->GetPoint( iSeries, iPoint )
    if p = 0 then return false
    rc = p->rc
    return true
end function

' The line vertex / bar top / pie rim midpoint.
public function tkChart_GetPointAnchor( byval hChart as TK_WIDGET ptr, byval iSeries as long, byval iPoint as long, byref pt as TKPOINT ) as boolean
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return false
    CHT_EnsureLayout( pChart )
    dim as TKCHART_POINT ptr p = pChart->GetPoint( iSeries, iPoint )
    if p = 0 then return false
    pt = p->ptPlot
    return true
end function

' State, not geometry: no layout forced.
public function tkChart_GetHotPoint( byval hChart as TK_WIDGET ptr, byref iSeries as long, byref iPoint as long ) as boolean
    iSeries = -1 : iPoint = -1
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return false
    iSeries = pChart->nHotSeries : iPoint = pChart->nHotPoint
    return (iPoint >= 0)
end function

