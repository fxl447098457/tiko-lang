end function

public function tkChart_SetSeriesColor( byval hChart as TK_WIDGET ptr, byval iSeries as long, byval clr as ulong ) as boolean
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return false
    dim as TKCHART_SERIES ptr s = pChart->GetSeries( iSeries )
    if s = 0 then return false
    s->bHasColor = true
    s->SeriesColor = clr
    pChart->Refresh()
    return true
end function

public function tkChart_ClearSeriesColor( byval hChart as TK_WIDGET ptr, byval iSeries as long ) as boolean
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return false
    dim as TKCHART_SERIES ptr s = pChart->GetSeries( iSeries )
    if s = 0 then return false
    s->bHasColor = false
    pChart->Refresh()
    return true
end function

' Raw pixels, min 1. tkPaint grows a polyline's pen with the scale, as GDI+ did.
public function tkChart_SetSeriesLineWidth( byval hChart as TK_WIDGET ptr, byval iSeries as long, byval nWidth as long ) as boolean
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return false
    dim as TKCHART_SERIES ptr s = pChart->GetSeries( iSeries )
    if s = 0 then return false
    s->nLineWidth = iif( nWidth < 1, 1, nWidth )
    pChart->Refresh()
    return true
end function

' Fill between a LINE series and the value baseline; alpha 0..255.
public function tkChart_SetSeriesFill( byval hChart as TK_WIDGET ptr, byval iSeries as long, byval clrFill as ulong, byval nAlpha as long ) as boolean
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return false
    dim as TKCHART_SERIES ptr s = pChart->GetSeries( iSeries )
    if s = 0 then return false
    if nAlpha < 0 then nAlpha = 0
    if nAlpha > 255 then nAlpha = 255
    s->bHasFill = true
    s->FillColor = clrFill
    s->nFillAlpha = nAlpha
    pChart->Refresh()
    return true
end function

public function tkChart_ClearSeriesFill( byval hChart as TK_WIDGET ptr, byval iSeries as long ) as boolean
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return false
    dim as TKCHART_SERIES ptr s = pChart->GetSeries( iSeries )
    if s = 0 then return false
    s->bHasFill = false
    pChart->Refresh()
    return true
end function

' Fill BETWEEN two line series. The pair is the identity (either order replaces).
public function tkChart_SetSeriesBand( byval hChart as TK_WIDGET ptr, byval seriesLo as long, byval seriesHi as long, _
                                       byval clrFill as ulong, byval nAlpha as long ) as boolean
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return false
    if (pChart->IsValidSeries( seriesLo ) = false) orelse (pChart->IsValidSeries( seriesHi ) = false) then return false
    if seriesLo = seriesHi then return false
    if nAlpha < 0 then nAlpha = 0
    if nAlpha > 255 then nAlpha = 255
    dim as long k = pChart->FindBand( seriesLo, seriesHi )
    if k < 0 then
        dim as long cap = ubound( pChart->bands ) + 1
        if pChart->bandCount >= cap then redim preserve pChart->bands( 0 to iif( cap = 0, 8, cap * 2 ) - 1 )
        k = pChart->bandCount
        pChart->bandCount += 1
    end if
    pChart->bands(k).iLo = seriesLo
    pChart->bands(k).iHi = seriesHi
    pChart->bands(k).clr = clrFill
    pChart->bands(k).nAlpha = nAlpha
    pChart->Refresh()
    return true
end function

' Either order. FALSE when there was no band: a removal is told from a no-op.
public function tkChart_ClearSeriesBand( byval hChart as TK_WIDGET ptr, byval seriesLo as long, byval seriesHi as long ) as boolean
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return false
    dim as long k = pChart->FindBand( seriesLo, seriesHi )
    if k < 0 then return false
    if k <> pChart->bandCount - 1 then pChart->bands(k) = pChart->bands( pChart->bandCount - 1 )
    pChart->bandCount -= 1
    pChart->Refresh()
    return true
end function

public function tkChart_GetBandCount( byval hChart as TK_WIDGET ptr ) as long
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return 0
    return pChart->bandCount
end function

' An unrecognised style is STORED as solid: what reads back always draws.
public function tkChart_SetSeriesLineStyle( byval hChart as TK_WIDGET ptr, byval iSeries as long, byval nStyle as long ) as boolean
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return false
    dim as TKCHART_SERIES ptr s = pChart->GetSeries( iSeries )
    if s = 0 then return false
    select case nStyle
    case CHT_LINE_SOLID, CHT_LINE_DASH, CHT_LINE_DOT, CHT_LINE_DASHDOT
        s->nLineStyle = nStyle
    case else
        s->nLineStyle = CHT_LINE_SOLID
    end select
    pChart->Refresh()
    return true
end function

public function tkChart_GetSeriesLineStyle( byval hChart as TK_WIDGET ptr, byval iSeries as long ) as long
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return CHT_LINE_SOLID
    dim as TKCHART_SERIES ptr s = pChart->GetSeries( iSeries )
    if s = 0 then return CHT_LINE_SOLID
    return s->nLineStyle
end function

' nSize raw pixels, min 2; -1 keeps the create-scaled default.
public function tkChart_SetSeriesSymbol( byval hChart as TK_WIDGET ptr, byval iSeries as long, byval nSymbol as long, byval nSize as long = -1 ) as boolean
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return false
    dim as TKCHART_SERIES ptr s = pChart->GetSeries( iSeries )
    if s = 0 then return false
    s->nSymbol = nSymbol
    if nSize >= 0 then s->nSymbolSize = iif( nSize < 2, 2, nSize )
    pChart->Refresh()
    return true
end function

public function tkChart_SetSeriesSmooth( byval hChart as TK_WIDGET ptr, byval iSeries as long, byval bSmooth as boolean ) as boolean
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return false
    dim as TKCHART_SERIES ptr s = pChart->GetSeries( iSeries )
    if s = 0 then return false
    s->bSmooth = bSmooth
    pChart->Refresh()
    return true
end function

' Hidden = out of the AXIS RANGE too; clears the hot point if it was in that series.
public function tkChart_SetSeriesVisible( byval hChart as TK_WIDGET ptr, byval iSeries as long, byval bVisible as boolean ) as boolean
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return false
    dim as TKCHART_SERIES ptr s = pChart->GetSeries( iSeries )
    if s = 0 then return false
    s->bVisible = bVisible
    if (bVisible = false) andalso (pChart->nHotSeries = iSeries) then pChart->nHotSeries = -1 : pChart->nHotPoint = -1
    pChart->Refresh()
    return true
end function

public function tkChart_IsSeriesVisible( byval hChart as TK_WIDGET ptr, byval iSeries as long ) as boolean
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return false
    dim as TKCHART_SERIES ptr s = pChart->GetSeries( iSeries )
    if s = 0 then return false
    return s->bVisible
end function

' --- points ------------------------------------------------------------------------------------
' The recycled slot is reset in FULL (colour flag, explode) so a second population inherits nothing.
private function CHT_AppendPoint( byval pChart as TKCHART_STATE ptr, byval iSeries as long, byref wszLabel as ustring ) as TKCHART_POINT ptr
    dim as TKCHART_SERIES ptr s = pChart->GetSeries( iSeries )
    if s = 0 then return 0
    s->EnsurePoints( s->pointCount + 1 )
    dim as TKCHART_POINT ptr p = @s->points( s->pointCount )
    with *p
        .Text = wszLabel
        .Value = 0.0 : .OpenVal = 0.0 : .HighVal = 0.0 : .LowVal = 0.0 : .CloseVal = 0.0
        .ItemData = 0
        .bHasColor = false : .PointColor = 0
        .nExplode = 0
        .fStart = 0.0 : .fSweep = 0.0
        .bLabelOut = false : .bLabelHid = false
        tkRect_SetEmpty( .rc )
        .ptPlot.x = 0 : .ptPlot.y = 0
    end with
    s->pointCount += 1
    return p
end function

public function tkChart_AddPoint( byval hChart as TK_WIDGET ptr, byval iSeries as long, byval wszLabel as ustring, byval fValue as double ) as long
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return -1
    dim as TKCHART_POINT ptr p = CHT_AppendPoint( pChart, iSeries, wszLabel )
    if p = 0 then return -1
    p->Value = fValue
    pChart->Refresh()
    return pChart->series(iSeries).pointCount - 1
end function

' A high below its low is swapped; Value carries the close.
public function tkChart_AddHlocPoint( byval hChart as TK_WIDGET ptr, byval iSeries as long, byval wszLabel as ustring, _
                                      byval fOpenVal as double, byval fHighVal as double, byval fLowVal as double, byval fCloseVal as double ) as long
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return -1
    dim as TKCHART_POINT ptr p = CHT_AppendPoint( pChart, iSeries, wszLabel )
    if p = 0 then return -1
    p->OpenVal = fOpenVal
    p->HighVal = fHighVal
    p->LowVal = fLowVal
    p->CloseVal = fCloseVal
    p->Value = fCloseVal
    if p->HighVal < p->LowVal then swap p->HighVal, p->LowVal
    pChart->Refresh()
    return pChart->series(iSeries).pointCount - 1
end function

public function tkChart_GetPointCount( byval hChart as TK_WIDGET ptr, byval iSeries as long ) as long
    dim as TKCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return 0
    dim as TKCHART_SERIES ptr s = pChart->GetSeries( iSeries )
    if s = 0 then return 0
