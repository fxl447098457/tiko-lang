' tkForms -- the base every designed form extends: a window, a layout, the modal and modeless show.
' Generated forms use it; a hand-written one can too. The form's address is kept in its window's
' Tag so event thunks can reach it, which is why a form can never be copied.
#module "tkForms"

#import "../tkHost"
#import "../tkApp" public
#import "../tkLayout" public
using tkHost
using tkPaint
using tkApp
using tkLayout

' ---- captions in another language -----------------------------------------------------------
public type tkForms_TranslateFunc as function( byref key as const ustring, byref text as const ustring ) as ustring

dim shared as tkForms_TranslateFunc gTranslate

' The program's own lookup. With none installed, tkForms_Tr answers with the text it was given.
public sub tkForms_SetTranslator( byval f as tkForms_TranslateFunc )
    gTranslate = f
end sub

public function tkForms_Tr( byref key as const ustring, byref text as const ustring ) as ustring
    if gTranslate then return gTranslate( key, text )
    return text
end function

' The form object a control belongs to, as set by FormBase.OpenWindow. 0 when the control's window
' is gone or is not a designed form, so an event thunk can check before it calls in.
public function tkForms_ObjectOf( byval w as TK_WIDGET ptr ) as any ptr
    dim as TK_FORM ptr f = tkForm_FromWidget( w )
    if (f = 0) orelse f->bDestroyed then return 0
    return f->Tag
end function

private sub OnSizeForm_( byval f as TK_FORM ptr, byval cx as long, byval cy as long )
    dim as any ptr p = f->Tag
    if p then tkLayout_Apply( cast( FormBase ptr, p )->Layout )
end sub

private sub OnScaleForm_( byval f as TK_FORM ptr, byval fOld as single, byval fNew as single )
    dim as any ptr p = f->Tag
    if p then tkLayout_Apply( cast( FormBase ptr, p )->Layout )
end sub

' The window is going, whoever closed it. Nothing in the form is valid to touch after this.
private sub OnDestroyForm_( byval f as TK_FORM ptr )
    dim as FormBase ptr p = cast( FormBase ptr, f->Tag )
    if p then
        p->Wnd = 0
        tkLayout_Destroy( p->Layout )
        p->Layout = 0
    end if
    f->Tag = 0
end sub

public type FormBase extends object
    Wnd as TK_FORM ptr
    Layout as TK_LAYOUT ptr

    declare constructor( )
    declare destructor( )

    ' Creates the window, hidden. cx and cy are design units. owner = 0 makes a top-level window.
    declare sub OpenWindow( byref title as const ustring, byval cx as long, byval cy as long, byval owner as TK_FORM ptr = nullptr )
    declare sub Show( )
    ' Runs until the form is closed. The window is then hidden, not destroyed: controls can still
    ' be read, and the form can be shown again.
    declare function ShowModal( ) as long
    declare sub EndModal( byval code as long )
    declare sub Close( )
    declare function IsOpen( ) as boolean

    private:
    ' Tag holds this object's address: a copy would leave the window pointing at the wrong one.
    declare constructor( byref rhs as const FormBase )
    declare operator let( byref rhs as const FormBase )
end type

constructor FormBase( )
end constructor

destructor FormBase( )
    if Wnd then tkForm_Destroy( Wnd )
end destructor

sub FormBase.OpenWindow( byref title as const ustring, byval cx as long, byval cy as long, byval owner as TK_FORM ptr = nullptr )
    if Wnd then exit sub
    dim as ustring t = title
    Wnd = tkApp_NewForm( t, cx, cy, owner )
    if Wnd = 0 then exit sub
    Wnd->Tag = @this
    Layout = tkLayout_Create( )
    tkForm_OnSize( Wnd, @OnSizeForm_ )
    tkForm_OnScaleChanged( Wnd, @OnScaleForm_ )
    tkForm_OnDestroy( Wnd, @OnDestroyForm_ )
end sub

sub FormBase.Show( )
    if Wnd then tkForm_Show( Wnd )
end sub

function FormBase.ShowModal( ) as long
    if Wnd = 0 then return 0
    return tkForm_ShowModalKeep( Wnd )
end function

sub FormBase.EndModal( byval code as long )
    if Wnd then tkForm_EndModal( Wnd, code )
end sub

sub FormBase.Close( )
    if Wnd then tkForm_Close( Wnd )
end sub

function FormBase.IsOpen( ) as boolean
    return Wnd <> 0
end function
