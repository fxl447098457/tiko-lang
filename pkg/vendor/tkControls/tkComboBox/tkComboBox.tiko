    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if p then p->nListItemHeight = iif( nItemHeight < 1, 1, nItemHeight )
end sub

public function tkComboBox_GetListItemHeight( byval hCombo as TK_WIDGET ptr ) as long
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if p = 0 then return 0
    return p->nListItemHeight
end function

' Rows shown before the list scrolls (PsPlatform's 12).
public sub tkComboBox_SetListMaxRows( byval hCombo as TK_WIDGET ptr, byval nRows as long )
