    if p = 0 then exit sub
    p->nBorderThick = iif( nThickness < 0, 0, nThickness )
    tkWidget_Invalidate( hCombo )
end sub

public sub tkComboBox_GetFocusRing( byval hCombo as TK_WIDGET ptr, byref nGap as long, byref nThickness as long )
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if p = 0 then exit sub
    nGap = p->nFocusGap : nThickness = p->nFocusThick
end sub

' Both change the ideal size: the band is reserved focused or not.
public sub tkComboBox_SetFocusRing( byval hCombo as TK_WIDGET ptr, byval nGap as long, byval nThickness as long )
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if p = 0 then exit sub
    p->nFocusGap = iif( nGap < 0, 0, nGap )
    p->nFocusThick = iif( nThickness < 0, 0, nThickness )
    CbRemeasure( p )
end sub

' Valid BEFORE the control is sized.
public sub tkComboBox_GetIdealSize( byval hCombo as TK_WIDGET ptr, byref nWidth as long, byref nHeight as long )
    nWidth = 0 : nHeight = 0
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if p = 0 then exit sub
    if p->bLayoutDirty then CbLayout( p )
    nWidth = p->nIdealW : nHeight = p->nIdealH
end sub

private function CbGetRect( byval hCombo as TK_WIDGET ptr, byref rc as TKRECT, byval nPart as long ) as boolean
    tkRect_SetEmpty( rc )
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if p = 0 then return false
    if p->bLayoutDirty then CbLayout( p )
    if p->bLayoutDirty then return false
    select case nPart
    case 1 : rc = p->rcText
    case 2 : rc = p->rcChevron
    case 3 : rc = p->rcVisual
    case else : rc = p->rcButton
    end select
    return true
end function

public function tkComboBox_GetButtonRect( byval hCombo as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return CbGetRect( hCombo, rc, 0 )
end function
' TRUE with an EMPTY rect in arrow-only mode.
public function tkComboBox_GetTextRect( byval hCombo as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return CbGetRect( hCombo, rc, 1 )
end function
public function tkComboBox_GetChevronRect( byval hCombo as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return CbGetRect( hCombo, rc, 2 )
end function
public function tkComboBox_GetVisualRect( byval hCombo as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return CbGetRect( hCombo, rc, 3 )
end function

' ---- appearance ----------------------------------------------------------------------------
public sub tkComboBox_GetColors( byval hCombo as TK_WIDGET ptr, byval pColors as TKCOMBOBOX_COLORS ptr )
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if (p = 0) orelse (pColors = 0) then exit sub
    *pColors = p->colors
end sub

' Copies, PINS, and re-derives the list's colours unless they were claimed.
public sub tkComboBox_SetColors( byval hCombo as TK_WIDGET ptr, byval pColors as TKCOMBOBOX_COLORS ptr )
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if (p = 0) orelse (pColors = 0) then exit sub
    p->colors = *pColors
    p->bColorsPinned = true
    CbDeriveListColors( p )
    tkWidget_Invalidate( hCombo )
end sub

public function tkComboBox_ThemeColors( byref t as TKTHEME_COLORS ) as TKCOMBOBOX_COLORS
    dim as TKCOMBOBOX_COLORS c
    c.BackColor = t.Surface : c.ForeColor = t.Text : c.BorderColor = t.Surface : c.ChevronColor = t.Text
    c.BackColorHot = t.SurfaceHot : c.ForeColorHot = t.TextHot : c.BorderColorHot = t.SurfaceHot : c.ChevronColorHot = t.TextHot
    c.BackColorOpen = t.Surface : c.ForeColorOpen = t.Accent : c.BorderColorOpen = t.Surface : c.ChevronColorOpen = t.Accent
    c.BackColorDisabled = t.SurfaceDisabled : c.ForeColorDisabled = t.TextDisabled
    c.BorderColorDisabled = t.SurfaceDisabled : c.ChevronColorDisabled = t.TextDisabled
    c.ForeColorPlaceholder = t.TextDim
    c.FocusRingColor = t.FocusRing
    return c
end function

public sub tkComboBox_ApplyTheme( byval hCombo as TK_WIDGET ptr, byref t as TKTHEME_COLORS )
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if p = 0 then exit sub
    ApplyThemeShape( hCombo )
    if p->bColorsPinned then exit sub
    dim as TKTHEME_COLORS tr = tkTheme_Styled( hCombo, t )
    p->colors = tkComboBox_ThemeColors( tr )
    tkTheme_ResolveInto( hCombo, tr, cast( ulong ptr, @p->colors ), sizeof( TKCOMBOBOX_COLORS ) \ 4, "ComboBox" )
    CbDeriveListColors( p )
    tkWidget_Invalidate( hCombo )
end sub

public sub tkComboBox_UnpinColors( byval hCombo as TK_WIDGET ptr )
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if p = 0 then exit sub
    p->bColorsPinned = false
    tkComboBox_ApplyTheme( hCombo, tkTheme_Of( hCombo ) )
end sub

public function tkComboBox_GetFont( byval hCombo as TK_WIDGET ptr ) as TTF_Font ptr
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if p = 0 then return 0
    return p->pTextFont
end function

' Borrowed. Also the measuring font and the list's font.
public sub tkComboBox_SetFont( byval hCombo as TK_WIDGET ptr, byval f as TTF_Font ptr )
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if p = 0 then exit sub
    p->pTextFont = f
    CbRemeasure( p )
end sub

public sub tkComboBox_ApplyFonts( byval hCombo as TK_WIDGET ptr, byval fText as TTF_Font ptr, byval fGlyph as TTF_Font ptr )
    if fText then tkComboBox_SetFont( hCombo, fText )
end sub

public function tkComboBox_GetPlaceholderText( byval hCombo as TK_WIDGET ptr ) as ustring
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if p = 0 then return ""
    return p->wszPlaceholder
end function

' Never measured: repaint only.
public sub tkComboBox_SetPlaceholderText( byval hCombo as TK_WIDGET ptr, byval Text as ustring )
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if p = 0 then exit sub
    p->wszPlaceholder = Text
    tkWidget_Invalidate( hCombo )
end sub

' ---- callbacks -----------------------------------------------------------------------------
public sub tkComboBox_SetPaintCallback( byval hCombo as TK_WIDGET ptr, byval usersub as CBO_PaintCallbackSub )
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if p = 0 then exit sub
    p->PaintCallback = usersub
    tkWidget_Invalidate( hCombo )
end sub

public sub tkComboBox_SetMessageCallback( byval hCombo as TK_WIDGET ptr, byval userfunc as CBO_MessageCallbackFunc )
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if p then p->MessageCallback = userfunc
end sub

public sub tkComboBox_SetSelChangeCallback( byval hCombo as TK_WIDGET ptr, byval usersub as CBO_SelChangeCallbackSub )
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if p then p->SelChangeCallback = usersub
end sub

public sub tkComboBox_SetDropDownCallback( byval hCombo as TK_WIDGET ptr, byval usersub as CBO_DropDownCallbackSub )
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if p then p->DropDownCallback = usersub
end sub

' ---- EDITABLE mode (Win32's CBS_DROPDOWN) -------------------------------------------------------
' A single-line tkTextBox over the text area: the user may type a value the list does not hold.
' A pick from the list fills it (silently: SelChange reports the pick); typing notifies through
' SetEditChangeCallback, Enter through SetEditEnterCallback; the chevron, F4 and Alt+Down still
' drop the list. The combo itself stops taking focus: the edit does, and the combo shows the ring.
public sub tkComboBox_SetEditable( byval hCombo as TK_WIDGET ptr, byval bEditable as boolean )
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if p = 0 then exit sub
    if bEditable andalso (p->wEdit = 0) then
        p->wEdit = tkTextBox_Create( hCombo, p->id, false )
        tkTextBox_SetFont( p->wEdit, CbFont( p ) )
        tkTextBox_SetBorderWidth( p->wEdit, 0 )
        tkTextBox_SetChangeCallback( p->wEdit, @CbEditChanged )
        tkTextBox_SetEnterPressedCallback( p->wEdit, @CbEditEnter )
        tkTextBox_SetFocusCallback( p->wEdit, @CbEditFocus )
        CbEditColors( p )
        if p->nCurSel >= 0 then tkTextBox_SetText( p->wEdit, p->items(p->nCurSel).wszText )
        hCombo->isFocusable = false
    elseif (bEditable = false) andalso (p->wEdit <> 0) then
        tkWidget_Destroy( p->wEdit )
        p->wEdit = 0
        hCombo->isFocusable = true
    end if
    CbRemeasure( p )
end sub

public function tkComboBox_GetEditable( byval hCombo as TK_WIDGET ptr ) as boolean
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    return (p <> 0) andalso (p->wEdit <> 0)
end function

' The edit's text, set silently. The selection is not changed.
public sub tkComboBox_SetEditText( byval hCombo as TK_WIDGET ptr, byval Text as ustring )
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if (p = 0) orelse (p->wEdit = 0) then exit sub
    tkTextBox_SetText( p->wEdit, Text )
end sub

' The edit (a tkTextBox), for anything the combo does not wrap; 0 when not editable.
public function tkComboBox_GetEditHandle( byval hCombo as TK_WIDGET ptr ) as TK_WIDGET ptr
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if p = 0 then return 0
    return p->wEdit
end function

public sub tkComboBox_SetEditChangeCallback( byval hCombo as TK_WIDGET ptr, byval usersub as CBO_EditCallbackSub )
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if p then p->EditChangeCallback = usersub
end sub

public sub tkComboBox_SetEditEnterCallback( byval hCombo as TK_WIDGET ptr, byval usersub as CBO_EditCallbackSub )
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if p then p->EditEnterCallback = usersub
end sub

' The theme's shape (tkTheme_ShapeOf, design units) unless the host set this control's own --
' its setter pins it. -1 in the theme gives the control's default. Only a change calls the setter.
private sub ApplyThemeShape( byval w as TK_WIDGET ptr )
    dim as TKCOMBOBOX_STATE ptr p = CB( w )
    if (p = 0) orelse p->bShapePinned then exit sub
    dim as TKTHEME_SHAPE sh = tkTheme_ShapeOf( w )
    dim as long v
    v = iif( sh.CornerRadius >= 0, tkHost_Scale( w->pHost, sh.CornerRadius * 2 ), tkHost_Scale( w->pHost, TKCOMBOBOX_DEFAULT_CURVATURE ) )
    if p->nCurvature <> v then tkComboBox_SetCornerCurvature( w, v )
    p->bShapePinned = false
end sub
