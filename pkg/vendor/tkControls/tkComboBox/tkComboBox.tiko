    if p = 0 then return 0
    return p->nCurvature
end function

' A DIAMETER; 0 = square.
public sub tkComboBox_SetCornerCurvature( byval hCombo as TK_WIDGET ptr, byval nCurvature as long )
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if p = 0 then exit sub
    p->nCurvature = iif( nCurvature < 0, 0, nCurvature )
    p->bShapePinned = true
    tkWidget_Invalidate( hCombo )
end sub

