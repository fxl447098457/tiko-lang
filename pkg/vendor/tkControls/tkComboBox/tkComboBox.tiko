public function tkComboBox_GetTextMode( byval hCombo as TK_WIDGET ptr ) as long
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if p = 0 then return CBO_TEXT_ALWAYS
    return p->nTextMode
