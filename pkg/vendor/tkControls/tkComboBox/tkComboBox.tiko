end function

' The control owns its SIZE; the host still owns its position.
public sub tkComboBox_SetAutoSize( byval hCombo as TK_WIDGET ptr, byval bAutoSize as boolean )
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if p = 0 then exit sub
    p->bAutoSize = bAutoSize
    CbApplyAutoSize( p )
end sub

public sub tkComboBox_GetPadding( byval hCombo as TK_WIDGET ptr, byref nLeft as long, byref nTop as long, byref nRight as long, byref nBottom as long )
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if p = 0 then exit sub
    nLeft = p->nPadLeft : nTop = p->nPadTop : nRight = p->nPadRight : nBottom = p->nPadBottom
end sub

public sub tkComboBox_SetPadding( byval hCombo as TK_WIDGET ptr, byval nLeft as long, byval nTop as long, byval nRight as long, byval nBottom as long )
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if p = 0 then exit sub
    p->nPadLeft = iif( nLeft < 0, 0, nLeft ) : p->nPadTop = iif( nTop < 0, 0, nTop )
    p->nPadRight = iif( nRight < 0, 0, nRight ) : p->nPadBottom = iif( nBottom < 0, 0, nBottom )
    CbRemeasure( p )
end sub

public function tkComboBox_GetTextGap( byval hCombo as TK_WIDGET ptr ) as long
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
