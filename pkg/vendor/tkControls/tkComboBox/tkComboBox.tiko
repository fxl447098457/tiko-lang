' Values outside the three constants are ignored.
public sub tkComboBox_SetTextMode( byval hCombo as TK_WIDGET ptr, byval nTextMode as long )
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if p = 0 then exit sub
    select case nTextMode
    case CBO_TEXT_ALWAYS, CBO_TEXT_NEVER, CBO_TEXT_WHENSELECTED
        p->nTextMode = nTextMode
        CbRemeasure( p )
    end select
end sub

' "Is a caption drawn right now", not "what mode is set".
public function tkComboBox_GetShowText( byval hCombo as TK_WIDGET ptr ) as boolean
    dim as TKCOMBOBOX_STATE ptr p = CB( hCombo )
    if p = 0 then return false
    return CbTextVisible( p )
