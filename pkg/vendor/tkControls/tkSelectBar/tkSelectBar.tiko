public function tkSelectBar_GetEnabled( byval hSelectBar as TK_WIDGET ptr, byval idx as long ) as boolean
    dim as TKSELECTBAR_STATE ptr pSel = GetSelectBarPointer( hSelectBar )
    if pSel = 0 then return false
    if pSel->IsValidPanel( idx ) = false then return false
    return pSel->panels(idx).isEnabled
end function

' REFUSED for the current panel. Disabling the hot or pressed one clears that state now.
public function tkSelectBar_SetEnabled( byval hSelectBar as TK_WIDGET ptr, byval idx as long, byval isEnabled as boolean ) as boolean
    dim as TKSELECTBAR_STATE ptr pSel = GetSelectBarPointer( hSelectBar )
    if pSel = 0 then return false
    if pSel->IsValidPanel( idx ) = false then return false
    if (isEnabled = false) andalso (idx = pSel->nCurSel) then return false
    if pSel->panels(idx).isEnabled = isEnabled then return true
    pSel->panels(idx).isEnabled = isEnabled
    if isEnabled = false then
        if pSel->nLastHotIdx = idx then SetHot( pSel, -1 )      ' also moves the tip off it
        if pSel->nPressedIdx = idx then pSel->CancelPress()
    end if
    tkWidget_Invalidate( hSelectBar )
    return true
end function

public function tkSelectBar_GetCurSel( byval hSelectBar as TK_WIDGET ptr ) as long
    dim as TKSELECTBAR_STATE ptr pSel = GetSelectBarPointer( hSelectBar )
    if pSel = 0 then return -1
    return pSel->nCurSel
end function

' SILENT. Rejects -1, an invalid index and a disabled panel; TRUE if already current.
public function tkSelectBar_SetCurSel( byval hSelectBar as TK_WIDGET ptr, byval idx as long ) as boolean
    dim as TKSELECTBAR_STATE ptr pSel = GetSelectBarPointer( hSelectBar )
    if pSel = 0 then return false
    if pSel->IsValidPanel( idx ) = false then return false
    if pSel->panels(idx).isEnabled = false then return false
    if pSel->nCurSel = idx then return true
    pSel->nCurSel = idx
    tkWidget_Invalidate( hSelectBar )
    return true
end function

' ---- layout (raw pixels) ---------------------------------------------------------------------
public sub tkSelectBar_GetPadding( byval hSelectBar as TK_WIDGET ptr, byref nPadLeft as long, byref nPadRight as long )
    nPadLeft = 0 : nPadRight = 0
    dim as TKSELECTBAR_STATE ptr pSel = GetSelectBarPointer( hSelectBar )
    if pSel = 0 then exit sub
    nPadLeft = pSel->nPadLeft : nPadRight = pSel->nPadRight
end sub

public sub tkSelectBar_SetPadding( byval hSelectBar as TK_WIDGET ptr, byval nPadLeft as long, byval nPadRight as long )
    dim as TKSELECTBAR_STATE ptr pSel = GetSelectBarPointer( hSelectBar )
    if pSel = 0 then exit sub
    pSel->nPadLeft = iif( nPadLeft < 0, 0, nPadLeft )
    pSel->nPadRight = iif( nPadRight < 0, 0, nPadRight )
    pSel->Refresh()
end sub

' -1 on either side inherits the bar's; below -1 clamps to -1.
public function tkSelectBar_SetPanelPadding( byval hSelectBar as TK_WIDGET ptr, byval idx as long, _
                                             byval nPadLeft as long, byval nPadRight as long ) as boolean
    dim as TKSELECTBAR_STATE ptr pSel = GetSelectBarPointer( hSelectBar )
    if pSel = 0 then return false
    if pSel->IsValidPanel( idx ) = false then return false
    pSel->panels(idx).nPadLeft = iif( nPadLeft < -1, -1, nPadLeft )
    pSel->panels(idx).nPadRight = iif( nPadRight < -1, -1, nPadRight )
    pSel->Refresh()
    return true
end function

public sub tkSelectBar_GetIndicator( byval hSelectBar as TK_WIDGET ptr, byref nThickness as long, byref nGap as long )
    nThickness = 0 : nGap = 0
    dim as TKSELECTBAR_STATE ptr pSel = GetSelectBarPointer( hSelectBar )
    if pSel = 0 then exit sub
    nThickness = pSel->nIndicatorHeight : nGap = pSel->nIndicatorGap
end sub

' BOTH are layout inputs: the centred block is text + gap + thickness.
public sub tkSelectBar_SetIndicator( byval hSelectBar as TK_WIDGET ptr, byval nThickness as long, byval nGap as long )
    dim as TKSELECTBAR_STATE ptr pSel = GetSelectBarPointer( hSelectBar )
    if pSel = 0 then exit sub
    pSel->nIndicatorHeight = iif( nThickness < 0, 0, nThickness )
    pSel->nIndicatorGap = iif( nGap < 0, 0, nGap )
    pSel->Refresh()
end sub

private function GetPart( byval hSelectBar as TK_WIDGET ptr, byval idx as long, byval nPart as long, byref rc as TKRECT ) as boolean
    tkRect_SetEmpty( rc )
    dim as TKSELECTBAR_STATE ptr pSel = GetSelectBarPointer( hSelectBar )
    if pSel = 0 then return false
    if pSel->IsValidPanel( idx ) = false then return false
    if pSel->bLayoutDirty then pSel->LayoutPanels()
    select case nPart
    case 1 : rc = pSel->panels(idx).rcText
    case 2 : rc = pSel->panels(idx).rcIndicator
    case else : rc = pSel->panels(idx).rc
    end select
    return true
end function

public function tkSelectBar_GetPanelRect( byval hSelectBar as TK_WIDGET ptr, byval idx as long, byref rc as TKRECT ) as boolean
    return GetPart( hSelectBar, idx, 0, rc )
end function

public function tkSelectBar_GetPanelTextRect( byval hSelectBar as TK_WIDGET ptr, byval idx as long, byref rc as TKRECT ) as boolean
    return GetPart( hSelectBar, idx, 1, rc )
end function

public function tkSelectBar_GetPanelIndicatorRect( byval hSelectBar as TK_WIDGET ptr, byval idx as long, byref rc as TKRECT ) as boolean
    return GetPart( hSelectBar, idx, 2, rc )
end function

' Valid before the bar has ever been sized.
public function tkSelectBar_GetIdealWidth( byval hSelectBar as TK_WIDGET ptr ) as long
    dim as TKSELECTBAR_STATE ptr pSel = GetSelectBarPointer( hSelectBar )
    if pSel = 0 then return 0
    if pSel->bLayoutDirty then pSel->LayoutPanels()
    return pSel->nTotalWidth
end function

' ---- appearance ------------------------------------------------------------------------------
public sub tkSelectBar_GetColors( byval hSelectBar as TK_WIDGET ptr, byval pColors as TKSELECTBAR_COLORS ptr )
    if pColors = 0 then exit sub
    dim as TKSELECTBAR_STATE ptr pSel = GetSelectBarPointer( hSelectBar )
    if pSel = 0 then exit sub
    *pColors = pSel->colors
end sub

' Copies the struct and PINS it: a theme change leaves this bar alone until UnpinColors.
public sub tkSelectBar_SetColors( byval hSelectBar as TK_WIDGET ptr, byval pColors as TKSELECTBAR_COLORS ptr )
    if pColors = 0 then exit sub
    dim as TKSELECTBAR_STATE ptr pSel = GetSelectBarPointer( hSelectBar )
    if pSel = 0 then exit sub
    pSel->colors = *pColors
    pSel->bColorsPinned = true
    tkWidget_Invalidate( hSelectBar )
end sub

' The bar's colours from the theme's roles (vendor PsSelectBar_ThemeColors, + the focus ring).
public function tkSelectBar_ThemeColors( byref t as TKTHEME_COLORS ) as TKSELECTBAR_COLORS
    dim as TKSELECTBAR_COLORS c
    c.BackColor         = t.Window
    c.ForeColor         = t.TextDim
    c.BackColorHot      = t.Window
    c.ForeColorHot      = t.TextHot
    c.BackColorSelect   = t.Window
    c.ForeColorSelect   = t.TextStrong
    c.ForeColorDisabled = t.TextDisabled
    c.IndicatorColor    = t.TextStrong
    c.FocusRingColor    = t.FocusRing
    return c
end function

public sub tkSelectBar_ApplyTheme( byval hSelectBar as TK_WIDGET ptr, byref t as TKTHEME_COLORS )
    dim as TKSELECTBAR_STATE ptr pSel = GetSelectBarPointer( hSelectBar )
    if (pSel = 0) orelse pSel->bColorsPinned then exit sub
    dim as TKTHEME_COLORS tr = tkTheme_Styled( hSelectBar, t )
    pSel->colors = tkSelectBar_ThemeColors( tr )
    tkTheme_ResolveInto( hSelectBar, tr, cast( ulong ptr, @pSel->colors ), sizeof( TKSELECTBAR_COLORS ) \ 4, "SelectBar" )
    tkWidget_Invalidate( hSelectBar )
end sub

public sub tkSelectBar_UnpinColors( byval hSelectBar as TK_WIDGET ptr )
    dim as TKSELECTBAR_STATE ptr pSel = GetSelectBarPointer( hSelectBar )
    if pSel = 0 then exit sub
    pSel->bColorsPinned = false
    tkSelectBar_ApplyTheme( hSelectBar, tkTheme_Of( hSelectBar ) )
end sub

public function tkSelectBar_GetFont( byval hSelectBar as TK_WIDGET ptr ) as TTF_Font ptr
    dim as TKSELECTBAR_STATE ptr pSel = GetSelectBarPointer( hSelectBar )
    if pSel = 0 then return 0
    return pSel->pPanelFont
end function

' The measuring AND drawing font, borrowed. Re-lays out the whole bar.
public function tkSelectBar_SetFont( byval hSelectBar as TK_WIDGET ptr, byval f as TTF_Font ptr ) as boolean
    dim as TKSELECTBAR_STATE ptr pSel = GetSelectBarPointer( hSelectBar )
    if pSel = 0 then return false
    pSel->pPanelFont = f
    pSel->Refresh()
    return true
end function

' The form's fonts: the bar has no glyph font, so fGlyph is ignored; 0 keeps the current one.
public sub tkSelectBar_ApplyFonts( byval hSelectBar as TK_WIDGET ptr, byval fText as TTF_Font ptr, byval fGlyph as TTF_Font ptr )
    if fText then tkSelectBar_SetFont( hSelectBar, fText )
end sub

