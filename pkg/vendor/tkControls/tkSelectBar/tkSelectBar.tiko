' The ONE text height the layout uses (tmHeight's analogue).
public function tkSelectBar_GetTextHeight( byval hSelectBar as TK_WIDGET ptr ) as long
    dim as TKSELECTBAR_STATE ptr pSel = GetSelectBarPointer( hSelectBar )
    if pSel = 0 then return 0
    if pSel->bLayoutDirty then pSel->LayoutPanels()
