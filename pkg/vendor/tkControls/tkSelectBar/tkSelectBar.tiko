    dim as TKSELECTBAR_STATE ptr pSel = GetSelectBarPointer( hSelectBar )
    if pSel = 0 then return 0
    if pSel->IsValidPanel( idx ) = false then return 0
    return pSel->panels(idx).id
end function

public function tkSelectBar_SetPanelID( byval hSelectBar as TK_WIDGET ptr, byval idx as long, byval id as long ) as boolean
    dim as TKSELECTBAR_STATE ptr pSel = GetSelectBarPointer( hSelectBar )
    if pSel = 0 then return false
    if pSel->IsValidPanel( idx ) = false then return false
    pSel->panels(idx).id = id
    return true
end function

public function tkSelectBar_GetItemData( byval hSelectBar as TK_WIDGET ptr, byval idx as long ) as integer
    dim as TKSELECTBAR_STATE ptr pSel = GetSelectBarPointer( hSelectBar )
    if pSel = 0 then return 0
    if pSel->IsValidPanel( idx ) = false then return 0
    return pSel->panels(idx).itemData
end function

public function tkSelectBar_SetItemData( byval hSelectBar as TK_WIDGET ptr, byval idx as long, byval itemData as integer ) as boolean
    dim as TKSELECTBAR_STATE ptr pSel = GetSelectBarPointer( hSelectBar )
    if pSel = 0 then return false
    if pSel->IsValidPanel( idx ) = false then return false
    pSel->panels(idx).itemData = itemData
    return true
