public function tkColumnHeader_GetHotColumn( byval hHeader as TK_WIDGET ptr ) as integer
    dim as TKCOLUMNHEADER_STATE ptr p = HD( hHeader )
    if p = 0 then return -1
    return p->nLastHotIdx
end function

public function tkColumnHeader_GetHotDivider( byval hHeader as TK_WIDGET ptr ) as integer
    dim as TKCOLUMNHEADER_STATE ptr p = HD( hHeader )
    if p = 0 then return -1
    return p->nHotDividerIdx
end function

public function tkColumnHeader_GetPressedColumn( byval hHeader as TK_WIDGET ptr ) as integer
    dim as TKCOLUMNHEADER_STATE ptr p = HD( hHeader )
    if p = 0 then return -1
    return p->nPressedIdx
end function

public function tkColumnHeader_GetDragColumn( byval hHeader as TK_WIDGET ptr ) as integer
    dim as TKCOLUMNHEADER_STATE ptr p = HD( hHeader )
    if p = 0 then return -1
    return p->nDragDividerIdx
end function

' ---- the sort indicator (the built-in painter draws it; the control never sorts) -------------
public sub tkColumnHeader_SetSortColumn( byval hHeader as TK_WIDGET ptr, byval idx as integer, byval nDir as long )
    dim as TKCOLUMNHEADER_STATE ptr p = HD( hHeader )
    if p = 0 then exit sub
    if (HdValid( p, idx ) = false) orelse (nDir = HDR_SORT_NONE) then
        p->nSortCol = -1 : p->nSortDir = HDR_SORT_NONE
    else
        p->nSortCol = idx : p->nSortDir = iif( nDir = HDR_SORT_DESC, HDR_SORT_DESC, HDR_SORT_ASC )
    end if
    tkWidget_Invalidate( hHeader )
end sub

public function tkColumnHeader_GetSortColumn( byval hHeader as TK_WIDGET ptr ) as integer
    dim as TKCOLUMNHEADER_STATE ptr p = HD( hHeader )
    if p = 0 then return -1
    return p->nSortCol
end function

public function tkColumnHeader_GetSortDirection( byval hHeader as TK_WIDGET ptr ) as long
    dim as TKCOLUMNHEADER_STATE ptr p = HD( hHeader )
    if p = 0 then return HDR_SORT_NONE
    return p->nSortDir
end function

' The built-in painter, for a paint callback that wants to draw on top of it.
public sub tkColumnHeader_PaintColumnDefault( byval pi as TKCOLUMNHEADER_PAINTINFO ptr )
    if pi = 0 then exit sub
    dim as TKCOLUMNHEADER_STATE ptr p = HD( pi->hHeader )
    if p then HdPaintDefault( p, pi )
end sub

' ---- appearance --------------------------------------------------------------------------------
public function tkColumnHeader_GetBackColor( byval hHeader as TK_WIDGET ptr ) as ulong
    dim as TKCOLUMNHEADER_STATE ptr p = HD( hHeader )
    if p = 0 then return 0
    return p->colors.BackColor
end function

' Repaints, PINS and returns the previous value.
public function tkColumnHeader_SetBackColor( byval hHeader as TK_WIDGET ptr, byval clr as ulong ) as ulong
    dim as TKCOLUMNHEADER_STATE ptr p = HD( hHeader )
    if p = 0 then return 0
    dim as ulong old = p->colors.BackColor
    p->colors.BackColor = clr
    p->bColorsPinned = true
    tkWidget_Invalidate( hHeader )
    return old
end function

public sub tkColumnHeader_GetColors( byval hHeader as TK_WIDGET ptr, byval pColors as TKCOLUMNHEADER_COLORS ptr )
    dim as TKCOLUMNHEADER_STATE ptr p = HD( hHeader )
    if (p = 0) orelse (pColors = 0) then exit sub
    *pColors = p->colors
end sub

public sub tkColumnHeader_SetColors( byval hHeader as TK_WIDGET ptr, byval pColors as TKCOLUMNHEADER_COLORS ptr )
    dim as TKCOLUMNHEADER_STATE ptr p = HD( hHeader )
    if (p = 0) orelse (pColors = 0) then exit sub
    p->colors = *pColors
    p->bColorsPinned = true
    tkWidget_Invalidate( hHeader )
end sub

public function tkColumnHeader_ThemeColors( byref t as TKTHEME_COLORS ) as TKCOLUMNHEADER_COLORS
    dim as TKCOLUMNHEADER_COLORS c
    c.BackColor = t.Surface                    ' vendor's one role
    c.BackColorHot = t.SurfaceHot
    c.BackColorPressed = t.Selected
    c.ForeColor = t.TextDim                    ' PsPlatform: a header caption is secondary text
    c.ForeColorHot = t.TextHot
    c.ForeColorPressed = t.SelectedText
    c.DividerColor = t.Border
    c.DividerColorHot = t.FocusRing
    c.SortMarkColor = t.Accent
    return c
end function

public sub tkColumnHeader_ApplyTheme( byval hHeader as TK_WIDGET ptr, byref t as TKTHEME_COLORS )
    dim as TKCOLUMNHEADER_STATE ptr p = HD( hHeader )
    if (p = 0) orelse p->bColorsPinned then exit sub
    dim as TKTHEME_COLORS tr = tkTheme_Styled( hHeader, t )
    p->colors = tkColumnHeader_ThemeColors( tr )
    tkTheme_ResolveInto( hHeader, tr, cast( ulong ptr, @p->colors ), sizeof( TKCOLUMNHEADER_COLORS ) \ 4, "ColumnHeader" )
    tkWidget_Invalidate( hHeader )
end sub

public sub tkColumnHeader_UnpinColors( byval hHeader as TK_WIDGET ptr )
    dim as TKCOLUMNHEADER_STATE ptr p = HD( hHeader )
    if p = 0 then exit sub
    p->bColorsPinned = false
    tkColumnHeader_ApplyTheme( hHeader, tkTheme_Of( hHeader ) )
end sub

public function tkColumnHeader_GetFont( byval hHeader as TK_WIDGET ptr ) as TTF_Font ptr
    dim as TKCOLUMNHEADER_STATE ptr p = HD( hHeader )
    if p = 0 then return 0
    return p->pFont
end function

' Borrowed. Drives no layout.
public function tkColumnHeader_SetFont( byval hHeader as TK_WIDGET ptr, byval f as TTF_Font ptr ) as boolean
    dim as TKCOLUMNHEADER_STATE ptr p = HD( hHeader )
    if p = 0 then return false
    p->pFont = f
    tkWidget_Invalidate( hHeader )
    return true
end function

public sub tkColumnHeader_ApplyFonts( byval hHeader as TK_WIDGET ptr, byval fText as TTF_Font ptr, byval fGlyph as TTF_Font ptr )
    if fText then tkColumnHeader_SetFont( hHeader, fText )
end sub

' ---- tooltips (tkTipHost: one tip, its text resolved per hot column) ---------------------------
public function tkColumnHeader_GetTooltipHandle( byval hHeader as TK_WIDGET ptr ) as TK_TIP ptr
