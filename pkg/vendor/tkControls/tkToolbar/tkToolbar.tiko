' -1 goes back to inheriting.
public function tkToolbar_SetItemPadding( byval hToolbar as TK_WIDGET ptr, byval idx as long, byval nPadBefore as long, byval nPadAfter as long ) as boolean
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if (pTB = 0) orelse (pTB->IsValidItem( idx ) = false) then return false
    pTB->items(idx).nPadBefore = nPadBefore
    pTB->items(idx).nPadAfter = nPadAfter
    pTB->Refresh()
    return true
end function

' 0 goes back to inheriting.
public function tkToolbar_SetItemIconSize( byval hToolbar as TK_WIDGET ptr, byval idx as long, byval nIconWidth as long, byval nIconHeight as long ) as boolean
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if (pTB = 0) orelse (pTB->IsValidItem( idx ) = false) then return false
    pTB->items(idx).nIconWidth = nIconWidth
    pTB->items(idx).nIconHeight = nIconHeight
    pTB->Refresh()
