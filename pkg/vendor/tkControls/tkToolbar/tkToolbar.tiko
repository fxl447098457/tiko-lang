    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if pTB then pTB->DropDownCallback = usersub
end sub

' ---- render probes: the WHOLE bar rendered through the paint path, one part read back ----
private function PartRect( byval pTB as TKTOOLBAR_STATE ptr, byval nPart as long, byval idx as long ) as TKRECT
    dim as TKRECT rc
    if nPart = TBR_PART_TOOLBAR then tkRect_Set( rc, 0, 0, pTB->hWin->cw, pTB->hWin->ch ) : return rc
    if idx = -1 then
        if (nPart = TBR_PART_CHEVRON) orelse (nPart = TBR_PART_ITEM) then return pTB->rcOverflow
        return rc
    end if
    if pTB->IsValidItem( idx ) = false then return rc
    select case nPart
    case TBR_PART_ITEM : rc = pTB->items(idx).rc
    case TBR_PART_ICON : rc = pTB->items(idx).rcIcon
    case TBR_PART_TEXT : rc = pTB->items(idx).rcText
    case TBR_PART_CHEVRON : rc = pTB->items(idx).rcChevron
    end select
    return rc
end function

private function RenderPart( byval hToolbar as TK_WIDGET ptr, byval nPart as long, byval idx as long ) as SDL_Surface ptr
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if pTB = 0 then return 0
    if EnsureLayout( pTB ) = false then return 0
    dim as TKRECT rc = PartRect( pTB, nPart, idx )
    if rc.left < 0 then rc.left = 0
    if rc.top < 0 then rc.top = 0
    if rc.right > hToolbar->cw then rc.right = hToolbar->cw
    if rc.bottom > hToolbar->ch then rc.bottom = hToolbar->ch
    if tkRect_IsEmpty( rc ) then return 0
    dim as TK_HOST ptr h = hToolbar->pHost
    dim as TKRECT a
    tkWidget_AbsRect( hToolbar, a )
    dim as TK_PAINT wp
    wp.renderer = h->renderer
    wp.engine = h->engine
    wp.pFont = h->pDefaultFont
    wp.fScale = h->fScale
    wp.Begin( a.left, a.top, hToolbar->cw, hToolbar->ch )
    RenderAll( pTB, @wp )
    SDL_SetRenderClipRect( h->renderer, 0 )
    dim as SDL_Rect r
    r.x = a.left + rc.left : r.y = a.top + rc.top : r.w = rc.right - rc.left : r.h = rc.bottom - rc.top
    dim as SDL_Surface ptr s0 = SDL_RenderReadPixels( h->renderer, @r )
    h->bDirty = true
    if s0 = 0 then return 0
    dim as SDL_Surface ptr s = SDL_ConvertSurface( s0, SDL_PIXELFORMAT_ARGB8888 )
    SDL_DestroySurface( s0 )
    return s
end function

' Distinct colours (capped at 256) inside one TBR_PART_* rect.
public function tkToolbar_CountRenderedTones( byval hToolbar as TK_WIDGET ptr, byval nPart as long, byval idx as long ) as long
    dim as SDL_Surface ptr s = RenderPart( hToolbar, nPart, idx )
    if s = 0 then return 0
    dim tones(0 to 255) as ulong
    dim as long n = 0
    for y as long = 0 to s->h - 1
        dim as ulong ptr row = cast( ulong ptr, cast( ubyte ptr, s->pixels ) + y * s->pitch )
        for x as long = 0 to s->w - 1
            dim as ulong c = row[x] and &h00FFFFFFul
            dim as boolean bFound = false
            for t as long = 0 to n - 1
                if tones(t) = c then bFound = true : exit for
            next
            if (bFound = false) andalso (n < 256) then tones(n) = c : n += 1
        next
    next
    SDL_DestroySurface( s )
    return n
end function

' FNV-1a of the same rect's RGB.
public function tkToolbar_HashRenderedPart( byval hToolbar as TK_WIDGET ptr, byval nPart as long, byval idx as long ) as ulong
    dim as SDL_Surface ptr s = RenderPart( hToolbar, nPart, idx )
    if s = 0 then return 0
    dim as ulong hv = &h811C9DC5ul
    for y as long = 0 to s->h - 1
        dim as ubyte ptr row = cast( ubyte ptr, s->pixels ) + y * s->pitch
        for x as long = 0 to s->w * 4 - 1
            if (x and 3) = 3 then continue for
            hv = (hv xor row[x]) * &h01000193ul
        next
    next
    SDL_DestroySurface( s )
    return hv
end function

' The theme's shape (tkTheme_ShapeOf, design units) unless the host set this control's own --
' its setter pins it. -1 in the theme gives the control's default. Only a change calls the setter.
private sub ApplyThemeShape( byval w as TK_WIDGET ptr )
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( w )
    if (pTB = 0) orelse pTB->bShapePinned then exit sub
    dim as TKTHEME_SHAPE sh = tkTheme_ShapeOf( w )
    dim as long v
    v = iif( sh.CornerRadius >= 0, tkHost_Scale( w->pHost, sh.CornerRadius * 2 ), tkHost_Scale( w->pHost, TKTOOLBAR_DEFAULT_CURVATURE ) )
    if pTB->nCurvature <> v then tkToolbar_SetCornerCurvature( w, v )
    pTB->bShapePinned = false
end sub
