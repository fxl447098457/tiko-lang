    if pTB then tkTipHost_SetDelay( @pTB->tip, TK_TIPDELAY_AUTOPOP, milliseconds )
end sub

public sub tkToolbar_SetReshowTime( byval hToolbar as TK_WIDGET ptr, byval milliseconds as long )
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if pTB then tkTipHost_SetDelay( @pTB->tip, TK_TIPDELAY_RESHOW, milliseconds )
end sub

' The hovered item (-1 for none, or over the overflow button) -- tk addition, for state queries.
public function tkToolbar_GetHotItem( byval hToolbar as TK_WIDGET ptr, byref nZone as long ) as long
    nZone = TBR_ZONE_NONE
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
