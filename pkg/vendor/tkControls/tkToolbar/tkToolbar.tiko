    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if (pTB = 0) orelse (pTB->IsValidItem( idx ) = false) then return false
    if nControlWidth >= 0 then pTB->items(idx).nControlWidth = nControlWidth
    if nControlHeight >= 0 then pTB->items(idx).nControlHeight = nControlHeight
    pTB->Refresh()
    return true
end function

private function ItemPart( byval hToolbar as TK_WIDGET ptr, byval idx as long, byval nPart as long, byref rc as TKRECT ) as boolean
    tkRect_SetEmpty( rc )
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if pTB = 0 then return false
    EnsureLayout( pTB )
    if pTB->IsValidItem( idx ) = false then return false
    select case nPart
    case TBR_PART_ITEM : rc = pTB->items(idx).rc
    case TBR_PART_ICON : rc = pTB->items(idx).rcIcon
    case TBR_PART_TEXT : rc = pTB->items(idx).rcText
    case TBR_PART_CHEVRON : rc = pTB->items(idx).rcChevron
    end select
    return true
end function

' The whole cell; empty for a hidden, overflowed or trimmed item.
public function tkToolbar_GetItemRect( byval hToolbar as TK_WIDGET ptr, byval idx as long, byref rc as TKRECT ) as boolean
    return ItemPart( hToolbar, idx, TBR_PART_ITEM, rc )
end function
public function tkToolbar_GetItemIconRect( byval hToolbar as TK_WIDGET ptr, byval idx as long, byref rc as TKRECT ) as boolean
    return ItemPart( hToolbar, idx, TBR_PART_ICON, rc )
end function
public function tkToolbar_GetItemTextRect( byval hToolbar as TK_WIDGET ptr, byval idx as long, byref rc as TKRECT ) as boolean
    return ItemPart( hToolbar, idx, TBR_PART_TEXT, rc )
end function
public function tkToolbar_GetItemChevronRect( byval hToolbar as TK_WIDGET ptr, byval idx as long, byref rc as TKRECT ) as boolean
    return ItemPart( hToolbar, idx, TBR_PART_CHEVRON, rc )
end function

public function tkToolbar_GetOverflowRect( byval hToolbar as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    tkRect_SetEmpty( rc )
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if pTB = 0 then return false
    EnsureLayout( pTB )
    if pTB->bNeedOverflow = false then return false
    rc = pTB->rcOverflow
    return true
end function

' Valid BEFORE the bar has been sized.
public sub tkToolbar_GetIdealSize( byval hToolbar as TK_WIDGET ptr, byref nWidth as long, byref nHeight as long )
    nWidth = 0 : nHeight = 0
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if pTB = 0 then exit sub
    if pTB->bLayoutDirty then pTB->LayoutItems()
    nWidth = pTB->nTotalWidth : nHeight = pTB->nIdealHeight
end sub

public function tkToolbar_GetIdealWidth( byval hToolbar as TK_WIDGET ptr ) as long
    dim as long w, hh
    tkToolbar_GetIdealSize( hToolbar, w, hh )
    return w
end function

public function tkToolbar_IsItemOverflowed( byval hToolbar as TK_WIDGET ptr, byval idx as long ) as boolean
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if pTB = 0 then return false
    EnsureLayout( pTB )
    if pTB->IsValidItem( idx ) = false then return false
    return pTB->items(idx).bOverflowed
end function

public function tkToolbar_GetOverflowCount( byval hToolbar as TK_WIDGET ptr ) as long
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if pTB = 0 then return 0
    EnsureLayout( pTB )
    dim as long n = 0
    for i as long = 0 to pTB->itemCount - 1
        if pTB->items(i).isVisible andalso pTB->items(i).bOverflowed andalso (pTB->items(i).bTrimmed = false) then n += 1
    next
    return n
end function

' ---- appearance ----
public sub tkToolbar_GetColors( byval hToolbar as TK_WIDGET ptr, byval pColors as TKTOOLBAR_COLORS ptr )
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if (pTB = 0) orelse (pColors = 0) then exit sub
    *pColors = pTB->colors
end sub

' PINS; re-themes every owned menu too (unless the menus were claimed).
public sub tkToolbar_SetColors( byval hToolbar as TK_WIDGET ptr, byval pColors as TKTOOLBAR_COLORS ptr )
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if (pTB = 0) orelse (pColors = 0) then exit sub
    pTB->colors = *pColors
    pTB->bColorsPinned = true
    ReapplyAllMenuColors( pTB )
    tkWidget_Invalidate( hToolbar )
end sub

public function tkToolbar_ThemeColors( byref t as TKTHEME_COLORS ) as TKTOOLBAR_COLORS
    dim as TKTOOLBAR_COLORS c
    c.BackColor = t.Window
    c.ForeColor = t.Text
    c.BackColorHot = t.SurfaceHot
    c.ForeColorHot = t.TextHot
    c.BackColorSelect = t.Selected
    c.ForeColorSelect = t.SelectedText
    c.ForeColorDisabled = t.TextDisabled
    c.SeparatorColor = t.Divider
    c.SplitDividerColor = t.Divider
    return c
end function

public sub tkToolbar_ApplyTheme( byval hToolbar as TK_WIDGET ptr, byref t as TKTHEME_COLORS )
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if pTB = 0 then exit sub
    ApplyThemeShape( hToolbar )
    if pTB->bColorsPinned then exit sub
    dim as TKTHEME_COLORS tr = tkTheme_Styled( hToolbar, t )
    pTB->colors = tkToolbar_ThemeColors( tr )
    tkTheme_ResolveInto( hToolbar, tr, cast( ulong ptr, @pTB->colors ), sizeof( TKTOOLBAR_COLORS ) \ 4, "Toolbar" )
    ReapplyAllMenuColors( pTB )
    tkWidget_Invalidate( hToolbar )
end sub

public sub tkToolbar_UnpinColors( byval hToolbar as TK_WIDGET ptr )
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if pTB = 0 then exit sub
    pTB->bColorsPinned = false
    tkToolbar_ApplyTheme( hToolbar, tkTheme_Of( hToolbar ) )
end sub

public function tkToolbar_SetItemForeColor( byval hToolbar as TK_WIDGET ptr, byval idx as long, byval clr as ulong ) as boolean
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if (pTB = 0) orelse (pTB->IsValidItem( idx ) = false) then return false
    pTB->items(idx).ForeColorItem = clr
    pTB->items(idx).bHasForeColor = true
    tkWidget_Invalidate( hToolbar )
    return true
end function

public function tkToolbar_ClearItemForeColor( byval hToolbar as TK_WIDGET ptr, byval idx as long ) as boolean
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if (pTB = 0) orelse (pTB->IsValidItem( idx ) = false) then return false
    pTB->items(idx).bHasForeColor = false
    tkWidget_Invalidate( hToolbar )
    return true
end function

public function tkToolbar_GetTextFont( byval hToolbar as TK_WIDGET ptr ) as TTF_Font ptr
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if pTB = 0 then return 0
    return pTB->pTextFont
end function

' A LAYOUT input; re-applied to the owned menus.
public function tkToolbar_SetTextFont( byval hToolbar as TK_WIDGET ptr, byval f as TTF_Font ptr ) as boolean
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if pTB = 0 then return false
    pTB->pTextFont = f
    if pTB->hOverflowMenu then tkPopupMenu_SetFonts( pTB->hOverflowMenu, pTB->pTextFont, pTB->pGlyphFont )
    for i as long = 0 to pTB->itemCount - 1
        if pTB->items(i).hMenu then tkPopupMenu_SetFonts( pTB->items(i).hMenu, pTB->pTextFont, pTB->pGlyphFont )
    next
    pTB->Refresh()
    return true
end function

public function tkToolbar_GetGlyphFont( byval hToolbar as TK_WIDGET ptr ) as TTF_Font ptr
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if pTB = 0 then return 0
    return pTB->pGlyphFont
end function

' Paint-time only: repaints, never re-lays out.
public function tkToolbar_SetGlyphFont( byval hToolbar as TK_WIDGET ptr, byval f as TTF_Font ptr ) as boolean
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if pTB = 0 then return false
    pTB->pGlyphFont = f
    tkWidget_Invalidate( hToolbar )
    return true
end function

public sub tkToolbar_ApplyFonts( byval hToolbar as TK_WIDGET ptr, byval fText as TTF_Font ptr, byval fGlyph as TTF_Font ptr )
    if fText then tkToolbar_SetTextFont( hToolbar, fText )
    if fGlyph then tkToolbar_SetGlyphFont( hToolbar, fGlyph )
end sub

public sub tkToolbar_GetGlyphs( byval hToolbar as TK_WIDGET ptr, byref wszChevron as ustring, byref wszOverflow as ustring )
    wszChevron = "" : wszOverflow = ""
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if pTB = 0 then exit sub
    wszChevron = pTB->wszChevron : wszOverflow = pTB->wszOverflow
end sub

public sub tkToolbar_SetGlyphs( byval hToolbar as TK_WIDGET ptr, byval wszChevron as ustring, byval wszOverflow as ustring )
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if pTB = 0 then exit sub
    pTB->wszChevron = wszChevron : pTB->wszOverflow = wszOverflow
    tkWidget_Invalidate( hToolbar )
end sub

' ---- menus ----
' Created on first call, owned by the toolbar. Handle its rows with tkPopupMenu_SetSelectCallback.
public function tkToolbar_GetItemMenu( byval hToolbar as TK_WIDGET ptr, byval idx as long ) as TK_MENU ptr
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if pTB = 0 then return 0
    return EnsureItemMenu( pTB, idx )
end function

' For theming only: its rows are rebuilt per open.
public function tkToolbar_GetOverflowMenu( byval hToolbar as TK_WIDGET ptr ) as TK_MENU ptr
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if pTB = 0 then return 0
    return EnsureOverflowMenu( pTB )
end function

' Claims the palette of every owned menu, present and future.
public sub tkToolbar_SetMenuColors( byval hToolbar as TK_WIDGET ptr, byval pColors as TKPOPUPMENU_COLORS ptr )
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if (pTB = 0) orelse (pColors = 0) then exit sub
    pTB->bMenuColorsCustom = true
    pTB->menuColors = *pColors
    pTB->bColorsPinned = true
    ReapplyAllMenuColors( pTB )
end sub

public function tkToolbar_IsDroppedDown( byval hToolbar as TK_WIDGET ptr ) as boolean
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if pTB = 0 then return false
    Resync( pTB )
    return (pTB->nDroppedIdx <> -1) orelse pTB->bOverflowOpen
end function

' -1 for the overflow menu OR for nothing (pair with IsDroppedDown).
public function tkToolbar_GetDroppedItem( byval hToolbar as TK_WIDGET ptr ) as long
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if pTB = 0 then return -1
    Resync( pTB )
    return pTB->nDroppedIdx
end function

' idx = -1 opens the overflow menu. Fires the DropDown callback.
public function tkToolbar_DropDown( byval hToolbar as TK_WIDGET ptr, byval idx as long ) as boolean
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if pTB = 0 then return false
    return OpenMenu( pTB, idx )
end function

' Closes whatever is open and fires the closing edge.
public sub tkToolbar_CloseUp( byval hToolbar as TK_WIDGET ptr )
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if pTB = 0 then exit sub
    dim as TK_MENU ptr hOpen = 0
    if pTB->bOverflowOpen then
        hOpen = pTB->hOverflowMenu
    elseif pTB->IsValidItem( pTB->nDroppedIdx ) then
        hOpen = pTB->items(pTB->nDroppedIdx).hMenu
    end if
    if hOpen then tkPopupMenu_CloseChain( hOpen )
    ClearDropState( pTB )
end sub

' ---- tooltips ----
public function tkToolbar_GetTooltipText( byval hToolbar as TK_WIDGET ptr, byval idx as long ) as ustring
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if (pTB = 0) orelse (pTB->IsValidItem( idx ) = false) then return ""
    return pTB->items(idx).wszTooltip
end function

public function tkToolbar_SetTooltipText( byval hToolbar as TK_WIDGET ptr, byval idx as long, byval Text as ustring ) as boolean
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if (pTB = 0) orelse (pTB->IsValidItem( idx ) = false) then return false
    pTB->items(idx).wszTooltip = Text
    return true
end function

