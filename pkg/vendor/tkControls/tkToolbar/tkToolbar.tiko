' Repaints without re-laying out. A DIAMETER, as every curvature in the family.
public sub tkToolbar_SetCornerCurvature( byval hToolbar as TK_WIDGET ptr, byval nCurvature as long )
    dim as TKTOOLBAR_STATE ptr pTB = GetToolbarPointer( hToolbar )
    if pTB = 0 then exit sub
    if nCurvature >= 0 then pTB->nCurvature = nCurvature
    pTB->bShapePinned = true
    tkWidget_Invalidate( hToolbar )
