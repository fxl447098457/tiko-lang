    if p then p->wszTooltip = Text
end sub

public function tkBadge_GetTooltipText( byval hBadge as TK_WIDGET ptr ) as ustring
    dim as TKBADGE_STATE ptr p = BG( hBadge )
    if p = 0 then return ""
    return p->wszTooltip
end function

