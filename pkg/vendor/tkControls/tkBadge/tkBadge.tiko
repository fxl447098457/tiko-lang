end sub

' Text and glyph fonts; a 0 leaves that one alone.
public sub tkBadge_ApplyFonts( byval hBadge as TK_WIDGET ptr, byval fText as TTF_Font ptr, byval fGlyph as TTF_Font ptr )
    dim as TKBADGE_STATE ptr p = BG( hBadge )
    if p = 0 then exit sub
    if fText then p->spec.fText = fText
    if fGlyph then p->spec.fGlyph = fGlyph
    Refresh( p )
end sub

