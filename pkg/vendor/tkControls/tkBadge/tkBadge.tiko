public sub tkBadge_SetGlyphFont( byval hBadge as TK_WIDGET ptr, byval f as TTF_Font ptr )
    dim as TKBADGE_STATE ptr p = BG( hBadge )
    if p = 0 then exit sub
    p->spec.fGlyph = f
