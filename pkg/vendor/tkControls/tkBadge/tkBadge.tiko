    dim as TKBADGE_STATE ptr p = BG( hBadge )
    if p = 0 then return 0
    return tkTipHost_Tip( @p->tip )
end function

' ---- appearance ----------------------------------------------------------------------------
public sub tkBadge_GetColors( byval hBadge as TK_WIDGET ptr, byval pColors as TKBADGE_COLORS ptr )
    dim as TKBADGE_STATE ptr p = BG( hBadge )
    if (p = 0) orelse (pColors = 0) then exit sub
    *pColors = p->colors
end sub

' Copies the struct and PINS it: a theme change leaves this badge alone until UnpinColors.
public sub tkBadge_SetColors( byval hBadge as TK_WIDGET ptr, byval pColors as TKBADGE_COLORS ptr )
    dim as TKBADGE_STATE ptr p = BG( hBadge )
    if (p = 0) orelse (pColors = 0) then exit sub
    p->colors = *pColors
    p->bColorsPinned = true
    tkWidget_Invalidate( hBadge )
end sub

' The badge's colours from the theme's roles (§5.6). Each ink is the theme ink that reads best on
' its fill (WCAG contrast), computed here, so a theme file's own colours stay legible.
public function tkBadge_ThemeColors( byref t as TKTHEME_COLORS ) as TKBADGE_COLORS
    dim as TKBADGE_COLORS c
    c.BackColor = t.Window
    c.RingColor = t.Window
    c.LabelColor = t.Text
    c.LabelColorDisabled = t.TextDisabled
    c.FillAccent = t.Accent
    c.FillInfo = t.Accent
    c.FillSuccess = t.Success
    c.FillWarning = t.Warning
    c.FillError = t.Error
    c.FillNeutral = t.TextDim
    c.FillDisabled = t.SurfaceDisabled
    c.InkDisabled = t.TextDisabled
    c.InkAccent = BestInk( t, c.FillAccent )
    c.InkInfo = BestInk( t, c.FillInfo )
    c.InkSuccess = BestInk( t, c.FillSuccess )
    c.InkWarning = BestInk( t, c.FillWarning )
    c.InkError = BestInk( t, c.FillError )
    c.InkNeutral = BestInk( t, c.FillNeutral )
    return c
end function

public sub tkBadge_ApplyTheme( byval hBadge as TK_WIDGET ptr, byref t as TKTHEME_COLORS )
    dim as TKBADGE_STATE ptr p = BG( hBadge )
    if (p = 0) orelse p->bColorsPinned then exit sub
    dim as TKTHEME_COLORS tr = tkTheme_Styled( hBadge, t )
    p->colors = tkBadge_ThemeColors( tr )
    tkTheme_ResolveInto( hBadge, tr, cast( ulong ptr, @p->colors ), sizeof( TKBADGE_COLORS ) \ 4, "Badge" )
    tkWidget_Invalidate( hBadge )
end sub

public sub tkBadge_UnpinColors( byval hBadge as TK_WIDGET ptr )
    dim as TKBADGE_STATE ptr p = BG( hBadge )
    if p = 0 then exit sub
    p->bColorsPinned = false
    tkBadge_ApplyTheme( hBadge, tkTheme_Of( hBadge ) )
end sub

' ---- callbacks -----------------------------------------------------------------------------
public sub tkBadge_PaintDefault( byval pi as TKBADGE_PAINTINFO ptr )
    if pi = 0 then exit sub
    dim as TKBADGE_STATE ptr p = BG( pi->hBadge )
    if p then RenderDefault( p, pi )
end sub

public sub tkBadge_SetPaintCallback( byval hBadge as TK_WIDGET ptr, byval usersub as BDG_PaintCallbackSub )
    dim as TKBADGE_STATE ptr p = BG( hBadge )
    if p = 0 then exit sub
    p->PaintCallback = usersub
    tkWidget_Invalidate( hBadge )
end sub

public sub tkBadge_SetMessageCallback( byval hBadge as TK_WIDGET ptr, byval userfunc as BDG_MessageCallbackFunc )
    dim as TKBADGE_STATE ptr p = BG( hBadge )
    if p then p->MessageCallback = userfunc
end sub
