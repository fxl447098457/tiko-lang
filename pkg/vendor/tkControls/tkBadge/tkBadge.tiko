' The badge plus (standalone) the gap and the label; valid before sizing.
public sub tkBadge_GetIdealSize( byval hBadge as TK_WIDGET ptr, byref nWidth as long, byref nHeight as long )
    nWidth = 0 : nHeight = 0
    dim as TKBADGE_STATE ptr p = BG( hBadge )
    if p = 0 then exit sub
    dim as TKBADGE_SPEC s = LiveSpec( p )
    tkBadge_MeasureSpec( s, nWidth, nHeight )
    if p->hTarget then exit sub
    dim as TTF_Font ptr f = TextFont( p )
    if (len( p->wszLabel ) > 0) andalso (f <> 0) then
        nWidth += iif( nWidth > 0, SC( s, TKBADGE_DEFAULT_LABELGAP ), 0 ) + tkText_Width( f, p->wszLabel )
        if tkText_Height( f ) > nHeight then nHeight = tkText_Height( f )
    end if
end sub

' The badge's rect (with its ring), widget-local; FALSE while nothing shows or not laid out.
public function tkBadge_GetBadgeRect( byval hBadge as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    tkRect_SetEmpty( rc )
    dim as TKBADGE_STATE ptr p = BG( hBadge )
    if p = 0 then return false
    if p->bLayoutDirty then Layout( p )
    rc = p->rcBadge
    return tkRect_IsEmpty( rc ) = false
end function

' ---- attachment (B1) ----------------------------------------------------------------------------
' Hang the badge on hTarget's corner: it becomes an adornment of hTarget (tkWidget_SetAdorner) --
' painted over the target, centred on the anchor, moved by (dx, dy) design units, following the
' target, never hit-tested. The ring becomes 2 px unless SetRing ran. hTarget = 0 detaches.
public declare sub tkBadge_Detach( byval hBadge as TK_WIDGET ptr, byval hNewParent as TK_WIDGET ptr = 0 )

public sub tkBadge_Attach( byval hBadge as TK_WIDGET ptr, byval hTarget as TK_WIDGET ptr, _
                          byval nCorner as long = TKBADGE_TOP_RIGHT, byval dx as long = 0, byval dy as long = 0, _
                          byval nOverlap as long = TKBADGE_OVERLAP_RECT )
    dim as TKBADGE_STATE ptr p = BG( hBadge )
    if p = 0 then exit sub
    if (hTarget = 0) orelse (hTarget = hBadge) then tkBadge_Detach( hBadge ) : exit sub
    if p->hTarget = 0 then p->hHome = tkWidget_Parent( hBadge )
    p->hTarget = hTarget
    p->nCorner = nCorner : p->nOffX = dx : p->nOffY = dy : p->nOverlap = nOverlap
    if p->bRingPinned = false then p->spec.nRing = TKBADGE_ATTACHED_RING
    if tkWidget_Parent( hBadge ) <> hTarget then tkWidget_Reparent( hBadge, hTarget )
    tkWidget_SetAdorner( hBadge, true )
    tkTipHost_Pop( @p->tip )
    Refresh( p )
end sub

' Back to a plain widget under hNewParent (0 = the parent it had before Attach), placed by the host.
public sub tkBadge_Detach( byval hBadge as TK_WIDGET ptr, byval hNewParent as TK_WIDGET ptr = 0 )
    dim as TKBADGE_STATE ptr p = BG( hBadge )
    if (p = 0) orelse (p->hTarget = 0) then exit sub
    dim as TK_WIDGET ptr home = iif( hNewParent <> 0, hNewParent, p->hHome )
    p->hTarget = 0
    tkWidget_SetAdorner( hBadge, false )
    if (home <> 0) andalso (home <> tkWidget_Parent( hBadge )) then tkWidget_Reparent( hBadge, home )
    if p->bRingPinned = false then p->spec.nRing = 0
    Refresh( p )
end sub

public function tkBadge_GetTarget( byval hBadge as TK_WIDGET ptr ) as TK_WIDGET ptr
    dim as TKBADGE_STATE ptr p = BG( hBadge )
    if p = 0 then return cast( TK_WIDGET ptr, 0 )
    return p->hTarget
end function

