'
' tkCheckedList -- a list with a check box per item: WinForms' CheckedListBox shape. New in
' tkControls (no Win32 sibling); the design is C:\dev\docs\tkControls\CHECKED-LISTS.md §5 (phase C2).
'
' A THIN WRAPPER over a tkListTree in check-box mode (C1): flat (no tree indent, no twisty), two
' states, the stock row painter. What it adds is the item table the ListTree does not keep -- a
' KEY and an ID per item -- and the value a form binds: the checked items' keys, in item order.
' Row i of the inner list IS item i; the list is never reordered (no drag-reorder).
'
' THE HANDLE is a container widget holding the ListTree, so the state has a home of its own. Focus
' given to the container goes straight to the list. tkCheckedList_GetListTree( h ) reaches the
' whole tkListTree API for anything not wrapped here (fonts, row height, colours, the paint and
' message callbacks, tooltips) -- but the list's SelChange, Activate, ItemCheck and ItemChecked
' callbacks belong to this control: set them here, not on the inner list.
'
' KEYS: an item's key is what the value is made of; "" means "the text is the key". Keys compare
' exactly (case-sensitive; D-8). The text pair joins / splits keys with the ValueSeparator (";"),
' trimming each piece: a key containing the separator cannot round-trip through text (§9.2).
'
' NOTIFICATION: setters are silent. The user's gestures (the box, Space, + / -, CheckOnClick) fire
' ItemCheck BEFORE (may veto or rewrite) and CheckedChanged AFTER, once per gesture.
#module "tkCheckedList"

#import "../tkHost" public
#import "../tkTheme" public
#import "../tkListTree" public
using tkHost
using tkPaint
using tkTheme
using tkListTree

public const TKCHECKEDLIST_DEFAULT_SEPARATOR = ";"

public type TKCHECKEDLIST_ITEM
    Text     as ustring
    Key      as ustring          ' "" = the text is the key
    id       as long
    itemData as integer
end type

' BEFORE a user's check change on item idx: FALSE vetoes; bNewChecked may be rewritten.
public type CKL_ItemCheckCallbackFunc as function( byval hList as TK_WIDGET ptr, byval idx as long, _
                                                   byref bNewChecked as boolean ) as boolean
' AFTER the gesture (one per gesture, however many items changed).
public type CKL_CheckedChangedCallbackSub as sub( byval hList as TK_WIDGET ptr )
public type CKL_SelChangeCallbackSub as sub( byval hList as TK_WIDGET ptr, byval idx as long )
public type CKL_ActivateCallbackSub as sub( byval hList as TK_WIDGET ptr, byval idx as long )

public type TKCHECKEDLIST_STATE
    hWin        as TK_WIDGET ptr        ' the container (the handle)
    hList       as TK_WIDGET ptr        ' the tkListTree
    items(any)  as TKCHECKEDLIST_ITEM
    itemCount   as long
    wszSep      as ustring = TKCHECKEDLIST_DEFAULT_SEPARATOR
    ItemCheckCallback      as CKL_ItemCheckCallbackFunc
    CheckedChangedCallback as CKL_CheckedChangedCallbackSub
    SelChangeCallback      as CKL_SelChangeCallbackSub
    ActivateCallback       as CKL_ActivateCallbackSub
end type


' ---- plumbing ---------------------------------------------------------------------------------
private function CL( byval h as TK_WIDGET ptr ) as TKCHECKEDLIST_STATE ptr
    if h = 0 then return 0
    return cast( TKCHECKEDLIST_STATE ptr, h->pData )
end function

' The inner list's callbacks hand over the LIST; its parent is our container.
private function CLOfList( byval hList as TK_WIDGET ptr ) as TKCHECKEDLIST_STATE ptr
    return CL( tkWidget_Parent( hList ) )
end function

private function ClValid( byval p as TKCHECKEDLIST_STATE ptr, byval idx as long ) as boolean
    return (p <> 0) andalso (idx >= 0) andalso (idx < p->itemCount)
end function

private function ClKeyOf( byval p as TKCHECKEDLIST_STATE ptr, byval idx as long ) as ustring
    if len( p->items(idx).Key ) then return p->items(idx).Key
    return p->items(idx).Text
end function

private function ClItemCheck( byval hList as TK_WIDGET ptr, byval row as integer, _
                              byval oldState as long, byref newState as long ) as boolean
    dim as TKCHECKEDLIST_STATE ptr p = CLOfList( hList )
    if (p = 0) orelse (p->ItemCheckCallback = 0) then return true
    dim as boolean bNew = (newState = LT_CHECK_CHECKED)
    if p->ItemCheckCallback( p->hWin, row, bNew ) = false then return false
    newState = iif( bNew, LT_CHECK_CHECKED, LT_CHECK_UNCHECKED )
    return true
end function

private sub ClItemChecked( byval hList as TK_WIDGET ptr, byval row as integer, byval newState as long )
    dim as TKCHECKEDLIST_STATE ptr p = CLOfList( hList )
    if (p <> 0) andalso (p->CheckedChangedCallback <> 0) then p->CheckedChangedCallback( p->hWin )
end sub

private sub ClSelChange( byval hList as TK_WIDGET ptr, byval row as integer )
    dim as TKCHECKEDLIST_STATE ptr p = CLOfList( hList )
    if (p <> 0) andalso (p->SelChangeCallback <> 0) then p->SelChangeCallback( p->hWin, row )
end sub

private sub ClActivate( byval hList as TK_WIDGET ptr, byval row as integer )
    dim as TKCHECKEDLIST_STATE ptr p = CLOfList( hList )
    if (p <> 0) andalso (p->ActivateCallback <> 0) then p->ActivateCallback( p->hWin, row )
end sub

private sub ClPaintRow( byval pi as TKLISTTREE_PAINTINFO ptr )
    tkListTree_PaintRowDefault( pi )
end sub

private function ClProc( byval w as TK_WIDGET ptr, byval m as TK_MSG ptr ) as boolean
    dim as TKCHECKEDLIST_STATE ptr p = CL( w )
    if p = 0 then return false
    select case m->msg
    case TKM_SIZE
        if p->hList then tkWidget_SetPos( p->hList, 0, 0, w->cw, w->ch )
        return true
    case TKM_SETFOCUS
        ' the container has no keys: focus goes to the list (which hands it to its rows)
        if p->hList then tkHost_SetFocus( w->pHost, p->hList )
        return true
    case TKM_DESTROY
        delete p
        w->pData = 0
        return true
    end select
    return false
end function


' ---- create -----------------------------------------------------------------------------------
public function tkCheckedList_Create( byval hParent as TK_WIDGET ptr, byval CtrlID as long ) as TK_WIDGET ptr
    if hParent = 0 then return 0
    dim as TKCHECKEDLIST_STATE ptr p = new TKCHECKEDLIST_STATE
    dim as TK_WIDGET ptr w = tkWidget_CreateChild( hParent, CtrlID, @ClProc, p )
    if w = 0 then delete p : return 0
    p->hWin = w
    p->hList = tkListTree_Create( w, CtrlID )
    tkListTree_SetTreeIndent( p->hList, false )
    tkListTree_ShowTwisty( p->hList, false )
    tkListTree_SetCheckBoxes( p->hList, true )
    tkListTree_SetCheckMode( p->hList, LT_CHECKMODE_TWOSTATE )
    tkListTree_SetPaintCallback( p->hList, @ClPaintRow )
    tkListTree_SetItemCheckCallback( p->hList, @ClItemCheck )
    tkListTree_SetItemCheckedCallback( p->hList, @ClItemChecked )
    tkListTree_SetSelChangeCallback( p->hList, @ClSelChange )
    tkListTree_SetActivateCallback( p->hList, @ClActivate )
    return w
end function

public function tkCheckedList_GetListTree( byval h as TK_WIDGET ptr ) as TK_WIDGET ptr
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    return iif( p <> 0, p->hList, 0 )
end function

public function tkCheckedList_GetID( byval h as TK_WIDGET ptr ) as long
    return iif( h <> 0, h->ctrlId, 0 )
end function


' ---- items ------------------------------------------------------------------------------------
' Inserts at idx (clamped to 0..count); returns the index, or -1.
public function tkCheckedList_InsertItem( byval h as TK_WIDGET ptr, byval idx as long, byval Text as ustring, _
                                          byval Key as ustring = "", byval id as long = 0, byval itemData as integer = 0 ) as long
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if p = 0 then return -1
    if idx < 0 then idx = 0
    if idx > p->itemCount then idx = p->itemCount
    if tkListTree_InsertString( p->hList, idx, Text ) < 0 then return -1
    redim preserve p->items( 0 to p->itemCount )
    for i as long = p->itemCount to idx + 1 step -1
        p->items(i) = p->items(i - 1)
    next
    p->items(idx).Text = Text : p->items(idx).Key = Key
    p->items(idx).id = id : p->items(idx).itemData = itemData
    p->itemCount += 1
    return idx
end function

public function tkCheckedList_AddItem( byval h as TK_WIDGET ptr, byval Text as ustring, byval Key as ustring = "", _
                                       byval id as long = 0, byval itemData as integer = 0 ) as long
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if p = 0 then return -1
    return tkCheckedList_InsertItem( h, p->itemCount, Text, Key, id, itemData )
end function

public function tkCheckedList_DeleteItem( byval h as TK_WIDGET ptr, byval idx as long ) as boolean
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if ClValid( p, idx ) = false then return false
    tkListTree_DeleteString( p->hList, idx )
    for i as long = idx to p->itemCount - 2
        p->items(i) = p->items(i + 1)
    next
    p->itemCount -= 1
    if p->itemCount = 0 then erase p->items else redim preserve p->items( 0 to p->itemCount - 1 )
    return true
end function

public sub tkCheckedList_Clear( byval h as TK_WIDGET ptr )
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if p = 0 then exit sub
    tkListTree_Clear( p->hList )
    erase p->items
    p->itemCount = 0
end sub

public function tkCheckedList_GetCount( byval h as TK_WIDGET ptr ) as long
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    return iif( p <> 0, p->itemCount, 0 )
end function

public function tkCheckedList_GetItemText( byval h as TK_WIDGET ptr, byval idx as long ) as ustring
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if ClValid( p, idx ) = false then return ""
    return p->items(idx).Text
end function

public function tkCheckedList_SetItemText( byval h as TK_WIDGET ptr, byval idx as long, byval Text as ustring ) as boolean
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if ClValid( p, idx ) = false then return false
    p->items(idx).Text = Text
    tkListTree_SetText( p->hList, idx, Text )
    return true
end function

' The key the value is made of: the item's own, else its text.
public function tkCheckedList_GetItemKey( byval h as TK_WIDGET ptr, byval idx as long ) as ustring
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if ClValid( p, idx ) = false then return ""
    return ClKeyOf( p, idx )
end function

public function tkCheckedList_SetItemKey( byval h as TK_WIDGET ptr, byval idx as long, byval Key as ustring ) as boolean
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if ClValid( p, idx ) = false then return false
    p->items(idx).Key = Key
    return true
end function

public function tkCheckedList_GetItemID( byval h as TK_WIDGET ptr, byval idx as long ) as long
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if ClValid( p, idx ) = false then return 0
    return p->items(idx).id
end function

public function tkCheckedList_SetItemID( byval h as TK_WIDGET ptr, byval idx as long, byval id as long ) as boolean
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if ClValid( p, idx ) = false then return false
    p->items(idx).id = id
    return true
end function

public function tkCheckedList_GetItemData( byval h as TK_WIDGET ptr, byval idx as long ) as integer
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if ClValid( p, idx ) = false then return 0
    return p->items(idx).itemData
end function

public function tkCheckedList_SetItemData( byval h as TK_WIDGET ptr, byval idx as long, byval itemData as integer ) as boolean
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if ClValid( p, idx ) = false then return false
    p->items(idx).itemData = itemData
    return true
end function

' A disabled item: its box is painted disabled, the user can neither select nor check it; its
' check state is kept and still part of the value.
public function tkCheckedList_SetItemEnabled( byval h as TK_WIDGET ptr, byval idx as long, byval bEnabled as boolean ) as boolean
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if ClValid( p, idx ) = false then return false
    return tkListTree_SetRowSelectable( p->hList, idx, bEnabled )
end function

public function tkCheckedList_GetItemEnabled( byval h as TK_WIDGET ptr, byval idx as long ) as boolean
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if ClValid( p, idx ) = false then return false
    return tkListTree_GetRowSelectable( p->hList, idx )
end function

' The first item whose key is exactly key, or -1.
public function tkCheckedList_FindItemByKey( byval h as TK_WIDGET ptr, byval Key as ustring ) as long
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if p = 0 then return -1
    for i as long = 0 to p->itemCount - 1
        if ClKeyOf( p, i ) = Key then return i
    next
    return -1
end function

' The first item whose text matches, ignoring case, or -1.
public function tkCheckedList_FindItemByText( byval h as TK_WIDGET ptr, byval Text as ustring ) as long
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if p = 0 then return -1
    dim as ustring t = lcase( Text )
    for i as long = 0 to p->itemCount - 1
        if lcase( p->items(i).Text ) = t then return i
    next
    return -1
end function


' ---- checks (all silent) ----------------------------------------------------------------------
public function tkCheckedList_SetChecked( byval h as TK_WIDGET ptr, byval idx as long, byval bChecked as boolean ) as boolean
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if ClValid( p, idx ) = false then return false
    return tkListTree_SetCheck( p->hList, idx, iif( bChecked, LT_CHECK_CHECKED, LT_CHECK_UNCHECKED ) )
end function

public function tkCheckedList_GetChecked( byval h as TK_WIDGET ptr, byval idx as long ) as boolean
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if ClValid( p, idx ) = false then return false
    return tkListTree_GetCheck( p->hList, idx ) = LT_CHECK_CHECKED
end function

public function tkCheckedList_GetCheckedCount( byval h as TK_WIDGET ptr ) as long
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if p = 0 then return 0
    return tkListTree_GetCheckedCount( p->hList )
end function

' The checked items' indices, in item order; returns the count.
public function tkCheckedList_GetCheckedIndices( byval h as TK_WIDGET ptr, indices() as integer ) as long
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if p = 0 then erase indices : return 0
    return tkListTree_GetCheckedItems( p->hList, indices() )
end function

public sub tkCheckedList_CheckAll( byval h as TK_WIDGET ptr, byval bChecked as boolean )
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if p = 0 then exit sub
    tkListTree_CheckAll( p->hList, iif( bChecked, LT_CHECK_CHECKED, LT_CHECK_UNCHECKED ) )
end sub

' The checked items' keys, in item order; returns the count.
public function tkCheckedList_GetCheckedKeys( byval h as TK_WIDGET ptr, keys() as ustring ) as long
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    dim as long n = tkCheckedList_GetCheckedCount( h )
    if n = 0 then erase keys : return 0
    redim keys( 0 to n - 1 )
    dim as long k = 0
    for i as long = 0 to p->itemCount - 1
        if tkCheckedList_GetChecked( h, i ) then keys(k) = ClKeyOf( p, i ) : k += 1
    next
    return n
end function

' Exactly the items whose key is in keys() end up checked; keys no item has are ignored. Silent.
public sub tkCheckedList_SetCheckedKeys( byval h as TK_WIDGET ptr, keys() as ustring )
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if p = 0 then exit sub
    for i as long = 0 to p->itemCount - 1
        dim as ustring ki = ClKeyOf( p, i )
        dim as boolean bOn = false
        for j as long = lbound( keys ) to ubound( keys )
            if keys(j) = ki then bOn = true : exit for
        next
        tkListTree_SetCheck( p->hList, i, iif( bOn, LT_CHECK_CHECKED, LT_CHECK_UNCHECKED ) )
    next
end sub

public sub tkCheckedList_SetValueSeparator( byval h as TK_WIDGET ptr, byval Sep as ustring )
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if (p <> 0) andalso (len( Sep ) > 0) then p->wszSep = Sep
end sub

public function tkCheckedList_GetValueSeparator( byval h as TK_WIDGET ptr ) as ustring
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if p = 0 then return TKCHECKEDLIST_DEFAULT_SEPARATOR      ' (not iif: ustring vs narrow literal)
    return p->wszSep
end function

' The bind pair (CHECKED-LISTS.md §9.2): the checked keys joined by the ValueSeparator, in item
' order ("red;green"); "" when none.
public function tkCheckedList_GetCheckedText( byval h as TK_WIDGET ptr ) as ustring
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if p = 0 then return ""
    dim as ustring s
    dim as boolean bFirst = true
    for i as long = 0 to p->itemCount - 1
        if tkCheckedList_GetChecked( h, i ) then
            if bFirst = false then s &= p->wszSep
            s &= ClKeyOf( p, i )
            bFirst = false
        end if
    next
    return s
end function

' Splits s on the ValueSeparator, trims each piece, drops empty ones, and checks exactly the items
' with those keys (SetCheckedKeys). "" unchecks everything. Silent.
public sub tkCheckedList_SetCheckedText( byval h as TK_WIDGET ptr, byval s as ustring )
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if p = 0 then exit sub
    dim as ustring keys()
    dim as long n = 0
    dim as long sepLen = len( p->wszSep )
    dim as long nPos = 1
    do
        dim as long nAt = instr( nPos, s, p->wszSep )
        dim as ustring piece = trim( iif( nAt > 0, mid( s, nPos, nAt - nPos ), mid( s, nPos ) ) )
        if len( piece ) then
            redim preserve keys( 0 to n )
            keys(n) = piece : n += 1
        end if
        if nAt = 0 then exit do
        nPos = nAt + sepLen
    loop
    if n = 0 then
        tkCheckedList_CheckAll( h, false )
    else
        tkCheckedList_SetCheckedKeys( h, keys() )
    end if
end sub


' ---- selection and behaviour ------------------------------------------------------------------
public function tkCheckedList_GetCurSel( byval h as TK_WIDGET ptr ) as long
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if p = 0 then return -1
    return tkListTree_GetCurSel( p->hList )
end function

public function tkCheckedList_SetCurSel( byval h as TK_WIDGET ptr, byval idx as long ) as long
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if p = 0 then return -1
    return tkListTree_SetCurSel( p->hList, idx )
end function

' One click on an item selects AND toggles it (WinForms CheckOnClick); off by default.
public sub tkCheckedList_SetCheckOnClick( byval h as TK_WIDGET ptr, byval bEnable as boolean )
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if p then tkListTree_SetCheckOnClick( p->hList, bEnable )
end sub

public function tkCheckedList_GetCheckOnClick( byval h as TK_WIDGET ptr ) as boolean
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    return (p <> 0) andalso tkListTree_GetCheckOnClick( p->hList )
end function

' Multiple selection (Ctrl / Shift): Space then checks every selected item with the focused one.
public sub tkCheckedList_SetExtendedSelect( byval h as TK_WIDGET ptr, byval bEnable as boolean )
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if p then tkListTree_SetExtendedSelect( p->hList, bEnable )
end sub

public sub tkCheckedList_SetFont( byval h as TK_WIDGET ptr, byval f as TTF_Font ptr )
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if p then tkListTree_SetFont( p->hList, f )
end sub

public function tkCheckedList_GetFont( byval h as TK_WIDGET ptr ) as TTF_Font ptr
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    return iif( p <> 0, tkListTree_GetFont( p->hList ), 0 )
end function

public sub tkCheckedList_SetRowHeight( byval h as TK_WIDGET ptr, byval nHeight as long )
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if p then tkListTree_SetRowHeight( p->hList, nHeight )
end sub

public function tkCheckedList_GetRowHeight( byval h as TK_WIDGET ptr ) as long
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    return iif( p <> 0, tkListTree_GetRowHeight( p->hList ), 0 )
end function

' The item's box rect, relative to the inner list's row surface (tkListTree_GetCheckRect).
public function tkCheckedList_GetCheckRect( byval h as TK_WIDGET ptr, byval idx as long, byref rc as TKRECT ) as boolean
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if ClValid( p, idx ) = false then tkRect_SetEmpty( rc ) : return false
    return tkListTree_GetCheckRect( p->hList, idx, rc )
end function


' ---- callbacks (0 removes) --------------------------------------------------------------------
public sub tkCheckedList_SetItemCheckCallback( byval h as TK_WIDGET ptr, byval userfunc as CKL_ItemCheckCallbackFunc )
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if p then p->ItemCheckCallback = userfunc
end sub

public sub tkCheckedList_SetCheckedChangedCallback( byval h as TK_WIDGET ptr, byval usersub as CKL_CheckedChangedCallbackSub )
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if p then p->CheckedChangedCallback = usersub
end sub

public sub tkCheckedList_SetSelChangeCallback( byval h as TK_WIDGET ptr, byval usersub as CKL_SelChangeCallbackSub )
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if p then p->SelChangeCallback = usersub
end sub

public sub tkCheckedList_SetActivateCallback( byval h as TK_WIDGET ptr, byval usersub as CKL_ActivateCallbackSub )
    dim as TKCHECKEDLIST_STATE ptr p = CL( h )
    if p then p->ActivateCallback = usersub
end sub
