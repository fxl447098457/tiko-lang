' Surface-local, the same x space the message callback's x carries.
public function tkListTree_GetColumnRect( byval hList as TK_WIDGET ptr, byval idx as integer, byref rc as TKRECT ) as boolean
    tkRect_SetEmpty( rc )
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
    if p = 0 then return false
    if tkColumnHeader_GetColumnRect( p->wHeader, idx, rc ) = false then return false
    rc.top = 0 : rc.bottom = p->wSurf->ch
    return true
end function

