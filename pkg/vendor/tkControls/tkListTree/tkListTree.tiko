public sub tkListTree_BeginUpdate( byval hList as TK_WIDGET ptr )
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
    if p then p->updateDepth += 1
end sub

public sub tkListTree_EndUpdate( byval hList as TK_WIDGET ptr )
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
    if p = 0 then exit sub
    if p->updateDepth > 0 then p->updateDepth -= 1
    if p->updateDepth <> 0 then exit sub
    if p->batchKind = 1 then
        dim as integer f = p->batchFirstRow, l = p->batchLastRow
        p->batchKind = 0 : p->batchFirstRow = -1 : p->batchLastRow = -1
        LtInvalidateRowSpan( p, f, l )
        exit sub
    end if
    p->Refresh()
end sub

public sub tkListTree_Refresh( byval hList as TK_WIDGET ptr )
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
    if p then p->Refresh()
end sub

public sub tkListTree_InvalidateRow( byval hList as TK_WIDGET ptr, byval row as integer )
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
    if (p <> 0) andalso p->IsValidRow( row ) then LtInvalidateRowSpan( p, row, row )
end sub

public sub tkListTree_InvalidateRows( byval hList as TK_WIDGET ptr, byval first_ as integer, byval last_ as integer )
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
    if p = 0 then exit sub
    if first_ > last_ then swap first_, last_
    if first_ < 0 then first_ = 0
    if last_ > p->rowCount - 1 then last_ = p->rowCount - 1
    if first_ <= last_ then LtInvalidateRowSpan( p, first_, last_ )
end sub

' Paints whatever is pending now (vendor's UpdateWindow on the surface).
public sub tkListTree_UpdateNow( byval hList as TK_WIDGET ptr )
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
    if (p <> 0) andalso p->hWin->pHost->bDirty then tkHost_Render( p->hWin->pHost )
end sub

' ---- groups and trees ---------------------------------------------------------------------
public function tkListTree_IsHeader( byval hList as TK_WIDGET ptr, byval row as integer ) as boolean
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
    if (p = 0) orelse (p->IsValidRow( row ) = false) then return false
    return p->rows(row).IsHeader
end function

public function tkListTree_IsCollapsed( byval hList as TK_WIDGET ptr, byval row as integer ) as boolean
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
    if (p = 0) orelse (p->IsValidRow( row ) = false) then return false
    return p->rows(row).bCollapsed
end function

private function LtSetCollapsed( byval hList as TK_WIDGET ptr, byval row as integer, byval nMode as long ) as boolean
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
    if p = 0 then return false
    if LtCanFold( p, row ) = false then return false
    dim as boolean bNew
    select case nMode
    case 0 : bNew = true                          ' collapse
    case 1 : bNew = false                         ' expand
    case else : bNew = not p->rows(row).bCollapsed
    end select
    if p->rows(row).bCollapsed <> bNew then
        p->rows(row).bCollapsed = bNew
        if p->bEditing then LtEndEdit( p, true )
        p->NotifyChange()
    end if
    return true
end function

public function tkListTree_CollapseRow( byval hList as TK_WIDGET ptr, byval row as integer ) as boolean
    return LtSetCollapsed( hList, row, 0 )
end function

public function tkListTree_ExpandRow( byval hList as TK_WIDGET ptr, byval row as integer ) as boolean
    return LtSetCollapsed( hList, row, 1 )
end function

public function tkListTree_ToggleRow( byval hList as TK_WIDGET ptr, byval row as integer ) as boolean
    return LtSetCollapsed( hList, row, 2 )
end function

public function tkListTree_SetNodeCollapsed( byval hList as TK_WIDGET ptr, byval row as integer, byval bCollapsed as boolean ) as boolean
    return LtSetCollapsed( hList, row, iif( bCollapsed, 0, 1 ) )
end function

private function LtSetAll( byval hList as TK_WIDGET ptr, byval bCollapsed as boolean ) as boolean
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
    if p = 0 then return false
    for i as integer = 0 to p->rowCount - 1
        if LtCanFold( p, i ) then p->rows(i).bCollapsed = bCollapsed
    next
    if p->bEditing then LtEndEdit( p, true )
    p->NotifyChange()
    return true
end function

public function tkListTree_CollapseAll( byval hList as TK_WIDGET ptr ) as boolean
    return LtSetAll( hList, true )
end function

public function tkListTree_ExpandAll( byval hList as TK_WIDGET ptr ) as boolean
    return LtSetAll( hList, false )
end function

