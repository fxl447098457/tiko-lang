' ---- theme --------------------------------------------------------------------------------
' Vendor's role mapping; skipped while the host has pinned colours (any colour setter).
public sub tkListTree_ApplyTheme( byval hList as TK_WIDGET ptr, byref t as TKTHEME_COLORS )
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
    if p = 0 then exit sub
    ApplyThemeShape( hList )
    if p->bColorsPinned then exit sub
    dim as TKTHEME_COLORS s = tkTheme_Styled( hList, t )     ' no colour struct: a style, no recipe
    p->BackColor = s.Window
    p->BorderColor = s.Border
    p->TwistyColor = s.TextDim
    p->dragIndicatorColor = s.Accent
    tkVScrollBar_SetColors( p->wBar, s.Window, s.Border, s.TextDisabled )
    tkColumnHeader_ApplyTheme( p->wHeader, s )
    p->bEditColorsSet = true
    p->clrEditBack = s.Surface : p->clrEditFore = s.Text
    p->clrEditBorder = s.Border : p->clrEditFocusBdr = s.FocusRing
    LtApplyEditColors( p )
    tkWidget_Invalidate( hList )
end sub

public sub tkListTree_UnpinColors( byval hList as TK_WIDGET ptr )
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
    if p = 0 then exit sub
    p->bColorsPinned = false
    tkListTree_ApplyTheme( hList, tkTheme_Of( hList ) )
end sub

public sub tkListTree_ApplyFonts( byval hList as TK_WIDGET ptr, byval fText as TTF_Font ptr, byval fGlyph as TTF_Font ptr )
    if fText then tkListTree_SetFont( hList, fText )
    if fGlyph then tkListTree_SetTwistyFont( hList, fGlyph )
end sub

' ---- PsPlatform's row painter, as an opt-in helper -----------------------------------------
' Selected > hot > plain from the current theme, a focus bar on the caret row while the rows
' have focus, the header bold-free caption with +/- when it is a legacy header, column-0 text
' at the tree indent, and every cell in its own rect, ellipsised.
public sub tkListTree_PaintRowDefault( byval pi as TKLISTTREE_PAINTINFO ptr )
    dim as TK_PAINT ptr b = pi->b
    dim as TKTHEME_COLORS t = tkTheme_RolesFor( pi->hList )
    dim as ulong back_ = t.Window, fore = t.Text
    if pi->isSelected then
        back_ = t.Selected : fore = t.SelectedText
    elseif pi->isHot then
        back_ = t.SurfaceHot : fore = t.TextHot
    end if
    if pi->isSelectable = false then fore = t.TextDisabled
    b->SetBackColor( back_ )
    b->PaintRect( @pi->rc )
    if pi->isFocused andalso pi->hasFocus then
        dim as TKRECT rb = pi->rc
        rb.right = rb.left + tkHost_Scale( pi->hList->pHost, 2 )
        b->SetBackColor( t.FocusRing )
        b->PaintRect( @rb )
    end if
    b->SetForeColor( fore )
    dim as long pad = tkHost_Scale( pi->hList->pHost, 6 )
    if pi->columnCount = 0 then
        dim as TKRECT rt = pi->rc
        rt.left += pi->indent + pad
        dim as ustring s = pi->wszCaption
        if pi->isHeader then
            if pi->isCollapsed then s = "+ " & s else s = "- " & s
        end if
        b->PaintText( s, @rt, TK_DT_LEFT or TK_DT_ELLIPSIS )
    else
        for c as integer = 0 to pi->columnCount - 1
            dim as TKRECT rt = pi->cells[c].rc
            rt.left += pad : rt.right -= pad
            b->PaintText( pi->cells[c].wszText, @rt, TK_DT_LEFT or TK_DT_ELLIPSIS )
        next
    end if
end sub

' The theme's shape (tkTheme_ShapeOf, design units) unless the host set this control's own --
' its setter pins it. -1 in the theme gives the control's default. Only a change calls the setter.
private sub ApplyThemeShape( byval w as TK_WIDGET ptr )
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( w )
    if (p = 0) orelse p->bShapePinned then exit sub
    dim as TKTHEME_SHAPE sh = tkTheme_ShapeOf( w )
    dim as long v
    v = iif( sh.BorderWidth >= 0, sh.BorderWidth, 0 )
    if p->nBorderWidth <> v then tkListTree_SetBorderWidth( w, v )
    p->bShapePinned = false
end sub
