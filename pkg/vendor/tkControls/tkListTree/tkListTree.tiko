' Non-selectable: never selected, never focused. Marking a live row drops both, silently.
public function tkListTree_SetRowSelectable( byval hList as TK_WIDGET ptr, byval row as integer, byval bSelectable as boolean = true ) as boolean
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
    if (p = 0) orelse (p->IsValidRow( row ) = false) then return false
    p->rows(row).bSelectable = bSelectable
    if bSelectable = false then
        p->rows(row).selected = false
        if p->focusRow = row then p->focusRow = -1 : p->lastNotifiedRow = -1
        if p->anchorRow = row then p->anchorRow = -1
    end if
    tkWidget_Invalidate( p->wSurf )
    return true
end function

public function tkListTree_GetRowSelectable( byval hList as TK_WIDGET ptr, byval row as integer ) as boolean
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
