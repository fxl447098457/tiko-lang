' ---- selection and state ------------------------------------------------------------------
public function tkListTree_GetCurSel( byval hList as TK_WIDGET ptr ) as integer
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
    if p = 0 then return -1
    return p->focusRow
end function

public function tkListTree_SetCurSel( byval hList as TK_WIDGET ptr, byval row as integer ) as integer
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
    if p = 0 then return -1
    if p->IsValidRow( row ) = false then
        p->ClearSelection()
        p->focusRow = -1 : p->anchorRow = -1 : p->lastNotifiedRow = -1
        LtSyncViewFromModel( p )
        return -1
    end if
    if p->IsRowSelectable( row ) = false then return -1
    p->SelectOnly( row )
    p->focusRow = row : p->anchorRow = row : p->lastNotifiedRow = row
    dim as integer visRow = p->ModelToVisible( row )
    if (visRow >= 0) andalso (LtVisPerPage( p ) >= 1) then
        dim as integer perPage = LtItemsPerPage( p )
        if visRow < p->nTopVis then
            p->topRow = row
        elseif visRow >= p->nTopVis + perPage then
            p->topRow = p->VisibleToModel( visRow - perPage + 1 )
        end if
    end if
    LtSyncViewFromModel( p )
    return row
end function

public function tkListTree_GetTopIndex( byval hList as TK_WIDGET ptr ) as integer
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
    if (p = 0) orelse (p->visibleCount = 0) then return -1
    return p->VisibleToModel( p->nTopVis )
end function

public function tkListTree_SetTopIndex( byval hList as TK_WIDGET ptr, byval row as integer ) as integer
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
    if (p = 0) orelse (p->IsValidRow( row ) = false) then return -1
    p->topRow = row
    LtSyncViewFromModel( p )
    return p->topRow
end function

