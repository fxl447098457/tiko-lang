    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
    if p = 0 then return false
    return p->IsRowSelected( row )
end function

public function tkListTree_SetSel( byval hList as TK_WIDGET ptr, byval row as integer, byval state as boolean ) as boolean
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
    if (p = 0) orelse (p->IsValidRow( row ) = false) then return false
    if state andalso (p->IsRowSelectable( row ) = false) then return false
    p->SetRowSelected( row, state )
    tkWidget_Invalidate( p->wSurf )
    return true
end function

public function tkListTree_GetSelCount( byval hList as TK_WIDGET ptr ) as integer
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
    if p = 0 then return 0
    return p->GetSelCount()
end function

public function tkListTree_GetSelItems( byval hList as TK_WIDGET ptr, selItems() as integer ) as integer
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
    dim as integer n = iif( p <> 0, p->GetSelCount(), 0 )
    if n = 0 then erase selItems : return 0
    redim selItems( 0 to n - 1 )
    dim as integer k = 0
    for i as integer = 0 to p->rowCount - 1
        if p->rows(i).selected then selItems(k) = i : k += 1
    next
    return n
end function

public sub tkListTree_SelectAll( byval hList as TK_WIDGET ptr, byval state as boolean )
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
    if p = 0 then exit sub
    for i as integer = 0 to p->rowCount - 1
        p->SetRowSelected( i, state )
    next
    tkWidget_Invalidate( p->wSurf )
end sub

