' ---- columns and the header band ----------------------------------------------------------
' Insert / delete shift every (non-spanned) row's cells across the column-0 / Text alias.
private sub LtShiftCellColumns( byval p as TKLISTTREE_STATE ptr, byval idx as integer, byval nDir as integer )
    if idx < 0 then exit sub
    for r as integer = 0 to p->rowCount - 1
        if p->rows(r).bSpanColumns then continue for
        dim as integer nCells = ubound( p->rows(r).cells ) + 1
        if nDir > 0 then
            if idx = 0 then
                if (nCells > 0) orelse (len( p->rows(r).Text ) > 0) then
                    p->rows(r).EnsureCells( nCells + 1 )
                    for c as integer = nCells to 1 step -1
                        p->rows(r).cells(c) = p->rows(r).cells(c - 1)
                    next
                    p->rows(r).cells(0) = p->rows(r).Text
                    p->rows(r).Text = ""
                end if
            elseif nCells >= idx then
                p->rows(r).EnsureCells( nCells + 1 )
                for c as integer = nCells to idx step -1
                    p->rows(r).cells(c) = p->rows(r).cells(c - 1)
                next
                p->rows(r).cells(idx - 1) = ""
            end if
        else
            if idx = 0 then
                if nCells > 0 then
                    p->rows(r).Text = p->rows(r).cells(0)
                    for c as integer = 0 to nCells - 2
                        p->rows(r).cells(c) = p->rows(r).cells(c + 1)
                    next
                    p->rows(r).TrimCells( nCells - 1 )
                else
                    p->rows(r).Text = ""
                end if
            elseif nCells >= idx then
                for c as integer = idx - 1 to nCells - 2
                    p->rows(r).cells(c) = p->rows(r).cells(c + 1)
                next
                p->rows(r).TrimCells( nCells - 1 )
            end if
        end if
    next
end sub

public function tkListTree_AddColumn( byval hList as TK_WIDGET ptr, byval Text as ustring, byval nWidth as integer = 100, _
                                     byval nMinWidth as integer = 0, byval itemData as integer = 0 ) as integer
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
    if p = 0 then return -1
    dim as integer r = tkColumnHeader_AddColumn( p->wHeader, Text, nWidth, nMinWidth, itemData )
    tkWidget_Invalidate( p->wSurf )
    return r
end function

public function tkListTree_InsertColumn( byval hList as TK_WIDGET ptr, byval idx as integer, byval Text as ustring, _
                                        byval nWidth as integer = 100, byval nMinWidth as integer = 0, byval itemData as integer = 0 ) as integer
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
    if p = 0 then return -1
    dim as integer r = tkColumnHeader_InsertColumn( p->wHeader, idx, Text, nWidth, nMinWidth, itemData )
    if r >= 0 then LtShiftCellColumns( p, r, +1 )
    tkWidget_Invalidate( p->wSurf )
    return r
end function

public function tkListTree_DeleteColumn( byval hList as TK_WIDGET ptr, byval idx as integer ) as boolean
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
    if p = 0 then return false
    if tkColumnHeader_DeleteColumn( p->wHeader, idx ) = false then return false
    LtShiftCellColumns( p, idx, -1 )
    tkWidget_Invalidate( p->wSurf )
    return true
end function

public sub tkListTree_ClearColumns( byval hList as TK_WIDGET ptr )
    dim as TKLISTTREE_STATE ptr p = GetListTreePointer( hList )
    if p = 0 then exit sub
    tkColumnHeader_Clear( p->wHeader )
    tkWidget_Invalidate( p->wSurf )
end sub

