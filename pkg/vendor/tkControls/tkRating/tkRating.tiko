' One item's own tooltip (Ant's per-item tooltips); "" = the rating's.
public sub tkRating_SetItemTooltip( byval hRating as TK_WIDGET ptr, byval nItem as long, byval Text as ustring )
    dim as TKRATING_STATE ptr p = RT( hRating )
    if (p = 0) orelse (nItem < 0) orelse (nItem >= TKRATING_MAX_ITEMS) then exit sub
    p->wszItemTip(nItem) = Text
end sub

