    dim as TKRATING_STATE ptr p = RT( hRating )
    if p = 0 then return 0
    return tkTipHost_Tip( @p->tip )
end function

public sub tkRating_SetHoverTime( byval hRating as TK_WIDGET ptr, byval ms as long )
    dim as TKRATING_STATE ptr p = RT( hRating )
    if p then tkTipHost_SetDelay( @p->tip, TK_TIPDELAY_INITIAL, ms )
end sub

public sub tkRating_SetAutoPopTime( byval hRating as TK_WIDGET ptr, byval ms as long )
    dim as TKRATING_STATE ptr p = RT( hRating )
    if p then tkTipHost_SetDelay( @p->tip, TK_TIPDELAY_AUTOPOP, ms )
end sub

public sub tkRating_SetReshowTime( byval hRating as TK_WIDGET ptr, byval ms as long )
    dim as TKRATING_STATE ptr p = RT( hRating )
    if p then tkTipHost_SetDelay( @p->tip, TK_TIPDELAY_RESHOW, ms )
end sub

' ---- appearance ----------------------------------------------------------------------------
public sub tkRating_GetColors( byval hRating as TK_WIDGET ptr, byval pColors as TKRATING_COLORS ptr )
    dim as TKRATING_STATE ptr p = RT( hRating )
    if (p = 0) orelse (pColors = 0) then exit sub
    *pColors = p->colors
end sub

' Copies the struct and PINS it: a theme change leaves this rating alone until UnpinColors.
public sub tkRating_SetColors( byval hRating as TK_WIDGET ptr, byval pColors as TKRATING_COLORS ptr )
    dim as TKRATING_STATE ptr p = RT( hRating )
    if (p = 0) orelse (pColors = 0) then exit sub
    p->colors = *pColors
    p->bColorsPinned = true
    tkWidget_Invalidate( hRating )
end sub

' The rating's colours from the theme's roles (§4.7): stars in Warning (amber, D-R5).
public function tkRating_ThemeColors( byref t as TKTHEME_COLORS ) as TKRATING_COLORS
    dim as TKRATING_COLORS c
    c.BackColor            = t.Window
    c.FocusRingColor       = t.FocusRing
    c.FillColor            = t.Warning
    c.FillColorHot         = tkColor_Lerp( t.Warning, t.TextStrong, 0.2 )
    c.FillColorDisabled    = t.TextDisabled
    c.EmptyColor           = t.Track
    c.EmptyColorHot        = t.SurfaceHot
    c.EmptyColorDisabled   = t.SurfaceDisabled
    c.BorderColor          = t.Border
    c.BorderColorDisabled  = t.BorderDisabled
    c.PlaceholderColor     = t.TextDim
    c.CaptionColor         = t.TextDim
    c.CaptionColorDisabled = t.TextDisabled
    return c
end function

public sub tkRating_ApplyTheme( byval hRating as TK_WIDGET ptr, byref t as TKTHEME_COLORS )
    dim as TKRATING_STATE ptr p = RT( hRating )
    if p = 0 then exit sub
    ApplyThemeShape( hRating )
    if p->bColorsPinned then exit sub
    dim as TKTHEME_COLORS tr = tkTheme_Styled( hRating, t )
    p->colors = tkRating_ThemeColors( tr )
    tkTheme_ResolveInto( hRating, tr, cast( ulong ptr, @p->colors ), sizeof( TKRATING_COLORS ) \ 4, "Rating" )
    tkWidget_Invalidate( hRating )
end sub

' Hands the rating back to the theme, which is applied at once.
public sub tkRating_UnpinColors( byval hRating as TK_WIDGET ptr )
    dim as TKRATING_STATE ptr p = RT( hRating )
    if p = 0 then exit sub
    p->bColorsPinned = false
    tkRating_ApplyTheme( hRating, tkTheme_Of( hRating ) )
end sub

' ---- callbacks -----------------------------------------------------------------------------
public sub tkRating_SetPaintCallback( byval hRating as TK_WIDGET ptr, byval usersub as RTG_PaintCallbackSub )
    dim as TKRATING_STATE ptr p = RT( hRating )
    if p = 0 then exit sub
    p->PaintCallback = usersub
    tkWidget_Invalidate( hRating )
end sub

public sub tkRating_SetMessageCallback( byval hRating as TK_WIDGET ptr, byval userfunc as RTG_MessageCallbackFunc )
    dim as TKRATING_STATE ptr p = RT( hRating )
    if p then p->MessageCallback = userfunc
end sub

' Replaces the stock drawing of each item; tkRating_PaintItemDefault draws one as it would have been.
public sub tkRating_SetPaintItemCallback( byval hRating as TK_WIDGET ptr, byval usersub as RTG_PaintItemCallbackSub )
    dim as TKRATING_STATE ptr p = RT( hRating )
    if p = 0 then exit sub
    p->PaintItemCallback = usersub
    tkWidget_Invalidate( hRating )
end sub

' The caption's text for (value, preview -- -1 when none); "" = the Caption.
public sub tkRating_SetFormatCaptionCallback( byval hRating as TK_WIDGET ptr, byval userfunc as RTG_FormatCaptionCallbackFunc )
    dim as TKRATING_STATE ptr p = RT( hRating )
    if p = 0 then exit sub
    p->FormatCallback = userfunc
    p->Refresh()
end sub

public sub tkRating_SetValueChangedCallback( byval hRating as TK_WIDGET ptr, byval usersub as RTG_ValueChangedCallbackSub )
    dim as TKRATING_STATE ptr p = RT( hRating )
    if p then p->ChangedCallback = usersub
end sub

public sub tkRating_SetHoverChangedCallback( byval hRating as TK_WIDGET ptr, byval usersub as RTG_HoverChangedCallbackSub )
    dim as TKRATING_STATE ptr p = RT( hRating )
    if p then p->HoverCallback = usersub
end sub

' The theme's shape until a shape setter ran: its BorderWidth is the items' outline.
private sub ApplyThemeShape( byval w as TK_WIDGET ptr )
    dim as TKRATING_STATE ptr p = RT( w )
    if (p = 0) orelse p->bShapePinned then exit sub
    dim as TKTHEME_SHAPE sh = tkTheme_ShapeOf( w )
    p->nBorderThick = iif( sh.BorderWidth >= 0, sh.BorderWidth, TKRATING_DEFAULT_BORDER )
    tkWidget_Invalidate( w )
end sub
