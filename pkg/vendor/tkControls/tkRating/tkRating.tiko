public sub tkRating_ApplyFonts( byval hRating as TK_WIDGET ptr, byval fText as TTF_Font ptr, byval fGlyph as TTF_Font ptr )
    dim as TKRATING_STATE ptr p = RT( hRating )
    if p = 0 then exit sub
    if fText then p->fText = fText
    if fGlyph then p->fGlyph = fGlyph
