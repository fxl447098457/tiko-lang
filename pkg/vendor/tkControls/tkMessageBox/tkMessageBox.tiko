    dim as TKMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer( hMsgBox )
    if (pBox = 0) orelse (nX < 0) orelse (nY < 0) then exit sub
    pBox->nFooterPadX = nX : pBox->nFooterPadY = nY
    pBox->Refresh()
end sub

public sub tkMessageBox_SetIconSize( byval hMsgBox as TK_WIDGET ptr, byval nIconWidth as long, byval nIconHeight as long )
    dim as TKMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer( hMsgBox )
    if (pBox = 0) orelse (nIconWidth < 0) orelse (nIconHeight < 0) then exit sub
    pBox->nIconWidth = nIconWidth : pBox->nIconHeight = nIconHeight
    pBox->Refresh()
end sub

