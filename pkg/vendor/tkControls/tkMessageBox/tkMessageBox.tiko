' 0 = no border. Drawn last, inside the client: repaints without re-measuring.
public sub tkMessageBox_SetBorderThickness( byval hMsgBox as TK_WIDGET ptr, byval nThickness as long )
    dim as TKMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer( hMsgBox )
    if (pBox = 0) orelse (nThickness < 0) then exit sub
    pBox->nBorderThick = nThickness
    tkWidget_Invalidate( hMsgBox )
end sub

' Valid BEFORE the window is ever sized.
public sub tkMessageBox_GetIdealSize( byval hMsgBox as TK_WIDGET ptr, byref nBoxWidth as long, byref nBoxHeight as long )
    nBoxWidth = 0 : nBoxHeight = 0
    dim as TKMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer( hMsgBox )
    if pBox = 0 then exit sub
    if pBox->bLayoutDirty then pBox->LayoutBox()
    nBoxWidth = pBox->nIdealW : nBoxHeight = pBox->nIdealH
end sub

' FALSE (rc empty) while the box has no client area -- between Create and DoModal/LayoutForTest.
' An absent part answers TRUE with an empty rect.
private function MBX_QueryRect( byval hMsgBox as TK_WIDGET ptr, byval nWhich as long, byref rc as TKRECT ) as boolean
    tkRect_SetEmpty( rc )
    dim as TKMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer( hMsgBox )
    if pBox = 0 then return false
    if pBox->bLayoutDirty then pBox->LayoutBox()
    if pBox->bLayoutDirty then return false
    select case nWhich
    case MBX_PART_CAPTION : rc = pBox->rcCaption
    case MBX_PART_BODY    : rc = pBox->rcBody
    case MBX_PART_FOOTER  : rc = pBox->rcFooter
    case MBX_PART_TEXT    : rc = pBox->rcText
    case MBX_PART_ICON    : rc = pBox->rcIcon
    case MBX_PART_CLOSE   : rc = pBox->rcClose
    case else             : return false
    end select
    return true
end function

public function tkMessageBox_GetCaptionRect( byval hMsgBox as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return MBX_QueryRect( hMsgBox, MBX_PART_CAPTION, rc )
end function
public function tkMessageBox_GetCloseRect( byval hMsgBox as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return MBX_QueryRect( hMsgBox, MBX_PART_CLOSE, rc )
end function
public function tkMessageBox_GetBodyRect( byval hMsgBox as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return MBX_QueryRect( hMsgBox, MBX_PART_BODY, rc )
end function
public function tkMessageBox_GetIconRect( byval hMsgBox as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return MBX_QueryRect( hMsgBox, MBX_PART_ICON, rc )
end function
public function tkMessageBox_GetTextRect( byval hMsgBox as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return MBX_QueryRect( hMsgBox, MBX_PART_TEXT, rc )
end function
public function tkMessageBox_GetFooterRect( byval hMsgBox as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return MBX_QueryRect( hMsgBox, MBX_PART_FOOTER, rc )
end function

public function tkMessageBox_GetButtonRect( byval hMsgBox as TK_WIDGET ptr, byval idx as long, byref rc as TKRECT ) as boolean
    tkRect_SetEmpty( rc )
    dim as TKMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer( hMsgBox )
    if (pBox = 0) orelse (idx < 0) orelse (idx >= pBox->nButtonCount) then return false
    if pBox->bLayoutDirty then pBox->LayoutBox()
    if pBox->bLayoutDirty then return false
    rc = pBox->rcButtons(idx)
    return true
end function

' --- fonts (borrowed) ------------------------------------------------------------------------------
public function tkMessageBox_GetFont( byval hMsgBox as TK_WIDGET ptr ) as TTF_Font ptr
    dim as TKMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer( hMsgBox )
    if pBox = 0 then return 0
    return pBox->pTextFont
end function

' The message AND measuring font; pushed into every button, now and later.
public sub tkMessageBox_SetFont( byval hMsgBox as TK_WIDGET ptr, byval f as TTF_Font ptr )
    dim as TKMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer( hMsgBox )
    if pBox = 0 then exit sub
    pBox->pTextFont = f
    for i as long = 0 to pBox->nButtonCount - 1
        tkButton_SetFont( pBox->hButtons(i), f )
    next
    pBox->Refresh()
end sub

public function tkMessageBox_GetCaptionFont( byval hMsgBox as TK_WIDGET ptr ) as TTF_Font ptr
    dim as TKMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer( hMsgBox )
    if pBox = 0 then return 0
    return pBox->pCaptionFont
end function

public sub tkMessageBox_SetCaptionFont( byval hMsgBox as TK_WIDGET ptr, byval f as TTF_Font ptr )
    dim as TKMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer( hMsgBox )
    if pBox = 0 then exit sub
    pBox->pCaptionFont = f
    pBox->Refresh()
end sub

public function tkMessageBox_GetGlyphFont( byval hMsgBox as TK_WIDGET ptr ) as TTF_Font ptr
    dim as TKMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer( hMsgBox )
    if pBox = 0 then return 0
    return pBox->pGlyphFont
end function

' The MESSAGE ICON's font (also the buttons' glyph font). Repaints only: the cell is declared.
public sub tkMessageBox_SetGlyphFont( byval hMsgBox as TK_WIDGET ptr, byval f as TTF_Font ptr )
    dim as TKMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer( hMsgBox )
    if pBox = 0 then exit sub
    pBox->pGlyphFont = f
    for i as long = 0 to pBox->nButtonCount - 1
        tkButton_SetGlyphFont( pBox->hButtons(i), f )
    next
    tkWidget_Invalidate( hMsgBox )
end sub

public function tkMessageBox_GetCloseGlyphFont( byval hMsgBox as TK_WIDGET ptr ) as TTF_Font ptr
    dim as TKMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer( hMsgBox )
    if pBox = 0 then return 0
    return pBox->pCloseFont
end function

' The close X's font (~10 pt), separate from the ~32 px icon's. Repaints only.
public sub tkMessageBox_SetCloseGlyphFont( byval hMsgBox as TK_WIDGET ptr, byval f as TTF_Font ptr )
    dim as TKMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer( hMsgBox )
    if pBox = 0 then exit sub
    pBox->pCloseFont = f
    tkWidget_Invalidate( hMsgBox )
end sub

' The form's fonts (tkApp): the message font and the icon font.
public sub tkMessageBox_ApplyFonts( byval hMsgBox as TK_WIDGET ptr, byval fText as TTF_Font ptr, byval fGlyph as TTF_Font ptr )
    if fText then tkMessageBox_SetFont( hMsgBox, fText )
    if fGlyph then tkMessageBox_SetGlyphFont( hMsgBox, fGlyph )
end sub

' --- colours and theme ----------------------------------------------------------------------------
public sub tkMessageBox_GetColors( byval hMsgBox as TK_WIDGET ptr, byval pColors as MBX_COLORS ptr )
    dim as TKMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer( hMsgBox )
    if (pBox = 0) orelse (pColors = 0) then exit sub
    *pColors = pBox->colors
end sub

public sub tkMessageBox_SetColors( byval hMsgBox as TK_WIDGET ptr, byval pColors as MBX_COLORS ptr )
    dim as TKMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer( hMsgBox )
    if (pBox = 0) orelse (pColors = 0) then exit sub
    pBox->colors = *pColors
    pBox->bColorsPinned = true
    tkWidget_Invalidate( hMsgBox )
end sub

' Into every button NOW and stored for every button added LATER; pins the buttons and the box.
public sub tkMessageBox_SetButtonColors( byval hMsgBox as TK_WIDGET ptr, byval pColors as TKBUTTON_COLORS ptr )
    dim as TKMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer( hMsgBox )
    if (pBox = 0) orelse (pColors = 0) then exit sub
    pBox->btnColors = *pColors
    pBox->bBtnColorsSet = true
    pBox->bColorsPinned = true
    for i as long = 0 to pBox->nButtonCount - 1
        tkButton_SetColors( pBox->hButtons(i), pColors )
    next
end sub

' Vendor PsMessageBox_ThemeColors, role for role.
public function tkMessageBox_ThemeColors( byref t as TKTHEME_COLORS ) as MBX_COLORS
    dim as MBX_COLORS c
    c.BorderColor = t.Border
    c.CaptionBackColor = t.Surface
    c.CaptionForeColor = t.Text
    c.CloseBackColor = t.Surface
    c.CloseForeColor = t.Text
    c.CloseBackColorHot = t.Error
    c.CloseForeColorHot = t.SelectedText
    c.CloseBackColorPressed = t.Error
    c.CloseForeColorPressed = t.SelectedText
    c.BackColor = t.Window
    c.ForeColor = t.Text
    c.FooterBackColor = t.SurfaceDisabled
    c.DividerColor = t.Divider
    c.IconColorInfo = t.FocusRing
    c.IconColorWarning = t.Warning
    c.IconColorError = t.Error
    c.IconColorQuestion = t.FocusRing
    return c
end function

' The box's colours and its buttons' (tkButton's adapter), unless pinned.
public sub tkMessageBox_ApplyTheme( byval hMsgBox as TK_WIDGET ptr, byref t as TKTHEME_COLORS )
    dim as TKMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer( hMsgBox )
    if (pBox = 0) orelse pBox->bColorsPinned then exit sub
    pBox->colors = tkMessageBox_ThemeColors( t )
    pBox->btnColors = tkButton_ThemeColors( t )
    for i as long = 0 to pBox->nButtonCount - 1
        tkButton_ApplyTheme( pBox->hButtons(i), t )
    next
    tkWidget_Invalidate( hMsgBox )
end sub

public sub tkMessageBox_UnpinColors( byval hMsgBox as TK_WIDGET ptr )
    dim as TKMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer( hMsgBox )
    if pBox = 0 then exit sub
    pBox->bColorsPinned = false
    pBox->bBtnColorsSet = false
    for i as long = 0 to pBox->nButtonCount - 1
        tkButton_UnpinColors( pBox->hButtons(i) )
    next
    tkMessageBox_ApplyTheme( hMsgBox, tkTheme_Of( hMsgBox ) )
end sub

' --- callbacks: 0 removes --------------------------------------------------------------------------
public sub tkMessageBox_SetPaintCallback( byval hMsgBox as TK_WIDGET ptr, byval usersub as MBX_PaintCallbackSub )
    dim as TKMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer( hMsgBox )
    if pBox = 0 then exit sub
    pBox->PaintCallback = usersub
    tkWidget_Invalidate( hMsgBox )
end sub

public sub tkMessageBox_SetMessageCallback( byval hMsgBox as TK_WIDGET ptr, byval userfunc as MBX_MessageCallbackFunc )
    dim as TKMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer( hMsgBox )
    if pBox then pBox->MessageCallback = userfunc
end sub

' The close X's moods, for a host painter or a test.
public function tkMessageBox_GetCloseHot( byval hMsgBox as TK_WIDGET ptr ) as boolean
    dim as TKMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer( hMsgBox )
    if pBox = 0 then return false
    return pBox->isCloseHot
end function


' ========================================================================================
' The tone probe: the box rendered into its dialog's back buffer and read back before any present.
' 0 while the box has no client area (LayoutForTest first).
' ========================================================================================
public function tkMessageBox_CountRenderedTones( byval hMsgBox as TK_WIDGET ptr, byval nPart as long ) as long
    dim as TKRECT rcPart
    if MBX_QueryRect( hMsgBox, nPart, rcPart ) = false then return 0
    if tkRect_IsEmpty( rcPart ) then return 0
    dim as TKMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer( hMsgBox )
    dim as TK_HOST ptr h = pBox->pDlg
    dim as TK_PAINT wp
    wp.renderer = h->renderer
    wp.engine = h->engine
    wp.pFont = h->pDefaultFont
    wp.fScale = h->fScale
    wp.Begin( 0, 0, hMsgBox->cw, hMsgBox->ch )
    MBX_RenderAll( pBox, @wp )
    SDL_SetRenderClipRect( h->renderer, 0 )
    h->bDirty = true
    dim as SDL_Rect sr
    sr.x = rcPart.left : sr.y = rcPart.top : sr.w = tkRect_Width( rcPart ) : sr.h = tkRect_Height( rcPart )
    dim as SDL_Surface ptr s0 = SDL_RenderReadPixels( h->renderer, @sr )
    if s0 = 0 then return 0
    dim as SDL_Surface ptr s = SDL_ConvertSurface( s0, SDL_PIXELFORMAT_ARGB8888 )
    SDL_DestroySurface( s0 )
    if s = 0 then return 0
    dim tones(0 to 63) as ulong
    dim as long n = 0
    for y as long = 0 to s->h - 1
        dim as ulong ptr row = cast( ulong ptr, cast( ubyte ptr, s->pixels ) + y * s->pitch )
        for x as long = 0 to s->w - 1
            dim as ulong c = row[x] and &h00FFFFFFul
            dim as boolean f = false
            for t as long = 0 to n - 1
                if tones(t) = c then f = true : exit for
            next
            if (f = false) andalso (n < 64) then tones(n) = c : n += 1
        next
    next
    SDL_DestroySurface( s )
    return n
end function
