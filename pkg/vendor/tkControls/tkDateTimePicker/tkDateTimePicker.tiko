    BackColor                as ulong = &hFF21252Bul
    BorderColor              as ulong = &hFF3C424Dul
    FocusBorderColor         as ulong = &hFF569CD6ul
    BorderColorDisabled      as ulong = &hFF30343Cul
    DividerColor             as ulong = &hFF3C424Dul
    DividerColorDisabled     as ulong = &hFF30343Cul
    FieldBackColor           as ulong = &hFF2C313Aul
    FieldForeColor           as ulong = &hFFD7DAE0ul
    FieldBackColorDisabled   as ulong = &hFF262A31ul
    FieldForeColorDisabled   as ulong = &hFF5A606Aul
    IconColor                as ulong = &hFF2C313Aul
    IconGlyphColor           as ulong = &hFFBEC4CEul
    IconGlyphColorHot        as ulong = &hFFFFFFFFul
    IconBackColorHot         as ulong = &hFF383E49ul
    IconGlyphColorDisabled   as ulong = &hFF5A606Aul
    ' --- the field's segments ---
    SegmentBackColorFocused  as ulong = &hFF0078D7ul
    SegmentForeColorFocused  as ulong = &hFFFFFFFFul
    PlaceholderColor         as ulong = &hFF8C929Cul
    ' --- the dropdown ---
    PanelBackColor           as ulong = &hFF21252Bul
    PanelBorderColor         as ulong = &hFF464C58ul
    ItemColor                as ulong = &hFFD2D6DCul
    ItemColorDisabled        as ulong = &hFF383C44ul
    ItemBackColorHot         as ulong = &hFF343A44ul
    ItemForeColorHot         as ulong = &hFFFFFFFFul
    ItemBackColorSelected    as ulong = &hFF0078D7ul
    ItemForeColorSelected    as ulong = &hFFFFFFFFul
    ColumnDividerColor       as ulong = &hFF3C424Dul
    FooterColor              as ulong = &hFFAAB0BAul
    FooterColorHot           as ulong = &hFFFFFFFFul
    FooterColorDisabled      as ulong = &hFF464A52ul
    ' --- the dropdown's calendar (tkDatePicker's block) ---
    TitleColor               as ulong = &hFFE1E4EAul
    TitleColorHot            as ulong = &hFFFFFFFFul
    NavGlyphColor            as ulong = &hFFBEC4CEul
    NavGlyphColorHot         as ulong = &hFFFFFFFFul
    NavGlyphColorDisabled    as ulong = &hFF464A52ul
    WeekdayColor             as ulong = &hFF8C929Cul
    DayColor                 as ulong = &hFFD2D6DCul
    DayColorWeekend          as ulong = &hFF96AFCDul
    DayColorAdjacent         as ulong = &hFF7C838Eul
    DayColorDisabled         as ulong = &hFF383C44ul
    DayBackColorHot          as ulong = &hFF343A44ul
    DayForeColorHot          as ulong = &hFFFFFFFFul
    DayBackColorSelected     as ulong = &hFF0078D7ul
    DayForeColorSelected     as ulong = &hFFFFFFFFul
    TodayRingColor           as ulong = &hFF569CD6ul
end type

public type TKDATETIMEPICKER_PAINTINFO
    hCtrl        as TK_WIDGET ptr
    b            as TK_PAINT ptr
    rcClient     as TKRECT
    rcFrame      as TKRECT
    rcField      as TKRECT
    rcDiv        as TKRECT
    rcIcon       as TKRECT                ' the button cell (empty with TKDTM_BUTTON_NONE)
    rcUp         as TKRECT                ' spin halves (empty unless TKDTM_BUTTON_SPIN)
    rcDown       as TKRECT
    isEnabled    as boolean
    isFocused    as boolean
    isOpen       as boolean
    hasValue     as boolean
    nHotPart     as long                  ' TKDTM_HIT_*
    nPressedPart as long
    nFocusSeg    as long                  ' segment index, -1 unfocused
end type

public type TKDATETIMEPICKER_MESSAGEINFO
    hCtrl  as TK_WIDGET ptr
    msg    as long
    x      as single
    y      as single
    key    as long
    mods   as long
    wheelX as single
    wheelY as single
end type

public type TKDATETIMEPICKER_TOOLTIPINFO
    hCtrl    as TK_WIDGET ptr
    dt       as TKDATETIME         ' the value (empty when there is none)
    hasValue as boolean
    nPart    as long               ' TKDTM_HIT_* under the pointer
    nSegment as long               ' the segment under the pointer, -1 (a literal, the button, outside)
    outText  as ustring            ' the tip's text: set it, and return TRUE to show it
end type

' FormatDateTime: sOut arrives as the pattern's text; set it to show other text at rest ("" keeps it).
public type DTM_FormatCallbackSub as sub( byval hCtrl as TK_WIDGET ptr, byval pDT as TKDATETIME ptr, byref sOut as ustring )
public type DTM_TooltipCallbackFunc as function( byval t as TKDATETIMEPICKER_TOOLTIPINFO ptr ) as boolean
public type DTM_DateTimeChangedCallbackSub as sub( byval hCtrl as TK_WIDGET ptr, byval pDT as TKDATETIME ptr, byval bHasValue as boolean )
public type DTM_DropDownCallbackSub as sub( byval hCtrl as TK_WIDGET ptr, byval isOpen as boolean )
public type DTM_PaintCallbackSub as sub( byval p as TKDATETIMEPICKER_PAINTINFO ptr )
public type DTM_ItemDisabledCallbackFunc as function( byval hCtrl as TK_WIDGET ptr, byval nKind as long, byval nValue as long ) as boolean
public type DTM_MessageCallbackFunc as function( byval m as TKDATETIMEPICKER_MESSAGEINFO ptr ) as boolean

type TKDATETIMEPICKER_STATE
    hWin            as TK_WIDGET ptr
    idc             as long
    isEnabled       as boolean = true
    isFocused       as boolean
    bColorsPinned   as boolean
    bShapePinned    as boolean
    bLayoutDirty    as boolean = true
    colors          as TKDATETIMEPICKER_COLORS
    ' value and rules
    tm              as TKDATETIME
    tMin            as TKDATETIME
    tMax            as TKDATETIME
    hasMin          as boolean
    hasMax          as boolean
    bAllowEmpty     as boolean = true
    nStep           as long = TKTP_DEFAULT_STEP
    ' display
    sPattern        as ustring = TKDTM_DEFAULT_PATTERN
    sAm             as ustring = "AM"
    sPm             as ustring = "PM"
    names           as TKDT_NAMES
    nWeekStart      as long = CAL_SUNDAY
    sPlaceholder    as ustring
    segs(any)       as TKTIME_SEGMENT
    nSegs           as long
    segX(any)       as long
    segW(any)       as long
    nZeroFrom       as long = 2                  ' the first time unit a user edit zeroes: 0 h, 1 m, 2 s, 3 ms, 4 none
    ' editing
    nFocusSeg       as long = -1
    sEntry          as string                    ' a partial entry's digits (or a month name's letters)
    nEntryTick      as ulongint
    bTabMovesSegments as boolean
    nWheelAccum     as single
    ' button cell
    nButtonStyle    as long = TKDTM_BUTTON_DROPDOWN
    nHotPart        as long
    nPressedPart    as long
    bRepeatOn       as boolean
    nRepeatDelay    as long = CDTM_DEFAULT_REPEATDELAY
    nRepeatInterval as long = CDTM_DEFAULT_REPEATINTERVAL
    ' the dropdown
    nVisibleRows    as long = TKTP_DEFAULT_ROWS
    bShowNow        as boolean
    sNowText        as ustring = "Now"
    sOKText         as ustring = "OK"
    tNowPinned      as TKDATETIME
    bNowPinned      as boolean
    pend            as TKDATETIME                ' the dropdown's pending choice
    isOpen          as boolean
    pPop            as TK_HOST ptr
    wPop            as TK_WIDGET ptr
    wCal            as TK_WIDGET ptr
    wPanel          as TK_WIDGET ptr
    wFooter         as TK_WIDGET ptr
    nFooterHot      as long = -1                 ' 0 Now, 1 OK
    nClosedBySerial as ulong = &hFFFFFFFFul
    bSilentClose    as boolean
    ' fonts and metrics
    pFont           as TTF_Font ptr              ' borrowed; 0 = the host's
    pIconFont       as TTF_Font ptr              ' borrowed; 0 = the drawn icon
    wszIconGlyph    as ustring
    nIconWidth      as long
    nFieldPad       as long
    nVertPadding    as long
    nCornerRadius   as long
    nBorderThick    as long = CDTM_DEFAULT_BORDERTHICK
    nDividerThick   as long = CDTM_DEFAULT_DIVIDERTHICK
    nFooterH        as long
    rcFrame         as TKRECT
    rcField         as TKRECT
    rcDiv           as TKRECT
    rcIcon          as TKRECT
    rcUp            as TKRECT
    rcDown          as TKRECT
    ' callbacks
    DateTimeChangedCallback as DTM_DateTimeChangedCallbackSub
    DropDownCallback     as DTM_DropDownCallbackSub
    PaintCallback        as DTM_PaintCallbackSub
    ItemDisabledCallback as DTM_ItemDisabledCallbackFunc
    MessageCallback      as DTM_MessageCallbackFunc
    FormatCallback       as DTM_FormatCallbackSub
    TooltipCallback      as DTM_TooltipCallbackFunc
    tip                  as TKTIPHOST_STATE
    nMouseX              as long = -1
    nMouseY              as long = -1
end type

dim shared as TKDATETIMEPICKER_STATE ptr gOpenDateTimePicker     ' one dropdown open per process


' ==========================================================================================
' State helpers
' ==========================================================================================
function DTM( byval w as TK_WIDGET ptr ) as TKDATETIMEPICKER_STATE ptr
    if w = 0 then return 0
    return cast( TKDATETIMEPICKER_STATE ptr, w->pData )
end function

function DtmFont( byval p as TKDATETIMEPICKER_STATE ptr ) as TTF_Font ptr
    if p->pFont then return p->pFont
    return p->hWin->pHost->pDefaultFont
end function

' The pattern as segments, and what a user edit zeroes.
' The pattern as segments (date tokens on), and what a user edit zeroes.
sub DtmParse( byval p as TKDATETIMEPICKER_STATE ptr )
    p->nSegs = tkTimePanel_ParsePattern( p->sPattern, p->segs(), true )
    if p->nSegs = 0 then p->nSegs = tkTimePanel_ParsePattern( TKDTM_DEFAULT_PATTERN, p->segs(), true )
    redim p->segX( 0 to p->nSegs - 1 )
    redim p->segW( 0 to p->nSegs - 1 )
    dim as long finest = -1                     ' -1: no time shown at all
    for i as long = 0 to p->nSegs - 1
        select case p->segs( i ).kind
        case TKTP_SEG_HOUR24, TKTP_SEG_HOUR12, TKTP_SEG_AMPM : if finest < 0 then finest = 0
        case TKTP_SEG_MINUTE   : if finest < 1 then finest = 1
        case TKTP_SEG_SECOND   : if finest < 2 then finest = 2
        case TKTP_SEG_FRACTION : finest = 3
        end select
    next
    p->nZeroFrom = finest + 1
    p->sEntry = ""
    if (p->nFocusSeg >= p->nSegs) orelse ((p->nFocusSeg >= 0) andalso (DtmIsEditable( p, p->nFocusSeg ) = false)) then p->nFocusSeg = -1
    p->bLayoutDirty = true
end sub

function DtmIsEditable( byval p as TKDATETIMEPICKER_STATE ptr, byval i as long ) as boolean
    if (i < 0) orelse (i >= p->nSegs) then return false
    return (p->segs( i ).kind <> TKTP_SEG_LITERAL) andalso (p->segs( i ).kind <> TKTP_SEG_WEEKDAY)
end function

function DtmFirstSeg( byval p as TKDATETIMEPICKER_STATE ptr ) as long
    for i as long = 0 to p->nSegs - 1
        if DtmIsEditable( p, i ) then return i
    next
    return -1
end function

function DtmLastSeg( byval p as TKDATETIMEPICKER_STATE ptr ) as long
    for i as long = p->nSegs - 1 to 0 step -1
        if DtmIsEditable( p, i ) then return i
    next
    return -1
end function

' The editable segment after (dirn 1) or before (-1) i, or -1.
function DtmNextSeg( byval p as TKDATETIMEPICKER_STATE ptr, byval i as long, byval dirn as long ) as long
    dim as long j = i + dirn
    while (j >= 0) andalso (j < p->nSegs)
        if DtmIsEditable( p, j ) then return j
        j += dirn
    wend
    return -1
end function

function DtmClampSerial( byval p as TKDATETIMEPICKER_STATE ptr, byval ser as longint ) as longint
    if p->hasMin andalso (ser < tkTimePanel_DateTimeToSerial( p->tMin )) then ser = tkTimePanel_DateTimeToSerial( p->tMin )
    if p->hasMax andalso (ser > tkTimePanel_DateTimeToSerial( p->tMax )) then ser = tkTimePanel_DateTimeToSerial( p->tMax )
    return ser
end function

' A USER edit's result: the parts the pattern hides zeroed (TIMEPICKER.md D-4), then clamped.
' A USER edit's result: the day clamped to its month, the time parts the pattern hides zeroed
' (TIMEPICKER.md D-4), then clamped to the range.
function DtmFinish( byval p as TKDATETIMEPICKER_STATE ptr, byval t as TKDATETIME ) as TKDATETIME
    if (t.wYear < 1) orelse (t.wMonth < 1) then return tkTimePanel_EmptyDateTime( )
    if t.wYear > 9999 then t.wYear = 9999
    dim as long dim_ = tkTimePanel_DaysInMonth( t.wYear, t.wMonth )
    if t.wDay > dim_ then t.wDay = dim_
    if t.wDay < 1 then t.wDay = 1
    if p->nZeroFrom <= 0 then t.wHour = 0
    if p->nZeroFrom <= 1 then t.wMinute = 0
    if p->nZeroFrom <= 2 then t.wSecond = 0
    if p->nZeroFrom <= 3 then t.wMilliseconds = 0
    dim as TKDATETIME r = tkTimePanel_MakeDateTime( t.wYear, t.wMonth, t.wDay, t.wHour, t.wMinute, t.wSecond, t.wMilliseconds )
    if tkTimePanel_IsDateTime( r ) = false then return r
    return tkTimePanel_SerialToDateTime( DtmClampSerial( p, tkTimePanel_DateTimeToSerial( r ) ) )
end function

' "Now": pinned (tests, screenshots), or the clock.
function DtmNow( byval p as TKDATETIMEPICKER_STATE ptr ) as TKDATETIME
    if p->bNowPinned then return p->tNowPinned
    return tkTimePanel_LocalNowDateTime( )
end function

' The time edits start from: the value, else midnight (D-7).
' The value edits start from: the value, else today at 00:00 (a date needs a day; D-7 adjusted).
function DtmBase( byval p as TKDATETIMEPICKER_STATE ptr ) as TKDATETIME
    if tkTimePanel_IsDateTime( p->tm ) then return p->tm
    dim as TKDATETIME n = DtmNow( p )
    return tkTimePanel_MakeDateTime( n.wYear, n.wMonth, n.wDay )
end function

' The value set by the USER. TRUE when it changed (the caller notifies, last).
' The value set by the USER. TRUE when it changed (the caller notifies, last).
function DtmUserSet( byval p as TKDATETIMEPICKER_STATE ptr, byref t as const TKDATETIME ) as boolean
    dim as boolean bWas = tkTimePanel_IsDateTime( p->tm ), bNow = tkTimePanel_IsDateTime( t )
    if (bWas = bNow) andalso ((bNow = false) orelse tkTimePanel_SameDateTime( p->tm, t )) then return false
    if bNow then p->tm = t else p->tm = tkTimePanel_EmptyDateTime( )
    p->bLayoutDirty = true
    tkWidget_Invalidate( p->hWin )
    return true
end function

' From a snapshot, last: the callback may destroy the picker.
' From a snapshot, last: the callback may destroy the picker.
sub DtmNotify( byval p as TKDATETIMEPICKER_STATE ptr )
    dim as TK_WIDGET ptr w = p->hWin
    dim as TKDATETIME t = p->tm
    dim as DTM_DateTimeChangedCallbackSub cb = p->DateTimeChangedCallback
    if cb then cb( w, @t, tkTimePanel_IsDateTime( t ) )
end sub

function DtmCallMessage( byval p as TKDATETIMEPICKER_STATE ptr, byval m as TK_MSG ptr ) as boolean
    if p->MessageCallback = 0 then return false
    dim as TKDATETIMEPICKER_MESSAGEINFO mi
    mi.hCtrl = p->hWin
    mi.msg = m->msg
    mi.x = m->x : mi.y = m->y
    mi.key = m->key : mi.mods = m->mods
    mi.wheelX = m->wheelX : mi.wheelY = m->wheelY
    return p->MessageCallback( @mi )
end function

' ---- what the field shows ------------------------------------------------------------------------
' t as text: the pattern's, then FormatTime's say ("" from it keeps the pattern's). "" for no time.
' t as text: the pattern's, then FormatDateTime's say ("" from it keeps the pattern's). "" for none.
function DtmFormatOf( byval p as TKDATETIMEPICKER_STATE ptr, byref t as const TKDATETIME ) as ustring
    if tkTimePanel_IsDateTime( t ) = false then return ""
    dim as ustring sOut = tkTimePanel_FormatPatternDT( t, p->sPattern, p->sAm, p->sPm, @p->names )
    if p->FormatCallback then
        dim as ustring sDef = sOut
        dim as TKDATETIME tc = t
        p->FormatCallback( p->hWin, @tc, sOut )
        if len( sOut ) = 0 then sOut = sDef
    end if
    return sOut
end function

' At rest -- unfocused, a time, no pending entry -- a FormatTime callback's text replaces the segments.
function DtmShowsFormat( byval p as TKDATETIMEPICKER_STATE ptr ) as boolean
    return (p->FormatCallback <> 0) andalso (p->isFocused = false) andalso tkTimePanel_IsDateTime( p->tm ) _
           andalso (len( p->sEntry ) = 0)
end function

function DtmSegText( byval p as TKDATETIMEPICKER_STATE ptr, byval i as long ) as ustring
    with p->segs( i )
        if .kind = TKTP_SEG_LITERAL then return .text
        if (i = p->nFocusSeg) andalso (len( p->sEntry ) > 0) then
            ' letters typed into a month name show the month they found
            dim as long c0 = asc( p->sEntry, 1 )
            if ((c0 < 48) orelse (c0 > 57)) andalso tkTimePanel_IsDateTime( p->tm ) then
                return tkTimePanel_SegmentTextDT( .kind, .nLen, p->tm, p->sAm, p->sPm, @p->names )
            end if
            return p->sEntry
        end if
        if tkTimePanel_IsDateTime( p->tm ) then return tkTimePanel_SegmentTextDT( .kind, .nLen, p->tm, p->sAm, p->sPm, @p->names )
        select case .kind
        case TKTP_SEG_FRACTION : return string( .nLen, "-" )
        case TKTP_SEG_YEAR     : return string( iif( .nLen >= 4, 4, 2 ), "-" )
        case TKTP_SEG_MONTHNAME, TKTP_SEG_WEEKDAY : return "---"
        end select
        return "--"
    end with
end function

' ---- layout -------------------------------------------------------------------------------------
' tkDatePicker's layout: the button cell = the right nIconWidth pixels, the divider left of it, the
' field from left + radius to the divider, inset by the border. No button: no cell, no divider.
sub DtmLayout( byval p as TKDATETIMEPICKER_STATE ptr )
    dim as long cw = p->hWin->cw, ch = p->hWin->ch
    p->bLayoutDirty = false
    tkRect_Set( p->rcFrame, 0, 0, cw, ch )
    tkRect_Set( p->rcIcon, cw, 0, cw, ch )
    tkRect_Set( p->rcDiv, cw, 0, cw, ch )
    tkRect_Set( p->rcUp, 0, 0, 0, 0 )
    tkRect_Set( p->rcDown, 0, 0, 0, 0 )
    dim as long fr = cw - p->nBorderThick
    if p->nButtonStyle <> TKDTM_BUTTON_NONE then
        tkRect_Set( p->rcIcon, cw - p->nIconWidth, 0, cw, ch )
        tkRect_Set( p->rcDiv, p->rcIcon.left - p->nDividerThick, 0, p->rcIcon.left, ch )
        fr = p->rcDiv.left
        if p->nButtonStyle = TKDTM_BUTTON_SPIN then
            dim as long mid_ = ch \ 2
            tkRect_Set( p->rcUp, p->rcIcon.left, 0, cw, mid_ )
            tkRect_Set( p->rcDown, p->rcIcon.left, mid_, cw, ch )
        end if
    end if
    dim as long fl = p->nCornerRadius
    if fr < fl then fr = fl
    dim as long ft = p->nBorderThick, fb = ch - p->nBorderThick
    if fb < ft then fb = ft
    tkRect_Set( p->rcField, fl, ft, fr, fb )
    ' the segments, left to right from the field's padding, each as wide as its text
    dim as TTF_Font ptr f = DtmFont( p )
    dim as long x = p->rcField.left + p->nFieldPad
    for i as long = 0 to p->nSegs - 1
        p->segX( i ) = x
        p->segW( i ) = tkText_Width( f, DtmSegText( p, i ) )
        x += p->segW( i )
    next
end sub

sub DtmEnsureLayout( byval p as TKDATETIMEPICKER_STATE ptr )
    ' segment widths follow the text, which changes with every edit: lay out on demand
    DtmLayout( p )
end sub

sub DtmRefresh( byval p as TKDATETIMEPICKER_STATE ptr )
    p->bLayoutDirty = true
    tkWidget_Invalidate( p->hWin )
end sub

function DtmHit( byval p as TKDATETIMEPICKER_STATE ptr, byval x as single, byval y as single ) as long
    DtmEnsureLayout( p )
    if (x < 0) orelse (y < 0) orelse (x >= p->hWin->cw) orelse (y >= p->hWin->ch) then return TKDTM_HIT_NONE
    select case p->nButtonStyle
    case TKDTM_BUTTON_DROPDOWN
        if tkRect_Contains( p->rcIcon, x, y ) then return TKDTM_HIT_BUTTON
    case TKDTM_BUTTON_SPIN
        if tkRect_Contains( p->rcUp, x, y ) then return TKDTM_HIT_SPINUP
        if tkRect_Contains( p->rcDown, x, y ) then return TKDTM_HIT_SPINDOWN
    end select
    return TKDTM_HIT_FIELD
end function

' The editable segment at x: the one under it, else the nearest.
function DtmSegAt( byval p as TKDATETIMEPICKER_STATE ptr, byval x as long ) as long
    DtmEnsureLayout( p )
    dim as long best = -1, bestD = &h7FFFFFFF
    for i as long = 0 to p->nSegs - 1
        if DtmIsEditable( p, i ) then
            dim as long d = 0
            if x < p->segX( i ) then
                d = p->segX( i ) - x
            elseif x >= p->segX( i ) + p->segW( i ) then
                d = x - (p->segX( i ) + p->segW( i )) + 1
            end if
            if d < bestD then best = i : bestD = d
        end if
    next
    return best
end function

' ---- painting -----------------------------------------------------------------------------------
' The drawn clock: a ring and two hands, until a glyph font is handed over.
sub DtmPaintClock( byval b as TK_PAINT ptr, byref rc as TKRECT, byval clrGlyph as ulong, byval clrBack as ulong )
    dim as long d = ((rc.right - rc.left) * 5) \ 9
    if d < 6 then exit sub
    dim as long x = rc.left + ((rc.right - rc.left) - d) \ 2
    dim as long y = rc.top + ((rc.bottom - rc.top) - d) \ 2
    dim as long th = (d + 8) \ 16
    if th < 1 then th = 1
    dim as TKRECT r
    tkRect_Set( r, x, y, x + d, y + d )
    b->SetBackColor( clrBack )
    b->SetPenColor( clrGlyph )
    b->PaintEllipse( @r, th )
    dim as long cx = x + d \ 2, cy = y + d \ 2
    b->SetPenColor( clrGlyph )
    b->PaintLine( th, cx, cy, cx, y + (d * 2) \ 9 )                ' minute hand, to 12
    b->PaintLine( th, cx, cy, x + (d * 3) \ 4 - th, cy )           ' hour hand, to 3
end sub

' A small chevron, up or down, centred in rc.
sub DtmPaintChevron( byval b as TK_PAINT ptr, byref rc as TKRECT, byval bUp as boolean, byval clr as ulong, byval th as long )
    dim as long w = (rc.right - rc.left) \ 3
    if w < 4 then w = 4
    dim as long hgt = w \ 2
    dim as long cx = (rc.left + rc.right) \ 2, cy = (rc.top + rc.bottom) \ 2
    dim as TKPOINT pts( 0 to 2 )
    pts( 0 ).x = cx - w \ 2 : pts( 2 ).x = cx + w \ 2 : pts( 1 ).x = cx
    if bUp then
        pts( 0 ).y = cy + hgt \ 2 : pts( 2 ).y = pts( 0 ).y : pts( 1 ).y = cy - hgt \ 2
    else
        pts( 0 ).y = cy - hgt \ 2 : pts( 2 ).y = pts( 0 ).y : pts( 1 ).y = cy + hgt \ 2
    end if
    b->SetPenColor( clr )
    b->PaintPolyline( @pts( 0 ), 3, th )
end sub

sub DtmRenderDefault( byval p as TKDATETIMEPICKER_STATE ptr, byval pi as TKDATETIMEPICKER_PAINTINFO ptr )
    dim as TK_PAINT ptr b = pi->b
    dim as long cw = pi->rcFrame.right - pi->rcFrame.left, ch = pi->rcFrame.bottom - pi->rcFrame.top
    if (cw <= 0) orelse (ch <= 0) then exit sub
    dim as long ell = p->nCornerRadius * 2
    dim as TKRECT rcFrame = pi->rcFrame
    b->SetBackColor( iif( pi->isEnabled, p->colors.FieldBackColor, p->colors.FieldBackColorDisabled ) )
    b->PaintRoundRect( @rcFrame, ell )
    ' the button cell, extended inward past the divider so only its outer corners round
    if p->nButtonStyle <> TKDTM_BUTTON_NONE then
        dim as long ext = p->nCornerRadius + p->nDividerThick + 1
        dim as TKRECT rcFill
        tkRect_Set( rcFill, pi->rcIcon.left - ext, pi->rcIcon.top, pi->rcIcon.right, pi->rcIcon.bottom )
        dim as boolean bLit = (p->nButtonStyle = TKDTM_BUTTON_DROPDOWN) andalso _
                              ((pi->nHotPart = TKDTM_HIT_BUTTON) orelse (pi->nPressedPart = TKDTM_HIT_BUTTON) orelse pi->isOpen)
        b->SetBackColor( iif( pi->isEnabled andalso bLit, p->colors.IconBackColorHot, p->colors.IconColor ) )
        b->PaintRoundRect( @rcFill, ell )
        if p->nDividerThick > 0 then
            dim as TKRECT rcDiv = pi->rcDiv
            b->SetBackColor( iif( pi->isEnabled, p->colors.DividerColor, p->colors.DividerColorDisabled ) )
            b->PaintRect( @rcDiv )
        end if
        if p->nButtonStyle = TKDTM_BUTTON_DROPDOWN then
            dim as ulong clrGlyph = p->colors.IconGlyphColor
            if pi->isEnabled = false then
                clrGlyph = p->colors.IconGlyphColorDisabled
            elseif bLit then
                clrGlyph = p->colors.IconGlyphColorHot
            end if
            dim as TKRECT rcIcon = pi->rcIcon
            if (p->pIconFont <> 0) andalso (len( p->wszIconGlyph ) > 0) then
                b->SetFont( p->pIconFont )
                b->SetForeColor( clrGlyph )
                b->PaintText( p->wszIconGlyph, @rcIcon, TK_DT_CENTER )
            else
                DtmPaintClock( b, rcIcon, clrGlyph, iif( pi->isEnabled andalso bLit, p->colors.IconBackColorHot, p->colors.IconColor ) )
            end if
        else
            dim as long th = cint( p->hWin->pHost->fScale * 1.5 )      ' 2 px at 1.0, 3 at 1.75
            if th < 1 then th = 1
            for k as long = 0 to 1
                dim as TKRECT r = pi->rcDown
                if k = 0 then r = pi->rcUp
                dim as long part = iif( k = 0, TKDTM_HIT_SPINUP, TKDTM_HIT_SPINDOWN )
                dim as ulong clr = p->colors.IconGlyphColor
                if pi->isEnabled = false then
                    clr = p->colors.IconGlyphColorDisabled
                elseif (pi->nHotPart = part) orelse (pi->nPressedPart = part) then
                    clr = p->colors.IconGlyphColorHot
                end if
                DtmPaintChevron( b, r, k = 0, clr, th )
            next
        end if
    end if
    ' the segments
    dim as TTF_Font ptr f = DtmFont( p )
    b->SetFont( f )
    dim as boolean bEmpty = (pi->hasValue = false) andalso (len( p->sEntry ) = 0)
    if DtmShowsFormat( p ) then
        dim as TKRECT rcF = pi->rcField
        rcF.left += p->nFieldPad
        b->SetForeColor( iif( pi->isEnabled, p->colors.FieldForeColor, p->colors.FieldForeColorDisabled ) )
        b->PaintText( DtmFormatOf( p, p->tm ), @rcF, TK_DT_LEFT or TK_DT_ELLIPSIS )
    elseif bEmpty andalso (len( p->sPlaceholder ) > 0) andalso (pi->isFocused = false) then
        dim as TKRECT rcT = pi->rcField
        rcT.left += p->nFieldPad
        b->SetForeColor( iif( pi->isEnabled, p->colors.PlaceholderColor, p->colors.FieldForeColorDisabled ) )
        b->PaintText( p->sPlaceholder, @rcT, TK_DT_LEFT or TK_DT_ELLIPSIS )
    else
        dim as TKRECT rcClip = pi->rcField
        b->PushClip( @rcClip )
        dim as long textH = tkText_Height( f )
        dim as long cy = (pi->rcField.top + pi->rcField.bottom) \ 2
        for i as long = 0 to p->nSegs - 1
            dim as TKRECT rs
            tkRect_Set( rs, p->segX( i ), pi->rcField.top, p->segX( i ) + p->segW( i ), pi->rcField.bottom )
            dim as ulong fore = p->colors.FieldForeColor
            if pi->isEnabled = false then
                fore = p->colors.FieldForeColorDisabled
            elseif bEmpty andalso (p->segs( i ).kind <> TKTP_SEG_LITERAL) then
                fore = p->colors.PlaceholderColor
            end if
            if pi->isFocused andalso pi->isEnabled andalso (i = pi->nFocusSeg) then
                dim as TKRECT rh
                tkRect_Set( rh, rs.left - 1, cy - textH \ 2, rs.right + 1, cy - textH \ 2 + textH )
                b->SetBackColor( p->colors.SegmentBackColorFocused )
                b->PaintRect( @rh )
                fore = p->colors.SegmentForeColorFocused
            end if
            b->SetForeColor( fore )
            b->PaintText( DtmSegText( p, i ), @rs, TK_DT_LEFT or TK_DT_NOCLIP )
        next
        b->PopClip()
    end if
    ' the outline last
    if p->nBorderThick > 0 then
        dim as ulong clrBorder = p->colors.BorderColor
        if pi->isEnabled = false then
            clrBorder = p->colors.BorderColorDisabled
        elseif pi->isFocused orelse pi->isOpen then
            clrBorder = p->colors.FocusBorderColor
        end if
        b->SetPenColor( clrBorder )
        b->PaintRoundOutline( @rcFrame, ell, p->nBorderThick )
    end if
end sub

sub DtmPaint( byval p as TKDATETIMEPICKER_STATE ptr, byval b as TK_PAINT ptr )
    DtmEnsureLayout( p )
    dim as TKDATETIMEPICKER_PAINTINFO pi
    pi.hCtrl = p->hWin : pi.b = b
    tkRect_Set( pi.rcClient, 0, 0, p->hWin->cw, p->hWin->ch )
    b->SetBackColor( p->colors.BackColor )
    b->PaintRect( @pi.rcClient )
    pi.rcFrame = p->rcFrame : pi.rcField = p->rcField : pi.rcDiv = p->rcDiv : pi.rcIcon = p->rcIcon
    pi.rcUp = p->rcUp : pi.rcDown = p->rcDown
    pi.isEnabled = p->isEnabled : pi.isFocused = p->isFocused : pi.isOpen = p->isOpen
    pi.hasValue = tkTimePanel_IsDateTime( p->tm )
    pi.nHotPart = p->nHotPart : pi.nPressedPart = p->nPressedPart
    pi.nFocusSeg = iif( p->isFocused, p->nFocusSeg, -1 )
    if p->PaintCallback then p->PaintCallback( @pi ) else DtmRenderDefault( p, @pi )
end sub

sub DtmSetHot( byval p as TKDATETIMEPICKER_STATE ptr, byval part as long )
    if part <> p->nHotPart then p->nHotPart = part : tkWidget_Invalidate( p->hWin )
end sub

sub DtmRescale( byval p as TKDATETIMEPICKER_STATE ptr, byval fOld as single, byval fNew as single )
    if (fOld <= 0) orelse (fNew <= 0) orelse (fOld = fNew) then exit sub
    dim as single k = fNew / fOld
    p->nIconWidth = cint( p->nIconWidth * k )
    p->nFieldPad = cint( p->nFieldPad * k )
    p->nVertPadding = cint( p->nVertPadding * k )
    p->nCornerRadius = cint( p->nCornerRadius * k )
    p->nFooterH = cint( p->nFooterH * k )
    if p->isOpen then tkDateTimePicker_CloseUp( p->hWin )     ' sized for the old scale
    DtmRefresh( p )
end sub


' ==========================================================================================
' The proc
' ==========================================================================================
function DtmProc( byval w as TK_WIDGET ptr, byval m as TK_MSG ptr ) as boolean
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( w )
    if p = 0 then return false
    dim as TK_HOST ptr h = w->pHost
    select case m->msg
    case TKM_PAINT
        DtmPaint( p, m->pPaint )
        return true

    case TKM_SIZE
        DtmRefresh( p )
        return true

    case TKM_SCALECHANGED
        DtmRescale( p, m->fOld, m->fNew )
        return true

    case TKM_THEMECHANGED
        tkDateTimePicker_ApplyTheme( w, tkTheme_Of( w ) )
        return true

    case TKM_MOUSEMOVE
        p->nMouseX = cint( m->x ) : p->nMouseY = cint( m->y )
        if p->TooltipCallback then tkTipHost_SetToolIndex( @p->tip, DtmTipIndex( p ) )
        if DtmCallMessage( p, m ) then return true
        if p->isEnabled = false then return true
        dim as long part = DtmHit( p, m->x, m->y )
        DtmSetHot( p, iif( part = TKDTM_HIT_FIELD, TKDTM_HIT_NONE, part ) )
        return true

    case TKM_MOUSELEAVE
        DtmCallMessage( p, m )
        DtmSetHot( p, TKDTM_HIT_NONE )
        return true

    case TKM_LBUTTONDOWN
        if p->isEnabled = false then return true
        tkTipHost_Pop( @p->tip )
        if DtmCallMessage( p, m ) then return true
        return DtmPress( p, m->x, m->y )

    case TKM_LBUTTONUP
        DtmCallMessage( p, m )
        DtmRelease( p )
        return true

    case TKM_CAPTURECHANGED
        DtmStopRepeat( p )
        if p->nPressedPart <> TKDTM_HIT_NONE then p->nPressedPart = TKDTM_HIT_NONE : tkWidget_Invalidate( w )
        return true

    case TKM_TIMER
        return DtmTimer( p, m->timerId )

    case TKM_SETFOCUS
        p->isFocused = true
        if DtmIsEditable( p, p->nFocusSeg ) = false then p->nFocusSeg = DtmFirstSeg( p )
        tkWidget_Invalidate( w )
        DtmCallMessage( p, m )
        return true

    case TKM_KILLFOCUS
        p->isFocused = false
        p->nWheelAccum = 0
        tkWidget_Invalidate( w )
        dim as boolean bChanged = DtmCommitEntry( p )
        DtmCallMessage( p, m )
        if bChanged then DtmNotify( p )
        return true

    case TKM_KEYDOWN
        if p->isEnabled = false then return false
        if DtmCallMessage( p, m ) then return true
        return DtmKey( p, m->key, m->mods, m->scancode )

    case TKM_MOUSEWHEEL
        if (p->isEnabled = false) orelse (p->isFocused = false) then return false     ' D-8: it scrolls the form
        if DtmCallMessage( p, m ) then return true
        return DtmWheel( p, m->x, m->wheelY )

    case TKM_ENABLE
        p->isEnabled = m->bFlag
        if p->isEnabled = false then
            if p->isOpen then tkDateTimePicker_CloseUp( w )
            DtmStopRepeat( p )
            p->nHotPart = TKDTM_HIT_NONE : p->nPressedPart = TKDTM_HIT_NONE
            p->sEntry = ""
        end if
        tkWidget_Invalidate( w )
        DtmCallMessage( p, m )
        return true

    case TKM_DESTROY
        if p->pPop then
            p->bSilentClose = true
            tkHost_Close( p->pPop )
        end if
        if gOpenDateTimePicker = p then gOpenDateTimePicker = 0
        tkWidget_KillTimer( w, TK_TIMER_AUTOREPEAT )
        tkWidget_KillTimer( w, DTM_TIMER_ENTRY )
        tkTipHost_Destroy( @p->tip )
        delete p
        w->pData = 0
        return true
    end select
    return false
end function


' ==========================================================================================
' Public API
' ==========================================================================================
' A child of hParent, created 0x0: size it from GetIdealSize.
public function tkDateTimePicker_Create( byval hParent as TK_WIDGET ptr, byval CtrlID as long ) as TK_WIDGET ptr
    if hParent = 0 then return 0
    dim as TK_HOST ptr h = hParent->pHost
    dim as TKDATETIMEPICKER_STATE ptr p = new TKDATETIMEPICKER_STATE
    p->idc = CtrlID
    p->nIconWidth = tkHost_Scale( h, CDTM_DEFAULT_ICONWIDTH )
    p->nFieldPad = tkHost_Scale( h, CDTM_DEFAULT_FIELDPAD )
    p->nVertPadding = tkHost_Scale( h, CDTM_DEFAULT_VERTPAD )
    p->nCornerRadius = tkHost_Scale( h, CDTM_DEFAULT_CORNERRADIUS )
    p->nFooterH = tkHost_Scale( h, CDTM_FOOTERH )
    p->names = tkTimePanel_DefaultNames( )
    DtmParse( p )
    dim as TK_WIDGET ptr w = tkWidget_CreateChild( hParent, CtrlID, @DtmProc, p )
    w->isFocusable = true
    p->hWin = w
    p->colors = tkDateTimePicker_ThemeColors( tkTheme_Of( w ) )
    tkTheme_ResolveInto( w, tkTheme_Of( w ), cast( ulong ptr, @p->colors ), sizeof( TKDATETIMEPICKER_COLORS ) \ 4, "DateTimePicker" )
    DtmApplyThemeShape( w )
    return w
end function

public function tkDateTimePicker_GetID( byval hCtrl as TK_WIDGET ptr ) as long
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then return 0
    return p->idc
end function

public function tkDateTimePicker_GetEnabled( byval hCtrl as TK_WIDGET ptr ) as boolean
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then return false
    return p->isEnabled
end function

public sub tkDateTimePicker_SetEnabled( byval hCtrl as TK_WIDGET ptr, byval isEnabled as boolean )
    if hCtrl then tkWidget_Enable( hCtrl, isEnabled )
end sub

public function tkDateTimePicker_GetFocused( byval hCtrl as TK_WIDGET ptr ) as boolean
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then return false
    return p->isFocused
end function

public sub tkDateTimePicker_Refresh( byval hCtrl as TK_WIDGET ptr )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p then DtmRefresh( p )
end sub

' ---- value (all silent) ---------------------------------------------------------------------------
public function tkDateTimePicker_GetDateTime( byval hCtrl as TK_WIDGET ptr, byref t as TKDATETIME ) as boolean
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    t = tkTimePanel_EmptyDateTime( )
    if p = 0 then return false
    t = p->tm
    return tkTimePanel_IsDateTime( t )
end function

' Keeps every part (hidden ones too); clamps to the range. An empty t clears -- even without
' AllowEmpty, which governs the user only.
public sub tkDateTimePicker_SetDateTime( byval hCtrl as TK_WIDGET ptr, byref t as const TKDATETIME )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then exit sub
    p->sEntry = ""
    if tkTimePanel_IsDateTime( t ) then
        p->tm = tkTimePanel_SerialToDateTime( DtmClampSerial( p, tkTimePanel_DateTimeToSerial( t ) ) )
    else
        p->tm = tkTimePanel_EmptyDateTime( )
    end if
    DtmRefresh( p )
end sub

public sub tkDateTimePicker_ClearDateTime( byval hCtrl as TK_WIDGET ptr )
    tkDateTimePicker_SetDateTime( hCtrl, tkTimePanel_EmptyDateTime( ) )
end sub

public function tkDateTimePicker_HasDateTime( byval hCtrl as TK_WIDGET ptr ) as boolean
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then return false
    return tkTimePanel_IsDateTime( p->tm )
end function

' The bind pair: an empty TKDATETIME (wYear 0) is no value.
public function tkDateTimePicker_GetDateTimeValue( byval hCtrl as TK_WIDGET ptr ) as TKDATETIME
    dim as TKDATETIME t
    tkDateTimePicker_GetDateTime( hCtrl, t )
    return t
end function

public sub tkDateTimePicker_SetDateTimeValue( byval hCtrl as TK_WIDGET ptr, byval t as TKDATETIME )
    tkDateTimePicker_SetDateTime( hCtrl, t )
end sub

' For the form designer (its rows hold numbers).
public sub tkDateTimePicker_SetDateTimeParts( byval hCtrl as TK_WIDGET ptr, byval y as long, byval mo as long, byval d as long, _
                                              byval hh as long, byval mi as long, byval ss as long )
    tkDateTimePicker_SetDateTime( hCtrl, tkTimePanel_MakeDateTime( y, mo, d, hh, mi, ss ) )
end sub

public sub tkDateTimePicker_GetRange( byval hCtrl as TK_WIDGET ptr, byref tMin as TKDATETIME, byref tMax as TKDATETIME, _
                                      byref hasMin as boolean, byref hasMax as boolean )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then exit sub
    tMin = p->tMin : tMax = p->tMax : hasMin = p->hasMin : hasMax = p->hasMax
end sub

' Min <= max (an inverted pair is swapped); an invalid bound is absent. Clamps the value, silently.
public sub tkDateTimePicker_SetRange( byval hCtrl as TK_WIDGET ptr, byref tMin as const TKDATETIME, byref tMax as const TKDATETIME, _
                                      byval hasMin as boolean = true, byval hasMax as boolean = true )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then exit sub
    p->hasMin = hasMin andalso tkTimePanel_IsDateTime( tMin )
    p->hasMax = hasMax andalso tkTimePanel_IsDateTime( tMax )
    p->tMin = tkTimePanel_EmptyDateTime( )
    p->tMax = tkTimePanel_EmptyDateTime( )
    if p->hasMin then p->tMin = tMin
    if p->hasMax then p->tMax = tMax
    if p->hasMin andalso p->hasMax andalso (tkTimePanel_CompareDateTime( p->tMin, p->tMax ) > 0) then swap p->tMin, p->tMax
    if tkTimePanel_IsDateTime( p->tm ) then p->tm = tkTimePanel_SerialToDateTime( DtmClampSerial( p, tkTimePanel_DateTimeToSerial( p->tm ) ) )
    DtmRefresh( p )
end sub

public sub tkDateTimePicker_SetMinDateTime( byval hCtrl as TK_WIDGET ptr, byval y as long, byval mo as long, byval d as long, _
                                            byval hh as long, byval mi as long, byval ss as long )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then exit sub
    tkDateTimePicker_SetRange( hCtrl, tkTimePanel_MakeDateTime( y, mo, d, hh, mi, ss ), p->tMax, true, p->hasMax )
end sub

public sub tkDateTimePicker_SetMaxDateTime( byval hCtrl as TK_WIDGET ptr, byval y as long, byval mo as long, byval d as long, _
                                            byval hh as long, byval mi as long, byval ss as long )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then exit sub
    tkDateTimePicker_SetRange( hCtrl, p->tMin, tkTimePanel_MakeDateTime( y, mo, d, hh, mi, ss ), p->hasMin, true )
end sub

public function tkDateTimePicker_GetAllowEmpty( byval hCtrl as TK_WIDGET ptr ) as boolean
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then return false
    return p->bAllowEmpty
end function

' Whether the USER may clear the value (Backspace / Delete / Ctrl+X).
public sub tkDateTimePicker_SetAllowEmpty( byval hCtrl as TK_WIDGET ptr, byval bAllow as boolean )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p then p->bAllowEmpty = bAllow
end sub

public function tkDateTimePicker_GetStep( byval hCtrl as TK_WIDGET ptr ) as long
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then return TKTP_DEFAULT_STEP
    return p->nStep
end function

' Seconds, 1 .. 3600: the dropdown's time columns, and the step of the finest minute / second segment.
public sub tkDateTimePicker_SetStep( byval hCtrl as TK_WIDGET ptr, byval nSeconds as long )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then exit sub
    if nSeconds < 1 then nSeconds = 1
    if nSeconds > 3600 then nSeconds = 3600
    p->nStep = nSeconds
end sub

' Month and weekday names (localization): 12 / 7 comma-separated names, full; the short ones are
' their first three letters unless given after a "|" ("Januar,...|Jan,..."). "" restores English.
public sub tkDateTimePicker_SetMonthNames( byval hCtrl as TK_WIDGET ptr, byval sNames as ustring )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then exit sub
    dim as TKDT_NAMES def = tkTimePanel_DefaultNames( )
    dim as ustring fulls = sNames, shorts
    dim as long bar = instr( sNames, "|" )
    if bar then fulls = left( sNames, bar - 1 ) : shorts = mid( sNames, bar + 1 )
    for i as long = 1 to 12
        dim as ustring f = DtmNthName( fulls, i - 1 ), sh = DtmNthName( shorts, i - 1 )
        if len( f ) = 0 then f = def.month( i )
        if len( sh ) = 0 then sh = left( f, 3 )
        p->names.month( i ) = f : p->names.monthShort( i ) = sh
    next
    DtmRefresh( p )
end sub

public sub tkDateTimePicker_SetDayNames( byval hCtrl as TK_WIDGET ptr, byval sNames as ustring )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then exit sub
    dim as TKDT_NAMES def = tkTimePanel_DefaultNames( )
    dim as ustring fulls = sNames, shorts
    dim as long bar = instr( sNames, "|" )
    if bar then fulls = left( sNames, bar - 1 ) : shorts = mid( sNames, bar + 1 )
    for i as long = 0 to 6
        dim as ustring f = DtmNthName( fulls, i ), sh = DtmNthName( shorts, i )
        if len( f ) = 0 then f = def.day( i )
        if len( sh ) = 0 then sh = left( f, 3 )
        p->names.day( i ) = f : p->names.dayShort( i ) = sh
    next
    DtmRefresh( p )
end sub

' Name n (0-based) of a comma-separated list, trimmed; "" past the end.
function DtmNthName( byref list as const ustring, byval n as long ) as ustring
    dim as long a = 1
    for k as long = 0 to n
        if a > len( list ) then return ""
        dim as long b = instr( a, list, "," )
        if b = 0 then b = len( list ) + 1
        if k = n then return trim( mid( list, a, b - a ) )
        a = b + 1
    next
    return ""
end function

public function tkDateTimePicker_GetMonthName( byval hCtrl as TK_WIDGET ptr, byval m as long, byval bShort as boolean = false ) as ustring
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if (p = 0) orelse (m < 1) orelse (m > 12) then return ""
    return iif( bShort, p->names.monthShort( m ), p->names.month( m ) )
end function

' The dropdown calendar's first day of the week: CAL_SUNDAY (default) or CAL_MONDAY.
public function tkDateTimePicker_GetWeekStart( byval hCtrl as TK_WIDGET ptr ) as long
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then return CAL_SUNDAY
    return p->nWeekStart
end function

public sub tkDateTimePicker_SetWeekStart( byval hCtrl as TK_WIDGET ptr, byval nWeekStart as long )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p then p->nWeekStart = iif( nWeekStart = CAL_MONDAY, CAL_MONDAY, CAL_SUNDAY )
end sub

' ---- display ------------------------------------------------------------------------------------
public function tkDateTimePicker_GetFormat( byval hCtrl as TK_WIDGET ptr ) as ustring
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then return ""
    return p->sPattern
end function

' The pattern: the field's segments and the dropdown's time columns. "" is yyyy-MM-dd HH:mm.
public sub tkDateTimePicker_SetFormat( byval hCtrl as TK_WIDGET ptr, byval sPattern as ustring )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then exit sub
    p->sPattern = sPattern
    if len( sPattern ) = 0 then p->sPattern = TKDTM_DEFAULT_PATTERN
    DtmParse( p )
    if p->isFocused then p->nFocusSeg = DtmFirstSeg( p )
    DtmRefresh( p )
end sub

public sub tkDateTimePicker_SetAmPmText( byval hCtrl as TK_WIDGET ptr, byval sAm as ustring, byval sPm as ustring )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then exit sub
    p->sAm = sAm
    p->sPm = sPm
    if len( sAm ) = 0 then p->sAm = "AM"
    if len( sPm ) = 0 then p->sPm = "PM"
    DtmRefresh( p )
end sub

' One designator at a time, for the form designer's rows ("" keeps AM / PM).
public sub tkDateTimePicker_SetAmText( byval hCtrl as TK_WIDGET ptr, byval sAm as ustring )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p then tkDateTimePicker_SetAmPmText( hCtrl, sAm, p->sPm )
end sub

public sub tkDateTimePicker_SetPmText( byval hCtrl as TK_WIDGET ptr, byval sPm as ustring )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p then tkDateTimePicker_SetAmPmText( hCtrl, p->sAm, sPm )
end sub

public function tkDateTimePicker_GetAmText( byval hCtrl as TK_WIDGET ptr ) as ustring
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then return ""
    return p->sAm
end function

public function tkDateTimePicker_GetPmText( byval hCtrl as TK_WIDGET ptr ) as ustring
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then return ""
    return p->sPm
end function

public function tkDateTimePicker_GetPlaceholderText( byval hCtrl as TK_WIDGET ptr ) as ustring
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then return ""
    return p->sPlaceholder
end function

' Shown instead of the dashes while there is no time and the field is not focused.
public sub tkDateTimePicker_SetPlaceholderText( byval hCtrl as TK_WIDGET ptr, byval sText as ustring )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then exit sub
    p->sPlaceholder = sText
    tkWidget_Invalidate( hCtrl )
end sub

' The time as text: the pattern's, or FormatTime's when it says something; "" when there is none.
' (Ctrl+C copies the pattern's text, which pastes back.)
public function tkDateTimePicker_GetText( byval hCtrl as TK_WIDGET ptr ) as ustring
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then return ""
    return DtmFormatOf( p, p->tm )
end function

public function tkDateTimePicker_GetButtonStyle( byval hCtrl as TK_WIDGET ptr ) as long
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then return TKDTM_BUTTON_DROPDOWN
    return p->nButtonStyle
end function

public sub tkDateTimePicker_SetButtonStyle( byval hCtrl as TK_WIDGET ptr, byval nStyle as long )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then exit sub
    if (nStyle < TKDTM_BUTTON_DROPDOWN) orelse (nStyle > TKDTM_BUTTON_NONE) then nStyle = TKDTM_BUTTON_DROPDOWN
    if p->isOpen andalso (nStyle <> TKDTM_BUTTON_DROPDOWN) then tkDateTimePicker_CloseUp( hCtrl )
    p->nButtonStyle = nStyle
    DtmRefresh( p )
end sub

public function tkDateTimePicker_GetTabMovesSegments( byval hCtrl as TK_WIDGET ptr ) as boolean
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then return false
    return p->bTabMovesSegments
end function

' TRUE: Tab / Shift+Tab walk the segments first (Qt), leaving at the last / first.
public sub tkDateTimePicker_SetTabMovesSegments( byval hCtrl as TK_WIDGET ptr, byval bMoves as boolean )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p then p->bTabMovesSegments = bMoves
end sub

' ---- segments ----------------------------------------------------------------------------------------
public function tkDateTimePicker_GetSegmentCount( byval hCtrl as TK_WIDGET ptr ) as long
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then return 0
    return p->nSegs
end function

' TKTP_SEG_* of segment i, or -1.
public function tkDateTimePicker_GetSegmentKind( byval hCtrl as TK_WIDGET ptr, byval i as long ) as long
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if (p = 0) orelse (i < 0) orelse (i >= p->nSegs) then return -1
    return p->segs( i ).kind
end function

' The segment the keys edit (also while unfocused: where they will start), or -1.
public function tkDateTimePicker_GetFocusedSegment( byval hCtrl as TK_WIDGET ptr ) as long
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then return -1
    return p->nFocusSeg
end function

public sub tkDateTimePicker_SetFocusedSegment( byval hCtrl as TK_WIDGET ptr, byval i as long )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if (p = 0) orelse (DtmIsEditable( p, i ) = false) then exit sub
    p->sEntry = ""
    p->nFocusSeg = i
    tkWidget_Invalidate( hCtrl )
end sub

' Segment i's text box, control pixels (the field's height). FALSE for no such segment.
public function tkDateTimePicker_GetSegmentRect( byval hCtrl as TK_WIDGET ptr, byval i as long, byref rc as TKRECT ) as boolean
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    tkRect_Set( rc, 0, 0, 0, 0 )
    if (p = 0) orelse (i < 0) orelse (i >= p->nSegs) then return false
    DtmEnsureLayout( p )
    tkRect_Set( rc, p->segX( i ), p->rcField.top, p->segX( i ) + p->segW( i ), p->rcField.bottom )
    return true
end function

' The digits typed into the focused segment so far ("" when no entry is pending). A test seam.
public function tkDateTimePicker_GetPendingEntry( byval hCtrl as TK_WIDGET ptr ) as string
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then return ""
    return p->sEntry
end function

' Qt's stepBy: segment i stepped n times as Up / Down would, but SILENT.
public sub tkDateTimePicker_StepBy( byval hCtrl as TK_WIDGET ptr, byval i as long, byval n as long )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if (p = 0) orelse (DtmIsEditable( p, i ) = false) orelse (n = 0) then exit sub
    dim as TKDATETIME t = DtmBase( p )
    for k as long = 1 to abs( n )
        t = DtmStepped( p, t, i, sgn( n ), false )
    next
    p->tm = DtmFinish( p, t )
    DtmRefresh( p )
end sub

' ---- appearance --------------------------------------------------------------------------------------
public function tkDateTimePicker_GetFont( byval hCtrl as TK_WIDGET ptr ) as TTF_Font ptr
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then return 0
    return p->pFont
end function

public sub tkDateTimePicker_SetFont( byval hCtrl as TK_WIDGET ptr, byval f as TTF_Font ptr )
