'
' tkDateTimePicker -- a date-and-time field: the date and time segments of one pattern, each typed
' into and stepped on its own, with a dropdown that holds a calendar beside a time panel (or a spin
' pair, or nothing). Seeded from tkTimePicker (the house idiom: copy the nearest sibling); the
' design is C:\dev\docs\tkControls\TIMEPICKER.md (T6) and the plan of 2026-11-23.
'
' THE FIELD is painted by the control: the pattern's segments (yyyy MM dd HH mm ..., the date tokens
' of tkTimePanel_ParsePattern( ..., TRUE )). Digits fill the focused segment and move on; Up/Down
' step it, wrapping inside the segment with no carry (a month or year change clamps the day to the
' month); a month NAME takes letters (type-ahead on the names); a weekday is shown, never edited.
' The frame, divider and button cell are tkDatePicker's layout, to the pixel.
'
' THE VALUE is a TKDATETIME (tkTimePanel): SYSTEMTIME, wYear = 0 for "no value". Setters are silent
' and keep every part; a USER edit zeroes the time parts the pattern does not show and clamps to the
' range. DateTimeChanged fires once per completed change.
'
' THE DROPDOWN (dtmPopup.tiko) holds tkCalendar and tkTimePanel side by side and a band with Now
' and OK. Its picks are PENDING: the field changes only on OK, Enter or Now; Esc, F4, Alt+Up/Down
' and an outside press dismiss it.
#module "tkDateTimePicker"

#import "../tkHost" public
#import "../tkTheme" public
#import "../tkTimePanel" public
#import "../tkCalendar" public
#import "../tkTooltip" public
using tkHost
using tkPaint
using tkTheme
using tkTimePanel
using tkCalendar
using tkTooltip

' ---- constants ---------------------------------------------------------------------------------
public enum
    TKDTM_BUTTON_DROPDOWN = 0
    TKDTM_BUTTON_SPIN
    TKDTM_BUTTON_NONE
end enum

' the week's first day: tkCalendar's values, named in this module for the designer's rows
public enum
    TKDTM_SUNDAY = CAL_SUNDAY
    TKDTM_MONDAY = CAL_MONDAY
end enum

public enum
    TKDTM_HIT_NONE = 0
    TKDTM_HIT_FIELD
    TKDTM_HIT_BUTTON                            ' the dropdown button
    TKDTM_HIT_SPINUP
    TKDTM_HIT_SPINDOWN
end enum

' Sizes in design units, scaled once at create (tkDatePicker's values). Border and divider are
' hairline rules: never scaled.
public const as long CDTM_DEFAULT_ICONWIDTH = 28
public const as long CDTM_DEFAULT_FIELDPAD = 6
public const as long CDTM_DEFAULT_VERTPAD = 5
public const as long CDTM_DEFAULT_CORNERRADIUS = 6
public const as long CDTM_DEFAULT_BORDERTHICK = 1
public const as long CDTM_DEFAULT_DIVIDERTHICK = 1
public const as long CDTM_POP_BORDERTHICK = 1
public const as long CDTM_FOOTERH = 30
public const as long CDTM_DEFAULT_REPEATDELAY = 400
public const as long CDTM_DEFAULT_REPEATINTERVAL = 60
public const as long DTM_TIMER_ENTRY = TK_TIMER_APP + 1
public const TKDTM_DEFAULT_PATTERN = "yyyy-MM-dd HH:mm"

' ---- types -------------------------------------------------------------------------------------
' The frame block is tkDatePicker's, value for value, so a picker pair matches under every theme.
