end sub

' Forwarded to the dropdown's panel (hCtrl is the PICKER): disables chooser items.
public sub tkDateTimePicker_SetItemDisabledCallback( byval hCtrl as TK_WIDGET ptr, byval userfunc as DTM_ItemDisabledCallbackFunc )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p then p->ItemDisabledCallback = userfunc
