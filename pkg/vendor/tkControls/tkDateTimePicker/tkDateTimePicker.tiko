    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p then p->MessageCallback = userfunc
end sub

' FormatDateTime: the text shown at rest (unfocused, a time, nothing being typed), GetText, and the
' copy of it. Focus brings the segments back: editing works on the pattern.
public sub tkDateTimePicker_SetFormatCallback( byval hCtrl as TK_WIDGET ptr, byval usersub as DTM_FormatCallbackSub )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then exit sub
    p->FormatCallback = usersub
    DtmRefresh( p )
end sub

' The tip over the picker: TRUE with outText shows it. The tip is made when this is first set.
public sub tkDateTimePicker_SetTooltipCallback( byval hCtrl as TK_WIDGET ptr, byval userfunc as DTM_TooltipCallbackFunc )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then exit sub
    p->TooltipCallback = userfunc
    if userfunc then tkTipHost_Ensure( @p->tip, hCtrl, @DtmTipText )
end sub

' The tip (0 until a Tooltip callback is set): its delays, or tkTooltip_Show in a test.
public function tkDateTimePicker_GetTooltipHandle( byval hCtrl as TK_WIDGET ptr ) as TK_TIP ptr
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then return 0
    return tkTipHost_Tip( @p->tip )
end function

' The segment under (x, y), -1 for a literal, the button cell or outside.
function DtmSegUnder( byval p as TKDATETIMEPICKER_STATE ptr, byval x as long, byval y as long ) as long
    if DtmHit( p, x, y ) <> TKDTM_HIT_FIELD then return -1
    for i as long = 0 to p->nSegs - 1
        if DtmIsEditable( p, i ) andalso (x >= p->segX( i )) andalso (x < p->segX( i ) + p->segW( i )) then return i
    next
    return -1
end function

' One tool per part and segment, so moving between segments brings a fresh tip.
function DtmTipIndex( byval p as TKDATETIMEPICKER_STATE ptr ) as long
    return DtmHit( p, p->nMouseX, p->nMouseY ) * 100 + DtmSegUnder( p, p->nMouseX, p->nMouseY ) + 1
end function

function DtmTipText( byval t as TK_TIP ptr, byval a as TK_WIDGET ptr, byval idx as long ) as ustring
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( a )
    if (p = 0) orelse (p->TooltipCallback = 0) then return ""
    dim as TKDATETIMEPICKER_TOOLTIPINFO ti
    ti.hCtrl = p->hWin
    ti.dt = p->tm
    ti.hasValue = tkTimePanel_IsDateTime( p->tm )
    ti.nPart = DtmHit( p, p->nMouseX, p->nMouseY )
    ti.nSegment = DtmSegUnder( p, p->nMouseX, p->nMouseY )
    if p->TooltipCallback( @ti ) = false then return ""
    return ti.outText
end function

' The theme's shape until a shape setter ran: its CornerRadius and BorderWidth.
sub DtmApplyThemeShape( byval w as TK_WIDGET ptr )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( w )
    if (p = 0) orelse p->bShapePinned then exit sub
    dim as TKTHEME_SHAPE sh = tkTheme_ShapeOf( w )
    p->nCornerRadius = iif( sh.CornerRadius >= 0, tkHost_Scale( w->pHost, sh.CornerRadius ), tkHost_Scale( w->pHost, CDTM_DEFAULT_CORNERRADIUS ) )
    p->nBorderThick = iif( sh.BorderWidth >= 0, sh.BorderWidth, CDTM_DEFAULT_BORDERTHICK )
    DtmRefresh( p )
end sub
