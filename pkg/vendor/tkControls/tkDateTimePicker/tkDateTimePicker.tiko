    if p = 0 then return 0
    return p->pIconFont
end function

' A glyph font for the dropdown button; with it AND a glyph (SetIconGlyph), the glyph replaces the
' drawn clock. No default glyph yet: the bundled font's clock codepoint is not chosen.
public sub tkDateTimePicker_SetIconFont( byval hCtrl as TK_WIDGET ptr, byval f as TTF_Font ptr )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then exit sub
    p->pIconFont = f
    tkWidget_Invalidate( hCtrl )
end sub

public function tkDateTimePicker_GetIconGlyph( byval hCtrl as TK_WIDGET ptr ) as ustring
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then return ""
    return p->wszIconGlyph
end function

public sub tkDateTimePicker_SetIconGlyph( byval hCtrl as TK_WIDGET ptr, byval sGlyph as ustring )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then exit sub
    p->wszIconGlyph = sGlyph
    tkWidget_Invalidate( hCtrl )
end sub

public function tkDateTimePicker_GetIconWidth( byval hCtrl as TK_WIDGET ptr ) as long
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then return 0
    return p->nIconWidth
end function

public sub tkDateTimePicker_SetIconWidth( byval hCtrl as TK_WIDGET ptr, byval nWidth as long )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then exit sub
    p->nIconWidth = iif( nWidth < 0, 0, nWidth )
    DtmRefresh( p )
end sub

public function tkDateTimePicker_GetCornerRadius( byval hCtrl as TK_WIDGET ptr ) as long
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then return 0
    return p->nCornerRadius
end function

public sub tkDateTimePicker_SetCornerRadius( byval hCtrl as TK_WIDGET ptr, byval nRadius as long )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then exit sub
    p->nCornerRadius = iif( nRadius < 0, 0, nRadius )
    p->bShapePinned = true
    DtmRefresh( p )
end sub

public function tkDateTimePicker_GetBorderThickness( byval hCtrl as TK_WIDGET ptr ) as long
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then return 0
    return p->nBorderThick
end function

public sub tkDateTimePicker_SetBorderThickness( byval hCtrl as TK_WIDGET ptr, byval nThickness as long )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then exit sub
    p->nBorderThick = iif( nThickness < 0, 0, nThickness )
    p->bShapePinned = true
    DtmRefresh( p )
end sub

' tkDatePicker's formula, measured on the widest time the pattern can show. Valid before sizing.
public sub tkDateTimePicker_GetIdealSize( byval hCtrl as TK_WIDGET ptr, byref nWidth as long, byref nHeight as long )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    nWidth = 0 : nHeight = 0
    if p = 0 then exit sub
    dim as TTF_Font ptr f = DtmFont( p )
    dim as long textW = 0
    ' 2022-09-28 is a Wednesday in September: the longest English names; both halves of the day
    for k as long = 0 to 1
        dim as TKDATETIME t = tkTimePanel_MakeDateTime( 2022, 9, 28, 10 + k * 12, 58, 58, 888 )
        dim as long tw = tkText_Width( f, DtmFormatOf( p, t ) )
        if tw > textW then textW = tw
        tw = tkText_Width( f, tkTimePanel_FormatPatternDT( t, p->sPattern, p->sAm, p->sPm, @p->names ) )
        if tw > textW then textW = tw
    next
    if len( p->sPlaceholder ) then
        dim as long pw = tkText_Width( f, p->sPlaceholder )
        if pw > textW then textW = pw
    end if
    dim as long cell = 0
    if p->nButtonStyle <> TKDTM_BUTTON_NONE then cell = p->nDividerThick + p->nIconWidth
    nWidth = p->nCornerRadius + p->nFieldPad + textW + p->nFieldPad + cell
    if p->nButtonStyle = TKDTM_BUTTON_NONE then nWidth += p->nBorderThick
    nHeight = tkText_Height( f ) + 2 * p->nVertPadding + 2 * p->nBorderThick
end sub

public function tkDateTimePicker_GetFrameRect( byval hCtrl as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    tkRect_Set( rc, 0, 0, 0, 0 )
    if p = 0 then return false
    DtmEnsureLayout( p )
    rc = p->rcFrame
    return (rc.right > rc.left) andalso (rc.bottom > rc.top)
end function

public function tkDateTimePicker_GetFieldRect( byval hCtrl as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    tkRect_Set( rc, 0, 0, 0, 0 )
    if p = 0 then return false
    DtmEnsureLayout( p )
    rc = p->rcField
    return (rc.right > rc.left) andalso (rc.bottom > rc.top)
end function

' The button cell (dropdown or spin pair); FALSE with TKDTM_BUTTON_NONE.
public function tkDateTimePicker_GetIconRect( byval hCtrl as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    tkRect_Set( rc, 0, 0, 0, 0 )
    if p = 0 then return false
    DtmEnsureLayout( p )
    rc = p->rcIcon
    return (rc.right > rc.left) andalso (rc.bottom > rc.top)
end function

' One spin half (bUp: the upper); FALSE unless TKDTM_BUTTON_SPIN.
public function tkDateTimePicker_GetSpinRect( byval hCtrl as TK_WIDGET ptr, byval bUp as boolean, byref rc as TKRECT ) as boolean
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    tkRect_Set( rc, 0, 0, 0, 0 )
    if p = 0 then return false
    DtmEnsureLayout( p )
    if bUp then rc = p->rcUp else rc = p->rcDown
    return (rc.right > rc.left) andalso (rc.bottom > rc.top)
end function

public function tkDateTimePicker_HitTest( byval hCtrl as TK_WIDGET ptr, byval x as long, byval y as long ) as long
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then return TKDTM_HIT_NONE
    return DtmHit( p, x, y )
end function

public function tkDateTimePicker_GetHotPart( byval hCtrl as TK_WIDGET ptr ) as long
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then return TKDTM_HIT_NONE
    return p->nHotPart
end function

public sub tkDateTimePicker_GetRepeat( byval hCtrl as TK_WIDGET ptr, byref nDelayMs as long, byref nIntervalMs as long )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then exit sub
    nDelayMs = p->nRepeatDelay : nIntervalMs = p->nRepeatInterval
end sub

' The spin pair's auto-repeat; 0 for either turns it off.
public sub tkDateTimePicker_SetRepeat( byval hCtrl as TK_WIDGET ptr, byval nDelayMs as long, byval nIntervalMs as long )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then exit sub
    p->nRepeatDelay = iif( nDelayMs < 0, 0, nDelayMs )
    p->nRepeatInterval = iif( nIntervalMs < 0, 0, nIntervalMs )
end sub

public sub tkDateTimePicker_GetColors( byval hCtrl as TK_WIDGET ptr, byval pColors as TKDATETIMEPICKER_COLORS ptr )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if (p = 0) orelse (pColors = 0) then exit sub
    *pColors = p->colors
end sub

' Copies the struct and PINS it: a theme change leaves this picker alone until UnpinColors.
public sub tkDateTimePicker_SetColors( byval hCtrl as TK_WIDGET ptr, byval pColors as TKDATETIMEPICKER_COLORS ptr )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if (p = 0) orelse (pColors = 0) then exit sub
    p->colors = *pColors
    p->bColorsPinned = true
    tkWidget_Invalidate( hCtrl )
end sub

' The frame block maps exactly as tkDatePicker_ThemeColors; the dropdown as its calendar.
public function tkDateTimePicker_ThemeColors( byref t as TKTHEME_COLORS ) as TKDATETIMEPICKER_COLORS
    dim as TKDATETIMEPICKER_COLORS c
    c.BackColor               = t.Window
    c.BorderColor             = t.Border
    c.FocusBorderColor        = t.FocusRing
    c.BorderColorDisabled     = t.BorderDisabled
    c.DividerColor            = t.Divider
    c.DividerColorDisabled    = t.BorderDisabled
    c.FieldBackColor          = t.Surface
    c.FieldForeColor          = t.Text
    c.FieldBackColorDisabled  = t.SurfaceDisabled
    c.FieldForeColorDisabled  = t.TextDisabled
    c.IconColor               = t.Surface
    c.IconGlyphColor          = t.Text
    c.IconGlyphColorHot       = t.TextHot
    c.IconBackColorHot        = t.SurfaceHot
    c.IconGlyphColorDisabled  = t.TextDisabled
    c.SegmentBackColorFocused = t.Selected
    c.SegmentForeColorFocused = t.SelectedText
    c.PlaceholderColor        = t.TextDim
    c.PanelBackColor          = t.Popup
    c.PanelBorderColor        = t.Border
    c.ItemColor               = t.PopupText
    c.ItemColorDisabled       = t.TextDisabled
    c.ItemBackColorHot        = t.SurfaceHot
    c.ItemForeColorHot        = t.TextHot
    c.ItemBackColorSelected   = t.Selected
    c.ItemForeColorSelected   = t.SelectedText
    c.ColumnDividerColor      = t.Divider
    c.FooterColor             = t.TextDim
    c.FooterColorHot          = t.TextHot
    c.FooterColorDisabled     = t.TextDisabled
    c.TitleColor              = t.TextHot
    c.TitleColorHot           = t.TextStrong
    c.NavGlyphColor           = t.Text
    c.NavGlyphColorHot        = t.TextHot
    c.NavGlyphColorDisabled   = t.TextDisabled
    c.WeekdayColor            = t.TextDim
    c.DayColor                = t.PopupText
    c.DayColorWeekend         = t.AccentHot
    c.DayColorAdjacent        = t.TextDim
    c.DayColorDisabled        = t.TextDisabled
    c.DayBackColorHot         = t.SurfaceHot
    c.DayForeColorHot         = t.TextHot
    c.DayBackColorSelected    = t.Selected
    c.DayForeColorSelected    = t.SelectedText
    c.TodayRingColor          = t.Accent
    return c
end function

public sub tkDateTimePicker_ApplyTheme( byval hCtrl as TK_WIDGET ptr, byref t as TKTHEME_COLORS )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then exit sub
    DtmApplyThemeShape( hCtrl )
    if p->bColorsPinned then exit sub
    dim as TKTHEME_COLORS tr = tkTheme_Styled( hCtrl, t )
    p->colors = tkDateTimePicker_ThemeColors( tr )
    tkTheme_ResolveInto( hCtrl, tr, cast( ulong ptr, @p->colors ), sizeof( TKDATETIMEPICKER_COLORS ) \ 4, "DateTimePicker" )
    tkWidget_Invalidate( hCtrl )
end sub

public sub tkDateTimePicker_UnpinColors( byval hCtrl as TK_WIDGET ptr )
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( hCtrl )
    if p = 0 then exit sub
    p->bColorsPinned = false
    tkDateTimePicker_ApplyTheme( hCtrl, tkTheme_Of( hCtrl ) )
end sub

public sub tkDateTimePicker_ApplyFonts( byval hCtrl as TK_WIDGET ptr, byval fText as TTF_Font ptr, byval fGlyph as TTF_Font ptr )
    if fText then tkDateTimePicker_SetFont( hCtrl, fText )
    if fGlyph then tkDateTimePicker_SetIconFont( hCtrl, fGlyph )
end sub

' ---- callbacks -------------------------------------------------------------------------------------
' A paint callback's way to draw the picker as it would have been drawn, then add to it.
public sub tkDateTimePicker_PaintDefault( byval pi as TKDATETIMEPICKER_PAINTINFO ptr )
    if pi = 0 then exit sub
    dim as TKDATETIMEPICKER_STATE ptr p = DTM( pi->hCtrl )
    if p then DtmRenderDefault( p, pi )
end sub

