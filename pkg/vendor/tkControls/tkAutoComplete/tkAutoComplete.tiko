' ---- items (every mutator silent; an open list closes) --------------------------------------
public function tkAutoComplete_AddItemEx( byval hAC as TK_WIDGET ptr, byref it as const TKAUTOCOMPLETE_ITEM ) as long
    dim as TKAUTOCOMPLETE_STATE ptr p = AC( hAC )
    if p = 0 then return -1
    return AcInsertAt( p, p->nItems, it )
end function

public function tkAutoComplete_AddItem( byval hAC as TK_WIDGET ptr, byval text as ustring, byval id as longint = 0, _
                                        byval itemData as integer = 0 ) as long
    dim as TKAUTOCOMPLETE_ITEM it
    it.text = text : it.id = id : it.itemData = itemData
    return tkAutoComplete_AddItemEx( hAC, it )
end function

public function tkAutoComplete_InsertItem( byval hAC as TK_WIDGET ptr, byval idx as long, byref it as const TKAUTOCOMPLETE_ITEM ) as long
    dim as TKAUTOCOMPLETE_STATE ptr p = AC( hAC )
    if p = 0 then return -1
    return AcInsertAt( p, idx, it )
end function

public function tkAutoComplete_DeleteItem( byval hAC as TK_WIDGET ptr, byval idx as long ) as boolean
    dim as TKAUTOCOMPLETE_STATE ptr p = AC( hAC )
    if (p = 0) orelse (AcValid( p, idx ) = false) then return false
    for i as long = idx to p->nItems - 2
        p->itText(i) = p->itText(i + 1)
        p->itKey(i) = p->itKey(i + 1)
        p->itDetail(i) = p->itDetail(i + 1)
        p->itId(i) = p->itId(i + 1)
        p->itData(i) = p->itData(i + 1)
        p->itEnabled(i) = p->itEnabled(i + 1)
    next
    p->nItems -= 1
    p->itText(p->nItems) = "" : p->itKey(p->nItems) = "" : p->itDetail(p->nItems) = ""
    if p->nSel = idx then
        p->nSel = -1
    elseif p->nSel > idx then
        p->nSel -= 1
    end if
    AcItemsChanged( p )
    return true
end function

public sub tkAutoComplete_Clear( byval hAC as TK_WIDGET ptr )
    dim as TKAUTOCOMPLETE_STATE ptr p = AC( hAC )
    if p = 0 then exit sub
    erase p->itText, p->itKey, p->itDetail, p->itId, p->itData, p->itEnabled
    p->nItems = 0
    p->nSel = -1
    AcItemsChanged( p )
end sub

' Replaces every item with these texts (ids 0).
public sub tkAutoComplete_SetItems( byval hAC as TK_WIDGET ptr, texts() as ustring )
    dim as TKAUTOCOMPLETE_STATE ptr p = AC( hAC )
    if p = 0 then exit sub
    tkAutoComplete_Clear( hAC )
    dim as long n = ubound( texts ) - lbound( texts ) + 1
    if n <= 0 then exit sub
    AcGrow( p, n )
    dim as TKAUTOCOMPLETE_ITEM it
    for i as long = 0 to n - 1
        it.text = texts(lbound( texts ) + i)
        AcSetAt( p, i, it )
    next
    p->nItems = n
    AcItemsChanged( p )
end sub

public function tkAutoComplete_GetCount( byval hAC as TK_WIDGET ptr ) as long
    dim as TKAUTOCOMPLETE_STATE ptr p = AC( hAC )
    return iif( p <> 0, p->nItems, 0 )
end function

public function tkAutoComplete_GetItem( byval hAC as TK_WIDGET ptr, byval idx as long, byref it as TKAUTOCOMPLETE_ITEM ) as boolean
    dim as TKAUTOCOMPLETE_STATE ptr p = AC( hAC )
    if (p = 0) orelse (AcValid( p, idx ) = false) then return false
    it.text = p->itText(idx) : it.detail = p->itDetail(idx) : it.id = p->itId(idx)
    it.itemData = p->itData(idx) : it.enabled = p->itEnabled(idx)
    return true
end function

public function tkAutoComplete_SetItem( byval hAC as TK_WIDGET ptr, byval idx as long, byref it as const TKAUTOCOMPLETE_ITEM ) as boolean
    dim as TKAUTOCOMPLETE_STATE ptr p = AC( hAC )
    if (p = 0) orelse (AcValid( p, idx ) = false) then return false
    AcSetAt( p, idx, it )
    AcItemsChanged( p )
    return true
end function

public function tkAutoComplete_GetItemText( byval hAC as TK_WIDGET ptr, byval idx as long ) as ustring
    dim as TKAUTOCOMPLETE_STATE ptr p = AC( hAC )
    if (p = 0) orelse (AcValid( p, idx ) = false) then return ""
    return p->itText(idx)
end function

public function tkAutoComplete_FindItemById( byval hAC as TK_WIDGET ptr, byval id as longint ) as long
    dim as TKAUTOCOMPLETE_STATE ptr p = AC( hAC )
    if p = 0 then return -1
    for i as long = 0 to p->nItems - 1
        if p->itId(i) = id then return i
    next
    return -1
end function

' Case-blind, whole text.
public function tkAutoComplete_FindItemByText( byval hAC as TK_WIDGET ptr, byval text as ustring ) as long
    dim as TKAUTOCOMPLETE_STATE ptr p = AC( hAC )
    if p = 0 then return -1
    dim as ustring k = tkMatch_Fold( text )
    for i as long = 0 to p->nItems - 1
        if p->itKey(i) = k then return i
    next
    return -1
end function

public sub tkAutoComplete_BeginUpdate( byval hAC as TK_WIDGET ptr )
    dim as TKAUTOCOMPLETE_STATE ptr p = AC( hAC )
    if p = 0 then exit sub
    AcCloseList( p )
    p->nUpdate += 1
end sub

public sub tkAutoComplete_EndUpdate( byval hAC as TK_WIDGET ptr )
    dim as TKAUTOCOMPLETE_STATE ptr p = AC( hAC )
    if (p = 0) orelse (p->nUpdate = 0) then exit sub
    p->nUpdate -= 1
    if p->nUpdate = 0 then AcItemsChanged( p )
end sub

' ---- the list ----------------------------------------------------------------------------------
public function tkAutoComplete_IsDroppedDown( byval hAC as TK_WIDGET ptr ) as boolean
    dim as TKAUTOCOMPLETE_STATE ptr p = AC( hAC )
    return (p <> 0) andalso p->isOpen
end function

' Opens the list for the current text (nothing highlighted); FALSE when nothing would show.
public function tkAutoComplete_DropDown( byval hAC as TK_WIDGET ptr ) as boolean
    dim as TKAUTOCOMPLETE_STATE ptr p = AC( hAC )
    if p = 0 then return false
    return AcOpenByKey( p, 0 )
end function

public sub tkAutoComplete_CloseUp( byval hAC as TK_WIDGET ptr )
    dim as TKAUTOCOMPLETE_STATE ptr p = AC( hAC )
    if p then AcCancel( p )
end sub

