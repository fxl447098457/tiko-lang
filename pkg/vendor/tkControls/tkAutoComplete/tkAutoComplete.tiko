public function tkAutoComplete_GetHighlight( byval hAC as TK_WIDGET ptr ) as long
    dim as TKAUTOCOMPLETE_STATE ptr p = AC( hAC )
    return iif( p <> 0, p->nHot, -1 )
end function

' Silent; no preview.
public sub tkAutoComplete_SetHighlight( byval hAC as TK_WIDGET ptr, byval row as long )
    dim as TKAUTOCOMPLETE_STATE ptr p = AC( hAC )
    if (p = 0) orelse (p->isOpen = false) then exit sub
    if (row >= 0) andalso (AcRowEnabled( p, row ) = false) then exit sub
    p->nHot = row
    AcEnsureVisible( p, row )
    if p->wList then tkWidget_Invalidate( p->wList )
end sub

