    dim as TKNUMERICUPDOWN_STATE ptr p = NU( hCtrl )
    if p = 0 then exit sub
    p->nBorderThick = iif( nThickness < 0, 0, nThickness )
    NudRefresh( p )
end sub

public function tkNumericUpDown_GetDividerThickness( byval hCtrl as TK_WIDGET ptr ) as long
    dim as TKNUMERICUPDOWN_STATE ptr p = NU( hCtrl )
    if p = 0 then return 0
    return p->nDividerThick
end function

