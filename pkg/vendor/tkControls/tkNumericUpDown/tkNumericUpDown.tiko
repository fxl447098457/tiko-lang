    dim as TKNUMERICUPDOWN_STATE ptr p = NU( hCtrl )
    if p = 0 then exit sub
    p->nDividerThick = iif( nThickness < 0, 0, nThickness )
    NudRefresh( p )
end sub

public sub tkNumericUpDown_GetGlyphSize( byval hCtrl as TK_WIDGET ptr, byref nLength as long, byref nThickness as long )
    nLength = 0 : nThickness = 0
    dim as TKNUMERICUPDOWN_STATE ptr p = NU( hCtrl )
    if p = 0 then exit sub
    nLength = p->nGlyphLength : nThickness = p->nGlyphThick
end sub

' Each floored at 1.
public sub tkNumericUpDown_SetGlyphSize( byval hCtrl as TK_WIDGET ptr, byval nLength as long, byval nThickness as long )
    dim as TKNUMERICUPDOWN_STATE ptr p = NU( hCtrl )
    if p = 0 then exit sub
    p->nGlyphLength = iif( nLength < 1, 1, nLength )
    p->nGlyphThick = iif( nThickness < 1, 1, nThickness )
    NudRefresh( p )
end sub

' The widest of the range's two ends at the current places, in the current font, plus the
' padding, both buttons, both dividers and the border. Valid before the control is sized.
public sub tkNumericUpDown_GetIdealSize( byval hCtrl as TK_WIDGET ptr, byref nWidth as long, byref nHeight as long )
    nWidth = 0 : nHeight = 0
    dim as TKNUMERICUPDOWN_STATE ptr p = NU( hCtrl )
    if p = 0 then exit sub
    dim as TTF_Font ptr f = p->pFont
    if f = 0 then f = hCtrl->pHost->pDefaultFont
    dim as long w0 = tkText_WidthU8( f, NudFormat( p->nMin, p->nDecimalPlaces ) )
    dim as long w1 = tkText_WidthU8( f, NudFormat( p->nMax, p->nDecimalPlaces ) )
    dim as long textW = iif( w1 > w0, w1, w0 )
    nWidth = (p->nButtonWidth * 2) + (p->nDividerThick * 2) + p->nValuePadLeft + p->nValuePadRight + textW
    nHeight = tkText_Height( f ) + (p->nVertPadding * 2) + (p->nBorderThick * 2)
end sub

private function NudGetRect( byval hCtrl as TK_WIDGET ptr, byref rc as TKRECT, byval iPart as long ) as boolean
    tkRect_SetEmpty( rc )
    dim as TKNUMERICUPDOWN_STATE ptr p = NU( hCtrl )
    if p = 0 then return false
    if p->bLayoutDirty then NudLayout( p )
    if p->bLayoutDirty then return false
    select case iPart
    case NUD_PART_MINUS : rc = p->rcMinus
    case NUD_PART_VALUE : rc = p->rcValue
    case NUD_PART_PLUS : rc = p->rcPlus
    case else : rc = p->rcFrame
    end select
    return true
end function

public function tkNumericUpDown_GetFrameRect( byval hCtrl as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return NudGetRect( hCtrl, rc, NUD_PART_NONE )
end function
public function tkNumericUpDown_GetMinusRect( byval hCtrl as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return NudGetRect( hCtrl, rc, NUD_PART_MINUS )
end function
public function tkNumericUpDown_GetValueRect( byval hCtrl as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return NudGetRect( hCtrl, rc, NUD_PART_VALUE )
end function
public function tkNumericUpDown_GetPlusRect( byval hCtrl as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return NudGetRect( hCtrl, rc, NUD_PART_PLUS )
end function

' The NUD_PART_* under a point in the control's own pixels.
public function tkNumericUpDown_HitTest( byval hCtrl as TK_WIDGET ptr, byval x as long, byval y as long ) as long
    dim as TKNUMERICUPDOWN_STATE ptr p = NU( hCtrl )
    if p = 0 then return NUD_PART_NONE
    return NudHit( p, x, y )
end function

' The part under the mouse, and the part held (for tests and custom painters).
public function tkNumericUpDown_GetHotPart( byval hCtrl as TK_WIDGET ptr ) as long
    dim as TKNUMERICUPDOWN_STATE ptr p = NU( hCtrl )
    if p = 0 then return NUD_PART_NONE
    return p->hotPart
end function

public function tkNumericUpDown_GetPressedPart( byval hCtrl as TK_WIDGET ptr ) as long
    dim as TKNUMERICUPDOWN_STATE ptr p = NU( hCtrl )
    if p = 0 then return NUD_PART_NONE
    return p->pressedPart
end function

public function tkNumericUpDown_IsRepeating( byval hCtrl as TK_WIDGET ptr ) as boolean
    dim as TKNUMERICUPDOWN_STATE ptr p = NU( hCtrl )
    if p = 0 then return false
    return p->repeatOn
end function

' ---- appearance ----------------------------------------------------------------------------
public sub tkNumericUpDown_GetColors( byval hCtrl as TK_WIDGET ptr, byval pColors as TKNUMERICUPDOWN_COLORS ptr )
    dim as TKNUMERICUPDOWN_STATE ptr p = NU( hCtrl )
    if (p = 0) orelse (pColors = 0) then exit sub
    *pColors = p->colors
end sub

' Copies the struct, PINS it and pushes the value cell's colours into the field.
public sub tkNumericUpDown_SetColors( byval hCtrl as TK_WIDGET ptr, byval pColors as TKNUMERICUPDOWN_COLORS ptr )
    dim as TKNUMERICUPDOWN_STATE ptr p = NU( hCtrl )
    if (p = 0) orelse (pColors = 0) then exit sub
    p->colors = *pColors
    p->bColorsPinned = true
    NudApplyStateColors( p )
    tkWidget_Invalidate( hCtrl )
end sub

public function tkNumericUpDown_ThemeColors( byref t as TKTHEME_COLORS ) as TKNUMERICUPDOWN_COLORS
    dim as TKNUMERICUPDOWN_COLORS c
    c.BackColor = t.Window
    c.BorderColor = t.Border
    c.FocusBorderColor = t.FocusRing
    c.BorderColorDisabled = t.BorderDisabled
    c.DividerColor = t.Divider
    c.DividerColorDisabled = t.BorderDisabled
    c.ValueBackColor = t.Surface
    c.ValueForeColor = t.Text
    c.ValueBackColorDisabled = t.SurfaceDisabled
    c.ValueForeColorDisabled = t.TextDisabled
    c.ButtonBackColor = t.Surface
    c.ButtonBackColorHot = t.SurfaceHot
    c.ButtonBackColorPressed = t.Selected
    c.ButtonBackColorDisabled = t.SurfaceDisabled
    c.GlyphColor = t.Text
    c.GlyphColorHot = t.TextHot
    c.GlyphColorPressed = t.SelectedText
    c.GlyphColorDisabled = t.TextDisabled
    return c
end function

public sub tkNumericUpDown_ApplyTheme( byval hCtrl as TK_WIDGET ptr, byref t as TKTHEME_COLORS )
    dim as TKNUMERICUPDOWN_STATE ptr p = NU( hCtrl )
    if p = 0 then exit sub
    ApplyThemeShape( hCtrl )
    if p->bColorsPinned then exit sub
    dim as TKTHEME_COLORS tr = tkTheme_Styled( hCtrl, t )
    p->colors = tkNumericUpDown_ThemeColors( tr )
    tkTheme_ResolveInto( hCtrl, tr, cast( ulong ptr, @p->colors ), sizeof( TKNUMERICUPDOWN_COLORS ) \ 4, "NumericUpDown" )
    NudApplyStateColors( p )
    tkWidget_Invalidate( hCtrl )
end sub

public sub tkNumericUpDown_UnpinColors( byval hCtrl as TK_WIDGET ptr )
    dim as TKNUMERICUPDOWN_STATE ptr p = NU( hCtrl )
    if p = 0 then exit sub
    p->bColorsPinned = false
    tkNumericUpDown_ApplyTheme( hCtrl, tkTheme_Of( hCtrl ) )
end sub

' No glyph font: the +/- glyphs are drawn bars.
public sub tkNumericUpDown_ApplyFonts( byval hCtrl as TK_WIDGET ptr, byval fText as TTF_Font ptr, byval fGlyph as TTF_Font ptr )
    if fText then tkNumericUpDown_SetFont( hCtrl, fText )
end sub

' ---- callbacks -----------------------------------------------------------------------------
public sub tkNumericUpDown_SetPaintCallback( byval hCtrl as TK_WIDGET ptr, byval usersub as NUD_PaintCallbackSub )
    dim as TKNUMERICUPDOWN_STATE ptr p = NU( hCtrl )
    if p = 0 then exit sub
    p->PaintCallback = usersub
    tkWidget_Invalidate( hCtrl )
end sub

public sub tkNumericUpDown_SetMessageCallback( byval hCtrl as TK_WIDGET ptr, byval userfunc as NUD_MessageCallbackFunc )
    dim as TKNUMERICUPDOWN_STATE ptr p = NU( hCtrl )
    if p then p->MessageCallback = userfunc
end sub

public sub tkNumericUpDown_SetValueChangedCallback( byval hCtrl as TK_WIDGET ptr, byval usersub as NUD_ValueChangedCallbackSub )
    dim as TKNUMERICUPDOWN_STATE ptr p = NU( hCtrl )
    if p then p->ValueChangedCallback = usersub
end sub

' The theme's shape (tkTheme_ShapeOf, design units) unless the host set this control's own --
' its setter pins it. -1 in the theme gives the control's default. Only a change calls the setter.
private sub ApplyThemeShape( byval w as TK_WIDGET ptr )
    dim as TKNUMERICUPDOWN_STATE ptr p = NU( w )
    if (p = 0) orelse p->bShapePinned then exit sub
    dim as TKTHEME_SHAPE sh = tkTheme_ShapeOf( w )
    dim as long v
    v = iif( sh.CornerRadius >= 0, tkHost_Scale( w->pHost, sh.CornerRadius ), tkHost_Scale( w->pHost, TKNUD_DEFAULT_CORNERRADIUS ) )
    if p->nCornerRadius <> v then tkNumericUpDown_SetCornerRadius( w, v )
    p->bShapePinned = false
end sub
