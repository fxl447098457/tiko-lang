    return p->pFont
end function

public sub tkNumericUpDown_SetFont( byval hCtrl as TK_WIDGET ptr, byval f as TTF_Font ptr )
    dim as TKNUMERICUPDOWN_STATE ptr p = NU( hCtrl )
    if p = 0 then exit sub
    p->pFont = f
    tkTextBox_SetFont( p->hTextBox, f )
    NudRefresh( p )
end sub

