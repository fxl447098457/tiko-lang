    dim as TKNUMERICUPDOWN_STATE ptr p = NU( hCtrl )
    if p = 0 then exit sub
    p->nButtonWidth = iif( nWidth < 0, 0, nWidth )
    NudRefresh( p )
end sub

public sub tkNumericUpDown_GetValuePadding( byval hCtrl as TK_WIDGET ptr, byref nLeft as long, byref nRight as long, byref nVert as long )
    nLeft = 0 : nRight = 0 : nVert = 0
    dim as TKNUMERICUPDOWN_STATE ptr p = NU( hCtrl )
    if p = 0 then exit sub
    nLeft = p->nValuePadLeft : nRight = p->nValuePadRight : nVert = p->nVertPadding
end sub

public sub tkNumericUpDown_SetValuePadding( byval hCtrl as TK_WIDGET ptr, byval nLeft as long, byval nRight as long, byval nVert as long )
    dim as TKNUMERICUPDOWN_STATE ptr p = NU( hCtrl )
    if p = 0 then exit sub
    p->nValuePadLeft = iif( nLeft < 0, 0, nLeft )
    p->nValuePadRight = iif( nRight < 0, 0, nRight )
    p->nVertPadding = iif( nVert < 0, 0, nVert )
    tkTextBox_SetMargins( p->hTextBox, p->nValuePadLeft, p->nValuePadRight )
    NudRefresh( p )
end sub

public function tkNumericUpDown_GetCornerRadius( byval hCtrl as TK_WIDGET ptr ) as long
    dim as TKNUMERICUPDOWN_STATE ptr p = NU( hCtrl )
    if p = 0 then return 0
    return p->nCornerRadius
end function

public sub tkNumericUpDown_SetCornerRadius( byval hCtrl as TK_WIDGET ptr, byval nRadius as long )
    dim as TKNUMERICUPDOWN_STATE ptr p = NU( hCtrl )
    if p = 0 then exit sub
    p->nCornerRadius = iif( nRadius < 0, 0, nRadius )
    p->bShapePinned = true
    NudRefresh( p )
end sub

public function tkNumericUpDown_GetBorderThickness( byval hCtrl as TK_WIDGET ptr ) as long
    dim as TKNUMERICUPDOWN_STATE ptr p = NU( hCtrl )
    if p = 0 then return 0
    return p->nBorderThick
end function

