'
' tkGroupBox -- a captioned frame around related controls. Never a tab stop. Children are parented to
' the box and positioned relative to its top-left corner; tkGroupBox_GetClientRect says where the
' frame leaves room for them, and has the shape tkLayout wants for a container's docking area.
#module "tkGroupBox"

#import "../tkHost" public
#import "../tkTheme" public
using tkHost
using tkPaint
using tkTheme

' Design units, scaled when used.
public const as long TKGROUPBOX_PADDING = 8
public const as long TKGROUPBOX_CAPTION_INDENT = 10
public const as long TKGROUPBOX_CAPTION_GAP = 4

public type TKGROUPBOX_COLORS
    BackColor         as ulong
    BorderColor       as ulong
    TextColor         as ulong
    TextColorDisabled as ulong
end type

public type TKGROUPBOX_STATE
    hWin          as TK_WIDGET ptr
    text          as ustring
    pFont         as TTF_Font ptr
    colors        as TKGROUPBOX_COLORS
    bColorsPinned as boolean
    declare function Font() as TTF_Font ptr
    declare function CaptionHeight() as long
end type

public declare function tkGroupBox_ThemeColors( byref t as TKTHEME_COLORS ) as TKGROUPBOX_COLORS
public declare sub tkGroupBox_ApplyTheme( byval hBox as TK_WIDGET ptr, byref t as TKTHEME_COLORS )

private function GetBoxPointer( byval h as TK_WIDGET ptr ) as TKGROUPBOX_STATE ptr
    if h = 0 then return 0
    return cast( TKGROUPBOX_STATE ptr, h->pData )
end function

function TKGROUPBOX_STATE.Font() as TTF_Font ptr
    if this.pFont then return this.pFont
    if this.hWin andalso this.hWin->pHost then return this.hWin->pHost->pDefaultFont
    return 0
end function

function TKGROUPBOX_STATE.CaptionHeight() as long
    dim as TTF_Font ptr f = this.Font()
    return iif( f <> 0, TTF_GetFontHeight( f ), 0 )
end function

private sub tkGroupBox_OnPaint( byval p as TKGROUPBOX_STATE ptr, byval b as TK_PAINT ptr )
    dim as TK_WIDGET ptr w = p->hWin
    dim as TK_HOST ptr h = w->pHost
    dim as TKRECT rc
    tkRect_Set( rc, 0, 0, w->cw, w->ch )
    b->SetBackColor( p->colors.BackColor )
    b->PaintRect( @rc )

    dim as long capH = p->CaptionHeight()
    dim as TKRECT rcFrame
    tkRect_Set( rcFrame, 0, capH \ 2, w->cw, w->ch )
    b->SetPenColor( p->colors.BorderColor )
    b->PaintBorderRect( @rcFrame )

    if len( p->text ) = 0 then exit sub
    dim as TTF_Font ptr f = p->Font()
    if f = 0 then exit sub
    dim as long gap = tkHost_Scale( h, TKGROUPBOX_CAPTION_GAP )
    dim as long x = tkHost_Scale( h, TKGROUPBOX_CAPTION_INDENT )
    dim as long maxW = w->cw - 2 * x
    dim as long tw = tkText_Width( f, p->text )
    if tw > maxW then tw = maxW
    if tw <= 0 then exit sub
    ' the frame line stops either side of the caption
    dim as TKRECT rcBand
    tkRect_Set( rcBand, x - gap, 0, x + tw + gap, capH )
    b->PaintRect( @rcBand )
    dim as TKRECT rcText
    tkRect_Set( rcText, x, 0, x + tw, capH )
    b->SetFont( f )
    b->SetForeColor( iif( tkWidget_IsEnabled( w ), p->colors.TextColor, p->colors.TextColorDisabled ) )
    b->PaintText( p->text, @rcText, TK_DT_LEFT or TK_DT_ELLIPSIS )
end sub

private function tkGroupBox_Proc( byval w as TK_WIDGET ptr, byval m as TK_MSG ptr ) as boolean
    dim as TKGROUPBOX_STATE ptr p = GetBoxPointer( w )
    if p = 0 then return false
    select case m->msg
    case TKM_PAINT
        tkGroupBox_OnPaint( p, m->pPaint )
        return true
    case TKM_SIZE
        tkWidget_Invalidate( w )
        return true
    case TKM_THEMECHANGED
        tkGroupBox_ApplyTheme( w, tkTheme_Of( w ) )
        return true
    case TKM_DESTROY
        delete p
        w->pData = 0
        return true
    end select
    return false
end function

public function tkGroupBox_Create( byval hParent as TK_WIDGET ptr, byval ctrlId as long ) as TK_WIDGET ptr
    if hParent = 0 then return 0
    dim as TKGROUPBOX_STATE ptr p = new TKGROUPBOX_STATE
    dim as TK_WIDGET ptr w = tkWidget_CreateChild( hParent, ctrlId, @tkGroupBox_Proc, p )
    p->hWin = w
    p->colors = tkGroupBox_ThemeColors( tkTheme_Of( w ) )
    ' the theme's recipes for this type apply from the start, not just after a theme change
    tkTheme_ResolveInto( w, tkTheme_Of( w ), cast( ulong ptr, @p->colors ), sizeof( TKGROUPBOX_COLORS ) \ 4, "GroupBox" )
    return w
end function

public function tkGroupBox_GetText( byval h as TK_WIDGET ptr ) as ustring
    dim as TKGROUPBOX_STATE ptr p = GetBoxPointer( h )
    if p = 0 then return ""
    return p->text
end function

public sub tkGroupBox_SetText( byval h as TK_WIDGET ptr, byref s as const ustring )
    dim as TKGROUPBOX_STATE ptr p = GetBoxPointer( h )
    if p = 0 then exit sub
    p->text = s
    tkWidget_Invalidate( h )
end sub

' Borrowed: the font must outlive the box. 0 returns to the surface's default.
public sub tkGroupBox_SetFont( byval h as TK_WIDGET ptr, byval f as TTF_Font ptr )
    dim as TKGROUPBOX_STATE ptr p = GetBoxPointer( h )
    if p = 0 then exit sub
    p->pFont = f
    tkWidget_Invalidate( h )
end sub

public function tkGroupBox_GetFont( byval h as TK_WIDGET ptr ) as TTF_Font ptr
    dim as TKGROUPBOX_STATE ptr p = GetBoxPointer( h )
    return iif( p <> 0, p->pFont, cast( TTF_Font ptr, 0 ) )
end function

' The area inside the frame and below the caption, in the box's own pixels.
public function tkGroupBox_GetClientRect( byval h as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    dim as TKGROUPBOX_STATE ptr p = GetBoxPointer( h )
    if p = 0 then return false
    dim as long pad = tkHost_Scale( h->pHost, TKGROUPBOX_PADDING )
    dim as long nL = pad, nT = p->CaptionHeight( ) + pad, nR = h->cw - pad, nB = h->ch - pad
    if nR < nL then nR = nL
    if nB < nT then nB = nT
    tkRect_Set( rc, nL, nT, nR, nB )
    return true
end function

' Colours: a host-chosen one survives a theme change; tkGroupBox_UnpinColors hands it back.
public sub tkGroupBox_SetColors( byval h as TK_WIDGET ptr, byref c as const TKGROUPBOX_COLORS )
    dim as TKGROUPBOX_STATE ptr p = GetBoxPointer( h )
    if p = 0 then exit sub
    p->colors = c
    p->bColorsPinned = true
    tkWidget_Invalidate( h )
end sub

public function tkGroupBox_GetColors( byval h as TK_WIDGET ptr ) as TKGROUPBOX_COLORS
    dim as TKGROUPBOX_STATE ptr p = GetBoxPointer( h )
    if p = 0 then return type<TKGROUPBOX_COLORS>( 0, 0, 0, 0 )
    return p->colors
end function

public function tkGroupBox_ThemeColors( byref t as TKTHEME_COLORS ) as TKGROUPBOX_COLORS
    dim as TKGROUPBOX_COLORS c
    c.BackColor = t.Window
    c.BorderColor = t.Border
    c.TextColor = t.TextDim
    c.TextColorDisabled = t.TextDisabled
    return c
end function

public sub tkGroupBox_ApplyTheme( byval h as TK_WIDGET ptr, byref t as TKTHEME_COLORS )
    dim as TKGROUPBOX_STATE ptr p = GetBoxPointer( h )
    if (p = 0) orelse p->bColorsPinned then exit sub
    dim as TKTHEME_COLORS tr = tkTheme_Styled( h, t )
    p->colors = tkGroupBox_ThemeColors( tr )
    tkTheme_ResolveInto( h, tr, cast( ulong ptr, @p->colors ), sizeof( TKGROUPBOX_COLORS ) \ 4, "GroupBox" )
    tkWidget_Invalidate( h )
end sub

public sub tkGroupBox_UnpinColors( byval h as TK_WIDGET ptr )
    dim as TKGROUPBOX_STATE ptr p = GetBoxPointer( h )
    if p = 0 then exit sub
    p->bColorsPinned = false
    tkGroupBox_ApplyTheme( h, tkTheme_Of( h ) )
end sub
