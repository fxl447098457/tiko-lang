'
' tkPicture -- shows one image: from a file (decoded and owned here) or a tkImageFile the host owns.
' Never a tab stop. The fit is tkPaint's: TK_IMGFIT_ASPECT, TK_IMGFIT_STRETCH or TK_IMGFIT_CENTER. A
' click is reported when a callback is set.
#module "tkPicture"

#import "../tkHost" public
#import "../tkTheme" public
#import "../tkImage" public
using tkHost
using tkPaint
using tkTheme
using tkImage

public type PIC_ClickCallbackSub as sub( byval hPicture as TK_WIDGET ptr, byval id as long )

public type TKPICTURE_STATE
    hWin          as TK_WIDGET ptr
    id            as long
    pOwned        as tkImageFile ptr
    sFile         as ustring
    pBorrowed     as tkImageFile ptr
    nFit          as long = TK_IMGFIT_ASPECT
    clrBack       as ulong
    bTransparent  as boolean = true
    bPressed      as boolean
    ClickCallback as PIC_ClickCallbackSub
    declare function Image() as tkImageFile ptr
end type

private function GetPicturePointer( byval h as TK_WIDGET ptr ) as TKPICTURE_STATE ptr
    if h = 0 then return 0
    return cast( TKPICTURE_STATE ptr, h->pData )
end function

function TKPICTURE_STATE.Image() as tkImageFile ptr
    if this.pBorrowed then return this.pBorrowed
    return this.pOwned
end function

private function tkPicture_Proc( byval w as TK_WIDGET ptr, byval m as TK_MSG ptr ) as boolean
    dim as TKPICTURE_STATE ptr p = GetPicturePointer( w )
    if p = 0 then return false
    select case m->msg
    case TKM_PAINT
        dim as TK_PAINT ptr b = m->pPaint
        dim as TKRECT rc
        tkRect_Set( rc, 0, 0, w->cw, w->ch )
        if p->bTransparent = false then
            b->SetBackColor( p->clrBack )
            b->PaintRect( @rc )
        end if
        dim as tkImageFile ptr img = p->Image()
        if img then tkImage_Paint( b, img, @rc, p->nFit )
        return true
    case TKM_SIZE
        tkWidget_Invalidate( w )
        return true
    case TKM_LBUTTONDOWN
        if p->ClickCallback = 0 then return false
        tkHost_SetCapture( w )
        p->bPressed = true
        return true
    case TKM_LBUTTONUP
        if p->bPressed = false then return false
        p->bPressed = false
        if tkHost_GetCapture( w->pHost ) = w then tkHost_ReleaseCapture( w->pHost )
        if (m->x >= 0) andalso (m->x < w->cw) andalso (m->y >= 0) andalso (m->y < w->ch) then
            if p->ClickCallback then p->ClickCallback( w, p->id )
        end if
        return true
    case TKM_CAPTURECHANGED
        p->bPressed = false
        return true
    case TKM_DESTROY
        if p->pOwned then delete p->pOwned
        delete p
        w->pData = 0
        return true
    end select
    return false
end function

public function tkPicture_Create( byval hParent as TK_WIDGET ptr, byval ctrlId as long ) as TK_WIDGET ptr
    if hParent = 0 then return 0
    dim as TKPICTURE_STATE ptr p = new TKPICTURE_STATE
    p->id = ctrlId
    p->clrBack = tkTheme_Get().Window
    dim as TK_WIDGET ptr w = tkWidget_CreateChild( hParent, ctrlId, @tkPicture_Proc, p )
    p->hWin = w
    return w
end function

' Decodes a file. FALSE when it cannot be read, and the picture is then empty.
public function tkPicture_SetFile( byval h as TK_WIDGET ptr, byref path as const ustring ) as boolean
    dim as TKPICTURE_STATE ptr p = GetPicturePointer( h )
    if p = 0 then return false
    p->pBorrowed = 0
    p->sFile = path
    if p->pOwned = 0 then p->pOwned = new tkImageFile
    dim as boolean ok = (p->pOwned->Load( path ) <> 0)
    tkWidget_Invalidate( h )
    return ok
end function

' The last path given to tkPicture_SetFile, whether or not it loaded.
public function tkPicture_GetFile( byval h as TK_WIDGET ptr ) as ustring
    dim as TKPICTURE_STATE ptr p = GetPicturePointer( h )
    if p = 0 then return ""
    return p->sFile
end function

' Borrowed: the image must outlive the picture, or be replaced first. 0 empties the picture.
public sub tkPicture_SetImage( byval h as TK_WIDGET ptr, byval img as tkImageFile ptr )
    dim as TKPICTURE_STATE ptr p = GetPicturePointer( h )
    if p = 0 then exit sub
    p->pBorrowed = img
    if (img = 0) andalso (p->pOwned <> 0) then p->pOwned->Dispose( )
    tkWidget_Invalidate( h )
end sub

public function tkPicture_HasImage( byval h as TK_WIDGET ptr ) as boolean
    dim as TKPICTURE_STATE ptr p = GetPicturePointer( h )
    if p = 0 then return false
    dim as tkImageFile ptr img = p->Image( )
    return iif( img <> 0, img->IsValid( ) <> 0, false )
end function

public sub tkPicture_GetNaturalSize( byval h as TK_WIDGET ptr, byref nWidth as long, byref nHeight as long )
    nWidth = 0 : nHeight = 0
    dim as TKPICTURE_STATE ptr p = GetPicturePointer( h )
    if p = 0 then exit sub
    dim as tkImageFile ptr img = p->Image( )
    if img = 0 then exit sub
    nWidth = img->NaturalWidth( )
    nHeight = img->NaturalHeight( )
end sub

public function tkPicture_GetFit( byval h as TK_WIDGET ptr ) as long
    dim as TKPICTURE_STATE ptr p = GetPicturePointer( h )
    return iif( p <> 0, p->nFit, TK_IMGFIT_ASPECT )
end function

public sub tkPicture_SetFit( byval h as TK_WIDGET ptr, byval nFit as long )
    dim as TKPICTURE_STATE ptr p = GetPicturePointer( h )
    if p = 0 then exit sub
    select case nFit
    case TK_IMGFIT_ASPECT, TK_IMGFIT_STRETCH, TK_IMGFIT_CENTER
        p->nFit = nFit
        tkWidget_Invalidate( h )
    end select
end sub

public function tkPicture_GetBackColor( byval h as TK_WIDGET ptr ) as ulong
    dim as TKPICTURE_STATE ptr p = GetPicturePointer( h )
    return iif( p <> 0, p->clrBack, 0ul )
end function

' Also turns the background on.
public sub tkPicture_SetBackColor( byval h as TK_WIDGET ptr, byval clr as ulong )
    dim as TKPICTURE_STATE ptr p = GetPicturePointer( h )
    if p = 0 then exit sub
    p->clrBack = clr
    p->bTransparent = false
    tkWidget_Invalidate( h )
end sub

public function tkPicture_GetTransparent( byval h as TK_WIDGET ptr ) as boolean
    dim as TKPICTURE_STATE ptr p = GetPicturePointer( h )
    return iif( p <> 0, p->bTransparent, true )
end function

public sub tkPicture_SetTransparent( byval h as TK_WIDGET ptr, byval bTransparent as boolean )
    dim as TKPICTURE_STATE ptr p = GetPicturePointer( h )
    if p = 0 then exit sub
    p->bTransparent = bTransparent
    tkWidget_Invalidate( h )
end sub

public sub tkPicture_SetClickCallback( byval h as TK_WIDGET ptr, byval usersub as PIC_ClickCallbackSub )
    dim as TKPICTURE_STATE ptr p = GetPicturePointer( h )
    if p then p->ClickCallback = usersub
end sub
