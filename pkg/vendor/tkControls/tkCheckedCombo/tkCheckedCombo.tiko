' ---- colours and theme ------------------------------------------------------------------------
public sub tkCheckedCombo_GetColors( byval h as TK_WIDGET ptr, byval pColors as TKCHECKEDCOMBO_COLORS ptr )
    dim as TKCHECKEDCOMBO_STATE ptr p = CC( h )
    if (p <> 0) andalso (pColors <> 0) then *pColors = p->colors
end sub

public sub tkCheckedCombo_SetColors( byval h as TK_WIDGET ptr, byval pColors as TKCHECKEDCOMBO_COLORS ptr )
    dim as TKCHECKEDCOMBO_STATE ptr p = CC( h )
    if (p = 0) orelse (pColors = 0) then exit sub
    p->colors = *pColors
    p->bColorsPinned = true
    tkWidget_Invalidate( h )
end sub

' tkComboBox's colours for a theme, field by field.
public function tkCheckedCombo_ThemeColors( byref t as TKTHEME_COLORS ) as TKCHECKEDCOMBO_COLORS
    dim as TKCOMBOBOX_COLORS k = tkComboBox_ThemeColors( t )
    dim as TKCHECKEDCOMBO_COLORS c
    c.BackColor = k.BackColor : c.ForeColor = k.ForeColor : c.BorderColor = k.BorderColor : c.ChevronColor = k.ChevronColor
    c.BackColorHot = k.BackColorHot : c.ForeColorHot = k.ForeColorHot : c.BorderColorHot = k.BorderColorHot : c.ChevronColorHot = k.ChevronColorHot
    c.BackColorOpen = k.BackColorOpen : c.ForeColorOpen = k.ForeColorOpen : c.BorderColorOpen = k.BorderColorOpen : c.ChevronColorOpen = k.ChevronColorOpen
    c.BackColorDisabled = k.BackColorDisabled : c.ForeColorDisabled = k.ForeColorDisabled
    c.BorderColorDisabled = k.BorderColorDisabled : c.ChevronColorDisabled = k.ChevronColorDisabled
    c.ForeColorPlaceholder = k.ForeColorPlaceholder : c.FocusRingColor = k.FocusRingColor
    return c
end function

public sub tkCheckedCombo_ApplyTheme( byval hCombo as TK_WIDGET ptr, byref t as TKTHEME_COLORS )
    dim as TKCHECKEDCOMBO_STATE ptr p = CC( hCombo )
    if (p = 0) orelse p->bColorsPinned then exit sub
    dim as TKTHEME_COLORS tr = tkTheme_Styled( hCombo, t )
    p->colors = tkCheckedCombo_ThemeColors( tr )
    tkTheme_ResolveInto( hCombo, tr, cast( ulong ptr, @p->colors ), sizeof( TKCHECKEDCOMBO_COLORS ) \ 4, "CheckedComboBox" )
    tkWidget_Invalidate( hCombo )
end sub

public sub tkCheckedCombo_UnpinColors( byval h as TK_WIDGET ptr )
    dim as TKCHECKEDCOMBO_STATE ptr p = CC( h )
    if p = 0 then exit sub
    p->bColorsPinned = false
    tkCheckedCombo_ApplyTheme( h, tkTheme_Of( h ) )
end sub


