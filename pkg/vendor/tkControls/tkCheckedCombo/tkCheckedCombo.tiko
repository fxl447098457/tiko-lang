end sub

public sub tkCheckedCombo_SetDropDownCallback( byval h as TK_WIDGET ptr, byval usersub as CCB_DropDownCallbackSub )
    dim as TKCHECKEDCOMBO_STATE ptr p = CC( h )
    if p then p->DropDownCallback = usersub
end sub
