' Type-to-filter in the list. The combo then wants text input (SDL starts it while the combo has
' the focus), so a character typed on the closed combo opens the list filtered by it.
public sub tkCheckedCombo_SetShowFilter( byval h as TK_WIDGET ptr, byval bShow as boolean )
    dim as TKCHECKEDCOMBO_STATE ptr p = CC( h )
    if p = 0 then exit sub
    p->bShowFilter = bShow
    if p->hWin->bWantsText <> bShow then
        p->hWin->bWantsText = bShow
        ' text input is started on a focus change: re-take the focus so it follows now
        dim as TK_HOST ptr hh = p->hWin->pHost
        if tkHost_GetFocus( hh ) = p->hWin then tkHost_SetFocus( hh, 0 ) : tkHost_SetFocus( hh, p->hWin )
    end if
end sub

' OK / Cancel in the list: the toggles wait for OK (D-7).
public sub tkCheckedCombo_SetShowButtons( byval h as TK_WIDGET ptr, byval bShow as boolean )
    dim as TKCHECKEDCOMBO_STATE ptr p = CC( h )
    if p then p->bShowButtons = bShow
end sub

