' tkReportDef -- editing the model's lists (Report Designer RD7): parameters, sources and their
' field snapshots, calculated fields, an item's rules; the page from a TKPAGESETUP; kinds by name.
' The Report Designer (tkEdit) changes the model's arrays only through these, so the redim stays in
' the vendor module.
#module "tkReportDef"

#import "../tkReport"
using tkReport
using tkPrint

' "text" "int" "float" "bool" "date" "time" as the file names them, and back.
public function tkReportDef_KindName( byval k as int32 ) as ustring
    return RdKindName( k )
end function

public function tkReportDef_KindOf( byref s as const ustring ) as int32
    return RdKindOf( s )
end function

' ---- parameters ----
public function tkReportDef_AddParam( byval def as TK_REPORTDEF ptr, byref p as TKRD_PARAM ) as int32
    if def = 0 then return -1
    if def->nParams > ubound( def->params ) then redim preserve def->params( 0 to def->nParams * 2 + 7 )
    def->params(def->nParams) = p
    def->nParams += 1
    return def->nParams - 1
end function

public sub tkReportDef_RemoveParam( byval def as TK_REPORTDEF ptr, byval i as int32 )
    if (def = 0) orelse (i < 0) orelse (i >= def->nParams) then exit sub
    for k as int32 = i to def->nParams - 2
        def->params(k) = def->params(k + 1)
    next
    dim as TKRD_PARAM blank
    def->params(def->nParams - 1) = blank
    def->nParams -= 1
end sub

public sub tkReportDef_SwapParams( byval def as TK_REPORTDEF ptr, byval a as int32, byval b as int32 )
    if (def = 0) orelse (a < 0) orelse (b < 0) orelse (a >= def->nParams) orelse (b >= def->nParams) then exit sub
    dim as TKRD_PARAM t = def->params(a)
    def->params(a) = def->params(b)
    def->params(b) = t
end sub

' ---- sources ----
public function tkReportDef_AddSource( byval def as TK_REPORTDEF ptr, byref s as TKRD_SOURCE ) as int32
    if def = 0 then return -1
    if def->nSources > ubound( def->sources ) then redim preserve def->sources( 0 to def->nSources * 2 + 7 )
    def->sources(def->nSources) = s
    def->nSources += 1
    return def->nSources - 1
end function

public sub tkReportDef_RemoveSource( byval def as TK_REPORTDEF ptr, byval i as int32 )
    if (def = 0) orelse (i < 0) orelse (i >= def->nSources) then exit sub
    for k as int32 = i to def->nSources - 2
        def->sources(k) = def->sources(k + 1)
    next
    dim as TKRD_SOURCE blank
    def->sources(def->nSources - 1) = blank
    def->nSources -= 1
end sub

public sub tkReportDef_SwapSources( byval def as TK_REPORTDEF ptr, byval a as int32, byval b as int32 )
    if (def = 0) orelse (a < 0) orelse (b < 0) orelse (a >= def->nSources) orelse (b >= def->nSources) then exit sub
    dim as TKRD_SOURCE t = def->sources(a)
    def->sources(a) = def->sources(b)
    def->sources(b) = t
end sub

' Source si's field snapshot: no fields.
public sub tkReportDef_ClearFields( byval def as TK_REPORTDEF ptr, byval si as int32 )
    if (def = 0) orelse (si < 0) orelse (si >= def->nSources) then exit sub
    ' the array stays allocated: AddField writes over it (an erase inside an array element is avoided)
    dim as TKRD_FIELD blank
    for k as int32 = 0 to def->sources(si).nFields - 1
        def->sources(si).fields(k) = blank
    next
    def->sources(si).nFields = 0
end sub

public sub tkReportDef_AddField( byval def as TK_REPORTDEF ptr, byval si as int32, byref name_ as const ustring, byval kind as int32 )
    if (def = 0) orelse (si < 0) orelse (si >= def->nSources) then exit sub
    dim byref as TKRD_SOURCE s = def->sources(si)
    if s.nFields > ubound( s.fields ) then redim preserve s.fields( 0 to s.nFields * 2 + 7 )
    s.fields(s.nFields).name_ = name_
    s.fields(s.nFields).kind = kind
    s.nFields += 1
end sub

' ---- calculated fields ([[calc]]) ----
public function tkReportDef_AddCalc( byval def as TK_REPORTDEF ptr, byref c as TKRD_CALC ) as int32
    if def = 0 then return -1
    if def->nCalcs > ubound( def->calcs ) then redim preserve def->calcs( 0 to def->nCalcs * 2 + 7 )
    def->calcs(def->nCalcs) = c
    def->nCalcs += 1
    return def->nCalcs - 1
end function

public sub tkReportDef_RemoveCalc( byval def as TK_REPORTDEF ptr, byval i as int32 )
    if (def = 0) orelse (i < 0) orelse (i >= def->nCalcs) then exit sub
    for k as int32 = i to def->nCalcs - 2
        def->calcs(k) = def->calcs(k + 1)
    next
    dim as TKRD_CALC blank
    def->calcs(def->nCalcs - 1) = blank
    def->nCalcs -= 1
end sub

public sub tkReportDef_SwapCalcs( byval def as TK_REPORTDEF ptr, byval a as int32, byval b as int32 )
    if (def = 0) orelse (a < 0) orelse (b < 0) orelse (a >= def->nCalcs) orelse (b >= def->nCalcs) then exit sub
    dim as TKRD_CALC t = def->calcs(a)
    def->calcs(a) = def->calcs(b)
    def->calcs(b) = t
end sub

' ---- an item's rules (the first that holds applies) ----
public function tkReportDef_AddRule( byval def as TK_REPORTDEF ptr, byval ii as int32, byref r as TKRD_RULE ) as int32
    if (def = 0) orelse (ii < 0) orelse (ii >= def->nItems) then return -1
    dim byref as TKRD_ITEM it = def->items(ii)
    if it.nRules > ubound( it.rules ) then redim preserve it.rules( 0 to it.nRules * 2 + 3 )
    it.rules(it.nRules) = r
    it.nRules += 1
    return it.nRules - 1
end function

public sub tkReportDef_RemoveRule( byval def as TK_REPORTDEF ptr, byval ii as int32, byval k as int32 )
    if (def = 0) orelse (ii < 0) orelse (ii >= def->nItems) then exit sub
    dim byref as TKRD_ITEM it = def->items(ii)
    if (k < 0) orelse (k >= it.nRules) then exit sub
    for j as int32 = k to it.nRules - 2
        it.rules(j) = it.rules(j + 1)
    next
    dim as TKRD_RULE blank
    it.rules(it.nRules - 1) = blank
    it.nRules -= 1
end sub

public sub tkReportDef_SwapRules( byval def as TK_REPORTDEF ptr, byval ii as int32, byval a as int32, byval b as int32 )
    if (def = 0) orelse (ii < 0) orelse (ii >= def->nItems) then exit sub
    dim byref as TKRD_ITEM it = def->items(ii)
    if (a < 0) orelse (b < 0) orelse (a >= it.nRules) orelse (b >= it.nRules) then exit sub
    dim as TKRD_RULE t = it.rules(a)
    it.rules(a) = it.rules(b)
    it.rules(b) = t
end sub

' ---- the page ----
' The report's page from a page setup (a Page Setup dialog's answer): paper by name, orientation,
' margins; a custom paper keeps its size.
public sub tkReportDef_SetPageSetup( byval def as TK_REPORTDEF ptr, byref ps as TKPAGESETUP )
    if def = 0 then exit sub
    select case ps.paper
    case TK_PAPER_A4 : def->paper = "A4"
    case TK_PAPER_LETTER : def->paper = "Letter"
    case TK_PAPER_LEGAL : def->paper = "Legal"
    case TK_PAPER_A3 : def->paper = "A3"
    case TK_PAPER_A5 : def->paper = "A5"
    case TK_PAPER_B5 : def->paper = "B5"
    case TK_PAPER_TABLOID : def->paper = "Tabloid"
    case TK_PAPER_EXECUTIVE : def->paper = "Executive"
    case TK_PAPER_CUSTOM
        def->paper = "Custom"
        def->paperW = ps.widthPt
        def->paperH = ps.heightPt
    case else : def->paper = ""
    end select
    def->landscape = ps.landscape
    def->mL = ps.marginL : def->mT = ps.marginT : def->mR = ps.marginR : def->mB = ps.marginB
end sub
