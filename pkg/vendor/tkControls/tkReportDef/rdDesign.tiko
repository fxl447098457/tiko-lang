'
' tkReportDef -- a band as the Report Designer's canvas shows it (Report Designer RD5). Each band
' is recorded into a one-page document of its own size through tkReport's own item painter
' (tkReport_PaintItem), then replayed by the canvas at its zoom: fonts, metrics and wrapping are
' the printed report's. Nothing is evaluated: a field shows its expression, a text item its
' template, a check is unticked, an image or custom item a labelled outline.
'
'   dim as TK_PRINTDOC ptr doc = tkReportDef_RecordBand( def, bi, tkReportDef_ContentWidth( def ) )
'   tkPrintReplay_Page( rp, doc, 0, x, y, pxPerPt )
#module "tkReportDef"

#import "../tkReport"
#import "../tkPaint"
using tkReport
using tkPrint
using tkPaint

' The width of the report's content: the page less its side margins, in points.
public function tkReportDef_ContentWidth( byval def as TK_REPORTDEF ptr ) as float32
    if def = 0 then return 0
    dim as TKPAGESETUP ps
    tkReportDef_PageSetup( def, ps )
    tkPageSetup_Resolve( ps )
    dim as single w, h
    tkPageSetup_PageSize( ps, w, h )
    dim as float32 cw = w - def->mL - def->mR
    if cw < 1 then cw = 1
    return cw
end function

' What an item shows on the canvas.
public function tkReportDef_DesignText( byref it as TKRD_ITEM ) as ustring
    select case it.kind
    case "text" : return it.text
    case "field" : return it.expr
    case "image"
        if len( it.expr ) then return it.expr
        return it.text
    case "custom" : return "custom " & it.tag
    end select
    return ""
end function

' Band bi as a one-page document widthPt wide and the band's height tall (at least 1 pt); 0 when
' bi is not a band. The caller destroys it (tkPrintDoc_Destroy).
public function tkReportDef_RecordBand( byval def as TK_REPORTDEF ptr, byval bi as int32, byval widthPt as float32 ) as TK_PRINTDOC ptr
    if (def = 0) orelse (bi < 0) orelse (bi >= def->nBands) then return 0
    dim byref as TKRD_BAND b = def->bands(bi)
    dim as TK_PRINTDOC ptr doc = tkPrintDoc_Create( b.id )
    dim as TKPAGESETUP ps
    ps.paper = TK_PAPER_CUSTOM
    ps.widthPt = iif( widthPt < 1, 1, widthPt )
    ps.heightPt = iif( b.height < 1, 1, b.height )
    ps.marginL = 0 : ps.marginT = 0 : ps.marginR = 0 : ps.marginB = 0
    dim as TK_PAGE ptr pg = tkPrintDoc_AddPageEx( doc, ps )
    dim as TKRECTF rc
    dim as ulong bandBack = RdColor( b.back, 0 )
    if (bandBack shr 24) <> 0 then
        tkRectF_Set( rc, 0, 0, ps.widthPt, ps.heightPt )
        tkPage_SetFillColor( pg, bandBack )
        tkPage_FillRect( pg, rc )
    end if
    dim as ustring id = lcase( b.id )
    for i as int32 = 0 to def->nItems - 1
        dim byref as TKRD_ITEM it = def->items(i)
        if lcase( it.band ) <> id then continue for
        dim as TKREPORT_ITEM e
        tkReportDef_MakeItem( it, e, -1 )
        rc = e.rc
        tkReport_PaintItemBack( pg, e, rc, e.back )
        dim as ustring text = tkReportDef_DesignText( it )
        if (e.kind = TKRI_IMAGE) orelse (e.kind = TKRI_CUSTOM) then
            ' a placeholder: no file is opened and no host callback runs at design time
            tkPage_SetLineColor( pg, &hFF9A9A9Aul )
            tkPage_SetPen( pg, 0.5 )
            tkPage_StrokeRect( pg, rc )
            tkPage_SetFont( pg, e.font )
            tkPage_SetTextColor( pg, &hFF7A7A7Aul )
            tkPage_Text( pg, text, rc, TK_DT_CENTER )
            text = ""
        end if
        tkReport_PaintItem( pg, e, rc, e.font, e.fore, e.back, text, false )
    next
    return doc
end function
