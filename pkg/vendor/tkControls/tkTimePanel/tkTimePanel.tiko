' Replaces item labels (tkTimePicker's FormatTime reaches its list this way). Re-measures.
public sub tkTimePanel_SetItemTextCallback( byval hPanel as TK_WIDGET ptr, byval usersub as TP_ItemTextCallbackSub )
    dim as TKTIMEPANEL_STATE ptr p = TP( hPanel )
    if p = 0 then exit sub
    p->ItemTextCallback = usersub
    p->bLayoutDirty = true
    tkWidget_Invalidate( hPanel )
end sub

' The theme's shape until a shape setter ran: its BorderWidth is the panel's border.
private sub ApplyThemeShape( byval w as TK_WIDGET ptr )
    dim as TKTIMEPANEL_STATE ptr p = TP( w )
    if (p = 0) orelse p->bShapePinned then exit sub
    dim as TKTHEME_SHAPE sh = tkTheme_ShapeOf( w )
    p->nBorderThick = iif( sh.BorderWidth >= 0, sh.BorderWidth, TKTP_DEFAULT_BORDER )
    p->bLayoutDirty = true
    tkWidget_Invalidate( w )
end sub
