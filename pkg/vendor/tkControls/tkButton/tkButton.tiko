public function tkButton_GetTextAlign( byval hButton as TK_WIDGET ptr ) as long
    dim as TKBUTTON_STATE ptr pBtn = GetButtonPointer( hButton )
    if pBtn = 0 then return BTN_ALIGN_CENTER
    return pBtn->nTextAlign
end function

public sub tkButton_SetTextAlign( byval hButton as TK_WIDGET ptr, byval nTextAlign as long )
    dim as TKBUTTON_STATE ptr pBtn = GetButtonPointer( hButton )
    if pBtn = 0 then exit sub
    select case nTextAlign
    case BTN_ALIGN_LEFT, BTN_ALIGN_CENTER, BTN_ALIGN_RIGHT
        pBtn->nTextAlign = nTextAlign
        tkWidget_Invalidate( hButton )
    end select
end sub

public sub tkButton_SetPadding( byval hButton as TK_WIDGET ptr, byval l as long, byval t as long, byval r as long, byval b as long )
    dim as TKBUTTON_STATE ptr pBtn = GetButtonPointer( hButton )
    if pBtn = 0 then exit sub
    pBtn->nPadLeft = iif( l < 0, 0, l ) : pBtn->nPadTop = iif( t < 0, 0, t )
    pBtn->nPadRight = iif( r < 0, 0, r ) : pBtn->nPadBottom = iif( b < 0, 0, b )
    pBtn->Refresh()
    tkButton_ApplyAutoSize( pBtn )
end sub

public sub tkButton_GetPadding( byval hButton as TK_WIDGET ptr, byref l as long, byref t as long, byref r as long, byref b as long )
    dim as TKBUTTON_STATE ptr pBtn = GetButtonPointer( hButton )
    if pBtn = 0 then exit sub
    l = pBtn->nPadLeft : t = pBtn->nPadTop : r = pBtn->nPadRight : b = pBtn->nPadBottom
end sub

public function tkButton_GetIconGap( byval hButton as TK_WIDGET ptr ) as long
    dim as TKBUTTON_STATE ptr pBtn = GetButtonPointer( hButton )
    if pBtn = 0 then return 0
    return pBtn->nIconGap
