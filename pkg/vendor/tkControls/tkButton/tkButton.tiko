' Render the WHOLE WINDOW with isFocused forced on, read back the button's part rect with
' SDL_RenderReadPixels, and count distinct colours (capped at 64). The Win32 version needed a
' private DIB and a cached memDC to dodge GDI+ batching; here the render target can simply be
' read before it is presented -- but it is the whole frame, not the control alone.
public function tkButton_CountRenderedTones( byval hButton as TK_WIDGET ptr, byval nPart as long ) as long
    dim as TKBUTTON_STATE ptr pBtn = GetButtonPointer( hButton )
    if pBtn = 0 then return 0
    dim as TKRECT rc
    if GetPart( hButton, nPart, rc ) = false then return 0
    if tkRect_IsEmpty( rc ) then return 0
    if rc.left < 0 then rc.left = 0
    if rc.top < 0 then rc.top = 0
    if rc.right > hButton->cw then rc.right = hButton->cw
    if rc.bottom > hButton->ch then rc.bottom = hButton->ch
    if tkRect_IsEmpty( rc ) then return 0

    dim as TK_HOST ptr h = hButton->pHost
    dim as boolean bSaved = pBtn->isFocused
    pBtn->isFocused = true
    dim as TKRECT a
    tkWidget_AbsRect( hButton, a )
    dim as TK_PAINT wp
    wp.renderer = h->renderer
    wp.engine = h->engine
    wp.Begin( a.left, a.top, hButton->cw, hButton->ch )
    tkButton_OnPaint( pBtn, @wp )
    pBtn->isFocused = bSaved
    SDL_SetRenderClipRect( h->renderer, 0 )

    dim as SDL_Rect r
    r.x = a.left + rc.left : r.y = a.top + rc.top
    r.w = rc.right - rc.left : r.h = rc.bottom - rc.top
    dim as SDL_Surface ptr s0 = SDL_RenderReadPixels( h->renderer, @r )
    if s0 = 0 then return 0
    dim as SDL_Surface ptr s = SDL_ConvertSurface( s0, SDL_PIXELFORMAT_ARGB8888 )
    SDL_DestroySurface( s0 )
    if s = 0 then return 0
    h->bDirty = true                 ' the probe drew into the back buffer; repaint honestly

    dim tones(0 to 63) as ulong
    dim as long nTones = 0
    for y as long = 0 to s->h - 1
        dim as ulong ptr row = cast( ulong ptr, cast( ubyte ptr, s->pixels ) + y * s->pitch )
        for x as long = 0 to s->w - 1
            dim as ulong c = row[x] and &h00FFFFFFul
            dim as boolean bFound = false
            for t as long = 0 to nTones - 1
                if tones(t) = c then bFound = true : exit for
            next
            if (bFound = false) andalso (nTones < 64) then tones(nTones) = c : nTones += 1
        next
    next
    SDL_DestroySurface( s )
    return nTones
end function
