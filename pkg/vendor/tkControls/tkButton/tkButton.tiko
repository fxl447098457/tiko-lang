' Valid BEFORE the control has been sized: the measuring pass precedes the zero-client bail.
public sub tkButton_GetIdealSize( byval hButton as TK_WIDGET ptr, byref nWidth as long, byref nHeight as long )
    nWidth = 0 : nHeight = 0
    dim as TKBUTTON_STATE ptr pBtn = GetButtonPointer( hButton )
    if pBtn = 0 then exit sub
    if pBtn->bLayoutDirty then pBtn->LayoutButton()
    nWidth = pBtn->nIdealW : nHeight = pBtn->nIdealH
end sub

public sub tkButton_GetTextWidth( byval hButton as TK_WIDGET ptr, byref tw as long, byref th as long )
    dim as TKBUTTON_STATE ptr pBtn = GetButtonPointer( hButton )
    if pBtn = 0 then exit sub
    if pBtn->bLayoutDirty then pBtn->LayoutButton()
    tw = pBtn->nTextWidth : th = pBtn->nTextHeight
end sub

private function GetPart( byval hButton as TK_WIDGET ptr, byval nPart as long, byref rc as TKRECT ) as boolean
    tkRect_SetEmpty( rc )
    dim as TKBUTTON_STATE ptr pBtn = GetButtonPointer( hButton )
    if pBtn = 0 then return false
    if pBtn->bLayoutDirty then pBtn->LayoutButton()
    if pBtn->bLayoutDirty then return false
    select case nPart
    case BTN_PART_TEXT
        rc = pBtn->rcText
    case BTN_PART_ICONLEFT
        rc = pBtn->rcIconLeft
    case BTN_PART_ICONRIGHT
        rc = pBtn->rcIconRight
    case -1
        rc = pBtn->rcVisual
    case else
        rc = pBtn->rcButton
    end select
    return true
end function

public function tkButton_GetButtonRect( byval hButton as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return GetPart( hButton, BTN_PART_BUTTON, rc )
end function
public function tkButton_GetTextRect( byval hButton as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return GetPart( hButton, BTN_PART_TEXT, rc )
end function
public function tkButton_GetIconLeftRect( byval hButton as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return GetPart( hButton, BTN_PART_ICONLEFT, rc )
end function
public function tkButton_GetIconRightRect( byval hButton as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return GetPart( hButton, BTN_PART_ICONRIGHT, rc )
end function
public function tkButton_GetVisualRect( byval hButton as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return GetPart( hButton, -1, rc )
end function

public sub tkButton_GetColors( byval hButton as TK_WIDGET ptr, byval pColors as TKBUTTON_COLORS ptr )
    dim as TKBUTTON_STATE ptr pBtn = GetButtonPointer( hButton )
    if (pBtn = 0) orelse (pColors = 0) then exit sub
    *pColors = pBtn->colors
end sub

' Copies the struct and PINS it: a theme change leaves this button alone until UnpinColors.
public sub tkButton_SetColors( byval hButton as TK_WIDGET ptr, byval pColors as TKBUTTON_COLORS ptr )
    dim as TKBUTTON_STATE ptr pBtn = GetButtonPointer( hButton )
    if (pBtn = 0) orelse (pColors = 0) then exit sub
    pBtn->colors = *pColors
    pBtn->bColorsPinned = true
    tkWidget_Invalidate( hButton )
end sub

' The button's colours from the theme's roles (vendor PsButton_ThemeColors).
public function tkButton_ThemeColors( byref t as TKTHEME_COLORS ) as TKBUTTON_COLORS
    dim as TKBUTTON_COLORS c
    c.BackColor = t.Surface : c.ForeColor = t.Text : c.BorderColor = t.Surface : c.IconColor = t.Text
    c.BackColorHot = t.SurfaceHot : c.ForeColorHot = t.TextHot : c.BorderColorHot = t.SurfaceHot : c.IconColorHot = t.TextHot
    c.BackColorPressed = t.Selected : c.ForeColorPressed = t.SelectedText
    c.BorderColorPressed = t.Selected : c.IconColorPressed = t.SelectedText
    c.BackColorDisabled = t.SurfaceDisabled : c.ForeColorDisabled = t.TextDisabled
    c.BorderColorDisabled = t.SurfaceDisabled : c.IconColorDisabled = t.TextDisabled
    c.FocusRingColor = t.FocusRing : c.DefaultBorderColor = t.FocusRing
    return c
end function

public sub tkButton_ApplyTheme( byval hButton as TK_WIDGET ptr, byref t as TKTHEME_COLORS )
    dim as TKBUTTON_STATE ptr pBtn = GetButtonPointer( hButton )
    if (pBtn = 0) orelse pBtn->bColorsPinned then exit sub
    pBtn->colors = tkButton_ThemeColors( t )
    tkWidget_Invalidate( hButton )
end sub

' Hands the button back to the theme, which is applied at once.
public sub tkButton_UnpinColors( byval hButton as TK_WIDGET ptr )
    dim as TKBUTTON_STATE ptr pBtn = GetButtonPointer( hButton )
    if pBtn = 0 then exit sub
    pBtn->bColorsPinned = false
    tkButton_ApplyTheme( hButton, tkTheme_Get() )
end sub

' The form's fonts (tkApp): either may be 0 to keep the current one.
public sub tkButton_ApplyFonts( byval hButton as TK_WIDGET ptr, byval fText as TTF_Font ptr, byval fGlyph as TTF_Font ptr )
    dim as TKBUTTON_STATE ptr pBtn = GetButtonPointer( hButton )
    if pBtn = 0 then exit sub
    if fText then pBtn->pTextFont = fText
    if fGlyph then pBtn->pGlyphFont = fGlyph
    pBtn->Refresh()
    tkButton_ApplyAutoSize( pBtn )
end sub

