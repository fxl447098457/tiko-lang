public sub tkButton_SetDefault( byval hButton as TK_WIDGET ptr, byval isDefault as boolean )
    dim as TKBUTTON_STATE ptr pBtn = GetButtonPointer( hButton )
    if (pBtn = 0) orelse (pBtn->isDefault = isDefault) then exit sub
    pBtn->isDefault = isDefault
    tkWidget_Invalidate( hButton )
