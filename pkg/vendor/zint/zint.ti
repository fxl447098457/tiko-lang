#pragma once

extern "C"

    /' Vector elements - see vector header `zint_vector` below '/
    type zint_vector_rect
        x as float32
        y as float32        /' Top left '/
        height as float32
        width as float32
        colour as int32     /' -1 for foreground, 1-8 for Cyan, Blue, Magenta, Red, Yellow, Green, Black, White '/
        next as zint_vector_rect ptr   /' Pointer to next rectangle '/
    end type

    type zint_vector_hexagon
        x as float32
        y as float32        /' Centre '/
        diameter as float32 /' Short (minimal) diameter (i.e. diameter of inscribed circle) '/
        rotation as int32   /' 0, 90, 180, 270 degrees, where 0 has apex at top, i.e. short diameter is horizontal '/
        next as zint_vector_hexagon ptr   /' Pointer to next hexagon '/
    end type

    type zint_vector_string
        x as float32
        y as float32        /' x is relative to halign (i.e. centre, left, right), y is relative to baseline '/
        fsize as float32    /' Font size '/
        width as float32    /' Rendered width estimate '/
        length as int32     /' Number of characters (bytes) '/
        rotation as int32   /' 0, 90, 180, 270 degrees '/
        halign as int32     /' Horizontal alignment: 0 for centre, 1 for left, 2 for right (end) '/
        text as uint8 ptr    /' UTF-8, NUL-terminated '/
        next as zint_vector_string ptr   /' Pointer to next string '/
    end type

    type zint_vector_circle
        x as float32
        y as float32        /' Centre '/
        diameter as float32 /' Circle diameter. Does not include width (if any) '/
        width as float32    /' Width of circle perimeter (circumference). 0 for fill (disc) '/
        colour as int32     /' Zero for draw with foreground colour (else draw with background colour (legacy)) '/
        next as zint_vector_circle ptr   /' Pointer to next circle '/
    end type

    /' Vector header '/
    type zint_vector
        width as float32
        height as float32    /' Width, height of barcode image (including text, whitespace) '/
        rectangles as zint_vector_rect ptr   /' Pointer to first rectangle '/
        hexagons as zint_vector_hexagon ptr   /' Pointer to first hexagon '/
        strings as zint_vector_string ptr   /' Pointer to first string '/
        circles as zint_vector_circle ptr   /' Pointer to first circle '/
    end type

    /' Structured Append info (see `symbol->structapp` below) - ignored unless `zint_structapp.count` is non-zero '/
    type zint_structapp
        index as int32      /' Position in Structured Append sequence, 1-based. Must be <= `count` '/
        count as int32      /' Number of symbols in Structured Append sequence. Set >= 2 to add SA Info '/
        id as zstring * 32  /' Optional ID to distinguish sequence, ASCII, NUL-terminated unless max 32 long '/
    end type

    /' Segment for use with API `ZBarcode_Encode_Segs()` and `content_segs` '/
    type zint_seg
        source as uint8 ptr    /' Data to encode '/
        length as int32     /' Length of `source`. If 0 or negative, `source` must be NUL-terminated '/
        eci as int32        /' Extended Channel Interpretation '/
    end type

    /' Main symbol structure '/
    type zint_symbol
        symbology as int32  /' Symbol to use (see BARCODE_XXX below) '/
        height as float32   /' Barcode height in X-dimensions (ignored for fixed-width barcodes) '/
        scale as float32    /' Scale factor when printing barcode, i.e. adjusts X-dimension. Default 1 '/
        whitespace_width as int32 /' Width in X-dimensions of whitespace to left & right of barcode '/
        whitespace_height as int32 /' Height in X-dimensions of whitespace above & below the barcode '/
        border_width as int32   /' Size of border in X-dimensions '/
        output_options as int32 /' Various output parameters (bind, box etc, see below) '/
        fgcolour as zstring * 16  /' Foreground as hexadecimal RGB/RGBA or decimal "C,M,Y,K" string, NUL-terminated '/
        bgcolour as zstring * 16  /' Background as hexadecimal RGB/RGBA or decimal "C,M,Y,K" string, NUL-terminated '/
        fgcolor as zstring ptr      /' Pointer to fgcolour (alternate spelling) '/
        bgcolor as zstring ptr      /' Pointer to bgcolour (alternate spelling) '/
        outfile as zstring * 256  /' Name of file to output to, NUL-terminated. Default "out.png" ("out.gif" if no PNG) '/
        primary as zstring * 128  /' Primary message data (MaxiCode, Composite), NUL-terminated '/
        option_1 as int32   /' Symbol-specific options (see "../docs/manual.txt") '/
        option_2 as int32   /' Symbol-specific options '/
        option_3 as int32   /' Symbol-specific options '/
        show_hrt as int32   /' Show (1) or hide (0) Human Readable Text (HRT). Default 1 '/
        input_mode as int32 /' Encoding of input data (see DATA_MODE etc below). Default DATA_MODE '/
        eci as int32        /' Extended Channel Interpretation. Default 0 (none) '/
        dpmm as float32     /' Resolution of output in dots per mm (BMP/EMF/PCX/PNG/TIF only). Default 0 (none) '/
        dot_size as float32 /' Size of dots used in BARCODE_DOTTY_MODE. Default 0.8 '/
        text_gap as float32 /' Gap between barcode and text (HRT) in X-dimensions. Default 1 '/
        guard_descent as float32 /' Height in X-dimensions that EAN/UPC guard bars descend. Default 5 '/
        structapp as zint_structapp      /' Structured Append info. Default structapp.count 0 (none) '/
        warn_level as int32 /' Affects error/warning value returned by Zint API (see WARN_XXX below) '/
        debug as int32      /' Debugging flags '/
        text(0 to 255) as uint8  /' Human Readable Text (HRT) (if any), UTF-8, NUL-terminated (output only) '/
        text_length as int32    /' Length of text in bytes (output only) '/
        rows as int32       /' Number of rows used by the symbol (output only) '/
        width as int32      /' Width of the generated symbol (output only) '/
        errtxt as zstring * 160   /' Error message if an error or warning occurs, NUL-terminated (output only) '/
        bitmap as uint8 ptr    /' Stored bitmap image (raster output only) '/
        bitmap_width as int32   /' Width of bitmap image (raster output only) '/
        bitmap_height as int32  /' Height of bitmap image (raster output only) '/
        alphamap as uint8 ptr    /' Array of alpha values used (raster output only) '/
        vector as zint_vector ptr   /' Pointer to vector header (vector output only) '/
        memfile as uint8 ptr    /' Pointer to in-memory file buffer if BARCODE_MEMORY_FILE (output only) '/
        memfile_size as int32   /' Length of in-memory file buffer (output only) '/
        content_segs as zint_seg ptr   /' Pointer to array of content segs if BARCODE_CONTENT_SEGS (output only) '/
        content_seg_count as int32 /' Number of `content_segs` (output only) '/
        encoded_data(0 to 199, 0 to 143) as uint8 /' Encoded data (output only). Allows for rows of 1152 modules '/
        row_height(0 to 199) as float32 /' Heights of rows (output only). Allows for 200 row DotCode '/
    end type

/' Symbologies (`symbol->symbology`) '/
