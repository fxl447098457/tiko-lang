/' Output options (`symbol->output_options`) '/
#define BARCODE_BIND_TOP &h00001        /' Boundary bar above the symbol only (not below), does not affect stacking '/
                                        /' Note: value was once used by the legacy (never-used) BARCODE_NO_ASCII '/
#define BARCODE_BIND &h00002            /' Boundary bars above & below the symbol and between stacked symbols '/
#define BARCODE_BOX &h00004             /' Box around symbol '/
#define BARCODE_STDOUT &h00008          /' Output to stdout '/
#define READER_INIT &h00010             /' Reader Initialisation (Programming) '/
#define SMALL_TEXT &h00020              /' Use smaller font '/
#define BOLD_TEXT &h00040               /' Use bold font '/
#define CMYK_COLOUR &h00080             /' CMYK colour space (Encapsulated PostScript and TIF) '/
#define BARCODE_DOTTY_MODE &h00100      /' Plot a matrix symbol using dots rather than squares '/
#define GS1_GS_SEPARATOR &h00200        /' Use GS instead of FNC1 as GS1 separator (Data Matrix) '/
#define OUT_BUFFER_INTERMEDIATE &h00400 /' Return ASCII values in bitmap buffer (OUT_BUFFER only) '/
#define BARCODE_QUIET_ZONES &h00800     /' Add compliant quiet zones (additional to any specified whitespace) '/
                                        /' Note: CODE16K, CODE49, CODABLOCKF, ITF14, EAN/UPC have default quiet zones
                                         '/
#define BARCODE_NO_QUIET_ZONES &h01000  /' Disable quiet zones, notably those with defaults as listed above '/
#define COMPLIANT_HEIGHT &h02000        /' Warn if height not compliant, or use standard height (if any) as default '/
#define EANUPC_GUARD_WHITESPACE &h04000 /' Add quiet zone indicators ("<"/">") to HRT whitespace (EAN/UPC) '/
#define EMBED_VECTOR_FONT &h08000       /' Embed font in vector output - currently only for SVG output '/
#define BARCODE_MEMORY_FILE &h10000     /' Write output to in-memory buffer `memfile` instead of to `outfile` '/
#define BARCODE_CONTENT_SEGS &h20000    /' Write data encoded to content segment buffers `content_segs` '/

/' Input data types (`symbol->input_mode`) '/
#define DATA_MODE 0                     /' Binary '/
#define UNICODE_MODE 1                  /' UTF-8 '/
#define GS1_MODE 2                      /' GS1 '/
/' The following may be OR-ed with above '/
#define ESCAPE_MODE &h0008              /' Process escape sequences '/
#define GS1PARENS_MODE &h0010           /' Process parentheses as GS1 AI delimiters (instead of square brackets) '/
#define GS1NOCHECK_MODE &h0020          /' Do not check validity of GS1 data (except that printable ASCII only) '/
#define HEIGHTPERROW_MODE &h0040        /' Interpret `height` as per-row rather than as overall height '/
#define FAST_MODE &h0080                /' Use faster if less optimal encodation or other shortcuts if available '/
                                        /' Note: affects DATAMATRIX, MICROPDF417, PDF417, QRCODE & UPNQR only '/
#define EXTRA_ESCAPE_MODE &h0100        /' Process special symbology-specific escape sequences as well as others '/
                                        /' Note: currently Code 128 only '/
#define GS1SYNTAXENGINE_MODE &h0200     /' Use the GS1 Syntax Engine (if available) to strictly validate GS1 input '/

/' Data Matrix specific options (`symbol->option_3`) '/
#define DM_SQUARE 100                   /' Only consider square versions on automatic symbol size selection '/
#define DM_DMRE 101                     /' Consider DMRE versions on automatic symbol size selection '/
#define DM_ISO_144 128                  /' Use ISO instead of "de facto" format for 144x144 (i.e. don't skew ECC) '/

/' QR, Han Xin, Grid Matrix specific options (`symbol->option_3`) '/
#define ZINT_FULL_MULTIBYTE 200         /' Enable Kanji/Hanzi compression for Latin-1 & binary data '/

/' Ultracode specific option (`symbol->option_3`) '/
#define ULTRA_COMPRESSION 128           /' Enable Ultracode compression (experimental) '/

/' Warning and error conditions (API return values) '/
#define ZINT_WARN_HRT_TRUNCATED 1       /' Human Readable Text was truncated (max 199 bytes) '/
#define ZINT_WARN_INVALID_OPTION 2      /' Invalid option given but overridden by Zint '/
#define ZINT_WARN_USES_ECI 3            /' Automatic ECI inserted by Zint '/
#define ZINT_WARN_NONCOMPLIANT 4        /' Symbol created not compliant with standards '/
#define ZINT_ERROR 5                    /' Warn/error marker, not returned '/
#define ZINT_ERROR_TOO_LONG 5           /' Input data wrong length '/
#define ZINT_ERROR_INVALID_DATA 6       /' Input data incorrect '/
#define ZINT_ERROR_INVALID_CHECK 7      /' Input check digit incorrect '/
#define ZINT_ERROR_INVALID_OPTION 8     /' Incorrect option given '/
#define ZINT_ERROR_ENCODING_PROBLEM 9   /' Internal error (should not happen) '/
#define ZINT_ERROR_FILE_ACCESS 10       /' Error opening output file '/
#define ZINT_ERROR_MEMORY 11            /' Memory allocation (malloc) failure '/
#define ZINT_ERROR_FILE_WRITE 12        /' Error writing to output file '/
#define ZINT_ERROR_USES_ECI 13          /' Error counterpart of warning if WARN_FAIL_ALL set (see below) '/
#define ZINT_ERROR_NONCOMPLIANT 14      /' Error counterpart of warning if WARN_FAIL_ALL set '/
#define ZINT_ERROR_HRT_TRUNCATED 15     /' Error counterpart of warning if WARN_FAIL_ALL set '/

/' Warning level (`symbol->warn_level`) '/
#define WARN_DEFAULT 0             /' Default behaviour '/
#define WARN_FAIL_ALL 2            /' Treat warning as error '/

/' Capability flags (ZBarcode_Cap() `cap_flag`) '/
#define ZINT_CAP_HRT &h0001                 /' Prints Human Readable Text? '/
#define ZINT_CAP_STACKABLE &h0002           /' Is stackable? '/
#define ZINT_CAP_EANUPC &h0004              /' Is EAN/UPC? '/
#define ZINT_CAP_EXTENDABLE &h0004          /' Legacy '/
#define ZINT_CAP_COMPOSITE &h0008           /' Can have composite data? '/
#define ZINT_CAP_ECI &h0010                 /' Supports Extended Channel Interpretations? '/
#define ZINT_CAP_GS1 &h0020                 /' Supports GS1 data? '/
#define ZINT_CAP_DOTTY &h0040               /' Can be output as dots? '/
#define ZINT_CAP_QUIET_ZONES &h0080         /' Has default quiet zones? '/
#define ZINT_CAP_FIXED_RATIO &h0100         /' Has fixed width-to-height (aspect) ratio? '/
#define ZINT_CAP_READER_INIT &h0200         /' Supports Reader Initialisation? '/
#define ZINT_CAP_FULL_MULTIBYTE &h0400      /' Supports full-multibyte option? '/
#define ZINT_CAP_MASK &h0800                /' Is mask selectable? '/
#define ZINT_CAP_STRUCTAPP &h1000           /' Supports Structured Append? '/
#define ZINT_CAP_COMPLIANT_HEIGHT &h2000    /' Has compliant height? '/
#define ZINT_CAP_BINDABLE &h4000            /' Can set row separators? '/

/' The largest amount of data that can be encoded is 4350 4-byte UTF-8 chars in Han Xin Code '/
#define ZINT_MAX_DATA_LEN 17400
/' Maximum number of segments allowed for (`seg_count`) '/
#define ZINT_MAX_SEG_COUNT 256

/' Debug flags (`symbol->debug`) '/
#define ZINT_DEBUG_PRINT &h0001         /' Print debug info (if any) to stdout '/
#define ZINT_DEBUG_TEST &h0002          /' For internal test use only '/

'' c2t: export macro ZINT_EXTERN (decoration, stripped where used)

    /' Create a symbol structure and set fields to default values '/
    declare function ZBarcode_Create( ) as zint_symbol ptr

    /' Free any output buffers that may have been created and zeroize output fields '/
    declare sub ZBarcode_Clear( byval symbol as zint_symbol ptr )

    /' Free any output buffers that may have been created and reset all fields to defaults '/
    declare sub ZBarcode_Reset( byval symbol as zint_symbol ptr )

    /' Free a symbol structure, including any output buffers '/
    declare sub ZBarcode_Delete( byval symbol as zint_symbol ptr )


    /' Encode a barcode. If `length` is 0 or negative, `source` must be NUL-terminated '/
    declare function ZBarcode_Encode( byval symbol as zint_symbol ptr, byval source as const uint8 ptr, byval length as int32 ) as int32

    /' Encode a barcode with multiple ECI segments '/
    declare function ZBarcode_Encode_Segs( byval symbol as zint_symbol ptr, byval segs as const zint_seg ptr, _
                        byval seg_count as int32 ) as int32

    /' Encode a barcode using input data from file `filename` '/
    declare function ZBarcode_Encode_File( byval symbol as zint_symbol ptr, byval filename as const zstring ptr ) as int32

    /' Output a previously encoded symbol to file `symbol->outfile` '/
    declare function ZBarcode_Print( byval symbol as zint_symbol ptr, byval rotate_angle as int32 ) as int32


    /' Encode and output a symbol to file `symbol->outfile` '/
    declare function ZBarcode_Encode_and_Print( byval symbol as zint_symbol ptr, byval source as const uint8 ptr, byval length as int32, _
                        byval rotate_angle as int32 ) as int32

    /' Encode a symbol with multiple ECI segments and output to file `symbol->outfile` '/
    declare function ZBarcode_Encode_Segs_and_Print( byval symbol as zint_symbol ptr, byval segs as const zint_seg ptr, _
                        byval seg_count as int32, byval rotate_angle as int32 ) as int32

    /' Encode a symbol using input data from file `filename` and output to file `symbol->outfile` '/
    declare function ZBarcode_Encode_File_and_Print( byval symbol as zint_symbol ptr, byval filename as const zstring ptr, _
                        byval rotate_angle as int32 ) as int32


    /' Output a previously encoded symbol to memory as raster (`symbol->bitmap`) '/
    declare function ZBarcode_Buffer( byval symbol as zint_symbol ptr, byval rotate_angle as int32 ) as int32

    /' Encode and output a symbol to memory as raster (`symbol->bitmap`) '/
    declare function ZBarcode_Encode_and_Buffer( byval symbol as zint_symbol ptr, byval source as const uint8 ptr, byval length as int32, _
                        byval rotate_angle as int32 ) as int32

    /' Encode a symbol with multiple ECI segments and output to memory as raster (`symbol->bitmap`) '/
    declare function ZBarcode_Encode_Segs_and_Buffer( byval symbol as zint_symbol ptr, byval segs as const zint_seg ptr, _
                        byval seg_count as int32, byval rotate_angle as int32 ) as int32

    /' Encode a symbol using input data from file `filename` and output to memory as raster (`symbol->bitmap`) '/
    declare function ZBarcode_Encode_File_and_Buffer( byval symbol as zint_symbol ptr, byval filename as const zstring ptr, _
                        byval rotate_angle as int32 ) as int32


    /' Output a previously encoded symbol to memory as vector (`symbol->vector`) '/
    declare function ZBarcode_Buffer_Vector( byval symbol as zint_symbol ptr, byval rotate_angle as int32 ) as int32

    /' Encode and output a symbol to memory as vector (`symbol->vector`) '/
    declare function ZBarcode_Encode_and_Buffer_Vector( byval symbol as zint_symbol ptr, byval source as const uint8 ptr, _
                        byval length as int32, byval rotate_angle as int32 ) as int32

    /' Encode a symbol with multiple ECI segments and output to memory as vector (`symbol->vector`) '/
    declare function ZBarcode_Encode_Segs_and_Buffer_Vector( byval symbol as zint_symbol ptr, byval segs as const zint_seg ptr, _
                        byval seg_count as int32, byval rotate_angle as int32 ) as int32

    /' Encode a symbol using input data from file `filename` and output to memory as vector (`symbol->vector`) '/
    declare function ZBarcode_Encode_File_and_Buffer_Vector( byval symbol as zint_symbol ptr, byval filename as const zstring ptr, _
                        byval rotate_angle as int32 ) as int32


    /' Is `symbol_id` a recognized symbology? '/
    declare function ZBarcode_ValidID( byval symbol_id as int32 ) as int32

    /' Copy BARCODE_XXX name of `symbol_id` into `name` buffer, NUL-terminated.
       Returns 0 if valid, 1 if not valid '/
    declare function ZBarcode_BarcodeName( byval symbol_id as int32, byval name_ as byte ptr ) as int32

    /' Return the capability flags for symbology `symbol_id` that match `cap_flag` '/
    declare function ZBarcode_Cap( byval symbol_id as int32, byval cap_flag as uint32 ) as uint32


    /' Return default X-dimension in mm for symbology `symbol_id`. Returns 0 on error (invalid `symbol_id`) '/
    declare function ZBarcode_Default_Xdim( byval symbol_id as int32 ) as float32

    /' Return the scale to use for `symbol_id` for non-zero X-dimension `x_dim_mm` at `dpmm` dots per mm for
       `filetype`. If `dpmm` zero defaults to 12. If `filetype` NULL/empty, defaults to "GIF". Returns 0 on error '/
    declare function ZBarcode_Scale_From_XdimDp( byval symbol_id as int32, byval x_dim_mm as float32, byval dpmm as float32, byval filetype as const zstring ptr ) as float32

    /' Reverse of `ZBarcode_Scale_From_XdimDp()` above to estimate the X-dimension or dpmm given non-zero `scale` and
       non-zero `x_dim_mm_or_dpmm`. Return value bound to dpmm max not X-dimension max. Returns 0 on error '/
    declare function ZBarcode_XdimDp_From_Scale( byval symbol_id as int32, byval scale as float32, byval x_dim_mm_or_dpmm as float32, _
                        byval filetype as const zstring ptr ) as float32


    /' Convert UTF-8 `source` of length `length` to `eci`-encoded `dest`, setting `p_dest_length` to length of `dest`
       on output. If `length` is 0 or negative, `source` must be NUL-terminated. Returns 0 on success, else
       ZINT_ERROR_INVALID_OPTION or ZINT_ERROR_INVALID_DATA. Compatible with libzueci `zueci_utf8_to_eci()` '/
    declare function ZBarcode_UTF8_To_ECI( byval eci as int32, byval source as const uint8 ptr, byval length as int32, byval dest as uint8 ptr, _
                        byval p_dest_length as int32 ptr ) as int32

    /' Calculate sufficient length needed to convert UTF-8 `source` of length `length` from UTF-8 to `eci`, and place
       in `p_dest_length`. If `length` is 0 or negative, `source` must be NUL-terminated. Returns 0 on success, else
       ZINT_ERROR_INVALID_OPTION or ZINT_ERROR_INVALID_DATA. Compatible with libzueci `zueci_dest_len_eci()` '/
    declare function ZBarcode_Dest_Len_ECI( byval eci as int32, byval source as const uint8 ptr, byval length as int32, byval p_dest_length as int32 ptr ) as int32


    /' Whether Zint built without PNG support '/
    declare function ZBarcode_NoPng( ) as int32

    /' Whether Zint built with GS1 Syntax Engine support '/
    declare function ZBarcode_HaveGS1SyntaxEngine( ) as int32

    /' Return the version of Zint linked to '/
    declare function ZBarcode_Version( ) as int32

end extern

/' vim: set ts=4 sw=4 et : '/
