'' vendor/zint -- libzint 2.16.0, the barcode library behind Zint (BSD-3: LICENSE), as one import:
''
''     #import "vendor/zint" link static        (or 'link dynamic', or neither)
''
'' Every routine, type and constant of zint.h is then callable as zint's manual documents it,
'' unqualified -- ZBarcode_Create, ZBarcode_Encode, ZBarcode_Buffer_Vector, ZBarcode_Delete,
'' BARCODE_QRCODE, UNICODE_MODE. The header is zint.ti, translated from zint.h by 'tiko c2t' and
'' committed; its banner names the C header and its SHA-256. Nothing needed translating by hand.
''
''     dim as zint_symbol ptr sym = ZBarcode_Create( )
''     sym->symbology = BARCODE_QRCODE
''     sym->input_mode = UNICODE_MODE
''     dim as string s = "https://tiko-lang.net"
''     if ZBarcode_Encode_and_Buffer_Vector( sym, strptr( s ), len( s ), 0 ) < ZINT_ERROR then
''         ' sym->rows x sym->width modules; sym->vector->rectangles is a linked list of the dark ones
''     else
''         print sym->errtxt
''     end if
''     ZBarcode_Delete( sym )
''
'' encoded_data is BIT-PACKED: module (row, col) is ( encoded_data(row, col shr 3) shr ( col and 7 ) ) and 1
'' (zint's own module_is_set, common.h). What ZBarcode_* allocate -- the vector, the bitmap -- is
'' zint's: ZBarcode_Delete frees it with the symbol.
''
'' THE LIBRARY is the backend alone, built without libpng (fetch.toml): ZBarcode_Print and the
'' *_and_Print routines can write BMP, EMF, GIF, PCX, EPS, SVG and TIF files, but not PNG.
'' With 'link static' libzint is linked into the program; with 'link dynamic' -- and when no
'' '#import' says, which is this package's default -- the shared library, which tiko copies
'' beside the program: zint.dll, zint_linux_x86_64.so on Linux, zint_linux_arm64.so on arm64
'' Linux, or zint_macos_arm64.dylib on macOS.
#module "zint"

public #include once "zint.ti"

#ifdef TIKO_LINK_STATIC
    #foreignlib ZINT static "lib/zint"
#else
    #foreignlib ZINT dynamic "lib/zint"
#endif
