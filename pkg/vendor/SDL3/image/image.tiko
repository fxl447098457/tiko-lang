'' vendor/SDL3/image -- SDL3_image 3.4 (the 3.4.4 header; built from release-3.4.x past 3.4.8,
'' ../fetch.toml), SDL 3's image-loading library (IMG_*), as one import:
''
''     #import "vendor/SDL3/image" link dynamic        (or neither)
''
'' It brings vendor/SDL3 with it: SDL's own names come across too, and SDL3 is linked.
'' The header is SDL_image.ti beside this file, the sdl3-freebasic binding (GaBurdis, MIT).
''
'' THE LIBRARY: as vendor/SDL3's -- 'link dynamic' alone. On Windows ../lib/SDL3_image.dll,
'' beside SDL3.dll (both built by ../static/build.sh), copied beside the program; on Linux the system's, '-lSDL3_image' from
'' the distribution's development package, and on macOS Homebrew's (brew install sdl3_image).
#module "image"

#import "vendor/SDL3" public

public #include once "SDL_image.ti"

'' 'link static': ../lib/SDL3_image_<os>_<arch>.a from ../static/build.sh, decoding through stb
'' (PNG, JPEG, BMP, GIF, TGA and the other formats SDL_image builds in); no AVIF, JXL, TIFF, WebP.
#ifdef TIKO_LINK_STATIC
    #foreignlib SDL3_image static "../lib/SDL3_image"
#elseif defined( TIKO_OS_LINUX ) or defined( TIKO_OS_MACOS )
    #foreignlib SDL3_image dynamic "system:SDL3_image"
#else
    #foreignlib SDL3_image dynamic "../lib/SDL3_image"
#endif
