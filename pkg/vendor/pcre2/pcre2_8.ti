#define PCRE2_UNGREEDY &h00040000u             /' C       '/
#define PCRE2_UTF &h00080000u                  /' C J M D '/
#define PCRE2_NEVER_BACKSLASH_C &h00100000u    /' C       '/
#define PCRE2_ALT_CIRCUMFLEX &h00200000u       /'   J M D '/
