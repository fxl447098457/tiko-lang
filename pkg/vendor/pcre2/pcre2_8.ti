#define PCRE2_MATCH_UNSET_BACKREF &h00000200u  /' C J M   '/
#define PCRE2_MULTILINE &h00000400u            /' C       '/
#define PCRE2_NEVER_UCP &h00000800u            /' C       '/
#define PCRE2_NEVER_UTF &h00001000u            /' C       '/
#define PCRE2_NO_AUTO_CAPTURE &h00002000u      /' C       '/
#define PCRE2_NO_AUTO_POSSESS &h00004000u      /' C       '/
#define PCRE2_NO_DOTSTAR_ANCHOR &h00008000u    /' C       '/
#define PCRE2_NO_START_OPTIMIZE &h00010000u    /'   J M D '/
