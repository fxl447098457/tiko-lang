/' Allow for C++ users compiling this directly. '/

extern "C"

/' The following option bits can be passed to pcre2_compile(), pcre2_match(),
or pcre2_dfa_match(). PCRE2_NO_UTF_CHECK affects only the function to which it
is passed. Put these bits at the most significant end of the options word so
others can be added next to them '/

#define PCRE2_ANCHORED &h80000000u
#define PCRE2_NO_UTF_CHECK &h40000000u
#define PCRE2_ENDANCHORED &h20000000u

/' The following option bits can be passed only to pcre2_compile(). However,
they may affect compilation, JIT compilation, and/or interpretive execution.
The following tags indicate which:

C   alters what is compiled by pcre2_compile()
J   alters what is compiled by pcre2_jit_compile()
M   is inspected during pcre2_match() execution
D   is inspected during pcre2_dfa_match() execution
'/

#define PCRE2_ALLOW_EMPTY_CLASS &h00000001u    /' C       '/
#define PCRE2_ALT_BSUX &h00000002u             /' C       '/
#define PCRE2_AUTO_CALLOUT &h00000004u         /' C       '/
#define PCRE2_CASELESS &h00000008u             /' C       '/
