/' Request types for pcre2_config(). '/

#define PCRE2_CONFIG_BSR 0
#define PCRE2_CONFIG_JIT 1
#define PCRE2_CONFIG_JITTARGET 2
#define PCRE2_CONFIG_LINKSIZE 3
#define PCRE2_CONFIG_MATCHLIMIT 4
#define PCRE2_CONFIG_NEWLINE 5
#define PCRE2_CONFIG_PARENSLIMIT 6
#define PCRE2_CONFIG_DEPTHLIMIT 7
#define PCRE2_CONFIG_RECURSIONLIMIT 7           /' Obsolete synonym '/
#define PCRE2_CONFIG_STACKRECURSE 8             /' Obsolete '/
#define PCRE2_CONFIG_UNICODE 9
#define PCRE2_CONFIG_UNICODE_VERSION 10
#define PCRE2_CONFIG_VERSION 11
#define PCRE2_CONFIG_HEAPLIMIT 12
#define PCRE2_CONFIG_NEVER_BACKSLASH_C 13
#define PCRE2_CONFIG_COMPILED_WIDTHS 14
#define PCRE2_CONFIG_TABLES_LENGTH 15
#define PCRE2_CONFIG_EFFECTIVE_LINKSIZE 16

/' Optimization directives for pcre2_set_optimize().
For binary compatibility, only add to this list; do not renumber. '/

#define PCRE2_OPTIMIZATION_NONE 0
#define PCRE2_OPTIMIZATION_FULL 1

#define PCRE2_AUTO_POSSESS 64
#define PCRE2_AUTO_POSSESS_OFF 65
#define PCRE2_DOTSTAR_ANCHOR 66
#define PCRE2_DOTSTAR_ANCHOR_OFF 67
#define PCRE2_START_OPTIMIZE 68
#define PCRE2_START_OPTIMIZE_OFF 69

/' Types used in pcre2_set_substitute_case_callout().

PCRE2_SUBSTITUTE_CASE_LOWER and PCRE2_SUBSTITUTE_CASE_UPPER are passed to the
callout to indicate that the case of the entire callout input should be
case-transformed. PCRE2_SUBSTITUTE_CASE_TITLE_FIRST is passed to indicate that
only the first character or glyph should be transformed to Unicode titlecase,
and the rest to lowercase. '/

#define PCRE2_SUBSTITUTE_CASE_LOWER 1
#define PCRE2_SUBSTITUTE_CASE_UPPER 2
#define PCRE2_SUBSTITUTE_CASE_TITLE_FIRST 3

/' Types for code units in patterns and subject strings. '/

type PCRE2_UCHAR8 as uint8
type PCRE2_UCHAR16 as uint16
type PCRE2_UCHAR32 as uint32

type PCRE2_SPTR8 as const PCRE2_UCHAR8 ptr
type PCRE2_SPTR16 as const PCRE2_UCHAR16 ptr
type PCRE2_SPTR32 as const PCRE2_UCHAR32 ptr

/' The PCRE2_SIZE type is used for all string lengths and offsets in PCRE2,
including pattern offsets for errors and subject offsets after a match. We
define special values to indicate zero-terminated strings and unset offsets in
the offset vector (ovector). '/

type PCRE2_SIZE as uinteger /' flatten.py: pcre2.h's #define, as a typedef '/
'' C2T-NOTE(value) pcre2_8.h:544 -- clang's value; 'SIZE_MAX' is nothing tiko declares
#define PCRE2_SIZE_MAX 18446744073709551615ull
'' C2T-NOTE(value) pcre2_8.h:545 -- clang's value; a cast, which tiko's preprocessor does not evaluate
#define PCRE2_ZERO_TERMINATED 18446744073709551615ull
'' C2T-NOTE(value) pcre2_8.h:546 -- clang's value; a cast, which tiko's preprocessor does not evaluate
#define PCRE2_UNSET 18446744073709551615ull

/' Generic types for opaque structures and JIT callback functions. These
declarations are defined in a macro that is expanded for each width later. '/

type pcre2_real_general_context_8__fwd as pcre2_real_general_context_8
type pcre2_general_context_8 as pcre2_real_general_context_8

type pcre2_real_compile_context_8__fwd as pcre2_real_compile_context_8
type pcre2_compile_context_8 as pcre2_real_compile_context_8

type pcre2_real_match_context_8__fwd as pcre2_real_match_context_8
type pcre2_match_context_8 as pcre2_real_match_context_8

type pcre2_real_convert_context_8__fwd as pcre2_real_convert_context_8
type pcre2_convert_context_8 as pcre2_real_convert_context_8

type pcre2_real_code_8__fwd as pcre2_real_code_8
type pcre2_code_8 as pcre2_real_code_8

type pcre2_real_match_data_8__fwd as pcre2_real_match_data_8
type pcre2_match_data_8 as pcre2_real_match_data_8

type pcre2_real_jit_stack_8__fwd as pcre2_real_jit_stack_8
type pcre2_jit_stack_8 as pcre2_real_jit_stack_8

type pcre2_jit_callback_8 as function cdecl( byval as any ptr ) as pcre2_jit_stack_8 ptr


/' The structures for passing out data via callout functions. We use structures
so that new fields can be added on the end in future versions, without changing
the API of the function, thereby allowing old clients to work without
modification. Define the generic versions in a macro; the width-specific
versions are generated from this macro below. '/

/' Flags for the callout_flags field. These are cleared after a callout. '/

#define PCRE2_CALLOUT_STARTMATCH &h00000001u     /' Set for each bumpalong '/
#define PCRE2_CALLOUT_BACKTRACK &h00000002u      /' Set after a backtrack '/

type pcre2_callout_block_8
  version as uint32                /' Identifies version of block '/
  /' ------------------------ Version 0 ------------------------------- '/
  callout_number as uint32         /' Number compiled into pattern '/
  capture_top as uint32            /' Max current capture '/
  capture_last as uint32           /' Most recently closed capture '/
  offset_vector as PCRE2_SIZE ptr  /' The offset vector '/
  mark as PCRE2_SPTR8               /' Pointer to current mark or NULL '/
  subject as PCRE2_SPTR8            /' The subject being matched '/
  subject_length as PCRE2_SIZE     /' The length of the subject '/
  start_match as PCRE2_SIZE        /' Offset to start of this match attempt '/
  current_position as PCRE2_SIZE   /' Where we currently are in the subject '/
  pattern_position as PCRE2_SIZE   /' Offset to next item in the pattern '/
  next_item_length as PCRE2_SIZE   /' Length of next item in the pattern '/
  /' ------------------- Added for Version 1 -------------------------- '/
  callout_string_offset as PCRE2_SIZE  /' Offset to string within pattern '/
  callout_string_length as PCRE2_SIZE  /' Length of string compiled into pattern '/
  callout_string as PCRE2_SPTR8     /' String compiled into pattern '/
  /' ------------------- Added for Version 2 -------------------------- '/
  callout_flags as uint32          /' See above for list '/
  /' ------------------------------------------------------------------ '/
end type

type pcre2_callout_enumerate_block_8
  version as uint32                /' Identifies version of block '/
  /' ------------------------ Version 0 ------------------------------- '/
  pattern_position as PCRE2_SIZE   /' Offset to next item in the pattern '/
  next_item_length as PCRE2_SIZE   /' Length of next item in the pattern '/
  callout_number as uint32         /' Number compiled into pattern '/
  callout_string_offset as PCRE2_SIZE  /' Offset to string within pattern '/
  callout_string_length as PCRE2_SIZE  /' Length of string compiled into pattern '/
  callout_string as PCRE2_SPTR8     /' String compiled into pattern '/
  /' ------------------------------------------------------------------ '/
end type

type pcre2_substitute_callout_block_8
  version as uint32                /' Identifies version of block '/
  /' ------------------------ Version 0 ------------------------------- '/
  input as PCRE2_SPTR8              /' Pointer to input subject string '/
  output as PCRE2_SPTR8             /' Pointer to output buffer '/
  output_offsets(0 to 1) as PCRE2_SIZE /' Changed portion of the output '/
  ovector as PCRE2_SIZE ptr        /' Pointer to current ovector '/
  oveccount as uint32              /' Count of pairs set in ovector '/
  subscount as uint32              /' Substitution number '/
  /' ------------------------------------------------------------------ '/
end type


