#module "tz"
'' std/tz: the Windows zone key of the OS zone, for TimeZone.Local's IANA id.
''
'' Windows names its zones with keys of its own ("Newfoundland Standard Time"), not
'' IANA ids. GetDynamicTimeZoneInformation gives the key; CLDR's windowsZones table
'' (tzwinmap.tiko, generated) gives the IANA zone that stands for it.
''
'' "ADJUST FOR DAYLIGHT SAVING TIME AUTOMATICALLY" OFF means the OS zone keeps its
'' standard offset all year, which no IANA zone does -- so the key is not reported
'' then, and Local's id is "".

declare function tzWindowsToIana( byref key as const ustring ) as ustring

#ifdef __FB_WIN32__

type TzSystemTime_
    as ushort wYear, wMonth, wDayOfWeek, wDay, wHour, wMinute, wSecond, wMilliseconds
end type

'' DYNAMIC_TIME_ZONE_INFORMATION: TIME_ZONE_INFORMATION's 172 bytes, the key name and
'' the "automatic DST disabled" flag.
type TzDynamicInfo_
    as long Bias
    as wstring * 32 StandardName
    as TzSystemTime_ StandardDate
    as long StandardBias
    as wstring * 32 DaylightName
    as TzSystemTime_ DaylightDate
    as long DaylightBias
    as wstring * 128 TimeZoneKeyName
    as ubyte DynamicDaylightTimeDisabled
end type

extern "Windows"
    declare function tzGetDynamicTimeZoneInformation alias "GetDynamicTimeZoneInformation" _
        ( byval p as TzDynamicInfo_ ptr ) as ulong
end extern

'' The OS zone's key, or "" when it cannot be read or automatic DST is off.
function tzWindowsLocalKey( ) as ustring
    dim as TzDynamicInfo_ d
    if tzGetDynamicTimeZoneInformation( @d ) = &hFFFFFFFFul then return ""
    if d.DynamicDaylightTimeDisabled <> 0 then return ""
    dim as ustring k = d.TimeZoneKeyName
    return k
end function

#endif
