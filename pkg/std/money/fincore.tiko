#module "money"
#import "std/numeric"
#import "std/chrono"
#import "std/outcome"
using numeric
using chrono
using outcome

'' std/chrono's C kernel, which is the runtime's (src/rtlib/dt_core.c) and not chrono's API:
'' the few this module calls, declared here for every file of it.
extern "rtlib"
declare function fb_DtIsLeapYear alias "fb_DtIsLeapYear" ( byval year as long ) as long
end extern

'' std/money: fincore -- interest, rates and the conventions they are quoted in
''
''     #import "std/money"
''     using money
''
''     '' A Canadian mortgage rate: 5.95% quoted SEMI-ANNUALLY, not in advance,
''     '' converted to the monthly rate that actually amortizes it.
''     var i = RatePerPaymentFromNominal( DecimalParse( "0.0595" ).Value( ), _
''                                        COMPOUND_SEMIANNUAL, PAY_MONTHLY )
''
''     '' The US convention is the SAME CALL with one enum changed.
''     var u = RatePerPaymentFromNominal( DecimalParse( "0.0595" ).Value( ), _
''                                        COMPOUND_MONTHLY, PAY_MONTHLY )
''
'' COMPOUNDING AND PAYMENT FREQUENCY ARE TWO PARAMETERS, NOT ONE.  This is the
'' central decision of the module and everything else follows from it.  A loan
'' has two frequencies: how often interest COMPOUNDS, which is a property of
'' how the rate is quoted, and how often a PAYMENT is made, which is a property
'' of the contract.  In the United States a mortgage compounds monthly and pays
'' monthly, so the two collapse and the distinction is invisible -- which is
'' why almost every finance library elides it.  In Canada the Interest Act
'' requires the rate to be quoted SEMI-ANNUALLY, NOT IN ADVANCE, while payments
'' are monthly, biweekly or weekly.  The two differ, and a library that assumed
'' one number produces a payment wrong by dollars a month and by thousands over
'' the term.
''
'' So there is no CanadianMortgageRate beside an American one.  There is
'' RatePerPaymentFromNominal, and the two markets differ in ONE ENUM.
''
'' THE EXACT / DOUBLE BOUNDARY, STATED ONCE.  decimal.tiko has no Pow, Exp,
'' Log or Sqrt -- it has + - * / mod, comparison, rounding and conversion.  So
'' anything here needing a power is either built from multiplication or is not
'' exact.  The rule, and every public function repeats which side it is on:
''
''     EXACT        growth or discount over an INTEGER number of periods;
''                  every sum, product and quotient of money; day-count
''                  fractions, which are an integer over an integer
''
''     DOUBLE       fractional exponents -- nominal-from-effective, the
''                  Canadian sixth root, dated discounting; continuous
''                  compounding; every solver
''
'' A rate that has been through the double kernel is rounded back at
'' FIN_RATE_SCALE and EVERYTHING DOWNSTREAM OF IT IS AGAIN EXACT.  A Canadian
'' mortgage crosses the boundary exactly once, at conversion; the 300-row
'' schedule that follows is exact Decimal arithmetic.  One approximation, at a
'' known place, named in the doc comment of the function that takes it.
''
'' "EXACT" MEANS EXACT TO A 96-BIT MANTISSA, not exact in the rational sense.
'' Decimal division produces a terminating expansion where one exists and 28
'' significant digits where one does not, matching .NET -- so 1/3 is 28 threes
'' here as it is in C#.  Said plainly so the word is not read as a stronger
'' claim than it is.
''
'' NOTHING NUMERIC IS HAND-ROLLED.  The double kernel calls std/numeric:
'' Pow, Expm1, Log1p, Ceil, Floor, IsNaN, NaN; the exact path calls
'' decimal.tiko's own arithmetic and Round; the calendar arithmetic calls
'' std/chrono and fb_DtIsLeapYear.  The one algorithm written here is the
'' BINARY EXPONENTIATION in GrowthFactor, and it exists only because
'' decimal.tiko has no power at all -- mathint.tiko's IPow is exact but INTEGER,
'' and math.tiko's Pow is DOUBLE, so neither can raise a Decimal.
''
'' WHICH OF Pow AND Expm1/Log1p, AND WHY IT IS NOT ARBITRARY.  Both ship in
'' std/numeric and the choice is about CANCELLATION, not preference:
''
''     the result is a FACTOR, near 1..10   ->  Pow( 1 + i, n )
''     the result is a RATE, near zero      ->  Expm1( n * Log1p( i ) )
''
'' ( 1 + i )^n - 1 for a monthly rate is 1.0049... - 1, which throws away three
'' correct digits to catastrophic cancellation.  Expm1 and Log1p are the libm
'' functions that exist to avoid exactly that, and every '- 1' form below uses
'' them.  GrowthFactorFractional returns the factor itself and uses Pow.
''
'' NAME COLLISIONS, STATED UP FRONT.  std/numeric declares `const as double E`
'' (Euler's number) and free functions Min, Max, Clamp, Sign and Round.
'' FreeBASIC identifiers are case-insensitive, so a local named 'e' or 'sign'
'' in a file that says 'using numeric', as this one does, will not compile.
'' Measured, not guessed -- `dim as FinanceError e` cost a build.


#if __FB_LANG__ <> "fb"
    #error "std/money requires -lang fb (it uses namespaces)"
#endif

#include once "fblimits.bi"
#include once "fblimits.bi"

using FB

'' ===========================================================================
'' Working scales
'' ===========================================================================

'' WHY 24 AND NOT 28.  A 96-bit mantissa holds up to
'' 79,228,162,514,264,337,593,543,950,335 -- about 28.6 decimal digits IN
'' TOTAL, shared between the integer and the fractional part.  A value carried
'' at scale 28 therefore has NO ROOM LEFT OF THE POINT, and a growth factor is
'' greater than one by construction.  Reducing to 24 after every step leaves an
'' integer part up to roughly 79,228 -- a growth factor that size is a 40-year
'' term at well over 10%, far past anything a mortgage produces.  Past it the
'' kernel returns FIN_OVERFLOW rather than silently shedding digits.
''
'' Twenty-four fractional digits is in turn far past any money question: a rate
'' at 24 places applied to a trillion-dollar balance is precise to the twelfth
'' decimal of a cent.
public const as long FIN_WORK_SCALE = 24

'' A double carries 15-17 significant decimal digits, and DecimalFromDouble
'' formats through "%.14e" -- fifteen.  Rounding a double-derived rate to more
'' places than the double ever held would be padding, not precision, so the
'' double kernel caps its answer here.
public const as long FIN_RATE_SCALE = 20

'' ===========================================================================
'' Conventions
'' ===========================================================================

'' THE VALUES ARE PERIODS PER YEAR, deliberately, so RatePerPeriod is a
'' division and not a lookup table.  COMPOUND_CONTINUOUS and COMPOUND_SIMPLE
'' are the two members that are NOT frequencies; every function consuming a
'' Compounding branches on them explicitly and none falls through to a division
'' by zero.
public enum Compounding
    COMPOUND_CONTINUOUS  = -1
    COMPOUND_SIMPLE      = 0
    COMPOUND_ANNUAL      = 1
    COMPOUND_SEMIANNUAL  = 2
    COMPOUND_QUARTERLY   = 4
    COMPOUND_MONTHLY     = 12
    COMPOUND_SEMIMONTHLY = 24
    COMPOUND_BIWEEKLY    = 26
    COMPOUND_WEEKLY      = 52
    COMPOUND_DAILY_360   = 360
    COMPOUND_DAILY_365   = 365
end enum

'' THE TWO ACCELERATED FREQUENCIES ARE NEGATIVE ON PURPOSE.  They are not a
'' rate conversion at all: an accelerated-biweekly payment is THE MONTHLY
'' PAYMENT DIVIDED BY TWO, made 26 times a year, which pays principal down
'' faster than 26 equal payments would.  That is a different computation, and a
'' negative value forces every SELECT CASE to handle it rather than reaching
'' abs( ) and silently treating it as ordinary biweekly.  They are the standard
'' Canadian prepayment product and getting them wrong is a common bug.
public enum PaymentFrequency
    PAY_ACCELERATED_WEEKLY   = -52
    PAY_ACCELERATED_BIWEEKLY = -26
    PAY_ANNUAL               = 1
    PAY_SEMIANNUAL           = 2
    PAY_QUARTERLY            = 4
    PAY_MONTHLY              = 12
    PAY_SEMIMONTHLY          = 24
    PAY_BIWEEKLY             = 26
    PAY_WEEKLY               = 52
end enum

public enum PaymentTiming
    PAY_END_OF_PERIOD   = 0        '' ordinary annuity -- the default everywhere
    PAY_BEGIN_OF_PERIOD = 1        '' annuity due
end enum

'' THIRTY_360_US IS ISDA'S 30/360 BOND BASIS (2006 Definitions 4.16(f)), and
'' THIRTY_E_360 IS ISDA'S 30E/360 (4.16(g)).  Both are specified in section
'' "Day count" below as numbered rules, because the two differ ONLY in their
'' end-of-month handling and that is precisely where implementations diverge
'' from one another.
''
'' Excel's basis 0 is a NASD variant that additionally adjusts for the last day
'' of February.  It is NOT reproduced here and this file does not claim it.
public enum DayCount
    DAYCOUNT_ACTUAL_365_FIXED
    DAYCOUNT_ACTUAL_360
    DAYCOUNT_ACTUAL_ACTUAL_ISDA
    DAYCOUNT_THIRTY_360_US
    DAYCOUNT_THIRTY_E_360
    DAYCOUNT_ACTUAL_365_25
end enum

'' ===========================================================================
'' Rounding policy
''
'' The mode enum is decimal.tiko's DecimalRounding, NOT a new FIN_* set.
'' decimal.tiko mirrors currency.tiko's CUR_* names for exactly this reason -- one
'' rule to learn rather than two -- and a third spelling of half-to-even would
'' undo that.
'' ===========================================================================

public type MoneyRounding
    as long            Digits_      '' 2 for dollars and cents; 0 .. 28
    as DecimalRounding Mode_
    as boolean         RoundEach_   '' round every posted amount, or only on output
end type

public function MoneyRoundingMake overload _
    ( _
        byval digits as long, byval mode as DecimalRounding, _
        byval roundEach as boolean _
    ) as MoneyRounding

    dim as MoneyRounding p
    p.Digits_    = digits
    p.Mode_      = mode
    p.RoundEach_ = roundEach
    return p
end function

'' The default in every record that carries one.  Half-to-even for the reason
'' currency.tiko and decimal.tiko both give: half-up biases every tie the same way,
'' and across a long schedule that is real money.
public function MoneyRoundingCents overload ( ) as MoneyRounding
    return MoneyRoundingMake( 2, DEC_HALF_EVEN, TRUE )
end function

public function MoneyRoundingBankersFour overload ( ) as MoneyRounding
    return MoneyRoundingMake( 4, DEC_HALF_EVEN, TRUE )
end function

'' Analytical mode: nothing is rounded on the way through, only on output.
public function MoneyRoundingExact overload ( ) as MoneyRounding
    return MoneyRoundingMake( DECIMAL_MAX_SCALE, DEC_HALF_EVEN, FALSE )
end function

public function MoneyRound overload ( byref v as Decimal, byref p as MoneyRounding ) as Decimal
    if( p.RoundEach_ = FALSE ) then return v
    return v.RoundMode( p.Digits_, p.Mode_ )
end function

'' ===========================================================================
'' Private helpers
''
'' 'h'-prefixed, per the house convention.  Validation happens ONCE, at the
'' public entry point; everything below assumes valid arguments, so no helper
'' here is reachable with garbage.
'' ===========================================================================

'' REDUCE-ONLY, and that is the whole point.  Decimal.Round( d ) returns the
'' value unchanged when d >= its scale, so this can never overflow.
'' Decimal.Rescale( d ) would PAD with zeros and can return Invalid when the
'' padded mantissa no longer fits 96 bits -- wrong tool for a growth factor.
''
'' APPLIED ONLY WHERE REPEATED MULTIPLICATION WOULD GROW THE SCALE WITHOUT
'' BOUND -- which is the binary-exponentiation loop, and nowhere else.  A single
'' division or product needs no cap: Decimal's own scale rules already bound it,
'' deterministically and identically to .NET, and capping anyway would throw
'' away four correct digits for nothing.
''
'' This matters for a claim the tests assert:
'' under the US convention the rate per payment is EXACTLY j/m.  Capping the
'' division made that false for any j/m with a non-terminating expansion --
'' 0.0595/12 among them.  Measured, then fixed.
function hFinCap overload ( byref v as Decimal ) as Decimal
    return v.Round( FIN_WORK_SCALE )
end function

'' A rate is usable when it is a valid Decimal and strictly greater than -1:
'' at exactly -1 the growth factor is zero and the discount factor divides by
'' it, and below -1 the loan has repaid more than it ever was.
function hFinRateOk overload ( byref i as Decimal ) as boolean
    if( i.IsValid( ) = FALSE ) then return FALSE
    return ( i > DecimalMinusOne( ) )
end function

'' The double kernel's exit: convert, then CAP at FIN_RATE_SCALE.  Returns
'' Invalid for NaN, infinity and anything past 1e30, which DecimalFromDouble
'' already refuses -- so an out-of-range double becomes FIN_OVERFLOW at the
'' caller rather than a plausible wrong number.
function hFinFromDouble overload ( byval v as double ) as Decimal
    dim as Decimal d = DecimalFromDouble( v )
    if( d.IsValid( ) = FALSE ) then return d
    return d.Round( FIN_RATE_SCALE )
end function

'' Periods per year for a PaymentFrequency, with the accelerated forms mapped
'' to the MONTHLY period they are defined against.  See
'' RatePerPaymentFromNominal for why that is the right answer and not a fudge.
function hFinPayPeriods overload ( byval f as PaymentFrequency ) as long
    select case as const f
    case PAY_ACCELERATED_WEEKLY, PAY_ACCELERATED_BIWEEKLY : return 12
    end select
    return clng( f )
end function

'' ===========================================================================
'' Day count
''
'' Plain values, not Result: these are total over their domain.  An Invalid
'' LocalDate is already Invalid in std/chrono and yields a zero-day span; an
'' out-of-range basis falls back to Act/365F, which is documented rather than
'' left to be discovered.
'' ===========================================================================

'' ISDA 30/360 BOND BASIS, 2006 Definitions 4.16(f).  Two rules, in order:
''   1. if D1 is 31, it becomes 30
''   2. if D2 is 31 AND D1 is 30 or 31, D2 becomes 30
'' Rule 2 is tested against the ORIGINAL D1, which is why rule 1's result is
'' not reused for it.
function hFinDays30360US overload ( byref d1 as LocalDate, byref d2 as LocalDate ) as long
    dim as long y1 = d1.Year, m1 = d1.Month, a1 = d1.Day
    dim as long y2 = d2.Year, m2 = d2.Month, a2 = d2.Day

    dim as boolean d1WasHigh = ( a1 >= 30 )
    if( a1 = 31 ) then a1 = 30
    if( a2 = 31 ) then
        if( d1WasHigh ) then a2 = 30
    end if

    return 360 * ( y2 - y1 ) + 30 * ( m2 - m1 ) + ( a2 - a1 )
end function

'' ISDA 30E/360, the Eurobond basis, 4.16(g).  One rule, applied to both ends
'' independently: a 31 becomes a 30.  THAT is the whole difference from the US
'' basis above -- 30E/360 never consults the other date.
function hFinDays30E360 overload ( byref d1 as LocalDate, byref d2 as LocalDate ) as long
    dim as long y1 = d1.Year, m1 = d1.Month, a1 = d1.Day
    dim as long y2 = d2.Year, m2 = d2.Month, a2 = d2.Day

    if( a1 = 31 ) then a1 = 30
    if( a2 = 31 ) then a2 = 30

    return 360 * ( y2 - y1 ) + 30 * ( m2 - m1 ) + ( a2 - a1 )
end function

public function DayCountDays overload _
    ( _
        byref d1 as LocalDate, byref d2 as LocalDate, byval basis as DayCount _
    ) as long

    if( d1.IsValid = FALSE ) then return 0
    if( d2.IsValid = FALSE ) then return 0

    select case as const basis
    case DAYCOUNT_THIRTY_360_US : return hFinDays30360US( d1, d2 )
    case DAYCOUNT_THIRTY_E_360  : return hFinDays30E360( d1, d2 )
    end select

    return d2.DayNumber - d1.DayNumber
end function

'' Act/Act (ISDA): split the span at each 1 January and sum each year's own
'' fraction, so a leap year contributes over 366 and a common year over 365.
'' At most about a hundred terms for any realistic span, accumulated exactly.
function hFinActActFraction overload ( byref d1 as LocalDate, byref d2 as LocalDate ) as Decimal
    if( d2.DayNumber <= d1.DayNumber ) then
        if( d2.DayNumber = d1.DayNumber ) then return DecimalZero( )
        return -hFinActActFraction( d2, d1 )
    end if

    dim as Decimal acc = DecimalZero( )
    dim as long y = d1.Year
    dim as long yEnd = d2.Year

    while( y <= yEnd )
        dim as LocalDate segStart = d1
        dim as LocalDate segEnd   = d2
        if( y > d1.Year )  then segStart = LocalDate( y, 1, 1 )
        if( y < yEnd )     then segEnd   = LocalDate( y + 1, 1, 1 )

        dim as long days = segEnd.DayNumber - segStart.DayNumber
        if( days <> 0 ) then
            dim as long denom = 365
            if( fb_DtIsLeapYear( y ) <> 0 ) then denom = 366
            acc = acc + ( DecimalFromInt( days ) / DecimalFromInt( denom ) )
        end if

        y += 1
    wend

    return acc
end function

public function DayCountFraction overload _
    ( _
        byref d1 as LocalDate, byref d2 as LocalDate, byval basis as DayCount _
    ) as Decimal

    if( d1.IsValid = FALSE ) then return DecimalZero( )
    if( d2.IsValid = FALSE ) then return DecimalZero( )

    if( basis = DAYCOUNT_ACTUAL_ACTUAL_ISDA ) then
        return hFinActActFraction( d1, d2 )
    end if

    dim as long days = DayCountDays( d1, d2, basis )

    select case as const basis
    case DAYCOUNT_ACTUAL_360
        return DecimalFromInt( days ) / DecimalFromInt( 360 )
    case DAYCOUNT_THIRTY_360_US, DAYCOUNT_THIRTY_E_360
        return DecimalFromInt( days ) / DecimalFromInt( 360 )
    case DAYCOUNT_ACTUAL_365_25
        '' 36525 / 100, not 365.25 parsed -- an integer over an integer, so the
        '' quotient is the terminating expansion and not a text round-trip.
        return ( DecimalFromInt( days ) * DecimalFromInt( 100 ) ) / DecimalFromInt( 36525 )
    end select

    return DecimalFromInt( days ) / DecimalFromInt( 365 )
end function

public function DayCountFractionDouble overload _
    ( _
        byref d1 as LocalDate, byref d2 as LocalDate, byval basis as DayCount _
    ) as double

    return DayCountFraction( d1, d2, basis ).ToDouble( )
end function

'' ===========================================================================
'' The exact growth kernel
'' ===========================================================================

'' EXACT.  ( 1 + i )^n for INTEGER n >= 0, by binary exponentiation with a
'' reduce to FIN_WORK_SCALE after every squaring and every multiply, half-even.
'' That is log2(n) + popcount(n) Decimal multiplies -- about thirteen for a
'' 360-period term, against 360 for the naive loop.
''
'' The accumulator is named 'acc' and not the obvious 'result': a local named
'' 'result' collides with outcome.Result and breaks every instantiation in scope.
public function GrowthFactor overload ( byref ratePerPeriod as Decimal, byval periods as long ) as FinResultDec
    if( hFinRateOk( ratePerPeriod ) = FALSE ) then return FinFailDec( FIN_INVALID_RATE )
    if( periods < 0 ) then return FinFailDec( FIN_INVALID_PERIODS )
    if( periods = 0 ) then return FinOkDec( DecimalOne( ) )

    dim as Decimal acc  = DecimalOne( )
    dim as Decimal factor = DecimalOne( ) + ratePerPeriod
    dim as long    k    = periods

    while( k > 0 )
        if( ( k and 1 ) <> 0 ) then
            acc = hFinCap( acc * factor )
            if( acc.IsValid( ) = FALSE ) then return FinFailDec( FIN_OVERFLOW )
        end if
        k = k shr 1
        if( k > 0 ) then
            factor = hFinCap( factor * factor )
            if( factor.IsValid( ) = FALSE ) then return FinFailDec( FIN_OVERFLOW )
        end if
    wend

    return FinOkDec( acc )
end function

'' EXACT.  One further Decimal division, so it inherits GrowthFactor's bound
'' plus one rounding.
''
'' PRECISION FALLS AWAY FOR A VERY SMALL DISCOUNT FACTOR, and it is a property
'' of the type rather than of this function.  Decimal's scale ceiling is 28
'' DECIMAL PLACES, not 28 significant digits, so a value near 1e-15 has only
'' about thirteen significant digits left below the point:
''
''     g = 1.1^360 = 7.9e14   ->   v = 1.26e-15, ~13 significant digits
''
'' Measured at 1.3e-14 relative.  For anything a loan or an annuity actually
'' does -- v between roughly 0.1 and 1 -- all 28 digits are there and this does
'' not arise.  It bites only at growth factors above about 1e13, which needs a
'' per-period rate and term no real instrument carries.  Stated so that the
'' limit is known rather than discovered.
public function DiscountFactor overload ( byref ratePerPeriod as Decimal, byval periods as long ) as FinResultDec
    dim as FinResultDec g = GrowthFactor( ratePerPeriod, periods )
    if( g.IsOk( ) = FALSE ) then return g
    if( g.Value( ).IsZero( ) ) then return FinFailDec( FIN_DOMAIN )

    dim as Decimal v = DecimalOne( ) / g.Value( )
    if( v.IsValid( ) = FALSE ) then return FinFailDec( FIN_OVERFLOW )
    return FinOkDec( v )
end function

'' DOUBLE KERNEL.  Fractional or negative period counts, via
'' Expm1( n * Log1p( i ) ) rather than ( 1 + i )^n -- the same value, computed
'' the way that does not lose the leading digits when i is small.
public function GrowthFactorFractional overload ( byref ratePerPeriod as Decimal, byval periods as double ) as FinResultDec
    if( hFinRateOk( ratePerPeriod ) = FALSE ) then return FinFailDec( FIN_INVALID_RATE )

    dim as double g = Pow( 1.0 + ratePerPeriod.ToDouble( ), periods )

    dim as Decimal d = hFinFromDouble( g )
    if( d.IsValid( ) = FALSE ) then return FinFailDec( FIN_OVERFLOW )
    return FinOkDec( d )
end function

'' DOUBLE KERNEL.  exp( r * t ).
public function GrowthFactorContinuous overload ( byref continuousRate as Decimal, byval years as double ) as FinResultDec
    if( continuousRate.IsValid( ) = FALSE ) then return FinFailDec( FIN_INVALID_RATE )

    dim as double g = exp( continuousRate.ToDouble( ) * years )

    dim as Decimal d = hFinFromDouble( g )
    if( d.IsValid( ) = FALSE ) then return FinFailDec( FIN_OVERFLOW )
    return FinOkDec( d )
end function

'' ===========================================================================
'' Simple interest
'' ===========================================================================

'' EXACT.  Two Decimal multiplies.  Plain value, not Result: it is total over
'' its domain, and an Invalid operand propagates as Invalid the way every
'' Decimal expression does.
public function SimpleInterest overload _
    ( _
        byref principal as Decimal, byref annualRate as Decimal, _
        byref yearFraction as Decimal _
    ) as Decimal

    return principal * annualRate * yearFraction
end function

public function SimpleInterestBetween overload _
    ( _
        byref principal as Decimal, byref annualRate as Decimal, _
        byref d1 as LocalDate, byref d2 as LocalDate, byval basis as DayCount _
    ) as Decimal

    dim as Decimal yf = DayCountFraction( d1, d2, basis )
    return SimpleInterest( principal, annualRate, yf )
end function

'' ===========================================================================
'' Rate conversions
'' ===========================================================================

'' EXACT.  rate / periodsPerYear.
''   COMPOUND_SIMPLE     -> the rate unchanged; simple interest has no per-period
''                          compounding to divide into
''   COMPOUND_CONTINUOUS -> FIN_INVALID_BASIS; there is no "per period"
public function RatePerPeriod overload ( byref nominalAnnual as Decimal, byval c as Compounding ) as FinResultDec
    if( nominalAnnual.IsValid( ) = FALSE ) then return FinFailDec( FIN_INVALID_RATE )
    if( c = COMPOUND_CONTINUOUS ) then return FinFailDec( FIN_INVALID_BASIS )
    if( c = COMPOUND_SIMPLE ) then return FinOkDec( nominalAnnual )
    if( clng( c ) < 1 ) then return FinFailDec( FIN_INVALID_BASIS )

    dim as Decimal i = nominalAnnual / DecimalFromInt( clng( c ) )
    if( i.IsValid( ) = FALSE ) then return FinFailDec( FIN_OVERFLOW )
    return FinOkDec( i )
end function

'' EXACT for an integer m: ( 1 + j/m )^m - 1, through GrowthFactor.
'' COMPOUND_CONTINUOUS is the one DOUBLE KERNEL branch, exp( j ) - 1.
public function RateEffectiveFromNominal overload ( byref nominalAnnual as Decimal, byval c as Compounding ) as FinResultDec
    if( nominalAnnual.IsValid( ) = FALSE ) then return FinFailDec( FIN_INVALID_RATE )

    if( c = COMPOUND_CONTINUOUS ) then
        dim as Decimal d = hFinFromDouble( Expm1( nominalAnnual.ToDouble( ) ) )
        if( d.IsValid( ) = FALSE ) then return FinFailDec( FIN_OVERFLOW )
        return FinOkDec( d )
    end if

    '' Simple interest quoted annually IS its own effective annual rate.
    if( c = COMPOUND_SIMPLE ) then return FinOkDec( nominalAnnual )
    if( clng( c ) < 1 ) then return FinFailDec( FIN_INVALID_BASIS )

    dim as FinResultDec per = RatePerPeriod( nominalAnnual, c )
    if( per.IsOk( ) = FALSE ) then return per

    dim as FinResultDec g = GrowthFactor( per.Value( ), clng( c ) )
    if( g.IsOk( ) = FALSE ) then return g

    return FinOkDec( g.Value( ) - DecimalOne( ) )
end function

'' DOUBLE KERNEL.  m * ( (1+e)^(1/m) - 1 ), computed as
'' m * Expm1( Log1p( e ) / m ).
public function RateNominalFromEffective overload ( byref effectiveAnnual as Decimal, byval c as Compounding ) as FinResultDec
    if( hFinRateOk( effectiveAnnual ) = FALSE ) then return FinFailDec( FIN_INVALID_RATE )

    if( c = COMPOUND_CONTINUOUS ) then
        dim as Decimal d = hFinFromDouble( Log1p( effectiveAnnual.ToDouble( ) ) )
        if( d.IsValid( ) = FALSE ) then return FinFailDec( FIN_OVERFLOW )
        return FinOkDec( d )
    end if

    if( c = COMPOUND_SIMPLE ) then return FinOkDec( effectiveAnnual )
    if( clng( c ) < 1 ) then return FinFailDec( FIN_INVALID_BASIS )

    '' Annual compounding is the identity, and it is EXACT -- taking the double
    '' path for m = 1 would round a rate the caller handed us verbatim.
    if( clng( c ) = 1 ) then return FinOkDec( effectiveAnnual )

    dim as double m = cdbl( clng( c ) )
    dim as double j = m * Expm1( Log1p( effectiveAnnual.ToDouble( ) ) / m )

    dim as Decimal d = hFinFromDouble( j )
    if( d.IsValid( ) = FALSE ) then return FinFailDec( FIN_OVERFLOW )
    return FinOkDec( d )
end function

'' Through the effective annual rate, which is the only common ground the two
'' quotations have.  EXACT when both legs are exact; otherwise DOUBLE KERNEL.
public function RateConvertCompounding overload _
    ( _
        byref nominalAnnual as Decimal, byval fromC as Compounding, _
        byval toC as Compounding _
    ) as FinResultDec

    if( fromC = toC ) then
        if( nominalAnnual.IsValid( ) = FALSE ) then return FinFailDec( FIN_INVALID_RATE )
        return FinOkDec( nominalAnnual )
    end if

    dim as FinResultDec eff = RateEffectiveFromNominal( nominalAnnual, fromC )
    if( eff.IsOk( ) = FALSE ) then return eff

    return RateNominalFromEffective( eff.Value( ), toC )
end function

'' DOUBLE KERNEL.  ln( 1 + e ), through Log1p.
public function RateContinuousFromEffective overload ( byref effectiveAnnual as Decimal ) as FinResultDec
    return RateNominalFromEffective( effectiveAnnual, COMPOUND_CONTINUOUS )
end function

'' DOUBLE KERNEL.  exp( r ) - 1, through Expm1.
public function RateEffectiveFromContinuous overload ( byref continuous as Decimal ) as FinResultDec
    return RateEffectiveFromNominal( continuous, COMPOUND_CONTINUOUS )
end function

'' ===========================================================================
'' THE FUNNEL
''
'' Every loan function in finloan.tiko goes through this one.  Given a nominal
'' annual rate quoted at compounding frequency m, and payments made p times a
'' year, the rate per payment is
''
''     i = ( 1 + j/m ) ^ ( m/p ) - 1
''
'' and there are exactly three cases:
''
''     m = p                 EXACT.  i = j/m, one division.       <- US mortgage
''     m/p a whole number    EXACT, through GrowthFactor.
''     m/p fractional        DOUBLE KERNEL.                       <- CA mortgage
''                           m = 2, p = 12, so m/p = 1/6:
''                           ( 1 + j/2 )^(1/6) - 1
''
'' FOR THE ACCELERATED FREQUENCIES this returns the rate for the UNDERLYING
'' MONTHLY period, because that is what the accelerated product is defined
'' against -- the payment is the monthly one divided by two or by four.
'' finloan.tiko is where it is then split and re-accrued.  Said
'' here because returning a monthly rate from a call given a biweekly frequency
'' is otherwise a surprise.
'' ===========================================================================

public function RatePerPaymentFromNominal overload _
    ( _
        byref nominalAnnual as Decimal, byval compoundC as Compounding, _
        byval payF as PaymentFrequency _
    ) as FinResultDec

    if( nominalAnnual.IsValid( ) = FALSE ) then return FinFailDec( FIN_INVALID_RATE )

    dim as long p = hFinPayPeriods( payF )
    if( p < 1 ) then return FinFailDec( FIN_INVALID_BASIS )

    '' Simple interest: no compounding, so the period rate is a plain division.
    if( compoundC = COMPOUND_SIMPLE ) then
        dim as Decimal i = nominalAnnual / DecimalFromInt( p )
        if( i.IsValid( ) = FALSE ) then return FinFailDec( FIN_OVERFLOW )
        return FinOkDec( i )
    end if

    '' Continuous: exp( j/p ) - 1.
    if( compoundC = COMPOUND_CONTINUOUS ) then
        dim as Decimal d = hFinFromDouble( Expm1( nominalAnnual.ToDouble( ) / cdbl( p ) ) )
        if( d.IsValid( ) = FALSE ) then return FinFailDec( FIN_OVERFLOW )
        return FinOkDec( d )
    end if

    dim as long m = clng( compoundC )
    if( m < 1 ) then return FinFailDec( FIN_INVALID_BASIS )

    dim as FinResultDec per = RatePerPeriod( nominalAnnual, compoundC )
    if( per.IsOk( ) = FALSE ) then return per

    '' CASE 1 -- the US mortgage.  Exact, and returned without touching a double.
    if( m = p ) then return per

    '' CASE 2 -- m/p a whole number.  Exact, through the integer kernel.
    if( ( m mod p ) = 0 ) then
        dim as FinResultDec g = GrowthFactor( per.Value( ), m \ p )
        if( g.IsOk( ) = FALSE ) then return g
        return FinOkDec( g.Value( ) - DecimalOne( ) )
    end if

    '' CASE 3 -- the Canadian mortgage.  ( 1 + j/m )^(m/p) - 1, once, here.
    if( hFinRateOk( per.Value( ) ) = FALSE ) then return FinFailDec( FIN_INVALID_RATE )

    dim as double expo = cdbl( m ) / cdbl( p )
    dim as double i    = Expm1( expo * Log1p( per.Value( ).ToDouble( ) ) )

    dim as Decimal d = hFinFromDouble( i )
    if( d.IsValid( ) = FALSE ) then return FinFailDec( FIN_OVERFLOW )
    return FinOkDec( d )
end function

