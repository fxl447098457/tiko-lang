#module "testing"
'' std/testing: expect -- the assertions, macros so that each one knows its own file and line
''
''     testing.ExpectEq( strings.Tally( "a,b,c", "," ), 2 )
''
''     util_test.tiko:14: ExpectEq failed
''       strings.Tally( "a,b,c", "," ) = 3
''       2 = 2
''
'' Each macro passes the text of its arguments, __FILE__ and __LINE__ -- the importer's, since an
'' exported macro is expanded where it is used -- to a procedure below. Those are overloaded over
'' longint, ulongint, double, boolean, string and ustring, and over any ptr for pointers: an
'' integer of any width, an enum and a literal reach the integer ones.
''
'' Require and RequireEq leave the test with 'exit sub' when they fail, and Skip always does:
'' a 'test' block is a sub. Used qualified, as std/logs' macros are: testing.Require( p <> 0 ).

#define Expect( c )             ExpectAt_( (c), #c, __FILE__, __LINE__ )
#define ExpectFalse( c )        ExpectFalseAt_( (c), #c, __FILE__, __LINE__ )
#define ExpectEq( a, b )        ExpectEqAt_( (a), (b), #a, #b, __FILE__, __LINE__ )
#define ExpectNe( a, b )        ExpectNeAt_( (a), (b), #a, #b, __FILE__, __LINE__ )
#define ExpectNear( a, b, e )   ExpectNearAt_( (a), (b), (e), #a, #b, __FILE__, __LINE__ )
#define Require( c )            if RequireAt_( (c), #c, __FILE__, __LINE__ ) = false then exit sub
#define RequireEq( a, b )       if RequireEqAt_( (a), (b), #a, #b, __FILE__, __LINE__ ) = false then exit sub
#define Fail( m )               FailAt_( (m), __FILE__, __LINE__ )
#define Skip( why )             SkipAt_( (why) ) : exit sub
#export Expect, ExpectFalse, ExpectEq, ExpectNe, ExpectNear, Require, RequireEq, Fail, Skip

'' What a value looks like in a failure message.
function Show_ overload ( byval v as longint ) as string
    return trim( str( v ) )
end function
function Show_ overload ( byval v as ulongint ) as string
    return trim( str( v ) )
end function
function Show_ overload ( byval v as double ) as string
    return trim( str( v ) )
end function
function Show_ overload ( byval v as boolean ) as string
    return iif( v, "true", "false" )
end function
function Show_ overload ( byref v as const string ) as string
    return chr( 34 ) & v & chr( 34 )
end function
function Show_ overload ( byref v as const ustring ) as string
    dim as string s = v
    return chr( 34 ) & s & chr( 34 )
end function
function Show_ overload ( byval v as any ptr ) as string
    return "&h" & hex( cast( uinteger, v ) )
end function

'' One side of a comparison as written and as it came out -- once, when it was written as the
'' value itself (a literal).
private function Side_( byref t as const string, byref v as const string ) as string
    if trim( t ) = v then return chr( 10 ) & "      " & v
    return chr( 10 ) & "      " & t & " = " & v
end function

'' The two sides of a comparison, one per line.
private function Sides_( byref ta as const string, byref va as const string, _
                         byref tb as const string, byref vb as const string ) as string
    return Side_( ta, va ) & Side_( tb, vb )
end function

function ExpectAt_( byval c as boolean, byref txt as const string, _
                    byref f as const string, byval l as long ) as boolean
    if c then return true
    Failed_( f, l, "Expect failed: " & txt )
    return false
end function

function RequireAt_( byval c as boolean, byref txt as const string, _
                     byref f as const string, byval l as long ) as boolean
    if c then return true
    Failed_( f, l, "Require failed: " & txt & " -- the test stops here" )
    return false
end function

function ExpectFalseAt_( byval c as boolean, byref txt as const string, _
                         byref f as const string, byval l as long ) as boolean
    if c = false then return true
    Failed_( f, l, "ExpectFalse failed: " & txt )
    return false
end function

#macro TKO_TESTING_EQ_( ty, pass_ )
function ExpectEqAt_ overload ( pass_ a as ty, pass_ b as ty, byref ta as const string, _
                                byref tb as const string, byref f as const string, byval l as long ) as boolean
    if a = b then return true
    Failed_( f, l, "ExpectEq failed" & Sides_( ta, Show_( a ), tb, Show_( b ) ) )
    return false
end function
function RequireEqAt_ overload ( pass_ a as ty, pass_ b as ty, byref ta as const string, _
                                 byref tb as const string, byref f as const string, byval l as long ) as boolean
    if a = b then return true
    Failed_( f, l, "RequireEq failed -- the test stops here" & Sides_( ta, Show_( a ), tb, Show_( b ) ) )
    return false
end function
function ExpectNeAt_ overload ( pass_ a as ty, pass_ b as ty, byref ta as const string, _
                                byref tb as const string, byref f as const string, byval l as long ) as boolean
    if a <> b then return true
    Failed_( f, l, "ExpectNe failed: both are " & Show_( a ) & Sides_( ta, Show_( a ), tb, Show_( b ) ) )
    return false
end function
#endmacro

TKO_TESTING_EQ_( longint, byval )
TKO_TESTING_EQ_( ulongint, byval )
TKO_TESTING_EQ_( double, byval )
TKO_TESTING_EQ_( boolean, byval )
TKO_TESTING_EQ_( const string, byref )
TKO_TESTING_EQ_( const ustring, byref )
TKO_TESTING_EQ_( any ptr, byval )

function ExpectNearAt_( byval a as double, byval b as double, byval e as double, _
                        byref ta as const string, byref tb as const string, _
                        byref f as const string, byval l as long ) as boolean
    if abs( a - b ) <= e then return true
    Failed_( f, l, "ExpectNear failed: they differ by " & Show_( abs( a - b ) ) & ", more than " & _
             Show_( e ) & Sides_( ta, Show_( a ), tb, Show_( b ) ) )
    return false
end function

sub FailAt_( byref m as const string, byref f as const string, byval l as long )
    Failed_( f, l, "Fail: " & m )
end sub

sub SkipAt_( byref why as const string )
    Skipped_( why )
end sub
