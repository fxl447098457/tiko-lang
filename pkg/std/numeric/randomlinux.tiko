#module "numeric"
'' std/numeric: randomlinux -- CryptoBytes' Linux half, getrandom( 2 ).  A Darwin
'' build needs a randomdarwin.tiko defining hOsRandomBytes the same way; Darwin has
'' no getrandom (getentropy in calls of at most 256 bytes, or arc4random_buf).
''
'' getrandom MAY RETURN FEWER BYTES, OR FAIL, and neither is the end: a request over
'' 256 bytes can be cut short by a signal, and a kernel before 3.17 or a seccomp
'' sandbox answers ENOSYS/EPERM.  The rest is read from /dev/urandom, and only when
'' that fails too is the answer FALSE -- which callers must not turn into zeros.

#if defined( __FB_LINUX__ ) or defined( __FB_ANDROID__ )

extern "c"
    declare function c_getrandom alias "getrandom" ( byval as any ptr, byval as uinteger, byval as ulong ) as integer
    declare function c_open alias "open" ( byval path as const zstring ptr, byval flags as long, ... ) as long
    declare function c_read alias "read" ( byval fd as long, byval buf as any ptr, byval n as uinteger ) as integer
    declare function c_close alias "close" ( byval fd as long ) as long
end extern

const TKN_O_CLOEXEC = &h80000           '' O_RDONLY is 0; the same on x86-64 and arm64

'' No GRND_ flag: it blocks only until the kernel's pool is first seeded.
private function hOsRandomBytes( byval dst as any ptr, byval nbytes as ulong ) as boolean
    dim as ubyte ptr p = dst
    dim as uinteger left_ = nbytes
    while( left_ > 0 )
        dim as integer got = c_getrandom( p, left_, 0 )
        if( got <= 0 ) then exit while
        p += got
        left_ -= got
    wend
    if( left_ = 0 ) then return true
    dim as long fd = c_open( "/dev/urandom", TKN_O_CLOEXEC )
    if( fd < 0 ) then return false
    while( left_ > 0 )
        dim as integer got = c_read( fd, p, left_ )
        if( got <= 0 ) then exit while
        p += got
        left_ -= got
    wend
    c_close( fd )
    return ( left_ = 0 )
end function

#endif
