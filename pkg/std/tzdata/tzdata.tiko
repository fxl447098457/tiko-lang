#module "tzdata"
#import "std/tz"
'' std/tzdata -- the IANA time zone database, inside the program.
''
''     #import "std/tz"
''     #import "std/tzdata"          '' nothing to call: importing it is enough
''
''     print tz.TimeZone.FindById( "Europe/Paris" ).Id
''
'' std/tz finds zones in $TZDIR and, on Linux and macOS, in /usr/share/zoneinfo.
'' Windows has neither, so a program that names zones there imports this module;
'' anywhere else it is the fallback for a machine whose zone files are missing.
'' It costs about 250 KB in the executable, which is why it is a module of its own:
'' a program that names no zones does not carry it.
''
'' WHAT IS INSIDE: tzdata 2026f, as Ubuntu 24.04 builds it -- with backzone, so the
'' pre-1970 history of zones tzdata has merged is kept (Europe/Amsterdam's
'' +00:19:32) -- compiled with zic -b slim. 598 ids, links included. Regenerate it
'' with tools/tzdb/build.sh. The tz database is in the public domain.
''
'' THE SYSTEM'S FILES COME FIRST where there are any, because the operating system
'' keeps them current: this copy is as old as the toolchain. tz.TimeZone.DataVersion
'' says which one a program is reading.

#embed TzdbBytes_ "tzdata.tzdb"

'' Registers the database with std/tz when this module starts.
type TzdataInit_
    as boolean registered           '' false only if a database was registered first
    declare constructor( )
end type

constructor TzdataInit_( )
    this.registered = tz.TimeZone.RegisterDatabase( @TzdbBytes_( 0 ), ubound( TzdbBytes_ ) + 1 )
end constructor

dim shared hTzdataStart as TzdataInit_

'' The tz database release inside this module ("2026f").
public function Version( ) as ustring
    '' the header's own field: "TZDB", a 4-byte format, then a length-prefixed version
    dim as long n = TzdbBytes_( 8 )
    dim as string v = space( n )
    for i as long = 0 to n - 1
        v[i] = TzdbBytes_( 9 + i )
    next
    return v
end function
