#module "logs"
#import "std/numeric"
#import "std/chrono"
#import "std/containers"
#ifdef __FB_UNIX__
#include once "../../sys/posix/posix.ti"
using posix
#endif
using numeric
using chrono
using containers

'' std/chrono's C kernel, which is the runtime's (src/rtlib/dt_core.c) and not chrono's API:
'' the few this module calls, declared here for every file of it.
extern "rtlib"
declare function fb_DtMonoTimestamp alias "fb_DtMonoTimestamp" ( ) as longint
declare function fb_DtMonoFrequency alias "fb_DtMonoFrequency" ( ) as longint
declare function fb_DtTicksFromCounts alias "fb_DtTicksFromCounts" ( byval counts as longint, byval freq as longint ) as longint
declare function fb_DtClockLocalOffsetNow alias "fb_DtClockLocalOffsetNow" ( ) as long
end extern

'' std/logs: logerror -- std/logs' OS plumbing and its error channel
''
''     #import "std/logs"
''
''     sub MyHandler( byref sinkname as ustring, byref reason as ustring, byval oscode as long )
''         '' ... page someone, bump a metric, write to a fallback file
''     end sub
''     logs.SetLogErrorHandler( @MyHandler )
''
'' A LOG CALL CANNOT FAIL, so when a sink cannot write, something else has to
'' say so -- a log file dead since Tuesday that says nothing is the worst
'' failure this module could have. That something is ONE PROCESS-WIDE HANDLER,
'' and every shipped sink reports through it.
''
'' ---------------------------------------------------------------------------
'' WHY THE HANDLER IS A PLAIN `dim shared`
''
'' std/logs is one module, compiled once, so its `dim shared` is the one process-wide variable.
'' As a header (fb/logerror.bi) it could not be: a `dim shared` in a .bi gave every module its
'' own copy. The default LOGGER solved that with FB_LOG_IMPLEMENT (fb/logdefault.bi), which one
'' module expanded. The handler could not: the sinks report through it, so a sink would then have
'' failed to LINK in a program that never expanded the macro -- every program using an explicit
'' FileSink.
''
'' `common shared` was the header's way out. Every module that included it
'' declared the same two variables and the LINKER merged them into one, zero
'' initialised, with no defining module. Measured across two modules on fbc
'' gas64, fbc gcc, win32, linux-x86_64 (gcc 13 and gas64) and tiko. It holds a
'' pointer and a flag, not an object, so nothing needs constructing.
''
'' ---------------------------------------------------------------------------
'' WHY THE OS DECLARATIONS ARE NAMESPACED AND ALIASED
''
'' As a header this could not #include "windows.bi": it would drag the whole Win32
'' surface into every program that logs. It also could not declare GetStdHandle in
'' the global namespace, because a program that includes windows.bi ITSELF would
'' then fail with `error 4: Duplicated definition` -- and most of the programs
'' that want a logger are Win32 programs. Measured, not guessed.
''
'' An earlier version declared them inside `namespace FB` with an ALIAS to the real export.
'' That coexists with windows.bi under gas64 and tiko, but NOT under -gen gcc,
'' where two prototypes for one C symbol conflict -- so the Win32
'' entry points are resolved with dylibsymbol instead (hLogK32, below). The
'' POSIX ones keep their aliases: their C types match crt/unistd.bi's.
''




#ifdef __FB_WIN32__
'' KERNEL32 IS REACHED THROUGH POINTERS, NOT DECLARATIONS.
''
'' An earlier version declared these `extern "windows"` with an alias, and that clashes
'' under -gen gcc -- fbc's default backend on win64. A program that includes
'' windows.bi AND calls WriteFile itself gets TWO C prototypes for one
'' symbol, with different parameter types:
''
''     error: conflicting types for 'WriteFile'
''
'' gas64 and tiko do not mind; gcc does. Resolving the entry points with
'' dylibsymbol emits no prototype at all, so nothing can conflict. Each sink
'' resolves its own table at construction: a header could not hold a
'' process-wide one (see logger.tiko), and LoadLibrary on kernel32 is a
'' reference-count bump.
type hK32GetStdHandle      as function stdcall ( byval as ulong ) as any ptr
type hK32GetFileType       as function stdcall ( byval as any ptr ) as ulong
type hK32GetConsoleMode    as function stdcall ( byval as any ptr, byval as ulong ptr ) as long
type hK32SetConsoleMode    as function stdcall ( byval as any ptr, byval as ulong ) as long
type hK32WriteConsoleW     as function stdcall _
    ( byval as any ptr, byval as any ptr, byval as ulong, byval as ulong ptr, byval as any ptr ) as long
type hK32WriteFile         as function stdcall _
    ( byval as any ptr, byval as any ptr, byval as ulong, byval as ulong ptr, byval as any ptr ) as long
type hK32CreateFileW       as function stdcall _
    ( byval as any ptr, byval as ulong, byval as ulong, byval as any ptr, byval as ulong, byval as ulong, byval as any ptr ) as any ptr
type hK32FlushFileBuffers  as function stdcall ( byval as any ptr ) as long
type hK32CloseHandle       as function stdcall ( byval as any ptr ) as long
type hK32GetLastError      as function stdcall ( ) as ulong

type hLogK32
    lib_                as any ptr
    pGetStdHandle       as hK32GetStdHandle
    pGetFileType        as hK32GetFileType
    pGetConsoleMode     as hK32GetConsoleMode
    pSetConsoleMode     as hK32SetConsoleMode
    pWriteConsoleW      as hK32WriteConsoleW
    pWriteFile          as hK32WriteFile
    pCreateFileW        as hK32CreateFileW
    pFlushFileBuffers   as hK32FlushFileBuffers
    pCloseHandle        as hK32CloseHandle
    pGetLastError       as hK32GetLastError

    declare sub Load( )
    declare sub Unload( )
end type

'' A pointer that did not resolve stays 0, and every caller tests it: a
'' sink with no kernel32 counts drops, it does not crash.
sub hLogK32.Load( )
    this.lib_ = dylibload( "kernel32.dll" )
    if( this.lib_ = nullptr ) then exit sub
    this.pGetStdHandle     = cast( hK32GetStdHandle,     dylibsymbol( this.lib_, "GetStdHandle" ) )
    this.pGetFileType      = cast( hK32GetFileType,      dylibsymbol( this.lib_, "GetFileType" ) )
    this.pGetConsoleMode   = cast( hK32GetConsoleMode,   dylibsymbol( this.lib_, "GetConsoleMode" ) )
    this.pSetConsoleMode   = cast( hK32SetConsoleMode,   dylibsymbol( this.lib_, "SetConsoleMode" ) )
    this.pWriteConsoleW    = cast( hK32WriteConsoleW,    dylibsymbol( this.lib_, "WriteConsoleW" ) )
    this.pWriteFile        = cast( hK32WriteFile,        dylibsymbol( this.lib_, "WriteFile" ) )
    this.pCreateFileW      = cast( hK32CreateFileW,      dylibsymbol( this.lib_, "CreateFileW" ) )
    this.pFlushFileBuffers = cast( hK32FlushFileBuffers, dylibsymbol( this.lib_, "FlushFileBuffers" ) )
    this.pCloseHandle      = cast( hK32CloseHandle,      dylibsymbol( this.lib_, "CloseHandle" ) )
    this.pGetLastError     = cast( hK32GetLastError,     dylibsymbol( this.lib_, "GetLastError" ) )
end sub

sub hLogK32.Unload( )
    if( this.lib_ <> nullptr ) then dylibfree( this.lib_ )
    this.lib_ = nullptr
    this.pGetStdHandle = nullptr : this.pGetFileType = nullptr : this.pGetConsoleMode = nullptr
    this.pSetConsoleMode = nullptr : this.pWriteConsoleW = nullptr : this.pWriteFile = nullptr
    this.pCreateFileW = nullptr : this.pFlushFileBuffers = nullptr : this.pCloseHandle = nullptr
    this.pGetLastError = nullptr
end sub

const FB_LOG_STD_OUTPUT = cast( ulong, -11 )
const FB_LOG_STD_ERROR  = cast( ulong, -12 )
const FB_LOG_FILE_TYPE_CHAR = 2
const FB_LOG_ENABLE_VT      = 4       '' ENABLE_VIRTUAL_TERMINAL_PROCESSING
#elseif defined( __FB_UNIX__ )
extern "rtlib"
    declare function hWriteFd alias "write"  ( byval fd as long, byval b as any ptr, byval n as uinteger ) as integer
    declare function hIsATty  alias "isatty" ( byval fd as long ) as long
    '' FileSink's flush (logfile.tiko), the same C prototype as file.bi's
    '' FileFlush so the two coexist under -gen gcc.
    declare function hFileFlush alias "fb_FileFlush" _
        ( byval filenumber as long = -1, byval systembuffer as long = 0 ) as long
end extern
#else
    #error "std/logs: no console backend for this target"
#endif

'' ============================================================== OnLogError
''
'' The handler's own failures are SWALLOWED -- ERR is
'' restored after it returns -- because the error reporter for the error
'' reporter does not exist.
public type LogErrorHandler as sub( byref sinkname as ustring, byref reason as ustring, byval oscode as long )

'' Mode 0 is "never set": the default handler, a line on stderr. Mode 1 is
'' "set", and a NULL handler then means reporting is OFF -- the supported way to
'' get silence, chosen explicitly, never a default. The counters keep counting.
dim shared hLogErrHandler as any ptr
dim shared hLogErrMode    as long

public declare sub SetLogErrorHandler( byval h as LogErrorHandler )
public declare function GetLogErrorHandler( ) as LogErrorHandler
public declare sub LogDefaultErrorHandler( byref sinkname as ustring, byref reason as ustring, byval oscode as long )

'' DEFINED BEFORE GetLogErrorHandler TAKES ITS ADDRESS, deliberately: tiko's
'' MIR verifier rejects a `declare`d procedure whose address is taken before a
'' `private` definition ("calls X with 3 arguments, which declares 0").
'' fbc does not mind, and the program runs either way.
''
'' The default: one line on stderr,
''
''     fb.logging: FileSink(C:\app\app.log): rotation failed: os=32
''
'' written straight to the OS handle -- not through a ConsoleSink, which could be
'' the sink that is failing. ": os=" is omitted when there is no OS code.
public sub LogDefaultErrorHandler( byref sinkname as ustring, byref reason as ustring, byval oscode as long )
dim as ustring ln = "fb.logging: " + sinkname + ": " + reason
if( oscode <> 0 ) then ln += ": os=" + str( oscode )
ln += !"\n"
dim as string u8 = ln                         '' ustring -> string is UTF-8
#ifdef __FB_WIN32__
    dim k as hLogK32
    k.Load( )
    if( k.pGetStdHandle <> nullptr andalso k.pWriteFile <> nullptr ) then
        dim as any ptr h = k.pGetStdHandle( FB_LOG_STD_ERROR )
        if( h <> nullptr andalso h <> cast( any ptr, -1 ) ) then
            dim as ulong wrote
            k.pWriteFile( h, strptr( u8 ), len( u8 ), @wrote, 0 )
        end if
    end if
    k.Unload( )
#elseif defined( __FB_UNIX__ )
    hWriteFd( STDERR_FILENO, strptr( u8 ), len( u8 ) )
#else
    #error "std/logs: no console backend for this target"
#endif
end sub

'' Configuration-time, like AddSink: a pointer-sized store, not synchronised
'' against a sink reporting at the same moment.
public sub SetLogErrorHandler( byval h as LogErrorHandler )
hLogErrHandler = cast( any ptr, h )
hLogErrMode    = 1
end sub

'' The handler in force. Never set returns the default, so a custom sink can
'' always call the result if it is not null.
public function GetLogErrorHandler( ) as LogErrorHandler
if( hLogErrMode = 0 ) then return @LogDefaultErrorHandler
return cast( LogErrorHandler, hLogErrHandler )
end function


'' What a sink calls, OUTSIDE ITS LOCK: a handler that logs -- and
'' handlers will -- would otherwise re-enter a held mutex and deadlock.
sub hLogReport( byref sinkname as ustring, byref reason as ustring, byval oscode as long )
if( hLogErrMode = 0 ) then
    LogDefaultErrorHandler( sinkname, reason, oscode )
elseif( hLogErrHandler <> nullptr ) then
    dim as long saved = err
    cast( LogErrorHandler, hLogErrHandler )( sinkname, reason, oscode )
    err = saved
end if
end sub

'' Rule 3: AT MOST ONE REPORT PER SINK PER SECOND, the suppressed count carried
'' into the next one. A full disk fails on EVERY record, and an unthrottled
'' handler turns one failure into a second denial of service. It also breaks
'' the loop a handler that logs to the failing sink would otherwise make.
''
'' Called UNDER the sink's lock -- the state is the sink's -- and it decides;
'' the report itself is made after the lock is released.
type hLogThrottle
lastticks  as longint            '' monotonic, of the last report; 0 = none
suppressed as ulongint
declare function Admit( byref reason as ustring ) as boolean
end type

function hLogThrottle.Admit( byref reason as ustring ) as boolean
dim as longint now_ = fb_DtTicksFromCounts( fb_DtMonoTimestamp( ), fb_DtMonoFrequency( ) )
if( this.lastticks <> 0 andalso now_ - this.lastticks < DT_TICKS_PER_SECOND ) then
    this.suppressed += 1
    return FALSE
end if
if( this.suppressed > 0 ) then reason += " (" + str( this.suppressed ) + " similar suppressed)"
this.suppressed = 0
this.lastticks  = now_
return TRUE
end function

