#module "money"
'' Amounts of money, kept in whole cents so that adding them up
'' never drifts.
''
''     #import "shop/money"
''     print money.Format( money.Cents( 1999 ) )

'' An amount of money.
public type Amount
    as int64 cents          '' negative for money owed
end type

'' An amount of 'n' cents.
public declare function Cents( byval n as int64 ) as Amount

'' The amount as text with two decimals: 19.99.
public declare function Format( byref a as Amount ) as ustring

function Cents( byval n as int64 ) as Amount
    dim a as Amount
    a.cents = n
    return a
end function

function Format( byref a as Amount ) as ustring
    var c = abs( a.cents )
    var s = str( c \ 100 ) & "." & right( "0" & str( c mod 100 ), 2 )
    return iif( a.cents < 0, "-" & s, s )
end function
