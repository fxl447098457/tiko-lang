'' Patterns that take a value apart, and guards.
type Point
    as int32 x, y
end type

dim as Point pts(0 to 3)
pts(1).x = 4 : pts(1).y = 4
pts(2).x = 0 : pts(2).y = 9
pts(3).x = -2 : pts(3).y = 5

for i as int32 = 0 to 3
    print match pts(i)
        Point( 0, 0 )          => "origin"
        Point( 0, y )          => "on the y axis at " & y
        Point( x, y ) if x = y => "diagonal at " & x
        Point( x, y ) if x < 0 => "left half"
        else                   => "elsewhere"
    end match
next

'' Two values at once, as a tuple.
for a as int32 = 0 to 1
    for b as int32 = 0 to 1
        print a; b; " -> "; match ( cbool( a = 1 ), cbool( b = 1 ) )
            ( true, true )   => "both"
            ( true, false )  => "first"
            ( false, true )  => "second"
            ( false, false ) => "neither"
        end match
    next
next
