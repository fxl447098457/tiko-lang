'' match compares one value against patterns, and every case must be handled.
enum Suit
    Hearts, Diamonds, Clubs, Spades
end enum

function Colour( byval s as Suit ) as string
    return match s
        Hearts, Diamonds => "red"
        Clubs, Spades    => "black"
    end match
end function

print Colour( Suit.Hearts ), Colour( Suit.Spades )

dim as int32 temps(0 to 4) = { -5, 0, 12, 24, 38 }
for i as int32 = 0 to 4
    match temps(i)
        case is < 0
            print temps(i); " freezing"
        case 0 to 15
            print temps(i); " cold"
        case 16 to 30
            print temps(i); " mild"
        case else
            print temps(i); " hot"
    end match
next
