'' A test that ends the program, and one that never ends.
#import "std/testing"
#import "crashing/ages"

test "parses an age"
    testing.ExpectEq( ages.ParseAge( "42" ), 42 )
end test

test "a bad age"
    testing.ExpectEq( ages.ParseAge( "-1" ), -1 )
end test

test "waits for ever"
    ages.WaitForever( )
end test

test "still runs"
    testing.ExpectEq( ages.ParseAge( "7" ), 7 )
end test
