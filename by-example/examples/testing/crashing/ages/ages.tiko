#module "ages"
'' A parser that ends the program on bad input.

public function ParseAge( byref s as ustring ) as int32
    var n = valint( s )
    if ( n < 0 ) orelse ( n > 150 ) then end 3
    return n
end function

'' Waits for a reply that never comes.
public sub WaitForever( )
    do
        sleep 50, 1
    loop
end sub
