'' The checks std/testing has, and what each does when it fails.
#import "std/testing"

test "values"
    dim as ustring lang = "tiko"
    testing.ExpectEq( len( lang ), 4 )
    testing.ExpectEq( lang, "tiko" )
    testing.ExpectNe( lang, "fbc" )
    testing.ExpectNear( 0.1 + 0.2, 0.3, 1e-9 )
    testing.Expect( lang < "zebra" )
    testing.ExpectFalse( lang = "" )
end test

test "an Expect that fails, and the test goes on"
    testing.ExpectEq( 1 + 1, 3 )
    testing.Fail( "and this is reported too" )
end test

test "a Require that fails ends the test"
    dim as int32 ptr p = 0
    testing.Require( p <> 0 )
    testing.ExpectEq( *p, 1 )             '' never reached
end test

test "skipped"
    testing.Skip( "not written yet" )
end test
