#module "conv"
'' Temperatures between Celsius and Fahrenheit, to one decimal place.

'' v rounded to one decimal place.
function Round1_( byval v as float64 ) as float64
    return int( v * 10 + 0.5 ) / 10
end function

public function ToFahrenheit( byval c as float64 ) as float64
    return Round1_( c * 9 / 5 + 32 )
end function

public function ToCelsius( byval f as float64 ) as float64
    return Round1_( ( f - 32 ) * 5 / 9 )
end function
