'' Black-box: a program of its own that uses conv as any
'' client would.
#import "std/testing"
#import "temps/conv"

test "water freezes and boils"
    testing.ExpectEq( conv.ToFahrenheit( 0 ), 32 )
    testing.ExpectEq( conv.ToFahrenheit( 100 ), 212 )
end test

test "there and back"
    testing.ExpectEq( conv.ToCelsius( conv.ToFahrenheit( 21.5 ) ), 21.5 )
end test
