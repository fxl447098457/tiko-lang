'' Regular expressions from PCRE2, the toolchain's vendor package.
#import "vendor/pcre2"

'' The compiled pattern, or a stop that says what is wrong with it.
function Compile( byref pattern as const string, _
                  byval options as uint32 ) as pcre2_code ptr
    dim errorCode as int32
    dim errorOffset as PCRE2_SIZE
    var re = pcre2_compile( strptr( pattern ), len( pattern ), options, _
                            @errorCode, @errorOffset, nullptr )
    if re = nullptr then
        dim message as zstring * 120
        pcre2_get_error_message( errorCode, cast( PCRE2_UCHAR ptr, @message ), _
                                 sizeof( message ) )
        print "bad pattern at byte " & errorOffset & ": "; message
        end 1
    end if
    return re
end function

'' PCRE2 reads UTF-8 bytes: a ustring assigned to a string becomes them.
dim text as ustring = "Zoë paid 12.50, Łukasz paid 7.25, Ana paid 30.00."
dim subject as string = text

var re = Compile( "(\p{Lu}\w*) paid (\d+)\.(\d\d)", PCRE2_UTF or PCRE2_UCP )
var md = pcre2_match_data_create_from_pattern( re, nullptr )

'' Each match's groups are in the ovector, as byte offsets into subject.
dim start as PCRE2_SIZE = 0
dim options as uint32 = 0
do while pcre2_match( re, strptr( subject ), len( subject ), _
                      start, options, md, nullptr ) > 0
    dim ov as PCRE2_SIZE ptr = pcre2_get_ovector_pointer( md )
    dim who as ustring = mid( subject, ov[2] + 1, ov[3] - ov[2] )
    print who; " "; mid( subject, ov[4] + 1, ov[5] - ov[4] ); _
          " and "; mid( subject, ov[6] + 1, ov[7] - ov[6] ); " cents"; _
          ", from byte "; ov[0]
    '' Where the next attempt starts, and with which options.
    if pcre2_next_match( md, @start, @options ) = 0 then exit do
loop

'' A pattern from outside the program gets a limit on its work.
var slow = Compile( "(a+)+$", 0 )
dim as string many = string( 26, "a" ) & "!"
var mc = pcre2_match_context_create( nullptr )
pcre2_set_match_limit( mc, 100000 )
var rc = pcre2_match( slow, strptr( many ), len( many ), 0, 0, md, mc )
print "(a+)+$: rc " & rc & ", the limit's code is " & PCRE2_ERROR_MATCHLIMIT

pcre2_match_context_free( mc )
pcre2_code_free( slow )
pcre2_match_data_free( md )
pcre2_code_free( re )
