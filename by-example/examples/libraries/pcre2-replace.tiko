'' Search and replace with pcre2_substitute.
#import "vendor/pcre2"

'' subject with every match of pattern replaced by replacement.
function Replace( byref pattern as const string, _
                  byref subject as const string, _
                  byref replacement as const string, _
                  byval extra as uint32 = 0 ) as string
    dim errorCode as int32
    dim errorOffset as PCRE2_SIZE
    var re = pcre2_compile( strptr( pattern ), len( pattern ), PCRE2_UTF, _
                            @errorCode, @errorOffset, nullptr )
    if re = nullptr then return "(bad pattern)"

    '' A size of 0 asks how much room the result needs, its zero included.
    dim options as uint32 = PCRE2_SUBSTITUTE_GLOBAL or _
                            PCRE2_SUBSTITUTE_OVERFLOW_LENGTH or extra
    dim result as string = " "
    dim size as PCRE2_SIZE = 0
    var rc = pcre2_substitute( re, strptr( subject ), len( subject ), 0, _
                 options, nullptr, nullptr, _
                 strptr( replacement ), len( replacement ), _
                 cast( PCRE2_UCHAR ptr, strptr( result ) ), @size )
    if rc = PCRE2_ERROR_NOMEMORY then
        '' Now a buffer that size, and the real thing.
        result = space( size )
        rc = pcre2_substitute( re, strptr( subject ), len( subject ), 0, _
                 options, nullptr, nullptr, _
                 strptr( replacement ), len( replacement ), _
                 cast( PCRE2_UCHAR ptr, strptr( result ) ), @size )
    end if
    pcre2_code_free( re )
    if rc < 0 then
        dim message as zstring * 120
        pcre2_get_error_message( rc, cast( PCRE2_UCHAR ptr, @message ), _
                                 sizeof( message ) )
        return "(" & message & ")"
    end if
    return left( result, size )
end function

dim dates as string = "Due 19/11/2026, paid 3/12/2026."
print Replace( "(\d{1,2})/(\d{1,2})/(\d{4})", dates, "$3-$2-$1" )

dim mail as string = "Mail grace@example.org or ada@example.org."
print Replace( "(\w+)@\w+\.org", mail, "$1@…" )
print Replace( "(\w+)@\w+\.org", mail, "\U$1\E", PCRE2_SUBSTITUTE_EXTENDED )
print Replace( "(\w+)@\w+\.org", mail, "$2" )
