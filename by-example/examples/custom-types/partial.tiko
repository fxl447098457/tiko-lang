'' Two blocks, one type. Each says 'partial', and neither repeats the other.
partial type Point
    x as int32
    y as int32
end type

partial type Point
    declare function Sum( ) as int32
end type

function Point.Sum( ) as int32
    return x + y
end function

dim as Point p = type( 3, 4 )
print p.Sum( )
print sizeof( Point )

'' A class works the same way. One part may name the base.
class Vehicle
    Wheels as int32 = 4
end class

partial class Car
    Doors as int32 = 2
end class

partial class Car
    inherits Vehicle
    declare function Total( ) as int32
end class

function Car.Total( ) as int32
    return Wheels + Doors
end function

dim as Car c
print c.Total( )
