#import "std/tz"
#import "std/tzdata"
#import "std/chrono"
using tz

'' A zone by its IANA name. std/tzdata puts the zone database in the
'' program, so this works on every machine, Windows included.
var ny = TimeZone.FindById( "America/New_York" )
var paris = TimeZone.FindById( "Europe/Paris" )
var tokyo = TimeZone.FindById( "Asia/Tokyo" )

'' A meeting at 09:00 New York time, and the same moment elsewhere.
var nine = chrono.DateTime( 2025, 3, 7, 9, 0, 0, 0 )
var meeting = ZonedDateTime.FromLocal( nine, ny )
print "New York: "; meeting.ToIsoString( )
print "Paris:    "; meeting.WithZoneSameInstant( paris ).ToIsoString( )
var there = meeting.WithZoneSameInstant( tokyo )
print "Tokyo:    "; there.ToString( "ddd HH:mm v" )

'' A week later at the same wall time. The clocks went forward on
'' 9 March, so a week is 167 hours this time.
var nextWeek = meeting.AddCalendarDays( 7 )
var elapsed = nextWeek.ToInstant( ) - meeting.ToInstant( )
print "next week: "; nextWeek.ToIsoString( )
print "hours between: "; elapsed.TotalHours

'' 02:30 on 9 March never happened in New York, and 01:30 on
'' 2 November happened twice. MapLocal counts the instants.
var skipped = chrono.DateTime( 2025, 3, 9, 2, 30, 0, 0 )
var twice = chrono.DateTime( 2025, 11, 2, 1, 30, 0, 0 )
dim as chrono.Instant a, b
print "02:30 on 9 March names"; ny.MapLocal( skipped, a, b ); " instants"
print "01:30 on 2 November names"; ny.MapLocal( twice, a, b ); " instants"
var moved = ZonedDateTime.FromLocal( skipped, ny )
var later = ZonedDateTime.FromLocal( twice, ny, dzLater )
print "the gap moves forward: "; moved.ToIsoString( )
print "the later 01:30:       "; later.ToIsoString( )

'' The text carries the zone, so it reads back to the same value.
var back = ZonedDateTime.ParseIso( nextWeek.ToIsoString( ) )
print "reads back: "; ( back = nextWeek )
