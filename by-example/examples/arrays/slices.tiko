'' a( lo to hi ) is part of an array, in the array's own indices.
'' The span counts from 0, and writing through it writes the array.
dim as int32 temps( 1 to 7 ) = { 12, 15, 11, 18, 21, 19, 14 }

dim as span( of int32 ) midweek = temps( 3 to 5 )
print "midweek:"; len( midweek ); " days, first"; midweek( 0 )
print "bounds"; lbound( midweek ); " to"; ubound( midweek )

midweek( 0 ) = 13                       ' changes temps( 3 )
print "temps( 3 ) is now"; temps( 3 )

'' A span is the parameter for "some of an array".
function Average( byval v as span( of int32 ) ) as double
    dim as double total = 0
    for each t in v
        total += t
    next
    return total / len( v )
end function

print "week average"; Average( temps( 1 to 7 ) )
print "weekend average"; Average( temps( 6 to 7 ) )

'' A span of a span is a smaller view of the same elements.
dim as span( of int32 ) wed_thu = midweek( 1 to 2 )
print "wed, thu:"; wed_thu( 0 ); wed_thu( 1 )

'' An ordinary array procedure takes a span, indexed from 0.
sub Warm( values( ) as int32 )
    for i as int32 = lbound( values ) to ubound( values )
        values( i ) += 1
    next
end sub

Warm( temps( 6 to 7 ) )
print "after Warm:"; temps( 6 ); temps( 7 )
