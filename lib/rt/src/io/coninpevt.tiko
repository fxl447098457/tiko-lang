	_XA( &h0000, &h0000, &h0000, &h0000 ), _XA( &h001B, &h001B, &h001B, &h0100 ), _
	_XA( &h0031, &h0021, &h0000, &h7800 ), _XA( &h0032, &h0040, &h0300, &h7900 ), _
	_XA( &h0033, &h0023, &h0000, &h7A00 ), _XA( &h0034, &h0024, &h0000, &h7B00 ), _
