'' ------------------------------------------------------------- the ring state
''
'' All file-local, all `static` in fbc. The INPUT_RECORDs are kept as raw bytes
'' because the only things done with them are memcpy and WriteConsoleInput.

dim shared as int32      tkort_key_buffer( 0 to KEY_BUFFER_LEN_ - 1 )
dim shared as uinteger  tkort_key_head = 0, tkort_key_tail = 0
dim shared as uint8     tkort_input_events( 0 to (KEY_BUFFER_LEN_ * IR_SIZE_) - 1 )
dim shared as uint32     tkort_key_scratch_pad = 0
dim shared as int32      tkort_key_buffer_changed = 0
dim shared as int32      tkort_control_handler_inited = 0

'' console_has_focus STARTS TRUE. A program that never receives a FOCUS_EVENT --
'' which is every program whose console it did not create -- must report focus,
'' not the absence of it.
dim shared as int32      tkort_console_has_focus = 1

'' FORWARD DECLARATIONS OF THIS FILE'S OWN EXPORTS. The three call each other
'' and are defined below the private helpers that use them, so they are declared
'' first -- and INSIDE an `extern "c"` block, because a bare `declare` at file
'' scope inherits the module's default convention and would take stdcall on
'' win32. That trap has been sprung twice in this repo.
extern "c"   '' NON-FBCALL: these three, whose definitions below say the same.
	declare function tkort_hConsoleInputBufferChanged alias "fb_hConsoleInputBufferChanged" ( ) as int32
	declare function tkort_ConsoleProcessEvents alias "fb_ConsoleProcessEvents" ( ) as int32
	declare function tkort_hConsoleTranslateKey alias "fb_hConsoleTranslateKey" _
		( byval AsciiChar as int8, byval wVsCode as uint16, byval wVkCode as uint16, _
		  byval dwControlKeyState as uint32, byval bEnhancedKeysOnly as int32 ) as int32
end extern

#define KER_AT( i ) ( @tkort_input_events( (i) * IR_SIZE_ + IR_EVENT_ ) )

private sub tkort_hConsolePostKey( byval key as int32, byval pker as uint8 ptr )

	TKORT_IOLOCK()

	tkort_key_buffer( tkort_key_tail ) = key

	'' The record is stored whole, with its EventType stamped, so put-back can
	'' hand it straight back to the console.
	memcpy( KER_AT( tkort_key_tail ), pker, KER_SIZE_ )
	*cptr( uint16 ptr, @tkort_input_events( tkort_key_tail * IR_SIZE_ + IR_EVENTTYPE_ ) ) = KEY_EVENT_

	'' FULL MEANS DROP THE OLDEST -- see the file header.
	if( ((tkort_key_tail + 1) and (KEY_BUFFER_LEN_ - 1)) = tkort_key_head ) then
		tkort_key_head = (tkort_key_head + 1) and (KEY_BUFFER_LEN_ - 1)
	end if
	tkort_key_tail = (tkort_key_tail + 1) and (KEY_BUFFER_LEN_ - 1)

	tkort_key_buffer_changed = 1

	TKORT_IOUNLOCK()
end sub

'' THE PEEK/GET PAIR ARE ONE FUNCTION. `full` decides whether an extended key is
'' returned whole or split into two reads; `allow_remove` decides peek from get.
private function tkort_hConsoleGetKeyEx( byval full as int32, byval allow_remove as int32 ) as int32

	dim as int32 key = -1

	tkort_ConsoleProcessEvents( )

	TKORT_IOLOCK()

	if( tkort_key_head <> tkort_key_tail ) then
		dim as int32 do_remove = allow_remove
		key = tkort_key_buffer( tkort_key_head )
		if( key > 255 ) then
			if( full = 0 ) then
				'' A NARROW READ RETURNS THE MARKER AND LEAVES THE REST. The
				'' buffer slot is REWRITTEN with the high byte and the entry is
				'' NOT removed, so the next call delivers the second half. That
				'' is how INKEY$ produces a two-character string one call at a
				'' time.
				tkort_key_buffer( tkort_key_head ) = (key shr 8)
				key = TKORT_EXT_CHAR_
				do_remove = 0
			end if
		end if
		if( do_remove <> 0 ) then
			tkort_key_head = (tkort_key_head + 1) and (KEY_BUFFER_LEN_ - 1)
			'' A REMOVAL CLEARS THE "changed" FLAG, by calling the reporter for
			'' its side effect and discarding the answer. It also re-enters
			'' ProcessEvents and the I/O lock -- fbc's does too.
			tkort_hConsoleInputBufferChanged( )
		end if
	end if

	TKORT_IOUNLOCK()

	return key
end function

'' ------------------------------------------------------- the key event decoder

private sub tkort_hConsoleProcessKeyEvent( byval event_ as uint8 ptr )

	dim as int32 KeyCode = any
	dim as int32 ValidKeyStatus = any, ValidKeys = any, AddScratchPadKey = 0
	dim as int32 bKeyDown = *cptr( int32 ptr, event_ + KER_KEYDOWN_ )
	dim as uint16 wVkCode = *cptr( uint16 ptr, event_ + KER_VKCODE_ )
	dim as uint16 wVsCode = *cptr( uint16 ptr, event_ + KER_VSCODE_ )
	dim as int8   AsciiChar = *cptr( int8 ptr, event_ + KER_UCHAR_ )
	dim as uint32  ctrl = *cptr( uint32 ptr, event_ + KER_CTRLSTATE_ )

	if( bKeyDown <> 0 ) then
		KeyCode = tkort_hConsoleTranslateKey( AsciiChar, wVsCode, wVkCode, ctrl, 0 )
	else
		KeyCode = -1
	end if

	'' ALT DOWN AND NOTHING ELSE DOWN. Ctrl or Shift alongside ALT disqualifies
	'' the combination entirely.
	dim as int32 no_ctrl_shift = _
		iif( (ctrl and (LEFT_CTRL_PRESSED_ or RIGHT_CTRL_PRESSED_ or SHIFT_PRESSED_)) = 0, 1, 0 )
	dim as int32 alt_down = _
		iif( (ctrl and (LEFT_ALT_PRESSED_ or RIGHT_ALT_PRESSED_)) <> 0, 1, 0 )
	ValidKeyStatus = iif( (no_ctrl_shift <> 0) andalso (alt_down <> 0), 1, 0 )

	'' THE KEYPAD IS IDENTIFIED BY VIRTUAL KEY, NOT SCAN CODE. fbc carries the
	'' scan-code version beside it under `#if 0`; the virtual-key test is the
	'' live one and is the only one reproduced.
	ValidKeys = iif( (wVkCode >= VK_NUMPAD0_) andalso (wVkCode <= VK_NUMPAD9_), 1, 0 )

	if( (ValidKeys <> 0) andalso (ValidKeyStatus <> 0) ) then
		if( bKeyDown <> 0 ) then
			'' NO OVERFLOW CHECK -- see the file header.
			tkort_key_scratch_pad *= 10
			tkort_key_scratch_pad += (wVkCode - VK_NUMPAD0_)
		end if
	elseif( KeyCode <> -1 ) then
		'' Any real keystroke abandons a half-typed Alt+numpad sequence.
		tkort_key_scratch_pad = 0
	elseif( ValidKeyStatus = 0 ) then
		'' ALT CAME UP: flush, if anything was accumulated.
		AddScratchPadKey = iif( tkort_key_scratch_pad <> 0, 1, 0 )
	end if

	if( AddScratchPadKey <> 0 ) then
		'' SYNTHESISE A WHOLE RECORD -- see the file header.
		dim as uint8 rec( 0 to KER_SIZE_ - 1 )
		dim as int8 chAsciiCode = cast( int8, tkort_key_scratch_pad and &hFF )
		dim as int16 wVk = w_VkKeyScanA( chAsciiCode )
		dim as uint32 st = 0

		memset( @rec(0), 0, KER_SIZE_ )
		*cptr( int8 ptr, @rec(KER_UCHAR_) ) = chAsciiCode
		*cptr( uint16 ptr, @rec(KER_VKCODE_) ) = cast( uint16, wVk and &hFF )

		'' VkKeyScan returns the shift state in the SECOND byte: bit 8 shift,
		'' bit 9 ctrl, bit 10 alt.
		if( (wVk and &h100) <> 0 ) then st or= SHIFT_PRESSED_
		if( (wVk and &h200) <> 0 ) then st or= LEFT_CTRL_PRESSED_
		if( (wVk and &h400) <> 0 ) then st or= LEFT_ALT_PRESSED_
		*cptr( uint32 ptr, @rec(KER_CTRLSTATE_) ) = st

		*cptr( uint16 ptr, @rec(KER_VSCODE_) ) = _
			cast( uint16, w_MapVirtualKeyA( *cptr( uint16 ptr, @rec(KER_VKCODE_) ), MAPVK_VK_TO_VSC_ ) )

		tkort_hConsolePostKey( cast( int32, tkort_key_scratch_pad and &hFF ), @rec(0) )
		tkort_key_scratch_pad = 0
	end if

	if( KeyCode <> -1 ) then
		tkort_hConsolePostKey( KeyCode, event_ )
	end if
end sub

'' ---------------------------------------------------------- the ctrl handler

private function tkort_hConsoleHandlerRoutine stdcall ( byval dwCtrlType as uint32 ) as int32

	select case dwCtrlType
	case CTRL_CLOSE_EVENT_, CTRL_LOGOFF_EVENT_, CTRL_SHUTDOWN_EVENT_
		'' A CLOSE BECOMES Alt+F4 IN THE KEY QUEUE -- see the file header.
		dim as uint8 rec( 0 to KER_SIZE_ - 1 )
		memset( @rec(0), 0, KER_SIZE_ )
		*cptr( uint16 ptr, @rec(KER_VKCODE_) ) = VK_F4_
		*cptr( uint32 ptr, @rec(KER_CTRLSTATE_) ) = LEFT_ALT_PRESSED_
		*cptr( uint16 ptr, @rec(KER_VSCODE_) ) = _
			cast( uint16, w_MapVirtualKeyA( VK_F4_, MAPVK_VK_TO_VSC_ ) )
		tkort_hConsolePostKey( KEY_QUIT_, @rec(0) )
		return 1
	end select

	return 0
end function

private sub tkort_hExitControlHandler cdecl ( )
	if( tkort_control_handler_inited <> 0 ) then
		w_SetConsoleCtrlHandler( cast( any ptr, @tkort_hConsoleHandlerRoutine ), 0 )
	end if
end sub

private sub tkort_hInitControlHandler( )
	TKORT_IOLOCK()
	if( tkort_control_handler_inited = 0 ) then
		'' SET BEFORE THE atexit CALL, not after: atexit can fail, and fbc still
		'' considers the handler installed if it does.
		tkort_control_handler_inited = 1
		atexit( @tkort_hExitControlHandler )
		w_SetConsoleCtrlHandler( cast( any ptr, @tkort_hConsoleHandlerRoutine ), 1 )
	end if
	TKORT_IOUNLOCK()
end sub

'' -------------------------------------------------------------- the exports

extern "c"   '' NON-FBCALL: all seven are declared plain in
             '' win32/fb_private_console.h, and the archive agrees -- no @N.

function tkort_hConsoleInputBufferChanged alias "fb_hConsoleInputBufferChanged" ( ) as int32

	dim as int32 result_ = any

	tkort_ConsoleProcessEvents( )

	TKORT_IOLOCK()
	result_ = tkort_key_buffer_changed
	tkort_key_buffer_changed = 0
	TKORT_IOUNLOCK()

	return result_
end function

function tkort_hConsoleGetKey alias "fb_hConsoleGetKey" ( byval full as int32 ) as int32
	return tkort_hConsoleGetKeyEx( full, 1 )
end function

function tkort_hConsolePeekKey alias "fb_hConsolePeekKey" ( byval full as int32 ) as int32
	return tkort_hConsoleGetKeyEx( full, 0 )
end function

sub tkort_hConsolePutBackEvents alias "fb_hConsolePutBackEvents" ( )

	dim as uinteger key_idx = any

	TKORT_IOLOCK()

	'' DRAIN FIRST, so nothing arriving now is left behind the keys about to be
	'' written back. The loop runs until ProcessEvents reports no mouse event --
	'' which is what its return value means, and it is only ever used here.
	while( tkort_ConsoleProcessEvents( ) <> 0 )
	wend

	key_idx = tkort_key_head
	while( key_idx <> tkort_key_tail )
		dim as uint32 dwEventsWritten = 0
		'' AT MOST TWO RUNS, because the ring wraps. The test is against the
		'' TAIL, not the head.
		dim as uinteger count_ = iif( key_idx > tkort_key_tail, _
		                              cast( uinteger, KEY_BUFFER_LEN_ ) - key_idx, _
		                              tkort_key_tail - key_idx )

		w_WriteConsoleInputA( TKORT_IN_HANDLE(), _
		                      @tkort_input_events( key_idx * IR_SIZE_ ), _
		                      cast( uint32, count_ ), @dwEventsWritten )

		key_idx += count_
		if( key_idx = KEY_BUFFER_LEN_ ) then key_idx = 0
	wend

	TKORT_IOUNLOCK()
end sub

function tkort_ConsoleHasFocus alias "fb_ConsoleHasFocus" ( ) as int32
	return tkort_console_has_focus
end function

'' THE RETURN VALUE MEANS "A MOUSE EVENT WAS DISPATCHED", not "an event was
'' read". Only fb_hConsolePutBackEvents looks at it.
function tkort_ConsoleProcessEvents alias "fb_ConsoleProcessEvents" ( ) as int32

	dim as int32 got_event = 0
	dim as uint8 ir( 0 to IR_SIZE_ - 1 )
	dim as uint32 dwRead = any

	tkort_hInitControlHandler( )

	do
		'' PEEK, THEN READ. The peek is what makes the loop terminate without
		'' blocking; the read is what consumes. A failed peek is treated as an
		'' empty queue rather than as an error.
		if( w_PeekConsoleInputA( TKORT_IN_HANDLE(), @ir(0), 1, @dwRead ) = 0 ) then
			dwRead = 0
		end if

		if( dwRead > 0 ) then
			w_ReadConsoleInputA( TKORT_IN_HANDLE(), @ir(0), 1, @dwRead )

			TKORT_IOLOCK()

			select case *cptr( uint16 ptr, @ir(IR_EVENTTYPE_) )
			case KEY_EVENT_
				dim as uint8 ptr ker = @ir(IR_EVENT_)
				dim as int32 down = *cptr( int32 ptr, ker + KER_KEYDOWN_ )
				dim as uint16 rep = *cptr( uint16 ptr, ker + KER_REPEAT_ )

				if( (down <> 0) andalso (rep <> 0) ) then
					'' A REPEAT COUNT POSTS THE KEY THAT MANY TIMES.
					for i as uinteger = 1 to rep
						tkort_hConsoleProcessKeyEvent( ker )
					next
				elseif( down = 0 ) then
					'' A KEY-UP IS PROCESSED ONCE, whatever the count says --
					'' and it must be processed, because that is where the
					'' Alt+numpad flush happens.
					tkort_hConsoleProcessKeyEvent( ker )
				end if

			case MOUSE_EVENT_
				dim as any ptr hook = TKORT_CON_MOUSEHOOK2()
				if( hook <> nullptr ) then
					dim as FnProcessMouseEvent f = cast( FnProcessMouseEvent, hook )
					f( @ir(IR_EVENT_) )
					got_event = 1
				end if

			case FOCUS_EVENT_
				tkort_console_has_focus = *cptr( int32 ptr, @ir(IR_EVENT_) )
			end select

			TKORT_IOUNLOCK()
		end if

	loop while( dwRead <> 0 )

	return got_event
end function

'' Translates an ASCII character, scan code and virtual key code into one
'' QB-compatible key code, or -1 when the key does not translate. See the file
'' header for the rules -- they are not obvious from the control flow.
function tkort_hConsoleTranslateKey alias "fb_hConsoleTranslateKey" _
	( byval AsciiChar as int8, byval wVsCode as uint16, byval wVkCode as uint16, _
	  byval dwControlKeyState as uint32, byval bEnhancedKeysOnly as int32 ) as int32

	dim as int32 KeyCode = 0, AddKeyCode = 0
	dim as int32 is_ext_code = iif( AsciiChar = 0, 1, 0 )

	if( ((dwControlKeyState and ENHANCED_KEY_) <> 0) andalso (is_ext_code <> 0) ) then
		'' THE TWELVE-ROW TABLE, matched on SCAN code.
		for i as integer = 0 to 11
			if( tkort_ext_key_entries(i).scan_code = wVsCode ) then
				dim as TKORT_KEYCODES ptr codes = @tkort_ext_key_entries(i).codes
				if( (dwControlKeyState and (LEFT_ALT_PRESSED_ or RIGHT_ALT_PRESSED_)) <> 0 ) then
					KeyCode = codes->value_alt
					AddKeyCode = iif( KeyCode <> 0, 1, 0 )
				elseif( (dwControlKeyState and (LEFT_CTRL_PRESSED_ or RIGHT_CTRL_PRESSED_)) <> 0 ) then
					KeyCode = codes->value_ctrl
					AddKeyCode = iif( KeyCode <> 0, 1, 0 )
				elseif( (dwControlKeyState and SHIFT_PRESSED_) <> 0 ) then
					KeyCode = codes->value_shift
					AddKeyCode = iif( KeyCode <> 0, 1, 0 )
				else
					'' THE NORMAL COLUMN IS ACCEPTED EVEN WHEN ZERO -- the only
					'' one of the four that is.
					KeyCode = codes->value_normal
					AddKeyCode = 1
				end if
				exit for
			end if
		next
	else
		dim as uint32 uiAsciiChar = cast( uint32, cast( uint8, AsciiChar ) )
		dim as uint32 uiNormalKey = any, uiNormalKeyOtherCase = any

		'' INDEXED BY SCAN CODE, with the bounds test that makes the table's
		'' length part of the contract.
		if( wVsCode < 89 ) then
			dim as TKORT_KEYCODES ptr codes = @tkort_asc_key_codes( wVsCode )

			uiNormalKey = w_MapVirtualKeyA( wVkCode, MAPVK_VK_TO_CHAR_ ) and &hFFFF
			'' THE CRT's isupper/tolower, on an argument that can exceed 255 --
			'' see the file header on why they are not reimplemented.
			if( isupper( cast( int32, uiNormalKey ) ) <> 0 ) then
				uiNormalKeyOtherCase = cast( uint32, tolower( cast( int32, uiNormalKey ) ) )
			elseif( islower( cast( int32, uiNormalKey ) ) <> 0 ) then
				uiNormalKeyOtherCase = cast( uint32, toupper( cast( int32, uiNormalKey ) ) )
			else
				uiNormalKeyOtherCase = uiNormalKey
			end if

			if( (dwControlKeyState and (LEFT_ALT_PRESSED_ or RIGHT_ALT_PRESSED_)) <> 0 ) then
				KeyCode = codes->value_alt
			elseif( (dwControlKeyState and (LEFT_CTRL_PRESSED_ or RIGHT_CTRL_PRESSED_)) <> 0 ) then
				KeyCode = codes->value_ctrl
			elseif( (dwControlKeyState and SHIFT_PRESSED_) <> 0 ) then
				KeyCode = codes->value_shift
			else
				if( uiAsciiChar = 0 ) then
					KeyCode = codes->value_normal
				else
					KeyCode = cast( int32, uiNormalKey )
				end if
			end if

			'' ACCEPTED ONLY IF EXTENDED **AND** THE ASCII AGREES WITH THE
			'' LAYOUT. The second half is what lets AltGr combinations through
			'' untranslated -- see the file header.
			dim as int32 is_ext = iif( KeyCode > 255, 1, 0 )
			dim as int32 agrees = iif( (uiAsciiChar = uiNormalKey) orelse _
			                          (uiAsciiChar = uiNormalKeyOtherCase), 1, 0 )
			AddKeyCode = iif( (is_ext <> 0) andalso (agrees <> 0), 1, 0 )
		end if

		if( (AddKeyCode = 0) andalso (bEnhancedKeysOnly = 0) ) then
			if( is_ext_code = 0 ) then
				'' A plain character is simply itself.
				KeyCode = cast( int32, uiAsciiChar )
				AddKeyCode = 1
			end if
		end if
	end if

	if( AddKeyCode <> 0 ) then
		'' RE-ENCODED, not returned as the table holds it: the high byte moves
		'' back up and FB_EXT_CHAR goes in the low byte.
		'' The high byte is MASKED TO EIGHT BITS on the way back up --
		'' FB_MAKE_EXT_KEY casts through `unsigned char`. Nothing here can
		'' currently exceed 0xFFFF, so the mask changes no reachable value;
		'' it is written because the contract is the macro, not the range.
		if( KeyCode > 255 ) then
			KeyCode = (((KeyCode shr 8) and &hFF) shl 8) or TKORT_EXT_CHAR_
		end if
		return KeyCode
	end if

	return -1
end function

end extern

#else

'' ============================================================= POSIX
''
'' NINE LINES IN fbc, AND THIS IS ALL OF THEM. On a terminal there is no event
'' queue to inspect: "did the input buffer change" is answered by "is there a
'' key waiting", which is fb_KeyHit -- and that goes through the INKEY hook, so
'' a program that installed one gets its own answer here too.

extern "rtlib"
	declare function tkrt_KeyHit2 alias "fb_KeyHit" ( ) as int32
end extern

extern "c"   '' NON-FBCALL: declared plain in fb_private_console.h.

function tkort_hConsoleInputBufferChanged alias "fb_hConsoleInputBufferChanged" ( ) as int32
	return tkrt_KeyHit2( )
end function

end extern

#endif
