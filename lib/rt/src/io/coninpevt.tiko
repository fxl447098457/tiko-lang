'' coninpevt.tiko -- the console input event pump and the QB key translation.
'' Seven symbols on Windows, one on POSIX, one fbc member (io_input.o).
''
'' THE POSIX HALF IS NINE LINES AND THE WINDOWS HALF IS FIVE HUNDRED, which is
'' the whole shape of this member: on a terminal the keyboard is a byte stream
'' that somebody else has already decoded, and on Windows it is a queue of
'' INPUT_RECORDs that has to be drained, filtered, counted and translated into
'' the single 8- or 16-bit code QBASIC's INKEY$ promises.
''
'' EVERYTHING HANGS OFF fb_ConsoleProcessEvents. It is called by every reader --
'' INKEY, GETKEY, MULTIKEY, the mouse -- and it drains the console queue in one
'' loop, posting keys into a 512-entry ring and dispatching mouse events to
'' __fb_con.mouseHook. Nothing else reads the console queue, so a key that this
'' function drops is gone.
''
'' THE RING DROPS THE OLDEST, NOT THE NEWEST. On overflow the head advances,
'' which is the opposite of the usual "buffer full, ignore" and is what makes a
'' held-down key eventually show its LAST repeat rather than its first.
''
'' A REPEAT COUNT POSTS THE KEY THAT MANY TIMES. wRepeatCount comes back from
'' the console as a single record standing for N presses; the loop expands it.
'' A key-UP event is processed exactly once regardless of the count, and that
'' asymmetry is deliberate -- see fb_hConsoleProcessKeyEvent.
''
'' THE ALT+NUMPAD SCRATCH PAD IS A STATE MACHINE ACROSS EVENTS. Holding ALT and
'' typing digits on the numeric keypad accumulates a decimal number; releasing
'' ALT posts that number as a character. So the digits themselves must NOT be
'' posted, the accumulator must survive between events, and the flush happens on
'' the event where ALT is no longer down. THE ACCUMULATOR NEVER OVERFLOW-CHECKS
'' -- `key_scratch_pad = key_scratch_pad * 10 + n` on an unsigned, then masked
'' to 8 bits at the end. Reproduced, because the mask makes the wrap harmless
'' and a "fix" would change which character a long digit run produces.
''
'' AND THE FLUSHED KEY IS SYNTHESISED, NOT REPLAYED. A whole KEY_EVENT_RECORD is
'' built by hand -- VkKeyScan to get the virtual key and its shift state,
'' MapVirtualKey to get a scan code -- so that fb_hConsolePutBackEvents can hand
'' it back to the console later as if the user had typed it.
''
'' PUT-BACK EXISTS FOR SHELL AND END. Keys the runtime has buffered but not
'' consumed are written back into the console's own input queue so the next
'' program sees them. THE COPY IS DONE IN AT MOST TWO RUNS because the ring
'' wraps, and the run length is computed as `(idx > tail) ? LEN - idx : tail -
'' idx`, which is a comparison against the TAIL and not against the head.
''
'' THE CTRL HANDLER TURNS A CLOSE INTO A KEYSTROKE. Alt+F4, logoff and shutdown
'' all post KEY_QUIT (0x6BFF) rather than terminating, which is what lets a
'' program notice the close in its own INKEY loop. It is installed lazily on the
'' first ProcessEvents call and removed by an atexit handler.
''
'' ---------------------------------------------------------------------------
''
'' fb_hConsoleTranslateKey IS THE KEYBOARD MODEL, and it is worth reading the
'' rules rather than the code:
''
''   AN ENHANCED KEY WITH NO ASCII goes through the twelve-row extended table,
''   matched on SCAN code, and picks one of four columns by modifier. A zero in
''   the chosen column means "no key" -- except for the normal column, where
''   zero is still posted.
''
''   EVERYTHING ELSE goes through the 89-row table indexed BY SCAN CODE, and the
''   result is only accepted when it is above 255 (i.e. really an extended key)
''   AND the ASCII the console gave matches what MapVirtualKey says the key
''   produces, in either case. That second test is what lets AltGr combinations
''   through untranslated: on a German keyboard AltGr+Q is '@', and the ALT
''   column would otherwise steal it.
''
''   FAILING BOTH, a non-zero ASCII character is simply itself.
''
''   AND AN EXTENDED RESULT IS RE-ENCODED as (high byte << 8) | 255 -- the
''   FB_EXT_CHAR marker -- which is NOT the same as the value the table holds.
''
'' isupper/tolower ARE THE CRT's, called rather than reimplemented. The argument
'' is `MapVirtualKey( vk, 2 ) & 0xFFFF`, which can exceed 255, and what the CRT
'' does with an out-of-range int is exactly what fbc's C does with it. Writing
'' an ASCII-only version here would be a different function on precisely the
'' inputs that are hard to reason about.
''
'' THE TWO TABLES WERE GENERATED, NOT TRANSCRIBED: a script read the 12-row and
'' 89-row initialisers out of fbc's source and emitted the FreeBASIC below. That
'' is 416 hex constants, which is well past the count where one wrong digit
'' survives every test that exists.

#include once "inc/descriptors.ti"
#include once "inc/console.ti"
#include once "inc/iolock.ti"
#include once "inc/sysbind.ti"

#ifdef __FB_WIN32__

'' ============================================================= WIN32

const KEY_BUFFER_LEN_ = 512

'' FB_EXT_CHAR is (char)255, and FB_MAKE_EXT_KEY( ch ) is (ch << 8) | 255.
'' KEY_QUIT is FB_MAKE_EXT_KEY( 'k' ) -- 'k' is 0x6B, so 0x6BFF.
const TKORT_EXT_CHAR_ = 255
const KEY_QUIT_       = &h6BFF

'' MEASURED by a clang probe against the mingw-w64 headers, target
'' x86_64-w64-windows-gnu. INPUT_RECORD holds no pointers, so the layout is the
'' same on win32 -- CONFIRMED from fbc's own win32 io_input.o, whose .bss is
'' 0x3040 = 12352 bytes: key_buffer[512] longs is 2048 and input_events[512]
'' leaves 10240, i.e. 20 bytes per record, with 64 bytes of alignment slack for
'' the five scalars. Its .rdata is 0x360 = 864, which is the 12-row table at 10
'' bytes plus the 89-row table at 8 -- 832 -- and 32 of padding. That is where
'' the row counts below are confirmed from as well.
''
''   INPUT_RECORD              sizeof 20   EventType 0   Event 4
''   KEY_EVENT_RECORD          sizeof 16
''     bKeyDown           0    wRepeatCount       4
''     wVirtualKeyCode    6    wVirtualScanCode   8
''     uChar             10    dwControlKeyState 12
''   FOCUS_EVENT_RECORD.bSetFocus   0
const IR_SIZE_        = 20
const IR_EVENTTYPE_   = 0
const IR_EVENT_       = 4

const KER_SIZE_       = 16
const KER_KEYDOWN_    = 0
const KER_REPEAT_     = 4
const KER_VKCODE_     = 6
const KER_VSCODE_     = 8
const KER_UCHAR_      = 10
const KER_CTRLSTATE_  = 12

'' MEASURED by the same probe.
const KEY_EVENT_    = 1
const MOUSE_EVENT_  = 2
const FOCUS_EVENT_  = 16

const RIGHT_ALT_PRESSED_  = &h0001
const LEFT_ALT_PRESSED_   = &h0002
const RIGHT_CTRL_PRESSED_ = &h0004
const LEFT_CTRL_PRESSED_  = &h0008
const SHIFT_PRESSED_      = &h0010
const ENHANCED_KEY_       = &h0100

const CTRL_CLOSE_EVENT_    = 2
const CTRL_LOGOFF_EVENT_   = 5
const CTRL_SHUTDOWN_EVENT_ = 6

const VK_F4_      = &h73
const VK_NUMPAD0_ = &h60
const VK_NUMPAD9_ = &h69

'' MapVirtualKey translation types: 0 is VK -> scan code, 2 is VK -> character.
const MAPVK_VK_TO_VSC_  = 0
const MAPVK_VK_TO_CHAR_ = 2

'' __fb_con.mouseHook, spelled locally in the same style src/io/coninput.tiko
'' uses. inc/console.ti documents the offset -- 72 on win64, 48 on win32.
#if defined( __FB_64BIT__ )
	const TKORT_CON_MOUSEHOOK_OFF2 = 72
#else
	const TKORT_CON_MOUSEHOOK_OFF2 = 48
#endif

#define TKORT_CON_MOUSEHOOK2() (*cptr( any ptr ptr, @__fb_con + TKORT_CON_MOUSEHOOK_OFF2 ))

type FnProcessMouseEvent as sub cdecl ( byval ev as any ptr )

extern "c"   '' NON-FBCALL: kernel32 imports, not rtlib entry points.
	declare function w_PeekConsoleInputA stdcall alias "PeekConsoleInputA" _
		( byval h as any ptr, byval buf as any ptr, byval n as uint32, byval got as uint32 ptr ) as int32
	declare function w_ReadConsoleInputA stdcall alias "ReadConsoleInputA" _
		( byval h as any ptr, byval buf as any ptr, byval n as uint32, byval got as uint32 ptr ) as int32
	declare function w_WriteConsoleInputA stdcall alias "WriteConsoleInputA" _
		( byval h as any ptr, byval buf as any ptr, byval n as uint32, byval wrote as uint32 ptr ) as int32
	declare function w_SetConsoleCtrlHandler stdcall alias "SetConsoleCtrlHandler" _
		( byval handler as any ptr, byval add_ as int32 ) as int32
	declare function w_MapVirtualKeyA stdcall alias "MapVirtualKeyA" _
		( byval code_ as uint32, byval maptype as uint32 ) as uint32
	declare function w_VkKeyScanA stdcall alias "VkKeyScanA" ( byval ch as int8 ) as int16
end extern

'' ------------------------------------------------------------- the two tables
''
'' GENERATED FROM fbc's SOURCE -- see the file header. Neither row count is
'' arbitrary: the search over the first stops at its end, and the second is
'' indexed BY SCAN CODE with an explicit bounds test, so a short table silently
'' stops translating the top of the keyboard.

type TKORT_KEYCODES
	as uint16 value_normal
	as uint16 value_shift
	as uint16 value_ctrl
	as uint16 value_alt
end type

type TKORT_KEYLISTENTRY
	as uint16        scan_code
	as TKORT_KEYCODES codes
end type

#define _XE( sc, n, s, c, a ) type<TKORT_KEYLISTENTRY>( sc, type<TKORT_KEYCODES>( n, s, c, a ) )
#define _XA( n, s, c, a )     type<TKORT_KEYCODES>( n, s, c, a )

dim shared as TKORT_KEYLISTENTRY tkort_ext_key_entries( 0 to 11 ) = { _
	_XE( &h001C, &h000D, &h000D, &h000A, &hA600 ), _
	_XE( &h0035, &h002F, &h003F, &h9500, &hA400 ), _
	_XE( &h0047, &h4700, &h4700, &h7700, &h9700 ), _
	_XE( &h0048, &h4800, &h4800, &h8D00, &h9800 ), _
	_XE( &h0049, &h4900, &h4900, &h8400, &h9900 ), _
	_XE( &h004B, &h4B00, &h4B00, &h7300, &h9B00 ), _
	_XE( &h004D, &h4D00, &h4D00, &h7400, &h9D00 ), _
	_XE( &h004F, &h4F00, &h4F00, &h7500, &h9F00 ), _
	_XE( &h0050, &h5000, &h5000, &h9100, &hA000 ), _
	_XE( &h0051, &h5100, &h5100, &h7600, &hA100 ), _
	_XE( &h0052, &h5200, &h5200, &h9200, &hA200 ), _
	_XE( &h0053, &h5300, &h5300, &h9300, &hA300 ) }

