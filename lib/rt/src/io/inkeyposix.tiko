'' inkeyposix.tiko -- INKEY, GETKEY and the POSIX key buffer. Five symbols, one
'' fbc member (unix/io_inkey.o).
''
'' EMPTY-ON: win64 win32
''
'' THE HARD PART IS THAT A KEYPRESS ARRIVES AS A STRING OF BYTES AND THE STRING
'' IS DIFFERENT ON EVERY TERMINAL. HOME might be "\e[1~", "\e[H" or "\eOH"
'' depending on TERM, so nothing can be hard-coded: the escape sequences are
'' looked up in the TERMCAP DATABASE at run time and assembled into a tree.
''
'' THE TREE IS BUILT ONCE, LAZILY, ON THE FIRST ESCAPE BYTE EVER SEEN. A program
'' that never presses a function key never calls tgetstr at all. Each node holds
'' one character, a sibling chain and a child chain, so
''
''     [a1  [a2  [b1  [b2      ->     root -> <[>
''                                             |
''                                            <b>--------<a>
''                                             |          |
''                                            <2>--<1>   <2>--<1>
''
'' and matching walks children while bytes agree and siblings when they do not.
''
'' THE FIRST BYTE IS DROPPED WHEN THE SEQUENCE IS ADDED -- `add_key( root, key
'' + 1, code )`. Every termcap sequence starts with ESC and the reader has
'' already consumed it before consulting the tree, so storing it would make
'' every lookup fail. That single `+ 1` is the whole reason the tree works.
''
'' A MOUSE REPORT IS JUST ANOTHER KEY. "[M" is inserted into the same tree with
'' the synthetic code 0x200, and when it matches, THREE MORE BYTES are read and
'' handed to __fb_con.mouse_update -- which is how src/io/mouseposix.tiko learns
'' anything at all. The function then returns -1, i.e. "no key", because a mouse
'' report is not one.
''
'' AN UNRECOGNISED ESCAPE SEQUENCE SWALLOWS EVERYTHING PENDING. When the walk
'' falls off the tree, the code drains the input with `while getch() >= 0` and
'' returns -1. That is deliberate: a partially-matched sequence would otherwise
'' leave its tail in the buffer to be reported as a run of garbage characters.
''
'' A LONE ESC IS AN ESC. If the byte after the escape is EOF, 27 is returned --
'' which is why pressing Escape works at all, and why it cannot be distinguished
'' from a truncated sequence.
''
'' THE BUFFER IS A 256-ENTRY RING THAT DROPS THE OLDEST. Overflow advances the
'' head, so a held key eventually reports its most recent presses rather than
'' its first -- the same policy as the Windows console queue.
''
'' TWO SUBSTITUTIONS HAPPEN ON THE WAY IN: 0x7F becomes 8, because a terminal's
'' Backspace sends DEL and callers expect BS; and LF becomes CR, so that a
'' terminal sending either line ending is reported as ENTER.
''
'' fb_hGetCh HAS A BUG THAT IS PART OF ITS CONTRACT. It stores get_input's
'' result in `k`, and only OVERWRITES `k` from the buffer if the buffer is
'' non-empty. When get_input returns -1 AND the buffer is empty, -1 is returned
'' -- correct. But when get_input returns a key it is BOTH pushed into the
'' buffer AND (via the buffer read) returned, so the value is right by
'' coincidence rather than by construction. Reproduced exactly.
''
'' fb_ConsoleGetkey LOCKS AND UNLOCKS AROUND EACH ATTEMPT rather than holding
'' the lock, because it BLOCKS: holding FB_LOCK across an indefinite wait would
'' stop every other thread's console I/O. Between attempts it calls fb_Sleep(-1),
'' which yields rather than spinning.
''
'' AND WITH NO CONSOLE, GETKEY IS fgetc(stdin) AND KEYHIT IS feof(stdin). A
'' redirected program still gets sensible behaviour instead of an error.

#include once "inc/descriptors.ti"
#include once "inc/console.ti"
#include once "inc/ctx.ti"
#include once "inc/iolock.ti"
#include once "inc/sysbind.ti"

#ifdef __FB_UNIX__

const KEY_BUFFER_LEN_ = 256

'' A synthetic code that cannot collide with any real key -- see the header.
const KEY_MOUSE_ = &h200

'' FB_MAKE_EXT_KEY( c ) is (c shl 8) or FB_EXT_CHAR, and FB_EXT_CHAR is 255.
#define TKORT_EXTKEY( c ) (((c) shl 8) or 255)

const KEY_BACKSPACE_ = 8
const KEY_TAB_       = 9
const KEY_F1_        = TKORT_EXTKEY( 59 )   '' ';'
const KEY_F2_        = TKORT_EXTKEY( 60 )
const KEY_F3_        = TKORT_EXTKEY( 61 )
const KEY_F4_        = TKORT_EXTKEY( 62 )
const KEY_F5_        = TKORT_EXTKEY( 63 )
const KEY_F6_        = TKORT_EXTKEY( 64 )
const KEY_F7_        = TKORT_EXTKEY( 65 )
const KEY_F8_        = TKORT_EXTKEY( 66 )
const KEY_F9_        = TKORT_EXTKEY( 67 )
const KEY_F10_       = TKORT_EXTKEY( 68 )
const KEY_F11_       = TKORT_EXTKEY( 69 )
const KEY_F12_       = TKORT_EXTKEY( 70 )
const KEY_HOME_      = TKORT_EXTKEY( 71 )   '' 'G'
const KEY_UP_        = TKORT_EXTKEY( 72 )
const KEY_PAGE_UP_   = TKORT_EXTKEY( 73 )
const KEY_LEFT_      = TKORT_EXTKEY( 75 )
const KEY_RIGHT_     = TKORT_EXTKEY( 77 )
const KEY_END_       = TKORT_EXTKEY( 79 )
const KEY_DOWN_      = TKORT_EXTKEY( 80 )
const KEY_PAGE_DOWN_ = TKORT_EXTKEY( 81 )
const KEY_INS_       = TKORT_EXTKEY( 82 )
const KEY_DEL_       = TKORT_EXTKEY( 83 )

'' A node of the escape-sequence tree -- see the file header for its shape.
type TKORT_KEYNODE
	as uint8             key_
	as int16             code_
	as TKORT_KEYNODE ptr next_
	as TKORT_KEYNODE ptr child_
end type

extern "c"   '' NON-FBCALL: termcap.
	declare function c_tgetstr2 alias "tgetstr" _
		( byval id as zstring ptr, byval area as zstring ptr ptr ) as zstring ptr
end extern

extern "c"   '' NON-FBCALL: rtlib internals, declared plain.
	declare function tkrt_hMakeInkeyStr alias "fb_hMakeInkeyStr" ( byval ch as int32 ) as FBSTRING ptr
end extern

extern "rtlib"   '' FBCALL.
	declare sub tkrt_BgLock4 alias "fb_BgLock" ( )
	declare sub tkrt_BgUnlock4 alias "fb_BgUnlock" ( )
	declare sub tkrt_Sleep4 alias "fb_Sleep" ( byval ms as int32 )
end extern

'' The 24 termcap capability ids and the key each stands for. Held as real
'' objects because tgetstr takes a mutable char*.
type TKORT_KEYDATA
	as zstring * 4 cap
	as int32        code_
end type

dim shared as TKORT_KEYDATA tkort_key_data( 0 to 23 )

private sub tkort_init_key_data( )
	dim as integer i = 0
	#macro KD( c, k )
		tkort_key_data(i).cap = c : tkort_key_data(i).code_ = k : i += 1
	#endmacro
	KD( "kb", KEY_BACKSPACE_ )
	KD( "kT", KEY_TAB_ )
	KD( "k1", KEY_F1_ )
	KD( "k2", KEY_F2_ )
	KD( "k3", KEY_F3_ )
	KD( "k4", KEY_F4_ )
	KD( "k5", KEY_F5_ )
	KD( "k6", KEY_F6_ )
	KD( "k7", KEY_F7_ )
	KD( "k8", KEY_F8_ )
	KD( "k9", KEY_F9_ )
	'' "k;" IS F10, not a typo -- termcap ran out of digits.
	KD( "k;", KEY_F10_ )
	'' AND F11/F12 ARE "F1"/"F2", which look like function keys one and two.
	KD( "F1", KEY_F11_ )
	KD( "F2", KEY_F12_ )
	KD( "kh", KEY_HOME_ )
	KD( "ku", KEY_UP_ )
	KD( "kP", KEY_PAGE_UP_ )
	KD( "kl", KEY_LEFT_ )
	KD( "kr", KEY_RIGHT_ )
	KD( "@7", KEY_END_ )
	KD( "kd", KEY_DOWN_ )
	KD( "kN", KEY_PAGE_DOWN_ )
	KD( "kI", KEY_INS_ )
	KD( "kD", KEY_DEL_ )
end sub

'' File-local state.
dim shared as int32 tkort_key_buffer( 0 to KEY_BUFFER_LEN_ - 1 )
dim shared as int32 tkort_key_head = 0, tkort_key_tail = 0
dim shared as int32 tkort_key_buffer_changed = 0
dim shared as TKORT_KEYNODE ptr tkort_root_node = nullptr

'' Inserts one sequence, one character per level. Recursive, as fbc's is.
private sub tkort_add_key _
	( byval node as TKORT_KEYNODE ptr ptr, byval key_ as zstring ptr, byval code_ as int16 )

	dim as TKORT_KEYNODE ptr n = *node
	while( n <> nullptr )
		if( n->key_ = cptr( uint8 ptr, key_ )[0] ) then
			tkort_add_key( @n->child_, cast( zstring ptr, cptr( uint8 ptr, key_ ) + 1 ), code_ )
			exit sub
		end if
		n = n->next_
	wend

	n = cast( TKORT_KEYNODE ptr, malloc( sizeof( TKORT_KEYNODE ) ) )
	if( n = nullptr ) then exit sub
	n->child_ = nullptr
	n->next_ = *node
	n->key_ = cptr( uint8 ptr, key_ )[0]
	n->code_ = 0
	*node = n

	'' THE CODE LANDS ON THE LAST CHARACTER ONLY; every node above it keeps 0,
	'' which is what makes a zero code mean "keep walking".
	if( cptr( uint8 ptr, key_ )[1] <> 0 ) then
		tkort_add_key( @n->child_, cast( zstring ptr, cptr( uint8 ptr, key_ ) + 1 ), code_ )
	else
		n->code_ = code_
	end if
end sub

'' BUILT ON FIRST USE -- see the file header.
private sub tkort_init_keys( )

	tkort_init_key_data( )

	for i as integer = 0 to 23
		dim as zstring ptr key_ = c_tgetstr2( @tkort_key_data(i).cap, nullptr )
		'' A TERMINAL THAT DOES NOT DEFINE A KEY simply has no entry -- the
		'' NULL is skipped rather than treated as an error.
		if( key_ <> nullptr ) then
			'' + 1 DROPS THE LEADING ESC -- see the file header.
			tkort_add_key( @tkort_root_node, _
			               cast( zstring ptr, cptr( uint8 ptr, key_ ) + 1 ), _
			               cast( int16, tkort_key_data(i).code_ ) )
		end if
	next

	'' The mouse report, inserted as if it were a key.
	dim as zstring * 4 m = "[M"
	tkort_add_key( @tkort_root_node, @m, KEY_MOUSE_ )
end sub

'' Reads one key, decoding an escape sequence through the tree.
private function tkort_get_input( ) as int32

	dim as any ptr g = TKORT_CON_P( TKORT_CON_KBGETCH )
	if( g = nullptr ) then return -1
	dim as function cdecl ( ) as int32 getch_ = cast( function cdecl ( ) as int32, g )

	dim as int32 k = getch_( )
	if( k = 27 ) then
		k = getch_( )
		'' A LONE ESC. See the file header on why it is indistinguishable from
		'' a truncated sequence.
		if( k = -1 ) then return 27

		if( tkort_root_node = nullptr ) then tkort_init_keys( )

		dim as TKORT_KEYNODE ptr node = tkort_root_node
		while( node <> nullptr )
			if( k = node->key_ ) then
				if( node->code_ <> 0 ) then
					if( node->code_ = KEY_MOUSE_ ) then
						'' THREE MORE BYTES, straight to the mouse driver.
						dim as int32 cb = getch_( )
						dim as int32 cx = getch_( )
						dim as int32 cy = getch_( )
						dim as any ptr mu = TKORT_CON_P( TKORT_CON_MOUSEUPDATE )
						if( mu <> nullptr ) then
							dim as sub cdecl ( byval a as int32, byval b as int32, byval c as int32 ) fn_ = _
								cast( sub cdecl ( byval a as int32, byval b as int32, byval c as int32 ), mu )
							fn_( cb, cx, cy )
						end if
						'' A MOUSE REPORT IS NOT A KEY.
						return -1
					end if
					return node->code_
				end if
				k = getch_( )
				if( k = -1 ) then return -1
				node = node->child_
				continue while
			end if
			node = node->next_
		wend

		'' FELL OFF THE TREE: drain and ignore -- see the file header.
		while( getch_( ) >= 0 )
		wend

		return -1
	end if

	return k
end function

extern "c"   '' NON-FBCALL: fb_private_console.h declares these plainly.

'' ASSUMES BG_LOCK IS HELD -- it is also called from the background thread, via
'' fb_hTermQuery in src/init/hinitposix.tiko.
sub tkort_hAddCh alias "fb_hAddCh" ( byval k as int32 )

	'' DEL BECOMES BACKSPACE and LF becomes CR -- see the file header.
	if( k = &h7F ) then
		k = 8
	elseif( k = 10 ) then
		k = 13
	end if

	tkort_key_buffer( tkort_key_tail ) = k
	'' FULL MEANS DROP THE OLDEST.
	if( ((tkort_key_tail + 1) and (KEY_BUFFER_LEN_ - 1)) = tkort_key_head ) then
		tkort_key_head = (tkort_key_head + 1) and (KEY_BUFFER_LEN_ - 1)
	end if
	tkort_key_tail = (tkort_key_tail + 1) and (KEY_BUFFER_LEN_ - 1)
	tkort_key_buffer_changed = -1
end sub

'' THE RETURN VALUE IS RIGHT BY COINCIDENCE -- see the file header.
function tkort_hGetCh alias "fb_hGetCh" ( byval remove_ as int32 ) as int32

	dim as int32 k = tkort_get_input( )
	if( k >= 0 ) then
		tkrt_BgLock4( )
		tkort_hAddCh( k )
		tkrt_BgUnlock4( )
	end if

	if( tkort_key_head <> tkort_key_tail ) then
		k = tkort_key_buffer( tkort_key_head )
		if( remove_ <> 0 ) then
			tkort_key_head = (tkort_key_head + 1) and (KEY_BUFFER_LEN_ - 1)
		end if
	end if

	return k
end function

'' The caller is expected to hold FB_LOCK.
function tkort_ConsoleInkey alias "fb_ConsoleInkey" ( ) as FBSTRING ptr

	if( TKORT_CON_L( TKORT_CON_INITED ) = 0 ) then return TKORT_NULLSTR()

	dim as int32 ch = tkort_hGetCh( -1 )
	if( ch >= 0 ) then
		return tkrt_hMakeInkeyStr( ch )
	end if

	return TKORT_NULLSTR()
end function

'' LOCKS PER ATTEMPT, NOT ACROSS THE WAIT -- see the file header.
function tkort_ConsoleGetkey alias "fb_ConsoleGetkey" ( ) as int32

	dim as int32 key_ = any

	do
		TKORT_IOLOCK()

		if( TKORT_CON_L( TKORT_CON_INITED ) = 0 ) then
			TKORT_IOUNLOCK()
			'' NO CONSOLE: plain stdin.
			return fgetc( stdin )
		end if

		key_ = tkort_hGetCh( -1 )

		TKORT_IOUNLOCK()

		if( key_ >= 0 ) then exit do

		'' -1 YIELDS rather than sleeping for a fixed time.
		tkrt_Sleep4( -1 )
	loop

	return key_
end function

'' The caller is expected to hold FB_LOCK.
''
'' IT REPORTS WHETHER THE BUFFER CHANGED, not whether it is non-empty -- and it
'' CLEARS the flag, so two calls in a row give different answers even with a key
'' still waiting.
function tkort_ConsoleKeyHit alias "fb_ConsoleKeyHit" ( ) as int32

	if( TKORT_CON_L( TKORT_CON_INITED ) = 0 ) then
		return iif( feof( stdin ) <> 0, 0, -1 )
	end if

	tkort_hGetCh( 0 )
	dim as int32 result_ = tkort_key_buffer_changed
	tkort_key_buffer_changed = 0
	return result_
end function

end extern

#endif
