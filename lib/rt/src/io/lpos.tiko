'' lpos.tiko -- LPOS, and nothing else. Upstream keeps fb_LPos alone in
'' io_lpos.o, and so does this, for the same reason the printer channel lives
'' in io/fileopenlpt.tiko: fb_LPos is the one console-side entry point that
'' calls into the printer device layer -- fb_DevPrinterGetOffset, in
'' io_devlptopen.o, which walks the open-device list. Left in io_conpage.o it
'' dragged that layer -- and its WINSPOOL.DRV and GDI32.dll imports -- into
'' every program that touches the console, because the console members are
'' loaded by all of them. Measured: the split is what makes a printer-free
'' binary import kernel32 and the CRT only.
''
'' PORTABLE, and one line of work: LPOS asks the printer device for the column
'' it is at. The device name is built from the caller's INDEX -- LPOS(0) is
'' "LPT1:" -- because the statement takes a printer number and the device layer
'' takes a name.
''
'' Under the I/O lock, because fb_DevPrinterGetOffset walks the open-device list.

#include once "inc/iolock.ti"

extern "c"   '' NON-FBCALL: fbc's own printer device, in io_printer.o.
	declare function tkrt_sprintf2 alias "sprintf" _
		( byval buf as zstring ptr, byval fmt as zstring ptr, ... ) as int32
	declare function tkrt_DevPrinterGetOffset alias "fb_DevPrinterGetOffset" ( byval dev as zstring ptr ) as int32
end extern

extern "rtlib"

function tkort_LPos alias "fb_LPos" ( byval printer_index as int32 ) as int32
	dim as zstring * 32 buffer = any
	dim as int32 cur = any

	TKORT_IOLOCK()

	tkrt_sprintf2( @buffer, @"LPT%d:", printer_index + 1 )
	cur = tkrt_DevPrinterGetOffset( @buffer )

	TKORT_IOUNLOCK()

	return cur
end function

end extern
