'' printerwin.tiko -- the WINDOWS printer driver: fb_PrinterOpen,
'' fb_PrinterWrite, fb_PrinterWriteWstr and fb_PrinterClose. Four symbols, one
'' fbc member (win32/io_printer.o).
''
'' EMPTY-ON: linux-x86_64 macos-arm64
''
'' THE POSIX HALF IS src/io/printerposix.tiko AND IS 194 LINES OF popen( "lp" ).
'' This one is 873 lines of spooler enumeration, GDI device contexts and a page
'' emulator, because Windows has no `lp` and no device node -- LPRINT has to be
'' built out of the print subsystem.
''
'' ---------------------------------------------------------------------------
'' THERE ARE TWO COMPLETELY DIFFERENT OUTPUT PATHS, chosen by whether the device
'' string carried an EMULATION suffix, and nothing after the open distinguishes
'' them except which handle is NULL:
''
''   NO EMULATION   OpenPrinter + StartDocPrinter + WritePrinter. Bytes go to
''                  the spooler as datatype "RAW" -- straight to the printer's
''                  own language, no rendering. hPrinter is set, hDc is NULL.
''   EMULATION      CreateDC( "WINSPOOL", name ) + StartDoc, and every character
''                  is DRAWN with TextOut at a computed position. hDc is set,
''                  hPrinter is NULL.
''
'' fb_PrinterWrite TESTS hPrinter TO DECIDE, and fb_PrinterClose tests hDc. Two
'' functions, two different fields, same distinction -- reproduced as written.
''
'' ---------------------------------------------------------------------------
'' LPTn IS MAPPED TO A PRINTER BY BUILDING A LIST, EVERY TIME. There is no
'' cache: each fb_PrinterOpen with a numbered port enumerates every printer on
'' the machine, builds a fresh list, finds one node and frees the rest. The
'' mapping is built in three passes and the ORDER IS THE POLICY:
''
''   1  LOCAL PRINTERS ON LPTx PORTS keep their own port number. A printer's
''      pPortName may be a COMMA-SEPARATED LIST, so it is split, each entry
''      trimmed of leading spaces, and only those starting "LPT" are taken.
''   2  THE DEFAULT PRINTER is mapped to the first free LPT number from 1 --
''      so it lands on LPT1 unless a real local printer already claimed it.
''   3  EVERYTHING ELSE (network printers, PDF writers) is mapped from LPT128
''      upward.
''
'' THE SPLIT WRITES INTO THE ENUMERATION BUFFER. `*pFoundPos = 0` truncates the
'' comma-separated string in place, inside the block EnumPrinters filled. That
'' is safe only because the buffer is this function's own and is freed
'' immediately after -- and it is why the buffer cannot be shared or cached.
''
'' THE DEFAULT PRINTER IS FOUND TWO WAYS. EnumPrinters with PRINTER_ENUM_DEFAULT
'' first; if that returns nothing, winspool.drv is LOADED AT RUNTIME and
'' GetDefaultPrinterA is called through GetProcAddress. The dynamic path exists
'' because GetDefaultPrinter did not exist before Windows 2000 and linking it
'' statically would have made the runtime refuse to start on NT4. Reproduced --
'' a static import would change which systems the runtime loads on.
''
'' AND THAT PATH LEAKS ON ONE BRANCH. When realloc fails, fbc frees the old
'' buffer and then CALLS pfnGetDefaultPrinter AGAIN WITH THE FREED POINTER,
'' because the `if (buffer == NULL) free(oldBuffer);` has no `break` after it.
'' Reproduced exactly: it is unreachable unless the allocation fails, and
'' diverging would be a repair rather than a port.
''
'' ---------------------------------------------------------------------------
'' THE EMULATOR IS A TEXT TERMINAL DRAWN ONTO A PAGE.
''
'' RAW mode places every character individually at (dwCurrentX, dwCurrentY) with
'' TextOut, advances by one font width, wraps at the right edge and ejects the
'' page at the bottom. One GDI call PER CHARACTER, which is slow and is what
'' makes the output positionally exact.
''
'' TTY mode runs the text through fb_ConPrintTTY -- the same teletype layer the
'' console uses -- with hooks that translate cell coordinates into device
'' coordinates. So tabs, carriage returns and line wrapping behave on paper
'' exactly as they do on screen.
''
'' FORMFEED IS HANDLED OUTSIDE THE TTY LAYER. fb_ConPrintTTY does not know about
'' character 12, so TTY mode scans for it, prints up to it, and then calls the
'' SCROLL HOOK with rows = 0 to eject the page. The scroll hook doubles as the
'' page-eject mechanism.
''
'' THE PAGE STARTS LAZILY. EmuPageStart is called before every character and
'' returns immediately once iPageStarted is set, so a document that prints
'' nothing never calls StartPage and produces no blank page.
''
'' THE BOTTOM BORDER USES THE FONT **WIDTH**. fbc computes
''     Border.Bottom = ( dwSizeY - dwFontSizeX + 1 ) / dwFontSizeY
'' -- dwFontSizeX in the numerator where dwFontSizeY belongs. On a monospace
'' font the two are close and the row count comes out near enough; on a
'' proportional one it is simply wrong. Reproduced, because the row count is
'' observable in where the page breaks.
''
'' ---------------------------------------------------------------------------
'' EVERY STRUCT LAYOUT HERE WAS MEASURED with a clang probe targeting
'' x86_64-w64-windows-gnu -- the same triple the archive is built for. The win32
'' values cannot be probed here (no i686 headers), so those structs are declared
'' with their natural field types and FreeBASIC's own layout rules produce them;
'' the asserts below therefore pin win64 exactly and win32 by construction.
'' LOGFONTA and TEXTMETRICA contain no pointers, so they are the same on both.

#include once "inc/descriptors.ti"
#include once "inc/rterror.ti"
#include once "inc/list.ti"
#include once "inc/conhooks.ti"
#include once "inc/sysbind.ti"

#ifdef __FB_WIN32__

const ERROR_INSUFFICIENT_BUFFER_ = 122

const PRINTER_ENUM_DEFAULT_     = 1
const PRINTER_ENUM_LOCAL_       = 2
const PRINTER_ENUM_CONNECTIONS_ = 4

'' GetDeviceCaps indices -- MEASURED.
const PHYSICALWIDTH_   = 110
const PHYSICALHEIGHT_  = 111
const HORZRES_         = 8
const VERTRES_         = 10
const PHYSICALOFFSETX_ = 112
const PHYSICALOFFSETY_ = 113
const LOGPIXELSX_      = 88
const LOGPIXELSY_      = 90

'' LOGFONT fields -- MEASURED.
const FW_NORMAL_          = 400
const OEM_CHARSET_        = 255
const OUT_DEFAULT_PRECIS_ = 0
const CLIP_DEFAULT_PRECIS_ = 0
const DRAFT_QUALITY_      = 1
const FIXED_PITCH_        = 1
const FF_MODERN_          = 48
const VARIABLE_PITCH_     = 2
const FF_SWISS_           = 32

'' TA_TOP, TA_LEFT and TA_NOUPDATECP ARE ALL ZERO -- measured. fbc's
'' SetTextAlign( hDc, TA_TOP or TA_LEFT or TA_NOUPDATECP ) therefore sets the
'' alignment to 0, which is also the default. Kept because the call is
'' observable through GDI even though the value is not.
const TA_DEFAULT_ = 0

const LF_FACESIZE_ = 32

'' DEV_LPT_INFO and DEV_LPT_PROTOCOL, as in src/io/devlptopen.tiko.
type DEV_LPT_INFO
	as any ptr      driver_opaque
	as zstring ptr  pszDevice
	as int32         iPort
	as uinteger     uiRefCount
end type

type DEV_LPT_PROTOCOL
	as zstring ptr proto
	as int32        iPort
	as zstring ptr name_
	as zstring ptr title_
	as zstring ptr emu
end type

#if defined( __FB_64BIT__ )
	#assert sizeof( DEV_LPT_PROTOCOL ) = 40
#else
	#assert sizeof( DEV_LPT_PROTOCOL ) = 20
#endif

'' MEASURED: 60 bytes, and lfCharSet sits at 23 -- the four BYTE fields pack
'' tightly after lfWeight with no padding. No pointers, so win32 agrees.
type LOGFONTA_
	as int32  lfHeight
	as int32  lfWidth
	as int32  lfEscapement
	as int32  lfOrientation
	as int32  lfWeight
	as uint8 lfItalic
	as uint8 lfUnderline
	as uint8 lfStrikeOut
	as uint8 lfCharSet
	as uint8 lfOutPrecision
	as uint8 lfClipPrecision
	as uint8 lfQuality
	as uint8 lfPitchAndFamily
	as zstring * LF_FACESIZE_ lfFaceName
end type

#assert sizeof( LOGFONTA_ ) = 60
#assert offsetof( LOGFONTA_, lfCharSet ) = 23
#assert offsetof( LOGFONTA_, lfFaceName ) = 28

'' MEASURED: 56 bytes, tmHeight at 0 and tmMaxCharWidth at 24. Only those two
'' are read, but the whole thing is spelled out so the offsets are checked.
type TEXTMETRICA_
	as int32  tmHeight
	as int32  tmAscent
	as int32  tmDescent
	as int32  tmInternalLeading
	as int32  tmExternalLeading
	as int32  tmAveCharWidth
	as int32  tmMaxCharWidth
	as int32  tmWeight
	as int32  tmOverhang
	as int32  tmDigitizedAspectX
	as int32  tmDigitizedAspectY
	as uint8 tmFirstChar
	as uint8 tmLastChar
	as uint8 tmDefaultChar
	as uint8 tmBreakChar
	as uint8 tmItalic
	as uint8 tmUnderlined
	as uint8 tmStruckOut
	as uint8 tmPitchAndFamily
	as uint8 tmCharSet
end type

#assert sizeof( TEXTMETRICA_ ) = 56
#assert offsetof( TEXTMETRICA_, tmMaxCharWidth ) = 24

'' MEASURED on win64: 40 bytes, lpszDocName at 8. On win32 the pointers halve
'' and FreeBASIC's natural layout follows.
type DOCINFOA_
	as int32        cbSize
	as zstring ptr lpszDocName
	as zstring ptr lpszOutput
	as zstring ptr lpszDatatype
	as uint32       fwType
end type

'' MEASURED on win64, where every pointer field is eight bytes. The 32-bit shapes
'' are covered by the behavioural test instead, as they always were -- these
'' asserts pin the win64 layout and say nothing about win32.
#if defined( __FB_64BIT__ )
#assert sizeof( DOCINFOA_ ) = 40
#assert offsetof( DOCINFOA_, lpszDocName ) = 8
#endif

'' MEASURED on win64: 24 bytes, three pointers.
type DOC_INFO_1A_
	as zstring ptr pDocName
	as zstring ptr pOutputFile
	as zstring ptr pDatatype
end type

#if defined( __FB_64BIT__ )
#assert sizeof( DOC_INFO_1A_ ) = 24
#endif

'' MEASURED on win64: 136 bytes, pServerName at 0, pPrinterName at 8, pPortName
'' at 24. Only those three are read; the rest is present so the SIZE is right,
'' because EnumPrinters returns an ARRAY and a wrong stride reads garbage from
'' the second element onward -- which looks like a corrupt printer name rather
'' than like a layout bug.
type PRINTER_INFO_2A_
	as zstring ptr pServerName
	as zstring ptr pPrinterName
	as zstring ptr pShareName
	as zstring ptr pPortName
	as zstring ptr pDriverName
	as zstring ptr pComment
	as zstring ptr pLocation
	as any ptr     pDevMode
	as zstring ptr pSepFile
	as zstring ptr pPrintProcessor
	as zstring ptr pDatatype
	as zstring ptr pParameters
	as any ptr     pSecurityDescriptor
	as uint32       Attributes
	as uint32       Priority
	as uint32       DefaultPriority
	as uint32       StartTime
	as uint32       UntilTime
	as uint32       Status
	as uint32       cJobs
	as uint32       AveragePPM
end type

#if defined( __FB_64BIT__ )
#assert sizeof( PRINTER_INFO_2A_ ) = 136
#assert offsetof( PRINTER_INFO_2A_, pPortName ) = 24
#endif

'' MEASURED on win64: 32 bytes (28 of content, padded).
type PRINTER_INFO_5A_
	as zstring ptr pPrinterName
	as zstring ptr pPortName
	as uint32       Attributes
	as uint32       DeviceNotSelectedTimeout
	as uint32       TransmissionRetryTimeout
end type

#if defined( __FB_64BIT__ )
#assert sizeof( PRINTER_INFO_5A_ ) = 32
#endif

'' The emulator's per-handle state. Nested exactly as fbc nests it, because
'' nothing outside this file reads it and the shape documents the split between
'' the two output paths.
type W32_PRINTER_EMU
	as uint32  dwFullSizeX
	as uint32  dwFullSizeY
	as uint32  dwSizeX
	as uint32  dwSizeY
	as uint32  dwOffsetX
	as uint32  dwOffsetY
	as uint32  dwDPI_X
	as uint32  dwDPI_Y

	as uint32  dwCurrentX
	as uint32  dwCurrentY
	as any ptr hFont
	as uint32  clFore
	as uint32  clBack
	as uint32  dwFontSizeX
	as uint32  dwFontSizeY
	as int32   iPageStarted

	as any ptr pfnPrint
end type

type W32_PRINTER_INFO
	as any ptr        hPrinter
	as uint32          dwJob
	as any ptr        hDc
	as W32_PRINTER_EMU Emu
end type

'' A node in the LPTn -> printer-name map.
type DEV_PRINTER_DEVICE
	as FB_LISTELEM elem
	as zstring ptr device
	as zstring ptr printer_name
end type

'' The emulator entry points, resolved by name from the device string.
type FnEmuPrint as sub cdecl _
	( byval pInfo as W32_PRINTER_INFO ptr, byval pText as any ptr, _
	  byval uiLength as uinteger, byval isunicode as int32 )

extern "c"   '' NON-FBCALL: kernel32, gdi32 and winspool imports.
	declare function w_GetLastError stdcall alias "GetLastError" ( ) as uint32
	declare function w_LoadLibraryA stdcall alias "LoadLibraryA" ( byval n as zstring ptr ) as any ptr
	declare function w_FreeLibrary stdcall alias "FreeLibrary" ( byval h as any ptr ) as int32
	declare function w_GetProcAddress stdcall alias "GetProcAddress" _
		( byval h as any ptr, byval n as zstring ptr ) as any ptr

end extern

'' ---------------------------------------------------------------------------
'' THE SPOOLER AND GDI IMPORTS ARE RESOLVED AT RUNTIME, NOT LINKED.
''
'' io_openqb.o takes the ADDRESS of fb_DevLptOpen for its LPT:/PRN: branches, so
'' any program that so much as calls OPEN pulls io_devlptopen.o, then this member.
'' With static Win32 imports that one reference put WINSPOOL.DRV and GDI32.dll in
'' the import table of every such binary -- a console program that never prints a
'' byte paid for the whole print subsystem, and every MinGW link had to find
'' libwinspool.a and libgdi32.a even when it needed no symbol from either.
''
'' fbc solves the same problem by naming winspool only for a program that uses
'' LPRINT. Here the linker cannot be taught which programs those are: the device
'' name is a runtime string. So the imports move behind LoadLibrary, the pattern
'' GetDefaultPrinterA below already had to use (a static import of that one would
'' have stopped the runtime loading on NT4). LPRINT behaves exactly as before;
'' a printer-free binary imports KERNEL32 and the CRT only. A freshly built
'' runtime needs no -lwinspool/-lgdi32 on any Windows target; the MSVC link
'' line still names them, but only because the suite links the seed's older
'' prebuilt libfb.a (src/codegen/toolchain.tiko).
''
'' THE CALL SITES DO NOT CHANGE. A function-pointer variable is called exactly
'' like a declared function, so every w_Xxx( ... ) below is untouched.

type FnEnumPrintersA as function stdcall _
	( byval flags as uint32, byval name_ as zstring ptr, byval level as uint32, _
	  byval buf as any ptr, byval cbBuf as uint32, byval needed as uint32 ptr, _
	  byval returned as uint32 ptr ) as int32
type FnOpenPrinterA as function stdcall _
	( byval name_ as zstring ptr, byval h as any ptr ptr, byval def as any ptr ) as int32
type FnClosePrinter as function stdcall ( byval h as any ptr ) as int32
type FnStartDocPrinterA as function stdcall _
	( byval h as any ptr, byval level as uint32, byval info as any ptr ) as uint32
type FnEndDocPrinter as function stdcall ( byval h as any ptr ) as int32
type FnWritePrinter as function stdcall _
	( byval h as any ptr, byval buf as any ptr, byval n as uint32, byval written as uint32 ptr ) as int32
type FnCreateDCA as function stdcall _
	( byval drv as zstring ptr, byval dev as zstring ptr, byval out_ as zstring ptr, _
	  byval init as any ptr ) as any ptr
type FnDeleteDC as function stdcall ( byval h as any ptr ) as int32
type FnStartDocA as function stdcall ( byval h as any ptr, byval di as DOCINFOA_ ptr ) as int32
type FnEndDoc as function stdcall ( byval h as any ptr ) as int32
type FnStartPage as function stdcall ( byval h as any ptr ) as int32
type FnEndPage as function stdcall ( byval h as any ptr ) as int32
type FnGetDeviceCaps as function stdcall ( byval h as any ptr, byval idx as int32 ) as int32
type FnCreateFontIndirectA as function stdcall ( byval lf as LOGFONTA_ ptr ) as any ptr
type FnSelectObject as function stdcall ( byval h as any ptr, byval o as any ptr ) as any ptr
type FnGetTextMetricsA as function stdcall ( byval h as any ptr, byval tm as TEXTMETRICA_ ptr ) as int32
type FnSetTextAlign as function stdcall ( byval h as any ptr, byval mode_ as uint32 ) as uint32
type FnSetTextColor as function stdcall ( byval h as any ptr, byval c as uint32 ) as uint32
type FnSetBkColor as function stdcall ( byval h as any ptr, byval c as uint32 ) as uint32
type FnTextOutA as function stdcall _
	( byval h as any ptr, byval x as int32, byval y as int32, _
	  byval s as zstring ptr, byval n as int32 ) as int32
type FnTextOutW as function stdcall _
	( byval h as any ptr, byval x as int32, byval y as int32, _
	  byval s as wstring ptr, byval n as int32 ) as int32

dim shared as FnEnumPrintersA        w_EnumPrintersA
dim shared as FnOpenPrinterA         w_OpenPrinterA
dim shared as FnClosePrinter         w_ClosePrinter
dim shared as FnStartDocPrinterA     w_StartDocPrinterA
dim shared as FnEndDocPrinter        w_EndDocPrinter
dim shared as FnWritePrinter         w_WritePrinter
dim shared as FnCreateDCA            w_CreateDCA
dim shared as FnDeleteDC             w_DeleteDC
dim shared as FnStartDocA            w_StartDocA
dim shared as FnEndDoc               w_EndDoc
dim shared as FnStartPage            w_StartPage
dim shared as FnEndPage              w_EndPage
dim shared as FnGetDeviceCaps        w_GetDeviceCaps
dim shared as FnCreateFontIndirectA  w_CreateFontIndirectA
dim shared as FnSelectObject         w_SelectObject
dim shared as FnGetTextMetricsA      w_GetTextMetricsA
dim shared as FnSetTextAlign         w_SetTextAlign
dim shared as FnSetTextColor         w_SetTextColor
dim shared as FnSetBkColor           w_SetBkColor
dim shared as FnTextOutA             w_TextOutA
dim shared as FnTextOutW             w_TextOutW

'' THE HANDLES ARE KEPT, NOT FREED. Freeing them after the open would leave
'' every later Write/Close call through a pointer into an unloaded module, and
'' the process is the lifetime of a printer channel anyway. The spooler handle
'' doubles as the "already resolved" flag.
dim shared as any ptr tkort_hWinspool = nullptr
dim shared as any ptr tkort_hGdi32    = nullptr

private function hLoadPrinterApis( ) as int32

	if( tkort_hWinspool <> nullptr ) then return -1

	tkort_hWinspool = w_LoadLibraryA( @"winspool.drv" )
	tkort_hGdi32    = w_LoadLibraryA( @"gdi32.dll" )
	if( (tkort_hWinspool = nullptr) orelse (tkort_hGdi32 = nullptr) ) then return 0

	w_EnumPrintersA       = cast( FnEnumPrintersA,       w_GetProcAddress( tkort_hWinspool, @"EnumPrintersA" ) )
	w_OpenPrinterA        = cast( FnOpenPrinterA,        w_GetProcAddress( tkort_hWinspool, @"OpenPrinterA" ) )
	w_ClosePrinter        = cast( FnClosePrinter,        w_GetProcAddress( tkort_hWinspool, @"ClosePrinter" ) )
	w_StartDocPrinterA    = cast( FnStartDocPrinterA,    w_GetProcAddress( tkort_hWinspool, @"StartDocPrinterA" ) )
	w_EndDocPrinter       = cast( FnEndDocPrinter,       w_GetProcAddress( tkort_hWinspool, @"EndDocPrinter" ) )
	w_WritePrinter        = cast( FnWritePrinter,        w_GetProcAddress( tkort_hWinspool, @"WritePrinter" ) )

	w_CreateDCA           = cast( FnCreateDCA,           w_GetProcAddress( tkort_hGdi32, @"CreateDCA" ) )
	w_DeleteDC            = cast( FnDeleteDC,            w_GetProcAddress( tkort_hGdi32, @"DeleteDC" ) )
	w_StartDocA           = cast( FnStartDocA,           w_GetProcAddress( tkort_hGdi32, @"StartDocA" ) )
	w_EndDoc              = cast( FnEndDoc,              w_GetProcAddress( tkort_hGdi32, @"EndDoc" ) )
	w_StartPage           = cast( FnStartPage,           w_GetProcAddress( tkort_hGdi32, @"StartPage" ) )
	w_EndPage             = cast( FnEndPage,             w_GetProcAddress( tkort_hGdi32, @"EndPage" ) )
	w_GetDeviceCaps       = cast( FnGetDeviceCaps,       w_GetProcAddress( tkort_hGdi32, @"GetDeviceCaps" ) )
	w_CreateFontIndirectA = cast( FnCreateFontIndirectA, w_GetProcAddress( tkort_hGdi32, @"CreateFontIndirectA" ) )
	w_SelectObject        = cast( FnSelectObject,        w_GetProcAddress( tkort_hGdi32, @"SelectObject" ) )
	w_GetTextMetricsA     = cast( FnGetTextMetricsA,     w_GetProcAddress( tkort_hGdi32, @"GetTextMetricsA" ) )
	w_SetTextAlign        = cast( FnSetTextAlign,        w_GetProcAddress( tkort_hGdi32, @"SetTextAlign" ) )
	w_SetTextColor        = cast( FnSetTextColor,        w_GetProcAddress( tkort_hGdi32, @"SetTextColor" ) )
	w_SetBkColor          = cast( FnSetBkColor,          w_GetProcAddress( tkort_hGdi32, @"SetBkColor" ) )
	w_TextOutA            = cast( FnTextOutA,            w_GetProcAddress( tkort_hGdi32, @"TextOutA" ) )
	w_TextOutW            = cast( FnTextOutW,            w_GetProcAddress( tkort_hGdi32, @"TextOutW" ) )

	return -1
end function

'' GetDefaultPrinterA, resolved at RUNTIME -- see the file header on why it is
'' not a static import.
type FnGetDefaultPrinter as function stdcall _
	( byval buf as zstring ptr, byval cch as uint32 ptr ) as int32

extern "c"   '' NON-FBCALL: rtlib internals.
	declare function tkrt_DevLptParseProtocol alias "fb_DevLptParseProtocol" _
		( byval lpt_proto_out as DEV_LPT_PROTOCOL ptr ptr, byval proto_raw as zstring ptr, _
		  byval proto_raw_len as uinteger, byval subst_prn as int32 ) as int32
	declare sub tkrt_ConPrintTTY alias "fb_ConPrintTTY" _
		( byval handle as fb_ConHooks ptr, byval pachText as uint8 ptr, _
		  byval TextLength as uinteger, byval is_text_mode as int32 )
end extern

extern "rtlib"   '' FBCALL.
	declare function tkrt_ErrorSetNum alias "fb_ErrorSetNum" ( byval e as int32 ) as int32
end extern

'' RGB( r, g, b ) is r + (g shl 8) + (b shl 16).
#define TKORT_RGB( r, g, b ) (cast( uint32, r ) or (cast( uint32, g ) shl 8) or (cast( uint32, b ) shl 16))

'' strdup / strcasecmp / strncasecmp / isspace, written out -- MinGW spells the
'' first three with a leading underscore. Same reason as src/io/devcomopen.tiko.
private function hStrDup( byval s as zstring ptr ) as zstring ptr
	if( s = nullptr ) then return nullptr
	dim as uinteger n = strlen( s )
	dim as zstring ptr p = cast( zstring ptr, malloc( n + 1 ) )
	if( p = nullptr ) then return nullptr
	memcpy( p, s, n + 1 )
	return p
end function

'' NOT named hCaseEqN: FreeBASIC is CASE-INSENSITIVE, so that name and the
'' HCASEEQN macro below would be the same identifier (error 4).
private function hStrCaseCmpN( byval a as zstring ptr, byval b as zstring ptr, byval n as integer ) as int32
	dim as uint8 ptr pa = cast( uint8 ptr, a )
	dim as uint8 ptr pb = cast( uint8 ptr, b )
	dim as integer i = 0
	do
		dim as uint8 ca = pa[i], cb = pb[i]
		if( (ca >= 97) andalso (ca <= 122) ) then ca -= 32
		if( (cb >= 97) andalso (cb <= 122) ) then cb -= 32
		if( ca <> cb ) then return 0
		if( ca = 0 ) then return 1
		i += 1
		if( (n >= 0) andalso (i >= n) ) then return 1
	loop
end function

#define HCASEEQ( a, b )     ( hStrCaseCmpN( (a), (b), -1 ) <> 0 )
#define HCASEEQN( a, b, n ) ( hStrCaseCmpN( (a), (b), (n) ) <> 0 )

private function hIsSpace( byval c as uint8 ) as int32
	return iif( (c = 32) orelse ((c >= 9) andalso (c <= 13)), -1, 0 )
end function

'' ------------------------------------------------------------ the device list

private function hListDevElemAlloc _
	( byval lst as FB_LIST ptr, byval device as zstring ptr, _
	  byval printer_name as zstring ptr ) as DEV_PRINTER_DEVICE ptr

	dim as DEV_PRINTER_DEVICE ptr node = _
		cast( DEV_PRINTER_DEVICE ptr, calloc( 1, sizeof( DEV_PRINTER_DEVICE ) ) )
	if( node = nullptr ) then return nullptr
	node->device = hStrDup( device )
	node->printer_name = hStrDup( printer_name )
	fb_hListDynElemAdd( lst, @node->elem )
	return node
end function

private sub hListDevElemFree( byval lst as FB_LIST ptr, byval node as DEV_PRINTER_DEVICE ptr )
	fb_hListDynElemRemove( lst, @node->elem )
	free( node->device )
	free( node->printer_name )
	free( node )
end sub

'' THE NODE IS THE ELEM. FB_LISTELEM is the FIRST member of DEV_PRINTER_DEVICE,
'' so the list head can be cast straight to a node -- the intrusive-list trick
'' fbc relies on throughout, and the reason `elem` must stay first.
private sub hListDevClear( byval lst as FB_LIST ptr )
	while( lst->head <> nullptr )
		hListDevElemFree( lst, cast( DEV_PRINTER_DEVICE ptr, lst->head ) )
	wend
end sub

private function hListDevFindDevice _
	( byval lst as FB_LIST ptr, byval pszDevice as zstring ptr ) as DEV_PRINTER_DEVICE ptr

	dim as DEV_PRINTER_DEVICE ptr node = cast( DEV_PRINTER_DEVICE ptr, lst->head )
	while( node <> nullptr )
		if( HCASEEQ( pszDevice, node->device ) ) then return node
		node = cast( DEV_PRINTER_DEVICE ptr, node->elem.next )
	wend
	return nullptr
end function

private function hListDevFindName _
	( byval lst as FB_LIST ptr, byval pszPrinterName as zstring ptr ) as DEV_PRINTER_DEVICE ptr

	dim as DEV_PRINTER_DEVICE ptr node = cast( DEV_PRINTER_DEVICE ptr, lst->head )
	while( node <> nullptr )
		if( HCASEEQ( pszPrinterName, node->printer_name ) ) then return node
		node = cast( DEV_PRINTER_DEVICE ptr, node->elem.next )
	wend
	return nullptr
end function

'' ------------------------------------------------------------- enumeration
''
'' BOTH ENUMERATORS RETRY UNTIL THE BUFFER IS BIG ENOUGH, and both give up on
'' any error other than ERROR_INSUFFICIENT_BUFFER. The realloc-failure branch
'' frees the old block and breaks, leaving *pCount at whatever the last call
'' reported.

private function hGetDefaultPrinters( byval pCount as int32 ptr ) as PRINTER_INFO_5A_ ptr

	dim as uint32 dwNeeded = 0, dwReturned = 0
	dim as PRINTER_INFO_5A_ ptr result_ = nullptr
	dim as uint32 dwFlags = PRINTER_ENUM_DEFAULT_

	*pCount = 0

	dim as int32 fResult = w_EnumPrintersA( dwFlags, nullptr, 5, nullptr, 0, @dwNeeded, @dwReturned )

	while( fResult = 0 )
		if( w_GetLastError( ) <> ERROR_INSUFFICIENT_BUFFER_ ) then exit while

		dim as PRINTER_INFO_5A_ ptr oldResult = result_
		result_ = cast( PRINTER_INFO_5A_ ptr, realloc( result_, dwNeeded ) )
		if( result_ = nullptr ) then
			free( oldResult )
			exit while
		end if

		fResult = w_EnumPrintersA( dwFlags, nullptr, 5, result_, dwNeeded, @dwNeeded, @dwReturned )
	wend

	*pCount = cast( int32, dwReturned )
	return result_
end function

private function hGetPrinters( byval pCount as int32 ptr ) as PRINTER_INFO_2A_ ptr

	dim as uint32 dwNeeded = 0, dwReturned = 0
	dim as PRINTER_INFO_2A_ ptr result_ = nullptr
	dim as uint32 dwFlags = PRINTER_ENUM_LOCAL_ or PRINTER_ENUM_CONNECTIONS_

	*pCount = 0

	dim as int32 fResult = w_EnumPrintersA( dwFlags, nullptr, 2, nullptr, 0, @dwNeeded, @dwReturned )

	while( fResult = 0 )
		if( w_GetLastError( ) <> ERROR_INSUFFICIENT_BUFFER_ ) then exit while

		dim as PRINTER_INFO_2A_ ptr oldResult = result_
		result_ = cast( PRINTER_INFO_2A_ ptr, realloc( result_, dwNeeded ) )
		if( result_ = nullptr ) then
			free( oldResult )
			exit while
		end if

		fResult = w_EnumPrintersA( dwFlags, nullptr, 2, result_, dwNeeded, @dwNeeded, @dwReturned )
	wend

	*pCount = cast( int32, dwReturned )
	return result_
end function

'' TWO WAYS TO FIND THE DEFAULT PRINTER, and the second is loaded at runtime --
'' see the file header, including the leak on the realloc-failure branch.
private function hGetDefaultPrinterName( ) as zstring ptr

	dim as zstring ptr result_ = nullptr
	dim as int32 nprint = any
	dim as PRINTER_INFO_5A_ ptr printers = hGetDefaultPrinters( @nprint )

	if( nprint = 0 ) then
		dim as any ptr hMod = w_LoadLibraryA( @"winspool.drv" )
		if( hMod <> nullptr ) then
			dim as FnGetDefaultPrinter pfn = _
				cast( FnGetDefaultPrinter, w_GetProcAddress( hMod, @"GetDefaultPrinterA" ) )
			if( pfn <> nullptr ) then
				dim as zstring ptr buffer_ = nullptr
				dim as uint32 dwSize = 0
				dim as int32 fResult = pfn( 0, @dwSize )
				while( fResult = 0 )
					if( w_GetLastError( ) <> ERROR_INSUFFICIENT_BUFFER_ ) then exit while

					dim as zstring ptr oldBuffer = buffer_
					buffer_ = cast( zstring ptr, realloc( buffer_, dwSize ) )
					'' NO `exit while` AFTER THE FREE -- fbc has none either, so
					'' a failed realloc calls through the freed pointer on the
					'' next iteration. Unreachable unless the allocation fails.
					if( buffer_ = nullptr ) then free( oldBuffer )
					fResult = pfn( buffer_, @dwSize )
				wend
				'' > 1 rather than <> 0: a size of exactly 1 is the empty string.
				if( dwSize > 1 ) then result_ = buffer_
			end if
			w_FreeLibrary( hMod )
		end if
	else
		result_ = hStrDup( printers->pPrinterName )
	end if

	free( printers )
	return result_
end function

'' ----------------------------------------------------------- list building

'' PASS 1: local printers keep their own LPT port. The port name may be a
'' COMMA-SEPARATED LIST and is split IN PLACE -- see the file header.
private sub hPrinterBuildListLocal( byval lst as FB_LIST ptr )

	dim as int32 nprint = any
	dim as PRINTER_INFO_2A_ ptr printers = hGetPrinters( @nprint )
	if( printers = nullptr ) then exit sub

	for i as int32 = 0 to nprint - 1
		dim as PRINTER_INFO_2A_ ptr printer = printers + i
		'' A NULL pServerName IS WHAT "LOCAL" MEANS here.
		if( printer->pServerName = nullptr ) then
			dim as zstring ptr pPortName = printer->pPortName
			dim as zstring ptr pFoundPos = strchr( pPortName, 44 )      '' ','
			while( pFoundPos <> nullptr )
				pFoundPos[0] = 0

				if( HCASEEQN( pPortName, @"LPT", 3 ) ) then
					if( hListDevFindDevice( lst, pPortName ) = nullptr ) then
						hListDevElemAlloc( lst, pPortName, printer->pPrinterName )
					end if
				end if

				pPortName = cast( zstring ptr, cast( uint8 ptr, pFoundPos ) + 1 )
				while( hIsSpace( cptr( uint8 ptr, pPortName )[0] ) <> 0 )
					pPortName = cast( zstring ptr, cast( uint8 ptr, pPortName ) + 1 )
				wend
				pFoundPos = strchr( pPortName, 44 )
			wend

			'' The last (or only) entry, after the final comma.
			if( HCASEEQN( pPortName, @"LPT", 3 ) ) then
				if( hListDevFindDevice( lst, pPortName ) = nullptr ) then
					hListDevElemAlloc( lst, pPortName, printer->pPrinterName )
				end if
			end if
		end if
	next

	free( printers )
end sub

'' PASS 2: the default printer takes the first FREE LPT number from iStartPort.
private function hPrinterBuildListDefault _
	( byval lst as FB_LIST ptr, byval iStartPort as int32 ) as int32

	dim as zstring * 32 Buffer_
	dim as int32 iPort = iStartPort - 1
	dim as zstring ptr printer_name = hGetDefaultPrinterName( )

	if( printer_name <> nullptr ) then
		if( hListDevFindName( lst, printer_name ) = nullptr ) then
			dim as DEV_PRINTER_DEVICE ptr node = any
			do
				iPort += 1
				sprintf( @Buffer_, @"LPT%d", iPort )
				node = hListDevFindDevice( lst, @Buffer_ )
			loop while( node <> nullptr )

			hListDevElemAlloc( lst, @Buffer_, printer_name )
		end if
		free( printer_name )
	end if

	return iPort + 1
end function

'' PASS 3: everything else, from LPT128 up.
private function hPrinterBuildListOther _
	( byval lst as FB_LIST ptr, byval iStartPort as int32 ) as int32

	dim as zstring * 32 Buffer_
	dim as int32 nprint = any, iPort = iStartPort - 1
	dim as PRINTER_INFO_2A_ ptr printers = hGetPrinters( @nprint )
	if( printers = nullptr ) then return iPort + 1

	for i as int32 = 0 to nprint - 1
		dim as PRINTER_INFO_2A_ ptr printer = printers + i
		if( hListDevFindName( lst, printer->pPrinterName ) = nullptr ) then
			dim as DEV_PRINTER_DEVICE ptr node = any
			do
				iPort += 1
				sprintf( @Buffer_, @"LPT%d", iPort )
				node = hListDevFindDevice( lst, @Buffer_ )
			loop while( node <> nullptr )

			hListDevElemAlloc( lst, @Buffer_, printer->pPrinterName )
		end if
	next

	free( printers )
	return iPort + 1
end function

'' THE ORDER OF THE THREE PASSES IS THE POLICY -- see the file header.
private sub hPrinterBuildList( byval lst as FB_LIST ptr )
	hPrinterBuildListLocal( lst )
	hPrinterBuildListDefault( lst, 1 )
	hPrinterBuildListOther( lst, 128 )
end sub

'' -------------------------------------------------------------- the emulator

'' uiCPI = 0 asks for a PROPORTIONAL font; anything else is monospace at that
'' many characters per inch, with the width derived from the device's DPI.
private sub hEmuBuild_LOGFONT _
	( byval lf as LOGFONTA_ ptr, byval pInfo as W32_PRINTER_INFO ptr, byval uiCPI as uint32 )

	memset( lf, 0, sizeof( LOGFONTA_ ) )
	'' Ten points: DPI * 10 / 72.
	lf->lfHeight = pInfo->Emu.dwDPI_Y * 10 \ 72
	lf->lfWeight = FW_NORMAL_
	lf->lfCharSet = OEM_CHARSET_
	lf->lfOutPrecision = OUT_DEFAULT_PRECIS_
	lf->lfClipPrecision = CLIP_DEFAULT_PRECIS_
	lf->lfQuality = DRAFT_QUALITY_
	if( uiCPI <> 0 ) then
		lf->lfWidth = pInfo->Emu.dwDPI_X \ uiCPI
		lf->lfPitchAndFamily = FIXED_PITCH_ or FF_MODERN_
		lf->lfFaceName = "System"
	else
		lf->lfWidth = 0
		lf->lfPitchAndFamily = VARIABLE_PITCH_ or FF_SWISS_
		lf->lfFaceName = "MS Sans Serif"
	end if
end sub

private sub hEmuUpdateInfo( byval pInfo as W32_PRINTER_INFO ptr )
	dim as TEXTMETRICA_ tm

	w_SelectObject( pInfo->hDc, pInfo->Emu.hFont )
	w_GetTextMetricsA( pInfo->hDc, @tm )
	pInfo->Emu.dwFontSizeX = tm.tmMaxCharWidth
	pInfo->Emu.dwFontSizeY = tm.tmHeight
end sub

'' LAZY: returns immediately once the page is open, so a document that prints
'' nothing produces no blank page.
private sub hEmuPageStart( byval pInfo as W32_PRINTER_INFO ptr )
	if( pInfo->Emu.iPageStarted <> 0 ) then exit sub

	w_StartPage( pInfo->hDc )
	pInfo->Emu.iPageStarted = -1

	hEmuUpdateInfo( pInfo )

	w_SetTextColor( pInfo->hDc, pInfo->Emu.clFore )
	w_SetBkColor( pInfo->hDc, pInfo->Emu.clBack )
end sub

'' ONE GDI CALL PER CHARACTER -- see the file header.
private sub hEmuPrint_RAW cdecl _
	( byval pInfo as W32_PRINTER_INFO ptr, byval pText as any ptr, _
	  byval uiLength as uinteger, byval isunicode as int32 )

	dim as uint8 ptr p = cast( uint8 ptr, pText )
	dim as uinteger remaining_ = uiLength

	while( remaining_ <> 0 )
		if( isunicode = 0 ) then
			dim as zstring * 2 ch
			ch[0] = p[0]
			ch[1] = 0
			p += 1
			hEmuPageStart( pInfo )
			w_TextOutA( pInfo->hDc, pInfo->Emu.dwCurrentX, pInfo->Emu.dwCurrentY, @ch, 1 )
		else
			dim as wstring * 2 wch
			wch[0] = *cptr( uint16 ptr, p )
			wch[1] = 0
			p += sizeof( wstring )
			hEmuPageStart( pInfo )
			w_TextOutW( pInfo->hDc, pInfo->Emu.dwCurrentX, pInfo->Emu.dwCurrentY, @wch, 1 )
		end if

		pInfo->Emu.dwCurrentX += pInfo->Emu.dwFontSizeX

		if( pInfo->Emu.dwCurrentX >= pInfo->Emu.dwSizeX ) then
			pInfo->Emu.dwCurrentX = 0
			pInfo->Emu.dwCurrentY += pInfo->Emu.dwFontSizeY
			if( pInfo->Emu.dwCurrentY >= pInfo->Emu.dwSizeY ) then
				pInfo->Emu.dwCurrentY = 0
				w_EndPage( pInfo->hDc )
				pInfo->Emu.iPageStarted = 0
			end if
		end if

		remaining_ -= 1
	wend
end sub

'' THE SCROLL HOOK DOUBLES AS THE PAGE EJECT -- see the file header. Called with
'' rows = 0 by the formfeed path.
private sub hHookConPrinterScroll cdecl _
	( byval handle as fb_ConHooks ptr, byval x1 as int32, byval y1 as int32, _
	  byval x2 as int32, byval y2 as int32, byval rows as int32 )

	dim as W32_PRINTER_INFO ptr pInfo = cast( W32_PRINTER_INFO ptr, handle->Opaque )
	dim as int32 page_rows = (pInfo->Emu.dwSizeY + pInfo->Emu.dwFontSizeY - 1) \ pInfo->Emu.dwFontSizeY

	if( pInfo->Emu.iPageStarted = 0 ) then w_StartPage( pInfo->hDc )
	w_EndPage( pInfo->hDc )

	'' Scrolling by more than a page ejects whole blank pages.
	while( rows >= page_rows )
		w_StartPage( pInfo->hDc )
		w_EndPage( pInfo->hDc )
		rows -= page_rows
	wend

	pInfo->Emu.iPageStarted = 0
	if( rows <> 0 ) then rows -= 1
	handle->Coord_.Y_ = rows
end sub

private function hHookConPrinterWrite cdecl _
	( byval handle as fb_ConHooks ptr, byval buffer_ as any ptr, byval length_ as uinteger ) as int32

	dim as W32_PRINTER_INFO ptr pInfo = cast( W32_PRINTER_INFO ptr, handle->Opaque )
	pInfo->Emu.dwCurrentX = handle->Coord_.X_ * pInfo->Emu.dwFontSizeX
	pInfo->Emu.dwCurrentY = handle->Coord_.Y_ * pInfo->Emu.dwFontSizeY
	hEmuPrint_RAW( pInfo, buffer_, length_, 0 )
	return -1
end function

private function hHookConPrinterWriteWstr cdecl _
	( byval handle as fb_ConHooks ptr, byval buffer_ as any ptr, byval length_ as uinteger ) as int32

	dim as W32_PRINTER_INFO ptr pInfo = cast( W32_PRINTER_INFO ptr, handle->Opaque )
	pInfo->Emu.dwCurrentX = handle->Coord_.X_ * pInfo->Emu.dwFontSizeX
	pInfo->Emu.dwCurrentY = handle->Coord_.Y_ * pInfo->Emu.dwFontSizeY
	hEmuPrint_RAW( pInfo, buffer_, length_, -1 )
	return -1
end function

'' TTY MODE: the console's own teletype layer, with hooks that map cells to
'' device coordinates. Formfeed is handled here because fb_ConPrintTTY does not
'' know about it -- see the file header.
private sub hEmuPrint_TTY cdecl _
	( byval pInfo as W32_PRINTER_INFO ptr, byval pText as any ptr, _
	  byval uiLength as uinteger, byval isunicode as int32 )

	dim as fb_ConHooks hooks
	dim as uint8 ptr p = cast( uint8 ptr, pText )
	dim as uinteger remaining_ = uiLength

	hooks.Opaque  = pInfo
	hooks.Scroll_ = @hHookConPrinterScroll
	hooks.Write_  = iif( isunicode <> 0, _
	                     cast( FnConWrite, @hHookConPrinterWriteWstr ), _
	                     cast( FnConWrite, @hHookConPrinterWrite ) )
	hooks.Border.Left_ = 0
	hooks.Border.Top_  = 0
	hooks.Border.Right_ = (pInfo->Emu.dwSizeX - pInfo->Emu.dwFontSizeX + 1) \ pInfo->Emu.dwFontSizeX
	'' dwFontSize**X** IN THE NUMERATOR, where Y belongs. fbc's, and the row
	'' count is observable in where the page breaks -- see the file header.
	hooks.Border.Bottom_ = (pInfo->Emu.dwSizeY - pInfo->Emu.dwFontSizeX + 1) \ pInfo->Emu.dwFontSizeY

	hooks.Coord_.X_ = pInfo->Emu.dwCurrentX \ pInfo->Emu.dwFontSizeX
	hooks.Coord_.Y_ = pInfo->Emu.dwCurrentY \ pInfo->Emu.dwFontSizeY

	while( remaining_ <> 0 )
		dim as uint8 chControl = 0
		dim as uinteger uiLengthTTY = remaining_

		'' Find the first character the TTY layer cannot handle.
		for ui as uinteger = 0 to remaining_ - 1
			dim as uint8 ch = any
			if( isunicode = 0 ) then
				ch = p[ui]
			else
				'' THE WIDE SCAN TRUNCATES TO A BYTE, exactly as fbc's
				'' `char ch = ((FB_WCHAR *)pText)[ui]` does -- so U+010C would
				'' also match formfeed. Reproduced.
				ch = cast( uint8, cptr( uint16 ptr, p )[ui] )
			end if
			if( ch = 12 ) then
				chControl = ch
				uiLengthTTY = ui
				exit for
			end if
		next

		tkrt_ConPrintTTY( @hooks, p, uiLengthTTY, -1 )

		if( remaining_ <> uiLengthTTY ) then
			uiLengthTTY += 1
			if( chControl = 12 ) then
				'' FORMFEED: eject the page through the scroll hook.
				hHookConPrinterScroll( @hooks, 0, 0, 0, 0, 0 )
			end if
		end if

		if( isunicode = 0 ) then
			p += uiLengthTTY
		else
			p += uiLengthTTY * sizeof( wstring )
		end if
		remaining_ -= uiLengthTTY
	wend

	if( (hooks.Coord_.X_ <> hooks.Border.Left_) orelse _
	    (hooks.Coord_.Y_ <> (hooks.Border.Bottom_ + 1)) ) then
		TKORT_CONCHECKSCROLL( @hooks )
	end if

	pInfo->Emu.dwCurrentX = hooks.Coord_.X_ * pInfo->Emu.dwFontSizeX
	pInfo->Emu.dwCurrentY = hooks.Coord_.Y_ * pInfo->Emu.dwFontSizeY
end sub

'' The emulation modes, matched by name from the device string. fbc carries a
'' third, "ESC/P2", behind #if 0; it is absent here for the same reason.
dim shared as zstring * 8 tkort_emu_raw = "RAW"
dim shared as zstring * 8 tkort_emu_tty = "TTY"

'' ---------------------------------------------------------------- the exports

extern "c"   '' NON-FBCALL: fb_printer.h declares all four plainly.

function tkort_PrinterOpen alias "fb_PrinterOpen" _
	( byval devInfo as DEV_LPT_INFO ptr, byval iPort as int32, _
	  byval pszDevice as zstring ptr ) as int32

	dim as int32 result_ = tkrt_ErrorSetNum( FB_RTERROR_OK )
	dim as FnEmuPrint pFoundEmu = nullptr
	dim as int32 foundEmu = 0
	dim as uint32 dwJob = 0
	dim as int32 fResult = any
	dim as any ptr hPrinter = nullptr
	dim as any ptr hDc = nullptr
	dim as zstring ptr printer_name = nullptr
	dim as zstring ptr doc_title = nullptr
	dim as DEV_LPT_PROTOCOL ptr lpt_proto = nullptr

	'' FIRST USE RESOLVES THE SPOOLER/GDI CALLS, before anything below reaches a
	'' w_Xxx pointer. Write/WriteWstr/Close can only run on a channel this opened,
	'' so they never arrive with the pointers still NULL. A machine without a
	'' print subsystem fails the OPEN rather than loading the DLLs at startup.
	if( hLoadPrinterApis( ) = 0 ) then
		return tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
	end if

	if( tkrt_DevLptParseProtocol( @lpt_proto, pszDevice, strlen( pszDevice ), 1 ) = 0 ) then
		if( lpt_proto <> nullptr ) then free( lpt_proto )
		return tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
	end if

	'' AN UNKNOWN EMULATION IS AN ERROR, not a fallback to RAW.
	if( cptr( uint8 ptr, lpt_proto->emu )[0] <> 0 ) then
		if( HCASEEQ( lpt_proto->emu, @tkort_emu_raw ) ) then
			pFoundEmu = cast( FnEmuPrint, @hEmuPrint_RAW ) : foundEmu = -1
		elseif( HCASEEQ( lpt_proto->emu, @tkort_emu_tty ) ) then
			pFoundEmu = cast( FnEmuPrint, @hEmuPrint_TTY ) : foundEmu = -1
		end if
		if( foundEmu = 0 ) then
			free( lpt_proto )
			return tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
		end if
	end if

	if( iPort = 0 ) then
		'' LPT:[PrinterName] -- a name, or the default.
		if( cptr( uint8 ptr, lpt_proto->name_ )[0] <> 0 ) then
			printer_name = hStrDup( lpt_proto->name_ )
		else
			printer_name = hGetDefaultPrinterName( )
		end if
	else
		'' LPTx: -- build the whole map and look one entry up. See the header.
		dim as FB_LIST dev_printer_devs
		fb_hListDynInit( @dev_printer_devs )
		hPrinterBuildList( @dev_printer_devs )

		dim as DEV_PRINTER_DEVICE ptr node = _
			hListDevFindDevice( @dev_printer_devs, lpt_proto->proto )
		if( node <> nullptr ) then printer_name = hStrDup( node->printer_name )

		hListDevClear( @dev_printer_devs )
	end if

	if( printer_name = nullptr ) then
		result_ = tkrt_ErrorSetNum( FB_RTERROR_FILENOTFOUND )
	else
		if( cptr( uint8 ptr, lpt_proto->emu )[0] <> 0 ) then
			'' EMULATION NEEDS A DEVICE CONTEXT, not the printer handle.
			hDc = w_CreateDCA( @"WINSPOOL", printer_name, nullptr, nullptr )
			fResult = iif( hDc <> nullptr, -1, 0 )
		else
			fResult = w_OpenPrinterA( printer_name, @hPrinter, nullptr )
		end if
		if( fResult = 0 ) then
			result_ = tkrt_ErrorSetNum( FB_RTERROR_FILENOTFOUND )
		end if
	end if

	'' THE TITLE IS ALLOCATED EVEN WHEN THE OPEN ALREADY FAILED, and freed at
	'' the bottom. fbc's ordering, kept.
	if( (lpt_proto->title_ <> nullptr) andalso (cptr( uint8 ptr, lpt_proto->title_ )[0] <> 0) ) then
		doc_title = hStrDup( lpt_proto->title_ )
	else
		doc_title = hStrDup( @"FreeBASIC document" )
	end if

	if( result_ = FB_RTERROR_OK ) then
		if( cptr( uint8 ptr, lpt_proto->emu )[0] <> 0 ) then
			dim as DOCINFOA_ docInfo
			memset( @docInfo, 0, sizeof( DOCINFOA_ ) )
			docInfo.cbSize = sizeof( DOCINFOA_ )
			docInfo.lpszDocName = doc_title
			dim as int32 iJob = w_StartDocA( hDc, @docInfo )
			if( iJob <= 0 ) then
				result_ = tkrt_ErrorSetNum( FB_RTERROR_FILEIO )
			else
				dwJob = cast( uint32, iJob )
			end if
		else
			'' DATATYPE "RAW" -- the bytes reach the printer unrendered.
			dim as DOC_INFO_1A_ DocInfo
			DocInfo.pDocName = doc_title
			DocInfo.pOutputFile = nullptr
			DocInfo.pDatatype = @"RAW"

			dwJob = w_StartDocPrinterA( hPrinter, 1, @DocInfo )
			if( dwJob = 0 ) then result_ = tkrt_ErrorSetNum( FB_RTERROR_FILEIO )
		end if
	end if

	if( result_ = FB_RTERROR_OK ) then
		dim as W32_PRINTER_INFO ptr pInfo = _
			cast( W32_PRINTER_INFO ptr, calloc( 1, sizeof( W32_PRINTER_INFO ) ) )
		if( pInfo = nullptr ) then
			result_ = tkrt_ErrorSetNum( FB_RTERROR_OUTOFMEM )
		else
			devInfo->driver_opaque = pInfo
			pInfo->hPrinter = hPrinter
			pInfo->dwJob = dwJob
			pInfo->hDc = hDc
			if( hDc <> nullptr ) then
				dim as LOGFONTA_ lf

				pInfo->Emu.dwFullSizeX = w_GetDeviceCaps( hDc, PHYSICALWIDTH_ )
				pInfo->Emu.dwFullSizeY = w_GetDeviceCaps( hDc, PHYSICALHEIGHT_ )
				pInfo->Emu.dwSizeX = w_GetDeviceCaps( hDc, HORZRES_ )
				pInfo->Emu.dwSizeY = w_GetDeviceCaps( hDc, VERTRES_ )
				pInfo->Emu.dwOffsetX = w_GetDeviceCaps( hDc, PHYSICALOFFSETX_ )
				pInfo->Emu.dwOffsetY = w_GetDeviceCaps( hDc, PHYSICALOFFSETY_ )
				pInfo->Emu.dwDPI_X = w_GetDeviceCaps( hDc, LOGPIXELSX_ )
				pInfo->Emu.dwDPI_Y = w_GetDeviceCaps( hDc, LOGPIXELSY_ )

				'' ZERO, NOT THE PHYSICAL OFFSET. fbc carries the offset
				'' version beside this under #if 0; the live branch starts at
				'' the top-left of the PRINTABLE area, so the margin the driver
				'' already applies is not added twice.
				pInfo->Emu.dwCurrentX = 0
				pInfo->Emu.dwCurrentY = 0

				pInfo->Emu.clFore = TKORT_RGB( 0, 0, 0 )
				pInfo->Emu.clBack = TKORT_RGB( 255, 255, 255 )

				'' 12 CPI monospace to start.
				hEmuBuild_LOGFONT( @lf, pInfo, 12 )
				pInfo->Emu.hFont = w_CreateFontIndirectA( @lf )

				pInfo->Emu.pfnPrint = cast( any ptr, pFoundEmu )

				'' TA_TOP or TA_LEFT or TA_NOUPDATECP is 0 -- see the header.
				w_SetTextAlign( hDc, TA_DEFAULT_ )

				hEmuUpdateInfo( pInfo )
			end if
		end if
	end if

	if( result_ <> FB_RTERROR_OK ) then
		if( dwJob <> 0 ) then
			if( cptr( uint8 ptr, lpt_proto->emu )[0] <> 0 ) then
				w_EndDoc( hDc )
			else
				w_EndDocPrinter( hPrinter )
			end if
		end if
		if( hPrinter <> nullptr ) then w_ClosePrinter( hPrinter )
		if( hDc <> nullptr ) then w_DeleteDC( hDc )
	end if

	if( printer_name <> nullptr ) then free( printer_name )
	if( doc_title <> nullptr ) then free( doc_title )
	if( lpt_proto <> nullptr ) then free( lpt_proto )

	return result_
end function

'' hPrinter NULL MEANS EMULATION -- see the file header on the two paths.
function tkort_PrinterWrite alias "fb_PrinterWrite" _
	( byval devInfo as DEV_LPT_INFO ptr, byval data_ as any ptr, byval length_ as uinteger ) as int32

	dim as W32_PRINTER_INFO ptr pInfo = cast( W32_PRINTER_INFO ptr, devInfo->driver_opaque )
	dim as uint32 dwWritten = any

	if( pInfo->hPrinter = nullptr ) then
		dim as FnEmuPrint fn_ = cast( FnEmuPrint, pInfo->Emu.pfnPrint )
		fn_( pInfo, data_, length_, 0 )
	elseif( w_WritePrinter( pInfo->hPrinter, data_, cast( uint32, length_ ), @dwWritten ) = 0 ) then
		return tkrt_ErrorSetNum( FB_RTERROR_FILEIO )
	elseif( cast( uinteger, dwWritten ) <> length_ ) then
		return tkrt_ErrorSetNum( FB_RTERROR_FILEIO )
	end if

	return tkrt_ErrorSetNum( FB_RTERROR_OK )
end function

'' THE WIDE SPOOLER PATH WRITES RAW CODE UNITS, byte count doubled -- no
'' conversion, unlike the POSIX driver which encodes UTF-8.
function tkort_PrinterWriteWstr alias "fb_PrinterWriteWstr" _
	( byval devInfo as DEV_LPT_INFO ptr, byval data_ as wstring ptr, byval length_ as uinteger ) as int32

	dim as W32_PRINTER_INFO ptr pInfo = cast( W32_PRINTER_INFO ptr, devInfo->driver_opaque )
	dim as uint32 dwWritten = any
	dim as uinteger bytes_ = length_ * sizeof( wstring )

	if( pInfo->hPrinter = nullptr ) then
		dim as FnEmuPrint fn_ = cast( FnEmuPrint, pInfo->Emu.pfnPrint )
		fn_( pInfo, data_, length_, -1 )
	elseif( w_WritePrinter( pInfo->hPrinter, data_, cast( uint32, bytes_ ), @dwWritten ) = 0 ) then
		return tkrt_ErrorSetNum( FB_RTERROR_FILEIO )
	elseif( cast( uinteger, dwWritten ) <> bytes_ ) then
		return tkrt_ErrorSetNum( FB_RTERROR_FILEIO )
	end if

	return tkrt_ErrorSetNum( FB_RTERROR_OK )
end function

'' CLOSE TESTS hDc, WHERE WRITE TESTED hPrinter -- the same distinction asked
'' two different ways. See the file header.
''
'' THE FONT IS NEVER DELETED. CreateFontIndirect's HFONT is stored in
'' Emu.hFont and no DeleteObject ever runs, so a program that opens and closes
'' an emulated printer repeatedly leaks one GDI object per open. Reproduced.
function tkort_PrinterClose alias "fb_PrinterClose" _
	( byval devInfo as DEV_LPT_INFO ptr ) as int32

	dim as W32_PRINTER_INFO ptr pInfo = cast( W32_PRINTER_INFO ptr, devInfo->driver_opaque )

	if( pInfo->hDc <> nullptr ) then
		if( pInfo->Emu.iPageStarted <> 0 ) then w_EndPage( pInfo->hDc )
		w_EndDoc( pInfo->hDc )
		w_DeleteDC( pInfo->hDc )
	else
		w_EndDocPrinter( pInfo->hPrinter )
		w_ClosePrinter( pInfo->hPrinter )
	end if

	if( devInfo->driver_opaque <> nullptr ) then free( devInfo->driver_opaque )
	devInfo->driver_opaque = nullptr

	return tkrt_ErrorSetNum( FB_RTERROR_OK )
end function

end extern

#endif
