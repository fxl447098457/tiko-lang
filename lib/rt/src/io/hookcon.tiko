'' hookcon.tiko -- the console hooks: fifteen entry points over fifteen fbc
'' members.
''
'' All the same shape as src/io/hookprint.tiko -- try the hook, fall back to the
'' console -- so what is worth reading is the TWO that do more than dispatch,
'' because each keeps a piece of state PRINT's padding depends on.
''
''   CLS    zeroes the screen handle's line_length. Without it the next PRINT ,
''          pads from wherever the cursor used to be, on a now-blank screen.
''
''   WIDTH  sets the screen handle's width AND resets VIEW PRINT -- but only when
''          a positive dimension was actually given. It also RETURNS TWO
''          DIFFERENT THINGS: the current value when asked for neither, and 0
''          when setting.
''
'' fb_DevScrnInit_NoOpen runs BEFORE the lock in the ones that touch the handle:
'' it has to exist before its fields do, and creating it takes the lock itself.
''
'' SLEEP alone RELEASES THE LOCK BEFORE CALLING -- it blocks; see tkort_Sleep.

#include once "inc/descriptors.ti"
#include once "inc/ctx.ti"
#include once "inc/file.ti"

#include once "inc/iolock.ti"

type FB_CLSPROC        as sub cdecl ( byval mode as int32 )
type FB_COLORPROC      as function cdecl ( byval fc as uint32, byval bc as uint32, byval flags as int32 ) as uint32
type FB_WIDTHPROC      as function cdecl ( byval cols as int32, byval rows as int32 ) as int32
type FB_GETXPROC       as function cdecl ( ) as int32
type FB_GETYPROC       as function cdecl ( ) as int32
type FB_GETXYPROC      as sub cdecl ( byval col as int32 ptr, byval row as int32 ptr )
type FB_GETSIZEPROC    as sub cdecl ( byval cols as int32 ptr, byval rows as int32 ptr )
type FB_MULTIKEYPROC   as function cdecl ( byval scancode as int32 ) as int32
type FB_SETMOUSEPROC   as function cdecl ( byval x as int32, byval y as int32, byval cursor as int32, byval clip as int32 ) as int32
type FB_VIEWUPDATEPROC as sub cdecl ( )
type FB_READXYPROC     as function cdecl ( byval col as int32, byval row as int32, byval colorflag as int32 ) as uint32
type FB_SLEEPPROC      as sub cdecl ( byval msecs as int32 )
type FB_ISREDIRPROC    as function cdecl ( byval is_input as int32 ) as int32
type FB_PAGECOPYPROC   as function cdecl ( byval src as int32, byval dst as int32 ) as int32
type FB_PAGESETPROC    as function cdecl ( byval active as int32, byval visible as int32 ) as int32

extern "rtlib"
	declare sub tkrt_ConsoleClear TKORT_CDECL alias "fb_ConsoleClear" ( byval mode as int32 )
	declare function tkrt_ConsoleColor TKORT_CDECL alias "fb_ConsoleColor" ( byval fc as uint32, byval bc as uint32, byval flags as int32 ) as uint32
	declare function tkrt_ConsoleWidth TKORT_CDECL alias "fb_ConsoleWidth" ( byval cols as int32, byval rows as int32 ) as int32
	declare function tkrt_ConsoleGetX TKORT_CDECL alias "fb_ConsoleGetX" ( ) as int32
	declare function tkrt_ConsoleGetY TKORT_CDECL alias "fb_ConsoleGetY" ( ) as int32
	declare sub tkrt_ConsoleGetXY alias "fb_ConsoleGetXY" ( byval col as int32 ptr, byval row as int32 ptr )
	declare sub tkrt_ConsoleGetSize alias "fb_ConsoleGetSize" ( byval cols as int32 ptr, byval rows as int32 ptr )
	declare function tkrt_ConsoleMultikey TKORT_CDECL alias "fb_ConsoleMultikey" ( byval scancode as int32 ) as int32
	declare function tkrt_ConsoleSetMouse TKORT_CDECL alias "fb_ConsoleSetMouse" ( byval x as int32, byval y as int32, byval cursor as int32, byval clip as int32 ) as int32
	declare sub tkrt_ConsoleViewUpdate TKORT_CDECL alias "fb_ConsoleViewUpdate" ( )
	declare function tkrt_ConsoleReadXY alias "fb_ConsoleReadXY" ( byval col as int32, byval row as int32, byval colorflag as int32 ) as uint32
	declare sub tkrt_ConsoleSleep TKORT_CDECL alias "fb_ConsoleSleep" ( byval msecs as int32 )
	declare function tkrt_ConsoleIsRedirected TKORT_CDECL alias "fb_ConsoleIsRedirected" ( byval is_input as int32 ) as int32
	declare function tkrt_ConsolePageCopy TKORT_CDECL alias "fb_ConsolePageCopy" ( byval src as int32, byval dst as int32 ) as int32
	declare function tkrt_ConsolePageSet TKORT_CDECL alias "fb_ConsolePageSet" ( byval active as int32, byval visible as int32 ) as int32
	declare sub tkrt_ConsoleView alias "fb_ConsoleView" ( byval top as int32, byval bot as int32 )
end extern

extern "c"   '' NON-FBCALL: the lazy screen-handle creator.
	declare sub tkrt_DevScrnInitNoOpen alias "fb_DevScrnInit_NoOpen" ( )
end extern

extern "rtlib"

sub tkort_Cls alias "fb_Cls" ( byval mode as int32 )
	tkrt_DevScrnInitNoOpen( )
	TKORT_IOLOCK()
	dim as FB_CLSPROC p = TKORT_HOOKPTR( FB_CLSPROC, TKORT_HK_CLS )
	if( p <> nullptr ) then
		p( mode )
	else
		tkrt_ConsoleClear( mode )
	end if
	'' Zeroed here, or the next PRINT , pads from a stale column.
	TKORT_FILETB()->line_length = 0
	TKORT_IOUNLOCK()
end sub

function tkort_Color alias "fb_Color" _
	( byval fc as uint32, byval bc as uint32, byval flags as int32 ) as uint32
	TKORT_IOLOCK()
	dim as uint32 cur = any
	dim as FB_COLORPROC p = TKORT_HOOKPTR( FB_COLORPROC, TKORT_HK_COLOR )
	if( p <> nullptr ) then cur = p( fc, bc, flags ) else cur = tkrt_ConsoleColor( fc, bc, flags )
	TKORT_IOUNLOCK()
	return cur
end function

function tkort_Width alias "fb_Width" ( byval cols as int32, byval rows as int32 ) as int32
	tkrt_DevScrnInitNoOpen( )
	TKORT_IOLOCK()
	dim as int32 cur = any
	dim as FB_WIDTHPROC p = TKORT_HOOKPTR( FB_WIDTHPROC, TKORT_HK_WIDTH )
	if( p <> nullptr ) then cur = p( cols, rows ) else cur = tkrt_ConsoleWidth( cols, rows )
	if( cols > 0 ) then TKORT_FILETB()->width = cols
	'' VIEW PRINT is reset only when something was actually set.
	if( (cols > 0) orelse (rows > 0) ) then tkrt_ConsoleView( 0, 0 )
	TKORT_IOUNLOCK()
	'' The current value when querying, 0 when setting.
	if( (cols < 1) andalso (rows < 1) ) then return cur
	return 0
end function

function tkort_GetX alias "fb_GetX" ( ) as int32
	TKORT_IOLOCK()
	dim as int32 res = any
	dim as FB_GETXPROC p = TKORT_HOOKPTR( FB_GETXPROC, TKORT_HK_GETX )
	if( p <> nullptr ) then res = p( ) else res = tkrt_ConsoleGetX( )
	TKORT_IOUNLOCK()
	return res
end function

function tkort_GetY alias "fb_GetY" ( ) as int32
	TKORT_IOLOCK()
	dim as int32 res = any
	dim as FB_GETYPROC p = TKORT_HOOKPTR( FB_GETYPROC, TKORT_HK_GETY )
	if( p <> nullptr ) then res = p( ) else res = tkrt_ConsoleGetY( )
	TKORT_IOUNLOCK()
	return res
end function

sub tkort_GetXY alias "fb_GetXY" ( byval col as int32 ptr, byval row as int32 ptr )
	TKORT_IOLOCK()
	dim as FB_GETXYPROC p = TKORT_HOOKPTR( FB_GETXYPROC, TKORT_HK_GETXY )
	if( p <> nullptr ) then p( col, row ) else tkrt_ConsoleGetXY( col, row )
	TKORT_IOUNLOCK()
end sub

sub tkort_GetSize alias "fb_GetSize" ( byval cols as int32 ptr, byval rows as int32 ptr )
	TKORT_IOLOCK()
	dim as FB_GETSIZEPROC p = TKORT_HOOKPTR( FB_GETSIZEPROC, TKORT_HK_GETSIZE )
	if( p <> nullptr ) then p( cols, rows ) else tkrt_ConsoleGetSize( cols, rows )
	TKORT_IOUNLOCK()
end sub

function tkort_Multikey alias "fb_Multikey" ( byval scancode as int32 ) as int32
	TKORT_IOLOCK()
	dim as int32 res = any
	dim as FB_MULTIKEYPROC p = TKORT_HOOKPTR( FB_MULTIKEYPROC, TKORT_HK_MULTIKEY )
	if( p <> nullptr ) then res = p( scancode ) else res = tkrt_ConsoleMultikey( scancode )
	TKORT_IOUNLOCK()
	return res
end function

function tkort_SetMouse alias "fb_SetMouse" _
	( byval x as int32, byval y as int32, byval cursor as int32, byval clip as int32 ) as int32
	TKORT_IOLOCK()
	dim as int32 res = any
	dim as FB_SETMOUSEPROC p = TKORT_HOOKPTR( FB_SETMOUSEPROC, TKORT_HK_SETMOUSE )
	if( p <> nullptr ) then res = p( x, y, cursor, clip ) else res = tkrt_ConsoleSetMouse( x, y, cursor, clip )
	TKORT_IOUNLOCK()
	return res
end function

sub tkort_ViewUpdate alias "fb_ViewUpdate" ( )
	TKORT_IOLOCK()
	dim as FB_VIEWUPDATEPROC p = TKORT_HOOKPTR( FB_VIEWUPDATEPROC, TKORT_HK_VIEWUPDATE )
	if( p <> nullptr ) then p( ) else tkrt_ConsoleViewUpdate( )
	TKORT_IOUNLOCK()
end sub

function tkort_ReadXY alias "fb_ReadXY" _
	( byval col as int32, byval row as int32, byval colorflag as int32 ) as uint32
	TKORT_IOLOCK()
	dim as uint32 res = any
	dim as FB_READXYPROC p = TKORT_HOOKPTR( FB_READXYPROC, TKORT_HK_READXY )
	if( p <> nullptr ) then res = p( col, row, colorflag ) else res = tkrt_ConsoleReadXY( col, row, colorflag )
	TKORT_IOUNLOCK()
	return res
end function

'' THE LOCK COVERS READING THE HOOK, NOT THE SLEEP -- fbc's hook_sleep.c unlocks before
'' sleeping. Held across it, one thread's SLEEP stalls every other thread's console I/O and
'' SLEEP; four threads looping SLEEP 5 kept the main thread out of its SLEEP 30 for 32 s on
'' Linux, an unfair mutex re-taken before the waiter woke (AWT-001).
sub tkort_Sleep alias "fb_Sleep" ( byval msecs as int32 )
	TKORT_IOLOCK()
	dim as FB_SLEEPPROC p = TKORT_HOOKPTR( FB_SLEEPPROC, TKORT_HK_SLEEP )
	TKORT_IOUNLOCK()
	if( p <> nullptr ) then p( msecs ) else tkrt_ConsoleSleep( msecs )
end sub

function tkort_IsRedirected alias "fb_IsRedirected" ( byval is_input as int32 ) as int32
	TKORT_IOLOCK()
	dim as int32 res = any
	dim as FB_ISREDIRPROC p = TKORT_HOOKPTR( FB_ISREDIRPROC, TKORT_HK_ISREDIR )
	if( p <> nullptr ) then res = p( is_input ) else res = tkrt_ConsoleIsRedirected( is_input )
	TKORT_IOUNLOCK()
	return res
end function

