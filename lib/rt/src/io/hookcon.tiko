	tkrt_DevScrnInitNoOpen( )
	TKORT_IOLOCK()
	dim as int32 res = any
	dim as FB_PAGECOPYPROC p = TKORT_HOOKPTR( FB_PAGECOPYPROC, TKORT_HK_PAGECOPY )
	if( p <> nullptr ) then res = p( src, dst ) else res = tkrt_ConsolePageCopy( src, dst )
	TKORT_IOUNLOCK()
	return res
end function

function tkort_PageSet alias "fb_PageSet" ( byval active as int32, byval visible as int32 ) as int32
	tkrt_DevScrnInitNoOpen( )
	TKORT_IOLOCK()
	dim as int32 res = any
	dim as FB_PAGESETPROC p = TKORT_HOOKPTR( FB_PAGESETPROC, TKORT_HK_PAGESET )
	if( p <> nullptr ) then res = p( active, visible ) else res = tkrt_ConsolePageSet( active, visible )
	TKORT_IOUNLOCK()
	return res
end function

end extern
