'' openqb.tiko -- the QB-compatible OPEN, and file copy. Two symbols across two
'' fbc members.
''
'' fb_FileOpenQB IS A DEVICE-STRING DISPATCHER, not an opener. It looks at the
'' filename, decides which of six device drivers should own the channel, and
'' hands off -- the actual opening is always fb_FileOpenVfsEx or fb_FileOpenEx.
''
'' AND IT DOES ITS OWN PARSING RATHER THAN ASKING THE DEVICES. Every device in
'' the runtime has a Test-Protocol entry point that answers "is this mine?", and
'' this function calls NONE of them. It re-implements the COM and LPT tests
'' inline and compares the rest with strcasecmp against fixed strings. The two
'' therefore disagree -- fb_DevComTestProtocol claims anything containing a colon,
'' and this does not -- and that disagreement is deliberate: OPEN must not hand
'' "C:\file" to the serial driver.
''
'' THE ORDER OF THE `else if` CHAIN IS THE PRECEDENCE, and it is not
'' alphabetical: COM, LPT, PRN:, CONS:, SCRN:, PIPE:, then an ordinary file. A
'' file genuinely named `PRN:` cannot be opened; that is DOS-compatible and
'' intentional.
''
'' THE LENGTH TESTS ARE EXACT FOR THE NAMED DEVICES, `> 3` for the numbered ones
'' and `>= 5` for PIPE. So "PRN:x" is an ordinary file while "PRN:" is the
'' printer, and "CONS:" with anything appended is a file too. An implementation
'' using a prefix match for all of them would open the wrong thing for several
'' real filenames.
''
'' `str->data[i] == ':'` READS ONE PAST THE DIGITS AND IS NOT BOUNDS-CHECKED
'' AGAINST str_len. The scan stops at `i < str_len`, and then the colon test
'' indexes `i` -- which for "COM12" with no colon is the terminator byte. That is
'' safe only because FBSTRING data is always NUL-terminated, and it is why the
'' test compares against ':' rather than testing `i < str_len` first.
''
'' THE PIPE CASE SKIPS SIX CHARACTERS AND MEASURES FIVE. `fb_StrMid( str, 6,
'' str_len - 5 )` -- MID is 1-based, so starting at 6 drops "PIPE:" (five
'' characters) and the length is the remainder. The 6-and-5 look inconsistent and
'' are correct.
''
'' AND SCRN: IS THE ONE THAT INITIALISES ITS DRIVER FIRST. fb_DevScrnInit is
'' called before the open, because the screen device's hook table is a
'' linker-driven feature switch that must be populated before a channel points at
'' it.
''
'' fb_FileCopy IS A ONE-LINER ON BOTH PLATFORMS but not the same one. Windows
'' calls CopyFile, which preserves attributes and timestamps and refuses to
'' overwrite; POSIX forwards to fb_CrtFileCopy, which is a read/write loop that
'' preserves nothing and truncates the destination. Same entry point, materially
'' different behaviour -- and neither is documented as the other.

#include once "inc/descriptors.ti"
#include once "inc/file.ti"
#include once "inc/ctx.ti"
#include once "inc/rterror.ti"
#include once "inc/sysbind.ti"
#include once "inc/upath.ti"

extern "c"   '' NON-FBCALL: libc's case-insensitive compares. MinGW provides the
             '' POSIX names on Windows too, so one declaration serves all three
             '' targets.
	'' _strnicmp / _stricmp ON THE MICROSOFT ABI. The UCRT has no strncasecmp or
	'' strcasecmp -- they are POSIX names, and MSVC spells the pair with a leading
	'' underscore and an i. Same signature and same meaning, a different name, and
	'' the same shape as the fseeko/ftello rename. TKORT_MSVC comes from build.sh;
	'' see src/sys/sys.ti for why fbc cannot tell us itself.
	#ifdef TKORT_MSVC
	declare function crt_strncasecmp alias "_strnicmp" _
		( byval a as zstring ptr, byval b as zstring ptr, byval n as uinteger ) as int32
	declare function crt_strcasecmp alias "_stricmp" _
		( byval a as zstring ptr, byval b as zstring ptr ) as int32
	#else
	declare function crt_strncasecmp alias "strncasecmp" _
		( byval a as zstring ptr, byval b as zstring ptr, byval n as uinteger ) as int32
	declare function crt_strcasecmp alias "strcasecmp" _
		( byval a as zstring ptr, byval b as zstring ptr ) as int32
	#endif
end extern

extern "c"   '' NON-FBCALL: fb_file.h, fb_serial.h and fb_printer.h declare the
             '' opener and all six drivers plainly -- and the win32 archive
             '' agrees, `_fb_FileOpenVfsEx` and `_fb_DevComOpen` both carrying
             '' no `@N`.
	declare function tkrt_FileOpenVfsEx alias "fb_FileOpenVfsEx" _
		( byval handle as FB_FILE ptr, byval str_filename as FBSTRING ptr, _
		  byval mode_ as uint32, byval acc as uint32, byval lock_ as uint32, _
		  byval len_ as int32, byval encoding as int32, byval pfnOpen as any ptr ) as int32

	'' The six drivers. Two of them -- Com and Lpt -- are still fbc's; the other
	'' four are tiko-rt's own, and nothing here can tell the difference.
	declare function tkrt_DevComOpen alias "fb_DevComOpen" _
		( byval h as FB_FILE ptr, byval f as zstring ptr, byval l as uinteger ) as int32
	declare function tkrt_DevLptOpen alias "fb_DevLptOpen" _
		( byval h as FB_FILE ptr, byval f as zstring ptr, byval l as uinteger ) as int32
	declare function tkrt_DevConsOpen alias "fb_DevConsOpen" _
		( byval h as FB_FILE ptr, byval f as zstring ptr, byval l as uinteger ) as int32
	declare function tkrt_DevScrnOpen alias "fb_DevScrnOpen" _
		( byval h as FB_FILE ptr, byval f as zstring ptr, byval l as uinteger ) as int32
	declare function tkrt_DevPipeOpen alias "fb_DevPipeOpen" _
		( byval h as FB_FILE ptr, byval f as zstring ptr, byval l as uinteger ) as int32
	declare sub tkrt_DevScrnInit alias "fb_DevScrnInit" ( )
end extern

extern "rtlib"   '' FBCALL: these three ARE decorated, and the win32 archive
                 '' spells them `_fb_FileOpenEx@24`, `_fb_StrMid@12` and
                 '' `_fb_CrtFileCopy@8`.
	declare function tkrt_FileOpenEx TKORT_CDECL alias "fb_FileOpenEx" _
		( byval handle as FB_FILE ptr, byval str_filename as FBSTRING ptr, _
		  byval mode_ as uint32, byval acc as uint32, byval lock_ as uint32, _
		  byval len_ as int32 ) as int32
	declare function tkrt_StrMid alias "fb_StrMid" _
		( byval s as FBSTRING ptr, byval start_ as integer, byval l as integer ) as FBSTRING ptr
	declare function tkrt_ErrorSetNum alias "fb_ErrorSetNum" ( byval e as int32 ) as int32
	#ifndef __FB_WIN32__
		declare function tkrt_CrtFileCopy alias "fb_CrtFileCopy" _
			( byval src as zstring ptr, byval dst as zstring ptr ) as int32
	#endif
end extern

#ifdef __FB_WIN32__
	extern "c"   '' NON-FBCALL: kernel32, `stdcall` per declaration.
		declare function w_CopyFileW stdcall alias "CopyFileW" _
			( byval src as wstring ptr, byval dst as wstring ptr, byval failIfExists as int32 ) as int32
	end extern
#endif

extern "rtlib"   '' FBCALL: fb_FileOpenQB and fb_FileCopy are both decorated,
                 '' `_fb_FileOpenQB@24` and `_fb_FileCopy@8`.

'' Scans the digits after a three-character prefix and reports whether a colon
'' follows them. Spelled once because COM and LPT do exactly the same thing --
'' and note it reads `data[i]` even when i has reached str_len, which is safe
'' only because the descriptor's data is NUL-terminated. See the file header.
private function hNumberedDeviceColon( byval s as FBSTRING ptr, byval str_len as integer ) as int32
	dim as integer i = 3
	while( (i < str_len) andalso (s->data[i] >= 48) andalso (s->data[i] <= 57) )
		i += 1
	wend
	return ( s->data[i] = 58 )                       '' ':'
end function

'' DISPATCHES ON THE NAME. The order of the tests is the precedence and is not
'' alphabetical -- see the file header.
function tkort_FileOpenQB alias "fb_FileOpenQB" _
	( byval str_ as FBSTRING ptr, byval mode_ as uint32, byval acc as uint32, _
	  byval lock_ as uint32, byval fnum as int32, byval len_ as int32 ) as int32

	'' THE CHANNEL NUMBER IS CHECKED BEFORE THE STRING, so an invalid fnum with
	'' a NULL filename reports the channel error and not the filename one.
	if( TKORT_FILE_INDEX_VALID( fnum ) = 0 ) then
		return tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
	end if

	dim as integer str_len = FB_STRSIZE( str_ )

	if( (str_len = 0) orelse (str_->data = nullptr) ) then
		return tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
	end if

	'' ---- serial: COM<digits>:
	if( (str_len > 3) andalso (crt_strncasecmp( str_->data, @"COM", 3 ) = 0) ) then
		if( hNumberedDeviceColon( str_, str_len ) ) then
			return tkrt_FileOpenVfsEx( TKORT_FILE_TO_HANDLE( fnum ), str_, mode_, acc, _
			                           lock_, len_, FB_FILE_ENCOD_ASCII, _
			                           cast( any ptr, @tkrt_DevComOpen ) )
		end if

	'' ---- parallel: LPT<digits>:
	'' NOTE THIS IS `elseif`, NOT A SEPARATE `if`. A string beginning "COM" that
	'' has no colon falls through the WHOLE chain to the ordinary-file case
	'' rather than being retried against LPT -- which is right, and is also why
	'' the structure has to be preserved rather than flattened.
	elseif( (str_len > 3) andalso (crt_strncasecmp( str_->data, @"LPT", 3 ) = 0) ) then
		if( hNumberedDeviceColon( str_, str_len ) ) then
			return tkrt_FileOpenVfsEx( TKORT_FILE_TO_HANDLE( fnum ), str_, mode_, acc, _
			                           lock_, len_, FB_FILE_ENCOD_ASCII, _
			                           cast( any ptr, @tkrt_DevLptOpen ) )
		end if

	'' ---- the default printer, EXACTLY four characters.
	elseif( (str_len = 4) andalso (crt_strcasecmp( str_->data, @"PRN:" ) = 0) ) then
		return tkrt_FileOpenVfsEx( TKORT_FILE_TO_HANDLE( fnum ), str_, mode_, acc, _
		                           lock_, len_, FB_FILE_ENCOD_ASCII, _
		                           cast( any ptr, @tkrt_DevLptOpen ) )

	'' ---- the console, exactly five.
	elseif( (str_len = 5) andalso (crt_strcasecmp( str_->data, @"CONS:" ) = 0) ) then
		return tkrt_FileOpenVfsEx( TKORT_FILE_TO_HANDLE( fnum ), str_, mode_, acc, _
		                           lock_, len_, FB_FILE_ENCOD_ASCII, _
		                           cast( any ptr, @tkrt_DevConsOpen ) )

	'' ---- the screen, exactly five, AND ITS DRIVER IS INITIALISED FIRST --
	'' the hook table is a linker-driven feature switch and must be populated
	'' before a channel points at it.
	elseif( (str_len = 5) andalso (crt_strcasecmp( str_->data, @"SCRN:" ) = 0) ) then
		tkrt_DevScrnInit( )
		return tkrt_FileOpenVfsEx( TKORT_FILE_TO_HANDLE( fnum ), str_, mode_, acc, _
		                           lock_, len_, FB_FILE_ENCOD_ASCII, _
		                           cast( any ptr, @tkrt_DevScrnOpen ) )

	'' ---- a pipe, five OR MORE -- the only prefix match in the chain, because
	'' the name follows the marker.
	elseif( (str_len >= 5) andalso (crt_strncasecmp( str_->data, @"PIPE:", 5 ) = 0) ) then
		'' SIX AND FIVE, and they are not a typo: MID is 1-based, so start 6
		'' drops the five characters of "PIPE:" and the length is the remainder.
		return tkrt_FileOpenVfsEx( TKORT_FILE_TO_HANDLE( fnum ), _
		                           tkrt_StrMid( str_, 6, str_len - 5 ), mode_, acc, _
		                           lock_, len_, FB_FILE_ENCOD_ASCII, _
		                           cast( any ptr, @tkrt_DevPipeOpen ) )
	end if

	'' ---- and anything else is an ordinary file, including a COM or LPT name
	'' that had no colon.
	return tkrt_FileOpenEx( TKORT_FILE_TO_HANDLE( fnum ), str_, mode_, acc, lock_, len_ )
end function

'' TWO DIFFERENT COPIES BEHIND ONE NAME -- see the file header. CopyFile
'' preserves attributes and timestamps; the POSIX read/write loop preserves
'' nothing.
function tkort_FileCopy alias "fb_FileCopy" _
	( byval source as zstring ptr, byval destination as zstring ptr ) as int32

	#ifdef __FB_WIN32__
		'' FALSE for failIfExists, so an existing destination IS overwritten --
		'' which is the one respect in which the two platforms agree.
		'' Both paths as UTF-16 (inc/upath.ti): UTF-8 if valid, else the ANSI code page.
		dim as wstring ptr ws = tkrt_PathToWide( source )
		dim as wstring ptr wd = tkrt_PathToWide( destination )
		dim as int32 res = 0
		if( (ws <> nullptr) andalso (wd <> nullptr) ) then res = w_CopyFileW( ws, wd, 0 )
		if( ws <> nullptr ) then free( ws )
		if( wd <> nullptr ) then free( wd )
		return tkrt_ErrorSetNum( iif( res = 0, FB_RTERROR_ILLEGALFUNCTIONCALL, FB_RTERROR_OK ) )
	#else
		'' fb_CrtFileCopy ALREADY SETS THE ERROR, so this must not set it again
		'' -- the return is passed straight through.
		return tkrt_CrtFileCopy( source, destination )
	#endif
end function

end extern
