'' devcomopen.tiko -- fb_DevComOpen and fb_DevSerialSetWidth: the COMx device,
'' its option-string parser and the six file hooks behind it. Two symbols, one
'' fbc member (dev_com.o), portable.
''
'' THE OPTION STRING IS THE WHOLE JOB. `OPEN "COM1:9600,N,8,1,CS0,DS0"` carries
'' a positional part and an extended part in one comma-separated list, and the
'' rule that joins them is: THE FIRST FOUR FIELDS ARE POSITIONAL BY INDEX, and
'' everything from the fifth on is matched by NAME. So the counter is not a
'' loop variable that happens to be handy -- it is the grammar.
''
'' AN EMPTY FIELD STILL ADVANCES THE COUNTER. "COM1:,,8" sets the DATA BITS,
'' because the two empty fields consume positions 0 and 1. That is what makes
'' the positional part usable without restating the defaults, and it is why the
'' `continue` for an empty option increments before it skips.
''
'' THE DEFAULTS ARE QB's, NOT ANYTHING MODERN: 300 baud, EVEN parity, 7 data
'' bits. A program that opens "COM1:" and expects 9600,N,8,1 gets a 1980s
'' terminal instead, and that is the documented behaviour rather than a bug.
''
'' AND THE STOP BITS ARE DERIVED WHEN NOT GIVEN, by a QB quirk that fbc's own
'' comment labels as one: at 110 baud or below the default is 2 stop bits -- or
'' 1.5 if the data length is 5 -- and 1 above that. The derivation runs AFTER
'' the whole option list, so it sees the final speed and data-bit values however
'' they were reached.
''
'' "PE" IS TWO DIFFERENT OPTIONS DEPENDING ON WHERE IT APPEARS. In the PARITY
'' position (index 1) it means "even parity, and check it" -- a QB quirk, and
'' fbc labels it so. In the extended part it means only "check parity" and
'' leaves the parity setting alone. Same two letters, two behaviours, selected
'' by the counter.
''
'' A MALFORMED OPTION STOPS THE LOOP BUT NOT THE FUNCTION. `res` becomes
'' ILLEGALFUNCTIONCALL and the loop condition fails, but the stop-bit
'' derivation still runs and the info block is still built -- only the
'' fb_SerialOpen call is skipped, and then everything is freed. So the error
'' path allocates and frees exactly what the success path does.
''
'' RANDOM IS SILENTLY REWRITTEN TO BINARY. `OPEN "COM1:" FOR RANDOM` is not an
'' error; the mode is changed to BINARY and the access to READWRITE before
'' anything else happens. A serial port has no records to be random about.
''
'' THE WIDTH IS SET TO ZERO BEFORE THE OPEN, not after, and only on the success
'' path -- so a port that fails to open leaves the caller's handle with whatever
'' width it had. Zero means "no line wrapping", which is what a serial port
'' wants and is NOT what the LPT device's 80 means.
''
'' fb_DevSerialSetWidth FINDS ITS PORT BY HOOK-TABLE ADDRESS. It walks the file
'' table looking for handles whose `hooks` pointer is exactly this file's table
'' -- not by type, not by name -- which is why the table has to be one shared
'' object and why nothing else may ever point a handle at it. Then it compares
'' the canonical "COMn:" name. It returns 0, not an error, when the device
'' string does not parse: a caller asking the width of a nonexistent port gets
'' the same answer as one asking about a port with no width.
''
'' strcasecmp IS WRITTEN OUT rather than bound, following src/io/devfile.tiko:
'' MinGW spells it _stricmp and glibc strcasecmp, and every string it is used on
'' here is an ASCII option keyword, where a plain A-Z fold is exactly
'' equivalent.

#include once "inc/descriptors.ti"
#include once "inc/file.ti"
#include once "inc/rterror.ti"
#include once "inc/iolock.ti"
#include once "inc/sysbind.ti"

'' FB_SERIAL_PARITY and FB_SERIAL_STOP_BITS, from fb_serial.h. Plain C enums, so
'' they count from zero in declaration order.
const FB_SERIAL_PARITY_NONE_  = 0
const FB_SERIAL_PARITY_EVEN_  = 1
const FB_SERIAL_PARITY_ODD_   = 2
const FB_SERIAL_PARITY_SPACE_ = 3
const FB_SERIAL_PARITY_MARK_  = 4

const FB_SERIAL_STOP_BITS_1_   = 0
const FB_SERIAL_STOP_BITS_1_5_ = 1
const FB_SERIAL_STOP_BITS_2_   = 2

const FB_FILE_ACCESS_READWRITE_ = 3

'' FB_SERIAL_OPTIONS, from fb_serial.h: seventeen 32-bit fields, no padding
'' anywhere, and the two enums are C enums so they are ints too.
type FB_SERIAL_OPTIONS
	as uint32 uiSpeed
	as uint32 uiDataBits
	as int32  Parity
	as int32  StopBits
	as uint32 DurationCTS
	as uint32 DurationDSR
	as uint32 DurationCD
	as uint32 OpenTimeout
	as int32  SuppressRTS
	as int32  AddLF
	as int32  CheckParity
	as int32  KeepDTREnabled
	as int32  DiscardOnError
	as int32  IgnoreAllErrors
	as uint32 IRQNumber
	as uint32 TransmitBuffer
	as uint32 ReceiveBuffer
end type

#assert sizeof( FB_SERIAL_OPTIONS ) = 68

'' DEV_COM_INFO, from dev_com_private.h. The options block is EMBEDDED, not
'' pointed to -- fb_SerialOpen takes its address, so it must live as long as the
'' handle does.
type DEV_COM_INFO
	as any ptr           hSerial
	as zstring ptr       pszDevice
	as int32              iPort
	as FB_SERIAL_OPTIONS Options
end type

#if defined( __FB_64BIT__ )
	#assert sizeof( DEV_COM_INFO ) = 88
	#assert offsetof( DEV_COM_INFO, Options ) = 20
#else
	#assert sizeof( DEV_COM_INFO ) = 80
	#assert offsetof( DEV_COM_INFO, Options ) = 12
#endif

extern "c"   '' NON-FBCALL: fb_serial.h and fb_device.h declare every one of
             '' these plainly, and the win32 archive spells them without `@N`.
	declare function tkrt_DevComTestProtocolEx alias "fb_DevComTestProtocolEx" _
		( byval handle as any ptr, byval filename as zstring ptr, _
		  byval filename_len as uinteger, byval pPort as uinteger ptr ) as int32
	declare function tkrt_SerialOpen alias "fb_SerialOpen" _
		( byval handle as FB_FILE ptr, byval iPort as int32, byval options as FB_SERIAL_OPTIONS ptr, _
		  byval pszDevice as zstring ptr, byval ppvHandle as any ptr ptr ) as int32
	declare function tkrt_SerialClose alias "fb_SerialClose" _
		( byval handle as FB_FILE ptr, byval pvHandle as any ptr ) as int32
	declare function tkrt_SerialWrite alias "fb_SerialWrite" _
		( byval handle as FB_FILE ptr, byval pvHandle as any ptr, _
		  byval data_ as any ptr, byval length_ as uinteger ) as int32
	declare function tkrt_SerialRead alias "fb_SerialRead" _
		( byval handle as FB_FILE ptr, byval pvHandle as any ptr, _
		  byval data_ as any ptr, byval pLength as uinteger ptr ) as int32
	declare function tkrt_SerialGetRemaining alias "fb_SerialGetRemaining" _
		( byval handle as FB_FILE ptr, byval pvHandle as any ptr, byval pLength as int64 ptr ) as int32
end extern

extern "rtlib"   '' FBCALL: fb_ErrorSetNum is decorated on win32.
	declare function tkrt_ErrorSetNum alias "fb_ErrorSetNum" ( byval e as int32 ) as int32
end extern

'' ASCII case folding, over the option keywords only -- see the file header.
private function hCaseEq( byval a as zstring ptr, byval b as zstring ptr, byval n as integer ) as int32
	dim as uint8 ptr pa = cast( uint8 ptr, a )
	dim as uint8 ptr pb = cast( uint8 ptr, b )
	dim as integer i = 0

	do
		dim as uint8 ca = pa[i], cb = pb[i]
		if( (ca >= 97) andalso (ca <= 122) ) then ca -= 32
		if( (cb >= 97) andalso (cb <= 122) ) then cb -= 32
		if( ca <> cb ) then return 0
		'' n < 0 means "compare to the end", which is strcasecmp; n >= 0 stops
		'' after n characters, which is strncasecmp.
		if( ca = 0 ) then return 1
		i += 1
		if( (n >= 0) andalso (i >= n) ) then return 1
	loop

	return 1
end function

'' strdup IS WRITTEN OUT for the same reason strcasecmp is: the CRT binding
'' spells it _strdup on MinGW and strdup on glibc, and this is the whole of it.
'' A failed allocation returns NULL, exactly as strdup does -- and exactly as
'' fbc's caller then fails to check.
private function hStrDup( byval s as zstring ptr ) as zstring ptr
	dim as uinteger n = strlen( s )
	dim as zstring ptr p = cast( zstring ptr, malloc( n + 1 ) )
	if( p = nullptr ) then return nullptr
	memcpy( p, s, n + 1 )
	return p
end function

#define CASEEQ( s, lit )     ( hCaseEq( (s), @(lit), -1 ) <> 0 )
#define CASEEQN( s, lit, n ) ( hCaseEq( (s), @(lit), (n) ) <> 0 )

'' ------------------------------------------------------------- the six hooks
''
'' All file-local; fbc's are `static` and the archive exports none of them. Each
'' one does the same three things: take the lock, pull hSerial out of the opaque
'' block, and hand off to the platform serial driver.

private function tkort_DevComWrite cdecl _
	( byval handle as FB_FILE ptr, byval value as any ptr, byval valuelen as uinteger ) as int32

	TKORT_IOLOCK()
	dim as DEV_COM_INFO ptr pInfo = cptr( DEV_COM_INFO ptr, handle->opaque )
	dim as int32 res = tkrt_SerialWrite( handle, pInfo->hSerial, value, valuelen )
	TKORT_IOUNLOCK()
	return res
end function

'' THE WIDE WRITE CONVERTS NOTHING -- it multiplies the count by the code-unit
'' size and writes the raw bytes. So a wide PRINT # to a serial port emits
'' UTF-16LE on Windows and UTF-32LE on Linux, and the two platforms disagree by
'' design rather than by oversight.
private function tkort_DevComWriteWstr cdecl _
	( byval handle as FB_FILE ptr, byval value as wstring ptr, byval valuelen as uinteger ) as int32

	return tkort_DevComWrite( handle, value, valuelen * sizeof( wstring ) )
end function

private function tkort_DevComRead cdecl _
	( byval handle as FB_FILE ptr, byval value as any ptr, byval pValuelen as uinteger ptr ) as int32

	TKORT_IOLOCK()
	dim as DEV_COM_INFO ptr pInfo = cptr( DEV_COM_INFO ptr, handle->opaque )
	dim as int32 res = tkrt_SerialRead( handle, pInfo->hSerial, value, pValuelen )
	TKORT_IOUNLOCK()
	return res
end function

'' THE WIDE READ PASSES A **LOCAL** BYTE COUNT AND NEVER WRITES IT BACK, so the
'' caller's count is left untouched no matter how much was read. Reproduced:
'' it is fbc's, and a caller that trusted the returned count would be reading
'' whatever it asked for rather than whatever arrived.
private function tkort_DevComReadWstr cdecl _
	( byval handle as FB_FILE ptr, byval value as wstring ptr, byval pValuelen as uinteger ptr ) as int32

	dim as uinteger len_ = *pValuelen * sizeof( wstring )
	return tkort_DevComRead( handle, value, @len_ )
end function

private function tkort_DevComTell cdecl _
	( byval handle as FB_FILE ptr, byval pOffset as int64 ptr ) as int32

	TKORT_IOLOCK()
	dim as DEV_COM_INFO ptr pInfo = cptr( DEV_COM_INFO ptr, handle->opaque )
	dim as int32 res = tkrt_SerialGetRemaining( handle, pInfo->hSerial, pOffset )
	TKORT_IOUNLOCK()
	return res
end function

'' EOF IS "NOTHING WAITING", AND A FAILED QUERY IS ALSO EOF. The function
'' returns FB_TRUE when the driver could not say -- so a port that has been
'' unplugged reports end-of-file rather than an error, which is what lets a
'' read loop terminate instead of spinning.
private function tkort_DevComEof cdecl ( byval handle as FB_FILE ptr ) as int32

	dim as int64 offset_ = any

	TKORT_IOLOCK()
	dim as DEV_COM_INFO ptr pInfo = cptr( DEV_COM_INFO ptr, handle->opaque )
	dim as int32 res = tkrt_SerialGetRemaining( handle, pInfo->hSerial, @offset_ )
	if( res <> FB_RTERROR_OK ) then
		res = -1                     '' FB_TRUE
	else
		res = iif( offset_ = 0, -1, 0 )
	end if
	TKORT_IOUNLOCK()

	return res
end function

'' CLOSE FREES ONLY ON SUCCESS. If the driver refuses, the DEV_COM_INFO and its
'' device name are left allocated and the handle still points at them -- so a
'' failed close leaks rather than leaving a dangling pointer, which is the safer
'' of the two and is fbc's choice.
private function tkort_DevComClose cdecl ( byval handle as FB_FILE ptr ) as int32

	TKORT_IOLOCK()
	dim as DEV_COM_INFO ptr pInfo = cptr( DEV_COM_INFO ptr, handle->opaque )
	dim as int32 res = tkrt_SerialClose( handle, pInfo->hSerial )
	if( res = FB_RTERROR_OK ) then
		free( pInfo->pszDevice )
		free( pInfo )
	end if
	TKORT_IOUNLOCK()

	return res
end function

'' THIS TABLE'S ADDRESS IS THE DEVICE'S IDENTITY -- fb_DevSerialSetWidth below
'' searches for it by pointer. See the file header.
dim shared as FB_FILE_HOOKS tkort_hooks_dev_com = ( _
	@tkort_DevComEof, _
	@tkort_DevComClose, _
	0, _
	@tkort_DevComTell, _
	@tkort_DevComRead, _
	@tkort_DevComReadWstr, _
	@tkort_DevComWrite, _
	@tkort_DevComWriteWstr, _
	0, _
	0, _
	0, _
	0, _
	0, _
	0 )

extern "c"   '' NON-FBCALL: fb_device.h declares both plainly and the archive
             '' agrees on all three targets -- no `@N` on win32.

function tkort_DevComOpen alias "fb_DevComOpen" _
	( byval handle as FB_FILE ptr, byval filename as zstring ptr, _
	  byval filename_len as uinteger ) as int32

	dim as DEV_COM_INFO ptr info = any
	dim as zstring * 128 achDev
	dim as uint8 ptr pchPos = any, pchPosEnd = any, pchPosNext = any
	dim as zstring ptr pchPosTmp = any
	dim as uinteger i = any, port = any, uiOption = any
	dim as int32 iStopBits = -1
	dim as int32 res = FB_RTERROR_OK

	if( tkrt_DevComTestProtocolEx( handle, filename, filename_len, @port ) = 0 ) then
		return tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
	end if

	if( port > 0 ) then
		i = sprintf( @achDev, @"COM%u:", cast( int32, port ) )
	else
		'' PORT 0 MEANS THE NAME WAS NOT "COMn" -- a device path, which is
		'' copied verbatim up to its colon rather than rebuilt.
		i = cast( uinteger, cast( uint8 ptr, strchr( filename, 58 ) ) - cast( uint8 ptr, filename ) )
		strncpy( @achDev, filename, i )
	end if
	achDev[i] = 0

	TKORT_IOLOCK()

	'' RANDOM BECOMES BINARY, silently. See the file header.
	if( handle->mode = FB_FILE_MODE_RANDOM ) then
		handle->mode = FB_FILE_MODE_BINARY
		handle->access = FB_FILE_ACCESS_READWRITE_
	end if

	info = cptr( DEV_COM_INFO ptr, calloc( 1, sizeof( DEV_COM_INFO ) ) )
	info->iPort = cast( int32, port )
	info->pszDevice = hStrDup( @achDev )

	'' QB's DEFAULTS, not anything modern. See the file header.
	info->Options.uiSpeed = 300
	info->Options.Parity = FB_SERIAL_PARITY_EVEN_
	info->Options.uiDataBits = 7
	info->Options.DurationCTS = 1000
	info->Options.DurationDSR = 1000

	pchPos = cast( uint8 ptr, strchr( filename, 58 ) )
	pchPos += 1

	uiOption = 0
	while( (res = FB_RTERROR_OK) andalso (pchPos[0] <> 0) )
		dim as uinteger uiOptionLength = any
		dim as zstring ptr pszOption = any

		while( (pchPos[0] = 32) orelse (pchPos[0] = 9) )
			pchPos += 1
		wend

		if( pchPos[0] = 0 ) then exit while

		if( pchPos[0] = 44 ) then       '' ','
			'' AN EMPTY FIELD STILL COUNTS -- see the file header.
			uiOption += 1
			pchPos += 1
			continue while
		end if

		pchPosNext = cast( uint8 ptr, strchr( cast( zstring ptr, pchPos ), 44 ) )
		if( pchPosNext = nullptr ) then
			pchPosNext = cast( uint8 ptr, filename ) + filename_len
			pchPosEnd = pchPosNext - 1
		else
			pchPosEnd = pchPosNext - 1
			pchPosNext += 1
		end if

		while( (pchPosEnd[0] = 32) orelse (pchPosEnd[0] = 9) )
			pchPosEnd -= 1
		wend
		pchPosEnd += 1

		uiOptionLength = cast( uinteger, pchPosEnd - pchPos )
		pszOption = cast( zstring ptr, malloc( uiOptionLength + 1 ) )
		memcpy( pszOption, pchPos, uiOptionLength )
		pszOption[uiOptionLength] = 0

		select case uiOption
		case 0
			'' BAUD RATE. strtoul stops at the first character it cannot use and
			'' the test is that it consumed EVERYTHING -- so "9600x" is an error
			'' rather than 9600.
			info->Options.uiSpeed = strtoul( pszOption, @pchPosTmp, 10 )
			if( pchPosTmp[0] <> 0 ) then res = tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )

		case 1
			'' PARITY. "PE" here is the QB quirk -- even parity AND check it --
			'' which is not what "PE" means further along the list.
			if( CASEEQ( pszOption, "N" ) ) then
				info->Options.Parity = FB_SERIAL_PARITY_NONE_
			elseif( CASEEQ( pszOption, "E" ) ) then
				info->Options.Parity = FB_SERIAL_PARITY_EVEN_
			elseif( CASEEQ( pszOption, "PE" ) ) then
				info->Options.CheckParity = -1
				info->Options.Parity = FB_SERIAL_PARITY_EVEN_
			elseif( CASEEQ( pszOption, "O" ) ) then
				info->Options.Parity = FB_SERIAL_PARITY_ODD_
			elseif( CASEEQ( pszOption, "S" ) ) then
				info->Options.Parity = FB_SERIAL_PARITY_SPACE_
			elseif( CASEEQ( pszOption, "M" ) ) then
				info->Options.Parity = FB_SERIAL_PARITY_MARK_
			else
				res = tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
			end if

		case 2
			info->Options.uiDataBits = strtoul( pszOption, @pchPosTmp, 10 )
			if( pchPosTmp[0] <> 0 ) then res = tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )

		case 3
			'' STOP BITS ARE PARSED AS A **DOUBLE**, because 1.5 is a legal
			'' value, and then compared for exact equality against 1.0, 1.5 and
			'' 2.0. Those three are all exactly representable, so the equality
			'' is safe -- but it also means "1.0000001" is an error rather than
			'' being rounded.
			dim as float64 dblStopBits = strtod( pszOption, @pchPosTmp )
			if( pchPosTmp[0] <> 0 ) then
				res = tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
			else
				if( dblStopBits = 1.0 ) then
					iStopBits = FB_SERIAL_STOP_BITS_1_
				elseif( dblStopBits = 1.5 ) then
					iStopBits = FB_SERIAL_STOP_BITS_1_5_
				elseif( dblStopBits = 2.0 ) then
					iStopBits = FB_SERIAL_STOP_BITS_2_
				else
					res = tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
				end if
			end if

		case else
			'' THE EXTENDED OPTIONS, matched by name. The two-letter ones with a
			'' number take everything after the prefix; the rest are flags.
			if( CASEEQN( pszOption, "CS", 2 ) ) then
				info->Options.DurationCTS = strtoul( pszOption + 2, @pchPosTmp, 10 )
				if( pchPosTmp[0] <> 0 ) then res = tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
			elseif( CASEEQN( pszOption, "DS", 2 ) ) then
				info->Options.DurationDSR = strtoul( pszOption + 2, @pchPosTmp, 10 )
				if( pchPosTmp[0] <> 0 ) then res = tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
			elseif( CASEEQN( pszOption, "CD", 2 ) ) then
				info->Options.DurationCD = strtoul( pszOption + 2, @pchPosTmp, 10 )
				if( pchPosTmp[0] <> 0 ) then res = tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
			elseif( CASEEQN( pszOption, "OP", 2 ) ) then
				info->Options.OpenTimeout = strtoul( pszOption + 2, @pchPosTmp, 10 )
				if( pchPosTmp[0] <> 0 ) then res = tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
			elseif( CASEEQN( pszOption, "TB", 2 ) ) then
				info->Options.TransmitBuffer = strtoul( pszOption + 2, @pchPosTmp, 10 )
				if( pchPosTmp[0] <> 0 ) then res = tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
			elseif( CASEEQN( pszOption, "RB", 2 ) ) then
				info->Options.ReceiveBuffer = strtoul( pszOption + 2, @pchPosTmp, 10 )
				if( pchPosTmp[0] <> 0 ) then res = tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
			elseif( CASEEQ( pszOption, "RS" ) ) then
				info->Options.SuppressRTS = -1
			elseif( CASEEQ( pszOption, "LF" ) ) then
				info->Options.AddLF = -1
			elseif( CASEEQ( pszOption, "ASC" ) ) then
				info->Options.AddLF = -1
			elseif( CASEEQ( pszOption, "BIN" ) ) then
				info->Options.AddLF = 0
			elseif( CASEEQ( pszOption, "PE" ) ) then
				'' AND HERE "PE" MEANS ONLY "check parity" -- see the header.
				info->Options.CheckParity = -1
			elseif( CASEEQ( pszOption, "DT" ) ) then
				info->Options.KeepDTREnabled = -1
			elseif( CASEEQ( pszOption, "FE" ) ) then
				info->Options.DiscardOnError = -1
			elseif( CASEEQ( pszOption, "ME" ) ) then
				info->Options.IgnoreAllErrors = -1
			elseif( CASEEQN( pszOption, "IR", 2 ) ) then
				info->Options.IRQNumber = strtoul( pszOption + 2, @pchPosTmp, 10 )
				if( pchPosTmp[0] <> 0 ) then res = tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
			else
				res = tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
			end if
		end select

		pchPos = pchPosNext
		free( pszOption )
		uiOption += 1
	wend

	'' THE STOP-BIT DERIVATION RUNS EVEN AFTER AN ERROR, and sees the final
	'' speed and data-bit values. See the file header.
	if( iStopBits = -1 ) then
		if( info->Options.uiSpeed <= 110 ) then
			if( info->Options.uiDataBits = 5 ) then
				iStopBits = FB_SERIAL_STOP_BITS_1_5_
			else
				iStopBits = FB_SERIAL_STOP_BITS_2_
			end if
		else
			iStopBits = FB_SERIAL_STOP_BITS_1_
		end if
	end if
	info->Options.StopBits = iStopBits

	if( res = FB_RTERROR_OK ) then
		'' ZERO, not 80 -- a serial port does not wrap. See the file header.
		handle->width = 0
		res = tkrt_SerialOpen( handle, info->iPort, @info->Options, info->pszDevice, @info->hSerial )
	end if

	if( res = FB_RTERROR_OK ) then
		handle->hooks = @tkort_hooks_dev_com
		handle->opaque = info
		handle->type_ = FB_FILE_TYPE_SERIAL
	else
		if( info->pszDevice <> nullptr ) then free( info->pszDevice )
		free( info )
	end if

	TKORT_IOUNLOCK()

	return res
end function

'' FINDS THE PORT BY HOOK-TABLE ADDRESS -- see the file header on why that makes
'' the table's identity part of the contract.
''
'' A FAILED PARSE RETURNS 0, NOT AN ERROR CODE. That is the opposite of
'' fb_DevPrinterSetWidth in src/io/devlptopen.tiko, which returns
'' ILLEGALFUNCTIONCALL for the same condition. The two functions have the same
'' shape, the same three parameters and different failure conventions; the
'' asymmetry is fbc's.
function tkort_DevSerialSetWidth alias "fb_DevSerialSetWidth" _
	( byval pszDevice as zstring ptr, byval width_ as int32, byval default_width as int32 ) as int32

	dim as int32 cur = iif( default_width = -1, 0, default_width )
	dim as uinteger i = any, port = any
	dim as zstring * 128 achDev

	if( tkrt_DevComTestProtocolEx( nullptr, pszDevice, strlen( pszDevice ), @port ) = 0 ) then
		return 0
	end if

	'' UNCONDITIONALLY REBUILT AS "COMn:", even when the parse reported port 0 --
	'' which then searches for the literal "COM0:" and finds nothing. The open
	'' path above has a second branch for that case; this one does not.
	i = sprintf( @achDev, @"COM%u:", cast( int32, port ) )
	achDev[i] = 0

	for j as integer = 0 to FB_MAX_FILES - 1
		dim as FB_FILE ptr tmp_handle = TKORT_FILETB() + j
		if( (tmp_handle->hooks = @tkort_hooks_dev_com) andalso _
		    (tmp_handle->redirection_to = nullptr) ) then
			dim as DEV_COM_INFO ptr tmp_info = cptr( DEV_COM_INFO ptr, tmp_handle->opaque )
			if( strcmp( tmp_info->pszDevice, @achDev ) = 0 ) then
				if( width_ <> -1 ) then tmp_handle->width = width_
				cur = tmp_handle->width
				exit for
			end if
		end if
	next

	return cur
end function

end extern
