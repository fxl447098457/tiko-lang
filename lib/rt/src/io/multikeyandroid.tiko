'' multikeyandroid.tiko -- io/multikeyposix's console-keyboard backend on Android: none.
'' #INCLUDED by io/multikeyposix.tiko, never compiled on its own and not in build/sources.txt.
''
'' Android has no Linux virtual console for MULTIKEY to read: no /dev/tty0 a program may open
'' and no KDGKBMODE to switch. fbc's rtlib builds its console-keyboard code under HOST_LINUX
'' only, which its Android build does not define (docs/tiko-android FACTS), so MULTIKEY there
'' sees nothing; this is that answer, the same one Darwin gives (multikeydarwin.tiko).

#if defined( __FB_ANDROID__ )

private function hOsKbConsoleInit( ) as int32
	return -1
end function

private sub hOsKbConsoleExit( )
end sub

private sub hOsKbConsoleGfx( byval gfx as int32 )
end sub

#endif
