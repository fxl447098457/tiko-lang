'' lprint.tiko -- the LPRINT family. Fifteen entry points across eleven fbc
'' members, and PORTABLE: every one of them is the corresponding PRINT with two
'' differences, and neither is per-platform.
''
'' THE TWO DIFFERENCES ARE THE WHOLE FILE:
''
''   1. fb_LPrintInit( ) runs first, opening the printer channel if it is not
''      already open. It returns an error code that every one of these entry
''      points except LPrintUsingInit THROWS AWAY -- LPRINT to a printer that
''      cannot be opened prints nothing and does not raise. Reproduced, not
''      improved: a program that relies on LPRINT being harmless without a
''      printer would start failing.
''
''   2. FB_PRINT_NEWLINE becomes FB_PRINT_BIN_NEWLINE. A printer channel is a
''      BINARY channel, so the runtime must emit CR LF itself rather than
''      letting the device translate a bare LF -- which is what the text path
''      does and what a printer would render as a line with no carriage return.
''
'' THE PRINTER'S CHANNEL NUMBER IS THE CALLER'S. Every entry point takes `fnum`
'' and passes it on; nothing here knows which channel the printer is. That is
'' why these are separate entry points rather than a flag on PRINT: the compiler
'' emits the LPRINT form, and the CHANNEL is resolved by fb_LPrintInit against
'' the caller's own state.
''
'' fb_LPrintInit STAYS fbc's -- it lives in file_openlpt.o, which also owns the
'' printer channel itself, and tiko-rt does not own the printer device.

#include once "inc/descriptors.ti"
#include once "inc/file.ti"
#include once "inc/print.ti"
#include once "inc/rterror.ti"

extern "rtlib"
	'' fbc's own: file_openlpt.o.
	declare function tkrt_LPrintInit TKORT_CDECL alias "fb_LPrintInit" ( ) as int32

	'' tiko-rt's own, in io/print.tiko, io/print_wstr.tiko and io/printusg.tiko.
	declare sub tkrt_PrintStringEx TKORT_CDECL alias "fb_PrintStringEx" _
		( byval h as FB_FILE ptr, byval s as FBSTRING ptr, byval mask as int32 )
	declare sub tkrt_PrintFixStringEx TKORT_CDECL alias "fb_PrintFixStringEx" _
		( byval h as FB_FILE ptr, byval s as zstring ptr, byval mask as int32 )
	declare sub tkrt_PrintVoidEx TKORT_CDECL alias "fb_PrintVoidEx" ( byval h as FB_FILE ptr, byval mask as int32 )
	declare sub tkrt_PrintWstrEx TKORT_CDECL alias "fb_PrintWstrEx" _
		( byval h as FB_FILE ptr, byval s as wstring ptr, byval mask as int32 )
	declare sub tkrt_PrintFixString alias "fb_PrintFixString" _
		( byval fnum as int32, byval s as zstring ptr, byval mask as int32 )
	declare function tkrt_PrintUsingInit alias "fb_PrintUsingInit" ( byval fmtstr as FBSTRING ptr ) as int32
	declare sub tkrt_PrintPadEx TKORT_CDECL alias "fb_PrintPadEx" ( byval h as FB_FILE ptr, byval mask as int32 )
end extern

'' fb_hFloat2Str's ADDBLANK flag, the leading space a positive number carries.
const TKORT_F2A_ADDBLANK = 1

extern "c"   '' NON-FBCALL: internal formatting helpers, declared plain.
	declare function tkrt_sprintf alias "sprintf" _
		( byval buf as zstring ptr, byval fmt as zstring ptr, ... ) as int32
	declare function tkrt_Float2Str alias "fb_hFloat2Str" _
		( byval v as float64, byval buf as zstring ptr, byval digits as int32, byval mask as int32 ) as zstring ptr
	declare function tkrt_hBoolToStr TKORT_FBCALL alias "fb_hBoolToStr" ( byval n as int8 ) as zstring ptr
	'' fb_hFilePrintBufferEx, NOT fb_PrintBufferEx. The two exist and both link:
	'' the first writes to a FILE handle and the second to the CONSOLE buffer. The
	'' wrong one was aliased here first, and the numeric LPRINTs went to the
	'' console path and set ERR=3 where fbc sets 1 -- caught by the differential,
	'' which is the only thing that could have caught it, since both names are
	'' real and the program links either way.
	declare function tkrt_PrintBufferEx alias "fb_hFilePrintBufferEx" _
		( byval h as FB_FILE ptr, byval s as zstring ptr, byval len_ as uinteger ) as int32
end extern

'' NEWLINE -> BIN_NEWLINE. A printer channel is binary, so the CR LF is the
'' runtime's job.
private function hBinNewline( byval mask as int32 ) as int32
	if( (mask and FB_PRINT_NEWLINE) <> 0 ) then
		return (mask and (not FB_PRINT_NEWLINE)) or FB_PRINT_BIN_NEWLINE
	end if
	return mask
end function

'' The same shape as io/print.tiko's PRINTNUM, over the printer channel. It is
'' repeated rather than shared because the mask conversion has to happen BEFORE
'' the format string is chosen -- the newline the buffer ends with is selected
'' from the converted mask, so calling PRINT's macro with a converted mask would
'' work only by accident of the two macros staying identical.
#macro LPRINTNUM( fnum, val, mask, fmt )
	scope
		dim as zstring * 80 buffer
		dim as int32 n = any
		dim as FB_FILE ptr __h = TKORT_FILE_TO_HANDLE( fnum )
		if( ((mask) and FB_PRINT_APPEND_SPACE) <> 0 ) then
			if( ((mask) and FB_PRINT_BIN_NEWLINE) <> 0 ) then
				n = tkrt_sprintf( @buffer, fmt + " " + TKORT_BIN_NEWLINE, val )
			else
				n = tkrt_sprintf( @buffer, fmt + " ", val )
			end if
		else
			if( ((mask) and FB_PRINT_BIN_NEWLINE) <> 0 ) then
				n = tkrt_sprintf( @buffer, fmt + TKORT_BIN_NEWLINE, val )
			else
				n = tkrt_sprintf( @buffer, fmt, val )
			end if
		end if

		tkrt_PrintBufferEx( __h, @buffer, n )

		if( ((mask) and FB_PRINT_PAD) <> 0 ) then tkrt_PrintPadEx( __h, mask )
	end scope
#endmacro

extern "rtlib"

'' ------------------------------------------------------------------ strings

sub tkort_LPrintString alias "fb_LPrintString" _
	( byval fnum as int32, byval s as FBSTRING ptr, byval mask as int32 )
	tkrt_LPrintInit( )
	tkrt_PrintStringEx( TKORT_FILE_TO_HANDLE( fnum ), s, hBinNewline( mask ) )
end sub

sub tkort_LPrintFixString alias "fb_LPrintFixString" _
	( byval fnum as int32, byval s as zstring ptr, byval mask as int32 )
	tkrt_LPrintInit( )
	tkrt_PrintFixStringEx( TKORT_FILE_TO_HANDLE( fnum ), s, hBinNewline( mask ) )
end sub

sub tkort_LPrintWstr alias "fb_LPrintWstr" _
	( byval fnum as int32, byval s as wstring ptr, byval mask as int32 )
	tkrt_LPrintInit( )
	tkrt_PrintWstrEx( TKORT_FILE_TO_HANDLE( fnum ), s, hBinNewline( mask ) )
end sub

sub tkort_LPrintVoid alias "fb_LPrintVoid" ( byval fnum as int32, byval mask as int32 )
	tkrt_LPrintInit( )
	tkrt_PrintVoidEx( TKORT_FILE_TO_HANDLE( fnum ), hBinNewline( mask ) )
end sub

'' ------------------------------------------------------------------ numbers
''
'' THE LEADING SPACE IS PART OF THE FORMAT: "% d" for signed and "%u" for
'' unsigned, so a signed LPRINT gets a leading blank and an unsigned one does
'' not. APPEND_SPACE adds a TRAILING one, which is a different space in a
'' different place.

sub tkort_LPrintInt alias "fb_LPrintInt" _
	( byval fnum as int32, byval v as int32, byval mask as int32 )
	tkrt_LPrintInit( )
	mask = hBinNewline( mask )
	LPRINTNUM( fnum, v, mask, "% d" )
end sub

sub tkort_LPrintUInt alias "fb_LPrintUInt" _
	( byval fnum as int32, byval v as uint32, byval mask as int32 )
	tkrt_LPrintInit( )
	mask = hBinNewline( mask )
	LPRINTNUM( fnum, v, mask, "%u" )
end sub

sub tkort_LPrintShort alias "fb_LPrintShort" _
	( byval fnum as int32, byval v as int16, byval mask as int32 )
	tkrt_LPrintInit( )
	mask = hBinNewline( mask )
	LPRINTNUM( fnum, cast( int32, v ), mask, "% d" )
end sub

sub tkort_LPrintUShort alias "fb_LPrintUShort" _
	( byval fnum as int32, byval v as uint16, byval mask as int32 )
	tkrt_LPrintInit( )
	mask = hBinNewline( mask )
	LPRINTNUM( fnum, cast( uint32, v ), mask, "%u" )
end sub

sub tkort_LPrintByte alias "fb_LPrintByte" _
	( byval fnum as int32, byval v as int8, byval mask as int32 )
	tkrt_LPrintInit( )
	mask = hBinNewline( mask )
	LPRINTNUM( fnum, cast( int32, v ), mask, "% d" )
end sub

sub tkort_LPrintUByte alias "fb_LPrintUByte" _
	( byval fnum as int32, byval v as uint8, byval mask as int32 )
	tkrt_LPrintInit( )
	mask = hBinNewline( mask )
	LPRINTNUM( fnum, cast( uint32, v ), mask, "%u" )
end sub

sub tkort_LPrintLongint alias "fb_LPrintLongint" _
	( byval fnum as int32, byval v as int64, byval mask as int32 )
	tkrt_LPrintInit( )
	mask = hBinNewline( mask )
	LPRINTNUM( fnum, v, mask, "% lld" )
end sub

sub tkort_LPrintULongint alias "fb_LPrintULongint" _
	( byval fnum as int32, byval v as uint64, byval mask as int32 )
	tkrt_LPrintInit( )
	mask = hBinNewline( mask )
	LPRINTNUM( fnum, v, mask, "%llu" )
end sub

'' A BOOLEAN PRINTS AS A WORD, not as a number: "true" or "false" through
'' fb_hBoolToStr, formatted with "%s".
sub tkort_LPrintBool alias "fb_LPrintBool" _
	( byval fnum as int32, byval v as int8, byval mask as int32 )
	tkrt_LPrintInit( )
	mask = hBinNewline( mask )
	LPRINTNUM( fnum, tkrt_hBoolToStr( v ), mask, "%s" )
end sub

'' ----------------------------------------------------------- floating point
''
'' NOT through LPRINTNUM. A float is rendered by fb_hFloat2Str, which applies
'' FreeBASIC's own significant-digit rules -- 7 for SINGLE and 16 for DOUBLE --
'' and then goes out as a FIXED STRING. Handing "%g" to sprintf here would give
'' C's rounding and C's exponent form, neither of which is what PRINT produces.
''
'' TKORT_F2A_ADDBLANK is the leading space, the same one "% d" carries for integers.

sub tkort_LPrintSingle alias "fb_LPrintSingle" _
	( byval fnum as int32, byval v as float32, byval mask as int32 )
	dim as zstring * (8 + 1 + 9 + 1) buffer = any
	tkrt_LPrintInit( )
	tkrt_PrintFixString( fnum, tkrt_Float2Str( cast( float64, v ), @buffer, 7, TKORT_F2A_ADDBLANK ), _
	                     hBinNewline( mask ) )
end sub

sub tkort_LPrintDouble alias "fb_LPrintDouble" _
	( byval fnum as int32, byval v as float64, byval mask as int32 )
	dim as zstring * (16 + 1 + 9 + 1) buffer = any
	tkrt_LPrintInit( )
	tkrt_PrintFixString( fnum, tkrt_Float2Str( v, @buffer, 16, TKORT_F2A_ADDBLANK ), _
	                     hBinNewline( mask ) )
end sub

'' ------------------------------------------------------------- PRINT USING
''
'' THE ONLY ONE THAT PROPAGATES fb_LPrintInit's ERROR. Every other entry point
'' here discards it, because LPRINT to an unopenable printer is silently
'' nothing; USING has to report, because its return value is what the compiler
'' tests before emitting the rest of the statement.

function tkort_LPrintUsingInit alias "fb_LPrintUsingInit" ( byval fmtstr as FBSTRING ptr ) as int32
	dim as int32 res = tkrt_LPrintInit( )
	if( res <> FB_RTERROR_OK ) then return res
	return tkrt_PrintUsingInit( fmtstr )
end function

end extern
