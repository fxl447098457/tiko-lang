'' fileinput.tiko -- INPUT #, LINE INPUT #, PRINT #, RESET and the put-back
'' buffer's wide half. Fifteen symbols across ten fbc members, and portable.
''
'' INPUT # IS A TOKENISER WITH A STATE BLOCK IN THREAD-LOCAL STORAGE. `INPUT #1,
'' a, b, c` lowers to one fb_FileInput -- which records the handle in the TLS
'' FB_INPUTCTX -- followed by one fb_FileInputNextToken per variable. The context
'' is per-thread because two threads reading two channels must not share a
'' position, and it is TLS rather than a parameter because fbc's codegen has no
'' place to thread one through.
''
'' THE SAME TOKENISER SERVES CONSOLE INPUT, and that is what the `handle = NULL`
'' branch is for: console INPUT fills ctx->str with a whole line first and the
'' tokeniser walks that string by index. One function, two sources, and the test
'' `FB_HANDLE_USED( ctx->handle )` is what picks between them.
''
'' d AND D BECOME e AND E, DELIBERATELY. QBASIC wrote double-precision exponents
'' as `1D5`; strtod accepts that only on Windows. The tokeniser increments the
'' character -- 'd' + 1 is 'e' -- so the number reaches strtod in a form every
'' platform parses. It does NOT do this after an '&', because `&hD` is a hex
'' digit and not an exponent.
''
'' THE DELIMITER IS SKIPPED BY THE TOKEN THAT ENDED WITHOUT ONE. A token that
'' stopped at a comma or a newline has already consumed it and sets skipdelim
'' false; a token that stopped for any other reason has not, so hSkipDelimiter
'' runs and eats the comma, the LF, or the CR LF pair. Getting this inverted
'' gives an INPUT that reads every second field.
''
'' LINE INPUT HAS TWO IMPLEMENTATIONS AND PICKS BY WHAT THE DEVICE OFFERS. A
'' device with pfnReadLine gets it directly; one with only pfnRead and pfnEof
'' gets the slow VFS path that reads ONE BYTE AT A TIME and assembles the line
'' itself. The slow path exists because a VFS device need not implement
'' ReadLine at all -- and it is where the CR-not-followed-by-LF put-back lives.
''
'' THE SLOW PATH BUILDS THE RESULT IN 1024-BYTE PIECES, assigning the first and
'' CONCATENATING the rest, so a line longer than the buffer still comes out
'' whole. The temporary descriptor is built with the length PLUS ONE so that
'' embedded NULs survive -- a line containing a NUL is a line, and strlen would
'' truncate it.
''
'' PRINT # GOES THROUGH fb_FilePutDataEx, NOT THROUGH THE WRITE HOOK, because
'' PRINT has to honour the channel's encoding, its width and its put-back state.
'' Both spellings first call fb_DevScrnInit_Write, which is what links the SCREEN
'' device's writer into the shared hook table for a program whose only output is
'' PRINT #.
''
'' THE WIDE PUT-BACK BUFFER IS FOUR BYTES, AND A WCHAR IS TWO OR FOUR. On Linux
'' ONE wide character fills it exactly and a second is error 3; on Windows two
'' fit. That asymmetry is real and observable, and it is not a bug to be fixed
'' here.

#include once "inc/descriptors.ti"
#include once "inc/file.ti"
#include once "inc/iolock.ti"
#include once "inc/rterror.ti"
#include once "inc/thread.ti"
#include once "inc/sysbind.ti"

'' NOT `TKORT_EOF`: FreeBASIC's own crt/stdio.bi ALREADY defines it, as
'' `#define TKORT_EOF (-1)` -- the same trailing-underscore convention this project
'' uses for keyword collisions, applied to the same keyword. Redefining it
'' expands to `const (-1) = -1` and reports "Expected identifier, found '('",
'' which names neither the macro nor the header it came from.
const TKORT_EOF = -1

'' (FB_WCHAR)-1: &hFFFF on Windows, &hFFFFFFFF on Linux. Comparing against -1 as
'' an integer would never match on the narrower target.
#if sizeof( wstring ) = 2
	const TKORT_WEOF as uint32 = &h0000FFFFu
#else
	const TKORT_WEOF as uint32 = &hFFFFFFFFu
#endif

'' fb_file.h:
''
''     FB_FILE *handle;  int status;  FBSTRING str;  int index;
''
'' THE PADDING IS EXPLICIT because FBSTRING is declared `field = 1` in
'' descriptors.ti -- packed, alignment 1 -- so a FreeBASIC type embedding it
'' would place it four bytes early on 64-bit where the C compiler aligns it to
'' eight. The same mistake put __fb_ctx.null_desc four bytes early once already.
'' The asserts are what hold it.
type FB_INPUTCTX field = 1
	as FB_FILE ptr handle
	as int32        status
	#if defined( __FB_64BIT__ )
		'' THE PADS ARE 64-BIT ONLY: they stand for the hole the 8-aligned
		'' FBSTRING leaves after two 4-byte fields, and on win32 there is none.
		'' fbc calls this `index`, and it is a C `int` -- genuinely 32-bit, not a
		'' pointer-width index. Renamed because the index-width lint matches on the
		'' NAME and is right to, and because a struct field mirroring an int is the
		'' one case where `as long` is the correct spelling. Same exemption as
		'' FB_FILE.reclen in inc/file.ti.
		as int32    pad0_
	#endif
	as FBSTRING    str_
	as int32        cursor
	#if defined( __FB_64BIT__ )
		as int32    pad1_
	#endif
end type

#if defined( __FB_64BIT__ )
	#assert sizeof( FB_INPUTCTX ) = 48
	#assert offsetof( FB_INPUTCTX, str_ )   = 16
	#assert offsetof( FB_INPUTCTX, cursor ) = 40
#else
	#assert sizeof( FB_INPUTCTX ) = 24
	#assert offsetof( FB_INPUTCTX, str_ )   = 8
	#assert offsetof( FB_INPUTCTX, cursor ) = 20
#endif

const BUFFER_LEN = 1024

'' fb_hFileLineInputEx's three states. eIM_Invalid is not a failure to detect --
'' it is a device with neither ReadLine nor Read+Eof, which is error 1.
const eIM_Invalid  = 0
const eIM_ReadLine = 1
const eIM_Read     = 2

extern "rtlib"
	declare function tkrt_ErrorSetNum alias "fb_ErrorSetNum" ( byval e as int32 ) as int32
	declare sub tkrt_StrDelete alias "fb_StrDelete" ( byval s as FBSTRING ptr )
	declare function tkrt_StrAssign alias "fb_StrAssign" _
		( byval dst as any ptr, byval dst_size as integer, _
		  byval src as any ptr, byval src_size as integer, byval fill_rem as int32 ) as any ptr
	declare function tkrt_StrConcatAssign alias "fb_StrConcatAssign" _
		( byval dst as any ptr, byval dst_size as integer, _
		  byval src as any ptr, byval src_size as integer, byval fillrem as int32 ) as any ptr
	declare sub tkrt_DevScrnInit_Write TKORT_CDECL alias "fb_DevScrnInit_Write" ( )
	declare sub tkrt_DevScrnInit_WriteWstr TKORT_CDECL alias "fb_DevScrnInit_WriteWstr" ( )
end extern

extern "c"   '' NON-FBCALL: the *Ex forms, the h-prefixed internals and the
             '' wstring length helper are all undecorated in fbc's win32 archive.
	declare function tkrt_StrAllocTempDescF TKORT_FBCALL alias "fb_StrAllocTempDescF" _
		( byval s as zstring ptr, byval length as integer ) as FBSTRING ptr
	declare function tkrt_GetDataEx alias "fb_FileGetDataEx" _
		( byval h as FB_FILE ptr, byval pos_ as int64, byval dst as any ptr, _
		  byval length as uinteger, byval bytesread as uinteger ptr, _
		  byval adjust as int32, byval is_uni as int32 ) as int32
	declare function tkrt_PutDataEx alias "fb_FilePutDataEx" _
		( byval h as FB_FILE ptr, byval pos_ as int64, byval data_ as any ptr, _
		  byval length as uinteger, byval adjust as int32, byval checkpos as int32, _
		  byval is_uni as int32 ) as int32
	declare function tkrt_PutBackEx alias "fb_FilePutBackEx" _
		( byval h as FB_FILE ptr, byval src as any ptr, byval chars as uinteger ) as int32
	declare function tkrt_hFileResetEx alias "fb_hFileResetEx" ( byval streamno as int32 ) as int32
	declare function tkrt_TlsGetCtx TKORT_FBCALL alias "fb_TlsGetCtx" _
		( byval keyid as int32, byval len_ as uinteger, byval dtor as any ptr ) as any ptr

	declare sub tkort_INPUTCTX_Destructor alias "fb_INPUTCTX_Destructor" ( byval data_ as any ptr )
end extern

'' FB_TLSGETCTX( INPUT ), spelled out -- FreeBASIC's macros cannot paste the
'' three names the C macro builds from one argument.
#define TKORT_TLSGET_INPUT() _
	cptr( FB_INPUTCTX ptr, tkrt_TlsGetCtx( FB_TLSKEY_INPUT, sizeof( FB_INPUTCTX ), _
	                                       @tkort_INPUTCTX_Destructor ) )

'' ------------------------------------------------------------------ RESET

extern "rtlib"

'' EVERY OPEN CHANNEL IS CLOSED AND THE WHOLE TABLE IS ZEROED -- and the flag is
'' cleared FIRST, so that a close hook which itself opens something cannot
'' recurse. A program that never opened a file skips all of it.
sub tkort_FileReset alias "fb_FileReset" ( )

	if( TKORT_DO_FILE_RESET() = FB_FALSE ) then exit sub
	TKORT_DO_FILE_RESET() = FB_FALSE

	TKORT_IOLOCK()

	for i as integer = 1 to (FB_MAX_FILES - FB_RESERVED_FILES)
		dim as FB_FILE ptr h = TKORT_FILE_TO_HANDLE_VALID( i )
		if( h->hooks <> nullptr ) then h->hooks->pfnClose( h )
	next

	memset( TKORT_FILE_TO_HANDLE_VALID( 1 ), 0, _
	        sizeof( FB_FILE ) * (FB_MAX_FILES - FB_RESERVED_FILES) )

	TKORT_IOUNLOCK()
end sub

'' 0 IS stdin AND 1 IS stdout, and nothing else is valid. This recovers the
'' standard streams after a program redirected them itself.
sub tkort_FileResetEx alias "fb_FileResetEx" ( byval streamno as int32 )

	dim as int32 errnum = any

	TKORT_IOLOCK()

	select case streamno
	case 0, 1
		errnum = iif( tkrt_hFileResetEx( streamno ) <> 0, FB_RTERROR_OK, FB_RTERROR_FILEIO )
	case else
		errnum = FB_RTERROR_ILLEGALFUNCTIONCALL
	end select

	TKORT_IOUNLOCK()

	'' Set OUTSIDE the lock, exactly as fbc does -- fb_ErrorSetNum touches
	'' thread-local state and does not need the I/O lock.
	tkrt_ErrorSetNum( errnum )
end sub

end extern

'' ------------------------------------------------------------------ PRINT #

extern "c"   '' NON-FBCALL: fb_print.h declares both plainly.

'' fb_DevScrnInit_Write FIRST. It is what links the SCREEN device's writer into
'' the shared hook table, and PRINT # to channel 0 is the only path some programs
'' ever take.
function tkort_hFilePrintBufferEx alias "fb_hFilePrintBufferEx" _
	( byval h as FB_FILE ptr, byval buffer as any ptr, byval length_ as uinteger ) as int32

	tkrt_DevScrnInit_Write( )
	return tkrt_PutDataEx( h, 0, buffer, length_, FB_TRUE, FB_TRUE, FB_FALSE )
end function

'' THE LENGTH COMES FROM strlen HERE, so this spelling cannot print an embedded
'' NUL. The *Ex form takes an explicit length and can.
function tkort_hFilePrintBuffer alias "fb_hFilePrintBuffer" _
	( byval fnum as int32, byval buffer as zstring ptr ) as int32

	return tkort_hFilePrintBufferEx( TKORT_FILE_TO_HANDLE( fnum ), buffer, strlen( buffer ) )
end function

function tkort_hFilePrintBufferWstrEx alias "fb_hFilePrintBufferWstrEx" _
	( byval h as FB_FILE ptr, byval buffer as wstring ptr, byval length_ as uinteger ) as int32

	tkrt_DevScrnInit_WriteWstr( )
	return tkrt_PutDataEx( h, 0, buffer, length_, FB_TRUE, FB_TRUE, FB_TRUE )
end function

'' wcslen, NOT fb_wstr_Len. fb_unicode.h declares fb_wstr_Len as a
'' `static __inline__` wrapper around wcslen, so THERE IS NO SUCH SYMBOL in
'' fbc's archive -- calling it linked cleanly inside tiko-rt and then broke
'' EVERY test in the differential with "undefined reference to fb_wstr_Len",
'' because diff.sh links tiko-rt's objects explicitly.
function tkort_hFilePrintBufferWstr alias "fb_hFilePrintBufferWstr" _
	( byval fnum as int32, byval buffer as wstring ptr ) as int32

	return tkort_hFilePrintBufferWstrEx( TKORT_FILE_TO_HANDLE( fnum ), buffer, _
	                                     wcslen( buffer ) )
end function

'' ------------------------------------------------------------ wide put-back

'' THE BUFFER IS FOUR BYTES AND A WCHAR IS TWO OR FOUR, so how many characters
'' fit depends on the target -- and on the channel's ENCODING, because an ASCII
'' channel stores the put-back NARROWED to one byte each while an encoded one
'' stores whole wide characters.
function tkort_FilePutBackWstrEx alias "fb_FilePutBackWstrEx" _
	( byval h as FB_FILE ptr, byval src as wstring ptr, byval chars as uinteger ) as int32

	dim as int32 res = any
	dim as uinteger bytes_ = any

	if( TKORT_HANDLE_USED( h ) = 0 ) then
		return tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
	end if

	TKORT_IOLOCK()

	res = tkrt_ErrorSetNum( FB_RTERROR_OK )

	if( h->encod <> FB_FILE_ENCOD_ASCII ) then
		bytes_ = chars * sizeof( wstring )
	else
		bytes_ = chars
	end if

	if( h->putback_size + bytes_ > TKORT_PUTBACK_BYTES ) then
		res = tkrt_ErrorSetNum( FB_RTERROR_FILEIO )
	else
		'' EXISTING CONTENT MOVES UP, NEW CONTENT GOES AT THE FRONT -- the
		'' buffer is read front-first, so the most recently pushed character
		'' must come out next.
		if( h->putback_size <> 0 ) then
			memmove( @h->putback_buffer(0) + bytes_, @h->putback_buffer(0), h->putback_size )
		end if

		h->putback_size += bytes_

		if( h->encod <> FB_FILE_ENCOD_ASCII ) then
			memcpy( @h->putback_buffer(0), src, bytes_ )
		else
			'' Narrowed one byte per character, NOT converted: the high bytes
			'' are dropped, because an ASCII channel has nowhere to put them.
			dim as uint8 ptr dst = @h->putback_buffer(0)
			dim as integer i = 0
			while( chars > 0 )
				dst[i] = cast( uint8, src[i] )
				i += 1
				chars -= 1
			wend
		end if
	end if

	TKORT_IOUNLOCK()

	return res
end function

end extern

extern "rtlib"

function tkort_FilePutBackWstr alias "fb_FilePutBackWstr" _
	( byval fnum as int32, byval src as wstring ptr, byval chars as uinteger ) as int32

	return tkort_FilePutBackWstrEx( TKORT_FILE_TO_HANDLE( fnum ), src, chars )
end function

'' ------------------------------------------------------------------ LINE INPUT

end extern

extern "rtlib"

'' Two implementations; see the file header for which device gets which.
private function hFileLineInputEx _
	( byval h as FB_FILE ptr, byval dst as any ptr, byval dst_len as integer, _
	  byval fillrem as int32 ) as int32

	dim as integer length_ = any, readlen = any
	dim as zstring * BUFFER_LEN buffer = any
	dim as uint8 ptr b = cast( uint8 ptr, @buffer )
	dim as int32 mode_ = eIM_Invalid

	if( TKORT_HANDLE_USED( h ) = 0 ) then
		return tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
	end if

	TKORT_IOLOCK()

	if( h->hooks->pfnReadLine <> nullptr ) then
		mode_ = eIM_ReadLine
	elseif( (h->hooks->pfnRead <> nullptr) andalso (h->hooks->pfnEof <> nullptr) ) then
		mode_ = eIM_Read
	end if

	select case mode_
	case eIM_Read
		'' The VFS-compatible path: one byte at a time, and slow by design.
		length_ = 0
		readlen = 0
		dim as int32 res = FB_RTERROR_OK

		while( h->hooks->pfnEof( h ) = 0 )
			dim as int32 do_add = FB_FALSE, do_break = FB_FALSE
			dim as uinteger read_len = any
			dim as uint8 ch = any

			res = tkrt_GetDataEx( h, 0, b + length_, 1, @read_len, FB_FALSE, FB_FALSE )

			if( (res = FB_RTERROR_OK) andalso (read_len = 1) ) then
				ch = b[length_]
				if( ch = 13 ) then
					'' CR: consume an LF if one follows, PUSH BACK anything
					'' else. A lone CR ends the line without eating the next
					'' character.
					res = tkrt_GetDataEx( h, 0, @ch, 1, @read_len, FB_FALSE, FB_FALSE )
					if( (res = FB_RTERROR_OK) andalso (ch <> 10) andalso (read_len = 1) ) then
						tkrt_PutBackEx( h, @ch, 1 )
					end if
					ch = 10
				end if
				if( ch = 10 ) then
					do_add = FB_TRUE
					do_break = FB_TRUE
				else
					'' Only when the buffer is exactly full -- otherwise the
					'' byte just accumulates.
					do_add = iif( length_ = (BUFFER_LEN - 1), FB_TRUE, FB_FALSE )
				end if
			else
				do_add = iif( length_ <> 0, FB_TRUE, FB_FALSE )
			end if

			if( (do_add <> FB_FALSE) orelse (h->hooks->pfnEof( h ) <> 0) ) then
				'' LENGTH PLUS ONE, so embedded NULs survive: the temp
				'' descriptor is built from a byte count, not from strlen.
				b[length_] = 0
				dim as FBSTRING ptr src = tkrt_StrAllocTempDescF( @buffer, length_ + 1 )
				if( readlen = 0 ) then
					tkrt_StrAssign( dst, dst_len, src, -1, fillrem )
				else
					tkrt_StrConcatAssign( dst, dst_len, src, -1, fillrem )
				end if
				readlen += length_
				length_ = 0
			else
				length_ += 1
			end if

			if( (res <> FB_RTERROR_OK) orelse (do_break <> FB_FALSE) ) then exit while
		wend

		'' NOTHING READ AT ALL: the destination is emptied rather than left
		'' alone, and how depends on whether it is a descriptor or a buffer.
		if( readlen = 0 ) then
			if( dst_len = -1 ) then
				tkrt_StrDelete( cast( FBSTRING ptr, dst ) )
			else
				*cast( uint8 ptr, dst ) = 0
			end if
		end if

	case eIM_ReadLine
		if( dst_len = -1 ) then
			'' A var-len destination is the hook's own output type, so it is
			'' filled directly with no copy.
			h->hooks->pfnReadLine( h, cast( FBSTRING ptr, dst ) )
		else
			'' Fixed-length or unknown: through a temporary, so that the
			'' fill-remainder rule is applied by fb_StrAssign rather than by
			'' the device.
			dim as FBSTRING str_result
			str_result.data = nullptr
			str_result.len = 0
			str_result.size = 0

			h->hooks->pfnReadLine( h, @str_result )
			tkrt_StrAssign( dst, dst_len, @str_result, -1, fillrem )
			tkrt_StrDelete( @str_result )
		end if

	case else
		TKORT_IOUNLOCK()
		return tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
	end select

	TKORT_IOUNLOCK()

	return tkrt_ErrorSetNum( FB_RTERROR_OK )
end function

function tkort_FileLineInput alias "fb_FileLineInput" _
	( byval fnum as int32, byval dst as any ptr, byval dst_len as integer, _
	  byval fillrem as int32 ) as int32

	return hFileLineInputEx( TKORT_FILE_TO_HANDLE( fnum ), dst, dst_len, fillrem )
end function

'' NO VFS FALLBACK ON THE WIDE SIDE. A device without pfnReadLineWstr is error 1
'' -- there is no byte-at-a-time reassembly for wide characters, because the
'' decoding belongs to the device.
function tkort_FileLineInputWstr alias "fb_FileLineInputWstr" _
	( byval fnum as int32, byval dst as wstring ptr, byval max_chars as integer ) as int32

	dim as FB_FILE ptr h = TKORT_FILE_TO_HANDLE( fnum )

	if( TKORT_HANDLE_USED( h ) = 0 ) then
		return tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
	end if

	if( h->hooks->pfnReadLineWstr = nullptr ) then
		return tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
	end if

	return h->hooks->pfnReadLineWstr( h, dst, max_chars )
end function

'' ------------------------------------------------------------------ INPUT #

'' Records the handle for the tokens that follow. The previous line's leftover
'' string is deleted here, not by the tokeniser.
function tkort_FileInput alias "fb_FileInput" ( byval fnum as int32 ) as int32

	TKORT_IOLOCK()

	dim as FB_FILE ptr h = TKORT_FILE_TO_HANDLE( fnum )
	if( TKORT_HANDLE_USED( h ) = 0 ) then
		TKORT_IOUNLOCK()
		return tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
	end if

	dim as FB_INPUTCTX ptr ctx = TKORT_TLSGET_INPUT()

	ctx->handle = h
	ctx->status = 0
	tkrt_StrDelete( @ctx->str_ )
	ctx->cursor = 0

	TKORT_IOUNLOCK()

	return tkrt_ErrorSetNum( FB_RTERROR_OK )
end function

end extern

extern "c"   '' NON-FBCALL: a TLS destructor and the tokeniser, both plain.

'' THE HANDLE IS NOT CLOSED HERE. It belongs to the program, and closing it when
'' a thread exits would close a channel the program is still using.
sub tkort_INPUTCTX_Destructor alias "fb_INPUTCTX_Destructor" ( byval data_ as any ptr )
	dim as FB_INPUTCTX ptr ctx = cast( FB_INPUTCTX ptr, data_ )
	tkrt_StrDelete( @ctx->str_ )
end sub

'' ------------------------------------------------------------ the tokeniser

'' Two sources, one reader. See the file header.
private function hReadChar( byval ctx as FB_INPUTCTX ptr ) as int32
	if( TKORT_HANDLE_USED( ctx->handle ) <> 0 ) then
		dim as int32 c = 0
		dim as uinteger length_ = any
		dim as int32 res = tkrt_GetDataEx( ctx->handle, 0, @c, 1, @length_, FB_FALSE, FB_FALSE )
		if( (res <> FB_RTERROR_OK) orelse (length_ = 0) ) then return TKORT_EOF
		'' MASKED TO ONE BYTE. The four-byte read target was only zeroed
		'' above; without the mask a high byte would leak into the value.
		return c and &h000000FF
	else
		if( ctx->cursor >= FB_STRSIZE( @ctx->str_ ) ) then return TKORT_EOF
		dim as uint8 ptr p = cast( uint8 ptr, ctx->str_.data )
		dim as int32 c = p[ctx->cursor]
		ctx->cursor += 1
		return c
	end if
end function

private function hUnreadChar( byval ctx as FB_INPUTCTX ptr, byval c as int32 ) as int32
	if( TKORT_HANDLE_USED( ctx->handle ) <> 0 ) then
		return tkrt_PutBackEx( ctx->handle, @c, 1 )
	else
		if( ctx->cursor <= 0 ) then return FB_FALSE
		ctx->cursor -= 1
		return FB_TRUE
	end if
end function

private function hSkipWhiteSpc( byval ctx as FB_INPUTCTX ptr ) as int32
	dim as int32 c = any
	do
		c = hReadChar( ctx )
		if( c = TKORT_EOF ) then exit do
	loop while( (c = 32) orelse (c = 9) )
	return c
end function

'' A COMMA, AN LF, A CR LF PAIR OR END OF FILE ENDS A FIELD. Anything else is
'' pushed back, because it belongs to the next one.
private sub hSkipDelimiter( byval ctx as FB_INPUTCTX ptr, byval c as int32 )

	while( (c = 32) orelse (c = 9) )
		c = hReadChar( ctx )
	wend

	select case c
	case 44, TKORT_EOF, 10          '' ',', end of file, LF
		'' consumed
	case 13                    '' CR: eat a following LF, push back anything else
		c = hReadChar( ctx )
		if( c <> 10 ) then hUnreadChar( ctx, c )
	case else
		hUnreadChar( ctx, c )
	end select
end sub

'' max_chars EXCLUDES THE TERMINATOR, and the buffer is assumed to have room for
'' it -- so a token exactly max_chars long still gets its NUL.
function tkort_FileInputNextToken alias "fb_FileInputNextToken" _
	( byval buffer as zstring ptr, byval max_chars as integer, _
	  byval is_string as int32, byval isfp as int32 ptr ) as integer

	dim as int32 c = any, isquote = FB_FALSE, hasamp = FB_FALSE, skipdelim = FB_TRUE
	dim as integer length_ = 0
	dim as uint8 ptr b = cast( uint8 ptr, buffer )
	dim as FB_INPUTCTX ptr ctx = TKORT_TLSGET_INPUT()
	dim as int32 savechar = any

	*isfp = FB_FALSE

	c = hSkipWhiteSpc( ctx )

	while( (c <> TKORT_EOF) andalso (length_ < max_chars) )

		savechar = FB_FALSE

		select case c
		case 10                          '' LF ends the field, delimiter eaten
			skipdelim = FB_FALSE
			goto done_

		case 13                          '' CR, likewise, after peeking for LF
			c = hReadChar( ctx )
			if( c <> 10 ) then hUnreadChar( ctx, c )
			skipdelim = FB_FALSE
			goto done_

		case 34                          '' '"'
			if( isquote = FB_FALSE ) then
				'' A quote only OPENS at the start of a field; one in the
				'' middle is an ordinary character.
				if( length_ = 0 ) then
					isquote = FB_TRUE
				else
					savechar = FB_TRUE
				end if
			else
				isquote = FB_FALSE
				'' The closing quote ends a STRING field and consumes one more
				'' character -- the delimiter. For a NUMERIC field it does
				'' not, because a quote there was never a quote.
				if( is_string <> 0 ) then
					c = hReadChar( ctx )
					goto done_
				end if
			end if

		case 44                          '' ',' -- a delimiter unless quoted
			if( isquote = FB_FALSE ) then
				skipdelim = FB_FALSE
				goto done_
			end if
			savechar = FB_TRUE

		case 38                          '' '&' -- a radix prefix follows
			hasamp = FB_TRUE
			savechar = FB_TRUE

		case 100, 68                     '' 'd', 'D'
			'' QBASIC'S DOUBLE EXPONENT. 'd' + 1 is 'e', and strtod accepts
			'' 'd' only on Windows -- so the character is INCREMENTED rather
			'' than replaced. Not after an '&', where D is a hex digit.
			if( (hasamp = FB_FALSE) andalso (is_string = 0) ) then c += 1
			if( hasamp = FB_FALSE ) then *isfp = FB_TRUE
			savechar = FB_TRUE

		case 101, 69, 46                 '' 'e', 'E', '.'
			if( hasamp = FB_FALSE ) then *isfp = FB_TRUE
			savechar = FB_TRUE

		case 9, 32                       '' tab, space
			'' Whitespace ends a NUMERIC field and is content inside a STRING
			'' one -- unless the string is quoted, where it is always content.
			if( isquote = FB_FALSE ) then
				if( is_string = 0 ) then goto done_
			end if
			savechar = FB_TRUE

		case else
			savechar = FB_TRUE
		end select

		if( savechar <> FB_FALSE ) then
			b[length_] = cast( uint8, c )
			length_ += 1
		end if

		c = hReadChar( ctx )
	wend

done_:
	b[length_] = 0

	if( skipdelim <> FB_FALSE ) then hSkipDelimiter( ctx, c )

	return length_
end function

end extern

'' ------------------------------------------------------- the wide tokeniser
''
'' THE SAME GRAMMAR MINUS THE NUMERIC CASES. There is no '&', no 'd'-to-'e' and
'' no isfp out-parameter: `INPUT #1, w` where w is a WSTRING reads text, and a
'' numeric INPUT goes through the narrow tokeniser and strtod. So this one only
'' has to know about quotes, commas, newlines and whitespace.
''
'' AND ITS END-OF-FILE IS A DIFFERENT VALUE. The narrow reader returns -1 as an
'' int; this one returns (FB_WCHAR)-1, which is &hFFFF on Windows and
'' &hFFFFFFFF on Linux -- so the comparison must be against a value of the
'' DESTINATION width, not against -1 as an integer.

extern "c"   '' NON-FBCALL: declared plainly in fb_file.h.

private function hReadCharW( byval ctx as FB_INPUTCTX ptr ) as uint32
	if( TKORT_HANDLE_USED( ctx->handle ) <> 0 ) then
		dim as wstring * 2 c = any
		dim as uinteger length_ = any
		dim as int32 res = tkrt_GetDataEx( ctx->handle, 0, @c, 1, @length_, FB_FALSE, FB_TRUE )
		if( (res <> FB_RTERROR_OK) orelse (length_ = 0) ) then return TKORT_WEOF
		return asc( c, 1 )
	else
		if( ctx->cursor >= FB_STRSIZE( @ctx->str_ ) ) then return TKORT_WEOF
		'' READ AS AN UNSIGNED BYTE. The console buffer is narrow, and a signed
		'' char above 127 would widen to a negative value and then to a huge
		'' code unit.
		dim as uint8 ptr p = cast( uint8 ptr, ctx->str_.data )
		dim as uint32 c = p[ctx->cursor]
		ctx->cursor += 1
		return c
	end if
end function

private function hUnreadCharW( byval ctx as FB_INPUTCTX ptr, byval c as uint32 ) as int32
	if( TKORT_HANDLE_USED( ctx->handle ) <> 0 ) then
		dim as wstring * 2 w = any
		w[0] = c
		w[1] = 0
		return tkort_FilePutBackWstrEx( ctx->handle, @w, 1 )
	else
		if( ctx->cursor <= 0 ) then return 0
		ctx->cursor -= 1
		return 1
	end if
end function

private function hSkipWhiteSpcW( byval ctx as FB_INPUTCTX ptr ) as uint32
	dim as uint32 c = any
	do
		c = hReadCharW( ctx )
		if( c = TKORT_WEOF ) then exit do
	loop while( (c = 32) orelse (c = 9) )
	return c
end function

private sub hSkipDelimiterW( byval ctx as FB_INPUTCTX ptr, byval c as uint32 )
	while( (c = 32) orelse (c = 9) )
		c = hReadCharW( ctx )
	wend

	select case c
	case 44, TKORT_WEOF, 10
		'' consumed
	case 13
		c = hReadCharW( ctx )
		if( c <> 10 ) then hUnreadCharW( ctx, c )
	case else
		hUnreadCharW( ctx, c )
	end select
end sub

'' RETURNS NOTHING, unlike the narrow one. The caller finds the length with a
'' wstring LEN, so an embedded NUL truncates a wide INPUT field where it would
'' not truncate a narrow one.
sub tkort_FileInputNextTokenWstr alias "fb_FileInputNextTokenWstr" _
	( byval buffer as wstring ptr, byval max_chars as integer, byval is_string as int32 )

	dim as uint32 c = any
	dim as int32 isquote = 0, skipdelim = FB_TRUE
	dim as integer length_ = 0
	dim as FB_INPUTCTX ptr ctx = TKORT_TLSGET_INPUT()
	dim as int32 savechar = any

	c = hSkipWhiteSpcW( ctx )

	while( (c <> TKORT_WEOF) andalso (length_ < max_chars) )

		savechar = FB_FALSE

		select case c
		case 10
			skipdelim = FB_FALSE
			goto donew_

		case 13
			c = hReadCharW( ctx )
			if( c <> 10 ) then hUnreadCharW( ctx, c )
			skipdelim = FB_FALSE
			goto donew_

		case 34                          '' '"'
			if( isquote = 0 ) then
				if( length_ = 0 ) then
					isquote = 1
				else
					savechar = FB_TRUE
				end if
			else
				isquote = 0
				if( is_string <> 0 ) then
					c = hReadCharW( ctx )
					goto donew_
				end if
			end if

		case 44                          '' ','
			if( isquote = 0 ) then
				skipdelim = FB_FALSE
				goto donew_
			end if
			savechar = FB_TRUE

		case 9, 32
			if( isquote = 0 ) then
				if( is_string = 0 ) then goto donew_
			end if
			savechar = FB_TRUE

		case else
			savechar = FB_TRUE
		end select

		if( savechar <> FB_FALSE ) then
			buffer[length_] = c
			length_ += 1
		end if

		c = hReadCharW( ctx )
	wend

donew_:
	buffer[length_] = 0

	if( skipdelim <> FB_FALSE ) then hSkipDelimiterW( ctx, c )
end sub

end extern
