'' xfocus.tiko -- fb_hXTermInitFocus, fb_hXTermExitFocus and fb_hXTermHasFocus:
'' asking X whether the terminal window has keyboard focus. Three symbols, one
'' fbc member (io_xfocus.o), POSIX only.
''
'' EMPTY-ON: win64 win32
''
'' THIS EXISTS SO MULTIKEY DOES NOT LIE. GetAsyncKeyState's POSIX counterpart
'' reads the whole keyboard, not this window's share of it, so a background
'' program would report keys the user is typing into something else. The Windows
'' side answers the same question with fb_ConsoleHasFocus; on X11 it takes a
'' display connection and a window comparison.
''
'' libX11 IS LOADED WITH dlopen, NOT LINKED. A console program must start on a
'' machine with no X server at all, so the three functions are resolved at
'' runtime through fb_hDynLoad and a failure is reported rather than fatal. That
'' is why X_FUNCS is a struct of three pointers and why nothing here names an X
'' symbol at link time.
''
'' THE THREE POINTERS ARE FILLED BY ORDER, NOT BY NAME. fb_hDynLoad takes a
'' NULL-terminated array of names and an array of void* to write into, and walks
'' both in lockstep -- so the ORDER of the names must match the order of the
'' fields exactly. Swapping two names silently swaps two function pointers, and
'' the first symptom is a crash inside Xlib with a plausible-looking stack.
''
'' Window IS EIGHT BYTES ON 64-BIT, being an XID which is `unsigned long`.
'' Declaring it as a ULONG would make XGetInputFocus write four bytes into an
'' eight-byte slot and leave the top half as whatever was on the stack, so the
'' comparison in HasFocus would fail at random.
''
'' REFERENCE-COUNTED, AND THE COUNT IS CHECKED DIFFERENTLY AT EACH END: Init
'' returns early when the count is ABOVE ONE after incrementing, Exit returns
'' early when it is ABOVE ZERO after decrementing. Both mean "someone else still
'' holds it", written two ways.
''
'' AND EXIT DOES NOT CLEAR THE POINTERS. After the last release `display` still
'' holds the address of a closed connection and X still holds three function
'' pointers into an unloaded library. A HasFocus call after ExitFocus therefore
'' calls through a dangling pointer -- fbc's, reproduced, and the reason the
'' differential below does not call these in sequence.

#include once "inc/descriptors.ti"

#ifdef __FB_UNIX__

'' The file name libX11 is loaded by: TKORT_X11_LIBNAME, one per OS.
#if defined( __FB_LINUX__ )
	#include once "x11liblinux.tiko"
#elseif defined( __FB_DARWIN__ )
	#include once "x11libdarwin.tiko"
#else
	#error "io/xfocus: no libX11 name for this OS"
#endif

'' Window is an XID -- `unsigned long`, eight bytes here. See the file header.
type XWINDOW as uint64

type XOPENDISPLAY   as function cdecl ( byval name_ as zstring ptr ) as any ptr
type XCLOSEDISPLAY  as function cdecl ( byval d as any ptr ) as int32
type XGETINPUTFOCUS as function cdecl ( byval d as any ptr, byval w as XWINDOW ptr, byval revert as int32 ptr ) as int32

'' THE FIELD ORDER IS THE NAME ORDER -- see the file header. These three are
'' filled positionally by fb_hDynLoad.
type X_FUNCS
	as XOPENDISPLAY   OpenDisplay
	as XCLOSEDISPLAY  CloseDisplay
	as XGETINPUTFOCUS GetInputFocus
end type

extern "c"   '' NON-FBCALL: fbc's dynamic loader, declared plain in
             '' fb_private_hdynload.h, and still C.
	declare function tkrt_hDynLoad alias "fb_hDynLoad" _
		( byval libname as zstring ptr, byval funcname as zstring ptr ptr, _
		  byval funcptr as any ptr ptr ) as any ptr
	declare sub tkrt_hDynUnload alias "fb_hDynUnload" ( byval lib as any ptr ptr )
end extern

'' File-local state, all of it. FreeBASIC emits a module-level `dim shared` as a
'' local symbol, which is what fbc's `static` gives too.
dim shared as int32    tkort_xf_refcount = 0
dim shared as any ptr tkort_xf_xlib
dim shared as X_FUNCS tkort_xf_X
dim shared as any ptr tkort_xf_display
dim shared as XWINDOW tkort_xf_xterm_window

'' The three names, in the SAME ORDER as X_FUNCS' fields, NULL-terminated. Held
'' as real objects rather than literals because the array must outlive the call
'' and a literal's address is not something FreeBASIC will take.
dim shared as zstring * 16 tkort_xf_n0, tkort_xf_n1, tkort_xf_n2
dim shared as zstring ptr  tkort_xf_names( 0 to 3 )

extern "c"   '' NON-FBCALL: all three are declared plain and the archive agrees.

function tkort_hXTermInitFocus alias "fb_hXTermInitFocus" ( ) as int32

	dim as int32 dummy = any

	'' ABOVE ONE AFTER INCREMENTING means someone else already opened it.
	tkort_xf_refcount += 1
	if( tkort_xf_refcount > 1 ) then return 0

	'' Built here rather than at module scope so there is no dependency on
	'' module-initialisation order.
	tkort_xf_n0 = "XOpenDisplay"
	tkort_xf_n1 = "XCloseDisplay"
	tkort_xf_n2 = "XGetInputFocus"
	tkort_xf_names(0) = @tkort_xf_n0
	tkort_xf_names(1) = @tkort_xf_n1
	tkort_xf_names(2) = @tkort_xf_n2
	tkort_xf_names(3) = nullptr

	'' THE ORDER OF THESE NAMES IS THE ORDER OF X_FUNCS' FIELDS -- fb_hDynLoad
	'' walks both in lockstep and never checks that they correspond.
	tkort_xf_xlib = tkrt_hDynLoad( @TKORT_X11_LIBNAME, @tkort_xf_names(0), _
	                               cptr( any ptr ptr, @tkort_xf_X ) )
	if( tkort_xf_xlib = nullptr ) then return -1

	'' NULL asks for the display named by $DISPLAY.
	tkort_xf_display = tkort_xf_X.OpenDisplay( 0 )
	if( tkort_xf_display = nullptr ) then return -1

	'' THE WINDOW THAT HAS FOCUS RIGHT NOW is taken to be the terminal's, on the
	'' assumption that the program was just launched from it. That is the whole
	'' identification -- there is no query for "my own window", because a console
	'' program does not have one.
	tkort_xf_X.GetInputFocus( tkort_xf_display, @tkort_xf_xterm_window, @dummy )

	return 0
end function

sub tkort_hXTermExitFocus alias "fb_hXTermExitFocus" ( )

	'' ABOVE ZERO AFTER DECREMENTING means someone else still holds it.
	tkort_xf_refcount -= 1
	if( tkort_xf_refcount > 0 ) then exit sub

	'' NOTHING IS CLEARED AFTERWARDS -- see the file header. display and the
	'' three function pointers are left dangling, deliberately.
	tkort_xf_X.CloseDisplay( tkort_xf_display )
	tkrt_hDynUnload( @tkort_xf_xlib )

end sub

function tkort_hXTermHasFocus alias "fb_hXTermHasFocus" ( ) as int32

	dim as XWINDOW focus_window = any
	dim as int32 dummy = any

	tkort_xf_X.GetInputFocus( tkort_xf_display, @focus_window, @dummy )

	'' AN IDENTITY COMPARISON against the window that had focus at init.
	''
	'' RETURNS **1**, NOT -1. The C is `return (focus_window == xterm_window)`,
	'' and C's == yields 1 -- not FreeBASIC's FB_TRUE, which is -1. Every caller
	'' here tests non-zero so both would work, but the differential compares the
	'' VALUE, and fb.h defines TRUE and FB_TRUE six lines apart precisely so that
	'' this distinction can be got wrong.
	return iif( focus_window = tkort_xf_xterm_window, 1, 0 )
end function

end extern

#endif
