'' x11keys.tiko -- fb_hInitX11KeycodeToScancodeTb and the 256-byte table it
'' fills. Two symbols, one fbc member (scancodes_x11.o), POSIX only.
''
'' EMPTY-ON: win64 win32
''
'' BUILDS A KEYCODE-TO-SCANCODE TABLE AT RUNTIME, because X11 keycodes are not
'' portable. A keycode is whatever number the X server assigned to a physical
'' key on this machine; a KEYSYM is the symbol that key produces. The mapping
'' from keycode to keysym is queried from the server, and the mapping from keysym
'' to FreeBASIC scancode is the fixed table below. So this is the join of a
'' runtime query and a compile-time table, and neither half is useful alone.
''
'' EVERY X11 FUNCTION ARRIVES AS A PARAMETER, not as a link-time import. That is
'' deliberate on fbc's part: libX11 is loaded with dlopen at runtime, because a
'' console program must not fail to start on a machine with no X server. The
'' caller resolves the four symbols and passes them in.
''
'' KeySym IS EIGHT BYTES ON 64-BIT LINUX, not four. It is `unsigned long` in
'' Xlib, so the table below stores ULONGINT and the pointer walk steps by 8. A
'' ULONG table would read every second keysym as garbage and match almost
'' nothing -- and the failure would look like "this keyboard layout is not
'' supported" rather than like a bug.
''
'' THE TABLE IS SEARCHED BY SCANNING FOR A ZERO SCANCODE, NOT A ZERO KEYSYM. The
'' loop condition is `keysym_to_scancode[j].scancode && (... != keysym)`, so it
'' stops on the terminating row whose SCANCODE is 0 -- and then stores that row's
'' scancode, which is 0. An unmatched keysym therefore writes 0, correctly, by
'' falling off the end rather than by an explicit test.
''
'' TWO KEYSYMS MAP TO THE SAME SCANCODE IN SEVERAL PLACES, and one pair is
'' identical: XK_grave and XK_quoteleft are both 0x60 in X11 -- literally the
'' same number listed twice, because the header defines them as aliases. The
'' second row is unreachable. Reproduced rather than deduplicated, because the
'' row COUNT is not observable but a scan that stopped early would be.
''
'' AND THE KEYPAD SHARES SCANCODES WITH THE MAIN KEYBOARD: XK_KP_Home and
'' XK_Home both give SC_HOME, XK_KP_Divide gives SC_SLASH. So MULTIKEY cannot
'' tell the keypad from the main block on X11 -- which is the opposite of the
'' Windows side, where the two virtual keys are kept in separate columns of
'' src/io/coninput.tiko's table precisely so they can both be tested.
''
'' THE KEYCODE RANGE IS CLAMPED TO 0..255 BEFORE THE LOOP, because the table is
'' 256 bytes and an X server is free to report a wider range. Without the clamp
'' a server with keycodes above 255 would write past the table.
''
'' THE TABLE WAS GENERATED FROM fbc's SOURCE, not transcribed: a script resolved
'' all 105 XK_ and SC_ names against X11's keysymdef.h and fb_event.h. The
'' keysym values are five-digit hex constants and there are 210 of them.

#include once "inc/descriptors.ti"

#ifdef __FB_UNIX__

'' KeySym is Xlib's `unsigned long` -- EIGHT bytes here. See the file header.
type TKORT_XKROW
	as uint64 keysym
	as int32     scancode
end type

#define _XK( k, s ) type<TKORT_XKROW>( k, s )

'' The X11 callbacks, passed in rather than linked -- see the file header.
type XDISPLAYKEYCODES    as function cdecl ( byval d as any ptr, byval lo as int32 ptr, byval hi as int32 ptr ) as int32
type XGETKEYBOARDMAPPING as function cdecl ( byval d as any ptr, byval kc as uint8, byval cnt as int32, byval per as int32 ptr ) as uint64 ptr
type XFREE               as function cdecl ( byval p as any ptr ) as int32

'' GENERATED FROM fbc's SOURCE -- see the file header. 105 rows, the last being
'' the terminator the search stops on.
dim shared as TKORT_XKROW tkort_keysym_to_scancode( 0 to 104 ) = { _
	_XK( &h0000FF1B, &h01 ), _XK( &h0000FFBE, &h3B ), _
	_XK( &h0000FFBF, &h3C ), _XK( &h0000FFC0, &h3D ), _
	_XK( &h0000FFC1, &h3E ), _XK( &h0000FFC2, &h3F ), _
	_XK( &h0000FFC3, &h40 ), _XK( &h0000FFC4, &h41 ), _
	_XK( &h0000FFC5, &h42 ), _XK( &h0000FFC6, &h43 ), _
	_XK( &h0000FFC7, &h44 ), _XK( &h0000FFC8, &h57 ), _
	_XK( &h0000FFC9, &h58 ), _XK( &h0000FF14, &h46 ), _
	_XK( &h00000060, &h29 ), _XK( &h00000060, &h29 ), _
	_XK( &h0000007E, &h29 ), _XK( &h00000031, &h02 ), _
	_XK( &h00000032, &h03 ), _XK( &h00000033, &h04 ), _
	_XK( &h00000034, &h05 ), _XK( &h00000035, &h06 ), _
	_XK( &h00000036, &h07 ), _XK( &h00000037, &h08 ), _
	_XK( &h00000038, &h09 ), _XK( &h00000039, &h0A ), _
	_XK( &h00000030, &h0B ), _XK( &h0000002D, &h0C ), _
	_XK( &h0000003D, &h0D ), _XK( &h0000005C, &h2B ), _
	_XK( &h0000FF08, &h0E ), _XK( &h0000FF09, &h0F ), _
	_XK( &h00000071, &h10 ), _XK( &h00000077, &h11 ), _
	_XK( &h00000065, &h12 ), _XK( &h00000072, &h13 ), _
	_XK( &h00000074, &h14 ), _XK( &h00000079, &h15 ), _
	_XK( &h00000075, &h16 ), _XK( &h00000069, &h17 ), _
	_XK( &h0000006F, &h18 ), _XK( &h00000070, &h19 ), _
	_XK( &h0000005B, &h1A ), _XK( &h0000005D, &h1B ), _
	_XK( &h0000FF0D, &h1C ), _XK( &h0000FFE5, &h3A ), _
	_XK( &h00000061, &h1E ), _XK( &h00000073, &h1F ), _
	_XK( &h00000064, &h20 ), _XK( &h00000066, &h21 ), _
	_XK( &h00000067, &h22 ), _XK( &h00000068, &h23 ), _
	_XK( &h0000006A, &h24 ), _XK( &h0000006B, &h25 ), _
	_XK( &h0000006C, &h26 ), _XK( &h0000003B, &h27 ), _
	_XK( &h00000027, &h28 ), _XK( &h0000FFE1, &h2A ), _
	_XK( &h0000007A, &h2C ), _XK( &h00000078, &h2D ), _
	_XK( &h00000063, &h2E ), _XK( &h00000076, &h2F ), _
	_XK( &h00000062, &h30 ), _XK( &h0000006E, &h31 ), _
	_XK( &h0000006D, &h32 ), _XK( &h0000002C, &h33 ), _
	_XK( &h0000002E, &h34 ), _XK( &h0000002F, &h35 ), _
	_XK( &h0000FFE2, &h36 ), _XK( &h0000FFE3, &h1D ), _
	_XK( &h0000FFE7, &h5B ), _XK( &h0000FFE9, &h38 ), _
	_XK( &h00000020, &h39 ), _XK( &h0000FFEA, &h38 ), _
	_XK( &h0000FFE8, &h5C ), _XK( &h0000FF67, &h5D ), _
	_XK( &h0000FFE4, &h1D ), _XK( &h0000FF63, &h52 ), _
	_XK( &h0000FF50, &h47 ), _XK( &h0000FF55, &h49 ), _
	_XK( &h0000FFFF, &h53 ), _XK( &h0000FF57, &h4F ), _
	_XK( &h0000FF56, &h51 ), _XK( &h0000FF52, &h48 ), _
	_XK( &h0000FF51, &h4B ), _XK( &h0000FF54, &h50 ), _
	_XK( &h0000FF53, &h4D ), _XK( &h0000FF7F, &h45 ), _
	_XK( &h0000FFAF, &h35 ), _XK( &h0000FFAA, &h37 ), _
	_XK( &h0000FFAD, &h0C ), _XK( &h0000FF95, &h47 ), _
	_XK( &h0000FF97, &h48 ), _XK( &h0000FF9A, &h49 ), _
	_XK( &h0000FFAB, &h4E ), _XK( &h0000FF96, &h4B ), _
	_XK( &h0000FF9D, &h4C ), _XK( &h0000FF98, &h4D ), _
	_XK( &h0000FF9C, &h4F ), _XK( &h0000FF99, &h50 ), _
	_XK( &h0000FF9B, &h51 ), _XK( &h0000FF8D, &h1C ), _
	_XK( &h0000FF9E, &h52 ), _XK( &h0000FF9F, &h53 ), _
	_XK( &h00000000, &h00 ) }

'' THE DECLARATION AND THE DEFINITION MUST AGREE ON THE TYPE, so the 256 bytes
'' are wrapped in a UDT rather than declared as a bare `ubyte` and defined as an
'' array -- FreeBASIC rejects that pair with error 36. Same idiom as
'' src/error/errmsg.tiko and src/init/ctxdata.tiko.
type TKORT_X11TB
	as uint8 v( 0 to 255 )
end type

#assert sizeof( TKORT_X11TB ) = 256

extern "c"   '' NON-FBCALL: the table is DATA and the initialiser is declared
             '' plain in fb_private_scancodes_x11.h. The declaration is what
             '' gives the definition below external linkage -- a `dim shared`
             '' inside this block would be file-local.
	extern fb_x11keycode_to_scancode alias "fb_x11keycode_to_scancode" as TKORT_X11TB
end extern

'' OUTSIDE the block. 256 bytes, zero-filled, indexed by X11 keycode.
dim shared fb_x11keycode_to_scancode as TKORT_X11TB

extern "c"   '' NON-FBCALL: declared plain, and the archive agrees.

sub tkort_hInitX11KeycodeToScancodeTb alias "fb_hInitX11KeycodeToScancodeTb" _
	( byval display_ as any ptr, byval DisplayKeycodes as XDISPLAYKEYCODES, _
	  byval GetKeyboardMapping as XGETKEYBOARDMAPPING, byval Free_ as XFREE )

	dim as int32 keycode_min = any, keycode_max = any
	dim as int32 keysyms_per_keycode_return = any

	DisplayKeycodes( display_, @keycode_min, @keycode_max )

	'' CLAMPED BEFORE THE LOOP -- the table is 256 bytes and a server may report
	'' a wider range. See the file header.
	if( keycode_min < 0 ) then keycode_min = 0
	if( keycode_max > 255 ) then keycode_max = 255

	for i as int32 = keycode_min to keycode_max
		'' ONE KEYCODE AT A TIME, and the result is freed each pass -- Xlib
		'' allocates the array on every call.
		dim as uint64 ptr keysyms = GetKeyboardMapping( display_, cast( uint8, i ), 1, _
		                                                  @keysyms_per_keycode_return )

		if( keysyms <> nullptr ) then
			dim as uint64 keysym = keysyms[0]

			'' NoSymbol LEAVES THE SLOT ALONE rather than writing zero -- so a
			'' keycode the server does not map keeps whatever the table already
			'' held, which for a fresh table is zero anyway.
			if( keysym <> 0 ) then
				'' STOPS ON A ZERO **SCANCODE**, not a zero keysym, and then
				'' stores that row -- so an unmatched keysym writes 0 by falling
				'' off the end. See the file header.
				dim as integer j = 0
				while( (tkort_keysym_to_scancode(j).scancode <> 0) andalso _
				       (tkort_keysym_to_scancode(j).keysym <> keysym) )
					j += 1
				wend
				fb_x11keycode_to_scancode.v(i) = cast( uint8, tkort_keysym_to_scancode(j).scancode )
			end if

			Free_( keysyms )
		end if
	next

end sub

end extern

#endif
