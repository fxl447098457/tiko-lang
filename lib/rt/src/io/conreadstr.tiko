'' conreadstr.tiko -- fb_ConsoleReadStr. One symbol, one fbc member
'' (io_readstr.o).
''
'' THE SAME NAME OVER TWO COMPLETELY DIFFERENT AMOUNTS OF WORK.
''
''   Windows   a thin wrapper: bracket the console window, flush any events the
''             console layer had put back, and call fgets. The CRT does the line
''             editing.
''   POSIX     a HAND-WRITTEN LINE EDITOR -- read a key at a time, echo it,
''             handle backspace by moving the cursor and deleting a cell, wrap at
''             the right margin, and stop at carriage return. There is no CRT
''             line discipline to lean on once the terminal is in raw mode.
''
'' THE POSIX SIDE FALLS BACK TO fgets WHEN THE CONSOLE IS NOT INITED, and that
'' is the only reason this file is testable at all: under a harness stdin is a
'' pipe, __fb_con.inited is false, and the editor below never runs. So the
'' differential exercises the fallback on both platforms and the editor on
'' neither -- stated here rather than left implied.
''
'' THE POLLING LOOP SPINS ON TWO CONDITIONS, and both matter: fb_hGetCh returns
'' -1 when nothing is waiting, and a value ABOVE 0xFF for an extended key. The
'' loop rejects both and sleeps 10ms, so arrow keys are silently DISCARDED by
'' this editor rather than moving the cursor. That is fbc's behaviour and it is
'' why INPUT on Linux does not have history or left-arrow editing.
''
'' BACKSPACE IS THREE OPERATIONS, not one: move the cursor back (wrapping to the
'' end of the previous line, and clamping at the top-left rather than going
'' negative), emit the terminal's delete-character sequence, and drop the
'' position. Emitting a backspace character instead would move the cursor without
'' erasing the cell.
''
'' TAB IS DROPPED ENTIRELY. `else if (k != '\t')` has no tab branch, so a tab is
'' neither stored nor echoed -- it simply vanishes. Not an oversight to fix.
''
'' THE CARRIAGE RETURN IS THE TERMINATOR AND IS NOT STORED, because the `k != 13`
'' test is at the BOTTOM of the loop: the return value is processed by the body
'' first, where it fails the `pos < len - 1` guard only if the buffer is full.
'' It reaches the store branch and IS written when there is room -- then
'' overwritten by the NUL. Reproduced exactly, because the byte count matters to
'' a caller reading `len`.
''
'' AND THE LENGTH IS A CAPACITY INCLUDING THE TERMINATOR: `pos < len - 1` leaves
'' room for the NUL that follows the loop.

#include once "inc/descriptors.ti"
#include once "inc/console.ti"
#include once "inc/sysbind.ti"

extern "c"   '' NON-FBCALL: fb_private_console.h declares this one plainly, and
             '' the win32 archive confirms no `@N`.

#ifdef __FB_WIN32__

	extern "c"   '' NON-FBCALL: fbc's console-window bracket, all three still C.
		declare sub tkrt_hRestoreConsoleWindow TKORT_FBCALL alias "fb_hRestoreConsoleWindow" ( )
		'' tkrt_hUpdateConsoleWindow is NOT declared here -- inc/console.ti already
		'' provides it, and a second declaration is error 4.
		declare sub tkrt_hConsolePutBackEvents alias "fb_hConsolePutBackEvents" ( )
		'' fbc's, in io_printbuff.o -- still C, and the only way to spell
		'' FB_CON_CORRECT_POSITION.
		declare sub tkrt_ConsolePrintBufferEx alias "fb_ConsolePrintBufferEx" _
			( byval buffer as any ptr, byval l as uinteger, byval mask as int32 )
	end extern

	#include once "inc/print.ti"

function tkort_ConsoleReadStr alias "fb_ConsoleReadStr" _
	( byval buffer as zstring ptr, byval len_ as integer ) as zstring ptr

	tkrt_hRestoreConsoleWindow( )

	'' FB_CON_CORRECT_POSITION(): flush a pending end-of-line adjustment so the
	'' prompt is where the user can see it.
	if( TKORT_CON_SCROLLOFF() <> 0 ) then
		tkrt_ConsolePrintBufferEx( nullptr, 0, FB_PRINT_FORCE_ADJUST )
	end if

	'' Anything the console layer stashed goes back to the CRT before fgets
	'' reads, or the first keystroke of the line is lost.
	tkrt_hConsolePutBackEvents( )

	dim as zstring ptr res = fgets( buffer, cast( int32, len_ ), stdin )

	tkrt_hUpdateConsoleWindow( )

	return res

end function

#elseif defined( __FB_UNIX__ )

	'' SEQ_LOCATE and SEQ_DEL_CHAR, from unix/fb_private_console.h -- indices
	'' into the terminfo capability table, not escape sequences themselves.
	const SEQ_LOCATE_   = 0
	const SEQ_DEL_CHAR_ = 14

	extern "c"   '' NON-FBCALL: fbc's terminal layer and key reader, both C.
		declare function tkrt_hGetCh alias "fb_hGetCh" ( byval blocking as int32 ) as int32
		declare sub tkrt_ConsolePrintBuffer alias "fb_ConsolePrintBuffer" _
			( byval buffer as zstring ptr, byval mask as int32 )
	end extern

	extern "rtlib"   '' FBCALL: these three are decorated.
		declare sub tkrt_ConsoleGetSize alias "fb_ConsoleGetSize" _
			( byval cols as int32 ptr, byval rows as int32 ptr )
		declare sub tkrt_ConsoleGetXY alias "fb_ConsoleGetXY" _
			( byval x as int32 ptr, byval y as int32 ptr )
		declare sub tkrt_Delay alias "fb_Delay" ( byval msecs as int32 )
	end extern

function tkort_ConsoleReadStr alias "fb_ConsoleReadStr" _
	( byval buffer as zstring ptr, byval len_ as integer ) as zstring ptr

	dim as int32 k = any, x = any, y = any, cols = any
	dim as integer pos_ = 0
	dim as zstring * 2 ch = any

	ch[0] = 0 : ch[1] = 0

	'' THE FALLBACK, and the only path a harness reaches -- see the file header.
	if( TKORT_CON_L( TKORT_CON_INITED ) = 0 ) then
		return fgets( buffer, cast( int32, len_ ), stdin )
	end if

	tkrt_ConsoleGetSize( @cols, nullptr )

	do
		'' SPINS PAST -1 (nothing waiting) AND PAST EXTENDED KEYS (> 0xFF), so
		'' arrows are discarded rather than acted on. See the file header.
		do
			k = tkrt_hGetCh( -1 )
			if( (k <> -1) andalso (k <= &hFF) ) then exit do
			tkrt_Delay( 10 )
		loop

		tkrt_ConsoleGetXY( @x, @y )

		if( k = 8 ) then
			'' BACKSPACE: move, delete the cell, drop the position. Wrapping to
			'' the previous line, and clamping at the top-left.
			if( pos_ > 0 ) then
				x -= 1
				if( x <= 0 ) then
					x = cols
					y -= 1
					if( y <= 0 ) then
						x = 1
						y = 1
					end if
				end if
				tkrt_hTermOut( SEQ_LOCATE_, x - 1, y - 1 )
				tkrt_hTermOut( SEQ_DEL_CHAR_, 0, 0 )
				pos_ -= 1
			end if
		elseif( k <> 9 ) then           '' TAB IS DROPPED -- see the file header.
			if( pos_ < len_ - 1 ) then
				ch[0] = cast( uint8, k )
				buffer[pos_] = ch[0]
				pos_ += 1
				tkrt_ConsolePrintBuffer( @ch, 0 )
				'' At the right margin the terminal will not wrap on its own.
				if( x = cols ) then fputc( 10, stdout )
			end if
		end if
	loop while( k <> 13 )

	fputc( 10, stdout )
	buffer[pos_] = 0

	return buffer

end function

#else
	#error "io/conreadstr: no backend for this target"
#endif

end extern
