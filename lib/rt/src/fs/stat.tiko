'' stat.tiko -- filesystem metadata and the current directory: seven entry points
'' over one fbc member, split by platform.
''
'' GetFileAttributesExW, NOT FindFirstFileW. The latter is the common shortcut,
'' is marginally faster, and is WRONG: it fails on a volume root ("C:\"), which
'' is a path programs stat all the time.
''
'' SYMLINK DETECTION NEEDS A SECOND CALL, AND ONLY SOMETIMES.
'' GetFileAttributesExW reports FILE_ATTRIBUTE_REPARSE_POINT but not the TAG,
'' and only the tag distinguishes a symlink or junction from an arbitrary
'' reparse point (dedup, cloud placeholders). So the tag is fetched with
'' FindFirstFileW ONLY when the reparse attribute is set, which is rare.
''
'' CREATION TIME IS OFTEN ABSENT ON POSIX, and the library says so rather than
'' inventing one. st_ctime is the INODE CHANGE time, not the birth time, and
'' reporting it as "created" would be a plausible-looking lie. The birth time
'' comes from statx(STATX_BTIME) where the kernel and filesystem supply it, and
'' HAS_CTIME is left CLEAR otherwise. Windows always has all three, which is why
'' the flag exists at all.
''
'' AbsolutePath and CanonicalPath ANSWER DIFFERENT QUESTIONS and the contrast is
'' the reason both exist: AbsolutePath joins the current directory on and does
'' NOT require the path to exist (its usual caller is about to create it);
'' CanonicalPath resolves every link and REQUIRES every component to exist.
''
'' On Windows AbsolutePath is delegated to GetFullPathNameW rather than
'' reimplemented, because "the relevant current directory" is not one thing
'' there: a drive-relative "C:foo" resolves against the PER-DRIVE current
'' directory for C:, not the process one. Hand-rolling that gets it wrong for
'' exactly the path form the RFC warns about.

#include once "inc/descriptors.ti"
#include once "inc/fsdefs.ti"
#include once "inc/fserror.ti"
#include once "inc/fspath.ti"
#include once "inc/sysbind.ti"

extern "rtlib"
	declare function tkrt_FsMapOsError alias "fb_FsMapOsError" ( ) as int32
end extern

extern "c"   '' NON-FBCALL: the ustring temp builder, declared plain.
	declare function tkrt_UStrAllocTemp TKORT_FBCALL alias "fb_hUStrAllocTemp" _
		( byval s as FBUSTRING ptr, byval units as integer ) as FBUSTRING ptr
	declare sub tkrt_UStrCopy2 alias "fb_hUStrCopy" _
		( byval dst as FB_UCHAR ptr, byval src as FB_UCHAR ptr, byval units as integer )
end extern

'' Unpack a USTRING argument through FB_USTRSIZE, never ->len raw: the temp flag
'' lives in the sign bit.
private sub hUArg( byval s as FBUSTRING ptr, byval ptr_ as FB_UCHAR ptr ptr, byval len_ as integer ptr )
	static as FB_UCHAR empty_(0 to 0) = { 0 }
	if( s = nullptr ) then
		*ptr_ = @empty_(0) : *len_ = 0
	elseif( s->data = nullptr ) then
		*ptr_ = @empty_(0) : *len_ = 0
	else
		*ptr_ = s->data
		*len_ = FB_USTRSIZE( s )
	end if
end sub

private function hTemp( byval src as FB_UCHAR ptr, byval units as integer ) as FBUSTRING ptr
	dim as FBUSTRING ptr dst = any
	if( units <= 0 ) then return TKORT_UNULL_DESC()
	dst = tkrt_UStrAllocTemp( nullptr, units )
	if( dst = nullptr ) then return TKORT_UNULL_DESC()
	if( dst->data <> nullptr ) then
		if( src <> nullptr ) then tkrt_UStrCopy2( dst->data, src, units )
		dst->data[units] = 0
	end if
	return dst
end function

#if defined( __FB_WIN32__ ) or defined( __FB_WIN64__ )

'' ---------------------------------------------------------- Windows backend

const INVALID_HANDLE_VALUE_    = -1
const INVALID_FILE_ATTRIBUTES_ = &hFFFFFFFFul
const MAX_PATH_                = 260
const FILE_SHARE_READ_         = &h00000001ul
const FILE_SHARE_WRITE_        = &h00000002ul
const FILE_SHARE_DELETE_       = &h00000004ul
const OPEN_EXISTING_           = 3
const FILE_WRITE_ATTRIBUTES_   = &h00000100ul
const FILE_FLAG_BACKUP_SEMANTICS_ = &h02000000ul
const FILE_ATTRIBUTE_READONLY_    = &h00000001ul
const FILE_ATTRIBUTE_HIDDEN_      = &h00000002ul
const FILE_ATTRIBUTE_DIRECTORY_   = &h00000010ul
const FILE_ATTRIBUTE_DEVICE_      = &h00000040ul
const FILE_ATTRIBUTE_REPARSE_POINT_ = &h00000400ul
const IO_REPARSE_TAG_SYMLINK_     = &hA000000Cul
const IO_REPARSE_TAG_MOUNT_POINT_ = &hA0000003ul
const GetFileExInfoStandard_ = 0
const VOLUME_NAME_DOS_       = 0

'' WIN32_FILE_ATTRIBUTE_DATA: attrs, three FILETIMEs, then the two size halves.
'' All DWORD-aligned, 36 bytes, no padding.
const FAD_SIZE_       = 36
const FAD_ATTRS_      = 0
const FAD_CTIME_      = 4
const FAD_ATIME_      = 12
const FAD_MTIME_      = 20
const FAD_SIZEHIGH_   = 28
const FAD_SIZELOW_    = 32

'' WIN32_FIND_DATAW: the same prefix, then dwReserved0 (the reparse tag),
'' dwReserved1, cFileName(260) and cAlternateFileName(14).
const WFD_SIZE_      = 592
const WFD_RESERVED0_ = 36

'' BY_HANDLE_FILE_INFORMATION -- attrs, three FILETIMEs, volume serial, the two
'' size halves, the link count, then the two index halves.
const BHFI_SIZE_      = 52
const BHFI_ATTRS_     = 0
const BHFI_CTIME_     = 4
const BHFI_ATIME_     = 12
const BHFI_MTIME_     = 20
const BHFI_VOLSERIAL_ = 28
const BHFI_SIZEHIGH_  = 32
const BHFI_SIZELOW_   = 36
const BHFI_INDEXHIGH_ = 44
const BHFI_INDEXLOW_  = 48

extern "c"   '' NON-FBCALL: kernel32 imports, not rtlib entry points.
	declare function w_GetFileAttributesExW stdcall alias "GetFileAttributesExW" _
		( byval n as wstring ptr, byval level as int32, byval info as any ptr ) as int32
	declare function w_FindFirstFileW stdcall alias "FindFirstFileW" _
		( byval n as wstring ptr, byval fd as any ptr ) as any ptr
	declare function w_FindClose stdcall alias "FindClose" ( byval h as any ptr ) as int32
	declare function w_CreateFileW stdcall alias "CreateFileW" _
		( byval n as wstring ptr, byval acc as uint32, byval share as uint32, byval sa as any ptr, _
		  byval disp as uint32, byval flags as uint32, byval templ as any ptr ) as any ptr
	declare function w_CloseHandle stdcall alias "CloseHandle" ( byval h as any ptr ) as int32
	declare function w_GetFileInformationByHandle stdcall alias "GetFileInformationByHandle" _
		( byval h as any ptr, byval info as any ptr ) as int32
	declare function w_GetFullPathNameW stdcall alias "GetFullPathNameW" _
		( byval n as wstring ptr, byval cap as uint32, byval buf as wstring ptr, byval part as any ptr ) as uint32
	declare function w_GetFinalPathNameByHandleW stdcall alias "GetFinalPathNameByHandleW" _
		( byval h as any ptr, byval buf as wstring ptr, byval cap as uint32, byval flags as uint32 ) as uint32
	declare function w_GetCurrentDirectoryW stdcall alias "GetCurrentDirectoryW" _
		( byval cap as uint32, byval buf as wstring ptr ) as uint32
	declare function w_SetCurrentDirectoryW stdcall alias "SetCurrentDirectoryW" ( byval n as wstring ptr ) as int32
	declare function w_SetFileTime stdcall alias "SetFileTime" _
		( byval h as any ptr, byval c as any ptr, byval a as any ptr, byval m as any ptr ) as int32
end extern

'' NUL-terminated wide copy of a USTRING path, heap-allocated because paths are
'' NOT bounded by MAX_PATH -- a \\?\ path may be far longer, and truncating one
'' silently operates on the WRONG FILE.
private function hFsWide( byval p as FBUSTRING ptr ) as wstring ptr
	dim as FB_UCHAR ptr s = any
	dim as integer len_ = any
	dim as FB_UCHAR ptr w = any

	hUArg( p, @s, @len_ )
	w = malloc( (len_ + 1) * sizeof( FB_UCHAR ) )
	if( w = nullptr ) then return nullptr
	if( len_ > 0 ) then memcpy( w, s, len_ * sizeof( FB_UCHAR ) )
	w[len_] = 0
	return cptr( wstring ptr, w )
end function

'' FILETIME is 100 ns since 1601-01-01; the module's tick is 100 ns since
'' 0001-01-01. Same unit, different epoch, so this is one addition.
private function hTicks( byval ft as uint8 ptr ) as int64
	dim as uint32 lo = *cptr( uint32 ptr, ft )
	dim as uint32 hi = *cptr( uint32 ptr, ft + 4 )
	if( (lo = 0) andalso (hi = 0) ) then return 0
	return cast( int64, (cast( uint64, hi ) shl 32) or cast( uint64, lo ) ) + FB_FS_TICKS_TO_FILETIME
end function

private sub hFromTicks( byval t as int64, byval ft as uint8 ptr )
	dim as uint64 v = cast( uint64, t - FB_FS_TICKS_TO_FILETIME )
	*cptr( uint32 ptr, ft )     = cast( uint32, v and &hFFFFFFFFull )
	*cptr( uint32 ptr, ft + 4 ) = cast( uint32, v shr 32 )
end sub

'' A reparse point is only a LINK if its tag says so. Dedup, cloud placeholders
'' and several other features are also reparse points, and treating them as
'' links would make a walk skip real directories.
private function hIsLinkTag( byval tag as uint32 ) as int32
	return iif( (tag = IO_REPARSE_TAG_SYMLINK_) orelse (tag = IO_REPARSE_TAG_MOUNT_POINT_), 1, 0 )
end function

private function hKindFromAttrs( byval attrs as uint32, byval tag as uint32 ) as int32
	if( attrs = INVALID_FILE_ATTRIBUTES_ ) then return FB_FSKIND_NONE
	if( ((attrs and FILE_ATTRIBUTE_REPARSE_POINT_) <> 0) andalso (hIsLinkTag( tag ) <> 0) ) then
		return FB_FSKIND_LINK
	end if
	if( (attrs and FILE_ATTRIBUTE_DIRECTORY_) <> 0 ) then return FB_FSKIND_DIR
	if( (attrs and (FILE_ATTRIBUTE_DEVICE_ or FILE_ATTRIBUTE_REPARSE_POINT_)) <> 0 ) then return FB_FSKIND_OTHER
	return FB_FSKIND_FILE
end function

'' Windows has no FS_IS_A_DIRECTORY and reports ERROR_ACCESS_DENIED for a wide
'' range of unrelated causes, so callers that know better synthesise their own
'' code. Nothing is guessed here.
private function hStatWide( byval w as wstring ptr, byval follow as int32, byval out_ as FB_FSINFO ptr ) as int32
	dim as uint8 fad( 0 to FAD_SIZE_ - 1 ) = any
	dim as uint32 tag = 0, attrs = any
	dim as any ptr h = any

	memset( out_, 0, sizeof( FB_FSINFO ) )

	if( w_GetFileAttributesExW( w, GetFileExInfoStandard_, @fad(0) ) = 0 ) then
		return tkrt_FsMapOsError( )
	end if

	attrs = *cptr( uint32 ptr, @fad(FAD_ATTRS_) )

	'' Only ask for the reparse tag when there is one to ask about.
	if( (attrs and FILE_ATTRIBUTE_REPARSE_POINT_) <> 0 ) then
		dim as uint8 fd( 0 to WFD_SIZE_ - 1 ) = any
		h = w_FindFirstFileW( w, @fd(0) )
		if( cast( integer, h ) <> INVALID_HANDLE_VALUE_ ) then
			tag = *cptr( uint32 ptr, @fd(WFD_RESERVED0_) )
			w_FindClose( h )
		end if
	end if

	'' follow: resolve the link and report what it points AT. A Stat result with
	'' IsSymlink true would be a contradiction -- that is what "follow" means.
	if( (follow <> 0) andalso ((attrs and FILE_ATTRIBUTE_REPARSE_POINT_) <> 0) _
	    andalso (hIsLinkTag( tag ) <> 0) ) then
		dim as uint8 bhfi( 0 to BHFI_SIZE_ - 1 ) = any
		dim as int32 ok = any, r = any
		dim as uint32 a2 = any

		h = w_CreateFileW( w, 0, _
			FILE_SHARE_READ_ or FILE_SHARE_WRITE_ or FILE_SHARE_DELETE_, _
			nullptr, OPEN_EXISTING_, FILE_FLAG_BACKUP_SEMANTICS_, nullptr )

		if( cast( integer, h ) = INVALID_HANDLE_VALUE_ ) then return tkrt_FsMapOsError( )

		ok = w_GetFileInformationByHandle( h, @bhfi(0) )
		r = iif( ok <> 0, FB_FS_OK, tkrt_FsMapOsError( ) )
		w_CloseHandle( h )
		if( ok = 0 ) then return r

		a2 = *cptr( uint32 ptr, @bhfi(BHFI_ATTRS_) )
		out_->size_ = (cast( uint64, *cptr( uint32 ptr, @bhfi(BHFI_SIZEHIGH_) ) ) shl 32) or _
		              cast( uint64, *cptr( uint32 ptr, @bhfi(BHFI_SIZELOW_) ) )
		out_->mtime = hTicks( @bhfi(BHFI_MTIME_) )
		out_->ctime = hTicks( @bhfi(BHFI_CTIME_) )
		out_->atime = hTicks( @bhfi(BHFI_ATIME_) )
		out_->native_attrs = a2
		out_->kind = iif( (a2 and FILE_ATTRIBUTE_DIRECTORY_) <> 0, FB_FSKIND_DIR, FB_FSKIND_FILE )

		if( (a2 and FILE_ATTRIBUTE_READONLY_) <> 0 ) then out_->flags or= FB_FSFLAG_READONLY
		if( (a2 and FILE_ATTRIBUTE_HIDDEN_) <> 0 ) then out_->flags or= FB_FSFLAG_HIDDEN

		out_->flags or= FB_FSFLAG_HAS_CTIME or FB_FSFLAG_HAS_ATIME
		return FB_FS_OK
	end if

	out_->size_ = (cast( uint64, *cptr( uint32 ptr, @fad(FAD_SIZEHIGH_) ) ) shl 32) or _
	              cast( uint64, *cptr( uint32 ptr, @fad(FAD_SIZELOW_) ) )
	out_->mtime = hTicks( @fad(FAD_MTIME_) )
	out_->ctime = hTicks( @fad(FAD_CTIME_) )
	out_->atime = hTicks( @fad(FAD_ATIME_) )
	out_->native_attrs = attrs
	out_->kind = hKindFromAttrs( attrs, tag )

	'' A directory's "size" is meaningless on Windows; report 0 rather than
	'' whatever the attribute block happened to contain.
	if( out_->kind = FB_FSKIND_DIR ) then out_->size_ = 0

	if( (attrs and FILE_ATTRIBUTE_READONLY_) <> 0 ) then out_->flags or= FB_FSFLAG_READONLY
	if( (attrs and FILE_ATTRIBUTE_HIDDEN_) <> 0 ) then out_->flags or= FB_FSFLAG_HIDDEN

	'' Windows always has all three times.
	out_->flags or= FB_FSFLAG_HAS_CTIME or FB_FSFLAG_HAS_ATIME

	return FB_FS_OK
end function

extern "rtlib"

function tkort_UStrFsStat alias "fb_UStrFsStat" _
	( byval p as FBUSTRING ptr, byval follow as int32, byval out_ as FB_FSINFO ptr ) as int32

	dim as wstring ptr w = hFsWide( p )
	dim as int32 r = any

	if( w = nullptr ) then return FB_FS_UNKNOWN
	r = hStatWide( w, follow, out_ )
	free( w )
	return r
end function

function tkort_UStrFsAbsolutePath alias "fb_UStrFsAbsolutePath" _
	( byval p as FBUSTRING ptr, byval status as int32 ptr ) as FBUSTRING ptr

	dim as wstring ptr w = any, buf = any
	dim as uint32 n = any
	dim as FBUSTRING ptr res = any

	if( status <> nullptr ) then *status = FB_FS_OK

	w = hFsWide( p )
	if( w = nullptr ) then
		if( status <> nullptr ) then *status = FB_FS_UNKNOWN
		return TKORT_UNULL_DESC()
	end if

	n = w_GetFullPathNameW( w, 0, nullptr, nullptr )
	if( n = 0 ) then
		if( status <> nullptr ) then *status = tkrt_FsMapOsError( )
		free( w )
		return TKORT_UNULL_DESC()
	end if

	buf = malloc( n * sizeof( FB_UCHAR ) )
	if( buf = nullptr ) then
		if( status <> nullptr ) then *status = FB_FS_UNKNOWN
		free( w )
		return TKORT_UNULL_DESC()
	end if

	n = w_GetFullPathNameW( w, n, buf, nullptr )
	if( n = 0 ) then
		if( status <> nullptr ) then *status = tkrt_FsMapOsError( )
		res = TKORT_UNULL_DESC()
	else
		res = hTemp( cptr( FB_UCHAR ptr, buf ), n )
	end if

	free( buf )
	free( w )
	return res
end function

'' Resolves every link, junction and mount point, resolves ".." THROUGH them
'' with the filesystem's semantics rather than lexically, and REQUIRES every
'' component to exist.
''
'' FILE_FLAG_BACKUP_SEMANTICS is what lets a DIRECTORY be opened by CreateFileW;
'' without it this works on files and fails on every directory.
''
'' THE \\?\ PREFIX IS STRIPPED unless the result exceeds MAX_PATH, in which case
'' it is KEPT -- removing it there would produce a path the OS cannot open. So
'' canonical results must be compared with PathEquals, not "=".
function tkort_UStrFsCanonicalPath alias "fb_UStrFsCanonicalPath" _
	( byval p as FBUSTRING ptr, byval status as int32 ptr ) as FBUSTRING ptr

	dim as wstring ptr w = any
	dim as FB_UCHAR ptr buf = any, o = any
	dim as any ptr h = any
	dim as uint32 n = any
	dim as integer outlen = any
	dim as FBUSTRING ptr res = any

	if( status <> nullptr ) then *status = FB_FS_OK

	w = hFsWide( p )
	if( w = nullptr ) then
		if( status <> nullptr ) then *status = FB_FS_UNKNOWN
		return TKORT_UNULL_DESC()
	end if

	h = w_CreateFileW( w, 0, _
		FILE_SHARE_READ_ or FILE_SHARE_WRITE_ or FILE_SHARE_DELETE_, _
		nullptr, OPEN_EXISTING_, FILE_FLAG_BACKUP_SEMANTICS_, nullptr )
	free( w )

	if( cast( integer, h ) = INVALID_HANDLE_VALUE_ ) then
		if( status <> nullptr ) then *status = tkrt_FsMapOsError( )
		return TKORT_UNULL_DESC()
	end if

	n = w_GetFinalPathNameByHandleW( h, nullptr, 0, VOLUME_NAME_DOS_ )
	if( n = 0 ) then
		if( status <> nullptr ) then *status = tkrt_FsMapOsError( )
		w_CloseHandle( h )
		return TKORT_UNULL_DESC()
	end if

	buf = malloc( (n + 1) * sizeof( FB_UCHAR ) )
	if( buf = nullptr ) then
		if( status <> nullptr ) then *status = FB_FS_UNKNOWN
		w_CloseHandle( h )
		return TKORT_UNULL_DESC()
	end if

	n = w_GetFinalPathNameByHandleW( h, cptr( wstring ptr, buf ), n, VOLUME_NAME_DOS_ )
	w_CloseHandle( h )

	if( n = 0 ) then
		if( status <> nullptr ) then *status = tkrt_FsMapOsError( )
		free( buf )
		return TKORT_UNULL_DESC()
	end if

	buf[n] = 0

	'' Strip "\\?\" when what remains still fits MAX_PATH. "\\?\UNC\srv\.." must
	'' become "\\srv\..", not "UNC\srv\..".
	o = buf
	outlen = n

	if( (n > 4) andalso (buf[0] = 92) andalso (buf[1] = 92) andalso _
	    (buf[2] = 63) andalso (buf[3] = 92) ) then
		if( (n > 8) andalso _
		    ((buf[4] = 85) orelse (buf[4] = 117)) andalso _
		    ((buf[5] = 78) orelse (buf[5] = 110)) andalso _
		    ((buf[6] = 67) orelse (buf[6] = 99)) andalso _
		    (buf[7] = 92) ) then
			if( (n - 6) <= MAX_PATH_ ) then
				'' overwrite the "\\?\UNC" tail so a "\\" leads
				buf[6] = 92
				o = buf + 6
				outlen = n - 6
			end if
		elseif( (n - 4) <= MAX_PATH_ ) then
			o = buf + 4
			outlen = n - 4
		end if
	end if

	res = hTemp( o, outlen )
	free( buf )
	return res
end function

function tkort_UStrFsCurrentDir alias "fb_UStrFsCurrentDir" ( byval status as int32 ptr ) as FBUSTRING ptr
	dim as wstring ptr buf = any
	dim as uint32 n = any
	dim as FBUSTRING ptr res = any

	if( status <> nullptr ) then *status = FB_FS_OK

	n = w_GetCurrentDirectoryW( 0, nullptr )
	if( n = 0 ) then
		if( status <> nullptr ) then *status = tkrt_FsMapOsError( )
		return TKORT_UNULL_DESC()
	end if

	buf = malloc( n * sizeof( FB_UCHAR ) )
	if( buf = nullptr ) then
		if( status <> nullptr ) then *status = FB_FS_UNKNOWN
		return TKORT_UNULL_DESC()
	end if

	n = w_GetCurrentDirectoryW( n, buf )
	if( n = 0 ) then
		if( status <> nullptr ) then *status = tkrt_FsMapOsError( )
		res = TKORT_UNULL_DESC()
	else
		res = hTemp( cptr( FB_UCHAR ptr, buf ), n )
	end if

	free( buf )
	return res
end function

function tkort_UStrFsSetCurrentDir alias "fb_UStrFsSetCurrentDir" ( byval p as FBUSTRING ptr ) as int32
	dim as wstring ptr w = hFsWide( p )
	dim as int32 r = FB_FS_OK

	if( w = nullptr ) then return FB_FS_UNKNOWN
	if( w_SetCurrentDirectoryW( w ) = 0 ) then r = tkrt_FsMapOsError( )
	free( w )
	return r
end function

'' Identity, for WalkDir's FollowSymlinks visited set.
'' FILE_FLAG_BACKUP_SEMANTICS is required to open a DIRECTORY at all, and
'' FILE_FLAG_OPEN_REPARSE_POINT is deliberately NOT passed: the walk wants the
'' identity of what the link POINTS AT, since that is what it would be
'' descending into and therefore what could form a cycle.
function tkort_UStrFsIdentity alias "fb_UStrFsIdentity" _
	( byval p as FBUSTRING ptr, byval vol as uint64 ptr, byval id as uint64 ptr ) as int32

	dim as wstring ptr w = any
	dim as any ptr h = any
	dim as uint8 bhfi( 0 to BHFI_SIZE_ - 1 ) = any
	dim as int32 r = FB_FS_OK

	*vol = 0
	*id = 0

	w = hFsWide( p )
	if( w = nullptr ) then return FB_FS_UNKNOWN

	h = w_CreateFileW( w, 0, _
		FILE_SHARE_READ_ or FILE_SHARE_WRITE_ or FILE_SHARE_DELETE_, _
		nullptr, OPEN_EXISTING_, FILE_FLAG_BACKUP_SEMANTICS_, nullptr )
	free( w )

	if( cast( integer, h ) = INVALID_HANDLE_VALUE_ ) then return tkrt_FsMapOsError( )

	if( w_GetFileInformationByHandle( h, @bhfi(0) ) = 0 ) then
		r = tkrt_FsMapOsError( )
	else
		*vol = cast( uint64, *cptr( uint32 ptr, @bhfi(BHFI_VOLSERIAL_) ) )
		*id  = (cast( uint64, *cptr( uint32 ptr, @bhfi(BHFI_INDEXHIGH_) ) ) shl 32) or _
		       cast( uint64, *cptr( uint32 ptr, @bhfi(BHFI_INDEXLOW_) ) )
	end if

	w_CloseHandle( h )
	return r
end function

'' A tick of 0 means "leave this one alone", so a caller can set one without
'' inventing a value for the other. FILE_FLAG_BACKUP_SEMANTICS again, so a
'' DIRECTORY's times can be set too -- a tree copy that preserved file times but
'' not directory times would be a strange half-measure.
function tkort_UStrFsSetTimes alias "fb_UStrFsSetTimes" _
	( byval p as FBUSTRING ptr, byval mtime as int64, byval atime as int64 ) as int32

	dim as wstring ptr w = any
	dim as any ptr h = any
	dim as uint8 ftm( 0 to 7 ) = any, fta( 0 to 7 ) = any
	dim as any ptr pm = nullptr, pa = nullptr
	dim as int32 r = FB_FS_OK

	w = hFsWide( p )
	if( w = nullptr ) then return FB_FS_UNKNOWN

	h = w_CreateFileW( w, FILE_WRITE_ATTRIBUTES_, _
		FILE_SHARE_READ_ or FILE_SHARE_WRITE_ or FILE_SHARE_DELETE_, _
		nullptr, OPEN_EXISTING_, FILE_FLAG_BACKUP_SEMANTICS_, nullptr )
	free( w )

	if( cast( integer, h ) = INVALID_HANDLE_VALUE_ ) then return tkrt_FsMapOsError( )

	if( mtime > 0 ) then
		hFromTicks( mtime, @ftm(0) )
		pm = @ftm(0)
	end if

	if( atime > 0 ) then
		hFromTicks( atime, @fta(0) )
		pa = @fta(0)
	end if

	if( w_SetFileTime( h, nullptr, pa, pm ) = 0 ) then r = tkrt_FsMapOsError( )

	w_CloseHandle( h )
	return r
end function

end extern

#elseif defined( __FB_UNIX__ )

'' ------------------------------------------------------------ POSIX backend
''
'' struct stat, struct timespec, the S_IF* / S_IW* mode bits, AT_FDCWD and
'' UTIME_OMIT all come from the posix binding (inc/sysbind.ti), measured on the
'' target's own libc; no offset or value is written here. The birth time is
'' the one OS-specific piece, in the per-OS file included below.

extern "c"   '' NON-FBCALL: libc, not rtlib entry points.
	declare function u_stat alias "stat" ( byval p as zstring ptr, byval st as struct_stat ptr ) as int32
	declare function u_lstat alias "lstat" ( byval p as zstring ptr, byval st as struct_stat ptr ) as int32
	declare function u_getcwd alias "getcwd" ( byval buf as zstring ptr, byval n as uinteger ) as zstring ptr
	declare function u_chdir alias "chdir" ( byval p as zstring ptr ) as int32
	declare function u_realpath alias "realpath" ( byval p as zstring ptr, byval resolved as zstring ptr ) as zstring ptr
	declare function u_utimensat alias "utimensat" _
		( byval dirfd as int32, byval p as zstring ptr, byval times as struct_timespec ptr, byval flags as int32 ) as int32
	declare function u_strlen alias "strlen" ( byval s as zstring ptr ) as uinteger
	declare function u_utf16to8 alias "fb_hUtf16ToUtf8" _
		( byval src as FB_UCHAR ptr, byval units as integer, byval dst as zstring ptr, byval cap as integer ) as integer
	declare function u_utf8to16 alias "fb_hUtf8ToUtf16" _
		( byval src as zstring ptr, byval bytes as integer, byval dst as FB_UCHAR ptr, byval cap as integer ) as integer
end extern

private function hFsNarrow( byval p as FBUSTRING ptr ) as zstring ptr
	dim as FB_UCHAR ptr s = any
	dim as integer len_ = any, cap = any, n = any
	dim as zstring ptr b = any

	hUArg( p, @s, @len_ )
	cap = len_ * 3 + 1
	b = malloc( cap )
	if( b = nullptr ) then return nullptr
	n = u_utf16to8( s, len_, b, cap - 1 )
	if( n < 0 ) then n = 0
	b[n] = 0
	return b
end function

'' UTF-8 (ptr, bytes) -> a caller-freed TEMP. A negative length means "measure
'' it with strlen", matching the C helper.
private function hFsFromNarrow( byval b as zstring ptr, byval bytes as integer ) as FBUSTRING ptr
	dim as FB_UCHAR ptr tmp = any
	dim as FBUSTRING ptr res = any
	dim as integer cap = any, n = any, nb = bytes

	if( nb < 0 ) then nb = u_strlen( b )
	if( nb <= 0 ) then return TKORT_UNULL_DESC()

	cap = nb + 1
	tmp = malloc( cap * sizeof( FB_UCHAR ) )
	if( tmp = nullptr ) then return TKORT_UNULL_DESC()

	n = u_utf8to16( b, nb, tmp, cap )
	if( n < 0 ) then n = 0

	res = hTemp( tmp, n )
	free( tmp )
	return res
end function

private function hUnixToTicks( byval sec as int64, byval nsec as int64 ) as int64
	return FB_FS_TICKS_TO_UNIX_EPOCH + (sec * 10000000ll) + (nsec \ 100ll)
end function

private function hKindFromMode( byval m as uint32 ) as int32
	'' Plain comparisons rather than SELECT CASE AS CONST: the S_IF* values are
	'' 0o120000 apart, which is a jump table with 40,000 empty slots and is
	'' error 69, "range too large".
	dim as uint32 t = m and S_IFMT
	if( t = S_IFLNK ) then return FB_FSKIND_LINK
	if( t = S_IFDIR ) then return FB_FSKIND_DIR
	if( t = S_IFREG ) then return FB_FSKIND_FILE
	return FB_FSKIND_OTHER
end function

private sub hFillFromStat( byval st as struct_stat ptr, byval out_ as FB_FSINFO ptr )
	dim as uint32 m = st->st_mode

	memset( out_, 0, sizeof( FB_FSINFO ) )

	out_->size_ = cast( uint64, st->st_size )
	out_->native_attrs = m
	out_->kind = hKindFromMode( m )

	out_->mtime = hUnixToTicks( st->st_mtim.tv_sec, st->st_mtim.tv_nsec )
	out_->atime = hUnixToTicks( st->st_atim.tv_sec, st->st_atim.tv_nsec )

	out_->flags or= FB_FSFLAG_HAS_ATIME

	out_->uid = st->st_uid
	out_->gid = st->st_gid
	out_->flags or= FB_FSFLAG_HAS_OWNER

	'' Read-only means "no write bit for the calling user" -- the portable
	'' answer the two platforms can agree on. GetPosixMode is there for code
	'' that needs the real mode.
	if( (m and (S_IWUSR or S_IWGRP or S_IWOTH)) = 0 ) then out_->flags or= FB_FSFLAG_READONLY
end sub

'' The birth time: hTryBirthTime( path_, follow, out_ ), one per OS.
#if defined( __FB_LINUX__ )
	#include once "statlinux.tiko"
#elseif defined( __FB_DARWIN__ )
	#include once "statdarwin.tiko"
#else
	#error "fs/stat: no birth-time backend for this OS"
#endif

extern "rtlib"

function tkort_UStrFsStat alias "fb_UStrFsStat" _
	( byval p as FBUSTRING ptr, byval follow as int32, byval out_ as FB_FSINFO ptr ) as int32

	dim as zstring ptr path_ = hFsNarrow( p )
	dim as struct_stat st = any
	dim as int32 r = any

	if( path_ = nullptr ) then return FB_FS_UNKNOWN

	r = iif( follow <> 0, u_stat( path_, @st ), u_lstat( path_, @st ) )

	if( r <> 0 ) then
		dim as int32 e = tkrt_FsMapOsError( )
		free( path_ )
		memset( out_, 0, sizeof( FB_FSINFO ) )
		return e
	end if

	hFillFromStat( @st, out_ )
	hTryBirthTime( path_, follow, out_ )

	free( path_ )
	return FB_FS_OK
end function

function tkort_UStrFsCurrentDir alias "fb_UStrFsCurrentDir" ( byval status as int32 ptr ) as FBUSTRING ptr
	dim as zstring * (PATH_MAX + 1) buf = any

	if( status <> nullptr ) then *status = FB_FS_OK

	if( u_getcwd( @buf, PATH_MAX + 1 ) = nullptr ) then
		if( status <> nullptr ) then *status = tkrt_FsMapOsError( )
		return TKORT_UNULL_DESC()
	end if

	return hFsFromNarrow( @buf, -1 )
end function

function tkort_UStrFsAbsolutePath alias "fb_UStrFsAbsolutePath" _
	( byval p as FBUSTRING ptr, byval status as int32 ptr ) as FBUSTRING ptr

	dim as FB_UCHAR ptr s = any
	dim as integer len_ = any

	if( status <> nullptr ) then *status = FB_FS_OK

	hUArg( p, @s, @len_ )

	'' Already absolute: hand it back untouched. The FB layer normalises.
	if( len_ > 0 ) then
		if( s[0] = 47 ) then return hTemp( s, len_ )
	end if

	'' Otherwise the FB layer joins this onto the path and normalises; doing the
	'' join here would duplicate fs/path.tiko for no gain.
	return tkort_UStrFsCurrentDir( status )
end function

'' Resolves every symbolic link and requires every component to exist -- unlike
'' AbsolutePath, and the contrast is the reason both exist.
function tkort_UStrFsCanonicalPath alias "fb_UStrFsCanonicalPath" _
	( byval p as FBUSTRING ptr, byval status as int32 ptr ) as FBUSTRING ptr

	dim as zstring ptr path_ = any, res = any
	dim as FBUSTRING ptr out_ = any

	if( status <> nullptr ) then *status = FB_FS_OK

	path_ = hFsNarrow( p )
	if( path_ = nullptr ) then
		if( status <> nullptr ) then *status = FB_FS_UNKNOWN
		return TKORT_UNULL_DESC()
	end if

	'' NULL lets realpath allocate, which avoids the PATH_MAX overflow the
	'' two-argument form is notorious for.
	res = u_realpath( path_, nullptr )

	if( res = nullptr ) then
		if( status <> nullptr ) then *status = tkrt_FsMapOsError( )
		out_ = TKORT_UNULL_DESC()
	else
		out_ = hFsFromNarrow( res, -1 )
		free( res )
	end if

	free( path_ )
	return out_
end function

function tkort_UStrFsSetCurrentDir alias "fb_UStrFsSetCurrentDir" ( byval p as FBUSTRING ptr ) as int32
	dim as zstring ptr path_ = hFsNarrow( p )
	dim as int32 r = FB_FS_OK

	if( path_ = nullptr ) then return FB_FS_UNKNOWN
	if( u_chdir( path_ ) <> 0 ) then r = tkrt_FsMapOsError( )
	free( path_ )
	return r
end function

'' A tick of 0 means "leave this one alone" -- UTIME_OMIT expresses exactly
'' that, which is why utimensat is used rather than the older utimes( ) that can
'' only set both.
function tkort_UStrFsSetTimes alias "fb_UStrFsSetTimes" _
	( byval p as FBUSTRING ptr, byval mtime as int64, byval atime as int64 ) as int32

	dim as zstring ptr path_ = hFsNarrow( p )
	dim as struct_timespec ts( 0 to 1 ) = any
	dim as int32 r = FB_FS_OK
	dim as int64 v = any

	if( path_ = nullptr ) then return FB_FS_UNKNOWN

	'' ts(0) is access, ts(1) is modification
	if( atime > 0 ) then
		v = atime - FB_FS_TICKS_TO_UNIX_EPOCH
		ts(0).tv_sec  = v \ 10000000ll
		ts(0).tv_nsec = (v mod 10000000ll) * 100ll
	else
		ts(0).tv_sec  = 0
		ts(0).tv_nsec = UTIME_OMIT
	end if

	if( mtime > 0 ) then
		v = mtime - FB_FS_TICKS_TO_UNIX_EPOCH
		ts(1).tv_sec  = v \ 10000000ll
		ts(1).tv_nsec = (v mod 10000000ll) * 100ll
	else
		ts(1).tv_sec  = 0
		ts(1).tv_nsec = UTIME_OMIT
	end if

	if( u_utimensat( AT_FDCWD, path_, @ts(0), 0 ) <> 0 ) then r = tkrt_FsMapOsError( )

	free( path_ )
	return r
end function

end extern

#else
	#error "fs/stat: no backend for this target"
#endif
