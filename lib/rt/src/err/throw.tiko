'' throw.tiko -- ERROR, RESUME and the handler hook: six entry points over one
'' fbc member.
''
'' THE DECISION EVERY PATH MAKES IS "HANDLER OR DIE". With a user handler
'' installed, the context is filled in and the handler's address is RETURNED --
'' this code does not call it. The compiler emits a jump to whatever comes
'' back, which is why the return type is a function pointer and why returning
'' NULL by mistake would jump to address zero rather than fail cleanly.
''
'' WITHOUT A HANDLER, fb_Die BUILDS A MESSAGE AND ENDS THE PROGRAM. It is
'' static in fbc, so there is no symbol to match and none is exported here.
''
'' fb_Die WRITES INTO __fb_errmsg AND PUBLISHES IT VIA __fb_ctx.errmsg. It does
'' not print: fb_hRtExit does that on the way out. Printing here would emit the
'' message twice under -exx, once from each.
''
'' THE MESSAGE IS ASSEMBLED WITH snprintf, WHICH IS MSVCRT ON WINDOWS while
'' sprintf is MinGW (inc/fmt.ti). It matters here only for %d, where the two
'' agree -- but the call is matched rather than the implementation chosen.
''
'' RESUME AND RESUME NEXT CLEAR *BOTH* LABELS, not just the one they used. A
'' second RESUME with no intervening error must die rather than loop back to a
'' stale label, and clearing only the label taken would let RESUME NEXT still
'' fire after a RESUME.

#include once "inc/descriptors.ti"
#include once "inc/rterror.ti"
#include once "inc/ctx.ti"
#include once "inc/fmt.ti"

const FB_TLSKEY_ERROR as int32 = 0

extern "rtlib"
	declare function fb_TlsGetCtx alias "fb_TlsGetCtx" _
		( byval idx as int32, byval length as uinteger, byval dtor as any ptr ) as any ptr
	declare sub tkrt_End alias "fb_End" ( byval errlevel as int32 )
end extern

'' src/c/errjmp.c. Plain C linkage, like every other member there, because the
'' C compiler is what has setjmp.h.
extern "c"   '' NON-FBCALL: src/c/errjmp.c's two entry points, plain C.
	declare sub fb_ErrorJmpGoAt alias "fb_ErrorJmpGoAt" ( byval env as any ptr )
	'' Defined below, after hCtx: the thrower calls them and sits between.
	declare sub fb_ErrorJmpGo alias "fb_ErrorJmpGo" ( )
	declare sub fb_ErrorJmpDisarm alias "fb_ErrorJmpDisarm" ( )
end extern


private function hCtx( ) as FB_ERRORCTX ptr
	return cptr( FB_ERRORCTX ptr, _
		fb_TlsGetCtx( FB_TLSKEY_ERROR, sizeof( FB_ERRORCTX ), nullptr ) )
end function

'' Indexed by FB_RTERROR. NOTE fbc's trailing comments here are misaligned --
'' SIGTERM appears twice and SIGABRT is against the quit text -- but the
'' STRINGS are in the right order and the strings are what is observable.
'' Reproduce the strings, not the comments.
private function hErrMessage( byval n as int32 ) as zstring ptr
	select case n
	case 0  : return @""
	case 1  : return @"illegal function call"
	case 2  : return @"file not found"
	case 3  : return @"file I/O error"
	case 4  : return @"out of memory"
	case 5  : return @"illegal resume"
	case 6  : return @"out of bounds array access"
	case 7  : return @"null pointer access"
	case 8  : return @"no privileges"
	case 9  : return @!"\"interrupted\" signal"
	case 10 : return @!"\"illegal instruction\" signal"
	case 11 : return @!"\"floating point error\" signal"
	case 12 : return @!"\"segmentation violation\" signal"
	case 13 : return @!"\"termination request\" signal"
	case 14 : return @!"\"abnormal termination\" signal"
	case 15 : return @!"\"quit request\" signal"
	case 16 : return @"return without gosub"
	case 17 : return @"end of file"
	case 18 : return @"array not dimensioned"
	case 19 : return @"wrong number of dimensions"
	end select
	return @""
end function

'' Builds the abort message into __fb_errmsg and returns it. Shared by hDie and by the signal
'' handler's way out after the runtime has shut down (tkort_SigDie).
private function hFormat( byval err_num as int32, byval line_num as int32, _
                          byval mod_name as zstring ptr, byval fun_name as zstring ptr, _
                          byval msg as zstring ptr ) as zstring ptr
	'' integer, not long: it is a byte offset into the message buffer, and
	'' snprintf returns a C int that is widened here explicitly.
	dim as integer pos_ = 0
	dim as zstring ptr em = cptr( zstring ptr, @__fb_errmsg )
	dim as zstring ptr prep = any

	pos_ += tkrt_snprintf( em + pos_, FB_ERRMSG_SIZE - pos_, _
	                       @!"\nAborting due to runtime error %d", err_num )

	'' The range test is what keeps an unknown code from indexing the table.
	if( (err_num >= 0) andalso (err_num < FB_RTERROR_MAX) ) then
		pos_ += tkrt_snprintf( em + pos_, FB_ERRMSG_SIZE - pos_, _
		                       @" (%s)", hErrMessage( err_num ) )
	end if

	if( line_num > 0 ) then
		pos_ += tkrt_snprintf( em + pos_, FB_ERRMSG_SIZE - pos_, _
		                       @" at line %d", line_num )
	end if

	if( mod_name <> nullptr ) then
		if( line_num > 0 ) then prep = @"of" else prep = @"in"
		if( fun_name <> nullptr ) then
			pos_ += tkrt_snprintf( em + pos_, FB_ERRMSG_SIZE - pos_, _
			                       @" %s %s::%s()", prep, mod_name, fun_name )
		else
			pos_ += tkrt_snprintf( em + pos_, FB_ERRMSG_SIZE - pos_, _
			                       @" %s %s()", prep, mod_name )
		end if
	end if

	if( msg <> nullptr ) then
		pos_ += tkrt_snprintf( em + pos_, FB_ERRMSG_SIZE - pos_, @", %s", msg )
	end if

	pos_ += tkrt_snprintf( em + pos_, FB_ERRMSG_SIZE - pos_, @!"\n\n" )

	em[FB_ERRMSG_SIZE - 1] = 0
	return em
end function

'' Builds the abort message and ends the program. STATIC in fbc: no symbol.
''
'' THE PREPOSITION CHANGES WITH THE LINE NUMBER -- " of MOD::FUN()" when a line
'' is known and " in MOD::FUN()" when it is not. fbc picks it with an inline
'' conditional on line_num > 0, and the two words are not interchangeable in
'' the output a test compares.
private sub hDie( byval err_num as int32, byval line_num as int32, _
                  byval mod_name as zstring ptr, byval fun_name as zstring ptr, _
                  byval msg as zstring ptr )

	dim as zstring ptr em = hFormat( err_num, line_num, mod_name, fun_name, msg )

	'' Published, not printed -- fb_hRtExit shows it on the way out.
	TKORT_CTX_ERRMSG() = em

	tkrt_End( err_num )
end sub

'' NON-FBCALL: fb_error.h declares the throwers plain; only fb_ErrorSetHandler
'' carries FBCALL. Getting this wrong is invisible except on win32.
extern "c"   '' NON-FBCALL: the throw/resume entry points, per fb_error.h.

'' Returns the HANDLER for the compiler to jump to, or dies. Never returns
'' normally when there is no handler.
function tkort_ErrorThrowMsg alias "fb_ErrorThrowMsg" _
	( byval err_num as int32, byval line_num as int32, byval mod_name as zstring ptr, _
	  byval msg as zstring ptr, byval res_label as any ptr, _
	  byval resnext_label as any ptr ) as FB_ERRHANDLER

	dim as FB_ERRORCTX ptr ctx = hCtx( )

	if( ctx->handler <> nullptr ) then
		ctx->err_num = err_num
		ctx->line_num = line_num
		'' The module name is kept only when one is GIVEN: a NULL leaves the
		'' previous name in place rather than clearing it, so a throw from a
		'' module without a name still reports the last one known.
		if( mod_name <> nullptr ) then ctx->mod_name = mod_name
		ctx->res_lbl = res_label
		ctx->resnxt_lbl = resnext_label

		'' AND THE JUMP ITSELF, WHICH RETURNING CANNOT DO. Returning the
		'' handler's address is fbc's contract and it works only where the
		'' raising procedure can jump to it -- GCC's cross-function computed
		'' goto. LLVM's indirectbr cannot leave its own function, so a throw
		'' inside a CALLED procedure had no way back to the caller's handler
		'' and died on the 'unreachable' after this call. src/c/errjmp.c holds
		'' the setjmp the compiler planted at the ON ERROR, and this does not
		'' return when one is armed.
		fb_ErrorJmpGo( )

		'' Not armed: an object built before the setjmp existed, or a handler
		'' installed by something that did not arm one. The old contract still
		'' works for a throw in the SAME procedure as its handler, which is
		'' what that object can express.
		return ctx->handler
	end if

	'' No handler: die. The module name falls back to the context's.
	dim as zstring ptr mn = mod_name
	if( mn = nullptr ) then mn = ctx->mod_name
	hDie( err_num, line_num, mn, ctx->fun_name, msg )
	return nullptr
end function

function tkort_ErrorThrowEx alias "fb_ErrorThrowEx" _
	( byval err_num as int32, byval line_num as int32, byval mod_name as zstring ptr, _
	  byval res_label as any ptr, byval resnext_label as any ptr ) as FB_ERRHANDLER
	return tkort_ErrorThrowMsg( err_num, line_num, mod_name, nullptr, res_label, resnext_label )
end function

'' Rethrows whatever error number is already in the context -- ERROR with no
'' argument, and the path RESUME takes after a handler returns.
function tkort_ErrorThrowAt alias "fb_ErrorThrowAt" _
	( byval line_num as int32, byval mod_name as zstring ptr, _
	  byval res_label as any ptr, byval resnext_label as any ptr ) as FB_ERRHANDLER
	dim as FB_ERRORCTX ptr ctx = hCtx( )
	return tkort_ErrorThrowEx( ctx->err_num, line_num, mod_name, res_label, resnext_label )
end function

'' Both resume paths clear BOTH labels -- see the header.
function tkort_ErrorResume alias "fb_ErrorResume" ( ) as any ptr
	dim as FB_ERRORCTX ptr ctx = hCtx( )
	dim as any ptr label_ = ctx->res_lbl
	if( label_ = nullptr ) then
		hDie( FB_RTERROR_ILLEGALRESUME, -1, ctx->mod_name, ctx->fun_name, nullptr )
	end if
	ctx->res_lbl = nullptr
	ctx->resnxt_lbl = nullptr
	return label_
end function

function tkort_ErrorResumeNext alias "fb_ErrorResumeNext" ( ) as any ptr
	dim as FB_ERRORCTX ptr ctx = hCtx( )
	dim as any ptr label_ = ctx->resnxt_lbl
	if( label_ = nullptr ) then
		hDie( FB_RTERROR_ILLEGALRESUME, -1, ctx->mod_name, ctx->fun_name, nullptr )
	end if
	ctx->res_lbl = nullptr
	ctx->resnxt_lbl = nullptr
	return label_
end function

end extern

extern "c"   '' NON-FBCALL: the setjmp buffer the compiler arms and jumps through; plain C.

'' THE BUFFER THE COMPILER SETJMPS INTO, aligned up to 16 out of the context's
'' packed storage. Arming happens here rather than in the emitted code so that
'' ON ERROR GOTO 0 -- a null handler, and no setjmp -- cannot leave a stale
'' buffer armed behind it.
function fb_ErrorJmpBuf alias "fb_ErrorJmpBuf" ( ) as any ptr
	dim as FB_ERRORCTX ptr ctx = hCtx( )
	dim as uinteger a = cast( uinteger, @ctx->jmp_raw(0) )
	a = (a + 15) and (not cast( uinteger, 15 ))
	ctx->jmp_armed = 1
	return cast( any ptr, a )
end function

sub fb_ErrorJmpDisarm alias "fb_ErrorJmpDisarm" ( )
	dim as FB_ERRORCTX ptr ctx = hCtx( )
	ctx->jmp_armed = 0
end sub

'' DOES NOT RETURN when armed.
sub fb_ErrorJmpGo alias "fb_ErrorJmpGo" ( )
	dim as FB_ERRORCTX ptr ctx = hCtx( )
	if( ctx->jmp_armed = 0 ) then return
	dim as uinteger a = cast( uinteger, @ctx->jmp_raw(0) )
	a = (a + 15) and (not cast( uinteger, 15 ))
	fb_ErrorJmpGoAt( cast( any ptr, a ) )
end sub

end extern

extern "rtlib"

'' FBCALL, unlike its neighbours (fb_ErrorSetHandler, below). Returns the OLD handler, so
'' ON ERROR can be nested and restored. The plain-C setjmp helpers above used to sit
'' INSIDE this block, an extern "rtlib" nested in an extern "rtlib"; lib/rt lint refused it.

'' THE HANDLER THE COMPILER WILL JUMP TO once setjmp has returned non-zero.
'' The emitted code cannot read the context itself and the address is not a
'' constant it holds: ON ERROR GOTO in one procedure and the throw in another
'' are the same handler, and only the runtime knows which is current.
function tkort_ErrorGetHandler alias "fb_ErrorGetHandler" ( ) as FB_ERRHANDLER
	dim as FB_ERRORCTX ptr ctx = hCtx( )
	return ctx->handler
end function

function tkort_ErrorSetHandler alias "fb_ErrorSetHandler" _
	( byval newhandler as FB_ERRHANDLER ) as FB_ERRHANDLER
	dim as FB_ERRORCTX ptr ctx = hCtx( )
	dim as FB_ERRHANDLER oldhandler = ctx->handler
	ctx->handler = newhandler
	'' 'ON ERROR GOTO 0' clears the handler and emits no setjmp, so the buffer
	'' the last ON ERROR armed must stop being a jump target with it -- its
	'' frame may be long gone.
	if( newhandler = nullptr ) then fb_ErrorJmpDisarm( )
	return oldhandler
end function

end extern

'' ---------------------------------------------------------------- a fatal signal's way out

#if defined( __FB_WIN32__ ) or defined( __FB_WIN64__ )
	extern "c"   '' NON-FBCALL: msvcrt.
		declare function sig_write alias "_write" ( byval fd as int32, byval buf as any ptr, byval n as uint32 ) as int32
		declare sub sig_exit alias "_exit" ( byval code as int32 )
	end extern
#else
	extern "c"   '' NON-FBCALL: libc.
		declare function sig_write alias "write" ( byval fd as int32, byval buf as any ptr, byval n as uinteger ) as integer
		declare sub sig_exit alias "_exit" ( byval code as int32 )
	end extern
#endif

extern "c"   '' NON-FBCALL: internal to tiko-rt, for error/signals.tiko; fbc has no such entry.

'' THE HANDLER'S DIE PATH WHEN THE THREAD HAS NO ERROR CONTEXT -- which also means it has no ON
'' ERROR handler, since installing one creates the context. What fb_ErrorThrowMsg would do for a
'' fresh context, without creating it (TK-004): the same message, no module, no function.
''
'' rtGone: fb_hRtExit has already run -- the signal came from a library's clean-up after the
'' program's (tkEdit: libGLX's fini, on a heap it found corrupt). There is nothing left to
'' unwind and exit( ) must not run again: the aborting thread may hold the heap's lock, and every
'' free in the remaining clean-up would wait on it. So the message goes straight to stderr and
'' the process ends with the error number, as it would have.
sub tkort_SigDie alias "tkort_SigDie" ( byval err_num as int32, byval rtGone as int32 )
	if( rtGone = 0 ) then
		hDie( err_num, -1, nullptr, nullptr, nullptr )
		exit sub
	end if
	dim as zstring ptr em = hFormat( err_num, -1, nullptr, nullptr, nullptr )
	dim as int32 n = 0
	while( em[n] <> 0 )
		n += 1
	wend
	sig_write( 2, em, n )
	sig_exit( err_num )
end sub

end extern
