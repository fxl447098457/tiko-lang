declare function fgetc cdecl alias "fgetc" ( byval _File as FILE ptr ) as long
declare function fgets cdecl alias "fgets" ( byval _Buf as zstring ptr, byval _MaxCount as long, byval _File as FILE ptr ) as zstring ptr
declare function fopen cdecl alias "fopen" ( byval _Filename as const zstring ptr, byval _Mode as const zstring ptr ) as FILE ptr
declare function fputc cdecl alias "fputc" ( byval _Ch as long, byval _File as FILE ptr ) as long
declare function fputs cdecl alias "fputs" ( byval _Str as const zstring ptr, byval _File as FILE ptr ) as long
declare function fread cdecl alias "fread" ( byval _DstBuf as any ptr, byval _ElementSize as size_t, byval _Count as size_t, byval _File as FILE ptr ) as uinteger
declare function freopen cdecl alias "freopen" ( byval _Filename as const zstring ptr, byval _Mode as const zstring ptr, byval _File as FILE ptr ) as FILE ptr
declare function fwrite cdecl alias "fwrite" ( byval _Str as const any ptr, byval _Size as size_t, byval _Count as size_t, byval _File as FILE ptr ) as uinteger
declare function getc cdecl alias "getc" ( byval _File as FILE ptr ) as long
declare function putc cdecl alias "putc" ( byval _Ch as long, byval _File as FILE ptr ) as long
declare function setvbuf cdecl alias "setvbuf" ( byval _File as FILE ptr, byval _Buf as zstring ptr, byval _Mode as long, byval _Size as size_t ) as long
declare function ungetc cdecl alias "ungetc" ( byval _Ch as long, byval _File as FILE ptr ) as long
type tm extern "c"
	tm_sec as long
	tm_min as long
	tm_hour as long
	tm_mday as long
	tm_mon as long
	tm_year as long
	tm_wday as long
	tm_yday as long
	tm_isdst as long
end type
declare function isupper cdecl alias "isupper" ( byval _C as long ) as long
declare function islower cdecl alias "islower" ( byval _C as long ) as long
declare function toupper cdecl alias "toupper" ( byval _C as long ) as long
declare function tolower cdecl alias "tolower" ( byval _C as long ) as long
declare function time_ cdecl alias "time" ( byval _Time as time_t ptr ) as time_t
declare function localtime cdecl alias "localtime" ( byval _Time as const time_t ptr ) as tm ptr
declare function ctime cdecl alias "ctime" ( byval _Time as const time_t ptr ) as zstring ptr
declare function log10 cdecl alias "log10" ( byval _X as double ) as double
declare function pow cdecl alias "pow" ( byval _X as double, byval _Y as double ) as double
declare function ceil cdecl alias "ceil" ( byval _X as double ) as double
declare function floor cdecl alias "floor" ( byval _X as double ) as double
declare function fabs cdecl alias "fabs" ( byval _X as double ) as double
declare function modf cdecl alias "modf" ( byval _X as double, byval _Y as double ptr ) as double
declare function rint cdecl alias "rint" ( byval as double ) as double
const EPERM = 1
const ENOENT = 2
const EACCES = 13

end extern
