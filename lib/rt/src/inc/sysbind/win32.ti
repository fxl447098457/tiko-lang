type _iobuf extern "c"
	_ptr as zstring ptr
	_cnt as long
	_base as zstring ptr
	_flag as long
	_file as long
	_charbuf as long
	_bufsiz as long
	_tmpfname as zstring ptr
end type
type FILE as _iobuf
declare function fprintf cdecl alias "fprintf" ( byval _File as FILE ptr, byval _Format as const zstring ptr, ... ) as long
declare function sprintf cdecl alias "sprintf" ( byval _Dest as zstring ptr, byval _Format as const zstring ptr, ... ) as long
