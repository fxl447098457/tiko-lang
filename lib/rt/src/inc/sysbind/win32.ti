declare sub free cdecl alias "free" ( byval _Memory as any ptr )
declare function malloc cdecl alias "malloc" ( byval _Size as size_t ) as any ptr
declare function realloc cdecl alias "realloc" ( byval _Memory as any ptr, byval _NewSize as size_t ) as any ptr
