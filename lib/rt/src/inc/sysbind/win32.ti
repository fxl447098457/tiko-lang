declare function memchr cdecl alias "memchr" ( byval _Buf as const any ptr, byval _Val as long, byval _MaxCount as size_t ) as any ptr
declare function memcmp cdecl alias "memcmp" ( byval _Buf1 as const any ptr, byval _Buf2 as const any ptr, byval _Size as size_t ) as long
