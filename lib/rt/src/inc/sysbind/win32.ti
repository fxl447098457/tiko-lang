'' sysbind/win32.ti -- the i686 C library binding, hand-derived from win64.ti
'' (the same MinGW-w64 headers, i686-w64-mingw32's). The two differ ONLY in the
'' pointer-width C types: size_t is 4 bytes on i386 and the functions returning it
'' return 4 there -- strlen, wcslen, fread, fwrite -- where win64.ti spells them
'' ulongint. Every other width (__time64_t, strtoull's unsigned long long, every
'' pointer) is the same. Regenerate with build/genbind.sh against the i686 headers
'' if a new C function enters the runtime.

'' win64.ti -- tiko-rt's C library binding for win64. GENERATED: do not edit.
''
'' Made by lib/rt/build/genbind.sh: tiko's own C importer (-cimport, decision 0016) over
'' lib/rt/build/sysbind.h against MinGW-w64's headers, cut by lib/rt/build/genbind.py
'' to the declarations tiko-rt's sources name and what those need. Regenerate after the
'' runtime starts using another C function; lib/rt/src/inc/sysbind.ti holds the rest.

#pragma once

#include once "crt/long.bi"

extern "C"   '' NON-FBCALL: the C library, not rtlib entry points.

type size_t as uinteger
type wchar_t as ushort
type __time64_t as longint
type time_t as __time64_t
