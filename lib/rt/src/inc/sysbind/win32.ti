declare function mbstowcs cdecl alias "mbstowcs" ( byval _Dest as wstring ptr, byval _Source as const zstring ptr, byval _MaxCount as size_t ) as size_t
declare function rand cdecl alias "rand" (  ) as long
declare sub srand cdecl alias "srand" ( byval _Seed as ulong )
declare function strtod cdecl alias "strtod" ( byval _Str as const zstring ptr, byval _EndPtr as zstring ptr ptr ) as double
declare function strtof cdecl alias "strtof" ( byval nptr as const zstring ptr, byval endptr as zstring ptr ptr ) as single
declare function strtol cdecl alias "strtol" ( byval _Str as const zstring ptr, byval _EndPtr as zstring ptr ptr, byval _Radix as long ) as clong
declare function strtoul cdecl alias "strtoul" ( byval _Str as const zstring ptr, byval _EndPtr as zstring ptr ptr, byval _Radix as long ) as culong
declare function wcstombs cdecl alias "wcstombs" ( byval _Dest as zstring ptr, byval _Source as const wstring ptr, byval _MaxCount as size_t ) as size_t
