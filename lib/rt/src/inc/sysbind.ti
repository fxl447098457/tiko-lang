#ifndef __TKORT_SYSBIND_BI__
#define __TKORT_SYSBIND_BI__

'' sysbind.ti -- tiko-rt's C library: the binding generated for the target, and the three
'' things no importer can carry.
''
'' THE BINDING IS tiko's OWN (decision 0016, phase E). lib/rt/build/genbind.sh imports the
'' C headers in lib/rt/build/sysbind.h with tiko's -cimport and keeps what the runtime's
'' sources name: src/inc/sysbind/win64.ti from MinGW-w64's headers, linux-x86_64.ti from
'' glibc's. Until this, tiko-rt included fbc's crt/*.bi, 61 of whose 80 headers may not be
'' redistributed -- the reason a toolchain could not be published (0015 §2.4). crt/long.bi,
'' which carries no such notice, is the one fbc header the binding still names.
''
'' windows-x86_64 builds from the win64 binding -- fbc compiles it AS win64 -- with the streams
'' re-pointed below, as they always were. No Microsoft-derived text is committed.
''
'' THE RESIDUE is written here, from measurement, not taken from any header:
''
''   the streams   a macro over a call on Windows (MinGW's FILE array, the UCRT's accessor)
''                 and three variables on Linux
''   errno         a macro over a call on every target
''   jmp_buf       C's is an ARRAY type, which FreeBASIC has no typedef for; its size and
''                 alignment were measured with clang: 256 bytes and 16 on both Windows
''                 ABIs. On a POSIX target it comes from the posix binding instead, measured
''                 by build/posixgen.sh (200 and 8 on x86-64 glibc). The GOSUB stack aligns
''                 its own copy to 16 (ctrl/gosub.tiko). longjmp is declared against it.

#if defined( __FB_WIN32__ )
	#ifdef __FB_64BIT__
		#include once "inc/sysbind/win64.ti"
	#else
		'' i686-w64-windows-gnu's own binding: same MinGW-w64 headers, 32-bit size_t.
		#include once "inc/sysbind/win32.ti"
	#endif
#elseif defined( __FB_LINUX__ )
	#include once "inc/sysbind/linux-x86_64.ti"
	'' THE POSIX LAYER: every constant and struct layout the runtime's __FB_UNIX__ code names,
	'' measured by build/posixgen.sh on the target's own host (D2 of docs/tiko-macos RFC-0001).
	#include once "inc/sysbind/linux-x86_64-posix.ti"
	using posix
#elseif defined( __FB_DARWIN__ )
	'' Hand-derived until tiko runs on the Mac (see the file), and the posix layer measured
	'' there by build/posixgen.sh against the macOS SDK.
	#include once "inc/sysbind/macos-arm64.ti"
	#include once "inc/sysbind/macos-arm64-posix.ti"
	using posix
#else
	#error "inc/sysbind.ti: no C library binding for this target"
#endif

extern "C"   '' NON-FBCALL: the C library, not rtlib entry points.

#if defined( __FB_LINUX__ )

	extern stdin alias "stdin" as FILE ptr
	extern stdout alias "stdout" as FILE ptr
	extern stderr alias "stderr" as FILE ptr

	declare function __errno_location( ) as int32 ptr
	#define errno (*__errno_location( ))

	'' jmp_buf is the posix binding's: its size and alignment measured, 200 and 8 here.

#elseif defined( __FB_DARWIN__ )

	'' Darwin's streams are three variables under other names, and its errno is __error( ):
	'' measured on the Mac with nm -u of a C file naming them (docs/tiko-macos FACTS
	'' "Darwin APIs"). The alias is the C name; Mach-O adds the '_' itself.
	extern stdin alias "__stdinp" as FILE ptr
	extern stdout alias "__stdoutp" as FILE ptr
	extern stderr alias "__stderrp" as FILE ptr

	declare function __error( ) as int32 ptr
	#define errno (*__error( ))

	'' jmp_buf is the posix binding's: 192 bytes here, measured.

#elseif defined( __FB_WIN32__ )

	#if defined( TKORT_MSVC ) or defined( TKORT_UCRT )
		'' THE UCRT HAS NO __iob_func. It exports one stream per call from
		'' __acrt_iob_func( n ) -- the Windows SDK's corecrt_wstdio.h defines stdout as
		'' __acrt_iob_func( 1 ) -- and its FILE is not MinGW's 48 bytes, so the stream
		'' is taken from the call and never by indexing an array. TKORT_MSVC comes from
		'' build.sh: fbc compiles windows-x86_64 as win64, and nothing else tells them apart.
		declare function tkrt_acrt_iob alias "__acrt_iob_func" ( byval ix as uint32 ) as FILE ptr
		#define stdin  tkrt_acrt_iob( 0 )
		#define stdout tkrt_acrt_iob( 1 )
		#define stderr tkrt_acrt_iob( 2 )
	#else
		'' MinGW's msvcrt hands out the base of a FILE array; the streams are entries 0-2.
		declare function __iob_func( ) as FILE ptr
		#define stdin  (@(__iob_func( ))[0])
		#define stdout (@(__iob_func( ))[1])
		#define stderr (@(__iob_func( ))[2])
	#endif

	declare function _errno( ) as int32 ptr
	#define errno (*_errno( ))

	type jmp_buf
		__opaque( 0 to 31 ) as uint64     '' 256 bytes
	end type

#else
	#error "inc/sysbind.ti: no streams, errno or jmp_buf for this target"
#endif

declare sub longjmp( byval env as jmp_buf ptr, byval value as int32 )

end extern

#endif '' __TKORT_SYSBIND_BI__
