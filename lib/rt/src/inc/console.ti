'' console.ti -- the per-platform console context, and the helpers that stay
'' fbc's.
''
'' THE TWO PLATFORMS DO NOT SHARE A CONTEXT, A LAYOUT, OR EVEN A CONCEPT. This is
'' the single biggest asymmetry in the runtime and the reason the console layer is
'' split member by member rather than behind one abstraction:
''
''   win32   __fb_con holds console HANDLES, a page table and a SMALL_RECT
''           WINDOW. The OS keeps the cursor, the colours and the character
''           cells; the runtime asks for them.
''   POSIX   __fb_con holds `termios` state, the terminal's TYPE, a SHADOW COPY
''           of the screen as character and attribute buffers, the cursor
''           position, the current colours, a table of termcap escape sequences
''           and a set of function pointers into whichever keyboard and mouse
''           driver was chosen. The runtime keeps all of it, because a terminal
''           will not tell you.
''
'' THE OBJECT ITSELF IS NOW tiko-rt's ON BOTH PLATFORMS -- src/init/hinitwin.tiko
'' on Windows and src/init/hinitposix.tiko on POSIX, each defining it with its own
'' #assert'd struct. This header used to say it lived in win32/io_window.o; that
'' was WRONG. fbc's io_window.o carries __fb_con as U (and on win64 as the
'' mingw-w64 `.refptr.__fb_con` indirection, which is what made it look like a
'' definition to a careless read); the only definer on Windows was, and is,
'' hinit.o.
''
'' The Windows layout below still MIRRORS rather than includes its definition,
'' because it is read by two dozen members tiko-rt does NOT own, from the print
'' buffer to the graphics library -- a wrong offset here is a silent write into an
'' unrelated field, in fbc's code as much as in ours. The two records are kept
'' honest by the #asserts in the defining module, not by the compiler. The POSIX
'' offsets are no longer a mirror: they are offsetof the defining type itself.
''
'' EVERY WINDOWS OFFSET IS MEASURED.
''
''   win64  a C probe compiled with clang --target=x86_64-w64-windows-gnu
''          against fbc's own headers: sizeof 80, and the field table below.
''   win32  the same layout with pointers halved, CONFIRMED BY DISASSEMBLY of
''          fbc's own win32 objects --
''              io_locate.o   movl $0x0, 0x2c   + IMAGE_REL_I386_DIR32 ___fb_con
''                            -> scrollWasOff at 44
''              io_getsize.o  movzwl 0x20 / 0x22 / 0x24 / 0x26
''                            -> window.Left/Top/Right/Bottom at 32/34/36/38
''   POSIX  NOT TYPED HERE: offsetof into FBCONSOLE_ (inc/conposix.ti), whose two
''          termios are the binding's. On glibc x86-64 conposix.ti asserts the layout
''          a gcc probe under WSL measured against fbc's headers: sizeof 408.

#pragma once

#include once "inc/descriptors.ti"

const FB_SCRN_DEFAULT_WIDTH  = 80
const FB_SCRN_DEFAULT_HEIGHT = 25

const FB_COLOR_FG_DEFAULT = &h1
const FB_COLOR_BG_DEFAULT = &h2

#if defined( __FB_WIN32__ ) or defined( __FB_WIN64__ )

	'' MEASURED (see the file header).
	''
	''            win64   win32
	''   inHandle      0       0
	''   outHandle     8       4
	''   pgHandleTb   16       8      4 entries
	''   active       48      24
	''   visible      52      28
	''   window       56      32      SMALL_RECT: 4 SHORTs, 8 bytes
	''   setByUser    64      40
	''   scrollWasOff 68      44
	''   mouseHook    72      48
	''   sizeof       80      52
	#if defined( __FB_64BIT__ )
		const TKORT_CON_WINDOW       = 56
		const TKORT_CON_SCROLLWASOFF = 68
#else
		const TKORT_CON_WINDOW       = 32
		const TKORT_CON_SCROLLWASOFF = 44
#endif

	'' SMALL_RECT is Left, Top, Right, Bottom as SHORT, in that order.
	const TKORT_RECT_LEFT   = 0
	const TKORT_RECT_TOP    = 2
	const TKORT_RECT_RIGHT  = 4
	const TKORT_RECT_BOTTOM = 6

	extern "c"   '' NON-FBCALL: fbc's own console object, declared plain.
		extern __fb_con alias "__fb_con" as uint8
	end extern

	#define TKORT_CON_WINDOW_LEFT()   (*cptr( int16 ptr, @__fb_con + TKORT_CON_WINDOW + TKORT_RECT_LEFT ))
	#define TKORT_CON_WINDOW_TOP()    (*cptr( int16 ptr, @__fb_con + TKORT_CON_WINDOW + TKORT_RECT_TOP ))
	#define TKORT_CON_WINDOW_RIGHT()  (*cptr( int16 ptr, @__fb_con + TKORT_CON_WINDOW + TKORT_RECT_RIGHT ))
	#define TKORT_CON_WINDOW_BOTTOM() (*cptr( int16 ptr, @__fb_con + TKORT_CON_WINDOW + TKORT_RECT_BOTTOM ))
	#define TKORT_CON_SCROLLOFF()     (*cptr( int32 ptr, @__fb_con + TKORT_CON_SCROLLWASOFF ))

	'' An EMPTY rect means the window has not been read yet, which is also how a
	'' redirected handle looks -- fb_InitConsoleWindow fills it and leaves it
	'' empty for a pipe or a file.
	#define TKORT_CON_WINDOW_EMPTY() _
		((TKORT_CON_WINDOW_LEFT() = TKORT_CON_WINDOW_RIGHT()) orelse _
		 (TKORT_CON_WINDOW_TOP() = TKORT_CON_WINDOW_BOTTOM()))

	'' CONSOLE_SCREEN_BUFFER_INFO: dwSize (2 SHORTs), dwCursorPosition (2),
	'' wAttributes (WORD), srWindow (4 SHORTs), dwMaximumWindowSize (2).
	'' 22 bytes, no padding -- every member is 2-byte aligned.
	const CSBI_SIZE_        = 22
	const CSBI_DWSIZE_X_    = 0
	const CSBI_DWSIZE_Y_    = 2
	const CSBI_CURSOR_X_    = 4
	const CSBI_CURSOR_Y_    = 6
	const CSBI_ATTRIBUTES_  = 8

	'' CONSOLE_CURSOR_INFO: dwSize (DWORD), bVisible (BOOL). 8 bytes.
	const CCI_SIZE_    = 8
	const CCI_VISIBLE_ = 4

	'' COORD is two SHORTs and is passed BY VALUE, which on win64 means packed
	'' into one 32-bit register slot -- so it is declared as a LONG and built by
	'' hand rather than as a UDT, whose by-value ABI FreeBASIC would not
	'' necessarily match.
	#define TKORT_COORD( x, y ) _
		((cast( uint32, cast( uint16, y ) ) shl 16) or cast( uint32, cast( uint16, x ) ))

	extern "c"   '' NON-FBCALL: kernel32 imports, not rtlib entry points.
		declare function w_GetConsoleScreenBufferInfo stdcall alias "GetConsoleScreenBufferInfo" _
			( byval h as any ptr, byval info as any ptr ) as int32
		declare function w_SetConsoleCursorPosition stdcall alias "SetConsoleCursorPosition" _
			( byval h as any ptr, byval c as uint32 ) as int32
		declare function w_GetConsoleCursorInfo stdcall alias "GetConsoleCursorInfo" _
			( byval h as any ptr, byval info as any ptr ) as int32
		declare function w_SetConsoleCursorInfo stdcall alias "SetConsoleCursorInfo" _
			( byval h as any ptr, byval info as any ptr ) as int32
		declare function w_SetConsoleTextAttribute stdcall alias "SetConsoleTextAttribute" _
			( byval h as any ptr, byval attr as uint16 ) as int32
		declare function w_GetLargestConsoleWindowSize stdcall alias "GetLargestConsoleWindowSize" _
			( byval h as any ptr ) as uint32
		declare function w_GetConsoleMode stdcall alias "GetConsoleMode" _
			( byval h as any ptr, byval mode_ as uint32 ptr ) as int32
		declare function w_ReadConsoleOutputAttribute stdcall alias "ReadConsoleOutputAttribute" _
			( byval h as any ptr, byval buf as uint16 ptr, byval n as uint32, byval c as uint32, byval got as uint32 ptr ) as int32
		declare function w_ReadConsoleOutputCharacterA stdcall alias "ReadConsoleOutputCharacterA" _
			( byval h as any ptr, byval buf as zstring ptr, byval n as uint32, byval c as uint32, byval got as uint32 ptr ) as int32
	end extern

	'' fbc's own, and they stay fbc's: the handle cache is in io_gethnd.o and the
	'' VIEW PRINT window arithmetic in io_window.o.
	extern "c"   '' NON-FBCALL: internal, declared plain in fb_private_console.h.
		declare function tkrt_hConsoleGetHandle alias "fb_hConsoleGetHandle" ( byval is_input as int32 ) as any ptr
		declare sub tkrt_InitConsoleWindow alias "fb_InitConsoleWindow" ( )
		declare sub tkrt_hConsoleGetWindow alias "fb_hConsoleGetWindow" _
			( byval l as int32 ptr, byval t as int32 ptr, byval c as int32 ptr, byval r as int32 ptr )
	end extern

	extern "rtlib"
		declare sub tkrt_hUpdateConsoleWindow alias "fb_hUpdateConsoleWindow" ( )
		declare sub tkrt_hConvertToConsole alias "fb_hConvertToConsole" _
			( byval l as int32 ptr, byval t as int32 ptr, byval r as int32 ptr, byval b as int32 ptr )
		declare sub tkrt_hConvertFromConsole alias "fb_hConvertFromConsole" _
			( byval l as int32 ptr, byval t as int32 ptr, byval r as int32 ptr, byval b as int32 ptr )
	end extern

	#define TKORT_IN_HANDLE()  tkrt_hConsoleGetHandle( 1 )
	#define TKORT_OUT_HANDLE() tkrt_hConsoleGetHandle( 0 )

#elseif defined( __FB_UNIX__ )

	#include once "inc/conposix.ti"

	'' THE OFFSETS ARE TAKEN FROM THE TYPE, not typed: FBCONSOLE_ lives in inc/conposix.ti,
	'' which src/init/hinitposix.tiko defines __fb_con with, and it embeds the binding's
	'' struct_termios -- so every offset below follows the target's termios layout. On
	'' glibc x86-64 conposix.ti asserts fbc's measured C layout (sizeof 408).
	const TKORT_CON_INITED    = offsetof( FBCONSOLE_, inited )
	const TKORT_CON_TERMTYPE  = offsetof( FBCONSOLE_, term_type )
	const TKORT_CON_FGCOLOR   = offsetof( FBCONSOLE_, fg_color )
	const TKORT_CON_BGCOLOR   = offsetof( FBCONSOLE_, bg_color )
	const TKORT_CON_CURX      = offsetof( FBCONSOLE_, cur_x )
	const TKORT_CON_CURY      = offsetof( FBCONSOLE_, cur_y )
	const TKORT_CON_W         = offsetof( FBCONSOLE_, w )
	const TKORT_CON_H         = offsetof( FBCONSOLE_, h )
	const TKORT_CON_CHARBUF   = offsetof( FBCONSOLE_, char_buffer )
	const TKORT_CON_ATTRBUF   = offsetof( FBCONSOLE_, attr_buffer )
	'' has_perm, linux/x86: src/init/hinitposix.tiko sets it from ioperm and
	'' src/sys/ports.tiko reads it before every INP and OUT.
	const TKORT_CON_HASPERM   = offsetof( FBCONSOLE_, has_perm )

	const INIT_CONSOLE_ = 1
	const TERM_XTERM_   = 1

	const TKORT_CON_SCROLLREGION = offsetof( FBCONSOLE_, scroll_region_changed )

	'' The handler slots, all function pointers. These are how the keyboard and
	'' mouse drivers install themselves: src/io/multikeyposix.tiko and
	'' src/io/mouseposix.tiko WRITE them, and src/init/hinitposix.tiko's
	'' background thread and console init/exit CALL through them.
	'' h_in is the /dev/tty descriptor the console layer opened.
	const TKORT_CON_HIN          = offsetof( FBCONSOLE_, h_in )

	const TKORT_CON_KBGETCH      = offsetof( FBCONSOLE_, keyboard_getch )
	const TKORT_CON_KBINIT       = offsetof( FBCONSOLE_, keyboard_init )
	const TKORT_CON_KBEXIT       = offsetof( FBCONSOLE_, keyboard_exit )
	const TKORT_CON_KBHANDLER    = offsetof( FBCONSOLE_, keyboard_handler )
	const TKORT_CON_MOUSEINIT    = offsetof( FBCONSOLE_, mouse_init )
	const TKORT_CON_MOUSEEXIT    = offsetof( FBCONSOLE_, mouse_exit )
	const TKORT_CON_MOUSEHANDLER = offsetof( FBCONSOLE_, mouse_handler )
	const TKORT_CON_MOUSEUPDATE  = offsetof( FBCONSOLE_, mouse_update )
	const TKORT_CON_GFXEXIT      = offsetof( FBCONSOLE_, gfx_exit )

	const SEQ_LOCATE_       = 0
	const SEQ_SCROLL_REGION_ = 2
	const SEQ_CLEOL_        = 4
	const SEQ_SCROLL_       = 11
	const SEQ_WINDOW_SIZE_  = 5
	const SEQ_FG_COLOR_     = 7
	const SEQ_BG_COLOR_     = 8
	const SEQ_RESET_COLOR_  = 9
	const SEQ_BRIGHT_COLOR_ = 10
	const SEQ_SHOW_CURSOR_  = 12
	const SEQ_HIDE_CURSOR_  = 13
	const SEQ_SET_COLOR_EX_ = 107

	extern "c"   '' NON-FBCALL: fbc's own console object, declared plain.
		extern __fb_con alias "__fb_con" as uint8
	end extern

	#define TKORT_CON_L( off ) (*cptr( int32 ptr, @__fb_con + (off) ))
	#define TKORT_CON_U( off ) (*cptr( uint32 ptr, @__fb_con + (off) ))
	#define TKORT_CON_P( off ) (*cptr( uint8 ptr ptr, @__fb_con + (off) ))

	'' fbc's own, all in unix/hinit.o, and they stay fbc's.
	extern "c"   '' NON-FBCALL: internal, declared plain in fb_private_console.h.
		declare sub tkrt_BgLock TKORT_FBCALL alias "fb_BgLock" ( )
		declare sub tkrt_BgUnlock TKORT_FBCALL alias "fb_BgUnlock" ( )
		declare sub tkrt_hRecheckConsoleSize alias "fb_hRecheckConsoleSize" ( byval requery as int32 )
		declare sub tkrt_hRecheckCursorPos alias "fb_hRecheckCursorPos" ( )
		declare function tkrt_hTermOut alias "fb_hTermOut" _
			( byval code_ as int32, byval p1 as int32, byval p2 as int32 ) as int32
		declare function c_isatty alias "isatty" ( byval fd as int32 ) as int32
	end extern

#else
	#error "inc/console.ti: no console context for this target"
#endif
