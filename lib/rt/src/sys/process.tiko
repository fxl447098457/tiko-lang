'' process.tiko -- CURDIR$, EXEPATH$, COMMAND$, CHDIR, MKDIR, RMDIR, EXEC, RUN,
'' CHAIN, SHELL and the command-line splitter. Eleven symbols across eleven fbc
'' members, and portable -- every per-platform part is behind an h-prefixed
'' helper that stays fbc's.
''
'' MAX_PATH IS 260 ON WINDOWS AND 1024 EVERYWHERE ELSE, and the difference is not
'' cosmetic: it is the size of the stack buffer these two functions hand to the
'' platform helper, so getting it wrong is either a truncated path or a stack
'' overrun. fb.h defines 1024 only `#ifndef HOST_WIN32`, leaving windows.h's 260
'' in place on Windows.
''
'' THE THREE DIRECTORY VERBS RETURN THE C LIBRARY'S CODE, NOT AN FB ERROR NUMBER.
'' `MKDIR "x"` yields 0 or -1 straight from mkdir(2), and nothing calls
'' fb_ErrorSetNum -- so ERR after a failed MKDIR is whatever it was before. A
'' program has to test the RETURN.
''
'' AND THEY DO NOT CHECK FOR A NULL DESCRIPTOR. `path->data` is dereferenced
'' unconditionally, so `MKDIR ""` on a never-assigned string passes NULL to the
'' CRT. Reproduced: fbc's behaviour there is the CRT's, and adding a guard would
'' turn a platform-defined result into a defined one.
''
'' RUN NEVER RETURNS ON SUCCESS. It execs and then calls fb_End(0) -- the -1 at
'' the bottom is reached only when the exec failed. CHAIN is EXEC with no
'' arguments, and EXEC is EXECEX with the wait flag set; the three differ by two
'' booleans and nothing else.
''
'' COMMAND$(-1) JOINS WITH SINGLE SPACES AND ALLOCATES FOR EXACTLY THAT: the
'' length is the sum of the argument lengths plus argc-2 separators. Off by one
'' either way is a heap overrun or a truncated tail, and the count is argc-2
'' rather than argc-1 because argv[0] is excluded.
''
'' THE ARGUMENT SPLITTER IMPLEMENTS THE WINDOWS BACKSLASH RULE, on every target.
'' A run of backslashes before a quote is halved, and the quote is literal only
'' if the run was ODD -- `\"` is a quote, `\\"` is one backslash and a delimiter.
'' Backslashes NOT before a quote are literal. This is msvcrt's rule and fbc
'' applies it to the whole command line regardless of platform, so a Linux
'' program built with fbc splits its arguments the Windows way.

#include once "inc/descriptors.ti"
#include once "inc/ctx.ti"
#include once "inc/iolock.ti"
#include once "inc/sysbind.ti"
#include once "inc/upath.ti"

'' See the file header. windows.h's value on Windows, fb.h's elsewhere.
#ifdef __FB_WIN32__
	'' ...in UTF-8 bytes: CURDIR and EXEPATH come back as UTF-8 now (inc/upath.ti), and
	'' windows.h's 260 UTF-16 units are up to three bytes each.
	const MAX_PATH_ = 260 * 3 + 1
#else
	const MAX_PATH_ = 1024
#endif

extern "rtlib"
	declare sub tkrt_End alias "fb_End" ( byval errlevel as int32 )
	declare function tkrt_ExecEx alias "fb_ExecEx" _
		( byval program as FBSTRING ptr, byval args as FBSTRING ptr, byval wait_ as int32 ) as int32
end extern

extern "c"   '' NON-FBCALL: the h-prefixed helpers, all undecorated in fbc's
             '' win32 archive.
	declare function tkrt_hStrAllocTemp TKORT_FBCALL alias "fb_hStrAllocTemp" _
		( byval s as FBSTRING ptr, byval length as integer ) as FBSTRING ptr
	declare function tkrt_DelTemp TKORT_FBCALL alias "fb_hStrDelTemp" ( byval s as FBSTRING ptr ) as int32
	declare sub tkrt_StrCopy TKORT_FBCALL alias "fb_hStrCopy" _
		( byval dst as zstring ptr, byval src as zstring ptr, byval bytes as integer )
	declare function tkrt_hGetCurrentDir alias "fb_hGetCurrentDir" _
		( byval buffer as zstring ptr, byval maxlen as integer ) as integer
	declare function tkrt_hGetExePath alias "fb_hGetExePath" _
		( byval buffer as zstring ptr, byval maxlen as integer ) as zstring ptr
	declare function tkrt_hShell alias "fb_hShell" ( byval cmd as zstring ptr ) as int32
end extern

'' The CRT directory calls. MinGW spells all three with a leading underscore and
'' mkdir takes no mode; POSIX spells them plainly and mkdir takes one.
#ifdef __FB_WIN32__
	extern "c"   '' NON-FBCALL: CRT entry points, not runtime ones.
		declare function crt_wchdir alias "_wchdir" ( byval p as wstring ptr ) as int32
		declare function crt_wmkdir alias "_wmkdir" ( byval p as wstring ptr ) as int32
		declare function crt_wrmdir alias "_wrmdir" ( byval p as wstring ptr ) as int32
	end extern
#elseif defined( __FB_UNIX__ )
	extern "c"   '' NON-FBCALL: CRT entry points, not runtime ones.
		declare function crt_chdir alias "chdir" ( byval p as zstring ptr ) as int32
		declare function crt_mkdir_ alias "mkdir" ( byval p as zstring ptr, byval m as mode_t ) as int32
		declare function crt_rmdir alias "rmdir" ( byval p as zstring ptr ) as int32
	end extern
	'' S_IRWXU | S_IRWXG | S_IROTH | S_IXOTH -- 0775, from the posix binding. NOT
	'' 0777: fbc creates directories group-writable and world-readable, and the
	'' umask narrows it further. 0777 here would be a different directory mode.
	const MKDIR_MODE = S_IRWXU or S_IRWXG or S_IROTH or S_IXOTH
#else
	#error "sys/process: no directory backend for this target"
#endif

#ifdef __FB_WIN32__
'' _wchdir (0), _wmkdir (1) or _wrmdir (2) over the path as UTF-16 (inc/upath.ti): UTF-8 if
'' valid, else the ANSI code page. -1 when it does not convert, as the CRT says for a bad path.
private function hWideDirCall( byval p as zstring ptr, byval which as int32 ) as int32
	dim as wstring ptr w = tkrt_PathToWide( p )
	if( w = nullptr ) then return -1
	dim as int32 r = any
	select case which
	case 0 : r = crt_wchdir( w )
	case 1 : r = crt_wmkdir( w )
	case else : r = crt_wrmdir( w )
	end select
	free( w )
	return r
end function
#endif

#ifdef __FB_WIN32__

'' THE CRT's OWN WIDE PARSE of the command line, so the split is exactly the narrow argv's:
'' the UCRT's _configure_wide_argv on the Microsoft ABI, msvcrt's __wgetmainargs elsewhere.
#ifdef TKORT_MSVC
	extern "c"   '' NON-FBCALL: ucrtbase.dll.
		declare function crt_configure_wide_argv alias "_configure_wide_argv" ( byval mode_ as int32 ) as int32
		declare function crt_p_argc alias "__p___argc" ( ) as int32 ptr
		declare function crt_p_wargv alias "__p___wargv" ( ) as wstring ptr ptr ptr
	end extern
#else
	extern "c"   '' NON-FBCALL: msvcrt.dll.
		declare function crt_wgetmainargs alias "__wgetmainargs" _
			( byval argc as int32 ptr, byval argv as wstring ptr ptr ptr, byval env as wstring ptr ptr ptr, _
			  byval glob as int32, byval si as int32 ptr ) as int32
	end extern
#endif

dim shared as zstring ptr ptr hArgv8 = nullptr

'' COMMAND'S ARGUMENTS AS UTF-8 on Windows -- a tiko divergence from fbc, whose COMMAND is the
'' CRT's ANSI argv, where an argument the code page cannot spell is already lost: by the
'' author's decision (C:\dev\docs	iko-unicode-paths\PLAN.md). Built once, on the first
'' COMMAND, and kept for the life of the process, as the CRT keeps its own. The narrow argv is
'' the answer whenever the wide one is not there or has a different count, and for any single
'' argument that does not convert. Two threads making the first call at once can both build
'' it; one copy is then never freed, which is all that race costs.
private function hArgvUtf8( ) as zstring ptr ptr
	if( hArgv8 <> nullptr ) then return hArgv8
	dim as int32 wc = 0
	dim as wstring ptr ptr wv = nullptr
	#ifdef TKORT_MSVC
		'' 1 = _crt_argv_unexpanded_arguments, as _configure_narrow_argv was called.
		if( crt_configure_wide_argv( 1 ) = 0 ) then
			wc = *crt_p_argc( )
			wv = *crt_p_wargv( )
		end if
	#else
		dim as wstring ptr ptr wenv = nullptr
		dim as int32 si = 0   '' _startupinfo: one int, newmode
		if( crt_wgetmainargs( @wc, @wv, @wenv, 0, @si ) <> 0 ) then wv = nullptr
	#endif
	if( (wv = nullptr) orelse (wc <> __fb_ctx.argc) ) then return __fb_ctx.argv
	dim as zstring ptr ptr a = malloc( sizeof( any ptr ) * cast( uinteger, wc + 1 ) )
	if( a = nullptr ) then return __fb_ctx.argv
	for i as integer = 0 to wc - 1
		a[i] = tkrt_WideToUtf8( wv[i] )
		if( a[i] = nullptr ) then a[i] = __fb_ctx.argv[i]
	next
	a[wc] = nullptr
	hArgv8 = a
	return a
end function

#endif

extern "rtlib"

'' ------------------------------------------------------------------ CURDIR$

'' THE COPY IS len + 1 BYTES, taking the terminator with it -- fb_hStrAllocTemp
'' allocates len + 1 and the helper wrote a NUL, so this is exact rather than
'' generous.
function tkort_CurDir alias "fb_CurDir" ( ) as FBSTRING ptr

	dim as FBSTRING ptr dst = any
	dim as zstring * (MAX_PATH_) tmp = any

	TKORT_IOLOCK()

	dim as integer length_ = tkrt_hGetCurrentDir( @tmp, MAX_PATH_ )

	if( length_ > 0 ) then
		dst = tkrt_hStrAllocTemp( nullptr, length_ )
		if( dst <> nullptr ) then
			memcpy( dst->data, @tmp, length_ + 1 )
		else
			dst = TKORT_NULLSTR()
		end if
	else
		'' Zero length is the failure case too, not just an empty directory --
		'' there is no such thing as an empty current directory.
		dst = TKORT_NULLSTR()
	end if

	TKORT_IOUNLOCK()

	return dst
end function

'' ------------------------------------------------------------------ EXEPATH$

'' NO LOCK, unlike CURDIR$ -- and that is fbc's, not an oversight to fix here:
'' the executable's path cannot change while the program runs, so there is
'' nothing for two threads to race over.
''
'' The buffer is MAX_PATH + 1 and the helper is told MAX_PATH, so a path of
'' exactly MAX_PATH characters still has room for its terminator.
function tkort_ExePath alias "fb_ExePath" ( ) as FBSTRING ptr

	dim as FBSTRING ptr dst = any
	dim as zstring * (MAX_PATH_ + 1) tmp = any

	dim as zstring ptr p = tkrt_hGetExePath( @tmp, MAX_PATH_ )

	if( p <> nullptr ) then
		'' strlen of the BUFFER, not of the returned pointer: the helper may
		'' return its argument or a pointer into it, and fbc measures tmp.
		dim as integer length_ = strlen( @tmp )
		dst = tkrt_hStrAllocTemp( nullptr, length_ )
		if( dst <> nullptr ) then
			tkrt_StrCopy( dst->data, @tmp, length_ )
		else
			dst = TKORT_NULLSTR()
		end if
	else
		dst = TKORT_NULLSTR()
	end if

	return dst
end function

'' ------------------------------------------------------------------ COMMAND$


'' arg < 0 JOINS EVERYTHING FROM argv[1]; arg >= argc is the empty string, and
'' arg = 0 is the program name. A program with no arguments answers "" to
'' COMMAND$(-1) without allocating anything.
function tkort_Command alias "fb_Command" ( byval arg as int32 ) as FBSTRING ptr

	dim as FBSTRING ptr dst = any
	dim as integer i = any, length_ = any

	'' ON WINDOWS THE ARGUMENTS ARE UTF-8 (hArgvUtf8), not the CRT's ANSI argv.
	#ifdef __FB_WIN32__
		dim as zstring ptr ptr argv_ = hArgvUtf8( )
	#else
		dim as zstring ptr ptr argv_ = __fb_ctx.argv
	#endif

	if( arg < 0 ) then
		if( __fb_ctx.argc <= 1 ) then return TKORT_NULLSTR()

		'' The separators are argc-2 of them: one between each pair of the
		'' argc-1 arguments from argv[1] up.
		length_ = 0
		for i = 1 to __fb_ctx.argc - 1
			length_ += strlen( argv_[i] )
		next

		dst = tkrt_hStrAllocTemp( nullptr, length_ + __fb_ctx.argc - 2 )
		if( dst = nullptr ) then return TKORT_NULLSTR()

		'' strcat from an empty start, exactly as fbc does -- quadratic in the
		'' argument count and irrelevant at any realistic one.
		dst->data[0] = 0
		for i = 1 to __fb_ctx.argc - 1
			strcat( dst->data, argv_[i] )
			if( i <> __fb_ctx.argc - 1 ) then strcat( dst->data, @" " )
		next

		return dst
	end if

	if( arg >= __fb_ctx.argc ) then return TKORT_NULLSTR()

	length_ = strlen( argv_[arg] )
	dst = tkrt_hStrAllocTemp( nullptr, length_ )
	if( dst = nullptr ) then return TKORT_NULLSTR()

	strcpy( dst->data, argv_[arg] )

	return dst
end function

'' ---------------------------------------------------------- the directories

'' The CRT's return value, unchanged, and the temp deleted afterwards. See the
'' file header on why there is no NULL check and no fb_ErrorSetNum.
function tkort_ChDir alias "fb_ChDir" ( byval path as FBSTRING ptr ) as int32
	#ifdef __FB_WIN32__
		dim as int32 res = hWideDirCall( path->data, 0 )
	#elseif defined( __FB_UNIX__ )
		dim as int32 res = crt_chdir( path->data )
	#else
		#error "sys/process: no backend for this target"
	#endif
	tkrt_DelTemp( path )
	return res
end function

function tkort_MkDir alias "fb_MkDir" ( byval path as FBSTRING ptr ) as int32
	#ifdef __FB_WIN32__
		dim as int32 res = hWideDirCall( path->data, 1 )
	#elseif defined( __FB_UNIX__ )
		dim as int32 res = crt_mkdir_( path->data, MKDIR_MODE )
	#else
		#error "sys/process: no backend for this target"
	#endif
	tkrt_DelTemp( path )
	return res
end function

function tkort_RmDir alias "fb_RmDir" ( byval path as FBSTRING ptr ) as int32
	#ifdef __FB_WIN32__
		dim as int32 res = hWideDirCall( path->data, 2 )
	#elseif defined( __FB_UNIX__ )
		dim as int32 res = crt_rmdir( path->data )
	#else
		#error "sys/process: no backend for this target"
	#endif
	tkrt_DelTemp( path )
	return res
end function

'' ------------------------------------------------------------- the processes

'' EXEC waits; RUN does not come back; CHAIN is EXEC with no arguments. All
'' three are fb_ExecEx with different flags, and NONE of them deletes its temp
'' descriptor -- fb_ExecEx does that, because it is the one that reads them.
function tkort_Exec alias "fb_Exec" _
	( byval program as FBSTRING ptr, byval args as FBSTRING ptr ) as int32

	return tkrt_ExecEx( program, args, FB_TRUE )
end function

'' -1 IS THE ONLY THING THIS CAN RETURN. On success fb_End never comes back; on
'' failure fb_ExecEx already returned -1 and so does this.
function tkort_Run alias "fb_Run" _
	( byval program as FBSTRING ptr, byval args as FBSTRING ptr ) as int32

	if( tkrt_ExecEx( program, args, FB_FALSE ) <> -1 ) then tkrt_End( 0 )
	return -1
end function

function tkort_Chain alias "fb_Chain" ( byval program as FBSTRING ptr ) as int32
	return tkrt_ExecEx( program, nullptr, FB_TRUE )
end function

'' A NULL OR UNASSIGNED PROGRAM STRING IS -1 WITHOUT A SHELL, and this is the
'' one function in the group that does check -- because it passes the pointer to
'' the platform's shell rather than to the CRT.
function tkort_Shell alias "fb_Shell" ( byval program as FBSTRING ptr ) as int32

	dim as int32 errcode = -1

	if( (program <> nullptr) andalso (program->data <> nullptr) ) then
		errcode = tkrt_hShell( program->data )
	end if

	tkrt_DelTemp( program )

	return errcode
end function

end extern

'' ------------------------------------------------------- the argument split

extern "c"   '' NON-FBCALL: fb_system.h declares fb_hParseArgs plainly.

'' THE WINDOWS BACKSLASH RULE, ON EVERY TARGET. See the file header.
''
''   an ODD run of backslashes before a quote  -- the run is halved and the
''                                                quote is LITERAL
''   an EVEN run before a quote                -- the run is halved and the
''                                                quote TOGGLES quoting
''   backslashes anywhere else                 -- literal, every one
''
'' The halving is done by REWINDING the write pointer over backslashes already
'' emitted, which is why they are written first and taken back afterwards.
''
'' BOTH ' ' AND NUL ARE DELIMITERS, so a command line built from a NUL-separated
'' block splits the same way as one built from a spaced string -- and a quoted
'' space becomes a literal space rather than ending the argument.
''
'' Returns -1 for a NULL buffer or a negative length, and the ARGUMENT COUNT
'' otherwise; dst must be at least as large as src.
function tkort_hParseArgs alias "fb_hParseArgs" _
	( byval dst as zstring ptr, byval src as zstring ptr, byval length_ as integer ) as int32

	dim as int32 in_quote = 0, argc = 0
	dim as integer bs_count = 0, i = 0
	dim as uint8 ptr s = cast( uint8 ptr, src )
	dim as uint8 ptr p = cast( uint8 ptr, dst )

	if( (src = nullptr) orelse (dst = nullptr) orelse (length_ < 0) ) then return -1

	'' Leading whitespace, which is not an argument.
	while( (i < length_) andalso ((*s = 32) orelse (*s = 0)) )
		i += 1
		s += 1
	wend

	while( i < length_ )
		bs_count = 0

		do
			if( *s = 92 ) then                      '' '\'
				*p = *s
				p += 1
				bs_count += 1
			else
				if( *s = 34 ) then                  '' '"'
					if( (bs_count and 1) <> 0 ) then
						'' Odd run: rewind over half of it plus the one that
						'' escaped the quote, then emit the quote itself.
						p -= ((bs_count - 1) shr 1) + 1
						*p = *s
						p += 1
					else
						'' Even run: rewind over half, and the quote is a
						'' quoting toggle rather than a character.
						p -= (bs_count shr 1)
						in_quote = iif( in_quote <> 0, 0, 1 )
					end if
				elseif( (*s = 32) orelse (*s = 0) ) then
					if( in_quote <> 0 ) then
						'' Inside quotes a NUL becomes a SPACE, not a NUL --
						'' the delimiter is normalised rather than preserved.
						*p = 32
						p += 1
					else
						*p = 0
						p += 1
						exit do
					end if
				else
					*p = *s
					p += 1
				end if

				bs_count = 0
			end if

			i += 1
			s += 1
		loop while( i < length_ )

		argc += 1

		while( (i < length_) andalso ((*s = 32) orelse (*s = 0)) )
			i += 1
			s += 1
		wend
	wend

	*p = 0

	return argc
end function

end extern
