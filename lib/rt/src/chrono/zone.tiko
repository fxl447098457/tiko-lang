'' zone.tiko -- timezone offsets and locale formatting: ten entry points over
'' one fbc member, split by platform.
''
'' THE OFFSET IS ASKED FOR AT AN INSTANT, NEVER "RIGHT NOW". Converting a July
'' timestamp with January's offset is the single most common timezone bug, and
'' an API that only offered the current offset would make it the path of least
'' resistance. Every function here that can take a time, does.
''
'' WINDOWS USES THE *DYNAMIC* ZONE INFORMATION, resolved at run time.
'' GetTimeZoneInformation applies TODAY'S DST rule to every year, which
'' silently misdates anything from before a rule change;
'' GetTimeZoneInformationForYear knows the historical rules. It is Windows 7
'' and MinGW only declares it above a raised _WIN32_WINNT, so it is looked up
'' through GetProcAddress rather than imported -- the same approach the clock
'' backend takes for the Windows 8 precise-time API. When it is absent the
'' static fallback still answers correctly for the CURRENT year.
''
'' UNIX GETS HISTORICAL CORRECTNESS FOR FREE, because localtime_r reads TZ and
'' /etc/localtime, which is where glibc consults the system tz database. This
'' library ships no copy of the tzdb on either platform.
''
'' THE TWO PLATFORMS NUMBER WEEKDAYS DIFFERENTLY AND BOTH ARE HANDLED HERE:
'' Windows LOCALE_SDAYNAME1 is MONDAY, which happens to match this library's
'' ISO 1..7 exactly; Unix DAY_1 and tm_wday are SUNDAY-first, so the Unix half
'' converts with `dow mod 7`. The Windows coincidence is worth naming, because
'' it looks like an omission.
''
'' LOCALE OUTPUT CANNOT BE ASSERTED BY EXACT STRING. It is whatever the
'' machine says, which is an honest limitation and exactly why the pattern
'' formatter in chrono/pattern.tiko uses invariant English instead.

#include once "inc/descriptors.ti"
#include once "inc/chrono.ti"

const DT_ZONE_STYLE_SHORT = 0
const DT_ZONE_STYLE_LONG  = 1
const DT_ZONE_STYLE_FULL  = 2

const FB_DT_TICKS_TO_UNIX_EPOCH = 621355968000000000ll
const FB_DT_TICKS_TO_FILETIME   = 504911232000000000ll

extern "rtlib"
	declare function tkrt_DtIsValidTicks alias "fb_DtIsValidTicks" ( byval t as int64 ) as int32
	declare sub tkrt_DtToCivil alias "fb_DtToCivil" _
		( byval t as int64, byval y as int32 ptr, byval mo as int32 ptr, byval d as int32 ptr, _
		  byval h as int32 ptr, byval mi as int32 ptr, byval s as int32 ptr, byval sub_ as int64 ptr )
	declare function tkrt_DtFromCivil alias "fb_DtFromCivil" _
		( byval y as int32, byval mo as int32, byval d as int32, byval h as int32, _
		  byval mi as int32, byval s as int32, byval sub_ as int64, byval o as int64 ptr ) as int32
	declare function tkrt_DtDayOfWeek alias "fb_DtDayOfWeek" ( byval days as int32 ) as int32
	declare function tkrt_DtDayOfYear alias "fb_DtDayOfYear" ( byval y as int32, byval mo as int32, byval d as int32 ) as int32
end extern

#if defined( __FB_WIN32__ ) or defined( __FB_WIN64__ )

'' ---------------------------------------------------------- Windows backend

type SYSTEMTIME_
	as uint16 wYear, wMonth, wDayOfWeek, wDay, wHour, wMinute, wSecond, wMilliseconds
end type

type FILETIME_
	as uint32 dwLowDateTime, dwHighDateTime
end type

type TIME_ZONE_INFORMATION_
	as int32         Bias
	as wstring * 32 StandardName
	as SYSTEMTIME_  StandardDate
	as int32         StandardBias
	as wstring * 32 DaylightName
	as SYSTEMTIME_  DaylightDate
	as int32         DaylightBias
end type

'' The dynamic form is the static one plus a key name and a disable flag.
type DYNAMIC_TIME_ZONE_INFORMATION_
	as TIME_ZONE_INFORMATION_ tzi
	as wstring * 128          TimeZoneKeyName
	as int8                   DynamicDaylightTimeDisabled
end type

const TIME_ZONE_ID_INVALID = &hFFFFFFFFul
const CP_UTF8 = 65001
const DATE_SHORTDATE = &h00000001
const DATE_LONGDATE  = &h00000002
const TIME_NOSECONDS = &h00000002
const LOCALE_SDAYNAME1         = &h0000002a
const LOCALE_SABBREVDAYNAME1   = &h00000031
const LOCALE_SMONTHNAME1       = &h00000038
const LOCALE_SABBREVMONTHNAME1 = &h00000044

type FB_TZFORYEARPROC as function stdcall _
	( byval y as uint16, byval dtzi as DYNAMIC_TIME_ZONE_INFORMATION_ ptr, _
	  byval tzi as TIME_ZONE_INFORMATION_ ptr ) as int32

'' Prefixed w_ for the same reason as chrono/clock.tiko: several of the bare
'' names are already declared by headers reached through the includes.
extern "c"   '' NON-FBCALL: kernel32 imports, not rtlib entry points.
	declare function w_GetModuleHandleA stdcall alias "GetModuleHandleA" ( byval n as zstring ptr ) as any ptr
	declare function w_GetProcAddress stdcall alias "GetProcAddress" ( byval m as any ptr, byval n as zstring ptr ) as any ptr
	declare function w_GetTimeZoneInformation stdcall alias "GetTimeZoneInformation" ( byval tzi as TIME_ZONE_INFORMATION_ ptr ) as uint32
	declare function w_GetDynamicTimeZoneInformation stdcall alias "GetDynamicTimeZoneInformation" ( byval dtzi as DYNAMIC_TIME_ZONE_INFORMATION_ ptr ) as uint32
	declare function w_SystemTimeToTzSpecificLocalTime stdcall alias "SystemTimeToTzSpecificLocalTime" _
		( byval tzi as TIME_ZONE_INFORMATION_ ptr, byval utc as SYSTEMTIME_ ptr, byval lcl as SYSTEMTIME_ ptr ) as int32
	declare function w_FileTimeToSystemTime stdcall alias "FileTimeToSystemTime" ( byval ft as FILETIME_ ptr, byval st as SYSTEMTIME_ ptr ) as int32
	declare function w_WideCharToMultiByte stdcall alias "WideCharToMultiByte" _
		( byval cp as uint32, byval flags as uint32, byval wstr_ as wstring ptr, byval cch as int32, _
		  byval dst as zstring ptr, byval cb as int32, byval dflt as zstring ptr, byval used as int32 ptr ) as int32
	declare function w_GetDateFormatEx stdcall alias "GetDateFormatEx" _
		( byval loc as wstring ptr, byval flags as uint32, byval st as SYSTEMTIME_ ptr, _
		  byval fmt as wstring ptr, byval dst as wstring ptr, byval cch as int32, byval cal as wstring ptr ) as int32
	declare function w_GetTimeFormatEx stdcall alias "GetTimeFormatEx" _
		( byval loc as wstring ptr, byval flags as uint32, byval st as SYSTEMTIME_ ptr, _
		  byval fmt as wstring ptr, byval dst as wstring ptr, byval cch as int32 ) as int32
	declare function w_GetLocaleInfoEx stdcall alias "GetLocaleInfoEx" _
		( byval loc as wstring ptr, byval lctype as uint32, byval dst as wstring ptr, byval cch as int32 ) as int32
end extern

'' UTF-16 -> UTF-8 at the boundary; everything above this layer is UTF-8.
private function hW2U( byval w as wstring ptr, byval buf as zstring ptr, byval buflen as int32 ) as int32
	dim as int32 n = any
	if( w = nullptr ) then return 0
	if( buf = nullptr ) then return 0
	if( buflen < 2 ) then return 0
	n = w_WideCharToMultiByte( CP_UTF8, 0, w, -1, buf, buflen - 1, nullptr, nullptr )
	if( n <= 0 ) then
		buf[0] = 0
		return 0
	end if
	'' n INCLUDES the terminating NUL, so the length is one less and the
	'' terminator is rewritten in case the conversion filled the buffer.
	buf[n - 1] = 0
	return n - 1
end function

dim shared as FB_TZFORYEARPROC hTzForYear = nullptr
dim shared as int32 hTzForYearChecked = 0

private function hGetTzForYearProc( ) as FB_TZFORYEARPROC
	dim as any ptr k32 = any
	if( hTzForYearChecked = 0 ) then
		k32 = w_GetModuleHandleA( @"kernel32.dll" )
		if( k32 <> nullptr ) then
			hTzForYear = cast( FB_TZFORYEARPROC, _
				w_GetProcAddress( k32, @"GetTimeZoneInformationForYear" ) )
		end if
		hTzForYearChecked = 1
	end if
	return hTzForYear
end function

'' Historical rules when available, today's rules when not -- see the header.
private function hTziForYear( byval utc as SYSTEMTIME_ ptr, byval tzi as TIME_ZONE_INFORMATION_ ptr ) as int32
	dim as DYNAMIC_TIME_ZONE_INFORMATION_ dtzi = any
	dim as FB_TZFORYEARPROC forYear = hGetTzForYearProc( )

	if( forYear <> nullptr ) then
		if( w_GetDynamicTimeZoneInformation( @dtzi ) <> TIME_ZONE_ID_INVALID ) then
			if( forYear( utc->wYear, @dtzi, tzi ) <> 0 ) then return 0
		end if
	end if
	if( w_GetTimeZoneInformation( tzi ) <> TIME_ZONE_ID_INVALID ) then return 0
	return 1
end function

private function hTicksToSystemTime( byval ticks as int64, byval st as SYSTEMTIME_ ptr ) as int32
	dim as FILETIME_ ft = any
	dim as uint64 u = any
	if( tkrt_DtIsValidTicks( ticks ) = 0 ) then return 1
	u = cast( uint64, ticks - FB_DT_TICKS_TO_FILETIME )
	ft.dwLowDateTime = cast( uint32, u and &hFFFFFFFFull )
	ft.dwHighDateTime = cast( uint32, u shr 32 )
	if( w_FileTimeToSystemTime( @ft, st ) <> 0 ) then return 0
	return 1
end function

extern "rtlib"

'' The offset is DERIVED by converting the same instant twice and differencing
'' the two civil renderings, rather than read out of the Bias fields -- which
'' is what makes it correct across a DST boundary.
function tkort_DtZoneOffsetAt alias "fb_DtZoneOffsetAt" ( byval utcTicks as int64 ) as int32
	dim as SYSTEMTIME_ utc = any, lcl = any
	dim as TIME_ZONE_INFORMATION_ tzi = any
	dim as int64 lt = any, ut = any

	if( hTicksToSystemTime( utcTicks, @utc ) ) then return 0
	if( hTziForYear( @utc, @tzi ) ) then return 0
	if( w_SystemTimeToTzSpecificLocalTime( @tzi, @utc, @lcl ) = 0 ) then return 0

	if( tkrt_DtFromCivil( lcl.wYear, lcl.wMonth, lcl.wDay, lcl.wHour, lcl.wMinute, lcl.wSecond, 0, @lt ) ) then return 0
	if( tkrt_DtFromCivil( utc.wYear, utc.wMonth, utc.wDay, utc.wHour, utc.wMinute, utc.wSecond, 0, @ut ) ) then return 0

	return cast( int32, (lt - ut) \ FB_DT_TICKS_PER_MINUTE )
end function

'' In DST when the offset at that instant differs from the standard one. A zone
'' with no daylight bias is never in DST, tested first so the comparison is not
'' made for zones that do not observe it.
function tkort_DtZoneIsDst alias "fb_DtZoneIsDst" ( byval utcTicks as int64 ) as int32
	dim as SYSTEMTIME_ utc = any
	dim as TIME_ZONE_INFORMATION_ tzi = any

	if( hTicksToSystemTime( utcTicks, @utc ) ) then return 0
	if( hTziForYear( @utc, @tzi ) ) then return 0
	if( tzi.DaylightBias = 0 ) then return 0
	if( tkort_DtZoneOffsetAt( utcTicks ) <> (-tzi.Bias - tzi.StandardBias) ) then return 1
	return 0
end function

function tkort_DtZoneSupportsDst alias "fb_DtZoneSupportsDst" ( ) as int32
	dim as TIME_ZONE_INFORMATION_ tzi = any
	if( w_GetTimeZoneInformation( @tzi ) = TIME_ZONE_ID_INVALID ) then return 0
	if( tzi.DaylightBias <> 0 ) then return 1
	return 0
end function

function tkort_DtZoneStandardName alias "fb_DtZoneStandardName" ( byval buf as zstring ptr, byval buflen as int32 ) as int32
	dim as TIME_ZONE_INFORMATION_ tzi = any
	if( buf = nullptr ) then return 0
	if( buflen < 2 ) then return 0
	buf[0] = 0
	if( w_GetTimeZoneInformation( @tzi ) = TIME_ZONE_ID_INVALID ) then return 0
	return hW2U( @tzi.StandardName, buf, buflen )
end function

function tkort_DtZoneDaylightName alias "fb_DtZoneDaylightName" ( byval buf as zstring ptr, byval buflen as int32 ) as int32
	dim as TIME_ZONE_INFORMATION_ tzi = any
	if( buf = nullptr ) then return 0
	if( buflen < 2 ) then return 0
	buf[0] = 0
	if( w_GetTimeZoneInformation( @tzi ) = TIME_ZONE_ID_INVALID ) then return 0
	return hW2U( @tzi.DaylightName, buf, buflen )
end function

'' ------------------------------------------------- Windows locale formatting

'' LOCALE_NAME_USER_DEFAULT is a NULL pointer, not a string.
private function hFillSystemTime( byval ticks as int64, byval st as SYSTEMTIME_ ptr, _
                                  byval want_dow as int32 ) as int32
	dim as int32 y = any, mo = any, d = any, h = any, mi = any, s = any
	dim as int64 sub_ = any

	tkrt_DtToCivil( ticks, @y, @mo, @d, @h, @mi, @s, @sub_ )
	st->wYear = y : st->wMonth = mo : st->wDay = d
	st->wHour = h : st->wMinute = mi : st->wSecond = s
	st->wMilliseconds = 0
	if( want_dow ) then
		'' SYSTEMTIME wants SUNDAY = 0; this library's day-of-week is ISO
		'' 1..7 with Monday = 1, so `mod 7` maps Sunday's 7 to 0 and leaves
		'' the rest alone.
		st->wDayOfWeek = tkrt_DtDayOfWeek( cast( int32, ticks \ FB_DT_TICKS_PER_DAY ) ) mod 7
	else
		st->wDayOfWeek = 0
	end if
	return 0
end function

function tkort_DtLocaleDateString alias "fb_DtLocaleDateString" _
	( byval ticks as int64, byval style as int32, byval buf as zstring ptr, byval buflen as int32 ) as int32
	dim as SYSTEMTIME_ st = any
	dim as wstring * 256 wbuf
	dim as uint32 flags = any

	if( buf = nullptr ) then return 0
	if( buflen < 2 ) then return 0
	buf[0] = 0
	if( tkrt_DtIsValidTicks( ticks ) = 0 ) then return 0

	hFillSystemTime( ticks, @st, 1 )
	flags = iif( style = DT_ZONE_STYLE_SHORT, DATE_SHORTDATE, DATE_LONGDATE )
	if( w_GetDateFormatEx( nullptr, flags, @st, nullptr, @wbuf, 256, nullptr ) <= 0 ) then return 0
	return hW2U( @wbuf, buf, buflen )
end function

function tkort_DtLocaleTimeString alias "fb_DtLocaleTimeString" _
	( byval ticks as int64, byval style as int32, byval buf as zstring ptr, byval buflen as int32 ) as int32
	dim as SYSTEMTIME_ st = any
	dim as wstring * 256 wbuf
	dim as uint32 flags = any

	if( buf = nullptr ) then return 0
	if( buflen < 2 ) then return 0
	buf[0] = 0
	if( tkrt_DtIsValidTicks( ticks ) = 0 ) then return 0

	'' No weekday here: the time formatter does not read it.
	hFillSystemTime( ticks, @st, 0 )
	flags = iif( style = DT_ZONE_STYLE_SHORT, TIME_NOSECONDS, 0 )
	if( w_GetTimeFormatEx( nullptr, flags, @st, nullptr, @wbuf, 256 ) <= 0 ) then return 0
	return hW2U( @wbuf, buf, buflen )
end function

'' The twelve month names are CONSECUTIVE LCTYPE values, so the index is added
'' to the first one rather than looked up.
function tkort_DtLocaleMonthName alias "fb_DtLocaleMonthName" _
	( byval mo as int32, byval abbreviated as int32, byval buf as zstring ptr, byval buflen as int32 ) as int32
	dim as wstring * 128 wbuf
	dim as uint32 t = any

	if( buf = nullptr ) then return 0
	if( buflen < 2 ) then return 0
	buf[0] = 0
	if( (mo < 1) orelse (mo > 12) ) then return 0

	t = iif( abbreviated <> 0, LOCALE_SABBREVMONTHNAME1, LOCALE_SMONTHNAME1 ) + (mo - 1)
	if( w_GetLocaleInfoEx( nullptr, t, @wbuf, 128 ) <= 0 ) then return 0
	return hW2U( @wbuf, buf, buflen )
end function

'' WINDOWS NUMBERS THESE MONDAY-FIRST -- LOCALE_SDAYNAME1 is Monday -- which
'' happens to match this library's ISO 1..7 exactly, so no conversion is
'' needed here and one IS needed in the Unix half.
function tkort_DtLocaleWeekdayName alias "fb_DtLocaleWeekdayName" _
	( byval dow as int32, byval abbreviated as int32, byval buf as zstring ptr, byval buflen as int32 ) as int32
	dim as wstring * 128 wbuf
	dim as uint32 t = any

	if( buf = nullptr ) then return 0
	if( buflen < 2 ) then return 0
	buf[0] = 0
	if( (dow < 1) orelse (dow > 7) ) then return 0

	t = iif( abbreviated <> 0, LOCALE_SABBREVDAYNAME1, LOCALE_SDAYNAME1 ) + (dow - 1)
	if( w_GetLocaleInfoEx( nullptr, t, @wbuf, 128 ) <= 0 ) then return 0
	return hW2U( @wbuf, buf, buflen )
end function

function tkort_DtLocaleIsSupported alias "fb_DtLocaleIsSupported" ( ) as int32
	return 1
end function

end extern

#elseif defined( __FB_UNIX__ )

'' ------------------------------------------------------------- Unix backend
''
'' struct tm and LC_TIME_MASK are the posix binding's (inc/sysbind.ti), measured on
'' the target.

extern "c"   '' NON-FBCALL: libc, not rtlib entry points.
	declare function u_localtime_r alias "localtime_r" ( byval t as time_t ptr, byval result as struct_tm ptr ) as struct_tm ptr
	declare function u_time alias "time" ( byval t as time_t ptr ) as time_t
	declare sub u_tzset alias "tzset" ( )
	declare function u_strftime alias "strftime" _
		( byval s as zstring ptr, byval maxs as uinteger, byval fmt as zstring ptr, byval tmv as struct_tm ptr ) as uinteger
	declare function u_strftime_l alias "strftime_l" _
		( byval s as zstring ptr, byval maxs as uinteger, byval fmt as zstring ptr, byval tmv as struct_tm ptr, byval l as any ptr ) as uinteger
	declare function u_newlocale alias "newlocale" _
		( byval mask as int32, byval lname as zstring ptr, byval base_ as any ptr ) as any ptr
	declare sub u_freelocale alias "freelocale" ( byval l as any ptr )
end extern

private function hTicksToTimeT( byval utcTicks as int64 ) as time_t
	return cast( time_t, (utcTicks - FB_DT_TICKS_TO_UNIX_EPOCH) \ FB_DT_TICKS_PER_SECOND )
end function

'' Bytes, through uint8 ptrs: 'buf[n] = s[n]' on zstring ptrs is a STRING
'' assignment that copies the whole rest of s, past buflen (TS-003).
private function hCopyStr( byval s as zstring ptr, byval buf as zstring ptr, byval buflen as int32 ) as int32
	dim as uint8 ptr ps = cptr( uint8 ptr, s ), d = cptr( uint8 ptr, buf )
	dim as int32 n = 0
	if( d = nullptr ) then return 0
	if( buflen < 2 ) then return 0
	if( ps = nullptr ) then
		d[0] = 0
		return 0
	end if
	while( (ps[n] <> 0) andalso (n < buflen - 1) )
		d[n] = ps[n]
		n += 1
	wend
	d[n] = 0
	return n
end function

extern "rtlib"

'' tm_gmtoff read directly: glibc and Darwin have it, so the portable fallback of
'' differencing mktime over the local and UTC renderings is not needed.
function tkort_DtZoneOffsetAt alias "fb_DtZoneOffsetAt" ( byval utcTicks as int64 ) as int32
	dim as time_t t = any
	dim as struct_tm tmv = any

	if( tkrt_DtIsValidTicks( utcTicks ) = 0 ) then return 0
	t = hTicksToTimeT( utcTicks )
	'' localtime_r, NEVER localtime -- this has to be thread-safe.
	if( u_localtime_r( @t, @tmv ) = nullptr ) then return 0
	return cast( int32, tmv.tm_gmtoff \ 60 )
end function

'' tm_isdst is TRI-STATE: positive means DST, zero means not, negative means
'' unknown. Only a positive value counts as DST.
function tkort_DtZoneIsDst alias "fb_DtZoneIsDst" ( byval utcTicks as int64 ) as int32
	dim as time_t t = any
	dim as struct_tm tmv = any

	if( tkrt_DtIsValidTicks( utcTicks ) = 0 ) then return 0
	t = hTicksToTimeT( utcTicks )
	if( u_localtime_r( @t, @tmv ) = nullptr ) then return 0
	if( tmv.tm_isdst > 0 ) then return 1
	return 0
end function

'' MIDWINTER AGAINST MIDSUMMER of the current year. Cheaper and more portable
'' than reading the tzdb, and it does not care which hemisphere we are in --
'' the two offsets differ either way if the zone observes DST at all.
function tkort_DtZoneSupportsDst alias "fb_DtZoneSupportsDst" ( ) as int32
	dim as time_t now_ = any
	dim as struct_tm tmv = any
	dim as int32 janOff = any, julOff = any, year_ = any
	dim as int64 jan = any, jul = any

	now_ = u_time( nullptr )
	if( u_localtime_r( @now_, @tmv ) = nullptr ) then return 0
	year_ = tmv.tm_year + 1900
	if( (year_ < FB_DT_MIN_YEAR) orelse (year_ > FB_DT_MAX_YEAR) ) then return 0

	if( tkrt_DtFromCivil( year_, 1, 15, 12, 0, 0, 0, @jan ) ) then return 0
	if( tkrt_DtFromCivil( year_, 7, 15, 12, 0, 0, 0, @jul ) ) then return 0

	janOff = tkort_DtZoneOffsetAt( jan )
	julOff = tkort_DtZoneOffsetAt( jul )
	if( janOff <> julOff ) then return 1
	return 0
end function

'' THE NAMES COME FROM localtime_r's tm_zone, NOT FROM tzname. tzname is two
'' process-global pointers that any tzset may rewrite while they are read;
'' tm_zone belongs to this call's own struct tm. Midwinter and midsummer of the
'' current year are asked, as SupportsDst does: the one with tm_isdst > 0 names
'' daylight time, the other standard time. A zone with no DST this year names
'' its standard time for both -- tzname[1] there was whatever DST name the zone
'' last had, decades ago (Asia/Kolkata: "+0630", from 1945).
'' These are abbreviations ("NST"), where Windows gives display names
'' ("Newfoundland Standard Time"): OS display text, not a portable value.
private function hZoneName( byval wantDst as int32, byval buf as zstring ptr, byval buflen as int32 ) as int32
	dim as time_t now_ = any, t = any
	dim as struct_tm tmv = any
	dim as int32 year_ = any, k = any
	dim as int64 ticks = any
	dim as zstring ptr stdName = nullptr

	if( buf = nullptr ) then return 0
	if( buflen < 2 ) then return 0
	buf[0] = 0
	'' tzset re-reads TZ, so a changed TZ is followed; glibc serialises it.
	u_tzset( )
	now_ = u_time( nullptr )
	if( u_localtime_r( @now_, @tmv ) = nullptr ) then return 0
	year_ = tmv.tm_year + 1900
	if( (year_ < FB_DT_MIN_YEAR) orelse (year_ > FB_DT_MAX_YEAR) ) then return 0

	for k = 0 to 1
		if( tkrt_DtFromCivil( year_, iif( k = 0, 1, 7 ), 15, 12, 0, 0, 0, @ticks ) ) then return 0
		t = hTicksToTimeT( ticks )
		if( u_localtime_r( @t, @tmv ) = nullptr ) then return 0
		if( tmv.tm_isdst > 0 ) then
			if( wantDst <> 0 ) then return hCopyStr( tmv.tm_zone, buf, buflen )
		elseif( stdName = nullptr ) then
			stdName = tmv.tm_zone
			if( wantDst = 0 ) then return hCopyStr( stdName, buf, buflen )
		end if
	next
	return hCopyStr( stdName, buf, buflen )
end function

function tkort_DtZoneStandardName alias "fb_DtZoneStandardName" ( byval buf as zstring ptr, byval buflen as int32 ) as int32
	return hZoneName( 0, buf, buflen )
end function

function tkort_DtZoneDaylightName alias "fb_DtZoneDaylightName" ( byval buf as zstring ptr, byval buflen as int32 ) as int32
	return hZoneName( 1, buf, buflen )
end function

private sub hFillTm( byval ticks as int64, byval tmv as struct_tm ptr )
	dim as int32 y = any, mo = any, d = any, h = any, mi = any, s = any
	dim as int64 sub_ = any
	dim as int32 days = cast( int32, ticks \ FB_DT_TICKS_PER_DAY )

	tkrt_DtToCivil( ticks, @y, @mo, @d, @h, @mi, @s, @sub_ )
	tmv->tm_sec = s : tmv->tm_min = mi : tmv->tm_hour = h
	tmv->tm_mday = d
	'' tm_mon is 0-BASED and tm_year is YEARS SINCE 1900.
	tmv->tm_mon = mo - 1
	tmv->tm_year = y - 1900
	'' tm_wday is SUNDAY = 0, so the ISO 1..7 value folds with `mod 7`.
	tmv->tm_wday = tkrt_DtDayOfWeek( days ) mod 7
	tmv->tm_yday = tkrt_DtDayOfYear( y, mo, d ) - 1
	'' -1, not 0: "unknown", so strftime does not assert a DST state.
	tmv->tm_isdst = -1
	tmv->tm_gmtoff = 0
	tmv->tm_zone = nullptr
end sub

'' THE USER'S LOCALE, NOT THE PROCESS'S. Nothing calls setlocale, so plain
'' strftime runs in the C locale and always says "March". setlocale would fix
'' that for the whole process -- and break snprintf-based number formatting,
'' which expects ".". A private LC_TIME locale built from "" (LC_ALL, then
'' LC_TIME, then LANG) is read fresh on every call, so it follows the
'' environment, and is UTF-8 for a UTF-8 locale without LC_CTYPE. A locale
'' that has not been generated gives NULL, and the C locale stands.
private function hStrftime( byval buf as zstring ptr, byval buflen as int32, _
	byval fmt as zstring ptr, byval tmv as struct_tm ptr ) as int32
	dim as any ptr l = u_newlocale( LC_TIME_MASK, @"", nullptr )
	dim as int32 n = any
	if( l = nullptr ) then return cast( int32, u_strftime( buf, buflen, fmt, tmv ) )
	n = cast( int32, u_strftime_l( buf, buflen, fmt, tmv, l ) )
	u_freelocale( l )
	return n
end function

'' strftime_l with "%x"/"%X" rather than nl_langinfo_l: the same locale-driven
'' answer, with the formatting done for us. The LONG style is spelled
'' out because no locale item corresponds to it.
function tkort_DtLocaleDateString alias "fb_DtLocaleDateString" _
	( byval ticks as int64, byval style as int32, byval buf as zstring ptr, byval buflen as int32 ) as int32
	dim as struct_tm tmv = any
	if( buf = nullptr ) then return 0
	if( buflen < 2 ) then return 0
	buf[0] = 0
	if( tkrt_DtIsValidTicks( ticks ) = 0 ) then return 0
	hFillTm( ticks, @tmv )
	if( style = DT_ZONE_STYLE_SHORT ) then
		return hStrftime( buf, buflen, @"%x", @tmv )
	end if
	return hStrftime( buf, buflen, @"%A %d %B %Y", @tmv )
end function

function tkort_DtLocaleTimeString alias "fb_DtLocaleTimeString" _
	( byval ticks as int64, byval style as int32, byval buf as zstring ptr, byval buflen as int32 ) as int32
	dim as struct_tm tmv = any
	if( buf = nullptr ) then return 0
	if( buflen < 2 ) then return 0
	buf[0] = 0
	if( tkrt_DtIsValidTicks( ticks ) = 0 ) then return 0
	hFillTm( ticks, @tmv )
	'' SHORT drops the seconds with an explicit format, because no locale
	'' item means "without seconds".
	if( style = DT_ZONE_STYLE_SHORT ) then
		return hStrftime( buf, buflen, @"%H:%M", @tmv )
	end if
	return hStrftime( buf, buflen, @"%X", @tmv )
end function

function tkort_DtLocaleMonthName alias "fb_DtLocaleMonthName" _
	( byval mo as int32, byval abbreviated as int32, byval buf as zstring ptr, byval buflen as int32 ) as int32
	dim as struct_tm tmv = any
	if( buf = nullptr ) then return 0
	if( buflen < 2 ) then return 0
	buf[0] = 0
	if( (mo < 1) orelse (mo > 12) ) then return 0
	hFillTm( FB_DT_TICKS_PER_DAY, @tmv )
	tmv.tm_mon = mo - 1
	tmv.tm_mday = 1
	if( abbreviated <> 0 ) then
		return hStrftime( buf, buflen, @"%b", @tmv )
	end if
	return hStrftime( buf, buflen, @"%B", @tmv )
end function

'' THE CONVERSION WINDOWS DOES NOT NEED: this library is ISO 1 = Monday and
'' tm_wday is Sunday = 0, so `dow mod 7` maps 7 to 0 and leaves 1..6 alone.
function tkort_DtLocaleWeekdayName alias "fb_DtLocaleWeekdayName" _
	( byval dow as int32, byval abbreviated as int32, byval buf as zstring ptr, byval buflen as int32 ) as int32
	dim as struct_tm tmv = any
	if( buf = nullptr ) then return 0
	if( buflen < 2 ) then return 0
	buf[0] = 0
	if( (dow < 1) orelse (dow > 7) ) then return 0
	hFillTm( FB_DT_TICKS_PER_DAY, @tmv )
	tmv.tm_wday = dow mod 7
	if( abbreviated <> 0 ) then
		return hStrftime( buf, buflen, @"%a", @tmv )
	end if
	return hStrftime( buf, buflen, @"%A", @tmv )
end function

function tkort_DtLocaleIsSupported alias "fb_DtLocaleIsSupported" ( ) as int32
	return 1
end function

end extern

#else
	#error "chrono/zone: no backend for this target"
#endif
