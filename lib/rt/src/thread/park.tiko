'' park.tiko -- park/unpark, a per-thread blocking primitive with a timeout, plus
'' fb_CpuCount. Six entry points over one fbc member, split by platform.
''
'' THE PERMIT IS A SEPARATE FLAG, NOT THE KERNEL OBJECT'S OWN STATE, and that is
'' the design. It makes the permit
''
''   STICKY -- an Unpark that arrives before the Park is REMEMBERED. Without
''            this every caller has a lost-wakeup race, and it is the half a
''            bare condition variable does not have.
''   BINARY -- two Unparks collapse to one, so a Park that follows two Unparks
''            blocks on the second.
''
'' and it is what lets Park distinguish a real permit from a spurious return, so
'' Park never comes back without one. The contract PERMITS spurious returns --
'' every caller re-checks its own predicate -- but not producing them is free
'' here and makes the primitive testable.
''
'' Windows uses an auto-reset Event and a critical section; POSIX a mutex and a
'' condition variable. Not CONDITION_VARIABLE/SleepConditionVariableSRW on
'' Windows: an event is the simpler match for a one-thread parker and does not
'' assume a Vista-era API surface. Not sem_timedwait on POSIX: it does not exist
'' on macOS, and the deadline computation is isolated in hDeadline and the clock
'' binding in hCondSetMonotonic (thread/parklinux.tiko), so a target without
'' pthread_condattr_setclock is a per-OS file and nothing else.
''
'' A TIMED PARK MUST NOT BECOME AN HOUR-LONG PARK BECAUSE SOMEONE CHANGED THE
'' TIME ZONE. The POSIX condition variable is bound to CLOCK_MONOTONIC where the
'' platform allows it, and hDeadline reads the matching clock; where it does not,
'' both fall back to CLOCK_REALTIME together. Windows gets this from
'' GetTickCount, which is milliseconds since boot -- and NOT GetTickCount64,
'' which would need a _WIN32_WINNT this runtime does not otherwise require.
'' Unsigned subtraction is correct across GetTickCount's 49.7-day wrap for any
'' interval shorter than that.

#include once "inc/thread.ti"
#include once "inc/sysbind.ti"

'' Binding the condition variable to CLOCK_MONOTONIC is the one OS-specific
'' step: pthread_condattr_setclock is Linux's, and absent on macOS.
#ifdef __FB_UNIX__
	#if defined( __FB_LINUX__ )
		#include once "parklinux.tiko"
	#elseif defined( __FB_DARWIN__ )
		#include once "parkdarwin.tiko"
	#else
		#error "thread/park: no monotonic condition-variable backend for this OS"
	#endif
#endif

extern "rtlib"

#if defined( __FB_WIN32__ ) or defined( __FB_WIN64__ )

type FBPARKER
	as any ptr event_                              '' auto-reset
	as uint8   lock_( 0 to TKORT_CRITSEC_SIZE - 1 )
	as int32    permit
end type

'' Consume a permit if one is there. THE ResetEvent MATTERS: a permit issued
'' while nobody was parked leaves the event signalled, and clearing it here is
'' what keeps the NEXT park from returning spuriously.
private function hTakePermit( byval p as FBPARKER ptr ) as int32
	dim as int32 got = any

	w_EnterCriticalSection( @p->lock_(0) )
	got = p->permit
	if( got <> 0 ) then
		p->permit = 0
		w_ResetEvent( p->event_ )
	end if
	w_LeaveCriticalSection( @p->lock_(0) )

	return got
end function

function tkort_ParkerCreate alias "fb_ParkerCreate" ( ) as FBPARKER ptr
	dim as FBPARKER ptr p = malloc( sizeof( FBPARKER ) )
	if( p = nullptr ) then return nullptr

	p->event_ = w_CreateEventA( nullptr, 0, 0, nullptr )
	if( p->event_ = nullptr ) then
		free( p )
		return nullptr
	end if

	w_InitializeCriticalSection( @p->lock_(0) )
	p->permit = 0

	return p
end function

sub tkort_ParkerDestroy alias "fb_ParkerDestroy" ( byval p as FBPARKER ptr )
	if( p = nullptr ) then exit sub
	w_CloseHandle( p->event_ )
	w_DeleteCriticalSection( @p->lock_(0) )
	free( p )
end sub

sub tkort_Park alias "fb_Park" ( byval p as FBPARKER ptr )
	if( p = nullptr ) then exit sub

	'' Loops rather than returning after one wait -- see the file header.
	while( hTakePermit( p ) = 0 )
		w_WaitForSingleObject( p->event_, INFINITE_ )
	wend
end sub

function tkort_ParkTimed alias "fb_ParkTimed" ( byval p as FBPARKER ptr, byval ms as uint32 ) as int32
	dim as uint32 start_ = any, elapsed = any

	if( p = nullptr ) then return 0

	start_ = w_GetTickCount( )

	do
		if( hTakePermit( p ) <> 0 ) then return 1

		elapsed = w_GetTickCount( ) - start_
		if( elapsed >= ms ) then
			'' Final check: the permit may have arrived between the last test
			'' and the deadline expiring.
			return hTakePermit( p )
		end if

		w_WaitForSingleObject( p->event_, ms - elapsed )
	loop
end function

sub tkort_Unpark alias "fb_Unpark" ( byval p as FBPARKER ptr )
	if( p = nullptr ) then exit sub

	w_EnterCriticalSection( @p->lock_(0) )
	if( p->permit = 0 ) then
		p->permit = 1
		w_SetEvent( p->event_ )
	end if
	w_LeaveCriticalSection( @p->lock_(0) )
end sub

'' SYSTEM_INFO: dwOemId/wProcessorArchitecture at 0, dwPageSize at 4,
'' lpMinimumApplicationAddress and lpMaximumApplicationAddress next,
'' dwActiveProcessorMask (ULONG_PTR), then dwNumberOfProcessors. 48 bytes on
'' x64 and 36 on x86; only the processor count is read.
#if defined( __FB_64BIT__ )
	const SYSINFO_SIZE_    = 48
	const SYSINFO_NPROCS_  = 32
#else
	const SYSINFO_SIZE_    = 36
	const SYSINFO_NPROCS_  = 20
#endif

function tkort_CpuCount alias "fb_CpuCount" ( ) as int32
	dim as uint8 si( 0 to SYSINFO_SIZE_ - 1 ) = any
	dim as uint32 n = any

	w_GetSystemInfo( @si(0) )
	n = *cptr( uint32 ptr, @si(SYSINFO_NPROCS_) )

	'' Logical processors in the calling process's processor group. Wrong inside
	'' a container with a CPU quota, and it is what every other language's
	'' runtime uses.
	return iif( n > 0, cast( int32, n ), 1 )
end function

#elseif defined( __FB_UNIX__ )

type FBPARKER
	as pthread_mutex_t lock_
	as pthread_cond_t  cond_
	as int32  permit
	as int32  monotonic                     '' cond is bound to CLOCK_MONOTONIC
end type

function tkort_ParkerCreate alias "fb_ParkerCreate" ( ) as FBPARKER ptr
	dim as FBPARKER ptr p = malloc( sizeof( FBPARKER ) )
	dim as pthread_condattr_t attr = any

	if( p = nullptr ) then return nullptr

	p->permit = 0
	p->monotonic = 0

	u_pthread_mutex_init( @p->lock_, nullptr )

	u_pthread_condattr_init( @attr )
	'' Where the platform refuses, we fall back to the realtime clock and
	'' hDeadline reads the matching one.
	if( hCondSetMonotonic( @attr ) = 0 ) then p->monotonic = 1
	u_pthread_cond_init( @p->cond_, @attr )
	u_pthread_condattr_destroy( @attr )

	return p
end function

sub tkort_ParkerDestroy alias "fb_ParkerDestroy" ( byval p as FBPARKER ptr )
	if( p = nullptr ) then exit sub
	u_pthread_cond_destroy( @p->cond_ )
	u_pthread_mutex_destroy( @p->lock_ )
	free( p )
end sub

private sub hDeadline( byval p as FBPARKER ptr, byval ms as uint32, byval ts as struct_timespec ptr )
	dim as clockid_t clk = CLOCK_REALTIME

	if( p->monotonic <> 0 ) then clk = CLOCK_MONOTONIC

	u_clock_gettime( clk, ts )

	ts->tv_sec  += cast( int64, ms \ 1000ul )
	ts->tv_nsec += cast( int64, ms mod 1000ul ) * 1000000ll
	if( ts->tv_nsec >= 1000000000ll ) then
		ts->tv_nsec -= 1000000000ll
		ts->tv_sec += 1
	end if
end sub

sub tkort_Park alias "fb_Park" ( byval p as FBPARKER ptr )
	if( p = nullptr ) then exit sub

	u_pthread_mutex_lock( @p->lock_ )
	'' A loop, not an if: pthread_cond_wait may return spuriously, and the
	'' predicate is the permit.
	while( p->permit = 0 )
		u_pthread_cond_wait( @p->cond_, @p->lock_ )
	wend
	p->permit = 0
	u_pthread_mutex_unlock( @p->lock_ )
end sub

function tkort_ParkTimed alias "fb_ParkTimed" ( byval p as FBPARKER ptr, byval ms as uint32 ) as int32
	dim as struct_timespec ts = any
	dim as int32 got = any

	if( p = nullptr ) then return 0

	u_pthread_mutex_lock( @p->lock_ )

	if( ms = 0 ) then
		'' A poll. pthread_cond_timedwait with an already-passed deadline is
		'' specified to return ETIMEDOUT, but going near the kernel to learn
		'' what we already know is pure cost.
		got = p->permit
		if( got <> 0 ) then p->permit = 0
		u_pthread_mutex_unlock( @p->lock_ )
		return got
	end if

	hDeadline( p, ms, @ts )

	while( p->permit = 0 )
		if( u_pthread_cond_timedwait( @p->cond_, @p->lock_, @ts ) = ETIMEDOUT ) then exit while
	wend

	'' Read the FLAG rather than the return code: the permit may have arrived
	'' between the deadline expiring and the mutex being re-acquired.
	got = p->permit
	if( got <> 0 ) then p->permit = 0

	u_pthread_mutex_unlock( @p->lock_ )

	return got
end function

sub tkort_Unpark alias "fb_Unpark" ( byval p as FBPARKER ptr )
	if( p = nullptr ) then exit sub

	u_pthread_mutex_lock( @p->lock_ )
	if( p->permit = 0 ) then
		p->permit = 1
		u_pthread_cond_signal( @p->cond_ )
	end if
	u_pthread_mutex_unlock( @p->lock_ )
end sub

function tkort_CpuCount alias "fb_CpuCount" ( ) as int32
	dim as int64 n = u_sysconf( _SC_NPROCESSORS_ONLN )

	'' Wrong inside a container with a CPU quota, and it is what every other
	'' language's runtime uses.
	return iif( n > 0, cast( int32, n ), 1 )
end function

#else
	#error "thread/park: no parker backend for this target"
#endif

end extern
