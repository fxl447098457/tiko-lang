'' intl.tiko -- the locale layer's portable half: the dividers, the two format
'' strings and the month and weekday names. Five symbols across five fbc
'' members.
''
'' EVERY ONE IS "ASK THE PLATFORM, THEN FALL BACK TO ENGLISH". fb_DrvIntl* is the
'' per-target driver -- GetLocaleInfo on Windows, nl_langinfo on POSIX -- and it
'' stays fbc's; these five hold the ENGLISH DEFAULTS and the rule for when to use
'' them.
''
'' THE TEST IS `fb_I18nGet() AND NOT disallow_localized`, in that order and in
'' all five. fb_I18nGet is the program's own switch -- fbc turns localisation off
'' unless the program asked for it -- and disallow_localized is the CALLER's,
'' used by fb_hDateParse to try the English month names as well as the local
'' ones. Either being false takes the English path.
''
'' AND THE DRIVER MAY STILL DECLINE. Every call tests the driver's result for
'' NULL (or FALSE) and falls through to English if it got one -- so a locale that
'' has no name for a month is not an error, it is "January".
''
'' THE DEFAULT DATE FORMAT IS "MM/dd/yyyy" AND IS COPIED WITH ITS TERMINATOR --
'' memcpy of ELEVEN bytes for ten characters. The buffer test is `len < 11`, so a
'' ten-byte buffer is refused rather than truncated. The time format uses strcpy
'' and tests `len < 9` for "HH:mm:ss".
''
'' THE MONTH AND WEEKDAY TABLES ARE INDEXED FROM ONE, and the range check comes
'' FIRST -- before the driver is consulted -- so an out-of-range month is NULL
'' whatever the locale says.
''
'' A TEMP DESCRIPTOR THAT CAME BACK AS THE NULL DESCRIPTOR IS REPORTED AS NULL.
'' fb_StrAllocTempDescZ returns &__fb_ctx.null_desc when it cannot allocate, and
'' the caller of these two must be able to tell that from a real name -- so the
'' identity comparison against the null descriptor is the allocation check.
''
'' fb_IntlGet RETURNS A POINTER TO A LITERAL, not a descriptor, and it is the one
'' entry point here that can return NULL for a VALID index -- an index outside
'' the four falls off the switch.

#include once "inc/descriptors.ti"
#include once "inc/ctx.ti"
#include once "inc/sysbind.ti"

'' fb_datetime.h's eFbIntlIndex, in order.
const eFIL_DateDivider          = 0
const eFIL_TimeDivider          = 1
const eFIL_NumDecimalPoint      = 2
const eFIL_NumThousandsSeparator = 3

extern "c"   '' NON-FBCALL: fb_datetime.h declares all five plainly, and the
             '' drivers beneath them likewise.
	declare function tkrt_I18nGet TKORT_FBCALL alias "fb_I18nGet" ( ) as int32
	declare function tkrt_StrAllocTempDescZ TKORT_FBCALL alias "fb_StrAllocTempDescZ" _
		( byval s as zstring ptr ) as FBSTRING ptr
	declare function tkrt_DrvIntlGet alias "fb_DrvIntlGet" ( byval index_ as int32 ) as zstring ptr
	declare function tkrt_DrvIntlGetDateFormat alias "fb_DrvIntlGetDateFormat" _
		( byval buffer as zstring ptr, byval length_ as uinteger ) as int32
	declare function tkrt_DrvIntlGetTimeFormat alias "fb_DrvIntlGetTimeFormat" _
		( byval buffer as zstring ptr, byval length_ as uinteger ) as int32
	declare function tkrt_DrvIntlGetMonthName alias "fb_DrvIntlGetMonthName" _
		( byval month_ as int32, byval short_names as int32 ) as FBSTRING ptr
	declare function tkrt_DrvIntlGetWeekdayName alias "fb_DrvIntlGetWeekdayName" _
		( byval weekday_ as int32, byval short_names as int32 ) as FBSTRING ptr
end extern

'' The English defaults. Pointers to literals, exactly as fbc's static tables
'' are -- nothing here is copied until a caller asks for a descriptor.
dim shared as zstring ptr pszMonthNamesLong(0 to 11) = { _
	@"January", @"February", @"March", @"April", @"May", @"June", _
	@"July", @"August", @"September", @"October", @"November", @"December" }

dim shared as zstring ptr pszMonthNamesShort(0 to 11) = { _
	@"Jan", @"Feb", @"Mar", @"Apr", @"May", @"Jun", _
	@"Jul", @"Aug", @"Sep", @"Oct", @"Nov", @"Dec" }

'' SUNDAY FIRST. fb_WeekdayName's first_day_of_week rotation is applied by the
'' caller, before it gets here -- this table is always Sunday-based.
dim shared as zstring ptr pszWeekdayNamesLong(0 to 6) = { _
	@"Sunday", @"Monday", @"Tuesday", @"Wednesday", @"Thursday", @"Friday", @"Saturday" }

dim shared as zstring ptr pszWeekdayNamesShort(0 to 6) = { _
	@"Sun", @"Mon", @"Tue", @"Wed", @"Thu", @"Fri", @"Sat" }

extern "c"   '' NON-FBCALL, as declared above.

'' ------------------------------------------------------------------ dividers

'' THE ONLY ONE THAT CAN RETURN NULL FOR A WELL-FORMED CALL: an index outside the
'' four falls off the bottom.
function tkort_IntlGet alias "fb_IntlGet" _
	( byval index_ as int32, byval disallow_localized as int32 ) as zstring ptr

	if( (tkrt_I18nGet( ) <> 0) andalso (disallow_localized = 0) ) then
		dim as zstring ptr pszResult = tkrt_DrvIntlGet( index_ )
		if( pszResult <> nullptr ) then return pszResult
	end if

	select case index_
	case eFIL_DateDivider           : return @"/"
	case eFIL_TimeDivider           : return @":"
	case eFIL_NumDecimalPoint       : return @"."
	case eFIL_NumThousandsSeparator : return @","
	end select

	return nullptr
end function

'' ------------------------------------------------------------- the formats

'' ELEVEN BYTES FOR TEN CHARACTERS -- the terminator travels with it, and a
'' ten-byte buffer is REFUSED rather than truncated.
function tkort_IntlGetDateFormat alias "fb_IntlGetDateFormat" _
	( byval buffer as zstring ptr, byval length_ as uinteger, _
	  byval disallow_localized as int32 ) as int32

	if( (tkrt_I18nGet( ) <> 0) andalso (disallow_localized = 0) ) then
		if( tkrt_DrvIntlGetDateFormat( buffer, length_ ) <> 0 ) then return 1
	end if

	if( length_ < 11 ) then return 0
	memcpy( buffer, @"MM/dd/yyyy", 11 )
	return 1
end function

'' strcpy here, not memcpy -- the same job, and fbc spells the two differently
'' for no reason that survives translation. The bound is nine for eight
'' characters.
function tkort_IntlGetTimeFormat alias "fb_IntlGetTimeFormat" _
	( byval buffer as zstring ptr, byval length_ as uinteger, _
	  byval disallow_localized as int32 ) as int32

	if( (tkrt_I18nGet( ) <> 0) andalso (disallow_localized = 0) ) then
		if( tkrt_DrvIntlGetTimeFormat( buffer, length_ ) <> 0 ) then return 1
	end if

	if( length_ < 9 ) then return 0
	strcpy( buffer, @"HH:mm:ss" )
	return 1
end function

'' ------------------------------------------------------------- the names

'' THE RANGE CHECK COMES FIRST, before the driver -- so an out-of-range month is
'' NULL whatever the locale says.
function tkort_IntlGetMonthName alias "fb_IntlGetMonthName" _
	( byval month_ as int32, byval short_names as int32, _
	  byval disallow_localized as int32 ) as FBSTRING ptr

	dim as FBSTRING ptr res = any

	if( (month_ < 1) orelse (month_ > 12) ) then return nullptr

	if( (tkrt_I18nGet( ) <> 0) andalso (disallow_localized = 0) ) then
		res = tkrt_DrvIntlGetMonthName( month_, short_names )
		if( res <> nullptr ) then return res
	end if

	if( short_names <> 0 ) then
		res = tkrt_StrAllocTempDescZ( pszMonthNamesShort(month_ - 1) )
	else
		res = tkrt_StrAllocTempDescZ( pszMonthNamesLong(month_ - 1) )
	end if

	'' THE NULL DESCRIPTOR IS THE ALLOCATION FAILURE, and the caller has to be
	'' able to tell it from a real name -- so it is reported as NULL.
	if( res = TKORT_NULLSTR() ) then return nullptr
	return res
end function

function tkort_IntlGetWeekdayName alias "fb_IntlGetWeekdayName" _
	( byval weekday_ as int32, byval short_names as int32, _
	  byval disallow_localized as int32 ) as FBSTRING ptr

	dim as FBSTRING ptr res = any

	if( (weekday_ < 1) orelse (weekday_ > 7) ) then return nullptr

	if( (tkrt_I18nGet( ) <> 0) andalso (disallow_localized = 0) ) then
		res = tkrt_DrvIntlGetWeekdayName( weekday_, short_names )
		if( res <> nullptr ) then return res
	end if

	if( short_names <> 0 ) then
		res = tkrt_StrAllocTempDescZ( pszWeekdayNamesShort(weekday_ - 1) )
	else
		res = tkrt_StrAllocTempDescZ( pszWeekdayNamesLong(weekday_ - 1) )
	end if

	if( res = TKORT_NULLSTR() ) then return nullptr
	return res
end function

end extern
