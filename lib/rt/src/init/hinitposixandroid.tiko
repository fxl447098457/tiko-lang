'' hinitposixandroid.tiko -- init/hinitposix's port-I/O permission on Android: never.
'' #INCLUDED by init/hinitposix.tiko's POSIX branch, never compiled on its own and not in
'' build/sources.txt. Provides hOsPortPermission( ) as int32, as the Linux and Darwin files do.
''
'' Bionic has no ioperm, and an app may not touch I/O ports; fbc's rtlib asks for the
'' permission only on x86 glibc Linux. src/sys/ports.tiko answers INP/OUT with
'' ILLEGALFUNCTIONCALL here without ever reading this, as it does on Darwin.

#if defined( __FB_ANDROID__ )

private function hOsPortPermission( ) as int32
	return 0
end function

#endif
