extern "rtlib"

function tkort_WStrContains alias "fb_WStrContains" _
	( byval s as wstring ptr, byval pat as FBUSTRING ptr, byval ic as int32 ) as int32
	dim as FB_UCHAR ptr sp = any, pp = any
	dim as integer sl = any, pl = any
	dim as HWSTRARG t1
	hWstrArg( s, @sp, @sl, @t1 )
	hUStrArg( pat, @pp, @pl )
	dim as int32 r = 1
	if( pl > 0 ) then r = iif( hu_hFind( sp, sl, pp, pl, 0, ic ) >= 0, 1, 0 )
	hWstrRel( @t1 )
	return r
end function

function tkort_WStrDeleteAt alias "fb_WStrDeleteAt" _
	( byval s as wstring ptr, byval start as integer, byval count as integer ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any
	dim as integer sl = any
	dim as HWSTRARG t1
	hWstrArg( s, @sp, @sl, @t1 )
	dim as integer coff = any, clen = any
	hu_hDeleteCut( sl, start, count, @coff, @clen )
	dim as FBUSTRING ptr r = any
	if( clen <= 0 ) then
		r = hUTempFrom( sp, sl )
	else
		r = hUTempFrom2( sp, coff, sp + coff + clen, sl - coff - clen )
	end if
	hWstrRel( @t1 )
	return r
end function

function tkort_WStrReplace alias "fb_WStrReplace" _
	( byval s as wstring ptr, byval pat as FBUSTRING ptr, byval rep as FBUSTRING ptr, byval ic as int32 ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any, pp = any, rp = any
	dim as integer sl = any, pl = any, rl = any
	dim as HWSTRARG t1
	hWstrArg( s, @sp, @sl, @t1 )
	hUStrArg( pat, @pp, @pl )
	hUStrArg( rep, @rp, @rl )
	dim as FB_UCHAR ptr ob = any
	dim as integer count = hu_hTally( sp, sl, pp, pl, ic )
	dim as FBUSTRING ptr r = hUTempAlloc( sl + count * (rl - pl), @ob )
	if( ob <> nullptr ) then hUTempTrim( r, hu_hReplaceFill( ob, sp, sl, pp, pl, rp, rl, ic ) )
	hWstrRel( @t1 )
	return r
end function

