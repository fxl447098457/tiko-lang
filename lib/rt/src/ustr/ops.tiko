'' ops.tiko -- ustr_ops.o: the FB.* string algorithms at 16-BIT width, plus the
'' WSTRING bridge.
''
'' THE LARGEST MEMBER IN THE RUNTIME: 74 exported entry points -- 38 UStr* and
'' 36 WStr*, the wstring side lacking only the two split functions.
''
'' The algorithms are NOT repeated here. inc/ops-core.ti is included once per
'' width, exactly as str_ops_core.h is in C, so this file is the 16-bit
'' instantiation plus wrappers. src/str/ops.tiko is the byte one.
''
'' ============================================================ ARGUMENTS
''
'' USTRING IS A DESCRIPTOR; WSTRING IS A BARE POINTER. A `byref as const ustring`
'' parameter carries an FBUSTRING for every argument form -- a var-len passes its
'' own descriptor and a USTRING * N gets a compiler-built temporary. A `byref as
'' const wstring` carries a raw NUL-terminated pointer with no descriptor at all.
'' Hence two families rather than one overload.
''
'' ONLY THE FIRST ARGUMENT IS EVER A WSTRING. Every later string parameter is
'' typed USTRING in all three overloads -- that is what lets fbc resolve the set
'' on the first parameter -- so it arrives as a descriptor either way.
''
'' ==================================================== THE WSTRING BRIDGE
''
'' FB_WCHAR is 2 bytes on Windows and 4 on Linux. Where it is 2 a wstring already
'' IS UTF-16, so the bridge reinterprets the pointer: no conversion, no
'' allocation. Where it is wider the text must be re-encoded into a temporary
'' that has to be released, which is a real per-call cost that fbc pays honestly
'' rather than pretending the widths are interchangeable.
''
'' THE BRANCH IS ON sizeof, NOT #ifdef. fbc's comment gives the reason and it is
'' worth keeping: it folds away at compile time just the same, and the branch
'' that is dead on this target still gets compiled and type-checked instead of
'' rotting. This project has shipped a Windows-only correctness bug twice; a
'' dead branch that still compiles is cheap insurance.
''
'' AND fbc RECORDS A BUG HERE THAT IS WORTH READING TWICE: reading `->len` raw
'' instead of through FB_USTRSIZE "made the whole WSTRING family return EMPTY on
'' Linux", because there hWstrArg goes through fb_WstrToUStr, which hands back a
'' TEMP descriptor whose length carries the temp flag in its sign bit. Windows
'' never saw it, because a 16-bit wchar is reinterpreted and no temporary is
'' involved. Same shape as this project's chr(0) and QB-radix findings: a
'' platform-conditional path, correct on the platform it was written on.

#include once "inc/descriptors.ti"
#include once "inc/ctx.ti"

extern "rtlib"
	declare function fb_hUStrAllocTemp alias "fb_hUStrAllocTemp" _
		( byval s as FBUSTRING ptr, byval units as integer ) as FBUSTRING ptr
	declare sub fb_hUStrCopy TKORT_CDECL alias "fb_hUStrCopy" _
		( byval dst as FB_UCHAR ptr, byval src as FB_UCHAR ptr, byval units as integer )
	declare function tkrt_UDelTempNoLock alias "fb_hUStrDelTemp_NoLock" _
		( byval s as FBUSTRING ptr ) as int32
	declare function fb_hUStrToUpper TKORT_CDECL alias "fb_hUStrToUpper" ( byval c as FB_UCHAR ) as FB_UCHAR
	declare function fb_hUStrToLower TKORT_CDECL alias "fb_hUStrToLower" ( byval c as FB_UCHAR ) as FB_UCHAR
	declare function tkrt_WstrToUStr alias "fb_WstrToUStr" ( byval w as wstring ptr ) as FBUSTRING ptr
	declare sub fb_StrLock alias "fb_StrLock" ( )
	declare sub fb_StrUnlock alias "fb_StrUnlock" ( )
end extern

#ifdef ENABLE_MT
	#define STRLOCK()   fb_StrLock()
	#define STRUNLOCK() fb_StrUnlock()
#else
	#define STRLOCK()
	#define STRUNLOCK()
#endif

'' ------------------------------------------- the 16-bit instantiation
''
'' CASE FOLDING IS THE GENERATED BMP TABLE, reached through fb_hUStrToUpper --
'' deliberately NOT towupper(), which is locale-dependent and would fold the same
'' string differently depending on the user's locale and on which libc the
'' program linked against. Astral characters have no simple mapping and pass
'' through unchanged.

#define SOP( n )       hu_##n
#define SOP_UNIT       FB_UCHAR
#define SOP_FOLD( c )  fb_hUStrToUpper( c )
#define SOP_LOWER( c ) fb_hUStrToLower( c )

'' ASCII alphanumerics plus everything non-ASCII: an accented letter continues a
'' word, and a CJK character is a word character with no case to change.
#macro SOP_ISWORD( c, r )
	r = 0
	if( ((c) >= 48) andalso ((c) <= 57) ) then r = 1
	if( ((c) >= 65) andalso ((c) <= 90) ) then r = 1
	if( ((c) >= 97) andalso ((c) <= 122) ) then r = 1
	if( (c) >= &h80 ) then r = 1
#endmacro

'' Real surrogate tests at this width -- this is where a pair exists and where
'' hReverseFill must not split one.
#define SOP_ISHIGH( u ) ( ((u) and &hFC00) = &hD800 )
#define SOP_ISLOW( u )  ( ((u) and &hFC00) = &hDC00 )

#include once "inc/ops-core.ti"

'' ==================================================== descriptor plumbing

'' A NULL descriptor, or one with no data, is the empty string -- and points at a
'' real NUL rather than at NULL, so every algorithm can read s[0] unconditionally.
dim shared as FB_UCHAR tkort_uEmpty(0 to 0) = { 0 }

private sub hUStrArg _
	( byval s as FBUSTRING ptr, byval ptr_ as FB_UCHAR ptr ptr, byval length as integer ptr )

	if( s = nullptr ) then
		*ptr_ = @tkort_uEmpty(0) : *length = 0
		exit sub
	end if
	if( s->data = nullptr ) then
		*ptr_ = @tkort_uEmpty(0) : *length = 0
		exit sub
	end if

	*ptr_ = s->data
	'' FB_USTRSIZE, NEVER ->len raw. See the header: reading it raw is what made
	'' the whole WSTRING family return empty on Linux.
	*length = FB_USTRSIZE( s )

end sub

'' The wstring bridge. `tmp` is NULL when the caller's buffer was used directly.
type HWSTRARG
	as FBUSTRING ptr tmp
end type

private sub hWstrArg _
	( _
		byval w as wstring ptr, byval ptr_ as FB_UCHAR ptr ptr, _
		byval length as integer ptr, byval tok as HWSTRARG ptr _
	)

	tok->tmp = nullptr

	if( w = nullptr ) then
		*ptr_ = @tkort_uEmpty(0) : *length = 0
		exit sub
	end if

	'' Branch on sizeof, not #ifdef -- it folds at compile time just the same,
	'' and the dead branch still gets compiled and type-checked.
	if( sizeof( wstring ) = 2 ) then
		'' Already UTF-16: reinterpret. No conversion, no allocation.
		*ptr_ = cptr( FB_UCHAR ptr, w )
		*length = cast( integer, wcslen( w ) )
	else
		'' Wider wchar: re-encode into a temp that must be released.
		tok->tmp = tkrt_WstrToUStr( w )
		hUStrArg( tok->tmp, ptr_, length )
	end if

end sub

private sub hWstrRel( byval tok as HWSTRARG ptr )
	if( tok->tmp <> nullptr ) then
		STRLOCK()
		tkrt_UDelTempNoLock( tok->tmp )
		STRUNLOCK()
		tok->tmp = nullptr
	end if
end sub

'' ---- temporaries, the ustring forms

private function hUTempFrom _
	( byval src as FB_UCHAR ptr, byval n as integer ) as FBUSTRING ptr

	if( n <= 0 ) then return TKORT_UNULLSTR( )

	dim as FBUSTRING ptr dst = fb_hUStrAllocTemp( nullptr, n )
	if( dst = nullptr ) then return TKORT_UNULLSTR( )

	if( dst->data <> nullptr ) then
		fb_hUStrCopy( dst->data, src, n )
		dst->data[n] = 0
	end if

	return dst

end function

private function hUTempFrom2 _
	( _
		byval a as FB_UCHAR ptr, byval alen as integer, _
		byval b as FB_UCHAR ptr, byval blen as integer _
	) as FBUSTRING ptr

	dim as integer n = alen + blen
	if( n <= 0 ) then return TKORT_UNULLSTR( )

	dim as FBUSTRING ptr dst = fb_hUStrAllocTemp( nullptr, n )
	if( dst = nullptr ) then return TKORT_UNULLSTR( )

	if( dst->data <> nullptr ) then
		if( alen > 0 ) then fb_hUStrCopy( dst->data, a, alen )
		if( blen > 0 ) then fb_hUStrCopy( @dst->data[alen], b, blen )
		dst->data[n] = 0
	end if

	return dst

end function

private function hUTempAlloc _
	( byval n as integer, byval outbuf as FB_UCHAR ptr ptr ) as FBUSTRING ptr

	*outbuf = nullptr
	if( n <= 0 ) then return TKORT_UNULLSTR( )

	dim as FBUSTRING ptr dst = fb_hUStrAllocTemp( nullptr, n )
	if( dst = nullptr ) then return TKORT_UNULLSTR( )

	*outbuf = dst->data
	return dst

end function

'' FB_USTRSETLEN preserves the temp bit that fb_hUStrAllocTemp just set.
private sub hUTempTrim( byval dst as FBUSTRING ptr, byval written as integer )
	if( dst->data = nullptr ) then exit sub
	FB_USTRSETLEN( dst, written )
	dst->data[written] = 0
end sub

'' The pad unit is ONE code unit; anything else becomes a space. At this width a
'' non-BMP pad is a surrogate PAIR and has no one-unit form, which is the same
'' reason the byte family rejects a multi-byte pad.
private function hUPadUnit( byval p as FB_UCHAR ptr, byval n as integer ) as FB_UCHAR
	if( n = 1 ) then return p[0]
	return 32
end function

'' 0-based and -1-for-absent becomes 1-based and 0-for-absent, once.
#define UPOS( at ) iif( (at) < 0, 0, (at) + 1 )

'' ======================================================= USTRING family
''
'' Simpler than the byte family in one respect: a pattern is ALREADY a ustring,
'' so there is no encoding step and no HPAT -- every argument goes through
'' hUStrArg. Positions are 1-based and count CODE UNITS, matching LEN, [] and
'' INSTR on a ustring, so an astral character counts as 2.
''
'' Searching by code unit needs no surrogate awareness: a surrogate half can
'' never equal a BMP unit, so a match can never land mid-character.
''
'' Nothing here releases its arguments -- they are the caller's, as in the byte
'' family.

extern "rtlib"

function tkort_UStrTally alias "fb_UStrTally" _
	( byval s as FBUSTRING ptr, byval pat as FBUSTRING ptr, byval ic as int32 ) as integer
	dim as FB_UCHAR ptr sp = any, pp = any
	dim as integer sl = any, pl = any
	hUStrArg( s, @sp, @sl ) : hUStrArg( pat, @pp, @pl )
	return hu_hTally( sp, sl, pp, pl, ic )
end function

function tkort_UStrTallyChars alias "fb_UStrTallyChars" _
	( byval s as FBUSTRING ptr, byval st as FBUSTRING ptr, byval ic as int32 ) as integer
	dim as FB_UCHAR ptr sp = any, tp = any
	dim as integer sl = any, tl = any
	hUStrArg( s, @sp, @sl ) : hUStrArg( st, @tp, @tl )
	return hu_hTallyAny( sp, sl, tp, tl, ic )
end function

function tkort_UStrInstrChars alias "fb_UStrInstrChars" _
	( byval start as integer, byval s as FBUSTRING ptr, byval st as FBUSTRING ptr, byval ic as int32 ) as integer
	if( start < 1 ) then return 0
	dim as FB_UCHAR ptr sp = any, tp = any
	dim as integer sl = any, tl = any
	hUStrArg( s, @sp, @sl ) : hUStrArg( st, @tp, @tl )
	return UPOS( hu_hFindAny( sp, sl, tp, tl, start - 1, ic ) )
end function

function tkort_UStrVerifySet alias "fb_UStrVerifySet" _
	( byval start as integer, byval s as FBUSTRING ptr, byval st as FBUSTRING ptr, byval ic as int32 ) as integer
	if( start < 1 ) then return 0
	dim as FB_UCHAR ptr sp = any, tp = any
	dim as integer sl = any, tl = any
	hUStrArg( s, @sp, @sl ) : hUStrArg( st, @tp, @tl )
	return UPOS( hu_hVerify( sp, sl, tp, tl, start - 1, ic ) )
end function

function tkort_UStrSpanOf alias "fb_UStrSpanOf" _
	( byval start as integer, byval s as FBUSTRING ptr, byval st as FBUSTRING ptr, byval ic as int32 ) as integer
	if( start < 1 ) then return 0
	dim as FB_UCHAR ptr sp = any, tp = any
	dim as integer sl = any, tl = any
	hUStrArg( s, @sp, @sl ) : hUStrArg( st, @tp, @tl )
	return hu_hSpan( sp, sl, tp, tl, start - 1, ic )
end function

function tkort_UStrStartsWith alias "fb_UStrStartsWith" _
	( byval s as FBUSTRING ptr, byval pre as FBUSTRING ptr, byval ic as int32 ) as int32
	dim as FB_UCHAR ptr sp = any, pp = any
	dim as integer sl = any, pl = any
	hUStrArg( s, @sp, @sl ) : hUStrArg( pre, @pp, @pl )
	return hu_hStartsWith( sp, sl, pp, pl, ic )
end function

function tkort_UStrEndsWith alias "fb_UStrEndsWith" _
	( byval s as FBUSTRING ptr, byval suf as FBUSTRING ptr, byval ic as int32 ) as int32
	dim as FB_UCHAR ptr sp = any, pp = any
	dim as integer sl = any, pl = any
	hUStrArg( s, @sp, @sl ) : hUStrArg( suf, @pp, @pl )
	return hu_hEndsWith( sp, sl, pp, pl, ic )
end function

'' Follows StartsWith rather than hFind: every string contains the empty string.
function tkort_UStrContains alias "fb_UStrContains" _
	( byval s as FBUSTRING ptr, byval pat as FBUSTRING ptr, byval ic as int32 ) as int32
	dim as FB_UCHAR ptr sp = any, pp = any
	dim as integer sl = any, pl = any
	hUStrArg( s, @sp, @sl ) : hUStrArg( pat, @pp, @pl )
	if( pl <= 0 ) then return 1
	return iif( hu_hFind( sp, sl, pp, pl, 0, ic ) >= 0, 1, 0 )
end function

function tkort_UStrIsNumeric alias "fb_UStrIsNumeric" ( byval s as FBUSTRING ptr ) as int32
	dim as FB_UCHAR ptr sp = any
	dim as integer sl = any
	hUStrArg( s, @sp, @sl )
	return hu_hIsNumeric( sp, sl )
end function

function tkort_UStrIsBlank alias "fb_UStrIsBlank" ( byval s as FBUSTRING ptr ) as int32
	dim as FB_UCHAR ptr sp = any
	dim as integer sl = any
	hUStrArg( s, @sp, @sl )
	return hu_hIsBlank( sp, sl )
end function

function tkort_UStrExtract alias "fb_UStrExtract" _
	( byval start as integer, byval s as FBUSTRING ptr, byval pat as FBUSTRING ptr, byval ic as int32 ) as FBUSTRING ptr
	if( start < 1 ) then return TKORT_UNULLSTR( )
	dim as FB_UCHAR ptr sp = any, pp = any
	dim as integer sl = any, pl = any, off = any, cnt = any
	hUStrArg( s, @sp, @sl ) : hUStrArg( pat, @pp, @pl )
	hu_hExtractSpan( sp, sl, pp, pl, start - 1, ic, @off, @cnt )
	return hUTempFrom( sp + off, cnt )
end function

function tkort_UStrExtractChars alias "fb_UStrExtractChars" _
	( byval start as integer, byval s as FBUSTRING ptr, byval st as FBUSTRING ptr, byval ic as int32 ) as FBUSTRING ptr
	if( start < 1 ) then return TKORT_UNULLSTR( )
	dim as FB_UCHAR ptr sp = any, tp = any
	dim as integer sl = any, tl = any, off = any, cnt = any
	hUStrArg( s, @sp, @sl ) : hUStrArg( st, @tp, @tl )
	hu_hExtractCharsSpan( sp, sl, tp, tl, start - 1, ic, @off, @cnt )
	return hUTempFrom( sp + off, cnt )
end function

function tkort_UStrRemain alias "fb_UStrRemain" _
	( byval s as FBUSTRING ptr, byval pat as FBUSTRING ptr, byval start as integer, byval ic as int32 ) as FBUSTRING ptr
	if( start < 1 ) then return TKORT_UNULLSTR( )
	dim as FB_UCHAR ptr sp = any, pp = any
	dim as integer sl = any, pl = any, off = any, cnt = any
	hUStrArg( s, @sp, @sl ) : hUStrArg( pat, @pp, @pl )
	hu_hRemainSpan( sp, sl, pp, pl, start - 1, ic, @off, @cnt )
	return hUTempFrom( sp + off, cnt )
end function

function tkort_UStrRemainChars alias "fb_UStrRemainChars" _
	( byval s as FBUSTRING ptr, byval st as FBUSTRING ptr, byval start as integer, byval ic as int32 ) as FBUSTRING ptr
	if( start < 1 ) then return TKORT_UNULLSTR( )
	dim as FB_UCHAR ptr sp = any, tp = any
	dim as integer sl = any, tl = any, off = any, cnt = any
	hUStrArg( s, @sp, @sl ) : hUStrArg( st, @tp, @tl )
	hu_hRemainCharsSpan( sp, sl, tp, tl, start - 1, ic, @off, @cnt )
	return hUTempFrom( sp + off, cnt )
end function

function tkort_UStrBetween alias "fb_UStrBetween" _
	( byval s as FBUSTRING ptr, byval d1 as FBUSTRING ptr, byval d2 as FBUSTRING ptr, _
	  byval start as integer, byval ic as int32 ) as FBUSTRING ptr
	if( start < 1 ) then return TKORT_UNULLSTR( )
	dim as FB_UCHAR ptr sp = any, ap = any, bp = any
	dim as integer sl = any, al = any, blen2 = any, off = any, cnt = any
	hUStrArg( s, @sp, @sl ) : hUStrArg( d1, @ap, @al ) : hUStrArg( d2, @bp, @blen2 )
	hu_hBetweenSpan( sp, sl, ap, al, bp, blen2, start - 1, ic, @off, @cnt )
	return hUTempFrom( sp + off, cnt )
end function

function tkort_UStrClipLeft alias "fb_UStrClipLeft" _
	( byval s as FBUSTRING ptr, byval n as integer ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any
	dim as integer sl = any, off = any, cnt = any
	hUStrArg( s, @sp, @sl )
	hu_hClipLeftSpan( sl, n, @off, @cnt )
	return hUTempFrom( sp + off, cnt )
end function

function tkort_UStrClipRight alias "fb_UStrClipRight" _
	( byval s as FBUSTRING ptr, byval n as integer ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any
	dim as integer sl = any, off = any, cnt = any
	hUStrArg( s, @sp, @sl )
	hu_hClipRightSpan( sl, n, @off, @cnt )
	return hUTempFrom( sp + off, cnt )
end function

function tkort_UStrDeleteAt alias "fb_UStrDeleteAt" _
	( byval s as FBUSTRING ptr, byval start as integer, byval count as integer ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any
	dim as integer sl = any, coff = any, clen = any
	hUStrArg( s, @sp, @sl )
	hu_hDeleteCut( sl, start, count, @coff, @clen )
	if( clen <= 0 ) then return hUTempFrom( sp, sl )
	return hUTempFrom2( sp, coff, sp + coff + clen, sl - coff - clen )
end function

function tkort_UStrInsertAt alias "fb_UStrInsertAt" _
	( byval s as FBUSTRING ptr, byval ins as FBUSTRING ptr, byval pos_ as integer ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any, ip = any
	dim as integer sl = any, il = any
	hUStrArg( s, @sp, @sl )
	dim as integer at = hu_hInsertSplit( sl, pos_ )
	if( at < 0 ) then return hUTempFrom( sp, sl )
	hUStrArg( ins, @ip, @il )
	dim as integer n = sl + il
	if( n <= 0 ) then return TKORT_UNULLSTR( )
	dim as FBUSTRING ptr dst = fb_hUStrAllocTemp( nullptr, n )
	if( dst = nullptr ) then return TKORT_UNULLSTR( )
	if( dst->data <> nullptr ) then
		if( at > 0 ) then fb_hUStrCopy( dst->data, sp, at )
		if( il > 0 ) then fb_hUStrCopy( @dst->data[at], ip, il )
		if( sl - at > 0 ) then fb_hUStrCopy( @dst->data[at + il], sp + at, sl - at )
		dst->data[n] = 0
	end if
	return dst
end function

'' ---- transforms

function tkort_UStrReplace alias "fb_UStrReplace" _
	( byval s as FBUSTRING ptr, byval pat as FBUSTRING ptr, byval rep as FBUSTRING ptr, byval ic as int32 ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any, pp = any, rp = any, outbuf = any
	dim as integer sl = any, pl = any, rl = any
	hUStrArg( s, @sp, @sl ) : hUStrArg( pat, @pp, @pl ) : hUStrArg( rep, @rp, @rl )
	dim as integer count = hu_hTally( sp, sl, pp, pl, ic )
	dim as integer n = sl + count * (rl - pl)
	dim as FBUSTRING ptr dst = hUTempAlloc( n, @outbuf )
	if( outbuf <> nullptr ) then hUTempTrim( dst, hu_hReplaceFill( outbuf, sp, sl, pp, pl, rp, rl, ic ) )
	return dst
end function

function tkort_UStrRemove alias "fb_UStrRemove" _
	( byval s as FBUSTRING ptr, byval pat as FBUSTRING ptr, byval ic as int32 ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any, pp = any, outbuf = any
	dim as integer sl = any, pl = any
	hUStrArg( s, @sp, @sl ) : hUStrArg( pat, @pp, @pl )
	dim as integer count = hu_hTally( sp, sl, pp, pl, ic )
	dim as FBUSTRING ptr dst = hUTempAlloc( sl - count * pl, @outbuf )
	if( outbuf <> nullptr ) then hUTempTrim( dst, hu_hReplaceFill( outbuf, sp, sl, pp, pl, nullptr, 0, ic ) )
	return dst
end function

function tkort_UStrRemoveChars alias "fb_UStrRemoveChars" _
	( byval s as FBUSTRING ptr, byval st as FBUSTRING ptr, byval ic as int32 ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any, tp = any, outbuf = any
	dim as integer sl = any, tl = any
	hUStrArg( s, @sp, @sl ) : hUStrArg( st, @tp, @tl )
	dim as FBUSTRING ptr dst = hUTempAlloc( sl, @outbuf )
	if( outbuf <> nullptr ) then hUTempTrim( dst, hu_hRemoveCharsFill( outbuf, sp, sl, tp, tl, ic ) )
	return dst
end function

function tkort_UStrRetainChars alias "fb_UStrRetainChars" _
	( byval s as FBUSTRING ptr, byval st as FBUSTRING ptr, byval ic as int32 ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any, tp = any, outbuf = any
	dim as integer sl = any, tl = any
	hUStrArg( s, @sp, @sl ) : hUStrArg( st, @tp, @tl )
	dim as FBUSTRING ptr dst = hUTempAlloc( sl, @outbuf )
	if( outbuf <> nullptr ) then hUTempTrim( dst, hu_hRetainCharsFill( outbuf, sp, sl, tp, tl, ic ) )
	return dst
end function

'' A replacement that is not exactly ONE code unit copies through unchanged --
'' at this width that also rules out an astral replacement, which is a pair.
function tkort_UStrReplaceChars alias "fb_UStrReplaceChars" _
	( byval s as FBUSTRING ptr, byval st as FBUSTRING ptr, byval wth as FBUSTRING ptr, byval ic as int32 ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any, tp = any, wp = any, outbuf = any
	dim as integer sl = any, tl = any, wl = any
	hUStrArg( s, @sp, @sl ) : hUStrArg( st, @tp, @tl ) : hUStrArg( wth, @wp, @wl )
	dim as FBUSTRING ptr dst = hUTempAlloc( sl, @outbuf )
	if( outbuf <> nullptr ) then
		if( wl <> 1 ) then
			if( sl > 0 ) then memcpy( outbuf, sp, sl * sizeof( FB_UCHAR ) )
			hUTempTrim( dst, sl )
		else
			hu_hReplaceCharsFill( outbuf, sp, sl, tp, tl, wp[0], ic )
			hUTempTrim( dst, sl )
		end if
	end if
	return dst
end function

function tkort_UStrReverse alias "fb_UStrReverse" ( byval s as FBUSTRING ptr ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any, outbuf = any
	dim as integer sl = any
	hUStrArg( s, @sp, @sl )
	dim as FBUSTRING ptr dst = hUTempAlloc( sl, @outbuf )
	if( outbuf <> nullptr ) then
		hu_hReverseFill( outbuf, sp, sl )
		hUTempTrim( dst, sl )
	end if
	return dst
end function

function tkort_UStrRepeat alias "fb_UStrRepeat" _
	( byval count as integer, byval s as FBUSTRING ptr ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any, outbuf = any
	dim as integer sl = any
	hUStrArg( s, @sp, @sl )
	if( count <= 0 ) then return TKORT_UNULLSTR( )
	if( sl <= 0 ) then return TKORT_UNULLSTR( )
	dim as integer n = count * sl
	dim as FBUSTRING ptr dst = hUTempAlloc( n, @outbuf )
	if( outbuf <> nullptr ) then
		for i as integer = 0 to count - 1
			memcpy( outbuf + i * sl, sp, sl * sizeof( FB_UCHAR ) )
		next
		hUTempTrim( dst, n )
	end if
	return dst
end function

function tkort_UStrShrink alias "fb_UStrShrink" _
	( byval s as FBUSTRING ptr, byval mask as FBUSTRING ptr ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any, mp = any, outbuf = any
	dim as integer sl = any, ml = any
	hUStrArg( s, @sp, @sl ) : hUStrArg( mask, @mp, @ml )
	dim as FBUSTRING ptr dst = hUTempAlloc( sl, @outbuf )
	if( outbuf <> nullptr ) then hUTempTrim( dst, hu_hShrinkFill( outbuf, sp, sl, mp, ml ) )
	return dst
end function

function tkort_UStrMCase alias "fb_UStrMCase" ( byval s as FBUSTRING ptr ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any, outbuf = any
	dim as integer sl = any
	hUStrArg( s, @sp, @sl )
	dim as FBUSTRING ptr dst = hUTempAlloc( sl, @outbuf )
	if( outbuf <> nullptr ) then
		hu_hMCaseFill( outbuf, sp, sl )
		hUTempTrim( dst, sl )
	end if
	return dst
end function

function tkort_UStrRemoveBetween alias "fb_UStrRemoveBetween" _
	( byval s as FBUSTRING ptr, byval d1 as FBUSTRING ptr, byval d2 as FBUSTRING ptr, _
	  byval removeAll as int32, byval start as integer, byval ic as int32 ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any, ap = any, bp = any, outbuf = any
	dim as integer sl = any, al = any, blen2 = any
	hUStrArg( s, @sp, @sl )
	if( start < 1 ) then return hUTempFrom( sp, sl )
	hUStrArg( d1, @ap, @al ) : hUStrArg( d2, @bp, @blen2 )
	dim as FBUSTRING ptr dst = hUTempAlloc( sl, @outbuf )
	if( outbuf <> nullptr ) then
		hUTempTrim( dst, hu_hRemoveBetweenFill( outbuf, sp, sl, ap, al, bp, blen2, removeAll, start - 1, ic ) )
	end if
	return dst
end function

private function hUPad _
	( byval s as FBUSTRING ptr, byval fieldw as integer, byval pad as FBUSTRING ptr, byval mode as int32 ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any, pp = any, outbuf = any
	dim as integer sl = any, pl = any
	hUStrArg( s, @sp, @sl ) : hUStrArg( pad, @pp, @pl )
	dim as FBUSTRING ptr dst = hUTempAlloc( fieldw, @outbuf )
	if( outbuf <> nullptr ) then
		hUTempTrim( dst, hu_hPadFill( outbuf, sp, sl, fieldw, hUPadUnit( pp, pl ), mode ) )
	end if
	return dst
end function

function tkort_UStrPadRight alias "fb_UStrPadRight" _
	( byval s as FBUSTRING ptr, byval w as integer, byval pad as FBUSTRING ptr ) as FBUSTRING ptr
	return hUPad( s, w, pad, 0 )
end function

function tkort_UStrPadLeft alias "fb_UStrPadLeft" _
	( byval s as FBUSTRING ptr, byval w as integer, byval pad as FBUSTRING ptr ) as FBUSTRING ptr
	return hUPad( s, w, pad, 1 )
end function

function tkort_UStrPadCenter alias "fb_UStrPadCenter" _
	( byval s as FBUSTRING ptr, byval w as integer, byval pad as FBUSTRING ptr ) as FBUSTRING ptr
	return hUPad( s, w, pad, 2 )
end function

'' An EMPTY closing means "the same as opening" -- both here and in Unwrap.
function tkort_UStrWrap alias "fb_UStrWrap" _
	( byval s as FBUSTRING ptr, byval op as FBUSTRING ptr, byval cl as FBUSTRING ptr ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any, ap = any, bp = any, outbuf = any
	dim as integer sl = any, al = any, blen2 = any
	hUStrArg( s, @sp, @sl ) : hUStrArg( op, @ap, @al ) : hUStrArg( cl, @bp, @blen2 )
	dim as FB_UCHAR ptr clp = any
	dim as integer cll = any
	if( blen2 > 0 ) then
		clp = bp : cll = blen2
	else
		clp = ap : cll = al
	end if
	dim as integer n = al + sl + cll
	dim as FBUSTRING ptr dst = hUTempAlloc( n, @outbuf )
	if( outbuf <> nullptr ) then
		if( al > 0 ) then memcpy( outbuf, ap, al * sizeof( FB_UCHAR ) )
		if( sl > 0 ) then memcpy( outbuf + al, sp, sl * sizeof( FB_UCHAR ) )
		if( cll > 0 ) then memcpy( outbuf + al + sl, clp, cll * sizeof( FB_UCHAR ) )
		hUTempTrim( dst, n )
	end if
	return dst
end function

function tkort_UStrUnwrap alias "fb_UStrUnwrap" _
	( byval s as FBUSTRING ptr, byval op as FBUSTRING ptr, byval cl as FBUSTRING ptr, byval ic as int32 ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any, ap = any, bp = any
	dim as integer sl = any, al = any, blen2 = any, off = any, cnt = any
	hUStrArg( s, @sp, @sl ) : hUStrArg( op, @ap, @al ) : hUStrArg( cl, @bp, @blen2 )
	dim as FB_UCHAR ptr clp = any
	dim as integer cll = any
	if( blen2 > 0 ) then
		clp = bp : cll = blen2
	else
		clp = ap : cll = al
	end if
	hu_hUnwrapSpan( sp, sl, ap, al, clp, cll, ic, @off, @cnt )
	return hUTempFrom( sp + off, cnt )
end function

'' Escape MEASURES first; Unescape can only shrink.
function tkort_UStrEscape alias "fb_UStrEscape" ( byval s as FBUSTRING ptr ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any, outbuf = any
	dim as integer sl = any
	hUStrArg( s, @sp, @sl )
	dim as integer n = hu_hEscapeFill( nullptr, sp, sl )
	dim as FBUSTRING ptr dst = hUTempAlloc( n, @outbuf )
	if( outbuf <> nullptr ) then
		hu_hEscapeFill( outbuf, sp, sl )
		hUTempTrim( dst, n )
	end if
	return dst
end function

function tkort_UStrUnescape alias "fb_UStrUnescape" ( byval s as FBUSTRING ptr ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any, outbuf = any
	dim as integer sl = any
	hUStrArg( s, @sp, @sl )
	dim as FBUSTRING ptr dst = hUTempAlloc( sl, @outbuf )
	if( outbuf <> nullptr ) then hUTempTrim( dst, hu_hUnescapeFill( outbuf, sp, sl ) )
	return dst
end function

function tkort_UStrSplitSpans alias "fb_UStrSplitSpans" _
	( byval s as FBUSTRING ptr, byval delim as FBUSTRING ptr, byval ic as int32, _
	  byval spans as integer ptr, byval maxpairs as integer ) as integer
	dim as FB_UCHAR ptr sp = any, dp = any
	dim as integer sl = any, dl = any
	hUStrArg( s, @sp, @sl ) : hUStrArg( delim, @dp, @dl )
	return hu_hSplitSpans( sp, sl, dp, dl, ic, spans, maxpairs )
end function

function tkort_UStrSplitCharsSpans alias "fb_UStrSplitCharsSpans" _
	( byval s as FBUSTRING ptr, byval st as FBUSTRING ptr, byval ic as int32, _
	  byval spans as integer ptr, byval maxpairs as integer ) as integer
	dim as FB_UCHAR ptr sp = any, tp = any
	dim as integer sl = any, tl = any
	hUStrArg( s, @sp, @sl ) : hUStrArg( st, @tp, @tl )
	return hu_hSplitCharsSpans( sp, sl, tp, tl, ic, spans, maxpairs )
end function

