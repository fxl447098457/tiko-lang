	dim as FBUSTRING ptr r = hUTempAlloc( w, @ob )
	if( ob <> nullptr ) then hUTempTrim( r, hu_hPadFill( ob, sp, sl, w, hUPadUnit( pp, pl ), 2 ) )
	hWstrRel( @t1 )
	return r
end function

function tkort_WStrWrap alias "fb_WStrWrap" _
	( byval s as wstring ptr, byval op as FBUSTRING ptr, byval cl as FBUSTRING ptr ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any, ap = any, bp = any
	dim as integer sl = any, al = any, bl2 = any
	dim as HWSTRARG t1
	hWstrArg( s, @sp, @sl, @t1 )
	hUStrArg( op, @ap, @al )
	hUStrArg( cl, @bp, @bl2 )
	dim as FB_UCHAR ptr ob = any, clp = any
	dim as integer cll = any
	if( bl2 > 0 ) then
		clp = bp : cll = bl2
	else
		clp = ap : cll = al
	end if
	dim as integer n = al + sl + cll
	dim as FBUSTRING ptr r = hUTempAlloc( n, @ob )
	if( ob <> nullptr ) then
		if( al > 0 ) then memcpy( ob, ap, al * sizeof( FB_UCHAR ) )
		if( sl > 0 ) then memcpy( ob + al, sp, sl * sizeof( FB_UCHAR ) )
		if( cll > 0 ) then memcpy( ob + al + sl, clp, cll * sizeof( FB_UCHAR ) )
		hUTempTrim( r, n )
	end if
	hWstrRel( @t1 )
	return r
end function

function tkort_WStrUnwrap alias "fb_WStrUnwrap" _
	( byval s as wstring ptr, byval op as FBUSTRING ptr, byval cl as FBUSTRING ptr, byval ic as int32 ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any, ap = any, bp = any
	dim as integer sl = any, al = any, bl2 = any
	dim as HWSTRARG t1
	hWstrArg( s, @sp, @sl, @t1 )
	hUStrArg( op, @ap, @al )
	hUStrArg( cl, @bp, @bl2 )
	dim as FB_UCHAR ptr clp = any
	dim as integer cll = any, off = any, cnt = any
	if( bl2 > 0 ) then
		clp = bp : cll = bl2
	else
		clp = ap : cll = al
	end if
	hu_hUnwrapSpan( sp, sl, ap, al, clp, cll, ic, @off, @cnt )
	dim as FBUSTRING ptr r = hUTempFrom( sp + off, cnt )
	hWstrRel( @t1 )
	return r
end function

end extern
