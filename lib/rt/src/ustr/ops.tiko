end function

function tkort_WStrRepeat alias "fb_WStrRepeat" _
	( byval count as integer, byval s as wstring ptr ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any
	dim as integer sl = any
	dim as HWSTRARG t1
	hWstrArg( s, @sp, @sl, @t1 )
	dim as FB_UCHAR ptr ob = any
	dim as FBUSTRING ptr r = any
	if( (count <= 0) orelse (sl <= 0) ) then
		r = TKORT_UNULLSTR( )
	else
		dim as integer n = count * sl
		r = hUTempAlloc( n, @ob )
		if( ob <> nullptr ) then
			for i as integer = 0 to count - 1
				memcpy( ob + i * sl, sp, sl * sizeof( FB_UCHAR ) )
			next
			hUTempTrim( r, n )
		end if
	end if
	hWstrRel( @t1 )
	return r
end function

end extern

extern "rtlib"

function tkort_WStrInsertAt alias "fb_WStrInsertAt" _
	( byval s as wstring ptr, byval ins as FBUSTRING ptr, byval pos_ as integer ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any, ip = any
	dim as integer sl = any, il = any
	dim as HWSTRARG t1
	hWstrArg( s, @sp, @sl, @t1 )
	hUStrArg( ins, @ip, @il )
	dim as integer at = hu_hInsertSplit( sl, pos_ )
	dim as FBUSTRING ptr r = any
	if( at < 0 ) then
		r = hUTempFrom( sp, sl )
	elseif( sl + il <= 0 ) then
		r = TKORT_UNULLSTR( )
	else
		dim as integer n = sl + il
		r = fb_hUStrAllocTemp( nullptr, n )
		if( r = nullptr ) then
			r = TKORT_UNULLSTR( )
		elseif( r->data <> nullptr ) then
			if( at > 0 ) then fb_hUStrCopy( r->data, sp, at )
			if( il > 0 ) then fb_hUStrCopy( @r->data[at], ip, il )
			if( sl - at > 0 ) then fb_hUStrCopy( @r->data[at + il], sp + at, sl - at )
			r->data[n] = 0
		end if
	end if
	hWstrRel( @t1 )
	return r
end function

function tkort_WStrReplaceChars alias "fb_WStrReplaceChars" _
	( byval s as wstring ptr, byval st as FBUSTRING ptr, byval wth as FBUSTRING ptr, byval ic as int32 ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any, tp = any, wp = any
	dim as integer sl = any, tl = any, wl = any
	dim as HWSTRARG t1
	hWstrArg( s, @sp, @sl, @t1 )
	hUStrArg( st, @tp, @tl )
	hUStrArg( wth, @wp, @wl )
	dim as FB_UCHAR ptr ob = any
	dim as FBUSTRING ptr r = hUTempAlloc( sl, @ob )
	if( ob <> nullptr ) then
		if( wl <> 1 ) then
			if( sl > 0 ) then memcpy( ob, sp, sl * sizeof( FB_UCHAR ) )
		else
			hu_hReplaceCharsFill( ob, sp, sl, tp, tl, wp[0], ic )
		end if
		hUTempTrim( r, sl )
	end if
	hWstrRel( @t1 )
	return r
end function

function tkort_WStrRemoveBetween alias "fb_WStrRemoveBetween" _
	( byval s as wstring ptr, byval d1 as FBUSTRING ptr, byval d2 as FBUSTRING ptr, byval removeAll as int32, byval start as integer, byval ic as int32 ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any, ap = any, bp = any
	dim as integer sl = any, al = any, bl2 = any
	dim as HWSTRARG t1
	hWstrArg( s, @sp, @sl, @t1 )
	hUStrArg( d1, @ap, @al )
	hUStrArg( d2, @bp, @bl2 )
	dim as FB_UCHAR ptr ob = any
	dim as FBUSTRING ptr r = any
	if( start < 1 ) then
		r = hUTempFrom( sp, sl )
	else
		r = hUTempAlloc( sl, @ob )
		if( ob <> nullptr ) then hUTempTrim( r, hu_hRemoveBetweenFill( ob, sp, sl, ap, al, bp, bl2, removeAll, start - 1, ic ) )
	end if
	hWstrRel( @t1 )
	return r
end function

function tkort_WStrPadRight alias "fb_WStrPadRight" _
	( byval s as wstring ptr, byval w as integer, byval pad as FBUSTRING ptr ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any, pp = any
	dim as integer sl = any, pl = any
	dim as HWSTRARG t1
	hWstrArg( s, @sp, @sl, @t1 )
	hUStrArg( pad, @pp, @pl )
	dim as FB_UCHAR ptr ob = any
	dim as FBUSTRING ptr r = hUTempAlloc( w, @ob )
	if( ob <> nullptr ) then hUTempTrim( r, hu_hPadFill( ob, sp, sl, w, hUPadUnit( pp, pl ), 0 ) )
	hWstrRel( @t1 )
	return r
end function

function tkort_WStrPadLeft alias "fb_WStrPadLeft" _
	( byval s as wstring ptr, byval w as integer, byval pad as FBUSTRING ptr ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any, pp = any
	dim as integer sl = any, pl = any
	dim as HWSTRARG t1
	hWstrArg( s, @sp, @sl, @t1 )
	hUStrArg( pad, @pp, @pl )
	dim as FB_UCHAR ptr ob = any
	dim as FBUSTRING ptr r = hUTempAlloc( w, @ob )
	if( ob <> nullptr ) then hUTempTrim( r, hu_hPadFill( ob, sp, sl, w, hUPadUnit( pp, pl ), 1 ) )
	hWstrRel( @t1 )
	return r
end function

function tkort_WStrPadCenter alias "fb_WStrPadCenter" _
	( byval s as wstring ptr, byval w as integer, byval pad as FBUSTRING ptr ) as FBUSTRING ptr
	dim as FB_UCHAR ptr sp = any, pp = any
	dim as integer sl = any, pl = any
