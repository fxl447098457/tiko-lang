'' ======================================================= WSTRING bridge
''
'' Each is its USTRING twin with the FIRST argument unpacked through
'' hWstrArg instead of hUStrArg, and released afterwards. Every later
'' argument is a USTRING descriptor in all three overloads, so nothing else
'' changes -- which is also what lets fbc resolve the overload set on the
'' first parameter alone.
''
'' THE RELEASE MUST HAPPEN ON EVERY PATH. Where FB_WCHAR is 16 bits the token
'' is NULL and hWstrRel is a no-op; where it is wider the token holds a temp
'' descriptor, and skipping the release leaks one ustring temp per call on
'' Linux and nothing at all on Windows.

extern "rtlib"

function tkort_WStrTally alias "fb_WStrTally" _
	( byval s as wstring ptr, byval pat as FBUSTRING ptr, byval ic as int32 ) as integer
	dim as FB_UCHAR ptr sp = any, pp = any
	dim as integer sl = any, pl = any
	dim as HWSTRARG t1
	hWstrArg( s, @sp, @sl, @t1 )
	hUStrArg( pat, @pp, @pl )
	dim as integer r = hu_hTally( sp, sl, pp, pl, ic )
	hWstrRel( @t1 )
	return r
end function

function tkort_WStrTallyChars alias "fb_WStrTallyChars" _
	( byval s as wstring ptr, byval st as FBUSTRING ptr, byval ic as int32 ) as integer
	dim as FB_UCHAR ptr sp = any, tp = any
	dim as integer sl = any, tl = any
	dim as HWSTRARG t1
	hWstrArg( s, @sp, @sl, @t1 )
	hUStrArg( st, @tp, @tl )
	dim as integer r = hu_hTallyAny( sp, sl, tp, tl, ic )
	hWstrRel( @t1 )
	return r
end function

function tkort_WStrInstrChars alias "fb_WStrInstrChars" _
	( byval start as integer, byval s as wstring ptr, byval st as FBUSTRING ptr, byval ic as int32 ) as integer
	if( start < 1 ) then return 0
	dim as FB_UCHAR ptr sp = any, tp = any
	dim as integer sl = any, tl = any
	dim as HWSTRARG t1
	hWstrArg( s, @sp, @sl, @t1 )
	hUStrArg( st, @tp, @tl )
	dim as integer r = UPOS( hu_hFindAny( sp, sl, tp, tl, start - 1, ic ) )
	hWstrRel( @t1 )
	return r
end function

function tkort_WStrVerifySet alias "fb_WStrVerifySet" _
	( byval start as integer, byval s as wstring ptr, byval st as FBUSTRING ptr, byval ic as int32 ) as integer
	if( start < 1 ) then return 0
	dim as FB_UCHAR ptr sp = any, tp = any
	dim as integer sl = any, tl = any
	dim as HWSTRARG t1
	hWstrArg( s, @sp, @sl, @t1 )
	hUStrArg( st, @tp, @tl )
	dim as integer r = UPOS( hu_hVerify( sp, sl, tp, tl, start - 1, ic ) )
	hWstrRel( @t1 )
	return r
end function

