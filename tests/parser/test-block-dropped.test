'' A 'test' block outside a test build is parsed and dropped (parser/testblock.tiko): the program
'' links without std/testing and runs as if the block were not there.
'' TEST: cli
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' CLEAN: build/.tbd
'' ARGS: -target windows-x86_64 tests/parser/src/test-block-dropped.tiko -o build/.tbd/a.exe
'' EXPECT-EXIT: 0
'' RUN: build/.tbd/a.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: before
'' EXPECT-RUN-OUT: after
