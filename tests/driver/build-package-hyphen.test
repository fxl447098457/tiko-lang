
'' A PACKAGE NAME THAT IS NOT AN IDENTIFIER. '[package] name = "my-app"' puts a hyphen in the
'' module's chain, 'my-app.frmsample', and the chain used to go into the generated interface
'' unchanged: 'namespace __tko_mod_my-app_frmsample' is not a statement (TKO0408), and the importer
'' then found neither the module's names nor the macro it exports (PpModChainIdent).
'' TEST: cli
'' ENV: TIKO_MODCACHE=build/.bhy/cache
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' CLEAN: build/.bhy
'' COPY: tests/driver/src/build-hyphen => build/.bhy/pkg
'' ARGS: build -target windows-x86_64 --manifest build/.bhy/pkg --message-format json
'' EXPECT-EXIT: 0
'' EXPECT-OUT: {"event":"unit","kind":"module","unit":"my-app.frmsample","status":"miss"}
'' EXPECT-OUT: {"event":"artifact","kind":"exe","path":"build/.bhy/pkg/out/debug/selftest.exe"}
'' RUN: build/.bhy/pkg/out/debug/selftest.exe
'' EXPECT-RUN-OUT: 42
