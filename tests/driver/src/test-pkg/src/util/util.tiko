#module "util"
'' util: a module with a public procedure and a module-private one.

'' Twice the number given.
public function Twice( byval x as long ) as long
    return x * 2
end function

'' Half the number: private to the module, reachable from its white-box tests.
function Half_( byval x as long ) as long
    return x \ 2
end function
