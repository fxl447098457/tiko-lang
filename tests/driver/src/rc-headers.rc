// The headers a Windows SDK supplies, and a name only llvm-rc needs from them:
// GoRC knows LANG_ENGLISH by itself, llvm-rc only through winnt.h.
#include <windows.h>
#include <commctrl.h>
#include <winres.h>

LANGUAGE LANG_ENGLISH,SUBLANG_ENGLISH_US

1000 DIALOGEX DISCARDABLE 200, 200, 208, 96
STYLE WS_THICKFRAME|WS_CAPTION|WS_SYSMENU|WS_MINIMIZEBOX|WS_MAXIMIZEBOX|WS_VISIBLE
CAPTION "rc-headers"
FONT 8, "MS Sans Serif", 0, 0, 1
{
  LTEXT "x", IDC_STATIC, 4, 4, 40, 10
}

// Beside the '.rc', not the current directory: llvm-rc compiles a preprocessed
// copy that lives elsewhere, so this resolves only through '-I <the .rc's dir>'.
2000 RCDATA "rc-headers.bin"
