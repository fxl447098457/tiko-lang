' Tests that stop the program: each is reported and the run goes on with the next one.
#import "std/testing"

test "first passes"
    testing.Expect( true )
end test

test "ends the program"
    end 7
end test

test "dereferences null"
    dim as long ptr p = 0
    print *p
end test

test "last passes"
    testing.ExpectEq( 1 + 1, 2 )
end test
