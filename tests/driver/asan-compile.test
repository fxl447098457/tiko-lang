'' -fsanitize=address's compile half on each target: clang is given -fsanitize=address and
'' use-after-return=always, which run its ASan pass over the 'sanitize_address' the IR carries.
'' TEST: cli
'' ARGS: -v -fsanitize=address --no-module-cache -target linux-x86_64 -c tests/driver/src/asan.tiko -o tests/driver/src/asan-linux.o
'' EXPECT-EXIT: 0
'' EXPECT-OUT: -fsanitize=address -fsanitize-address-use-after-return=always
'' EXPECT-FILE: tests/driver/src/asan-linux.o
