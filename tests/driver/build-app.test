'' 'tiko build' OF AN APP (docs/tiko-android A6 step 5): kind = "app" builds with -app, and
'' [target.x.app]'s bundle = true makes it an App Bundle, so the artefact is out/debug/game.aab and
'' the link writes game.aab.libmain.so beside it. The stand-in NDK cannot link: exit 5, no bundle.
'' TEST: cli
'' ENV: TIKO_ANDROID_NDK=tests/driver/src/fakendk
'' ENV: TIKO_LIBPATH=tests/driver/src/elfgroup
'' ENV: TIKO_MODCACHE=build/.bapp/cache
'' CLEAN: build/.bapp
'' COPY: tests/driver/src/build-app => build/.bapp/pkg
'' ARGS: build -target android-x86_64 --manifest build/.bapp/pkg -v
'' EXPECT-EXIT: 5
'' EXPECT-OUT-SEQ: -target x86_64-linux-android29
'' EXPECT-OUT-SEQ: -shared -Wl,-soname,libmain.so
'' EXPECT-OUT-SEQ: out/debug/game.aab.libmain.so
'' EXPECT-NO-FILE: build/.bapp/pkg/out/debug/game.aab
