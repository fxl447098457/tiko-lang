'' 'tiko doc' over a project: one page per module, the index, doc.json and the search; the module's
'' test file and its private names never reach the documentation.
'' TEST: cli
'' ENV: TIKO_MODCACHE=build/.dpj/cache
'' CLEAN: build/.dpj
'' COPY: tests/driver/src/test-pkg => build/.dpj/pkg
'' ARGS: doc -target windows-x86_64 --manifest build/.dpj/pkg --message-format json
'' EXPECT-EXIT: 0
'' EXPECT-OUT: {"event":"doc","dir":"build/.dpj/pkg/src/util","exit":0}
'' EXPECT-OUT: {"event":"doc-end","modules":1,
'' EXPECT-FILE: build/.dpj/pkg/out/doc/index.html
'' EXPECT-FILE-HAS: build/.dpj/pkg/out/doc/index.md :: | [util](tp.src.util.md) | `#import "tp/src/util"` |
'' EXPECT-FILE-HAS: build/.dpj/pkg/out/doc/doc.json :: {"format":1,"generator":"tiko
'' EXPECT-FILE-HAS: build/.dpj/pkg/out/doc/search.js :: window.TIKO_DOC_INDEX=[
'' EXPECT-FILE-HAS: build/.dpj/pkg/out/doc/search.js :: "n":"util.Twice"
'' EXPECT-FILE-HAS: build/.dpj/pkg/out/doc/tp.src.util.md :: ### Twice
'' EXPECT-FILE-HAS: build/.dpj/pkg/out/doc/tp.src.util.md :: Twice the number given.
'' EXPECT-FILE-NOT-HAS: build/.dpj/pkg/out/doc/tp.src.util.md :: Half_
'' EXPECT-FILE-NOT-HAS: build/.dpj/pkg/out/doc/tp.src.util.md :: test
