'' '--filter' runs only the tests whose names hold the text; '--' passes the rest to the program
'' (std/testing's RunMain), here '--exact'.
'' TEST: cli
'' HOSTS: windows
'' ENV: TIKO_MODCACHE=build/.ttf/cache
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' CLEAN: build/.ttf
'' COPY: tests/driver/src/test-pkg => build/.ttf/pkg
'' STEP: test -target windows-x86_64 --manifest build/.ttf/pkg --filter twice
'' STEP-OUT: running 1 test
'' STEP-OUT: test Twice doubles ... ok
'' STEP-NOT: Half_
'' ARGS: test -target windows-x86_64 --manifest build/.ttf/pkg -- --exact "a failing one"
'' EXPECT-EXIT: 1
'' EXPECT-OUT: running 1 test
'' EXPECT-OUT: test a failing one ... FAILED
