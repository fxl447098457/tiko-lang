'' '-Os -mt' LINKS libfbmt-s.a: the size runtime follows '-mt' as the plain one does.
'' TEST: cli
'' HOSTS: windows
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' CLEAN: build/.oslm
'' ARGS: -v -Os -mt --no-module-cache -target windows-x86_64 tests/driver/src/optsize-rt.bas -o build/.oslm/a.exe
'' EXPECT-EXIT: 0
'' EXPECT-OUT: windows-x86_64/libfbmt-s.a
'' RUN: build/.oslm/a.exe
'' EXPECT-RUN-OUT: SIZE 42
