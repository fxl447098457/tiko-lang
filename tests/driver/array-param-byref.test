'' BYREF ON AN ARRAY PARAMETER: 'sub f( byref a( ) as T )' -- a tiko extension (fbc's error
'' 59). The parser drops the word, so the parameter is the plain descriptor one; this RUNS it
'' because the risk is a second indirection that compiles and then writes through the wrong
'' pointer. See ParseParam in parser/declparam.tiko.
'' TEST: cli
'' ARGS: -target windows-x86_64 tests/driver/src/array-param-byref.bas -o tests/driver/arrayparambyref.exe
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' EXPECT-EXIT: 0
'' EXPECT-FILE: tests/driver/arrayparambyref.exe
'' RUN: tests/driver/arrayparambyref.exe
'' EXPECT-RUN-OUT: grow 9 42
'' EXPECT-RUN-OUT: fill xyyzzz
'' EXPECT-RUN-OUT: total 42
'' EXPECT-RUN-OUT: fixed 10
'' EXPECT-RUN-OUT: ptr 9
'' EXPECT-RUN-OUT: erased-1
'' EXPECT-RUN-OUT: two 7
'' EXPECT-RUN-OUT: loop zzz
