'' THE BUILT-IN 'asan' PROFILE: -g -exx -O1 -fsanitize=address, written to out/asan/.
'' TEST: cli
'' HOSTS: windows
'' ENV: TIKO_MODCACHE=build/.bpa/cache
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' CLEAN: build/.bpa
'' COPY: tests/driver/src/build-pkg => build/.bpa/pkg
'' ARGS: build tool -target windows-x86_64 --manifest build/.bpa/pkg --profile asan -v
'' EXPECT-EXIT: 0
'' EXPECT-OUT: -O1
'' EXPECT-OUT: -fsanitize=address
'' EXPECT-FILE: build/.bpa/pkg/out/asan/clang_rt.asan_dynamic-x86_64.dll
'' RUN: build/.bpa/pkg/out/asan/tool.exe
