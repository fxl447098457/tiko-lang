'' '-O2' LINKS THE PLAIN RUNTIME, even where the size runtime sits beside it: only '-Os'
'' asks for libfb-s.a.
'' TEST: cli
'' HOSTS: windows
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' CLEAN: build/.olp
'' ARGS: -v -O2 --no-module-cache -target windows-x86_64 tests/driver/src/optsize-rt.bas -o build/.olp/a.exe
'' EXPECT-EXIT: 0
'' EXPECT-OUT: windows-x86_64/libfb.a
'' EXPECT-NOT: libfb-s.a
'' RUN: build/.olp/a.exe
'' EXPECT-RUN-OUT: SIZE 42
