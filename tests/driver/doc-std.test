'' 'tiko doc' of a toolchain module: std/strings, its package path the import, -o the output.
'' TEST: cli
'' ENV: TIKO_MODCACHE=build/.dst/cache
'' CLEAN: build/.dst
'' ARGS: doc -target windows-x86_64 pkg/std/strings -o build/.dst/out
'' EXPECT-EXIT: 0
'' EXPECT-FILE-HAS: build/.dst/out/std.strings.md :: `#import "std/strings"`
'' EXPECT-FILE-HAS: build/.dst/out/std.strings.md :: ### Tally
'' EXPECT-FILE-NOT-HAS: build/.dst/out/std.strings.md :: __tko_mod_
