'' 'tiko test --no-run': the program is built -- a generated main and the black-box file as roots,
'' the debug profile -- and not run. The event stream says so.
'' TEST: cli
'' ENV: TIKO_MODCACHE=build/.tbo/cache
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' CLEAN: build/.tbo
'' COPY: tests/driver/src/test-pkg => build/.tbo/pkg
'' ARGS: test -target windows-x86_64 --manifest build/.tbo/pkg --no-run --message-format json
'' EXPECT-EXIT: 0
'' EXPECT-OUT: {"event":"build-start","format":1,"target":"tests","profile":"debug","roots":["build/.tbo/pkg/out/test/tests.tiko","build/.tbo/pkg/tests/api_test.tiko"]}
'' EXPECT-OUT: "unit":"std.testing"
'' EXPECT-NOT: test-plan
'' EXPECT-FILE: build/.tbo/pkg/out/test/tests.exe
