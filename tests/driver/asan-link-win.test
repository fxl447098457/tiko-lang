'' -fsanitize=address on windows-x86_64: the link names clang's DYNAMIC ASan runtime, its thunk
'' whole-archive and the SEH interceptor, and the runtime's DLL is copied beside the program.
'' TEST: cli
'' HOSTS: windows
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' CLEAN: build/.asanlink
'' ARGS: -v -fsanitize=address --no-module-cache -target windows-x86_64 tests/driver/src/asan.tiko -o build/.asanlink/asan.exe
'' EXPECT-EXIT: 0
'' EXPECT-OUT: clang_rt.asan_dynamic-x86_64.lib
'' EXPECT-OUT: -wholearchive:
'' EXPECT-OUT: clang_rt.asan_dynamic_runtime_thunk-x86_64.lib
'' EXPECT-OUT: -Xlinker -include:__asan_seh_interceptor
'' EXPECT-FILE: build/.asanlink/clang_rt.asan_dynamic-x86_64.dll
'' RUN: build/.asanlink/asan.exe
'' EXPECT-RUN-OUT: asan
