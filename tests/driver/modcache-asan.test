'' AN ASan BUILD DOES NOT REUSE A PLAIN BUILD'S MODULES: -fsanitize=address instruments the object,
'' so it is on the options line of the key and the second build misses on it.
'' TEST: cli
'' ENV: TIKO_MODCACHE=build/.mct-asan/cache
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' HOSTS: windows
'' CLEAN: build/.mct-asan
'' COPY: tests/driver/src/modcache => build/.mct-asan
'' STEP: -v -target windows-x86_64 -i build/.mct-asan/libs build/.mct-asan/app/main.bas -o build/.mct-asan/app.exe
'' ARGS: -fsanitize=address -v -target windows-x86_64 -i build/.mct-asan/libs build/.mct-asan/app/main.bas -o build/.mct-asan/app.exe
'' EXPECT-EXIT: 0
'' EXPECT-OUT: module acme.leaf: miss (options
'' EXPECT-OUT: module acme.middle: miss (options
