'' AN APP LINKS AS A SHARED libmain.so (docs/tiko-android A4): -shared with the soname SDLActivity
'' loads, whatever the file is called; the runtime's app entry fbrtapp.o (SDL_main, logcat, the
'' return path) after fbrt0pic.o; and liblog for the logcat redirect. The output is the .apk; the
'' link writes <out>.libmain.so beside the objects. The library path here has neither startup
'' object, so the line is printed and the link stops: exit 5, and no file of either name.
'' TEST: cli
'' ENV: TIKO_ANDROID_NDK=tests/driver/src/fakendk
'' ARGS: -v -target android-x86_64 -app tests/driver/src/no-fbrt0.bas -p tests/driver/src/elfgroup -o build/.andapp-never.apk
'' EXPECT-EXIT: 5
'' EXPECT-OUT-SEQ: -target x86_64-linux-android29 -fuse-ld=lld
'' EXPECT-OUT-SEQ: -shared -Wl,-soname,libmain.so
'' EXPECT-OUT-SEQ: -o "build/.andapp-never.apk.libmain.so"
'' EXPECT-OUT-SEQ: -lm -ldl -llog
'' EXPECT-NO-FILE: build/.andapp-never.apk
'' EXPECT-NO-FILE: build/.andapp-never.apk.libmain.so
