'' A PROFILE'S opt = "s" IS '-Os' (2026-11-25): clang compiles at -Os, __FB_OPTIMIZE__ is 2.
'' TEST: cli
'' ENV: TIKO_MODCACHE=build/.bos/cache
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' CLEAN: build/.bos
'' COPY: tests/driver/src/build-optsize => build/.bos/pkg
'' ARGS: build -target windows-x86_64 --manifest build/.bos/pkg --profile small -v
'' EXPECT-EXIT: 0
'' EXPECT-OUT: -Os -ffunction-sections
'' RUN: build/.bos/pkg/out/small/app.exe
'' EXPECT-RUN-OUT: small  2
