'' [target.x.app] permissions IS AN ARRAY (docs/fasting-android F0): one -apppermission per
'' element, so a plain string is refused, and says what the key holds.
'' TEST: cli
'' ENV: TIKO_MODCACHE=build/.bapb/cache
'' CLEAN: build/.bapb
'' COPY: tests/driver/src/build-app => build/.bapb/pkg
'' WRITE: build/.bapb/pkg/tiko.toml :: [package]\nname = "buildapp"\n[target.game]\nmain = "main.bas"\nkind = "app"\n[target.game.app]\npermissions = "INTERNET"\n
'' ARGS: metadata -target android-x86_64 --manifest build/.bapb/pkg
'' EXPECT-EXIT: 2
'' EXPECT-OUT: TKO0144
'' EXPECT-OUT: 'permissions' in [target.game.app] is an array of strings
