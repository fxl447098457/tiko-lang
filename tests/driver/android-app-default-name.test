'' -app WRITES <name>.apk, NOT lib<name>.so: it is a -dll underneath (OUT_DLL), but the 'lib' prefix
'' a Unix shared library's default name gets is not an app's (docs/tiko-android A4). Under -v the
'' link line names the temporary libmain.so beside it; the stand-in NDK cannot link, so exit 5.
'' TEST: cli
'' ENV: TIKO_ANDROID_NDK=tests/driver/src/fakendk
'' ARGS: -v -target android-arm64 -app tests/driver/src/no-fbrt0.bas -p tests/driver/src/elfgroup
'' EXPECT-EXIT: 5
'' EXPECT-OUT-SEQ: -target aarch64-linux-android29
'' EXPECT-OUT-SEQ: -o "tests/driver/src/no-fbrt0.apk.libmain.so"
'' EXPECT-NOT: libno-fbrt0
'' EXPECT-NO-FILE: tests/driver/src/no-fbrt0.apk
