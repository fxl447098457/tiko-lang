'' std/testing's assertions over every type they take, one test passing them all; and Require
'' leaves its test, so the Fail after it is never reached.
'' TEST: cli
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' CLEAN: build/.tso
'' ARGS: -target windows-x86_64 --test -g -exx tests/std/testing/src/overloads.tiko -o build/.tso/t.exe
'' EXPECT-EXIT: 0
'' RUN: build/.tso/t.exe
'' EXPECT-RUN-EXIT: 1
'' EXPECT-RUN-OUT: test overloads ... ok
'' EXPECT-RUN-OUT: test require stops the test ... FAILED
'' EXPECT-RUN-OUT: Require failed: 1 = 2 -- the test stops here
'' EXPECT-RUN-OUT: test result: FAILED. 1 passed; 1 failed; 0 skipped
