'' A test build of one file (--test): each 'test' block is registered before main and RunMain runs
'' them in order, printing each result and every failed check with its own line; exit 1 on a
'' failure. A Skip stops its test, so the Fail after it never runs.
'' TEST: cli
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' CLEAN: build/.tsr
'' ARGS: -target windows-x86_64 --test -g -exx tests/std/testing/src/single.tiko -o build/.tsr/t.exe
'' EXPECT-EXIT: 0
'' RUN: build/.tsr/t.exe
'' EXPECT-RUN-EXIT: 1
'' EXPECT-RUN-OUT: running 3 tests
'' EXPECT-RUN-OUT: test adds ... ok
'' EXPECT-RUN-OUT: test wrong ... FAILED
'' EXPECT-RUN-OUT: single.tiko:15: ExpectEq failed
'' EXPECT-RUN-OUT: Twice( 3 ) = 6
'' EXPECT-RUN-OUT: single.tiko:16: ExpectEq failed
'' EXPECT-RUN-OUT: s = "abc"
'' EXPECT-RUN-OUT: "abd"
'' EXPECT-RUN-OUT: single.tiko:17: ExpectNear failed: they differ by 0.5, more than 0.1
'' EXPECT-RUN-OUT: test skipped ... ignored (not on this host)
'' EXPECT-RUN-OUT: test result: FAILED. 1 passed; 1 failed; 1 skipped
