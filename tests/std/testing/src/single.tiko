' A test build of one file: its 'test' blocks registered at load, run by RunMain in file order.
#import "std/testing"

function Twice( byval x as long ) as long
    return x * 2
end function

test "adds"
    testing.ExpectEq( Twice( 2 ), 4 )
    testing.Expect( Twice( 1 ) = 2 )
end test

test "wrong"
    dim as string s = "abc"
    testing.ExpectEq( Twice( 3 ), 7 )
    testing.ExpectEq( s, "abd" )
    testing.ExpectNear( 1.0, 1.5, 0.1 )
end test

test "skipped"
    testing.Skip( "not on this host" )
    testing.Fail( "never here" )
end test

end testing.RunMain( )
