' Every assertion over the types it takes, each one passing: the overload sets resolve with no
' ambiguity for integers of each width, enums, literals, doubles, singles, booleans, strings,
' ustrings and pointers.
#import "std/testing"
enum Color
    RED, GREEN
end enum
test "overloads"
    dim as long a = 4
    dim as integer i = 5
    dim as ulongint u = 18446744073709551615ull
    dim as int32 n32 = -3
    dim as double d = 2
    dim as single sg = 0.5
    dim as boolean b = true
    dim as string s = "x"
    dim as ustring us = "y"
    dim as Color c = GREEN
    dim as long ptr p = @a
    dim as any ptr np = 0
    testing.ExpectEq( a, 4 )
    testing.ExpectEq( i, 5 )
    testing.ExpectEq( u, 18446744073709551615ull )
    testing.ExpectEq( n32, -3 )
    testing.ExpectEq( d, 2 )
    testing.ExpectEq( sg, 0.5 )
    testing.ExpectEq( b, true )
    testing.ExpectEq( a > 3, true )
    testing.ExpectEq( s, "x" )
    testing.ExpectEq( us, "y" )
    testing.ExpectEq( us, mid( s & "y", 2 ) )
    testing.ExpectEq( c, GREEN )
    testing.ExpectEq( c, 1 )
    testing.ExpectEq( p, @a )
    testing.ExpectEq( np, 0 )
    testing.ExpectNe( a, 5 )
    testing.ExpectNe( s, "z" )
    testing.ExpectNear( d, 2.0001, 0.001 )
    testing.Expect( a = 4 )
    testing.ExpectFalse( a = 5 )
    testing.Require( p <> 0 )
    testing.RequireEq( a, 4 )
end test
test "require stops the test"
    testing.Require( 1 = 2 )
    testing.Fail( "not reached" )
end test
end testing.RunMain( )
