'' tiko c2t: C's __int128 is tiko's int128 / uint128 -- the keyword, 'unsigned __int128' and clang's
'' builtin typedefs __int128_t / __uint128_t; a cast to one in a function-like macro; a 128-bit macro
'' value is a TODO, since libclang reads only its low 64 bits. --verify checks the record on both targets.
'' Everything after the clang line is asserted byte for byte; the tiko and clang versions
'' in the banner depend on the host, so only the lines around them are.
'' TEST: cli
'' CLEAN: build/.c2t/int128
'' ARGS: c2t tests/c2t/src/int128.h --verify -o build/.c2t/int128/int128.ti
'' EXPECT-EXIT: 2
'' EXPECT-FILE-HAS: build/.c2t/int128/int128.ti :: '' int128.ti -- tiko header translated by c2t (tiko 
'' EXPECT-FILE-HAS: build/.c2t/int128/int128.ti :: ) from the C header "int128.h"\n''   source sha256 : da7ef8572983b16f4a2d44b6abe4a75200ea6daeaa06cb7d9ba7b7529e8b75ae\n''   clang         : 
'' EXPECT-FILE-HAS: build/.c2t/int128/int128.ti :: ''   passes        : x86_64-pc-windows-msvc, x86_64-pc-linux-gnu\n''   options       : --verify\n''\n'' Generated from C. Search for C2T-TODO and translate those parts by hand.\n''\n'' Renamed:\n''   parameter  mul128.out -> mul128.out_   (tiko reserved word)\n''\n'' 1 item needs manual translation:\n''   line 35  int128.h:15  C2T-TODO(macro)  WIDE_BIG\n'' =============================================================================\n\n/' int128.h -- C's __int128 in tiko c2t: tiko's int128 / uint128 under the keyword and\n   clang's builtin typedefs; a cast to one in a function-like macro; a 128-bit macro value,\n   which libclang reads only the low 64 bits of, refused with a TODO. '/\n#pragma once\n\nextern "C"\n\ntype i128 as int128\ntype u128 as uint128\ntype i128t as int128\ntype u128t as uint128\ntype Pair128\n    lo as int128\n    hi as uint128\nend type\ndeclare function mul128( byval a as u128, byval b as u128, byval out_ as Pair128 ptr ) as u128\n#define WIDEN(x) cast(int128, (x))\n#define UWIDEN(x) cast(uint128, (x))\n'' C2T-TODO(macro) int128.h:15 -- 'WIDE_BIG' is a 128-bit integer value: libclang reads only its low 64 bits\n'' #define WIDE_BIG ((__int128)1 << 100)\n\nend extern\n
