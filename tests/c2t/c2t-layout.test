'' tiko c2t: bit-field records MSVC and SysV lay out differently get 'extern "c"' (and only those, and packed ones), so tiko lays them out by the target's C rule and --verify agrees on both targets; and records holding an __int128, 16-aligned by C's rule and tiko's alike, are no over-alignment.
'' Everything after the clang line is asserted byte for byte; the tiko and clang versions
'' in the banner depend on the host, so only the lines around them are.
'' TEST: cli
'' CLEAN: build/.c2t/layout
'' ARGS: c2t tests/c2t/src/layout.h --verify -o build/.c2t/layout/layout.ti
'' EXPECT-EXIT: 0
'' EXPECT-FILE-HAS: build/.c2t/layout/layout.ti :: '' layout.ti -- tiko header translated by c2t (tiko 
'' EXPECT-FILE-HAS: build/.c2t/layout/layout.ti :: ) from the C header "layout.h"\n''   source sha256 : 32ad0729e6fbea90c60a78cd77aa2cfbaa90de71f449418389138bc3334a7f53\n''   clang         : 
'' EXPECT-FILE-HAS: build/.c2t/layout/layout.ti :: ''   passes        : x86_64-pc-windows-msvc, x86_64-pc-linux-gnu\n''   options       : --verify\n''\n'' Generated from C. Search for C2T-TODO and translate those parts by hand.\n''\n'' Nothing needs manual translation.\n'' =============================================================================\n\n/' layout.h -- records whose bit-fields MSVC and SysV lay out differently: written with\n   'extern "c"', tiko lays each out by its target's C rule, and --verify agrees with clang. '/\n#pragma once\n\nextern "C"\n\ntype Mixed extern "c"\n    a : 3 as byte\n    b : 5 as int32\nend type                                        /' MSVC starts a new unit at 'int' '/\ntype Plain extern "c"\n    x : 3 as uint32\n    y : 5 as uint32\n    c as byte\nend type\ntype Holds\n    m as Mixed\n    n as int32\nend type                                        /' holds one by value '/\ndeclare sub take( byval m as Mixed ptr, byval p as Plain ptr )    /' and a pointer to each '/\n\n/' __int128 is 16-aligned in tiko as in C: not over-alignment, and --verify agrees '/\ntype Wide\n    c as byte\n    v as int128\n    u as uint128\nend type\ntype WideTail\n    v as int128\n    i as int32\nend type                                        /' tiko's rounding reaches C's 32 '/\ntype HoldsWide\n    c as byte\n    w as WideTail\nend type                                         /' 'w' at 16 '/\ndeclare function wide_sum( byval w as Wide ptr, byval k as int128 ) as uint128\n\nend extern\n
