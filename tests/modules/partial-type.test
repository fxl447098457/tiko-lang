'' 'partial type' ACROSS THE FILES OF A MODULE AND THROUGH ITS INTERFACE: the interface carries
'' every part, and the importer's parser pools them, so sizeof( frm.Form ) is the whole type's.
'' TEST: cli
'' ARGS: -target windows-x86_64 -i tests/modules/src/partialtype/libs tests/modules/src/partialtype/app/main.tiko -o tests/modules/partialtype.exe
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' EXPECT-EXIT: 0
'' RUN: tests/modules/partialtype.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT:  2              4            clicked 2      7             40
