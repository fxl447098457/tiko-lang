'' vendor/SDL3 THEN a module that includes windows.bi: SDL.ti brings crt/stddef.bi's NULL
'' macro, so windef.bi never declares 'const NULL' / 'const MAX_PATH', and hc/win's interface
'' spelled its defaults by those names: TKO0675. It spells '0' and '260' now, for any
'' package, without sys's '[defines]'. Compile only.
'' TEST: cli
'' NEEDS: pkg/vendor/SDL3/lib/SDL3.dll
'' ENV: TIKO_PKG=pkg
'' ARGS: -target windows-x86_64 --no-module-cache -c -i tests/modules/src/hdrconst/libs tests/modules/src/hdrconst/app/sdlfirst.tiko -o tests/modules/hdrconsts.o
'' EXPECT-EXIT: 0
'' EXPECT-NOT: TKO0
'' EXPECT-FILE: tests/modules/hdrconsts.o
