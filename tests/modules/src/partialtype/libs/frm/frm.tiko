#module "frm"

public type Helper
    Value as long
end type

' Says neither public nor private: the generated part's 'public' covers the whole type.
partial type Form
    Count as long
    Extra as Helper
    declare sub Bump( )
end type

sub Form.Bump( )
    Count += 1
    btnOK = Count * 2
    Extra.Value = 7
end sub

sub Form.btnOK_Click( )
    Bump( )
    txtName = "clicked " & str( Count )
end sub
