#module "spans"

'' An exported procedure that takes and returns span( of long ) (docs/tiko-slices RFC-0003).
public function Sum( byval v as span( of long ) ) as long
    dim as long t = 0
    for each x as long in v
        t += x
    next
    return t
end function

public function Tail( byval v as span( of long ) ) as span( of long )
    return v(1 to len( v ) - 1)
end function
