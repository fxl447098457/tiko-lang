#import "spans"

'' The importer declares its own TYPE called span: the module's span( of long ) is still the
'' array slice.
type span
    z as integer
end type

dim as long a(1 to 4) = { 1, 2, 3, 4 }
print spans.Sum( a(1 to 4) )
print spans.Sum( spans.Tail( a(1 to 4) ) )
dim as span own
own.z = 7
print own.z
