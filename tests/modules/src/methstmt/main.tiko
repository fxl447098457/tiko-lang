'' A method named like a statement keyword, inherited across a module boundary: the case
'' tkForms' FormBase.Close hit. fbc-modern's lookup finds the base's method through the
'' import just as it does in one file.
#import "./methstmtbase"

type D extends methstmtbase.BaseT
    declare sub Doit( )
end type

sub D.Doit( )
    Close( )
    Get( )
    Name( )
end sub

dim as D x
x.Doit( )
print x.v
