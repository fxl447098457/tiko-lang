'' A program on SDL3's main callbacks with nothing but '#import "vendor/SDL3"': the module
'' declares SDL_EnterAppMainCallbacks (SDL_main.ti), so no extern "C" block is needed.
#import "vendor/SDL3"

function AppInit cdecl( byval appstate as any ptr ptr, _
        byval argc as int32, byval argv as zstring ptr ptr ) as SDL_AppResult
    return SDL_APP_SUCCESS
end function

function AppEvent cdecl( byval appstate as any ptr, _
        byval event as SDL_Event ptr ) as SDL_AppResult
    return SDL_APP_CONTINUE
end function

function AppIterate cdecl( byval appstate as any ptr ) as SDL_AppResult
    return SDL_APP_SUCCESS
end function

sub AppQuit cdecl( byval appstate as any ptr, byval result as SDL_AppResult )
end sub

end SDL_EnterAppMainCallbacks( 0, nullptr, @AppInit, @AppIterate, @AppEvent, @AppQuit )
