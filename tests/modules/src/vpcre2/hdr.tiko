'' The committed vendor/pcre2 headers -- pcre2_8.ti and pcre2-residue.ti -- as an importer reads
'' them: no library needed. The generic names are the 8-bit ones; PCRE2_SIZE is a type.
#include once "../../../../pkg/vendor/pcre2/pcre2_8.ti"
#include once "../../../../pkg/vendor/pcre2/pcre2-residue.ti"
dim as int32 errc
dim as PCRE2_SIZE erroff
dim as string pat = "(?<n>\d+)", s = "a 12"
dim as pcre2_code ptr re = pcre2_compile( strptr( pat ), len( pat ), PCRE2_UTF, @errc, @erroff, 0 )
dim as pcre2_match_data ptr md = pcre2_match_data_create_from_pattern( re, 0 )
dim as pcre2_match_context ptr mc = pcre2_match_context_create( 0 )
pcre2_set_match_limit( mc, 1000 )
print pcre2_match( re, strptr( s ), len( s ), 0, 0, md, mc ), pcre2_get_ovector_pointer( md )[0]
dim as pcre2_callout_block cb
print sizeof( pcre2_callout_block ), sizeof( pcre2_substitute_callout_block ), offsetof( pcre2_callout_block, mark )
print PCRE2_ZERO_TERMINATED = PCRE2_UNSET, PCRE2_ERROR_NOMATCH, PCRE2_MAJOR, PCRE2_DATE
pcre2_match_context_free( mc ) : pcre2_match_data_free( md ) : pcre2_code_free( re )
