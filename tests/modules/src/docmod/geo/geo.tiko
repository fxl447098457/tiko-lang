#module "geo"
'' geo: shapes and their areas -- the documentation fixture.
''
''     #import "geo"
''     print geo.Area( geo.Square( 2 ) )
''
'' Every public name below is documented by the comment above it.

'' A shape: a kind and its size.
public type Shape
    '' how many sides; 0 for a circle
    as long sides
    as double size              '' the length of a side, or the radius
    '' Makes an empty shape.
    declare constructor( )
    '' Its perimeter, in units.
    declare function Perimeter( ) as double
protected:
    as long kept_
private:
    as long m_hidden
end type

'' The colours a shape may have.
public enum Colour
    RED                         '' the first
    GREEN, BLUE
end enum

'' The largest number of sides a shape may have.
public const MAX_SIDES = 64

'' The area of a shape, in square units.
public declare function Area overload ( byref s as Shape ) as double

'' The area of a square of side n.
public declare function Area overload ( byval n as double ) as double

public declare function Square( byval n as double ) as Shape

'' Documented at its definition only.
public function Square( byval n as double ) as Shape
    dim as Shape s
    s.sides = 4
    s.size = n
    return s
end function

function Area( byref s as Shape ) as double
    return s.size * s.size
end function

function Area( byval n as double ) as double
    return n * n
end function

'' Never documented: module-private.
function Secret_( ) as long
    return 1
end function

private function Hidden_( ) as long
    return 2
end function

constructor Shape( )
end constructor

function Shape.Perimeter( ) as double
    return this.sides * this.size
end function

'' The bigger of two values, of any type.
public function Bigger( of T )( byval a as T, byval b as T ) as T
    if a > b then return a
    return b
end function

'' Doubles x: an exported macro.
#define Double2( x ) ((x) * 2)
#export Double2
