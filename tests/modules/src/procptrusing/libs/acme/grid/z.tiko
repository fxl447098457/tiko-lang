'' The procedure-pointer aliases, over names only 'using host' reaches.
#module "grid"
#import "acme/host"
using host
public type OnW as sub( byval p as W ptr )
public type OnWP as sub( byval p as WP ptr )
dim shared as OnW g_onW
dim shared as OnWP g_onWP
public sub Fire( byval w as W ptr, byval wp as WP ptr )
    if g_onW then g_onW( w )
    if g_onWP then g_onWP( wp )
end sub
