'' The committed vendor/zint header -- zint.ti, translated by 'tiko c2t' from zint 2.16.0's zint.h
'' -- as an importer reads it: no library needed.
#include once "../../../../pkg/vendor/zint/zint.ti"
dim as zint_symbol ptr sym = ZBarcode_Create( )
sym->symbology = BARCODE_QRCODE
sym->input_mode = UNICODE_MODE or ESCAPE_MODE
sym->output_options = BARCODE_QUIET_ZONES
dim as string s = "tiko"
if ZBarcode_Encode_and_Buffer_Vector( sym, strptr( s ), len( s ), 0 ) < ZINT_ERROR then
    dim as zint_vector_rect ptr r = sym->vector->rectangles
    print sym->rows, sym->width, r->x, r->width, sym->encoded_data(0, 0) and 1, sym->row_height(0)
end if
print sizeof( zint_symbol ), sizeof( zint_vector_string ), sym->errtxt, BARCODE_LAST, ZINT_MAX_DATA_LEN
ZBarcode_Delete( sym )
