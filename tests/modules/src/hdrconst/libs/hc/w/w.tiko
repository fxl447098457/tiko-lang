'' A module that read hcdef.bi first: its constants are consts here, and its interface
'' names them -- spelled as their literals, so an importer holding the macros reads them.
#module "w"
#include once "hcdef.bi"
public const SQ = HC_NEG ^ 2
public function F( byval p as any ptr = HC_NULL, byval n as long = HC_MAX ) as long
    if p = HC_NULL then return n
    return 1
end function
public function G( byval k as long = HC_NEG, byval h as double = HC_HALF, _
                   byval t as long = HC_TYPED ) as double
    return k + h + t
end function
