'' A module that includes windows.bi before any crt header: windef.bi declares
'' 'const NULL = 0' and 'const MAX_PATH = 260', and its interface names both.
#module "win"
#include once "windows.bi"
public function F( byval p as HWND = NULL, byval n as long = MAX_PATH ) as long
    if p = NULL then return n
    return 1
end function
