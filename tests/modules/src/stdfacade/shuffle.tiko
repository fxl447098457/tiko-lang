'' std/numeric: ShuffleArray, ShuffleDeque, ShuffleList, ChoiceArray, ChoiceDeque.
'' Every member, empty / one / many, a wrapped Deque, the shared stream with the
'' plain-array Shuffle, uniformity over all 24 orders of four, the multiset kept,
'' a counting UDT (balance, and no copy at all in ShuffleList), a nested
'' container, write-through Choice, and Choice on empty raising out-of-bounds.

#import "std/containers"
#import "std/numeric"
using containers
using numeric

dim shared as long checks, fails

sub Check( byval ok as boolean, byref what as const string )
    checks += 1
    if( ok = false ) then
        fails += 1
        print "FAIL "; what
    end if
end sub

'' --- a counting element ----------------------------------------------------

dim shared as long ctorCount, copyCount, dtorCount

type Counted
    as long v
    declare constructor( )
    declare constructor( byval x as long )
    declare constructor( byref rhs as Counted )
    declare destructor( )
    declare operator let( byref rhs as Counted )
end type

constructor Counted( )
    ctorCount += 1
end constructor

constructor Counted( byval x as long )
    ctorCount += 1
    v = x
end constructor

constructor Counted( byref rhs as Counted )
    ctorCount += 1
    copyCount += 1
    v = rhs.v
end constructor

destructor Counted( )
    dtorCount += 1
end destructor

operator Counted.let( byref rhs as Counted )
    copyCount += 1
    v = rhs.v
end operator

'' --- helpers -----------------------------------------------------------------

function JoinA( byref a as Array( of string ) ) as string
    dim as string s
    for each x in a
        s &= x
    next
    return s
end function

function JoinD( byref d as Deque( of string ) ) as string
    dim as string s
    for each x in d
        s &= x
    next
    return s
end function

function JoinL( byref l as LinkedList( of string ) ) as string
    dim as string s
    for each x in l
        s &= x
    next
    return s
end function

'' The list walked tail to head through 'prv', reversed back -- must equal JoinL.
function JoinLBack( byref l as LinkedList( of string ) ) as string
    dim as string s
    dim as LinkedNode( of string ) ptr p = l.LastNode( )
    while( p <> nullptr )
        s = p->value & s
        p = p->prv
    wend
    return s
end function

'' Lehmer index of a permutation of 0..3, in 0..23.
function Lehmer4( byval a0 as long, byval a1 as long, byval a2 as long, byval a3 as long ) as long
    dim as long a( 0 to 3 ) = { a0, a1, a2, a3 }
    dim as long used( 0 to 3 ), idx = 0, fact = 6
    for i as long = 0 to 3
        dim as long rank = 0
        for j as long = 0 to a( i ) - 1
            if( used( j ) = 0 ) then rank += 1
        next
        used( a( i ) ) = 1
        idx += rank * fact
        select case i
        case 0 : fact = 2
        case 1 : fact = 1
        case else : fact = 0
        end select
    next
    return idx
end function

function Uniform24( seen( ) as long, byval trials as long ) as boolean
    dim as double expect = trials / 24.0
    for i as long = 0 to 23
        if( seen( i ) = 0 ) then return false
        if( abs( seen( i ) - expect ) > expect * 0.15 ) then return false
    next
    return true
end function

'' Two generators in step: the next draw of each is the same.
function InStep( byref a as Rng, byref b as Rng ) as boolean
    return a.NextULongInt( ) = b.NextULongInt( )
end function

'' --- empty and one element: nothing moves, nothing is drawn ------------------

scope
    dim as Rng r = RngSeeded( 5 ), ref = RngSeeded( 5 )
    dim as Array( of string ) a
    dim as Deque( of string ) d
    dim as LinkedList( of string ) l
    ShuffleArray( r, a ) : ShuffleDeque( r, d ) : ShuffleList( r, l )
    Check( a.Count( ) = 0 andalso d.Count( ) = 0 andalso l.Count( ) = 0, "empty counts" )
    Check( l.FirstNode( ) = nullptr andalso l.LastNode( ) = nullptr, "empty list ends" )
    Check( InStep( r, ref ), "empty draws nothing" )

    a.Push( "x" ) : d.PushBack( "x" ) : l.PushBack( "x" )
    ShuffleArray( r, a ) : ShuffleDeque( r, d ) : ShuffleList( r, l )
    Check( JoinA( a ) = "x" andalso JoinD( d ) = "x" andalso JoinL( l ) = "x", "one element kept" )
    Check( l.FirstNode( ) = l.LastNode( ) andalso l.FirstNode( )->prv = nullptr andalso l.FirstNode( )->nxt = nullptr, "one-node list links" )
    Check( InStep( r, ref ), "one element draws nothing" )
end scope

'' --- one seed, one order: plain array, Array, Deque, LinkedList ---------------

scope
    dim as Array( of string ) a
    dim as Deque( of string ) d
    dim as LinkedList( of string ) l
    dim as string x( 0 to 7 )
    for i as long = 0 to 7
        dim as string c = chr( 65 + i )
        a.Push( c ) : d.PushBack( c ) : l.PushBack( c ) : x( i ) = c
    next
    dim as Rng r1 = RngSeeded( 42 ), r2 = RngSeeded( 42 ), r3 = RngSeeded( 42 ), r4 = RngSeeded( 42 )
    ShuffleArray( r1, a ) : ShuffleDeque( r2, d ) : ShuffleList( r3, l ) : Shuffle( r4, x( ) )
    dim as string px
    for i as long = 0 to 7
        px &= x( i )
    next
    '' the committed reference order: a stable stream gives it on every target
    print "seed 42: "; JoinA( a )
    Check( JoinD( d ) = JoinA( a ), "deque order = array order" )
    Check( JoinL( l ) = JoinA( a ), "list order = array order" )
    Check( px = JoinA( a ), "plain Shuffle order = array order" )
    Check( JoinLBack( l ) = JoinL( l ), "list prv chain" )
    Check( l.Front( ) = left( JoinA( a ), 1 ) andalso l.Back( ) = right( JoinA( a ), 1 ), "list Front/Back" )
    dim as ulongint nxt = r1.NextULongInt( )
    Check( r2.NextULongInt( ) = nxt andalso r3.NextULongInt( ) = nxt andalso r4.NextULongInt( ) = nxt, "same number of draws" )
    Check( a.Count( ) = 8 andalso d.Count( ) = 8 andalso l.Count( ) = 8, "counts kept" )

    '' the list is still a list: push, pop and copy after a shuffle
    l.PushFront( "<" ) : l.PushBack( ">" )
    Check( JoinL( l ) = "<" & JoinA( a ) & ">" andalso JoinLBack( l ) = JoinL( l ), "list push after shuffle" )
    dim as LinkedList( of string ) l2 = l
    Check( JoinL( l2 ) = JoinL( l ), "list copy after shuffle" )
    dim as string popped
    while( l.IsEmpty( ) = false )
        popped &= l.PopFront( )
    wend
    Check( popped = JoinL( l2 ) andalso l.Count( ) = 0, "list pop after shuffle" )
end scope

'' --- a wrapped Deque: the ring's head is not slot 0 -------------------------

scope
    dim as Deque( of long ) d
    dim as Array( of long ) a
    for i as long = 5 to 9
        d.PushBack( i )
    next
    for i as long = 4 to 0 step -1
        d.PushFront( i )                     '' head wraps to the top of the ring
    next
    for i as long = 0 to 9
        a.Push( i )
    next
    dim as Rng r1 = RngSeeded( 9 ), r2 = RngSeeded( 9 )
    ShuffleDeque( r1, d ) : ShuffleArray( r2, a )
    dim as boolean same = true
    for i as long = 0 to 9
        if( d[ i ] <> a[ i ] ) then same = false
    next
    Check( same, "wrapped deque order = array order" )
end scope

'' --- every order of four, equally often -------------------------------------

scope
    const TRIALS = 48000
    dim as long seenA( 0 to 23 ), seenD( 0 to 23 ), seenL( 0 to 23 )
    dim as Rng r = RngSeeded( 7 )
    for k as long = 1 to TRIALS
        dim as Array( of long ) a
        dim as Deque( of long ) d
        dim as LinkedList( of long ) l
        for i as long = 0 to 3
            a.Push( i ) : d.PushBack( i ) : l.PushBack( i )
        next
        ShuffleArray( r, a ) : ShuffleDeque( r, d ) : ShuffleList( r, l )
        seenA( Lehmer4( a[ 0 ], a[ 1 ], a[ 2 ], a[ 3 ] ) ) += 1
        seenD( Lehmer4( d[ 0 ], d[ 1 ], d[ 2 ], d[ 3 ] ) ) += 1
        dim as LinkedNode( of long ) ptr p = l.FirstNode( )
        seenL( Lehmer4( p->value, p->nxt->value, p->nxt->nxt->value, p->nxt->nxt->nxt->value ) ) += 1
    next
    Check( Uniform24( seenA( ), TRIALS ), "array uniform over 24 orders" )
    Check( Uniform24( seenD( ), TRIALS ), "deque uniform over 24 orders" )
    Check( Uniform24( seenL( ), TRIALS ), "list uniform over 24 orders" )
end scope

'' --- many elements: the multiset is kept, and it does move -------------------

scope
    const N = 1000
    dim as Array( of long ) a
    dim as Deque( of long ) d
    dim as LinkedList( of long ) l
    for i as long = 0 to N - 1
        a.Push( i ) : d.PushBack( i ) : l.PushBack( i )
    next
    dim as Rng r = RngSeeded( 1234 )
    ShuffleArray( r, a ) : ShuffleDeque( r, d ) : ShuffleList( r, l )
    dim as long hitA( 0 to N - 1 ), hitD( 0 to N - 1 ), hitL( 0 to N - 1 )
    dim as long fixedA = 0
    for i as long = 0 to N - 1
        hitA( a[ i ] ) += 1 : hitD( d[ i ] ) += 1
        if( a[ i ] = i ) then fixedA += 1
    next
    for each v in l
        hitL( v ) += 1
    next
    dim as boolean once = true
    for i as long = 0 to N - 1
        if( hitA( i ) <> 1 orelse hitD( i ) <> 1 orelse hitL( i ) <> 1 ) then once = false
    next
    Check( once, "1000: every value exactly once" )
    Check( fixedA < 10, "1000: almost nothing stays put" )   '' expected fixed points: 1
    Check( a.Count( ) = N andalso d.Count( ) = N andalso l.Count( ) = N, "1000: counts kept" )
end scope

'' --- a counting UDT: balance, and ShuffleList copies nothing ------------------

scope
    scope
        dim as Array( of Counted ) a
        dim as Deque( of Counted ) d
        dim as LinkedList( of Counted ) l
        for i as long = 1 to 50
            dim as Counted c = Counted( i )
            a.Push( c ) : d.PushBack( c ) : l.PushBack( c )
        next
        dim as Rng r = RngSeeded( 3 )

        dim as long before = copyCount
        ShuffleList( r, l )
        Check( copyCount = before, "ShuffleList copies no element" )

        '' node identity: every value's address is unchanged by the shuffle
        dim as Counted ptr where( 1 to 50 )
        dim as LinkedNode( of Counted ) ptr p = l.FirstNode( )
        while( p <> nullptr )
            where( p->value.v ) = @p->value
            p = p->nxt
        wend
        ShuffleList( r, l )
        dim as boolean stays = true
        p = l.FirstNode( )
        while( p <> nullptr )
            if( where( p->value.v ) <> @p->value ) then stays = false
            p = p->nxt
        wend
        Check( stays, "ShuffleList keeps element addresses" )

        ShuffleArray( r, a ) : ShuffleDeque( r, d )
        dim as long sumA = 0, sumD = 0, sumL = 0
        for i as long = 0 to 49
            sumA += a[ i ].v : sumD += d[ i ].v
        next
        for each c in l
            sumL += c.v
        next
        Check( sumA = 1275 andalso sumD = 1275 andalso sumL = 1275, "UDT values kept" )

        Check( ChoiceArray( r, a ).v >= 1 andalso ChoiceDeque( r, d ).v <= 50, "UDT Choice" )
    end scope
    Check( ctorCount = dtorCount, "UDT constructed = destroyed" )
end scope

'' --- a nested container ------------------------------------------------------

scope
    dim as Array( of Array( of long ) ) outer
    for i as long = 0 to 9
        dim as Array( of long ) inner
        for k as long = 0 to i
            inner.Push( i )
        next
        outer.Push( inner )
    next
    dim as Rng r = RngSeeded( 11 )
    ShuffleArray( r, outer )
    dim as boolean ok = true
    dim as long seen( 0 to 9 )
    for i as long = 0 to 9
        dim as long tag = outer[ i ][ 0 ]
        seen( tag ) += 1
        if( outer[ i ].Count( ) <> tag + 1 ) then ok = false
        for k as long = 0 to outer[ i ].Count( ) - 1
            if( outer[ i ][ k ] <> tag ) then ok = false
        next
    next
    for i as long = 0 to 9
        if( seen( i ) <> 1 ) then ok = false
    next
    Check( ok, "nested Array( of Array ) kept whole" )
end scope

'' --- Choice: one element, uniform, one draw, write-through --------------------

scope
    dim as Rng r = RngSeeded( 21 )
    dim as Array( of string ) a1
    dim as Deque( of string ) d1
    a1.Push( "only" ) : d1.PushBack( "only" )
    Check( ChoiceArray( r, a1 ) = "only" andalso ChoiceDeque( r, d1 ) = "only", "Choice of one" )

    dim as Array( of long ) a
    dim as Deque( of long ) d
    for i as long = 0 to 4
        a.Push( i ) : d.PushBack( i )
    next
    const TRIALS = 50000
    dim as long hitA( 0 to 4 ), hitD( 0 to 4 )
    for k as long = 1 to TRIALS
        hitA( ChoiceArray( r, a ) ) += 1
        hitD( ChoiceDeque( r, d ) ) += 1
    next
    dim as boolean flat = true
    for i as long = 0 to 4
        if( abs( hitA( i ) - TRIALS / 5 ) > TRIALS / 5 * 0.05 ) then flat = false
        if( abs( hitD( i ) - TRIALS / 5 ) > TRIALS / 5 * 0.05 ) then flat = false
    next
    Check( flat, "Choice uniform over 5" )

    '' exactly one NextInt( 0, n-1 ) per call
    dim as Rng c1 = RngSeeded( 77 ), c2 = RngSeeded( 77 )
    dim as long got = ChoiceArray( c1, a )
    Check( got = clng( c2.NextInt( 0, 4 ) ) andalso InStep( c1, c2 ), "ChoiceArray is one draw" )
    got = ChoiceDeque( c1, d )
    Check( got = clng( c2.NextInt( 0, 4 ) ) andalso InStep( c1, c2 ), "ChoiceDeque is one draw" )

    '' byref: writing through the result changes the container
    ChoiceArray( r, a ) = 100
    ChoiceDeque( r, d ) += 100
    dim as long bigA = 0, bigD = 0
    for i as long = 0 to 4
        if( a[ i ] >= 100 ) then bigA += 1
        if( d[ i ] >= 100 ) then bigD += 1
    next
    Check( bigA = 1 andalso bigD = 1, "Choice writes through" )
end scope

'' --- Choice on empty raises out-of-bounds ------------------------------------

function ChoiceEmptyArrayErr( ) as long
    dim as Array( of long ) a
    dim as Rng r = RngSeeded( 1 )
    on error goto caught
    dim as long v = ChoiceArray( r, a )
    return 0
caught:
    return err
end function

function ChoiceEmptyDequeErr( ) as long
    dim as Deque( of long ) d
    dim as Rng r = RngSeeded( 1 )
    on error goto caught
    dim as long v = ChoiceDeque( r, d )
    return 0
caught:
    return err
end function

Check( ChoiceEmptyArrayErr( ) = 6, "ChoiceArray on empty raises out-of-bounds" )
Check( ChoiceEmptyDequeErr( ) = 6, "ChoiceDeque on empty raises out-of-bounds" )

print "checks:"; checks
if( fails = 0 ) then
    print "failures: none"
else
    print "failures:"; fails
    end 1
end if
