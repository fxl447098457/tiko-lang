'' vendor/SDL3 BEFORE sys/win: SDL.ti brings crt/stddef.bi's NULL macro, so windows.bi from
'' sys/win's interface never declares windef.bi's 'const NULL'. sys/win's interface spells its
'' NULL defaults '0' (pkg/sys/tiko.toml [defines]), so win.UpperCase's default needs neither.
#import "vendor/SDL3"
#import "sys/win"
dim as HANDLE h = 0
dim as any ptr p = NULL
print win.UpperCase( "ok" ), SDL_INIT_VIDEO, h = p
