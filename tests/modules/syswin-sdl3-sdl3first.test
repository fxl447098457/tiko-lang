'' vendor/SDL3 THEN sys/win: SDL.ti brings crt/stddef.bi's NULL macro first, so windows.bi from
'' sys/win's interface never declares windef.bi's 'const NULL', and sys/win's interface spelled its
'' defaults 'NULL': TKO0675 "a parameter default names 'null'". The sys package defines NULL and
'' MAX_PATH as crt does (pkg/sys/tiko.toml), so the interface spells '0'. Compile only.
'' TEST: cli
'' NEEDS: pkg/vendor/SDL3/lib/SDL3.dll
'' ENV: TIKO_PKG=pkg
'' ENV: TIKO_MODCACHE=build/.syswinsdl3a/mc
'' CLEAN: build/.syswinsdl3a
'' ARGS: -target windows-x86_64 -c tests/modules/src/syswinsdl3/sdl3first.tiko -o build/.syswinsdl3a/main.o
'' EXPECT-EXIT: 0
'' EXPECT-NOT: TKO0
'' EXPECT-FILE: build/.syswinsdl3a/main.o
