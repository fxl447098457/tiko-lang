'' EXPECT-OUT: cast-udt-no-ptr-cast.bas(57,19): error TKO0804
'' EXPECT-OUT: cast-udt-no-ptr-cast.bas(58,25): error TKO0804
'' EXPECT-OUT: cast-udt-no-ptr-cast.bas(59,7): error TKO0804
'' EXPECT-OUT: cast-udt-no-ptr-cast.bas(60,8): error TKO0804
'' EXPECT-OUT: cast-udt-no-ptr-cast.bas(61,10): error TKO0804
'' EXPECT-OUT: cast-udt-no-ptr-cast.bas(62,21): error TKO0804
'' EXPECT-OUT: cast-udt-no-ptr-cast.bas(63,21): error TKO0804
'' EXPECT-OUT: cast-udt-no-ptr-cast.bas(64,22): error TKO0804
'' EXPECT-OUT: cast-udt-no-ptr-cast.bas(65,22): error TKO0804
