'' match: what the desugaring itself refuses (TKO1240-1249).
dim as long n = 1, r
match n
end match
r = match n
    case 1 : print 1
end match
match n
    1 => print 1
end match
match n
    case else : print 0
    case 1 : print 1
end match
do while match n
        1 => true
        else => false
    end match
    exit do
loop
match n
    case is : print 0
    case else : print 1
end match
type P
    as long x, y
end type
dim as P pt
match pt
    case P( a, a ) : print 0
    case else : print 1
end match
match pt
    case P( a, 0 ), P( 0, a ) : print 0
    case else : print 1
end match
match n
    case 1 : print 1
    case else if n > 0 : print 0
end match
