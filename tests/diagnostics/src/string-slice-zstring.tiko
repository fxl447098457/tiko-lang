function ByPtr( byval zstr as zstring ptr ) as integer
    return 0
end function
function ByRefZ( byref zstr as zstring ) as integer
    return 0
end function
function ByRefCZ( byref zstr as const zstring ) as integer
    return 0
end function
dim as string s = "Paul Squires"
dim as slice sl = s[0 to 3]
dim as ustring u = "Paul Squires"
dim as uslice ul = u[0 to 3]
ByPtr( sl )
ByRefZ( sl )
