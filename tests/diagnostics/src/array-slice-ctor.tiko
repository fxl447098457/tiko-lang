dim as integer a(0 to 3)
dim as integer ptr p = @a(0)
dim as double ptr dp = 0
dim as const integer ptr cp = @a(0)
dim as span( of integer ) v1 = span( of integer )( p, 2 )
dim as span( of integer ) v2 = span( of integer )( dp, 2 )
dim as span( of integer ) v3 = span( of integer )( p )
dim as span( of integer ) v4 = span( of integer )( cp, 2 )
dim as const span( of integer ) v5 = span( of const integer )( cp, 2 )
dim as span( of integer ) v6 = span( of integer )( cast( any ptr, p ), 2 )
