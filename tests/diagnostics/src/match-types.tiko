'' match: what needs the subject's type (TKO1250-1257).
enum Light
    Red, Amber, Green
end enum
type Point
    as long x, y
end type
type Pair
    as long a, b
end type
dim as Light l
dim as long n
dim as Point p
dim as boolean a, b
match l
    case Red : print 1
    case Amber : print 2
end match
dim as string s = match n
    1 => "one"
end match
match l
    case Red, Amber, Green : print 3
    case Red : print 4
end match
match ( a, b )
    case ( true, any ) : print 5
    case ( false, true ) : print 6
end match
match p
    case Pair( x, y ) : print x
    case else : print 7
end match
match p
    case Point( x ) : print x
    case else : print 8
end match
match n
    case c as Point : print 9
    case else : print 10
end match
match n
    case starts "x" : print 11
    case else : print 12
end match
match p
    case ( 1, 2 ) : print 13
    case else : print 14
end match
const LIMIT = 10
dim as long lim = match p
    Point( LIMIT, y ) => y
    else => 0
end match
