function Local1( ) as span( of integer )
    dim as integer lv(0 to 3)
    return lv(0 to 1)
end function
function FromParam( a() as integer ) as span( of integer )
    return a(0 to 1)
end function
function Pass( byval v as span( of integer ) ) as span( of integer )
    return v(0 to 0)
end function
sub Outer( )
    dim as span( of integer ) keep
    if 1 then
        dim as integer inner(0 to 2)
        keep = inner(0 to 1)
    end if
end sub
dim shared as span( of integer ) gs
type Holder
    v as span( of integer )
end type
type Lexer as view
    v as span( of integer )
end type
dim as integer arr(0 to 3)
dim as span( of integer ) w = FromParam( arr() )
dim as span( of integer ) spans(0 to 1)
dim as span( of integer ) ptr pp = new span( of integer )
dim as span( of slice ) sos
