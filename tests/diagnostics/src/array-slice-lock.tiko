sub Grow( a() as integer )
    redim preserve a(0 to 99)
end sub
sub Peek_( byval v as span( of integer ) )
end sub
redim d(0 to 3) as integer
dim as span( of integer ) v = d(0 to 1)
redim preserve d(0 to 7)
print v(0)
dim as span( of integer ) w = d(0 to 1)
erase d
print w(0)
redim d(0 to 3)
dim as span( of integer ) x = d(0 to 1)
Grow( d() )
Peek_( x )
dim as integer f(0 to 3)
dim as span( of integer ) y = f(0 to 1)
erase f
print y(0)
redim e(0 to 3) as integer
dim as span( of integer ) z = e(0 to 1)
print z(0)
redim e(0 to 9)
z = e(0 to 1)
print z(0)
dim as string ss(0 to 2)
dim as slice sl = ss(1)[0 to 0]
redim q(0 to 2) as string
dim as slice ql = q(1)[0 to 0]
redim preserve q(0 to 5)
print ql
