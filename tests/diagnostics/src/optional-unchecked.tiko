#import "std/outcome"
using outcome

function Find( byval k as long ) as Optional( of long )
    if k > 0 then return Some( k )
    return None( of long )( )
end function

function Parse( byval k as long ) as Result( of long, string )
    if k > 0 then return Ok( of long, string )( k )
    return Fail( of long, string )( "no" )
end function

sub Take( byref o as Optional( of long ) )
end sub

sub Warns( )
    dim a as Optional( of long ) = Find( 1 )
    print a.Value( )                                '' 19 bare
    if a.HasValue( ) then print a.Value( )
    a.Clear( )
    print a.Value( )                                '' 22 after Clear
    if a.HasValue( ) then
        a = Find( 2 )
        print a.Value( )                            '' 25 after reassignment
    else
        print a.Value( )                            '' 27 in the else of HasValue
    end if
    while a.HasValue( )
        Take( a )
        print a.Value( )                            '' 31 a loop that kills
    wend
    dim r as Result( of long, string ) = Parse( 1 )
    print r.Failure( )                              '' 34 Failure without IsOk
    if not r.IsOk( ) then print r.Value( )          '' 35 Value when not IsOk
    if r.IsOk( ) then print r.Failure( )            '' 36 Failure when IsOk
end sub

function Guarded( byval o as Optional( of long ), byval r as Result( of long, string ) ) as long
    if o.HasValue( ) then print o.Value( )
    if o.HasValue( ) = false then print 0 else print o.Value( )
    if o.HasValue( ) andalso o.Value( ) > 3 then print 1
    if (not o.HasValue( )) orelse o.Value( ) = 0 then print 2
    print iif( o.HasValue( ), o.Value( ), -1 )
    while o.HasValue( )
        print o.Value( )
        o.Clear( )
    wend
    if r.IsOk( ) then print r.Value( ) else print r.Failure( )
    if r.IsOk( ) = false then
        print r.Failure( )
    elseif r.Value( ) > 0 then
        print 3
    end if
    dim s as Optional( of long ) = Some( 4L )
    print s.Value( )
    s = None( of long )( )
    s = outcome.Some( 5L )
    print s.Value( )
    dim q as Optional( of long )
    q.Assign( 6 )
    print q.Value( )
    if q.HasValue( ) then
        if r.IsOk( ) then print q.Value( ) + r.Value( )
    end if
    if not o.HasValue( ) then return 0
    print o.Value( )
    if o.HasValue( ) = 0 then error 5
    print o.Value( )
    if o.HasValue( ) <> true then end 1
    return o.Value( )
end function

sub ByrefParams( byref o as Optional( of long ), byref k as const Optional( of long ) )
    print o.Value( )                                '' 75 a byref parameter
    print k.Value( )                                '' 76 a const byref parameter
    if k.HasValue( ) then print k.Value( )
end sub

#define assert_(e) if (e) = 0 then fb_Assert(__FILE__, __LINE__, __FUNCTION__, #e)
sub CopiesAndAsserts( )
    dim src as Optional( of long ) = Some( 1L )
    dim cpy as Optional( of long ) = src
    print cpy.Value( )                              '' a copy of a known value
    dim e as Optional( of long )
    dim cpy2 as Optional( of long ) = e
    print cpy2.Value( )                             '' 87 a copy of an empty one
    assert_( e.HasValue( ) )
    print e.Value( )                                '' after an fbc-style assert_
    var f = sub[ byref e ]( )
        e.Clear( ) : print e.Value( )               '' a closure's body is not judged
    end sub
end sub
