'' TKO0988 (fbc's 14, 16, 7) and TKO0989 (fbc's 24): a cva intrinsic with the wrong operands.
'' Lowering declines these, so each was an internal compiler error (TKO0994).
'' TEST: cli
'' ARGS: -c tests/diagnostics/src/cva-operands.bas -o tests/diagnostics/src/cva-operands.o
'' EXPECT-EXIT: 1
'' EXPECT-MAX-DIAG: 17
'' EXPECT-OUT: cva-operands.bas(8,5): error TKO0988: 'cva_start' is written 'cva_start( list, lastParam )'
'' EXPECT-OUT: cva-operands.bas(9,5): error TKO0988: 'cva_start' is written
'' EXPECT-OUT: cva-operands.bas(10,5): error TKO0988: 'cva_start' is written
'' EXPECT-OUT: cva-operands.bas(11,5): error TKO0988: 'cva_end' is written 'cva_end( list )'
'' EXPECT-OUT: cva-operands.bas(12,5): error TKO0988: 'cva_end' is written
'' EXPECT-OUT: cva-operands.bas(13,5): error TKO0988: 'cva_copy' is written 'cva_copy( dest, source )'
'' EXPECT-OUT: cva-operands.bas(14,15): error TKO0989: 'cva_start' needs a 'cva_list', and this is a 'long'
'' EXPECT-OUT: cva-operands.bas(15,15): error TKO0989: 'cva_start' needs a 'cva_list', and this is a 'any ptr'
'' EXPECT-OUT: cva-operands.bas(16,13): error TKO0989: 'cva_end' needs a 'cva_list', and this is a 'long'
'' EXPECT-OUT: cva-operands.bas(17,13): error TKO0989: 'cva_end' needs a 'cva_list'
'' EXPECT-OUT: cva-operands.bas(18,14): error TKO0989: 'cva_copy' needs a 'cva_list', and this is a 'long'
'' EXPECT-OUT: cva-operands.bas(19,14): error TKO0989: 'cva_copy' needs a 'cva_list'
'' EXPECT-OUT: cva-operands.bas(20,17): error TKO0989: 'cva_copy' needs a 'cva_list', and this is a 'any ptr'
'' EXPECT-OUT: cva-operands.bas(21,19): error TKO0989: 'cva_arg' needs a 'cva_list', and this is a 'long'
'' EXPECT-OUT: cva-operands.bas(22,19): error TKO0989: 'cva_arg' needs a 'cva_list'
'' EXPECT-OUT: cva-operands.bas(23,19): error TKO0989: 'cva_arg' needs a 'cva_list'
'' EXPECT-OUT: cva-operands.bas(24,13): error TKO0989: 'cva_arg' needs a 'cva_list', and this is a 'long'
'' EXPECT-NOT: TKO0994
