'' WIN32 C IMPORT: the i686 calling conventions are real and must survive both
'' function declarations and procedure-pointer types. Clang's C frontend rejects
'' __int128 on i386, so shapes.h omits that 64-bit-only section here.
'' TEST: cli
'' ARGS: -target win32 -cimport tests/cimport/src/shapes.h -cimport-out -
'' EXPECT-EXIT: 0
'' EXPECT-OUT: type later__ptr as later ptr
'' EXPECT-OUT: type compare_fn as function cdecl( byval as const any ptr, byval as const any ptr ) as long
'' EXPECT-OUT: declare function shapes_stdcall stdcall alias "shapes_stdcall" ( byval value as long ) as long
'' EXPECT-OUT: declare function shapes_pascal pascal alias "shapes_pascal" ( byval value as long ) as long
'' EXPECT-OUT: type stdcall_fn as function stdcall( byval as long ) as long
'' EXPECT-OUT: type pascal_fn as function pascal( byval as long ) as long
'' EXPECT-NOT: type shapes_i128
'' EXPECT-NOT: error TKO
