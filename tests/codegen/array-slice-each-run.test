'' RUN: for each over a span (docs/tiko-slices RFC-0003 §5) -- by value; byref, writing through
'' to the array; over 'a(lo to hi)' of strings and of a UDT -- and span( of T )( p, n ) over a
'' pointer into an array.
'' TEST: cli
'' ARGS: -target windows-x86_64 -w all tests/codegen/src/array-slice-each.tiko -o tests/codegen/arraysliceeach.exe
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' EXPECT-EXIT: 0
'' EXPECT-NOT: warning
'' EXPECT-FILE: tests/codegen/arraysliceeach.exe
'' RUN: tests/codegen/arraysliceeach.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT:  2 3 4
'' EXPECT-RUN-OUT:  20 30 40 5
'' EXPECT-RUN-OUT: qr
'' EXPECT-RUN-OUT:  0 5
'' EXPECT-RUN-OUT:  3 30
