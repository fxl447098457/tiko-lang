'' RUN: -fsanitize=address -g reports heap-use-after-free at the tiko line that made it, and the program
'' exits 1 before the line after it.
'' TEST: cli
'' HOSTS: windows
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' ARGS: -g -fsanitize=address --no-module-cache -target windows-x86_64 tests/codegen/src/asan-uaf.tiko -o tests/codegen/asanuaf.exe
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/asanuaf.exe
'' EXPECT-RUN-EXIT: 1
'' EXPECT-RUN-OUT: ERROR: AddressSanitizer: heap-use-after-free
'' EXPECT-RUN-OUT: asan-uaf.tiko:4
