'' win64: the same source as cva-list-byval-linux-x86_64.test keeps its 'char *' va_list --
'' passed by value as an i64, read with LLVM's own 'va_arg'. Only an ARRAY va_list decays.
'' TEST: cli
'' ARGS: -target win64 --emit-ir tests/codegen/src/cva-list-byval.bas
'' EXPECT-EXIT: 0
'' EXPECT-OUT: define i64 @"TK_VSUM"(i32 %p0, i64 %p1)
'' EXPECT-OUT: va_arg ptr %s2, i64
'' EXPECT-OUT: declare void @"C_VREAD"(i32, i64)
