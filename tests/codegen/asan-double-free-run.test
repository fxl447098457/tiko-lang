'' RUN: -fsanitize=address -g reports attempting double-free at the tiko line that made it, and the program
'' exits 1 before the line after it.
'' TEST: cli
'' HOSTS: windows
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' ARGS: -g -fsanitize=address --no-module-cache -target windows-x86_64 tests/codegen/src/asan-double-free.tiko -o tests/codegen/asandfree.exe
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/asandfree.exe
'' EXPECT-RUN-EXIT: 1
'' EXPECT-RUN-OUT: ERROR: AddressSanitizer: attempting double-free
'' EXPECT-RUN-OUT: asan-double-free.tiko:3
