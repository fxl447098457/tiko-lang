'' A STRUCTOR SLOT IS ONE POINTER, so its section alignment is the pointer's. On win32 a
'' 4-byte pointer written 'align 8' leaves a 4-byte zero pad after it, and MinGW's
'' __do_global_ctors reads the FIRST ZERO in __CTOR_LIST__ as the list's end -- every
'' slot above it, tiko's module inits and fbrt0.o's fb_hRtInit included, never ran and a
'' -mt program died on its first string lock. The alignment is asserted through the IR,
'' where it is written; the link is what the pad broke.
'' TEST: cli
'' ARGS: -target win32 --emit-ir tests/codegen/src/structor-align-win32.tiko
'' EXPECT-EXIT: 0
'' EXPECT-OUT: section ".ctors.65434", align 4
'' EXPECT-OUT: section ".dtors.65434", align 4

sub firstctor constructor 101
    print "ctor101"
end sub

sub firstdtor destructor 101
    print "dtor101"
end sub

print "main"