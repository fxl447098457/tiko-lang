'' RUN: tiko's int128 / uint128 (types/type.ti) -- arithmetic past 64 bits through LLVM's i128
'' and compiler-rt's __divti3 & co. (the msvc link names clang_rt.builtins), float conversion
'' both ways, the runtime's tko_* STR / PRINT / WRITE, byval and byref procedures, an overload
'' pick, a 16-aligned field, an array, SELECT CASE, and a 64-bit unsigned constant and global
'' zero-extended. Every value checked against Python's integers.
'' TEST: cli
'' ARGS: -target windows-x86_64 tests/codegen/src/int128.bas -o tests/codegen/int128.exe
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/int128.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: -35-2 16 16
'' EXPECT-RUN-OUT: -170141183460469231731687303715884105728
'' EXPECT-RUN-OUT:  170141183460469231731687303715884105727
'' EXPECT-RUN-OUT: 340282366920938463463374607431768211455
'' EXPECT-RUN-OUT: 12676506002282294014967032053761267650600228229401496703205375422550200076076467165567735125376
'' EXPECT-RUN-OUT: -176848577040768610699874889-1-15474250491067253436239052842535295864962565428011153394608635904
'' EXPECT-RUN-OUT: -170141183460469231731687303715884105728 340282366920938463463374607431768211455 0
'' EXPECT-RUN-OUT: -170141183460469231731687303715884105728,340282366920938463463374607431768211455,5
'' EXPECT-RUN-OUT: 1.267650600228229e+030-1.23794003928538e+027 1.#INF
'' EXPECT-RUN-OUT: -123456789012345671681000000000000000019884624838656
'' EXPECT-RUN-OUT: 922337203685477580818446744073709551616
'' EXPECT-RUN-OUT: 18446744073709551615-118446744073709551615340282366920938463463374607431768211455
