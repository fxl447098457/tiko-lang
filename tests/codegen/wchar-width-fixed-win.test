'' A 'wstring * N' element and '(*pw)[ i ]' are 2 bytes on Windows -- the counterpart of
'' wchar-width-fixed-linux / -macos. fbc-modern (-target win64) says USHORT, and
'' 'csign( q )' is '(int16)fb_WstrValInt( ... )'.
'' TEST: cli
'' ARGS: -target windows-x86_64 --emit-ir tests/codegen/src/wchar-width-fixed.tiko
'' EXPECT-EXIT: 0
'' EXPECT-OUT: %t4 = mul i64 0, 2
'' EXPECT-OUT: store i16 %t7, ptr %t5, align 2
'' EXPECT-OUT: %t8 = load i16, ptr %t7, align 2
'' EXPECT-OUT: store i16 %t8, ptr %t6, align 2
'' EXPECT-OUT: %t9 = load i16, ptr %t8, align 2
'' EXPECT-OUT: %t5 = trunc i32 %t4 to i16
