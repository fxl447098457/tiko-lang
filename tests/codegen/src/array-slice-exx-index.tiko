'' -exx (docs/tiko-slices RFC-0003 §4): v(i) past len( v ) is runtime error 6; a fixed array's span
'' and a span over a pointer have no anchor and are only index-checked.
dim as integer f(1 to 5) = { 1, 2, 3, 4, 5 }
dim as span( of integer ) v = f(2 to 4)
dim as integer t = v(2)
dim as integer i = 3
print v(i) + t
