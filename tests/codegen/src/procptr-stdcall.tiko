'' The source of tests/codegen/procptr-stdcall.test: a call THROUGH a 'function stdcall'
'' pointer, with a live esp-relative local read after it. Emitted cdecl, the callee's
'' 'ret 16' moves the caller's stack and that read is a wild pointer -- measured on win32
'' through SHGetKnownFolderPath (0xC0000005 in hKnownFolder's 'w[n]').
declare function GetProcAddress stdcall alias "GetProcAddress" _
    ( byval m as any ptr, byval z as const zstring ptr ) as any ptr

type FKnown as function stdcall ( byval a as any ptr, byval b as ulong, _
    byval c as any ptr, byval d as any ptr ptr ) as long

dim as any ptr h = nullptr
dim as FKnown p = cast( FKnown, GetProcAddress( h, @"F" ) )
dim as ubyte g( 0 to 15 )
dim as any ptr w = nullptr
dim as long hr = p( @g( 0 ), 0, nullptr, @w )
print hr