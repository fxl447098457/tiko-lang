'' A correct program under -fsanitize=address: no report, exit 0. What it touches is what the
'' runtime does on the program's behalf -- strings, dynamic arrays, a UDT with a destructor,
'' Optional, a container, ON ERROR's jump to a handler, and a thread.
#import "std/outcome"
#import "std/containers"
using outcome

type Box
    as string label
    declare destructor( )
end type
destructor Box( )
    label = ""
end destructor

sub Raise( )
    on local error goto caught
    error 5
    print "not reached"
    exit sub
caught:
    dim as long n = err
    print "caught"; n
end sub

sub Worker( byval p as any ptr )
    dim as string s = "thread " & *cptr( long ptr, p )
    print s
end sub

dim as string s = "abc"
for i as long = 1 to 200
    s &= chr( 65 + (i mod 26) )
next
print len( s )
dim as long a( )
redim a( 0 to 9 )
for i as long = 0 to 9 : a( i ) = i * i : next
redim preserve a( 0 to 99 )
print a( 9 )
scope
    dim b as Box
    b.label = "boxed " & s
    print left( b.label, 5 )
end scope
dim o as Optional( of long ) = Some( 3L )
if o.HasValue( ) then print o.Value( )
dim arr as containers.Array( of string )
for i as long = 1 to 50 : arr.Push( str( i ) ) : next
print arr.Count( )
Raise( )
dim as long tv = 7
dim as any ptr th = threadcreate( @Worker, @tv )
threadwait( th )
print "done"
