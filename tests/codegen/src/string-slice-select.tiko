'' A narrow slice as a SELECT CASE subject, over several case values. The subject reached the
'' cases as a runtime pool descriptor that every fb_StrCompare released, so the descriptor was
'' freed once per case value tested and the pool stayed corrupt for the rest of the program.

dim shared as integer gCalls = 0
dim shared as string gTwo

function S( ) as string
    return "iPi"
end function

function Pick( byval nm as const slice ) as boolean
    select case nm
    case "bin", "hex", "oct"
        return true
    end select
    return false
end function

function Subject( ) as const slice
    gCalls += 1
    return gTwo[0 to len( gTwo ) - 1]
end function

function Which( byval nm as const slice ) as integer
    select case nm
    case "one"
        return 1
    case "two", "deux"
        return 2
    case "a" to "c"
        return 3
    case else
        return 4
    end select
end function

gTwo = "two"

'' After the second case value matched, two live temporaries must still be two.
print Pick( "hex" ), Pick( "zzz" )
print instr( S( ), "." )
print instr( S( ) & "x", "P" )

'' The subject runs once, however many case values follow.
select case Subject( )
case "one", "un"
    print "wrong"
case "two", "deux"
    print "subject two"
end select
print "calls"; gCalls

print Which( "one" ); Which( "deux" ); Which( "b" ); Which( "zed" )

'' A SELECT that lost a descriptor per execution would exhaust the pool long before this.
dim as integer hits = 0
for i as integer = 1 to 5000
    if Pick( "oct" ) then hits += 1
next
print "hits"; hits
print "[" & str( 12 ) & "][" & str( 34 ) & "]"
