'' cast( string, x ) over a UDT declaring 'operator cast( ) as string', as the argument of the
'' intrinsics that left it untyped (TKO0994) -- every value measured against fbc-modern 1.20.
type U
    v as integer
    declare operator cast( ) as string
end type
operator U.cast( ) as string
    return "abcde"
end operator

dim shared as string held
type R
    v as integer
    declare operator cast( ) byref as string
end type
operator R.cast( ) byref as string
    return held
end operator

'' two casts: the one the target names is called
type OV
    v as integer
    declare operator cast( ) as long
    declare operator cast( ) as string
end type
operator OV.cast( ) as long
    return 7
end operator
operator OV.cast( ) as string
    return "12x"
end operator

dim shared as integer fails
sub Check( byval ok as boolean, byref what as const string )
    if not ok then fails += 1 : print "FAIL "; what
end sub

dim as U x
dim as OV o
dim as R b
held = "held"

Check( len( cast( string, x ) ) = 5, "len" )
Check( len( (cast( string, x )) ) = 5, "len through parentheses" )
Check( len( cptr( string, x ) ) = 5, "len of the cptr spelling" )
Check( sizeof( cast( string, x ) ) = sizeof( string ), "sizeof is the descriptor" )
Check( asc( cast( string, x ) ) = 97, "asc" )
Check( asc( cast( string, x ), 3 ) = 99, "asc at an index" )
Check( instr( cast( string, x ), "cd" ) = 3, "instr" )
Check( val( cast( string, o ) ) = 12, "val" )
Check( len( cast( string, o ) ) = 3, "len picks the string overload" )
Check( len( cast( string, b ) ) = 4, "len of a byref string cast" )
Check( len( cast( string, b ) & "!" ) = 5, "len of a chain" )

dim as string sel
select case cast( string, x )
case "abcde" : sel = "hit"
case else : sel = "miss"
end select
Check( sel = "hit", "select case" )

'' the operand is evaluated once
dim shared as integer calls
type C
    v as integer
    declare operator cast( ) as string
end type
operator C.cast( ) as string
    calls += 1
    return "c"
end operator
dim as C cc
Check( len( cast( string, cc ) ) = 1, "len over a counting cast" )
Check( calls = 1, "the cast ran once" )

if fails = 0 then print "ok"
