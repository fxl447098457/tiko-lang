common shared gInts() as long
common shared gText() as string
common shared gGrid( any, any ) as double
declare sub Fill( )
print lbound( gInts ); ubound( gInts ); ubound( gInts, 0 ); ubound( gText )
Fill( )
print ubound( gInts ); gInts( 2 ); ubound( gText ); gText( 1 ); ubound( gGrid, 2 ); gGrid( 1, 2 )
redim gInts( 5 to 6 )
print lbound( gInts ); ubound( gInts )
