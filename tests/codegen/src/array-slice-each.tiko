'' ARRAY SLICES, P2 (docs/tiko-slices RFC-0003 §5): for each over a span by value and byref
'' (writing through to the array), over string and UDT elements, and span( of T )( p, n ).
type Pt
    x as long
end type
dim as integer a(1 to 5) = { 1, 2, 3, 4, 5 }
dim as span( of integer ) v = a(2 to 4)
for each x as integer in v
    print x;
next
print
for each byref y as integer in v
    y *= 10
next
print a(2); a(3); a(4); a(5)
dim as string s(0 to 2) = { "p", "q", "r" }
for each t as string in s(1 to 2)
    print t;
next
print
dim as Pt pts(0 to 1)
pts(1).x = 5
for each p as Pt in pts(0 to 1)
    print p.x;
next
print
dim as integer ptr pp = @a(1)
dim as span( of integer ) w = span( of integer )( pp, 3 )
print len( w ); w(2)
