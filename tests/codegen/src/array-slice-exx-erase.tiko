'' -exx (docs/tiko-slices RFC-0003 §7): a callee's ERASE frees the array a span views --
'' runtime error 6 at the span's use. An empty span is inside anything and passes.
sub Drop( a() as integer )
    erase a
end sub
sub Peek2( byval v as span( of integer ), byval e as span( of integer ), a() as integer )
    Drop( a() )
    dim as integer n = len( e )
    for each x as integer in e
        n += x
    next
    print v(0) + n
end sub
redim d(0 to 3) as integer
Peek2( d(1 to 2), d(1 to 0), d() )
