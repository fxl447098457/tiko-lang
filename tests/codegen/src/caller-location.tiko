sub Where( byref what as string, byval ln as long = __CALLER_LINE__, byval fl as zstring ptr = __CALLER_FILE__ )
    dim as string f = *fl
    print what; ln; " "; mid( f, instrrev( f, any "/\" ) + 1 )
end sub

type Box
    as long n
    declare sub Here( byval ln as long = __CALLER_LINE__ )
end type
sub Box.Here( byval ln as long )
    print "box"; ln
end sub

Where( "first" )
Where( "second" )
Where( "given", 99 )
dim b as Box
b.Here( )
print "own"; __CALLER_LINE__
#ifdef __TIKO_CALLER_LOCATION__
print "defined"
#endif
