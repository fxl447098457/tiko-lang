' One type written in several blocks: members from every part, a base given by a later part, parts
' in matching namespaces, and a part holding only methods.
type Animal extends object
    declare virtual function Name( ) as string
end type

function Animal.Name( ) as string
    return "base"
end function

partial type Thing
    A as long = 3
    declare function Sum( ) as long
end type

namespace NS
    partial type Inner
        X as long
    end type
end namespace

partial type Thing extends Animal
    B as long = 4
    declare function Name( ) as string override
end type

namespace NS
    partial type Inner
        Y as long
    end type
end namespace

partial type Thing
    declare function Twice( ) as long
end type

function Thing.Sum( ) as long
    return A + B
end function

function Thing.Name( ) as string
    return "thing"
end function

function Thing.Twice( ) as long
    return Sum( ) * 2
end function

' 'partial' is only a keyword in 'partial type <name>'.
sub partial( byval v as long )
    print "called " & str( v )
end sub

type HasTheWord
    partial as long
end type

dim as Thing t
print t.Sum( ), t.Twice( )
dim as Animal ptr p = @t
print p->Name( )
print sizeof( NS.Inner )
print OffsetOf( Thing, B ) > OffsetOf( Thing, A )
partial type<long>( 7 )
dim as HasTheWord w
w.partial = 6
print w.partial
print OffsetOf( Thing, A ) > 0
