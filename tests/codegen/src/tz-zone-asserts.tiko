'' std/tz: misuse is a runtime error (pkg/std/README.md). TryFindById answers false for
'' an id that is not found; FindById is runtime error 1. Prints the Try result, then dies.
#import "std/tz"
print tz.TimeZone.TryFindById( "Nowhere/Zone", tz.TimeZone.Utc( ) )
dim as tz.TimeZone z = tz.TimeZone.FindById( "Nowhere/Zone" )
print "not reached"
