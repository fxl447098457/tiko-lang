'' A 'wstring * N' element, and '(*pw)[ i ]' over a bare wstring, is the target's wchar:
'' 2 bytes on Windows, 4 on linux-x86_64 and macos-arm64. Each procedure touches
'' exactly one element, so its IR holds exactly one load or store of it.
sub put_fixed( )
    dim as wstring * 4 q = any
    q[0] = 34
end sub

function get_fixed( ) as ulong
    dim as wstring * 4 q = any
    return q[1]
end function

sub put_bare( byval pw as wstring ptr )
    (*pw)[1] = 35
end sub

function get_bare( byval pw as wstring ptr ) as ulong
    return (*pw)[2]
end function

function sign_fixed( ) as long
    dim as wstring * 4 q = any
    return csign( q )
end function
