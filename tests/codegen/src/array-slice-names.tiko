'' 'span' is contextual (docs/tiko-slices RFC-0003 §1): a variable and a parameter called span do
'' not hide span( of T ).
dim as integer span = 4
sub slice2( byval span as integer )
    print span
end sub
slice2( span )
dim as integer arr(0 to 3) = { 1, 2, 3, 4 }
dim as span( of integer ) v = arr(1 to 2)
print v(0) + v(1)
