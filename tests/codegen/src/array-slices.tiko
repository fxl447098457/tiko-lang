'' ARRAY SLICES, P1 (docs/tiko-slices RFC-0003): 'a(lo to hi)' over a fixed array, a dynamic
'' array and an 'a()' parameter; re-slicing; len, lbound, ubound; v(i) read and write through
'' to the source; string and UDT elements; a source whose lbound is not 0.

type Pt
    x as long
    y as long
end type

sub Show( byref tag as string, byval v as span( of integer ) )
    dim as string t = tag & " " & len( v ) & ":"
    for i as integer = 0 to len( v ) - 1
        t &= " " & v(i)
    next
    print t
end sub

sub FromParam( a() as integer )
    dim as span( of integer ) v = a(lbound( a ) + 1 to ubound( a ))
    Show( "param", v )
end sub

function Mid3( byval v as span( of integer ) ) as span( of integer )
    return v(1 to 3)
end function

dim as integer f(1 to 6) = { 10, 20, 30, 40, 50, 60 }
dim as span( of integer ) v = f(2 to 4)
Show( "fixed", v )
print "bounds"; lbound( v ); ubound( v ); lbound( v, 0 ); ubound( v, 0 ); lbound( v, 2 ); ubound( v, 2 )
v(1) = 99
print "write"; f(3)

'' 'a(i to i)(0)' is 'a(i)' for every i -- the off-by-one, asserted.
dim as boolean ok = true
for i as integer = 1 to 6
    dim as span( of integer ) one = f(i to i)
    if one(0) <> f(i) then ok = false
next
print "single"; ok

dim as span( of integer ) e = f(4 to 3)
print "empty"; len( e )

dim as span( of integer ) w = v(1 to 2)
Show( "reslice", w )

redim d(0 to 4) as integer
for i as integer = 0 to 4
    d(i) = i * i
next
Show( "dynamic", d(1 to 4) )
FromParam( d() )
Show( "returned", Mid3( d(0 to 4) ) )

redim z( ) as integer
dim as span( of integer ) ez = z(lbound( z ) to ubound( z ))
print "unallocated"; len( ez )

dim as string names(0 to 3) = { "ann", "bob", "cy", "di" }
dim as span( of string ) sv = names(1 to 2)
sv(0) &= "!"
print "strings "; sv(0); " "; sv(1); " "; names(1)

dim as Pt pts(0 to 2)
dim as span( of Pt ) pv = pts(1 to 2)
pv(1).x = 7
print "udt"; pts(2).x; sizeof( pv )

dim as const integer k(0 to 2) = { 1, 2, 3 }
dim as const span( of integer ) kv = k(0 to 1)
print "const"; kv(1)
