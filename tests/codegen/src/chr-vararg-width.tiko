'' The source of tests/codegen/chr-vararg-width.test: fb_CHR and fb_WstrChr read
'' each character with cva_arg( ap, unsigned int ), and on i386 a variadic slot
'' is the machine word. Widen the characters to int64 there and every slot after
'' the first is the previous argument's sign-extension: chr( 65, 66, 67 ) came back
'' as 65 0 66 on win32, which is how tkEdit's CRLF line endings became LF.
dim as string s = chr( 65, 66, 67 )
'' an all-constant wchr folds to a literal, so the codes must be variables to
'' reach fb_WstrChr at all.
dim as integer lo = 13, hi = 10
dim as ustring w = "x" & wchr( lo, hi )
print len( s ) + len( w )
