'' -exx (docs/tiko-slices RFC-0003 §7): a callee's REDIM PRESERVE through an 'x()' parameter moves
'' the array a span views -- runtime error 6 at the span's use.
sub Grow( a() as integer )
    redim preserve a(0 to 99999)
end sub
sub Peek2( byval v as span( of integer ), a() as integer )
    Grow( a() )
    print v(0)
end sub
redim d(0 to 3) as integer
Peek2( d(0 to 2), d() )
