'' std/tz: ParseIso is TryParseIso's plain form -- text with no zone annotation is
'' runtime error 1 there.
#import "std/tz"
#import "std/os"
os.SetEnv( "TZDIR", "tests/codegen/tzdata" )
dim as tz.ZonedDateTime z
print tz.ZonedDateTime.TryParseIso( "2025-07-04T12:00:00-04:00", z )
print tz.ZonedDateTime.ParseIso( "2025-07-04T12:00:00-04:00[America/New_York]" ).Hour
print tz.ZonedDateTime.ParseIso( "2025-07-04T12:00:00-04:00" ).Hour
print "not reached"
