#import "std/outcome"
using outcome

sub Probe( )
    on local error goto caught
    dim e as Optional( of long )
    print e.Value( )
    print "not reached"
    exit sub
caught:
    dim as long n = err, l = erl
    print "caught"; n; l
end sub

sub ProbeResult( )
    on local error goto caught
    dim r as Result( of long, string ) = Ok( of long, string )( 1 )
    print r.Failure( )
    print "not reached"
    exit sub
caught:
    dim as long n = err, l = erl
    print "caught"; n; l
end sub

Probe( )
ProbeResult( )
dim o as Optional( of long ) = Some( 42L )
o.Value( ) = 43
print "byref"; o.Value( )
dim e as Optional( of long )
print e.Value( )
print "not reached"
