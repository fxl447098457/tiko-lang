function vsum cdecl( byval n as long, ... ) as int128
    dim as cva_list ap
    cva_start( ap, n )
    dim as int128 s = 0
    for i as long = 1 to n
        s += cva_arg( ap, int128 )
    next
    cva_end( ap )
    return s
end function

dim as int128 a = (cast( int128, 1 ) shl 80) + 3
dim as int128 b = 5
dim as int128 s = vsum( 2, a, b )
print culngint( s shr 64 ); " "; culngint( s and &hFFFFFFFFFFFFFFFFull )
