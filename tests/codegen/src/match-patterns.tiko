'' match (docs/tiko-comparison RFC-0001-match): every pattern kind, in both forms.
enum Light
    Red, Amber, Green
end enum
type Point
    as long x, y
end type
type Seg
    as Point a, b
end type
type Shape extends object
    declare virtual destructor( )
end type
destructor Shape( )
end destructor
type Circle extends Shape
    as double r
end type
type Rect extends Shape
    as double w, h
end type

'' enum, statement form, a multi-line body and ':' bodies
sub ShowLight( byval l as Light )
    match l
        case Red
            print "enum:";
            print "stop"
        case Amber : print "enum:slow"
        case Green : print "enum:go"
    end match
end sub
ShowLight( Light.Red ) : ShowLight( Light.Amber ) : ShowLight( Light.Green )

'' values, lists, ranges, is, else -- expression form
function Status( byval code as long ) as ustring
    return match code
        200        => "OK"
        301, 302   => "Redirect"
        400 to 499 => "Client error"
        is >= 500  => "Server error"
        else       => "Unknown"
    end match
end function
print "status:"; Status( 200 ); "|"; Status( 302 ); "|"; Status( 404 ); "|"; Status( 503 ); "|"; Status( 7 )

'' boolean, both members
dim as boolean ok_ = false
print "bool:"; match ok_
    true  => "pass"
    false => "fail"
end match

'' UDT destructuring, guards, bindings
sub ShowPoint( byref p as Point )
    match p
        case Point( 0, 0 )
            print "udt:origin"
        case Point( x, y ) if x = y
            print "udt:diagonal"; x
        case Point( x, y )
            print "udt:"; x; ","; y
    end match
end sub
dim as Point p
ShowPoint( p )
p.x = 4 : p.y = 4 : ShowPoint( p )
p.x = 1 : p.y = 9 : ShowPoint( p )

'' nested UDT patterns
dim as Seg sg
sg.b.x = 5
match sg
    case Seg( Point( 0, 0 ), Point( bx, 0 ) ) : print "nested:"; bx
    case else : print "nested:else"
end match

'' tuples and 'any'
function AccessOf( byval isAdmin as boolean, byval isOwner as boolean ) as string
    return match ( isAdmin, isOwner )
        ( true,  any   ) => "full"
        ( false, true  ) => "own"
        ( false, false ) => "none"
    end match
end function
print "tuple:"; AccessOf( true, false ); "|"; AccessOf( false, true ); "|"; AccessOf( false, false )

'' class type patterns over a pointer, a null one, and 'any as'
function Area( byval s as Shape ptr ) as double
    return match s
        c as Circle => 3 * c->r * c->r
        r as Rect   => r->w * r->h
        else        => -1
    end match
end function
dim as Rect ptr rp = new Rect
rp->w = 2 : rp->h = 5
dim as Circle ptr cp = new Circle
cp->r = 2
print "type:"; Area( rp ); Area( cp ); Area( 0 )
dim as Shape ptr sp = cp
match sp
    case any as Rect : print "anyas:rect"
    case any as Circle : print "anyas:circle"
    case else : print "anyas:other"
end match

'' strings: values, lists, ranges, starts with and without a binding
sub RunCmd( byref cmd as string )
    match cmd
        case "quit", "exit" : print "cmd:bye"
        case starts "load " rest
            print "cmd:load<"; rest; ">"
        case starts "#"
            print "cmd:comment"
        case "a" to "m" : print "cmd:early"
        case else : print "cmd:unknown"
    end match
end sub
RunCmd( "exit" ) : RunCmd( "load abc" ) : RunCmd( "# x" ) : RunCmd( "help" ) : RunCmd( "zz" )

'' a ustring subject
dim as ustring u = "load ü"
match u
    case starts "load " rest : print "ustr:"; len( rest )
    case else : print "ustr:else"
end match
