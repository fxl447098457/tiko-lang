'' A narrow slice has no NUL: docs/tiko-slices RFC-0001 §7. Everything that is not a known
'' length-driven consumer gets a terminated copy of its own.

extern "C"
    declare function c_strlen alias "strlen" ( byval p as const zstring ptr ) as uinteger
end extern

sub RefConst( byref x as const string )
    print "ref"; len( x ); c_strlen( x )
end sub

'' The callee's own string work must not recycle the parameter's descriptor.
sub RefAfterPrint( byref x as const string )
    print x
    dim as string other = "ZZZZZZZZ"
    print "[" & x & "]"; len( x ); len( other )
end sub

sub ByValue( byval x as string )
    print "val"; len( x ); c_strlen( x )
end sub

sub Ptr1( byval p as const zstring ptr )
    print "ptr"; c_strlen( p ); " "; *p
end sub

sub RefZ( byref z as const zstring )
    print "refz "; z
end sub

function Measure( byval p as const zstring ptr ) as integer
    return c_strlen( p )
end function

dim as string s = "hello world"
dim as slice v = s[0 to 4]

RefConst( v )
RefAfterPrint( v )
ByValue( v )

'' The explicit way to a C string, in a statement and inside an expression.
Ptr1( cast( string, v ) )
RefZ( cast( string, v ) )
print Measure( cast( string, v ) )
dim as integer m = Measure( cast( string, v ) ) + 1
print m
if Measure( cast( string, v ) ) = 5 then print "five"
print c_strlen( v & "" )

'' Runtime entries that take the descriptor's data as a C string.
dim as string nm = "sltkabcdef"
dim as slice nv = nm[0 to 6]
dim as integer f = freefile
open "sltkabc" for output as #f : print #f, "short" : close #f
f = freefile
open "sltkabcdef" for output as #f : print #f, "long" : close #f
print "kill"; kill( nv )
print (dir( "sltkabc" ) <> ""); (dir( "sltkabcdef" ) <> "")
kill "sltkabcdef"

dim as string e = "PATHXX"
dim as slice ev = e[0 to 3]
print (environ( ev ) = environ( "PATH" )); (environ( "PATH" ) <> "")

'' The consumers that borrow still see the slice and leave the source alone.
print v
print v & "!"
print (v = "hello"); (v = "hello world")
dim as string t = v
t &= v
print t; len( t )

'' An empty slice.
dim as slice em = s[3 to 2]
print "["; em; "]"; len( em ); (em = "")
dim as string et = em
print len( et )
print s
