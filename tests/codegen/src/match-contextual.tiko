'' 'match' is contextual (RFC-0001-match 5.2): every way fbc lets it be a name keeps working.
'' A paren-less call inside a SELECT arm followed by 'case', a function, a variable, a label, and
'' 'end match' as END with an exit code.
sub match( byval x as long )
    print "sub match"; x
end sub
function matchf( byval x as long ) as long
    return x * 2
end function
dim as long y = 2
select case y
    case 1
        match 10
    case 2
        match 20
end select
match 5
dim as long matchv = matchf( 21 )
print "func"; matchv
goto here
print "skipped"
here:
print "label"
