' 'partial class': the implicit 'object' base of parts with no 'inherits', a written base on a
' later part, and an interface given by one part.
interface INamed
    function Name( ) as string
end interface

class Animal
    Legs as long = 4
    declare virtual function Name( ) as string
end class

function Animal.Name( ) as string
    return "animal"
end function

partial class Plain
    A as long = 1
end class

partial class Plain
    B as long = 2
    declare function Sum( ) as long
end class

function Plain.Sum( ) as long
    return A + B
end function

partial class Dog
    Age as long = 7
    declare function Name( ) as string override
end class

partial class Dog
    inherits Animal
    implements INamed
    declare function Twice( ) as long
    declare function Title( ) as string implements INamed.Name
end class

function Dog.Name( ) as string
    return "dog"
end function

function Dog.Twice( ) as long
    return Age * 2
end function

function Dog.Title( ) as string
    return "rex"
end function

dim as Plain p
print p.Sum( )
dim as Dog d
print d.Legs, d.Twice( )
dim as Animal ptr a = @d
print a->Name( )
dim as INamed n = d
print n.Name( )
print OffsetOf( Dog, Age ) > OffsetOf( Animal, Legs )
