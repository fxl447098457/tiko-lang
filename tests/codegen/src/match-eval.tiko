'' match (docs/tiko-comparison RFC-0001-match): evaluation -- once, in order, before the statement.
enum Light
    Red, Amber, Green
end enum
dim shared as long calls
function NextVal( ) as long
    calls += 1
    return calls
end function

'' the subject is evaluated once, whatever the arm count
dim as long v = match NextVal( )
    1 => 10
    2 => 20
    else => 99
end match
print "once:"; v; calls

'' statement form: once too
match NextVal( )
    case 1 : print "stmt:1"
    case 2 : print "stmt:2"
    case else : print "stmt:else"
end match
print "stmtcalls:"; calls

'' a guard that fails falls through to the next arm
dim as long n = 7
match n
    case is > 5 if n mod 2 = 0 : print "guard:even big"
    case is > 5 : print "guard:odd big"
    case else : print "guard:small"
end match

'' a match expression inside a single-line IF, and two in one statement
dim as boolean c = true
if c then print "sl:"; match n
    7 => "seven"
    else => "other"
end match
print "two:"; match n
    7 => "a"
    else => "b"
end match; match n + 1
    8 => "c"
    else => "d"
end match

'' nested: a match in an arm's value, using the outer binding
type Pair
    as long a, b
end type
dim as Pair pr
pr.a = 3 : pr.b = 4
print "nest:"; match pr
    Pair( a, b ) if a > b => "down"
    Pair( a, b ) => match b - a
        1 => "step"
        else => "jump"
    end match
end match

'' a string result and a UDT result from the value form
function Name_( byval l as Light ) as string
    return match l
        Red => "red" & "!"
        Amber => "amber"
        Green => "green"
    end match
end function
print "strres:"; Name_( Light.Red ); Name_( Light.Green )
function MkPair( byval k as long ) as Pair
    dim as Pair a, b
    a.a = 1 : b.a = 2
    return match k
        1 => a
        else => b
    end match
end function
print "udtres:"; MkPair( 1 ).a; MkPair( 5 ).a

'' an enum variable holding no member's value: no arm runs; the value form gives its last arm
dim as Light odd = cast( Light, 9 )
match odd
    case Red : print "odd:red"
    case Amber : print "odd:amber"
    case Green : print "odd:green"
end match
print "oddv:"; match odd
    Red => 1
    Amber => 2
    Green => 3
end match

'' bindings alias the copy, not the original
dim as Pair q
q.a = 1
match q
    case Pair( a, any )
        a = 50
        print "copy:"; a; q.a
end match

'' inside a generic, instantiated twice
function Kind_( of T )( byval x as T ) as string
    return match sizeof( x )
        is <= 8 => "int"
        else => "str"
    end match
end function
print "generic:"; Kind_( 3 ); "|"; Kind_( "abc" )

print "done"
