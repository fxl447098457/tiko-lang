'' A span where an 'x() as T' parameter is wanted (docs/tiko-slices RFC-0003 §6): the callee sees
'' a 0-based array over the span's elements; writes land in the source; a 'byval span' overload
'' beats an array one; ERASE in the callee clears the elements in place.
function Total( a() as integer ) as integer
    dim as integer t = 0
    for i as integer = lbound( a ) to ubound( a )
        t += a(i)
    next
    return t
end function
sub Bump( a() as integer )
    for i as integer = lbound( a ) to ubound( a )
        a(i) += 100
    next
end sub
sub Bounds( a() as integer )
    print "bounds"; lbound( a ); ubound( a )
end sub
sub Pick overload ( a() as integer )
    print "array"
end sub
sub Pick overload ( byval v as span( of integer ) )
    print "span"
end sub
sub Clear_( a() as integer )
    erase a
end sub
sub Names( a() as string )
    print a(0); a(1)
end sub
dim as integer f(1 to 6) = { 1, 2, 3, 4, 5, 6 }
dim as span( of integer ) v = f(2 to 4)
print "total"; Total( v ); Total( f(5 to 6) )
Bump( v )
print "bumped"; f(1); f(2); f(4); f(5)
Bounds( v )
Bounds( f(3 to 2) )
Pick( v )
Pick( f() )
Clear_( f(5 to 6) )
print "cleared"; f(4); f(5); f(6)
dim as string s(0 to 3) = { "a", "b", "c", "d" }
Names( s(2 to 3) )
