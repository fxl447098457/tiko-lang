'' std/tz: Resolve is TryResolve's plain form -- where TryResolve answers false (here
'' dzReject on St_Johns' 2025 fall-back overlap), Resolve is runtime error 1.
#import "std/tz"
#import "std/chrono"
#import "std/os"
os.SetEnv( "TZDIR", "tests/codegen/tzdata" )
dim as tz.TimeZone sj = tz.TimeZone.FindById( "America/St_Johns" )
dim as chrono.DateTime w = chrono.DateTime( 2025, 11, 2, 1, 30, 0, 0 )
dim as chrono.Instant r
print sj.TryResolve( w, tz.dzReject, r )
print sj.Resolve( w ).ToIsoString( )
print sj.Resolve( w, tz.dzReject ).ToIsoString( )
print "not reached"
