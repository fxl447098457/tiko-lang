'' RUN: 'match' stays a name (RFC-0001-match 5.2, every shape measured with fbc 1.10.1): a
'' paren-less call 'match 20' inside a SELECT arm followed by 'case', a call at the top level, a
'' function, a label. The keyword needs an 'end match', and the SELECT's own 'end select' comes first.
'' TEST: cli
'' ARGS: -target windows-x86_64 -w all tests/codegen/src/match-contextual.tiko -o tests/codegen/matchcontextual.exe
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' EXPECT-EXIT: 0
'' EXPECT-NOT: warning
'' EXPECT-FILE: tests/codegen/matchcontextual.exe
'' RUN: tests/codegen/matchcontextual.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: sub match 20
'' EXPECT-RUN-OUT: sub match 5
'' EXPECT-RUN-OUT: func 42
'' EXPECT-RUN-OUT: label
