'' RUN: -fsanitize=address -g reports heap-buffer-overflow at the tiko line that made it, and the program
'' exits 1 before the line after it.
'' TEST: cli
'' HOSTS: windows
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' ARGS: -g -fsanitize=address --no-module-cache -target windows-x86_64 tests/codegen/src/asan-overflow.tiko -o tests/codegen/asanovf.exe
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/asanovf.exe
'' EXPECT-RUN-EXIT: 1
'' EXPECT-RUN-OUT: ERROR: AddressSanitizer: heap-buffer-overflow
'' EXPECT-RUN-OUT: asan-overflow.tiko:2
