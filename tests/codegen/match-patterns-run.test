'' RUN: 'match' (docs/tiko-comparison RFC-0001-match) -- every pattern kind in both forms: an enum,
'' values / lists / ranges / 'is' / 'else', a boolean, UDT destructuring with guards and bindings,
'' nested UDTs, tuples with 'any', class type patterns over a pointer (and a null one), 'any as',
'' string values, lists, ranges and 'starts' with and without a binding, and a ustring subject.
'' TEST: cli
'' ARGS: -target windows-x86_64 -w all tests/codegen/src/match-patterns.tiko -o tests/codegen/matchpatterns.exe
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' EXPECT-EXIT: 0
'' EXPECT-NOT: warning
'' EXPECT-FILE: tests/codegen/matchpatterns.exe
'' RUN: tests/codegen/matchpatterns.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: enum:stop
'' EXPECT-RUN-OUT: enum:slow
'' EXPECT-RUN-OUT: enum:go
'' EXPECT-RUN-OUT: status:OK|Redirect|Client error|Server error|Unknown
'' EXPECT-RUN-OUT: bool:fail
'' EXPECT-RUN-OUT: udt:origin
'' EXPECT-RUN-OUT: udt:diagonal 4
'' EXPECT-RUN-OUT: udt: 1, 9
'' EXPECT-RUN-OUT: nested: 5
'' EXPECT-RUN-OUT: tuple:full|own|none
'' EXPECT-RUN-OUT: type: 10 12-1
'' EXPECT-RUN-OUT: anyas:circle
'' EXPECT-RUN-OUT: cmd:bye
'' EXPECT-RUN-OUT: cmd:load<abc>
'' EXPECT-RUN-OUT: cmd:comment
'' EXPECT-RUN-OUT: cmd:early
'' EXPECT-RUN-OUT: cmd:unknown
'' EXPECT-RUN-OUT: ustr: 1
