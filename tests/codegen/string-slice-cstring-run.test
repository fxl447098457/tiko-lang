'' RUN: a narrow slice has no NUL, so everything but print, '&' and the comparisons gets a terminated
'' copy: byref const string parameters, cast( string, v ) for a zstring pointer, kill, environ.
'' TEST: cli
'' ARGS: -target windows-x86_64 -w all tests/codegen/src/string-slice-cstring.tiko -o tests/codegen/stringslicecstring.exe
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' EXPECT-EXIT: 0
'' EXPECT-NOT: warning
'' EXPECT-FILE: tests/codegen/stringslicecstring.exe
'' RUN: tests/codegen/stringslicecstring.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: ref 55
'' EXPECT-RUN-OUT: [hello] 5 8
'' EXPECT-RUN-OUT: val 55
'' EXPECT-RUN-OUT: ptr5 hello
'' EXPECT-RUN-OUT: refz hello
'' EXPECT-RUN-OUT: five
'' EXPECT-RUN-OUT: kill 0
'' EXPECT-RUN-OUT:  0-1
'' EXPECT-RUN-OUT: -1-1
'' EXPECT-RUN-OUT: hello!
'' EXPECT-RUN-OUT: -1 0
'' EXPECT-RUN-OUT: hellohello 10
'' EXPECT-RUN-OUT: [] 0-1
