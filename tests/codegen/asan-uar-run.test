'' RUN: -fsanitize=address -g reports stack-use-after-return at the tiko line that made it, and the program
'' exits 1 before the line after it.
'' TEST: cli
'' HOSTS: windows
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' ARGS: -g -fsanitize=address --no-module-cache -target windows-x86_64 tests/codegen/src/asan-uar.tiko -o tests/codegen/asanuar.exe
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/asanuar.exe
'' EXPECT-RUN-EXIT: 1
'' EXPECT-RUN-OUT: ERROR: AddressSanitizer: stack-use-after-return
'' EXPECT-RUN-OUT: asan-uar.tiko:6
