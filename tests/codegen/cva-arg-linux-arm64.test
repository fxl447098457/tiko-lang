'' linux-arm64: cva_arg is clang's AAPCS64 sequence over the 32-byte va_list record
'' { __stack @0, __gr_top @8, __vr_top @16, __gr_offs @24, __vr_offs @28 } -- NEVER LLVM's own
'' 'va_arg' instruction, which compiles silently there and reads garbage (probed 2026-11-19,
'' docs/tiko-linux-arm64 FEASIBILITY 2.1). GP reads walk gr_offs at 24 by 8, int128 rounds it to
'' 16 and aligns the stack to 16, double and single walk vr_offs at 28 by 16 with an 8-byte stack
'' slot. The running proof is build/aapcslane.sh's linux-arm64 lane (t_va, t_va2, t_va3).
'' See EmitVaArgAapcs64_ in src/codegen/llvmaggcopy.tiko.
'' TEST: cli
'' ARGS: -target linux-arm64 --emit-ir tests/codegen/src/cva-arg-aapcs64.bas
'' EXPECT-EXIT: 0
'' EXPECT-NOT: = va_arg
'' EXPECT-OUT: %t8.op = getelementptr i8, ptr %s2, i64 24
'' EXPECT-OUT: %t8.nx = getelementptr i8, ptr %t8.sk, i64 8
'' EXPECT-OUT: %t8 = load i64, ptr %t8.addr, align 8
'' EXPECT-OUT: %t10 = load ptr, ptr %t10.addr, align 8
'' EXPECT-OUT: %t12.oal = and i32 %t12.o15, -16
'' EXPECT-OUT: %t12.skal = and i64 %t12.ski15, -16
'' EXPECT-OUT: %t12.nx = getelementptr i8, ptr %t12.ska, i64 16
'' EXPECT-OUT: %t12 = load i128, ptr %t12.addr, align 8
'' EXPECT-OUT: %t14.op = getelementptr i8, ptr %s2, i64 28
'' EXPECT-OUT: %t14.tp = getelementptr i8, ptr %s2, i64 16
'' EXPECT-OUT: %t14.nw = add i32 %t14.o, 16
'' EXPECT-OUT: %t14.nx = getelementptr i8, ptr %t14.sk, i64 8
'' EXPECT-OUT: %t14 = load double, ptr %t14.addr, align 8
'' EXPECT-OUT: %t16 = load float, ptr %t16.addr, align 4
