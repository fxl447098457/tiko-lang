#define TRACING
#include once "trace.ti"

function Mean( values( ) as float64 ) as float64
    var n = ubound( values ) - lbound( values ) + 1
    TRACE( "count " & n )
    dim total as float64
    for each v in values
        total += v
    next
    TRACE( "total " & total )
    return total / n
end function

dim readings( 0 to 2 ) as float64 = { 3.5, 4.0, 5.5 }
var m = Mean( readings( ) )
TRACE( "mean " & m )
