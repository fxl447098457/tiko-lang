'' Tests that end the program, or never end.
#import "std/testing"
#import "stopping/sensors"

test "parses a reading"
    testing.ExpectEq( sensors.ParseReading( "21" ), 21 )
end test

test "refuses a reading out of range"
    testing.ExpectEq( sensors.ParseReading( "999" ), 0 )
end test

test "waits for the sensor"
    sensors.WaitForSensor( )
end test

test "still runs after both"
    testing.ExpectEq( sensors.ParseReading( "-5" ), -5 )
end test
