#module "sensors"
'' Sensor readings: a parser that ends the program on bad input,
'' and a wait with no time limit.

public function ParseReading( byref s as ustring ) as int32
    var n = valint( s )
    if ( n < -50 ) orelse ( n > 60 ) then end 3
    return n
end function

public sub WaitForSensor( )
    do
        sleep 50, 1
    loop
end sub
