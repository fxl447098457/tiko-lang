#module "stacks"
'' A stack of int32 whose storage grows by doubling.

'' The size to grow to from 'size': four, then double.
function NextSize_( byval size as int32 ) as int32
    return iif( size < 4, 4, size * 2 )
end function

public type Stack
    declare sub Push( byval v as int32 )
    declare function Pop( ) as int32
    declare function Count( ) as int32
private:
    dim items( any ) as int32
    dim used as int32
end type

sub Stack.Push( byval v as int32 )
    if used > ubound( items ) then
        redim preserve items( NextSize_( used ) - 1 )
    end if
    items( used ) = v
    used += 1
end sub

function Stack.Pop( ) as int32
    used -= 1
    return items( used )
end function

function Stack.Count( ) as int32
    return used
end function
