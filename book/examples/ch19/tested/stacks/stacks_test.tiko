#module "stacks"
'' White-box tests: part of the module in a test build, so
'' the module-private NextSize_ is in reach.
#import "std/testing"

test "storage starts at four and doubles"
    testing.ExpectEq( NextSize_( 0 ), 4 )
    testing.ExpectEq( NextSize_( 4 ), 8 )
    testing.ExpectEq( NextSize_( 8 ), 16 )
end test
