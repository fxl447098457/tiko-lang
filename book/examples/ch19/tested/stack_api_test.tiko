'' Black-box tests: a program of their own, using the stacks
'' module the way any client does.
#import "std/testing"
#import "./stacks"

test "a new stack is empty"
    dim s as stacks.Stack
    testing.ExpectEq( s.Count( ), 0 )
end test

test "pops in reverse order"
    dim s as stacks.Stack
    for i as int32 = 1 to 5
        s.Push( i )
    next
    testing.ExpectEq( s.Pop( ), 5 )
    testing.ExpectEq( s.Pop( ), 4 )
    testing.ExpectEq( s.Count( ), 3 )
end test

test "counts what it holds"
    dim s as stacks.Stack
    s.Push( 7 )
    testing.ExpectEq( s.Count( ), 2 )         '' wrong on purpose
end test
