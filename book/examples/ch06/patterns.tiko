'' patterns.tiko -- taking a value apart: UDT fields, guards, class types and strings.
type Point
    as int32 x, y
end type

sub Where( byref p as Point )
    match p
        case Point( 0, 0 )
            print "the origin"
        case Point( x, y ) if x = y
            print "on the diagonal at"; x
        case Point( x, y )
            print "at"; x; ","; y
    end match
end sub

dim as Point p
Where( p )
p.x = 3 : p.y = 3 : Where( p )
p.x = 1 : p.y = 7 : Where( p )

class Shape
    declare virtual destructor( )
end class
destructor Shape( )
end destructor
type Circle extends Shape
    as double r
end type
type Rect extends Shape
    as double w, h
end type

'' A type pattern tests what a base pointer really points at, and binds it typed.
function Area( byval s as Shape ptr ) as double
    return match s
        c as Circle => 3.14159 * c->r * c->r
        r as Rect   => r->w * r->h
        else        => 0
    end match
end function

dim as Rect ptr rp = new Rect
rp->w = 2 : rp->h = 5
print "area"; Area( rp )
delete rp

'' 'starts' matches a prefix and binds the rest of the string.
dim as string cmd = "load notes.txt"
match cmd
    case "quit", "exit"      : print "bye"
    case starts "load " file : print "loading "; file
    case else                : print "unknown command"
end match
