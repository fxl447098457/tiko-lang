'' matching.tiko -- match: one value against patterns, as a statement and as a value.
enum Light
    Red, Amber, Green
end enum

sub Drive( byval l as Light )
    '' The statement form: 'case' arms, each with a body of any length.
    match l
        case Red   : print "stop"
        case Amber : print "slow down"
        case Green : print "go"
    end match
end sub

Drive( Light.Amber )

'' The value form: 'pattern => value' arms, and the whole match is the value.
dim as int32 code = 404
dim as ustring label = match code
    200        => "OK"
    301, 302   => "Redirect"
    400 to 499 => "Client error"
    else       => "Unknown"
end match
print label

'' Tuples: several values matched at once; 'any' matches anything.
dim as boolean isAdmin = false, isOwner = true
match ( isAdmin, isOwner )
    case ( true,  any   ) : print "full access"
    case ( false, true  ) : print "own records only"
    case ( false, false ) : print "no access"
end match
