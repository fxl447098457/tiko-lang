'' wide.tiko -- int128 holds what int64 cannot.
dim as int64 big = 9223372036854775807        ' the largest int64
dim as int128 wrapped = big * big             ' 64-bit product: wraps
dim as int128 square = cast( int128, big ) * big   ' 128-bit: exact
print wrapped
print square

' a literal past 64 bits needs no suffix
dim as uint128 most = 340282366920938463463374607431768211455
print hex( most )
