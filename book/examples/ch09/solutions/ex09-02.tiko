'' ex09-02.tiko -- read a key=value block, one pair per line.
''
'' The work is all in deciding where a line ends and where the first
'' '=' is. Splitting on '=' would be wrong: a value may contain one,
'' so the key is everything before the FIRST separator and the value
'' is everything after it, however many more there are.

#import "std/strings"

dim as ustring config = _
    "host = example.org" & chr( 10 ) & _
    "port=8080" & chr( 10 ) & _
    "  " & chr( 10 ) & _
    "motto = live = learn" & chr( 10 ) & _
    "nokeyhere" & chr( 10 ) & _
    "empty ="

var lines = strings.Split( config, chr( 10 ) )

for each entry in lines
    dim as ustring line_ = trim( entry )

    if len( line_ ) = 0 then
        print "(blank line skipped)"
        continue for
    end if

    dim as int32 at = instr( line_, "=" )
    if at = 0 then
        print "no '=' in ["; line_; "] -- skipped"
        continue for
    end if

    dim as ustring key = trim( left( line_, at - 1 ) )
    dim as ustring value = trim( mid( line_, at + 1 ) )

    print "key = ["; key; "]  value = ["; value; "]"
next
