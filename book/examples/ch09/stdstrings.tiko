'' stdstrings.tiko -- what the standard library adds.
#import "std/strings"

dim as ustring s = "alpha,beta,gamma"

'' Split hands back an Array( of ustring ) -- the container from
'' Chapter 24. Here it is only asked for its count and its elements.
var parts = strings.Split( s, "," )
print "Split gave"; parts.Count( ); " parts:";
for each part in parts
    print " ["; part; "]";
next
print

print "Join       = ["; strings.Join( parts, " | " ); "]"
print "Replace    = ["; strings.Replace( s, "beta", "BETA" ); "]"
print "Between    = ["; strings.Between( "name(value)", "(", ")" ); "]"
print "StartsWith = "; strings.StartsWith( s, "alpha" )
print "EndsWith   = "; strings.EndsWith( s, "gamma" )
print "Contains   = "; strings.Contains( s, "bet" )
print "IsNumeric  = "; strings.IsNumeric( "42" ); _
      strings.IsNumeric( "4a" )
print "PadLeft    = ["; strings.PadLeft( "7", 4, "0" ); "]"
print "PadRight   = ["; strings.PadRight( "ab", 5, "." ); "]"
print "PadCenter  = ["; strings.PadCenter( "ab", 6, "." ); "]"
print "Repeat     = ["; strings.Repeat( 3, "ab" ); "]"
print "Reverse    = ["; strings.Reverse( "abc" ); "]"
print "Wrap       = ["; strings.Wrap( "hi", "<", ">" ); "]"
print "Escape     = ["; strings.Escape( !"a\tb" ); "]"
