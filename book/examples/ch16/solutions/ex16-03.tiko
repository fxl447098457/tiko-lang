'' ex16-03.tiko -- where this platform keeps temporary files.
#if defined( TIKO_OS_WINDOWS )
    const TEMP_VAR = "TEMP"
#elseif defined( TIKO_OS_LINUX )
    const TEMP_VAR = "TMPDIR"
#elseif defined( TIKO_OS_MACOS )
    const TEMP_VAR = "TMPDIR"
#else
    #error "ex16-03: this platform is not supported"
#endif

print "temporary files: the "; TEMP_VAR; " variable"
