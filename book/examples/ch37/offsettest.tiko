'' The two counts of a position, with no window. U+00E9 is two bytes
'' and one unit; U+1F600 is four bytes and two units.
#import "./offsets"

dim as ustring ascii = "plain text"
dim as ustring accent = "caf" & wchr( &hE9 ) & " au lait"
dim as ustring emoji = wchr( &h1F600 ) & " smile"

print "== ASCII: the two counts agree"
print "byte 5 is unit"; offsets.UnitsIn( ascii, 5 )
print "unit 5 is byte"; offsets.BytesIn( ascii, 5 )

print "== 'au' in cafe-acute au lait"
dim as int32 at = instr( accent, "au" ) - 1
print "unit offset:"; at
print "byte offset:"; offsets.BytesIn( accent, at )
print "and back:   "; offsets.UnitsIn( accent, _
                          offsets.BytesIn( accent, at ) )

print "== 'smile' after U+1F600"
at = instr( emoji, "smile" ) - 1
print "unit offset:"; at
print "byte offset:"; offsets.BytesIn( emoji, at )
print "and back:   "; offsets.UnitsIn( emoji, _
                          offsets.BytesIn( emoji, at ) )

print "== the edges"
print "offset 0:   "; offsets.BytesIn( accent, 0 ); _
      offsets.UnitsIn( accent, 0 )
dim as int32 units = len( accent )
dim as int32 count = offsets.BytesIn( accent, units )
print "the end:    "; count; offsets.UnitsIn( accent, count )
