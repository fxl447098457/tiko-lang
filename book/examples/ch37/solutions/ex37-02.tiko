'' Exercise 37-2: a new document takes the line ending of the system it
'' was started on, and a file that was read keeps its own.
#import "../textfile"
#import "std/fs"

function NativeEnding( ) as textfile.LineEnding
#if defined( TIKO_OS_WINDOWS )
    return textfile.LineEnding.CrLf
#else
    return textfile.LineEnding.Lf
#endif
end function

function NewDocument( ) as textfile.Document
    dim as textfile.Document doc
    doc.ending = NativeEnding( )
    return doc
end function

dim as textfile.Document doc = NewDocument( )
doc.path = "ex3702.tmp"
doc.text = !"one\ntwo\n"
print "saved: ["; textfile.Save( doc ); "]"

dim as textfile.Document back
textfile.Load( doc.path, back )
print "text survives: "; cbool( back.text = doc.text )
print "ending is the system's: "; cbool( back.ending = NativeEnding( ) )
fs.RemoveFile( doc.path )

'' Read a file in the other ending: it keeps that one.
back.path = "ex3702.tmp"
back.ending = iif( NativeEnding( ) = textfile.LineEnding.Lf, _
                   textfile.LineEnding.CrLf, textfile.LineEnding.Lf )
textfile.Save( back )
dim as textfile.Document other
textfile.Load( back.path, other )
print "another file keeps its own: "; _
      cbool( other.ending <> NativeEnding( ) )
fs.RemoveFile( back.path )
