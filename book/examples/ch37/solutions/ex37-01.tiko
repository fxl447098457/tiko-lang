'' Exercise 37-1: a column that counts characters, so that a character
'' outside the BMP, which a ustring holds as two units, counts once.
'' A low surrogate is the second half of such a pair.

'' How many characters lie between lineStart and offset, both 0-based
'' unit offsets into text.
function CharsBetween( byref text as const ustring, _
                       byval lineStart as int32, _
                       byval offset as int32 ) as int32
    dim as int32 n
    for i as int32 = lineStart + 1 to offset
        select case asc( text, i )
        case &hDC00 to &hDFFF
        case else
            n += 1
        end select
    next
    return n
end function

dim as ustring s = wchr( &h1F600 ) & wchr( &h1F600 ) & "x" & _
                   wchr( &hE9 ) & "y"
print "units in the line:      "; len( s )
print "column of the end:      "; CharsBetween( s, 0, len( s ) ) + 1
print "column after the first: "; CharsBetween( s, 0, 2 ) + 1
print "column of the x:        "; CharsBetween( s, 0, 4 ) + 1
