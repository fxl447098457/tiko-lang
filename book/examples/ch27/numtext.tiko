#import "std/numeric"

'' val cannot fail: garbage and a real zero look the same.
print "val( ""42abc"" ) ="; val( "42abc" ); _
      ", val( ""abc"" ) ="; val( "abc" )

'' TryParseDouble takes the whole string or nothing.
dim inputs( ... ) as ustring = { "2.5", "42abc", " 7", "1e3", "" }
for each text in inputs
    var v = numeric.TryParseDouble( text )
    print left( """" & text & """" & space( 8 ), 8 ); _
          iif( v.HasValue( ), str( v.Value( ) ), "refused" )
next

'' str rounds for show; ToString gives digits that read back exactly.
dim as float64 x = 0.1, y = 0.2
print "str:      "; str( x + y )
print "ToString: "; numeric.ToString( x + y )
var back = numeric.TryParseDouble( numeric.ToString( x + y ) ).Value( )
print "str reads back: "; cbool( val( str( x + y ) ) = x + y ); _
      ", ToString reads back: "; cbool( back = x + y )

'' A NumFormat says how a number should look.
dim f as numeric.NumFormat
f.style = numeric.NUM_FIXED
f.digits = 2
f.grouping = true
print numeric.ToString( 1234567.891, f )
