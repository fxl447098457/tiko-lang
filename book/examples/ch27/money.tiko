#import "std/money"

'' Binary floating point cannot hold 0.1 exactly.
dim as float64 a = 0.1, b = 0.2
print "float64: 0.1 + 0.2 = 0.3 is "; cbool( a + b = 0.3 )

'' Decimal holds decimal fractions exactly.
var d1 = money.DecimalParse( "0.1" ).Value( )
var d2 = money.DecimalParse( "0.2" ).Value( )
print "Decimal: 0.1 + 0.2 = "; ( d1 + d2 ).ToString( ); " is "; _
      ( d1 + d2 = money.DecimalParse( "0.3" ).Value( ) )

'' Currency: four places, fixed, in eight bytes.
var price = money.CurrencyParse( "19.99" ).Value( )
print "3 at 19.99 = "; ( price * 3 ).ToString( )
print "2 / 3      = "; ( money.CurrencyFromInt( 2 ) / 3 ).ToString( )

'' Text is parsed strictly: a fifth place is refused, not dropped.
print "parse 1.23456 as Currency: "; _
      money.CurrencyParse( "1.23456" ).HasValue( )

'' A Decimal keeps the scale it was written with.
var rate = money.DecimalParse( "0.0825" ).Value( )
var amount = money.DecimalParse( "59.97" ).Value( )
print "tax at 8.25% = "; ( amount * rate ).ToString( ); _
      ", to cents "; ( amount * rate ).Round( 2 ).ToString( )

'' Split 100.00 three ways so the parts add back to the total.
dim weights( 0 to 2 ) as int64 = { 1, 1, 1 }
dim parts( ) as money.Decimal
money.DecimalApportion( money.DecimalParse( "100.00" ).Value( ), 2, _
                        weights( ), parts( ) )
print "100.00 in three:";
for each part in parts
    print " "; part.ToString( );
next
print
