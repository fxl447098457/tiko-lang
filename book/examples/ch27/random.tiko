#import "std/numeric"

'' A seeded generator: the same seed gives the same numbers.
dim rng as numeric.Rng = numeric.RngSeeded( 12345 )

print "ten dice:";
for i as int32 = 1 to 10
    print rng.NextInt( 1, 6 );
next
print

print "a double in [0, 1): "; numeric.ToString( rng.NextDouble( ) )

'' Shuffle every element into a random order, each order equally likely.
dim deck( 1 to 8 ) as int32 = { 1, 2, 3, 4, 5, 6, 7, 8 }
numeric.Shuffle( rng, deck( ) )
print "shuffled:";
for each card in deck
    print card;
next
print

'' An Rng is a value: a copy carries on from the same point.
var copy_ = rng
print "original and copy agree: "; _
      cbool( rng.NextInt( 1, 1000 ) = copy_.NextInt( 1, 1000 ) )
