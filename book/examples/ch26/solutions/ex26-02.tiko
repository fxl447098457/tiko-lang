#import "std/chrono"

'' Add up a list of ISO 8601 durations, refusing any bad one.
dim laps( ... ) as ustring = { "PT4M12.5S", "PT3M58S", "PT4M1S", _
                              "4:05", "PT4M7.25S" }

dim total as chrono.TimeSpan
dim as int32 used = 0
for each text in laps
    dim lap as chrono.TimeSpan
    if chrono.TimeSpan.TryParseIso( text, lap ) then
        total += lap
        used += 1
    else
        print "not a duration: "; text
    end if
next
print "laps:"; used; ", total "; total.ToIsoString( )
print "mean lap: "; total.Divide( used ).ToIsoString( )
