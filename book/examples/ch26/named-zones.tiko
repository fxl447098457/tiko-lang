#import "std/tz"
#import "std/tzdata"
#import "std/chrono"
using tz

'' A weekly call, 09:00 in New York, for the four weeks around the change
'' to daylight time. Each week is the SAME WALL TIME, re-resolved.
dim as TimeZone ny = TimeZone.FindById( "America/New_York" )
dim as TimeZone ld = TimeZone.FindById( "Europe/London" )
dim as chrono.DateTime nine = chrono.DateTime( 2025, 3, 3, 9, 0, 0, 0 )
dim as ZonedDateTime callAt = ZonedDateTime.FromLocal( nine, ny )
for week as long = 0 to 3
    dim as ZonedDateTime c = callAt.AddCalendarDays( 7 * week )
    dim as ZonedDateTime l = c.WithZoneSameInstant( ld )
    print c.ToString( "ddd dd MMM HH:mm v" ); "  =  "; _
          l.ToString( "HH:mm v" ); " in London"
next

'' Elapsed time and calendar time part company across the change.
dim as ZonedDateTime w1 = callAt.AddCalendarDays( 7 )
dim as chrono.TimeSpan gap = w1.ToInstant( ) - callAt.ToInstant( )
print "hours from week 0 to week 1:"; gap.TotalHours

'' A reading that happened twice: the policy chooses.
dim as chrono.DateTime twice = chrono.DateTime( 2025, 11, 2, 1, 30, 0, 0 )
print ZonedDateTime.FromLocal( twice, ny, dzEarlier ).ToIsoString( )
print ZonedDateTime.FromLocal( twice, ny, dzLater ).ToIsoString( )
dim as ZonedDateTime refused
dim as boolean ok = ZonedDateTime.TryFromLocal( twice, ny, dzReject, refused )
print "dzReject accepts it: "; ok

'' The next change of offset, found from the zone's rules.
dim as chrono.Instant june = chrono.Instant.ParseIso( "2025-06-01T00:00:00Z" )
dim as chrono.Instant nx
if ny.TryNextTransition( june, nx ) then
    print "next change: "; ZonedDateTime.FromInstant( nx, ny ).ToIsoString( )
end if
