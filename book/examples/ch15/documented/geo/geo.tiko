#module "geo"
'' Squares and circles, and how much room they take.
''
''     #import "shapes/geo"
''     print geo.Area( geo.Square( 2 ) )

'' A shape: how many sides it has, and its size.
public type Shape
    '' 0 for a circle
    as int32 sides
    as float64 size         '' a side's length, or the radius
    '' The distance around it.
    declare function Perimeter( ) as float64
end type

'' A square whose sides are 'side' long.
public declare function Square( byval side as float64 ) as Shape

'' The area of a shape.
public declare function Area( byref s as Shape ) as float64

'' How a shape's numbers are rounded for printing.
public const DIGITS = 2

function Square( byval side as float64 ) as Shape
    dim s as Shape
    s.sides = 4
    s.size = side
    return s
end function

function Area( byref s as Shape ) as float64
    if s.sides = 0 then return 3.14159265 * s.size * s.size
    return s.size * s.size
end function

function Shape.Perimeter( ) as float64
    if sides = 0 then return 2 * 3.14159265 * size
    return sides * size
end function

'' Never documented: no 'public'.
function Round_( byval v as float64 ) as float64
    return int( v * 10 ^ DIGITS + 0.5 ) / 10 ^ DIGITS
end function
