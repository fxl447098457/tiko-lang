'' Parts with no 'inherits' take the base from the part that writes one.
class Animal
    Legs as int32 = 4
    declare virtual function Sound( ) as ustring
end class

function Animal.Sound( ) as ustring
    return "..."
end function

partial class Dog
    Name as ustring = "Rex"
    declare function Sound( ) as ustring override
end class

partial class Dog
    inherits Animal
    declare function Describe( ) as ustring
end class

function Dog.Sound( ) as ustring
    return "Woof"
end function

function Dog.Describe( ) as ustring
    return Name & " has " & Legs & " legs"
end function

dim as Dog d
print d.Describe( )
dim as Animal ptr a = @d
print a->Sound( )
