#module "orderform"

'' Written by you. The tool never opens this file.
partial type Form
    Clicks as int32
    declare function Summary( ) as ustring
end type

sub Form.Submit_Click( )
    Clicks += 1
    Total += 9.5
end sub

function Form.Summary( ) as ustring
    return NameBox & ": " & Clicks & " clicks, total " & Total
end function
