'' step2.tiko -- split the text into words.
#import "std/fs"
#import "std/strings"

var loaded = fs.ReadAllText( "words.txt" )
if loaded.IsOk( ) = false then
    print "cannot read words.txt"
    end 1
end if

'' normalize any CRLF line endings with just LF characters
var flat = strings.Replace( loaded.Value( ), !"\r\n", !"\n" )

'' replace LF's with spaces
flat = strings.Replace( flat, !"\n", " " )

var words = strings.Split( flat, " " )
print "words: " & words.Count

for each w in words
    if len( w ) > 0 then print "  [" & w & "]"
next
