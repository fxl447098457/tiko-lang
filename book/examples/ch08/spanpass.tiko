'' spanpass.tiko -- a span as a parameter, a result, and an array.

function Sum( byval v as span( of int32 ) ) as int64
    dim as int64 t = 0
    for each x as int32 in v
        t += x
    next
    return t
end function

'' The caller's span in, part of it out: nothing is copied.
function Middle( byval v as span( of int32 ) ) as span( of int32 )
    return v( 1 to len( v ) - 2 )
end function

'' An ordinary array procedure, written before spans existed.
sub DoubleAll( a( ) as int32 )
    for i as int32 = lbound( a ) to ubound( a )
        a( i ) *= 2
    next
end sub

redim as int32 d( 0 to 7 )
for i as int32 = 0 to 7
    d( i ) = i
next

print "sum of d( 2 to 5 ) ="; Sum( d( 2 to 5 ) )
print "sum of its middle  ="; Sum( Middle( d( 2 to 5 ) ) )

DoubleAll( d( 4 to 7 ) )                    ' a span where a( ) is wanted
for each x as int32 in d( 0 to 7 )
    print x;
next
print
