'' spans.tiko -- part of an array, without a copy.

dim as int32 a( 1 to 6 ) = { 10, 20, 30, 40, 50, 60 }

dim as span( of int32 ) v = a( 2 to 4 )   ' a's own indices
print "v has"; len( v ); " elements:"; v( 0 ); v( 1 ); v( 2 )
print "lbound"; lbound( v ); ", ubound"; ubound( v )

v( 1 ) = 99                               ' writes a( 3 )
print "a( 3 ) is now"; a( 3 )

dim as span( of int32 ) w = v( 1 to 2 )   ' a span of a span
for each x as int32 in w
    print x;
next
print

for each byref x as int32 in a( 5 to 6 )
    x += 1
next
print "a( 5 ), a( 6 ):"; a( 5 ); a( 6 )

dim as span( of int32 ) e = a( 4 to 3 )   ' empty
print "empty:"; len( e )
