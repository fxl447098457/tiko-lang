#import "std/net"

'' Text in, the canonical form out: IPv6 in its shortest lower-case spelling.
dim texts( 0 to 4 ) as ustring = { "192.168.1.20", "2001:0DB8:0:0:0:0:0:1", _
    "::ffff:10.0.0.7", "fe80::1%eth0", "010.0.0.1" }
for each text in texts
    dim r as net.NetResultIp = net.ParseIp( text )
    if r.IsOk( ) then
        dim a as net.IpAddress = r.Value( )
        print text; " -> "; a.ToString( ); iif( a.IsPrivate( ), " (private)", "" ); _
            iif( a.IsLinkLocal( ), " (link-local)", "" ); iif( a.IsV4Mapped( ), " (IPv4 as IPv6)", "" )
    else
        print text; " -> "; r.Failure( ).Message( )
    end if
next

'' An address and a port.
dim sa as net.SocketAddress = net.ParseSocketAddress( "[::1]:8080" ).Value( )
print sa.Ip.IsLoopback( ), sa.Port, sa.ToString( )
