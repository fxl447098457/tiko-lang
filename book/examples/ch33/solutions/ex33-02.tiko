'' Exercise 32-2: match whole words, so 'dog' does not match 'dogma'.
#import "../search"

'' One byte of the UTF-8 text. Every byte of a character outside
'' ASCII is 128 or more and counts as part of a word, so 'dog' is not
'' a whole word of a German compound that ends in it. The price:
'' punctuation outside ASCII, such as a long dash, joins words too.
function IsWordChar( byval c as int32 ) as boolean
    select case c
    case asc( "a" ) to asc( "z" ), asc( "A" ) to asc( "Z" ), _
         asc( "0" ) to asc( "9" ), asc( "_" ), 128 to 255
        return true
    end select
    return false
end function

function WordMatches( byref line_ as ustring, byref word as ustring, _
                      byval ignoreCase as boolean ) as boolean
    dim as ustring hay = line_, needle = word
    if ignoreCase then
        hay = lcase( hay )
        needle = lcase( needle )
    end if
    dim as int32 at = instr( hay, needle )
    do while at > 0
        dim as boolean startOk = ( at = 1 )
        if startOk = false then
            startOk = not IsWordChar( hay[ at - 2 ] )
        end if
        dim as int32 after = at + len( needle )
        dim as boolean endOk = ( after > len( hay ) )
        if endOk = false then
            endOk = not IsWordChar( hay[ after - 1 ] )
        end if
        if startOk andalso endOk then return true
        at = instr( at + 1, hay, needle )
    loop
    return false
end function

dim tests( ... ) as ustring = { "the lazy dog.", "dogma", _
                                "hot-dog stand", "Dog days", _
                                "underdog", !"dog\u00E9", _
                                !"Sch\u00E4dog" }
for each text in tests
    print left( text & space( 16 ), 16 ); _
          "substring: "; _
          search.LineMatches( text, "dog", true ); _
          ", word: "; _
          WordMatches( text, "dog", true )
next
